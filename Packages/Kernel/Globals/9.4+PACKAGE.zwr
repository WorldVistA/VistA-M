^DIC(9.4,101,22,6,"PAH",73,0)="96 SEQ #88^3050311^1"
^DIC(9.4,101,22,6,"PAH",73,1,0)="^^1^1^3050311"
^DIC(9.4,101,22,6,"PAH",73,1,1,0)="SNT AND PREMIUM PAY UPDATES"
^DIC(9.4,101,22,6,"PAH",74,0)="98 SEQ #89^3050311^1"
^DIC(9.4,101,22,6,"PAH",74,1,0)="^^1^1^3050311"
^DIC(9.4,101,22,6,"PAH",74,1,1,0)="Set January 20, 2005 as a holiday for selected sites in the DC area."
^DIC(9.4,101,22,6,"PAH",75,0)="97 SEQ #90^3050401^1"
^DIC(9.4,101,22,6,"PAH",75,1,0)="^^5^5^3050401"
^DIC(9.4,101,22,6,"PAH",75,1,1,0)="This patch contains the fix necessary to correct the queuing of the reports"
^DIC(9.4,101,22,6,"PAH",75,1,2,0)="from the Employee Inquiry [PRSD 04 EMPLOYEE INQUIRY] option and the reports"
^DIC(9.4,101,22,6,"PAH",75,1,3,0)="from the Payrun Data Inquiry [PRSD 04 PAYRUN DATA INQUIRY] option. After this"
^DIC(9.4,101,22,6,"PAH",75,1,4,0)="patch is installed, the queued reports will include all applicable data"
^DIC(9.4,101,22,6,"PAH",75,1,5,0)="instead of just the header without data."
^DIC(9.4,101,22,6,"PAH",76,0)="99 SEQ #91^3050709^1"
^DIC(9.4,101,22,6,"PAH",76,1,0)="^^6^6^3050709"
^DIC(9.4,101,22,6,"PAH",76,1,1,0)="This patch contains the fix necessary to remove the "
^DIC(9.4,101,22,6,"PAH",76,1,2,0)="supervisor/lead indicator if necessary based on the Employee"
^DIC(9.4,101,22,6,"PAH",76,1,3,0)="Occupation Series & Title code that is downloaded from Central"
^DIC(9.4,101,22,6,"PAH",76,1,4,0)="PAID. After this patch is installed, the supervisor/lead indicator"
^DIC(9.4,101,22,6,"PAH",76,1,5,0)="field in file #450, field #41, will not be populated if the"
^DIC(9.4,101,22,6,"PAH",76,1,6,0)="employee is no longer in a supervisory position."
^DIC(9.4,101,22,6,"PAH",77,0)="102 SEQ #92^3060410^1"
^DIC(9.4,101,22,6,"PAH",77,1,0)="^^1^1^3060410"
^DIC(9.4,101,22,6,"PAH",77,1,1,0)="See patch description on Forum for complete details of this patch."
^DIC(9.4,101,22,6,"PAH",78,0)="103 SEQ #93^3060410^1"
^DIC(9.4,101,22,6,"PAH",78,1,0)="^^5^5^3060410"
^DIC(9.4,101,22,6,"PAH",78,1,1,0)="This patch addresses one issues:"
^DIC(9.4,101,22,6,"PAH",78,1,2,0)="The Employee Leave Pattern Report does not include all "
^DIC(9.4,101,22,6,"PAH",78,1,3,0)="types of leave that are available for a leave request. A"
^DIC(9.4,101,22,6,"PAH",78,1,4,0)="request was made to include all types of time that are"
^DIC(9.4,101,22,6,"PAH",78,1,5,0)="available for a leave request on this report."
^DIC(9.4,101,22,6,"PAH",79,0)="101 SEQ #94^3060504^1"
^DIC(9.4,101,22,6,"PAH",79,1,0)="^^3^3^3060504"
^DIC(9.4,101,22,6,"PAH",79,1,1,0)="This patch will address the following:"
^DIC(9.4,101,22,6,"PAH",79,1,2,0)="The employee count numbers on the Strength Report are not "
^DIC(9.4,101,22,6,"PAH",79,1,3,0)="totaling up correctly and report is not balancing."
^DIC(9.4,101,22,6,"PAH",80,0)="108 SEQ #95^3060711^1"
^DIC(9.4,101,22,6,"PAH",81,0)="105 SEQ #96^3061227.143238^1"
^DIC(9.4,101,22,6,"PAH",81,1,0)="^^6^6^3061227"
^DIC(9.4,101,22,6,"PAH",81,1,1,0)="This patch addresses three issues:"
^DIC(9.4,101,22,6,"PAH",81,1,2,0)="1. The VCS Allotments field in files #450 and #459 are not"
^DIC(9.4,101,22,6,"PAH",81,1,3,0)="   formatted correctly."
^DIC(9.4,101,22,6,"PAH",81,1,4,0)="2. Fields 758, 759, 760, 761 in file #450 are not available to"
^DIC(9.4,101,22,6,"PAH",81,1,5,0)="   print using the PRSD 04 PRINT EMPLOYEE FILES option."
^DIC(9.4,101,22,6,"PAH",81,1,6,0)="3. The description of field 7 of file #458.5 has a typographical error."
^DIC(9.4,101,22,6,"PAH",82,0)="113 SEQ #97^3070627.212608^1"
^DIC(9.4,101,22,6,"PAH",82,1,0)="^^2^2^3070627"
^DIC(9.4,101,22,6,"PAH",82,1,1,0)=" "
^DIC(9.4,101,22,6,"PAH",82,1,2,0)="President Ford Funeral (01/02/07) - Government closing"
^DIC(9.4,101,22,6,"PAH",83,0)="93 SEQ #98^3070904.222744^1"
^DIC(9.4,101,22,6,"PAH",84,0)="109 SEQ #99^3070904.223008^1"
^DIC(9.4,101,22,6,"PAH",84,1,0)="^^6^6^3070904"
^DIC(9.4,101,22,6,"PAH",84,1,1,0)="This patch addresses four issues:"
^DIC(9.4,101,22,6,"PAH",84,1,2,0)="1. Labor Distribution Audit report errors out"
^DIC(9.4,101,22,6,"PAH",84,1,3,0)="2. Error received when payroll processes automatically "
^DIC(9.4,101,22,6,"PAH",84,1,4,0)="   after system shutdown"
^DIC(9.4,101,22,6,"PAH",84,1,5,0)="3. Employee not charged with enough Military Leave"
^DIC(9.4,101,22,6,"PAH",84,1,6,0)="4. Meal time incorrectly being deducted from Annual Leave"
^DIC(9.4,101,22,6,"PAH",85,0)="111 SEQ #100^3070904.235711^1"
^DIC(9.4,101,22,6,"PAH",85,1,0)="^^4^4^3070904"
^DIC(9.4,101,22,6,"PAH",85,1,1,0)="Public Law 108-445 modified the pay policies for VHA Physicians and "
^DIC(9.4,101,22,6,"PAH",85,1,2,0)="Dentists effective January 8, 2006.  This patch modifies VistA PAID/ETA in"
^DIC(9.4,101,22,6,"PAH",85,1,3,0)="accordance with the new pay policies for leave accrual and charging of"
^DIC(9.4,101,22,6,"PAH",85,1,4,0)="leave."
^DIC(9.4,101,22,6,"PAH",86,0)="114 SEQ #101^3070905.012407^1"
^DIC(9.4,101,22,6,"PAH",86,1,0)="^^1^1^3070905"
^DIC(9.4,101,22,6,"PAH",86,1,1,0)="This patch will modify the display of VA employee social security numbers."
^DIC(9.4,101,22,6,"PAH",87,0)="112 SEQ #102^3071212.225132^1"
^DIC(9.4,101,22,6,"PAH",87,1,0)="^^1^1^3071212"
^DIC(9.4,101,22,6,"PAH",87,1,1,0)="Nurse Alternative Work Schedules"
^DIC(9.4,101,22,6,"PAH",88,0)="118 SEQ #103^3080203.210904^1"
^DIC(9.4,101,22,6,"PAH",88,1,0)="^^2^2^3080203"
^DIC(9.4,101,22,6,"PAH",88,1,1,0)="See the patch description on Forum for complete details concerning this "
^DIC(9.4,101,22,6,"PAH",88,1,2,0)="patch."
^DIC(9.4,101,22,6,"PAH",89,0)="116 SEQ #104^3080526.193613^1"
^DIC(9.4,101,22,6,"PAH",90,0)="117 SEQ #106^3090422.154716^17"
^DIC(9.4,101,22,6,"PAH",91,0)="100 SEQ #107^3090422.161827^17"
^DIC(9.4,101,22,6,"PAH",91,1,0)="^^7^7^3090422"
^DIC(9.4,101,22,6,"PAH",91,1,1,0)="This patch addresses three issues:"
^DIC(9.4,101,22,6,"PAH",91,1,2,0)="1. A Cache error is generated when a number greater than"
^DIC(9.4,101,22,6,"PAH",91,1,3,0)="   142 characters is entered into the time fields on the "
^DIC(9.4,101,22,6,"PAH",91,1,4,0)="   Leave Request screen."
^DIC(9.4,101,22,6,"PAH",91,1,5,0)="2. HRIS Bulletin 07-08 has mandated an increase in the "
^DIC(9.4,101,22,6,"PAH",91,1,6,0)="   length of the Duty Station field."
^DIC(9.4,101,22,6,"PAH",91,1,7,0)="3. An electronic signature is not recognized."
^DIC(9.4,101,22,6,"PAH",92,0)="122 SEQ #108^3090422.161845^17"
^DIC(9.4,101,22,6,"PAH",92,1,0)="^^2^2^3090422"
^DIC(9.4,101,22,6,"PAH",92,1,1,0)="This patch will set Friday December 26, 2008 as an extra Christmas"
^DIC(9.4,101,22,6,"PAH",92,1,2,0)="holiday."
^DIC(9.4,101,22,6,"PAH",93,0)="123 SEQ #109^3090423.111406^17"
^DIC(9.4,101,22,6,"PAH",93,1,0)="^^2^2^3090423"
^DIC(9.4,101,22,6,"PAH",93,1,1,0)="This patch will set Inauguration Day, Tuesday January 20, 2009 as a "
^DIC(9.4,101,22,6,"PAH",93,1,2,0)="holiday for stations 101 and 688."
^DIC(9.4,101,22,6,"PAH",94,0)="107 SEQ #110^3090820.16165^17"
^DIC(9.4,101,22,6,"PAH",94,1,0)="^^6^6^3090820"
^DIC(9.4,101,22,6,"PAH",94,1,1,0)="This patch addresses three issues:"
^DIC(9.4,101,22,6,"PAH",94,1,2,0)="1. Erroneous data entries in file #458"
^DIC(9.4,101,22,6,"PAH",94,1,3,0)="2. The E node in file #458 is not setting "
^DIC(9.4,101,22,6,"PAH",94,1,4,0)="   correctly sometimes"
^DIC(9.4,101,22,6,"PAH",94,1,5,0)="3. Part time MD's (Pay Plan Q) are getting paid more than"
^DIC(9.4,101,22,6,"PAH",94,1,6,0)="   80 hours. "
^DIC(9.4,101,22,6,"PAH",95,0)="115 SEQ #111^3091022.104938^17"
^DIC(9.4,101,22,6,"PAH",95,1,0)="^^1^1^3091022"
^DIC(9.4,101,22,6,"PAH",95,1,1,0)="TOUR CHANGE PROBLEM;LD DISPLAY ERROR;LEAVE USED REPORT CORRECTION"
^DIC(9.4,101,22,6,"PAH",96,0)="121 SEQ #112^3100105.170041^17"
^DIC(9.4,101,22,6,"PAH",96,1,0)="^^5^5^3100105"
^DIC(9.4,101,22,6,"PAH",96,1,1,0)="This patch addresses 3 issues:"
^DIC(9.4,101,22,6,"PAH",96,1,2,0)="1. Error <UNDEFINED>FX1+8^PRSATE in 'Enter/Edit Emp Tour of Duty'"
^DIC(9.4,101,22,6,"PAH",96,1,3,0)="2. Overlapping tour error appears in 'Enter/Edit Emp Tour of Duty' "
^DIC(9.4,101,22,6,"PAH",96,1,4,0)="   when the tours do not overlap"
^DIC(9.4,101,22,6,"PAH",96,1,5,0)="3. Incorrect 8b edit error"
^DIC(9.4,101,22,6,"PAH",97,0)="119 SEQ #113^3100415.154751^17"
^DIC(9.4,101,22,6,"PAH",97,1,0)="^^5^5^3100415"
^DIC(9.4,101,22,6,"PAH",97,1,1,0)="This patch addresses three issues:"
^DIC(9.4,101,22,6,"PAH",97,1,2,0)="1. Saturday premium pay incorrect when holiday pay involved"
^DIC(9.4,101,22,6,"PAH",97,1,3,0)="2. Part time employee pay incorrect when 2 holidays fall together"
^DIC(9.4,101,22,6,"PAH",97,1,4,0)="3. Part time and nurse holiday pay incorrect when it "
^DIC(9.4,101,22,6,"PAH",97,1,5,0)="   includes a two-day tour."
^DIC(9.4,101,22,6,"PAH",98,0)="106 SEQ #105^3110127.091159^17"
^DIC(9.4,101,22,6,"PAH",98,1,0)="^^2^2^3110127"
^DIC(9.4,101,22,6,"PAH",98,1,1,0)="This patch addresses one issue: the Uniform allowance hourly rate is"
^DIC(9.4,101,22,6,"PAH",98,1,2,0)="different in the Central PAID system than in the VistA system."
^DIC(9.4,101,22,6,"PAH",99,0)="125 SEQ #114^3100816.12072^17"
^DIC(9.4,101,22,6,"PAH",99,1,0)="^^5^5^3100816"
^DIC(9.4,101,22,6,"PAH",99,1,1,0)="This patch addresses 2 issues:"
^DIC(9.4,101,22,6,"PAH",99,1,2,0)="1. Leave Without Pay (LWOP) is not being counted in the Night Differential"
^DIC(9.4,101,22,6,"PAH",99,1,3,0)="   calculation"
^DIC(9.4,101,22,6,"PAH",99,1,4,0)="2. Hard error occurs in Approve Signed ESRs [PRSP ESR SAP] option when"
^DIC(9.4,101,22,6,"PAH",99,1,5,0)="   the Time & Leave (T & L) unit begins with an alpha character"
^DIC(9.4,101,22,6,"PAH",100,0)="128 SEQ #115^3110127.091209^17"
^DIC(9.4,101,22,6,"PAH",100,1,0)="^^3^3^3110127"
^DIC(9.4,101,22,6,"PAH",100,1,1,0)="SUPPORT FOR NON-PATIENT IDENTITY MANAGMENT"
^DIC(9.4,101,22,6,"PAH",100,1,2,0)="Refer to patch PRS*4.0*128 in the FORUM Patch Module for a complete"
^DIC(9.4,101,22,6,"PAH",100,1,3,0)="description."
^DIC(9.4,101,22,6,"PAH",101,0)="130 SEQ #116^3110308.140129^17"
^DIC(9.4,101,22,6,"PAH",101,1,0)="^^3^3^3110308"
^DIC(9.4,101,22,6,"PAH",101,1,1,0)="This patch addresses one issue.  The Central Business Office (CBO) "
^DIC(9.4,101,22,6,"PAH",101,1,2,0)="requested additions and deletions to the ETA list of hybrids to mirror "
^DIC(9.4,101,22,6,"PAH",101,1,3,0)="the current valid list of hybrid Occupation Series & Title codes."
^DIC(9.4,101,22,6,"PAH",102,0)="124 SEQ #117^3110428.16153^17"
^DIC(9.4,101,22,6,"PAH",102,1,0)="^^3^3^3110428"
^DIC(9.4,101,22,6,"PAH",102,1,1,0)="This patch addresses 2 issues:"
^DIC(9.4,101,22,6,"PAH",102,1,2,0)="1. Employees are able to certify own timecard without security key"
^DIC(9.4,101,22,6,"PAH",102,1,3,0)="2. Site is unable to change an intermittent employee's time card"
^DIC(9.4,101,22,6,"PAH",103,0)="110 SEQ #118^3110503.115944^17"
^DIC(9.4,101,22,6,"PAH",103,1,0)="^^5^5^3110503"
^DIC(9.4,101,22,6,"PAH",103,1,1,0)="This patch addresses 3 issues:"
^DIC(9.4,101,22,6,"PAH",103,1,2,0)="1. Undefined error in option 'Display Employee Tour Hours'"
^DIC(9.4,101,22,6,"PAH",103,1,3,0)="2. Undefined error in option 'Find Mismatched Normal and Tour Hours'"
^DIC(9.4,101,22,6,"PAH",103,1,4,0)="3. Overtime/Compensatory (OT/CT) requests are erroneously approved when"
^DIC(9.4,101,22,6,"PAH",103,1,5,0)="   user enters '^' at selective disapproval."
^DIC(9.4,101,22,6,"PAH",104,0)="133 SEQ #119^3120315.144845^17"
^DIC(9.4,101,22,6,"PAH",105,0)="134 SEQ #120^3120319.141518^17"
^DIC(9.4,101,22,6,"PAH",105,1,0)="^^3^3^3120319"
^DIC(9.4,101,22,6,"PAH",105,1,1,0)="This patch contains a report for sites to identify Comp Time to"
^DIC(9.4,101,22,6,"PAH",105,1,2,0)="be reinstated to RN's covered by the National Nursing Union (NNU)"
^DIC(9.4,101,22,6,"PAH",105,1,3,0)="as dictated by  the NNU/VA Settlement ruling."
^DIC(9.4,101,22,6,"PAH",106,0)="126 SEQ #121^3120410.151611^17"
^DIC(9.4,101,22,6,"PAH",106,1,0)="^^19^19^3120410"
^DIC(9.4,101,22,6,"PAH",106,1,1,0)="This patch primarily implements new functionality within VistA's"
^DIC(9.4,101,22,6,"PAH",106,1,2,0)="Personnel and Accounting Integrated Data/ Enhanced Time and Attendance"
^DIC(9.4,101,22,6,"PAH",106,1,3,0)="(PAID/ETA) software version 4.0 to provides appropriate"
^DIC(9.4,101,22,6,"PAH",106,1,4,0)="data to VANOD (Veterans Affairs Nursing Outcomes Database) in accordance"
^DIC(9.4,101,22,6,"PAH",106,1,5,0)="with Public Law 107-135 and the OIG Recommendation 4a (annual reporting"
^DIC(9.4,101,22,6,"PAH",106,1,6,0)="requirement).  The patch also includes minor modifications to existing ETA"
^DIC(9.4,101,22,6,"PAH",106,1,7,0)="functionality to support the collection of data for the VANOD."
^DIC(9.4,101,22,6,"PAH",106,1,8,0)=" "
^DIC(9.4,101,22,6,"PAH",106,1,9,0)="This patch is dependent on the Nursing Service patch-NUR*4.0*43.  The "
^DIC(9.4,101,22,6,"PAH",106,1,10,0)="Nursing "
^DIC(9.4,101,22,6,"PAH",106,1,11,0)="service patch also supports the collection of data for the VANOD.  Patch "
^DIC(9.4,101,22,6,"PAH",106,1,12,0)="NUR*4."
^DIC(9.4,101,22,6,"PAH",106,1,13,0)="0*43 must be installed prior to patch PRS*4.0*126."
^DIC(9.4,101,22,6,"PAH",106,1,14,0)=" "
^DIC(9.4,101,22,6,"PAH",106,1,15,0)="The patch implements functionality to gather and store information related"
^DIC(9.4,101,22,6,"PAH",106,1,16,0)="to nurses providing direct patient care (as well as indirect care).  It"
^DIC(9.4,101,22,6,"PAH",106,1,17,0)="provides functionality to enter, edit, update, review, certify and store"
^DIC(9.4,101,22,6,"PAH",106,1,18,0)="this information.  The system provides the ability for a point to point "
^DIC(9.4,101,22,6,"PAH",106,1,19,0)="transfer of this information from each VistA instance to the VANOD."
^DIC(9.4,101,22,6,"PAH",107,0)="127 SEQ #122^3120829.105907^17"
^DIC(9.4,101,22,6,"PAH",107,1,0)="^^3^3^3120829"
^DIC(9.4,101,22,6,"PAH",107,1,1,0)="This patch addresses one issue:"
^DIC(9.4,101,22,6,"PAH",107,1,2,0)="1. The employee Social Security Number is displayed in full "
^DIC(9.4,101,22,6,"PAH",107,1,3,0)="   when accessing the 'List Leave Requests' report."
^DIC(9.4,101,22,6,"PAH",108,0)="135 SEQ #123^3120829.113253^17"
^DIC(9.4,101,22,6,"PAH",108,1,0)="^^3^3^3120829"
^DIC(9.4,101,22,6,"PAH",108,1,1,0)="Effective June 17, 2012, occuation series code 0679 (Medical Support "
^DIC(9.4,101,22,6,"PAH",108,1,2,0)="Assistant) will be converted to Hybrid status per Public Law 111-163,"
^DIC(9.4,101,22,6,"PAH",108,1,3,0)="the Omnibus Health Services Act."
^DIC(9.4,101,22,6,"PAH",109,0)="132 SEQ #124^3121004.170623^17"
^DIC(9.4,101,22,6,"PAH",110,0)="136 SEQ #125^3130103.113551^17"
^DIC(9.4,101,22,6,"PAH",110,1,0)="^^1^1^3130103"
^DIC(9.4,101,22,6,"PAH",110,1,1,0)="Pay period calculation does not extend past 2012 pay periods."
^DIC(9.4,101,22,6,"PAH",111,0)="139 SEQ #126^3130103.11512^17"
^DIC(9.4,101,22,6,"PAH",111,1,0)="^^3^3^3130103"
^DIC(9.4,101,22,6,"PAH",111,1,1,0)="Presidential Executive Order declares December 24, 2012 as an official "
^DIC(9.4,101,22,6,"PAH",111,1,2,0)="federal holiday.  PAID ETA must be updated to reflect this additional"
^DIC(9.4,101,22,6,"PAH",111,1,3,0)="holiday."
^DIC(9.4,101,22,6,"PAH",112,0)="137 SEQ #127^3131126.094317^17"
^DIC(9.4,101,22,6,"PAH",112,1,0)="^^4^4^3131126"
^DIC(9.4,101,22,6,"PAH",112,1,1,0)="This patch corrects two issues:"
^DIC(9.4,101,22,6,"PAH",112,1,2,0)="1.Intermittant nurse entitled to but not able to post on call."
^DIC(9.4,101,22,6,"PAH",112,1,3,0)="2.PRS MONTH CALENDAR option does not include pay periods past 2012 or"
^DIC(9.4,101,22,6,"PAH",112,1,4,0)="holidays past 2013."
^DIC(9.4,101,22,6,"PAH",113,0)="138 SEQ #128^3140107.102646^17"
^DIC(9.4,101,22,6,"PAH",113,1,0)="^^5^5^3140107"
^DIC(9.4,101,22,6,"PAH",113,1,1,0)="Occupation Series/Title codes 010106-Marriage Family Therapist and"
^DIC(9.4,101,22,6,"PAH",113,1,2,0)="010117-Licensed Mental Health Provider need to be given hybrid status. "
^DIC(9.4,101,22,6,"PAH",113,1,3,0)="Also, the Central Business Office (CBO) submitted a list of Occupation "
^DIC(9.4,101,22,6,"PAH",113,1,4,0)="Series/Title codes and have requested those be given Hybrid status "
^DIC(9.4,101,22,6,"PAH",113,1,5,0)="so that they will now receive Saturday Premium Pay."
^DIC(9.4,101,22,6,"PAH",114,0)="129 SEQ #129^3141117.143554^17"
^DIC(9.4,101,22,6,"PAH",114,1,0)="^^4^4^3141117"
^DIC(9.4,101,22,6,"PAH",114,1,1,0)="Title 5 part time employees are eligible for Sunday premium"
^DIC(9.4,101,22,6,"PAH",114,1,2,0)="pay just like the full time employees. VistA ETA has to be"
^DIC(9.4,101,22,6,"PAH",114,1,3,0)="changed to allow the part time employees to be paid Sunday"
^DIC(9.4,101,22,6,"PAH",114,1,4,0)="premium pay."
^DIC(9.4,101,22,6,"PAH",115,0)="144 SEQ #130^3150106.11493^17"
^DIC(9.4,101,22,6,"PAH",115,1,0)="^^3^3^3150106"
^DIC(9.4,101,22,6,"PAH",115,1,1,0)="Presidential Executive Order declares December 26, 2014 as an official "
^DIC(9.4,101,22,6,"PAH",115,1,2,0)="federal holiday.  PAID ETA must be updated to reflect this additional  "
^DIC(9.4,101,22,6,"PAH",115,1,3,0)="holiday."
^DIC(9.4,101,22,6,"PAH",116,0)="140 SEQ #131^3150106.125947^17"
^DIC(9.4,101,22,6,"PAH",116,1,0)="^^4^4^3150106"
^DIC(9.4,101,22,6,"PAH",116,1,1,0)="This patch addresses two issues:  "
^DIC(9.4,101,22,6,"PAH",116,1,2,0)="1.Part time Physician Memorandums have incorrect pay period "
^DIC(9.4,101,22,6,"PAH",116,1,3,0)="  designations after 2012."
^DIC(9.4,101,22,6,"PAH",116,1,4,0)="2.Two new codes need to be added to the Telework Code file."
^DIC(9.4,101,22,6,"PAH",117,0)="141 SEQ #132^3150417.092327^17"
^DIC(9.4,101,22,6,"PAH",117,1,0)="^^4^4^3150417"
^DIC(9.4,101,22,6,"PAH",117,1,1,0)="This patch addresses three issues:"
^DIC(9.4,101,22,6,"PAH",117,1,2,0)="1. Additional Occupation Series & Title codes to be added to hybrid table."
^DIC(9.4,101,22,6,"PAH",117,1,3,0)="2. Healthcare worker codes should not be included in hybrid table."
^DIC(9.4,101,22,6,"PAH",117,1,4,0)="3. Spelling error will be corrected."
^DIC(9.4,101,22,6,"PAH",118,0)="143 SEQ #133^3160407.16014^54"
^DIC(9.4,101,22,6,"PAH",118,1,0)="^^2^2^3160407"
^DIC(9.4,101,22,6,"PAH",118,1,1,0)="This patch contains updates to the Hybrid table for Occupation"
^DIC(9.4,101,22,6,"PAH",118,1,2,0)="Series/Title Codes converting to Hybrid status."
^DIC(9.4,101,22,6,"PAH",119,0)="147 SEQ #134^3161006.123725^54"
^DIC(9.4,101,22,6,"PAH",119,1,0)="^^2^2^3161006"
^DIC(9.4,101,22,6,"PAH",119,1,1,0)="This patch contains updates to the Hybrid table for Occupation"
^DIC(9.4,101,22,6,"PAH",119,1,2,0)="Series/Title Codes converting to Hybrid status."
^DIC(9.4,101,22,6,"PAH",120,0)="149 SEQ #135^3170123.14391^54"
^DIC(9.4,101,22,6,"PAH",120,1,0)="^^1^1^3170123"
^DIC(9.4,101,22,6,"PAH",120,1,1,0)="PAID ANNUITANT INDICATOR (#454.0126) SUB FILE UPDATE"
^DIC(9.4,101,22,6,"PAH",121,0)="148 SEQ #136^3170203.151002^54"
^DIC(9.4,101,22,6,"PAH",121,1,0)="^^2^2^3170203"
^DIC(9.4,101,22,6,"PAH",121,1,1,0)="This patch contains updates to the Hybrid table for Occupation"
^DIC(9.4,101,22,6,"PAH",121,1,2,0)="Series/Title Codes converting to Hybrid status."
^DIC(9.4,101,22,6,"PAH",122,0)="142 SEQ #137^3170726.130308^54"
^DIC(9.4,101,22,6,"PAH",122,1,0)="^^17^17^3170726"
^DIC(9.4,101,22,6,"PAH",122,1,1,0)="Patch PRS*4.0*142 addresses four issues:"
^DIC(9.4,101,22,6,"PAH",122,1,2,0)=" "
^DIC(9.4,101,22,6,"PAH",122,1,3,0)="1. PAID options that use PRIMLOC^PRSNUT03 to return a nurses primary "
^DIC(9.4,101,22,6,"PAH",122,1,4,0)="   assignment will return an incorrect location if that location has a "
^DIC(9.4,101,22,6,"PAH",122,1,5,0)="   similar string to another."
^DIC(9.4,101,22,6,"PAH",122,1,6,0)=" "
^DIC(9.4,101,22,6,"PAH",122,1,7,0)="2. The Mismatch Report by T&L Unit [PRSNR MISMATCHES BY T&L] option will "
^DIC(9.4,101,22,6,"PAH",122,1,8,0)="   not display the first entry in a report. "
^DIC(9.4,101,22,6,"PAH",122,1,9,0)=" "
^DIC(9.4,101,22,6,"PAH",122,1,10,0)="3. The Mismatch Report by T&L Unit [PRSNR MISMATCHES BY T&L] option will "
^DIC(9.4,101,22,6,"PAH",122,1,11,0)="   produce an undefined error when an employee has work hours associated "
^DIC(9.4,101,22,6,"PAH",122,1,12,0)="   with a non-regular tour of duty. "
^DIC(9.4,101,22,6,"PAH",122,1,13,0)=" "
^DIC(9.4,101,22,6,"PAH",122,1,14,0)="4. The All Non Direct Activity at a Nurse Location [PRSNR NURLOC NONDIR -"
^DIC(9.4,101,22,6,"PAH",122,1,15,0)="   COORD] option will produce a subscript error if an employee who worked "
^DIC(9.4,101,22,6,"PAH",122,1,16,0)="   as a nurse during the date range of the report is not currently a "
^DIC(9.4,101,22,6,"PAH",122,1,17,0)="   nurse."
^DIC(9.4,101,22,6,"PAH",123,0)="146 SEQ #138^3170830.145108^54"
^DIC(9.4,101,22,6,"PAH",123,1,0)="^^10^10^3170830"
^DIC(9.4,101,22,6,"PAH",123,1,1,0)="Patch PRS*4.0*146 addresses two issues:"
^DIC(9.4,101,22,6,"PAH",123,1,2,0)=" "
^DIC(9.4,101,22,6,"PAH",123,1,3,0)="1. A DD(Data Dictionary) change is needed for the UNIFORM ALLOWANCE AMT "
^DIC(9.4,101,22,6,"PAH",123,1,4,0)="   CPPD (#536) field of the PAID EMPLOYEE (#450) file. The same change"
^DIC(9.4,101,22,6,"PAH",123,1,5,0)="   is also needed for the UNIFORM ALLOWANCE AMT CPPD (#109) field of the "
^DIC(9.4,101,22,6,"PAH",123,1,6,0)="   of the EMPLOYEE (#459.01) sub-file of the PAID PAYRUN DATA (#459)"
^DIC(9.4,101,22,6,"PAH",123,1,7,0)="   file."
^DIC(9.4,101,22,6,"PAH",123,1,8,0)=" "
^DIC(9.4,101,22,6,"PAH",123,1,9,0)="2. The NURSE T&L UNIT (#15) field of the POC DAILY TIME EXTRACTION "
^DIC(9.4,101,22,6,"PAH",123,1,10,0)="   (#451.7) file is storing information incorrectly."
^DIC(9.4,101,22,6,"PAH",124,0)="150 SEQ #139^3171102.151912^54"
^DIC(9.4,101,22,6,"PAH",124,1,0)="^^11^11^3171102"
^DIC(9.4,101,22,6,"PAH",124,1,1,0)="This patch will address three issues:"
^DIC(9.4,101,22,6,"PAH",124,1,2,0)=" "
^DIC(9.4,101,22,6,"PAH",124,1,3,0)="1. A subscript error occurs in the Memoranda Report [PRSP PS MR] "
^DIC(9.4,101,22,6,"PAH",124,1,4,0)="   option after a site converts to the Veterans Affairs Time and "
^DIC(9.4,101,22,6,"PAH",124,1,5,0)="   Attendance System (VATAS)."
^DIC(9.4,101,22,6,"PAH",124,1,6,0)=" "
^DIC(9.4,101,22,6,"PAH",124,1,7,0)="2. The Memoranda Report [PRSP PS MR] option does not display "
^DIC(9.4,101,22,6,"PAH",124,1,8,0)="   2018 pay periods."
^DIC(9.4,101,22,6,"PAH",124,1,9,0)=" "
^DIC(9.4,101,22,6,"PAH",124,1,10,0)="3. The Monthly Calendar [PRS MONTH CALENDAR] is only coded to"
^DIC(9.4,101,22,6,"PAH",124,1,11,0)="   calculate pay periods through 2017, and holidays through 2018."
^DIC(9.4,101,22,6,"PAH",125,0)="152 SEQ #140^3171201.124439^54"
^DIC(9.4,101,22,6,"PAH",125,1,0)="^^2^2^3171201"
^DIC(9.4,101,22,6,"PAH",125,1,1,0)="This patch contains updates to the Hybrid table for Occupation"
^DIC(9.4,101,22,6,"PAH",125,1,2,0)="Series/Title Codes converting to Hybrid status."
^DIC(9.4,101,22,6,"PAH",126,0)="153 SEQ #141^3180130.151252^54"
^DIC(9.4,101,22,6,"PAH",126,1,0)="^^2^2^3180130"
^DIC(9.4,101,22,6,"PAH",126,1,1,0)="This patch contains updates to the Hybrid table for Occupation"
^DIC(9.4,101,22,6,"PAH",126,1,2,0)="Series/Title Codes converting to Hybrid status."
^DIC(9.4,101,22,6,"PAH",127,0)="151 SEQ #142^3180301.15103^54"
^DIC(9.4,101,22,6,"PAH",127,1,0)="^^8^8^3180301"
^DIC(9.4,101,22,6,"PAH",127,1,1,0)=" This patch will address two issues:"
^DIC(9.4,101,22,6,"PAH",127,1,2,0)=" "
^DIC(9.4,101,22,6,"PAH",127,1,3,0)=" 1. An Electronic Subsidiary Record (ESR) cannot be approved for"
^DIC(9.4,101,22,6,"PAH",127,1,4,0)="    an employee name with multiple Internal Entry Numbers (IENs)"
^DIC(9.4,101,22,6,"PAH",127,1,5,0)="    in the PAID EMPLOYEE (#450) file."
^DIC(9.4,101,22,6,"PAH",127,1,6,0)="  "
^DIC(9.4,101,22,6,"PAH",127,1,7,0)=" 2. Timekeepers cannot ENTER Overtime for a T&L when an inactive"
^DIC(9.4,101,22,6,"PAH",127,1,8,0)="    T&L shares the same number."
^DIC(9.4,101,22,6,"PAH",128,0)="154 SEQ #143^3180424.162621^54"
^DIC(9.4,101,22,6,"PAH",128,1,0)="^^5^5^3180424"
^DIC(9.4,101,22,6,"PAH",128,1,1,0)="This patch corrects one issue:"
^DIC(9.4,101,22,6,"PAH",128,1,2,0)=" "
^DIC(9.4,101,22,6,"PAH",128,1,3,0)="1. The PAID - Expenditure Report will not work after a"
^DIC(9.4,101,22,6,"PAH",128,1,4,0)="   site moves to the Veterans Affairs Time and Attendance "
^DIC(9.4,101,22,6,"PAH",128,1,5,0)="   System (VATAS)."
^DIC(9.4,101,22,6,"PAH",129,0)="155 SEQ #144^3180706.131819^54"
^DIC(9.4,101,22,6,"PAH",129,1,0)="^^2^2^3180706"
^DIC(9.4,101,22,6,"PAH",129,1,1,0)="This patch contains updates to the Hybrid table for Occupation"
^DIC(9.4,101,22,6,"PAH",129,1,2,0)="Series/Title Codes converting to Hybrid status."
^DIC(9.4,101,22,6,"PAH",130,0)="156 SEQ #145^3180906.155203^54"
^DIC(9.4,101,22,6,"PAH",130,1,0)="^^2^2^3180906"
^DIC(9.4,101,22,6,"PAH",130,1,1,0)="This patch contains updates to the Hybrid table for Occupation"
^DIC(9.4,101,22,6,"PAH",130,1,2,0)="Series/Title Codes converting to Hybrid status."
