^DIC(9.4,100,22,15,"PAH",37,1,227,0)="     ROUTINE SUMMARY:"
^DIC(9.4,100,22,15,"PAH",37,1,228,0)="     ================"
^DIC(9.4,100,22,15,"PAH",37,1,229,0)="     The second line of the routine now looks like:"
^DIC(9.4,100,22,15,"PAH",37,1,230,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,231,0)="     <tab>   ;;5.01;MENTAL HEALTH;**[patch list]**;Dec 30, 1994"
^DIC(9.4,100,22,15,"PAH",37,1,232,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,233,0)="                                     Checksum Values"
^DIC(9.4,100,22,15,"PAH",37,1,234,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,235,0)="     Routine Name    Before Patch        After Patch     Patch List"
^DIC(9.4,100,22,15,"PAH",37,1,236,0)="     ------------    ------------        -----------     -----------"
^DIC(9.4,100,22,15,"PAH",37,1,237,0)="     YSMTI2          N/A                 7197346         62"
