^DIC(9.4,43,"INIT")="VALMPT^2960613.141811"
^DIC(9.4,43,"PRE")="VALMPP^2960613.141738"
^DIC(9.4,43,"VERSION")="1.0"
^DIC(9.4,44,0)="CONSULT/REQUEST TRACKING^GMRC^CONSULTS/REQUESTS"
^DIC(9.4,44,1,0)="1^9.41A^2^2^3240517^^^^"
^DIC(9.4,44,1,1,0)="This package provides the tools needed for Consults and Requests to be"
^DIC(9.4,44,1,2,0)="ordered via OE/RR and then tracked by the service receiving the order."
^DIC(9.4,44,4,0)="^9.44PA^3^3"
^DIC(9.4,44,4,1,0)=123
^DIC(9.4,44,4,1,222)="y^^^^^^n"
^DIC(9.4,44,4,1,222.7)="N"
^DIC(9.4,44,4,1,222.9)="N"
^DIC(9.4,44,4,2,0)=123.1
^DIC(9.4,44,4,2,222)="y^^^^^^y^o^n"
^DIC(9.4,44,4,2,222.7)="Y"
^DIC(9.4,44,4,2,222.9)="N"
^DIC(9.4,44,4,3,0)=123.5
^DIC(9.4,44,4,3,222)="y^^^^^^y^o^n"
^DIC(9.4,44,4,3,222.7)="N"
^DIC(9.4,44,4,3,222.9)="N"
^DIC(9.4,44,4,"B",123,1)=""
^DIC(9.4,44,4,"B",123.1,2)=""
^DIC(9.4,44,4,"B",123.5,3)=""
^DIC(9.4,44,5)="SLC"
^DIC(9.4,44,7)="^^I"
^DIC(9.4,44,9)="^"
^DIC(9.4,44,11)="123^123.5"
^DIC(9.4,44,14,0)="^9.4014^2^2"
