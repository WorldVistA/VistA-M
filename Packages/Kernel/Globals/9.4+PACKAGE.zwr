^DIC(9.4,3,22,21,"PAH",182,1,110,0)="Clearance - 04/05/2002"
^DIC(9.4,3,22,21,"PAH",182,1,111,0)=" "
^DIC(9.4,3,22,21,"PAH",182,1,112,0)=" "
^DIC(9.4,3,22,21,"PAH",182,1,113,0)="Installation Instructions:"
^DIC(9.4,3,22,21,"PAH",182,1,114,0)=" "
^DIC(9.4,3,22,21,"PAH",182,1,115,0)="     1.   Users ARE allowed to be on the system during the"
^DIC(9.4,3,22,21,"PAH",182,1,116,0)="     installation but if you have not recently run a scheduled purge of"
^DIC(9.4,3,22,21,"PAH",182,1,117,0)="     old alerts you may want to schedule the installation for off hours."
^DIC(9.4,3,22,21,"PAH",182,1,118,0)=" "
^DIC(9.4,3,22,21,"PAH",182,1,119,0)="     2.   DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",182,1,120,0)="     so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",182,1,121,0)=" "
^DIC(9.4,3,22,21,"PAH",182,1,122,0)="     3.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,3,22,21,"PAH",182,1,123,0)="     This option will load the KIDS (Kernel Installation and Distribution"
^DIC(9.4,3,22,21,"PAH",182,1,124,0)="     System) package onto your system."
^DIC(9.4,3,22,21,"PAH",182,1,125,0)=" "
^DIC(9.4,3,22,21,"PAH",182,1,126,0)="     4.   You DO NOT need to stop TaskMan or the background filers."
^DIC(9.4,3,22,21,"PAH",182,1,127,0)=" "
^DIC(9.4,3,22,21,"PAH",182,1,128,0)="     5.   The patch has now been loaded into a transport global on your"
^DIC(9.4,3,22,21,"PAH",182,1,129,0)="     system.  On the KIDS menu, select the 'Installation' menu and use"
^DIC(9.4,3,22,21,"PAH",182,1,130,0)="     the following options:"
^DIC(9.4,3,22,21,"PAH",182,1,131,0)="           Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",182,1,132,0)="           Print Transport Global"
^DIC(9.4,3,22,21,"PAH",182,1,133,0)="           Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",182,1,134,0)="           Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",182,1,135,0)="           Return to Programmers Prompt and use ""D ^XPDKRN"":"
^DIC(9.4,3,22,21,"PAH",182,1,136,0)="           Select KIDS OPTION: Install"
^DIC(9.4,3,22,21,"PAH",182,1,137,0)="                               ======="
^DIC(9.4,3,22,21,"PAH",182,1,138,0)="            Install Package(s)"
^DIC(9.4,3,22,21,"PAH",182,1,139,0)="            Select INSTALL NAME: XU*8.0*173"
^DIC(9.4,3,22,21,"PAH",182,1,140,0)="                                 =========="
^DIC(9.4,3,22,21,"PAH",182,1,141,0)=" "
^DIC(9.4,3,22,21,"PAH",182,1,142,0)="            Checking Install for Package XU*8.0*173"
^DIC(9.4,3,22,21,"PAH",182,1,143,0)=" "
^DIC(9.4,3,22,21,"PAH",182,1,144,0)="            Install Questions for XU*8.0*173"
^DIC(9.4,3,22,21,"PAH",182,1,145,0)=" "
^DIC(9.4,3,22,21,"PAH",182,1,146,0)="            Incoming Files:"
^DIC(9.4,3,22,21,"PAH",182,1,147,0)=" "
^DIC(9.4,3,22,21,"PAH",182,1,148,0)=" "
^DIC(9.4,3,22,21,"PAH",182,1,149,0)="               8992      ALERT  (Partial Definition)"
^DIC(9.4,3,22,21,"PAH",182,1,150,0)="            Note:  You already have the 'ALERT' File."
^DIC(9.4,3,22,21,"PAH",182,1,151,0)=" "
^DIC(9.4,3,22,21,"PAH",182,1,152,0)="            Want KIDS to Rebuild Menu Trees Upon Completion of Install? "
^DIC(9.4,3,22,21,"PAH",182,1,153,0)="YES// NO"
^DIC(9.4,3,22,21,"PAH",182,1,154,0)="      =="
^DIC(9.4,3,22,21,"PAH",182,1,155,0)="            Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",182,1,156,0)="                                                                  =="
^DIC(9.4,3,22,21,"PAH",182,1,157,0)="            Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,3,22,21,"PAH",182,1,158,0)="Protocols? YES// NO"
^DIC(9.4,3,22,21,"PAH",182,1,159,0)="                 =="
^DIC(9.4,3,22,21,"PAH",182,1,160,0)=" "
^DIC(9.4,3,22,21,"PAH",182,1,161,0)="     6.  AXP Sites - Answer 'NO' to the question 'Want to MOVE"
^DIC(9.4,3,22,21,"PAH",182,1,162,0)="     routines to other CPUs?'."
^DIC(9.4,3,22,21,"PAH",182,1,163,0)=" "
^DIC(9.4,3,22,21,"PAH",182,1,164,0)="     7.  If the routines were unmapped as part of step 2, they should be"
^DIC(9.4,3,22,21,"PAH",182,1,165,0)="     returned to the mapped set once the installation has run to"
^DIC(9.4,3,22,21,"PAH",182,1,166,0)="     completion."
^DIC(9.4,3,22,21,"PAH",183,0)="226 SEQ #190^3020516^1"
^DIC(9.4,3,22,21,"PAH",184,0)="231 SEQ #191^3020516^1"
^DIC(9.4,3,22,21,"PAH",185,0)="235 SEQ #192^3020605^1"
^DIC(9.4,3,22,21,"PAH",186,0)="207 SEQ #193^3020626^1"
^DIC(9.4,3,22,21,"PAH",186,1,0)="^^2^2^3020626"
^DIC(9.4,3,22,21,"PAH",186,1,1,0)="For the patch description see the patch message or the patch module on"
^DIC(9.4,3,22,21,"PAH",186,1,2,0)="Forum."
^DIC(9.4,3,22,21,"PAH",187,0)="234^3020626^1"
^DIC(9.4,3,22,21,"PAH",187,1,0)="^^63^63^3020626"
^DIC(9.4,3,22,21,"PAH",187,1,1,0)="Associated patches: (v)SD*5.3*262 install with patch         `XU*8*234'"
^DIC(9.4,3,22,21,"PAH",187,1,2,0)="                    (v)DG*5.3*447   install with patch       `XU*8*234'"
^DIC(9.4,3,22,21,"PAH",187,1,3,0)="                    (v)YS*5.01*71 install with patch         `XU*8*234'"
^DIC(9.4,3,22,21,"PAH",187,1,4,0)="  "
^DIC(9.4,3,22,21,"PAH",187,1,5,0)=" 1. This patch provides a change in the ""XUS KEY CHECK"" RPC necessary"
^DIC(9.4,3,22,21,"PAH",187,1,6,0)="    for other applications to use the RPC to full advantage.  Whereas"
^DIC(9.4,3,22,21,"PAH",187,1,7,0)="    the RPC would originally return an indicator of whether the current"
^DIC(9.4,3,22,21,"PAH",187,1,8,0)="    user owned the key or keys, this adds an additional argument which"
^DIC(9.4,3,22,21,"PAH",187,1,9,0)="    can be used to specify another user's DUZ value, and the check will"
^DIC(9.4,3,22,21,"PAH",187,1,10,0)="    be performed on the key(s) for that user.  If this argument is not"
^DIC(9.4,3,22,21,"PAH",187,1,11,0)="    specified, it will perform the test for the current user, as it has "
^DIC(9.4,3,22,21,"PAH",187,1,12,0)="    done in the past."
^DIC(9.4,3,22,21,"PAH",187,1,13,0)="  "
^DIC(9.4,3,22,21,"PAH",187,1,14,0)="    Generated for Mental Health Assistant GUI, patch YS*5.01*71 at the "
^DIC(9.4,3,22,21,"PAH",187,1,15,0)="    request of the Database Administrator."
^DIC(9.4,3,22,21,"PAH",187,1,16,0)="  "
^DIC(9.4,3,22,21,"PAH",187,1,17,0)=" NOISs V01-1201-N0503"
^DIC(9.4,3,22,21,"PAH",187,1,18,0)=" E3Rs none"
^DIC(9.4,3,22,21,"PAH",187,1,19,0)="  "
