^DIC(9.4,4,22,1,"PAH",79,1,30,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",79,1,31,0)=" "
^DIC(9.4,4,22,1,"PAH",79,1,32,0)="              Before          After"
