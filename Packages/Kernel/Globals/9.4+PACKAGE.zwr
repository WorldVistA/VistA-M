^DIC(9.4,175,22,2,"PAH",129,1,1,0)="VistA Imaging Capture 189"
^DIC(9.4,175,22,2,"PAH",129,1,2,0)="1 - Synchronize Patient with CPRS when CCOW is not active on the Desktop"
^DIC(9.4,175,22,2,"PAH",129,1,3,0)="  This functionality stopped working in a previous patch.  It is fixed in "
^DIC(9.4,175,22,2,"PAH",129,1,4,0)="  this version."
^DIC(9.4,175,22,2,"PAH",129,1,5,0)="  "
^DIC(9.4,175,22,2,"PAH",129,1,6,0)="2 - Duplicate Capture issue."
^DIC(9.4,175,22,2,"PAH",129,1,7,0)="  When Capturing an Image to an image group, if user clicks on capture"
^DIC(9.4,175,22,2,"PAH",129,1,8,0)="  a second time "
^DIC(9.4,175,22,2,"PAH",129,1,9,0)="  The same image is captured twice. "
^DIC(9.4,175,22,2,"PAH",129,1,10,0)="  "
^DIC(9.4,175,22,2,"PAH",129,1,11,0)="3 - The List of patient consults for Teledermatology does not display"
^DIC(9.4,175,22,2,"PAH",129,1,12,0)="  This functionality stopped working in a previous patch.  It is fixed in "
^DIC(9.4,175,22,2,"PAH",129,1,13,0)="  this patch. "
^DIC(9.4,175,22,2,"PAH",129,1,14,0)="  "
