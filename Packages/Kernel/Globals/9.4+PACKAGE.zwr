^DIC(9.4,120,22,12,"PAH",42,0)="49^3020626^1"
^DIC(9.4,120,22,12,"PAH",43,0)="60 SEQ #47^3020710^1"
^DIC(9.4,120,22,12,"PAH",44,0)="51 SEQ #48^3020724^1"
^DIC(9.4,120,22,12,"PAH",45,0)="59 SEQ #49^3020814^1"
^DIC(9.4,120,22,12,"PAH",46,0)="55 SEQ #50^3021025^1"
^DIC(9.4,120,22,12,"PAH",46,1,0)="^^1^1^3021025"
^DIC(9.4,120,22,12,"PAH",46,1,1,0)="See FORUM patch module for full description."
^DIC(9.4,120,22,12,"PAH",47,0)="66 SEQ #51^3021025^1"
^DIC(9.4,120,22,12,"PAH",48,0)="64 SEQ #52^3021025^1"
^DIC(9.4,120,22,12,"PAH",48,1,0)="^^2^2^3021025"
^DIC(9.4,120,22,12,"PAH",48,1,1,0)="Z06 Transmission problem:"
^DIC(9.4,120,22,12,"PAH",48,1,2,0)="ORF+^IVMPRECZ Undefined variable UPMTS"
^DIC(9.4,120,22,12,"PAH",49,0)="63 SEQ #53^3021116^1"
^DIC(9.4,120,22,12,"PAH",49,1,0)="^^7^7^3021116"
^DIC(9.4,120,22,12,"PAH",49,1,1,0)="Within several HL7 messaging programs there is a call to invoke the "
^DIC(9.4,120,22,12,"PAH",49,1,2,0)="process to send an acknowledgment back to the HEC that is using the "
^DIC(9.4,120,22,12,"PAH",49,1,3,0)="wrong variable.  Also several programs do not clean up the temporary "
^DIC(9.4,120,22,12,"PAH",49,1,4,0)="global -^TMP prior to and/or after the creation of a query."
^DIC(9.4,120,22,12,"PAH",49,1,5,0)=" "
^DIC(9.4,120,22,12,"PAH",49,1,6,0)="Patch DG*5.3*472 is a required build for IVM*2.0*63 and needs to be "
^DIC(9.4,120,22,12,"PAH",49,1,7,0)="installed first."
^DIC(9.4,120,22,12,"PAH",50,0)="58^3021209^1"
^DIC(9.4,120,22,12,"PAH",51,0)="62^3021220^1"
^DIC(9.4,120,22,12,"PAH",52,0)="68 SEQ #57^3030109^1"
^DIC(9.4,120,22,12,"PAH",53,0)="67^3030204^1"
^DIC(9.4,120,22,12,"PAH",54,0)="69 SEQ #59^3030329^1"
^DIC(9.4,120,22,12,"PAH",55,0)="77^3030417^1"
^DIC(9.4,120,22,12,"PAH",55,1,0)="^^2^2^3030417"
^DIC(9.4,120,22,12,"PAH",55,1,1,0)="ADDITIONAL ENHANCEMENTS REQUIRED TO HANDLE SENDING AND RECEIVING OF OTHER"
^DIC(9.4,120,22,12,"PAH",55,1,2,0)="HL7 MESSAGES BASED UPON RECEIPT OF A Z06 MESSAGE."
^DIC(9.4,120,22,12,"PAH",56,0)="73 SEQ #61^3030430^1"
^DIC(9.4,120,22,12,"PAH",56,1,0)="^^1^1^3030430"
^DIC(9.4,120,22,12,"PAH",56,1,1,0)="IVM*2.0*73 Kids Build"
^DIC(9.4,120,22,12,"PAH",57,0)="78^3030430^1"
^DIC(9.4,120,22,12,"PAH",57,1,0)="^^6^6^3030430"
^DIC(9.4,120,22,12,"PAH",57,1,1,0)="THIS IS AN EMERGENCY FIX TO PATCH IVM*2*77"
^DIC(9.4,120,22,12,"PAH",57,1,2,0)=" "
^DIC(9.4,120,22,12,"PAH",57,1,3,0)="THE IP ADDRESS FOR THE Z09 SERVER PRTOTCOL WILL BE CHANGED"
^DIC(9.4,120,22,12,"PAH",57,1,4,0)=" "
^DIC(9.4,120,22,12,"PAH",57,1,5,0)="THE SENDING OF Z09 TO THE APPROPRIATE HEC (LEGACY VS. EDB) WILL BE"
^DIC(9.4,120,22,12,"PAH",57,1,6,0)="CORRECTED."
^DIC(9.4,120,22,12,"PAH",58,0)="76^3030520^1"
^DIC(9.4,120,22,12,"PAH",59,0)="71 SEQ #64^3030520^1"
^DIC(9.4,120,22,12,"PAH",59,1,0)="^^11^11^3030520"
^DIC(9.4,120,22,12,"PAH",59,1,1,0)="The problem is that when the Means Test Signature (Z06) is transmitted to "
^DIC(9.4,120,22,12,"PAH",59,1,2,0)="the site that performed the Means Test, and the test did not upload for "
^DIC(9.4,120,22,12,"PAH",59,1,3,0)="any reason, the ""IVM - MEANS TEST UPLOAD"" Bulletin gives the following "
^DIC(9.4,120,22,12,"PAH",59,1,4,0)="message:"
^DIC(9.4,120,22,12,"PAH",59,1,5,0)=" "
^DIC(9.4,120,22,12,"PAH",59,1,6,0)="The following error occured when an Income Verification Match"
^DIC(9.4,120,22,12,"PAH",59,1,7,0)="verified Means Test was being uploaded for the following patient:"
^DIC(9.4,120,22,12,"PAH",59,1,8,0)=" "
^DIC(9.4,120,22,12,"PAH",59,1,9,0)="    NAME:     Xxxxxxx,Xxxxxxx"
^DIC(9.4,120,22,12,"PAH",59,1,10,0)="    ID:       XXX-XX-XXXX"
^DIC(9.4,120,22,12,"PAH",59,1,11,0)="    ERROR:    Means Test of NOV 28,2002 not in DHCP."
^DIC(9.4,120,22,12,"PAH",60,0)="72 SEQ #65^3030628^1"
^DIC(9.4,120,22,12,"PAH",61,0)="75^3030628^1"
^DIC(9.4,120,22,12,"PAH",61,1,0)="^^1^1^3030628"
^DIC(9.4,120,22,12,"PAH",61,1,1,0)="GEOGRAPHIC MEANS TESTING - PHASE II"
^DIC(9.4,120,22,12,"PAH",62,0)="74 SEQ #67^3030802^1"
^DIC(9.4,120,22,12,"PAH",63,0)="81 SEQ #68^3030802^1"
^DIC(9.4,120,22,12,"PAH",64,0)="83 SEQ #69^3030821^1"
^DIC(9.4,120,22,12,"PAH",65,0)="86 SEQ #70^3030912^1"
^DIC(9.4,120,22,12,"PAH",66,0)="82 SEQ #71^3030912^1"
^DIC(9.4,120,22,12,"PAH",67,0)="84 SEQ #72^3030912^1"
