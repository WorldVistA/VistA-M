^DIC(9.4,70,22,2,"PAH",18,1,379,0)="end of file list"
^DIC(9.4,70,22,2,"PAH",19,0)="16 SEQ #19^3020207^1"
^DIC(9.4,70,22,2,"PAH",19,1,0)="^^117^117^3020207"
^DIC(9.4,70,22,2,"PAH",19,1,1,0)="NOIS: WCO-0300-50643"
^DIC(9.4,70,22,2,"PAH",19,1,2,0)="      XWBTCPC"
^DIC(9.4,70,22,2,"PAH",19,1,3,0)="  Under Cache 3.2 error trapping conditions, the return of control wouldn't go "
^DIC(9.4,70,22,2,"PAH",19,1,4,0)="  to the correct routine, resulting in a run-away job. Fixed by being explicit "
^DIC(9.4,70,22,2,"PAH",19,1,5,0)="  about the routine to return to."
^DIC(9.4,70,22,2,"PAH",19,1,6,0)="                        "
^DIC(9.4,70,22,2,"PAH",19,1,7,0)="  When a READ or WRITE error occurs, the error trap code was trying to send "
^DIC(9.4,70,22,2,"PAH",19,1,8,0)="  an error message to the client. This caused an error, which resulted in a "
^DIC(9.4,70,22,2,"PAH",19,1,9,0)="  second error being logged."
^DIC(9.4,70,22,2,"PAH",19,1,10,0)="                        "
^DIC(9.4,70,22,2,"PAH",19,1,11,0)="  The calls to RTL were remove from logging the broker code. If Response Time "
^DIC(9.4,70,22,2,"PAH",19,1,12,0)="  Logging is on, then the RPC will still be logged."
^DIC(9.4,70,22,2,"PAH",19,1,13,0)=""
^DIC(9.4,70,22,2,"PAH",19,1,14,0)="  Worked with the NVS to use the correct call to see that Broker connection"
^DIC(9.4,70,22,2,"PAH",19,1,15,0)="  got registered as client server so they all connections from one IP address"
^DIC(9.4,70,22,2,"PAH",19,1,16,0)="  could share Cache one licenses."
^DIC(9.4,70,22,2,"PAH",19,1,17,0)="  "
^DIC(9.4,70,22,2,"PAH",19,1,18,0)="  A change was made to check the IP address of the PEER and to use that if"
^DIC(9.4,70,22,2,"PAH",19,1,19,0)="  different than the IP address in the header.  This allows the use of NAT"
^DIC(9.4,70,22,2,"PAH",19,1,20,0)="  translation."
^DIC(9.4,70,22,2,"PAH",19,1,21,0)=""
^DIC(9.4,70,22,2,"PAH",19,1,22,0)="NOIS: CLL-0301-40678"
^DIC(9.4,70,22,2,"PAH",19,1,23,0)="      JAC-0301-70277"
^DIC(9.4,70,22,2,"PAH",19,1,24,0)="      XWBTCPC"
^DIC(9.4,70,22,2,"PAH",19,1,25,0)="   If an application Newed the XWBOS variable and then experienced an error,"
^DIC(9.4,70,22,2,"PAH",19,1,26,0)="   it would cause a second error in the error module of the Broker.  This "
^DIC(9.4,70,22,2,"PAH",19,1,27,0)="   has been fixed by setting the value of XWBOS in the error trap module."
^DIC(9.4,70,22,2,"PAH",19,1,28,0)=""
^DIC(9.4,70,22,2,"PAH",19,1,29,0)="NOIS: KAN-0201-40992"
^DIC(9.4,70,22,2,"PAH",19,1,30,0)="      XWBTCPL"
^DIC(9.4,70,22,2,"PAH",19,1,31,0)="   If a connection was made to the RPC Broker listener port that failed to "
^DIC(9.4,70,22,2,"PAH",19,1,32,0)="   send the correct information, this could cause the listener to fail to "
^DIC(9.4,70,22,2,"PAH",19,1,33,0)="   detect other connection requests.  This has been fixed by changing the "
^DIC(9.4,70,22,2,"PAH",19,1,34,0)="   timeout on the read and resetting the port if this happens."
^DIC(9.4,70,22,2,"PAH",19,1,35,0)=""
^DIC(9.4,70,22,2,"PAH",19,1,36,0)="Routine Summary"
^DIC(9.4,70,22,2,"PAH",19,1,37,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,70,22,2,"PAH",19,1,38,0)="of these routines now looks like:"
^DIC(9.4,70,22,2,"PAH",19,1,39,0)=" ;;1.1;RPC BROKER;<patchlist>;Mar 28, 1997"
^DIC(9.4,70,22,2,"PAH",19,1,40,0)=""
^DIC(9.4,70,22,2,"PAH",19,1,41,0)="                 Checksum"
^DIC(9.4,70,22,2,"PAH",19,1,42,0)="Routine         Old       New      2nd Line"
^DIC(9.4,70,22,2,"PAH",19,1,43,0)="XWBBRK        5912545   5552318    **2,4,10,16**"
^DIC(9.4,70,22,2,"PAH",19,1,44,0)="XWBTCPC       7568523   7379419    **2,5,4,6,9,16**"
^DIC(9.4,70,22,2,"PAH",19,1,45,0)="XWBTCPL       9128997  10414009    **1,7,9,15,16**"
^DIC(9.4,70,22,2,"PAH",19,1,46,0)=""
^DIC(9.4,70,22,2,"PAH",19,1,47,0)="List of preceding patches: 10, 15"
^DIC(9.4,70,22,2,"PAH",19,1,48,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,70,22,2,"PAH",19,1,49,0)=""
^DIC(9.4,70,22,2,"PAH",19,1,50,0)="========================================================================="
^DIC(9.4,70,22,2,"PAH",19,1,51,0)="Installation:"
^DIC(9.4,70,22,2,"PAH",19,1,52,0)=""
^DIC(9.4,70,22,2,"PAH",19,1,53,0)="   1.  During the installation, do not run any RPC-Broker-based Client/Server"
^DIC(9.4,70,22,2,"PAH",19,1,54,0)="       software (e.g., CPRS, PCMM, BCMA).  No Broker-based client/server "
^DIC(9.4,70,22,2,"PAH",19,1,55,0)="       software should be running while installing this patch on the "
^DIC(9.4,70,22,2,"PAH",19,1,56,0)="       server.  You can identify these jobs by checking the system status "
^DIC(9.4,70,22,2,"PAH",19,1,57,0)="       and verifying if any XWBTCPC routines are running (i.e., Broker "
^DIC(9.4,70,22,2,"PAH",19,1,58,0)="       Handler).  If you find any of these jobs running on the system,  "
^DIC(9.4,70,22,2,"PAH",19,1,59,0)="       notify users to logoff or FORCEX the jobs.  Active users may get "
^DIC(9.4,70,22,2,"PAH",19,1,60,0)="       NOSOURCE or CLOBBER errors.  "
^DIC(9.4,70,22,2,"PAH",19,1,61,0)=" "
^DIC(9.4,70,22,2,"PAH",19,1,62,0)="   2.  Stop the Broker Listener on the server.  Do this by first "
^DIC(9.4,70,22,2,"PAH",19,1,63,0)="       checking the system status, then verifying if the XWBTCPL "
^DIC(9.4,70,22,2,"PAH",19,1,64,0)="       routine is running (i.e., Broker Listener).  If you find this "
^DIC(9.4,70,22,2,"PAH",19,1,65,0)="       routine running on your system, STOP IT.  To stop the Broker "
^DIC(9.4,70,22,2,"PAH",19,1,66,0)="       Listener, do the following: "
^DIC(9.4,70,22,2,"PAH",19,1,67,0)=" "
^DIC(9.4,70,22,2,"PAH",19,1,68,0)="           a.  Log into your M server.                   "
^DIC(9.4,70,22,2,"PAH",19,1,69,0)="           b.  Enter the following command at the M prompt: "
^DIC(9.4,70,22,2,"PAH",19,1,70,0)=" "
^DIC(9.4,70,22,2,"PAH",19,1,71,0)="               >D STOP^XWBTCP(Listener port) "
^DIC(9.4,70,22,2,"PAH",19,1,72,0)="               (Typically, the Listener port is 9200) "
^DIC(9.4,70,22,2,"PAH",19,1,73,0)=""
^DIC(9.4,70,22,2,"PAH",19,1,74,0)="   3.  Stop any users that are using Broker applications. This applies"
^DIC(9.4,70,22,2,"PAH",19,1,75,0)="       to any job in XWBTCPC or in CPRS."
^DIC(9.4,70,22,2,"PAH",19,1,76,0)="       "
^DIC(9.4,70,22,2,"PAH",19,1,77,0)="   4.  Broker routines are not usually mapped on systems that allow mapping."
^DIC(9.4,70,22,2,"PAH",19,1,78,0)="       So, you will probably not have to disable mapping."
^DIC(9.4,70,22,2,"PAH",19,1,79,0)=""
^DIC(9.4,70,22,2,"PAH",19,1,80,0)="   5.  Use the Kernel Option 'INSTALL/CHECK MESSAGE' located on the "
^DIC(9.4,70,22,2,"PAH",19,1,81,0)="       PackMan menu. This option will load the KIDS package onto your "
^DIC(9.4,70,22,2,"PAH",19,1,82,0)="       system."
^DIC(9.4,70,22,2,"PAH",19,1,83,0)=""
^DIC(9.4,70,22,2,"PAH",19,1,84,0)="   6.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,70,22,2,"PAH",19,1,85,0)="       system. Now you need to use KIDS to install the Transport global."
^DIC(9.4,70,22,2,"PAH",19,1,86,0)="       On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",19,1,87,0)="       options:"
^DIC(9.4,70,22,2,"PAH",19,1,88,0)=""
^DIC(9.4,70,22,2,"PAH",19,1,89,0)="          Verify Checksums in Transport Global"
^DIC(9.4,70,22,2,"PAH",19,1,90,0)="          Print Transport Global"
^DIC(9.4,70,22,2,"PAH",19,1,91,0)="          Compare Transport Global to Current System"
^DIC(9.4,70,22,2,"PAH",19,1,92,0)="          Backup a Transport Global"
^DIC(9.4,70,22,2,"PAH",19,1,93,0)=""
^DIC(9.4,70,22,2,"PAH",19,1,94,0)="   7.  On the KIDS Installation menu, use the option Install Package(s)."
^DIC(9.4,70,22,2,"PAH",19,1,95,0)="       Respond to the prompts as follows:"
^DIC(9.4,70,22,2,"PAH",19,1,96,0)="       "
^DIC(9.4,70,22,2,"PAH",19,1,97,0)="       Select INSTALL NAME:  XWB*1.1*16"
^DIC(9.4,70,22,2,"PAH",19,1,98,0)="                             =========="
^DIC(9.4,70,22,2,"PAH",19,1,99,0)="                             "
^DIC(9.4,70,22,2,"PAH",19,1,100,0)="       Want KIDS to INHIBIT LOGONs during the install? YES//"
^DIC(9.4,70,22,2,"PAH",19,1,101,0)="                              "
^DIC(9.4,70,22,2,"PAH",19,1,102,0)="       No Options or Protocols need to be placed out-of-order."
^DIC(9.4,70,22,2,"PAH",19,1,103,0)="       Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,70,22,2,"PAH",19,1,104,0)="                                                                       =="
^DIC(9.4,70,22,2,"PAH",19,1,105,0)=""
^DIC(9.4,70,22,2,"PAH",19,1,106,0)="   8.  If the routines were unmapped as part of step 3, the mapped set"
^DIC(9.4,70,22,2,"PAH",19,1,107,0)="       should be rebuilt once the installation has run to completion. "
^DIC(9.4,70,22,2,"PAH",19,1,108,0)=""
^DIC(9.4,70,22,2,"PAH",19,1,109,0)="   9.  Restart the Broker Listener on the Server:"
^DIC(9.4,70,22,2,"PAH",19,1,110,0)="         a.  Log into your M server"
^DIC(9.4,70,22,2,"PAH",19,1,111,0)="         b.  Enter the following at the M prompt:"
^DIC(9.4,70,22,2,"PAH",19,1,112,0)=""
^DIC(9.4,70,22,2,"PAH",19,1,113,0)="             >D STRT^XWBTCP(Listener port)"
^DIC(9.4,70,22,2,"PAH",19,1,114,0)="             (Typically, the Listener port is 9200)"
^DIC(9.4,70,22,2,"PAH",19,1,115,0)=""
^DIC(9.4,70,22,2,"PAH",19,1,116,0)="============================================================================"
^DIC(9.4,70,22,2,"PAH",19,1,117,0)=""
^DIC(9.4,70,22,2,"PAH",20,0)="27 SEQ #20^3020315^1"
^DIC(9.4,70,22,2,"PAH",20,1,0)="^^142^142^3020315"
^DIC(9.4,70,22,2,"PAH",20,1,1,0)="Test sites:      San Diego, Seattle, and El Paso"
^DIC(9.4,70,22,2,"PAH",20,1,2,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,3,0)="NOIS:            None"
^DIC(9.4,70,22,2,"PAH",20,1,4,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,5,0)="Required builds: XWB*1.1*22"
^DIC(9.4,70,22,2,"PAH",20,1,6,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,7,0)="PATCH DESCRIPTION"
^DIC(9.4,70,22,2,"PAH",20,1,8,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,9,0)="When using the GUI Computerized Patient Record System (CPRS), ""remote"
^DIC(9.4,70,22,2,"PAH",20,1,10,0)="data views"" are available to the user showing patient information"
^DIC(9.4,70,22,2,"PAH",20,1,11,0)="collected real-time from remote sites.  The collection of real-time data"
^DIC(9.4,70,22,2,"PAH",20,1,12,0)="from remote sites also occurs from other sites such as the Government"
^DIC(9.4,70,22,2,"PAH",20,1,13,0)="Computer-based Patient Record (GCPR), and other packages such as Bar-code"
^DIC(9.4,70,22,2,"PAH",20,1,14,0)="Medication Administration (BCMA), and Integrated Billing (IB).  This data"
^DIC(9.4,70,22,2,"PAH",20,1,15,0)="collection occurs as the result of calls to a RPC Broker - HL7 bridge"
^DIC(9.4,70,22,2,"PAH",20,1,16,0)="routine."
^DIC(9.4,70,22,2,"PAH",20,1,17,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,18,0)="When calls for remote site data are made by these packages to the HL7"
^DIC(9.4,70,22,2,"PAH",20,1,19,0)="package, the requests are placed in a message queue awaiting processing."
^DIC(9.4,70,22,2,"PAH",20,1,20,0)="A background job processes the entries in the message queue, collects the"
^DIC(9.4,70,22,2,"PAH",20,1,21,0)="data from the remote site, and makes the remote site's data available to"
^DIC(9.4,70,22,2,"PAH",20,1,22,0)="local users."
^DIC(9.4,70,22,2,"PAH",20,1,23,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,24,0)="Presently, there is only one message queue to a given site.  When users"
^DIC(9.4,70,22,2,"PAH",20,1,25,0)="make multiple calls to the same remote site, the messages are processed"
^DIC(9.4,70,22,2,"PAH",20,1,26,0)="in the order they were queued, each one finishing before the next request"
^DIC(9.4,70,22,2,"PAH",20,1,27,0)="is started and processed.  If any of the requests in a processing queue"
^DIC(9.4,70,22,2,"PAH",20,1,28,0)="take a long time to process, or if there are a large number of requests"
^DIC(9.4,70,22,2,"PAH",20,1,29,0)="waiting processing, inordinately high delays are seen before the remote"
^DIC(9.4,70,22,2,"PAH",20,1,30,0)="data is available to local users."
^DIC(9.4,70,22,2,"PAH",20,1,31,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,32,0)="Prior to this patch, processing of requests to the HL7 package for"
^DIC(9.4,70,22,2,"PAH",20,1,33,0)="remote data made by GCPR and CPRS, was performed synchronously - in order"
^DIC(9.4,70,22,2,"PAH",20,1,34,0)="of time of request - each job finishing before the next job started. This"
^DIC(9.4,70,22,2,"PAH",20,1,35,0)="patch enables asynchronous processing - multiple jobs running at the same"
^DIC(9.4,70,22,2,"PAH",20,1,36,0)="time."
^DIC(9.4,70,22,2,"PAH",20,1,37,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,38,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,39,0)="REQUEST TIMEOUTS"
^DIC(9.4,70,22,2,"PAH",20,1,40,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,41,0)="When requests are made to remote sites for data, there is a limit to how"
^DIC(9.4,70,22,2,"PAH",20,1,42,0)="long the calling procedure will wait for a reply.  When a request for"
^DIC(9.4,70,22,2,"PAH",20,1,43,0)="remote data is not returned within the length of time specified in the"
^DIC(9.4,70,22,2,"PAH",20,1,44,0)="ACK TIMEOUT field of the logical link used for the remote request, the"
^DIC(9.4,70,22,2,"PAH",20,1,45,0)="call fails.  If your site experiences this problem, you may need to"
^DIC(9.4,70,22,2,"PAH",20,1,46,0)="increase the value of the ACK TIMEOUT field for the involved logical"
^DIC(9.4,70,22,2,"PAH",20,1,47,0)="link in increments of 30 to 60 seconds until the problem stops. (VACIO"
^DIC(9.4,70,22,2,"PAH",20,1,48,0)="is one link that has shown a need for a longer timeout.)  Refer to 'How"
^DIC(9.4,70,22,2,"PAH",20,1,49,0)="to edit Links', section 2.2 in the Health Level Seven Site Manager"
^DIC(9.4,70,22,2,"PAH",20,1,50,0)="Developer manual, for additional help in editing links."
^DIC(9.4,70,22,2,"PAH",20,1,51,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,52,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,53,0)="The routines XWB2HL7 and XWB2HL7C are included in this patch.  The first"
^DIC(9.4,70,22,2,"PAH",20,1,54,0)="and second lines of these routines are shown below."
^DIC(9.4,70,22,2,"PAH",20,1,55,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,56,0)="    XWB2HL7   ;ISF/RWF - Remote RPC via HL7 ;8/27/01  09:31"
^DIC(9.4,70,22,2,"PAH",20,1,57,0)="               ;;1.1;RPC BROKER;**12,18,20,22,27**;Mar 28, 1997"
^DIC(9.4,70,22,2,"PAH",20,1,58,0)="    XWB2HL7C  ;ISF/RWF - Remote RPC via HL7 ;12/27/01 15:33"
^DIC(9.4,70,22,2,"PAH",20,1,59,0)="               ;;1.1;RPC BROKER;**27**;Mar 28, 1997"
^DIC(9.4,70,22,2,"PAH",20,1,60,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,61,0)="The VA Kernel checksums for the routines included in this patch"
^DIC(9.4,70,22,2,"PAH",20,1,62,0)="(calculated using CHECK^XTSUMBLD) are listed below."
^DIC(9.4,70,22,2,"PAH",20,1,63,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,64,0)="                Checksum        Checksum"
^DIC(9.4,70,22,2,"PAH",20,1,65,0)="  Routine Name  Before Patch    After Patch     Patch List"
^DIC(9.4,70,22,2,"PAH",20,1,66,0)="  ============  ============    ===========     ====================="
^DIC(9.4,70,22,2,"PAH",20,1,67,0)="  XWB2HL7       10783627        10960487        12,18,20,22,27"
^DIC(9.4,70,22,2,"PAH",20,1,68,0)="  XWB2HL7C      --------         1022701        27"
^DIC(9.4,70,22,2,"PAH",20,1,69,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,70,0)="Sites should use CHECK^XTSUMBLD to verify checksums after patch"
^DIC(9.4,70,22,2,"PAH",20,1,71,0)="installation."
^DIC(9.4,70,22,2,"PAH",20,1,72,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,73,0)=" Installation Instructions:"
^DIC(9.4,70,22,2,"PAH",20,1,74,0)=" =========================="
^DIC(9.4,70,22,2,"PAH",20,1,75,0)="   1.  Do not run any RPC Broker-based Remote Data View (RDV) software"
^DIC(9.4,70,22,2,"PAH",20,1,76,0)="       (e.g., CPRS, PCMM) during the installation of this patch, and do"
^DIC(9.4,70,22,2,"PAH",20,1,77,0)="       do not allow any incoming HL7 RDV messages. To identify these jobs,"
^DIC(9.4,70,22,2,"PAH",20,1,78,0)="       check the system status, locating all running XWBTCPC (Broker"
^DIC(9.4,70,22,2,"PAH",20,1,79,0)="       Handler) routines. If any XWBTCPC routines are running,"
^DIC(9.4,70,22,2,"PAH",20,1,80,0)="       notify the users associated with the running routines to log off."
^DIC(9.4,70,22,2,"PAH",20,1,81,0)="       If it is not possible to contact users, it will be necessary to"
^DIC(9.4,70,22,2,"PAH",20,1,82,0)="       stop the jobs manually, using a utility such as FORCEX on VMS"
^DIC(9.4,70,22,2,"PAH",20,1,83,0)="       systems, or RESJOB on Cache systems. (Users may get NOSOURCE or"
^DIC(9.4,70,22,2,"PAH",20,1,84,0)="       CLOBBER error messages if this patch is installed while they are"
^DIC(9.4,70,22,2,"PAH",20,1,85,0)="       working.)"
^DIC(9.4,70,22,2,"PAH",20,1,86,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,87,0)="   2.  Stop the Broker Listener on the server.  Check the system status"
^DIC(9.4,70,22,2,"PAH",20,1,88,0)="       and verify if the XWBTCPL routine is running. (i.e., Broker"
^DIC(9.4,70,22,2,"PAH",20,1,89,0)="       Listener).  If it is running, stop it using the command shown"
^DIC(9.4,70,22,2,"PAH",20,1,90,0)="       below."
^DIC(9.4,70,22,2,"PAH",20,1,91,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,92,0)="       From the M prompt, enter:"
^DIC(9.4,70,22,2,"PAH",20,1,93,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,94,0)="         >D STOP^XWBTCP(LISTENER-PORT)"
^DIC(9.4,70,22,2,"PAH",20,1,95,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,96,0)="       When stopping the listener using the above command, substitute"
^DIC(9.4,70,22,2,"PAH",20,1,97,0)="       the actual port number for 'LISTENER-PORT'.  Typically, the"
^DIC(9.4,70,22,2,"PAH",20,1,98,0)="       listener port is 9200.  (If the listener port is 9200, the"
^DIC(9.4,70,22,2,"PAH",20,1,99,0)="       actual command would be 'D STOP^XWBTCP(9200)'.)"
^DIC(9.4,70,22,2,"PAH",20,1,100,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,101,0)="   3.  AXP/DSM SITES:  Review your mapped routine set.  If any of the"
^DIC(9.4,70,22,2,"PAH",20,1,102,0)="       routines patched by XWB*1.1*27 are mapped, they should be"
^DIC(9.4,70,22,2,"PAH",20,1,103,0)="       removed from the mapped set at this time."
^DIC(9.4,70,22,2,"PAH",20,1,104,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,105,0)="   4.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu to"
^DIC(9.4,70,22,2,"PAH",20,1,106,0)="       load the KIDS package onto your system."
^DIC(9.4,70,22,2,"PAH",20,1,107,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,108,0)="   5.  Step 4 loads a transport global on your system. Before actually"
^DIC(9.4,70,22,2,"PAH",20,1,109,0)="       installing the software contained in this transport global, you"
^DIC(9.4,70,22,2,"PAH",20,1,110,0)="       should take the time to review what will happen when the"
^DIC(9.4,70,22,2,"PAH",20,1,111,0)="       software is installed, and take other actions such as backing"
^DIC(9.4,70,22,2,"PAH",20,1,112,0)="       up the software that is about to be overwritten.  The menu options"
^DIC(9.4,70,22,2,"PAH",20,1,113,0)="       shown below should be used when performing review and backup tasks."
^DIC(9.4,70,22,2,"PAH",20,1,114,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,115,0)="          Verify Checksums in Transport Global"
^DIC(9.4,70,22,2,"PAH",20,1,116,0)="          Print Transport Global"
^DIC(9.4,70,22,2,"PAH",20,1,117,0)="          Compare Transport Global to Current System"
^DIC(9.4,70,22,2,"PAH",20,1,118,0)="          Backup a Transport Global"
^DIC(9.4,70,22,2,"PAH",20,1,119,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,120,0)="   6.  Patch XWB*1.1*27 is now loaded into a transport global on your"
^DIC(9.4,70,22,2,"PAH",20,1,121,0)="       system.  The next step is to use KIDS to install the"
^DIC(9.4,70,22,2,"PAH",20,1,122,0)="       transport global.  This is done using the 'Installation' menu's"
^DIC(9.4,70,22,2,"PAH",20,1,123,0)="       'Install Package(s) [XPD INSTALL BUILD]' menu option.  When"
^DIC(9.4,70,22,2,"PAH",20,1,124,0)="       using this menu option to install the patch build, you will be"
^DIC(9.4,70,22,2,"PAH",20,1,125,0)="       asked several questions.  The questions, and the answers you"
^DIC(9.4,70,22,2,"PAH",20,1,126,0)="       should supply, are shown below."
^DIC(9.4,70,22,2,"PAH",20,1,127,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,128,0)="       INSTALL NAME:  <XWB*1.1*27>"
^DIC(9.4,70,22,2,"PAH",20,1,129,0)="       Want KIDS to INHIBIT LOGONS during the install?  <NO>"
^DIC(9.4,70,22,2,"PAH",20,1,130,0)="       Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,70,22,2,"PAH",20,1,131,0)="         and Protocols?  <NO>"
^DIC(9.4,70,22,2,"PAH",20,1,132,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,133,0)="   7.  AXP/DSM SITES: After the patch has been installed, rebuild"
^DIC(9.4,70,22,2,"PAH",20,1,134,0)="       your map set, if necessary."
^DIC(9.4,70,22,2,"PAH",20,1,135,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,136,0)="   8.  Restart the Broker Listener on the Server.  From the M prompt,"
^DIC(9.4,70,22,2,"PAH",20,1,137,0)="       enter the following command:"
^DIC(9.4,70,22,2,"PAH",20,1,138,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,139,0)="             >D STRT^XWBTCP(LISTENER-PORT)"
^DIC(9.4,70,22,2,"PAH",20,1,140,0)=" "
^DIC(9.4,70,22,2,"PAH",20,1,141,0)="       Remember to substitute the actual port number for"
^DIC(9.4,70,22,2,"PAH",20,1,142,0)="       'LISTENER-PORT'.  (See step #2 above.)"
^DIC(9.4,70,22,2,"PAH",21,0)="25 SEQ #21^3020516^1"
^DIC(9.4,70,22,2,"PAH",21,1,0)="^^62^62^3020516"
^DIC(9.4,70,22,2,"PAH",21,1,1,0)="This Patch Addresses the Following NOIS Call:"
^DIC(9.4,70,22,2,"PAH",21,1,2,0)="============================================="
^DIC(9.4,70,22,2,"PAH",21,1,3,0)="1. WIC-0701-42695"
^DIC(9.4,70,22,2,"PAH",21,1,4,0)=""
^DIC(9.4,70,22,2,"PAH",21,1,5,0)="Problem Statement:"
^DIC(9.4,70,22,2,"PAH",21,1,6,0)="------------------"
^DIC(9.4,70,22,2,"PAH",21,1,7,0)="Integrated Billing (IB) has released a patch that uses the RPC Broker Remote "
^DIC(9.4,70,22,2,"PAH",21,1,8,0)="Data View (RDV) RPCs to collect data from remote systems. This caused a "
^DIC(9.4,70,22,2,"PAH",21,1,9,0)="significant increase in the number of Remote Users (i.e., visitors) added to "
^DIC(9.4,70,22,2,"PAH",21,1,10,0)="sites' local NEW PERSON files (#200)."
^DIC(9.4,70,22,2,"PAH",21,1,11,0)=""
^DIC(9.4,70,22,2,"PAH",21,1,12,0)="Patch Solution:"
^DIC(9.4,70,22,2,"PAH",21,1,13,0)="---------------"
^DIC(9.4,70,22,2,"PAH",21,1,14,0)=""
^DIC(9.4,70,22,2,"PAH",21,1,15,0)="A new field named SUPPRESS RDV USER SETUP (#.1) has been added to the REMOTE "
^DIC(9.4,70,22,2,"PAH",21,1,16,0)="PROCEDURE file (#8994). It regulates the addition of Remote Users to sites' "
^DIC(9.4,70,22,2,"PAH",21,1,17,0)="local NEW PERSON files for the RDV-based RPCs. This new field contains either "
^DIC(9.4,70,22,2,"PAH",21,1,18,0)="one of the following two values:"
^DIC(9.4,70,22,2,"PAH",21,1,19,0)=""
^DIC(9.4,70,22,2,"PAH",21,1,20,0)="  1. NO (default value) -- The Remote User will be added to the site's local "
^DIC(9.4,70,22,2,"PAH",21,1,21,0)="  NEW PERSON file."
^DIC(9.4,70,22,2,"PAH",21,1,22,0)="    "
^DIC(9.4,70,22,2,"PAH",21,1,23,0)="  2. YES -- The Remote User will NOT be added to the NEW PERSON file and the "
^DIC(9.4,70,22,2,"PAH",21,1,24,0)="  DUZ will be set to the Postmaster."
^DIC(9.4,70,22,2,"PAH",21,1,25,0)="  "
^DIC(9.4,70,22,2,"PAH",21,1,26,0)="  "
^DIC(9.4,70,22,2,"PAH",21,1,27,0)="Routine XWB2HL7 was changed with patch XWB*1.1*22."
^DIC(9.4,70,22,2,"PAH",21,1,28,0)=""
^DIC(9.4,70,22,2,"PAH",21,1,29,0)="========================================================================="
^DIC(9.4,70,22,2,"PAH",21,1,30,0)="Installation:"
^DIC(9.4,70,22,2,"PAH",21,1,31,0)="       "
^DIC(9.4,70,22,2,"PAH",21,1,32,0)="   1.  There are no routines in this patch. The Broker does NOT"
^DIC(9.4,70,22,2,"PAH",21,1,33,0)="       need to be stopped.  Users can remain on the system."
^DIC(9.4,70,22,2,"PAH",21,1,34,0)=""
^DIC(9.4,70,22,2,"PAH",21,1,35,0)="   2.  Use the Kernel Option 'INSTALL/CHECK MESSAGE' located on the "
^DIC(9.4,70,22,2,"PAH",21,1,36,0)="       PackMan menu. This option will load the KIDS package onto your "
^DIC(9.4,70,22,2,"PAH",21,1,37,0)="       system."
^DIC(9.4,70,22,2,"PAH",21,1,38,0)=""
^DIC(9.4,70,22,2,"PAH",21,1,39,0)="   3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,70,22,2,"PAH",21,1,40,0)="       system. Now you need to use KIDS to install the Transport global."
^DIC(9.4,70,22,2,"PAH",21,1,41,0)="       On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",21,1,42,0)="       options:"
^DIC(9.4,70,22,2,"PAH",21,1,43,0)=""
^DIC(9.4,70,22,2,"PAH",21,1,44,0)="          Verify Checksums in Transport Global"
^DIC(9.4,70,22,2,"PAH",21,1,45,0)="          Print Transport Global"
^DIC(9.4,70,22,2,"PAH",21,1,46,0)="          Compare Transport Global to Current System"
^DIC(9.4,70,22,2,"PAH",21,1,47,0)="          Backup a Transport Global"
^DIC(9.4,70,22,2,"PAH",21,1,48,0)=""
^DIC(9.4,70,22,2,"PAH",21,1,49,0)="   4.  On the KIDS Installation menu, use the option Install Package(s)."
^DIC(9.4,70,22,2,"PAH",21,1,50,0)="       Respond to the prompts as follows:"
^DIC(9.4,70,22,2,"PAH",21,1,51,0)="       "
^DIC(9.4,70,22,2,"PAH",21,1,52,0)="       Select INSTALL NAME:  XWB*1.1*25"
^DIC(9.4,70,22,2,"PAH",21,1,53,0)="                             =========="
^DIC(9.4,70,22,2,"PAH",21,1,54,0)="                             "
^DIC(9.4,70,22,2,"PAH",21,1,55,0)="       Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,70,22,2,"PAH",21,1,56,0)="                              "
^DIC(9.4,70,22,2,"PAH",21,1,57,0)="       No Options or Protocols need to be placed out-of-order."
^DIC(9.4,70,22,2,"PAH",21,1,58,0)="       Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,70,22,2,"PAH",21,1,59,0)="                                                                       =="
^DIC(9.4,70,22,2,"PAH",21,1,60,0)=""
^DIC(9.4,70,22,2,"PAH",21,1,61,0)="============================================================================"
^DIC(9.4,70,22,2,"PAH",21,1,62,0)=""
^DIC(9.4,70,22,2,"PAH",22,0)="13 SEQ #22^3020528^1"
^DIC(9.4,70,22,2,"PAH",22,1,0)="^^443^443^3020528"
^DIC(9.4,70,22,2,"PAH",22,1,1,0)="This patch provides silent login functionality in the Broker.  Any GUI"
^DIC(9.4,70,22,2,"PAH",22,1,2,0)="application that uses the Broker may now be able to login to an M Server"
^DIC(9.4,70,22,2,"PAH",22,1,3,0)="silently (i.e. without any user dialog).  The logins supported via the GUI"
^DIC(9.4,70,22,2,"PAH",22,1,4,0)="are:"
^DIC(9.4,70,22,2,"PAH",22,1,5,0)="1) setting the access code and verify code properties of the USER object"
^DIC(9.4,70,22,2,"PAH",22,1,6,0)="for the RPCBroker so that no sign-on dialog displays (if the user is"
^DIC(9.4,70,22,2,"PAH",22,1,7,0)="Multi-divisional, a division property may also be set); "
^DIC(9.4,70,22,2,"PAH",22,1,8,0)="and "
^DIC(9.4,70,22,2,"PAH",22,1,9,0)="2) Obtaining a token which may be passed to an application being started "
^DIC(9.4,70,22,2,"PAH",22,1,10,0)="by the current application."
^DIC(9.4,70,22,2,"PAH",22,1,11,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,12,0)="  This patch also provides support for Enterprise Single Sign-On using an"
^DIC(9.4,70,22,2,"PAH",22,1,13,0)="Authentication Proxy when it becomes available."
^DIC(9.4,70,22,2,"PAH",22,1,14,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,15,0)="  Since mechanisms are provided for a silent (dialog free) sign-on for the"
^DIC(9.4,70,22,2,"PAH",22,1,16,0)="RPCBroker, it may be used in situations where dialogs are not desirable. "
^DIC(9.4,70,22,2,"PAH",22,1,17,0)="To further support this, control of whether dialogs are shown for errors"
^DIC(9.4,70,22,2,"PAH",22,1,18,0)="detected is also supported with the property ShowErrorMsgs.  The default"
^DIC(9.4,70,22,2,"PAH",22,1,19,0)="value for this property is semRaise which will raise an error message in a"
^DIC(9.4,70,22,2,"PAH",22,1,20,0)="dialog box.  If this is not desirable, the value should be set to"
^DIC(9.4,70,22,2,"PAH",22,1,21,0)="semQuiet.  However, if this value is chosen, the application MUST check"
^DIC(9.4,70,22,2,"PAH",22,1,22,0)="the RPCBError property for information about any errors encountered"
^DIC(9.4,70,22,2,"PAH",22,1,23,0)="following EVERY broker call.  The application may also set the"
^DIC(9.4,70,22,2,"PAH",22,1,24,0)="OnRPCBFailure property with a method to be called in the event an error is"
^DIC(9.4,70,22,2,"PAH",22,1,25,0)="encountered.  This method accepts an RPCBroker instance as an argument so"
^DIC(9.4,70,22,2,"PAH",22,1,26,0)="that it may obtain the information in the RPCBError property."
^DIC(9.4,70,22,2,"PAH",22,1,27,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,28,0)="This patch also fulfills the following E3Rs:"
^DIC(9.4,70,22,2,"PAH",22,1,29,0)="         11265, Allowing Access and Verify Codes to be Passed"
^DIC(9.4,70,22,2,"PAH",22,1,30,0)="         10668, Auto Signon for Instrument"
^DIC(9.4,70,22,2,"PAH",22,1,31,0)="         12800, Programmatic Login"
^DIC(9.4,70,22,2,"PAH",22,1,32,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,33,0)="The patch also resolves the following NOIS calls:"
^DIC(9.4,70,22,2,"PAH",22,1,34,0)="         HIN-0300-41574, PROBLEM WITH F1 SHORTCUT FOR HELP IN GUI"
^DIC(9.4,70,22,2,"PAH",22,1,35,0)="         HOU-0399-72697, Signing on via Broker"
^DIC(9.4,70,22,2,"PAH",22,1,36,0)="         ISW-1299-22382, CPRS W/XWB*1.1*8"
^DIC(9.4,70,22,2,"PAH",22,1,37,0)="         ISW-1299-21488, CPRS W/XWB*1.1*8"
^DIC(9.4,70,22,2,"PAH",22,1,38,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,39,0)="IMPORTANT NOTES:"
^DIC(9.4,70,22,2,"PAH",22,1,40,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,41,0)="This patch consists of 2 parts:"
^DIC(9.4,70,22,2,"PAH",22,1,42,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,43,0)="1.  Packman message containing the XWB*1.1*13 KIDS build.  The packman"
^DIC(9.4,70,22,2,"PAH",22,1,44,0)="message simply updates the version multiple of the package."
^DIC(9.4,70,22,2,"PAH",22,1,45,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,46,0)="2.  Updated BDK (programmer client workstation software). This version of"
^DIC(9.4,70,22,2,"PAH",22,1,47,0)="the BDK supports Delphi 4, Delphi 5, and Delphi 6. "
^DIC(9.4,70,22,2,"PAH",22,1,48,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,49,0)="DO NOT INSTALL THIS PROGRAMMER CLIENT WORKSTATION SOFTWARE ON END-USER"
^DIC(9.4,70,22,2,"PAH",22,1,50,0)="CLIENT WORKSTATIONS.  If you are not using the BDK in any local or"
^DIC(9.4,70,22,2,"PAH",22,1,51,0)="national development, you do not need to retrieve the Broker's programmer"
^DIC(9.4,70,22,2,"PAH",22,1,52,0)="client workstation software. The software does not update the Broker"
^DIC(9.4,70,22,2,"PAH",22,1,53,0)="software that is running at end-user client workstations."
^DIC(9.4,70,22,2,"PAH",22,1,54,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,55,0)="The software distribution includes:"
^DIC(9.4,70,22,2,"PAH",22,1,56,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,57,0)=" FILE NAMES       DESCRIPTION                         Bytes"
^DIC(9.4,70,22,2,"PAH",22,1,58,0)=" XWB1_1P13PG.EXE  BDK Self-Installing Executable   4,416,873    "
^DIC(9.4,70,22,2,"PAH",22,1,59,0)=" XWB1_1P13IG.PDF  Installation Guide                 453,899  "
^DIC(9.4,70,22,2,"PAH",22,1,60,0)=" XWB1_1P13RM.TXT  Readme text file                    21,688"
^DIC(9.4,70,22,2,"PAH",22,1,61,0)=" XWB1_1P13DG.PDF  Developer's Guide                  502,143"
^DIC(9.4,70,22,2,"PAH",22,1,62,0)=" XWB1_1P13SM.PDF  Systems Manual                     708,711"
^DIC(9.4,70,22,2,"PAH",22,1,63,0)=" XWB1_1P13TM.PDF  Technical Manual                   350,314  "
^DIC(9.4,70,22,2,"PAH",22,1,64,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,65,0)="Note:  Use Binary mode for .PDF, and .EXE files. "
^DIC(9.4,70,22,2,"PAH",22,1,66,0)="       Use ASCII mode for .TXT file."
^DIC(9.4,70,22,2,"PAH",22,1,67,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,68,0)="To obtain the updated BDK, use FTP to retrieve the software from one of"
^DIC(9.4,70,22,2,"PAH",22,1,69,0)="the following CIO Field Offices' ANONYMOUS.SOFTWARE directories:"
^DIC(9.4,70,22,2,"PAH",22,1,70,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,71,0)="  CIO FIELD OFFICE                FTP Address        "
^DIC(9.4,70,22,2,"PAH",22,1,72,0)="  Hines                           152.129.1.110 (isc-chicago.domain.ext)"
^DIC(9.4,70,22,2,"PAH",22,1,73,0)="  Albany                          152.127.1.5 (isc-albany.domain.ext)"
^DIC(9.4,70,22,2,"PAH",22,1,74,0)="  Salt Lake City                  152.131.2.1 (isc-slc.domain.ext)"
^DIC(9.4,70,22,2,"PAH",22,1,75,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,76,0)="PACKAGE DEPENDENCIES:"
^DIC(9.4,70,22,2,"PAH",22,1,77,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,78,0)="A Package may have been defined to require the Broker package.  Patch"
^DIC(9.4,70,22,2,"PAH",22,1,79,0)="XWB*1.1*13 changes the identity of the Broker design-time package. If you"
^DIC(9.4,70,22,2,"PAH",22,1,80,0)="try to install a package into the Delphi IDE that requires the Broker, you"
^DIC(9.4,70,22,2,"PAH",22,1,81,0)="may receive an error message like:"
^DIC(9.4,70,22,2,"PAH",22,1,82,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,83,0)="      Can't load package <Package1>."
^DIC(9.4,70,22,2,"PAH",22,1,84,0)="      One of the library files needed to run this package cannot be found."
^DIC(9.4,70,22,2,"PAH",22,1,85,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,86,0)="To resolve this problem, Open the dpk file associated with that package;"
^DIC(9.4,70,22,2,"PAH",22,1,87,0)="delete the reference to the old version of the Broker in the Requires"
^DIC(9.4,70,22,2,"PAH",22,1,88,0)="section; add a reference to the new design-time Broker package (XWB_Dxx)"
^DIC(9.4,70,22,2,"PAH",22,1,89,0)="into the Requires section; recompile and install the package."
^DIC(9.4,70,22,2,"PAH",22,1,90,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,91,0)="BROKER-DEPENDENT COMPONENTS:"
^DIC(9.4,70,22,2,"PAH",22,1,92,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,93,0)="Warning: Some components, such as the FileMan Delphi Components, reference"
^DIC(9.4,70,22,2,"PAH",22,1,94,0)="the TRPCBroker component.  If you use such components for development, be"
^DIC(9.4,70,22,2,"PAH",22,1,95,0)="aware that installing a new version of the TRPCBroker component (i.e. a"
^DIC(9.4,70,22,2,"PAH",22,1,96,0)="new BDK) may cause incompatibilities in Delphi, resulting in a compile"
^DIC(9.4,70,22,2,"PAH",22,1,97,0)="failure of the unit containing the Broker-dependent component and the"
^DIC(9.4,70,22,2,"PAH",22,1,98,0)="following compilation error:"
^DIC(9.4,70,22,2,"PAH",22,1,99,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,100,0)="       Unit <unit1> was compiled with a different version of <unit2>."
^DIC(9.4,70,22,2,"PAH",22,1,101,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,102,0)="Check with the creators of the Broker-dependent component to make sure"
^DIC(9.4,70,22,2,"PAH",22,1,103,0)="that, with regards to the version of the BDK you are about to install:"
^DIC(9.4,70,22,2,"PAH",22,1,104,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,105,0)="a) Your current component is compatible, or"
^DIC(9.4,70,22,2,"PAH",22,1,106,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,107,0)="b) You can obtain a new version of the component that is compatible."
^DIC(9.4,70,22,2,"PAH",22,1,108,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,109,0)="c) You have the source (.pas, .dfm, .dpk, etc.) files available so that"
^DIC(9.4,70,22,2,"PAH",22,1,110,0)="the component can be recompiled successfully.    If you're using the"
^DIC(9.4,70,22,2,"PAH",22,1,111,0)="FileMan Delphi Components (FMDC), please note that the FMDC source code"
^DIC(9.4,70,22,2,"PAH",22,1,112,0)="includes references to RPC Broker Development Kit (BDK) code. When you"
^DIC(9.4,70,22,2,"PAH",22,1,113,0)="install a new version of the BDK, you will need to recompile the FMDC."
^DIC(9.4,70,22,2,"PAH",22,1,114,0)="   As of patch FMDC*1.0*1, source code for FMDC is provided, allowing you"
^DIC(9.4,70,22,2,"PAH",22,1,115,0)="to recompile FMDC if necessary. For instructions on how to recompile FMDC,"
^DIC(9.4,70,22,2,"PAH",22,1,116,0)="please refer to FMDC*1.0*2."
^DIC(9.4,70,22,2,"PAH",22,1,117,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,118,0)="INSTALLATION:"
^DIC(9.4,70,22,2,"PAH",22,1,119,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,120,0)="Server Side:"
^DIC(9.4,70,22,2,"PAH",22,1,121,0)="============"
^DIC(9.4,70,22,2,"PAH",22,1,122,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,123,0)="Use the following instructions in installing this server-side RPC Broker"
^DIC(9.4,70,22,2,"PAH",22,1,124,0)="patch.  Do NOT follow the M Server Installation Instructions in the RPC"
^DIC(9.4,70,22,2,"PAH",22,1,125,0)="Broker Installation Guide to install the server portion of this patch."
^DIC(9.4,70,22,2,"PAH",22,1,126,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,127,0)="No routines or other package components are added or modified on the"
^DIC(9.4,70,22,2,"PAH",22,1,128,0)="server by this patch."
^DIC(9.4,70,22,2,"PAH",22,1,129,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,130,0)="1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This option"
^DIC(9.4,70,22,2,"PAH",22,1,131,0)="will load the KIDS (Kernel Installation and Distribution System) package"
^DIC(9.4,70,22,2,"PAH",22,1,132,0)="onto your system.       "
^DIC(9.4,70,22,2,"PAH",22,1,133,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,134,0)="2. On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",22,1,135,0)="option:"
^DIC(9.4,70,22,2,"PAH",22,1,136,0)="   Install Package(s)  'XWB*1.1*13'"
^DIC(9.4,70,22,2,"PAH",22,1,137,0)="                        =========="
^DIC(9.4,70,22,2,"PAH",22,1,138,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,139,0)="Answer the install questions like this:"
^DIC(9.4,70,22,2,"PAH",22,1,140,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,141,0)="Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,70,22,2,"PAH",22,1,142,0)="                                                      =="
^DIC(9.4,70,22,2,"PAH",22,1,143,0)="Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,70,22,2,"PAH",22,1,144,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,145,0)="Client Side:"
^DIC(9.4,70,22,2,"PAH",22,1,146,0)="============"
^DIC(9.4,70,22,2,"PAH",22,1,147,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,148,0)="Please follow the instructions in the most recent Broker 1.1 Installation"
^DIC(9.4,70,22,2,"PAH",22,1,149,0)="Guide."
^DIC(9.4,70,22,2,"PAH",22,1,150,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,151,0)="The following list gives the specific attributes including size"
^DIC(9.4,70,22,2,"PAH",22,1,152,0)="and CRC-32 for all of the files installed on the client"
^DIC(9.4,70,22,2,"PAH",22,1,153,0)="using the installation program XWB1_1P13PG.EXE."
^DIC(9.4,70,22,2,"PAH",22,1,154,0)=" "
^DIC(9.4,70,22,2,"PAH",22,1,155,0)=" "
