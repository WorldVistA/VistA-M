^DIC(9.4,4,22,1,"PAH",138,1,22,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",138,1,23,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",138,1,24,0)=" "
^DIC(9.4,4,22,1,"PAH",138,1,25,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",138,1,26,0)="NOTE: This patch requires MailMan patch XM*7.1*158."
^DIC(9.4,4,22,1,"PAH",138,1,27,0)="1.  Users should not be on the system during patch installation."
^DIC(9.4,4,22,1,"PAH",138,1,28,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",138,1,29,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",138,1,30,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",138,1,31,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",138,1,32,0)="4.  On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",138,1,33,0)="    option to stop the background filer:"
^DIC(9.4,4,22,1,"PAH",138,1,34,0)="       STOP background filer"
^DIC(9.4,4,22,1,"PAH",138,1,35,0)="Are you sure you want the BACKGROUND FILERS to STOP delivering mail? NO// YES"
^DIC(9.4,4,22,1,"PAH",138,1,36,0)="                                                                          ==="
^DIC(9.4,4,22,1,"PAH",138,1,37,0)="<< Background filer will stop soon. >>"
^DIC(9.4,4,22,1,"PAH",138,1,38,0)="5.  Stop TaskMan.  Shut down the listeners.  You may also wish to shut down"
^DIC(9.4,4,22,1,"PAH",138,1,39,0)="    HL7 filers/LLP's and other background tasks which may attempt to create"
^DIC(9.4,4,22,1,"PAH",138,1,40,0)="    new messages.  During the installation of this patch, we do not want any"
^DIC(9.4,4,22,1,"PAH",138,1,41,0)="    messages coming in or going out.  Users should not be on the system."
^DIC(9.4,4,22,1,"PAH",138,1,42,0)="6.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",138,1,43,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",138,1,44,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",138,1,45,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",138,1,46,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",138,1,47,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",138,1,48,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",138,1,49,0)=" Select INSTALL NAME:    XM*7.1*169     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",138,1,50,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",138,1,51,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",138,1,52,0)=""
^DIC(9.4,4,22,1,"PAH",138,1,53,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",138,1,54,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",138,1,55,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",138,1,56,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",138,1,57,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",138,1,58,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",138,1,59,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",138,1,60,0)=""
^DIC(9.4,4,22,1,"PAH",138,1,61,0)=" DEVICE: HOME// <Do not queue this.>"
^DIC(9.4,4,22,1,"PAH",138,1,62,0)="                --------------------"
^DIC(9.4,4,22,1,"PAH",138,1,63,0)="7.  Start TaskMan.  If you shut down HL7 filers/LLP's and other"
^DIC(9.4,4,22,1,"PAH",138,1,64,0)="    background tasks in step 4, be sure to restart them, too."
^DIC(9.4,4,22,1,"PAH",138,1,65,0)="8.  On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",138,1,66,0)="    option to start the background filer:"
^DIC(9.4,4,22,1,"PAH",138,1,67,0)="       START background filer"
^DIC(9.4,4,22,1,"PAH",138,1,68,0)="<< Background filer will start soon. >>"
^DIC(9.4,4,22,1,"PAH",138,1,69,0)="9.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",138,1,70,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",139,0)="171 SEQ #164^3010326^1"
^DIC(9.4,4,22,1,"PAH",139,1,0)="^^75^75^3010326"
^DIC(9.4,4,22,1,"PAH",139,1,1,0)="Patch XM*7.1*171"
^DIC(9.4,4,22,1,"PAH",139,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",139,1,3,0)="Test Site:  Columbia, MO"
^DIC(9.4,4,22,1,"PAH",139,1,4,0)="NOIS: CMO-0101-42392"
^DIC(9.4,4,22,1,"PAH",139,1,5,0)="Fix Filter/query messages addressed to a private mail group."
^DIC(9.4,4,22,1,"PAH",139,1,6,0)="Filter won't recognize such messages at all."
^DIC(9.4,4,22,1,"PAH",139,1,7,0)="Query does find them, but the user interface is problematical when changing"
^DIC(9.4,4,22,1,"PAH",139,1,8,0)="the 'addressed to' selection."
^DIC(9.4,4,22,1,"PAH",139,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",139,1,10,0)="In the FILTER subfile of file 3.7, MAILBOX,"
^DIC(9.4,4,22,1,"PAH",139,1,11,0)="Field 5, FROM, has some new help text."
^DIC(9.4,4,22,1,"PAH",139,1,12,0)="Field 6, ADDRESSED TO, is expanded to 55 characters."
^DIC(9.4,4,22,1,"PAH",139,1,13,0)=""
^DIC(9.4,4,22,1,"PAH",139,1,14,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",139,1,15,0)="is at a minimum.  It requires MailMan patches XM*7.1*146 and XM*7.1*150."
^DIC(9.4,4,22,1,"PAH",139,1,16,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",139,1,17,0)=""
