^DIC(9.4,42,22,7,"PAH",103,1,27,0)=" "
^DIC(9.4,42,22,7,"PAH",103,1,28,0)="New Service Requests (NSRs):"
^DIC(9.4,42,22,7,"PAH",103,1,29,0)="----------------------------"
^DIC(9.4,42,22,7,"PAH",103,1,30,0)="N/A"
^DIC(9.4,42,22,7,"PAH",103,1,31,0)=" "
^DIC(9.4,42,22,7,"PAH",103,1,32,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,42,22,7,"PAH",103,1,33,0)="-----------------------------"
^DIC(9.4,42,22,7,"PAH",103,1,34,0)="PSPO 2497: Mental health instruments that use a complex scoring algorithm "
^DIC(9.4,42,22,7,"PAH",103,1,35,0)="display an incorrect score when used in Health Summary and Clinical "
^DIC(9.4,42,22,7,"PAH",103,1,36,0)="Reminders. "
^DIC(9.4,42,22,7,"PAH",103,1,37,0)=" "
^DIC(9.4,42,22,7,"PAH",103,1,38,0)="Remedy Ticket(s) & Overview:"
^DIC(9.4,42,22,7,"PAH",103,1,39,0)="----------------------------"
^DIC(9.4,42,22,7,"PAH",103,1,40,0)="N/A"
^DIC(9.4,42,22,7,"PAH",103,1,41,0)=" "
