^DIC(9.4,14,22,5.9,"PAH",138,1,97,0)="SOFTWARE RETRIEVAL:"
^DIC(9.4,14,22,5.9,"PAH",138,1,98,0)="==================="
^DIC(9.4,14,22,5.9,"PAH",138,1,99,0)="  "
^DIC(9.4,14,22,5.9,"PAH",138,1,100,0)="The following software and documentation files are exported as part of"
^DIC(9.4,14,22,5.9,"PAH",138,1,101,0)="this patch:"
^DIC(9.4,14,22,5.9,"PAH",138,1,102,0)="  "
^DIC(9.4,14,22,5.9,"PAH",138,1,103,0)="     File Name           Contents                         Retrieval Format"
^DIC(9.4,14,22,5.9,"PAH",138,1,104,0)="     ---------           --------                         ----------------"
^DIC(9.4,14,22,5.9,"PAH",138,1,105,0)="     LR_52_259.KID       LR*5.2*259 KIDS build                 ASCII"
^DIC(9.4,14,22,5.9,"PAH",138,1,106,0)="  "
^DIC(9.4,14,22,5.9,"PAH",138,1,107,0)="The software files are available on one of the following OI Field Offices'"
^DIC(9.4,14,22,5.9,"PAH",138,1,108,0)="ANONYMOUS.SOFTWARE directories."
^DIC(9.4,14,22,5.9,"PAH",138,1,109,0)="  "
^DIC(9.4,14,22,5.9,"PAH",138,1,110,0)="All sites are encouraged to use their FTP capability to obtain these files."
^DIC(9.4,14,22,5.9,"PAH",138,1,111,0)="Use the FTP address ""download.vista.domain.ext"" (without the quotes) to"
^DIC(9.4,14,22,5.9,"PAH",138,1,112,0)="connect to the first available FTP server where the files are located."
^DIC(9.4,14,22,5.9,"PAH",138,1,113,0)="  "
^DIC(9.4,14,22,5.9,"PAH",138,1,114,0)="     OI FIELD OFFICE    FTP ADDRESS                DIRECTORY"
^DIC(9.4,14,22,5.9,"PAH",138,1,115,0)="     ===============    ===========                ========="
^DIC(9.4,14,22,5.9,"PAH",138,1,116,0)="     ALBANY             ftp.fo-albany.domain.ext   [ANONYMOUS.SOFTWARE]"
^DIC(9.4,14,22,5.9,"PAH",138,1,117,0)="     HINES              ftp.fo-hines.domain.ext    [ANONYMOUS.SOFTWARE]"
^DIC(9.4,14,22,5.9,"PAH",138,1,118,0)="     SALT LAKE          ftp.fo-slc.domain.ext      [ANONYMOUS.SOFTWARE]"
^DIC(9.4,14,22,5.9,"PAH",138,1,119,0)=" "
^DIC(9.4,14,22,5.9,"PAH",138,1,120,0)=""
^DIC(9.4,14,22,5.9,"PAH",138,1,121,0)=""
^DIC(9.4,14,22,5.9,"PAH",138,1,122,0)=""
^DIC(9.4,14,22,5.9,"PAH",139,0)="305 SEQ #237^3040507^1"
^DIC(9.4,14,22,5.9,"PAH",139,1,0)="^^227^227^3040507"
^DIC(9.4,14,22,5.9,"PAH",139,1,1,0)="Currently, the Laboratory application contains functionality that will "
^DIC(9.4,14,22,5.9,"PAH",139,1,2,0)="allow the user to add a new patient to the PATIENT (#2) file from within "
^DIC(9.4,14,22,5.9,"PAH",139,1,3,0)="the Laboratory Application.  However, due to IT Service Request 20030306 "
^DIC(9.4,14,22,5.9,"PAH",139,1,4,0)="Patient Identity Management Services and HDR (Health Data Repository) Pilot,"
^DIC(9.4,14,22,5.9,"PAH",139,1,5,0)="it has been requested that all ancillary applications, including Laboratory"
^DIC(9.4,14,22,5.9,"PAH",139,1,6,0)="Service, remove such functionality.  For more information on this service"
^DIC(9.4,14,22,5.9,"PAH",139,1,7,0)="request, view the following link:"
^DIC(9.4,14,22,5.9,"PAH",139,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,9,0)="http://vista.domain.ext/pas/ViewTrackingRecord.asp?RequestID=20030306"
^DIC(9.4,14,22,5.9,"PAH",139,1,10,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,11,0)="Most, if not all, sites are not using the functionality that allows a patient "
^DIC(9.4,14,22,5.9,"PAH",139,1,12,0)="name to be added to the PATIENT (#2) file from the patient name prompt "
^DIC(9.4,14,22,5.9,"PAH",139,1,13,0)="within Lab menu options.  However, the functionality is in place and may be "
^DIC(9.4,14,22,5.9,"PAH",139,1,14,0)="used if the site has the ALLOW LAB TO ADD PATIENTS (#13) field of the"
^DIC(9.4,14,22,5.9,"PAH",139,1,15,0)="LABORATORY SITE (#69.9) file set to 'Yes.'  If this field is set to 'Yes',"
^DIC(9.4,14,22,5.9,"PAH",139,1,16,0)="any patient name prompt will accept a new patient name, one that does not"
^DIC(9.4,14,22,5.9,"PAH",139,1,17,0)="currently exist in the PATIENT(#2) file, if the new patient name is entered"
^DIC(9.4,14,22,5.9,"PAH",139,1,18,0)="twice.  See the example below:"
^DIC(9.4,14,22,5.9,"PAH",139,1,19,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,20,0)="Select Laboratory DHCP Menu Option: 1  Phlebotomy menu"
^DIC(9.4,14,22,5.9,"PAH",139,1,21,0)="  "
^DIC(9.4,14,22,5.9,"PAH",139,1,22,0)="          Add tests to a given accession."
^DIC(9.4,14,22,5.9,"PAH",139,1,23,0)="          Add tests to an already existing order number."
^DIC(9.4,14,22,5.9,"PAH",139,1,24,0)="          Delete entire order or individual tests"
^DIC(9.4,14,22,5.9,"PAH",139,1,25,0)="          Itemized routine lab collection"
^DIC(9.4,14,22,5.9,"PAH",139,1,26,0)="          Lab orders by collection type"
^DIC(9.4,14,22,5.9,"PAH",139,1,27,0)="          Lab test order"
^DIC(9.4,14,22,5.9,"PAH",139,1,28,0)="          List of lab orders not collected"
^DIC(9.4,14,22,5.9,"PAH",139,1,29,0)="          List of orders not collected (Long form)"
^DIC(9.4,14,22,5.9,"PAH",139,1,30,0)="          Order/test status"
^DIC(9.4,14,22,5.9,"PAH",139,1,31,0)="          Print collection list/labels"
^DIC(9.4,14,22,5.9,"PAH",139,1,32,0)="          Print future collection labels"
^DIC(9.4,14,22,5.9,"PAH",139,1,33,0)="          Print single future collection label"
^DIC(9.4,14,22,5.9,"PAH",139,1,34,0)="          Receipt of routine lab collection from wards"
^DIC(9.4,14,22,5.9,"PAH",139,1,35,0)="          Test description information"
^DIC(9.4,14,22,5.9,"PAH",139,1,36,0)="          Ward lab menu ..."
^DIC(9.4,14,22,5.9,"PAH",139,1,37,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,38,0)="Select Phlebotomy menu Option: LAB TEST order"
^DIC(9.4,14,22,5.9,"PAH",139,1,39,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,40,0)="Select Patient Name: NEWPATIENT,JANE ??  <-- 1st try - Name does not exist so "
^DIC(9.4,14,22,5.9,"PAH",139,1,41,0)="                                             '??' displays"
^DIC(9.4,14,22,5.9,"PAH",139,1,42,0)="Select Patient Name: NEWPATIENT,JANE     <-- 2nd try - Name is accepted as a "
^DIC(9.4,14,22,5.9,"PAH",139,1,43,0)="                                             new entry to the PATIENT(#2)"
^DIC(9.4,14,22,5.9,"PAH",139,1,44,0)="file."
^DIC(9.4,14,22,5.9,"PAH",139,1,45,0)="   ARE YOU ADDING 'NEWPATIENT,JANE' AS A NEW PATIENT (THE 239TH)? No// Y "
^DIC(9.4,14,22,5.9,"PAH",139,1,46,0)="(Yes)"
^DIC(9.4,14,22,5.9,"PAH",139,1,47,0)="   PATIENT SEX: F FEMALE"
^DIC(9.4,14,22,5.9,"PAH",139,1,48,0)="   PATIENT DATE OF BIRTH: 03121975  (MAR 12, 1975)"
^DIC(9.4,14,22,5.9,"PAH",139,1,49,0)="   PATIENT SOCIAL SECURITY NUMBER: 111223333"
^DIC(9.4,14,22,5.9,"PAH",139,1,50,0)="   PATIENT TYPE: ?"
^DIC(9.4,14,22,5.9,"PAH",139,1,51,0)="   PATIENT TYPE: TRICARE  "
^DIC(9.4,14,22,5.9,"PAH",139,1,52,0)="   PATIENT VETERAN (Y/N)?: Y YES"
^DIC(9.4,14,22,5.9,"PAH",139,1,53,0)="   ."
^DIC(9.4,14,22,5.9,"PAH",139,1,54,0)="   ."
^DIC(9.4,14,22,5.9,"PAH",139,1,55,0)="   ."
^DIC(9.4,14,22,5.9,"PAH",139,1,56,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,57,0)="A number of patient demographic fields are prompted before resuming the "
^DIC(9.4,14,22,5.9,"PAH",139,1,58,0)="prompting of fields required for the LAB TEST ORDER [LROW] option.  Most "
^DIC(9.4,14,22,5.9,"PAH",139,1,59,0)="options in Laboratory Service permit new patient names to be entered in the "
^DIC(9.4,14,22,5.9,"PAH",139,1,60,0)="format shown above.  Patch LR*5.2*305 was created to remove this "
^DIC(9.4,14,22,5.9,"PAH",139,1,61,0)="functionality from within the Laboratory Service application. "
^DIC(9.4,14,22,5.9,"PAH",139,1,62,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,63,0)="The following two changes to existing functionality are included in this "
^DIC(9.4,14,22,5.9,"PAH",139,1,64,0)="patch:"
^DIC(9.4,14,22,5.9,"PAH",139,1,65,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,66,0)="  1. The ALLOW LAB TO ADD PATIENTS (#13) field of the LABORATORY SITE "
^DIC(9.4,14,22,5.9,"PAH",139,1,67,0)="     (#69.9) file has been modified so that it can no longer be set to"
^DIC(9.4,14,22,5.9,"PAH",139,1,68,0)="     'Yes.'  'No' is now the only answer allowed."
^DIC(9.4,14,22,5.9,"PAH",139,1,69,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,70,0)="  2. The patient name prompt in menu options within Laboratory Service, "
^DIC(9.4,14,22,5.9,"PAH",139,1,71,0)="     has been modified to no longer allow a new patient to be added to the "
^DIC(9.4,14,22,5.9,"PAH",139,1,72,0)="     PATIENT (#2) file from within Lab.  See the example below:"
^DIC(9.4,14,22,5.9,"PAH",139,1,73,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,74,0)="Select Laboratory DHCP Menu Option: 1  Phlebotomy menu"
^DIC(9.4,14,22,5.9,"PAH",139,1,75,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,76,0)="          Add tests to a given accession."
^DIC(9.4,14,22,5.9,"PAH",139,1,77,0)="          Add tests to an already existing order number."
^DIC(9.4,14,22,5.9,"PAH",139,1,78,0)="          Add to collection list"
^DIC(9.4,14,22,5.9,"PAH",139,1,79,0)="          Delete entire order or individual tests"
^DIC(9.4,14,22,5.9,"PAH",139,1,80,0)="          Itemized routine lab collection"
^DIC(9.4,14,22,5.9,"PAH",139,1,81,0)="          Lab orders by collection type"
^DIC(9.4,14,22,5.9,"PAH",139,1,82,0)="          Lab test order"
^DIC(9.4,14,22,5.9,"PAH",139,1,83,0)="          List of lab orders not collected"
^DIC(9.4,14,22,5.9,"PAH",139,1,84,0)="          List of orders not collected (Long form)"
^DIC(9.4,14,22,5.9,"PAH",139,1,85,0)="          Order/test status"
^DIC(9.4,14,22,5.9,"PAH",139,1,86,0)="          Print collection list/labels"
^DIC(9.4,14,22,5.9,"PAH",139,1,87,0)="          Print future collection labels"
^DIC(9.4,14,22,5.9,"PAH",139,1,88,0)="          Print single future collection label"
^DIC(9.4,14,22,5.9,"PAH",139,1,89,0)="          Receipt of routine lab collection from wards"
^DIC(9.4,14,22,5.9,"PAH",139,1,90,0)="          Test description information"
^DIC(9.4,14,22,5.9,"PAH",139,1,91,0)="          Ward lab menu ..."
^DIC(9.4,14,22,5.9,"PAH",139,1,92,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,93,0)="Select Phlebotomy menu Option: LAB TEST order"
^DIC(9.4,14,22,5.9,"PAH",139,1,94,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,95,0)="Select Patient Name: NEWPATIENT,JANE ??"
^DIC(9.4,14,22,5.9,"PAH",139,1,96,0)="Select Patient Name: NEWPATIENT,JANE ??"
^DIC(9.4,14,22,5.9,"PAH",139,1,97,0)="Select Patient Name: NEWPATIENT,JANE ??"
^DIC(9.4,14,22,5.9,"PAH",139,1,98,0)="Select Patient Name:"
^DIC(9.4,14,22,5.9,"PAH",139,1,99,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,100,0)="The new patient name NEWPATIENT,JANE is not accepted."
^DIC(9.4,14,22,5.9,"PAH",139,1,101,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,102,0)="VISTA Laboratory Package patch LR*5.2*305 contains changes to software "
^DIC(9.4,14,22,5.9,"PAH",139,1,103,0)="controlled by VHA DIRECTIVE 99-053, titled VISTA BLOOD BANK SOFTWARE. "
^DIC(9.4,14,22,5.9,"PAH",139,1,104,0)="Changes include: NOT ALLOWING LAB TO ADD PATIENTS TO PATIENT FILE"
^DIC(9.4,14,22,5.9,"PAH",139,1,105,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,106,0)="All of the above changes have been reviewed by the VISTA Blood Bank "
^DIC(9.4,14,22,5.9,"PAH",139,1,107,0)="Developer and found to have no impact on the VISTA BLOOD BANK SOFTWARE "
^DIC(9.4,14,22,5.9,"PAH",139,1,108,0)="control functions."
^DIC(9.4,14,22,5.9,"PAH",139,1,109,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,110,0)="RISK ANALYSIS:  Changes made by patch LR*5.2*305 have no effect on Blood "
^DIC(9.4,14,22,5.9,"PAH",139,1,111,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",139,1,112,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,113,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS:  Patch LR*5.2*305 does not "
^DIC(9.4,14,22,5.9,"PAH",139,1,114,0)="alter or modify any software design safeguards or safety critical elements "
^DIC(9.4,14,22,5.9,"PAH",139,1,115,0)="functions."
^DIC(9.4,14,22,5.9,"PAH",139,1,116,0)="  "
^DIC(9.4,14,22,5.9,"PAH",139,1,117,0)="POTENTIAL IMPACT ON SITES:  This patch contains changes to one routine and "
^DIC(9.4,14,22,5.9,"PAH",139,1,118,0)="one file identified in Veterans Health Administration (VHA) Directive "
^DIC(9.4,14,22,5.9,"PAH",139,1,119,0)="99-053, group B listing. The changes have no effect in Blood Bank "
^DIC(9.4,14,22,5.9,"PAH",139,1,120,0)="functionality or medical device control functions. There is no adverse "
^DIC(9.4,14,22,5.9,"PAH",139,1,121,0)="potential to sites."
^DIC(9.4,14,22,5.9,"PAH",139,1,122,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,123,0)="Software Updates:"
^DIC(9.4,14,22,5.9,"PAH",139,1,124,0)="----------------"
^DIC(9.4,14,22,5.9,"PAH",139,1,125,0)="The following code has been changed in routine ^LRDPA.  Added Quit at the end"
^DIC(9.4,14,22,5.9,"PAH",139,1,126,0)="of the first line in subroutine LAYG."
^DIC(9.4,14,22,5.9,"PAH",139,1,127,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,128,0)="From:  "
^DIC(9.4,14,22,5.9,"PAH",139,1,129,0)="LAYG    ;Determine if DLAYGO is allowed on second pass."
^DIC(9.4,14,22,5.9,"PAH",139,1,130,0)="        K DLAYGO S DIC(0)=""EQMZ"""
^DIC(9.4,14,22,5.9,"PAH",139,1,131,0)="        Q:'$P($G(LRPARAM),""^"",6)"
^DIC(9.4,14,22,5.9,"PAH",139,1,132,0)="        Q:'$D(LRLABKY)"
^DIC(9.4,14,22,5.9,"PAH",139,1,133,0)="        S DLAYGO=2 S DIC(0)=""EQMZL"""
^DIC(9.4,14,22,5.9,"PAH",139,1,134,0)="        Q"
^DIC(9.4,14,22,5.9,"PAH",139,1,135,0)="To:"
^DIC(9.4,14,22,5.9,"PAH",139,1,136,0)="LAYG    ;Don't allow DLAYGO on second pass."
^DIC(9.4,14,22,5.9,"PAH",139,1,137,0)="        K DLAYGO S DIC(0)=""EQMZ"" Q"
^DIC(9.4,14,22,5.9,"PAH",139,1,138,0)="        Q:'$P($G(LRPARAM),""^"",6)"
^DIC(9.4,14,22,5.9,"PAH",139,1,139,0)="        Q:'$D(LRLABKY)"
^DIC(9.4,14,22,5.9,"PAH",139,1,140,0)="        S DLAYGO=2 S DIC(0)=""EQMZL"""
^DIC(9.4,14,22,5.9,"PAH",139,1,141,0)="        Q"
^DIC(9.4,14,22,5.9,"PAH",139,1,142,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,143,0)="DD Updates:"
^DIC(9.4,14,22,5.9,"PAH",139,1,144,0)="-----------"
^DIC(9.4,14,22,5.9,"PAH",139,1,145,0)="The description of ALLOW LAB TO ADD PATIENTS field (#13) in the LABORATORY"
^DIC(9.4,14,22,5.9,"PAH",139,1,146,0)="SITE file (#69.9) has been changed to indicate that field #13 is no longer"
^DIC(9.4,14,22,5.9,"PAH",139,1,147,0)="functional, and the set code value '1' has been removed as a valid entry."
^DIC(9.4,14,22,5.9,"PAH",139,1,148,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,149,0)="From:"
^DIC(9.4,14,22,5.9,"PAH",139,1,150,0)="69.9,13   ALLOW LAB TO ADD PATIENTS 0;6 SET (Required)"
^DIC(9.4,14,22,5.9,"PAH",139,1,151,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,152,0)="          '1' FOR YES;"
^DIC(9.4,14,22,5.9,"PAH",139,1,153,0)="          '0' FOR NO; "
^DIC(9.4,14,22,5.9,"PAH",139,1,154,0)="          LAST EDITED: MAY 01, 1984 "
^DIC(9.4,14,22,5.9,"PAH",139,1,155,0)="          DESCRIPTION: If the Lab is allowed to enter patients into"
^DIC(9.4,14,22,5.9,"PAH",139,1,156,0)="               the system, this field must contain a 'Yes' entry.  Only "
^DIC(9.4,14,22,5.9,"PAH",139,1,157,0)="               lab users with the LRLAB key will make the changes and "
^DIC(9.4,14,22,5.9,"PAH",139,1,158,0)="               only when using lab options.  "
^DIC(9.4,14,22,5.9,"PAH",139,1,159,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,160,0)="To:"
^DIC(9.4,14,22,5.9,"PAH",139,1,161,0)="69.9,13          ALLOW LAB TO ADD PATIENTS 0;6 SET (Required)"
^DIC(9.4,14,22,5.9,"PAH",139,1,162,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,163,0)="          '0' FOR NO; "
^DIC(9.4,14,22,5.9,"PAH",139,1,164,0)="          LAST EDITED: SEP 02, 2003 "
^DIC(9.4,14,22,5.9,"PAH",139,1,165,0)="          DESCRIPTION: This field is not functional.  It is no longer "
^DIC(9.4,14,22,5.9,"PAH",139,1,166,0)="               used to allow Lab to add patients to the Patient file. "
^DIC(9.4,14,22,5.9,"PAH",139,1,167,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,168,0)="Test Sites     "
^DIC(9.4,14,22,5.9,"PAH",139,1,169,0)="---------- "
^DIC(9.4,14,22,5.9,"PAH",139,1,170,0)="Muskogee, OK"
^DIC(9.4,14,22,5.9,"PAH",139,1,171,0)="Boston HCS"
^DIC(9.4,14,22,5.9,"PAH",139,1,172,0)="Cheyenne VAMC"
^DIC(9.4,14,22,5.9,"PAH",139,1,173,0)="Columbus VAMC"
^DIC(9.4,14,22,5.9,"PAH",139,1,174,0)="  "
^DIC(9.4,14,22,5.9,"PAH",139,1,175,0)="  ROUTINE SUMMARY: "
^DIC(9.4,14,22,5.9,"PAH",139,1,176,0)="  ================="
^DIC(9.4,14,22,5.9,"PAH",139,1,177,0)="  The following routine(s) are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",139,1,178,0)="  of each routine now looks like: "
^DIC(9.4,14,22,5.9,"PAH",139,1,179,0)="  "
^DIC(9.4,14,22,5.9,"PAH",139,1,180,0)="  <tab>     ;;5.2;LAB SERVICE;**[patch list]**; Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",139,1,181,0)="   "
^DIC(9.4,14,22,5.9,"PAH",139,1,182,0)="                Checksum      Checksum"
^DIC(9.4,14,22,5.9,"PAH",139,1,183,0)="  Routine Name  Before Patch  After Patch  Patch List"
^DIC(9.4,14,22,5.9,"PAH",139,1,184,0)="  ------------  ------------  -----------  -----------"
^DIC(9.4,14,22,5.9,"PAH",139,1,185,0)="  LR305         N/A           5010875      **305** (Deleted by KIDS)"
^DIC(9.4,14,22,5.9,"PAH",139,1,186,0)="  LRDPA         7837880       7840899      **137,121,153,202,211,248,305** "
^DIC(9.4,14,22,5.9,"PAH",139,1,187,0)="  "
^DIC(9.4,14,22,5.9,"PAH",139,1,188,0)="  Installation Instructions: "
^DIC(9.4,14,22,5.9,"PAH",139,1,189,0)="  =========================="
^DIC(9.4,14,22,5.9,"PAH",139,1,190,0)="  Users may remain on the system, but installation should be done at off"
^DIC(9.4,14,22,5.9,"PAH",139,1,191,0)="  peak hours.  No options need to be placed out of service.  Installation "
^DIC(9.4,14,22,5.9,"PAH",139,1,192,0)="  time is less than 1 minute during off peak hours and less than 5 minutes"
^DIC(9.4,14,22,5.9,"PAH",139,1,193,0)="  during peak hours.  Installation of this patch requires no additional "
^DIC(9.4,14,22,5.9,"PAH",139,1,194,0)="  memory space."
^DIC(9.4,14,22,5.9,"PAH",139,1,195,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,196,0)="  1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,14,22,5.9,"PAH",139,1,197,0)="     option will load the KIDS package in this message onto your system."
^DIC(9.4,14,22,5.9,"PAH",139,1,198,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,199,0)="  2. Review your mapped set.  If the routines are mapped, they "
^DIC(9.4,14,22,5.9,"PAH",139,1,200,0)="     should be removed from the mapped set at this time"
^DIC(9.4,14,22,5.9,"PAH",139,1,201,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,202,0)="  3. The patch has now been loaded into a Transport global on your"
^DIC(9.4,14,22,5.9,"PAH",139,1,203,0)="     system. You now need to use KIDS to install the Transport global."
^DIC(9.4,14,22,5.9,"PAH",139,1,204,0)="     "
^DIC(9.4,14,22,5.9,"PAH",139,1,205,0)="  4. On the Kernel Installation and Distribution System (KIDS) menu, select"
^DIC(9.4,14,22,5.9,"PAH",139,1,206,0)="     the 'Installation' menu.  You may elect to use the following options:"
^DIC(9.4,14,22,5.9,"PAH",139,1,207,0)="         a. Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",139,1,208,0)="         b. Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",139,1,209,0)="         c. Verify Checksums in Transport Global"
^DIC(9.4,14,22,5.9,"PAH",139,1,210,0)="         d. Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",139,1,211,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,212,0)="  5. When ready, select the Install Packages option (when prompted for the"
^DIC(9.4,14,22,5.9,"PAH",139,1,213,0)="     INSTALL NAME, enter 'LR*5.2*305'.      "
^DIC(9.4,14,22,5.9,"PAH",139,1,214,0)="  "
^DIC(9.4,14,22,5.9,"PAH",139,1,215,0)="  6. When prompted 'Want KIDS to INHIBIT LOGONs during the install? YES//',"
^DIC(9.4,14,22,5.9,"PAH",139,1,216,0)="     respond ""NO""."
^DIC(9.4,14,22,5.9,"PAH",139,1,217,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,218,0)="  7. When prompted 'Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,14,22,5.9,"PAH",139,1,219,0)="     Protocols? YES//', respond ""NO""."
^DIC(9.4,14,22,5.9,"PAH",139,1,220,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,221,0)="  8. If any routines were unmapped as part of step 2, they should be"
^DIC(9.4,14,22,5.9,"PAH",139,1,222,0)="     returned to the mapped set once the installation has run to"
^DIC(9.4,14,22,5.9,"PAH",139,1,223,0)="     completion."
^DIC(9.4,14,22,5.9,"PAH",139,1,224,0)=" "
^DIC(9.4,14,22,5.9,"PAH",139,1,225,0)="  9. Using Fileman, verify that the ALLOW LAB TO ADD PATIENTS (#13) field "
^DIC(9.4,14,22,5.9,"PAH",139,1,226,0)="     of the LABORATORY SITE file (#69.9) is set to 'No.'  If not, set it to"
^DIC(9.4,14,22,5.9,"PAH",139,1,227,0)="     'No.'  'No' is the only setting allowed after patch installation."
^DIC(9.4,14,22,5.9,"PAH",140,0)="281^3040702^1"
^DIC(9.4,14,22,5.9,"PAH",140,1,0)="^^353^353^3040702"
^DIC(9.4,14,22,5.9,"PAH",140,1,1,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*281 does not "
^DIC(9.4,14,22,5.9,"PAH",140,1,2,0)="contain any changes to the VISTA BLOOD BANK Software as defined by VHA  "
^DIC(9.4,14,22,5.9,"PAH",140,1,3,0)="DIRECTIVE 99-053 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",140,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,5,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*281 does not "
^DIC(9.4,14,22,5.9,"PAH",140,1,6,0)="alter or modify any software design safeguards or safety critical"
^DIC(9.4,14,22,5.9,"PAH",140,1,7,0)="elements functions."
^DIC(9.4,14,22,5.9,"PAH",140,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,9,0)="RISK ANALYSIS: Changes made by patch LR*5.2*281 have no effect on Blood "
^DIC(9.4,14,22,5.9,"PAH",140,1,10,0)="Bank software functionality, therefore RISK is none. "
^DIC(9.4,14,22,5.9,"PAH",140,1,11,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,12,0)="VALIDATION REQUIREMENTS BY OPTION:  Because of the nature of the changes made,"
^DIC(9.4,14,22,5.9,"PAH",140,1,13,0)="no specific validation requirements exist as a result of installation of this"
^DIC(9.4,14,22,5.9,"PAH",140,1,14,0)="patch."
^DIC(9.4,14,22,5.9,"PAH",140,1,15,0)="***********************************************************************"
^DIC(9.4,14,22,5.9,"PAH",140,1,16,0)="Due to extensive historical data transmission requirements and mandated setups"
^DIC(9.4,14,22,5.9,"PAH",140,1,17,0)="required for such, a phased installation and implementation of this patch will"
^DIC(9.4,14,22,5.9,"PAH",140,1,18,0)="be utilized for release of this patch.  The software download information will"
^DIC(9.4,14,22,5.9,"PAH",140,1,19,0)="be made available to sites attending one of the following national"
^DIC(9.4,14,22,5.9,"PAH",140,1,20,0)="audioconference calls:"
^DIC(9.4,14,22,5.9,"PAH",140,1,21,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,22,0)="Tuesday, June 8 at 1:00 - 3:00 PM EST for VISNs 1-2-3-4-5-6 "
^DIC(9.4,14,22,5.9,"PAH",140,1,23,0)="Thursday, June 10 at 3:00 - 5:00 PM EST for VISNs 7-8-9-10-11 "
^DIC(9.4,14,22,5.9,"PAH",140,1,24,0)="Tuesday, June 15 at 4:00 - 6:00 PM EST for VISNs 12-15-16-17-23 "
^DIC(9.4,14,22,5.9,"PAH",140,1,25,0)="Wednesday, June 16 at 2:00 - 4:00 PM EST for VISNs 18-19-20-21-22 "
^DIC(9.4,14,22,5.9,"PAH",140,1,26,0)="Thursday, June 17 at 2:00 - 4:00 PM EST for those unable to attend the other"
^DIC(9.4,14,22,5.9,"PAH",140,1,27,0)="calls. "
^DIC(9.4,14,22,5.9,"PAH",140,1,28,0)=""
^DIC(9.4,14,22,5.9,"PAH",140,1,29,0)="The VANTS telephone number is 1 800 767-1750 and the access code for all calls"
^DIC(9.4,14,22,5.9,"PAH",140,1,30,0)="is 13143."
^DIC(9.4,14,22,5.9,"PAH",140,1,31,0)=""
^DIC(9.4,14,22,5.9,"PAH",140,1,32,0)="This patch will involve reseeding of the EPI databases for each site to allow"
^DIC(9.4,14,22,5.9,"PAH",140,1,33,0)="the new data created by this patch to be captured.  It is imperative each site "
^DIC(9.4,14,22,5.9,"PAH",140,1,34,0)="attend an audioconference prior to installation and implementation of"
^DIC(9.4,14,22,5.9,"PAH",140,1,35,0)="LR*5.2*281."
^DIC(9.4,14,22,5.9,"PAH",140,1,36,0)=""
^DIC(9.4,14,22,5.9,"PAH",140,1,37,0)="INSTRUCTIONS FOR SEEDING THE HISTORICAL DATA:"
^DIC(9.4,14,22,5.9,"PAH",140,1,38,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,39,0)="Historical data must be gathered from October 1, 2000 through June 14, 2004. "
^DIC(9.4,14,22,5.9,"PAH",140,1,40,0)="Use the Lab EPI Manual Run (Enhanced) [LREPI ENHANCE MANUAL RUN] option to run/"
^DIC(9.4,14,22,5.9,"PAH",140,1,41,0)="gather and transmit 6 manual runs (consecutive runs) at a time."
^DIC(9.4,14,22,5.9,"PAH",140,1,42,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,43,0)="** Sites DO NOT transmit on June 16 or July 4 to avoid Austin Automation Center"
^DIC(9.4,14,22,5.9,"PAH",140,1,44,0)=" (AAC) capacity limitations. **"
^DIC(9.4,14,22,5.9,"PAH",140,1,45,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,46,0)="Batch #1: October 1, 2000 -March 31, 2001"
^DIC(9.4,14,22,5.9,"PAH",140,1,47,0)="Batch #2: April 1, 2001 - September 30, 2001"
^DIC(9.4,14,22,5.9,"PAH",140,1,48,0)="Batch #3: October 1, 2001 - March 31, 2002"
^DIC(9.4,14,22,5.9,"PAH",140,1,49,0)="Batch #4: April 1, 2002 - September 30, 2002"
^DIC(9.4,14,22,5.9,"PAH",140,1,50,0)="Batch #5: October 1, 2002 - March 31, 2003"
^DIC(9.4,14,22,5.9,"PAH",140,1,51,0)="Batch #6: April 1, 2003 - September 30, 2003"
^DIC(9.4,14,22,5.9,"PAH",140,1,52,0)="Batch #7: October 1, 2003 - March 31, 2004"
^DIC(9.4,14,22,5.9,"PAH",140,1,53,0)="Batch #8: April 1, 2004 - June 14, 2004 "
^DIC(9.4,14,22,5.9,"PAH",140,1,54,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,55,0)="Sites will run 8 batches of reports. Each batch should contain 6 separate"
^DIC(9.4,14,22,5.9,"PAH",140,1,56,0)="monthly extracts which are tasked separately by month, i.e., OCT 2000, NOV"
^DIC(9.4,14,22,5.9,"PAH",140,1,57,0)="2000, DEC 2000, JAN 2001, FEB 2001, MAR 2001 = 1 batch and will generate six"
^DIC(9.4,14,22,5.9,"PAH",140,1,58,0)="separate processing reports back to the station and transmit them over a five"
^DIC(9.4,14,22,5.9,"PAH",140,1,59,0)="week period June 10, 2004 - July 12, 2004."
^DIC(9.4,14,22,5.9,"PAH",140,1,60,0)="You do not have to wait for one monthly extract to run before starting the next"
^DIC(9.4,14,22,5.9,"PAH",140,1,61,0)="in a batch."
^DIC(9.4,14,22,5.9,"PAH",140,1,62,0)="You do not have to wait for one batch to complete running before queuing the"
^DIC(9.4,14,22,5.9,"PAH",140,1,63,0)="next batch."
^DIC(9.4,14,22,5.9,"PAH",140,1,64,0)="If you receive any fatal errors and the monthly extract is rejected, you will"
^DIC(9.4,14,22,5.9,"PAH",140,1,65,0)="need to fix the error and retransmit that month. "
^DIC(9.4,14,22,5.9,"PAH",140,1,66,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,67,0)="Sites may transmit reports to AAC on evenings and weekends following this"
^DIC(9.4,14,22,5.9,"PAH",140,1,68,0)="schedule:"
^DIC(9.4,14,22,5.9,"PAH",140,1,69,0)="1. VISNs with odd numbers are asked to transmit batches on Tuesday & Thursday"
^DIC(9.4,14,22,5.9,"PAH",140,1,70,0)=" during the PM hours and Saturdays."
^DIC(9.4,14,22,5.9,"PAH",140,1,71,0)="2. VISNs with even numbers are asked to transmit on Monday & Friday during the"
^DIC(9.4,14,22,5.9,"PAH",140,1,72,0)=" PM hours and Sundays."
^DIC(9.4,14,22,5.9,"PAH",140,1,73,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,74,0)="**  NO Sites may transmit on June 16 or July 4 due to AAC limitations. **"
^DIC(9.4,14,22,5.9,"PAH",140,1,75,0)=""
^DIC(9.4,14,22,5.9,"PAH",140,1,76,0)=""
^DIC(9.4,14,22,5.9,"PAH",140,1,77,0)="The EPI Enhancement patch, LR*5.2*281, contains enhancements and "
^DIC(9.4,14,22,5.9,"PAH",140,1,78,0)="modifications to the Emerging Pathogens Initiative (EPI) software."
^DIC(9.4,14,22,5.9,"PAH",140,1,79,0)="The enhancements and modifications included in this patch are:"
^DIC(9.4,14,22,5.9,"PAH",140,1,80,0)=""
^DIC(9.4,14,22,5.9,"PAH",140,1,81,0)="1) New EPI Summary Verification Report of EPI Extracted Data from Site:"
^DIC(9.4,14,22,5.9,"PAH",140,1,82,0)="   The new Verification Summary Report of EPI Extracted Data from Site   "
^DIC(9.4,14,22,5.9,"PAH",140,1,83,0)="   replaces the existing Emerging Pathogens Verification Report.  This "
^DIC(9.4,14,22,5.9,"PAH",140,1,84,0)="   new summary report consists of the following functionality:"
^DIC(9.4,14,22,5.9,"PAH",140,1,85,0)="        1) Summary report automatically generated at the sites and sent    "
^DIC(9.4,14,22,5.9,"PAH",140,1,86,0)="           to the EPI-REPORT mail group on the 15th day of each month"
^DIC(9.4,14,22,5.9,"PAH",140,1,87,0)="        2) Summary pages are displayed in a human readable format used "
^DIC(9.4,14,22,5.9,"PAH",140,1,88,0)="           for quick viewing"
^DIC(9.4,14,22,5.9,"PAH",140,1,89,0)="        3) Displays reporting site name and station number"
^DIC(9.4,14,22,5.9,"PAH",140,1,90,0)="        4) Summary report is only 1-2 pages long"
^DIC(9.4,14,22,5.9,"PAH",140,1,91,0)="        5) Summary report displays emerging pathogens total number of"
^DIC(9.4,14,22,5.9,"PAH",140,1,92,0)="           occurrences during the monthly processing cycle"
^DIC(9.4,14,22,5.9,"PAH",140,1,93,0)="        6) Summary report displays emerging pathogens total number of"
^DIC(9.4,14,22,5.9,"PAH",140,1,94,0)="           persons with occurrences during the monthly processing cycle"
^DIC(9.4,14,22,5.9,"PAH",140,1,95,0)="        7) Displays Resolution of Risk Assessment number of persons "
^DIC(9.4,14,22,5.9,"PAH",140,1,96,0)="           with the nationally rolled-up resolution Hepatitis C that "
^DIC(9.4,14,22,5.9,"PAH",140,1,97,0)="           occurred during monthly processing cycle"
^DIC(9.4,14,22,5.9,"PAH",140,1,98,0)=""
^DIC(9.4,14,22,5.9,"PAH",140,1,99,0)="2) New Detailed Verification Report is a detailed pathogen-specific report for validation purposes.  The Print Detailed Verification Report [LREPI VERIFICATION REPORT] option prints t"
^DIC(9.4,14,22,5.9,"PAH",140,1,100,0)="automatically generated when your site does an automated or manual run and data is sent to Austin Automation Center.  Six months of previous reports are kept as well as the current mo"
^DIC(9.4,14,22,5.9,"PAH",140,1,101,0)=""
^DIC(9.4,14,22,5.9,"PAH",140,1,102,0)="3) Sites now have the ability to capture and manipulate EPI data into a "
^DIC(9.4,14,22,5.9,"PAH",140,1,103,0)="report or spreadsheet-delimited format.  A site can also add pathogens for local use and generate reports or capture data in a spreadsheet format for local use."
^DIC(9.4,14,22,5.9,"PAH",140,1,104,0)=""
^DIC(9.4,14,22,5.9,"PAH",140,1,105,0)="4) Additional data will be sent to Austin.  Including:"
^DIC(9.4,14,22,5.9,"PAH",140,1,106,0)="        LOINC codes"
^DIC(9.4,14,22,5.9,"PAH",140,1,107,0)="        Master Patient Index"
^DIC(9.4,14,22,5.9,"PAH",140,1,108,0)="        County and State for patient demographics"
^DIC(9.4,14,22,5.9,"PAH",140,1,109,0)="        MIC values"
^DIC(9.4,14,22,5.9,"PAH",140,1,110,0)="        The new Race and Ethnicity fields"
^DIC(9.4,14,22,5.9,"PAH",140,1,111,0)=""
^DIC(9.4,14,22,5.9,"PAH",140,1,112,0)="5) Provide the ability to capture 6 new pathogens:"
^DIC(9.4,14,22,5.9,"PAH",140,1,113,0)="        All Staphylococcus aureus (Reference #18)"
^DIC(9.4,14,22,5.9,"PAH",140,1,114,0)="        Methicillin-Resistant Staphylococcus aureus (MRSA)"
^DIC(9.4,14,22,5.9,"PAH",140,1,115,0)="        (Reference #19)"
^DIC(9.4,14,22,5.9,"PAH",140,1,116,0)="        Vancomycin-Resistant Staphylococcus aureus (VRSA)"
^DIC(9.4,14,22,5.9,"PAH",140,1,117,0)="         (Reference #20)"
^DIC(9.4,14,22,5.9,"PAH",140,1,118,0)="        Vancomycin-Resistant Coagulase Negative Staphylococci/Staph epi   "
^DIC(9.4,14,22,5.9,"PAH",140,1,119,0)="        (VRSE)(Reference #21)"
^DIC(9.4,14,22,5.9,"PAH",140,1,120,0)="        All Streptococcus pneumoniae (Reference #22)"
^DIC(9.4,14,22,5.9,"PAH",140,1,121,0)="        All Enterococci (Reference #23)"
^DIC(9.4,14,22,5.9,"PAH",140,1,122,0)=""
^DIC(9.4,14,22,5.9,"PAH",140,1,123,0)="6) EPI is also enhanced to capture the approved newer Legionella Urinary Antigen test."
^DIC(9.4,14,22,5.9,"PAH",140,1,124,0)=""
^DIC(9.4,14,22,5.9,"PAH",140,1,125,0)="7) A bug is fixed with the date handling for start and stop date."
^DIC(9.4,14,22,5.9,"PAH",140,1,126,0)=""
^DIC(9.4,14,22,5.9,"PAH",140,1,127,0)="8) The new field PREVIOUS CYCLE (#19) in the Lab Search/Extract file(#69.5) contains a numeric entry which defines the number of previous cycles to search.  These findings will be rep"
^DIC(9.4,14,22,5.9,"PAH",140,1,128,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,129,0)="NEW OPTIONS:"
^DIC(9.4,14,22,5.9,"PAH",140,1,130,0)="NAME: LREPI DELETE LOCAL PATHOGEN       MENU TEXT: Delete Local Pathogen"
^DIC(9.4,14,22,5.9,"PAH",140,1,131,0)="  TYPE: run routine"
^DIC(9.4,14,22,5.9,"PAH",140,1,132,0)="DESCRIPTION:   This option allows deletion of local pathogens ONLY. "
^DIC(9.4,14,22,5.9,"PAH",140,1,133,0)="National pathogens CAN NOT be deleted."
^DIC(9.4,14,22,5.9,"PAH",140,1,134,0)="  ROUTINE: DELETE^LREPIPI"
^DIC(9.4,14,22,5.9,"PAH",140,1,135,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,136,0)="NAME: LREPI DELETE LOCAL REPORT"
^DIC(9.4,14,22,5.9,"PAH",140,1,137,0)="  MENU TEXT: Delete Local Report or Spreadsheet"
^DIC(9.4,14,22,5.9,"PAH",140,1,138,0)="  TYPE: run routine"
^DIC(9.4,14,22,5.9,"PAH",140,1,139,0)=" DESCRIPTION:   This option allows you to delete local reports or local"
^DIC(9.4,14,22,5.9,"PAH",140,1,140,0)=" spreadsheets.  "
^DIC(9.4,14,22,5.9,"PAH",140,1,141,0)="  ROUTINE: DELETE^LREPIRS2"
^DIC(9.4,14,22,5.9,"PAH",140,1,142,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,143,0)="NAME: LREPI ENTER/EDIT LOCAL PATH       MENU TEXT: Enter/Edit Local "
^DIC(9.4,14,22,5.9,"PAH",140,1,144,0)="Pathogens"
^DIC(9.4,14,22,5.9,"PAH",140,1,145,0)="  TYPE: run routine"
^DIC(9.4,14,22,5.9,"PAH",140,1,146,0)=" DESCRIPTION:   This option allows you to enter or edit local pathogens "
^DIC(9.4,14,22,5.9,"PAH",140,1,147,0)="into the LAB SEARCH/EXTRACT FILE (#69.5)  These pathogens can be selected for the report/spreadsheet option.  Local pathogens WILL NOT be transmitted to Austin."
^DIC(9.4,14,22,5.9,"PAH",140,1,148,0)="  ROUTINE: LREPIPI"
^DIC(9.4,14,22,5.9,"PAH",140,1,149,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,150,0)="NAME: LREPI GENERATE REPORT/SP"
^DIC(9.4,14,22,5.9,"PAH",140,1,151,0)="  MENU TEXT: Lab EPI Generate Local Report/Spreadsheet"
^DIC(9.4,14,22,5.9,"PAH",140,1,152,0)="  TYPE: run routine"
^DIC(9.4,14,22,5.9,"PAH",140,1,153,0)=" DESCRIPTION:   This new option is used to generate reports or spreadsheets for national EPI and local pathogen data.  The job is automatically tasked after selecting the national EPI"
^DIC(9.4,14,22,5.9,"PAH",140,1,154,0)="or spreadsheet.  The report or spreadsheet can then be viewed on the screen or printed using the new LAB EPI Print Local Report/Spreadsheet option.  Note: NO data is transmitted to Au"
^DIC(9.4,14,22,5.9,"PAH",140,1,155,0)="  ROUTINE: LREPIRS"
^DIC(9.4,14,22,5.9,"PAH",140,1,156,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,157,0)="NAME: LREPI LOCAL PATHOGEN MENU         MENU TEXT: Local Pathogen Menu"
^DIC(9.4,14,22,5.9,"PAH",140,1,158,0)="  TYPE: menu"
^DIC(9.4,14,22,5.9,"PAH",140,1,159,0)=" DESCRIPTION:   This menu contains options to enter/edit and delete local pathogens.  Also, it contains options to generate and print the local report/spreadsheet.  "
^DIC(9.4,14,22,5.9,"PAH",140,1,160,0)="ITEM: LREPI ENTER/EDIT LOCAL PATH"
^DIC(9.4,14,22,5.9,"PAH",140,1,161,0)="ITEM: LREPI DELETE LOCAL PATHOGEN"
^DIC(9.4,14,22,5.9,"PAH",140,1,162,0)="ITEM: LREPI GENERATE REPORT/SP          SYNONYM: GEN"
^DIC(9.4,14,22,5.9,"PAH",140,1,163,0)="ITEM: LREPI PRINT REPORT/SPSHT          SYNONYM: PRT"
^DIC(9.4,14,22,5.9,"PAH",140,1,164,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,165,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,166,0)="NAME: LREPI PATHOGEN INQUIRY            MENU TEXT: Pathogen Inquiry"
^DIC(9.4,14,22,5.9,"PAH",140,1,167,0)="  TYPE: run routine"
^DIC(9.4,14,22,5.9,"PAH",140,1,168,0)=" DESCRIPTION:   This new option is used to inquire into the LAB"
^DIC(9.4,14,22,5.9,"PAH",140,1,169,0)="SEARCH/EXTRACT file (#69.5) parameter description fields (i.e. INACTIVE:NO, LAG DAYS: 15, RUN DATE:ICT 07,2003, CYCLE:MONTHLY, PROTOCOL:LREPI, FOLLOW PTF:YES, REFERENCE NUMBER:23, and"
^DIC(9.4,14,22,5.9,"PAH",140,1,170,0)="  ROUTINE: INQUIRY^LREPIPI"
^DIC(9.4,14,22,5.9,"PAH",140,1,171,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,172,0)="NAME: LREPI PRINT REPORT/SPSHT"
^DIC(9.4,14,22,5.9,"PAH",140,1,173,0)="  MENU TEXT: Lab EPI Print Local Report/Spreadsheet"
^DIC(9.4,14,22,5.9,"PAH",140,1,174,0)="  TYPE: run routine"
^DIC(9.4,14,22,5.9,"PAH",140,1,175,0)=" DESCRIPTION:   This option allows you to print a report or spreadsheet "
^DIC(9.4,14,22,5.9,"PAH",140,1,176,0)="that was generated with the Lab EPI Generate Local Report/Spreadsheet.  "
^DIC(9.4,14,22,5.9,"PAH",140,1,177,0)="  ROUTINE: LREPIRS2"
^DIC(9.4,14,22,5.9,"PAH",140,1,178,0)=" "
^DIC(9.4,14,22,5.9,"PAH",140,1,179,0)="NAME: LREPI VERIFICATION REPORT"
^DIC(9.4,14,22,5.9,"PAH",140,1,180,0)="  MENU TEXT: Print Detailed Verification Report"
^DIC(9.4,14,22,5.9,"PAH",140,1,181,0)="  TYPE: run routine"
^DIC(9.4,14,22,5.9,"PAH",140,1,182,0)=" DESCRIPTION:   This option prints the Detailed Verification Report.  This "
^DIC(9.4,14,22,5.9,"PAH",140,1,183,0)="report is automatically generated when your site does an automated or "
^DIC(9.4,14,22,5.9,"PAH",140,1,184,0)="manual run and data is sent to Austin Automation Center.  Six months of "
^DIC(9.4,14,22,5.9,"PAH",140,1,185,0)="previous reports are kept as well as the current month for printing.  "
^DIC(9.4,14,22,5.9,"PAH",140,1,186,0)="  ROUTINE: LREPIRP7"
^DIC(9.4,14,22,5.9,"PAH",140,1,187,0)=""
^DIC(9.4,14,22,5.9,"PAH",140,1,188,0)="MODIFIED OPTIONS:"
^DIC(9.4,14,22,5.9,"PAH",140,1,189,0)="NAME: LREPI ENHANCE MANUAL RUN          MENU TEXT: Lab EPI Manual Run (Enhanced)"
^DIC(9.4,14,22,5.9,"PAH",140,1,190,0)="  TYPE: run routine"
^DIC(9.4,14,22,5.9,"PAH",140,1,191,0)="DESCRIPTION:   This option is used ONLY to manually extract national EPI data"
^DIC(9.4,14,22,5.9,"PAH",140,1,192,0)=" and transmit to the Austin Automation Center (AAC). When this option is run,"
^DIC(9.4,14,22,5.9,"PAH",140,1,193,0)=" an EPI Summary Verification Report is generated and automatically sent to the"
^DIC(9.4,14,22,5.9,"PAH",140,1,194,0)=" EPI-Report mail group. Also, a Detailed Verification Report is generated and"
^DIC(9.4,14,22,5.9,"PAH",140,1,195,0)=" can be printed using the new Print Detailed Verification Report [LREPI"
^DIC(9.4,14,22,5.9,"PAH",140,1,196,0)=" VERIFICATION REPORT] option. This option has been RENAMED from Lab"
^DIC(9.4,14,22,5.9,"PAH",140,1,197,0)=" Search/Extract Manual Run (Enhanced) [LREPI SEARCH/EXTRACT ENHANCED MANUAL"
^DIC(9.4,14,22,5.9,"PAH",140,1,198,0)=" RUN] to EPI Manual Run (Enhanced) [LREPI ENHANCE MANUAL RUN] option.  "
^DIC(9.4,14,22,5.9,"PAH",140,1,199,0)="  ROUTINE: LREPIRM"
^DIC(9.4,14,22,5.9,"PAH",140,1,200,0)=""
^DIC(9.4,14,22,5.9,"PAH",140,1,201,0)="NAME: LREPI NIGHTLY TASK                MENU TEXT: Lab EPI Nightly Task"
^DIC(9.4,14,22,5.9,"PAH",140,1,202,0)="  TYPE: run routine"
^DIC(9.4,14,22,5.9,"PAH",140,1,203,0)=" DESCRIPTION:   The Lab Search/Extract Nightly Task option must be scheduled to"
^DIC(9.4,14,22,5.9,"PAH",140,1,204,0)=" run each night by TaskMan. This option will build a HL7 Message and send it"
^DIC(9.4,14,22,5.9,"PAH",140,1,205,0)=" the defined location specified in the EPI Protocols.  "
^DIC(9.4,14,22,5.9,"PAH",140,1,206,0)="  ROUTINE: AUTO^LREPIRM                 SCHEDULING RECOMMENDED: YES"
^DIC(9.4,14,22,5.9,"PAH",140,1,207,0)=""
^DIC(9.4,14,22,5.9,"PAH",140,1,208,0)="NAME: LREPI PARAMETER SETUP             MENU TEXT: Lab EPI Parameter Setup"
^DIC(9.4,14,22,5.9,"PAH",140,1,209,0)="  TYPE: ScreenMan"
^DIC(9.4,14,22,5.9,"PAH",140,1,210,0)="DESCRIPTION:   This option is used to define the search criteria along with"
^DIC(9.4,14,22,5.9,"PAH",140,1,211,0)=" additional information associated with the EPI extracts.  This option only"
^DIC(9.4,14,22,5.9,"PAH",140,1,212,0)=" allows editing.  You are not allowed to add local pathogens with this option.  "
^DIC(9.4,14,22,5.9,"PAH",140,1,213,0)="  DIC {DIC}: LAB(69.5,                  DIC(0): AEMQ"
^DIC(9.4,14,22,5.9,"PAH",140,1,214,0)="  DR{DDS}: [LREPI9]                     DDSFILE: 69.5"
^DIC(9.4,14,22,5.9,"PAH",140,1,215,0)=""
