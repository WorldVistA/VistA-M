^DIC(9.4,60,22,13,"PAH",602,1,715,0)="12.(HDSO-7772) Jump to eRx Patient from Backdoor"
^DIC(9.4,60,22,13,"PAH",602,1,716,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",602,1,717,0)="   A new hidden action called Jump to eRx Patient (JE) is being added to the"
^DIC(9.4,60,22,13,"PAH",602,1,718,0)="   Patient Prescription Processing [PSO LM BACKDOOR ORDERS] option. It will be"
^DIC(9.4,60,22,13,"PAH",602,1,719,0)="   available in the Patient Information screen as well as in the Medication "
^DIC(9.4,60,22,13,"PAH",602,1,720,0)="   Profile screen. This option will allow the user to jump to the eRx Holding"
^DIC(9.4,60,22,13,"PAH",602,1,721,0)="   Queue in the eRx Single Patient Queue.  "
^DIC(9.4,60,22,13,"PAH",602,1,722,0)="  "
