^DIC(9.4,4,22,1,"PAH",108,0)="131 SEQ #133^3000724^1"
^DIC(9.4,4,22,1,"PAH",108,1,0)="^^166^166^3000724"
^DIC(9.4,4,22,1,"PAH",108,1,1,0)="Patch XM*7.1*131"
^DIC(9.4,4,22,1,"PAH",108,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",108,1,3,0)="NOIS TAM-0700-30683"
^DIC(9.4,4,22,1,"PAH",108,1,4,0)="Test Site:  Tampa, FL"
^DIC(9.4,4,22,1,"PAH",108,1,5,0)="If you new a message in the WASTE basket, it tells you,"
^DIC(9.4,4,22,1,"PAH",108,1,6,0)="""Message saved to  basket.""  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",108,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",108,1,8,0)="E3R 1305, 4838"
^DIC(9.4,4,22,1,"PAH",108,1,9,0)="Test Site:  Biloxi, MS"
^DIC(9.4,4,22,1,"PAH",108,1,10,0)="Add status line showing number of new messages in new message list."
^DIC(9.4,4,22,1,"PAH",108,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",108,1,12,0)="E3R 2404"
^DIC(9.4,4,22,1,"PAH",108,1,13,0)="Test Site:  Biloxi, MS"
^DIC(9.4,4,22,1,"PAH",108,1,14,0)="If a message is broadcast, then prompt sender for a vaporize date, if one"
^DIC(9.4,4,22,1,"PAH",108,1,15,0)="hasn't already been supplied."
^DIC(9.4,4,22,1,"PAH",108,1,16,0)=""
^DIC(9.4,4,22,1,"PAH",108,1,17,0)="E3R 3417"
^DIC(9.4,4,22,1,"PAH",108,1,18,0)="Test Site:  Biloxi, MS"
^DIC(9.4,4,22,1,"PAH",108,1,19,0)="Add an option to vaporize groups of messages."
^DIC(9.4,4,22,1,"PAH",108,1,20,0)="Related help frames have been updated, and a new help frame,"
^DIC(9.4,4,22,1,"PAH",108,1,21,0)="XM-U-M-VAPORIZE EDIT-2, has been added."
^DIC(9.4,4,22,1,"PAH",108,1,22,0)="A new API, VAPORMSG^XMXAPI, has been added."
^DIC(9.4,4,22,1,"PAH",108,1,23,0)=""
^DIC(9.4,4,22,1,"PAH",108,1,24,0)="E3R 6215"
^DIC(9.4,4,22,1,"PAH",108,1,25,0)="Test Site:  Biloxi, MS"
^DIC(9.4,4,22,1,"PAH",108,1,26,0)="List broadcast recipients first during Q or QD."
^DIC(9.4,4,22,1,"PAH",108,1,27,0)=""
^DIC(9.4,4,22,1,"PAH",108,1,28,0)="E3R 14211"
^DIC(9.4,4,22,1,"PAH",108,1,29,0)="Test Site:  Palo Alto, CA"
^DIC(9.4,4,22,1,"PAH",108,1,30,0)="Let site decide whether or not to let a user drop out of a non-self-enrolling"
^DIC(9.4,4,22,1,"PAH",108,1,31,0)="mail group.  A new field has been added to file 4.3, MAILMAN SITE PARAMETERS,"
^DIC(9.4,4,22,1,"PAH",108,1,32,0)="and option XMKSP has been updated to include it.  Here's the new field:"
^DIC(9.4,4,22,1,"PAH",108,1,33,0)=""
^DIC(9.4,4,22,1,"PAH",108,1,34,0)="STANDARD DATA DICTIONARY #4.3 -- MAILMAN SITE PARAMETERS FILE"
^DIC(9.4,4,22,1,"PAH",108,1,35,0)="STORED IN ^XMB(1,  (1 ENTRY)   (VERSION 7.1)"
^DIC(9.4,4,22,1,"PAH",108,1,36,0)=""
^DIC(9.4,4,22,1,"PAH",108,1,37,0)="DATA     NAME                  GLOBAL        DATA"
^DIC(9.4,4,22,1,"PAH",108,1,38,0)="ELEMENT  TITLE                 LOCATION      TYPE"
^DIC(9.4,4,22,1,"PAH",108,1,39,0)="---------------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",108,1,40,0)="4.3,22   DROP OUT OF RESTRICTED GROUP 2;2 SET"
^DIC(9.4,4,22,1,"PAH",108,1,41,0)=" "
^DIC(9.4,4,22,1,"PAH",108,1,42,0)="                           '0' FOR NO;"
^DIC(9.4,4,22,1,"PAH",108,1,43,0)="                           '1' FOR YES;"
^DIC(9.4,4,22,1,"PAH",108,1,44,0)="         LAST EDITED:      JUN 06, 2000"
^DIC(9.4,4,22,1,"PAH",108,1,45,0)="         HELP-PROMPT:      Let users drop out of non-self-enrolling mail"
^DIC(9.4,4,22,1,"PAH",108,1,46,0)="                           groups?"
^DIC(9.4,4,22,1,"PAH",108,1,47,0)="         DESCRIPTION:      Enter YES if you wish to allow users to drop"
^DIC(9.4,4,22,1,"PAH",108,1,48,0)="                           out of non-self-enrolling mail groups.  The"
^DIC(9.4,4,22,1,"PAH",108,1,49,0)="                           users will be warned that this is a"
^DIC(9.4,4,22,1,"PAH",108,1,50,0)="                           non-self-enrolling group, and that they won't"
^DIC(9.4,4,22,1,"PAH",108,1,51,0)="                           be allowed to rejoin later, and then they will"
^DIC(9.4,4,22,1,"PAH",108,1,52,0)="                           be asked to re-confirm the decision to drop out."
^DIC(9.4,4,22,1,"PAH",108,1,53,0)=" "
^DIC(9.4,4,22,1,"PAH",108,1,54,0)="                           Enter NO if you don't.  (This is the default.)"
^DIC(9.4,4,22,1,"PAH",108,1,55,0)="                           Then users will have to contact IRM or the mail"
^DIC(9.4,4,22,1,"PAH",108,1,56,0)="                           group coordinator to ask to be dropped."
^DIC(9.4,4,22,1,"PAH",108,1,57,0)=" "
^DIC(9.4,4,22,1,"PAH",108,1,58,0)="         TECHNICAL DESCR:  If a mail group is not a self-enrolling mail"
^DIC(9.4,4,22,1,"PAH",108,1,59,0)="                           group, then users can't just join.  They must"
^DIC(9.4,4,22,1,"PAH",108,1,60,0)="                           be added by the mail group coordinator."
^DIC(9.4,4,22,1,"PAH",108,1,61,0)=" "
^DIC(9.4,4,22,1,"PAH",108,1,62,0)="                           If a user no longer wishes to be a member of"
^DIC(9.4,4,22,1,"PAH",108,1,63,0)="                           such a group, he must ask the group coordinator"
^DIC(9.4,4,22,1,"PAH",108,1,64,0)="                           to drop him.  But what if the group coordinator"
^DIC(9.4,4,22,1,"PAH",108,1,65,0)="                           has left the organization or is unresponsive?"
^DIC(9.4,4,22,1,"PAH",108,1,66,0)="                           Then what?  Then the user will have to ask IRM"
^DIC(9.4,4,22,1,"PAH",108,1,67,0)="                           to help.  This problem can be avoided by"
^DIC(9.4,4,22,1,"PAH",108,1,68,0)="                           setting this field to YES."
^DIC(9.4,4,22,1,"PAH",108,1,69,0)=" "
^DIC(9.4,4,22,1,"PAH",108,1,70,0)="                           Some would argue that the coordinator added the"
^DIC(9.4,4,22,1,"PAH",108,1,71,0)="                           user to the group for a reason, and the user"
^DIC(9.4,4,22,1,"PAH",108,1,72,0)="                           should not be allowed to drop out.  (Perhaps"
^DIC(9.4,4,22,1,"PAH",108,1,73,0)="                           the coordinator is the user's boss.)  They"
^DIC(9.4,4,22,1,"PAH",108,1,74,0)="                           would argue that it is MailMan's job to prevent"
^DIC(9.4,4,22,1,"PAH",108,1,75,0)="                           the user from dropping out.  (Set the field to"
^DIC(9.4,4,22,1,"PAH",108,1,76,0)="                           NO.) Others would argue that it is not"
^DIC(9.4,4,22,1,"PAH",108,1,77,0)="                           MailMan's job at all, but the boss's job to"
^DIC(9.4,4,22,1,"PAH",108,1,78,0)="                           prevent the user from dropping out, and to"
^DIC(9.4,4,22,1,"PAH",108,1,79,0)="                           discipline the user if he does.  (Set the field"
^DIC(9.4,4,22,1,"PAH",108,1,80,0)="                           to YES.)"
^DIC(9.4,4,22,1,"PAH",108,1,81,0)=""
^DIC(9.4,4,22,1,"PAH",108,1,82,0)="*Note: If you do nothing with this new field, then this patch will not"
^DIC(9.4,4,22,1,"PAH",108,1,83,0)="change MailMan's behavior.  Users will not be able to drop out of"
^DIC(9.4,4,22,1,"PAH",108,1,84,0)="non-self-enrolling mail groups."
^DIC(9.4,4,22,1,"PAH",108,1,85,0)=""
^DIC(9.4,4,22,1,"PAH",108,1,86,0)="Additionally,"
^DIC(9.4,4,22,1,"PAH",108,1,87,0)=""
^DIC(9.4,4,22,1,"PAH",108,1,88,0)="This patch introduces two more new APIs:"
^DIC(9.4,4,22,1,"PAH",108,1,89,0)="$$TPMSGCT^XMXUTIL - returns # of new priority messages in a user's mailbox."
^DIC(9.4,4,22,1,"PAH",108,1,90,0)="$$BPMSGCT^XMXUTIL - returns # of new priority messages in a user's basket."
^DIC(9.4,4,22,1,"PAH",108,1,91,0)=""
^DIC(9.4,4,22,1,"PAH",108,1,92,0)="This patch fixes a problem noticed on FORUM that could cause infinite looping"
^DIC(9.4,4,22,1,"PAH",108,1,93,0)="of error messages from remote sites."
^DIC(9.4,4,22,1,"PAH",108,1,94,0)=""
^DIC(9.4,4,22,1,"PAH",108,1,95,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",108,1,96,0)="is at a minimum.  It requires MailMan patches XM*7.1*107, XM*7.1*124,"
^DIC(9.4,4,22,1,"PAH",108,1,97,0)="XM*7.1*127, and XM*7.1*130."
^DIC(9.4,4,22,1,"PAH",108,1,98,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",108,1,99,0)=""
^DIC(9.4,4,22,1,"PAH",108,1,100,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",108,1,101,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",108,1,102,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",108,1,103,0)=" "
^DIC(9.4,4,22,1,"PAH",108,1,104,0)="              Before          After"
^DIC(9.4,4,22,1,"PAH",108,1,105,0)="Name          Checksum        Checksum        Patch List"
