^DIC(9.4,48,22,5.28,"PAH",674,1,34,0)="VSE-8143: BF - VistA: Modify SDES CLIN PRECAN to correct date range "
^DIC(9.4,48,22,5.28,"PAH",674,1,35,0)="          validation"
