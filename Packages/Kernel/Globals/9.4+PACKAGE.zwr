^DIC(9.4,148,5)="HINES"
^DIC(9.4,148,7)="^^I"
^DIC(9.4,148,11)="154^154.99"
^DIC(9.4,148,22,0)="^9.49I^9^3"
^DIC(9.4,148,22,7,0)="1.5^2951120^2960925"
^DIC(9.4,148,22,8,0)="2.0^3051119^2970107^1"
^DIC(9.4,148,22,8,1,0)="^^1^1^3051119"
^DIC(9.4,148,22,8,1,1,0)="Spinal Cord Dysfunction Version 2.0"
^DIC(9.4,148,22,8,"PAH",0)="^9.4901^25^25"
^DIC(9.4,148,22,8,"PAH",1,0)="1^2970221^1"
^DIC(9.4,148,22,8,"PAH",1,1,0)="^^2^2^2970221"
^DIC(9.4,148,22,8,"PAH",1,1,1,0)="This is patch 1 of Spinal Cord Dysfunction Version 2.  This patch will fix"
^DIC(9.4,148,22,8,"PAH",1,1,2,0)="the undefined variable SPNPAGE."
^DIC(9.4,148,22,8,"PAH",2,0)="2^2970528^1"
^DIC(9.4,148,22,8,"PAH",2,1,0)="^^5^5^2970528"
^DIC(9.4,148,22,8,"PAH",2,1,1,0)="This is patch 2 for Spinal Cord Dysfunction Version 2.0.  This patch"
^DIC(9.4,148,22,8,"PAH",2,1,2,0)="resolves the following NOIS: CAS-0497-10709, WIM-0497-20628,"
^DIC(9.4,148,22,8,"PAH",2,1,3,0)="HOU-0497-70385, BRK-0397-12815, HUN-0397-20346, ISD-0397-70256,"
^DIC(9.4,148,22,8,"PAH",2,1,4,0)="DAY-0397-40132, DEN-0297-51749, SDC-0297-61101, SDC-0297-60260,"
^DIC(9.4,148,22,8,"PAH",2,1,5,0)="and LIT-0197-71898."
^DIC(9.4,148,22,8,"PAH",3,0)="3^2971127^1"
^DIC(9.4,148,22,8,"PAH",3,1,0)="^^129^129^2971127"
^DIC(9.4,148,22,8,"PAH",3,1,1,0)="This patch will enhance the Spinal Cord Dysfunction 2.0 package "
^DIC(9.4,148,22,8,"PAH",3,1,2,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,3,0)="This patch will also resolve the following: "
^DIC(9.4,148,22,8,"PAH",3,1,4,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,5,0)="1) NOIS# IOW-0997-41147 Undefined Variable DO"
^DIC(9.4,148,22,8,"PAH",3,1,6,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,7,0)="   Option: Registrant General Report [SPNL REGISTRANT GENERAL REPORT]"
^DIC(9.4,148,22,8,"PAH",3,1,8,0)="An undefined D0 error will occur when the user uses the option Registrant"
^DIC(9.4,148,22,8,"PAH",3,1,9,0)="General Report under the filtered Reports [SPNL SCD REPORTS (FILTERED)]."
^DIC(9.4,148,22,8,"PAH",3,1,10,0)="This problem is fixed with routine SPNLPIN. This patch is to correct an"
^DIC(9.4,148,22,8,"PAH",3,1,11,0)="error in the Sort by Geographical Area. The routine SPNPSR06 has been"
^DIC(9.4,148,22,8,"PAH",3,1,12,0)="corrected.  The routines was modified to use D0 (""0"" Zero) instead of"
^DIC(9.4,148,22,8,"PAH",3,1,13,0)="DO (""O"" Letter)."
^DIC(9.4,148,22,8,"PAH",3,1,14,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,15,0)="2) NOIS# SDC-0697-61902 Data Error in FSS report"
^DIC(9.4,148,22,8,"PAH",3,1,16,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,17,0)="   Option: Functional Status Scores [SPNF FIM SCORES]"
^DIC(9.4,148,22,8,"PAH",3,1,18,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,19,0)="When a user selects the option 2 Clinical Reported FIM, under the"
^DIC(9.4,148,22,8,"PAH",3,1,20,0)="selection 2 Functional Information to enter Functional Status data for SCD"
^DIC(9.4,148,22,8,"PAH",3,1,21,0)="patients, the user will get the wrong Extent & Completeness and Type of"
^DIC(9.4,148,22,8,"PAH",3,1,22,0)="Injury data displayed when the user runs the Total Score Selection option"
^DIC(9.4,148,22,8,"PAH",3,1,23,0)="in the Functional Status Score. Routine SPNFPLT1 has been modified to"
^DIC(9.4,148,22,8,"PAH",3,1,24,0)="calculate the data correctly. "
^DIC(9.4,148,22,8,"PAH",3,1,25,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,26,0)="3) NOIS# LIT-0697-71551 Last Physical Date"
^DIC(9.4,148,22,8,"PAH",3,1,27,0)="         TAM-0297-30780 Last Physical Exam Field included in report."
^DIC(9.4,148,22,8,"PAH",3,1,28,0)="   Option: Follow-up (Last Physical Exam)"
^DIC(9.4,148,22,8,"PAH",3,1,29,0)="           [SPNL F/U LAST PHYS EXAM]"
^DIC(9.4,148,22,8,"PAH",3,1,30,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,31,0)="When the user enters dates in the Sub-Fields, ANNUAL REHAB EVAL OFFERED"
^DIC(9.4,148,22,8,"PAH",3,1,32,0)="(#.01), ANNUAL REHAB EVAL RECEIVED (#1), and NEXT ANNUAL REHAB EVAL DUE "
^DIC(9.4,148,22,8,"PAH",3,1,33,0)="(#2), under the Multiple field ANNUAL REHAB EVAL OFFERED #7 in file 154,"
^DIC(9.4,148,22,8,"PAH",3,1,34,0)="SCD (Spinal Cord) Registry, the option Follow-up (Last Physical Exam) under"
^DIC(9.4,148,22,8,"PAH",3,1,35,0)="the Filtered Reports menu should display the date in the field ANNUAL"
^DIC(9.4,148,22,8,"PAH",3,1,36,0)="REHAB EVAL RECEIVED #1 instead of the date in the field LAST PHYSICAL EXAM"
^DIC(9.4,148,22,8,"PAH",3,1,37,0)="#1.2, which is no longer used will be deleted in a future release. This is"
^DIC(9.4,148,22,8,"PAH",3,1,38,0)="fixed in the routines SPNLR and SPNLRE."
^DIC(9.4,148,22,8,"PAH",3,1,39,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,40,0)="4) NOIS# DEN-0597-52404 Reg. Injury Report Wrong Sent to printer"
^DIC(9.4,148,22,8,"PAH",3,1,41,0)="   Option: Registrant Injury Report"
^DIC(9.4,148,22,8,"PAH",3,1,42,0)="           [SPNL REGISTRANT INJURY REPORT]"
^DIC(9.4,148,22,8,"PAH",3,1,43,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,44,0)="If the user enters in filter criteria to screen on SCD Patients for the"
^DIC(9.4,148,22,8,"PAH",3,1,45,0)="Registrant Injury Report, the program would not use the filters if that"
^DIC(9.4,148,22,8,"PAH",3,1,46,0)="report were queued to a printer.  This is fixed in routine SPNLPIN"
^DIC(9.4,148,22,8,"PAH",3,1,47,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,48,0)="5) NOIS# BRK-0397-12815 Extract Error"
^DIC(9.4,148,22,8,"PAH",3,1,49,0)="   Database Correction: Field MS Type (#2.2) in SCD (SPINAL CORD) "
^DIC(9.4,148,22,8,"PAH",3,1,50,0)="                        REGISTRY File (#154)"
^DIC(9.4,148,22,8,"PAH",3,1,51,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,52,0)="The data was not deleted in the global position prior the creation of the"
^DIC(9.4,148,22,8,"PAH",3,1,53,0)="field MS Type #2.2 in the in SCD (SPINAL CORD) REGISTRY File (154).  The"
^DIC(9.4,148,22,8,"PAH",3,1,54,0)="Post- Init will check the data and delete all invalid entries."
^DIC(9.4,148,22,8,"PAH",3,1,55,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,56,0)="NON-NOIS ISSUES"
^DIC(9.4,148,22,8,"PAH",3,1,57,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,58,0)="6) Filtered Reports menu Enhancement"
^DIC(9.4,148,22,8,"PAH",3,1,59,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,60,0)="The option Filtered Reports [SPNL SCD REPORT(FILTERED)] menu has been"
^DIC(9.4,148,22,8,"PAH",3,1,61,0)="modified to allow users to turn off the filters.  This enhancement will"
^DIC(9.4,148,22,8,"PAH",3,1,62,0)="give the users the option of using the filters for the filtered reports or"
^DIC(9.4,148,22,8,"PAH",3,1,63,0)="skip the filters and go directly to the reports. The following routines"
^DIC(9.4,148,22,8,"PAH",3,1,64,0)="have been modified: SPNPRTMT, and SPNPRTUP."
^DIC(9.4,148,22,8,"PAH",3,1,65,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,66,0)="7) Patient Summary Report Fix"
^DIC(9.4,148,22,8,"PAH",3,1,67,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,68,0)="This patch will fix the report, Patient Summary Report [SPNL REGISTRY"
^DIC(9.4,148,22,8,"PAH",3,1,69,0)="SUMMARY].  The Print Template [SPNL REGISTRY DUMP] in file 154 has been"
^DIC(9.4,148,22,8,"PAH",3,1,70,0)="modified by replacing the old field LAST PHYSICAL EXAM with the latest"
^DIC(9.4,148,22,8,"PAH",3,1,71,0)="entry in field ANNUAL REHAB EVAL RECEIVED (#1) in the ANNUAL REHAB EVAL"
^DIC(9.4,148,22,8,"PAH",3,1,72,0)="OFFERED multiple (#7).  The new field will be listed as Last Annual Rehab"
^DIC(9.4,148,22,8,"PAH",3,1,73,0)="Received.                                                               "
^DIC(9.4,148,22,8,"PAH",3,1,74,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,75,0)="Test Sites                                                                    "
^DIC(9.4,148,22,8,"PAH",3,1,76,0)="==========                                                                    "
^DIC(9.4,148,22,8,"PAH",3,1,77,0)="Iowa City, IA                                                                 "
^DIC(9.4,148,22,8,"PAH",3,1,78,0)="San Diego, CA                                                                 "
^DIC(9.4,148,22,8,"PAH",3,1,79,0)="Little Rock, AR                                                               "
^DIC(9.4,148,22,8,"PAH",3,1,80,0)="Denver, CO                                                                    "
^DIC(9.4,148,22,8,"PAH",3,1,81,0)="Brockton, MA                                                                  "
^DIC(9.4,148,22,8,"PAH",3,1,82,0)="Tampa, FL                                                                    "
^DIC(9.4,148,22,8,"PAH",3,1,83,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,84,0)="Routine Summary:"
^DIC(9.4,148,22,8,"PAH",3,1,85,0)="================"
^DIC(9.4,148,22,8,"PAH",3,1,86,0)="The following routines are included in this patch.  The second line of"
^DIC(9.4,148,22,8,"PAH",3,1,87,0)="these routines should look like: "
^DIC(9.4,148,22,8,"PAH",3,1,88,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,89,0)="  <tab>;;2.0; Spinal Cord Dysfunction;**[patch list]**; 01/02/1997"
^DIC(9.4,148,22,8,"PAH",3,1,90,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,91,0)="CHECK^XTSUMBLD results:     "
^DIC(9.4,148,22,8,"PAH",3,1,92,0)=" "
^DIC(9.4,148,22,8,"PAH",3,1,93,0)="Routine Name   Before Patch    After Patch    Patch List                      "
^DIC(9.4,148,22,8,"PAH",3,1,94,0)="============   ============    ===========    ==========                      "
^DIC(9.4,148,22,8,"PAH",3,1,95,0)="SPNFPLT1         5617787         5730334         **3**                        "
