^DIC(9.4,48,22,5.28,"PAH",579,1,325,0)="26) Jira #VSE-786 - Speed up processing of JSON RPC"
^DIC(9.4,48,22,5.28,"PAH",579,1,326,0)=" "
^DIC(9.4,48,22,5.28,"PAH",579,1,327,0)="Problem:"
^DIC(9.4,48,22,5.28,"PAH",579,1,328,0)="Current VSE Broker code that processes JSON responses from RPCs is slow. "
^DIC(9.4,48,22,5.28,"PAH",579,1,329,0)="If the JSON response contains a few hundred records, it can take minutes "
^DIC(9.4,48,22,5.28,"PAH",579,1,330,0)="to parse all the data. That is because instead of parsing the data stream "
^DIC(9.4,48,22,5.28,"PAH",579,1,331,0)="as an array of strings, which is how VistA returns JSON, the VSE Broker "
^DIC(9.4,48,22,5.28,"PAH",579,1,332,0)="uses the code intended for single string value RPCs, which checks each "
^DIC(9.4,48,22,5.28,"PAH",579,1,333,0)="character for the end of transmission."
^DIC(9.4,48,22,5.28,"PAH",580,0)="786b^3210707"
^DIC(9.4,48,22,5.28,"PAH",580,1,0)="^^5^5^3210707"
^DIC(9.4,48,22,5.28,"PAH",580,1,1,0)="Backup of SD*5.3*786 on Jul 07, 2021"
^DIC(9.4,48,22,5.28,"PAH",580,1,2,0)=" "
^DIC(9.4,48,22,5.28,"PAH",580,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,48,22,5.28,"PAH",580,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,48,22,5.28,"PAH",580,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,48,22,5.28,"PAH",581,0)="786 SEQ #638^3210707.091354^17"
^DIC(9.4,48,22,5.28,"PAH",581,1,0)="^^2^2^3210707"
^DIC(9.4,48,22,5.28,"PAH",581,1,1,0)="Patch SD*5.3*786 will unschedule and mark out of order the"
