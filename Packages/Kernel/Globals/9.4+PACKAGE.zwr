^DIC(9.4,3,22,21,"PAH",52,1,6,0)="Subject:"
^DIC(9.4,3,22,21,"PAH",52,1,7,0)="======"
^DIC(9.4,3,22,21,"PAH",52,1,8,0)="     XU*8*60   CORRECT NAMESPACE PROBLEM/FIX MICROSURGERY"
^DIC(9.4,3,22,21,"PAH",52,1,9,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,10,0)="     When the routine XUSHSHP was written to hash the signature block in"
^DIC(9.4,3,22,21,"PAH",52,1,11,0)="     file 200, several local variables were used which were not within the"
^DIC(9.4,3,22,21,"PAH",52,1,12,0)="     Kernel namespace.  As would be expected, at least one of the"
^DIC(9.4,3,22,21,"PAH",52,1,13,0)="     variables is now another namespace and conflicts have arisen.  This"
^DIC(9.4,3,22,21,"PAH",52,1,14,0)="     patch uses the NEW command to limit the scope of these incorrectly"
^DIC(9.4,3,22,21,"PAH",52,1,15,0)="     namespaced variables to the code in which they are used, and will"
^DIC(9.4,3,22,21,"PAH",52,1,16,0)="     prevent future problems with other packages due to this error."
^DIC(9.4,3,22,21,"PAH",52,1,17,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,18,0)="     Several alpha sites reported unusually high activity associated"
^DIC(9.4,3,22,21,"PAH",52,1,19,0)="     with the XUTL global.  This was identified as a problem related to "
^DIC(9.4,3,22,21,"PAH",52,1,20,0)="     a spuriously high date value being set into the ""AT"" cross "
^DIC(9.4,3,22,21,"PAH",52,1,21,0)="     reference in file 19.  Since this date was always ahead of NOW,"
^DIC(9.4,3,22,21,"PAH",52,1,22,0)="     micro-surgery would restart as soon as it had completed.  To "
^DIC(9.4,3,22,21,"PAH",52,1,23,0)="     correct this problem, this patch contains a change to XQ83 which "
^DIC(9.4,3,22,21,"PAH",52,1,24,0)="     will reset any of these spurious future nodes to NOW and stop this "
^DIC(9.4,3,22,21,"PAH",52,1,25,0)="     excess activity.  A change is also made in XQ7 which will prevent "
^DIC(9.4,3,22,21,"PAH",52,1,26,0)="     these nodes being set incorrectly in the future."
^DIC(9.4,3,22,21,"PAH",52,1,27,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,28,0)="     There have also been some reports of problems [NOIS CLA-0397-22395]"
^DIC(9.4,3,22,21,"PAH",52,1,29,0)="     associated with the value of ZTCPU being reset as a result of a call"
^DIC(9.4,3,22,21,"PAH",52,1,30,0)="     to KICK^XQ7 during KIDS installations.  This problem is corrected by"
^DIC(9.4,3,22,21,"PAH",52,1,31,0)="     NEWING the value ZTCPU before it is used in KICK^XQ7."
^DIC(9.4,3,22,21,"PAH",52,1,32,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,33,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,34,0)="Category:"
^DIC(9.4,3,22,21,"PAH",52,1,35,0)="======="
^DIC(9.4,3,22,21,"PAH",52,1,36,0)="     Routine"
^DIC(9.4,3,22,21,"PAH",52,1,37,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,38,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,39,0)="Test Sites :"
^DIC(9.4,3,22,21,"PAH",52,1,40,0)="=============="
^DIC(9.4,3,22,21,"PAH",52,1,41,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,42,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,43,0)="Routine Summary :"
^DIC(9.4,3,22,21,"PAH",52,1,44,0)="=============="
^DIC(9.4,3,22,21,"PAH",52,1,45,0)="     The following is a list of the routines included in this patch.  The"
^DIC(9.4,3,22,21,"PAH",52,1,46,0)="     second line of each of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",52,1,47,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,48,0)="    XQ7             <tab>;;8.0;KERNEL;**44,60**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",52,1,49,0)="    XQ83            <tab>;;8.0;KERNEL;**60**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",52,1,50,0)="    XUSHSHP         <tab>;;8.0;KERNEL;**60**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",52,1,51,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,52,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,53,0)="Routine Name                      Patch List"
^DIC(9.4,3,22,21,"PAH",52,1,54,0)="------------                     --------------"
^DIC(9.4,3,22,21,"PAH",52,1,55,0)="XQ7                                44,60"
^DIC(9.4,3,22,21,"PAH",52,1,56,0)="XQ83                               60"
^DIC(9.4,3,22,21,"PAH",52,1,57,0)="XUSHSHP                            60"
^DIC(9.4,3,22,21,"PAH",52,1,58,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,59,0)="Checksums:"
^DIC(9.4,3,22,21,"PAH",52,1,60,0)="========="
^DIC(9.4,3,22,21,"PAH",52,1,61,0)="  Rtn Nm           Chksum Before        Chksum After         Patch List"
^DIC(9.4,3,22,21,"PAH",52,1,62,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,63,0)="  XQ7                2506259              2523046             44,60"
^DIC(9.4,3,22,21,"PAH",52,1,64,0)="  XQ83               9490213             10007662             60"
^DIC(9.4,3,22,21,"PAH",52,1,65,0)="  XUSHSHP           11148336             11486766             60"
^DIC(9.4,3,22,21,"PAH",52,1,66,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,67,0)="  _X_ Used CHECK^XTSUMBLD     (or)    ___ Used KIDS option"
^DIC(9.4,3,22,21,"PAH",52,1,68,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,69,0)="     To test if the transport has been corrupted, you can use the "
^DIC(9.4,3,22,21,"PAH",52,1,70,0)="     ""Verify Package Integrity"" option.  This option is under Utilities "
^DIC(9.4,3,22,21,"PAH",52,1,71,0)="     under the KIDS menu.  It will compare the checksums in the build "
^DIC(9.4,3,22,21,"PAH",52,1,72,0)="     with the current checksums and list any that differ."
^DIC(9.4,3,22,21,"PAH",52,1,73,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,74,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,75,0)="Installation Instructions:"
^DIC(9.4,3,22,21,"PAH",52,1,76,0)="==================="
^DIC(9.4,3,22,21,"PAH",52,1,77,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,78,0)="     1.   Users ARE allowed to be on the system during the "
^DIC(9.4,3,22,21,"PAH",52,1,79,0)="          installation.  However, since XQ83 is referenced during the"
^DIC(9.4,3,22,21,"PAH",52,1,80,0)="          log-on procedure, BRIEFLY INHIBITING LOGONS while the patch is"
^DIC(9.4,3,22,21,"PAH",52,1,81,0)="          installed is recommended"
^DIC(9.4,3,22,21,"PAH",52,1,82,0)="     2.   DO NOT place TaskMan in a WAIT/STOP state. "
^DIC(9.4,3,22,21,"PAH",52,1,83,0)="     3.   The routines in this patch are used in the background and"
^DIC(9.4,3,22,21,"PAH",52,1,84,0)="          will not normally affect journaling, compiled templates, or"
^DIC(9.4,3,22,21,"PAH",52,1,85,0)="          option usage."
^DIC(9.4,3,22,21,"PAH",52,1,86,0)="     4.   These routines are usually mapped on systems that allow "
^DIC(9.4,3,22,21,"PAH",52,1,87,0)="          mapping, so you will need to disable mapping for the affected"
^DIC(9.4,3,22,21,"PAH",52,1,88,0)="          routines."
^DIC(9.4,3,22,21,"PAH",52,1,89,0)="     5.   Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. "
^DIC(9.4,3,22,21,"PAH",52,1,90,0)="          This option will load the KIDS package onto your system.  "
^DIC(9.4,3,22,21,"PAH",52,1,91,0)="     6.   The patch has now been loaded into a Transport global on your "
^DIC(9.4,3,22,21,"PAH",52,1,92,0)="          system. You now need to use KIDS to install the Transport"
^DIC(9.4,3,22,21,"PAH",52,1,93,0)="          global.  "
^DIC(9.4,3,22,21,"PAH",52,1,94,0)="     7.   On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,3,22,21,"PAH",52,1,95,0)="             following options: "
^DIC(9.4,3,22,21,"PAH",52,1,96,0)=" "
^DIC(9.4,3,22,21,"PAH",52,1,97,0)="           Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",52,1,98,0)="           Print Transport Global "
^DIC(9.4,3,22,21,"PAH",52,1,99,0)="           Compare Transport Global to Current System "
^DIC(9.4,3,22,21,"PAH",52,1,100,0)="           Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",52,1,101,0)="           Install Package(s) "
^DIC(9.4,3,22,21,"PAH",52,1,102,0)="           INSTALL NAME: XU*8.0*60"
^DIC(9.4,3,22,21,"PAH",52,1,103,0)="                                          ========="
^DIC(9.4,3,22,21,"PAH",52,1,104,0)="     8.   MSM Sites - Answer YES to the question 'Want to MOVE "
^DIC(9.4,3,22,21,"PAH",52,1,105,0)="                      routines to other CPUs?'. Enter the names of your "
^DIC(9.4,3,22,21,"PAH",52,1,106,0)="                      Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",52,1,107,0)="           AXP Sites - Answer NO to this question."
^DIC(9.4,3,22,21,"PAH",52,1,108,0)="     9.   Rebuild your mapped set if necessary."
^DIC(9.4,3,22,21,"PAH",53,0)="71^2980218"
^DIC(9.4,3,22,21,"PAH",53,1,0)="^^104^104^2980408"
^DIC(9.4,3,22,21,"PAH",53,1,1,0)="This patch includes routines that either needed change because of Y2K"
^DIC(9.4,3,22,21,"PAH",53,1,2,0)="analysis or provide new date formats for others to use."
^DIC(9.4,3,22,21,"PAH",53,1,3,0)=""
^DIC(9.4,3,22,21,"PAH",53,1,4,0)="See the Web page to see the new formats available with FMTE^XLFDT and"
^DIC(9.4,3,22,21,"PAH",53,1,5,0)="HTE^XLFDT. "
^DIC(9.4,3,22,21,"PAH",53,1,6,0)=" http://www.vista.domain.ext/softserv/infrastr.uct/kernel/y2k/index.html"
^DIC(9.4,3,22,21,"PAH",53,1,7,0)=""
^DIC(9.4,3,22,21,"PAH",53,1,8,0)="Here is a sample,  Note the NEW values for y.  5, 6, 7 "
^DIC(9.4,3,22,21,"PAH",53,1,9,0)="$$FMTE(x[,y])"
^DIC(9.4,3,22,21,"PAH",53,1,10,0)="VA FileMan to External"
^DIC(9.4,3,22,21,"PAH",53,1,11,0)="       Return conversion to an external format of a date in VA FileMan format."
^DIC(9.4,3,22,21,"PAH",53,1,12,0)="       arguments:  x  VA FileMan date"
^DIC(9.4,3,22,21,"PAH",53,1,13,0)="                   y  [optional] Affects output as follows:"
^DIC(9.4,3,22,21,"PAH",53,1,14,0)="               If '$D(y) then return standard VA FileMan format."
^DIC(9.4,3,22,21,"PAH",53,1,15,0)="               If +y = 1 then return standard VA FileMan format."
^DIC(9.4,3,22,21,"PAH",53,1,16,0)="               If +y = 2 then return MM/DD/YY@HH:MM:SS format."
^DIC(9.4,3,22,21,"PAH",53,1,17,0)="               If +y = 3 then return DD/MM/YY@HH:MM:SS format."
^DIC(9.4,3,22,21,"PAH",53,1,18,0)="               If +y = 4 then return YY/MM/DD@HH:MM:SS format."
^DIC(9.4,3,22,21,"PAH",53,1,19,0)="               If +y = 5 then return MM/DD/YYYYHH:MM:SS format."
^DIC(9.4,3,22,21,"PAH",53,1,20,0)="               If +y = 6 then return DD/MM/YYYY@HH:MM:SS format."
^DIC(9.4,3,22,21,"PAH",53,1,21,0)="               If +y = 7 then return YYYY/MM/DD@HH:MM:SS format."
^DIC(9.4,3,22,21,"PAH",53,1,22,0)="               If y contains ""D"" then Date only."
^DIC(9.4,3,22,21,"PAH",53,1,23,0)="               If y contains ""F"" then output date with leading blanks."
^DIC(9.4,3,22,21,"PAH",53,1,24,0)="               If y contains ""P"" then output ""HH:MM:SS am/pm""."
^DIC(9.4,3,22,21,"PAH",53,1,25,0)="               If y contains ""M"" then output ""HH:MM"" only."
^DIC(9.4,3,22,21,"PAH",53,1,26,0)="               If y contains ""S"" then force seconds in the output."
^DIC(9.4,3,22,21,"PAH",53,1,27,0)="               If y contains ""Z"" then output date with leading zeros."
^DIC(9.4,3,22,21,"PAH",53,1,28,0)="               "
^DIC(9.4,3,22,21,"PAH",53,1,29,0)="               W $$HTE^XLFDT(""54786,40523"")      --> Dec 31, 1990@11:15:23"
^DIC(9.4,3,22,21,"PAH",53,1,30,0)="               W $$HTE^XLFDT(""54786,40523"",2)    --> 12/31/90@11:15:23"
^DIC(9.4,3,22,21,"PAH",53,1,31,0)="               W $$FMTE^XLFDT(2940629.105744,1)  --> Jun 29, 1994@10:57:44"
^DIC(9.4,3,22,21,"PAH",53,1,32,0)="               W $$FMTE^XLFDT(2940629.105744,""2M"") --> 6/29/94@10:57"
^DIC(9.4,3,22,21,"PAH",53,1,33,0)="               W $$FMTE^XLFDT(2940629.1057,""2S"") --> 6/29/94@10:57:00"
^DIC(9.4,3,22,21,"PAH",53,1,34,0)="               W $$FMTE^XLFDT(2940629.1057,""4D"") --> 94/6/29"
^DIC(9.4,3,22,21,"PAH",53,1,35,0)="               W $$FMTE^XLFDT(2940629.1057,""1P"") --> Jun 29, 1994 10:57 am"
^DIC(9.4,3,22,21,"PAH",53,1,36,0)="               W $$FMTE^XLFDT(2940629.1057,""2P"") --> 6/29/94 10:57 am"
^DIC(9.4,3,22,21,"PAH",53,1,37,0)="               W $$FMTE^XLFDT(3000229.1105,""5"")  --> 2/29/2000@11:05"
^DIC(9.4,3,22,21,"PAH",53,1,38,0)="               W $$FMTE^XLFDT(3000229.1105,""5ZP"") --> 02/29/2000 11:05 am"
^DIC(9.4,3,22,21,"PAH",53,1,39,0)="               W $$FMTE^XLFDT(3000229.1105,""5F"") -->  2/29/2000@11:05"
^DIC(9.4,3,22,21,"PAH",53,1,40,0)="               W $$FMTE^XLFDT(3000229.1105,""6Z"") --> 29/02/2000@11:05"
^DIC(9.4,3,22,21,"PAH",53,1,41,0)="               W $$FMTE^XLFDT(3000301.1105,""7"")  --> 2000/3/1@11:05"
^DIC(9.4,3,22,21,"PAH",53,1,42,0)=""
^DIC(9.4,3,22,21,"PAH",53,1,43,0)=""
^DIC(9.4,3,22,21,"PAH",53,1,44,0)=""
^DIC(9.4,3,22,21,"PAH",53,1,45,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",53,1,46,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",53,1,47,0)="XLFDT         2542000   4068329    **71**"
^DIC(9.4,3,22,21,"PAH",53,1,48,0)="XLFDT1        1537932   2415851    **71**"
^DIC(9.4,3,22,21,"PAH",53,1,49,0)="XLFDT2        4162412   3429255    **71**"
^DIC(9.4,3,22,21,"PAH",53,1,50,0)="XLFDT3        7128144   6320544    **71**"
^DIC(9.4,3,22,21,"PAH",53,1,51,0)="XLFDT4        1396443   1396443    **71**"
^DIC(9.4,3,22,21,"PAH",53,1,52,0)="XQDATE        1632193   1671306    **71**"
^DIC(9.4,3,22,21,"PAH",53,1,53,0)="XTER2        13615695  10464968    **71**"
^DIC(9.4,3,22,21,"PAH",53,1,54,0)="XUWORKDY      1331031    902683    **65,71**"
^DIC(9.4,3,22,21,"PAH",53,1,55,0)="ZOSVVXD       7658715   7782508    **13,65,71**"
^DIC(9.4,3,22,21,"PAH",53,1,56,0)="  "
^DIC(9.4,3,22,21,"PAH",53,1,57,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",53,1,58,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",53,1,59,0)=""
^DIC(9.4,3,22,21,"PAH",53,1,60,0)="  1.  DSM sites - Some of these routines may be mapped,"
^DIC(9.4,3,22,21,"PAH",53,1,61,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",53,1,62,0)="      "
^DIC(9.4,3,22,21,"PAH",53,1,63,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",53,1,64,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",53,1,65,0)="      "
^DIC(9.4,3,22,21,"PAH",53,1,66,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",53,1,67,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",53,1,68,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",53,1,69,0)="      options:"
^DIC(9.4,3,22,21,"PAH",53,1,70,0)="      "
^DIC(9.4,3,22,21,"PAH",53,1,71,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",53,1,72,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",53,1,73,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",53,1,74,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",53,1,75,0)="         "
^DIC(9.4,3,22,21,"PAH",53,1,76,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",53,1,77,0)="      non-peek time."
^DIC(9.4,3,22,21,"PAH",53,1,78,0)="      "
^DIC(9.4,3,22,21,"PAH",53,1,79,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",53,1,80,0)="      option:"
^DIC(9.4,3,22,21,"PAH",53,1,81,0)="         Install Package(s)  'XU*8.0*71'"
^DIC(9.4,3,22,21,"PAH",53,1,82,0)="                              ========="
^DIC(9.4,3,22,21,"PAH",53,1,83,0)="         "
^DIC(9.4,3,22,21,"PAH",53,1,84,0)="  7.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",53,1,85,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",53,1,86,0)="      "
^DIC(9.4,3,22,21,"PAH",53,1,87,0)="  8.  After installing this patch, "
^DIC(9.4,3,22,21,"PAH",53,1,88,0)="      DSM sites - you need to move one routines from "
^DIC(9.4,3,22,21,"PAH",53,1,89,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",53,1,90,0)="      OpenM Sites - you don't need to move anything, skip this step."
^DIC(9.4,3,22,21,"PAH",53,1,91,0)="      ZOSVVXD"
^DIC(9.4,3,22,21,"PAH",53,1,92,0)="      "
^DIC(9.4,3,22,21,"PAH",53,1,93,0)="      And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",53,1,94,0)="       "
^DIC(9.4,3,22,21,"PAH",53,1,95,0)="      DSM sites:"
^DIC(9.4,3,22,21,"PAH",53,1,96,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",53,1,97,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",53,1,98,0)="      Patch number to load: 71"
^DIC(9.4,3,22,21,"PAH",53,1,99,0)="                            =="
^DIC(9.4,3,22,21,"PAH",53,1,100,0)="                            "
^DIC(9.4,3,22,21,"PAH",53,1,101,0)="  9.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",53,1,102,0)=""
^DIC(9.4,3,22,21,"PAH",53,1,103,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",53,1,104,0)=""
^DIC(9.4,3,22,21,"PAH",54,0)="77^2980401"
^DIC(9.4,3,22,21,"PAH",54,1,0)="^^47^47^2980408"
^DIC(9.4,3,22,21,"PAH",54,1,1,0)="BOI-0398-52635,  BRX-0398-12325"
^DIC(9.4,3,22,21,"PAH",54,1,2,0)="HIN-0398-42171   XUWORKDY"
^DIC(9.4,3,22,21,"PAH",54,1,3,0)="During the fixing of XUWORKDY for Y2K issues the changes weren't tested"
^DIC(9.4,3,22,21,"PAH",54,1,4,0)="with data that couldn't be calculated.  Dates missing the month or day"
^DIC(9.4,3,22,21,"PAH",54,1,5,0)="are invalid. "
^DIC(9.4,3,22,21,"PAH",54,1,6,0)=" "
^DIC(9.4,3,22,21,"PAH",54,1,7,0)="DAY-0398-42487"
^DIC(9.4,3,22,21,"PAH",54,1,8,0)="HOU-0398-72500   XTER2"
^DIC(9.4,3,22,21,"PAH",54,1,9,0)="During the fixing of XTER2 for Y2K issues, Testing didn't find that"
^DIC(9.4,3,22,21,"PAH",54,1,10,0)="entering mm/dd/yy would not report the errors there were on that date."
^DIC(9.4,3,22,21,"PAH",54,1,11,0)=" "
^DIC(9.4,3,22,21,"PAH",54,1,12,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",54,1,13,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",54,1,14,0)="XTER2        10464968  10468040    **71,77**"
^DIC(9.4,3,22,21,"PAH",54,1,15,0)="XUWORKDY       902683    908391    **65,71,77**"
^DIC(9.4,3,22,21,"PAH",54,1,16,0)=" "
^DIC(9.4,3,22,21,"PAH",54,1,17,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",54,1,18,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",54,1,19,0)=" "
^DIC(9.4,3,22,21,"PAH",54,1,20,0)="  1.  DSM sites - This routine may be mapped,"
^DIC(9.4,3,22,21,"PAH",54,1,21,0)="      so you will need to disable mapping for the effected routines. "
^DIC(9.4,3,22,21,"PAH",54,1,22,0)="     "
^DIC(9.4,3,22,21,"PAH",54,1,23,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",54,1,24,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",54,1,25,0)="     "
^DIC(9.4,3,22,21,"PAH",54,1,26,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",54,1,27,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",54,1,28,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",54,1,29,0)="      options:"
^DIC(9.4,3,22,21,"PAH",54,1,30,0)="      "
^DIC(9.4,3,22,21,"PAH",54,1,31,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",54,1,32,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",54,1,33,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",54,1,34,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",54,1,35,0)="     "
^DIC(9.4,3,22,21,"PAH",54,1,36,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",54,1,37,0)="      non-peak time.  (There is a very small possibility of some CLOBER"
^DIC(9.4,3,22,21,"PAH",54,1,38,0)="      errors)"
^DIC(9.4,3,22,21,"PAH",54,1,39,0)=" "
^DIC(9.4,3,22,21,"PAH",54,1,40,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",54,1,41,0)="      option:"
^DIC(9.4,3,22,21,"PAH",54,1,42,0)="        Install Package(s)  'XU*8.0*77'"
^DIC(9.4,3,22,21,"PAH",54,1,43,0)="                             ========="
^DIC(9.4,3,22,21,"PAH",54,1,44,0)="        "
^DIC(9.4,3,22,21,"PAH",54,1,45,0)="     "
^DIC(9.4,3,22,21,"PAH",54,1,46,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",54,1,47,0)=" ========================================================================="
^DIC(9.4,3,22,21,"PAH",55,0)="78 SEQ #61^2980417^1"
^DIC(9.4,3,22,21,"PAH",55,1,0)="^^45^45^2980417"
^DIC(9.4,3,22,21,"PAH",55,1,1,0)="This is an emergency patch to Kernel to provide the routine we asked"
^DIC(9.4,3,22,21,"PAH",55,1,2,0)="the MailMan maintance developer to call.  The MailMan patch didn't note "
^DIC(9.4,3,22,21,"PAH",55,1,3,0)="the dependency with Kernel, this was our mistake."
^DIC(9.4,3,22,21,"PAH",55,1,4,0)=" "
^DIC(9.4,3,22,21,"PAH",55,1,5,0)=" "
^DIC(9.4,3,22,21,"PAH",55,1,6,0)="        ZISTCPS      This is a new routine that has the general TCP/IP"
^DIC(9.4,3,22,21,"PAH",55,1,7,0)="                     server for OpenM in it.  This function was moved"
^DIC(9.4,3,22,21,"PAH",55,1,8,0)="                     to help standardize the call in %ZISTCP."
^DIC(9.4,3,22,21,"PAH",55,1,9,0)="                     The MailMan listener for OpenM was changed to reflect"
^DIC(9.4,3,22,21,"PAH",55,1,10,0)="                     this change.  The two patched got out of sync."
^DIC(9.4,3,22,21,"PAH",55,1,11,0)="                       "
^DIC(9.4,3,22,21,"PAH",55,1,12,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",55,1,13,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",55,1,14,0)="ZISTCPS         NEW     1057561    **78**"
^DIC(9.4,3,22,21,"PAH",55,1,15,0)=" "
^DIC(9.4,3,22,21,"PAH",55,1,16,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",55,1,17,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",55,1,18,0)=" "
^DIC(9.4,3,22,21,"PAH",55,1,19,0)="  1.  DSM sites - Don't need/use this routine."
^DIC(9.4,3,22,21,"PAH",55,1,20,0)="      "
^DIC(9.4,3,22,21,"PAH",55,1,21,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",55,1,22,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",55,1,23,0)="      "
^DIC(9.4,3,22,21,"PAH",55,1,24,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",55,1,25,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",55,1,26,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",55,1,27,0)="      options:"
^DIC(9.4,3,22,21,"PAH",55,1,28,0)="      "
^DIC(9.4,3,22,21,"PAH",55,1,29,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",55,1,30,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",55,1,31,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",55,1,32,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",55,1,33,0)="         "
^DIC(9.4,3,22,21,"PAH",55,1,34,0)=" 4.  Users can remain on the system. This patch can be loaded any time."
^DIC(9.4,3,22,21,"PAH",55,1,35,0)="      "
^DIC(9.4,3,22,21,"PAH",55,1,36,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",55,1,37,0)="      option:"
^DIC(9.4,3,22,21,"PAH",55,1,38,0)="         Install Package(s)  'XU*8.0*78'"
^DIC(9.4,3,22,21,"PAH",55,1,39,0)="                              ========="
^DIC(9.4,3,22,21,"PAH",55,1,40,0)="      "
^DIC(9.4,3,22,21,"PAH",55,1,41,0)="  8.  After installing this patch, "
^DIC(9.4,3,22,21,"PAH",55,1,42,0)="      OpenM Sites - You need to rename this routine."
^DIC(9.4,3,22,21,"PAH",55,1,43,0)="      ZL ZISTCPS ZS %ZISTCPS"
^DIC(9.4,3,22,21,"PAH",55,1,44,0)=" "
^DIC(9.4,3,22,21,"PAH",55,1,45,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",56,0)="67 SEQ #62^2980428^1"
^DIC(9.4,3,22,21,"PAH",56,1,0)="^^120^120^2980428"
^DIC(9.4,3,22,21,"PAH",56,1,1,0)="**** This patch will add to the number of entries in the LOCK table. ****"
^DIC(9.4,3,22,21,"PAH",56,1,2,0)="**** Depending on the number of jobs on a system node the Lock table ****"
^DIC(9.4,3,22,21,"PAH",56,1,3,0)="**** may need to be increased.                                       ****"
^DIC(9.4,3,22,21,"PAH",56,1,4,0)=""
^DIC(9.4,3,22,21,"PAH",56,1,5,0)=" Certain long running task (i.e. HL7 filers and LLP's) are getting removed "
^DIC(9.4,3,22,21,"PAH",56,1,6,0)=" from the system by the daily 'job' and 'Taskman' clean-up routines even "
^DIC(9.4,3,22,21,"PAH",56,1,7,0)=" though they are still active.  Taskman has been modified to lock the "
^DIC(9.4,3,22,21,"PAH",56,1,8,0)=" ^%ZTSCH(""TASK"",tasknumber) node when starting a task and release the lock "
^DIC(9.4,3,22,21,"PAH",56,1,9,0)=" at completion.  The clean-up routines will now attempt to lock this node to "
^DIC(9.4,3,22,21,"PAH",56,1,10,0)=" determine if the task is still active."
^DIC(9.4,3,22,21,"PAH",56,1,11,0)="  "
^DIC(9.4,3,22,21,"PAH",56,1,12,0)=" These problems were reported in the following NOIS's:  MAR-1196-20400, "
^DIC(9.4,3,22,21,"PAH",56,1,13,0)=" CMO-1196-41389, WNY-1296-11772, MAD-0197-40149, ISH-0197-41376, "
^DIC(9.4,3,22,21,"PAH",56,1,14,0)=" HIN-0297-41185."
^DIC(9.4,3,22,21,"PAH",56,1,15,0)="  "
^DIC(9.4,3,22,21,"PAH",56,1,16,0)=" In addition to being tested locally, the following sites tested this patch:"
^DIC(9.4,3,22,21,"PAH",56,1,17,0)="  "
^DIC(9.4,3,22,21,"PAH",56,1,18,0)="  Baltimore VAMC, Dayton VAMC, Columbia VAMC"
^DIC(9.4,3,22,21,"PAH",56,1,19,0)="  "
^DIC(9.4,3,22,21,"PAH",56,1,20,0)="WNY-1296-11772, CMO-1196-41389, MAR-1196-20400"
^DIC(9.4,3,22,21,"PAH",56,1,21,0)="HIN-0297-41185 ZTMS3   Prevent TaskMan and Kernel clean-up programs from "
^DIC(9.4,3,22,21,"PAH",56,1,22,0)="ISH-0197-41376          blowing away tasks that need to run for long periods"
^DIC(9.4,3,22,21,"PAH",56,1,23,0)="MAD-0197-40149  XUTMK   of time.  This requires that tasks only use "
^DIC(9.4,3,22,21,"PAH",56,1,24,0)="                XUTMRJD INCREMENTAL locks."
^DIC(9.4,3,22,21,"PAH",56,1,25,0)="                                "
^DIC(9.4,3,22,21,"PAH",56,1,26,0)="Long time requests for tasks that restart themselfas if they stop unexpectedly."
^DIC(9.4,3,22,21,"PAH",56,1,27,0)="Part of the problem has been to know when a TASK is running.  The change to "
^DIC(9.4,3,22,21,"PAH",56,1,28,0)="prevent clean-up programs from deleting the info about long running tasks"
^DIC(9.4,3,22,21,"PAH",56,1,29,0)="puts into place the needed part so that taskman can check and restart tasks"
^DIC(9.4,3,22,21,"PAH",56,1,30,0)="that need to be persistent."
^DIC(9.4,3,22,21,"PAH",56,1,31,0)=""
^DIC(9.4,3,22,21,"PAH",56,1,32,0)="SFC-1197-60720   ZTMS2  Taskman would not check the device file OUT-OF-SERVICE"
^DIC(9.4,3,22,21,"PAH",56,1,33,0)="                 ZTMS3  field.  This was caused by DT not being set at the time"
^DIC(9.4,3,22,21,"PAH",56,1,34,0)="                 ZTMS   of the call to %ZIS."
^DIC(9.4,3,22,21,"PAH",56,1,35,0)=""
^DIC(9.4,3,22,21,"PAH",56,1,36,0)="ZTLOAD has two new supported tags."
^DIC(9.4,3,22,21,"PAH",56,1,37,0)=""
^DIC(9.4,3,22,21,"PAH",56,1,38,0)="$$PSET^%ZTLOAD to set a task as persistent.  Returns 1 if the flag is set other"
^DIC(9.4,3,22,21,"PAH",56,1,39,0)="wise returns 0."
^DIC(9.4,3,22,21,"PAH",56,1,40,0)="PCLEAR^%ZTLOAD to clear the persistent flag for a task."
^DIC(9.4,3,22,21,"PAH",56,1,41,0)=""
^DIC(9.4,3,22,21,"PAH",56,1,42,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",56,1,43,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",56,1,44,0)="XQ1          11726256  11899807    **1,15,59,67**"
^DIC(9.4,3,22,21,"PAH",56,1,45,0)="XQ82          3479466   3479466    **59,67**"
^DIC(9.4,3,22,21,"PAH",56,1,46,0)="XUTMG19                 3890099    **20,67**"
^DIC(9.4,3,22,21,"PAH",56,1,47,0)="XUTMK         6472549   6655042    **49,67**"
^DIC(9.4,3,22,21,"PAH",56,1,48,0)="XUTMRJD       6554859   6838266    **49,67**"
^DIC(9.4,3,22,21,"PAH",56,1,49,0)="XUTMTZ                  7805273    **67**"
^DIC(9.4,3,22,21,"PAH",56,1,50,0)="ZTLOAD        1188558   1753065    **67**"
^DIC(9.4,3,22,21,"PAH",56,1,51,0)="ZTLOAD2       3203201   3185920    **1,67**"
^DIC(9.4,3,22,21,"PAH",56,1,52,0)="ZTLOAD3                 3918318    **67**"
^DIC(9.4,3,22,21,"PAH",56,1,53,0)="ZTLOAD7       3885066   4104573    **67**"
^DIC(9.4,3,22,21,"PAH",56,1,54,0)="ZTM           7821111   8229940    **24,36,64,67**"
^DIC(9.4,3,22,21,"PAH",56,1,55,0)="ZTM0          5563711   5758864    **42,36,67**"
^DIC(9.4,3,22,21,"PAH",56,1,56,0)="ZTMS          5336388   5366119    **2,18,24,36,67**"
^DIC(9.4,3,22,21,"PAH",56,1,57,0)="ZTMS2         5283853   5301865    **2,18,23,36,67**"
^DIC(9.4,3,22,21,"PAH",56,1,58,0)="ZTMS3         9572340  10241859    **1,18,36,49,64,67**"
^DIC(9.4,3,22,21,"PAH",56,1,59,0)=""
^DIC(9.4,3,22,21,"PAH",56,1,60,0)="========================================================================= "
^DIC(9.4,3,22,21,"PAH",56,1,61,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",56,1,62,0)=""
^DIC(9.4,3,22,21,"PAH",56,1,63,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",56,1,64,0)="      so you will need to disable mapping for the effected routines."
^DIC(9.4,3,22,21,"PAH",56,1,65,0)="      "
^DIC(9.4,3,22,21,"PAH",56,1,66,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",56,1,67,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",56,1,68,0)="      "
^DIC(9.4,3,22,21,"PAH",56,1,69,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",56,1,70,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",56,1,71,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",56,1,72,0)="      options:"
^DIC(9.4,3,22,21,"PAH",56,1,73,0)="      "
^DIC(9.4,3,22,21,"PAH",56,1,74,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,3,22,21,"PAH",56,1,75,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",56,1,76,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",56,1,77,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",56,1,78,0)="         "
^DIC(9.4,3,22,21,"PAH",56,1,79,0)=" 4.   Inhibit users from login into the system. (If you install when few"
^DIC(9.4,3,22,21,"PAH",56,1,80,0)="      user are on the system and the possibility of some CLOBER errors is"
^DIC(9.4,3,22,21,"PAH",56,1,81,0)="      acceptable then users can stay on the system.)"
^DIC(9.4,3,22,21,"PAH",56,1,82,0)="      Also place TASKMAN in a wait state."
^DIC(9.4,3,22,21,"PAH",56,1,83,0)="      "
^DIC(9.4,3,22,21,"PAH",56,1,84,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",56,1,85,0)="      option:"
^DIC(9.4,3,22,21,"PAH",56,1,86,0)="         Install Package(s)  'XU*8.0*67'"
^DIC(9.4,3,22,21,"PAH",56,1,87,0)="                              ========="
^DIC(9.4,3,22,21,"PAH",56,1,88,0)="         "
^DIC(9.4,3,22,21,"PAH",56,1,89,0)="  7.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,3,22,21,"PAH",56,1,90,0)="      other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",56,1,91,0)="      MSM Sites - With Taskman not working you need to move the routine to"
^DIC(9.4,3,22,21,"PAH",56,1,92,0)="      other CPU's with the D ^XPDCPU"
^DIC(9.4,3,22,21,"PAH",56,1,93,0)="      "
^DIC(9.4,3,22,21,"PAH",56,1,94,0)="  8.  After installing this patch, "
^DIC(9.4,3,22,21,"PAH",56,1,95,0)="      DSM/MSM sites - you need to move several routines from "
^DIC(9.4,3,22,21,"PAH",56,1,96,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",56,1,97,0)="      OpenM Sites - you don't need to move anything, skip this step."
^DIC(9.4,3,22,21,"PAH",56,1,98,0)="      ZTLOAD"
^DIC(9.4,3,22,21,"PAH",56,1,99,0)="      ZTLOAD3"
^DIC(9.4,3,22,21,"PAH",56,1,100,0)="      ZTLOAD7"
^DIC(9.4,3,22,21,"PAH",56,1,101,0)="      ZTM"
^DIC(9.4,3,22,21,"PAH",56,1,102,0)="      ZTM0"
^DIC(9.4,3,22,21,"PAH",56,1,103,0)="      ZTMS"
^DIC(9.4,3,22,21,"PAH",56,1,104,0)="      ZTMS2"
^DIC(9.4,3,22,21,"PAH",56,1,105,0)="      ZTMS3"
^DIC(9.4,3,22,21,"PAH",56,1,106,0)=""
^DIC(9.4,3,22,21,"PAH",56,1,107,0)="      And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",56,1,108,0)="       "
^DIC(9.4,3,22,21,"PAH",56,1,109,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",56,1,110,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",56,1,111,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",56,1,112,0)="      Patch number to load: 67"
^DIC(9.4,3,22,21,"PAH",56,1,113,0)="                            =="
^DIC(9.4,3,22,21,"PAH",56,1,114,0)="       "
^DIC(9.4,3,22,21,"PAH",56,1,115,0)="  9.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",56,1,116,0)=" 10.  Enable user's login."
^DIC(9.4,3,22,21,"PAH",56,1,117,0)="      Remove TASKMAN from the wait state."
^DIC(9.4,3,22,21,"PAH",56,1,118,0)=""
^DIC(9.4,3,22,21,"PAH",56,1,119,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",56,1,120,0)=""
^DIC(9.4,3,22,21,"PAH",57,0)="76 SEQ #63^2980513^1"
^DIC(9.4,3,22,21,"PAH",58,0)="83 SEQ #64^2980527^1"
^DIC(9.4,3,22,21,"PAH",59,0)="46 SEQ #65^2980527^1"
^DIC(9.4,3,22,21,"PAH",59,1,0)="^^86^86^2980527"
^DIC(9.4,3,22,21,"PAH",59,1,1,0)="                     XU*8*46 - Jump Problems and XQUIT"
^DIC(9.4,3,22,21,"PAH",59,1,2,0)=" "
^DIC(9.4,3,22,21,"PAH",59,1,3,0)="     There are no associated patches."
^DIC(9.4,3,22,21,"PAH",59,1,4,0)=" "
^DIC(9.4,3,22,21,"PAH",59,1,5,0)="     This patch contains 22 routines, a new Kernel File (Menu Systen Quick"
^DIC(9.4,3,22,21,"PAH",59,1,6,0)="Help), 13 Help Frames, and 3 Options; which fix a couple of problems with"
^DIC(9.4,3,22,21,"PAH",59,1,7,0)="jumping.  Under certain circumstances the Entry Action and Header would"
^DIC(9.4,3,22,21,"PAH",59,1,8,0)="not be executed for the parent option of a secondary menu tree and the"
^DIC(9.4,3,22,21,"PAH",59,1,9,0)="XUCOMMAND option which is the parent of the Common Options.  In addition,"
^DIC(9.4,3,22,21,"PAH",59,1,10,0)="the headers were occasionally executed before the entry action rather than"
^DIC(9.4,3,22,21,"PAH",59,1,11,0)="after the entry action, the latter always being the correct sequence."
^DIC(9.4,3,22,21,"PAH",59,1,12,0)="[NOIS DAY-0994-40200, SPO-0597-50637]"
^DIC(9.4,3,22,21,"PAH",59,1,13,0)=" "
^DIC(9.4,3,22,21,"PAH",59,1,14,0)="     This patch also synchronizes the single uparrow jump (""^"") and the"
^DIC(9.4,3,22,21,"PAH",59,1,15,0)="double uparrow or rubber-band jump (""^^"") so that both react the same"
^DIC(9.4,3,22,21,"PAH",59,1,16,0)="when the variable XQUIT is set during the execution of an Entry Action."
^DIC(9.4,3,22,21,"PAH",59,1,17,0)="[NOIS DAY-0596-41019]."
^DIC(9.4,3,22,21,"PAH",59,1,18,0)=" "
^DIC(9.4,3,22,21,"PAH",59,1,19,0)="     The  program ^XQDATE has been modified to correct a flaw that could"
^DIC(9.4,3,22,21,"PAH",59,1,20,0)="make time stand still by not cleaning up after itself."
^DIC(9.4,3,22,21,"PAH",59,1,21,0)="[NOIS BRX-0498-10234, CMO-0498-40588]."
^DIC(9.4,3,22,21,"PAH",59,1,22,0)=" "
^DIC(9.4,3,22,21,"PAH",59,1,23,0)=" "
^DIC(9.4,3,22,21,"PAH",59,1,24,0)="     Patch 46 also includes an enhancement to XQUIT processing. If XQUIT"
^DIC(9.4,3,22,21,"PAH",59,1,25,0)="is encountered in a jump path the software will return the user to the"
^DIC(9.4,3,22,21,"PAH",59,1,26,0)="option the user jumped from rather than stopping in mid-jump.  It Also"
^DIC(9.4,3,22,21,"PAH",59,1,27,0)="required the inclusion of a Screen-based Option Editor (OPED).  Please see"
^DIC(9.4,3,22,21,"PAH",59,1,28,0)="the option ""Kernel New Features Help"" for a complete look at these"
^DIC(9.4,3,22,21,"PAH",59,1,29,0)="features."
^DIC(9.4,3,22,21,"PAH",59,1,30,0)="  "
^DIC(9.4,3,22,21,"PAH",59,1,31,0)="     This patch contains the routine XQP46INI, a post install routine,"
^DIC(9.4,3,22,21,"PAH",59,1,32,0)="that may be deleted after the install."
^DIC(9.4,3,22,21,"PAH",59,1,33,0)=" "
^DIC(9.4,3,22,21,"PAH",59,1,34,0)="=========================================================================="
^DIC(9.4,3,22,21,"PAH",59,1,35,0)=" "
^DIC(9.4,3,22,21,"PAH",59,1,36,0)="INSTALLATION: "
^DIC(9.4,3,22,21,"PAH",59,1,37,0)="   1.  These routines may be mapped on systems that allow"
^DIC(9.4,3,22,21,"PAH",59,1,38,0)="       it so you may have to disable mapping."
^DIC(9.4,3,22,21,"PAH",59,1,39,0)="   2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This "
^DIC(9.4,3,22,21,"PAH",59,1,40,0)="       option will load the KIDS package onto your system.  "
^DIC(9.4,3,22,21,"PAH",59,1,41,0)="   3.  The patch has now been loaded into a Transport global on your "
^DIC(9.4,3,22,21,"PAH",59,1,42,0)="       system. You now need to use KIDS to install the Transport global.  "
^DIC(9.4,3,22,21,"PAH",59,1,43,0)="   4.  On the KIDS menu, under the 'Installation' menu, use the following "
^DIC(9.4,3,22,21,"PAH",59,1,44,0)="       options: "
^DIC(9.4,3,22,21,"PAH",59,1,45,0)="          Print Transport Global "
^DIC(9.4,3,22,21,"PAH",59,1,46,0)="          Compare Transport Global to Current System "
^DIC(9.4,3,22,21,"PAH",59,1,47,0)="          Verify Checksums in Transport Global "
^DIC(9.4,3,22,21,"PAH",59,1,48,0)="          Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",59,1,49,0)="          Install Package(s) "
^DIC(9.4,3,22,21,"PAH",59,1,50,0)="   5.  MSM Sites - Answer YES to the question 'Want to MOVE routines to "
^DIC(9.4,3,22,21,"PAH",59,1,51,0)="       other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,3,22,21,"PAH",59,1,52,0)="   6.  Rebuild your mapped set if necessary."
^DIC(9.4,3,22,21,"PAH",59,1,53,0)="   7.  If users are allowed to remain on the system during installation"
^DIC(9.4,3,22,21,"PAH",59,1,54,0)="       errors may occur when the routines are loaded."
^DIC(9.4,3,22,21,"PAH",59,1,55,0)=" "
^DIC(9.4,3,22,21,"PAH",59,1,56,0)="=========================================================================="
^DIC(9.4,3,22,21,"PAH",59,1,57,0)=" "
^DIC(9.4,3,22,21,"PAH",59,1,58,0)=" "
^DIC(9.4,3,22,21,"PAH",59,1,59,0)="               CHECK SUMS (^XTSUMBLD) AND PATCH LISTS"
^DIC(9.4,3,22,21,"PAH",59,1,60,0)=" "
^DIC(9.4,3,22,21,"PAH",59,1,61,0)="      The second line of these routines should look like this:"
^DIC(9.4,3,22,21,"PAH",59,1,62,0)="           ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",59,1,63,0)=" "
