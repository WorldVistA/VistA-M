^DIC(9.4,14,22,5.9,"PAH",187,1,395,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",187,1,396,0)="========================="
^DIC(9.4,14,22,5.9,"PAH",187,1,397,0)="This patch can be installed with users on the system.  However, it is "
^DIC(9.4,14,22,5.9,"PAH",187,1,398,0)="recommended that installation occur when there is no Anatomic Pathology"
^DIC(9.4,14,22,5.9,"PAH",187,1,399,0)="activity or activity is at a minimum.  This will prevent 'Cannot return to "
^DIC(9.4,14,22,5.9,"PAH",187,1,400,0)="source routine' errors.  The Anatomic Pathology menu will be disabled "
^DIC(9.4,14,22,5.9,"PAH",187,1,401,0)="automatically by this patch and re-enabled after installation."
^DIC(9.4,14,22,5.9,"PAH",187,1,402,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,403,0)="Install Time - less than 5 minutes."
^DIC(9.4,14,22,5.9,"PAH",187,1,404,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,405,0)="PRE-INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",187,1,406,0)="============================="
^DIC(9.4,14,22,5.9,"PAH",187,1,407,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,408,0)="***************************************************************************"
^DIC(9.4,14,22,5.9,"PAH",187,1,409,0)="*** IT IS VERY IMPORTANT THAT YOU FOLLOW THE PRE-INSTALLATION           ***"
^DIC(9.4,14,22,5.9,"PAH",187,1,410,0)="*** INSTRUCTIONS BEFORE INSTALLING THE PATCH.                           ***"
^DIC(9.4,14,22,5.9,"PAH",187,1,411,0)="***                                                                     ***"
^DIC(9.4,14,22,5.9,"PAH",187,1,412,0)="*** All outstanding (unreleased) supplementary reports from July 23,    *** "
^DIC(9.4,14,22,5.9,"PAH",187,1,413,0)="*** 2003, the date LR*5.2*259 Anatomic Pathology Electronic Signature   ***"
^DIC(9.4,14,22,5.9,"PAH",187,1,414,0)="*** patch was first installed in a production account, until the present***"
^DIC(9.4,14,22,5.9,"PAH",187,1,415,0)="*** MUST be released before installing this patch.  If there are        ***"
^DIC(9.4,14,22,5.9,"PAH",187,1,416,0)="*** unverified supplementary reports, THE PATCH WILL NOT INSTALL.       *** "
^DIC(9.4,14,22,5.9,"PAH",187,1,417,0)="***                                                                     ***"
^DIC(9.4,14,22,5.9,"PAH",187,1,418,0)="*** The appropriate Laboratory personnel should check for unverified    ***"
^DIC(9.4,14,22,5.9,"PAH",187,1,419,0)="*** supplementary reports and make sure all are reviewed and released   ***"
^DIC(9.4,14,22,5.9,"PAH",187,1,420,0)="*** before proceeding with this installation.  The following option     ***"
^DIC(9.4,14,22,5.9,"PAH",187,1,421,0)="*** can be used to check for outstanding unreleased supplementary       ***"
^DIC(9.4,14,22,5.9,"PAH",187,1,422,0)="*** reports:  List of unverified pathology reports [LRAPV] option.      ***"
^DIC(9.4,14,22,5.9,"PAH",187,1,423,0)="*** Selection #2 will create a listing of unverified supplementary      ***"
^DIC(9.4,14,22,5.9,"PAH",187,1,424,0)="*** reports.                                                            ***"
^DIC(9.4,14,22,5.9,"PAH",187,1,425,0)="**************************************************************************"
^DIC(9.4,14,22,5.9,"PAH",187,1,426,0)="**************************************************************************"
^DIC(9.4,14,22,5.9,"PAH",187,1,427,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,428,0)="1.     LOAD TRANSPORT GLOBAL"
^DIC(9.4,14,22,5.9,"PAH",187,1,429,0)="       ---------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",187,1,430,0)="       Choose the PackMan message containing this patch and invoke the "
^DIC(9.4,14,22,5.9,"PAH",187,1,431,0)="       INSTALL/CHECK   MESSAGE PackMan option."
^DIC(9.4,14,22,5.9,"PAH",187,1,432,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,433,0)="2.     START UP KIDS"
^DIC(9.4,14,22,5.9,"PAH",187,1,434,0)="       Start up the Kernel Installation and distribution System "
^DIC(9.4,14,22,5.9,"PAH",187,1,435,0)="       Menu [XPD MAIN]:"
^DIC(9.4,14,22,5.9,"PAH",187,1,436,0)="               Edits and Distribution ..."
^DIC(9.4,14,22,5.9,"PAH",187,1,437,0)="                        Utilities ..."
^DIC(9.4,14,22,5.9,"PAH",187,1,438,0)="                        Installation ...       "
^DIC(9.4,14,22,5.9,"PAH",187,1,439,0)="       Select Kernel Installation & Distribution System Option:  INStallation"
^DIC(9.4,14,22,5.9,"PAH",187,1,440,0)="                                                                 ----"
^DIC(9.4,14,22,5.9,"PAH",187,1,441,0)="               1      Load a Distribution"
^DIC(9.4,14,22,5.9,"PAH",187,1,442,0)="               2      Verify Checksums in Transport Global"
^DIC(9.4,14,22,5.9,"PAH",187,1,443,0)="               3      Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",187,1,444,0)="               4      Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",187,1,445,0)="               5      Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",187,1,446,0)="               6      Install Package(s)"
^DIC(9.4,14,22,5.9,"PAH",187,1,447,0)="                      Restart Install of Package(s)"
^DIC(9.4,14,22,5.9,"PAH",187,1,448,0)="                      Unload a Distribution"
^DIC(9.4,14,22,5.9,"PAH",187,1,449,0)="               DD     DD, 2nd Line Comparison"
^DIC(9.4,14,22,5.9,"PAH",187,1,450,0)="       "
^DIC(9.4,14,22,5.9,"PAH",187,1,451,0)="       Select Installation Option:                 "
^DIC(9.4,14,22,5.9,"PAH",187,1,452,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,453,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,454,0)="3.     Select Installation Option:"
^DIC(9.4,14,22,5.9,"PAH",187,1,455,0)="       -------------------------------"
^DIC(9.4,14,22,5.9,"PAH",187,1,456,0)="       NOTE:  The following are OPTIONAL - (When prompted for the "
^DIC(9.4,14,22,5.9,"PAH",187,1,457,0)="       INSTALL NAME, enter LR*5.2*317):"
^DIC(9.4,14,22,5.9,"PAH",187,1,458,0)="       a.  Backup a Transport Global - This option will create a "
^DIC(9.4,14,22,5.9,"PAH",187,1,459,0)="           backup message of any routines exported with this patch. "
^DIC(9.4,14,22,5.9,"PAH",187,1,460,0)="          It will not backup any other changes such as DD's or templates."
^DIC(9.4,14,22,5.9,"PAH",187,1,461,0)="       b.  Compare Transport Global to Current System - This option "
^DIC(9.4,14,22,5.9,"PAH",187,1,462,0)="           will allow you to view all changes that will be made when this "
^DIC(9.4,14,22,5.9,"PAH",187,1,463,0)="          patch is installed. It compares all components of this patch "
^DIC(9.4,14,22,5.9,"PAH",187,1,464,0)="          (routines, DD's, templates, etc.)."
^DIC(9.4,14,22,5.9,"PAH",187,1,465,0)="       c.  Verify Checksums in Transport Global - This option will  "
^DIC(9.4,14,22,5.9,"PAH",187,1,466,0)="           allow you to ensure the integrity of the routines that are in "
^DIC(9.4,14,22,5.9,"PAH",187,1,467,0)="           the transport global."
^DIC(9.4,14,22,5.9,"PAH",187,1,468,0)="     "
^DIC(9.4,14,22,5.9,"PAH",187,1,469,0)="4.     Select Installation Option:  Install Package(s) "
^DIC(9.4,14,22,5.9,"PAH",187,1,470,0)="                                    ------------------"
^DIC(9.4,14,22,5.9,"PAH",187,1,471,0)="       **This is the step to start the installation of this KIDS patch: "
^DIC(9.4,14,22,5.9,"PAH",187,1,472,0)="   "
^DIC(9.4,14,22,5.9,"PAH",187,1,473,0)="       a.  Choose the Install Package(s) option to start the patch install."
^DIC(9.4,14,22,5.9,"PAH",187,1,474,0)="          (When prompted for the INSTALL NAME, enter LR*5.2*317.)"
^DIC(9.4,14,22,5.9,"PAH",187,1,475,0)="       b.  When prompted 'Want KIDS to INHIBIT LOGONs during the install? "
^DIC(9.4,14,22,5.9,"PAH",187,1,476,0)="           YES//' answer NO (unless otherwise indicated)"
^DIC(9.4,14,22,5.9,"PAH",187,1,477,0)="       c.  When prompted 'Want to DISABLE Scheduled Options, Menu Options,"
^DIC(9.4,14,22,5.9,"PAH",187,1,478,0)="           and Protocols? YES//' answer NO (unless otherwise indicated)"
^DIC(9.4,14,22,5.9,"PAH",187,1,479,0)="                 "
^DIC(9.4,14,22,5.9,"PAH",187,1,480,0)="5.   If you have any unreleased supplementary reports from July 23, 2003"
^DIC(9.4,14,22,5.9,"PAH",187,1,481,0)="       until the present, the install will abort.  To print the unreleased"
^DIC(9.4,14,22,5.9,"PAH",187,1,482,0)="       supplementary reports, you can print the install file."
^DIC(9.4,14,22,5.9,"PAH",187,1,483,0)="       Here's an example:"
^DIC(9.4,14,22,5.9,"PAH",187,1,484,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,485,0)="Select Kernel Installation & Distribution System Option: utilities"
^DIC(9.4,14,22,5.9,"PAH",187,1,486,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,487,0)="Select Utilities Option: install File Print"
^DIC(9.4,14,22,5.9,"PAH",187,1,488,0)="Select INSTALL NAME: lr*5.2*317   Loaded from Distribution  8/25/06@14:37:36       "
^DIC(9.4,14,22,5.9,"PAH",187,1,489,0)=" "
^DIC(9.4,14,22,5.9,"PAH",187,1,490,0)="DEVICE: HOME// ;;1000  UCX/TELNET"
