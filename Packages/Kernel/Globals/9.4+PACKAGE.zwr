^DIC(9.4,4,22,2,"PAH",12,0)="11 SEQ #12^3030204^1"
^DIC(9.4,4,22,2,"PAH",12,1,0)="^^61^61^3030204"
^DIC(9.4,4,22,2,"PAH",12,1,1,0)="Patch XM*8.0*11"
^DIC(9.4,4,22,2,"PAH",12,1,2,0)=""
^DIC(9.4,4,22,2,"PAH",12,1,3,0)="NOIS: PAL-0402-60941"
^DIC(9.4,4,22,2,"PAH",12,1,4,0)="Test Site: Palo Alto HCS"
^DIC(9.4,4,22,2,"PAH",12,1,5,0)=""
^DIC(9.4,4,22,2,"PAH",12,1,6,0)="When trying to connect to a site which is unreachable for whatever reason,"
^DIC(9.4,4,22,2,"PAH",12,1,7,0)="MailMan may burn CPU cycles in a tight loop.  The patch adds a 1 second"
^DIC(9.4,4,22,2,"PAH",12,1,8,0)="hang within the loop to mitigate that."
^DIC(9.4,4,22,2,"PAH",12,1,9,0)=""
^DIC(9.4,4,22,2,"PAH",12,1,10,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",12,1,11,0)="is at a minimum. It has no patch prerequisites, except that MailMan 8 must"
^DIC(9.4,4,22,2,"PAH",12,1,12,0)="be installed."
^DIC(9.4,4,22,2,"PAH",12,1,13,0)="============================================================================ "
^DIC(9.4,4,22,2,"PAH",12,1,14,0)=""
^DIC(9.4,4,22,2,"PAH",12,1,15,0)="ROUTINES:"
^DIC(9.4,4,22,2,"PAH",12,1,16,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,2,"PAH",12,1,17,0)="       ;;8.0;MailMan;**[patch list]**;Jun 28, 2002"
^DIC(9.4,4,22,2,"PAH",12,1,18,0)=""
^DIC(9.4,4,22,2,"PAH",12,1,19,0)="              Before          After"
^DIC(9.4,4,22,2,"PAH",12,1,20,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,2,"PAH",12,1,21,0)="------------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",12,1,22,0)="XMC1A          3411138         3522021        11"
^DIC(9.4,4,22,2,"PAH",12,1,23,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,2,"PAH",12,1,24,0)=""
^DIC(9.4,4,22,2,"PAH",12,1,25,0)="This patch introduces no new routines."
^DIC(9.4,4,22,2,"PAH",12,1,26,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",12,1,27,0)=" "
^DIC(9.4,4,22,2,"PAH",12,1,28,0)="INSTALLATION:"
^DIC(9.4,4,22,2,"PAH",12,1,29,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",12,1,30,0)="is at a minimum. It has no patch prerequisites, except that MailMan 8 must"
^DIC(9.4,4,22,2,"PAH",12,1,31,0)="be installed."
^DIC(9.4,4,22,2,"PAH",12,1,32,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,2,"PAH",12,1,33,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,2,"PAH",12,1,34,0)="    affected routine(s).  "
^DIC(9.4,4,22,2,"PAH",12,1,35,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,2,"PAH",12,1,36,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,2,"PAH",12,1,37,0)="4.  Users may be on the system.  You do not need to stop TaskMan"
^DIC(9.4,4,22,2,"PAH",12,1,38,0)="    or the background filer."
^DIC(9.4,4,22,2,"PAH",12,1,39,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,2,"PAH",12,1,40,0)="    Transport Global:"
^DIC(9.4,4,22,2,"PAH",12,1,41,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,2,"PAH",12,1,42,0)="       Print Transport Global"
^DIC(9.4,4,22,2,"PAH",12,1,43,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,2,"PAH",12,1,44,0)="       Backup a Transport Global"
^DIC(9.4,4,22,2,"PAH",12,1,45,0)="       Install Package(s)"
^DIC(9.4,4,22,2,"PAH",12,1,46,0)=" Select INSTALL NAME:    XM*8.0*11     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,2,"PAH",12,1,47,0)="                         ========="
^DIC(9.4,4,22,2,"PAH",12,1,48,0)=" Install Questions for XM*8.0*11"
^DIC(9.4,4,22,2,"PAH",12,1,49,0)=""
^DIC(9.4,4,22,2,"PAH",12,1,50,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,2,"PAH",12,1,51,0)="                                                       =="
^DIC(9.4,4,22,2,"PAH",12,1,52,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,2,"PAH",12,1,53,0)="                                                                       =="
^DIC(9.4,4,22,2,"PAH",12,1,54,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,2,"PAH",12,1,55,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,2,"PAH",12,1,56,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,2,"PAH",12,1,57,0)=""
^DIC(9.4,4,22,2,"PAH",12,1,58,0)=" DEVICE: HOME// <You may queue it if you wish>"
^DIC(9.4,4,22,2,"PAH",12,1,59,0)="                ------------------------------"
^DIC(9.4,4,22,2,"PAH",12,1,60,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,2,"PAH",12,1,61,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",13,0)="13 SEQ #13^3030204^1"
^DIC(9.4,4,22,2,"PAH",13,1,0)="^^59^59^3030204"
^DIC(9.4,4,22,2,"PAH",13,1,1,0)="Patch XM*8.0*13"
^DIC(9.4,4,22,2,"PAH",13,1,2,0)=""
^DIC(9.4,4,22,2,"PAH",13,1,3,0)="NOIS: CMH-0103-N0418"
^DIC(9.4,4,22,2,"PAH",13,1,4,0)="Test Site: CMOP-Hines"
^DIC(9.4,4,22,2,"PAH",13,1,5,0)=""
^DIC(9.4,4,22,2,"PAH",13,1,6,0)="If you run OPTION: Message statistics [XMSTAT], and select ""M"" for ""All"
^DIC(9.4,4,22,2,"PAH",13,1,7,0)="Mailboxes"", MailMan reports on ""Inactive Mailboxes"", instead.  This patch"
^DIC(9.4,4,22,2,"PAH",13,1,8,0)="fixes that."
^DIC(9.4,4,22,2,"PAH",13,1,9,0)=""
^DIC(9.4,4,22,2,"PAH",13,1,10,0)="NOTE: This patch may be installed at any time."
^DIC(9.4,4,22,2,"PAH",13,1,11,0)="It requires MailMan patch XM*8.0*10."
^DIC(9.4,4,22,2,"PAH",13,1,12,0)="============================================================================ "
^DIC(9.4,4,22,2,"PAH",13,1,13,0)=""
^DIC(9.4,4,22,2,"PAH",13,1,14,0)="ROUTINES:"
^DIC(9.4,4,22,2,"PAH",13,1,15,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,2,"PAH",13,1,16,0)="       ;;8.0;MailMan;**[patch list]**;Jun 28, 2002"
^DIC(9.4,4,22,2,"PAH",13,1,17,0)=""
^DIC(9.4,4,22,2,"PAH",13,1,18,0)="              Before          After"
^DIC(9.4,4,22,2,"PAH",13,1,19,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,2,"PAH",13,1,20,0)="------------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",13,1,21,0)="XMA30         10649028        10730063        10,13"
^DIC(9.4,4,22,2,"PAH",13,1,22,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,2,"PAH",13,1,23,0)=""
^DIC(9.4,4,22,2,"PAH",13,1,24,0)="This patch introduces no new routines."
^DIC(9.4,4,22,2,"PAH",13,1,25,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",13,1,26,0)=" "
^DIC(9.4,4,22,2,"PAH",13,1,27,0)="INSTALLATION:"
^DIC(9.4,4,22,2,"PAH",13,1,28,0)="NOTE: This patch may be installed at any time."
^DIC(9.4,4,22,2,"PAH",13,1,29,0)="It requires MailMan patch XM*8.0*10."
^DIC(9.4,4,22,2,"PAH",13,1,30,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,2,"PAH",13,1,31,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,2,"PAH",13,1,32,0)="    affected routine(s).  "
^DIC(9.4,4,22,2,"PAH",13,1,33,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,2,"PAH",13,1,34,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,2,"PAH",13,1,35,0)="4.  Users may be on the system.  You do not need to stop TaskMan"
^DIC(9.4,4,22,2,"PAH",13,1,36,0)="    or the background filer."
^DIC(9.4,4,22,2,"PAH",13,1,37,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,2,"PAH",13,1,38,0)="    Transport Global:"
^DIC(9.4,4,22,2,"PAH",13,1,39,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,2,"PAH",13,1,40,0)="       Print Transport Global"
^DIC(9.4,4,22,2,"PAH",13,1,41,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,2,"PAH",13,1,42,0)="       Backup a Transport Global"
^DIC(9.4,4,22,2,"PAH",13,1,43,0)="       Install Package(s)"
^DIC(9.4,4,22,2,"PAH",13,1,44,0)=" Select INSTALL NAME:    XM*8.0*13     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,2,"PAH",13,1,45,0)="                         ========="
^DIC(9.4,4,22,2,"PAH",13,1,46,0)=" Install Questions for XM*8.0*13"
^DIC(9.4,4,22,2,"PAH",13,1,47,0)=""
^DIC(9.4,4,22,2,"PAH",13,1,48,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,2,"PAH",13,1,49,0)="                                                       =="
^DIC(9.4,4,22,2,"PAH",13,1,50,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,2,"PAH",13,1,51,0)="                                                                       =="
^DIC(9.4,4,22,2,"PAH",13,1,52,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,2,"PAH",13,1,53,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,2,"PAH",13,1,54,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,2,"PAH",13,1,55,0)=""
^DIC(9.4,4,22,2,"PAH",13,1,56,0)=" DEVICE: HOME// <You may queue it if you wish>"
^DIC(9.4,4,22,2,"PAH",13,1,57,0)="                ------------------------------"
^DIC(9.4,4,22,2,"PAH",13,1,58,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,2,"PAH",13,1,59,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",14,0)="2 SEQ #14^3030329^1"
^DIC(9.4,4,22,2,"PAH",14,1,0)="^^177^177^3030329"
^DIC(9.4,4,22,2,"PAH",14,1,1,0)="                   * * * * *  ATTENTION  * * * * *"
^DIC(9.4,4,22,2,"PAH",14,1,2,0)="         You must make manual changes to your P-MESSAGE entries"
^DIC(9.4,4,22,2,"PAH",14,1,3,0)="          in your DEVICE (#3.5) and TERMINAL TYPE (#3.2) files!"
^DIC(9.4,4,22,2,"PAH",14,1,4,0)="  Please read and follow the patch instructions for details on the changes!"
^DIC(9.4,4,22,2,"PAH",14,1,5,0)="                   * * * * *  ATTENTION  * * * * *"
^DIC(9.4,4,22,2,"PAH",14,1,6,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,7,0)="Patch XM*8.0*2"
^DIC(9.4,4,22,2,"PAH",14,1,8,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,9,0)="Test Sites: Bronx, NY; Tampa, FL; Montana HCS; Altoona, PA"
^DIC(9.4,4,22,2,"PAH",14,1,10,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,11,0)="NOIS: BRX-0802-12085"
^DIC(9.4,4,22,2,"PAH",14,1,12,0)="P-MESSAGE has the following problems:"
^DIC(9.4,4,22,2,"PAH",14,1,13,0)="1) A calling program can't get the message number back."
^DIC(9.4,4,22,2,"PAH",14,1,14,0)="2) Users aren't able to specify subject, sender, and recipients if they"
^DIC(9.4,4,22,2,"PAH",14,1,15,0)="queue the print."
^DIC(9.4,4,22,2,"PAH",14,1,16,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,17,0)="This patch fixes these problems, which have also been mentioned in the"
^DIC(9.4,4,22,2,"PAH",14,1,18,0)="following E3Rs:"
^DIC(9.4,4,22,2,"PAH",14,1,19,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,20,0)="E3R:  5147,6405,13621"
^DIC(9.4,4,22,2,"PAH",14,1,21,0)="When printing to the P-MESSAGE device, perform all user interaction before"
^DIC(9.4,4,22,2,"PAH",14,1,22,0)="the text is put into the message, and enable users to specify P-MESSAGE"
^DIC(9.4,4,22,2,"PAH",14,1,23,0)="subject, sender, and recipients even if they queue the print."
^DIC(9.4,4,22,2,"PAH",14,1,24,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,25,0)="E3R:  13766"
^DIC(9.4,4,22,2,"PAH",14,1,26,0)="When printing to the P-MESSAGE device, return the message number of the"
^DIC(9.4,4,22,2,"PAH",14,1,27,0)="message created.  The message number will be returned only if the calling"
^DIC(9.4,4,22,2,"PAH",14,1,28,0)="program has set the variable XMZBACK.  If $D(XMZBACK), then XMZ will be"
^DIC(9.4,4,22,2,"PAH",14,1,29,0)="set upon return, and XMZBACK will be killed."
^DIC(9.4,4,22,2,"PAH",14,1,30,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,31,0)="E3R:  14895"
^DIC(9.4,4,22,2,"PAH",14,1,32,0)="When printing to the P-MESSAGE device, and the user has chosen to have the"
^DIC(9.4,4,22,2,"PAH",14,1,33,0)="message appear to be from the POSTMASTER, put the user's DUZ in the SENDER"
^DIC(9.4,4,22,2,"PAH",14,1,34,0)="(#1.1) field of the MESSAGE (#3.9) file."
^DIC(9.4,4,22,2,"PAH",14,1,35,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,36,0)="The post-init ensures that some DIALOG (#.84) file entries which are no"
^DIC(9.4,4,22,2,"PAH",14,1,37,0)="longer needed are deleted."
^DIC(9.4,4,22,2,"PAH",14,1,38,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,39,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",14,1,40,0)="is at a minumum.  It requires MailMan patch XM*8.0*10, as well as"
^DIC(9.4,4,22,2,"PAH",14,1,41,0)="Kernel patches XU*8.0*162 and XU*8.0*175."
^DIC(9.4,4,22,2,"PAH",14,1,42,0)="============================================================================ "
^DIC(9.4,4,22,2,"PAH",14,1,43,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,44,0)="ROUTINES:"
^DIC(9.4,4,22,2,"PAH",14,1,45,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,2,"PAH",14,1,46,0)="       ;;8.0;MailMan;**[patch list]**;Jun 28, 2002"
^DIC(9.4,4,22,2,"PAH",14,1,47,0)=" "
^DIC(9.4,4,22,2,"PAH",14,1,48,0)="              Before          After"
^DIC(9.4,4,22,2,"PAH",14,1,49,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,2,"PAH",14,1,50,0)="--------------------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",14,1,51,0)="XMAPHOST       7077399         9091852        2"
^DIC(9.4,4,22,2,"PAH",14,1,52,0)="XMUT5          6663310         6762357        10,2"
^DIC(9.4,4,22,2,"PAH",14,1,53,0)="XMYPRE1        * NEW *           68287        2"
^DIC(9.4,4,22,2,"PAH",14,1,54,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,2,"PAH",14,1,55,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,56,0)="This patch introduces the following new routine:"
^DIC(9.4,4,22,2,"PAH",14,1,57,0)="XMYPRE1 has no user entry points, and may be deleted following install."
^DIC(9.4,4,22,2,"PAH",14,1,58,0)="============================================================================"
^DIC(9.4,4,22,2,"PAH",14,1,59,0)=" "
^DIC(9.4,4,22,2,"PAH",14,1,60,0)="INSTALLATION:"
^DIC(9.4,4,22,2,"PAH",14,1,61,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",14,1,62,0)="is at a minumum.  It requires MailMan patch XM*8.0*10, as well as"
^DIC(9.4,4,22,2,"PAH",14,1,63,0)="Kernel patches XU*8.0*162 and XU*8.0*175."
^DIC(9.4,4,22,2,"PAH",14,1,64,0)="1. Users may be on the system during installation of this patch."
^DIC(9.4,4,22,2,"PAH",14,1,65,0)="2. DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,2,"PAH",14,1,66,0)="   affected routine(s).  "
^DIC(9.4,4,22,2,"PAH",14,1,67,0)="3. On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,2,"PAH",14,1,68,0)="   the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,2,"PAH",14,1,69,0)="4. You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,2,"PAH",14,1,70,0)="   Users may be on the system."
^DIC(9.4,4,22,2,"PAH",14,1,71,0)="5. On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,2,"PAH",14,1,72,0)="   Transport Global:"
^DIC(9.4,4,22,2,"PAH",14,1,73,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,2,"PAH",14,1,74,0)="       Print Transport Global"
^DIC(9.4,4,22,2,"PAH",14,1,75,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,2,"PAH",14,1,76,0)="       Backup a Transport Global"
^DIC(9.4,4,22,2,"PAH",14,1,77,0)="       Install Package(s)"
^DIC(9.4,4,22,2,"PAH",14,1,78,0)=" Select INSTALL NAME:    XM*8.0*2    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,2,"PAH",14,1,79,0)="                         ========"
^DIC(9.4,4,22,2,"PAH",14,1,80,0)=" Install Questions:"
^DIC(9.4,4,22,2,"PAH",14,1,81,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,2,"PAH",14,1,82,0)="                                                       =="
^DIC(9.4,4,22,2,"PAH",14,1,83,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,2,"PAH",14,1,84,0)="                                                                       =="
^DIC(9.4,4,22,2,"PAH",14,1,85,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,2,"PAH",14,1,86,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,2,"PAH",14,1,87,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,2,"PAH",14,1,88,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,89,0)=" DEVICE: HOME// <Do NOT queue it!>"
^DIC(9.4,4,22,2,"PAH",14,1,90,0)="                ------------------"
^DIC(9.4,4,22,2,"PAH",14,1,91,0)="6. Edit the P-MESSAGE entries in the DEVICE (#3.5) file."
^DIC(9.4,4,22,2,"PAH",14,1,92,0)="a. First, print out a copy of the P-MESSAGE entries in the DEVICE (#3.5)"
^DIC(9.4,4,22,2,"PAH",14,1,93,0)="   file, so you have a record of what they look like before you edit them."
^DIC(9.4,4,22,2,"PAH",14,1,94,0)="   This is very important, so you can refer back to it in case you make an"
^DIC(9.4,4,22,2,"PAH",14,1,95,0)="   editing mistake."
^DIC(9.4,4,22,2,"PAH",14,1,96,0)="b. Make sure the first 9 characters of the device name is ""P-MESSAGE"".  If"
^DIC(9.4,4,22,2,"PAH",14,1,97,0)="   it isn't, queued p-messages will not contain the requested subjects, or"
^DIC(9.4,4,22,2,"PAH",14,1,98,0)="   be delivered to the requested users.  Default values will be used,"
^DIC(9.4,4,22,2,"PAH",14,1,99,0)="   instead."
^DIC(9.4,4,22,2,"PAH",14,1,100,0)="c. Edit the PRE-OPEN EXECUTE (#19.7) field of the P-MESSAGE entries in"
^DIC(9.4,4,22,2,"PAH",14,1,101,0)="   the DEVICE (#3.5) file, using the instructions as a *pattern*."
^DIC(9.4,4,22,2,"PAH",14,1,102,0)="   (Note: There may be some differences, depending on your system.)"
^DIC(9.4,4,22,2,"PAH",14,1,103,0)="- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -"
^DIC(9.4,4,22,2,"PAH",14,1,104,0)="VMS/DSM sites might look like this.  *** Your site may vary slightly. ***"
^DIC(9.4,4,22,2,"PAH",14,1,105,0)="-------"
^DIC(9.4,4,22,2,"PAH",14,1,106,0)="Before:"
^DIC(9.4,4,22,2,"PAH",14,1,107,0)="PRE-OPEN EXECUTE:"
^DIC(9.4,4,22,2,"PAH",14,1,108,0)=" S IO=$P(IO,""."")_$J_"".""_$P(IO,""."",2)"
^DIC(9.4,4,22,2,"PAH",14,1,109,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,110,0)="After:"
^DIC(9.4,4,22,2,"PAH",14,1,111,0)="PRE-OPEN EXECUTE:"
^DIC(9.4,4,22,2,"PAH",14,1,112,0)=" D EN^XMAPHOST Q:$G(POP)  S IO=$P(IO,""."")_$J_"".""_$P(IO,""."",2)"
^DIC(9.4,4,22,2,"PAH",14,1,113,0)=" ========================="
^DIC(9.4,4,22,2,"PAH",14,1,114,0)=" <<Add the underlined text to the beginning.  Please note that there are >>"
^DIC(9.4,4,22,2,"PAH",14,1,115,0)=" <<2 spaces after the 'Q:$G(POP)'!  Do not make any other changes.  It is>>"
^DIC(9.4,4,22,2,"PAH",14,1,116,0)=" <<OK for the rest of the text to look different from what's shown here. >>"
^DIC(9.4,4,22,2,"PAH",14,1,117,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,118,0)="- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -"
^DIC(9.4,4,22,2,"PAH",14,1,119,0)="Cache OpenM/NT and Cache VMS sites might look like this."
^DIC(9.4,4,22,2,"PAH",14,1,120,0)="----------------------------   *** Your site may vary slightly. ***"
^DIC(9.4,4,22,2,"PAH",14,1,121,0)="Before:"
^DIC(9.4,4,22,2,"PAH",14,1,122,0)="PRE-OPEN EXECUTE:"
^DIC(9.4,4,22,2,"PAH",14,1,123,0)=" S IO=$P(IO,""."")_$J_"".""_$P(IO,""."",2)"
^DIC(9.4,4,22,2,"PAH",14,1,124,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,125,0)="After:"
^DIC(9.4,4,22,2,"PAH",14,1,126,0)="PRE-OPEN EXECUTE:"
^DIC(9.4,4,22,2,"PAH",14,1,127,0)=" D EN^XMAPHOST Q:$G(POP)  S IO=$P(IO,""."")_$J_"".""_$P(IO,""."",2)"
^DIC(9.4,4,22,2,"PAH",14,1,128,0)=" ========================="
^DIC(9.4,4,22,2,"PAH",14,1,129,0)=" <<Add the underlined text to the beginning.  Please note that there are >>"
^DIC(9.4,4,22,2,"PAH",14,1,130,0)=" <<2 spaces after the 'Q:$G(POP)'!  Do not make any other changes.  It is>>"
^DIC(9.4,4,22,2,"PAH",14,1,131,0)=" <<OK for the rest of the text to look different from what's shown here. >>"
^DIC(9.4,4,22,2,"PAH",14,1,132,0)="- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -"
^DIC(9.4,4,22,2,"PAH",14,1,133,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,134,0)="7. Edit the P-MESSAGE entries in the TERMINAL TYPE (#3.2) file."
^DIC(9.4,4,22,2,"PAH",14,1,135,0)="a. First, print out a copy of the P-MESSAGE entries in the TERMINAL TYPE"
^DIC(9.4,4,22,2,"PAH",14,1,136,0)="   (#3.2) file, so you have a record of what they look like before you edit"
^DIC(9.4,4,22,2,"PAH",14,1,137,0)="   them. This is very important, so you can refer back to it in case you"
^DIC(9.4,4,22,2,"PAH",14,1,138,0)="   make an editing mistake."
^DIC(9.4,4,22,2,"PAH",14,1,139,0)="b. Edit the CLOSE EXECUTE (#7) field of the P-MESSAGE entries in the"
^DIC(9.4,4,22,2,"PAH",14,1,140,0)="   TERMINAL TYPE (#3.2) file, using the instructions as a *pattern*."
^DIC(9.4,4,22,2,"PAH",14,1,141,0)="   (Note: There may be some differences, depending on your system.)"
^DIC(9.4,4,22,2,"PAH",14,1,142,0)="- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -"
^DIC(9.4,4,22,2,"PAH",14,1,143,0)="VMS/DSM sites might look like this.  *** Your site may vary slightly. ***"
^DIC(9.4,4,22,2,"PAH",14,1,144,0)="-------"
^DIC(9.4,4,22,2,"PAH",14,1,145,0)="Before:"
^DIC(9.4,4,22,2,"PAH",14,1,146,0)="CLOSE EXECUTE: "
^DIC(9.4,4,22,2,"PAH",14,1,147,0)=" W:$X ! S XMREC=""R X#255:1"" X ""U IO:DISCONNECT"" D ^XMAPHOST,READ^XMAPHOST"
^DIC(9.4,4,22,2,"PAH",14,1,148,0)="        ====================                      =========="
^DIC(9.4,4,22,2,"PAH",14,1,149,0)=" X ""C IO:DELETE"" K XMIO,IO(1,IO) Q"
^DIC(9.4,4,22,2,"PAH",14,1,150,0)="                   =====        =="
^DIC(9.4,4,22,2,"PAH",14,1,151,0)=" <<Delete the underlined text.  Do not make any other changes.  It is   >>"
^DIC(9.4,4,22,2,"PAH",14,1,152,0)=" <<OK for the rest of the text to look different from what's shown here.>>"
^DIC(9.4,4,22,2,"PAH",14,1,153,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,154,0)="After:"
^DIC(9.4,4,22,2,"PAH",14,1,155,0)="CLOSE EXECUTE:"
^DIC(9.4,4,22,2,"PAH",14,1,156,0)=" W:$X ! X ""U IO:DISCONNECT"" D READ^XMAPHOST X ""C IO:DELETE"" K IO(1,IO)"
^DIC(9.4,4,22,2,"PAH",14,1,157,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,158,0)="- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -"
^DIC(9.4,4,22,2,"PAH",14,1,159,0)="Cache OpenM/NT and Cache VMS sites might look like this."
^DIC(9.4,4,22,2,"PAH",14,1,160,0)="----------------------------   *** Your site may vary slightly. ***"
^DIC(9.4,4,22,2,"PAH",14,1,161,0)="Before:"
^DIC(9.4,4,22,2,"PAH",14,1,162,0)="CLOSE EXECUTE: "
^DIC(9.4,4,22,2,"PAH",14,1,163,0)=" W:$X ! S XMREC=""R X#255:1"" U IO:(""R"") D ^XMAPHOST,READ^XMAPHOST"
^DIC(9.4,4,22,2,"PAH",14,1,164,0)="        ====================             =========="
^DIC(9.4,4,22,2,"PAH",14,1,165,0)=" X ""C IO:""""D"""""" K XMIO,IO(1,IO) Q"
^DIC(9.4,4,22,2,"PAH",14,1,166,0)="                  =====        =="
^DIC(9.4,4,22,2,"PAH",14,1,167,0)=" <<Delete the underlined text.  Do not make any other changes.  It is   >>"
^DIC(9.4,4,22,2,"PAH",14,1,168,0)=" <<OK for the rest of the text to look different from what's shown here.>>"
^DIC(9.4,4,22,2,"PAH",14,1,169,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,170,0)="After:"
^DIC(9.4,4,22,2,"PAH",14,1,171,0)="CLOSE EXECUTE:"
^DIC(9.4,4,22,2,"PAH",14,1,172,0)=" W:$X ! U IO:(""R"") D READ^XMAPHOST X ""C IO:""""D"""""" K IO(1,IO)"
^DIC(9.4,4,22,2,"PAH",14,1,173,0)="- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -"
^DIC(9.4,4,22,2,"PAH",14,1,174,0)=""
^DIC(9.4,4,22,2,"PAH",14,1,175,0)="8.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,2,"PAH",14,1,176,0)="9.  You may delete the post-init, ^XMYPRE1."
^DIC(9.4,4,22,2,"PAH",14,1,177,0)="============================================================================"
^DIC(9.4,4,22,2,"PAH",15,0)="15 SEQ #15^3030329^1"
^DIC(9.4,4,22,2,"PAH",15,1,0)="^^65^65^3030329"
^DIC(9.4,4,22,2,"PAH",15,1,1,0)="Patch XM*8.0*15"
^DIC(9.4,4,22,2,"PAH",15,1,2,0)=""
^DIC(9.4,4,22,2,"PAH",15,1,3,0)="NOIS: TUA-0203-31789"
^DIC(9.4,4,22,2,"PAH",15,1,4,0)="Test Site: Tuscaloosa, AL"
^DIC(9.4,4,22,2,"PAH",15,1,5,0)=""
^DIC(9.4,4,22,2,"PAH",15,1,6,0)="If you forward a message to broadcast, agree that you'd like to set a"
^DIC(9.4,4,22,2,"PAH",15,1,7,0)="vaporize date, but enter ^ at the vaporize date prompt, the message is"
^DIC(9.4,4,22,2,"PAH",15,1,8,0)="broadcast.  This patch will change the process, so that an ^ will abort"
^DIC(9.4,4,22,2,"PAH",15,1,9,0)="the broadcast."
^DIC(9.4,4,22,2,"PAH",15,1,10,0)=""
^DIC(9.4,4,22,2,"PAH",15,1,11,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",15,1,12,0)="is at a minimum.  It has no patch prerequisites, except that MailMan 8 must"
^DIC(9.4,4,22,2,"PAH",15,1,13,0)="be installed."
^DIC(9.4,4,22,2,"PAH",15,1,14,0)="============================================================================ "
^DIC(9.4,4,22,2,"PAH",15,1,15,0)=""
^DIC(9.4,4,22,2,"PAH",15,1,16,0)="ROUTINES:"
^DIC(9.4,4,22,2,"PAH",15,1,17,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,2,"PAH",15,1,18,0)="       ;;8.0;MailMan;**[patch list]**;Jun 28, 2002"
^DIC(9.4,4,22,2,"PAH",15,1,19,0)=""
^DIC(9.4,4,22,2,"PAH",15,1,20,0)="              Before          After"
^DIC(9.4,4,22,2,"PAH",15,1,21,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,2,"PAH",15,1,22,0)="------------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",15,1,23,0)="XMJMOI        14666274        15155593        15"
^DIC(9.4,4,22,2,"PAH",15,1,24,0)="XMXAPI         7362843         7484319        15"
^DIC(9.4,4,22,2,"PAH",15,1,25,0)="XMXAPIU         596863          904353        15"
^DIC(9.4,4,22,2,"PAH",15,1,26,0)="XMXPARM       14944409        15011904        15"
^DIC(9.4,4,22,2,"PAH",15,1,27,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,2,"PAH",15,1,28,0)=""
^DIC(9.4,4,22,2,"PAH",15,1,29,0)="This patch introduces no new routines."
^DIC(9.4,4,22,2,"PAH",15,1,30,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",15,1,31,0)=" "
^DIC(9.4,4,22,2,"PAH",15,1,32,0)="INSTALLATION:"
^DIC(9.4,4,22,2,"PAH",15,1,33,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",15,1,34,0)="is at a minimum.  It has no patch prerequisites, except that MailMan 8 must"
^DIC(9.4,4,22,2,"PAH",15,1,35,0)="be installed."
^DIC(9.4,4,22,2,"PAH",15,1,36,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,2,"PAH",15,1,37,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,2,"PAH",15,1,38,0)="    affected routine(s).  "
^DIC(9.4,4,22,2,"PAH",15,1,39,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,2,"PAH",15,1,40,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,2,"PAH",15,1,41,0)="4.  Users may be on the system.  You do not need to stop TaskMan"
^DIC(9.4,4,22,2,"PAH",15,1,42,0)="    or the background filer."
^DIC(9.4,4,22,2,"PAH",15,1,43,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,2,"PAH",15,1,44,0)="    Transport Global:"
^DIC(9.4,4,22,2,"PAH",15,1,45,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,2,"PAH",15,1,46,0)="       Print Transport Global"
^DIC(9.4,4,22,2,"PAH",15,1,47,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,2,"PAH",15,1,48,0)="       Backup a Transport Global"
^DIC(9.4,4,22,2,"PAH",15,1,49,0)="       Install Package(s)"
^DIC(9.4,4,22,2,"PAH",15,1,50,0)=" Select INSTALL NAME:    XM*8.0*15     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,2,"PAH",15,1,51,0)="                         ========="
^DIC(9.4,4,22,2,"PAH",15,1,52,0)=" Install Questions for XM*8.0*15"
^DIC(9.4,4,22,2,"PAH",15,1,53,0)=""
^DIC(9.4,4,22,2,"PAH",15,1,54,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,2,"PAH",15,1,55,0)="                                                       =="
^DIC(9.4,4,22,2,"PAH",15,1,56,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,2,"PAH",15,1,57,0)="                                                                       =="
^DIC(9.4,4,22,2,"PAH",15,1,58,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,2,"PAH",15,1,59,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,2,"PAH",15,1,60,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,2,"PAH",15,1,61,0)=""
^DIC(9.4,4,22,2,"PAH",15,1,62,0)=" DEVICE: HOME// <You may queue it if you wish>"
^DIC(9.4,4,22,2,"PAH",15,1,63,0)="                ------------------------------"
^DIC(9.4,4,22,2,"PAH",15,1,64,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,2,"PAH",15,1,65,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",16,0)="16 SEQ #16^3030404^1"
^DIC(9.4,4,22,2,"PAH",16,1,0)="^^65^65^3030404"
^DIC(9.4,4,22,2,"PAH",16,1,1,0)="Patch XM*8.0*16"
^DIC(9.4,4,22,2,"PAH",16,1,2,0)=""
^DIC(9.4,4,22,2,"PAH",16,1,3,0)="NOIS: ISL-0303-51989"
^DIC(9.4,4,22,2,"PAH",16,1,4,0)="Test Site: OIFO Salt Lake"
^DIC(9.4,4,22,2,"PAH",16,1,5,0)=""
^DIC(9.4,4,22,2,"PAH",16,1,6,0)="If you use the API ADDMBRS^XMXAPIG to add a remote user to a mail group"
^DIC(9.4,4,22,2,"PAH",16,1,7,0)="in the MAIL GROUP (#3.8) file, MailMan adds the user to the DISTRIBUTION"
^DIC(9.4,4,22,2,"PAH",16,1,8,0)="LIST (#3.813) multiple, instead of to the REMOTE MEMBER (#3.812) multiple."
^DIC(9.4,4,22,2,"PAH",16,1,9,0)="This patch fixes that."
^DIC(9.4,4,22,2,"PAH",16,1,10,0)=""
^DIC(9.4,4,22,2,"PAH",16,1,11,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",16,1,12,0)="is at a minimum.  It has no patch prerequisites, except that MailMan 8 must"
^DIC(9.4,4,22,2,"PAH",16,1,13,0)="be installed."
^DIC(9.4,4,22,2,"PAH",16,1,14,0)="============================================================================ "
^DIC(9.4,4,22,2,"PAH",16,1,15,0)=""
^DIC(9.4,4,22,2,"PAH",16,1,16,0)="ROUTINES:"
^DIC(9.4,4,22,2,"PAH",16,1,17,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,2,"PAH",16,1,18,0)="       ;;8.0;MailMan;**[patch list]**;Jun 28, 2002"
^DIC(9.4,4,22,2,"PAH",16,1,19,0)=""
^DIC(9.4,4,22,2,"PAH",16,1,20,0)="              Before          After"
^DIC(9.4,4,22,2,"PAH",16,1,21,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,2,"PAH",16,1,22,0)="------------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",16,1,23,0)="XMXAPIG        5257560         5257560        16"
^DIC(9.4,4,22,2,"PAH",16,1,24,0)="XMXBSKT       12498784        12520227        16"
^DIC(9.4,4,22,2,"PAH",16,1,25,0)="XMXGRP         9498223         9498181        16"
^DIC(9.4,4,22,2,"PAH",16,1,26,0)="XMXMSGS2       8470689         8537934        16"
