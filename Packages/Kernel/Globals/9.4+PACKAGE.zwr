^DIC(9.4,14,22,5.9,"PAH",287,0)="480 SEQ #386^3170403.143153^54"
^DIC(9.4,14,22,5.9,"PAH",287,1,0)="^^172^172^3170403"
^DIC(9.4,14,22,5.9,"PAH",287,1,1,0)=" This patch addresses the following issue:"
^DIC(9.4,14,22,5.9,"PAH",287,1,2,0)=" - Microbiology accession is being removed from the 'Incomplete "
^DIC(9.4,14,22,5.9,"PAH",287,1,3,0)=" test status report (LRWRKINC)' option when a PRELIMINARY result is"
^DIC(9.4,14,22,5.9,"PAH",287,1,4,0)=" released when using the Universal Interface Microbiology release options."
^DIC(9.4,14,22,5.9,"PAH",287,1,5,0)="  "
^DIC(9.4,14,22,5.9,"PAH",287,1,6,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,7,0)="  Blood Bank Review:"
^DIC(9.4,14,22,5.9,"PAH",287,1,8,0)="  =================="
^DIC(9.4,14,22,5.9,"PAH",287,1,9,0)="  EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*480 does not "
^DIC(9.4,14,22,5.9,"PAH",287,1,10,0)="  alter or modify any software design safeguards or safety critical "
^DIC(9.4,14,22,5.9,"PAH",287,1,11,0)="  elements functions."
^DIC(9.4,14,22,5.9,"PAH",287,1,12,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,13,0)="  RISK ANALYSIS: Changes made by patch LR*5.2*480 have no effect on Blood "
^DIC(9.4,14,22,5.9,"PAH",287,1,14,0)="  Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",287,1,15,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,16,0)="  VALIDATION REQUIREMENTS BY OPTION: Because of the nature of the changes "
^DIC(9.4,14,22,5.9,"PAH",287,1,17,0)="  made, no specific validation requirements exist as a result of "
^DIC(9.4,14,22,5.9,"PAH",287,1,18,0)="  installation of this patch."
^DIC(9.4,14,22,5.9,"PAH",287,1,19,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,20,0)="Remedy Ticket Overview:"
^DIC(9.4,14,22,5.9,"PAH",287,1,21,0)="  =========================="
^DIC(9.4,14,22,5.9,"PAH",287,1,22,0)="  N/A"
^DIC(9.4,14,22,5.9,"PAH",287,1,23,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,24,0)="New Service Requests (NSR)s):"
^DIC(9.4,14,22,5.9,"PAH",287,1,25,0)="  =================="
^DIC(9.4,14,22,5.9,"PAH",287,1,26,0)="  N/A"
^DIC(9.4,14,22,5.9,"PAH",287,1,27,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,28,0)="  Participating Test Sites:"
^DIC(9.4,14,22,5.9,"PAH",287,1,29,0)="  ========================="
^DIC(9.4,14,22,5.9,"PAH",287,1,30,0)=" James A. Haley Veterans Hospital"
^DIC(9.4,14,22,5.9,"PAH",287,1,31,0)=" Iowa City VA Healthcare System"
^DIC(9.4,14,22,5.9,"PAH",287,1,32,0)=" Lexington VA Medical Center"
^DIC(9.4,14,22,5.9,"PAH",287,1,33,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,34,0)=" Problem:"
^DIC(9.4,14,22,5.9,"PAH",287,1,35,0)=" --------"
^DIC(9.4,14,22,5.9,"PAH",287,1,36,0)=" When releasing a microbiology preliminary report using the new "
^DIC(9.4,14,22,5.9,"PAH",287,1,37,0)=" Universal Interface release options the status of the accession was being"
^DIC(9.4,14,22,5.9,"PAH",287,1,38,0)=" set to complete and was then no longer available on the Incomplete Test"
^DIC(9.4,14,22,5.9,"PAH",287,1,39,0)=" Status list report."
^DIC(9.4,14,22,5.9,"PAH",287,1,40,0)="    "
^DIC(9.4,14,22,5.9,"PAH",287,1,41,0)=" Resolution:"
^DIC(9.4,14,22,5.9,"PAH",287,1,42,0)=" -----------"
^DIC(9.4,14,22,5.9,"PAH",287,1,43,0)=" The patch modifies LRVR0 at ACCEPT+68 and adds the following three lines"
^DIC(9.4,14,22,5.9,"PAH",287,1,44,0)=" of code:"
^DIC(9.4,14,22,5.9,"PAH",287,1,45,0)="         ;"
^DIC(9.4,14,22,5.9,"PAH",287,1,46,0)="         ; If Lab UI interface then prompt user for accession test "
^DIC(9.4,14,22,5.9,"PAH",287,1,47,0)=" complete date /time in EC3^LRMIEDZ2 call."
^DIC(9.4,14,22,5.9,"PAH",287,1,48,0)="         I LRINTYPE=1 S LRFIFO=0"
^DIC(9.4,14,22,5.9,"PAH",287,1,49,0)="  "
^DIC(9.4,14,22,5.9,"PAH",287,1,50,0)="        Routine: LRVR0"
^DIC(9.4,14,22,5.9,"PAH",287,1,51,0)=" "
^DIC(9.4,14,22,5.9,"PAH",287,1,52,0)=" "
^DIC(9.4,14,22,5.9,"PAH",287,1,53,0)=" Problem: "
^DIC(9.4,14,22,5.9,"PAH",287,1,54,0)=" --------"
^DIC(9.4,14,22,5.9,"PAH",287,1,55,0)=" When a retransmission of microbiology results are received the accepting "
^DIC(9.4,14,22,5.9,"PAH",287,1,56,0)=" of the retransmission values was causing the existing"
^DIC(9.4,14,22,5.9,"PAH",287,1,57,0)=" organism, comments and susceptibilities to be deleted. This is expected "
^DIC(9.4,14,22,5.9,"PAH",287,1,58,0)=" functionality when handling verified microbiology reports"
^DIC(9.4,14,22,5.9,"PAH",287,1,59,0)=" from external reference laboratories.  "
^DIC(9.4,14,22,5.9,"PAH",287,1,60,0)=" "
^DIC(9.4,14,22,5.9,"PAH",287,1,61,0)=" However when handling result transmission from a Universal Interface "
^DIC(9.4,14,22,5.9,"PAH",287,1,62,0)=" microbiology instrument the user before the report is"
^DIC(9.4,14,22,5.9,"PAH",287,1,63,0)=" verified can enter additional information that needs to be preserved.  "
^DIC(9.4,14,22,5.9,"PAH",287,1,64,0)=" "
^DIC(9.4,14,22,5.9,"PAH",287,1,65,0)=" Resolution: "
^DIC(9.4,14,22,5.9,"PAH",287,1,66,0)=" -----------"
^DIC(9.4,14,22,5.9,"PAH",287,1,67,0)=" The patch modifies the handling of existing results based on the type of "
^DIC(9.4,14,22,5.9,"PAH",287,1,68,0)=" interface. LEDI types of interfaces will continue to"
^DIC(9.4,14,22,5.9,"PAH",287,1,69,0)=" remove previous information prior to storing new information from the "
^DIC(9.4,14,22,5.9,"PAH",287,1,70,0)=" reference laboratory. Universal Interfaces type interfaces"
^DIC(9.4,14,22,5.9,"PAH",287,1,71,0)=" will maintain existing information entered by Laboratory or received via "
^DIC(9.4,14,22,5.9,"PAH",287,1,72,0)=" prior transmissions and merge the new transmission with"
^DIC(9.4,14,22,5.9,"PAH",287,1,73,0)=" the existing data before presenting to lab user for review.  "
^DIC(9.4,14,22,5.9,"PAH",287,1,74,0)=" "
^DIC(9.4,14,22,5.9,"PAH",287,1,75,0)="        Routine: LRVRMI2A modified labels N9A, N12A, N17 "
^DIC(9.4,14,22,5.9,"PAH",287,1,76,0)=" "
^DIC(9.4,14,22,5.9,"PAH",287,1,77,0)="        Routine: LRVRMI4A modified labels N3A, N6A, N6B"
^DIC(9.4,14,22,5.9,"PAH",287,1,78,0)=" "
^DIC(9.4,14,22,5.9,"PAH",287,1,79,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,80,0)=" Software and Documentation Retrieval Instructions:"
^DIC(9.4,14,22,5.9,"PAH",287,1,81,0)=" ---------------------------------------------------- "
^DIC(9.4,14,22,5.9,"PAH",287,1,82,0)=" Software being released as a Packman message and/or documentation"
^DIC(9.4,14,22,5.9,"PAH",287,1,83,0)=" describing the new functionality introduced by this patch are available."
^DIC(9.4,14,22,5.9,"PAH",287,1,84,0)="  "
^DIC(9.4,14,22,5.9,"PAH",287,1,85,0)=" The preferred method is to retrieve files from download.vista.domain.ext."
^DIC(9.4,14,22,5.9,"PAH",287,1,86,0)=" This transmits the files from the first available server. Sites may "
^DIC(9.4,14,22,5.9,"PAH",287,1,87,0)=" also elect to retrieve files directly from a specific server. "
^DIC(9.4,14,22,5.9,"PAH",287,1,88,0)="  "
^DIC(9.4,14,22,5.9,"PAH",287,1,89,0)=" Sites may retrieve the software and/or documentation directly using "
^DIC(9.4,14,22,5.9,"PAH",287,1,90,0)=" Secure File Transfer Protocol (SFTP) from the ANONYMOUS.SOFTWARE "
^DIC(9.4,14,22,5.9,"PAH",287,1,91,0)=" directory at the following OI Field Offices:"
^DIC(9.4,14,22,5.9,"PAH",287,1,92,0)="    "
^DIC(9.4,14,22,5.9,"PAH",287,1,93,0)=" Albany:                 fo-albany.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",287,1,94,0)=" Hines:                  fo-hines.domain.ext    "
^DIC(9.4,14,22,5.9,"PAH",287,1,95,0)=" Salt Lake City:         fo-slc.domain.ext"
^DIC(9.4,14,22,5.9,"PAH",287,1,96,0)="    "
^DIC(9.4,14,22,5.9,"PAH",287,1,97,0)=" Documentation can also be found on the VA Software Documentation Library "
^DIC(9.4,14,22,5.9,"PAH",287,1,98,0)=" at: http://www4.domain.ext/vdl/"
^DIC(9.4,14,22,5.9,"PAH",287,1,99,0)="  "
^DIC(9.4,14,22,5.9,"PAH",287,1,100,0)="                                      "
^DIC(9.4,14,22,5.9,"PAH",287,1,101,0)=" File Name                 Contents               Retrieval Format "
^DIC(9.4,14,22,5.9,"PAH",287,1,102,0)=" ------------------        --------------------   ----------------"
^DIC(9.4,14,22,5.9,"PAH",287,1,103,0)=" LAB_MICRO_INTERFACE_RELEASE_1_0_DOCS.ZIP         binary"
^DIC(9.4,14,22,5.9,"PAH",287,1,104,0)="  "
^DIC(9.4,14,22,5.9,"PAH",287,1,105,0)=" This zip file contains the following documents in both .docx and .pdf"
^DIC(9.4,14,22,5.9,"PAH",287,1,106,0)="    "
^DIC(9.4,14,22,5.9,"PAH",287,1,107,0)="           VLE Micro_Lab_Micro_Interface_Release_1.0_Technical_Manual"
^DIC(9.4,14,22,5.9,"PAH",287,1,108,0)="           VLE Micro_Lab_Micro_Interface_Release_1.0_User_Guide"
^DIC(9.4,14,22,5.9,"PAH",287,1,109,0)="           VLE Micro_Deployment_Installation_Roll Back_Back Out_Guide"
^DIC(9.4,14,22,5.9,"PAH",287,1,110,0)="    "
^DIC(9.4,14,22,5.9,"PAH",287,1,111,0)="  The VistA Documentation Library (VDL) web site will also contain the "
^DIC(9.4,14,22,5.9,"PAH",287,1,112,0)="  above referenced documents. This website is usually updated within 1-3"
^DIC(9.4,14,22,5.9,"PAH",287,1,113,0)="  days of the patch release date. The VDL web address for Laboratory"
^DIC(9.4,14,22,5.9,"PAH",287,1,114,0)="  Universal Interface user documentation is:"
^DIC(9.4,14,22,5.9,"PAH",287,1,115,0)="  http://www.domain.ext/vdl/application.asp?appid=120"
^DIC(9.4,14,22,5.9,"PAH",287,1,116,0)="  "
^DIC(9.4,14,22,5.9,"PAH",287,1,117,0)="  Pre/Post Installation Overview"
^DIC(9.4,14,22,5.9,"PAH",287,1,118,0)="  ------------------------------"
^DIC(9.4,14,22,5.9,"PAH",287,1,119,0)="  There are no Pre/Post installation routines associated with this "
^DIC(9.4,14,22,5.9,"PAH",287,1,120,0)="  patch.  "
^DIC(9.4,14,22,5.9,"PAH",287,1,121,0)="  "
^DIC(9.4,14,22,5.9,"PAH",287,1,122,0)="  Pre-Installation Instructions"
^DIC(9.4,14,22,5.9,"PAH",287,1,123,0)="  -----------------------------"
^DIC(9.4,14,22,5.9,"PAH",287,1,124,0)="  This patch may be installed with users on the system although it is"
^DIC(9.4,14,22,5.9,"PAH",287,1,125,0)="  recommended that it be installed during non-peak hours to minimize "
^DIC(9.4,14,22,5.9,"PAH",287,1,126,0)="  potential disruption to users.  This patch should take less than one  "
^DIC(9.4,14,22,5.9,"PAH",287,1,127,0)="  minute to install."
^DIC(9.4,14,22,5.9,"PAH",287,1,128,0)="  "
^DIC(9.4,14,22,5.9,"PAH",287,1,129,0)="  NOTE: Kernel patches must be current on the target system to avoid "
^DIC(9.4,14,22,5.9,"PAH",287,1,130,0)="      problems loading and/or installing this patch."
^DIC(9.4,14,22,5.9,"PAH",287,1,131,0)="  "
^DIC(9.4,14,22,5.9,"PAH",287,1,132,0)="    "
^DIC(9.4,14,22,5.9,"PAH",287,1,133,0)="     ==================== Installation Instructions ===================="
^DIC(9.4,14,22,5.9,"PAH",287,1,134,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,135,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,136,0)="     1. Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu. This"
^DIC(9.4,14,22,5.9,"PAH",287,1,137,0)="        option will load the KIDS patch onto your system."
^DIC(9.4,14,22,5.9,"PAH",287,1,138,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,139,0)="     2. The patch has now been loaded into a Transport global on your"
^DIC(9.4,14,22,5.9,"PAH",287,1,140,0)="        system. You now need to use KIDS to install the transport global."
^DIC(9.4,14,22,5.9,"PAH",287,1,141,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,142,0)="     3. On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,14,22,5.9,"PAH",287,1,143,0)="        select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",287,1,144,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,145,0)="     4. Use the 'Verify Checksum in Transport Global' option and verify"
^DIC(9.4,14,22,5.9,"PAH",287,1,146,0)="        that all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",287,1,147,0)="      "
^DIC(9.4,14,22,5.9,"PAH",287,1,148,0)="     5. On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,14,22,5.9,"PAH",287,1,149,0)="        options:"
^DIC(9.4,14,22,5.9,"PAH",287,1,150,0)="                Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",287,1,151,0)="                Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",287,1,152,0)="                Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",287,1,153,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,154,0)="        If you wish to preserve a copy of the routines exported in this "
^DIC(9.4,14,22,5.9,"PAH",287,1,155,0)="        patch prior to installation, you should use the 'Backup a "
^DIC(9.4,14,22,5.9,"PAH",287,1,156,0)="        Transport Global' option at this time. You may also compare the"
^DIC(9.4,14,22,5.9,"PAH",287,1,157,0)="        routines in your production account to the routines in the patch"
^DIC(9.4,14,22,5.9,"PAH",287,1,158,0)="        by using the 'Compare a Transport Global to Current System'"
^DIC(9.4,14,22,5.9,"PAH",287,1,159,0)="        option."
^DIC(9.4,14,22,5.9,"PAH",287,1,160,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,161,0)="     6. Use the 'Install Package(s)' option under the 'Installation' menu "
^DIC(9.4,14,22,5.9,"PAH",287,1,162,0)="        and select the package 'LR*5.2*480."
^DIC(9.4,14,22,5.9,"PAH",287,1,163,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,164,0)="        When Prompted ""Want KIDS to INHIBIT LOGONs during the install? "
^DIC(9.4,14,22,5.9,"PAH",287,1,165,0)="        NO//"", respond NO.  "
^DIC(9.4,14,22,5.9,"PAH",287,1,166,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,167,0)="        When Prompted ""Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,14,22,5.9,"PAH",287,1,168,0)="        and Protocols? NO//"", respond NO."
^DIC(9.4,14,22,5.9,"PAH",287,1,169,0)="   "
^DIC(9.4,14,22,5.9,"PAH",287,1,170,0)="  Post-Installation Instructions"
^DIC(9.4,14,22,5.9,"PAH",287,1,171,0)="  ------------------------------"
^DIC(9.4,14,22,5.9,"PAH",287,1,172,0)="  There are no post-installation tasks."
^DIC(9.4,14,22,5.9,"PAH",288,0)="483 SEQ #387^3170403.154545^54"
^DIC(9.4,14,22,5.9,"PAH",288,1,0)="^^133^133^3170403"
^DIC(9.4,14,22,5.9,"PAH",288,1,1,0)=" "
^DIC(9.4,14,22,5.9,"PAH",288,1,2,0)="This patch contains only a correction to the second line of the routine "
^DIC(9.4,14,22,5.9,"PAH",288,1,3,0)="LRAPKOE.  The second line erroneously listed patch LR*5.2*469 when it was "
^DIC(9.4,14,22,5.9,"PAH",288,1,4,0)="released with LR*5.2*479. This reference to LR*5.2*469 will be removed as"
^DIC(9.4,14,22,5.9,"PAH",288,1,5,0)="LRAPKOE was NOT released as part of LR*5.2*469. There are no other changes"
^DIC(9.4,14,22,5.9,"PAH",288,1,6,0)="to the functionality in LRAPKOE."
^DIC(9.4,14,22,5.9,"PAH",288,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",288,1,8,0)="Patch LR*5.2*479 should be installed on schedule."
^DIC(9.4,14,22,5.9,"PAH",288,1,9,0)=" "
^DIC(9.4,14,22,5.9,"PAH",288,1,10,0)="Blood Bank Review:"
^DIC(9.4,14,22,5.9,"PAH",288,1,11,0)="=================="
^DIC(9.4,14,22,5.9,"PAH",288,1,12,0)=" "
^DIC(9.4,14,22,5.9,"PAH",288,1,13,0)=" EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*483 does not "
^DIC(9.4,14,22,5.9,"PAH",288,1,14,0)=" contain any changes to the VISTA BLOOD BANK Software as defined by "
^DIC(9.4,14,22,5.9,"PAH",288,1,15,0)=" ProPath standard titled: BBM Team Review of VistA Patches."
^DIC(9.4,14,22,5.9,"PAH",288,1,16,0)=" "
^DIC(9.4,14,22,5.9,"PAH",288,1,17,0)=" RISK ANALYSIS: Changes made by patch LR*5.2*483 have no effect on Blood "
^DIC(9.4,14,22,5.9,"PAH",288,1,18,0)=" Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",288,1,19,0)=" "
^DIC(9.4,14,22,5.9,"PAH",288,1,20,0)=" VALIDATION REQUIREMENTS BY OPTION: Because of the nature of the changes "
^DIC(9.4,14,22,5.9,"PAH",288,1,21,0)=" made, no specific validation requirements exist as a result of "
^DIC(9.4,14,22,5.9,"PAH",288,1,22,0)=" installation of this patch."
^DIC(9.4,14,22,5.9,"PAH",288,1,23,0)=" "
