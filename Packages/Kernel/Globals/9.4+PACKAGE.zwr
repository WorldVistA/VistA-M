^DIC(9.4,47,22,5.9,"PAH",751,0)="961 SEQ #843^3181004.144932^54"
^DIC(9.4,47,22,5.9,"PAH",751,1,0)="^^2^2^3181004"
^DIC(9.4,47,22,5.9,"PAH",751,1,1,0)="Office of Mental Health is requesting 4 Treating Specialty (TS) Codes be "
^DIC(9.4,47,22,5.9,"PAH",751,1,2,0)="inactivated with an inactivation date of 10/1/18"
^DIC(9.4,47,22,5.9,"PAH",752,0)="960 SEQ #844^3181004.162657^54"
^DIC(9.4,47,22,5.9,"PAH",752,1,0)="^^2^2^3181004"
^DIC(9.4,47,22,5.9,"PAH",752,1,1,0)="This Build contains components for the report enhancements to PRF by the "
^DIC(9.4,47,22,5.9,"PAH",752,1,2,0)="SHRPE project."
^DIC(9.4,47,22,5.9,"PAH",753,0)="970 SEQ #845^3181101.162313^54"
^DIC(9.4,47,22,5.9,"PAH",753,1,0)="^^1^1^3181101"
^DIC(9.4,47,22,5.9,"PAH",753,1,1,0)="Please refer to the Patch Description in FORUM for patch DG*5.3*970"
^DIC(9.4,47,22,5.9,"PAH",754,0)="947 SEQ #846^3181102.152732^54"
^DIC(9.4,47,22,5.9,"PAH",754,1,0)="^^2^2^3181102"
^DIC(9.4,47,22,5.9,"PAH",754,1,1,0)="Please see the DG*5.3*947 patch description for detailed information "
^DIC(9.4,47,22,5.9,"PAH",754,1,2,0)="regarding this patch."
^DIC(9.4,47,22,5.9,"PAH",755,0)="958 SEQ #847^3181102.15333^54"
^DIC(9.4,47,22,5.9,"PAH",755,1,0)="^^6^6^3181102"
^DIC(9.4,47,22,5.9,"PAH",755,1,1,0)="This patch addresses NSR 20171118. It modifies the option Religion List "
^DIC(9.4,47,22,5.9,"PAH",755,1,2,0)="for Inpatients [DG RELIGION LIST] to display only the last four digits of"
^DIC(9.4,47,22,5.9,"PAH",755,1,3,0)="a patient's Social Security Number (SSN). This option is used to run a"
^DIC(9.4,47,22,5.9,"PAH",755,1,4,0)="report listing inpatients by religious faith. Currently, this option"
^DIC(9.4,47,22,5.9,"PAH",755,1,5,0)="unnecessarily displays each patient's full SSN. This modification helps"
^DIC(9.4,47,22,5.9,"PAH",755,1,6,0)="protect patient privacy and supports national SSN reduction efforts."
^DIC(9.4,47,22,5.9,"PAH",756,0)="965 SEQ #848^3181203.180952^54"
^DIC(9.4,47,22,5.9,"PAH",756,1,0)="^^3^3^3181203"
^DIC(9.4,47,22,5.9,"PAH",756,1,1,0)="Patch DG*5.3*965 addresses 2 issues:"
^DIC(9.4,47,22,5.9,"PAH",756,1,2,0)="1. <SUBSCRIPT>PIVNW+40^VAFHPIVT error (Pivot file entry not there)."
^DIC(9.4,47,22,5.9,"PAH",756,1,3,0)="2. SAM-site is receiving SUBSCRIPT>SAVE+11^DGRPECE error"
^DIC(9.4,47,22,5.9,"PAH",757,0)="967 SEQ #849^3181206.16091^54"
^DIC(9.4,47,22,5.9,"PAH",757,1,0)="^^3^3^3181206"
^DIC(9.4,47,22,5.9,"PAH",757,1,1,0)="MASTER VETERAN INDEX VISTA ENHANCEMENTS - MVI SENSITIVITY"
^DIC(9.4,47,22,5.9,"PAH",757,1,2,0)="Refer to patch DG*5.3*967 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",757,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",758,0)="941^3190103.170114^54"
^DIC(9.4,47,22,5.9,"PAH",758,1,0)="^^2^2^3190103"
^DIC(9.4,47,22,5.9,"PAH",758,1,1,0)="Please see the DG*5.3*941 patch description for detailed information "
^DIC(9.4,47,22,5.9,"PAH",758,1,2,0)="regarding this patch."
^DIC(9.4,47,22,5.9,"PAH",759,0)="973^3190103.170634^54"
^DIC(9.4,47,22,5.9,"PAH",759,1,0)="^^11^11^3190103"
^DIC(9.4,47,22,5.9,"PAH",759,1,1,0)="The Means Test thresholds for Calendar Year 2019 are distributed with this"
^DIC(9.4,47,22,5.9,"PAH",759,1,2,0)="patch. The post-installation routine, DG53973P, will create a new subentry"
^DIC(9.4,47,22,5.9,"PAH",759,1,3,0)="(or replace an existing one) for calendar year 2019 in the MEANS TEST DATA"
^DIC(9.4,47,22,5.9,"PAH",759,1,4,0)="(#250) multiple field of the MAS PARAMETERS (#43) file. "
^DIC(9.4,47,22,5.9,"PAH",759,1,5,0)=" "
^DIC(9.4,47,22,5.9,"PAH",759,1,6,0)=" "
^DIC(9.4,47,22,5.9,"PAH",759,1,7,0)="This patch, DG*5.3*973 is one of three VistA 2019 threshold patches. It "
^DIC(9.4,47,22,5.9,"PAH",759,1,8,0)="updates the thresholds for the Means Tests and the Maximum Annual Pension "
^DIC(9.4,47,22,5.9,"PAH",759,1,9,0)="Rate. Patch EAS*1.0*170 will address the annual updates for the GMT "
^DIC(9.4,47,22,5.9,"PAH",759,1,10,0)="Thresholds and patch IB*2.0*635 will address the annual updates for the "
^DIC(9.4,47,22,5.9,"PAH",759,1,11,0)="Pharmacy Copay Thresholds."
^DIC(9.4,47,22,5.9,"PAH",760,0)="971 SEQ #852^3190131.164231^54"
^DIC(9.4,47,22,5.9,"PAH",760,1,0)="^^4^4^3190131"
^DIC(9.4,47,22,5.9,"PAH",760,1,1,0)="User gets <UNDEFINED>ACTIVE+51^DGPFAPIU *DGACT(0) when using the Reminder "
^DIC(9.4,47,22,5.9,"PAH",760,1,2,0)="Test[PXRM REMINDER TEST] option in the Reminder Managers Menu[PXRM "
^DIC(9.4,47,22,5.9,"PAH",760,1,3,0)="MANAGERS MENU] when the end date of the PRF Assignment date is the same "
^DIC(9.4,47,22,5.9,"PAH",760,1,4,0)="as the end date for the report. "
^DIC(9.4,47,22,5.9,"PAH",761,0)="966 SEQ #853^3190201.160454^54"
^DIC(9.4,47,22,5.9,"PAH",761,1,0)="^^2^2^3190201"
^DIC(9.4,47,22,5.9,"PAH",761,1,1,0)="Please see the DG*5.3*966 patch description for detailed information "
^DIC(9.4,47,22,5.9,"PAH",761,1,2,0)="regarding this patch."
^DIC(9.4,47,22,5.9,"PAH",762,0)="951 SEQ #854^3190305.144117^54"
^DIC(9.4,47,22,5.9,"PAH",762,1,0)="^^22^22^3190305"
^DIC(9.4,47,22,5.9,"PAH",762,1,1,0)="This patch addresses enhancements to Patient Record Flags (PRF) to "
^DIC(9.4,47,22,5.9,"PAH",762,1,2,0)="improve the delivery of targeted Mental Health care for individuals at "
^DIC(9.4,47,22,5.9,"PAH",762,1,3,0)="high risk for suicide."
^DIC(9.4,47,22,5.9,"PAH",762,1,4,0)=" "
^DIC(9.4,47,22,5.9,"PAH",762,1,5,0)="Enhancements to PRF reports were made to improve effective management of "
^DIC(9.4,47,22,5.9,"PAH",762,1,6,0)="coordination of care for high risk individuals and to include new data "
^DIC(9.4,47,22,5.9,"PAH",762,1,7,0)="elements introduced with this patch."
^DIC(9.4,47,22,5.9,"PAH",762,1,8,0)=" "
^DIC(9.4,47,22,5.9,"PAH",762,1,9,0)="1. The Disruptive Behavior Reporting System (DBRS) record numbers are now "
^DIC(9.4,47,22,5.9,"PAH",762,1,10,0)="recorded in the PRF FileMan files to enable a convenient reference "
^DIC(9.4,47,22,5.9,"PAH",762,1,11,0)="between VistA and DBRS."
^DIC(9.4,47,22,5.9,"PAH",762,1,12,0)=" "
^DIC(9.4,47,22,5.9,"PAH",762,1,13,0)="2. Modification to support TIU/CPRS Progress Note Properties' action list "
^DIC(9.4,47,22,5.9,"PAH",762,1,14,0)="functionality. "
^DIC(9.4,47,22,5.9,"PAH",762,1,15,0)=" "
^DIC(9.4,47,22,5.9,"PAH",762,1,16,0)="3. Enhancements to PRF flags ownership transfers. The patch implements "
^DIC(9.4,47,22,5.9,"PAH",762,1,17,0)="new functionality and makes modification to existing code to improve the "
^DIC(9.4,47,22,5.9,"PAH",762,1,18,0)="process of ownership transfer and eliminate issues reported by PRF users. "
^DIC(9.4,47,22,5.9,"PAH",762,1,19,0)=" "
^DIC(9.4,47,22,5.9,"PAH",762,1,20,0)="4. Various enhancements and fixes related to PRF flag HL7 transmissions "
^DIC(9.4,47,22,5.9,"PAH",762,1,21,0)=" "
^DIC(9.4,47,22,5.9,"PAH",762,1,22,0)="Please see the patch description of the patch in FORUM for details."
^DIC(9.4,47,22,5.9,"PAH",763,0)="974 SEQ #855^3190501.151212^54"
^DIC(9.4,47,22,5.9,"PAH",763,1,0)="^^3^3^3190501"
^DIC(9.4,47,22,5.9,"PAH",763,1,1,0)="MASTER VETERAN INDEX VISTA ENHANCEMENTS - SUPPORT LONG NAMES IN VA MPI"
^DIC(9.4,47,22,5.9,"PAH",763,1,2,0)="Refer to patch DG*5.3*974 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",763,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",764,0)="975 SEQ #856^3190604.175623^54"
^DIC(9.4,47,22,5.9,"PAH",764,1,0)="^^3^3^3190604"
^DIC(9.4,47,22,5.9,"PAH",764,1,1,0)="Patch DG*5.3*975 fixes an issue where the old MSE (Military Service"
^DIC(9.4,47,22,5.9,"PAH",764,1,2,0)="Episode) data is being deleted from an incoming ORFZ11 and new MSE data"
^DIC(9.4,47,22,5.9,"PAH",764,1,3,0)="is not being stored."
^DIC(9.4,47,22,5.9,"PAH",765,0)="976 SEQ #857^3190604.180001^54"
^DIC(9.4,47,22,5.9,"PAH",765,1,0)="^^1^1^3190604"
^DIC(9.4,47,22,5.9,"PAH",765,1,1,0)="Please refer to the Patch Description in FORUM for patch DG*5.3*976"
^DIC(9.4,47,22,5.9,"PAH",766,0)="979 SEQ #858^3190708.165038^65"
^DIC(9.4,47,22,5.9,"PAH",766,1,0)="^^7^7^3190708"
^DIC(9.4,47,22,5.9,"PAH",766,1,1,0)="User reported an issue in the ISO Sensitive Records Report-Export [DG "
^DIC(9.4,47,22,5.9,"PAH",766,1,2,0)="SENSITIVE RCDS RPT-EXPORT] option where the data is not being displayed "
^DIC(9.4,47,22,5.9,"PAH",766,1,3,0)="correctly if the PATIENT NAME (.01) field is 30 characters long. The "
^DIC(9.4,47,22,5.9,"PAH",766,1,4,0)="print template does not account for the ""^"" it concatenates to the end of "
^DIC(9.4,47,22,5.9,"PAH",766,1,5,0)="the patients name to use as a delimiter. Therefore, the PATIENT NAME "
^DIC(9.4,47,22,5.9,"PAH",766,1,6,0)="(.01) and the DATE/TIME RECORD ACCESSED (#50) field would be displayed "
^DIC(9.4,47,22,5.9,"PAH",766,1,7,0)="together."
^DIC(9.4,47,22,5.9,"PAH",767,0)="978^3190912.122259^65"
^DIC(9.4,47,22,5.9,"PAH",767,1,0)="^^2^2^3190912"
^DIC(9.4,47,22,5.9,"PAH",767,1,1,0)="Please see the DG*5.3*978 patch description for detailed information "
^DIC(9.4,47,22,5.9,"PAH",767,1,2,0)="regarding this patch."
^DIC(9.4,47,22,5.9,"PAH",768,0)="987 SEQ #860^3191016.162847^65"
^DIC(9.4,47,22,5.9,"PAH",768,1,0)="^^2^2^3191016"
