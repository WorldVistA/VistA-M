^DIC(9.4,14,22,5.9,"PAH",129,1,44,0)="   Test Site(s):   ASHEVILLE, NC"
^DIC(9.4,14,22,5.9,"PAH",129,1,45,0)="                   AUGUSTA, GA (C)"
^DIC(9.4,14,22,5.9,"PAH",129,1,46,0)="                   FAYETTEVILLE, AR"
