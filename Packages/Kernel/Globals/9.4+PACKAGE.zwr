^DIC(9.4,137,22,3,"PAH",8,0)="54 SEQ #52^2980409^1"
^DIC(9.4,137,22,3,"PAH",8,1,0)="^^4^4^2980409"
^DIC(9.4,137,22,3,"PAH",8,1,1,0)="The routine SOWKQAMN contained in patch SOW*3*53 contained erroneous"
^DIC(9.4,137,22,3,"PAH",8,1,2,0)="patch tracking information on the second line. This patch updates that"
^DIC(9.4,137,22,3,"PAH",8,1,3,0)="routine to provide accurate patch tracking information within the routine."
^DIC(9.4,137,22,3,"PAH",8,1,4,0)="The version of SOWKQAMN contained in SOW*3*53 is functionally correct."
^DIC(9.4,137,22,3,"PAH",9,0)="55 SEQ #53^2980428^1"
^DIC(9.4,137,22,3,"PAH",9,1,0)="^^7^7^2980428"
^DIC(9.4,137,22,3,"PAH",9,1,1,0)="This patch contains a routine, executed as a post installation routine,"
^DIC(9.4,137,22,3,"PAH",9,1,2,0)="to ensure that the prefix SOW is entered for the SOCIAL WORK entry in the"
^DIC(9.4,137,22,3,"PAH",9,1,3,0)="PACKAGE file (9.4)."
^DIC(9.4,137,22,3,"PAH",9,1,4,0)=" "
^DIC(9.4,137,22,3,"PAH",9,1,5,0)="During the process the entry SOCIAL WORK PATCH in the PACKAGE file (9.4)"
^DIC(9.4,137,22,3,"PAH",9,1,6,0)="will also be updated. The prefix for SOCIAL WORK PATCH will be changed to"
^DIC(9.4,137,22,3,"PAH",9,1,7,0)="ZZSW. It is no longer used."
^DIC(9.4,137,22,3,"PAH",10,0)="56 SEQ #54^2980712^1"
^DIC(9.4,137,22,3,"PAH",10,1,0)="^^4^4^2980712"
^DIC(9.4,137,22,3,"PAH",10,1,1,0)="This patch contains changes to the option Summary Open Cases -"
^DIC(9.4,137,22,3,"PAH",10,1,2,0)="Workers Patient Registry [SOWKPS]. It will move the column containing the"
^DIC(9.4,137,22,3,"PAH",10,1,3,0)="patient ID from column 25 to column 32, allowing more space for the"
^DIC(9.4,137,22,3,"PAH",10,1,4,0)="patient's name on the report."
^DIC(9.4,137,22,3,"PAH",11,0)="57 SEQ #55^2980725^1"
^DIC(9.4,137,22,3,"PAH",11,1,0)="^^7^7^2980725"
^DIC(9.4,137,22,3,"PAH",11,1,1,0)="This patch will delete the obsolete NURSING HOME PROFILE file (#658). It"
^DIC(9.4,137,22,3,"PAH",11,1,2,0)="was never used in Social Work V. 3.0. A decision was made to delete"
^DIC(9.4,137,22,3,"PAH",11,1,3,0)="this file because it contains references to the USER file (#3) which is"
^DIC(9.4,137,22,3,"PAH",11,1,4,0)="slated for removal. In addition to deleting the file, associated templates"
^DIC(9.4,137,22,3,"PAH",11,1,5,0)="are also deleted. This includes the input templates SWNHADD and SWNHEDIT,"
^DIC(9.4,137,22,3,"PAH",11,1,6,0)="sort template SWNH PRINT, and print template SWNH PRINT. All locally"
^DIC(9.4,137,22,3,"PAH",11,1,7,0)="created templates for this file will also be deleted."
^DIC(9.4,137,22,3,"PAH",12,0)="58 SEQ #56^2990417^1"
^DIC(9.4,137,22,3,"PAH",12,1,0)="^^18^18^2990417"
^DIC(9.4,137,22,3,"PAH",12,1,1,0)="1. This patch will delete the CNHC COST CONTROL file (#657). It"
^DIC(9.4,137,22,3,"PAH",12,1,2,0)="was never used in Social Work V. 3.0. Associate templates are also"
^DIC(9.4,137,22,3,"PAH",12,1,3,0)="removed. They are as follows:"
^DIC(9.4,137,22,3,"PAH",12,1,4,0)=" "
^DIC(9.4,137,22,3,"PAH",12,1,5,0)=" INPUT TEMPLATE(S)     PRINT TEMPLATE(S)          SORT TEMPLATE"
^DIC(9.4,137,22,3,"PAH",12,1,6,0)=" =================     =====================      ======================="
^DIC(9.4,137,22,3,"PAH",12,1,7,0)=" SOWKASIH              SOWKCNHC COST BREAKDOWN    SOWKCNHC COST BREAKDOWN"
^DIC(9.4,137,22,3,"PAH",12,1,8,0)=" SOWKCNHEDT"
^DIC(9.4,137,22,3,"PAH",12,1,9,0)=" SOWKRC"
^DIC(9.4,137,22,3,"PAH",12,1,10,0)=" SWASIH"
^DIC(9.4,137,22,3,"PAH",12,1,11,0)=" SWNRC "
^DIC(9.4,137,22,3,"PAH",12,1,12,0)=" "
^DIC(9.4,137,22,3,"PAH",12,1,13,0)=" "
^DIC(9.4,137,22,3,"PAH",12,1,14,0)="2. This patch removes the Automatic Reporting System [SOWKIPD] menu and"
^DIC(9.4,137,22,3,"PAH",12,1,15,0)="the options included within it. This includes the options Compile AMIS"
^DIC(9.4,137,22,3,"PAH",12,1,16,0)="Data [SOWKARS], Print Patient and AMIS Segments Data (132 COLUMNS)"
^DIC(9.4,137,22,3,"PAH",12,1,17,0)="[SOWKARSP], and Transmit AMIS Data Via MailMan [SOWKARSE].  It will also"
^DIC(9.4,137,22,3,"PAH",12,1,18,0)="delete associated routines."
^DIC(9.4,137,22,3,"PAH",13,0)="60 SEQ #57^3000417^1"
^DIC(9.4,137,22,3,"PAH",13,1,0)="^^2^2^3000417"
^DIC(9.4,137,22,3,"PAH",13,1,1,0)="When a file lookup is performed a $TEST check after the call, no longer"
^DIC(9.4,137,22,3,"PAH",13,1,2,0)="functions properly. The solution for this is to remove the $TEST checks."
^DIC(9.4,137,22,3,"PAH",14,0)="61 SEQ #58^3000501^1"
^DIC(9.4,137,22,3,"PAH",14,1,0)="^^3^3^3000501"
^DIC(9.4,137,22,3,"PAH",14,1,1,0)="This patch inserts a line between ""FO will stand for FOOD"" and"
^DIC(9.4,137,22,3,"PAH",14,1,2,0)="""HE will stand for HEALTH"" when using the Print SWS Agency [SOWKBHPR]"
^DIC(9.4,137,22,3,"PAH",14,1,3,0)="option."
^DIC(9.4,137,22,3,"PAH",15,0)="62 SEQ #59^3010305^1"
^DIC(9.4,137,22,3,"PAH",15,1,0)="^^2^2^3010305"
^DIC(9.4,137,22,3,"PAH",15,1,1,0)="See Patch SOW*3*62 in the National Patch Module for description of the"
^DIC(9.4,137,22,3,"PAH",15,1,2,0)="Build."
^DIC(9.4,137,22,3,"PAH",16,0)="63 SEQ #60^3030115^1"
^DIC(9.4,137,22,3,"PAH",16,1,0)="^^5^5^3030115"
^DIC(9.4,137,22,3,"PAH",16,1,1,0)="The Assessment Profile [SOWKDBP] option will reflect the New Race and "
^DIC(9.4,137,22,3,"PAH",16,1,2,0)="Ethnicity Standards enhancements.  The modified routine will "
^DIC(9.4,137,22,3,"PAH",16,1,3,0)="display/print, in the demographic section, the Veteran's Ethnicity in"
^DIC(9.4,137,22,3,"PAH",16,1,4,0)="sequence 9 and the Veteran's Race(s) in sequence 10.  The Veteran's "
^DIC(9.4,137,22,3,"PAH",16,1,5,0)="Religious preference will shifted to sequence 11."
^DIC(9.4,137,22,3,"PAH",17,0)="64 SEQ #61^3071212.211745^1"
^DIC(9.4,137,22,3,"PAH",17,1,0)="^^10^10^3071212"
^DIC(9.4,137,22,3,"PAH",17,1,1,0)="The Scheduling V. 5.3 package is moving the patient appointment information"
^DIC(9.4,137,22,3,"PAH",17,1,2,0)="stored in the APPOINTMENT sub-file (#2.98) of the PATIENT file (#2) and the"
^DIC(9.4,137,22,3,"PAH",17,1,3,0)="APPOINTMENT sub-file  (#44.001) of the HOSPITAL LOCATION file (#44) to the"
^DIC(9.4,137,22,3,"PAH",17,1,4,0)="Government Off-the-Shelf (GOTS) database. Eventually, these sub-files will"
^DIC(9.4,137,22,3,"PAH",17,1,5,0)="be deleted from the Scheduling files. As part of the Scheduling Replacement"
^DIC(9.4,137,22,3,"PAH",17,1,6,0)="Project, Scheduling V. 5.3 package is providing a series of Application"
^DIC(9.4,137,22,3,"PAH",17,1,7,0)="Programmer Interface calls (APIs) that will be used to get the patient"
^DIC(9.4,137,22,3,"PAH",17,1,8,0)="appointment information from the new GOTS database. This patch replaces all"
^DIC(9.4,137,22,3,"PAH",17,1,9,0)="direct references to the patient appointment information in the Management"
^DIC(9.4,137,22,3,"PAH",17,1,10,0)="Monitor V [SOWKQAMONV] option, with the new APIs. "
^DIC(9.4,137,22,3,"PAH",18,0)="65 SEQ #62^3200623.14424^65"
^DIC(9.4,137,22,3,"PAH",18,1,0)="^^2^2^3200623"
^DIC(9.4,137,22,3,"PAH",18,1,1,0)="This patch will retire the Social Work package by removing all associated "
^DIC(9.4,137,22,3,"PAH",18,1,2,0)="components."
^DIC(9.4,137,22,3,"PAH","B","40 SEQ #49",5)=""
