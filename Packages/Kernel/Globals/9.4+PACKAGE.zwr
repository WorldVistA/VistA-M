^DIC(9.4,5,22,13,"PAH",7,1,49,0)="XINDX3        3897455   3946423    **20**"
^DIC(9.4,5,22,13,"PAH",7,1,50,0)="XINDX4        4711071   5192692    **20**"
^DIC(9.4,5,22,13,"PAH",7,1,51,0)="XINDX5        6259999   7001485    **20**"
^DIC(9.4,5,22,13,"PAH",7,1,52,0)="XINDX51       9529173   9238490    **20**"
^DIC(9.4,5,22,13,"PAH",7,1,53,0)="XINDX52       2298647   2275540    **20**"
^DIC(9.4,5,22,13,"PAH",7,1,54,0)="XINDX53       4122188   4208616    **20**"
^DIC(9.4,5,22,13,"PAH",7,1,55,0)="XINDX6       10179476  10238332    **20**"
^DIC(9.4,5,22,13,"PAH",7,1,56,0)="XINDX7        7575886   7680200    **20**"
^DIC(9.4,5,22,13,"PAH",7,1,57,0)="XINDX8        6101428   6232391    **20**"
^DIC(9.4,5,22,13,"PAH",7,1,58,0)="XINDX9        4045898   4248028    **20**"
^DIC(9.4,5,22,13,"PAH",7,1,59,0)="XTRUTL        3298585   3298825    **20**"
