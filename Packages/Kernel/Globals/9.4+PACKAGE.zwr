^DIC(9.4,14,22,5.9,"PAH",98,1,385,0)=" "
^DIC(9.4,14,22,5.9,"PAH",98,1,386,0)="Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES// YES"
^DIC(9.4,14,22,5.9,"PAH",98,1,387,0)=" "
^DIC(9.4,14,22,5.9,"PAH",98,1,388,0)=" "
^DIC(9.4,14,22,5.9,"PAH",98,1,389,0)="Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,14,22,5.9,"PAH",98,1,390,0)="Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,14,22,5.9,"PAH",98,1,391,0)=" "
^DIC(9.4,14,22,5.9,"PAH",98,1,392,0)="Enter the Device you want to print the Install messages."
^DIC(9.4,14,22,5.9,"PAH",98,1,393,0)="You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,14,22,5.9,"PAH",98,1,394,0)="Enter a '^' to abort the install."
^DIC(9.4,14,22,5.9,"PAH",98,1,395,0)="DEVICE: HOME//   TELNET"
^DIC(9.4,14,22,5.9,"PAH",98,1,396,0)="Install Started for LR*5.2*263 : "
^DIC(9.4,14,22,5.9,"PAH",98,1,397,0)="               Feb 29, 2000@15:53:41"
^DIC(9.4,14,22,5.9,"PAH",98,1,398,0)=" "
^DIC(9.4,14,22,5.9,"PAH",98,1,399,0)="Build Distribution Date: Jan 27, 2000"
