^DIC(9.4,207,22,2,0)="2.0"
^DIC(9.4,207,22,2,"PAH",0)="^9.4901^4^4"
^DIC(9.4,207,22,2,"PAH",1,0)="0^3161118.17145^54"
^DIC(9.4,207,22,2,"PAH",2,0)="1 SEQ #2^3181206.155854^54"
^DIC(9.4,207,22,2,"PAH",2,1,0)="^^169^169^3181206"
^DIC(9.4,207,22,2,"PAH",2,1,1,0)="This patch (VBEC*2*1) is being released in conjunction with the Vista "
^DIC(9.4,207,22,2,"PAH",2,1,2,0)="Blood Establishment Computer Software (VBECS) VBECS 2.3.0 server patch."
^DIC(9.4,207,22,2,"PAH",2,1,3,0)=" "
^DIC(9.4,207,22,2,"PAH",2,1,4,0)="Installation of this patch will have no effect on sites who have not "
^DIC(9.4,207,22,2,"PAH",2,1,5,0)="installed VBECS."
^DIC(9.4,207,22,2,"PAH",2,1,6,0)=" "
^DIC(9.4,207,22,2,"PAH",2,1,7,0)="A full description of the VistA patch changes and implementation process "
^DIC(9.4,207,22,2,"PAH",2,1,8,0)="are included in the VBECS 2.3.0 Release Notes."
^DIC(9.4,207,22,2,"PAH",2,1,9,0)=" "
^DIC(9.4,207,22,2,"PAH",2,1,10,0)="The VistA patch is released with a seven (7) day compliance date."
^DIC(9.4,207,22,2,"PAH",2,1,11,0)=" "
^DIC(9.4,207,22,2,"PAH",2,1,12,0)="BLOOD BANK CLEARANCE"
^DIC(9.4,207,22,2,"PAH",2,1,13,0)="===================="
^DIC(9.4,207,22,2,"PAH",2,1,14,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch VBEC*2*1 contains "
^DIC(9.4,207,22,2,"PAH",2,1,15,0)="changes to a package referenced in VHA OI SEPG SOP 192-023 Review of "
^DIC(9.4,207,22,2,"PAH",2,1,16,0)="VISTA Patches for Effects on VISTA Blood Bank Software. This patch does "
^DIC(9.4,207,22,2,"PAH",2,1,17,0)="not alter or modify any VistA Blood Bank software design safeguards or "
^DIC(9.4,207,22,2,"PAH",2,1,18,0)="safety critical elements functions."
^DIC(9.4,207,22,2,"PAH",2,1,19,0)=" "
^DIC(9.4,207,22,2,"PAH",2,1,20,0)="RISK ANALYSIS: Changes made by patch VBEC*2*1 have no adverse effect on "
^DIC(9.4,207,22,2,"PAH",2,1,21,0)="VistA Blood Bank software functionality, therefore RISK is none."
^DIC(9.4,207,22,2,"PAH",2,1,22,0)=" "
^DIC(9.4,207,22,2,"PAH",2,1,23,0)="VALIDATION REQUIREMENTS:"
^DIC(9.4,207,22,2,"PAH",2,1,24,0)="========================"
^DIC(9.4,207,22,2,"PAH",2,1,25,0)="The VBECS 2.3.0 update and VBEC*2*1 require customer validation in the "
^DIC(9.4,207,22,2,"PAH",2,1,26,0)="local Test account prior to installation in Production to meet Food & "
^DIC(9.4,207,22,2,"PAH",2,1,27,0)="Drug Administration (FDA) requirements. The user validates the Blood Bank "
^DIC(9.4,207,22,2,"PAH",2,1,28,0)="software for its intended use prior to its acceptance and use for patient "
^DIC(9.4,207,22,2,"PAH",2,1,29,0)="care. The VBECS 2.3.0 Release Notes contain descriptions of the changes "
^DIC(9.4,207,22,2,"PAH",2,1,30,0)="made in this patch and includes validation scenarios."
^DIC(9.4,207,22,2,"PAH",2,1,31,0)=" "
^DIC(9.4,207,22,2,"PAH",2,1,32,0)="It is imperative that the installation of VBEC*2*1 occur prior to the "
^DIC(9.4,207,22,2,"PAH",2,1,33,0)="installation of the VBECS 2.3.0 server patch. Coordinate the installation "
^DIC(9.4,207,22,2,"PAH",2,1,34,0)="with Pathology & Laboratory Medicine Service staff to allow adequate time "
^DIC(9.4,207,22,2,"PAH",2,1,35,0)="for impact analysis and testing the changes prior to installation in "
^DIC(9.4,207,22,2,"PAH",2,1,36,0)="Production."
^DIC(9.4,207,22,2,"PAH",2,1,37,0)=" "
