^DIC(9.4,52,22,28,"PAH",26,1,1,0)="Various fixes to Control Point module."
^DIC(9.4,52,22,28,"PAH",27,0)="85^2961207^1"
^DIC(9.4,52,22,28,"PAH",27,1,0)="^^2^2^2961207"
^DIC(9.4,52,22,28,"PAH",27,1,1,0)=" "
^DIC(9.4,52,22,28,"PAH",27,1,2,0)="This Build contains the KIDS Installation for PRC*5*85."
^DIC(9.4,52,22,28,"PAH",28,0)="108^2961224^1"
^DIC(9.4,52,22,28,"PAH",28,1,0)="^^5^5^2961224"
^DIC(9.4,52,22,28,"PAH",28,1,1,0)="This patch will correct routine PRCOPHA1 to include '1' as the sixth"
^DIC(9.4,52,22,28,"PAH",28,1,2,0)="parameter in the call to TRANSMIT^PRCPSMCS.  When this parameter is"
^DIC(9.4,52,22,28,"PAH",28,1,3,0)="included, during the EDI Retransmit option the version number in the PHA"
^DIC(9.4,52,22,28,"PAH",28,1,4,0)="transaction's ISM segment will be '001', the correct version, rather than"
^DIC(9.4,52,22,28,"PAH",28,1,5,0)="'040', the default but here incorrect version."
^DIC(9.4,52,22,28,"PAH",29,0)="105 SEQ #90^2970107^1"
^DIC(9.4,52,22,28,"PAH",29,1,0)="^^1^1^2970107"
^DIC(9.4,52,22,28,"PAH",29,1,1,0)="PURCHASE CARD CHANGES"
^DIC(9.4,52,22,28,"PAH",30,0)="110 SEQ #92^2970122^1"
^DIC(9.4,52,22,28,"PAH",30,1,0)="^^1^1^2970122"
^DIC(9.4,52,22,28,"PAH",30,1,1,0)="820 PROCESSING FIX"
^DIC(9.4,52,22,28,"PAH",31,0)="114 SEQ #93^2970122^1"
^DIC(9.4,52,22,28,"PAH",31,1,0)="^^5^5^2970122"
^DIC(9.4,52,22,28,"PAH",31,1,1,0)="This patch corrects the logic for calculating the Current Fiscal Year"
^DIC(9.4,52,22,28,"PAH",31,1,2,0)="during the building of the PV transaction for transmission to FMS."
^DIC(9.4,52,22,28,"PAH",31,1,3,0)=" "
^DIC(9.4,52,22,28,"PAH",31,1,4,0)="This patch also backs out the changes to routine PRCB1E1 which were"
^DIC(9.4,52,22,28,"PAH",31,1,5,0)="introduced with patch PRC*5*96 affecting Carry Forward."
^DIC(9.4,52,22,28,"PAH",32,0)="97 SEQ #94^2970204^1"
^DIC(9.4,52,22,28,"PAH",32,1,0)="^^1^1^2970204"
^DIC(9.4,52,22,28,"PAH",32,1,1,0)="For Kernel Sort/ Patch 97."
