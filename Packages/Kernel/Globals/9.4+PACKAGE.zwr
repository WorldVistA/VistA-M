^DIC(9.4,4,22,1,"PAH",129,0)="161 SEQ #154^3010103^1"
^DIC(9.4,4,22,1,"PAH",129,1,0)="^^58^58^3010103"
^DIC(9.4,4,22,1,"PAH",129,1,1,0)="Patch XM*7.1*161"
^DIC(9.4,4,22,1,"PAH",129,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",129,1,3,0)="NOIS: none"
^DIC(9.4,4,22,1,"PAH",129,1,4,0)="Test Sites:  FORUM"
^DIC(9.4,4,22,1,"PAH",129,1,5,0)="If a user, using the Classic reader, deletes all the messages in his basket,"
^DIC(9.4,4,22,1,"PAH",129,1,6,0)="MailMan tells him that he has only confidential messages in his basket, and"
^DIC(9.4,4,22,1,"PAH",129,1,7,0)="that as a surrogate, he is not allowed to read them.  This patch corrects"
^DIC(9.4,4,22,1,"PAH",129,1,8,0)="that."
^DIC(9.4,4,22,1,"PAH",129,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",129,1,10,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",129,1,11,0)="is at a minimum.  It requires MailMan patch XM*7.1*160."
^DIC(9.4,4,22,1,"PAH",129,1,12,0)="============================================================================ "
