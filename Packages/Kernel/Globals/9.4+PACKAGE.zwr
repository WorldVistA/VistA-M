^DIC(9.4,4,22,1,"PAH",77,1,6,0)="Post patch XM*7.1*50, setting XMSUB to a message subject, and then queueing"
^DIC(9.4,4,22,1,"PAH",77,1,7,0)="a report to the p-message device fails to pick up the message subject."
^DIC(9.4,4,22,1,"PAH",77,1,8,0)="This patch corrects that."
^DIC(9.4,4,22,1,"PAH",77,1,9,0)=""
^DIC(9.4,4,22,1,"PAH",77,1,10,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",77,1,11,0)="minimum.  It requires MailMan patch XM*7.1*91."
