^DIC(9.4,28,22,6,"PAH",1,1,58,0)="4297              Date of Birth Part 3      mmyyyy          mmyy"
^DIC(9.4,28,22,6,"PAH",1,1,59,0)="4350              Period Ending             mmddyyyy        mmddyy"
