^DIC(9.4,133,7)="^^I"
^DIC(9.4,133,11)="910^919.99"
^DIC(9.4,133,22,0)="^9.49I^9^1"
^DIC(9.4,133,22,9,0)="1.0^3051119"
^DIC(9.4,133,22,9,"PAH",0)="^9.4901^29^29"
^DIC(9.4,133,22,9,"PAH",1,0)="17^2970303^1"
^DIC(9.4,133,22,9,"PAH",1,1,0)="^^2^2^2970303"
^DIC(9.4,133,22,9,"PAH",1,1,1,0)="See National Patch Module (NPM) for a description of the changes included"
^DIC(9.4,133,22,9,"PAH",1,1,2,0)="in this patch."
^DIC(9.4,133,22,9,"PAH",2,0)="19 SEQ #18^2970501^1"
^DIC(9.4,133,22,9,"PAH",2,1,0)="^^2^2^2970501"
^DIC(9.4,133,22,9,"PAH",2,1,1,0)="This patch corrects 4 input templates related to the Uniform Offense"
^DIC(9.4,133,22,9,"PAH",2,1,2,0)="Report.  See NPM for complete description."
^DIC(9.4,133,22,9,"PAH",3,0)="18 SEQ #19^2970501^1"
^DIC(9.4,133,22,9,"PAH",3,1,0)="^^3^3^2970501"
^DIC(9.4,133,22,9,"PAH",3,1,1,0)="This patch corrects several problems, mostly with the Daily Operations"
^DIC(9.4,133,22,9,"PAH",3,1,2,0)="Journal, reported via NOIS since patch 17.  See NPM for complete"
^DIC(9.4,133,22,9,"PAH",3,1,3,0)="description."
^DIC(9.4,133,22,9,"PAH",4,0)="20^2980330^1"
^DIC(9.4,133,22,9,"PAH",4,1,0)="^^2^2^2980330"
^DIC(9.4,133,22,9,"PAH",4,1,1,0)="ES*1.0*20"
^DIC(9.4,133,22,9,"PAH",4,1,2,0)="Y2K Revisions - age calculation."
^DIC(9.4,133,22,9,"PAH",5,0)="23 SEQ #21^2980423^1"
^DIC(9.4,133,22,9,"PAH",5,1,0)="^^2^2^2980423"
^DIC(9.4,133,22,9,"PAH",5,1,1,0)="ES*1*23"
^DIC(9.4,133,22,9,"PAH",5,1,2,0)="Fix TIME2 variable in ESPAJE."
^DIC(9.4,133,22,9,"PAH",6,0)="15 SEQ #16^2960924^1"
^DIC(9.4,133,22,9,"PAH",7,0)="21 SEQ #22^2980604^1"
^DIC(9.4,133,22,9,"PAH",7,1,0)="^^1^1^2980604"
^DIC(9.4,133,22,9,"PAH",7,1,1,0)="Clean up NOIS issues."
^DIC(9.4,133,22,9,"PAH",8,0)="24 SEQ #23^2980712^1"
^DIC(9.4,133,22,9,"PAH",8,1,0)="^^1^1^2980712"
^DIC(9.4,133,22,9,"PAH",8,1,1,0)="Prevent negative time display for journal entry."
^DIC(9.4,133,22,9,"PAH",9,0)="25 SEQ #24^2980712^1"
^DIC(9.4,133,22,9,"PAH",9,1,0)="^^1^1^2980712"
^DIC(9.4,133,22,9,"PAH",9,1,1,0)="Patch to patch ES*1*21."
^DIC(9.4,133,22,9,"PAH",10,0)="22 SEQ #25^2980831^1"
^DIC(9.4,133,22,9,"PAH",10,1,0)="^^1^1^2980831"
^DIC(9.4,133,22,9,"PAH",10,1,1,0)="Increase felony theft threshold from $100 to $1000."
^DIC(9.4,133,22,9,"PAH",11,0)="26 SEQ #26^2990914^1"
^DIC(9.4,133,22,9,"PAH",11,1,0)="^^4^4^2990914"
^DIC(9.4,133,22,9,"PAH",11,1,1,0)=" This patch changes the Daily Operations Journal [ESP DAILY OPERATIONS "
^DIC(9.4,133,22,9,"PAH",11,1,2,0)=" JOURNAL].  In a NOIS message IND-1098-40335 it was reported that a blank"
^DIC(9.4,133,22,9,"PAH",11,1,3,0)=" page is always sent to the printer at the start of the report.  The"
^DIC(9.4,133,22,9,"PAH",11,1,4,0)=" routine ESPJOU has been modified to repair this defect."
^DIC(9.4,133,22,9,"PAH",12,0)="28 SEQ #27^3000405^1"
^DIC(9.4,133,22,9,"PAH",12,1,0)="^^6^6^3000405"
^DIC(9.4,133,22,9,"PAH",12,1,1,0)="This patch correct the problem that was created by patch ES*1*22.  The"
^DIC(9.4,133,22,9,"PAH",12,1,2,0)="problem that occurred was that the user was unable to press the ""^"" key"
^DIC(9.4,133,22,9,"PAH",12,1,3,0)="to exit the Print Conversion Report.  This patch also corrected a problem"
^DIC(9.4,133,22,9,"PAH",12,1,4,0)="that was reported by the test where if the report was sent to a slave"
^DIC(9.4,133,22,9,"PAH",12,1,5,0)="printer the screen would remain hung."
^DIC(9.4,133,22,9,"PAH",12,1,6,0)="The related NOIS to this patch is NYN-0898-11176."
^DIC(9.4,133,22,9,"PAH",13,0)="29 SEQ #28^3000405^1"
^DIC(9.4,133,22,9,"PAH",13,1,0)="^^6^6^3000405"
^DIC(9.4,133,22,9,"PAH",13,1,1,0)="The purpose of this patch is to correct the problem where the process"
^DIC(9.4,133,22,9,"PAH",13,1,2,0)="seems to hang after a Quick Name Check [ESP QUICK NAME] report is sent"
^DIC(9.4,133,22,9,"PAH",13,1,3,0)="to a slave printer. Though the process is not truly hung, the slave printer,"
^DIC(9.4,133,22,9,"PAH",13,1,4,0)="because it is not closed properly, continues to control the process after"
^DIC(9.4,133,22,9,"PAH",13,1,5,0)="the report is finished. This patch properly closes the output device and"
^DIC(9.4,133,22,9,"PAH",13,1,6,0)="returns control to the main routine upon the report having completed."
^DIC(9.4,133,22,9,"PAH",14,0)="31 SEQ #29^3000501^1"
^DIC(9.4,133,22,9,"PAH",15,0)="27 SEQ #30^3000724^1"
^DIC(9.4,133,22,9,"PAH",15,1,0)="^^1^1^3000724"
^DIC(9.4,133,22,9,"PAH",15,1,1,0)="Test build to make the Police Journal multidivsional for the NDBI software"
^DIC(9.4,133,22,9,"PAH",16,0)="36 SEQ #31^3030329^1"
^DIC(9.4,133,22,9,"PAH",17,0)="34 SEQ #32^3030912^1"
^DIC(9.4,133,22,9,"PAH",17,1,0)="^^1^1^3030912"
^DIC(9.4,133,22,9,"PAH",17,1,1,0)="Open evidence report printing out of sequence"
^DIC(9.4,133,22,9,"PAH",18,0)="33 SEQ #33^3031002^1"
^DIC(9.4,133,22,9,"PAH",18,1,0)="^^1^1^3031002"
^DIC(9.4,133,22,9,"PAH",18,1,1,0)="Problem with external to internal date conversion."
^DIC(9.4,133,22,9,"PAH",19,0)="37 SEQ #34^3031126^1"
^DIC(9.4,133,22,9,"PAH",19,1,0)="^^2^2^3031126"
^DIC(9.4,133,22,9,"PAH",19,1,1,0)="This patch will correct the problem of allowing incorrect journal dates "
^DIC(9.4,133,22,9,"PAH",19,1,2,0)="to be entered."
^DIC(9.4,133,22,9,"PAH",20,0)="39 SEQ #35^3040427^1"
^DIC(9.4,133,22,9,"PAH",20,1,0)="^^6^6^3040427"
^DIC(9.4,133,22,9,"PAH",20,1,1,0)="When going back and printing old journal entries and offense reports the "
^DIC(9.4,133,22,9,"PAH",20,1,2,0)="officers badges/rank are not correct for the timeframe.  Any officer that "
^DIC(9.4,133,22,9,"PAH",20,1,3,0)="has had a badge/rank change is causing the old reports to reflect their "
^DIC(9.4,133,22,9,"PAH",20,1,4,0)="current badge/rank and not the badge/rank at time of journal/offense data "
^DIC(9.4,133,22,9,"PAH",20,1,5,0)="entry.  This has raised concerns about legal issues for court/fraud "
^DIC(9.4,133,22,9,"PAH",20,1,6,0)="purposes."
^DIC(9.4,133,22,9,"PAH",21,0)="32 SEQ #36^3040521^1"
^DIC(9.4,133,22,9,"PAH",21,1,0)="^^1^1^3040521"
^DIC(9.4,133,22,9,"PAH",21,1,1,0)="TIME entry default not correct."
^DIC(9.4,133,22,9,"PAH",22,0)="35 SEQ #37^3040702^1"
^DIC(9.4,133,22,9,"PAH",22,1,0)="^^1^1^3040702"
^DIC(9.4,133,22,9,"PAH",22,1,1,0)="Sites are getting an undefined error when generating ESP FACILITY REPORTS."
^DIC(9.4,133,22,9,"PAH",23,0)="40 SEQ #38^3040802^1"
^DIC(9.4,133,22,9,"PAH",23,1,0)="^^2^2^3040802"
^DIC(9.4,133,22,9,"PAH",23,1,1,0)="This build will prevent the ability to delete open status Uniform Offense"
^DIC(9.4,133,22,9,"PAH",23,1,2,0)="Reports."
^DIC(9.4,133,22,9,"PAH",24,0)="43 SEQ #39^3040802^1"
^DIC(9.4,133,22,9,"PAH",24,1,0)="^^1^1^3040802"
^DIC(9.4,133,22,9,"PAH",24,1,1,0)="System skipping journal entries (time default)"
^DIC(9.4,133,22,9,"PAH",25,0)="41 SEQ #40^3040903^1"
^DIC(9.4,133,22,9,"PAH",25,1,0)="^^1^1^3040903"
^DIC(9.4,133,22,9,"PAH",25,1,1,0)="Police and Security Key violation + indentifying officers with same name"
^DIC(9.4,133,22,9,"PAH",26,0)="42 SEQ #41^3040903^1"
^DIC(9.4,133,22,9,"PAH",26,1,0)="^^7^7^3040903"
^DIC(9.4,133,22,9,"PAH",26,1,1,0)="Modify software to include 1st letter of first name and middle name"
^DIC(9.4,133,22,9,"PAH",26,1,2,0)="of officer of officer on the Daily Operations Journal, Case Assignment "
^DIC(9.4,133,22,9,"PAH",26,1,3,0)="Register and Offense Match Report."
^DIC(9.4,133,22,9,"PAH",26,1,4,0)=" "
^DIC(9.4,133,22,9,"PAH",26,1,5,0)="Also, remove the on screen initial page feeds from FOLLOW-UP ENTRY "
^DIC(9.4,133,22,9,"PAH",26,1,6,0)="ADD/EDIT, PRINT ANY FOLLOW UP NOTE, PRINT ANY OFFENSE REPORT and REVIEW "
^DIC(9.4,133,22,9,"PAH",26,1,7,0)="COMPLETED OFFENSE REPORT."
^DIC(9.4,133,22,9,"PAH",27,0)="44 SEQ #42^3070904.230559^1"
^DIC(9.4,133,22,9,"PAH",27,1,0)="^^6^6^3070904"
^DIC(9.4,133,22,9,"PAH",27,1,1,0)="1. Modify Violation Number field (.05) in file #914 from 6 to 7 digits."
^DIC(9.4,133,22,9,"PAH",27,1,2,0)=" "
^DIC(9.4,133,22,9,"PAH",27,1,3,0)="2. Conflict between Category and Status under Complainant portion of"
^DIC(9.4,133,22,9,"PAH",27,1,4,0)="   Offense Report. "
^DIC(9.4,133,22,9,"PAH",27,1,5,0)=" "
^DIC(9.4,133,22,9,"PAH",27,1,6,0)="3. ERROR - <UNDEFINED>S+14^DIC3"
^DIC(9.4,133,22,9,"PAH",28,0)="45 SEQ #43^3080526.153523^1"
^DIC(9.4,133,22,9,"PAH",28,1,0)="^^2^2^3080526"
^DIC(9.4,133,22,9,"PAH",28,1,1,0)="MODIFY ESPQNC TO QUIT WHEN AN ENTRY CONTAINS A ""^"" CHARACTER.  PREVENTING "
^DIC(9.4,133,22,9,"PAH",28,1,2,0)="AN UNDEFINED ERROR FROM OCCURING.  "
^DIC(9.4,133,22,9,"PAH",29,0)="46 SEQ #44^3091028.124231^17"
