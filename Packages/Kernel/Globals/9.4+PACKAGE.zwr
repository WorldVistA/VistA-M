^DIC(9.4,4,22,1,"PAH",78,1,33,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",78,1,34,0)=" "
^DIC(9.4,4,22,1,"PAH",78,1,35,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",78,1,36,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",78,1,37,0)="minimum.  It requires MailMan patch XM*7.1*50."
^DIC(9.4,4,22,1,"PAH",78,1,38,0)="1.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",78,1,39,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",78,1,40,0)="2.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",78,1,41,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",78,1,42,0)="3.  You do not need to stop TaskMan, but you should stop the background"
^DIC(9.4,4,22,1,"PAH",78,1,43,0)="    filer.  On the Manage MailMan:Local Delivery Management menu, use the"
^DIC(9.4,4,22,1,"PAH",78,1,44,0)="    following option to stop the background filer:"
^DIC(9.4,4,22,1,"PAH",78,1,45,0)="       STOP background filer"
^DIC(9.4,4,22,1,"PAH",78,1,46,0)="Are you sure you want the BACKGROUND FILERS to STOP delivering mail? NO// YES"
^DIC(9.4,4,22,1,"PAH",78,1,47,0)="                                                                          ==="
^DIC(9.4,4,22,1,"PAH",78,1,48,0)="<< Background filer will stop soon. >>"
^DIC(9.4,4,22,1,"PAH",78,1,49,0)="4.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",78,1,50,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",78,1,51,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",78,1,52,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",78,1,53,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",78,1,54,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",78,1,55,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",78,1,56,0)=" Select INSTALL NAME:    XM*7.1*106    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",78,1,57,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",78,1,58,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",78,1,59,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",78,1,60,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",78,1,61,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",78,1,62,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",78,1,63,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",78,1,64,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",78,1,65,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",78,1,66,0)=""
^DIC(9.4,4,22,1,"PAH",78,1,67,0)=" DEVICE: HOME// <Press Return>    <Do NOT queue it!>"
^DIC(9.4,4,22,1,"PAH",78,1,68,0)="                =============="
^DIC(9.4,4,22,1,"PAH",78,1,69,0)="5.  Start the background filer."
^DIC(9.4,4,22,1,"PAH",78,1,70,0)="    On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,1,"PAH",78,1,71,0)="    option to start the background filer:"
^DIC(9.4,4,22,1,"PAH",78,1,72,0)="       START background filer"
^DIC(9.4,4,22,1,"PAH",78,1,73,0)="<< Background filer will start soon. >>"
^DIC(9.4,4,22,1,"PAH",78,1,74,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",78,1,75,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",79,0)="108 SEQ #104^2991210^1"
^DIC(9.4,4,22,1,"PAH",79,1,0)="^^82^82^2991210"
^DIC(9.4,4,22,1,"PAH",79,1,1,0)="Patch XM*7.1*108"
^DIC(9.4,4,22,1,"PAH",79,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",79,1,3,0)="Y2K Waiver Request ID#:  Y2KW0001        Y2K Waiver Status: Approved"
^DIC(9.4,4,22,1,"PAH",79,1,4,0)="This patch may be installed during the Y2K Moratorium, either BEFORE 12/15/99"
^DIC(9.4,4,22,1,"PAH",79,1,5,0)="or AFTER 1/15/2000. This patch MAY NOT be installed between 12/15/1999 and"
^DIC(9.4,4,22,1,"PAH",79,1,6,0)="1/15/2000 (the Y2K Lockdown Period). "
^DIC(9.4,4,22,1,"PAH",79,1,7,0)=""
^DIC(9.4,4,22,1,"PAH",79,1,8,0)="NOIS:  FAV-1199-72207"
^DIC(9.4,4,22,1,"PAH",79,1,9,0)="Test Site:  Fayetteville, AR"
^DIC(9.4,4,22,1,"PAH",79,1,10,0)=""
^DIC(9.4,4,22,1,"PAH",79,1,11,0)="Adds more checks to the MailMan global integrity checking routines:"
^DIC(9.4,4,22,1,"PAH",79,1,12,0)="- makes sure every IEN in the Message file is a number"
^DIC(9.4,4,22,1,"PAH",79,1,13,0)="- makes sure no recipient in the Message file is null."
^DIC(9.4,4,22,1,"PAH",79,1,14,0)="- makes sure there isn't more than one B xref per basket in the Mailbox file"
^DIC(9.4,4,22,1,"PAH",79,1,15,0)="- makes sure messages in the WASTE basket aren't new"
^DIC(9.4,4,22,1,"PAH",79,1,16,0)="- makes sure the names of the IN and WASTE baskets haven't been changed"
^DIC(9.4,4,22,1,"PAH",79,1,17,0)=""
^DIC(9.4,4,22,1,"PAH",79,1,18,0)="NOIS:  none"
^DIC(9.4,4,22,1,"PAH",79,1,19,0)="Test Site:  Indianapolis, IN"
^DIC(9.4,4,22,1,"PAH",79,1,20,0)=""
^DIC(9.4,4,22,1,"PAH",79,1,21,0)="The API, LISTMSGS^XMXAPIB, may incorrectly state whether there are more"
^DIC(9.4,4,22,1,"PAH",79,1,22,0)="messages in the list.  This patch fixes that."
^DIC(9.4,4,22,1,"PAH",79,1,23,0)=""
^DIC(9.4,4,22,1,"PAH",79,1,24,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",79,1,25,0)="minimum.  It requires MailMan patches XM*7.1*50 and XM*7.1*74."
^DIC(9.4,4,22,1,"PAH",79,1,26,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",79,1,27,0)=""
^DIC(9.4,4,22,1,"PAH",79,1,28,0)="ROUTINES:"
