^DIC(9.4,100,22,15,"PAH",31,1,292,0)="."
^DIC(9.4,100,22,15,"PAH",31,1,293,0)="YSDATA(6950)=[BEGIN ITEM]"
^DIC(9.4,100,22,15,"PAH",31,1,294,0)="YSDATA(6951)=MMPI2^567"
^DIC(9.4,100,22,15,"PAH",31,1,295,0)="YSDATA(6952)=[INTRO]"
^DIC(9.4,100,22,15,"PAH",31,1,296,0)="YSDATA(6953)=[TEXT]"
^DIC(9.4,100,22,15,"PAH",31,1,297,0)="YSDATA(6954)=Most married couples don't show much affection for each other."
^DIC(9.4,100,22,15,"PAH",31,1,298,0)="YSDATA(6955)=[BOTTOM]"
^DIC(9.4,100,22,15,"PAH",31,1,299,0)="YSDATA(6956)=T= True"
^DIC(9.4,100,22,15,"PAH",31,1,300,0)="YSDATA(6957)=F= False"
^DIC(9.4,100,22,15,"PAH",31,1,301,0)="YSDATA(6958)=Answer= "
^DIC(9.4,100,22,15,"PAH",31,1,302,0)="YSDATA(6959)=[RESPONSE]"
^DIC(9.4,100,22,15,"PAH",31,1,303,0)="YSDATA(6960)=TFX"
^DIC(9.4,100,22,15,"PAH",31,1,304,0)="YSDATA(6961)=[END ITEM]"
^DIC(9.4,100,22,15,"PAH",31,1,305,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,306,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,307,0)="7. GAFHX"
^DIC(9.4,100,22,15,"PAH",31,1,308,0)="     RPC: YS GAF API"
^DIC(9.4,100,22,15,"PAH",31,1,309,0)="       M: GAFHX^YSGAFAPI"
^DIC(9.4,100,22,15,"PAH",31,1,310,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,311,0)="This API returns the GAF scores for a specified patient. It can be "
^DIC(9.4,100,22,15,"PAH",31,1,312,0)="constrained by both date range and occurrence limit. Please note that data "
^DIC(9.4,100,22,15,"PAH",31,1,313,0)="for this API comes from the DIAGNOSTIC RESULTS - MENTAL HEALTH file (#627.8)."
^DIC(9.4,100,22,15,"PAH",31,1,314,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,315,0)="Input: "
^DIC(9.4,100,22,15,"PAH",31,1,316,0)="      DFN: Patient internal identifier"
^DIC(9.4,100,22,15,"PAH",31,1,317,0)="    BEGIN: Inclusive date in %DT acceptable format (11/11/2011) "
^DIC(9.4,100,22,15,"PAH",31,1,318,0)="           to begin search [optional]"
^DIC(9.4,100,22,15,"PAH",31,1,319,0)="      END: Inclusive date in %DT acceptable format (11/11/2011) "
^DIC(9.4,100,22,15,"PAH",31,1,320,0)="           to end search  [optional]"
^DIC(9.4,100,22,15,"PAH",31,1,321,0)="    LIMIT: Constrains to the last N diagnoses [optional]"
^DIC(9.4,100,22,15,"PAH",31,1,322,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,323,0)="Output:"
^DIC(9.4,100,22,15,"PAH",31,1,324,0)="Array(1)=[DATA] ;indicates successful  call"
^DIC(9.4,100,22,15,"PAH",31,1,325,0)="Array(1)=GAF Score^Internal Date^External Date^Provider^Comment"
^DIC(9.4,100,22,15,"PAH",31,1,326,0)="."
^DIC(9.4,100,22,15,"PAH",31,1,327,0)="."
^DIC(9.4,100,22,15,"PAH",31,1,328,0)="Array(N)=GAF Score^Internal Date^External Date^Provider^Comment"
^DIC(9.4,100,22,15,"PAH",31,1,329,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,330,0)="Example:"
^DIC(9.4,100,22,15,"PAH",31,1,331,0)="Input"
^DIC(9.4,100,22,15,"PAH",31,1,332,0)="-----"
^DIC(9.4,100,22,15,"PAH",31,1,333,0)="YS(""DFN"")=29601"
^DIC(9.4,100,22,15,"PAH",31,1,334,0)="YS(""LIMIT"")=3"
^DIC(9.4,100,22,15,"PAH",31,1,335,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,336,0)="Output"
^DIC(9.4,100,22,15,"PAH",31,1,337,0)="------"
^DIC(9.4,100,22,15,"PAH",31,1,338,0)="YSDATA(1)=[DATA]"
^DIC(9.4,100,22,15,"PAH",31,1,339,0)="YSDATA(2)=100^2981209.1105^12/09/1998@11:05^DEVLIN,MARK^"
^DIC(9.4,100,22,15,"PAH",31,1,340,0)="YSDATA(3)=99^2981209.092^12/09/1998@09:20^DEVLIN,MARK^"
^DIC(9.4,100,22,15,"PAH",31,1,341,0)="YSDATA(4)=66^2981124.1406^11/24/1998@14:06^DEVLIN,MARK^"
^DIC(9.4,100,22,15,"PAH",31,1,342,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,343,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,344,0)="  Associated NOIS:   None"
^DIC(9.4,100,22,15,"PAH",31,1,345,0)="   "
^DIC(9.4,100,22,15,"PAH",31,1,346,0)="     Test Site(s):   Bay Pines Test LAB"
^DIC(9.4,100,22,15,"PAH",31,1,347,0)="                     Tuscaloosa, AL"
^DIC(9.4,100,22,15,"PAH",31,1,348,0)="                     West Palm Beach, FL"
^DIC(9.4,100,22,15,"PAH",31,1,349,0)="                     "
