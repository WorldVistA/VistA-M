^DIC(9.4,43,22,1,"PAH",7,1,10,0)="If they are using any application which uses List Manager (e.g. CPRS,"
^DIC(9.4,43,22,1,"PAH",7,1,11,0)="Outpatient Pharmacy, Appointment Management), they may experience a Clobber"
^DIC(9.4,43,22,1,"PAH",7,1,12,0)="Error.  This patch requires patch VALM*1.0*6."
^DIC(9.4,43,22,1,"PAH",7,1,13,0)="============================================================================ "
