^DIC(9.4,85,22,1.5,"PAH",4,1,9,0)=" "
^DIC(9.4,85,22,1.5,"PAH",4,1,10,0)=" "
^DIC(9.4,85,22,1.5,"PAH",4,1,11,0)=" Description:"
^DIC(9.4,85,22,1.5,"PAH",4,1,12,0)=" ============"
^DIC(9.4,85,22,1.5,"PAH",4,1,13,0)="    NOIS: ISA-0700-12514, NOL-0700-72818"
^DIC(9.4,85,22,1.5,"PAH",4,1,14,0)=" "
^DIC(9.4,85,22,1.5,"PAH",4,1,15,0)="        Sites had reported that PDX is generating error"
^DIC(9.4,85,22,1.5,"PAH",4,1,16,0)="    messages because of unable to find the correct"
^DIC(9.4,85,22,1.5,"PAH",4,1,17,0)="    Domain name from the Domain file.  The problem that"
^DIC(9.4,85,22,1.5,"PAH",4,1,18,0)="    is causing this is that the pointer is using B"
^DIC(9.4,85,22,1.5,"PAH",4,1,19,0)="    cross reference.  Routines are modified to point at"
^DIC(9.4,85,22,1.5,"PAH",4,1,20,0)="    C cross reference."
^DIC(9.4,85,22,1.5,"PAH",4,1,21,0)=" "
