^DIC(9.4,42,22,7,"PAH",103,1,47,0)="Documentation Retrieval Instructions:"
^DIC(9.4,42,22,7,"PAH",103,1,48,0)="------------------------------------- "
^DIC(9.4,42,22,7,"PAH",103,1,49,0)="Documentation can also be found on the VA Software Documentation Library "
^DIC(9.4,42,22,7,"PAH",103,1,50,0)="at:"
^DIC(9.4,42,22,7,"PAH",103,1,51,0)="http://www4.domain.ext/vdl/"
