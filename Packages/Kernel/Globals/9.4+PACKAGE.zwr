^DIC(9.4,72,0)="RECORD TRACKING^RT^Medical Records and Film Jacket Tracking"
^DIC(9.4,72,1,0)="^^3^3^2911022^^^^"
^DIC(9.4,72,1,1,0)="This package is mainly used for medical records tracking and film"
^DIC(9.4,72,1,2,0)="jacket tracking. However, it is design to be used to track most"
^DIC(9.4,72,1,3,0)="any kind of record, such as dental."
