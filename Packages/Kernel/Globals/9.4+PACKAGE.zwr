^DIC(9.4,53,22,20,"PAH",11,0)="55 SEQ #42^2961104^1"
^DIC(9.4,53,22,20,"PAH",11,1,0)="^^1^1^2961104"
^DIC(9.4,53,22,20,"PAH",11,1,1,0)="DSM-E-LEVEL ERROR IN PRCARFD"
^DIC(9.4,53,22,20,"PAH",12,0)="62 SEQ #43^2961116^1"
^DIC(9.4,53,22,20,"PAH",12,1,0)="^^4^4^2961116"
^DIC(9.4,53,22,20,"PAH",12,1,1,0)="Because of a recent general counsel decision, the IRS offset sotware is"
^DIC(9.4,53,22,20,"PAH",12,1,2,0)="being modified to remove all bills, for which the patient has reimbursable"
^DIC(9.4,53,22,20,"PAH",12,1,3,0)="insurance.  A screen has been added in routine PRCAOFF2 to accomplish"
^DIC(9.4,53,22,20,"PAH",12,1,4,0)="this."
^DIC(9.4,53,22,20,"PAH",13,0)="59 SEQ #44^2961207^1"
^DIC(9.4,53,22,20,"PAH",13,1,0)="^^2^2^2961207"
^DIC(9.4,53,22,20,"PAH",13,1,1,0)=" "
^DIC(9.4,53,22,20,"PAH",13,1,2,0)="routine for joint inquiry fix"
^DIC(9.4,53,22,20,"PAH",14,0)="54 SEQ #45^2961224^1"
^DIC(9.4,53,22,20,"PAH",14,1,0)="^^2^2^2961224"
^DIC(9.4,53,22,20,"PAH",14,1,1,0)="This is patch 54, which is a patch to correct a problem encountered with"
^DIC(9.4,53,22,20,"PAH",14,1,2,0)="patch 43, when test data was inadvertantly sent with the patch."
^DIC(9.4,53,22,20,"PAH",15,0)="53 SEQ #46^2961224^1"
^DIC(9.4,53,22,20,"PAH",16,0)="57 SEQ #47^2970204^1"
^DIC(9.4,53,22,20,"PAH",16,1,0)="^^1^1^2970204"
^DIC(9.4,53,22,20,"PAH",16,1,1,0)="Bill of Collection with Multiple Fiscal Years"
^DIC(9.4,53,22,20,"PAH",17,0)="34 SEQ #48^2970217^1"
^DIC(9.4,53,22,20,"PAH",17,1,0)="^^1^1^2970217"
^DIC(9.4,53,22,20,"PAH",17,1,1,0)="CCPC patient statements"
^DIC(9.4,53,22,20,"PAH",18,0)="56 SEQ #49^2970221^1"
^DIC(9.4,53,22,20,"PAH",18,1,0)="^^1^1^2970221"
^DIC(9.4,53,22,20,"PAH",18,1,1,0)="DD changes required for PRCA*4.5*56"
^DIC(9.4,53,22,20,"PAH",19,0)="60 SEQ #50^2970307^1"
^DIC(9.4,53,22,20,"PAH",19,1,0)="^^3^3^2970307"
^DIC(9.4,53,22,20,"PAH",19,1,1,0)=" After installing this patch the system will correctly determine whether a"
^DIC(9.4,53,22,20,"PAH",19,1,2,0)=" Workman's Comp bill is summary or detail when there is no value in the"
^DIC(9.4,53,22,20,"PAH",19,1,3,0)=" FUND field."
^DIC(9.4,53,22,20,"PAH",20,0)="51^2970312^1"
