^DIC(9.4,101,22,6,"PAH",63,1,1,0)="See the patch description on Forum for a complete description of this patch."
^DIC(9.4,101,22,6,"PAH",64,0)="82 SEQ #79^3031023^1"
^DIC(9.4,101,22,6,"PAH",64,1,0)="^^5^5^3031023"
^DIC(9.4,101,22,6,"PAH",64,1,1,0)="This patch adds all of the necessary changes to the VistA PAID/ETA software to"
^DIC(9.4,101,22,6,"PAH",64,1,2,0)="be in compliance with Central PAID Service Request 02-485 PAID LABOR"
^DIC(9.4,101,22,6,"PAH",64,1,3,0)="DISTRIBUTION AND ACCOUNTING CHANGES and Service Request 03-623 VistA/DHCP ETA"
^DIC(9.4,101,22,6,"PAH",64,1,4,0)="DOWNLOAD CONSOLIDATION.  Please see the patch description on FORUM for complete"
^DIC(9.4,101,22,6,"PAH",64,1,5,0)="details of these changes."
^DIC(9.4,101,22,6,"PAH",65,0)="88 SEQ #80^3031231^1"
