^DIC(9.4,100,22,15,"PAH",73,1,37,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,38,0)="New Service Requests (NSRs):"
^DIC(9.4,100,22,15,"PAH",73,1,39,0)="----------------------------"
^DIC(9.4,100,22,15,"PAH",73,1,40,0)="NSR #20150509: Posttraumatic Stress Disorder (PTSD) Checklist 5 (PCL-5) "
^DIC(9.4,100,22,15,"PAH",73,1,41,0)="and Mental Health Assistant Stabilization (MHAS) "
^DIC(9.4,100,22,15,"PAH",73,1,42,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,43,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,100,22,15,"PAH",73,1,44,0)="-----------------------------"
^DIC(9.4,100,22,15,"PAH",73,1,45,0)="PSPO 2497: Mental health instruments that use a complex scoring algorithm "
^DIC(9.4,100,22,15,"PAH",73,1,46,0)="display an incorrect score when used in Health Summary and Clinical "
^DIC(9.4,100,22,15,"PAH",73,1,47,0)="Reminders. "
^DIC(9.4,100,22,15,"PAH",73,1,48,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,49,0)="Remedy Ticket(s) & Overview:"
^DIC(9.4,100,22,15,"PAH",73,1,50,0)="----------------------------"
^DIC(9.4,100,22,15,"PAH",73,1,51,0)="HD0000000391317 - Error Evaluating Clinical Reminder - local GAF reminder"
^DIC(9.4,100,22,15,"PAH",73,1,52,0)="Problem: In some instances, a utility in the YTQPXRM2 routine errors out"
^DIC(9.4,100,22,15,"PAH",73,1,53,0)="when evaluating a GAF clinical reminder because the time portion of the"
^DIC(9.4,100,22,15,"PAH",73,1,54,0)="date/time lookup value has trailing zeros."
^DIC(9.4,100,22,15,"PAH",73,1,55,0)="Solution: The patch modifies the routine to strip off the trailing zeros ."
^DIC(9.4,100,22,15,"PAH",73,1,56,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,57,0)="HD0000000807935 - Mental Health - MH Tests (excluding ASI) "
^DIC(9.4,100,22,15,"PAH",73,1,58,0)="Problem: The scoring criteria for the MCMI3 instrument changed since it "
^DIC(9.4,100,22,15,"PAH",73,1,59,0)="was first released."
^DIC(9.4,100,22,15,"PAH",73,1,60,0)="Solution: The scoring criteria are updated."
^DIC(9.4,100,22,15,"PAH",73,1,61,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,62,0)="HD0000000922629 - Mental Health - Mental Health Assistant: scoring error "
^DIC(9.4,100,22,15,"PAH",73,1,63,0)="MoCA, MoCA Alt1, and MoCA Alt2"
^DIC(9.4,100,22,15,"PAH",73,1,64,0)="HD0000000938421 - Mental Health - Mental Health Assistant"
^DIC(9.4,100,22,15,"PAH",73,1,65,0)="HD0000000964555 - MOCA calculation is off"
^DIC(9.4,100,22,15,"PAH",73,1,66,0)="Problem: There is an error in the way three instruments, MOCA, MOCA ALT1 "
^DIC(9.4,100,22,15,"PAH",73,1,67,0)="and MOCA ALT 2 are scored."
^DIC(9.4,100,22,15,"PAH",73,1,68,0)="Solution: The scoring error is fixed for all three instruments . "
^DIC(9.4,100,22,15,"PAH",73,1,69,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,70,0)="HD0000000939794 - Mental Health - Mental Health Assistant"
^DIC(9.4,100,22,15,"PAH",73,1,71,0)="Problem: There is a scoring error in the BAI instrument. There is a MH "
^DIC(9.4,100,22,15,"PAH",73,1,72,0)="SCALES (#601.87) file entry associated with this instrument that should"
^DIC(9.4,100,22,15,"PAH",73,1,73,0)="not be."
^DIC(9.4,100,22,15,"PAH",73,1,74,0)="Solution: That entry is no longer associated with the instrument."
^DIC(9.4,100,22,15,"PAH",73,1,75,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,76,0)="INC000000616128 - Mental Health - Error Generating Report"
^DIC(9.4,100,22,15,"PAH",73,1,77,0)="Problem: There is an error when generating a report for an administration "
^DIC(9.4,100,22,15,"PAH",73,1,78,0)="that doesn't exist."
^DIC(9.4,100,22,15,"PAH",73,1,79,0)="Solution: Quit before generating the report if an instrument "
^DIC(9.4,100,22,15,"PAH",73,1,80,0)="administration is not found."
^DIC(9.4,100,22,15,"PAH",73,1,81,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,82,0)="Test Sites:"
^DIC(9.4,100,22,15,"PAH",73,1,83,0)="----------"
^DIC(9.4,100,22,15,"PAH",73,1,84,0)="TBD"
^DIC(9.4,100,22,15,"PAH",73,1,85,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,86,0)="Software and Documentation Retrieval Instructions:"
^DIC(9.4,100,22,15,"PAH",73,1,87,0)="---------------------------------------------------- "
^DIC(9.4,100,22,15,"PAH",73,1,88,0)="This patch is being distributed as a host file.  The name of the host "
^DIC(9.4,100,22,15,"PAH",73,1,89,0)="file is YS_PCL5_UPDATE.KID.  This file should be downloaded in ASCII "
^DIC(9.4,100,22,15,"PAH",73,1,90,0)="format."
^DIC(9.4,100,22,15,"PAH",73,1,91,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,92,0)="The preferred method is to retrieve files from:"
^DIC(9.4,100,22,15,"PAH",73,1,93,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,94,0)="    download.vista.domain.ext."
^DIC(9.4,100,22,15,"PAH",73,1,95,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,96,0)="This transmits the files from the first available server. Sites may"
^DIC(9.4,100,22,15,"PAH",73,1,97,0)="also elect to retrieve files directly from a specific server."
^DIC(9.4,100,22,15,"PAH",73,1,98,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,99,0)="Sites may retrieve the software and install guide directly using Secure"
^DIC(9.4,100,22,15,"PAH",73,1,100,0)="File Transfer Protocol (SFTP) from the ANONYMOUS.SOFTWARE directory at "
^DIC(9.4,100,22,15,"PAH",73,1,101,0)="the following OI Field Offices:"
^DIC(9.4,100,22,15,"PAH",73,1,102,0)="   "
^DIC(9.4,100,22,15,"PAH",73,1,103,0)="Albany:                 fo-albany.domain.ext"
^DIC(9.4,100,22,15,"PAH",73,1,104,0)="Hines:                  fo-hines.domain.ext    "
^DIC(9.4,100,22,15,"PAH",73,1,105,0)="Salt Lake City:         fo-slc.domain.ext"
^DIC(9.4,100,22,15,"PAH",73,1,106,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,107,0)="The Install Guide is also available on the above servers.  It is "
^DIC(9.4,100,22,15,"PAH",73,1,108,0)="available as .PDF format.  This file should be downloaded in BINARY "
^DIC(9.4,100,22,15,"PAH",73,1,109,0)="format.  "
^DIC(9.4,100,22,15,"PAH",73,1,110,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,111,0)="    File Name:              Description:                  Protocol"
^DIC(9.4,100,22,15,"PAH",73,1,112,0)="    ==========              ============                  ========="
^DIC(9.4,100,22,15,"PAH",73,1,113,0)="    YS_PCL5_UPDATE.PDF      PCL-5 Update Install Guide    BINARY"
^DIC(9.4,100,22,15,"PAH",73,1,114,0)="    YS_PCL5_UPDATE.KID      PCL-5 Update Host File        ASCII"
^DIC(9.4,100,22,15,"PAH",73,1,115,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,116,0)="Documentation can also be found on the VA Software Documentation "
^DIC(9.4,100,22,15,"PAH",73,1,117,0)="Library at:  http://www4.domain.ext/vdl/"
^DIC(9.4,100,22,15,"PAH",73,1,118,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,119,0)="Installation:"
^DIC(9.4,100,22,15,"PAH",73,1,120,0)="============="
^DIC(9.4,100,22,15,"PAH",73,1,121,0)="This patch can be loaded with users on the system.  Installation will "
^DIC(9.4,100,22,15,"PAH",73,1,122,0)="take five minutes.  Refer to the Install Guide, YS_PCL5_UPDATE.PDF, "
^DIC(9.4,100,22,15,"PAH",73,1,123,0)="for complete details."
^DIC(9.4,100,22,15,"PAH",73,1,124,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,125,0)="1.  Use the ""Load a Distribution"" option on the KIDS installation menu. "
^DIC(9.4,100,22,15,"PAH",73,1,126,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,127,0)="    When prompted to enter a host file, type in YS_PCL5_UPDATE.KID"
^DIC(9.4,100,22,15,"PAH",73,1,128,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,129,0)="2.  On the KIDS menu under the 'INSTALLATION' menu, use the following "
^DIC(9.4,100,22,15,"PAH",73,1,130,0)="    options, as desired:"
^DIC(9.4,100,22,15,"PAH",73,1,131,0)="        Print Transport Global"
^DIC(9.4,100,22,15,"PAH",73,1,132,0)="        Compare Transport Global to Current System"
^DIC(9.4,100,22,15,"PAH",73,1,133,0)="        Verify checksums in Transport Global"
^DIC(9.4,100,22,15,"PAH",73,1,134,0)="        Backup a Transport Global"
^DIC(9.4,100,22,15,"PAH",73,1,135,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,136,0)="3.  On the KIDS menu under the 'INSTALLATION' menu, use the following "
^DIC(9.4,100,22,15,"PAH",73,1,137,0)="    option to install the patch:"
^DIC(9.4,100,22,15,"PAH",73,1,138,0)="        Install Package(s)"
^DIC(9.4,100,22,15,"PAH",73,1,139,0)="           When prompted for INSTALL NAME, use YS_PCL5_UPDATE"
^DIC(9.4,100,22,15,"PAH",73,1,140,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,141,0)="4.  When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,100,22,15,"PAH",73,1,142,0)="    Install? NO//' enter NO.     "
^DIC(9.4,100,22,15,"PAH",73,1,143,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,144,0)="5.  When prompted 'Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,100,22,15,"PAH",73,1,145,0)="    NO//' enter NO."
^DIC(9.4,100,22,15,"PAH",73,1,146,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,147,0)="6.  When prompted 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,100,22,15,"PAH",73,1,148,0)="    and Protocols? NO//' enter NO. "
^DIC(9.4,100,22,15,"PAH",73,1,149,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,150,0)="7.  If prompted 'Delay Install (Minutes):  (0 - 60): 0//' respond 0."
^DIC(9.4,100,22,15,"PAH",73,1,151,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,152,0)=" "
^DIC(9.4,100,22,15,"PAH",73,1,153,0)="Post-Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",73,1,154,0)="-------------------------------"
^DIC(9.4,100,22,15,"PAH",73,1,155,0)="N/A"
^DIC(9.4,100,22,15,"PAH",74,0)="131 SEQ #98^3171005.140455^54"
^DIC(9.4,100,22,15,"PAH",74,1,0)="^^2^2^3171005"
^DIC(9.4,100,22,15,"PAH",74,1,1,0)="PATCH YS*5.01*131 ADDRESSES THE FOLLOWING:"
^DIC(9.4,100,22,15,"PAH",74,1,2,0)="1. R14616270FY17 - CIWA question number 11 for headache not totaling."
^DIC(9.4,100,22,15,"PAH",75,0)="128^3171127.135526^54"
^DIC(9.4,100,22,15,"PAH",76,0)="121 SEQ #100^3180601.134759^54"
^DIC(9.4,100,22,15,"PAH",76,1,0)="^^15^15^3180601"
^DIC(9.4,100,22,15,"PAH",76,1,1,0)="See the patch description for more detailed information.  This build "
^DIC(9.4,100,22,15,"PAH",76,1,2,0)="makes the following changes for Mental Health Assistant."
^DIC(9.4,100,22,15,"PAH",76,1,3,0)=" "
^DIC(9.4,100,22,15,"PAH",76,1,4,0)="The following new tests are added:  ASSIST-NIDA, BRS, CCSA-DSM5, CEMI, "
^DIC(9.4,100,22,15,"PAH",76,1,5,0)="CIWA-AR-, CSI, CSI-4, CSI PARTNER VERSION, CSI-4 PARTNER VERSION, GAI,"
^DIC(9.4,100,22,15,"PAH",76,1,6,0)="ISI, KTAZ-ADL-6pt, PSOCQ, PSS, RLS, SMEQ, SNQ, STOP."
^DIC(9.4,100,22,15,"PAH",76,1,7,0)=" "
^DIC(9.4,100,22,15,"PAH",76,1,8,0)="The following tests are retired:  CIWA-AR, AUIR, CESD5, DOM80, DOMG, ERS, "
^DIC(9.4,100,22,15,"PAH",76,1,9,0)="HLOC, IEQ, RLOC, SAI, SDES, SMAST, VALD, WAS."
^DIC(9.4,100,22,15,"PAH",76,1,10,0)=" "
^DIC(9.4,100,22,15,"PAH",76,1,11,0)="ASSIST is renamed to ASSIST-WHOv3."
^DIC(9.4,100,22,15,"PAH",76,1,12,0)="INDEX OF ASL is renamed to KATZ-ADL-18pt."
^DIC(9.4,100,22,15,"PAH",76,1,13,0)=" "
^DIC(9.4,100,22,15,"PAH",76,1,14,0)="PHQ9 has an updated report."
^DIC(9.4,100,22,15,"PAH",76,1,15,0)="WAI-SR has corrections to scoring."
^DIC(9.4,100,22,15,"PAH",77,0)="129 SEQ #101^3180601.135141^54"
^DIC(9.4,100,22,15,"PAH",77,1,0)="^^21^21^3180601"
^DIC(9.4,100,22,15,"PAH",77,1,1,0)="See the patch description for more detailed information.  This build"
^DIC(9.4,100,22,15,"PAH",77,1,2,0)="makes the following changes for the Mental Health Assistant (MHA)."
^DIC(9.4,100,22,15,"PAH",77,1,3,0)=" "
^DIC(9.4,100,22,15,"PAH",77,1,4,0)="The Two Factor Authentication is implemented."
^DIC(9.4,100,22,15,"PAH",77,1,5,0)=" "
^DIC(9.4,100,22,15,"PAH",77,1,6,0)="The Global Assessment of Functioning Manager (GAF) functionality is "
^DIC(9.4,100,22,15,"PAH",77,1,7,0)="removed."
^DIC(9.4,100,22,15,"PAH",77,1,8,0)=" "
^DIC(9.4,100,22,15,"PAH",77,1,9,0)="Modifications were made to the Delphi code to migrate MHA from Delphi 7 "
^DIC(9.4,100,22,15,"PAH",77,1,10,0)="to XE8."
^DIC(9.4,100,22,15,"PAH",77,1,11,0)="  "
^DIC(9.4,100,22,15,"PAH",77,1,12,0)="The following tests were retired:  AUIR, CESD5, DOM80, DOMG, ERS, HLOC,"
^DIC(9.4,100,22,15,"PAH",77,1,13,0)="IEQ, RLOC, SAI, SDES, SMAST, VALD, WAS."
^DIC(9.4,100,22,15,"PAH",77,1,14,0)=" "
^DIC(9.4,100,22,15,"PAH",77,1,15,0)="Data validation was implemented for the Instrument Date of Administration "
^DIC(9.4,100,22,15,"PAH",77,1,16,0)="to prevent dates more than 1 year in the past from being entered."
^DIC(9.4,100,22,15,"PAH",77,1,17,0)=" "
^DIC(9.4,100,22,15,"PAH",77,1,18,0)="The PCL-5 was modified so that it can be used on the Special Results tab "
^DIC(9.4,100,22,15,"PAH",77,1,19,0)="in the Instrument Results module."
^DIC(9.4,100,22,15,"PAH",77,1,20,0)=" "
^DIC(9.4,100,22,15,"PAH",77,1,21,0)="Several deficiencies and Remedy tickets were addressed."
^DIC(9.4,100,22,15,"PAH",78,0)="117 SEQ #102^3180706.124155^54"
^DIC(9.4,100,22,15,"PAH",79,0)="134 SEQ #103^3180907.12172^54"
^DIC(9.4,100,22,15,"PAH",79,1,0)="^^2^2^3180907"
^DIC(9.4,100,22,15,"PAH",79,1,1,0)="See the patch description for more detailed information.  This build "
^DIC(9.4,100,22,15,"PAH",79,1,2,0)="makes the following changes for Mental Health Assistant."
^DIC(9.4,100,22,15,"PAH",80,0)="136 SEQ #104^3181206.160335^54"
^DIC(9.4,100,22,15,"PAH",80,1,0)="^^10^10^3181206"
^DIC(9.4,100,22,15,"PAH",80,1,1,0)="See the patch description for more detailed information.  This build "
^DIC(9.4,100,22,15,"PAH",80,1,2,0)="makes the following changes for Mental Health Assistant."
^DIC(9.4,100,22,15,"PAH",80,1,3,0)="This patch contains 6 new instruments:"
^DIC(9.4,100,22,15,"PAH",80,1,4,0)=" "
^DIC(9.4,100,22,15,"PAH",80,1,5,0)="BPRS-A"
^DIC(9.4,100,22,15,"PAH",80,1,6,0)="PSS-3 2ND"
^DIC(9.4,100,22,15,"PAH",80,1,7,0)="PCL-5 Weekly"
^DIC(9.4,100,22,15,"PAH",80,1,8,0)="WEMWBS"
^DIC(9.4,100,22,15,"PAH",80,1,9,0)="HSI"
^DIC(9.4,100,22,15,"PAH",80,1,10,0)="MHRM"
^DIC(9.4,100,22,15,"PAH",81,0)="123 SEQ #105^3190305.144642^54"
^DIC(9.4,100,22,15,"PAH",81,1,0)="^^24^24^3190305"
^DIC(9.4,100,22,15,"PAH",81,1,1,0)="See the patch description for more detailed information.  This build "
^DIC(9.4,100,22,15,"PAH",81,1,2,0)="makes the following changes for Mental Health Assistant (MHA)."
^DIC(9.4,100,22,15,"PAH",81,1,3,0)=" "
^DIC(9.4,100,22,15,"PAH",81,1,4,0)="MHA is moving the scoring logic for instruments from the YS_MHA_AUX.dll "
^DIC(9.4,100,22,15,"PAH",81,1,5,0)="to the M server side.  This patch converts the following instruments  "
^DIC(9.4,100,22,15,"PAH",81,1,6,0)="from scoring in the DLL to M: AUDC, BAI, BAM-C, BAM-R, BASIS-24, BDI2, "
^DIC(9.4,100,22,15,"PAH",81,1,7,0)="BHS, BSS (formerly BSI), CDR, CEMI, FAST, ISMI, MINICOG, MMPI-2-RF,"
^DIC(9.4,100,22,15,"PAH",81,1,8,0)="NEOP-I-3, PC PTSD, PHQ-2, POQ, QOLI, STMS, VR-12, WHODAS 2, and WHYMPI."
^DIC(9.4,100,22,15,"PAH",81,1,9,0)=" "
^DIC(9.4,100,22,15,"PAH",81,1,10,0)="MHA now stores scale scores for all instruments in the MH RESULTS file. "
^DIC(9.4,100,22,15,"PAH",81,1,11,0)="Additionally, should an instrument need to be rescored for any reason, "
^DIC(9.4,100,22,15,"PAH",81,1,12,0)="there has been functionality added to maintain an audit for previous "
^DIC(9.4,100,22,15,"PAH",81,1,13,0)="scores."
^DIC(9.4,100,22,15,"PAH",81,1,14,0)=" "
^DIC(9.4,100,22,15,"PAH",81,1,15,0)="The BSI was renamed to the BSS.  Additional modifications were made"
^DIC(9.4,100,22,15,"PAH",81,1,16,0)="and can be found in the patch."
^DIC(9.4,100,22,15,"PAH",81,1,17,0)=" "
^DIC(9.4,100,22,15,"PAH",81,1,18,0)="The responses for Question 7 in the VR-12 were corrected."
^DIC(9.4,100,22,15,"PAH",81,1,19,0)=" "
^DIC(9.4,100,22,15,"PAH",81,1,20,0)="The Progress Note was modified to remove extra linefeeds when multiple"
^DIC(9.4,100,22,15,"PAH",81,1,21,0)="instruments were administered."
^DIC(9.4,100,22,15,"PAH",81,1,22,0)=" "
^DIC(9.4,100,22,15,"PAH",81,1,23,0)="The ""skip"" question logic in the Administer one item at a time for an"
^DIC(9.4,100,22,15,"PAH",81,1,24,0)="instrument was corrected."
^DIC(9.4,100,22,15,"PAH",82,0)="137 SEQ #106^3190402.164551^54"
^DIC(9.4,100,22,15,"PAH",82,1,0)="^^2^2^3190402"
^DIC(9.4,100,22,15,"PAH",82,1,1,0)="See the patch description for more detailed information.  This build "
^DIC(9.4,100,22,15,"PAH",82,1,2,0)="makes changes to the Mental Health Assistant."
^DIC(9.4,100,22,15,"PAH",83,0)="143 SEQ #107^3190501.145919^54"
^DIC(9.4,100,22,15,"PAH",83,1,0)="^^5^5^3190501"
^DIC(9.4,100,22,15,"PAH",83,1,1,0)="The patch addresses one (1) issues:"
^DIC(9.4,100,22,15,"PAH",83,1,2,0)=" "
^DIC(9.4,100,22,15,"PAH",83,1,3,0)="1.   When using the SCL9R instrument in the Mental Health Assistant,"
^DIC(9.4,100,22,15,"PAH",83,1,4,0)="     only four (4) answer choices are offered when there should be "
^DIC(9.4,100,22,15,"PAH",83,1,5,0)="     five (5).  "
^DIC(9.4,100,22,15,"PAH",84,0)="148 SEQ #108^3190501.155434^54"
^DIC(9.4,100,22,15,"PAH",84,1,0)="^^2^2^3190501"
^DIC(9.4,100,22,15,"PAH",84,1,1,0)="This patch will rebuild the ""AC"" indexes in the MH RESULTS (601.92) file"
^DIC(9.4,100,22,15,"PAH",84,1,2,0)="and in the MH ANSWERS (601.85) file."
^DIC(9.4,100,22,15,"PAH",85,0)="147 SEQ #109^3190708.165709^65"
^DIC(9.4,100,22,15,"PAH",85,1,0)="^^2^2^3190708"
^DIC(9.4,100,22,15,"PAH",85,1,1,0)="See the patch description for more detailed information.  This build "
^DIC(9.4,100,22,15,"PAH",85,1,2,0)="makes changes to the Mental Health Assistant."
^DIC(9.4,100,22,15,"PAH",86,0)="138 SEQ #111^3190722.171506^65"
^DIC(9.4,100,22,15,"PAH",86,1,0)="^^1^1^3190722"
^DIC(9.4,100,22,15,"PAH",86,1,1,0)="This patch will add 8 new instruments."
^DIC(9.4,100,22,15,"PAH",87,0)="139 SEQ #113^3190912.120829^65"
^DIC(9.4,100,22,15,"PAH",87,1,0)="^^1^1^3190912"
^DIC(9.4,100,22,15,"PAH",87,1,1,0)="This patch will address the following issues 8 new instruments."
^DIC(9.4,100,22,15,"PAH",88,0)="122^3190930.103646^65"
^DIC(9.4,100,22,15,"PAH",88,1,0)="^^1^1^3190930"
^DIC(9.4,100,22,15,"PAH",88,1,1,0)="MENTAL HEALTH NCC PROJECT 5.01"
^DIC(9.4,100,22,15,"PAH",89,0)="151 SEQ #116^3191016.162657^65"
^DIC(9.4,100,22,15,"PAH",89,1,0)="^^1^1^3191016"
^DIC(9.4,100,22,15,"PAH",89,1,1,0)="This patch will add 8 new instruments."
^DIC(9.4,100,22,15,"PAH",90,0)="142 SEQ #117^3191101.162518^65"
^DIC(9.4,100,22,15,"PAH",90,1,0)="^^25^25^3191101"
^DIC(9.4,100,22,15,"PAH",90,1,1,0)="This patch updates the following Mental Health instruments:"
^DIC(9.4,100,22,15,"PAH",90,1,2,0)=" "
^DIC(9.4,100,22,15,"PAH",90,1,3,0)="AIMS"
^DIC(9.4,100,22,15,"PAH",90,1,4,0)="  The disclaimer is no longer added to the progress note text."
^DIC(9.4,100,22,15,"PAH",90,1,5,0)=" "
^DIC(9.4,100,22,15,"PAH",90,1,6,0)="C-SSRS"
^DIC(9.4,100,22,15,"PAH",90,1,7,0)="  A Key Indicator is now added if Question 3 response is 'Yes'."
^DIC(9.4,100,22,15,"PAH",90,1,8,0)=" "
^DIC(9.4,100,22,15,"PAH",90,1,9,0)="MMPI-2-RF"
^DIC(9.4,100,22,15,"PAH",90,1,10,0)="  T-Score now calculates correctly for the EID scale."
^DIC(9.4,100,22,15,"PAH",90,1,11,0)="  Score for PSYC-r is now correct when question 216 is true."
^DIC(9.4,100,22,15,"PAH",90,1,12,0)=" "
^DIC(9.4,100,22,15,"PAH",90,1,13,0)="QOLI"
^DIC(9.4,100,22,15,"PAH",90,1,14,0)="  A scoring error introduced by YS*5.01*139 has been corrected."
^DIC(9.4,100,22,15,"PAH",90,1,15,0)=" "
^DIC(9.4,100,22,15,"PAH",90,1,16,0)="If an instrument with many scales preceded and instrument with a few "
^DIC(9.4,100,22,15,"PAH",90,1,17,0)="scales during a session, some additional scales were carried over to the "
^DIC(9.4,100,22,15,"PAH",90,1,18,0)="instrument with fewer scales.  This was visible in the Health Summary"
^DIC(9.4,100,22,15,"PAH",90,1,19,0)="component and TIU objects.  It also sometimes affected the display in the"
^DIC(9.4,100,22,15,"PAH",90,1,20,0)="Special Reports Wizard.  This is corrected with this patch.  Additionally,"
^DIC(9.4,100,22,15,"PAH",90,1,21,0)="the patch checks previous administrations to make sure each administration"
^DIC(9.4,100,22,15,"PAH",90,1,22,0)="has only the correct scales associated."
^DIC(9.4,100,22,15,"PAH",90,1,23,0)=" "
^DIC(9.4,100,22,15,"PAH",90,1,24,0)="Additional record locks were added to reduce the likelihood of errors when"
^DIC(9.4,100,22,15,"PAH",90,1,25,0)="generating a report for a legacy instrument."
^DIC(9.4,100,22,15,"PAH",91,0)="130 SEQ #119^3200122.154404^65"
^DIC(9.4,100,22,15,"PAH",91,1,0)="^^2^2^3200122"
^DIC(9.4,100,22,15,"PAH",91,1,1,0)="Add assignment capablity to MHA and calls for MHA Web app that allows "
^DIC(9.4,100,22,15,"PAH",91,1,2,0)="patient entry."
^DIC(9.4,100,22,15,"PAH",92,0)="150 SEQ #123^3200402.173333^70"
^DIC(9.4,100,22,15,"PAH",92,1,0)="^^12^12^3200402"
^DIC(9.4,100,22,15,"PAH",92,1,1,0)="This patch will address the following issues 11 new instruments:"
^DIC(9.4,100,22,15,"PAH",92,1,2,0)="Ascertain Dementia 8 -item Informant Questionnair(AD8)"
^DIC(9.4,100,22,15,"PAH",92,1,3,0)="Adverse Childhood Experiences (ACE)"
^DIC(9.4,100,22,15,"PAH",92,1,4,0)="Borderline Symptom List 23 - (BSL-23)"
^DIC(9.4,100,22,15,"PAH",92,1,5,0)="Composite Morningness Questionnaire (CMQ)"
^DIC(9.4,100,22,15,"PAH",92,1,6,0)="Eating Attitudes Test- 26 Item (EAT-26)"
^DIC(9.4,100,22,15,"PAH",92,1,7,0)="The Florida Obsessive Compulsive Inventory (FOCI"
^DIC(9.4,100,22,15,"PAH",92,1,8,0)="Mental Health Recovery Measure-10 (MHRM-10)"
^DIC(9.4,100,22,15,"PAH",92,1,9,0)="Nursing Delirium Screening Scale - (NuDESC)"
^DIC(9.4,100,22,15,"PAH",92,1,10,0)="SHORT INVENTORY OF PROBLEMS - AD (SIP-AD-30)"
^DIC(9.4,100,22,15,"PAH",92,1,11,0)="SHORT INVENTORY OF PROBLEMS - AD (SIP-AD-Start)"
^DIC(9.4,100,22,15,"PAH",92,1,12,0)="Short Warwick-Edinburgh Mental Well-being Scale(SWEMWBS)"
^DIC(9.4,100,22,15,"PAH",93,0)="154^3200410.154118^70"
^DIC(9.4,100,22,15,"PAH",93,1,0)="^^263^263^3200410"
^DIC(9.4,100,22,15,"PAH",93,1,1,0)="The MENTAL HEALTH NCC WARRANTY RELEASE 5.01 multi-build is a warranty "
^DIC(9.4,100,22,15,"PAH",93,1,2,0)="release for the National Clozapine Registry (NCR) software. This release "
^DIC(9.4,100,22,15,"PAH",93,1,3,0)="will fix the defects and incidents reported by the sites to the "
^DIC(9.4,100,22,15,"PAH",93,1,4,0)="developers of the National Clozapine Coordination (NCC) Project. The "
^DIC(9.4,100,22,15,"PAH",93,1,5,0)="project is also referred to as the Clozapine Modernization (ClozMod) "
^DIC(9.4,100,22,15,"PAH",93,1,6,0)="Project."
^DIC(9.4,100,22,15,"PAH",93,1,7,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,8,0)="The NCR is maintained by the National Clozapine Coordinating Center "
^DIC(9.4,100,22,15,"PAH",93,1,9,0)="(NCCC).  The NCCC is responsible for VA's compliance with the clozapine "
^DIC(9.4,100,22,15,"PAH",93,1,10,0)="Risk Evaluation and Mitigation Strategy (REMS), which is mandated by the "
^DIC(9.4,100,22,15,"PAH",93,1,11,0)="Food and Drug Administration (FDA) for tracking clozapine patients. "
^DIC(9.4,100,22,15,"PAH",93,1,12,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,13,0)="The multi-build contains the Mental Health patch YS*5.01*154 and the "
^DIC(9.4,100,22,15,"PAH",93,1,14,0)="Outpatient Pharmacy patch PSO*7.0*574.  The list of defects and their "
^DIC(9.4,100,22,15,"PAH",93,1,15,0)="resolution is below."
^DIC(9.4,100,22,15,"PAH",93,1,16,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,17,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,100,22,15,"PAH",93,1,18,0)="--------------------------------------------"
^DIC(9.4,100,22,15,"PAH",93,1,19,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,20,0)="   *   *   *   *   *   *"
^DIC(9.4,100,22,15,"PAH",93,1,21,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,22,0)="Patch YS*5.01*154 contains the following fixes:"
^DIC(9.4,100,22,15,"PAH",93,1,23,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,24,0)="1. Patients who are actively receiving clozapine (e.g. had a prescription "
^DIC(9.4,100,22,15,"PAH",93,1,25,0)="last month) are discontinued."
^DIC(9.4,100,22,15,"PAH",93,1,26,0)="Defect 1132329"
^DIC(9.4,100,22,15,"PAH",93,1,27,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,28,0)="Problem:"
^DIC(9.4,100,22,15,"PAH",93,1,29,0)="--------"
^DIC(9.4,100,22,15,"PAH",93,1,30,0)="The YSCL DAILY TRANSMISSION option checks for clozapine patients who "
^DIC(9.4,100,22,15,"PAH",93,1,31,0)="should be discontinued.  The logic was erroneously discontinuing patients."
^DIC(9.4,100,22,15,"PAH",93,1,32,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,33,0)="Resolution:"
^DIC(9.4,100,22,15,"PAH",93,1,34,0)="-----------"
^DIC(9.4,100,22,15,"PAH",93,1,35,0)="The YSCLDIS and YSCLTST5 routines were modified to correct issues with "
^DIC(9.4,100,22,15,"PAH",93,1,36,0)="clozapine patients being discontinued erroneously when the YSCL DAILY "
^DIC(9.4,100,22,15,"PAH",93,1,37,0)="TRANSMISSION runs at the site. The fixes also ensure that information "
^DIC(9.4,100,22,15,"PAH",93,1,38,0)="about patients that were discontinued is stored in ^XTMP(""YSCLDIS"") as a "
^DIC(9.4,100,22,15,"PAH",93,1,39,0)="log.  A discontinued patient is one who has the CLOZAPINE STATUS field "
^DIC(9.4,100,22,15,"PAH",93,1,40,0)="(#54) in the PHARMACY PATIENT FILE (#55) set to ""DISCONTINUED""."
^DIC(9.4,100,22,15,"PAH",93,1,41,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,42,0)="The YSCL154P pre-init routine was created to ensure that the YSCL DAILY "
^DIC(9.4,100,22,15,"PAH",93,1,43,0)="TRANSMISSION option is scheduled in the OPTION SCHEDULING FILE (#19.2).  "
^DIC(9.4,100,22,15,"PAH",93,1,44,0)="If the option is scheduled the installer will see a message like this:"
^DIC(9.4,100,22,15,"PAH",93,1,45,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,46,0)="YSCL DAILY TRANSMISSION information in file #19.2:"
^DIC(9.4,100,22,15,"PAH",93,1,47,0)="  QUEUED TO RUN AT WHAT TIME: OCT 02, 2019@01:30"
^DIC(9.4,100,22,15,"PAH",93,1,48,0)="  RESCHEDULING FREQUENCY: 1D"
^DIC(9.4,100,22,15,"PAH",93,1,49,0)="  TASK ID: 2576362"
^DIC(9.4,100,22,15,"PAH",93,1,50,0)="No issues found for the YSCL DAILY TRANSMISSION option."
^DIC(9.4,100,22,15,"PAH",93,1,51,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,52,0)="If the YSCL154P routine detects an issue the installer will see messages "
^DIC(9.4,100,22,15,"PAH",93,1,53,0)="that look like the two examples shown below.  If a message like this is "
^DIC(9.4,100,22,15,"PAH",93,1,54,0)="shown then the site will need to take corrective action to schedule the "
^DIC(9.4,100,22,15,"PAH",93,1,55,0)="YSCL DAILY TRANSMISSION using TaskMan options.  If there are any "
^DIC(9.4,100,22,15,"PAH",93,1,56,0)="questions about how to schedule the option please contact the ClozMod "
^DIC(9.4,100,22,15,"PAH",93,1,57,0)="team."
^DIC(9.4,100,22,15,"PAH",93,1,58,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,59,0)="Error message example 1 from the YSCL154P routine:"
^DIC(9.4,100,22,15,"PAH",93,1,60,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,61,0)="YSCL DAILY TRANSMISSION information in file #19.2:"
^DIC(9.4,100,22,15,"PAH",93,1,62,0)="*** WARNING *** The option is NOT scheduled."
^DIC(9.4,100,22,15,"PAH",93,1,63,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,64,0)="The YSCL DAILY TRANSMISSION Option should be scheduled to be run daily,"
^DIC(9.4,100,22,15,"PAH",93,1,65,0)=" in the early AM hours with no DEVICE."
^DIC(9.4,100,22,15,"PAH",93,1,66,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,67,0)="Error message example 2 from the YSCL154P routine:"
^DIC(9.4,100,22,15,"PAH",93,1,68,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,69,0)="YSCL DAILY TRANSMISSION information in file #19.2:"
^DIC(9.4,100,22,15,"PAH",93,1,70,0)="  QUEUED TO RUN AT WHAT TIME:  * Time not found! *"
^DIC(9.4,100,22,15,"PAH",93,1,71,0)="  RESCHEDULING FREQUENCY: 1D"
^DIC(9.4,100,22,15,"PAH",93,1,72,0)="  TASK ID:  * Task not found! *"
^DIC(9.4,100,22,15,"PAH",93,1,73,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,74,0)="The YSCL DAILY TRANSMISSION Option should be scheduled to be run daily,"
^DIC(9.4,100,22,15,"PAH",93,1,75,0)=" in the early AM hours with no DEVICE."
^DIC(9.4,100,22,15,"PAH",93,1,76,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,77,0)="Note: There are routines in the PSO*7.0*574 patch that also address this "
^DIC(9.4,100,22,15,"PAH",93,1,78,0)="defect."
^DIC(9.4,100,22,15,"PAH",93,1,79,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,80,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,81,0)="2. Registered clozapine patients who have not received a clozapine "
^DIC(9.4,100,22,15,"PAH",93,1,82,0)="prescription in more than 56 days may not be discontinued."
^DIC(9.4,100,22,15,"PAH",93,1,83,0)="Defect 1132404"
^DIC(9.4,100,22,15,"PAH",93,1,84,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,85,0)="Problem:"
^DIC(9.4,100,22,15,"PAH",93,1,86,0)="--------"
^DIC(9.4,100,22,15,"PAH",93,1,87,0)="A patient who had not received Clozapine for more than 56 days did not "
^DIC(9.4,100,22,15,"PAH",93,1,88,0)="have their status changed to DSCONTINUED during the nightly scan."
^DIC(9.4,100,22,15,"PAH",93,1,89,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,90,0)="Resolution:"
^DIC(9.4,100,22,15,"PAH",93,1,91,0)="-----------"
^DIC(9.4,100,22,15,"PAH",93,1,92,0)="Logic in routine YSCLDIS was changed to fix the problem."
^DIC(9.4,100,22,15,"PAH",93,1,93,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,94,0)="3. Newly Registered clozapine patients were only getting a dispense "
^DIC(9.4,100,22,15,"PAH",93,1,95,0)="frequency of WEEKLY in file #603.01."
^DIC(9.4,100,22,15,"PAH",93,1,96,0)="Defect 1132352"
^DIC(9.4,100,22,15,"PAH",93,1,97,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,98,0)="Problem:"
^DIC(9.4,100,22,15,"PAH",93,1,99,0)="--------"
^DIC(9.4,100,22,15,"PAH",93,1,100,0)="A server command being sent from Forum to the YSCLSERVER MailMan server "
^DIC(9.4,100,22,15,"PAH",93,1,101,0)="at the sites wasn't being handled correctly by the server routines."
^DIC(9.4,100,22,15,"PAH",93,1,102,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,103,0)="Resolution:"
^DIC(9.4,100,22,15,"PAH",93,1,104,0)="-----------"
^DIC(9.4,100,22,15,"PAH",93,1,105,0)="Routine YSCLSERV was modified to put the correct DISPENSE FREQUENCY "
^DIC(9.4,100,22,15,"PAH",93,1,106,0)="(field #2) in the CLOZAPINE PATIENT LIST file (#603.01); this routine was "
^DIC(9.4,100,22,15,"PAH",93,1,107,0)="also modified for defect 1132342 (see below).  Routine YSCLTST5 was "
^DIC(9.4,100,22,15,"PAH",93,1,108,0)="changed to remove code that was overwriting data written in ^XTMP."
^DIC(9.4,100,22,15,"PAH",93,1,109,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,110,0)="4. Nightly transmission missing required data."
^DIC(9.4,100,22,15,"PAH",93,1,111,0)="Defect 1132355"
^DIC(9.4,100,22,15,"PAH",93,1,112,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,113,0)="Problem:"
^DIC(9.4,100,22,15,"PAH",93,1,114,0)="--------"
^DIC(9.4,100,22,15,"PAH",93,1,115,0)="The YSCL DAILY TRANSMISSION option may not have sent all the necessary "
^DIC(9.4,100,22,15,"PAH",93,1,116,0)="data to the Forum Mail Group."
^DIC(9.4,100,22,15,"PAH",93,1,117,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,118,0)="Resolution:"
^DIC(9.4,100,22,15,"PAH",93,1,119,0)="-----------"
^DIC(9.4,100,22,15,"PAH",93,1,120,0)="Routines YSCLSERV, YSCLSRV1, YSCLSRV2, and YSCLSRV3 were modified to "
^DIC(9.4,100,22,15,"PAH",93,1,121,0)="ensure that all the needed data are returned.  The call to the MailMan "
^DIC(9.4,100,22,15,"PAH",93,1,122,0)="Application Programmer Interface (API) was updated."
^DIC(9.4,100,22,15,"PAH",93,1,123,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,124,0)="5. Discontinue Message not sent"
^DIC(9.4,100,22,15,"PAH",93,1,125,0)="Defect 1132342"
^DIC(9.4,100,22,15,"PAH",93,1,126,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,127,0)="Problem:"
^DIC(9.4,100,22,15,"PAH",93,1,128,0)="--------"
^DIC(9.4,100,22,15,"PAH",93,1,129,0)="Patients are discontinued without a message being sent to the NCCC "
^DIC(9.4,100,22,15,"PAH",93,1,130,0)="alerting them that a patient was discontinued."
^DIC(9.4,100,22,15,"PAH",93,1,131,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,132,0)="Resolution:"
^DIC(9.4,100,22,15,"PAH",93,1,133,0)="-----------"
^DIC(9.4,100,22,15,"PAH",93,1,134,0)="Routine YSCLSERV was modified to ensure that the discontinue message is "
^DIC(9.4,100,22,15,"PAH",93,1,135,0)="sent); this routine was also modified for defect 1132355 (see above)."
^DIC(9.4,100,22,15,"PAH",93,1,136,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,137,0)="6. The option Daily Clozapine Transmission [YSCL DAILY TRANSMISSION] was "
^DIC(9.4,100,22,15,"PAH",93,1,138,0)="not always sending demographic data to the RUCL files in Hines."
^DIC(9.4,100,22,15,"PAH",93,1,139,0)="Defect 1155009."
^DIC(9.4,100,22,15,"PAH",93,1,140,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,141,0)="Problem:"
^DIC(9.4,100,22,15,"PAH",93,1,142,0)="--------"
^DIC(9.4,100,22,15,"PAH",93,1,143,0)="The Daily Clozapine Transmission option was not sending demographic data "
^DIC(9.4,100,22,15,"PAH",93,1,144,0)="to the CLOZARIL REPORTS file (#1900) in the FOURWORD server that resides "
^DIC(9.4,100,22,15,"PAH",93,1,145,0)="in the Hines data center."
^DIC(9.4,100,22,15,"PAH",93,1,146,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,147,0)="Resolution:"
^DIC(9.4,100,22,15,"PAH",93,1,148,0)="-----------"
^DIC(9.4,100,22,15,"PAH",93,1,149,0)="This is not directly testable at sites."
^DIC(9.4,100,22,15,"PAH",93,1,150,0)="Data are now sent to the FOURWORD server which contains the legacy "
^DIC(9.4,100,22,15,"PAH",93,1,151,0)="Clozapine registration database."
^DIC(9.4,100,22,15,"PAH",93,1,152,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,153,0)="Routines YSCLDIS, YSCLSERV, and YSCLTST5 were modified. Routine YSCLTST9 "
^DIC(9.4,100,22,15,"PAH",93,1,154,0)="was created."
^DIC(9.4,100,22,15,"PAH",93,1,155,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,156,0)="   *   *   *   *   *   *"
^DIC(9.4,100,22,15,"PAH",93,1,157,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,158,0)="Test Sites:"
^DIC(9.4,100,22,15,"PAH",93,1,159,0)="----------"
^DIC(9.4,100,22,15,"PAH",93,1,160,0)=" - West Los Angeles VAMC (691)"
^DIC(9.4,100,22,15,"PAH",93,1,161,0)=" - N. Florida /S. Georgia VAMC (573)"
^DIC(9.4,100,22,15,"PAH",93,1,162,0)=" - VA Connecticut Healthcare System - West Haven Division (689)"
^DIC(9.4,100,22,15,"PAH",93,1,163,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,164,0)="There are no documentation updates associated with this patch."
^DIC(9.4,100,22,15,"PAH",93,1,165,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,166,0)="Patch Installation:"
^DIC(9.4,100,22,15,"PAH",93,1,167,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,168,0)="Pre/Post Installation Overview:"
^DIC(9.4,100,22,15,"PAH",93,1,169,0)="-------------------------------"
^DIC(9.4,100,22,15,"PAH",93,1,170,0)="There are no tasks to be performed before the installation of this "
^DIC(9.4,100,22,15,"PAH",93,1,171,0)="multi-build.  Note that the routines should be backed up to a PackMan "
^DIC(9.4,100,22,15,"PAH",93,1,172,0)="message before installing the build."
^DIC(9.4,100,22,15,"PAH",93,1,173,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,174,0)="Pre-Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",93,1,175,0)="------------------------------"
^DIC(9.4,100,22,15,"PAH",93,1,176,0)="This patch may be installed with users on the system although it is"
^DIC(9.4,100,22,15,"PAH",93,1,177,0)="recommended that it be installed during non-peak hours to minimize"
^DIC(9.4,100,22,15,"PAH",93,1,178,0)="potential disruption to users.  This patch should take less than 5 minutes"
^DIC(9.4,100,22,15,"PAH",93,1,179,0)="to install.  It should not be installed when the YSCL DAILY TRANSMISION "
^DIC(9.4,100,22,15,"PAH",93,1,180,0)="option is running.  If unsure when that is check the OPTION SCHEDULING "
^DIC(9.4,100,22,15,"PAH",93,1,181,0)="file (#19.2) using FileMan:"
^DIC(9.4,100,22,15,"PAH",93,1,182,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,183,0)="Select VA FileMan Option: Inquire to File Entries"
^DIC(9.4,100,22,15,"PAH",93,1,184,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,185,0)="Output from what File: OPTION SCHEDULING//   (17 entries)"
^DIC(9.4,100,22,15,"PAH",93,1,186,0)="Select OPTION SCHEDULING NAME:  YSCL DAILY TRANSMISSION"
^DIC(9.4,100,22,15,"PAH",93,1,187,0)="Another one: "
^DIC(9.4,100,22,15,"PAH",93,1,188,0)="Standard Captioned Output? Yes//   (Yes)"
^DIC(9.4,100,22,15,"PAH",93,1,189,0)="Include COMPUTED fields:  (N/Y/R/B): NO//  - No record number (IEN), no "
^DIC(9.4,100,22,15,"PAH",93,1,190,0)="Computed  Fields"
^DIC(9.4,100,22,15,"PAH",93,1,191,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,192,0)="NAME: YSCL DAILY TRANSMISSION"
^DIC(9.4,100,22,15,"PAH",93,1,193,0)="  QUEUED TO RUN AT WHAT TIME: OCT 05, 2019@01:30"
^DIC(9.4,100,22,15,"PAH",93,1,194,0)="  RESCHEDULING FREQUENCY: 1D            TASK ID: 2577736"
^DIC(9.4,100,22,15,"PAH",93,1,195,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,196,0)="Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",93,1,197,0)="--------------------------"
^DIC(9.4,100,22,15,"PAH",93,1,198,0)="1. The KIDS multi-build can be found in the VistA software repository at "
^DIC(9.4,100,22,15,"PAH",93,1,199,0)="download.vista.domain.ext"
^DIC(9.4,100,22,15,"PAH",93,1,200,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,201,0)="    ANON$:[ANONYMOUS.ANONYMOUS]MH_NCC_WARRANTY_5_01_T06.KID"
^DIC(9.4,100,22,15,"PAH",93,1,202,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,203,0)="Place the KIDS multi-build file into a local directory and use the KIDS "
^DIC(9.4,100,22,15,"PAH",93,1,204,0)="option Load a Distribution option to load it into the transport global."
^DIC(9.4,100,22,15,"PAH",93,1,205,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,206,0)="2. Choose the INSTALL/CHECK MESSAGE PackMan option."
^DIC(9.4,100,22,15,"PAH",93,1,207,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,208,0)="3. From the Kernel Installation and Distribution System Menu, select the"
^DIC(9.4,100,22,15,"PAH",93,1,209,0)="Installation Menu.  From this menu, you may elect to use the following"
^DIC(9.4,100,22,15,"PAH",93,1,210,0)="options. When prompted for the INSTALL NAME enter:"
^DIC(9.4,100,22,15,"PAH",93,1,211,0)="   MENTAL HEALTH NCC WARRANTY RELEASE 5.01"
^DIC(9.4,100,22,15,"PAH",93,1,212,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,213,0)="a. Backup a Transport Global - This option will create a backup message"
^DIC(9.4,100,22,15,"PAH",93,1,214,0)="of any routines exported with this patch."
^DIC(9.4,100,22,15,"PAH",93,1,215,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,216,0)="b. Compare Transport Global to Current System - This option will (allow"
^DIC(9.4,100,22,15,"PAH",93,1,217,0)="you to view all changes that will be made when this patch is installed.  "
^DIC(9.4,100,22,15,"PAH",93,1,218,0)="It compares all components of this patch routines, DDs, templates, etc.)."
^DIC(9.4,100,22,15,"PAH",93,1,219,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,220,0)="c. Verify Checksums in Transport Global - This option will allow you to"
^DIC(9.4,100,22,15,"PAH",93,1,221,0)="ensure the integrity of the routines that are in the transport global."
^DIC(9.4,100,22,15,"PAH",93,1,222,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,223,0)="4.  From the Installation Menu, select the Install Package(s) option and"
^DIC(9.4,100,22,15,"PAH",93,1,224,0)="choose the patch to install (MENTAL HEALTH NCC WARRANTY RELEASE 5.01)."
^DIC(9.4,100,22,15,"PAH",93,1,225,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,226,0)="5. Accept the default when prompted 'Want KIDS to Rebuild Menu Trees Upon "
^DIC(9.4,100,22,15,"PAH",93,1,227,0)="Completion of Install? NO//'"
^DIC(9.4,100,22,15,"PAH",93,1,228,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,229,0)="6. Accept the default when prompted 'Want KIDS to INHIBIT LOGONs during "
^DIC(9.4,100,22,15,"PAH",93,1,230,0)="the install? NO//'"
^DIC(9.4,100,22,15,"PAH",93,1,231,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,232,0)="7. Accept the default when prompted 'Want to DISABLE Scheduled Options, "
^DIC(9.4,100,22,15,"PAH",93,1,233,0)="Menu Options, and Protocols? NO//'"
^DIC(9.4,100,22,15,"PAH",93,1,234,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,235,0)="8. If prompted 'Delay Install (Minutes):  (0 - 60): 0// enter 0 (zero)."
^DIC(9.4,100,22,15,"PAH",93,1,236,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,237,0)="Backout /Rollback Strategy:"
^DIC(9.4,100,22,15,"PAH",93,1,238,0)="---------------------------"
^DIC(9.4,100,22,15,"PAH",93,1,239,0)="Backout will be done only with the concurrence and participation of"
^DIC(9.4,100,22,15,"PAH",93,1,240,0)="development team and appropriate VA site/region personnel. The decision to"
^DIC(9.4,100,22,15,"PAH",93,1,241,0)="backout the software will be a joint decision between development"
^DIC(9.4,100,22,15,"PAH",93,1,242,0)="team, VA site and regional personnel, and other appropriate VA "
^DIC(9.4,100,22,15,"PAH",93,1,243,0)="personnel.  Rollback applies to data only and is not applicable to this "
^DIC(9.4,100,22,15,"PAH",93,1,244,0)="multi-build."
^DIC(9.4,100,22,15,"PAH",93,1,245,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,246,0)="Prior to installing the KIDS multi-build, the site/region should have"
^DIC(9.4,100,22,15,"PAH",93,1,247,0)="saved a backup of the routines in a PackMan message using the Backup a"
^DIC(9.4,100,22,15,"PAH",93,1,248,0)="Transport Global [XPD BACKUP] menu option (this is done at time of"
^DIC(9.4,100,22,15,"PAH",93,1,249,0)="install). The message containing the backed-up routines can be loaded with"
^DIC(9.4,100,22,15,"PAH",93,1,250,0)="the ""Xtract PackMan"" function at the Message Action prompt. The PackMan"
^DIC(9.4,100,22,15,"PAH",93,1,251,0)="function ""INSTALL/CHECK MESSAGE"" is then used to install the backed up"
^DIC(9.4,100,22,15,"PAH",93,1,252,0)="routines onto the VistA System."
^DIC(9.4,100,22,15,"PAH",93,1,253,0)=" "
^DIC(9.4,100,22,15,"PAH",93,1,254,0)="Validation of Backout Procedure"
^DIC(9.4,100,22,15,"PAH",93,1,255,0)="-------------------------------"
^DIC(9.4,100,22,15,"PAH",93,1,256,0)="The backout Procedure can be verified by printing the first 2 lines of"
^DIC(9.4,100,22,15,"PAH",93,1,257,0)="the PSO* and YS* Routines contained in the MENTAL HEALTH NCC WARRANTY "
^DIC(9.4,100,22,15,"PAH",93,1,258,0)="RELEASE 5.01 multi-build using the option First Line Routine Print [XU "
^DIC(9.4,100,22,15,"PAH",93,1,259,0)="FIRST LINE PRINT]. Once the old routines listed in the multi-build patch "
^DIC(9.4,100,22,15,"PAH",93,1,260,0)="have been restored, the first two lines of the Routines will no longer "
^DIC(9.4,100,22,15,"PAH",93,1,261,0)="contain the designation of patch 574 (for Outpatient Pharmacy PSO* "
^DIC(9.4,100,22,15,"PAH",93,1,262,0)="routines) and patch 154 (for Mental Health YS* routines) in the patch "
^DIC(9.4,100,22,15,"PAH",93,1,263,0)="list section on line 2 of the routines."
^DIC(9.4,100,22,15,"PAH",94,0)="132 SEQ #125^3200601.151621^70"
^DIC(9.4,100,22,15,"PAH",94,1,0)="^^6^6^3200601"
^DIC(9.4,100,22,15,"PAH",94,1,1,0)="The Mobile Application Phase 2 (MAP2) Mental Health Checkup project "
^DIC(9.4,100,22,15,"PAH",94,1,2,0)="requires access to certain Remote Procedure Calls (RPCs) that are part of "
^DIC(9.4,100,22,15,"PAH",94,1,3,0)="the MENTAL HEALTH package. The purpose of this patch is to publish those "
^DIC(9.4,100,22,15,"PAH",94,1,4,0)="RPCs allowing access for use by Mental Health Checkup by setting the "
^DIC(9.4,100,22,15,"PAH",94,1,5,0)="field APP PROXY ALLOWED field (#.11) of the REMOTE PROCEDURE file (#8994) "
^DIC(9.4,100,22,15,"PAH",94,1,6,0)="to YES."
^DIC(9.4,100,22,15,"PAH",95,0)="165 SEQ #126^3200713.172245^65"
^DIC(9.4,100,22,15,"PAH",95,1,0)="^^8^8^3200713"
^DIC(9.4,100,22,15,"PAH",95,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,100,22,15,"PAH",95,1,2,0)=" "
^DIC(9.4,100,22,15,"PAH",95,1,3,0)="1. When adding new entries to the CLOZAPINE PATIENT LIST (#603.01)"
^DIC(9.4,100,22,15,"PAH",95,1,4,0)="file patient lookups running in the background can return erroneous"
^DIC(9.4,100,22,15,"PAH",95,1,5,0)="results, which in turn leads to incorrect entries in the file."
^DIC(9.4,100,22,15,"PAH",95,1,6,0)=" "
^DIC(9.4,100,22,15,"PAH",95,1,7,0)="This issue is being tracked in SNOW on INC10558263 and is also being"
^DIC(9.4,100,22,15,"PAH",95,1,8,0)="tracked on Rational Defect #1263669."
^DIC(9.4,100,22,15,"PAH",96,0)="166^3200923.152517^65"
^DIC(9.4,100,22,15,"PAH",96,1,0)="^^378^378^3200923"
^DIC(9.4,100,22,15,"PAH",96,1,1,0)=" The Health Integration & Modernization (HI&M) CLOZAPINE NCCC OVRD "
^DIC(9.4,100,22,15,"PAH",96,1,2,0)=" COVID-19 multi-build is an emergency patch to the National Clozapine "
^DIC(9.4,100,22,15,"PAH",96,1,3,0)=" Registry (NCR) software to correct defects to Clozapine National "
^DIC(9.4,100,22,15,"PAH",96,1,4,0)=" Clozapine Coordinating Center (NCCC) Override functionality."
^DIC(9.4,100,22,15,"PAH",96,1,5,0)="  "
^DIC(9.4,100,22,15,"PAH",96,1,6,0)=" The NCR is maintained by the NCCC. The NCCC is responsible for VA's "
^DIC(9.4,100,22,15,"PAH",96,1,7,0)=" compliance with the clozapine Risk Evaluation and Mitigation Strategy "
^DIC(9.4,100,22,15,"PAH",96,1,8,0)=" (REMS), which is mandated by the Food and Drug Administration (FDA) for "
^DIC(9.4,100,22,15,"PAH",96,1,9,0)=" tracking clozapine patients."
^DIC(9.4,100,22,15,"PAH",96,1,10,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,11,0)=" The multi-build contains the Mental Health patch YS*5.01*166 and the "
^DIC(9.4,100,22,15,"PAH",96,1,12,0)=" Outpatient Pharmacy patch PSO*7.0*612.  The list of defects and their "
^DIC(9.4,100,22,15,"PAH",96,1,13,0)=" resolution is below."
^DIC(9.4,100,22,15,"PAH",96,1,14,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,15,0)=" This patch is also being released with informational patch PSJ*5*403 that"
^DIC(9.4,100,22,15,"PAH",96,1,16,0)=" documents changes to Inpatient Medications' processing of clozapine"
^DIC(9.4,100,22,15,"PAH",96,1,17,0)=" overrides that are a result of the defect fixes in PSO*7.0*612 and"
^DIC(9.4,100,22,15,"PAH",96,1,18,0)=" YS*5.01*166."
^DIC(9.4,100,22,15,"PAH",96,1,19,0)="  "
^DIC(9.4,100,22,15,"PAH",96,1,20,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,21,0)=" Defect Tracking System Ticket(s) & Overview: "
^DIC(9.4,100,22,15,"PAH",96,1,22,0)=" --------------------------------------------"
^DIC(9.4,100,22,15,"PAH",96,1,23,0)=" * Defect and Enhancement ID's listed below are internal identifiers and "
^DIC(9.4,100,22,15,"PAH",96,1,24,0)="   do not map to any external system."
^DIC(9.4,100,22,15,"PAH",96,1,25,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,26,0)=" Patch YS*5.01*166 contains the following changes: "
^DIC(9.4,100,22,15,"PAH",96,1,27,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,28,0)=" 1. Requirement 1 Enhancement - Automate the Pharmacy "
^DIC(9.4,100,22,15,"PAH",96,1,29,0)=" Registration of NCCC Clozapine Authorizations."
^DIC(9.4,100,22,15,"PAH",96,1,30,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,31,0)=" Problem:"
^DIC(9.4,100,22,15,"PAH",96,1,32,0)=" --------"
^DIC(9.4,100,22,15,"PAH",96,1,33,0)=" Currently, national clozapine authorization numbers are sent by the "
^DIC(9.4,100,22,15,"PAH",96,1,34,0)=" National Clozapine Coordinating Center (NCCC) and filed into the "
^DIC(9.4,100,22,15,"PAH",96,1,35,0)=" CLOZAPINE PATIENT LIST file (#603.01). Later, a pharmacy user "
^DIC(9.4,100,22,15,"PAH",96,1,36,0)=" must manually execute Vista option Register Clozapine Patient [PSOL "
^DIC(9.4,100,22,15,"PAH",96,1,37,0)=" REGISTER PATIENT] (for new patients), or Edit Data for a Patient in the "
^DIC(9.4,100,22,15,"PAH",96,1,38,0)=" Clozapine Program PSOL [EDIT] (for previously registered patients). "
^DIC(9.4,100,22,15,"PAH",96,1,39,0)="  "
^DIC(9.4,100,22,15,"PAH",96,1,40,0)=" Resolution:"
^DIC(9.4,100,22,15,"PAH",96,1,41,0)=" ---------- "
^DIC(9.4,100,22,15,"PAH",96,1,42,0)=" Automate the clozapine registration process by automatically updating the"
^DIC(9.4,100,22,15,"PAH",96,1,43,0)=" patient's clozapine registration number and status when a new National "
^DIC(9.4,100,22,15,"PAH",96,1,44,0)=" Clozapine number is received from the NCCC, "
^DIC(9.4,100,22,15,"PAH",96,1,45,0)="  "
^DIC(9.4,100,22,15,"PAH",96,1,46,0)=" Technical Resolution:"
^DIC(9.4,100,22,15,"PAH",96,1,47,0)=" ---------------------"
^DIC(9.4,100,22,15,"PAH",96,1,48,0)=" A new Pharmacy API has been created that accepts Patient DFN and "
^DIC(9.4,100,22,15,"PAH",96,1,49,0)=" NCCC Clozapine Authorization number as input and files the number into "
^DIC(9.4,100,22,15,"PAH",96,1,50,0)=" the CLOZAPINE REGISTRATION NUMBER field (#53) in the PHARAMCY PATIENT "
^DIC(9.4,100,22,15,"PAH",96,1,51,0)=" file (#55), and updates the CLOZAPINE STATUS field (#54) to 'A' for "
^DIC(9.4,100,22,15,"PAH",96,1,52,0)=" Active. This API is executed when a new clozapine authorization is filed "
^DIC(9.4,100,22,15,"PAH",96,1,53,0)=" into the CLOZAPINE PATIENT LIST (#603.01) file via a mumps action cross "
^DIC(9.4,100,22,15,"PAH",96,1,54,0)=" reference."
^DIC(9.4,100,22,15,"PAH",96,1,55,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,56,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,57,0)=" 2. Requirement 1 Defect 2 - National Override Date update fails "
^DIC(9.4,100,22,15,"PAH",96,1,58,0)=" for patient with more than one clozapine authorization."
^DIC(9.4,100,22,15,"PAH",96,1,59,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,60,0)=" Problem:"
^DIC(9.4,100,22,15,"PAH",96,1,61,0)=" -----------       "
^DIC(9.4,100,22,15,"PAH",96,1,62,0)=" When a National Override is requested for a patient that has more "
^DIC(9.4,100,22,15,"PAH",96,1,63,0)=" than one entry in 603.01, the YSCL Server code performs a defective "
^DIC(9.4,100,22,15,"PAH",96,1,64,0)=" lookup into 603.01. If the patient has more than one entry in 603.01, the"
^DIC(9.4,100,22,15,"PAH",96,1,65,0)=" server code retrieves the older clozapine number and compares it to the "
^DIC(9.4,100,22,15,"PAH",96,1,66,0)=" clozapine number in the incoming override. Since the override is usually "
^DIC(9.4,100,22,15,"PAH",96,1,67,0)=" (if not always) performed on the most recent clozapine number, the "
^DIC(9.4,100,22,15,"PAH",96,1,68,0)=" override fails and generates the error message, ""SSN (PATIENT,NAME) has "
^DIC(9.4,100,22,15,"PAH",96,1,69,0)=" multiple Clozapine Numbers at nnn"". "
^DIC(9.4,100,22,15,"PAH",96,1,70,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,71,0)=" Resolution:"
^DIC(9.4,100,22,15,"PAH",96,1,72,0)=" -----------"
^DIC(9.4,100,22,15,"PAH",96,1,73,0)=" The Mental Health Clozapine Server's NCCC Override patient lookup "
^DIC(9.4,100,22,15,"PAH",96,1,74,0)=" into file 603.01 shall be corrected when processing an incoming NCCC "
^DIC(9.4,100,22,15,"PAH",96,1,75,0)=" Override so that it looks in file 603.01 for the specific patient and "
^DIC(9.4,100,22,15,"PAH",96,1,76,0)=" NCCC Clozapine number from the incoming message. Only the file 603.01 "
^DIC(9.4,100,22,15,"PAH",96,1,77,0)=" entry matching the incoming NCCC clozapine number and patient shall be "
^DIC(9.4,100,22,15,"PAH",96,1,78,0)=" updated with the incoming NCCC Override Date."
^DIC(9.4,100,22,15,"PAH",96,1,79,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,80,0)=" Technical Resolution:"
^DIC(9.4,100,22,15,"PAH",96,1,81,0)=" ---------------------"
^DIC(9.4,100,22,15,"PAH",96,1,82,0)=" Correct routine YSCLSRV2 from failing to find a match in the "
^DIC(9.4,100,22,15,"PAH",96,1,83,0)=" CLOZAPINE PATIENT LIST file (#603.01) for the incoming clozapine "
^DIC(9.4,100,22,15,"PAH",96,1,84,0)=" authorization number and patient when attempting to file an NCCC Override"
^DIC(9.4,100,22,15,"PAH",96,1,85,0)=" Date in the OVERRIDE field (#3). Prior to the patch, the code compared "
^DIC(9.4,100,22,15,"PAH",96,1,86,0)=" clozapine number associated with the incoming NCCC override with the "
^DIC(9.4,100,22,15,"PAH",96,1,87,0)=" first (earliest) clozapine authorization number on file for the patient. "
^DIC(9.4,100,22,15,"PAH",96,1,88,0)=" If the patient had only one clozapine number on file, the match was "
^DIC(9.4,100,22,15,"PAH",96,1,89,0)=" successful. If the patient had more than one clozapine number on file, "
^DIC(9.4,100,22,15,"PAH",96,1,90,0)=" the match failed as the most recent clozapine number was ignored. Routine"
^DIC(9.4,100,22,15,"PAH",96,1,91,0)=" OVVRID^YSCLSRV2 was changed to look through all clozapine authorization "
^DIC(9.4,100,22,15,"PAH",96,1,92,0)=" numbers associated with the patient to find a match for the clozapine "
^DIC(9.4,100,22,15,"PAH",96,1,93,0)=" number associated with the incoming NCCC override. "
^DIC(9.4,100,22,15,"PAH",96,1,94,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,95,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,96,0)=" 3. Requirement 2 Defect 1 - Patient with Temp Registration and an "
^DIC(9.4,100,22,15,"PAH",96,1,97,0)=" NCCC Authorization and NCCC Override Date, but day supply limited to 4."
^DIC(9.4,100,22,15,"PAH",96,1,98,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,99,0)=" INC9951972: COVID-19 VistA PSO defect - Clozapine National Override "
^DIC(9.4,100,22,15,"PAH",96,1,100,0)=" patient's prescription limited to 4 days."
^DIC(9.4,100,22,15,"PAH",96,1,101,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,102,0)=" Problem:"
^DIC(9.4,100,22,15,"PAH",96,1,103,0)=" --------"
^DIC(9.4,100,22,15,"PAH",96,1,104,0)=" A Patient initially receives a 4-day emergency authorization, and "
^DIC(9.4,100,22,15,"PAH",96,1,105,0)=" later an NCCC Authorization and an NCCC Override Date. While the NCCC "
^DIC(9.4,100,22,15,"PAH",96,1,106,0)=" Override Date is still active, the Day Supply (for Outpatient Pharmacy) "
^DIC(9.4,100,22,15,"PAH",96,1,107,0)=" or Order Duration (for Inpatient Medications) continues to be limited to "
^DIC(9.4,100,22,15,"PAH",96,1,108,0)=" 4 days. Inpatient Medications Order Duration is defined as the number of "
^DIC(9.4,100,22,15,"PAH",96,1,109,0)=" days between the order's Start Date/Time and Stop Date/Time."
^DIC(9.4,100,22,15,"PAH",96,1,110,0)="      "
^DIC(9.4,100,22,15,"PAH",96,1,111,0)=" Resolution:"
^DIC(9.4,100,22,15,"PAH",96,1,112,0)=" -----------"
^DIC(9.4,100,22,15,"PAH",96,1,113,0)=" If a NCCC Authorized National Override Date is in effect following "
^DIC(9.4,100,22,15,"PAH",96,1,114,0)=" an initial local override, the system shall process an active clozapine "
^DIC(9.4,100,22,15,"PAH",96,1,115,0)=" patient's clozapine prescription under national override processes "
^DIC(9.4,100,22,15,"PAH",96,1,116,0)=" allowing the patient to be provided with the approved quantity associated"
^DIC(9.4,100,22,15,"PAH",96,1,117,0)=" with their individual dispensing frequency from the DISPENSE FREQUENCY "
^DIC(9.4,100,22,15,"PAH",96,1,118,0)=" field (#2) in the CLOZAPINE PATIENT LIST file (#603.01). The approved "
^DIC(9.4,100,22,15,"PAH",96,1,119,0)=" quantity is determined by the order's Days Supply for Outpatient Pharmacy"
^DIC(9.4,100,22,15,"PAH",96,1,120,0)=" orders, and the Order Duration (days between Start Date/Time and Stop "
^DIC(9.4,100,22,15,"PAH",96,1,121,0)=" Date/Time) for Inpatient Medications orders."
^DIC(9.4,100,22,15,"PAH",96,1,122,0)="  "
^DIC(9.4,100,22,15,"PAH",96,1,123,0)=" Technical Resolution:"
^DIC(9.4,100,22,15,"PAH",96,1,124,0)=" ---------------------"
^DIC(9.4,100,22,15,"PAH",96,1,125,0)=" The correct patient dispense frequency is now retrieved by changing"
^DIC(9.4,100,22,15,"PAH",96,1,126,0)=" CL1^YSCLTST4 to find the dispense frequency associated with the patient's"
^DIC(9.4,100,22,15,"PAH",96,1,127,0)=" registered clozapine authorization number."
^DIC(9.4,100,22,15,"PAH",96,1,128,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,129,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,130,0)=" 4. Requirement 2 Defect 2 - Patient with NCCC Authorization receives a"
^DIC(9.4,100,22,15,"PAH",96,1,131,0)=" Special Condition Fill, and later an NCCC Authorization and Override"
^DIC(9.4,100,22,15,"PAH",96,1,132,0)=" Date, but day supply limited to 4."
^DIC(9.4,100,22,15,"PAH",96,1,133,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,134,0)=" INC9951972: COVID-19 VistA PSO defect - Clozapine National Override "
^DIC(9.4,100,22,15,"PAH",96,1,135,0)=" patient's prescription limited to 4 days "
^DIC(9.4,100,22,15,"PAH",96,1,136,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,137,0)=" Problem:"
^DIC(9.4,100,22,15,"PAH",96,1,138,0)=" --------"
^DIC(9.4,100,22,15,"PAH",96,1,139,0)=" A patient with an initial NCCC Authorization receives a Special Condition"
^DIC(9.4,100,22,15,"PAH",96,1,140,0)=" override, followed by an NCCC override, is limited to a Day Supply"
^DIC(9.4,100,22,15,"PAH",96,1,141,0)=" (Outpatient Pharmacy orders) or an Order Duration (Inpatient Medications"
^DIC(9.4,100,22,15,"PAH",96,1,142,0)=" orders) limited to 4 for clozapine orders. The NCCC national clozapine"
^DIC(9.4,100,22,15,"PAH",96,1,143,0)=" override and the patient's regular clozapine dispense frequency"
^DIC(9.4,100,22,15,"PAH",96,1,144,0)=" are ignored."
^DIC(9.4,100,22,15,"PAH",96,1,145,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,146,0)=" Resolution:"
^DIC(9.4,100,22,15,"PAH",96,1,147,0)=" -----------"
^DIC(9.4,100,22,15,"PAH",96,1,148,0)=" A patient with an initial NCCC clozapine authorization receiving a "
^DIC(9.4,100,22,15,"PAH",96,1,149,0)=" Special Condition override, followed by an NCCC override, shall be"
^DIC(9.4,100,22,15,"PAH",96,1,150,0)=" processed under national override rules allowing the patient to be"
^DIC(9.4,100,22,15,"PAH",96,1,151,0)=" provided with the approved quantity associated with their individual"
^DIC(9.4,100,22,15,"PAH",96,1,152,0)=" dispensing frequency from the DISPENSE FREQUENCY field (#2) in the"
^DIC(9.4,100,22,15,"PAH",96,1,153,0)=" CLOZAPINE PATIENT LIST file (#603.01). The approved quantity is reflected"
^DIC(9.4,100,22,15,"PAH",96,1,154,0)=" in the order's Days Supply for Outpatient Pharmacy orders, and the Order"
^DIC(9.4,100,22,15,"PAH",96,1,155,0)=" Duration (days between Start Date/Time and Stop Date/Time) for Inpatient"
^DIC(9.4,100,22,15,"PAH",96,1,156,0)=" Medications orders."
^DIC(9.4,100,22,15,"PAH",96,1,157,0)="  "
^DIC(9.4,100,22,15,"PAH",96,1,158,0)=" Technical Resolution:"
^DIC(9.4,100,22,15,"PAH",96,1,159,0)=" ---------------------"
^DIC(9.4,100,22,15,"PAH",96,1,160,0)=" Routine OVRRID^YSCLTST2 changed to kill ^XTMP(""PSJ4D-""_DFN) and "
^DIC(9.4,100,22,15,"PAH",96,1,161,0)=" ^XTMP(""PSO4D-""_DFN) after an NCCC override is successfully filed. This "
^DIC(9.4,100,22,15,"PAH",96,1,162,0)=" removes a patient's local clozapine override information when it is "
^DIC(9.4,100,22,15,"PAH",96,1,163,0)=" replaced by an NCCC override."
^DIC(9.4,100,22,15,"PAH",96,1,164,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,165,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,166,0)=" Patch Components"
^DIC(9.4,100,22,15,"PAH",96,1,167,0)=" ================"
^DIC(9.4,100,22,15,"PAH",96,1,168,0)=" Files & Fields Associated:"
^DIC(9.4,100,22,15,"PAH",96,1,169,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,170,0)=" File Name (Number)    Field Name (Number)      New/Modified/Deleted      "
^DIC(9.4,100,22,15,"PAH",96,1,171,0)=" ------------------    ----------------------   --------------------      "
^DIC(9.4,100,22,15,"PAH",96,1,172,0)=" CLOZAPINE PATIENT     CLOZAPINE REGISTRATION   Modified* (Mumps X-Ref)  "
^DIC(9.4,100,22,15,"PAH",96,1,173,0)=" LIST (#603.01)        NUMBER (#.01)"
^DIC(9.4,100,22,15,"PAH",96,1,174,0)="                       CLOZAPINE PATIEN T(#1)   Modified* (Mumps X-Ref)"
^DIC(9.4,100,22,15,"PAH",96,1,175,0)=" "
^DIC(9.4,100,22,15,"PAH",96,1,176,0)=" *New style ""AC"" mumps cross reference added to these two fields in file "
^DIC(9.4,100,22,15,"PAH",96,1,177,0)="  603.01. New routine TRGR^PSOCLADD(DFN,PSOCLZNW) is invoked when a new"
^DIC(9.4,100,22,15,"PAH",96,1,178,0)="  entry is filed. New Integration Control Registration (ICR) #7175 has"
^DIC(9.4,100,22,15,"PAH",96,1,179,0)="  been created to document the new cross application interaction."
^DIC(9.4,100,22,15,"PAH",96,1,180,0)=" "
