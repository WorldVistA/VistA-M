^DIC(9.4,163,22,1,"PAH",180,0)="195 SEQ #184^3050813^1"
^DIC(9.4,163,22,1,"PAH",180,1,0)="^^3^3^3050813"
^DIC(9.4,163,22,1,"PAH",180,1,1,0)="WHEN THERE IS MORE THAN ONE OPERATION REPORT FOR THE SAME DAY, THERE IS "
^DIC(9.4,163,22,1,"PAH",180,1,2,0)="NO WAY TO TELL WHICH OPERATION REPORT TO CHOOSE.  ADD PRINCIPAL PROCEDURE "
^DIC(9.4,163,22,1,"PAH",180,1,3,0)="NAME TO LIST."
^DIC(9.4,163,22,1,"PAH",181,0)="186 SEQ #185^3051020^1"
^DIC(9.4,163,22,1,"PAH",181,1,0)="^^2^2^3051020"
^DIC(9.4,163,22,1,"PAH",181,1,1,0)="The description of this patch may be found in the National Patch Module "
^DIC(9.4,163,22,1,"PAH",181,1,2,0)="under TIU*1*186."
^DIC(9.4,163,22,1,"PAH",182,0)="194 SEQ #186^3051115^1"
^DIC(9.4,163,22,1,"PAH",182,1,0)="^^4^4^3051115"
^DIC(9.4,163,22,1,"PAH",182,1,1,0)="IN CPRS GUI, NOTES, VIEW, SIGNED BY AUTHOR IT DISPLAYS NOTES BY SIGNED BY "
^DIC(9.4,163,22,1,"PAH",182,1,2,0)="INSTEAD OF AUTHOR.  IN ROLL AND SCROLL OPTION 2B Review Progress Notes, "
^DIC(9.4,163,22,1,"PAH",182,1,3,0)="SS DOES THE SAME.  IN ROLL AND SCROLL CPRS, NOTES, CV IT DOES THE SAME.  "
^DIC(9.4,163,22,1,"PAH",182,1,4,0)="THIS PATCH WILL CORRECT THOSE PROBLEMS."
^DIC(9.4,163,22,1,"PAH",183,0)="191 SEQ #187^3051115^1"
^DIC(9.4,163,22,1,"PAH",183,1,0)="^^2^2^3051115"
^DIC(9.4,163,22,1,"PAH",183,1,1,0)="The description of this patch may be found in the National Patch Module "
^DIC(9.4,163,22,1,"PAH",183,1,2,0)="under TIU*1.0*191."
^DIC(9.4,163,22,1,"PAH",184,0)="198 SEQ #188^3051202^1"
^DIC(9.4,163,22,1,"PAH",184,1,0)="^^7^7^3051202"
^DIC(9.4,163,22,1,"PAH",184,1,1,0)="CORRECT A PROBLEM WITH ACTIVE/RECENT MEDS OBJECT. UNDER CERTAIN "
^DIC(9.4,163,22,1,"PAH",184,1,2,0)="CONDITIONS IT WOULD SHOW A DISCONTINUED MED AND NOT THE ACTIVE MED FOR "
^DIC(9.4,163,22,1,"PAH",184,1,3,0)="THE SAME DRUG."
^DIC(9.4,163,22,1,"PAH",184,1,4,0)=" "
^DIC(9.4,163,22,1,"PAH",184,1,5,0)="PROBLEM WITH TIU DOCUMENT PARAMETER EDIT.  SITES WERE CHANGING THE "
^DIC(9.4,163,22,1,"PAH",184,1,6,0)="DOCUMENT NAME DURING THE EDIT AND LOOSING ALL THE PARAMETERS FOR THE "
^DIC(9.4,163,22,1,"PAH",184,1,7,0)="DOCUMENT.  ADDED A WARNING MESSAGE IF DOCUMENT NAME IS CHANGED OR DELETED."
^DIC(9.4,163,22,1,"PAH",185,0)="203 SEQ #189^3060112^1"
^DIC(9.4,163,22,1,"PAH",185,1,0)="^^4^4^3060112"
^DIC(9.4,163,22,1,"PAH",185,1,1,0)="If the Patient Movement Record field (1401) of the TIU Document file "
^DIC(9.4,163,22,1,"PAH",185,1,2,0)="(8925) is null an unfined error occurs when trying to edit the Discharge "
^DIC(9.4,163,22,1,"PAH",185,1,3,0)="Summary. The input template TIU ENTER/EDIT DS will be modified to prevent "
^DIC(9.4,163,22,1,"PAH",185,1,4,0)="this hard error."
^DIC(9.4,163,22,1,"PAH",186,0)="206 SEQ #190^3060213^1"
^DIC(9.4,163,22,1,"PAH",186,1,0)="^^1^1^3060213"
^DIC(9.4,163,22,1,"PAH",186,1,1,0)="WHEN DELETING A TIU DOCUMENT PARAMETER AN UNDEFINED OCCURS."
^DIC(9.4,163,22,1,"PAH",187,0)="201 SEQ #191^3060308^1"
^DIC(9.4,163,22,1,"PAH",187,1,0)="^^2^2^3060308"
^DIC(9.4,163,22,1,"PAH",187,1,1,0)="Fix problem in boilerplate logic when a line of boilerplate text contains "
^DIC(9.4,163,22,1,"PAH",187,1,2,0)="more than one object."
^DIC(9.4,163,22,1,"PAH",188,0)="212 SEQ #192^3060504^1"
^DIC(9.4,163,22,1,"PAH",188,1,0)="^^1^1^3060504"
^DIC(9.4,163,22,1,"PAH",188,1,1,0)="DOCUMENT PARAMETER VALUES CAN BE LOST WHILE EDITING A DOCUMENT PARAMETER."
^DIC(9.4,163,22,1,"PAH",189,0)="189 SEQ #193^3060504^1"
^DIC(9.4,163,22,1,"PAH",189,1,0)="^^2^2^3060504"
^DIC(9.4,163,22,1,"PAH",189,1,1,0)="Contains the Missing Expected Cosigner Report and a fix to the TIU UNK "
