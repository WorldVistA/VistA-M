^DIC(9.4,48,22,5.28,"PAH",579,1,316,0)=" "
^DIC(9.4,48,22,5.28,"PAH",579,1,317,0)="25) Jira #VSE-741 - Update GUI to use new SDEC GET PATIENT RECALL RPC"
^DIC(9.4,48,22,5.28,"PAH",579,1,318,0)=" "
^DIC(9.4,48,22,5.28,"PAH",579,1,319,0)="Problem:"
