^DIC(9.4,93,22,21,"PAH",195,1,86,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,93,22,21,"PAH",195,1,87,0)="-----------------------------"
^DIC(9.4,93,22,21,"PAH",195,1,88,0)="N/A"
^DIC(9.4,93,22,21,"PAH",195,1,89,0)=" "
^DIC(9.4,93,22,21,"PAH",195,1,90,0)=" "
^DIC(9.4,93,22,21,"PAH",195,1,91,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,93,22,21,"PAH",195,1,92,0)="--------------------------------------------"
^DIC(9.4,93,22,21,"PAH",195,1,93,0)="1.)     INC23855232: capri transfer of document issue"
^DIC(9.4,93,22,21,"PAH",195,1,94,0)="        INC23855099: CAPRI will not let me send documents to VBMS - seems "
^DIC(9.4,93,22,21,"PAH",195,1,95,0)="                     to be a certificate issue."
^DIC(9.4,93,22,21,"PAH",195,1,96,0)="        INC23832201: CAPRI will not allow upload to VBMS"
^DIC(9.4,93,22,21,"PAH",195,1,97,0)="        INC23849031: Capri error - unable to send records to VBMS eFolder"
^DIC(9.4,93,22,21,"PAH",195,1,98,0)="      "
^DIC(9.4,93,22,21,"PAH",195,1,99,0)="   Problem: "
^DIC(9.4,93,22,21,"PAH",195,1,100,0)="   --------"
^DIC(9.4,93,22,21,"PAH",195,1,101,0)="   Some users are experiencing an issue with CAPRI transfers to VBMS "
^DIC(9.4,93,22,21,"PAH",195,1,102,0)="   eFolder."
^DIC(9.4,93,22,21,"PAH",195,1,103,0)="  "
^DIC(9.4,93,22,21,"PAH",195,1,104,0)="  "
^DIC(9.4,93,22,21,"PAH",195,1,105,0)="   Resolution:"
^DIC(9.4,93,22,21,"PAH",195,1,106,0)="   -----------"
^DIC(9.4,93,22,21,"PAH",195,1,107,0)="   Removed security check on token return as this is causing the issue "
^DIC(9.4,93,22,21,"PAH",195,1,108,0)="   for remote users.   "
^DIC(9.4,93,22,21,"PAH",196,0)="242 SEQ #207^3221115.084206^89"
^DIC(9.4,93,22,21,"PAH",196,1,0)="^^16^16^3221115"
^DIC(9.4,93,22,21,"PAH",196,1,1,0)="Patch DVBA*2.7*242 updates the CAPRI GUI to be 508 compliant by "
^DIC(9.4,93,22,21,"PAH",196,1,2,0)="implementing the bug defect remediations for this year's audit. "
^DIC(9.4,93,22,21,"PAH",196,1,3,0)=" "
^DIC(9.4,93,22,21,"PAH",196,1,4,0)="A small update is also included to improve the CAPRI Disability Benefits "
^DIC(9.4,93,22,21,"PAH",196,1,5,0)="Questionnaire (DBQ) Push Utility to better handle CAPRI parameters that "
^DIC(9.4,93,22,21,"PAH",196,1,6,0)="are incorrectly set up in VistA. "
^DIC(9.4,93,22,21,"PAH",196,1,7,0)=" "
^DIC(9.4,93,22,21,"PAH",196,1,8,0)="CAPRI GUI Veterans Benefits Administration (VBA) Users are experiencing "
^DIC(9.4,93,22,21,"PAH",196,1,9,0)="mislabeled clinical documents in Veterans Benefits Management System "
^DIC(9.4,93,22,21,"PAH",196,1,10,0)="(VBMS), this has been updated to show the correct document type and "
^DIC(9.4,93,22,21,"PAH",196,1,11,0)="subject."
^DIC(9.4,93,22,21,"PAH",196,1,12,0)=" "
^DIC(9.4,93,22,21,"PAH",196,1,13,0)="CAPRI GUI Users are also experiencing wrong patient demographics being "
^DIC(9.4,93,22,21,"PAH",196,1,14,0)="displayed in the PDF footer after signing a Disability Benefits "
^DIC(9.4,93,22,21,"PAH",196,1,15,0)="Questionnaire (DBQ). This patch ensures that CAPRI will display the "
^DIC(9.4,93,22,21,"PAH",196,1,16,0)="correct patient demographics information in the PDF footer."
^DIC(9.4,93,22,21,"PAH",197,0)="243 SEQ #208^3230213.131753^89"
^DIC(9.4,93,22,21,"PAH",197,1,0)="^^229^229^3230213"
^DIC(9.4,93,22,21,"PAH",197,1,1,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,2,0)="Patch DVBA*2.7*243 introduces the capability to upload clinical documents "
^DIC(9.4,93,22,21,"PAH",197,1,3,0)="from CAPRI to VBMS using multiple veteran identifiers,"
^DIC(9.4,93,22,21,"PAH",197,1,4,0)="which is addressing issue reported in INC23999254."
^DIC(9.4,93,22,21,"PAH",197,1,5,0)="In addition, this patch is limiting user access to the eFolder Uploading "
^DIC(9.4,93,22,21,"PAH",197,1,6,0)="features. Only users meeting criteria provided by the Business"
^DIC(9.4,93,22,21,"PAH",197,1,7,0)="will be able to send Clinical Documents to the eFolder."
^DIC(9.4,93,22,21,"PAH",197,1,8,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,9,0)="Patch DVBA*2.7*243 is also resolving the following issues:"
^DIC(9.4,93,22,21,"PAH",197,1,10,0)="INC23613395: CAPRI Report Builder fails on the Outpatient History All "
^DIC(9.4,93,22,21,"PAH",197,1,11,0)="report in the Meds tab of the Clinical Documents  "
^DIC(9.4,93,22,21,"PAH",197,1,12,0)="INC18759211: CAPRI: can't get DBQs to sign when in draft/not ready status"
^DIC(9.4,93,22,21,"PAH",197,1,13,0)="INC20083692: Report Builder running slowly "
^DIC(9.4,93,22,21,"PAH",197,1,14,0)="INC23025221: CAPRI Allows multiple DBQs with the same name to be added to "
^DIC(9.4,93,22,21,"PAH",197,1,15,0)="a worksheet in error "
^DIC(9.4,93,22,21,"PAH",197,1,16,0)="INC21126820: Cannot use Adobe Acrobat Print to PDF from CAPRI"
^DIC(9.4,93,22,21,"PAH",197,1,17,0)="INC23999254: Patient Claim Number is missing error, unable to send "
^DIC(9.4,93,22,21,"PAH",197,1,18,0)="clinical document to eFolder"
^DIC(9.4,93,22,21,"PAH",197,1,19,0)="INC21941384: Requesting offce value on ""insufficient"" exam request "
^DIC(9.4,93,22,21,"PAH",197,1,20,0)="showing the wrong office"
^DIC(9.4,93,22,21,"PAH",197,1,21,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,22,0)=" "
^DIC(9.4,93,22,21,"PAH",197,1,23,0)=" "
