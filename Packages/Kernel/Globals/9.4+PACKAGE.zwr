^DIC(9.4,185,22,1,"PAH",2,1,0)="^^2^2^3040507"
^DIC(9.4,185,22,1,"PAH",2,1,1,0)="DBIA #4376.  Correct DD node of the TRANSCRIBED BY field in the "
^DIC(9.4,185,22,1,"PAH",2,1,2,0)="INCOMPLETE RECORDS file."
^DIC(9.4,185,22,1,"PAH",3,0)="3 SEQ #3^3041111^1"
^DIC(9.4,185,22,1,"PAH",3,1,0)="^^2^2^3041111"
^DIC(9.4,185,22,1,"PAH",3,1,1,0)="DISABLE COREFLS SOFTWARE.  Remove variable pointer to #392.31 in "
