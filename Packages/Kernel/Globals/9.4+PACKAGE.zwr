^DIC(9.4,47,22,5.9,"PAH",124,1,2,0)="of patch DG*5.3*222 in the National Patch Module."
^DIC(9.4,47,22,5.9,"PAH",125,0)="208 SEQ #202^2990427^1"
^DIC(9.4,47,22,5.9,"PAH",125,1,0)="^^5^5^2990427"
^DIC(9.4,47,22,5.9,"PAH",125,1,1,0)="   It prevents the duplication of the pseudo WHILE ASIH discharge. In a"
^DIC(9.4,47,22,5.9,"PAH",125,1,2,0)="   test environment changing a TRANSFER TO ASIH(OTHER FACILITY) to a"
^DIC(9.4,47,22,5.9,"PAH",125,1,3,0)="   TRANSFER TO ASIH incorrectly created a duplicate WHILE ASIH discharge."
^DIC(9.4,47,22,5.9,"PAH",125,1,4,0)="   The effect of this extra discharge would be reflected in the Bed Status"
^DIC(9.4,47,22,5.9,"PAH",125,1,5,0)="   Report. This patch prevents the duplication from occuring."
^DIC(9.4,47,22,5.9,"PAH",126,0)="204 SEQ #203^2990427^1"
^DIC(9.4,47,22,5.9,"PAH",126,1,0)="^^1^1^2990427"
^DIC(9.4,47,22,5.9,"PAH",126,1,1,0)="See National Patch Module."
^DIC(9.4,47,22,5.9,"PAH",127,0)="229 SEQ #204^2990427^1"
^DIC(9.4,47,22,5.9,"PAH",127,1,0)="^^2^2^2990427"
^DIC(9.4,47,22,5.9,"PAH",127,1,1,0)="Fix to PD1 segment builder to prevent PC provider = -1 from being sent"
^DIC(9.4,47,22,5.9,"PAH",127,1,2,0)="to Austin."
^DIC(9.4,47,22,5.9,"PAH",128,0)="149^2990510^1"
^DIC(9.4,47,22,5.9,"PAH",128,1,0)="^^2^2^2990510"
^DIC(9.4,47,22,5.9,"PAH",128,1,1,0)="For a complete description, refer to the FORUM Patch Module"
^DIC(9.4,47,22,5.9,"PAH",128,1,2,0)="for patch DG*5.3*149."
^DIC(9.4,47,22,5.9,"PAH",129,0)="230 SEQ #206^2990510^1"
^DIC(9.4,47,22,5.9,"PAH",129,1,0)="^^2^2^2990510"
^DIC(9.4,47,22,5.9,"PAH",129,1,1,0)="The changes included in this patch are described in the description of"
^DIC(9.4,47,22,5.9,"PAH",129,1,2,0)="patch DG*5.3*230 in the National Patch Module."
^DIC(9.4,47,22,5.9,"PAH",130,0)="235 SEQ #207^2990602^1"
^DIC(9.4,47,22,5.9,"PAH",130,1,0)="^^11^11^2990602"
^DIC(9.4,47,22,5.9,"PAH",130,1,1,0)="This patch updates the PTF CENSUS DATE File (#45.86) for the  third"
^DIC(9.4,47,22,5.9,"PAH",130,1,2,0)="quarter of FY 1999 (4/1/1999-6/30/1999).  The closeout  date for this"
^DIC(9.4,47,22,5.9,"PAH",130,1,3,0)="census is 7/16/1999."
^DIC(9.4,47,22,5.9,"PAH",130,1,4,0)=" "
^DIC(9.4,47,22,5.9,"PAH",130,1,5,0)="This patch addresses the Quarterly Census issue discussed in VHA"
^DIC(9.4,47,22,5.9,"PAH",130,1,6,0)="Directive 98-056."
^DIC(9.4,47,22,5.9,"PAH",130,1,7,0)=" "
^DIC(9.4,47,22,5.9,"PAH",130,1,8,0)="This patch may be installed at anytime, however, it must be installed"
^DIC(9.4,47,22,5.9,"PAH",130,1,9,0)="before 6/30/1999.  This patch does not affect any  options or any"
^DIC(9.4,47,22,5.9,"PAH",130,1,10,0)="permanent routines so it may be loaded out of  sequence, if necessary, to"
^DIC(9.4,47,22,5.9,"PAH",130,1,11,0)="meet the 6/30/1999 date."
^DIC(9.4,47,22,5.9,"PAH",131,0)="195^2990602^1"
^DIC(9.4,47,22,5.9,"PAH",131,1,0)="^^5^5^2990602"
^DIC(9.4,47,22,5.9,"PAH",131,1,1,0)="VHA Directive 98-058, ""Sexual Trauma Counseling Care and Services"""
^DIC(9.4,47,22,5.9,"PAH",131,1,2,0)="requires that VHA provide care and counseling to veterans determined to"
^DIC(9.4,47,22,5.9,"PAH",131,1,3,0)="have been a victim of sexual trauma while the veteran was serving on"
^DIC(9.4,47,22,5.9,"PAH",131,1,4,0)="active duty.  This patch will focus on the data collection for this"
^DIC(9.4,47,22,5.9,"PAH",131,1,5,0)="directive."
^DIC(9.4,47,22,5.9,"PAH",132,0)="216 SEQ #209^2990602^1"
^DIC(9.4,47,22,5.9,"PAH",132,1,0)="^^3^3^2990602"
^DIC(9.4,47,22,5.9,"PAH",132,1,1,0)="Addresses SHARING AGREEMENT SUBCATEGORY ISSUES raised in NOISes"
^DIC(9.4,47,22,5.9,"PAH",132,1,2,0)="SYR-0698-11882 and ALB-1298-52122. Allows the editing of the Subcategory"
^DIC(9.4,47,22,5.9,"PAH",132,1,3,0)="name, and screens subcategory selection by whether it is active."
^DIC(9.4,47,22,5.9,"PAH",133,0)="231^2990628^1"
^DIC(9.4,47,22,5.9,"PAH",133,1,0)="^^34^34^2990628"
^DIC(9.4,47,22,5.9,"PAH",133,1,1,0)=" Patch DG*5.3*149 added new cross references to a number of fields"
^DIC(9.4,47,22,5.9,"PAH",133,1,2,0)=" from the PATIENT file (#2). Clinical Information Resource Network"
^DIC(9.4,47,22,5.9,"PAH",133,1,3,0)=" (CIRN) needs to monitor changes made to these fields.  This patch"
^DIC(9.4,47,22,5.9,"PAH",133,1,4,0)=" turns audit ON for a number of fields in the PATIENT file. "
^DIC(9.4,47,22,5.9,"PAH",133,1,5,0)="  "
^DIC(9.4,47,22,5.9,"PAH",133,1,6,0)=" The following is a list of fields in the PATIENT file for which "
^DIC(9.4,47,22,5.9,"PAH",133,1,7,0)=" auditing is turned on: "
^DIC(9.4,47,22,5.9,"PAH",133,1,8,0)="      .02    SEX"
^DIC(9.4,47,22,5.9,"PAH",133,1,9,0)="      .03    DATE OF BIRTH"
^DIC(9.4,47,22,5.9,"PAH",133,1,10,0)="      .05    MARITAL STATUS"
^DIC(9.4,47,22,5.9,"PAH",133,1,11,0)="      .08    RELIGIOUS PREFERENCE"
^DIC(9.4,47,22,5.9,"PAH",133,1,12,0)="      .09    SOCIAL SECURITY NUMBER"
^DIC(9.4,47,22,5.9,"PAH",133,1,13,0)="      .111   STREET ADDRESS [LINE 1]"
^DIC(9.4,47,22,5.9,"PAH",133,1,14,0)="      .1112  ZIP+4"
^DIC(9.4,47,22,5.9,"PAH",133,1,15,0)="      .112   STREET ADDRESS [LINE 2]"
^DIC(9.4,47,22,5.9,"PAH",133,1,16,0)="      .113   STREET ADDRESS [LINE 3]"
^DIC(9.4,47,22,5.9,"PAH",133,1,17,0)="      .114   CITY"
^DIC(9.4,47,22,5.9,"PAH",133,1,18,0)="      .115   STATE"
^DIC(9.4,47,22,5.9,"PAH",133,1,19,0)="      .117   COUNTY"
^DIC(9.4,47,22,5.9,"PAH",133,1,20,0)="      .131   PHONE NUMBER [RESIDENCE]"
^DIC(9.4,47,22,5.9,"PAH",133,1,21,0)="      .132   PHONE NUMBER [WORK]"
^DIC(9.4,47,22,5.9,"PAH",133,1,22,0)="      .211   K-NAME OF PRIMARY NOK"
^DIC(9.4,47,22,5.9,"PAH",133,1,23,0)="      .219   K-PHONE NUMBER"
^DIC(9.4,47,22,5.9,"PAH",133,1,24,0)="      .2403  MOTHER'S MAIDEN NAME"
^DIC(9.4,47,22,5.9,"PAH",133,1,25,0)="      .301   SERVICE CONNECTED?"
^DIC(9.4,47,22,5.9,"PAH",133,1,26,0)="      .302   SERVICE CONNECTED PERCENTAGE"
^DIC(9.4,47,22,5.9,"PAH",133,1,27,0)="      .31115 EMPLOYMENT STATUS"
^DIC(9.4,47,22,5.9,"PAH",133,1,28,0)="      .323   PERIOD OF SERVICE"
^DIC(9.4,47,22,5.9,"PAH",133,1,29,0)="      .351   DATE OF DEATH"
^DIC(9.4,47,22,5.9,"PAH",133,1,30,0)="   391       TYPE"
^DIC(9.4,47,22,5.9,"PAH",133,1,31,0)="  1901       VETERAN"
^DIC(9.4,47,22,5.9,"PAH",133,1,32,0)="  "
^DIC(9.4,47,22,5.9,"PAH",133,1,33,0)=" The post-install routine DG53231P is invoked to re-compile all Print"
^DIC(9.4,47,22,5.9,"PAH",133,1,34,0)=" Templates and Input Templates for the affected fields. "
^DIC(9.4,47,22,5.9,"PAH",134,0)="233 SEQ #211^2990719^1"
^DIC(9.4,47,22,5.9,"PAH",134,1,0)="^^6^6^2990719"
^DIC(9.4,47,22,5.9,"PAH",134,1,1,0)=" "
^DIC(9.4,47,22,5.9,"PAH",134,1,2,0)="This KIDS build installs the routine DG53233P which activates the"
^DIC(9.4,47,22,5.9,"PAH",134,1,3,0)="ENROLLMENT QUERY ACTIVE (#15) field of the IVM SITE PARAMETER (#301.9)."
^DIC(9.4,47,22,5.9,"PAH",134,1,4,0)=" "
^DIC(9.4,47,22,5.9,"PAH",134,1,5,0)="It also includes a change to the description to correct a spelling mistake"
^DIC(9.4,47,22,5.9,"PAH",134,1,6,0)="in the Data Dictionary for the IVM SITE PARAMETER (#301.9) file."
^DIC(9.4,47,22,5.9,"PAH",135,0)="217 SEQ #212^2990803^1"
^DIC(9.4,47,22,5.9,"PAH",135,1,0)="^^8^8^2990803"
^DIC(9.4,47,22,5.9,"PAH",135,1,1,0)="New routine (DGMTARR) creates and prints 3 new Means Test reports.  The"
^DIC(9.4,47,22,5.9,"PAH",135,1,2,0)="'Report for Specific Income Amount' .  This report uses input from the"
^DIC(9.4,47,22,5.9,"PAH",135,1,3,0)="user to define a dollar range and date range, and prints veterans whose"
^DIC(9.4,47,22,5.9,"PAH",135,1,4,0)="income falls between the dollar range and date range.    The 'Report of"
^DIC(9.4,47,22,5.9,"PAH",135,1,5,0)="income range Less than Threshold' will print veterans whose income is"
^DIC(9.4,47,22,5.9,"PAH",135,1,6,0)="within the selected range less than the Threshold amount.  The last"
^DIC(9.4,47,22,5.9,"PAH",135,1,7,0)="report, 'Report of Same Income', shows veterans who reported the identical"
^DIC(9.4,47,22,5.9,"PAH",135,1,8,0)="income value for all 10 income fields."
^DIC(9.4,47,22,5.9,"PAH",136,0)="232^2990914^1"
^DIC(9.4,47,22,5.9,"PAH",136,1,0)="^^1^1^2990914"
^DIC(9.4,47,22,5.9,"PAH",136,1,1,0)="See the National Patch Module for a complete description of this patch."
^DIC(9.4,47,22,5.9,"PAH",137,0)="224 SEQ #214^2990914^1"
^DIC(9.4,47,22,5.9,"PAH",137,1,0)="^^11^11^2990914"
^DIC(9.4,47,22,5.9,"PAH",137,1,1,0)="E3R 12006 notes that the terms ""Primary Care Physician"" and ""Primary Care"
^DIC(9.4,47,22,5.9,"PAH",137,1,2,0)="Provider"" are used in ways that may be confusing. The Primary Care"
^DIC(9.4,47,22,5.9,"PAH",137,1,3,0)="Provider for the PCMM package is different from the Inpatient Primary Care"
^DIC(9.4,47,22,5.9,"PAH",137,1,4,0)="Provider.  For purposes of clarity, in the PATIENT MOVEMENT file (#405),"
^DIC(9.4,47,22,5.9,"PAH",137,1,5,0)="the field name of field #.08 has been changed from PRIMARY CARE PHYSICIAN"
^DIC(9.4,47,22,5.9,"PAH",137,1,6,0)="to PRIMARY PHYSICIAN."
^DIC(9.4,47,22,5.9,"PAH",137,1,7,0)=" "
^DIC(9.4,47,22,5.9,"PAH",137,1,8,0)="The Data Dictionary for this field is included, as is the DGPM SPECIALTY"
^DIC(9.4,47,22,5.9,"PAH",137,1,9,0)="TRANSFER input template, to accommodate this change."
^DIC(9.4,47,22,5.9,"PAH",137,1,10,0)=" "
^DIC(9.4,47,22,5.9,"PAH",137,1,11,0)="No routines are included."
^DIC(9.4,47,22,5.9,"PAH",138,0)="248 SEQ #215^2990914^1"
^DIC(9.4,47,22,5.9,"PAH",138,1,0)="^^6^6^2990914"
^DIC(9.4,47,22,5.9,"PAH",138,1,1,0)="This patch updates the PTF CENSUS DATE File (#45.86) for the fourth"
^DIC(9.4,47,22,5.9,"PAH",138,1,2,0)="quarter of FY 1999 (7/1/99 - 9/30/1999).  The closeout date for this"
^DIC(9.4,47,22,5.9,"PAH",138,1,3,0)="census is 10/15/99."
^DIC(9.4,47,22,5.9,"PAH",138,1,4,0)=" "
^DIC(9.4,47,22,5.9,"PAH",138,1,5,0)="This patch addresses the Quarterly Census issue discussed in VHA"
^DIC(9.4,47,22,5.9,"PAH",138,1,6,0)="Directive 98-056."
^DIC(9.4,47,22,5.9,"PAH",139,0)="252 SEQ #216^2991003^1"
^DIC(9.4,47,22,5.9,"PAH",139,1,0)="^^6^6^2991003"
^DIC(9.4,47,22,5.9,"PAH",139,1,1,0)="This patch corrects a problem reported when entering breakeven days for"
^DIC(9.4,47,22,5.9,"PAH",139,1,2,0)="multiple DRGs using the Enter Breakeven Days, [DG PTF BREAK EVEN ENTER],"
^DIC(9.4,47,22,5.9,"PAH",139,1,3,0)="option."
^DIC(9.4,47,22,5.9,"PAH",139,1,4,0)=" "
^DIC(9.4,47,22,5.9,"PAH",139,1,5,0)="It was also discovered that this option will not accept fiscal years after"
^DIC(9.4,47,22,5.9,"PAH",139,1,6,0)="1999."
^DIC(9.4,47,22,5.9,"PAH",140,0)="218 SEQ #217^2991003^1"
^DIC(9.4,47,22,5.9,"PAH",140,1,0)="^^1^1^2991003"
^DIC(9.4,47,22,5.9,"PAH",140,1,1,0)="Income Inconsistency for SC veterans 50-100%."
^DIC(9.4,47,22,5.9,"PAH",141,0)="214 SEQ #219^2991003^1"
^DIC(9.4,47,22,5.9,"PAH",141,1,0)="^^9^9^2991003"
^DIC(9.4,47,22,5.9,"PAH",141,1,1,0)="This patch will prevent a user from accessing or creating their own"
^DIC(9.4,47,22,5.9,"PAH",141,1,2,0)="Patient (#2) file entry if the Restrict Patient Record Access (#1201) in"
^DIC(9.4,47,22,5.9,"PAH",141,1,3,0)="the MAS Parameters (#43) file is set to yes and the user does not hold"
^DIC(9.4,47,22,5.9,"PAH",141,1,4,0)="the DG RECORD ACCESS security key. "
^DIC(9.4,47,22,5.9,"PAH",141,1,5,0)=" "
^DIC(9.4,47,22,5.9,"PAH",141,1,6,0)="If the user does not have a SSN defined in the New Person (#200) file they"
^DIC(9.4,47,22,5.9,"PAH",141,1,7,0)="will not be allowed to access any Patient file record.  If the SSN in the"
^DIC(9.4,47,22,5.9,"PAH",141,1,8,0)="New Person file matches the Patient file SSN they will not be allowed to"
^DIC(9.4,47,22,5.9,"PAH",141,1,9,0)="access or create their own Patient file record."
^DIC(9.4,47,22,5.9,"PAH",142,0)="182^2991003^1"
^DIC(9.4,47,22,5.9,"PAH",142,1,0)="^^1^1^2991003"
^DIC(9.4,47,22,5.9,"PAH",142,1,1,0)="See National Patch Module for description of changes included in this patch."
^DIC(9.4,47,22,5.9,"PAH",143,0)="238 SEQ #221^2991003^1"
^DIC(9.4,47,22,5.9,"PAH",143,1,0)="^^1^1^2991003"
^DIC(9.4,47,22,5.9,"PAH",143,1,1,0)="Y2K DGR report fixes"
^DIC(9.4,47,22,5.9,"PAH",144,0)="226 SEQ #222^2991003^1"
^DIC(9.4,47,22,5.9,"PAH",144,1,0)="^^2^2^2991003"
^DIC(9.4,47,22,5.9,"PAH",144,1,1,0)="The changes included in this patch are described in the description"
^DIC(9.4,47,22,5.9,"PAH",144,1,2,0)="of patch DG*5.3*226 in the National Patch Module."
^DIC(9.4,47,22,5.9,"PAH",145,0)="237 SEQ #223^2991019^1"
^DIC(9.4,47,22,5.9,"PAH",145,1,0)="^^1^1^2991019"
^DIC(9.4,47,22,5.9,"PAH",145,1,1,0)="RE-ENROLLMENT - ACTIVATE CD FUNCTIONS"
^DIC(9.4,47,22,5.9,"PAH",146,0)="254 SEQ #224^2991019^1"
^DIC(9.4,47,22,5.9,"PAH",146,1,0)="^^2^2^2991019"
^DIC(9.4,47,22,5.9,"PAH",146,1,1,0)="See National Patch Module for description of changes included in this"
