^DIC(9.4,193,0)="VISTALINK SECURITY^XOBS^SECURITY SUBSYSTEM FOR VISTALINK"
^DIC(9.4,193,1,0)="^9.41A^1^1^3030903^^"
^DIC(9.4,193,1,1,0)="CONTAINS ROUTINES COMPRISING THE SECURITY SUBSYSTEM FOR VISTALINK."
^DIC(9.4,193,5)="OAKLAND"
^DIC(9.4,193,20,0)="^9.402P^^"
^DIC(9.4,193,22,0)="^9.49I^3^3"
^DIC(9.4,193,22,1,0)="1.0^3120508^3031121^1"
^DIC(9.4,193,22,1,1,0)="^^4^4^3120508"
^DIC(9.4,193,22,1,1,1,0)="Contains the client/server M-side security module for VistALink. This"
^DIC(9.4,193,22,1,1,2,0)="module acts mainly as a wrapper around Kernel's login functionality, as"
^DIC(9.4,193,22,1,1,3,0)="well as around the RPC Broker's authorization functionality. VistALink"
^DIC(9.4,193,22,1,1,4,0)="uses this module for end-user authentication and for RPC authorization."
^DIC(9.4,193,22,1,"PAH",0)="^9.4901^1^1"
^DIC(9.4,193,22,1,"PAH",1,0)="2 SEQ #1^3041228^1"
^DIC(9.4,193,22,1,"PAH",1,1,0)="^^3^3^3041228"
^DIC(9.4,193,22,1,"PAH",1,1,1,0)="See the patch description for patch XOBS*1.0*2 on Forum."
^DIC(9.4,193,22,1,"PAH",1,1,2,0)=" "
^DIC(9.4,193,22,1,"PAH",1,1,3,0)="[M Build: 1.0.2.6]"
^DIC(9.4,193,22,1,"PAH","B","2 SEQ #1",1)=""
^DIC(9.4,193,22,2,0)="1.5^3050909^3060608^1"
^DIC(9.4,193,22,2,1,0)="^^6^6^3060608"
^DIC(9.4,193,22,2,1,1,0)="Contains the client/server M-side security module for VistALink. This"
^DIC(9.4,193,22,2,1,2,0)="module acts mainly as a wrapper around Kernel's login functionality, as"
^DIC(9.4,193,22,2,1,3,0)="well as around the RPC Broker's authorization functionality. VistALink"
^DIC(9.4,193,22,2,1,4,0)="uses this module for end-user authentication and for RPC authorization."
^DIC(9.4,193,22,2,1,5,0)=" "
^DIC(9.4,193,22,2,1,6,0)="[Build: 1.5.0.026]"
^DIC(9.4,193,22,3,0)="1.6^3090508^3110120^17"
^DIC(9.4,193,22,3,1,0)="^^4^4^3110120"
^DIC(9.4,193,22,3,1,1,0)="Contains the client/server M-side security module for VistALink. This"
^DIC(9.4,193,22,3,1,2,0)="module acts mainly as a wrapper around Kernel's login functionality, as"
^DIC(9.4,193,22,3,1,3,0)="well as around the RPC Broker's authorization functionality. VistALink"
^DIC(9.4,193,22,3,1,4,0)="uses this module for end-user authentication and for RPC authorization."
^DIC(9.4,193,22,3,"PAH",0)="^9.4901^4^4"
^DIC(9.4,193,22,3,"PAH",1,0)="2 SEQ #1^3180403.154542^54"
^DIC(9.4,193,22,3,"PAH",1,1,0)="^^4^4^3180403"
^DIC(9.4,193,22,3,"PAH",1,1,1,0)="This patch corrects 2 issues within the VISTALINK SECURITY package:"
^DIC(9.4,193,22,3,"PAH",1,1,2,0)=" "
^DIC(9.4,193,22,3,"PAH",1,1,3,0)="Application variables not cleaned up between RPC requests."
^DIC(9.4,193,22,3,"PAH",1,1,4,0)="VistaLink's context variables are not updated properly."
^DIC(9.4,193,22,3,"PAH",2,0)="3^3190201.144656^54"
^DIC(9.4,193,22,3,"PAH",3,0)="4^3221004.133623^89"
^DIC(9.4,193,22,3,"PAH",3,1,0)="^^4^4^3221004"
^DIC(9.4,193,22,3,"PAH",3,1,1,0)="This patch corrects an issue within the VISTALINK package:"
^DIC(9.4,193,22,3,"PAH",3,1,2,0)=" "
^DIC(9.4,193,22,3,"PAH",3,1,3,0)="VistaLink server errors are not respecting the Kernel's limits for logging"
^DIC(9.4,193,22,3,"PAH",3,1,4,0)="errors. "
^DIC(9.4,193,22,3,"PAH",4,0)="6^3260327.111118^90"
