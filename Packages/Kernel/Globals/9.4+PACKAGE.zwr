^DIC(9.4,96,22,1.2,"PAH",28,1,1,0)=" General Information"
^DIC(9.4,96,22,1.2,"PAH",28,1,2,0)=" ======================================================================="
^DIC(9.4,96,22,1.2,"PAH",28,1,3,0)=" The purpose of this patch is for Dental Record Manager to comply with "
^DIC(9.4,96,22,1.2,"PAH",28,1,4,0)=" the ICD-9 changes in the LEX*2.0*45 patch.  The following Dental ICD-9"
^DIC(9.4,96,22,1.2,"PAH",28,1,5,0)=" codes are being inactivated and must be removed from the Dental CPT"
^DIC(9.4,96,22,1.2,"PAH",28,1,6,0)=" Code Mapping table:"
^DIC(9.4,96,22,1.2,"PAH",28,1,7,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,8,0)=" 478.1  Other diseases of nasal cavity and sinuses"
^DIC(9.4,96,22,1.2,"PAH",28,1,9,0)=" 521.8  Other specific diseases of hard tissues of teeth"
^DIC(9.4,96,22,1.2,"PAH",28,1,10,0)=" 523.0  Acute gingivitis"
^DIC(9.4,96,22,1.2,"PAH",28,1,11,0)=" 523.1  Chronic gingivitis"
^DIC(9.4,96,22,1.2,"PAH",28,1,12,0)=" 523.3  Acute periodontitis"
^DIC(9.4,96,22,1.2,"PAH",28,1,13,0)=" 523.4  Chronic periodontitis"
^DIC(9.4,96,22,1.2,"PAH",28,1,14,0)="   "
^DIC(9.4,96,22,1.2,"PAH",28,1,15,0)=" The patch installation process should take be less than 5 minutes."
^DIC(9.4,96,22,1.2,"PAH",28,1,16,0)=" The post installation process may take a few minutes to process the"
^DIC(9.4,96,22,1.2,"PAH",28,1,17,0)=" changes to the DENTAL CPT CODE MAPPING (#228) data.  "
^DIC(9.4,96,22,1.2,"PAH",28,1,18,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,19,0)=" "
^DIC(9.4,96,22,1.2,"PAH",28,1,20,0)=" ENHANCEMENTS TO THE DRM APPLICATION"
^DIC(9.4,96,22,1.2,"PAH",28,1,21,0)=" ======================================================================="
^DIC(9.4,96,22,1.2,"PAH",28,1,22,0)=" The DENTAL CPT CODE MAPPING table has been changed so that any"
^DIC(9.4,96,22,1.2,"PAH",28,1,23,0)=" references to inactivated ICD-9 codes have been replaced or removed."
^DIC(9.4,96,22,1.2,"PAH",28,1,24,0)=" Changes to the national mapping table were made by the Dental Coding"
^DIC(9.4,96,22,1.2,"PAH",28,1,25,0)=" Group members.  The following changes may occur:"
^DIC(9.4,96,22,1.2,"PAH",28,1,26,0)="    "
^DIC(9.4,96,22,1.2,"PAH",28,1,27,0)="    CODE     REMOVE ICD-9    REPLACE with ICD-9"
^DIC(9.4,96,22,1.2,"PAH",28,1,28,0)="    -----    -------------   --------------------------"
