^DIC(9.4,44,22,3,"PAH",102,1,192,0)="Patch Installation:"
^DIC(9.4,44,22,3,"PAH",102,1,193,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,194,0)="Pre/Post Installation Overview:"
^DIC(9.4,44,22,3,"PAH",102,1,195,0)="-------------------------------"
^DIC(9.4,44,22,3,"PAH",102,1,196,0)="N/A"
^DIC(9.4,44,22,3,"PAH",102,1,197,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,198,0)="Pre-Installation Instructions:"
^DIC(9.4,44,22,3,"PAH",102,1,199,0)="------------------------------"
^DIC(9.4,44,22,3,"PAH",102,1,200,0)="N/A "
^DIC(9.4,44,22,3,"PAH",102,1,201,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,202,0)="Installation Instructions:"
^DIC(9.4,44,22,3,"PAH",102,1,203,0)="--------------------------"
^DIC(9.4,44,22,3,"PAH",102,1,204,0)="This patch may be installed with users on the system although it is "
^DIC(9.4,44,22,3,"PAH",102,1,205,0)="recommended that it be installed during non-peak hours to minimize"
^DIC(9.4,44,22,3,"PAH",102,1,206,0)="potential disruption to users.  This patch should take less than 5 minutes"
^DIC(9.4,44,22,3,"PAH",102,1,207,0)="to install."
^DIC(9.4,44,22,3,"PAH",102,1,208,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,209,0)=" 1.     Choose the PackMan message containing this patch."
^DIC(9.4,44,22,3,"PAH",102,1,210,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,211,0)=" 2.     Choose the INSTALL/CHECK MESSAGE PackMan option. "
^DIC(9.4,44,22,3,"PAH",102,1,212,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,213,0)=" 3.     From the Kernel Installation and Distribution System Menu, select "
^DIC(9.4,44,22,3,"PAH",102,1,214,0)="        the Installation Menu.  From this menu, you may elect to use the"
^DIC(9.4,44,22,3,"PAH",102,1,215,0)="        following options. When prompted for the INSTALL NAME enter the"
^DIC(9.4,44,22,3,"PAH",102,1,216,0)="        patch #(ex. GMRC*3.0*154):"
^DIC(9.4,44,22,3,"PAH",102,1,217,0)=" a.     Backup a Transport Global - This option will create a backup "
^DIC(9.4,44,22,3,"PAH",102,1,218,0)="        message of any routines exported with this patch. It will not"
^DIC(9.4,44,22,3,"PAH",102,1,219,0)="        backup any other changes such as DDs or templates."
^DIC(9.4,44,22,3,"PAH",102,1,220,0)=" b.     Compare Transport Global to Current System - This option will "
^DIC(9.4,44,22,3,"PAH",102,1,221,0)="        (allow you to view all changes that will be made when this  "
^DIC(9.4,44,22,3,"PAH",102,1,222,0)="        patch is installed. It compares all components of this patch"
^DIC(9.4,44,22,3,"PAH",102,1,223,0)="        routines, DDs, templates, etc.)."
^DIC(9.4,44,22,3,"PAH",102,1,224,0)=" c.     Verify Checksums in Transport Global - This option will allow you "
^DIC(9.4,44,22,3,"PAH",102,1,225,0)="        to ensure the integrity of the routines that are in the transport"
^DIC(9.4,44,22,3,"PAH",102,1,226,0)="        global."
^DIC(9.4,44,22,3,"PAH",102,1,227,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,228,0)=" 4.      From the Installation Menu, select the Install Package(s) option "
^DIC(9.4,44,22,3,"PAH",102,1,229,0)="         and choose the patch to install."
^DIC(9.4,44,22,3,"PAH",102,1,230,0)="  "
^DIC(9.4,44,22,3,"PAH",102,1,231,0)=" 5.     When prompted 'Want KIDS to INHIBIT LOGONs during the install? "
^DIC(9.4,44,22,3,"PAH",102,1,232,0)="        NO//'"
^DIC(9.4,44,22,3,"PAH",102,1,233,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,234,0)=" 6.     When prompted 'Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,44,22,3,"PAH",102,1,235,0)="        and Protocols? NO//'"
^DIC(9.4,44,22,3,"PAH",102,1,236,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,237,0)=" 7.     If prompted 'Delay Install (Minutes):  (0 - 60): 0//' respond 0."
^DIC(9.4,44,22,3,"PAH",102,1,238,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,239,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,240,0)="Post-Installation Instructions:"
^DIC(9.4,44,22,3,"PAH",102,1,241,0)="-------------------------------"
^DIC(9.4,44,22,3,"PAH",102,1,242,0)="N/A"
^DIC(9.4,44,22,3,"PAH",102,1,243,0)=" "
^DIC(9.4,44,22,3,"PAH",102,1,244,0)="Back-Out Plan:"
^DIC(9.4,44,22,3,"PAH",102,1,245,0)="--------------------"
^DIC(9.4,44,22,3,"PAH",102,1,246,0)="If there is a need to backout this patch. The routine save that was made "
^DIC(9.4,44,22,3,"PAH",102,1,247,0)="at the time of install will need to be used to overwrite the routines in"
^DIC(9.4,44,22,3,"PAH",102,1,248,0)="this patch. Once this is done the other elements included in this patch"
^DIC(9.4,44,22,3,"PAH",102,1,249,0)="will become non-functional and incapable of affecting the system."
^DIC(9.4,44,22,3,"PAH",103,0)="145^3201112.17522^17"
^DIC(9.4,44,22,3,"PAH",103,1,0)="^^5^5^3201112"
^DIC(9.4,44,22,3,"PAH",103,1,1,0)="Consults build to go along with CPRS GUI v31MA (Mission Act), OR*3.0*519."
^DIC(9.4,44,22,3,"PAH",103,1,2,0)="Contains the data dictionary and code changes to implement order save, "
^DIC(9.4,44,22,3,"PAH",103,1,3,0)="edit/resubmit, and view/print of integrated Decision Support Tool "
^DIC(9.4,44,22,3,"PAH",103,1,4,0)="(DST) and Consult Toolbox (CTB) functionality in CPRS GUI."
^DIC(9.4,44,22,3,"PAH",103,1,5,0)="See FORUM patch description for full details."
^DIC(9.4,44,22,3,"PAH",104,0)="163 SEQ #143^3201123.100854^17"
^DIC(9.4,44,22,3,"PAH",105,0)="167 SEQ #145^3210121.164002^17"
^DIC(9.4,44,22,3,"PAH",105,1,0)="^^1^1^3210121"
^DIC(9.4,44,22,3,"PAH",105,1,1,0)="Please see patch description in FORUM."
^DIC(9.4,44,22,3,"PAH",106,0)="168 SEQ #147^3210211.130634^17"
^DIC(9.4,44,22,3,"PAH",106,1,0)="^^2^2^3210211"
^DIC(9.4,44,22,3,"PAH",106,1,1,0)="THIS PATCH ADDRESS THE ISSUE OF NON-PRINTABLE CONTROL CODES BEING SAVED "
^DIC(9.4,44,22,3,"PAH",106,1,2,0)="TO THE CONSULT RECORD."
^DIC(9.4,44,22,3,"PAH",107,0)="171 SEQ #148^3210312.122543^17"
^DIC(9.4,44,22,3,"PAH",107,1,0)="^^1^1^3210312"
^DIC(9.4,44,22,3,"PAH",107,1,1,0)="Please see the patch description in FORUM."
^DIC(9.4,44,22,3,"PAH",108,0)="170 SEQ #149^3210312.122553^17"
^DIC(9.4,44,22,3,"PAH",108,1,0)="^^5^5^3210312"
^DIC(9.4,44,22,3,"PAH",108,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,44,22,3,"PAH",108,1,2,0)=" "
^DIC(9.4,44,22,3,"PAH",108,1,3,0)="The consult auto-discontinue process invokes the discontinue action based "
^DIC(9.4,44,22,3,"PAH",108,1,4,0)="on the first cancellation of a consult even though a consult might have "
^DIC(9.4,44,22,3,"PAH",108,1,5,0)="been resubmitted and cancelled at a later date."
^DIC(9.4,44,22,3,"PAH",109,0)="177b^3210623"
^DIC(9.4,44,22,3,"PAH",109,1,0)="^^5^5^3210623"
^DIC(9.4,44,22,3,"PAH",109,1,1,0)="Backup of GMRC*3.0*177 on Jun 23, 2021"
^DIC(9.4,44,22,3,"PAH",109,1,2,0)=" "
^DIC(9.4,44,22,3,"PAH",109,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,44,22,3,"PAH",109,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,44,22,3,"PAH",109,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,44,22,3,"PAH",110,0)="177 SEQ #150^3210623.113334^17"
^DIC(9.4,44,22,3,"PAH",111,0)="84^3210701.1128^17"
^DIC(9.4,44,22,3,"PAH",112,0)="173b^3210812"
^DIC(9.4,44,22,3,"PAH",112,1,0)="^^5^5^3210812"
^DIC(9.4,44,22,3,"PAH",112,1,1,0)="Backup of GMRC*3.0*173 on Aug 12, 2021"
^DIC(9.4,44,22,3,"PAH",112,1,2,0)=" "
^DIC(9.4,44,22,3,"PAH",112,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,44,22,3,"PAH",112,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,44,22,3,"PAH",112,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,44,22,3,"PAH",113,0)="173 SEQ #153^3210812.111531^17"
^DIC(9.4,44,22,3,"PAH",114,0)="176 SEQ #155^3220315.13154^86"
^DIC(9.4,44,22,3,"PAH",114,1,0)="^^1^1^3220315"
^DIC(9.4,44,22,3,"PAH",114,1,1,0)="Please see patch description in FORUM."
^DIC(9.4,44,22,3,"PAH",115,0)="169 SEQ #156^3220419.123052^86"
^DIC(9.4,44,22,3,"PAH",115,1,0)="^^9^9^3220419"
^DIC(9.4,44,22,3,"PAH",115,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,44,22,3,"PAH",115,1,2,0)="Cross reference AIFC in the REQUEST/CONSULTATION FILE (#123) was found to "
^DIC(9.4,44,22,3,"PAH",115,1,3,0)="have an incorrect field length for the field REMOTE CONSULT FILE ENTRY "
^DIC(9.4,44,22,3,"PAH",115,1,4,0)="(#.06)."
^DIC(9.4,44,22,3,"PAH",115,1,5,0)="The field length for File (#123)/Field (#.06) is 12. The cross reference "
^DIC(9.4,44,22,3,"PAH",115,1,6,0)="AIFC"
^DIC(9.4,44,22,3,"PAH",115,1,7,0)="Field (#.06) length is incorrect at 9."
^DIC(9.4,44,22,3,"PAH",115,1,8,0)="The AIFC cross reference field length will be corrected to 12 numeric "
^DIC(9.4,44,22,3,"PAH",115,1,9,0)="characters and then the AIFC cross reference will be rebuilt."
^DIC(9.4,44,22,3,"PAH",116,0)="186 SEQ #157^3220509.140508^86"
^DIC(9.4,44,22,3,"PAH",117,0)="190 SEQ #158^3220628.154608^86"
