^DIC(9.4,14,22,5.9,"PAH",188,0)="369 SEQ #286^3070905.003807^1"
^DIC(9.4,14,22,5.9,"PAH",188,1,0)="^^2^2^3070905"
^DIC(9.4,14,22,5.9,"PAH",188,1,1,0)="This patch addresses several issues in the Lab Service"
^DIC(9.4,14,22,5.9,"PAH",188,1,2,0)="package."
^DIC(9.4,14,22,5.9,"PAH",189,0)="331 SEQ #287^3070905.004545^1"
^DIC(9.4,14,22,5.9,"PAH",189,1,0)="^^416^416^3070905"
^DIC(9.4,14,22,5.9,"PAH",189,1,1,0)="Blood Bank Clearance"
^DIC(9.4,14,22,5.9,"PAH",189,1,2,0)="===================="
^DIC(9.4,14,22,5.9,"PAH",189,1,3,0)="VISTA Laboratory Package patch LR*5.2*331 contains changes to software"
^DIC(9.4,14,22,5.9,"PAH",189,1,4,0)="controlled by VHA DIRECTIVE 2004-058, titled VISTA BLOOD BANK SOFTWARE."
^DIC(9.4,14,22,5.9,"PAH",189,1,5,0)="Changes include: "
^DIC(9.4,14,22,5.9,"PAH",189,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,7,0)="  The patch will remove the ""AD"" cross-reference from the ACCESSION"
^DIC(9.4,14,22,5.9,"PAH",189,1,8,0)="  field (#15) in the ACCESSION NUMBER sub-file (#68.02) in the"
^DIC(9.4,14,22,5.9,"PAH",189,1,9,0)="  ACCESSION file (#68)."
^DIC(9.4,14,22,5.9,"PAH",189,1,10,0)="  "
^DIC(9.4,14,22,5.9,"PAH",189,1,11,0)="  The IN COMMON ACCESSION field (#15.1) is added to the ACCESSION"
^DIC(9.4,14,22,5.9,"PAH",189,1,12,0)="  NUMBER sub-file (#68.02) of the ACCESSION file (#68)."
^DIC(9.4,14,22,5.9,"PAH",189,1,13,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,14,0)="  STANDARD DATA DICTIONARY #68.02 -- ACCESSION NUMBER SUB-FILE"
^DIC(9.4,14,22,5.9,"PAH",189,1,15,0)="  STORED IN ^LRO(68,D0,1,D1,1,"
^DIC(9.4,14,22,5.9,"PAH",189,1,16,0)="  "
^DIC(9.4,14,22,5.9,"PAH",189,1,17,0)="  DATA        NAME                  GLOBAL        DATA"
^DIC(9.4,14,22,5.9,"PAH",189,1,18,0)="  ELEMENT     TITLE                 LOCATION      TYPE"
^DIC(9.4,14,22,5.9,"PAH",189,1,19,0)="  -----------------------------------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",189,1,20,0)="  "
^DIC(9.4,14,22,5.9,"PAH",189,1,21,0)="  68.02,15    ACCESSION              .2;1 FREE TEXT"
^DIC(9.4,14,22,5.9,"PAH",189,1,22,0)="  "
^DIC(9.4,14,22,5.9,"PAH",189,1,23,0)="             PRINTABLE ACCESSION"
^DIC(9.4,14,22,5.9,"PAH",189,1,24,0)="             INPUT TRANSFORM:  K:X[""""""""!($A(X)=45) X I $D(X) K:$L(X)>15!"
^DIC(9.4,14,22,5.9,"PAH",189,1,25,0)="                               ($L(X)<7) X"
^DIC(9.4,14,22,5.9,"PAH",189,1,26,0)="             LAST EDITED:      MAR 03, 2005"
^DIC(9.4,14,22,5.9,"PAH",189,1,27,0)="             HELP-PROMPT:      ANSWER MUST BE ACCESSION, e.g., CH 0428 125"
^DIC(9.4,14,22,5.9,"PAH",189,1,28,0)="             DESCRIPTION:      The printable form of the Accession is"
^DIC(9.4,14,22,5.9,"PAH",189,1,29,0)="                                 stored here."
^DIC(9.4,14,22,5.9,"PAH",189,1,30,0)="  "
^DIC(9.4,14,22,5.9,"PAH",189,1,31,0)="  "
^DIC(9.4,14,22,5.9,"PAH",189,1,32,0)="  68.02,15.1  IN COMMON ACCESSION    AD;1 FREE TEXT"
^DIC(9.4,14,22,5.9,"PAH",189,1,33,0)="  "
^DIC(9.4,14,22,5.9,"PAH",189,1,34,0)="             INPUT TRANSFORM:  K:$L(X)>15!($L(X)<7) X"
^DIC(9.4,14,22,5.9,"PAH",189,1,35,0)="             LAST EDITED:      MAR 03, 2005"
^DIC(9.4,14,22,5.9,"PAH",189,1,36,0)="             HELP-PROMPT:      Answer must be 7-15 characters in length"
^DIC(9.4,14,22,5.9,"PAH",189,1,37,0)="             DESCRIPTION:      When this accession area is 'in common'"
^DIC(9.4,14,22,5.9,"PAH",189,1,38,0)="                               with another accession area the printable"
^DIC(9.4,14,22,5.9,"PAH",189,1,39,0)="                               form of the 'in common' accession is stored"
^DIC(9.4,14,22,5.9,"PAH",189,1,40,0)="                               here."
^DIC(9.4,14,22,5.9,"PAH",189,1,41,0)="  "
^DIC(9.4,14,22,5.9,"PAH",189,1,42,0)="  The LOG field (#.001) in the ACCESSION NUMBER sub-file (#68.02) of"
^DIC(9.4,14,22,5.9,"PAH",189,1,43,0)="  the ACCESSION file (#68) is modified to increase the upper limit"
^DIC(9.4,14,22,5.9,"PAH",189,1,44,0)="  of accession numbers from 9999 to 999999."
^DIC(9.4,14,22,5.9,"PAH",189,1,45,0)="  "
^DIC(9.4,14,22,5.9,"PAH",189,1,46,0)="     STANDARD DATA DICTIONARY #68.02 -- ACCESSION NUMBER SUB-FILE"
^DIC(9.4,14,22,5.9,"PAH",189,1,47,0)="     STORED IN ^LRO(68,D0,1,D1,1,"
^DIC(9.4,14,22,5.9,"PAH",189,1,48,0)="  "
^DIC(9.4,14,22,5.9,"PAH",189,1,49,0)="     DATA         NAME                  GLOBAL        DATA"
^DIC(9.4,14,22,5.9,"PAH",189,1,50,0)="     ELEMENT      TITLE                 LOCATION      TYPE"
^DIC(9.4,14,22,5.9,"PAH",189,1,51,0)="     --------------------------------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",189,1,52,0)="  "
^DIC(9.4,14,22,5.9,"PAH",189,1,53,0)="     68.02,.001   LOG                                 NUMBER"
^DIC(9.4,14,22,5.9,"PAH",189,1,54,0)="  "
^DIC(9.4,14,22,5.9,"PAH",189,1,55,0)="          INPUT TRANSFORM: K:+X'=X!(X>999999)!(X<1)!(X?.E1"".""1.N) X"
^DIC(9.4,14,22,5.9,"PAH",189,1,56,0)="          LAST EDITED:     MAR 14, 2005"
^DIC(9.4,14,22,5.9,"PAH",189,1,57,0)="          HELP-PROMPT:     Type a number between 1 and 999999, 0 Decimal"
^DIC(9.4,14,22,5.9,"PAH",189,1,58,0)="                           Digits"
^DIC(9.4,14,22,5.9,"PAH",189,1,59,0)="          DESCRIPTION:     The numeric part of the accession."
^DIC(9.4,14,22,5.9,"PAH",189,1,60,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,61,0)="All of the above changes have been reviewed by the VISTA Blood Bank"
^DIC(9.4,14,22,5.9,"PAH",189,1,62,0)="Developer and found to have no impact on the VISTA BLOOD BANK SOFTWARE"
^DIC(9.4,14,22,5.9,"PAH",189,1,63,0)="control functions."
^DIC(9.4,14,22,5.9,"PAH",189,1,64,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,65,0)="RISK ANALYSIS: Changes made by patch LR*5.2*331 have no effect on Blood"
^DIC(9.4,14,22,5.9,"PAH",189,1,66,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",189,1,67,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,68,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*331 does not"
^DIC(9.4,14,22,5.9,"PAH",189,1,69,0)="alter or modify any software design safeguards or safety critical elements"
^DIC(9.4,14,22,5.9,"PAH",189,1,70,0)="functions."
^DIC(9.4,14,22,5.9,"PAH",189,1,71,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,72,0)="POTENTIAL IMPACT ON SITES: This patch contains changes to 0 routines and 1"
^DIC(9.4,14,22,5.9,"PAH",189,1,73,0)="file identified in Veterans Health Administration (VHA) Directive 2004-058,"
^DIC(9.4,14,22,5.9,"PAH",189,1,74,0)="group B listing. The changes have no effect on Blood Bank functionality or"
^DIC(9.4,14,22,5.9,"PAH",189,1,75,0)="medical device control functions. There is no adverse potential to sites."
^DIC(9.4,14,22,5.9,"PAH",189,1,76,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,77,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,78,0)="VALIDATION REQUIREMENTS BY OPTION: "
^DIC(9.4,14,22,5.9,"PAH",189,1,79,0)="There are no validation requirements for this patch."
^DIC(9.4,14,22,5.9,"PAH",189,1,80,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,81,0)="MINIMAL TEST CASE SCENARIOS BY OPTION, INCLUSIVE OF ALL CONTROL FUNCTIONS:"
^DIC(9.4,14,22,5.9,"PAH",189,1,82,0)="There are no test case scenarios for this patch."
^DIC(9.4,14,22,5.9,"PAH",189,1,83,0)="============================================================================"
^DIC(9.4,14,22,5.9,"PAH",189,1,84,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,85,0)="Patch Description:"
^DIC(9.4,14,22,5.9,"PAH",189,1,86,0)="=================="
^DIC(9.4,14,22,5.9,"PAH",189,1,87,0)="This patch addresses 3 issues in the Laboratory package pertaining to "
^DIC(9.4,14,22,5.9,"PAH",189,1,88,0)="accessioning."
^DIC(9.4,14,22,5.9,"PAH",189,1,89,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,90,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,91,0)="ASSOCIATED REMEDY TICKETS:"
^DIC(9.4,14,22,5.9,"PAH",189,1,92,0)="=========================="
^DIC(9.4,14,22,5.9,"PAH",189,1,93,0)="1.  HD0000000071160 - LOCKED ACCESSION AREA"
^DIC(9.4,14,22,5.9,"PAH",189,1,94,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,95,0)="2.  HD0000000093193 - <UNDEFINED>WN1A^LRWLST1"
^DIC(9.4,14,22,5.9,"PAH",189,1,96,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,97,0)="3.  HD0000000102626 - Error -  <SUBSCRIPT>GRID+21^LR7OGMG"
^DIC(9.4,14,22,5.9,"PAH",189,1,98,0)="    Duplicates:  HD0000000102632"
^DIC(9.4,14,22,5.9,"PAH",189,1,99,0)="                 HD0000000103751"
^DIC(9.4,14,22,5.9,"PAH",189,1,100,0)="                 HD0000000112457"
^DIC(9.4,14,22,5.9,"PAH",189,1,101,0)="                 HD0000000122951"
^DIC(9.4,14,22,5.9,"PAH",189,1,102,0)="                 HD0000000131510"
^DIC(9.4,14,22,5.9,"PAH",189,1,103,0)="                 HD0000000138475"
^DIC(9.4,14,22,5.9,"PAH",189,1,104,0)="                 HD0000000138900"
^DIC(9.4,14,22,5.9,"PAH",189,1,105,0)="                 HD0000000142655"
^DIC(9.4,14,22,5.9,"PAH",189,1,106,0)="                 HD0000000154545"
^DIC(9.4,14,22,5.9,"PAH",189,1,107,0)="                 HD0000000155087"
^DIC(9.4,14,22,5.9,"PAH",189,1,108,0)="                 HD0000000160742"
^DIC(9.4,14,22,5.9,"PAH",189,1,109,0)="                 HD0000000170863"
^DIC(9.4,14,22,5.9,"PAH",189,1,110,0)="                 HD0000000179768"
^DIC(9.4,14,22,5.9,"PAH",189,1,111,0)="                 HD0000000180175"
^DIC(9.4,14,22,5.9,"PAH",189,1,112,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,113,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,114,0)="PARTICIPATING TEST SITES:"
^DIC(9.4,14,22,5.9,"PAH",189,1,115,0)="========================="
^DIC(9.4,14,22,5.9,"PAH",189,1,116,0)="ASHEVILLE, NC "
^DIC(9.4,14,22,5.9,"PAH",189,1,117,0)="CENTRAL TEXAS HCS "
^DIC(9.4,14,22,5.9,"PAH",189,1,118,0)="CLEVELAND, OH "
^DIC(9.4,14,22,5.9,"PAH",189,1,119,0)="MARYLAND HCS"
^DIC(9.4,14,22,5.9,"PAH",189,1,120,0)="MILWAUKEE, WI "
^DIC(9.4,14,22,5.9,"PAH",189,1,121,0)="NORTH CHICAGO, IL "
^DIC(9.4,14,22,5.9,"PAH",189,1,122,0)="SALISBURY, NC "
^DIC(9.4,14,22,5.9,"PAH",189,1,123,0)="VA GREATER LOS ANGELES HCS"
^DIC(9.4,14,22,5.9,"PAH",189,1,124,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,125,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,126,0)="REMEDY OVERVIEW:"
^DIC(9.4,14,22,5.9,"PAH",189,1,127,0)="================"
^DIC(9.4,14,22,5.9,"PAH",189,1,128,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,129,0)="1.1. HD0000000071160:"
^DIC(9.4,14,22,5.9,"PAH",189,1,130,0)="---------------------"
^DIC(9.4,14,22,5.9,"PAH",189,1,131,0)="A user reported encountering ""FileMan DBS call failed during accessioning"
^DIC(9.4,14,22,5.9,"PAH",189,1,132,0)="in routine LRWLST1"" MailMan bulletins during accessioning. The generation"
^DIC(9.4,14,22,5.9,"PAH",189,1,133,0)="of this bulletin occurs when Laboratory was making a duplicate FileMan DBS"
^DIC(9.4,14,22,5.9,"PAH",189,1,134,0)="call during accessioning that involved an accession area being 'in common'"
^DIC(9.4,14,22,5.9,"PAH",189,1,135,0)="with another accession area.  This duplicate call would occur when the"
^DIC(9.4,14,22,5.9,"PAH",189,1,136,0)="accession area has a lower internal entry number in ACCESSION file (#68)"
^DIC(9.4,14,22,5.9,"PAH",189,1,137,0)="than the accession area it is 'in common' with."
^DIC(9.4,14,22,5.9,"PAH",189,1,138,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,139,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,140,0)="1.2. HD0000000071160:"
^DIC(9.4,14,22,5.9,"PAH",189,1,141,0)="----------------------"
^DIC(9.4,14,22,5.9,"PAH",189,1,142,0)="During internal software review, the following issues were identified:"
^DIC(9.4,14,22,5.9,"PAH",189,1,143,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,144,0)="  a. It was determined that the ""AD"" CROSS-REFERENCE on ACCESSION field"
^DIC(9.4,14,22,5.9,"PAH",189,1,145,0)="     (#15) in ACCESSION NUMBER sub-file (#68.02) of ACCESSION file (#68)"
^DIC(9.4,14,22,5.9,"PAH",189,1,146,0)="     was not setting the reference to the 'in common' accession correctly"
^DIC(9.4,14,22,5.9,"PAH",189,1,147,0)="     on the accession. The patch will remove this cross-reference from"
^DIC(9.4,14,22,5.9,"PAH",189,1,148,0)="     the data dictionary. See 2b. for storing 'in common' accession"
^DIC(9.4,14,22,5.9,"PAH",189,1,149,0)="     reference."
^DIC(9.4,14,22,5.9,"PAH",189,1,150,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,151,0)="  b. Field IN COMMON ACCESSION (#15.1) in ACCESSION NUMBER sub-file"
^DIC(9.4,14,22,5.9,"PAH",189,1,152,0)="     (#68.02) of ACCESSION file (#68) is added to the data dictionary"
^DIC(9.4,14,22,5.9,"PAH",189,1,153,0)="     to store the reference to the 'in common' accession when this"
^DIC(9.4,14,22,5.9,"PAH",189,1,154,0)="     relationship exists.  Routine LRWLST11 will update this field when"
^DIC(9.4,14,22,5.9,"PAH",189,1,155,0)="     appropriate."
^DIC(9.4,14,22,5.9,"PAH",189,1,156,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,157,0)="   STANDARD DATA DICTIONARY #68.02 -- ACCESSION NUMBER SUB-FILE"
^DIC(9.4,14,22,5.9,"PAH",189,1,158,0)="   STORED IN ^LRO(68,D0,1,D1,1,"
^DIC(9.4,14,22,5.9,"PAH",189,1,159,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,160,0)="   DATA        NAME                  GLOBAL        DATA"
^DIC(9.4,14,22,5.9,"PAH",189,1,161,0)="   ELEMENT     TITLE                 LOCATION      TYPE"
^DIC(9.4,14,22,5.9,"PAH",189,1,162,0)="   -----------------------------------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",189,1,163,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,164,0)="   68.02,15    ACCESSION              .2;1 FREE TEXT"
^DIC(9.4,14,22,5.9,"PAH",189,1,165,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,166,0)="              PRINTABLE ACCESSION"
^DIC(9.4,14,22,5.9,"PAH",189,1,167,0)="              INPUT TRANSFORM:  K:X[""""""""!($A(X)=45) X I $D(X) K:$L(X)>15!"
^DIC(9.4,14,22,5.9,"PAH",189,1,168,0)="                                ($L(X)<7) X"
^DIC(9.4,14,22,5.9,"PAH",189,1,169,0)="              LAST EDITED:      MAR 03, 2005"
^DIC(9.4,14,22,5.9,"PAH",189,1,170,0)="              HELP-PROMPT:      ANSWER MUST BE ACCESSION, e.g., CH 0428 125"
^DIC(9.4,14,22,5.9,"PAH",189,1,171,0)="              DESCRIPTION:      The printable form of the Accession is"
^DIC(9.4,14,22,5.9,"PAH",189,1,172,0)="                                stored here."
^DIC(9.4,14,22,5.9,"PAH",189,1,173,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,174,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,175,0)="   68.02,15.1  IN COMMON ACCESSION    AD;1 FREE TEXT"
^DIC(9.4,14,22,5.9,"PAH",189,1,176,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,177,0)="              INPUT TRANSFORM:  K:$L(X)>15!($L(X)<7) X"
^DIC(9.4,14,22,5.9,"PAH",189,1,178,0)="              LAST EDITED:      MAR 03, 2005"
^DIC(9.4,14,22,5.9,"PAH",189,1,179,0)="              HELP-PROMPT:      Answer must be 7-15 characters in length"
^DIC(9.4,14,22,5.9,"PAH",189,1,180,0)="              DESCRIPTION:      When this accession area is 'in common'"
^DIC(9.4,14,22,5.9,"PAH",189,1,181,0)="                                with another accession area the printable"
^DIC(9.4,14,22,5.9,"PAH",189,1,182,0)="                                form of the 'in common' accession is stored"
^DIC(9.4,14,22,5.9,"PAH",189,1,183,0)="                                here."
^DIC(9.4,14,22,5.9,"PAH",189,1,184,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,185,0)="   c. Field LOG (#.001) in ACCESSION NUMBER sub-file (#68.02) of ACCESSION"
^DIC(9.4,14,22,5.9,"PAH",189,1,186,0)="      file (#68) is modified to increase the upper limit of accession"
^DIC(9.4,14,22,5.9,"PAH",189,1,187,0)="      numbers from 9999 to 999999."
^DIC(9.4,14,22,5.9,"PAH",189,1,188,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,189,0)="      STANDARD DATA DICTIONARY #68.02 -- ACCESSION NUMBER SUB-FILE"
^DIC(9.4,14,22,5.9,"PAH",189,1,190,0)="      STORED IN ^LRO(68,D0,1,D1,1,"
^DIC(9.4,14,22,5.9,"PAH",189,1,191,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,192,0)="      DATA         NAME                  GLOBAL        DATA"
^DIC(9.4,14,22,5.9,"PAH",189,1,193,0)="      ELEMENT      TITLE                 LOCATION      TYPE"
^DIC(9.4,14,22,5.9,"PAH",189,1,194,0)="      --------------------------------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",189,1,195,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,196,0)="      68.02,.001   LOG                                 NUMBER"
^DIC(9.4,14,22,5.9,"PAH",189,1,197,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,198,0)="           INPUT TRANSFORM: K:+X'=X!(X>999999)!(X<1)!(X?.E1"".""1.N) X"
^DIC(9.4,14,22,5.9,"PAH",189,1,199,0)="           LAST EDITED:     MAR 14, 2005"
^DIC(9.4,14,22,5.9,"PAH",189,1,200,0)="           HELP-PROMPT:     Type a number between 1 and 999999, 0 Decimal"
^DIC(9.4,14,22,5.9,"PAH",189,1,201,0)="                            Digits"
^DIC(9.4,14,22,5.9,"PAH",189,1,202,0)="           DESCRIPTION:     The numeric part of the accession."
^DIC(9.4,14,22,5.9,"PAH",189,1,203,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,204,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,205,0)="   d. The functionality to allow the user to force an accession to a"
^DIC(9.4,14,22,5.9,"PAH",189,1,206,0)="      specific number could cause a 'stack overflow' error due to how the"
^DIC(9.4,14,22,5.9,"PAH",189,1,207,0)="      M NEW command was implemented. Coding changes to LRWLST1 will only"
^DIC(9.4,14,22,5.9,"PAH",189,1,208,0)="      NEW certain variables once."
^DIC(9.4,14,22,5.9,"PAH",189,1,209,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,210,0)="   e. Direct READs in routine LRWLST1 have been replaced with FileMan"
^DIC(9.4,14,22,5.9,"PAH",189,1,211,0)="      supported DIR reader API calls."
^DIC(9.4,14,22,5.9,"PAH",189,1,212,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,213,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,214,0)="2. HD0000000093193:"
^DIC(9.4,14,22,5.9,"PAH",189,1,215,0)="-------------------"
^DIC(9.4,14,22,5.9,"PAH",189,1,216,0)="A user reported an <UNDEFINED>WN1A^LRWLST1 error when accessioning. This"
^DIC(9.4,14,22,5.9,"PAH",189,1,217,0)="would occur when attempting to force an accession number for an accession"
^DIC(9.4,14,22,5.9,"PAH",189,1,218,0)="area that did not have any accessions for the current accession day."
^DIC(9.4,14,22,5.9,"PAH",189,1,219,0)="Routine LRWLST1 will now handle displaying a default accession number 1"
^DIC(9.4,14,22,5.9,"PAH",189,1,220,0)="when there are no existing accessions for the current accession day."
^DIC(9.4,14,22,5.9,"PAH",189,1,221,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,222,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,223,0)="3. HD0000000102626:"
^DIC(9.4,14,22,5.9,"PAH",189,1,224,0)="-------------------"
^DIC(9.4,14,22,5.9,"PAH",189,1,225,0)="A user reported a <SUBSCRIPT>GRID+21^LR7OGMG error when using the CPRS Lab"
^DIC(9.4,14,22,5.9,"PAH",189,1,226,0)="Reports tab to display recent laboratory results.  This would occur when"
^DIC(9.4,14,22,5.9,"PAH",189,1,227,0)="there are three or more tests on an accession, at least two of the tests"
^DIC(9.4,14,22,5.9,"PAH",189,1,228,0)="were performed at different laboratories and a third test had a 'pending'"
^DIC(9.4,14,22,5.9,"PAH",189,1,229,0)="result and therefore no performing laboratory designated.  The software"
^DIC(9.4,14,22,5.9,"PAH",189,1,230,0)="was attempting to determine the performing laboratory for the pending"
^DIC(9.4,14,22,5.9,"PAH",189,1,231,0)="test. Routine LR7OGMG will now ignore tests that do not have a performing"
^DIC(9.4,14,22,5.9,"PAH",189,1,232,0)="laboratory when constructing the list of performing laboratories"
^DIC(9.4,14,22,5.9,"PAH",189,1,233,0)="associated with an accession's test results."
^DIC(9.4,14,22,5.9,"PAH",189,1,234,0)="     "
^DIC(9.4,14,22,5.9,"PAH",189,1,235,0)="  "
^DIC(9.4,14,22,5.9,"PAH",189,1,236,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",189,1,237,0)="-------------------------"
^DIC(9.4,14,22,5.9,"PAH",189,1,238,0)="  The install time for this patch is less than 5 minute. This patch"
^DIC(9.4,14,22,5.9,"PAH",189,1,239,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,14,22,5.9,"PAH",189,1,240,0)="  Suggested time to install: non-peak requirement hours."
^DIC(9.4,14,22,5.9,"PAH",189,1,241,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,242,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,243,0)="NOTE: Kernel patches must be current on the target system to avoid"
^DIC(9.4,14,22,5.9,"PAH",189,1,244,0)="      problems loading and/or installing this patch."
^DIC(9.4,14,22,5.9,"PAH",189,1,245,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,246,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,14,22,5.9,"PAH",189,1,247,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,14,22,5.9,"PAH",189,1,248,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,249,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,250,0)="  1.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,14,22,5.9,"PAH",189,1,251,0)="        option will load the KIDS package onto your system."
^DIC(9.4,14,22,5.9,"PAH",189,1,252,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,253,0)="  2.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,14,22,5.9,"PAH",189,1,254,0)="      select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",189,1,255,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,256,0)="  3.  From this menu, you may then elect to use the following options"
^DIC(9.4,14,22,5.9,"PAH",189,1,257,0)="      (when prompted for the INSTALL NAME, enter LR*5.2*331):"
^DIC(9.4,14,22,5.9,"PAH",189,1,258,0)="        a. Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",189,1,259,0)="        b. Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",189,1,260,0)="        c. Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",189,1,261,0)="        d. Verify Checksums in Transport Global"
^DIC(9.4,14,22,5.9,"PAH",189,1,262,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,263,0)="      Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,14,22,5.9,"PAH",189,1,264,0)="      all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",189,1,265,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,266,0)="  4.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,14,22,5.9,"PAH",189,1,267,0)="      and select the package 'LR*5.2*331'."
^DIC(9.4,14,22,5.9,"PAH",189,1,268,0)="    "
^DIC(9.4,14,22,5.9,"PAH",189,1,269,0)="      When prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,14,22,5.9,"PAH",189,1,270,0)="      Install? YES//' choose 'NO'. Responding 'Yes' to the prompt for"
^DIC(9.4,14,22,5.9,"PAH",189,1,271,0)="      rebuilding menu trees can significantly increase install time."
^DIC(9.4,14,22,5.9,"PAH",189,1,272,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,273,0)="      When prompted 'Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,14,22,5.9,"PAH",189,1,274,0)="      YES// choose 'NO'. "
^DIC(9.4,14,22,5.9,"PAH",189,1,275,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,276,0)="      When prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,14,22,5.9,"PAH",189,1,277,0)="      Protocols? YES//', choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",189,1,278,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,279,0)="     The install will automatically disable the following options:"
^DIC(9.4,14,22,5.9,"PAH",189,1,280,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,281,0)="       Accession order then immediately enter data [LR ACC THEN DATA]"
^DIC(9.4,14,22,5.9,"PAH",189,1,282,0)="       Batch data entry (chem, hem, tox, etc.) [LRSTUF]"
^DIC(9.4,14,22,5.9,"PAH",189,1,283,0)="       Bypass normal data entry [LRFAST]"
^DIC(9.4,14,22,5.9,"PAH",189,1,284,0)="       Fast Bypass Data Entry/Verify [LRFASTS]"
^DIC(9.4,14,22,5.9,"PAH",189,1,285,0)="       Special test accessioning [LRNONCOM]"
^DIC(9.4,14,22,5.9,"PAH",189,1,286,0)="       Merge Accessions [LRACC MERGE]"
^DIC(9.4,14,22,5.9,"PAH",189,1,287,0)="       Add tests to a given accession [LRADD TO ACC]"
^DIC(9.4,14,22,5.9,"PAH",189,1,288,0)="       Add tests to an already existing order number. [LRADD TO ORDER]"
^DIC(9.4,14,22,5.9,"PAH",189,1,289,0)="       Lab add test(s) to an existing order [LRADDTST]"
^DIC(9.4,14,22,5.9,"PAH",189,1,290,0)="       Delete entire order or individual tests [LRCENDEL]"
^DIC(9.4,14,22,5.9,"PAH",189,1,291,0)="       Remove an accession [LRDELOG]"
^DIC(9.4,14,22,5.9,"PAH",189,1,292,0)="       Referral Patient Multi-purpose Accession [LRLEDI]"
^DIC(9.4,14,22,5.9,"PAH",189,1,293,0)="       Accessioning, standard (Microbiology) [LRMICROLOGIN]"
^DIC(9.4,14,22,5.9,"PAH",189,1,294,0)="       Accessioning tests ordered by ward order entry [LROE]"
^DIC(9.4,14,22,5.9,"PAH",189,1,295,0)="       Lab test order [LROW]"
^DIC(9.4,14,22,5.9,"PAH",189,1,296,0)="       Fast lab test order (IMMEDIATE COLLECT) [LROW IMMED COLLECT]"
^DIC(9.4,14,22,5.9,"PAH",189,1,297,0)="       Fast lab test order (ROUTINE) [LROW ROUTINE]"
^DIC(9.4,14,22,5.9,"PAH",189,1,298,0)="       Fast lab test order (SEND PATIENT) [LROW SEND PAT]"
^DIC(9.4,14,22,5.9,"PAH",189,1,299,0)="       Fast lab test order (WARD COLLECT) [LROW WARD COL]"
^DIC(9.4,14,22,5.9,"PAH",189,1,300,0)="       Receipt of routine lab collection from wards [LRPHEXCPT]"
^DIC(9.4,14,22,5.9,"PAH",189,1,301,0)="       Itemized routine lab collection [LRPHITEM]"
^DIC(9.4,14,22,5.9,"PAH",189,1,302,0)="       Manually accession QC, Environmental, etc. [LRQCLOG]"
^DIC(9.4,14,22,5.9,"PAH",189,1,303,0)="       Multipurpose accessioning [LRQUICK]"
^DIC(9.4,14,22,5.9,"PAH",189,1,304,0)="       Delete test from an accession [LRTSTOUT]"
^DIC(9.4,14,22,5.9,"PAH",189,1,305,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,306,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,307,0)=" Note: Routine LR331 will be deleted after successful patch installation. "
^DIC(9.4,14,22,5.9,"PAH",189,1,308,0)=" "
^DIC(9.4,14,22,5.9,"PAH",189,1,309,0)="  "
^DIC(9.4,14,22,5.9,"PAH",189,1,310,0)="INSTALLATION EXAMPLE"
