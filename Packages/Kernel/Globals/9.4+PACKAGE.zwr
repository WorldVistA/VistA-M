^DIC(9.4,14,22,5.9,"PAH",5,1,241,0)="LRCAPPH1                NA                3477475           127"
^DIC(9.4,14,22,5.9,"PAH",5,1,242,0)="LRCAPV1A                2080378           2090945           105,127"
^DIC(9.4,14,22,5.9,"PAH",6,0)="136 SEQ #99^2961011^1"
^DIC(9.4,14,22,5.9,"PAH",6,1,0)="^^28^28^2961011"
^DIC(9.4,14,22,5.9,"PAH",6,1,1,0)="Patch LR*5.2*127 is required to be installed."
^DIC(9.4,14,22,5.9,"PAH",6,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",6,1,3,0)="1) This patch corrects the problem of multiple LRCAPPH jobs running and"
^DIC(9.4,14,22,5.9,"PAH",6,1,4,0)="the same time when only one is required. This problem appears when the"
^DIC(9.4,14,22,5.9,"PAH",6,1,5,0)="system has slow response times and LRCAPPH jobs begin to accumulate."
^DIC(9.4,14,22,5.9,"PAH",6,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",6,1,7,0)="2) This patch also correct a variable used to for system response"
^DIC(9.4,14,22,5.9,"PAH",6,1,8,0)="monitoring."
^DIC(9.4,14,22,5.9,"PAH",6,1,9,0)=" "
^DIC(9.4,14,22,5.9,"PAH",6,1,10,0)="Routines      Before Check Sum        After Check Sum   Patch List"
^DIC(9.4,14,22,5.9,"PAH",6,1,11,0)="=================================================================="
^DIC(9.4,14,22,5.9,"PAH",6,1,12,0)=" "
^DIC(9.4,14,22,5.9,"PAH",6,1,13,0)="LRCAPPH      10523848                 10492287          1,19,127,136"
^DIC(9.4,14,22,5.9,"PAH",6,1,14,0)=" "
^DIC(9.4,14,22,5.9,"PAH",6,1,15,0)="==================================================================="
^DIC(9.4,14,22,5.9,"PAH",6,1,16,0)=" "
^DIC(9.4,14,22,5.9,"PAH",6,1,17,0)="Note: Patch LR*5.2*127 MUST be installed before this patch is installed. "
^DIC(9.4,14,22,5.9,"PAH",6,1,18,0)=" "
^DIC(9.4,14,22,5.9,"PAH",6,1,19,0)="1. Users may remain on the system."
^DIC(9.4,14,22,5.9,"PAH",6,1,20,0)="2. No options need be placed out of order."
^DIC(9.4,14,22,5.9,"PAH",6,1,21,0)="3. Install patch during non-peak hours."
^DIC(9.4,14,22,5.9,"PAH",6,1,22,0)="4. Laboratory specimens should not be accessioned or verified during"
^DIC(9.4,14,22,5.9,"PAH",6,1,23,0)="installation of the patch."
^DIC(9.4,14,22,5.9,"PAH",6,1,24,0)="5. Auto-instrument LAB routines does not have to be stopped."
^DIC(9.4,14,22,5.9,"PAH",6,1,25,0)=" "
^DIC(9.4,14,22,5.9,"PAH",6,1,26,0)="NOIS List"
^DIC(9.4,14,22,5.9,"PAH",6,1,27,0)="MIN-0996-41784"
^DIC(9.4,14,22,5.9,"PAH",6,1,28,0)="MIA-1096-30234"
^DIC(9.4,14,22,5.9,"PAH",7,0)="59 SEQ #100^2961017^1"
^DIC(9.4,14,22,5.9,"PAH",7,1,0)="^^1^1^2961023^^"
^DIC(9.4,14,22,5.9,"PAH",7,1,1,0)="Lab Archiving Enhancement Patch"
^DIC(9.4,14,22,5.9,"PAH",8,0)="101 SEQ #101^2961107^1"
^DIC(9.4,14,22,5.9,"PAH",8,1,0)="^^1^1^2961107"
^DIC(9.4,14,22,5.9,"PAH",8,1,1,0)="DETAILED WORKLOAD REPORT"
^DIC(9.4,14,22,5.9,"PAH",9,0)="126 SEQ #102^2961107^1"
^DIC(9.4,14,22,5.9,"PAH",9,1,0)="^^1^1^2961107"
^DIC(9.4,14,22,5.9,"PAH",9,1,1,0)="FIX FOR PATCH 108"
^DIC(9.4,14,22,5.9,"PAH",10,0)="138 SEQ #103^2961108^1"
^DIC(9.4,14,22,5.9,"PAH",10,1,0)="^^411^411^2961108"
^DIC(9.4,14,22,5.9,"PAH",10,1,1,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,2,0)="This is a joint Radiology, PIMS, PCE, VSIT, National Patient Care Database"
^DIC(9.4,14,22,5.9,"PAH",10,1,3,0)="(NPCDB) and Laboratory patch. This patch will not successfully install if"
^DIC(9.4,14,22,5.9,"PAH",10,1,4,0)="the Scheduling Package SD*5.3*63 patch has not been installed."
^DIC(9.4,14,22,5.9,"PAH",10,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,6,0)="    Patches should be installed in the following order:"
^DIC(9.4,14,22,5.9,"PAH",10,1,7,0)="      SD*5.3*63  (Scheduling)"
^DIC(9.4,14,22,5.9,"PAH",10,1,8,0)="      RA*4.5*8   (Radiology/Nuclear Med)"
^DIC(9.4,14,22,5.9,"PAH",10,1,9,0)="      LR*5.2*138 (Laboratory ** this patch **)"
^DIC(9.4,14,22,5.9,"PAH",10,1,10,0)="      VSIT*2*1   (Visit Tracking)"
^DIC(9.4,14,22,5.9,"PAH",10,1,11,0)="      PX*1*9     (PCE)"
^DIC(9.4,14,22,5.9,"PAH",10,1,12,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,13,0)="Patch SD*5.3*63 must be installed before the installation LR*5.2*138."
^DIC(9.4,14,22,5.9,"PAH",10,1,14,0)="The sequence of patch installs for either RA*4.5*8 or LR*5.2*138 is not"
^DIC(9.4,14,22,5.9,"PAH",10,1,15,0)="important. The RA*4.5*8 and LR*5.2*138 can be installed in reverse order."
^DIC(9.4,14,22,5.9,"PAH",10,1,16,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,17,0)="The Laboratory Information Manager (LIM) should be notified of the patch"
^DIC(9.4,14,22,5.9,"PAH",10,1,18,0)="installation schedule and the date/time of the actual LR*5.2*138"
^DIC(9.4,14,22,5.9,"PAH",10,1,19,0)="installation."
^DIC(9.4,14,22,5.9,"PAH",10,1,20,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,21,0)="Site Preparation notice:"
^DIC(9.4,14,22,5.9,"PAH",10,1,22,0)="This patch and LMIP workload reporting rely on the STATION NUMBER (#99) in"
^DIC(9.4,14,22,5.9,"PAH",10,1,23,0)="the INSTITUTION file (#4) being correctly defined. New OOS HOSPITAL"
^DIC(9.4,14,22,5.9,"PAH",10,1,24,0)="LOCATION names will be based on this field. The user can not control how a"
^DIC(9.4,14,22,5.9,"PAH",10,1,25,0)="new LAB OOS LOCATIONS will be named. The name will be based on the"
^DIC(9.4,14,22,5.9,"PAH",10,1,26,0)="INSTITUTION file setup."
^DIC(9.4,14,22,5.9,"PAH",10,1,27,0)="==============================="
^DIC(9.4,14,22,5.9,"PAH",10,1,28,0)="Purpose of the patch:"
^DIC(9.4,14,22,5.9,"PAH",10,1,29,0)="1. Correct collection of NPCDB laboratory workload."
^DIC(9.4,14,22,5.9,"PAH",10,1,30,0)="2. Create LAB Occasion of Service (OOS) LOCATIONS for the purpose of PCE"
^DIC(9.4,14,22,5.9,"PAH",10,1,31,0)="   reporting."
^DIC(9.4,14,22,5.9,"PAH",10,1,32,0)="3. Provide immediate functionality without LIM intervention."
^DIC(9.4,14,22,5.9,"PAH",10,1,33,0)="4. Provide data clean up of previously reported NPCDB workload (PX*1*9)."
^DIC(9.4,14,22,5.9,"PAH",10,1,34,0)="5. Provide utilities to manage multi-divisional NPCDB workload."
^DIC(9.4,14,22,5.9,"PAH",10,1,35,0)="6. Provide capabilities to support non Pathology & Laboratory Medicine"
^DIC(9.4,14,22,5.9,"PAH",10,1,36,0)="   services to receive proper NPCDB workload credit."
^DIC(9.4,14,22,5.9,"PAH",10,1,37,0)="7. Enhancement of the Laboratory NPCDB reporting capabilities."
^DIC(9.4,14,22,5.9,"PAH",10,1,38,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,39,0)="This patch will not effect LMIP workload capture or DSS Laboratory"
^DIC(9.4,14,22,5.9,"PAH",10,1,40,0)="workload data extraction. There are no CPT code updates contained in this"
^DIC(9.4,14,22,5.9,"PAH",10,1,41,0)="patch."
^DIC(9.4,14,22,5.9,"PAH",10,1,42,0)="=============================="
^DIC(9.4,14,22,5.9,"PAH",10,1,43,0)="Problem:"
^DIC(9.4,14,22,5.9,"PAH",10,1,44,0)="Scheduling software determines if a particular procedure requires patient"
^DIC(9.4,14,22,5.9,"PAH",10,1,45,0)="diagnosis based on the HOSPITAL LOCATION file setup. The Laboratory was"
^DIC(9.4,14,22,5.9,"PAH",10,1,46,0)="passing the ordering location without patient diagnosis. This produced"
^DIC(9.4,14,22,5.9,"PAH",10,1,47,0)="NPCDB workload recording errors because of no diagnosis being passed."
^DIC(9.4,14,22,5.9,"PAH",10,1,48,0)="  Some packages still use Clinic Stop codes to identify certain kinds of"
^DIC(9.4,14,22,5.9,"PAH",10,1,49,0)="data. The Stop Codes were determined based on the HOSPITAL LOCATION file"
^DIC(9.4,14,22,5.9,"PAH",10,1,50,0)="setup. The Stop Code passed by Laboratory to the PCE API was not being"
^DIC(9.4,14,22,5.9,"PAH",10,1,51,0)="used."
^DIC(9.4,14,22,5.9,"PAH",10,1,52,0)="============================"
^DIC(9.4,14,22,5.9,"PAH",10,1,53,0)="Problem Solution"
^DIC(9.4,14,22,5.9,"PAH",10,1,54,0)="New OOS HOSPITAL LOCATIONS will be created solely for Laboratory NPCDB"
^DIC(9.4,14,22,5.9,"PAH",10,1,55,0)="Workload reporting. These new locations can not be used for appointments"
^DIC(9.4,14,22,5.9,"PAH",10,1,56,0)="or as test ordering locations. These special OOS locations will be"
^DIC(9.4,14,22,5.9,"PAH",10,1,57,0)="configured to not require diagnosis, eliminating the current errors."
^DIC(9.4,14,22,5.9,"PAH",10,1,58,0)="   The Scheduling software will use these special hospital (non diagnosis"
^DIC(9.4,14,22,5.9,"PAH",10,1,59,0)="requiring) locations when passing workload to NPCDB. Upon initial install"
^DIC(9.4,14,22,5.9,"PAH",10,1,60,0)="all workload will be reported as laboratory Stop Code 108 for the Primary"
^DIC(9.4,14,22,5.9,"PAH",10,1,61,0)="Institution as defined by LMIP Workload Collection file (#67.9). Options"
^DIC(9.4,14,22,5.9,"PAH",10,1,62,0)="are provided to allow the LIM to create additional OOS Hospital Locations."
^DIC(9.4,14,22,5.9,"PAH",10,1,63,0)="The naming of the OOS locations is controlled by the a option included in"
^DIC(9.4,14,22,5.9,"PAH",10,1,64,0)="this patch."
^DIC(9.4,14,22,5.9,"PAH",10,1,65,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,66,0)="NOTE: The LIM can not edit the Hospital Location file directly. They can"
^DIC(9.4,14,22,5.9,"PAH",10,1,67,0)="only do so via a special option. LAB OOS LOCATIONS should not be created"
^DIC(9.4,14,22,5.9,"PAH",10,1,68,0)="through VA FileMan."
^DIC(9.4,14,22,5.9,"PAH",10,1,69,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,70,0)="=============================="
^DIC(9.4,14,22,5.9,"PAH",10,1,71,0)="Workload Reporting Logic:"
^DIC(9.4,14,22,5.9,"PAH",10,1,72,0)="1. Only collected specimens will be processed by the software."
^DIC(9.4,14,22,5.9,"PAH",10,1,73,0)="2. Only laboratory specimens having a collection type of Immediate "
^DIC(9.4,14,22,5.9,"PAH",10,1,74,0)="Collect, Send Patient or Lab Collect will receive phlebotomy Workload"
^DIC(9.4,14,22,5.9,"PAH",10,1,75,0)="credit."
^DIC(9.4,14,22,5.9,"PAH",10,1,76,0)="3. Only those specimens with a HOSPITAL LOCATION type of Clinic, Module or"
^DIC(9.4,14,22,5.9,"PAH",10,1,77,0)="Other will be passed to PCE API. This is not dependent on specimen"
^DIC(9.4,14,22,5.9,"PAH",10,1,78,0)="collection type"
^DIC(9.4,14,22,5.9,"PAH",10,1,79,0)="4. No new WKLD CODE CPT codes are included in this patch. Those linked"
^DIC(9.4,14,22,5.9,"PAH",10,1,80,0)="LABORATORY TESTS without CPT codes will not be passed to PCE API. Another"
^DIC(9.4,14,22,5.9,"PAH",10,1,81,0)="Laboratory patch will fully populate the WKLD CODE file with CPT codes."
^DIC(9.4,14,22,5.9,"PAH",10,1,82,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,83,0)="NOTE: The DEFAULT LAB OOS LOCATION field is populated during the post"
^DIC(9.4,14,22,5.9,"PAH",10,1,84,0)="install. This field is used by NPCDB Laboratory workload reporting"
^DIC(9.4,14,22,5.9,"PAH",10,1,85,0)="software if a specific ACCESSION AREA does not have a LAB OOS LOCATION"
^DIC(9.4,14,22,5.9,"PAH",10,1,86,0)="assigned."
^DIC(9.4,14,22,5.9,"PAH",10,1,87,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,88,0)="  A tasked routine will inspect the LAB ORDER ENTRY (#69) file for"
^DIC(9.4,14,22,5.9,"PAH",10,1,89,0)="collected specimens. When it finds a patient with collected specimen(s)"
^DIC(9.4,14,22,5.9,"PAH",10,1,90,0)="the software will use the above logic steps to determine if the specimen"
^DIC(9.4,14,22,5.9,"PAH",10,1,91,0)="meets criteria. If the specimens meets criteria, the software checks the"
^DIC(9.4,14,22,5.9,"PAH",10,1,92,0)="ACCESSION AREA where the specimen was accessioned. The accessioned test(s)"
^DIC(9.4,14,22,5.9,"PAH",10,1,93,0)="does not need to be verified in order to trigger NPCDB or LMIP Phlebotomy"
^DIC(9.4,14,22,5.9,"PAH",10,1,94,0)="workload reporting. If the ACCESSION AREA has a LAB OOS LOCATION defined"
^DIC(9.4,14,22,5.9,"PAH",10,1,95,0)="the API will pass that location. If the ACCESSION AREA does not have a LAB"
^DIC(9.4,14,22,5.9,"PAH",10,1,96,0)="OOS LOCATION defined, the DEFAULT LAB OOS LOCATION will be passed."
^DIC(9.4,14,22,5.9,"PAH",10,1,97,0)=" "
^DIC(9.4,14,22,5.9,"PAH",10,1,98,0)="======================================="
^DIC(9.4,14,22,5.9,"PAH",10,1,99,0)="ROUTINE SUMMARY:"
^DIC(9.4,14,22,5.9,"PAH",10,1,100,0)="================="
^DIC(9.4,14,22,5.9,"PAH",10,1,101,0)=" Routine Name           Before Patch      After Patch       Patch List"
