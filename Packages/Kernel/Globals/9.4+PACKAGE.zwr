^DIC(9.4,11,22,5.03,"PAH",36,1,397,0)="--------------"
^DIC(9.4,11,22,5.03,"PAH",36,1,398,0)=" None"
^DIC(9.4,11,22,5.03,"PAH",36,1,399,0)=" "
