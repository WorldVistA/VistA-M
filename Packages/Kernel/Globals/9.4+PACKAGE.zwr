^DIC(9.4,4,22,2,"PAH",2,1,107,0)=" DEVICE: HOME// <You may queue it if you wish>"
^DIC(9.4,4,22,2,"PAH",2,1,108,0)="                ------------------------------"
^DIC(9.4,4,22,2,"PAH",2,1,109,0)="6. DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,2,"PAH",2,1,110,0)="7. In the TCP/IP DEVICE (#8.25) field of the MAILMAN SITE PARAMETERS (#4.3)"
^DIC(9.4,4,22,2,"PAH",2,1,111,0)="   file, enter the name of the device used at your site for TCP/IP scripts."
^DIC(9.4,4,22,2,"PAH",2,1,112,0)="   If you don't know it, you can find it by doing a FileMan Inquiry for FORUM"
^DIC(9.4,4,22,2,"PAH",2,1,113,0)="   (or any other domain with a TCP/IP script) in the DOMAIN (#4.2) file:"
^DIC(9.4,4,22,2,"PAH",2,1,114,0)=""
^DIC(9.4,4,22,2,"PAH",2,1,115,0)="Select OPTION: INQUIRE TO FILE ENTRIES"
^DIC(9.4,4,22,2,"PAH",2,1,116,0)="OUTPUT FROM WHAT FILE: DEVICE// 4.2  DOMAIN  (548 entries)"
^DIC(9.4,4,22,2,"PAH",2,1,117,0)="Select DOMAIN NAME: DOMAIN.EXT"
^DIC(9.4,4,22,2,"PAH",2,1,118,0)="ANOTHER ONE:"
^DIC(9.4,4,22,2,"PAH",2,1,119,0)="STANDARD CAPTIONED OUTPUT? Yes//   (Yes)"
^DIC(9.4,4,22,2,"PAH",2,1,120,0)="Include COMPUTED fields:  (N/Y/R/B): NO//  - No record number (IEN), no"
^DIC(9.4,4,22,2,"PAH",2,1,121,0)=" Computed Fields"
^DIC(9.4,4,22,2,"PAH",2,1,122,0)=""
^DIC(9.4,4,22,2,"PAH",2,1,123,0)="NAME: DOMAIN.EXT                      FLAGS: S"
^DIC(9.4,4,22,2,"PAH",2,1,124,0)="  PHYSICAL LINK DEVICE: NULL DEVICE  <<< 2nd choice <<<"
^DIC(9.4,4,22,2,"PAH",2,1,125,0)="TRANSMISSION SCRIPT: TCP/IP             PRIORITY: 5"
^DIC(9.4,4,22,2,"PAH",2,1,126,0)="  NUMBER OF ATTEMPTS: 30                TYPE: Simple Mail Transfer Protocol"
^DIC(9.4,4,22,2,"PAH",2,1,127,0)="  PHYSICAL LINK / DEVICE: NULL DEVICE  <<< 1st choice <<<"
^DIC(9.4,4,22,2,"PAH",2,1,128,0)=""
^DIC(9.4,4,22,2,"PAH",2,1,129,0)="Your first choice for the device is the one in the TCP/IP script.  If there"
^DIC(9.4,4,22,2,"PAH",2,1,130,0)="isn't any there, then your second choice is as indicated.  Note:"
^DIC(9.4,4,22,2,"PAH",2,1,131,0)="- Not all of the fields are shown in this example."
^DIC(9.4,4,22,2,"PAH",2,1,132,0)="- Your TCP/IP script may have a different name from the one shown."
^DIC(9.4,4,22,2,"PAH",2,1,133,0)="- Your device may have a different name from the one shown."
^DIC(9.4,4,22,2,"PAH",2,1,134,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",3,0)="5 SEQ #3^3020927^1"
^DIC(9.4,4,22,2,"PAH",3,1,0)="^^60^60^3020927"
^DIC(9.4,4,22,2,"PAH",3,1,1,0)="Patch XM*8.0*5"
^DIC(9.4,4,22,2,"PAH",3,1,2,0)=""
^DIC(9.4,4,22,2,"PAH",3,1,3,0)="NOIS: HIN-0902-41106"
^DIC(9.4,4,22,2,"PAH",3,1,4,0)="Test Site:  FORUM"
^DIC(9.4,4,22,2,"PAH",3,1,5,0)="If you do a search for messages, and then forward 2 of them to a remote site,"
^DIC(9.4,4,22,2,"PAH",3,1,6,0)="MailMan tells you that it forwarded 4 messages.  This patch fixes that."
^DIC(9.4,4,22,2,"PAH",3,1,7,0)=""
^DIC(9.4,4,22,2,"PAH",3,1,8,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",3,1,9,0)="is at a minimum. It has no patch prerequisites, except, of course, that"
^DIC(9.4,4,22,2,"PAH",3,1,10,0)="MailMan 8.0 be installed."
^DIC(9.4,4,22,2,"PAH",3,1,11,0)="============================================================================ "
^DIC(9.4,4,22,2,"PAH",3,1,12,0)=""
^DIC(9.4,4,22,2,"PAH",3,1,13,0)="ROUTINES:"
^DIC(9.4,4,22,2,"PAH",3,1,14,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,2,"PAH",3,1,15,0)="       ;;8.0;MailMan;**[patch list]**;Jun 28, 2002"
^DIC(9.4,4,22,2,"PAH",3,1,16,0)=""
^DIC(9.4,4,22,2,"PAH",3,1,17,0)="              Before          After"
^DIC(9.4,4,22,2,"PAH",3,1,18,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,2,"PAH",3,1,19,0)="------------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",3,1,20,0)="XMJMORX1       7116146         7133283        5"
^DIC(9.4,4,22,2,"PAH",3,1,21,0)="XMKPR         10051281        10056227        5"
^DIC(9.4,4,22,2,"PAH",3,1,22,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,2,"PAH",3,1,23,0)=""
^DIC(9.4,4,22,2,"PAH",3,1,24,0)="This patch introduces no new routines."
^DIC(9.4,4,22,2,"PAH",3,1,25,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",3,1,26,0)=" "
^DIC(9.4,4,22,2,"PAH",3,1,27,0)="INSTALLATION:"
^DIC(9.4,4,22,2,"PAH",3,1,28,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",3,1,29,0)="is at a minimum. It has no patch prerequisites, except, of course, that"
^DIC(9.4,4,22,2,"PAH",3,1,30,0)="MailMan 8.0 be installed."
^DIC(9.4,4,22,2,"PAH",3,1,31,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,2,"PAH",3,1,32,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,2,"PAH",3,1,33,0)="    affected routine(s).  "
^DIC(9.4,4,22,2,"PAH",3,1,34,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,2,"PAH",3,1,35,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,2,"PAH",3,1,36,0)="4.  Users may be on the system.  You do not need to stop TaskMan"
^DIC(9.4,4,22,2,"PAH",3,1,37,0)="    or the background filer."
^DIC(9.4,4,22,2,"PAH",3,1,38,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,2,"PAH",3,1,39,0)="    Transport Global:"
^DIC(9.4,4,22,2,"PAH",3,1,40,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,2,"PAH",3,1,41,0)="       Print Transport Global"
^DIC(9.4,4,22,2,"PAH",3,1,42,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,2,"PAH",3,1,43,0)="       Backup a Transport Global"
^DIC(9.4,4,22,2,"PAH",3,1,44,0)="       Install Package(s)"
^DIC(9.4,4,22,2,"PAH",3,1,45,0)=" Select INSTALL NAME:    XM*8.0*5     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,2,"PAH",3,1,46,0)="                         ========"
^DIC(9.4,4,22,2,"PAH",3,1,47,0)=" Install Questions for XM*8.0*5"
^DIC(9.4,4,22,2,"PAH",3,1,48,0)=""
^DIC(9.4,4,22,2,"PAH",3,1,49,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,2,"PAH",3,1,50,0)="                                                       =="
^DIC(9.4,4,22,2,"PAH",3,1,51,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,2,"PAH",3,1,52,0)="                                                                       =="
^DIC(9.4,4,22,2,"PAH",3,1,53,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,2,"PAH",3,1,54,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,2,"PAH",3,1,55,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,2,"PAH",3,1,56,0)=""
^DIC(9.4,4,22,2,"PAH",3,1,57,0)=" DEVICE: HOME// <You may queue it if you wish>"
^DIC(9.4,4,22,2,"PAH",3,1,58,0)="                ------------------------------"
^DIC(9.4,4,22,2,"PAH",3,1,59,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,2,"PAH",3,1,60,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",4,0)="1 SEQ #4^3021008^1"
^DIC(9.4,4,22,2,"PAH",4,1,0)="^^73^73^3021008"
^DIC(9.4,4,22,2,"PAH",4,1,1,0)="Patch XM*8.0*1"
^DIC(9.4,4,22,2,"PAH",4,1,2,0)=""
^DIC(9.4,4,22,2,"PAH",4,1,3,0)="NOIS: BAY-0802-31743"
^DIC(9.4,4,22,2,"PAH",4,1,4,0)="Test Site:  Bay Pines, FL"
^DIC(9.4,4,22,2,"PAH",4,1,5,0)="If you send or forward a message to * (Broadcast to all local users), as well"
^DIC(9.4,4,22,2,"PAH",4,1,6,0)="as to SHARED,MAIL, the message is not delivered to SHARED,MAIL.  This patch"
^DIC(9.4,4,22,2,"PAH",4,1,7,0)="fixes that. "
^DIC(9.4,4,22,2,"PAH",4,1,8,0)=""
^DIC(9.4,4,22,2,"PAH",4,1,9,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",4,1,10,0)="is at a minimum.  It has no patch prerequisites, except, of course, that"
^DIC(9.4,4,22,2,"PAH",4,1,11,0)="MailMan 8.0 be installed."
^DIC(9.4,4,22,2,"PAH",4,1,12,0)="============================================================================ "
^DIC(9.4,4,22,2,"PAH",4,1,13,0)=""
^DIC(9.4,4,22,2,"PAH",4,1,14,0)="ROUTINES:"
^DIC(9.4,4,22,2,"PAH",4,1,15,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,2,"PAH",4,1,16,0)="       ;;8.0;MailMan;**[patch list]**;Jun 28, 2002"
^DIC(9.4,4,22,2,"PAH",4,1,17,0)=""
^DIC(9.4,4,22,2,"PAH",4,1,18,0)=" "
^DIC(9.4,4,22,2,"PAH",4,1,19,0)="              Before          After"
^DIC(9.4,4,22,2,"PAH",4,1,20,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,2,"PAH",4,1,21,0)="------------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",4,1,22,0)="XMKP          16206281        16231239        1"
^DIC(9.4,4,22,2,"PAH",4,1,23,0)="XMTDL         18753082        18995257        1"
^DIC(9.4,4,22,2,"PAH",4,1,24,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,2,"PAH",4,1,25,0)=""
^DIC(9.4,4,22,2,"PAH",4,1,26,0)="This patch introduces no new routines."
^DIC(9.4,4,22,2,"PAH",4,1,27,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",4,1,28,0)=" "
^DIC(9.4,4,22,2,"PAH",4,1,29,0)="INSTALLATION:"
^DIC(9.4,4,22,2,"PAH",4,1,30,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",4,1,31,0)="is at a minimum.  It has no patch prerequisites, except, of course, that"
^DIC(9.4,4,22,2,"PAH",4,1,32,0)="MailMan 8.0 be installed."
^DIC(9.4,4,22,2,"PAH",4,1,33,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,2,"PAH",4,1,34,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,2,"PAH",4,1,35,0)="    affected routine(s).  "
^DIC(9.4,4,22,2,"PAH",4,1,36,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,2,"PAH",4,1,37,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,2,"PAH",4,1,38,0)="4.  Users may be on the system.  You do not need to stop TaskMan,"
^DIC(9.4,4,22,2,"PAH",4,1,39,0)="    but you should stop the background filer."
^DIC(9.4,4,22,2,"PAH",4,1,40,0)="    On the Manage MailMan:Local Delivery Management menu, use the"
^DIC(9.4,4,22,2,"PAH",4,1,41,0)="    following option to stop the background filer:"
^DIC(9.4,4,22,2,"PAH",4,1,42,0)="       STOP background filer"
^DIC(9.4,4,22,2,"PAH",4,1,43,0)="Are you sure you want the BACKGROUND FILERS to STOP delivering mail? NO// YES"
^DIC(9.4,4,22,2,"PAH",4,1,44,0)="                                                                          ==="
^DIC(9.4,4,22,2,"PAH",4,1,45,0)="<< Background filer will stop soon. >>"
^DIC(9.4,4,22,2,"PAH",4,1,46,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,2,"PAH",4,1,47,0)="    Transport Global:"
^DIC(9.4,4,22,2,"PAH",4,1,48,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,2,"PAH",4,1,49,0)="       Print Transport Global"
^DIC(9.4,4,22,2,"PAH",4,1,50,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,2,"PAH",4,1,51,0)="       Backup a Transport Global"
^DIC(9.4,4,22,2,"PAH",4,1,52,0)="       Install Package(s)"
^DIC(9.4,4,22,2,"PAH",4,1,53,0)=" Select INSTALL NAME:    XM*8.0*1     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,2,"PAH",4,1,54,0)="                         ========"
^DIC(9.4,4,22,2,"PAH",4,1,55,0)=" Install Questions for XM*8.0*1"
^DIC(9.4,4,22,2,"PAH",4,1,56,0)=""
^DIC(9.4,4,22,2,"PAH",4,1,57,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,2,"PAH",4,1,58,0)="                                                       =="
^DIC(9.4,4,22,2,"PAH",4,1,59,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,2,"PAH",4,1,60,0)="                                                                       =="
^DIC(9.4,4,22,2,"PAH",4,1,61,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,2,"PAH",4,1,62,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,2,"PAH",4,1,63,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,2,"PAH",4,1,64,0)=""
^DIC(9.4,4,22,2,"PAH",4,1,65,0)=" DEVICE: HOME// <Do NOT queue it!>"
^DIC(9.4,4,22,2,"PAH",4,1,66,0)="                ------------------"
^DIC(9.4,4,22,2,"PAH",4,1,67,0)="6.  Start the background filer."
^DIC(9.4,4,22,2,"PAH",4,1,68,0)="    On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,2,"PAH",4,1,69,0)="    option to start the background filer:"
^DIC(9.4,4,22,2,"PAH",4,1,70,0)="       START background filer"
^DIC(9.4,4,22,2,"PAH",4,1,71,0)="<< Background filer will start soon. >>"
^DIC(9.4,4,22,2,"PAH",4,1,72,0)="7.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,2,"PAH",4,1,73,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",5,0)="6 SEQ #5^3021025^1"
^DIC(9.4,4,22,2,"PAH",5,1,0)="^^90^90^3021025"
^DIC(9.4,4,22,2,"PAH",5,1,1,0)="Patch XM*8.0*6"
^DIC(9.4,4,22,2,"PAH",5,1,2,0)=""
^DIC(9.4,4,22,2,"PAH",5,1,3,0)="Remedy Ticket: HD 12891 / CHG 4269"
^DIC(9.4,4,22,2,"PAH",5,1,4,0)="Test Sites: MPI-AUSTIN, CIOFO-ALBANY"
^DIC(9.4,4,22,2,"PAH",5,1,5,0)=""
^DIC(9.4,4,22,2,"PAH",5,1,6,0)="This patch contains several fixes."
^DIC(9.4,4,22,2,"PAH",5,1,7,0)=""
^DIC(9.4,4,22,2,"PAH",5,1,8,0)="1. When MailMan has tried all the scripts to transmit a queue, and the"
^DIC(9.4,4,22,2,"PAH",5,1,9,0)="transmission still fails, MailMan sends the postmaster a message to"
^DIC(9.4,4,22,2,"PAH",5,1,10,0)="notify of the problem.  This message gets bigger and bigger with"
^DIC(9.4,4,22,2,"PAH",5,1,11,0)="subsequent failures, because it reports on every previous failed attempt,"
^DIC(9.4,4,22,2,"PAH",5,1,12,0)="which can number in the 1000s.  This patch limits the message size by"
^DIC(9.4,4,22,2,"PAH",5,1,13,0)="reporting a maximum of 100 previous failed attempts."
^DIC(9.4,4,22,2,"PAH",5,1,14,0)=""
^DIC(9.4,4,22,2,"PAH",5,1,15,0)="2. Patch XM*8.0*1 failed to include the patch number in the second line of"
^DIC(9.4,4,22,2,"PAH",5,1,16,0)="routine ^XMTDL.  This patch adds it."
^DIC(9.4,4,22,2,"PAH",5,1,17,0)=""
^DIC(9.4,4,22,2,"PAH",5,1,18,0)="3. For GT.M systems, change the listener from the non-standard port 2525"
^DIC(9.4,4,22,2,"PAH",5,1,19,0)="to standard 25 in routine ^XMRUCX."
^DIC(9.4,4,22,2,"PAH",5,1,20,0)=""
^DIC(9.4,4,22,2,"PAH",5,1,21,0)="4. In routine ^XMR1, add a check to reject a connection if the site"
^DIC(9.4,4,22,2,"PAH",5,1,22,0)="attempting to connect is listed in the NETWORK SENDERS REJECTED (#4.501)"
^DIC(9.4,4,22,2,"PAH",5,1,23,0)="file."
^DIC(9.4,4,22,2,"PAH",5,1,24,0)=""
^DIC(9.4,4,22,2,"PAH",5,1,25,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",5,1,26,0)="is at a minimum. It requires patches XM*8.0*1 and *5."
^DIC(9.4,4,22,2,"PAH",5,1,27,0)="============================================================================ "
^DIC(9.4,4,22,2,"PAH",5,1,28,0)=""
^DIC(9.4,4,22,2,"PAH",5,1,29,0)="ROUTINES:"
^DIC(9.4,4,22,2,"PAH",5,1,30,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,2,"PAH",5,1,31,0)="       ;;8.0;MailMan;**[patch list]**;Jun 28, 2002"
^DIC(9.4,4,22,2,"PAH",5,1,32,0)=""
^DIC(9.4,4,22,2,"PAH",5,1,33,0)="              Before          After"
^DIC(9.4,4,22,2,"PAH",5,1,34,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,2,"PAH",5,1,35,0)="------------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",5,1,36,0)="XMCX           5550363         5865594        6"
^DIC(9.4,4,22,2,"PAH",5,1,37,0)="XMKPR         10056227        11722808        5,6"
^DIC(9.4,4,22,2,"PAH",5,1,38,0)="XMR1          10825754        11104837        6"
^DIC(9.4,4,22,2,"PAH",5,1,39,0)="XMRUCX         1143285         1138934        6"
^DIC(9.4,4,22,2,"PAH",5,1,40,0)="XMTDL         18995257        18999651        1,6"
^DIC(9.4,4,22,2,"PAH",5,1,41,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,2,"PAH",5,1,42,0)=""
^DIC(9.4,4,22,2,"PAH",5,1,43,0)="This patch introduces no new routines."
^DIC(9.4,4,22,2,"PAH",5,1,44,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",5,1,45,0)=" "
^DIC(9.4,4,22,2,"PAH",5,1,46,0)="INSTALLATION:"
^DIC(9.4,4,22,2,"PAH",5,1,47,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",5,1,48,0)="is at a minimum. It requires patches XM*8.0*1 and *5."
^DIC(9.4,4,22,2,"PAH",5,1,49,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,2,"PAH",5,1,50,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,2,"PAH",5,1,51,0)="    affected routine(s).  "
^DIC(9.4,4,22,2,"PAH",5,1,52,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,2,"PAH",5,1,53,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,2,"PAH",5,1,54,0)="4.  Users may be on the system.  You do not need to stop TaskMan,"
^DIC(9.4,4,22,2,"PAH",5,1,55,0)="    but you should stop the background filer.  Failure to do so may result"
^DIC(9.4,4,22,2,"PAH",5,1,56,0)="    in ""source routine edited"" errors."
^DIC(9.4,4,22,2,"PAH",5,1,57,0)="    On the Manage MailMan:Local Delivery Management menu, use the"
^DIC(9.4,4,22,2,"PAH",5,1,58,0)="    following option to stop the background filer:"
^DIC(9.4,4,22,2,"PAH",5,1,59,0)="       STOP background filer"
^DIC(9.4,4,22,2,"PAH",5,1,60,0)="Are you sure you want the BACKGROUND FILERS to STOP delivering mail? NO// YES"
^DIC(9.4,4,22,2,"PAH",5,1,61,0)="                                                                          ==="
^DIC(9.4,4,22,2,"PAH",5,1,62,0)="<< Background filer will stop soon. >>"
^DIC(9.4,4,22,2,"PAH",5,1,63,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,2,"PAH",5,1,64,0)="    Transport Global:"
^DIC(9.4,4,22,2,"PAH",5,1,65,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,2,"PAH",5,1,66,0)="       Print Transport Global"
^DIC(9.4,4,22,2,"PAH",5,1,67,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,2,"PAH",5,1,68,0)="       Backup a Transport Global"
^DIC(9.4,4,22,2,"PAH",5,1,69,0)="       Install Package(s)"
^DIC(9.4,4,22,2,"PAH",5,1,70,0)=" Select INSTALL NAME:    XM*8.0*6     Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,2,"PAH",5,1,71,0)="                         ========"
^DIC(9.4,4,22,2,"PAH",5,1,72,0)=" Install Questions for XM*8.0*6"
^DIC(9.4,4,22,2,"PAH",5,1,73,0)=""
^DIC(9.4,4,22,2,"PAH",5,1,74,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,2,"PAH",5,1,75,0)="                                                       =="
^DIC(9.4,4,22,2,"PAH",5,1,76,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,2,"PAH",5,1,77,0)="                                                                       =="
^DIC(9.4,4,22,2,"PAH",5,1,78,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,2,"PAH",5,1,79,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,2,"PAH",5,1,80,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,2,"PAH",5,1,81,0)=""
^DIC(9.4,4,22,2,"PAH",5,1,82,0)=" DEVICE: HOME// <Do NOT queue it!>"
^DIC(9.4,4,22,2,"PAH",5,1,83,0)="                ------------------"
^DIC(9.4,4,22,2,"PAH",5,1,84,0)="6.  Start the background filer."
^DIC(9.4,4,22,2,"PAH",5,1,85,0)="    On the Manage MailMan:Local Delivery Management menu, use the following"
^DIC(9.4,4,22,2,"PAH",5,1,86,0)="    option to start the background filer:"
^DIC(9.4,4,22,2,"PAH",5,1,87,0)="       START background filer"
^DIC(9.4,4,22,2,"PAH",5,1,88,0)="<< Background filer will start soon. >>"
^DIC(9.4,4,22,2,"PAH",5,1,89,0)="7.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,2,"PAH",5,1,90,0)="==========================================================================="
^DIC(9.4,4,22,2,"PAH",6,0)="7 SEQ #6^3021108^1"
^DIC(9.4,4,22,2,"PAH",6,1,0)="^^61^61^3021108"
^DIC(9.4,4,22,2,"PAH",6,1,1,0)="Patch XM*8.0*7"
^DIC(9.4,4,22,2,"PAH",6,1,2,0)=""
^DIC(9.4,4,22,2,"PAH",6,1,3,0)="Remedy Ticket: HD 13399 / CHG 4289"
^DIC(9.4,4,22,2,"PAH",6,1,4,0)="Test Site: Long Beach, CA"
^DIC(9.4,4,22,2,"PAH",6,1,5,0)=""
^DIC(9.4,4,22,2,"PAH",6,1,6,0)="This patch fixes a problem in routine ^XMRTCP.  It attempts to access a"
^DIC(9.4,4,22,2,"PAH",6,1,7,0)="non-existing variable called XMB(""LASTTRY"").  The actual name of the"
^DIC(9.4,4,22,2,"PAH",6,1,8,0)="variable is XMB(""LAST TRY"")."
^DIC(9.4,4,22,2,"PAH",6,1,9,0)=""
^DIC(9.4,4,22,2,"PAH",6,1,10,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",6,1,11,0)="is at a minimum. It has no patch prerequisites, except that MailMan 8 must"
^DIC(9.4,4,22,2,"PAH",6,1,12,0)="be installed."
^DIC(9.4,4,22,2,"PAH",6,1,13,0)="============================================================================ "
^DIC(9.4,4,22,2,"PAH",6,1,14,0)=""
^DIC(9.4,4,22,2,"PAH",6,1,15,0)="ROUTINES:"
^DIC(9.4,4,22,2,"PAH",6,1,16,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,2,"PAH",6,1,17,0)="       ;;8.0;MailMan;**[patch list]**;Jun 28, 2002"
^DIC(9.4,4,22,2,"PAH",6,1,18,0)=""
^DIC(9.4,4,22,2,"PAH",6,1,19,0)="              Before          After"
^DIC(9.4,4,22,2,"PAH",6,1,20,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,2,"PAH",6,1,21,0)="------------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",6,1,22,0)="XMRTCP         3549159         3556521        7"
^DIC(9.4,4,22,2,"PAH",6,1,23,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,2,"PAH",6,1,24,0)=""
^DIC(9.4,4,22,2,"PAH",6,1,25,0)="This patch introduces no new routines."
