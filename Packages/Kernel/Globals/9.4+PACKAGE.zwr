^DIC(9.4,4,22,1,"PAH",97,1,110,0)="This patch introduces the following new routines:"
^DIC(9.4,4,22,1,"PAH",97,1,111,0)=" "
^DIC(9.4,4,22,1,"PAH",97,1,112,0)="Routine      Callable at     Description"
