^DIC(9.4,115,22,2,"PAH",118,1,1,0)="2017 Maintenance of Radiology File #73.2 (Radiology CPT by Procedure Type"
^DIC(9.4,115,22,2,"PAH",119,0)="141 SEQ #124^3180301.151453^54"
^DIC(9.4,115,22,2,"PAH",119,1,0)="^^4^4^3180301"
^DIC(9.4,115,22,2,"PAH",119,1,1,0)="This patch will address the following SDM Tickets:"
^DIC(9.4,115,22,2,"PAH",119,1,2,0)="1. I14066990FY17 - <UNDEFINED>PRT+13^RARTE5"
^DIC(9.4,115,22,2,"PAH",119,1,3,0)="2. I14376092FY17 - New: SBY-Error Message: Report Designer HL7 Logs are "
^DIC(9.4,115,22,2,"PAH",119,1,4,0)="                   not updating to Vista"
^DIC(9.4,115,22,2,"PAH",120,0)="137 SEQ #125^3180302.152859^54"
^DIC(9.4,115,22,2,"PAH",120,1,0)="^^9^9^3180302"
^DIC(9.4,115,22,2,"PAH",120,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,115,22,2,"PAH",120,1,2,0)=" "
^DIC(9.4,115,22,2,"PAH",120,1,3,0)="Historic radiolgy patient demographic updates to PACS."
^DIC(9.4,115,22,2,"PAH",120,1,4,0)="'Mass Override to Complete' option removal."
^DIC(9.4,115,22,2,"PAH",120,1,5,0)="Status Tracking of Exams addition of pregnancy screen prompt."
^DIC(9.4,115,22,2,"PAH",120,1,6,0)="Outside Report Entry/Edit bypass of pregnancy screen requirement. "
^DIC(9.4,115,22,2,"PAH",120,1,7,0)="Status tracking display of printsets with SSANs enabled."
^DIC(9.4,115,22,2,"PAH",120,1,8,0)="Registered Request Printer."
^DIC(9.4,115,22,2,"PAH",120,1,9,0)="Images Acquired indicator on radiology reports. "
^DIC(9.4,115,22,2,"PAH",121,0)="132 SEQ #126^3180403.15531^54"
^DIC(9.4,115,22,2,"PAH",121,1,0)="^^1^1^3180403"
^DIC(9.4,115,22,2,"PAH",121,1,1,0)="This adds height and weight to Radiology exam registration demograhics."
^DIC(9.4,115,22,2,"PAH",122,0)="135 SEQ #127^3180501.1451^54"
^DIC(9.4,115,22,2,"PAH",122,1,0)="^^3^3^3180501"
^DIC(9.4,115,22,2,"PAH",122,1,1,0)="Patch one hundred and thirty-five for the VistA Radiology/Nuclear Medicine"
