^DIC(9.4,100,22,15,"PAH",37,1,243,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,244,0)="     Installation Instructions:"
^DIC(9.4,100,22,15,"PAH",37,1,245,0)="     =========================="
^DIC(9.4,100,22,15,"PAH",37,1,246,0)="    1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu."
^DIC(9.4,100,22,15,"PAH",37,1,247,0)="       This option will load the KIDS package in this message onto "
^DIC(9.4,100,22,15,"PAH",37,1,248,0)="       your system."
^DIC(9.4,100,22,15,"PAH",37,1,249,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,250,0)="    2. The patch has now been loaded into a Transport global on your"
^DIC(9.4,100,22,15,"PAH",37,1,251,0)="       system. You now need to use KIDS to install the Transport"
^DIC(9.4,100,22,15,"PAH",37,1,252,0)="       global. On the KIDS menu, under the 'Installation' menu, use"
^DIC(9.4,100,22,15,"PAH",37,1,253,0)="       the following options:"
^DIC(9.4,100,22,15,"PAH",37,1,254,0)=" "
^DIC(9.4,100,22,15,"PAH",37,1,255,0)="                  Print Transport Global"
^DIC(9.4,100,22,15,"PAH",37,1,256,0)="                  Compare Transport Global to Current System"
^DIC(9.4,100,22,15,"PAH",37,1,257,0)="                  Verify Checksums in Transport Global"
^DIC(9.4,100,22,15,"PAH",37,1,258,0)="                  Backup a Transport Global"
^DIC(9.4,100,22,15,"PAH",37,1,259,0)=" "
^DIC(9.4,100,22,15,"PAH",37,1,260,0)="    3. Installation of this patch should be at off peak hours."
^DIC(9.4,100,22,15,"PAH",37,1,261,0)=" "
^DIC(9.4,100,22,15,"PAH",37,1,262,0)="    4. Users may remain on the system."
^DIC(9.4,100,22,15,"PAH",37,1,263,0)=" "
^DIC(9.4,100,22,15,"PAH",37,1,264,0)="    5. Installation will take less than five minutes. Installation"
^DIC(9.4,100,22,15,"PAH",37,1,265,0)="       of this patch requires no additional memory space."
^DIC(9.4,100,22,15,"PAH",37,1,266,0)=" "
^DIC(9.4,100,22,15,"PAH",37,1,267,0)="    6. From the 'Installation Menu' of the KIDS menu, run the option"
^DIC(9.4,100,22,15,"PAH",37,1,268,0)="       'Install Package(s)' Select the package 'YS*5.01*62' and"
^DIC(9.4,100,22,15,"PAH",37,1,269,0)="       proceed with install."
^DIC(9.4,100,22,15,"PAH",37,1,270,0)=" "
^DIC(9.4,100,22,15,"PAH",37,1,271,0)="    7. When prompted 'Want KIDS to INHIBIT LOGONs during the"
^DIC(9.4,100,22,15,"PAH",37,1,272,0)="       install? YES//', respond  NO."
^DIC(9.4,100,22,15,"PAH",37,1,273,0)=""
^DIC(9.4,100,22,15,"PAH",37,1,274,0)="    8. When prompted 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,100,22,15,"PAH",37,1,275,0)="       Options, and Protocols? YES//', respond  NO."
^DIC(9.4,100,22,15,"PAH",38,0)="64 SEQ #57^3000626^1"
^DIC(9.4,100,22,15,"PAH",38,1,0)="^^67^67^3000626"
^DIC(9.4,100,22,15,"PAH",38,1,1,0)="This patch releases a new Mental Health API named YSGAFAP1.  This API will "
^DIC(9.4,100,22,15,"PAH",38,1,2,0)="allow the calling routine to store the Global Assessment of Functioning (GAF) "
^DIC(9.4,100,22,15,"PAH",38,1,3,0)="data in the DIAGNOSTIC RESULTS - MENTAL HEALTH file (#627.8).  The fields "
^DIC(9.4,100,22,15,"PAH",38,1,4,0)="that will store the GAF data are PATIENT NAME (#.02), DATE/TIME OF "
^DIC(9.4,100,22,15,"PAH",38,1,5,0)="DIAGNOSIS (#.03), DIAGNOSIS BY (#.04), TRANSCRIBER (#.05), AXIS 5 (#65)"
^DIC(9.4,100,22,15,"PAH",38,1,6,0)="and PATIENT TYPE (#66)."
^DIC(9.4,100,22,15,"PAH",38,1,7,0)=""
^DIC(9.4,100,22,15,"PAH",38,1,8,0)=""
^DIC(9.4,100,22,15,"PAH",38,1,9,0)="   Test Site(s): El Paso, TX"
^DIC(9.4,100,22,15,"PAH",38,1,10,0)="                 Fargo, ND"
^DIC(9.4,100,22,15,"PAH",38,1,11,0)="                 Grand Junction, CO"
^DIC(9.4,100,22,15,"PAH",38,1,12,0)="                 Huntington, WV"
^DIC(9.4,100,22,15,"PAH",38,1,13,0)="                 Miami, FL"
^DIC(9.4,100,22,15,"PAH",38,1,14,0)="                 Sheridan, WY"
^DIC(9.4,100,22,15,"PAH",38,1,15,0)="                 South Texas HCS"
^DIC(9.4,100,22,15,"PAH",38,1,16,0)="                 ST Louis, MO"
^DIC(9.4,100,22,15,"PAH",38,1,17,0)="                 Tampa, FL"
^DIC(9.4,100,22,15,"PAH",38,1,18,0)="                 West Palm Beach, FL"
^DIC(9.4,100,22,15,"PAH",38,1,19,0)="                 White River Junction, VT"
^DIC(9.4,100,22,15,"PAH",38,1,20,0)="    "
^DIC(9.4,100,22,15,"PAH",38,1,21,0)=""
^DIC(9.4,100,22,15,"PAH",38,1,22,0)="   ROUTINE SUMMARY:"
^DIC(9.4,100,22,15,"PAH",38,1,23,0)="   ================"
^DIC(9.4,100,22,15,"PAH",38,1,24,0)="   The second line of the routine now looks like:"
