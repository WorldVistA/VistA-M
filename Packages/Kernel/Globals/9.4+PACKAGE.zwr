^DIC(9.4,14,22,5.9,"PAH",226,1,126,0)="The following is a list of menu options included in this patch:"
^DIC(9.4,14,22,5.9,"PAH",226,1,127,0)="=============================================================="
^DIC(9.4,14,22,5.9,"PAH",226,1,128,0)=" "
^DIC(9.4,14,22,5.9,"PAH",226,1,129,0)="Option Name                      Type                New/Modified"
^DIC(9.4,14,22,5.9,"PAH",226,1,130,0)="-----------                      ----                ------------"
^DIC(9.4,14,22,5.9,"PAH",226,1,131,0)="HOWDY BCE MAIN MENU             menu                    NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,132,0)="HOWDY MAIN MENU                 menu                    NEW"
^DIC(9.4,14,22,5.9,"PAH",226,1,133,0)="LRHY BCE LABEL PRINT            action                  NEW      "
