^DIC(9.4,47,22,5.9,"PAH",784,0)="998^3200601.154028^70"
^DIC(9.4,47,22,5.9,"PAH",784,1,0)="^^2^2^3200601"
^DIC(9.4,47,22,5.9,"PAH",784,1,1,0)="Please see the DG*5.3*998 patch description for detailed information"
^DIC(9.4,47,22,5.9,"PAH",784,1,2,0)="regarding this patch."
^DIC(9.4,47,22,5.9,"PAH",785,0)="977 SEQ #877^3200601.164357^70"
^DIC(9.4,47,22,5.9,"PAH",785,1,0)="^^3^3^3200601"
^DIC(9.4,47,22,5.9,"PAH",785,1,1,0)="This patch implements EXPANDED MH CARE NON-ENROLLEE as a primary"
^DIC(9.4,47,22,5.9,"PAH",785,1,2,0)="eligibility code in VistA Registration to identify and support nonveterans"
^DIC(9.4,47,22,5.9,"PAH",785,1,3,0)="that need emergent mental healthcare services."
^DIC(9.4,47,22,5.9,"PAH",786,0)="932^3200624.121405^65"
^DIC(9.4,47,22,5.9,"PAH",786,1,0)="^^3^3^3200624"
^DIC(9.4,47,22,5.9,"PAH",786,1,1,0)="This patch creates a new protocol that is executed whenever a field that "
^DIC(9.4,47,22,5.9,"PAH",786,1,2,0)="points to the ICD DIAGNOSIS file (#80) is modified. See the associated "
^DIC(9.4,47,22,5.9,"PAH",786,1,3,0)="patch description for complete details about this patch."
^DIC(9.4,47,22,5.9,"PAH",787,0)="992 SEQ #879^3200624.135851^65"
^DIC(9.4,47,22,5.9,"PAH",787,1,0)="^^11^11^3200624"
^DIC(9.4,47,22,5.9,"PAH",787,1,1,0)="Patch DG*5.3*992 addresses two issues."
^DIC(9.4,47,22,5.9,"PAH",787,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",787,1,3,0)="        1. Users are unable to add/edit or delete catastrophically "
^DIC(9.4,47,22,5.9,"PAH",787,1,4,0)="           disabled data from the Patient (#2) file once entered even "
^DIC(9.4,47,22,5.9,"PAH",787,1,5,0)="           when they are signed into the facility that originally created "
^DIC(9.4,47,22,5.9,"PAH",787,1,6,0)="           the entry."
^DIC(9.4,47,22,5.9,"PAH",787,1,7,0)=" "
^DIC(9.4,47,22,5.9,"PAH",787,1,8,0)="        2. An issue where the incorrect pivot number and ward are "
^DIC(9.4,47,22,5.9,"PAH",787,1,9,0)="           sometimes saved in the PADE OUTBOUND MESSAGES file (#58.72) "
^DIC(9.4,47,22,5.9,"PAH",787,1,10,0)="           when readmitting a patient that was previously in an "
^DIC(9.4,47,22,5.9,"PAH",787,1,11,0)="           observation status."
^DIC(9.4,47,22,5.9,"PAH",788,0)="1012 SEQ #880^3200713.172408^65"
^DIC(9.4,47,22,5.9,"PAH",788,1,0)="^^2^2^3200713"
^DIC(9.4,47,22,5.9,"PAH",788,1,1,0)="Refer to the DG*5.3*1012 patch description for detailed information "
^DIC(9.4,47,22,5.9,"PAH",788,1,2,0)="regarding this patch."
^DIC(9.4,47,22,5.9,"PAH",789,0)="1005 SEQ #881^3200721.121616^65"
^DIC(9.4,47,22,5.9,"PAH",790,0)="1024 SEQ #882^3200730.151021^65"
^DIC(9.4,47,22,5.9,"PAH",790,1,0)="^^3^3^3200730"
^DIC(9.4,47,22,5.9,"PAH",790,1,1,0)="MASTER VETERAN INDEX VISTA ISSUE - PRF SUPPORT"
^DIC(9.4,47,22,5.9,"PAH",790,1,2,0)="Refer to patch DG*5.3*1024 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",790,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",791,0)="1010 SEQ #883^3200730.151306^65"
^DIC(9.4,47,22,5.9,"PAH",791,1,0)="^^2^2^3200730"
^DIC(9.4,47,22,5.9,"PAH",791,1,1,0)="Display postal code at the end of foreign addresses instead of at the"
^DIC(9.4,47,22,5.9,"PAH",791,1,2,0)="beginning."
^DIC(9.4,47,22,5.9,"PAH",792,0)="997^3200810.125927^65"
^DIC(9.4,47,22,5.9,"PAH",792,1,0)="^^2^2^3200810"
^DIC(9.4,47,22,5.9,"PAH",792,1,1,0)="Please see the DG*5.3*997 patch description for detailed information "
^DIC(9.4,47,22,5.9,"PAH",792,1,2,0)="regarding this patch."
^DIC(9.4,47,22,5.9,"PAH",793,0)="1008 SEQ #885^3200819.113116^65"
^DIC(9.4,47,22,5.9,"PAH",793,1,0)="^^2^2^3200819"
^DIC(9.4,47,22,5.9,"PAH",793,1,1,0)="Please see the DG*5.3*1008 patch description for detailed information"
^DIC(9.4,47,22,5.9,"PAH",793,1,2,0)="regarding this patch."
^DIC(9.4,47,22,5.9,"PAH",794,0)="993^3200824.161748^65"
^DIC(9.4,47,22,5.9,"PAH",794,1,0)="^^3^3^3200824"
^DIC(9.4,47,22,5.9,"PAH",794,1,1,0)=" "
^DIC(9.4,47,22,5.9,"PAH",794,1,2,0)="Please see the DG*5.3*993 patch description for detailed information "
^DIC(9.4,47,22,5.9,"PAH",794,1,3,0)="regarding this patch"
^DIC(9.4,47,22,5.9,"PAH",795,0)="1007 SEQ #887^3200923.104015^65"
^DIC(9.4,47,22,5.9,"PAH",795,1,0)="^^8^8^3200923"
^DIC(9.4,47,22,5.9,"PAH",795,1,1,0)="Patch DG*5.3*1007 address two issues"
^DIC(9.4,47,22,5.9,"PAH",795,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",795,1,3,0)="1. The Service Component (.04) field of the Military Service Episode "
^DIC(9.4,47,22,5.9,"PAH",795,1,4,0)="(.3216) sub-file is not being extracted with the corresponding Military "
^DIC(9.4,47,22,5.9,"PAH",795,1,5,0)="Service Episode data"
^DIC(9.4,47,22,5.9,"PAH",795,1,6,0)=" "
^DIC(9.4,47,22,5.9,"PAH",795,1,7,0)="2. Incorrect Help Text Displays on Registration Screen for Multiple Birth "
^DIC(9.4,47,22,5.9,"PAH",795,1,8,0)="Indicator"
^DIC(9.4,47,22,5.9,"PAH",796,0)="1026 SEQ #888^3200923.153344^65"
^DIC(9.4,47,22,5.9,"PAH",796,1,0)="^^3^3^3200923"
^DIC(9.4,47,22,5.9,"PAH",796,1,1,0)="MASTER VETERAN INDEX VISTA ENHANCEMENT - TFL API UPDATE"
^DIC(9.4,47,22,5.9,"PAH",796,1,2,0)="Refer to patch DG*5.3*1026 in the FORUM Patch Module for a complete"
^DIC(9.4,47,22,5.9,"PAH",796,1,3,0)="description."
^DIC(9.4,47,22,5.9,"PAH",797,0)="1016 SEQ #889^3200923.153437^65"
^DIC(9.4,47,22,5.9,"PAH",797,1,0)="^^18^18^3200923"
^DIC(9.4,47,22,5.9,"PAH",797,1,1,0)="Patch  DG*5.3*1016 implements the following:"
^DIC(9.4,47,22,5.9,"PAH",797,1,2,0)=" "
^DIC(9.4,47,22,5.9,"PAH",797,1,3,0)="1. Provides a fix to ensure 'Reevaluate Eligibility' Mailman messages "
^DIC(9.4,47,22,5.9,"PAH",797,1,4,0)="sent to DGEN ELIGIBILITY ALERT group are sent only for patients "
^DIC(9.4,47,22,5.9,"PAH",797,1,5,0)="registered as 'OTH' patients, per the defined business scenario."
^DIC(9.4,47,22,5.9,"PAH",797,1,6,0)=" "
^DIC(9.4,47,22,5.9,"PAH",797,1,7,0)="2. Provides enhancement to the 'Reevaluate Eligibility' Mailman message "
^DIC(9.4,47,22,5.9,"PAH",797,1,8,0)="to be sent to DGEN ELIGIBILITY ALERT group for patients first registered "
^DIC(9.4,47,22,5.9,"PAH",797,1,9,0)="as NON-OTH patients and screened positively for MST, but whose "
^DIC(9.4,47,22,5.9,"PAH",797,1,10,0)="registration then changed to OTH and subsequent MST re-screening "
^DIC(9.4,47,22,5.9,"PAH",797,1,11,0)="resulting in no or decline."
^DIC(9.4,47,22,5.9,"PAH",797,1,12,0)=" "
^DIC(9.4,47,22,5.9,"PAH",797,1,13,0)="3. Provides a fix to ensure that the OTH Patient Inquiry option displays "
^DIC(9.4,47,22,5.9,"PAH",797,1,14,0)="an ACTIVE OTH status if the patient transitions from OTH Emergent to OTH "
^DIC(9.4,47,22,5.9,"PAH",797,1,15,0)="Extended."
^DIC(9.4,47,22,5.9,"PAH",797,1,16,0)=" "
^DIC(9.4,47,22,5.9,"PAH",797,1,17,0)="4. Provides a fix to ensure that the OTH Patient Inquiry option displays "
^DIC(9.4,47,22,5.9,"PAH",797,1,18,0)="the correct current Primary Eligibility."
^DIC(9.4,47,22,5.9,"PAH",798,0)="1015 SEQ #891^3200923.164329^65"
^DIC(9.4,47,22,5.9,"PAH",798,1,0)="^^2^2^3200923"
^DIC(9.4,47,22,5.9,"PAH",798,1,1,0)="Please see the DG*5.3*1015 patch description for detailed information "
^DIC(9.4,47,22,5.9,"PAH",798,1,2,0)="regarding this patch."
