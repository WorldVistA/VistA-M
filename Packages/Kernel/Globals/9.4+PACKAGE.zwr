^DIC(9.4,14,22,5.9,"PAH",152,1,295,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,296,0)="ENTRY#    NAME                          ERROR"
^DIC(9.4,14,22,5.9,"PAH",152,1,297,0)="8729      TISSUE                        Missing"
^DIC(9.4,14,22,5.9,"PAH",152,1,298,0)="8730      ORGANISM                      Missing"
^DIC(9.4,14,22,5.9,"PAH",152,1,299,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,300,0)="Enter missing data, if input transform failure is reported this will be "
^DIC(9.4,14,22,5.9,"PAH",152,1,301,0)="corrected when patch is installed."
^DIC(9.4,14,22,5.9,"PAH",152,1,302,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,303,0)="There is also a FM Verify field error 'fails Input Transform' in WKLD "
^DIC(9.4,14,22,5.9,"PAH",152,1,304,0)="CODE (#64) file that will be corrected with the install of LR*5.2*302. "
^DIC(9.4,14,22,5.9,"PAH",152,1,305,0)="The screen preventing the selection of LOINC codes with Del (delete) "
^DIC(9.4,14,22,5.9,"PAH",152,1,306,0)="status will be removed. This will allow LEDI sites to coordinate "
^DIC(9.4,14,22,5.9,"PAH",152,1,307,0)="transition from deprecated terms to active terms."
^DIC(9.4,14,22,5.9,"PAH",152,1,308,0)="    The 'DEL' screen will be removed from the following 2 fields:"
^DIC(9.4,14,22,5.9,"PAH",152,1,309,0)="   DEFAULT LOINC CODE (#25) field."
^DIC(9.4,14,22,5.9,"PAH",152,1,310,0)="   SPECIMEN (#20), sub-file TIME ASPECT (#30), LOINC CODE (#4) field."
^DIC(9.4,14,22,5.9,"PAH",152,1,311,0)="NO PRE-INSTALL CORRECTIVE ACTION IS REQUIRED for these errors."
^DIC(9.4,14,22,5.9,"PAH",152,1,312,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,313,0)="Other types of errors may require assistance from the EVS technical teams "
^DIC(9.4,14,22,5.9,"PAH",152,1,314,0)="before proceeding."
^DIC(9.4,14,22,5.9,"PAH",152,1,315,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,316,0)="PRE-INSTALL ROUTINE"
^DIC(9.4,14,22,5.9,"PAH",152,1,317,0)="Note: The pre-install routine will produce a listing of duplicate(s) "
^DIC(9.4,14,22,5.9,"PAH",152,1,318,0)="contained in WKLD CODE (#64) file if any are present."
^DIC(9.4,14,22,5.9,"PAH",152,1,319,0)="    Those duplicates listed with a proceeding '*' SHOULD be resolved "
^DIC(9.4,14,22,5.9,"PAH",152,1,320,0)="before installation of the patch. However, the patch will install if the "
^DIC(9.4,14,22,5.9,"PAH",152,1,321,0)="duplicates are present during installation."
^DIC(9.4,14,22,5.9,"PAH",152,1,322,0)="    Those duplicates listed with a proceeding '+' will be deleted by the "
^DIC(9.4,14,22,5.9,"PAH",152,1,323,0)="pre-install program. No action is required."
^DIC(9.4,14,22,5.9,"PAH",152,1,324,0)="    Those duplicates that do not have a preceding character will not "
^DIC(9.4,14,22,5.9,"PAH",152,1,325,0)="affect the installation.  Those entries that do not have a proceeding "
^DIC(9.4,14,22,5.9,"PAH",152,1,326,0)="character are locally created NLT codes and are provided to indicate to "
^DIC(9.4,14,22,5.9,"PAH",152,1,327,0)="the local user that multiples do exist. This information maybe useful "
^DIC(9.4,14,22,5.9,"PAH",152,1,328,0)="when doing searches on the WKLD DATA (#64.1) file for a particular "
^DIC(9.4,14,22,5.9,"PAH",152,1,329,0)="test(s)."
^DIC(9.4,14,22,5.9,"PAH",152,1,330,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,331,0)="Example of listing:"
^DIC(9.4,14,22,5.9,"PAH",152,1,332,0)="  Checking WKLD CODE file (#64) for duplicate names or numbers."
^DIC(9.4,14,22,5.9,"PAH",152,1,333,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,334,0)="+Blood Products Administration^2633"
^DIC(9.4,14,22,5.9,"PAH",152,1,335,0)="+Blood Products Administration^3214"
^DIC(9.4,14,22,5.9,"PAH",152,1,336,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,337,0)="+CPK MB/CPK Tot^3702"
^DIC(9.4,14,22,5.9,"PAH",152,1,338,0)="+CPK MB/CPK Tot^3767"
^DIC(9.4,14,22,5.9,"PAH",152,1,339,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,340,0)="+Coagulation Factor VIII Inhib~BLOOD CENTER OF SE WISCONSIN^100873"
^DIC(9.4,14,22,5.9,"PAH",152,1,341,0)="Coagulation Factor VIII Inhib~BLOOD CENTER OF SE WISCONSIN^100874"
^DIC(9.4,14,22,5.9,"PAH",152,1,342,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,343,0)="*CPK MB/CPT Tot~BLOOD CENTER OF SE WISCONSIN^100973"
^DIC(9.4,14,22,5.9,"PAH",152,1,344,0)="*CPK MB/CPT Tot~BLOOD CENTER OF SE WISCONSIN^100974"
^DIC(9.4,14,22,5.9,"PAH",152,1,345,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,346,0)="+Hypersensitivity Pneumonitis^1557"
^DIC(9.4,14,22,5.9,"PAH",152,1,347,0)="+Hypersensitivity Pneumonitis^1600"
^DIC(9.4,14,22,5.9,"PAH",152,1,348,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,349,0)="+89026.0000 ^1600"
^DIC(9.4,14,22,5.9,"PAH",152,1,350,0)="+89026.0000 ^2828"
^DIC(9.4,14,22,5.9,"PAH",152,1,351,0)="                           End of duplicate listing."
^DIC(9.4,14,22,5.9,"PAH",152,1,352,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,353,0)="  If '*' duplicates were listed they should be resolved before patch "
^DIC(9.4,14,22,5.9,"PAH",152,1,354,0)="install."
^DIC(9.4,14,22,5.9,"PAH",152,1,355,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,356,0)="               Those '+' will be removed during the post install."
^DIC(9.4,14,22,5.9,"PAH",152,1,357,0)="====================="
^DIC(9.4,14,22,5.9,"PAH",152,1,358,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,359,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,360,0)="Routines:"
^DIC(9.4,14,22,5.9,"PAH",152,1,361,0)="====================="
^DIC(9.4,14,22,5.9,"PAH",152,1,362,0)="LRDAGE"
^DIC(9.4,14,22,5.9,"PAH",152,1,363,0)="This patch contains a NEW age calculation routine, LRDAGE. This routine "
^DIC(9.4,14,22,5.9,"PAH",152,1,364,0)="is used to calculate the age of the patient based on when the specimen "
^DIC(9.4,14,22,5.9,"PAH",152,1,365,0)="was collected instead of date of birth (DOB). For example, if the "
^DIC(9.4,14,22,5.9,"PAH",152,1,366,0)="specimen was collected one year ago, the age will be a year less than "
^DIC(9.4,14,22,5.9,"PAH",152,1,367,0)="today's age. The routine is particularly useful in pediatric patient's "
^DIC(9.4,14,22,5.9,"PAH",152,1,368,0)="normal ranges. This age is used to determine the appropriate normal range "
^DIC(9.4,14,22,5.9,"PAH",152,1,369,0)="based on collection date. This patch expands the age format to include "
^DIC(9.4,14,22,5.9,"PAH",152,1,370,0)="day, month or year designation. This could affect the $SELECT statement "
^DIC(9.4,14,22,5.9,"PAH",152,1,371,0)="evaluation of normal range. Sites are advised to review $SELECT statement "
^DIC(9.4,14,22,5.9,"PAH",152,1,372,0)="in light of this age format. The format of the age is as follows:"
^DIC(9.4,14,22,5.9,"PAH",152,1,373,0)=" 1hr - 30 days = 1dy - 30dy"
^DIC(9.4,14,22,5.9,"PAH",152,1,374,0)=" 1 - 23 months = 1mo - 24mo"
^DIC(9.4,14,22,5.9,"PAH",152,1,375,0)=" >23 month     = 2yr - 999yr"
^DIC(9.4,14,22,5.9,"PAH",152,1,376,0)="The default age of 99yr is return if a computation error occurs because "
^DIC(9.4,14,22,5.9,"PAH",152,1,377,0)="of incorrect values passed to age API. Technical information for the API "
^DIC(9.4,14,22,5.9,"PAH",152,1,378,0)="call is contained in the routine documentation section."
^DIC(9.4,14,22,5.9,"PAH",152,1,379,0)="    The functionality of this routine is not implemented by the patch "
^DIC(9.4,14,22,5.9,"PAH",152,1,380,0)="installation. However, sites requiring the ability to determine age to "
^DIC(9.4,14,22,5.9,"PAH",152,1,381,0)="this degree, may wish to migrate their local M code in the EXECUTE CODE "
^DIC(9.4,14,22,5.9,"PAH",152,1,382,0)="(#62.07) and DELTA CHECKS (#62.1) files to make use of this routine."
^DIC(9.4,14,22,5.9,"PAH",152,1,383,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,384,0)="Routine Summary:"
^DIC(9.4,14,22,5.9,"PAH",152,1,385,0)="================"
^DIC(9.4,14,22,5.9,"PAH",152,1,386,0)=" "
^DIC(9.4,14,22,5.9,"PAH",152,1,387,0)="The following is a list of the routine(s) included in this patch.  The"
^DIC(9.4,14,22,5.9,"PAH",152,1,388,0)="  second line of each of these routine(s) will look like:"
^DIC(9.4,14,22,5.9,"PAH",152,1,389,0)="  "
