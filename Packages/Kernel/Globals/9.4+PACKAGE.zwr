^DIC(9.4,11,22,5.03,"PAH",24,1,307,0)="    LAB_LEDI_II_UM.DOC   INTERCHANGE PHASE II (LEDI II)"
^DIC(9.4,11,22,5.03,"PAH",24,1,308,0)="                         USER MANUAL"
^DIC(9.4,11,22,5.03,"PAH",24,1,309,0)=" "
^DIC(9.4,11,22,5.03,"PAH",24,1,310,0)="   The software files are available on one of the following OI Field"
^DIC(9.4,11,22,5.03,"PAH",24,1,311,0)="   Offices' ANONYMOUS.SOFTWARE directories."
^DIC(9.4,11,22,5.03,"PAH",24,1,312,0)=" "
^DIC(9.4,11,22,5.03,"PAH",24,1,313,0)="   All sites are encouraged to use their FTP capability to obtain these "
^DIC(9.4,11,22,5.03,"PAH",24,1,314,0)="   files.  Use the FTP address ""download.vista.domain.ext"" (without the"
^DIC(9.4,11,22,5.03,"PAH",24,1,315,0)="   quotes) to connect to the first available FTP server where the files"
^DIC(9.4,11,22,5.03,"PAH",24,1,316,0)="   are located."
^DIC(9.4,11,22,5.03,"PAH",24,1,317,0)=" "
