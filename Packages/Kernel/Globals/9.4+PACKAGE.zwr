^DIC(9.4,14,22,5.9,"PAH",119,1,63,0)="==============="
^DIC(9.4,14,22,5.9,"PAH",119,1,64,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,14,22,5.9,"PAH",119,1,65,0)="  of each of these routines now looks like:"
