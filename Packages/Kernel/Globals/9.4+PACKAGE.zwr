^DIC(9.4,59,22,5,"PAH",413,0)="365 SEQ #414^3150316.160856^17"
^DIC(9.4,59,22,5,"PAH",413,1,0)="^^9^9^3150316"
^DIC(9.4,59,22,5,"PAH",413,1,1,0)="Patch PSN*4.0*365 addresses the following four issues:"
^DIC(9.4,59,22,5,"PAH",413,1,2,0)=" "
^DIC(9.4,59,22,5,"PAH",413,1,3,0)="1. INC000000864913 - Subscript error when sorting by name printing "
^DIC(9.4,59,22,5,"PAH",413,1,4,0)="products marked for CMOP"
^DIC(9.4,59,22,5,"PAH",413,1,5,0)="2. INC000000744810 - Drug Identifier Data Dictionary description "
^DIC(9.4,59,22,5,"PAH",413,1,6,0)="change"
^DIC(9.4,59,22,5,"PAH",413,1,7,0)="3. INC000000812050 - Invalid entries on Merge report (Additives and "
^DIC(9.4,59,22,5,"PAH",413,1,8,0)="Solutions needing to be re-matched to Orderable Items)"
^DIC(9.4,59,22,5,"PAH",413,1,9,0)="4. INC000000610447 - Incorrect drug identifier included under Varenicline"
^DIC(9.4,59,22,5,"PAH",414,0)="432^3150323.110559^17"
^DIC(9.4,59,22,5,"PAH",414,1,0)="^^16^16^3150323"
