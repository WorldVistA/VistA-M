^DIC(9.4,60,"DEV")="SAB/B'HAM"
^DIC(9.4,60,"DIBT",0)="^9.48^^0"
^DIC(9.4,60,"DIE",0)="^9.47^2^2"
^DIC(9.4,60,"DIE",1,0)="PSO OUTPT^2"
^DIC(9.4,60,"DIE",2,0)="PSO OUTPTA^2"
^DIC(9.4,60,"DIPT",0)="^9.46^1^1"
^DIC(9.4,60,"DIPT",1,0)="PSO ACTION PROFILE^44"
^DIC(9.4,60,"EX",0)="^9.432^3^3"
^DIC(9.4,60,"EX",1,0)="PSIV"
^DIC(9.4,60,"EX",2,0)="PSG"
^DIC(9.4,60,"EX",3,0)="PSZ"
^DIC(9.4,60,"INI")="PSOSTART^2960702.160105"
^DIC(9.4,60,"INIT")="PSOPOST^2960702.164817"
^DIC(9.4,60,"PRE")="PSOPREI^2960702.160007"
^DIC(9.4,60,"VERSION")="7.0"
^DIC(9.4,70,0)="RPC BROKER^XWB^Remote Procedure Call Broker"
^DIC(9.4,70,1,0)="^^9^9^2950915^^"
^DIC(9.4,70,1,1,0)="Remote Procedure Call (RPC) Broker is the software that provides Decentralized"
^DIC(9.4,70,1,2,0)="Hospital Computer Program (DHCP) its client/server architecture.  The RPC"
^DIC(9.4,70,1,3,0)="Broker allows workstations running client applications to access DHCP data and"
^DIC(9.4,70,1,4,0)="methods.  "
^DIC(9.4,70,1,5,0)=""
^DIC(9.4,70,1,6,0)="RPC Broker has a client module which runs on the workstation and a server"
^DIC(9.4,70,1,7,0)="module which runs on the host computer where the data and business rules "
^DIC(9.4,70,1,8,0)="reside.  On the client side the Broker works between the applications and the"
^DIC(9.4,70,1,9,0)="transport protocol.  "
^DIC(9.4,70,5)="San Francisco"
^DIC(9.4,70,20,0)="^9.402P^^"
^DIC(9.4,70,22,0)="^9.49I^2^2"
^DIC(9.4,70,22,1,0)="1.0^2960524^2960715^1"
^DIC(9.4,70,22,1,1,0)="^^2^2^2960715"
^DIC(9.4,70,22,1,1,1,0)="This distribution contains all the server code and data for the Remote"
^DIC(9.4,70,22,1,1,2,0)="Procedure Call (RPC) Broker version 1.0."
^DIC(9.4,70,22,2,0)="1.1^3051119^2971118^1"
^DIC(9.4,70,22,2,1,0)="^^1^1^3051119"
^DIC(9.4,70,22,2,1,1,0)="RPC BROKER version 1.1"
^DIC(9.4,70,22,2,"PAH",0)="^9.4901^44^44"
^DIC(9.4,70,22,2,"PAH",1,0)="1^2980220^1"
^DIC(9.4,70,22,2,"PAH",1,1,0)="^^47^47^2980220"
^DIC(9.4,70,22,2,"PAH",1,1,1,0)="This patch fixes some small problems that were discovered after release."
^DIC(9.4,70,22,2,"PAH",1,1,2,0)=""
^DIC(9.4,70,22,2,"PAH",1,1,3,0)="XWBTCPL   Remove the SYMBOL_TABLE from the VAX DSM JOB command."
^DIC(9.4,70,22,2,"PAH",1,1,4,0)="XWBTCP    When stopping the Broker, Catch a failure to open a socket."
^DIC(9.4,70,22,2,"PAH",1,1,5,0)=""
^DIC(9.4,70,22,2,"PAH",1,1,6,0)="XWB BROKER EXAMPLE option was missing its type field."
^DIC(9.4,70,22,2,"PAH",1,1,7,0)=""
^DIC(9.4,70,22,2,"PAH",1,1,8,0)="                 Checksum"
^DIC(9.4,70,22,2,"PAH",1,1,9,0)="Routine         Old       New      2nd Line"
^DIC(9.4,70,22,2,"PAH",1,1,10,0)="XWBTCP        8888247   9081629    **1**"
^DIC(9.4,70,22,2,"PAH",1,1,11,0)="XWBTCPL       8380513   8215020    **1**"
^DIC(9.4,70,22,2,"PAH",1,1,12,0)=""
^DIC(9.4,70,22,2,"PAH",1,1,13,0)="========================================================================= "
^DIC(9.4,70,22,2,"PAH",1,1,14,0)="Installation:"
^DIC(9.4,70,22,2,"PAH",1,1,15,0)=""
^DIC(9.4,70,22,2,"PAH",1,1,16,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,70,22,2,"PAH",1,1,17,0)="      so you will need to disable mapping for the effected routines. "
^DIC(9.4,70,22,2,"PAH",1,1,18,0)="     "
^DIC(9.4,70,22,2,"PAH",1,1,19,0)=" 2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,70,22,2,"PAH",1,1,20,0)="     option will load the KIDS package onto your system."
^DIC(9.4,70,22,2,"PAH",1,1,21,0)="     "
^DIC(9.4,70,22,2,"PAH",1,1,22,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,70,22,2,"PAH",1,1,23,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,70,22,2,"PAH",1,1,24,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",1,1,25,0)="      options:"
^DIC(9.4,70,22,2,"PAH",1,1,26,0)="      "
^DIC(9.4,70,22,2,"PAH",1,1,27,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,70,22,2,"PAH",1,1,28,0)="         Print Transport Global"
^DIC(9.4,70,22,2,"PAH",1,1,29,0)="         Compare Transport Global to Current System"
^DIC(9.4,70,22,2,"PAH",1,1,30,0)="         Backup a Transport Global"
^DIC(9.4,70,22,2,"PAH",1,1,31,0)="     "
^DIC(9.4,70,22,2,"PAH",1,1,32,0)=" 4.  Users can remain on the system but,"
^DIC(9.4,70,22,2,"PAH",1,1,33,0)="     The Listener must be stopped before installing this patch."
^DIC(9.4,70,22,2,"PAH",1,1,34,0)="     "
^DIC(9.4,70,22,2,"PAH",1,1,35,0)=" 5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",1,1,36,0)="     option:"
^DIC(9.4,70,22,2,"PAH",1,1,37,0)="        Install Package(s)  'XWB*1.1*1'"
^DIC(9.4,70,22,2,"PAH",1,1,38,0)="                             ========="
^DIC(9.4,70,22,2,"PAH",1,1,39,0)="        "
^DIC(9.4,70,22,2,"PAH",1,1,40,0)=" 6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,70,22,2,"PAH",1,1,41,0)="     other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,70,22,2,"PAH",1,1,42,0)="     "
^DIC(9.4,70,22,2,"PAH",1,1,43,0)=" 7.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,70,22,2,"PAH",1,1,44,0)=" "
^DIC(9.4,70,22,2,"PAH",1,1,45,0)=" 8.  Restart the Broker Listener"
^DIC(9.4,70,22,2,"PAH",1,1,46,0)=" ========================================================================="
^DIC(9.4,70,22,2,"PAH",1,1,47,0)=""
^DIC(9.4,70,22,2,"PAH",2,0)="2^2980808^1"
^DIC(9.4,70,22,2,"PAH",2,1,0)="^^124^124^2980808"
^DIC(9.4,70,22,2,"PAH",2,1,1,0)="Subject: Encryption, Data Collection, Agent"
^DIC(9.4,70,22,2,"PAH",2,1,2,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,3,0)="Category: "
^DIC(9.4,70,22,2,"PAH",2,1,4,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,5,0)="  - Routine"
^DIC(9.4,70,22,2,"PAH",2,1,6,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,7,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,8,0)="DESCRIPTION:"
^DIC(9.4,70,22,2,"PAH",2,1,9,0)="============="
^DIC(9.4,70,22,2,"PAH",2,1,10,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,11,0)="This patch addresses 3 problems with RPC Broker v1.1"
^DIC(9.4,70,22,2,"PAH",2,1,12,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,13,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,14,0)="Encrypted Literal:"
^DIC(9.4,70,22,2,"PAH",2,1,15,0)=" A leading period (""."") in a LITERAL parameter can cause a pattern match"
^DIC(9.4,70,22,2,"PAH",2,1,16,0)=" failure in RPCs. This type of literal is common when data is encrypted."
^DIC(9.4,70,22,2,"PAH",2,1,17,0)=" The failure only occurs with RPCs which combine multiple literals and an"
^DIC(9.4,70,22,2,"PAH",2,1,18,0)=" array.  This fix addresses the needs of NOIS WAS-0398-22800"
^DIC(9.4,70,22,2,"PAH",2,1,19,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,20,0)="  "
^DIC(9.4,70,22,2,"PAH",2,1,21,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,22,0)="Data Collection Switch:"
^DIC(9.4,70,22,2,"PAH",2,1,23,0)=" The original version of the broker automatically collected Response Time"
^DIC(9.4,70,22,2,"PAH",2,1,24,0)=" data.  This was done to fulfill a request from Capacity Management since"
^DIC(9.4,70,22,2,"PAH",2,1,25,0)=" at the time, no baseline data existed for Vista client-server"
^DIC(9.4,70,22,2,"PAH",2,1,26,0)=" Applications.  The broker will not do this any longer.  Collection will"
^DIC(9.4,70,22,2,"PAH",2,1,27,0)=" be ontrolled by the use of the Capacity Management tools, allowing the"
^DIC(9.4,70,22,2,"PAH",2,1,28,0)=" site to decide when to turn data collection on or off. This fix addresses"
^DIC(9.4,70,22,2,"PAH",2,1,29,0)=" the needs of NOIS BRX-0498-11768 and HUN-0498-21137."
^DIC(9.4,70,22,2,"PAH",2,1,30,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,31,0)="***NOTE:"
^DIC(9.4,70,22,2,"PAH",2,1,32,0)=" The Capacity Management option ""Enable/Disable RT Logging"" looks at the"
^DIC(9.4,70,22,2,"PAH",2,1,33,0)=" old Kernel Site Parameters file instead of the new Kernel System"
^DIC(9.4,70,22,2,"PAH",2,1,34,0)=" Parameters file.  So, using this option will not enable/disable the RTM."
^DIC(9.4,70,22,2,"PAH",2,1,35,0)=" The Capacity Management team is aware of this and are going to issue a"
^DIC(9.4,70,22,2,"PAH",2,1,36,0)=" patch.  In the meantime, a site has to use FileMan to manually turn the"
^DIC(9.4,70,22,2,"PAH",2,1,37,0)=" RTM on/off in file 8989.3 (Kernel System Parameter).  The field is the"
^DIC(9.4,70,22,2,"PAH",2,1,38,0)=" LOG SYSTEM RT and its within the VOLUME SET multiple."
^DIC(9.4,70,22,2,"PAH",2,1,39,0)=" Example:"
^DIC(9.4,70,22,2,"PAH",2,1,40,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,41,0)=" Select OPTION: ENTER OR EDIT FILE ENTRIES  "
^DIC(9.4,70,22,2,"PAH",2,1,42,0)="       Select KERNEL SYSTEM PARAMETERS DOMAIN NAME: 1 KERNEL.ISC-SF.DOMAIN.EXT"
^DIC(9.4,70,22,2,"PAH",2,1,43,0)="               Select VOLUME SET: KDE// "
^DIC(9.4,70,22,2,"PAH",2,1,44,0)="                       LOG SYSTEM RT?: NO// Y  YES  <<=="
^DIC(9.4,70,22,2,"PAH",2,1,45,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,46,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,47,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,48,0)="10 Second Network Timeout in Client Agent:"
^DIC(9.4,70,22,2,"PAH",2,1,49,0)=" A 30 second timeout is being switched to 10 for network communications"
^DIC(9.4,70,22,2,"PAH",2,1,50,0)=" with client agent.  In the event of network problems, this should prevent"
^DIC(9.4,70,22,2,"PAH",2,1,51,0)=" delays  to exceed minutes in communications between the server and the"
^DIC(9.4,70,22,2,"PAH",2,1,52,0)=" workstation client agent.  No current NOIS addresses this, this effect"
^DIC(9.4,70,22,2,"PAH",2,1,53,0)=" was discovered by the SF CIOFO."
^DIC(9.4,70,22,2,"PAH",2,1,54,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,55,0)="  "
^DIC(9.4,70,22,2,"PAH",2,1,56,0)="=========================================================================="
^DIC(9.4,70,22,2,"PAH",2,1,57,0)=" INSTALLATION:"
^DIC(9.4,70,22,2,"PAH",2,1,58,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,59,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,60,0)=" 1.  DSM sites - Some of these routines MAY BE mapped, so you will need"
^DIC(9.4,70,22,2,"PAH",2,1,61,0)="     to disable mapping for the effected routines.  Broker routines do not"
^DIC(9.4,70,22,2,"PAH",2,1,62,0)="     need to be mapped."
^DIC(9.4,70,22,2,"PAH",2,1,63,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,64,0)=" 2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,70,22,2,"PAH",2,1,65,0)="     option will load the KIDS package onto your system."
^DIC(9.4,70,22,2,"PAH",2,1,66,0)="    "
^DIC(9.4,70,22,2,"PAH",2,1,67,0)=" 3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,70,22,2,"PAH",2,1,68,0)="     system. You now need to use KIDS to install the Transport global."
^DIC(9.4,70,22,2,"PAH",2,1,69,0)="     On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",2,1,70,0)="     options:"
^DIC(9.4,70,22,2,"PAH",2,1,71,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,72,0)="         Verify Checksum's in Transport Global"
^DIC(9.4,70,22,2,"PAH",2,1,73,0)="         Print Transport Global"
^DIC(9.4,70,22,2,"PAH",2,1,74,0)="         Compare Transport Global to Current System"
^DIC(9.4,70,22,2,"PAH",2,1,75,0)="         Backup a Transport Global"
^DIC(9.4,70,22,2,"PAH",2,1,76,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,77,0)="    "
^DIC(9.4,70,22,2,"PAH",2,1,78,0)=" 4.  All RPC Broker users should log off."
^DIC(9.4,70,22,2,"PAH",2,1,79,0)="     Since no changes are made to the main server routines, sites do not"
^DIC(9.4,70,22,2,"PAH",2,1,80,0)="     need to shut down the listener jobs, BUT sites may choose to do if it"
^DIC(9.4,70,22,2,"PAH",2,1,81,0)="     make it easier to control users trying to log on during the routine"
^DIC(9.4,70,22,2,"PAH",2,1,82,0)="     update."
^DIC(9.4,70,22,2,"PAH",2,1,83,0)="     "
^DIC(9.4,70,22,2,"PAH",2,1,84,0)=" 5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,70,22,2,"PAH",2,1,85,0)="     option:"
^DIC(9.4,70,22,2,"PAH",2,1,86,0)="        Install Package(s)  'XWB*1.1*2'"
^DIC(9.4,70,22,2,"PAH",2,1,87,0)="                             ========="
^DIC(9.4,70,22,2,"PAH",2,1,88,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,89,0)=" 6.  MSM Sites - Answer YES to the question 'Want to MOVE routines to"
^DIC(9.4,70,22,2,"PAH",2,1,90,0)="     other CPUs?'. Enter the names of your Compute and Print server(s)."
^DIC(9.4,70,22,2,"PAH",2,1,91,0)="    "
^DIC(9.4,70,22,2,"PAH",2,1,92,0)=" 7.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,70,22,2,"PAH",2,1,93,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,94,0)=" 8.  Restart the Broker Listener if necessary."
^DIC(9.4,70,22,2,"PAH",2,1,95,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,96,0)="=========================================================================="
^DIC(9.4,70,22,2,"PAH",2,1,97,0)=" "
^DIC(9.4,70,22,2,"PAH",2,1,98,0)=" "
