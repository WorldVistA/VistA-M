^DIC(9.4,100,22,15,"PAH",46,1,79,0)="  YSCLSRV3             N/A                7345805        74"
^DIC(9.4,100,22,15,"PAH",46,1,80,0)="  YSCLTEST           12420746             12047382       18,22,26,47,"
^DIC(9.4,100,22,15,"PAH",46,1,81,0)="                                                         61,69,74"
