^DIC(9.4,4,22,1,"PAH",165,1,42,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",165,1,43,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",165,1,44,0)=" "
^DIC(9.4,4,22,1,"PAH",165,1,45,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",165,1,46,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",165,1,47,0)="is at a minimum.  It requires MailMan patch XM*7.1*189."
^DIC(9.4,4,22,1,"PAH",165,1,48,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",165,1,49,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",165,1,50,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",165,1,51,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",165,1,52,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",165,1,53,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",165,1,54,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",165,1,55,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",165,1,56,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",165,1,57,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",165,1,58,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",165,1,59,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",165,1,60,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",165,1,61,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",165,1,62,0)=" Select INSTALL NAME:    XM*7.1*196    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",165,1,63,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",165,1,64,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",165,1,65,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",165,1,66,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",165,1,67,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",165,1,68,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",165,1,69,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",165,1,70,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",165,1,71,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",165,1,72,0)=""
^DIC(9.4,4,22,1,"PAH",165,1,73,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",165,1,74,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",165,1,75,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",165,1,76,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",166,0)="194 SEQ #191^3010926^1"
^DIC(9.4,4,22,1,"PAH",166,1,0)="^^95^95^3010926"
^DIC(9.4,4,22,1,"PAH",166,1,1,0)="Patch XM*7.1*194"
^DIC(9.4,4,22,1,"PAH",166,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",166,1,3,0)="NOIS PUG-0801-51201"
^DIC(9.4,4,22,1,"PAH",166,1,4,0)="Test Site: Puget Sound HCS"
^DIC(9.4,4,22,1,"PAH",166,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",166,1,6,0)="DOMAIN.EXT (or the gateway to it) sometimes sets limits on the number"
^DIC(9.4,4,22,1,"PAH",166,1,7,0)="of recipients that can be on a message sent from another site.  It's"
^DIC(9.4,4,22,1,"PAH",166,1,8,0)="an anti-spam measure.  Once it hits that number, it won't accept any"
^DIC(9.4,4,22,1,"PAH",166,1,9,0)="more recipients, and if the site tries to send more, DOMAIN.EXT closes"
^DIC(9.4,4,22,1,"PAH",166,1,10,0)="the connection."
^DIC(9.4,4,22,1,"PAH",166,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",166,1,12,0)="MailMan has code designed to detect bad forwarding addresses and remove"
^DIC(9.4,4,22,1,"PAH",166,1,13,0)="them. It makes the decision to delete a forwarding address based on"
^DIC(9.4,4,22,1,"PAH",166,1,14,0)="receiving an error (any error!) from the remote site after having given"
^DIC(9.4,4,22,1,"PAH",166,1,15,0)="the remote site a message recipient.  Unfortunately, DOMAIN.EXT's anti-"
^DIC(9.4,4,22,1,"PAH",166,1,16,0)="spam measure has caused MailMan to delete perfectly good forwarding"
^DIC(9.4,4,22,1,"PAH",166,1,17,0)="addresses.  This patch changes what MailMan does once a remote site says,"
^DIC(9.4,4,22,1,"PAH",166,1,18,0)="""Stop! I can't can't take any more!"":"
^DIC(9.4,4,22,1,"PAH",166,1,19,0)="1) MailMan doesn't delete the user's forwarding address."
^DIC(9.4,4,22,1,"PAH",166,1,20,0)="2) MailMan stops trying to add more recipients."
^DIC(9.4,4,22,1,"PAH",166,1,21,0)=""
^DIC(9.4,4,22,1,"PAH",166,1,22,0)="Here's a sample of the messages which let the user know his forwarding"
^DIC(9.4,4,22,1,"PAH",166,1,23,0)="address was deleted (inappropriately!)."
^DIC(9.4,4,22,1,"PAH",166,1,24,0)=""
^DIC(9.4,4,22,1,"PAH",166,1,25,0)="Subj: Forwarding Address Deleted  [#34506097] 14 Aug 01 13:02  4 lines"
^DIC(9.4,4,22,1,"PAH",166,1,26,0)="From: POSTMASTER - COMPUTER PROGRAMMER  In 'IN' basket.   Page 1"
^DIC(9.4,4,22,1,"PAH",166,1,27,0)="----------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",166,1,28,0)="Your forwarding address: <not shown>@DOMAIN.EXT"
^DIC(9.4,4,22,1,"PAH",166,1,29,0)="has been deleted because it is not valid."
^DIC(9.4,4,22,1,"PAH",166,1,30,0)="The error message is:"
^DIC(9.4,4,22,1,"PAH",166,1,31,0)="552 Too many recipients, max 50"
^DIC(9.4,4,22,1,"PAH",166,1,32,0)=""
^DIC(9.4,4,22,1,"PAH",166,1,33,0)="Subj: Forwarding Address Deleted  [#34506097] 14 Aug 01 13:02  4 lines"
^DIC(9.4,4,22,1,"PAH",166,1,34,0)="From: POSTMASTER - COMPUTER PROGRAMMER  In 'IN' basket.   Page 1"
^DIC(9.4,4,22,1,"PAH",166,1,35,0)="----------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",166,1,36,0)="Your forwarding address: <not shown>@DOMAIN.EXT"
^DIC(9.4,4,22,1,"PAH",166,1,37,0)="has been deleted because it is not valid."
^DIC(9.4,4,22,1,"PAH",166,1,38,0)="The error message is:"
^DIC(9.4,4,22,1,"PAH",166,1,39,0)="221 Closing connection"
^DIC(9.4,4,22,1,"PAH",166,1,40,0)=""
^DIC(9.4,4,22,1,"PAH",166,1,41,0)="This patch ensures that a user's forwarding address will not be deleted as"
^DIC(9.4,4,22,1,"PAH",166,1,42,0)="a result of error messages such as those above."
^DIC(9.4,4,22,1,"PAH",166,1,43,0)=""
^DIC(9.4,4,22,1,"PAH",166,1,44,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",166,1,45,0)="is at a minimum.  It requires MailMan patches XM*7.1*159, *173, *179 & *182."
^DIC(9.4,4,22,1,"PAH",166,1,46,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",166,1,47,0)=""
^DIC(9.4,4,22,1,"PAH",166,1,48,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",166,1,49,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",166,1,50,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",166,1,51,0)=" "
