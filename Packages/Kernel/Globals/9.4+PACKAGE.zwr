^DIC(9.4,14,22,5.9,"PAH",277,1,206,0)=" "
^DIC(9.4,14,22,5.9,"PAH",277,1,207,0)="New Service Requests (NSRs):"
^DIC(9.4,14,22,5.9,"PAH",277,1,208,0)="----------------------------   "
^DIC(9.4,14,22,5.9,"PAH",277,1,209,0)="#20140511"
^DIC(9.4,14,22,5.9,"PAH",277,1,210,0)="The Anatomic Pathology (AP) laboratory service needs a mechanism for "
^DIC(9.4,14,22,5.9,"PAH",277,1,211,0)="clinicians to provide required patient-specific, procedure-specific, and "
^DIC(9.4,14,22,5.9,"PAH",277,1,212,0)="specimen-specific information to facilitate specimen processing by "
^DIC(9.4,14,22,5.9,"PAH",277,1,213,0)="pathologists. This mechanism must be in place for use by the specimen "
^DIC(9.4,14,22,5.9,"PAH",277,1,214,0)="labeling application in order to generate a primary specimen label that "
^DIC(9.4,14,22,5.9,"PAH",277,1,215,0)="positively identifies the specimen and accurately associates it with the "
^DIC(9.4,14,22,5.9,"PAH",277,1,216,0)="patient."
^DIC(9.4,14,22,5.9,"PAH",277,1,217,0)=" "
^DIC(9.4,14,22,5.9,"PAH",277,1,218,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,14,22,5.9,"PAH",277,1,219,0)="-----------------------------"
^DIC(9.4,14,22,5.9,"PAH",277,1,220,0)="N/A"
^DIC(9.4,14,22,5.9,"PAH",277,1,221,0)=" "
^DIC(9.4,14,22,5.9,"PAH",277,1,222,0)=" "
^DIC(9.4,14,22,5.9,"PAH",277,1,223,0)="Remedy Ticket(s) & Overview:"
