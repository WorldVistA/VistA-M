^DIC(9.4,3,22,21,"PAH",242,0)="291 SEQ #250^3030603^1"
^DIC(9.4,3,22,21,"PAH",242,1,0)="^^61^61^3030603"
^DIC(9.4,3,22,21,"PAH",242,1,1,0)="XU*8.0*291"
^DIC(9.4,3,22,21,"PAH",242,1,2,0)=""
^DIC(9.4,3,22,21,"PAH",242,1,3,0)="E3Rs: 6512, 9016"
^DIC(9.4,3,22,21,"PAH",242,1,4,0)="Test Sites: FORUM (VMS/DSM), Cleveland (VMS/DSM), Grand Junction (Cache/NT)"
^DIC(9.4,3,22,21,"PAH",242,1,5,0)="Blood Bank Team Clearance: 4/2/03"
^DIC(9.4,3,22,21,"PAH",242,1,6,0)=""
^DIC(9.4,3,22,21,"PAH",242,1,7,0)="When converting a spool document to a MailMan message, the user can now"
^DIC(9.4,3,22,21,"PAH",242,1,8,0)="enter the subject of the message, select the basket when addressing to"
^DIC(9.4,3,22,21,"PAH",242,1,9,0)="himself, address the message to anyone else, and choose whether the message"
^DIC(9.4,3,22,21,"PAH",242,1,10,0)="should be from himself or the Postmaster."
^DIC(9.4,3,22,21,"PAH",242,1,11,0)=""
^DIC(9.4,3,22,21,"PAH",242,1,12,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,3,22,21,"PAH",242,1,13,0)="is at a minimum.  It requires MailMan patches XM*8.0*2 and XM*8.0*15, as"
^DIC(9.4,3,22,21,"PAH",242,1,14,0)="well as Kernel patch XU*8.0*69."
^DIC(9.4,3,22,21,"PAH",242,1,15,0)="============================================================================ "
^DIC(9.4,3,22,21,"PAH",242,1,16,0)=""
^DIC(9.4,3,22,21,"PAH",242,1,17,0)="ROUTINES:"
^DIC(9.4,3,22,21,"PAH",242,1,18,0)="The second line of the routine now looks like:"
^DIC(9.4,3,22,21,"PAH",242,1,19,0)="       ;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",242,1,20,0)=""
^DIC(9.4,3,22,21,"PAH",242,1,21,0)="              Before          After"
^DIC(9.4,3,22,21,"PAH",242,1,22,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,3,22,21,"PAH",242,1,23,0)="------------------------------------------------------------------"
^DIC(9.4,3,22,21,"PAH",242,1,24,0)="ZISPL         14330151        14237859        23,69,291"
^DIC(9.4,3,22,21,"PAH",242,1,25,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",242,1,26,0)=""
^DIC(9.4,3,22,21,"PAH",242,1,27,0)="This patch introduces no new routines."
^DIC(9.4,3,22,21,"PAH",242,1,28,0)="==========================================================================="
^DIC(9.4,3,22,21,"PAH",242,1,29,0)=" "
^DIC(9.4,3,22,21,"PAH",242,1,30,0)="INSTALLATION:"
^DIC(9.4,3,22,21,"PAH",242,1,31,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,3,22,21,"PAH",242,1,32,0)="is at a minimum.  It requires MailMan patches XM*8.0*2 and XM*8.0*15, as"
^DIC(9.4,3,22,21,"PAH",242,1,33,0)="well as Kernel patch XU*8.0*69."
^DIC(9.4,3,22,21,"PAH",242,1,34,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,3,22,21,"PAH",242,1,35,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,3,22,21,"PAH",242,1,36,0)="    affected routine(s).  "
^DIC(9.4,3,22,21,"PAH",242,1,37,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,3,22,21,"PAH",242,1,38,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,3,22,21,"PAH",242,1,39,0)="4.  Users may be on the system.  You do not need to stop TaskMan."
^DIC(9.4,3,22,21,"PAH",242,1,40,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,3,22,21,"PAH",242,1,41,0)="    Transport Global:"
^DIC(9.4,3,22,21,"PAH",242,1,42,0)="       Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",242,1,43,0)="       Print Transport Global"
^DIC(9.4,3,22,21,"PAH",242,1,44,0)="       Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",242,1,45,0)="       Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",242,1,46,0)="       Install Package(s)"
^DIC(9.4,3,22,21,"PAH",242,1,47,0)=" Select INSTALL NAME:    XU*8.0*291    Loaded from Distribution  <date/time>"
^DIC(9.4,3,22,21,"PAH",242,1,48,0)="                         =========="
^DIC(9.4,3,22,21,"PAH",242,1,49,0)=" Install Questions for XU*8.0*291"
^DIC(9.4,3,22,21,"PAH",242,1,50,0)=""
^DIC(9.4,3,22,21,"PAH",242,1,51,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",242,1,52,0)="                                                       =="
^DIC(9.4,3,22,21,"PAH",242,1,53,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,3,22,21,"PAH",242,1,54,0)="                                                                       =="
^DIC(9.4,3,22,21,"PAH",242,1,55,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,3,22,21,"PAH",242,1,56,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,3,22,21,"PAH",242,1,57,0)=" Enter a '^' to abort the install."
^DIC(9.4,3,22,21,"PAH",242,1,58,0)=""
^DIC(9.4,3,22,21,"PAH",242,1,59,0)=" DEVICE: HOME// <You may queue it if you wish>"
^DIC(9.4,3,22,21,"PAH",242,1,60,0)="                ------------------------------"
^DIC(9.4,3,22,21,"PAH",242,1,61,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
