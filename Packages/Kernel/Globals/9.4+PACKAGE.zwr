^DIC(9.4,4,22,1,"PAH",74,1,1,0)="Patch XM*7.1*105"
^DIC(9.4,4,22,1,"PAH",74,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",74,1,3,0)="Y2K Waiver Exemption ID: WE0009"
