^DIC(9.4,52,22,28,"PAH",98,1,0)="^^2^2^2990121"
^DIC(9.4,52,22,28,"PAH",98,1,1,0)="This patch will fix a few NOIS(s) and E3R(s) related to Request For"
^DIC(9.4,52,22,28,"PAH",98,1,2,0)="Quotation Bid (RFQ) module."
