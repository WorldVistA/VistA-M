^DIC(9.4,170,22,2,0)="1.0^3051119^2990628^1"
^DIC(9.4,170,22,2,1,0)="^^6^6^3051119"
^DIC(9.4,170,22,2,1,1,0)="This build contains various messaging support components required by both the "
^DIC(9.4,170,22,2,1,2,0)="clinical and demographic builds.  It includes support for the following."
^DIC(9.4,170,22,2,1,3,0)=" "
^DIC(9.4,170,22,2,1,4,0)="1) Event Queue"
^DIC(9.4,170,22,2,1,5,0)="2) Exception Logging"
^DIC(9.4,170,22,2,1,6,0)="3) Subscription Services"
^DIC(9.4,170,22,2,"PAH",0)="^9.4901^77^77"
