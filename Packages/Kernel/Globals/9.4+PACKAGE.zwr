^DIC(9.4,4,22,1,"PAH",166,1,55,0)="XMA32       8333956      8481844     37,50,159,194"
^DIC(9.4,4,22,1,"PAH",166,1,56,0)="XMSM        7427993      7510310     4,6,13,20,50,176,182,194"
