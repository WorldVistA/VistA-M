^DIC(9.4,163,22,1,"PAH",194,0)="199 SEQ #198^3060711^1"
^DIC(9.4,163,22,1,"PAH",194,1,0)="^^3^3^3060711"
^DIC(9.4,163,22,1,"PAH",194,1,1,0)="Fix ACL cross reference for field .02 in file 8925.1. Add field ""SIGNED "
^DIC(9.4,163,22,1,"PAH",194,1,2,0)="BY SURROGATE to file 8925.7 and provide tool to set this field for notes "
