^DIC(9.4,48,22,5.28,"PAH",41,0)="93 SEQ #79^2970303^1"
^DIC(9.4,48,22,5.28,"PAH",41,1,0)="^^3^3^2970303"
^DIC(9.4,48,22,5.28,"PAH",41,1,1,0)="This build contains changes to two routines.  They are needed to correct a"
^DIC(9.4,48,22,5.28,"PAH",41,1,2,0)="problem of properly filing the primary diagnosis.  If the encounter does"
^DIC(9.4,48,22,5.28,"PAH",41,1,3,0)="not have a primary diagnosis than it will not be accepted by Austin."
^DIC(9.4,48,22,5.28,"PAH",42,0)="92 SEQ #80^2970312^1"
^DIC(9.4,48,22,5.28,"PAH",42,1,0)="^^1^1^2970312"
^DIC(9.4,48,22,5.28,"PAH",42,1,1,0)="Refer to entry SD*5.3*92 of the National Patch Module."
^DIC(9.4,48,22,5.28,"PAH",43,0)="89 SEQ #81^2970312^1"
^DIC(9.4,48,22,5.28,"PAH",43,1,0)="^^2^2^2970312"
^DIC(9.4,48,22,5.28,"PAH",43,1,1,0)="Fixes sporadic undefined error in SCMCDD1.  For complete description, see"
^DIC(9.4,48,22,5.28,"PAH",43,1,2,0)="NPM."
^DIC(9.4,48,22,5.28,"PAH",44,0)="91 SEQ #82^2970312^1"
^DIC(9.4,48,22,5.28,"PAH",44,1,0)="^^5^5^2970312"
^DIC(9.4,48,22,5.28,"PAH",44,1,1,0)="Patch for NOIS: MAD-1196-40990"
^DIC(9.4,48,22,5.28,"PAH",44,1,2,0)="EMPLOYEES 7 RESEARCH REQUIRING MT"
^DIC(9.4,48,22,5.28,"PAH",44,1,3,0)=" "
^DIC(9.4,48,22,5.28,"PAH",44,1,4,0)="Corrects the ELAP^SDPCE API call to return the eligibility pointer and"
^DIC(9.4,48,22,5.28,"PAH",44,1,5,0)="appointment type pointer in the correct piece positions."
^DIC(9.4,48,22,5.28,"PAH",45,0)="82 SEQ #83^2970317^1"
^DIC(9.4,48,22,5.28,"PAH",45,1,0)="^^1^1^2970317"
^DIC(9.4,48,22,5.28,"PAH",45,1,1,0)="See NPM for description."
^DIC(9.4,48,22,5.28,"PAH",46,0)="90 SEQ #84^2970317^1"
^DIC(9.4,48,22,5.28,"PAH",46,1,0)="^^2^2^2970317"
^DIC(9.4,48,22,5.28,"PAH",46,1,1,0)=" "
^DIC(9.4,48,22,5.28,"PAH",46,1,2,0)="See patch description in the Patch Module for patch SD*5.3*90."
^DIC(9.4,48,22,5.28,"PAH",47,0)="95 SEQ #85^2970321^1"
^DIC(9.4,48,22,5.28,"PAH",47,1,0)="^^2^2^2970321"
^DIC(9.4,48,22,5.28,"PAH",47,1,1,0)="Corrects the handling of associated credit stop codes for Hospital"
^DIC(9.4,48,22,5.28,"PAH",47,1,2,0)="locations that are exempted from sending diagnostic codes"
^DIC(9.4,48,22,5.28,"PAH",48,0)="52 SEQ #86^2970321^1"
^DIC(9.4,48,22,5.28,"PAH",48,1,0)="^^2^2^2970321"
^DIC(9.4,48,22,5.28,"PAH",48,1,1,0)="PCMM Reporting Device problems.  For a complete description, please see"
^DIC(9.4,48,22,5.28,"PAH",48,1,2,0)="the NPM."
^DIC(9.4,48,22,5.28,"PAH",49,0)="96 SEQ #87^2970326^1"
^DIC(9.4,48,22,5.28,"PAH",49,1,0)="^^1^1^2970326"
^DIC(9.4,48,22,5.28,"PAH",49,1,1,0)="Refer to National Patch Module for details"
^DIC(9.4,48,22,5.28,"PAH",50,0)="109 SEQ #88^2970326^1"
^DIC(9.4,48,22,5.28,"PAH",50,1,0)="^^1^1^2970326"
^DIC(9.4,48,22,5.28,"PAH",50,1,1,0)="See National Patch Module for description."
^DIC(9.4,48,22,5.28,"PAH",51,0)="97 SEQ #89^2970326^1"
^DIC(9.4,48,22,5.28,"PAH",51,1,0)="^^2^2^2970326"
^DIC(9.4,48,22,5.28,"PAH",51,1,1,0)="This build contians the routines necessary to correct xeveral problems"
^DIC(9.4,48,22,5.28,"PAH",51,1,2,0)="with the deletion of Add/Edits."
^DIC(9.4,48,22,5.28,"PAH",52,0)="99 SEQ #90^2970401^1"
^DIC(9.4,48,22,5.28,"PAH",52,1,0)="^^6^6^2970401"
^DIC(9.4,48,22,5.28,"PAH",52,1,1,0)="This patch address's duplicate encounters being added to the transmitted"
^DIC(9.4,48,22,5.28,"PAH",52,1,2,0)="outpatient encounter file, encounters in the transmitted file by error,"
^DIC(9.4,48,22,5.28,"PAH",52,1,3,0)="and missing checked out encounters."
^DIC(9.4,48,22,5.28,"PAH",52,1,4,0)=" "
^DIC(9.4,48,22,5.28,"PAH",52,1,5,0)="This patch creates a Supervisor Ambulatory Care Menu on the Ambulatory"
^DIC(9.4,48,22,5.28,"PAH",52,1,6,0)="care reporting menu."
^DIC(9.4,48,22,5.28,"PAH",53,0)="105 SEQ #91^2970401^1"
^DIC(9.4,48,22,5.28,"PAH",53,1,0)="^^61^61^2970401"
^DIC(9.4,48,22,5.28,"PAH",53,1,1,0)="  Refer to National Patch Module for complete details"
^DIC(9.4,48,22,5.28,"PAH",53,1,2,0)=""
^DIC(9.4,48,22,5.28,"PAH",53,1,3,0)="  Clean up of the ACRP transmission files"
^DIC(9.4,48,22,5.28,"PAH",53,1,4,0)="  ---------------------------------------"
^DIC(9.4,48,22,5.28,"PAH",53,1,5,0)="  The first clean up routine, SD53105A, will clean up dangling pointers"
^DIC(9.4,48,22,5.28,"PAH",53,1,6,0)="  and orphan entries within the ACRP transmission files.  The following"
^DIC(9.4,48,22,5.28,"PAH",53,1,7,0)="  actions/checks will be performed:"
^DIC(9.4,48,22,5.28,"PAH",53,1,8,0)=" "
^DIC(9.4,48,22,5.28,"PAH",53,1,9,0)="  (1) Entries in the Transmitted Outpatient Encounter file (409.73)"
^DIC(9.4,48,22,5.28,"PAH",53,1,10,0)="      that do not have a valid pointer to the Outpatient Encounter"
^DIC(9.4,48,22,5.28,"PAH",53,1,11,0)="      file (#409.68) or the Deleted Outpatient Encounter file"
^DIC(9.4,48,22,5.28,"PAH",53,1,12,0)="      (#409.74) are deleted."
^DIC(9.4,48,22,5.28,"PAH",53,1,13,0)=" "
^DIC(9.4,48,22,5.28,"PAH",53,1,14,0)="  (2) Entries in the Transmitted Outpatient Encounter file that have"
^DIC(9.4,48,22,5.28,"PAH",53,1,15,0)="      been rejected by the Austin Automation Center and do not have an"
^DIC(9.4,48,22,5.28,"PAH",53,1,16,0)="      entry in the Transmitted Outpatient Encounter Error file"
^DIC(9.4,48,22,5.28,"PAH",53,1,17,0)="      (#409.75) are marked for re-transmission."
^DIC(9.4,48,22,5.28,"PAH",53,1,18,0)=" "
^DIC(9.4,48,22,5.28,"PAH",53,1,19,0)="  (3) Entries in the Deleted Outpatient Encounter file that do not"
^DIC(9.4,48,22,5.28,"PAH",53,1,20,0)="      have a corresponding entry in the Transmitted Outpatient"
^DIC(9.4,48,22,5.28,"PAH",53,1,21,0)="      Encounter file are deleted."
^DIC(9.4,48,22,5.28,"PAH",53,1,22,0)=" "
^DIC(9.4,48,22,5.28,"PAH",53,1,23,0)="  (4) Entries in the Transmitted Outpatient Encounter Error file that"
^DIC(9.4,48,22,5.28,"PAH",53,1,24,0)="      do not have a valid pointer to the Transmitted Outpatient"
^DIC(9.4,48,22,5.28,"PAH",53,1,25,0)="      Encounter file are deleted."
^DIC(9.4,48,22,5.28,"PAH",53,1,26,0)=" "
^DIC(9.4,48,22,5.28,"PAH",53,1,27,0)="  The entry point SCAN^SD53105A should be used to scan for errors and"
^DIC(9.4,48,22,5.28,"PAH",53,1,28,0)="  print what would have been done."
^DIC(9.4,48,22,5.28,"PAH",53,1,29,0)=" "
^DIC(9.4,48,22,5.28,"PAH",53,1,30,0)="  The entry point FIX^SD53105A should be used to fix the errors."
^DIC(9.4,48,22,5.28,"PAH",53,1,31,0)="  Although nothing is printed, a summary of what was done is sent to"
^DIC(9.4,48,22,5.28,"PAH",53,1,32,0)="  the user queueing the fix and recipients of the SCDX AMBCARE TO"
^DIC(9.4,48,22,5.28,"PAH",53,1,33,0)="  NPCDB SUMMARY bulletin."
^DIC(9.4,48,22,5.28,"PAH",53,1,34,0)=" "
^DIC(9.4,48,22,5.28,"PAH",53,1,35,0)=" "
^DIC(9.4,48,22,5.28,"PAH",53,1,36,0)="  Clean up of the Scheduling Visits file and Clinic Stop Code multiple"
^DIC(9.4,48,22,5.28,"PAH",53,1,37,0)="  --------------------------------------------------------------------"
^DIC(9.4,48,22,5.28,"PAH",53,1,38,0)="  The second clean up routine, SD53105B, will clean up missing pointers"
^DIC(9.4,48,22,5.28,"PAH",53,1,39,0)="  and stub entries in the Scheduling Visits file.  The following"
^DIC(9.4,48,22,5.28,"PAH",53,1,40,0)="  actions/checks will be performed:"
^DIC(9.4,48,22,5.28,"PAH",53,1,41,0)=" "
^DIC(9.4,48,22,5.28,"PAH",53,1,42,0)="  (1) Performs a search for entries in the Clinic Stop Code multiple"
^DIC(9.4,48,22,5.28,"PAH",53,1,43,0)="      (#10) of the Scheduling Visits file (#409.5) that do not point"
^DIC(9.4,48,22,5.28,"PAH",53,1,44,0)="      to an entry in the Outpatient Encounter file (#409.68).   For"
^DIC(9.4,48,22,5.28,"PAH",53,1,45,0)="      those found, an existing Outpatient Encounter that matches the"
^DIC(9.4,48,22,5.28,"PAH",53,1,46,0)="      clinic stop will be attached to the entry or a new Outpatient"
^DIC(9.4,48,22,5.28,"PAH",53,1,47,0)="      Encounter will be created for it."
^DIC(9.4,48,22,5.28,"PAH",53,1,48,0)=" "
^DIC(9.4,48,22,5.28,"PAH",53,1,49,0)="  (2) Stub entries in the Clinic Stop Code multiple are deleted."
^DIC(9.4,48,22,5.28,"PAH",53,1,50,0)=" "
^DIC(9.4,48,22,5.28,"PAH",53,1,51,0)="  (3) Entries in the Scheduling Visits file with no clinic stops are"
^DIC(9.4,48,22,5.28,"PAH",53,1,52,0)="      deleted."
^DIC(9.4,48,22,5.28,"PAH",53,1,53,0)=" "
^DIC(9.4,48,22,5.28,"PAH",53,1,54,0)="  The entry point SCAN^SD53105B should be used to scan for errors and"
^DIC(9.4,48,22,5.28,"PAH",53,1,55,0)="  print what would have been done."
^DIC(9.4,48,22,5.28,"PAH",53,1,56,0)=" "
^DIC(9.4,48,22,5.28,"PAH",53,1,57,0)="  The entry point FIX^SD53105B should be used to fix the errors."
^DIC(9.4,48,22,5.28,"PAH",53,1,58,0)="  Although nothing is printed, a summary of what was done is sent to"
^DIC(9.4,48,22,5.28,"PAH",53,1,59,0)="  the user queueing the fix and recipients of the SCDX AMBCARE TO"
^DIC(9.4,48,22,5.28,"PAH",53,1,60,0)="  NPCDB SUMMARY bulletin."
^DIC(9.4,48,22,5.28,"PAH",53,1,61,0)=""
^DIC(9.4,48,22,5.28,"PAH",54,0)="104 SEQ #92^2970401^1"
^DIC(9.4,48,22,5.28,"PAH",54,1,0)="^^5^5^2970401"
^DIC(9.4,48,22,5.28,"PAH",54,1,1,0)="This patch provides two cleanup actions: 1) clean-up bad radiology"
^DIC(9.4,48,22,5.28,"PAH",54,1,2,0)="add/edits in the SCHEDULING VISITS File, #409.5; 2) provide a utility for"
^DIC(9.4,48,22,5.28,"PAH",54,1,3,0)="users to redesignate appointment types for Occassion of Service encounters"
^DIC(9.4,48,22,5.28,"PAH",54,1,4,0)="that received a 'regular' appointment type inappropriately in the"
^DIC(9.4,48,22,5.28,"PAH",54,1,5,0)="SCHEDULING VISITS File, #409.5."
^DIC(9.4,48,22,5.28,"PAH",55,0)="98 SEQ #93^2970408^1"
^DIC(9.4,48,22,5.28,"PAH",55,1,0)="^^3^3^2970408"
^DIC(9.4,48,22,5.28,"PAH",55,1,1,0)="This patch addresses a problem raised in NOIS ISA-0197-12151, where the"
^DIC(9.4,48,22,5.28,"PAH",55,1,2,0)="position of the data for two fields is reversed on the PCMM Team's"
^DIC(9.4,48,22,5.28,"PAH",55,1,3,0)="Patients report.  See NPM for complete description."
^DIC(9.4,48,22,5.28,"PAH",56,0)="100 SEQ #94^2970408^1"
^DIC(9.4,48,22,5.28,"PAH",56,1,0)="^^7^7^2970408"
^DIC(9.4,48,22,5.28,"PAH",56,1,1,0)="This is a replacement to SD*5.3*87, which was entered in error.  In"
^DIC(9.4,48,22,5.28,"PAH",56,1,2,0)="addition to fixing the problem introduced with SD*5.3*87 (problems with"
^DIC(9.4,48,22,5.28,"PAH",56,1,3,0)="certain Room-Beds) this patch does the following:"
^DIC(9.4,48,22,5.28,"PAH",56,1,4,0)=" "
^DIC(9.4,48,22,5.28,"PAH",56,1,5,0)="Fixes non-printing of Inpatient Provider in Inpatient MailMan messages."
^DIC(9.4,48,22,5.28,"PAH",56,1,6,0)="Fixes subjects for PCMM MailMan messages removes full name and full SSN"
^DIC(9.4,48,22,5.28,"PAH",56,1,7,0)="from message subject. For complete description, see NPM."
^DIC(9.4,48,22,5.28,"PAH",57,0)="102 SEQ #95^2970409^1"
