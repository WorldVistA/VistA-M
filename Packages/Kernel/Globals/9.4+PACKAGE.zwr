^DIC(9.4,13,22,9,"PAH",12,0)="16 SEQ #12^3190708.215918^65"
^DIC(9.4,13,22,9,"PAH",13,0)="17 SEQ #13^3190815.16145^65"
^DIC(9.4,13,22,9,"PAH",13,1,0)="^^127^127^3190815"
^DIC(9.4,13,22,9,"PAH",13,1,1,0)="Description:"
^DIC(9.4,13,22,9,"PAH",13,1,2,0)="==========="
^DIC(9.4,13,22,9,"PAH",13,1,3,0)="Patch 17 correct 2 issues that were discovered during pre-load"
^DIC(9.4,13,22,9,"PAH",13,1,4,0)="of the Veteran's Data Integration & Federation (VDIF) Qualifying"
^DIC(9.4,13,22,9,"PAH",13,1,5,0)="Patient Query (QPQ) endeavor."
^DIC(9.4,13,22,9,"PAH",13,1,6,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,7,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,8,0)="Patch Components:"
^DIC(9.4,13,22,9,"PAH",13,1,9,0)="-----------------"
^DIC(9.4,13,22,9,"PAH",13,1,10,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,11,0)="none"
^DIC(9.4,13,22,9,"PAH",13,1,12,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,13,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,14,0)="Blood Bank Clearance:"
^DIC(9.4,13,22,9,"PAH",13,1,15,0)="---------------------"
^DIC(9.4,13,22,9,"PAH",13,1,16,0)="?/??/2019"
^DIC(9.4,13,22,9,"PAH",13,1,17,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch DI*22.2*17 contains"
^DIC(9.4,13,22,9,"PAH",13,1,18,0)="changes to a package referenced in ProPath standard titled: BBM Team"
^DIC(9.4,13,22,9,"PAH",13,1,19,0)="Review of VistA Patches. This patch does not alter or modify any VistA"
^DIC(9.4,13,22,9,"PAH",13,1,20,0)="Blood Bank software design safeguards or safety critical elements"
^DIC(9.4,13,22,9,"PAH",13,1,21,0)="functions."
^DIC(9.4,13,22,9,"PAH",13,1,22,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,23,0)="RISK ANALYSIS: Changes made by patch DI*22.2*17 have no adverse effect on"
^DIC(9.4,13,22,9,"PAH",13,1,24,0)="Blood Bank software functionality, therefore RISK is none. "
^DIC(9.4,13,22,9,"PAH",13,1,25,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,26,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,27,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,13,22,9,"PAH",13,1,28,0)="--------------------------------------------"
^DIC(9.4,13,22,9,"PAH",13,1,29,0)="1. Problem:"
^DIC(9.4,13,22,9,"PAH",13,1,30,0)="    Word processing and free text fields can contain control characters from"
^DIC(9.4,13,22,9,"PAH",13,1,31,0)="    the extended character set ($C values of 127 to 159)"
^DIC(9.4,13,22,9,"PAH",13,1,32,0)="   Resolution:"
^DIC(9.4,13,22,9,"PAH",13,1,33,0)="    Change DDEG to remove control characters"
^DIC(9.4,13,22,9,"PAH",13,1,34,0)="  "
^DIC(9.4,13,22,9,"PAH",13,1,35,0)="2. Problem:"
^DIC(9.4,13,22,9,"PAH",13,1,36,0)="    Inquire to ENTITY file option doesn't display GROUP AS A LIST items."
^DIC(9.4,13,22,9,"PAH",13,1,37,0)="   Resolution:"
^DIC(9.4,13,22,9,"PAH",13,1,38,0)="    Change DDEPRT to display GROUP AS A LIST items"
^DIC(9.4,13,22,9,"PAH",13,1,39,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,40,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,41,0)="Test Sites:"
^DIC(9.4,13,22,9,"PAH",13,1,42,0)="-----------"
^DIC(9.4,13,22,9,"PAH",13,1,43,0)="TBD"
^DIC(9.4,13,22,9,"PAH",13,1,44,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,45,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,46,0)="Software and Documentation Retrieval Instructions:"
^DIC(9.4,13,22,9,"PAH",13,1,47,0)="-------------------------------------------------- "
^DIC(9.4,13,22,9,"PAH",13,1,48,0)="Software is being released as a KIDS Build on Forum."
^DIC(9.4,13,22,9,"PAH",13,1,49,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,50,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,51,0)="Patch Installation:"
^DIC(9.4,13,22,9,"PAH",13,1,52,0)="  "
^DIC(9.4,13,22,9,"PAH",13,1,53,0)="Pre-Installation Instructions:"
^DIC(9.4,13,22,9,"PAH",13,1,54,0)="------------------------------"
^DIC(9.4,13,22,9,"PAH",13,1,55,0)="This patch can be queued for installation.  TaskMan does not have to be"
^DIC(9.4,13,22,9,"PAH",13,1,56,0)="stopped, Health Level 7 (HL7) filers do not need to be stopped, and"
^DIC(9.4,13,22,9,"PAH",13,1,57,0)="users may be on the system.  The patch should be installed during"
^DIC(9.4,13,22,9,"PAH",13,1,58,0)="non-peak hours to minimize potential for disruption to users.  This"
^DIC(9.4,13,22,9,"PAH",13,1,59,0)="patch should take less than 1 minute to install."
^DIC(9.4,13,22,9,"PAH",13,1,60,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,61,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,62,0)="Installation Instructions:"
^DIC(9.4,13,22,9,"PAH",13,1,63,0)="--------------------------"
^DIC(9.4,13,22,9,"PAH",13,1,64,0)="1. Choose the MailMan message containing this patch."
^DIC(9.4,13,22,9,"PAH",13,1,65,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,66,0)="2. Choose the INSTALL/CHECK MESSAGE PackMan option.  "
^DIC(9.4,13,22,9,"PAH",13,1,67,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,68,0)="3. From the Kernel Installation and Distribution System Menu, select"
^DIC(9.4,13,22,9,"PAH",13,1,69,0)="   the Installation Menu.  From this menu, you may elect to use the"
^DIC(9.4,13,22,9,"PAH",13,1,70,0)="   following options. When prompted for the INSTALL NAME enter"
^DIC(9.4,13,22,9,"PAH",13,1,71,0)="   DI*22.2*17."
^DIC(9.4,13,22,9,"PAH",13,1,72,0)=" a. Print Transport Global - This option lets you print the contents"
^DIC(9.4,13,22,9,"PAH",13,1,73,0)="    of a Transport Global that is currently loaded in the ^XTMP"
^DIC(9.4,13,22,9,"PAH",13,1,74,0)="    global."
^DIC(9.4,13,22,9,"PAH",13,1,75,0)=" b. Backup a Transport Global - This option will create a backup"
^DIC(9.4,13,22,9,"PAH",13,1,76,0)="    message of any routines exported with this patch. It will not"
^DIC(9.4,13,22,9,"PAH",13,1,77,0)="    backup any other changes such as functions."
^DIC(9.4,13,22,9,"PAH",13,1,78,0)=" c. Compare Transport Global to Current System - This option will"
^DIC(9.4,13,22,9,"PAH",13,1,79,0)="    allow you to view all changes that will be made when this patch"
^DIC(9.4,13,22,9,"PAH",13,1,80,0)="    is installed.  It compares all components of this patch"
^DIC(9.4,13,22,9,"PAH",13,1,81,0)="    (routines, DDs, templates, etc.)."
^DIC(9.4,13,22,9,"PAH",13,1,82,0)=" d. Verify Checksums in Transport Global - This option will allow"
^DIC(9.4,13,22,9,"PAH",13,1,83,0)="    you to ensure the integrity of the routines that are in the"
^DIC(9.4,13,22,9,"PAH",13,1,84,0)="    transport global."
^DIC(9.4,13,22,9,"PAH",13,1,85,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,86,0)="4. From the Installation Menu, select the Install Package(s) option"
^DIC(9.4,13,22,9,"PAH",13,1,87,0)="   and when prompted for the INSTALL NAME, enter DI*22.2*17."
^DIC(9.4,13,22,9,"PAH",13,1,88,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,89,0)="5. If prompted 'Want KIDS to Rebuild Menu Trees Upon Completion of"
^DIC(9.4,13,22,9,"PAH",13,1,90,0)="   Install? NO//' respond NO."
^DIC(9.4,13,22,9,"PAH",13,1,91,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,92,0)="6. When prompted ""Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,13,22,9,"PAH",13,1,93,0)="   NO//"" respond NO."
^DIC(9.4,13,22,9,"PAH",13,1,94,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,95,0)="7. If prompted ""Want to DISABLE Scheduled Options, Menu Options, "
^DIC(9.4,13,22,9,"PAH",13,1,96,0)="   and Protocols? NO//"" respond NO. "
^DIC(9.4,13,22,9,"PAH",13,1,97,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,98,0)="8. If prompted ""Delay Install (Minutes):  (0 - 60): 0//"" respond 0."
^DIC(9.4,13,22,9,"PAH",13,1,99,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,100,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,101,0)="Post-Installation Instructions:"
^DIC(9.4,13,22,9,"PAH",13,1,102,0)="-------------------------------"
^DIC(9.4,13,22,9,"PAH",13,1,103,0)="none"
^DIC(9.4,13,22,9,"PAH",13,1,104,0)="  "
^DIC(9.4,13,22,9,"PAH",13,1,105,0)="  "
^DIC(9.4,13,22,9,"PAH",13,1,106,0)="Backout and Rollback Procedure:"
^DIC(9.4,13,22,9,"PAH",13,1,107,0)="------------------------------- "
^DIC(9.4,13,22,9,"PAH",13,1,108,0)="If rollback/backout is required, the installer can restore the routines"
^DIC(9.4,13,22,9,"PAH",13,1,109,0)="using the MailMan message that were saved prior to installing the"
^DIC(9.4,13,22,9,"PAH",13,1,110,0)="patch."
^DIC(9.4,13,22,9,"PAH",13,1,111,0)=" "
^DIC(9.4,13,22,9,"PAH",13,1,112,0)=" "
