^DIC(9.4,4,22,1,"PAH",92,0)="120 SEQ #117^3000516^1"
^DIC(9.4,4,22,1,"PAH",92,1,0)="^^60^60^3000516"
^DIC(9.4,4,22,1,"PAH",92,1,1,0)="Patch XM*7.1*120"
^DIC(9.4,4,22,1,"PAH",92,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",92,1,3,0)="NOIS:  WBP-0200-22440"
^DIC(9.4,4,22,1,"PAH",92,1,4,0)="Test Site:  Wilkes Barre, PA"
^DIC(9.4,4,22,1,"PAH",92,1,5,0)=""
^DIC(9.4,4,22,1,"PAH",92,1,6,0)="Ensure that subjects are 3-65 characters, and are not of the format 1""R""1.N"
^DIC(9.4,4,22,1,"PAH",92,1,7,0)="(which is reserved for responses). "
^DIC(9.4,4,22,1,"PAH",92,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",92,1,9,0)="In particular,"
^DIC(9.4,4,22,1,"PAH",92,1,10,0)="- bulletin subjects will be truncated if they are longer than 65 characters."
^DIC(9.4,4,22,1,"PAH",92,1,11,0)="- users will no longer be able to enter a subject of the format Rnnnn."
^DIC(9.4,4,22,1,"PAH",92,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",92,1,13,0)="NOTE: This patch should be installed after hours, when user activity is at a"
^DIC(9.4,4,22,1,"PAH",92,1,14,0)="minimum.  It requires MailMan patch XM*7.1*107."
^DIC(9.4,4,22,1,"PAH",92,1,15,0)="============================================================================ "
