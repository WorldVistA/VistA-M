^DIC(9.4,97,22,18,0)="4.0^3050315^3050401^1"
^DIC(9.4,97,22,18,1,0)="^^12^12^3050401"
^DIC(9.4,97,22,18,1,1,0)="The PBM V. 4.0 application contains enhancements to support the VA "
^DIC(9.4,97,22,18,1,2,0)="National Formulary (VANF), disease management issues and patient safety "
^DIC(9.4,97,22,18,1,3,0)="initiatives. "
^DIC(9.4,97,22,18,1,4,0)=" "
^DIC(9.4,97,22,18,1,5,0)="Two new extracts have been created to gather patient vital/immunization "
^DIC(9.4,97,22,18,1,6,0)="and allergy/adverse reaction data.  Modifications have also been "
^DIC(9.4,97,22,18,1,7,0)="made to existing Prescription, Unit Dose, Intravenous (IV),"
^DIC(9.4,97,22,18,1,8,0)="Controlled Substance (CS), Automatic Replenishment/Ward Stock (AR/WS),"
^DIC(9.4,97,22,18,1,9,0)="Procurement, Patient Demographic, Outpatient Visits, Laboratory "
^DIC(9.4,97,22,18,1,10,0)="extracts, and existing PBM options.  New summary reports have been "
^DIC(9.4,97,22,18,1,11,0)="created for Automated Management Information System (AMIS) reporting.  New"
^DIC(9.4,97,22,18,1,12,0)="options have also been created to support the added functionality."
^DIC(9.4,97,22,18,"PAH",0)="^9.4901^21^21"
^DIC(9.4,97,22,18,"PAH",1,0)="4 SEQ #1^3051020^1"
^DIC(9.4,97,22,18,"PAH",1,1,0)="^^3^3^3051020"
^DIC(9.4,97,22,18,"PAH",1,1,1,0)="This patch corrects the IV AMIS Summary report for the Pharmacy "
^DIC(9.4,97,22,18,"PAH",1,1,2,0)="Benefits Management (PBM) Version 4.0 extract in cases where there is "
^DIC(9.4,97,22,18,"PAH",1,1,3,0)="very little or no IV data available for the date range of an IV extract."
^DIC(9.4,97,22,18,"PAH",2,0)="3 SEQ #2^3060308^1"
^DIC(9.4,97,22,18,"PAH",2,1,0)="^^17^17^3060308"
^DIC(9.4,97,22,18,"PAH",2,1,1,0)="The Pharmacy Benefits Management (PBM) Extract Enhancement III project "
^DIC(9.4,97,22,18,"PAH",2,1,2,0)="provides enhancements to send all chemistry lab test results to the "
^DIC(9.4,97,22,18,"PAH",2,1,3,0)="Consolidated Mail Outpatient Pharmacy (CMOP) National Server.  These "
^DIC(9.4,97,22,18,"PAH",2,1,4,0)="results are sent via Health Level 7 (HL7) messages using the Health Level "
^DIC(9.4,97,22,18,"PAH",2,1,5,0)="Seven Optimized (HLO) messaging service.  "
^DIC(9.4,97,22,18,"PAH",2,1,6,0)=" "
^DIC(9.4,97,22,18,"PAH",2,1,7,0)="This patch includes an environmental check routine. The preinstallation "
^DIC(9.4,97,22,18,"PAH",2,1,8,0)="steps require the logical link, PSU SEND, to be defined correctly. It "
^DIC(9.4,97,22,18,"PAH",2,1,9,0)="checks to see if it is unfurling within a test area or a live area and if"
^DIC(9.4,97,22,18,"PAH",2,1,10,0)="the link is configured incorrectly, the installation lists what is wrong "
^DIC(9.4,97,22,18,"PAH",2,1,11,0)="with the link and then aborts.  The IRM can troubleshoot the link and run "
^DIC(9.4,97,22,18,"PAH",2,1,12,0)="the installation of PSU*4*3 once he has the link defined as specified."
^DIC(9.4,97,22,18,"PAH",2,1,13,0)=" "
^DIC(9.4,97,22,18,"PAH",2,1,14,0)="This patch also includes the listening software employed at the CMOP-NAT"
^DIC(9.4,97,22,18,"PAH",2,1,15,0)="server. It is routines PSULRHL2 & PSULRHL3. NEITHER OF THESE ROUTINES "
^DIC(9.4,97,22,18,"PAH",2,1,16,0)="SHOULD BE USED AT SITES.  These should only be deployed on the CMOP-NAT"
^DIC(9.4,97,22,18,"PAH",2,1,17,0)="server for PBM."
^DIC(9.4,97,22,18,"PAH",3,0)="7 SEQ #3^3060410^1"
^DIC(9.4,97,22,18,"PAH",3,1,0)="^^2^2^3060410"
^DIC(9.4,97,22,18,"PAH",3,1,1,0)="When printing a mapping report in Map Pharmacy Locations [PSU MAP PHARMACY"
^DIC(9.4,97,22,18,"PAH",3,1,2,0)="LOCATIONS] option, an undefined error occurs."
^DIC(9.4,97,22,18,"PAH",4,0)="6 SEQ #4^3060504^1"
^DIC(9.4,97,22,18,"PAH",4,1,0)="^^6^6^3060504"
^DIC(9.4,97,22,18,"PAH",4,1,1,0)="This patch corrects the AR/WS AMIS Summary report for the Pharmacy"
^DIC(9.4,97,22,18,"PAH",4,1,2,0)="Benefits Management (PBM) Version 4.0 extract in cases where there is no"
^DIC(9.4,97,22,18,"PAH",4,1,3,0)="AR/WS data available for the date range of an AR/WS extract."
^DIC(9.4,97,22,18,"PAH",4,1,4,0)=" "
^DIC(9.4,97,22,18,"PAH",4,1,5,0)="This patch also corrects the Prescription Extract MailMan messages"
^DIC(9.4,97,22,18,"PAH",4,1,6,0)="containing mismatched data elements for partial fill prescriptions."
^DIC(9.4,97,22,18,"PAH",5,0)="8 SEQ #5^3060824^1"
^DIC(9.4,97,22,18,"PAH",5,1,0)="^^10^10^3060824"
^DIC(9.4,97,22,18,"PAH",5,1,1,0)="Issue #1: The Provider Summary report is reporting missing data.  When a"
^DIC(9.4,97,22,18,"PAH",5,1,2,0)="Provider has a Service/Section, the Provider will incorrectly show up on"
^DIC(9.4,97,22,18,"PAH",5,1,3,0)="the report as missing specific data."
^DIC(9.4,97,22,18,"PAH",5,1,4,0)=" "
^DIC(9.4,97,22,18,"PAH",5,1,5,0)="Issue #2:  When running Manual Pharmacy Statistics [PSU PBM MANUAL] "
^DIC(9.4,97,22,18,"PAH",5,1,6,0)="option, the clinic that appears in a mailman message is not"
^DIC(9.4,97,22,18,"PAH",5,1,7,0)="the same clinic that appears in the PRESCRIPTION file (#52)."
^DIC(9.4,97,22,18,"PAH",5,1,8,0)=" "
^DIC(9.4,97,22,18,"PAH",5,1,9,0)="Issue #3: This patch will clean up routines no longer being used in the "
^DIC(9.4,97,22,18,"PAH",5,1,10,0)="Pharmacy Benefits Management package."
^DIC(9.4,97,22,18,"PAH",6,0)="10 SEQ #6^3061227.143918^1"
^DIC(9.4,97,22,18,"PAH",6,1,0)="^^5^5^3061227"
^DIC(9.4,97,22,18,"PAH",6,1,1,0)="This patch will address the ALLERGIC/ADVERS REACTIONS report."
^DIC(9.4,97,22,18,"PAH",6,1,2,0)=" "
^DIC(9.4,97,22,18,"PAH",6,1,3,0)="Issue #1 (REMEDY HD167841):"
^DIC(9.4,97,22,18,"PAH",6,1,4,0)="The PBM Allergic/Advers Reactions report has missing and incorrect data "
^DIC(9.4,97,22,18,"PAH",6,1,5,0)="being reported."
^DIC(9.4,97,22,18,"PAH",7,0)="9 SEQ #7^3070904.223921^1"
^DIC(9.4,97,22,18,"PAH",7,1,0)="^^1^1^3070904"
^DIC(9.4,97,22,18,"PAH",7,1,1,0)="PBM FIXES: MAPPED LOCATIONS/PHARM IEN/AMIS REPORT HEADER"
^DIC(9.4,97,22,18,"PAH",8,0)="11 SEQ #8^3080203.214144^1"
^DIC(9.4,97,22,18,"PAH",8,1,0)="^^2^2^3080203"
^DIC(9.4,97,22,18,"PAH",8,1,1,0)="This patch will address the subscript error that occurs on mircbiology"
^DIC(9.4,97,22,18,"PAH",8,1,2,0)="records for verified chemistry lab results on the PBM/HL7 interface."
^DIC(9.4,97,22,18,"PAH",9,0)="12 SEQ #9^3080203.223551^1"
^DIC(9.4,97,22,18,"PAH",9,1,0)="^^1^1^3080203"
^DIC(9.4,97,22,18,"PAH",9,1,1,0)="PBM Pharmacy Statistics Report"
^DIC(9.4,97,22,18,"PAH",10,0)="13 SEQ #10^3080526.191052^1"
^DIC(9.4,97,22,18,"PAH",10,1,0)="^^3^3^3080526"
^DIC(9.4,97,22,18,"PAH",10,1,1,0)="This patch will correct the following,"
^DIC(9.4,97,22,18,"PAH",10,1,2,0)="HD198412  -  PBM UNmapped locations showing again"
^DIC(9.4,97,22,18,"PAH",10,1,3,0)="HD227109  -  PBM EXTRACT COPAY FIELD NOT FUNCTIONING"
^DIC(9.4,97,22,18,"PAH",11,0)="14 SEQ #11^3090423.123653^17"
^DIC(9.4,97,22,18,"PAH",11,1,0)="^^4^4^3090423"
^DIC(9.4,97,22,18,"PAH",11,1,1,0)="Associated Remedy Tickets:"
^DIC(9.4,97,22,18,"PAH",11,1,2,0)="=========================="
^DIC(9.4,97,22,18,"PAH",11,1,3,0)="HD261253 - a loop in PSUAA1"
^DIC(9.4,97,22,18,"PAH",11,1,4,0)=" d HD280061 - 2 Monthly report will not run to completion - PSUAA1 loop."
^DIC(9.4,97,22,18,"PAH",12,0)="15 SEQ #12^3090708.145611^17"
^DIC(9.4,97,22,18,"PAH",12,1,0)="^^7^7^3090708"
^DIC(9.4,97,22,18,"PAH",12,1,1,0)="Associated Remedy Tickets:"
^DIC(9.4,97,22,18,"PAH",12,1,2,0)="=========================="
^DIC(9.4,97,22,18,"PAH",12,1,3,0)="HD288563 - 6 PBM EXTRACT DOES NOT COLLECT ALL ICD9 CODES"
^DIC(9.4,97,22,18,"PAH",12,1,4,0)="HD286672 - 8 <SUBSCRIPT>VITALS+55^PSUVIT1"
^DIC(9.4,97,22,18,"PAH",12,1,5,0)="HD290578 - 5 <UNDEFINED>RPT+9^PSUCP1"
^DIC(9.4,97,22,18,"PAH",12,1,6,0)="HD293287 - 6 CONSISTENCY IN PBM EXTRACT MAIL MSG SUBJECT"
^DIC(9.4,97,22,18,"PAH",12,1,7,0)="HD251472 - 2 Undefined error DAT2+11~PSUDEM2"
^DIC(9.4,97,22,18,"PAH",13,0)="5^3090714.15213^17"
^DIC(9.4,97,22,18,"PAH",13,1,0)="^^34^34^3090714"
^DIC(9.4,97,22,18,"PAH",13,1,1,0)="This patch addresses a request which support the Pharmacy Benefits"
^DIC(9.4,97,22,18,"PAH",13,1,2,0)="Management (PBM) Extracts Enhancement #3 project. In order to allow the"
^DIC(9.4,97,22,18,"PAH",13,1,3,0)="retransmission of only those patients who have had demographic updates,"
^DIC(9.4,97,22,18,"PAH",13,1,4,0)="Outpatient Pharmacy V. 7.0, Inpatient Medications V. 5.0, Registration"
^DIC(9.4,97,22,18,"PAH",13,1,5,0)="v. 5.3 and Pharmacy Data Management V. 1.0 were modified to build an entry"
^DIC(9.4,97,22,18,"PAH",13,1,6,0)="for re-transmission in PBM PATIENT DEMOGRAPHICS File #59.9."
^DIC(9.4,97,22,18,"PAH",13,1,7,0)=" "
^DIC(9.4,97,22,18,"PAH",13,1,8,0)="The following issues are addressed in this patch:"
^DIC(9.4,97,22,18,"PAH",13,1,9,0)="1. The logic in routine PSUHL was corrected so that when an edit is made"
^DIC(9.4,97,22,18,"PAH",13,1,10,0)="to the RACE INFORMATION field #2 or ETHNICITY INFORMATION field #6 in"
^DIC(9.4,97,22,18,"PAH",13,1,11,0)="the PATIENT File #2, an entry is queued in the PBM PATIENT DEMOGRAPHICS"
^DIC(9.4,97,22,18,"PAH",13,1,12,0)="File #59.9. Currently, because of flawed logic when edits are made to"
^DIC(9.4,97,22,18,"PAH",13,1,13,0)="either of these two fields, an entry is not queued."
^DIC(9.4,97,22,18,"PAH",13,1,14,0)=" "
^DIC(9.4,97,22,18,"PAH",13,1,15,0)="The integration agreement #4803 was added to record the usage of routine"
^DIC(9.4,97,22,18,"PAH",13,1,16,0)="PSUHL by other packages."
^DIC(9.4,97,22,18,"PAH",13,1,17,0)=" "
^DIC(9.4,97,22,18,"PAH",13,1,18,0)=" "
^DIC(9.4,97,22,18,"PAH",13,1,19,0)="2. The Automatic Pharmacy Statistics [PSU PBM AUTO] report generated a"
^DIC(9.4,97,22,18,"PAH",13,1,20,0)="<SUSBCRIPT> error condition. This error was created when the report was"
^DIC(9.4,97,22,18,"PAH",13,1,21,0)="run before any monthly data was filed. Routine PSUHL was modified to quit"
^DIC(9.4,97,22,18,"PAH",13,1,22,0)="the FOR loop at line tag CLEANUP when the DAY variable is NULL."
^DIC(9.4,97,22,18,"PAH",13,1,23,0)=" "
^DIC(9.4,97,22,18,"PAH",13,1,24,0)=""
^DIC(9.4,97,22,18,"PAH",13,1,25,0)="3. Sites reported getting <STORE>SETDPT+9^DPTLK1 errors which was traced"
^DIC(9.4,97,22,18,"PAH",13,1,26,0)="to the protocol PSU PATIENT DEMOGRAPHIC CHANGE called by the DG FIELD"
^DIC(9.4,97,22,18,"PAH",13,1,27,0)="MONITOR protocol. Line tag LOGDFN was changed to use the DBS call"
^DIC(9.4,97,22,18,"PAH",13,1,28,0)="UPDATE^DIE instead of the Fileman call FILE^DICN."
^DIC(9.4,97,22,18,"PAH",13,1,29,0)=" "
^DIC(9.4,97,22,18,"PAH",13,1,30,0)="4. During internal testing, a problem was discovered with the handling"
^DIC(9.4,97,22,18,"PAH",13,1,31,0)="of local data elements in routine PSUHL. The killing of those variables"
^DIC(9.4,97,22,18,"PAH",13,1,32,0)="presents the potential for problems later in other areas. This patch"
^DIC(9.4,97,22,18,"PAH",13,1,33,0)="corrects the way in which these variables are handled."
^DIC(9.4,97,22,18,"PAH",13,1,34,0)=""
^DIC(9.4,97,22,18,"PAH",14,0)="16 SEQ #14^3100518.152318^17"
^DIC(9.4,97,22,18,"PAH",14,1,0)="^^28^28^3100518"
^DIC(9.4,97,22,18,"PAH",14,1,1,0)="Currently, the Pharmacy Benefits Management (PBM) extract blocks the"
^DIC(9.4,97,22,18,"PAH",14,1,2,0)="transmission of chemistry lab results for ""Employee Veteran"" and"
^DIC(9.4,97,22,18,"PAH",14,1,3,0)="""Employee Non-Veteran."" This patch addresses the New Service Request (NSR)"
^DIC(9.4,97,22,18,"PAH",14,1,4,0)="#20080810 to transmit the chemistry lab results for ""Employee Veteran"""
^DIC(9.4,97,22,18,"PAH",14,1,5,0)="via Health Level 7 (HL7) messaging to the PBM extract database while"
^DIC(9.4,97,22,18,"PAH",14,1,6,0)="continuing to block the chemistry lab results for ""Employee Non-Veteran."""
^DIC(9.4,97,22,18,"PAH",14,1,7,0)=" "
^DIC(9.4,97,22,18,"PAH",14,1,8,0)="This patch also addresses the following."
^DIC(9.4,97,22,18,"PAH",14,1,9,0)=" "
^DIC(9.4,97,22,18,"PAH",14,1,10,0)="Problem:"
^DIC(9.4,97,22,18,"PAH",14,1,11,0)="========"
^DIC(9.4,97,22,18,"PAH",14,1,12,0)="Several facilities were reporting that selected laboratory tests were not"
^DIC(9.4,97,22,18,"PAH",14,1,13,0)="present in the Structured Query Language (SQL) database used by PBM to"
^DIC(9.4,97,22,18,"PAH",14,1,14,0)="perform medication use safety surveillance, while the source data was"
^DIC(9.4,97,22,18,"PAH",14,1,15,0)="clearly available in local VistA and Computerized Patient Record"
^DIC(9.4,97,22,18,"PAH",14,1,16,0)="System (CPRS). Upon further investigation, it was discovered that the"
^DIC(9.4,97,22,18,"PAH",14,1,17,0)="laboratory results did transmit as expected, but the lab test name did"
^DIC(9.4,97,22,18,"PAH",14,1,18,0)="not, resulting in database search failures."
^DIC(9.4,97,22,18,"PAH",14,1,19,0)=" "
^DIC(9.4,97,22,18,"PAH",14,1,20,0)="Resolution:"
^DIC(9.4,97,22,18,"PAH",14,1,21,0)="==========="
^DIC(9.4,97,22,18,"PAH",14,1,22,0)="The source of the error was traced to laboratory tests with a National"
^DIC(9.4,97,22,18,"PAH",14,1,23,0)="Lab Test (NLT) Name containing a tilde (~) character. This character"
^DIC(9.4,97,22,18,"PAH",14,1,24,0)="is also used as the delimiter in HL7 message processing, and the extra"
^DIC(9.4,97,22,18,"PAH",14,1,25,0)="tilde caused the routines that parse the transmitted data to be offset by"
^DIC(9.4,97,22,18,"PAH",14,1,26,0)="one data element. The correction is to translate any tilde characters in"
^DIC(9.4,97,22,18,"PAH",14,1,27,0)="the NLT name into an underscore (_) character, so that any remaining"
^DIC(9.4,97,22,18,"PAH",14,1,28,0)="tilde characters are solely present as the expected HL7 delimiters."
^DIC(9.4,97,22,18,"PAH",15,0)="17 SEQ #15^3100802.151042^17"
^DIC(9.4,97,22,18,"PAH",15,1,0)="^^3^3^3100802"
^DIC(9.4,97,22,18,"PAH",15,1,1,0)="This patch will correct an issue at CMOP-NAT sites in which a patient who "
^DIC(9.4,97,22,18,"PAH",15,1,2,0)="have an alias name, but no alias SSN would have their SSN overwritten "
^DIC(9.4,97,22,18,"PAH",15,1,3,0)="with the empty ("""") alias SSN."
^DIC(9.4,97,22,18,"PAH",16,0)="18 SEQ #16^3110719.095958^17"
^DIC(9.4,97,22,18,"PAH",16,1,0)="^^9^9^3110719"
^DIC(9.4,97,22,18,"PAH",16,1,1,0)="When a user runs PSU PBM MANUAL reports for a large timeframe. This would "
^DIC(9.4,97,22,18,"PAH",16,1,2,0)="cause the XTMP global to fill up in some cases and prevent users from "
^DIC(9.4,97,22,18,"PAH",16,1,3,0)="logging into CPRS."
^DIC(9.4,97,22,18,"PAH",16,1,4,0)=" "
^DIC(9.4,97,22,18,"PAH",16,1,5,0)="Controlled substances are showing up as being linked incorrectly to an "
^DIC(9.4,97,22,18,"PAH",16,1,6,0)="outpatient clinic."
^DIC(9.4,97,22,18,"PAH",16,1,7,0)=" "
^DIC(9.4,97,22,18,"PAH",16,1,8,0)="Integrated facilities are not correctly distinguished between in "
^DIC(9.4,97,22,18,"PAH",16,1,9,0)="national reports."
^DIC(9.4,97,22,18,"PAH",17,0)="20 SEQ #17^3120829.121911^17"
^DIC(9.4,97,22,18,"PAH",17,1,0)="^^8^8^3120829"
^DIC(9.4,97,22,18,"PAH",17,1,1,0)="This patch will correct the following issues:"
^DIC(9.4,97,22,18,"PAH",17,1,2,0)=" "
^DIC(9.4,97,22,18,"PAH",17,1,3,0)="1. The technical manual is missing a note to refer users to "
^DIC(9.4,97,22,18,"PAH",17,1,4,0)="   FORUM as a source of information for APIs and callable routines."
^DIC(9.4,97,22,18,"PAH",17,1,5,0)=" "
^DIC(9.4,97,22,18,"PAH",17,1,6,0)="   "
^DIC(9.4,97,22,18,"PAH",17,1,7,0)="2. Allergy extract transmissions contain an extra delimiter if"
^DIC(9.4,97,22,18,"PAH",17,1,8,0)="   they are longer than 254 characters."
^DIC(9.4,97,22,18,"PAH",18,0)="19 SEQ #18^3140902.125421^17"
^DIC(9.4,97,22,18,"PAH",19,0)="1 SEQ #19^3160701.141402^54"
^DIC(9.4,97,22,18,"PAH",19,1,0)="^^9^9^3160701"
^DIC(9.4,97,22,18,"PAH",19,1,1,0)="This patch addresses the following problem:"
^DIC(9.4,97,22,18,"PAH",19,1,2,0)="  "
^DIC(9.4,97,22,18,"PAH",19,1,3,0)="INC1244256"
^DIC(9.4,97,22,18,"PAH",19,1,4,0)="                       The pharmacy patient IV report of the Pharmacy "
^DIC(9.4,97,22,18,"PAH",19,1,5,0)="Benefits Management (PBM) extract does not calculate values for returned, "
^DIC(9.4,97,22,18,"PAH",19,1,6,0)="destroyed, or canceled IV orders. This is because the inpatient option "
^DIC(9.4,97,22,18,"PAH",19,1,7,0)="Returns and Destroyed Entry (IV)(PSJI RETURNS) does not place a value for "
^DIC(9.4,97,22,18,"PAH",19,1,8,0)="the DAILY USAGE field that the PBM software is checking in order to add "
^DIC(9.4,97,22,18,"PAH",19,1,9,0)="the total number of returned, destroyed, or canceled IVs. "
^DIC(9.4,97,22,18,"PAH",20,0)="22 SEQ #20^3171128.124809^54"
^DIC(9.4,97,22,18,"PAH",20,1,0)="^^76^76^3171128"
^DIC(9.4,97,22,18,"PAH",20,1,1,0)="This patch will resolve the following issues."
^DIC(9.4,97,22,18,"PAH",20,1,2,0)=" "
^DIC(9.4,97,22,18,"PAH",20,1,3,0)="1. R15508923FY17 - PBM IV Total Cost column incorrect"
^DIC(9.4,97,22,18,"PAH",20,1,4,0)=" "
^DIC(9.4,97,22,18,"PAH",20,1,5,0)="  "
^DIC(9.4,97,22,18,"PAH",20,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,97,22,18,"PAH",20,1,7,0)="--------------------------------------------"
^DIC(9.4,97,22,18,"PAH",20,1,8,0)=" "
^DIC(9.4,97,22,18,"PAH",20,1,9,0)="1. R15508923FY17 - PBM IV Total Cost column incorrect "
^DIC(9.4,97,22,18,"PAH",20,1,10,0)="  "
^DIC(9.4,97,22,18,"PAH",20,1,11,0)="Problem: "
^DIC(9.4,97,22,18,"PAH",20,1,12,0)="--------"
^DIC(9.4,97,22,18,"PAH",20,1,13,0)="The PBMAMIS reports generated by the Manual Pharmacy Statistics [PSU PBM"
^DIC(9.4,97,22,18,"PAH",20,1,14,0)="MANUAL] option sometimes will calculate the Total Cost column incorrectly."
^DIC(9.4,97,22,18,"PAH",20,1,15,0)="There is a specific situation where the cost from an IV order of one type can"
^DIC(9.4,97,22,18,"PAH",20,1,16,0)="be added to the cost of a different IV type. Below you can see all the all"
^DIC(9.4,97,22,18,"PAH",20,1,17,0)="the reports generated by the that are affected by this issue:"
^DIC(9.4,97,22,18,"PAH",20,1,18,0)="  "
^DIC(9.4,97,22,18,"PAH",20,1,19,0)="IV AMIS Summary for MMM DD,YYYY through MMM DD,YYYY for DIVISION NAME"
^DIC(9.4,97,22,18,"PAH",20,1,20,0)=" "
^DIC(9.4,97,22,18,"PAH",20,1,21,0)="                    LVPs    LVPs   LVPs   LVPs  LVPs       Total    NET LVPs"
^DIC(9.4,97,22,18,"PAH",20,1,22,0)="Division            DISP    RET    DES    CAN   DISP       Cost     DISP"
^DIC(9.4,97,22,18,"PAH",20,1,23,0)="-----------------------------------------------------------------------------"
^DIC(9.4,97,22,18,"PAH",20,1,24,0)="DIVISION NAME        999    999    999    999    999 $    999.99 $   999.99"
^DIC(9.4,97,22,18,"PAH",20,1,25,0)="-----------------------------------------------------------------------------"
^DIC(9.4,97,22,18,"PAH",20,1,26,0)="Total                999    999    999    999    999 $    999.99 $   999.99"
^DIC(9.4,97,22,18,"PAH",20,1,27,0)=" "
^DIC(9.4,97,22,18,"PAH",20,1,28,0)=" "
^DIC(9.4,97,22,18,"PAH",20,1,29,0)="                                                NET               Cost/"
^DIC(9.4,97,22,18,"PAH",20,1,30,0)="                    IVPBs   IVPBs  IVPBs  IVPBs IVPBs    Total    NET IVPBs"
^DIC(9.4,97,22,18,"PAH",20,1,31,0)="Division            DISP    RET    DES    CAN   DISP     Cost     DISP"
^DIC(9.4,97,22,18,"PAH",20,1,32,0)="-----------------------------------------------------------------------------"
^DIC(9.4,97,22,18,"PAH",20,1,33,0)="DIVISION NAME        999    999    999    999    999 $    999.99 $   999.99"
^DIC(9.4,97,22,18,"PAH",20,1,34,0)="-----------------------------------------------------------------------------"
^DIC(9.4,97,22,18,"PAH",20,1,35,0)="Total                999    999    999    999    999 $    999.99 $   999.99"
^DIC(9.4,97,22,18,"PAH",20,1,36,0)=" "
^DIC(9.4,97,22,18,"PAH",20,1,37,0)="  "
^DIC(9.4,97,22,18,"PAH",20,1,38,0)="                                                NET               Cost/"
^DIC(9.4,97,22,18,"PAH",20,1,39,0)="                   TPNs    TPNs    TPNs   TPNs  TPNs     Total    NET TPNs"
^DIC(9.4,97,22,18,"PAH",20,1,40,0)="Division           DISP    RET     DES    CAN   DISP     Cost     DISP"
^DIC(9.4,97,22,18,"PAH",20,1,41,0)="-----------------------------------------------------------------------------"
^DIC(9.4,97,22,18,"PAH",20,1,42,0)="DIVISION NAME        999    999    999    999    999 $    999.99 $   999.99"
^DIC(9.4,97,22,18,"PAH",20,1,43,0)="-----------------------------------------------------------------------------"
^DIC(9.4,97,22,18,"PAH",20,1,44,0)="Total                999    999    999    999    999 $    999.99 $   999.99"
^DIC(9.4,97,22,18,"PAH",20,1,45,0)=" "
^DIC(9.4,97,22,18,"PAH",20,1,46,0)=" "
^DIC(9.4,97,22,18,"PAH",20,1,47,0)="                                                NET               Cost/"
^DIC(9.4,97,22,18,"PAH",20,1,48,0)="                    CHEMO   CHEMO  CHEMO  CHEMO CHEMO     Total   NET CHEMOs"
^DIC(9.4,97,22,18,"PAH",20,1,49,0)="Division            DISP    RET    DES    CAN   DISP      Cost    DISP"
^DIC(9.4,97,22,18,"PAH",20,1,50,0)="-----------------------------------------------------------------------------"
^DIC(9.4,97,22,18,"PAH",20,1,51,0)="DIVISION NAME        999    999    999    999    999 $    999.99 $   999.99"
^DIC(9.4,97,22,18,"PAH",20,1,52,0)="-----------------------------------------------------------------------------"
^DIC(9.4,97,22,18,"PAH",20,1,53,0)="Total                999    999    999    999    999 $    999.99 $   999.99"
^DIC(9.4,97,22,18,"PAH",20,1,54,0)=" "
^DIC(9.4,97,22,18,"PAH",20,1,55,0)=" "
^DIC(9.4,97,22,18,"PAH",20,1,56,0)="                                                NET               Cost/"
^DIC(9.4,97,22,18,"PAH",20,1,57,0)="                   SYRs    SYRs   SYRs   SYRs   SYRs     Total    NET SYRs"
^DIC(9.4,97,22,18,"PAH",20,1,58,0)="Division           DISP    RET    DES    CAN    DISP     Cost     DISP"
^DIC(9.4,97,22,18,"PAH",20,1,59,0)="-----------------------------------------------------------------------------"
^DIC(9.4,97,22,18,"PAH",20,1,60,0)="DIVISION NAME        999    999    999    999    999 $    999.99 $   999.99"
^DIC(9.4,97,22,18,"PAH",20,1,61,0)="-----------------------------------------------------------------------------"
^DIC(9.4,97,22,18,"PAH",20,1,62,0)="Total                999    999    999    999    999 $    999.99 $   999.99"
^DIC(9.4,97,22,18,"PAH",20,1,63,0)=" "
^DIC(9.4,97,22,18,"PAH",20,1,64,0)=" "
^DIC(9.4,97,22,18,"PAH",20,1,65,0)="The discrepancy happens for patients with an order that has an internal"
^DIC(9.4,97,22,18,"PAH",20,1,66,0)="number that matches the number of a subsequent record of the last IV counted"
^DIC(9.4,97,22,18,"PAH",20,1,67,0)="for the Total Cost, then the cost of that order will get included into the"
^DIC(9.4,97,22,18,"PAH",20,1,68,0)="total even if it is of the different type."
^DIC(9.4,97,22,18,"PAH",20,1,69,0)=" "
^DIC(9.4,97,22,18,"PAH",20,1,70,0)=" "
^DIC(9.4,97,22,18,"PAH",20,1,71,0)="Resolution:"
^DIC(9.4,97,22,18,"PAH",20,1,72,0)="-----------"
^DIC(9.4,97,22,18,"PAH",20,1,73,0)="Modified the routines PSUV6, PSUV7, PSUV8, PSUV9 and PSUV10 to include the "
^DIC(9.4,97,22,18,"PAH",20,1,74,0)="patient Social Security Number (SSN) when comparing the order number for"
^DIC(9.4,97,22,18,"PAH",20,1,75,0)="calculating the total for the IV type. This will prevent an order from a"
^DIC(9.4,97,22,18,"PAH",20,1,76,0)="different to be included in the total for the wrong IV type."
^DIC(9.4,97,22,18,"PAH",21,0)="23 SEQ #21^3180403.152905^54"
^DIC(9.4,97,22,18,"PAH",21,1,0)="^^72^72^3180403"
^DIC(9.4,97,22,18,"PAH",21,1,1,0)="This patch will resolve the following issue:"
^DIC(9.4,97,22,18,"PAH",21,1,2,0)=" "
^DIC(9.4,97,22,18,"PAH",21,1,3,0)="1. I16082026FY17 - PSU SEND has incorrect DNS DOMAIN"
^DIC(9.4,97,22,18,"PAH",21,1,4,0)=" "
^DIC(9.4,97,22,18,"PAH",21,1,5,0)="  "
^DIC(9.4,97,22,18,"PAH",21,1,6,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,97,22,18,"PAH",21,1,7,0)="--------------------------------------------"
^DIC(9.4,97,22,18,"PAH",21,1,8,0)=" "
^DIC(9.4,97,22,18,"PAH",21,1,9,0)="1. I16082026FY17 - PSU SEND has incorrect DNS DOMAIN"
^DIC(9.4,97,22,18,"PAH",21,1,10,0)="  "
^DIC(9.4,97,22,18,"PAH",21,1,11,0)="Problem: "
^DIC(9.4,97,22,18,"PAH",21,1,12,0)="--------"
^DIC(9.4,97,22,18,"PAH",21,1,13,0)="The CMOP-Nat VistA system migrated to the Region 1 Denver Data Center on "
^DIC(9.4,97,22,18,"PAH",21,1,14,0)="July 29, 2017. During the migration a problem was identified with the HL "
^DIC(9.4,97,22,18,"PAH",21,1,15,0)="Logical Link ""PSU SEND"". It was discovered that the HL Logical Link entry "
^DIC(9.4,97,22,18,"PAH",21,1,16,0)="on all VAMC VistA systems was set with an invalid DNS DOMAIN of "
^DIC(9.4,97,22,18,"PAH",21,1,17,0)="""CMOP-NAT.DOMAIN.EXT"". The Region 1 Denver Data Center migration team along"
^DIC(9.4,97,22,18,"PAH",21,1,18,0)="with the National VistA Migration Team requested that a national software "
^DIC(9.4,97,22,18,"PAH",21,1,19,0)="patch be created and released to update the ""PSU SEND"" entry in the HL "
^DIC(9.4,97,22,18,"PAH",21,1,20,0)="Logical Link file to use the correct DNS DOMAIN ""HL7.CMOP-NAT.DOMAIN.EXT"". "
^DIC(9.4,97,22,18,"PAH",21,1,21,0)="This change is required so that when there are hardware changes to the "
^DIC(9.4,97,22,18,"PAH",21,1,22,0)="CMOP-Nat VistA system, VistA HL7's DNS-aware functionality will automatically"
^DIC(9.4,97,22,18,"PAH",21,1,23,0)="update the link's IP address without requiring individual, manual updates at"
^DIC(9.4,97,22,18,"PAH",21,1,24,0)="each site. During the migration as a work-around, ""CMOP-NAT.DOMAIN.EXT"" and"
^DIC(9.4,97,22,18,"PAH",21,1,25,0)="its associated IP were broadcasted nationally so there would be no disruption"
^DIC(9.4,97,22,18,"PAH",21,1,26,0)="to message traffic being sent by the VAMCs, but ""HL7.CMOP-NAT.DOMAIN.EXT"" is"
^DIC(9.4,97,22,18,"PAH",21,1,27,0)="the preferred and best long-term solution. The PSU SEND logical link was "
^DIC(9.4,97,22,18,"PAH",21,1,28,0)="created during the pre-install steps of PSU*4*3 (PBM EXTRACT ENHANCEMENT"
^DIC(9.4,97,22,18,"PAH",21,1,29,0)="III)."
^DIC(9.4,97,22,18,"PAH",21,1,30,0)=" "
^DIC(9.4,97,22,18,"PAH",21,1,31,0)="Resolution:"
^DIC(9.4,97,22,18,"PAH",21,1,32,0)="-----------"
^DIC(9.4,97,22,18,"PAH",21,1,33,0)="A post-install routine (PSO23PI) will be executed following the installation"
^DIC(9.4,97,22,18,"PAH",21,1,34,0)="of this patch and will perform the following update if necessary:"
^DIC(9.4,97,22,18,"PAH",21,1,35,0)=" "
^DIC(9.4,97,22,18,"PAH",21,1,36,0)=" 1. Loop through all the records in the HL LOGICAL LINK file (#870) and"
^DIC(9.4,97,22,18,"PAH",21,1,37,0)="    retrieve the value for the  DNS DOMAIN field (#.08)"
^DIC(9.4,97,22,18,"PAH",21,1,38,0)=" 2. If the DNS DOMAIN value (converted to uppercase) is different than"
^DIC(9.4,97,22,18,"PAH",21,1,39,0)="    ""CMOP-NAT.DOMAIN.EXT"", skip the record (no update)"
^DIC(9.4,97,22,18,"PAH",21,1,40,0)=" 3. If the DNS DOMAIN uppercase value is equal to ""CMOP-NAT.DOMAIN.EXT"", "
^DIC(9.4,97,22,18,"PAH",21,1,41,0)="    update it to ""HL7.CMOP-NAT.DOMAIN.EXT"""
^DIC(9.4,97,22,18,"PAH",21,1,42,0)=" "
^DIC(9.4,97,22,18,"PAH",21,1,43,0)="Once the patch PSU*4*23 successfully installs a Mailman message will be sent"
^DIC(9.4,97,22,18,"PAH",21,1,44,0)="to the PSU MAIL group and the person who installed the patch with the "
^DIC(9.4,97,22,18,"PAH",21,1,45,0)="following information:"
^DIC(9.4,97,22,18,"PAH",21,1,46,0)=" "
^DIC(9.4,97,22,18,"PAH",21,1,47,0)="  Subj: PSU*4*23 DNS DOMAIN CMOP-NAT.DOMAIN.EXT Update  [#2737116]"
^DIC(9.4,97,22,18,"PAH",21,1,48,0)="  From: POSTMASTER  In 'IN' basket.   Page 1  *New*"
^DIC(9.4,97,22,18,"PAH",21,1,49,0)="  --------------------------------------------------------------------------"
^DIC(9.4,97,22,18,"PAH",21,1,50,0)="  The post-install routine performed the following updates:"
^DIC(9.4,97,22,18,"PAH",21,1,51,0)=" "
^DIC(9.4,97,22,18,"PAH",21,1,52,0)="  HL LOGICAL LINK       DNS DOMAIN (Before Patch)   DNS DOMAIN (After Patch)"
^DIC(9.4,97,22,18,"PAH",21,1,53,0)="  --------------------- -------------------------   ------------------------"
^DIC(9.4,97,22,18,"PAH",21,1,54,0)="  PSU SEND              CMOP-NAT.DOMAIN.EXT         HL7.CMOP-NAT.DOMAIN.EXT"
^DIC(9.4,97,22,18,"PAH",21,1,55,0)=" "
^DIC(9.4,97,22,18,"PAH",21,1,56,0)="  Enter message action (in IN basket): Ignore//  "
^DIC(9.4,97,22,18,"PAH",21,1,57,0)=" "
^DIC(9.4,97,22,18,"PAH",21,1,58,0)="In case the post-install routine does not find any entries in the HL LOGICAL "
^DIC(9.4,97,22,18,"PAH",21,1,59,0)="LINK file that needs to be updated it will instead send this message:"
^DIC(9.4,97,22,18,"PAH",21,1,60,0)="  "
^DIC(9.4,97,22,18,"PAH",21,1,61,0)="   Subj: PSU*4*23 DNS DOMAIN CMOP-NAT.DOMAIN.EXT Update  [#2737114] "
^DIC(9.4,97,22,18,"PAH",21,1,62,0)="   From: POSTMASTER  In 'IN' basket.   Page 1"
^DIC(9.4,97,22,18,"PAH",21,1,63,0)="   -------------------------------------------------------------------------"
^DIC(9.4,97,22,18,"PAH",21,1,64,0)="   The post-install routine found no records in the HL LOGICAL LINK file "
^DIC(9.4,97,22,18,"PAH",21,1,65,0)="   (#870) with the DNS DOMAIN field (#.08) set to 'CMOP-NAT.DOMAIN.EXT'."
^DIC(9.4,97,22,18,"PAH",21,1,66,0)="   No updates performed."
^DIC(9.4,97,22,18,"PAH",21,1,67,0)=" "
^DIC(9.4,97,22,18,"PAH",21,1,68,0)="   Enter message action (in IN basket): Ignore// "
^DIC(9.4,97,22,18,"PAH",21,1,69,0)=" "
^DIC(9.4,97,22,18,"PAH",21,1,70,0)="Note: Non-production accounts usually have the DNS DOMAIN field (#.08) in"
^DIC(9.4,97,22,18,"PAH",21,1,71,0)="      HL LOGICAL LINK file (#870) set to null/blank and for this reason this"
^DIC(9.4,97,22,18,"PAH",21,1,72,0)="      patch will make no update in most of these accounts."
^DIC(9.4,97,22,18,"PAH","B",5,13)=""
