^DIC(9.4,134,22,17,"PAH",20,1,81,0)=" n/a"
^DIC(9.4,134,22,17,"PAH",20,1,82,0)="  "
^DIC(9.4,134,22,17,"PAH",20,1,83,0)=" TEST SITES:"
^DIC(9.4,134,22,17,"PAH",20,1,84,0)=" ==========="
^DIC(9.4,134,22,17,"PAH",20,1,85,0)="PORTLAND (OR) VAMC  -  648"
^DIC(9.4,134,22,17,"PAH",20,1,86,0)="PHOENIX VAMC        -  644"
