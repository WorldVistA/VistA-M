^DIC(9.4,48,22,5.28,"PAH",638,1,9,0)="VSE-4924: CP - Modify SDES GET CONSULTS BY DFN and SDES GET CONSULT BY IEN"
^DIC(9.4,48,22,5.28,"PAH",638,1,10,0)="          to return additional fields"
^DIC(9.4,48,22,5.28,"PAH",638,1,11,0)="VSE-4956: BB - Create a new RPC in the SDES namespace to return a boolean"
^DIC(9.4,48,22,5.28,"PAH",638,1,12,0)="          indicating demographics needs update"
^DIC(9.4,48,22,5.28,"PAH",638,1,13,0)="VSE-5016: LB - Modify SDES CANCEL APPOINTMENT 2 to remove appointment IEN"
^DIC(9.4,48,22,5.28,"PAH",638,1,14,0)="          from MRTC APPT MADE sub-file"
^DIC(9.4,48,22,5.28,"PAH",638,1,15,0)="VSE-5026: BF - Modify SDES GET APPT REQ LIST BY DFN, SDES GET RECALLS"
^DIC(9.4,48,22,5.28,"PAH",638,1,16,0)="          BY DFN, and SDES GET RECALL BY IEN to return recall reminder"
^DIC(9.4,48,22,5.28,"PAH",638,1,17,0)="          appt type"
^DIC(9.4,48,22,5.28,"PAH",638,1,18,0)="VSE-5037: AP - Modify SDES CREATE RECALL REQ 2 to accept the recall "
^DIC(9.4,48,22,5.28,"PAH",638,1,19,0)="          reminder type name"
^DIC(9.4,48,22,5.28,"PAH",638,1,20,0)="VSE-5043: MD - Please create a new Appointment Request Disposition Reason,"
^DIC(9.4,48,22,5.28,"PAH",638,1,21,0)="          post install routine, and update the code to not reopen the "
^DIC(9.4,48,22,5.28,"PAH",638,1,22,0)="          request"
^DIC(9.4,48,22,5.28,"PAH",638,1,23,0)="VSE-5073: DS - Modify SDES CREATE APPOINTMENTS to make the SDEC RESOURCE"
^DIC(9.4,48,22,5.28,"PAH",638,1,24,0)="          parameter optional"
^DIC(9.4,48,22,5.28,"PAH",638,1,25,0)="VSE-5103: BB - Create SDES GET APPT TYPES RPC for SAS team"
^DIC(9.4,48,22,5.28,"PAH",638,1,26,0)="VSE-5105: BB - Create a new SDES GET SPEC NEEDS AND PREFS RPC for the SAS"
^DIC(9.4,48,22,5.28,"PAH",638,1,27,0)="          team"
^DIC(9.4,48,22,5.28,"PAH",638,1,28,0)="VSE-5106: BB - Create a new SDES GET CONSULT DETAILS RPC for the SAS team"
^DIC(9.4,48,22,5.28,"PAH",638,1,29,0)="VSE-5107: BB - Create a new SDES GET PATIENT INQUIRY RPC for the SAS team"
^DIC(9.4,48,22,5.28,"PAH",638,1,30,0)="VSE-5144: DR - Create a new field in 409.84 called MISSION ACT ELIGIBLE"
^DIC(9.4,48,22,5.28,"PAH",638,1,31,0)="VSE-5145: BF - Make a copy of SDES GET MISSION ACT ELIG and rename one"
^DIC(9.4,48,22,5.28,"PAH",638,1,32,0)="          copy for EAS"
^DIC(9.4,48,22,5.28,"PAH",638,1,33,0)="VSE-5146: BF - Modify SDES GET MISSION ACT ELIG to return if an "
^DIC(9.4,48,22,5.28,"PAH",638,1,34,0)="          appointment is Mission Act Eligible across multiple clinics with"
^DIC(9.4,48,22,5.28,"PAH",638,1,35,0)="          the same stop code"
^DIC(9.4,48,22,5.28,"PAH",638,1,36,0)="VSE-5148: BF - Modify APPADD to set the new field in 409.84 to Y if "
^DIC(9.4,48,22,5.28,"PAH",638,1,37,0)="          appointment is Mission Act Eligible"
^DIC(9.4,48,22,5.28,"PAH",638,1,38,0)="VSE-5164: LB - VistA - Modify SDES EDIT CLINIC AVAILABILITY to not require"
^DIC(9.4,48,22,5.28,"PAH",638,1,39,0)="          times and slots"
^DIC(9.4,48,22,5.28,"PAH",638,1,40,0)="VSE-5197: BF - VistA: Modify SDES GET MISSION ACT ELIG to not display "
^DIC(9.4,48,22,5.28,"PAH",638,1,41,0)="          availability pop up when both PID and target appointment are"
^DIC(9.4,48,22,5.28,"PAH",638,1,42,0)="          within WTS"
^DIC(9.4,48,22,5.28,"PAH",638,1,43,0)="VSE-5216: LB - Create post-install routine to report pending appointments"
^DIC(9.4,48,22,5.28,"PAH",638,1,44,0)="          and requests that have different patient DFN."
^DIC(9.4,48,22,5.28,"PAH",638,1,45,0)="VSE-5260: BF - VistA: Modify SDES GET MISSION ACT ELIG RPC."
^DIC(9.4,48,22,5.28,"PAH",638,1,46,0)="VSE-5263: BF - VistA: Create new RPC to return MISSION Act Eligibility for"
^DIC(9.4,48,22,5.28,"PAH",638,1,47,0)="          Block&Move for Recalls"
^DIC(9.4,48,22,5.28,"PAH",638,1,48,0)="VSE-5337: BB - VistA: Need to address <UNDEFINED>H+1^SDEC57"
^DIC(9.4,48,22,5.28,"PAH",638,1,49,0)="VSE-5338: MD - VistA: GETIEN^SDEC51 - to prevent leaking of the X and Y "
^DIC(9.4,48,22,5.28,"PAH",638,1,50,0)="          variables."
