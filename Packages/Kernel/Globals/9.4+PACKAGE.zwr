^DIC(9.4,13,22,9,"PAH",10,1,32,0)="Blood Bank Clearance:"
^DIC(9.4,13,22,9,"PAH",10,1,33,0)="---------------------"
^DIC(9.4,13,22,9,"PAH",10,1,34,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch DI*22.2*9 contains"
^DIC(9.4,13,22,9,"PAH",10,1,35,0)="changes to a package referenced in ProPath standard titled: BBM Team"
^DIC(9.4,13,22,9,"PAH",10,1,36,0)="Review of VistA Patches. This patch does not alter or modify any VistA"
^DIC(9.4,13,22,9,"PAH",10,1,37,0)="Blood Bank software design safeguards or safety critical elements"
^DIC(9.4,13,22,9,"PAH",10,1,38,0)="functions."
^DIC(9.4,13,22,9,"PAH",10,1,39,0)=" "
^DIC(9.4,13,22,9,"PAH",10,1,40,0)="RISK ANALYSIS: Changes made by patch DI*22.2*9 have no effect on Blood"
^DIC(9.4,13,22,9,"PAH",10,1,41,0)="Bank software functionality, therefore RISK's none. "
^DIC(9.4,13,22,9,"PAH",10,1,42,0)=" "
