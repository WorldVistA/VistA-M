^DIC(9.4,60,22,13,"PAH",626,1,8,0)="no DD modifications but an additional entry at the VER multiple (58.4001) "
^DIC(9.4,60,22,13,"PAH",626,1,9,0)="stored at the 1 subscript (for the Baseline or STANDARD definition) e.g.,"
^DIC(9.4,60,22,13,"PAH",626,1,10,0)="^PS(58.4,1,0)=""STANDARD ASAP DEFINITION"""
^DIC(9.4,60,22,13,"PAH",626,1,11,0)="^PS(58.4,1,""VER"",0)=""^58.4001^n^n"""
^DIC(9.4,60,22,13,"PAH",626,1,12,0)="^PS(58.4,1,""VER"",+1,0)=""4.2A"""
