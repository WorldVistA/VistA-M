^DIC(9.4,73,22,9,"PAH",20,1,63,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,73,22,9,"PAH",20,1,64,0)="                                                                       =="
^DIC(9.4,73,22,9,"PAH",20,1,65,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,73,22,9,"PAH",20,1,66,0)=" You can queue the install by enter a 'Q' at the device prompt."
