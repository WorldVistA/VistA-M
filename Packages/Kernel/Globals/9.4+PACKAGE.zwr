^DIC(9.4,175,22,2,"PAH",101,0)="150^3150413.1321^17"
^DIC(9.4,175,22,2,"PAH",101,1,0)="^^23^23^3150413"
^DIC(9.4,175,22,2,"PAH",101,1,1,0)="Patch 150 is a patch to complete the Image Never Existed fix that"
^DIC(9.4,175,22,2,"PAH",101,1,2,0)="was started in Patch 129 and Patch 135"
^DIC(9.4,175,22,2,"PAH",101,1,3,0)=" "
^DIC(9.4,175,22,2,"PAH",101,1,4,0)="IMAGE File (#2005) entries that are deleted when the process to copy the "
^DIC(9.4,175,22,2,"PAH",101,1,5,0)="file to the Image Share (Tier1 Storage) and considered "
^DIC(9.4,175,22,2,"PAH",101,1,6,0)="'Image Never Existed'. "
^DIC(9.4,175,22,2,"PAH",101,1,7,0)="The Display Client will list these images as 'Deleted' images. "
^DIC(9.4,175,22,2,"PAH",101,1,8,0)="This gives the provider the false impression that a relevant image may"
^DIC(9.4,175,22,2,"PAH",101,1,9,0)="have been associated with the Patient Record."
^DIC(9.4,175,22,2,"PAH",101,1,10,0)="This Patch modifies 6 routines."
^DIC(9.4,175,22,2,"PAH",101,1,11,0)="The RPC that returns a list of Patient images is changed.  "
^DIC(9.4,175,22,2,"PAH",101,1,12,0)="Now, images with the status 'Image Never Existed' will not be "
^DIC(9.4,175,22,2,"PAH",101,1,13,0)="listed with the Deleted Images of a patient."
^DIC(9.4,175,22,2,"PAH",101,1,14,0)="This will check the routines from a BUILD file."
^DIC(9.4,175,22,2,"PAH",101,1,15,0)="Select BUILD NAME:    MAG*3.0*150     IMAGING"
^DIC(9.4,175,22,2,"PAH",101,1,16,0)="MAGGI12   value = 101869499"
^DIC(9.4,175,22,2,"PAH",101,1,17,0)="MAGGTAU   value = 66990261"
