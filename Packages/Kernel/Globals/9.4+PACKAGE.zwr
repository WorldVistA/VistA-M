^DIC(9.4,14,22,5.9,"PAH",288,1,99,0)=" "
^DIC(9.4,14,22,5.9,"PAH",288,1,100,0)="Problem:"
^DIC(9.4,14,22,5.9,"PAH",288,1,101,0)="--------"
^DIC(9.4,14,22,5.9,"PAH",288,1,102,0)=" With the release of patch LR*5.2*479 the second line of the routine"
^DIC(9.4,14,22,5.9,"PAH",288,1,103,0)=" LRAPKOE mistakenly contained a reference to patch LR*5.2*469."
^DIC(9.4,14,22,5.9,"PAH",288,1,104,0)=" "
^DIC(9.4,14,22,5.9,"PAH",288,1,105,0)="Resolution:"
^DIC(9.4,14,22,5.9,"PAH",288,1,106,0)="-----------"
^DIC(9.4,14,22,5.9,"PAH",288,1,107,0)=" This patch will correct the second line of the routine as follows:"
^DIC(9.4,14,22,5.9,"PAH",288,1,108,0)=" Second line as released with LR*5.2*479:"
^DIC(9.4,14,22,5.9,"PAH",288,1,109,0)="     ;;5.2;LAB SERVICE;**462,469,479**;Sep 27, 1994;Build 8"
^DIC(9.4,14,22,5.9,"PAH",288,1,110,0)=" "
^DIC(9.4,14,22,5.9,"PAH",288,1,111,0)=" Second line after the install of LR*5.2*483:"
^DIC(9.4,14,22,5.9,"PAH",288,1,112,0)="     ;;5.2;LAB SERVICE;**462,479,483**;Sep 27, 1994;"
^DIC(9.4,14,22,5.9,"PAH",288,1,113,0)=" "
^DIC(9.4,14,22,5.9,"PAH",288,1,114,0)="        Routine: LRAPKOE"
^DIC(9.4,14,22,5.9,"PAH",288,1,115,0)=" "
^DIC(9.4,14,22,5.9,"PAH",288,1,116,0)=" Software Retrieval Instructions:"
^DIC(9.4,14,22,5.9,"PAH",288,1,117,0)=" ------------------------------------- "
^DIC(9.4,14,22,5.9,"PAH",288,1,118,0)=" Software will be released via a PackMan message. "
^DIC(9.4,14,22,5.9,"PAH",288,1,119,0)="  "
^DIC(9.4,14,22,5.9,"PAH",288,1,120,0)=" "
^DIC(9.4,14,22,5.9,"PAH",288,1,121,0)="Patch Installation:"
^DIC(9.4,14,22,5.9,"PAH",288,1,122,0)="  "
^DIC(9.4,14,22,5.9,"PAH",288,1,123,0)="  "
^DIC(9.4,14,22,5.9,"PAH",288,1,124,0)=" Pre/Post Installation Overview:"
^DIC(9.4,14,22,5.9,"PAH",288,1,125,0)=" -------------------------------"
^DIC(9.4,14,22,5.9,"PAH",288,1,126,0)=" N/A "
^DIC(9.4,14,22,5.9,"PAH",288,1,127,0)="  "
^DIC(9.4,14,22,5.9,"PAH",288,1,128,0)=" Pre-Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",288,1,129,0)=" ------------------------------"
^DIC(9.4,14,22,5.9,"PAH",288,1,130,0)=" N/A"
^DIC(9.4,14,22,5.9,"PAH",288,1,131,0)="  "
^DIC(9.4,14,22,5.9,"PAH",288,1,132,0)=" Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",288,1,133,0)=" --------------------------"
^DIC(9.4,14,22,5.9,"PAH",289,0)="477^3170601.180606^54"
^DIC(9.4,14,22,5.9,"PAH",289,1,0)="^^2^2^3170601"
^DIC(9.4,14,22,5.9,"PAH",289,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,14,22,5.9,"PAH",289,1,2,0)="included in this patch."
^DIC(9.4,14,22,5.9,"PAH",290,0)="484 SEQ #389^3170629.17383^54"
^DIC(9.4,14,22,5.9,"PAH",290,1,0)="^^1^1^3170629"
^DIC(9.4,14,22,5.9,"PAH",290,1,1,0)="Please see FORUM for full patch description and installation instructions."
^DIC(9.4,14,22,5.9,"PAH",291,0)="485 SEQ #390^3170929.162447^54"
^DIC(9.4,14,22,5.9,"PAH",291,1,0)="^^4^4^3170929"
^DIC(9.4,14,22,5.9,"PAH",291,1,1,0)="This patch addresses one (1) VistA Laboratory Anatomic Pathology issue:"
^DIC(9.4,14,22,5.9,"PAH",291,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",291,1,3,0)="I13556053FY17: Multiple orders associated with one Anatomic Pathology"
^DIC(9.4,14,22,5.9,"PAH",291,1,4,0)="               accession"
^DIC(9.4,14,22,5.9,"PAH",292,0)="488 SEQ #391^3170929.162544^54"
^DIC(9.4,14,22,5.9,"PAH",292,1,0)="^^5^5^3170929"
^DIC(9.4,14,22,5.9,"PAH",292,1,1,0)="This patch addresses two (2) VistA Laboratory issues related to override "
^DIC(9.4,14,22,5.9,"PAH",292,1,2,0)="reference ranges:"
^DIC(9.4,14,22,5.9,"PAH",292,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",292,1,4,0)="1. Override Reference Ranges Not Displaying on Reports"
^DIC(9.4,14,22,5.9,"PAH",292,1,5,0)="2. Option LRENTER Prompt Answer of ""YES"" Treated as ""NO"""
^DIC(9.4,14,22,5.9,"PAH",293,0)="478 SEQ #392^3170929.163526^54"
^DIC(9.4,14,22,5.9,"PAH",293,1,0)="^^9^9^3170929"
^DIC(9.4,14,22,5.9,"PAH",293,1,1,0)="This is a general maintenance patch for the laboratory"
^DIC(9.4,14,22,5.9,"PAH",293,1,2,0)="package by the Vista Maintenance team that addresses an"
^DIC(9.4,14,22,5.9,"PAH",293,1,3,0)="issue with the search criteria associated with the Howdy"
^DIC(9.4,14,22,5.9,"PAH",293,1,4,0)="Patient Wait Time report."
^DIC(9.4,14,22,5.9,"PAH",293,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",293,1,6,0)="ASSOCIATED SERVICE DESK TICKET:"
^DIC(9.4,14,22,5.9,"PAH",293,1,7,0)="=============================="
^DIC(9.4,14,22,5.9,"PAH",293,1,8,0)="1.      R11469217FY17  -  Entries outside entered search criteria"
^DIC(9.4,14,22,5.9,"PAH",293,1,9,0)="                          included on Patient Wait Time report"
^DIC(9.4,14,22,5.9,"PAH",294,0)="493^3171005.143636^54"
^DIC(9.4,14,22,5.9,"PAH",294,1,0)="^^2^2^3171005"
^DIC(9.4,14,22,5.9,"PAH",294,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,14,22,5.9,"PAH",294,1,2,0)="included in this patch."
^DIC(9.4,14,22,5.9,"PAH",295,0)="491 SEQ #394^3171127.122321^54"
^DIC(9.4,14,22,5.9,"PAH",295,1,0)="^^5^5^3171127"
^DIC(9.4,14,22,5.9,"PAH",295,1,1,0)="This patch addresses two (2) VistA Laboratory issues related to the "
^DIC(9.4,14,22,5.9,"PAH",295,1,2,0)="deletion of Howdy duplicate test orders:"
^DIC(9.4,14,22,5.9,"PAH",295,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",295,1,4,0)="1.  Duplicate test is deleted in VistA but active in CPRS"
^DIC(9.4,14,22,5.9,"PAH",295,1,5,0)="2.  Error occurs when orders have more than one duplicate test"
^DIC(9.4,14,22,5.9,"PAH",296,0)="492 SEQ #395^3171127.142707^54"
^DIC(9.4,14,22,5.9,"PAH",296,1,0)="^^11^11^3171127"
^DIC(9.4,14,22,5.9,"PAH",296,1,1,0)="This patch addresses three (3) VistA Laboratory issues related to "
^DIC(9.4,14,22,5.9,"PAH",296,1,2,0)="phlebotomy collection list logic:"
^DIC(9.4,14,22,5.9,"PAH",296,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",296,1,4,0)="1.  Test orders that roll over from one collection list to another may "
^DIC(9.4,14,22,5.9,"PAH",296,1,5,0)="appear to be ordered twice in CPRS even though they are only ordered once."
^DIC(9.4,14,22,5.9,"PAH",296,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",296,1,7,0)="2.  Merged orders created by collection list generation sometimes do not "
^DIC(9.4,14,22,5.9,"PAH",296,1,8,0)="have correct CPRS start date/times."
^DIC(9.4,14,22,5.9,"PAH",296,1,9,0)=" "
^DIC(9.4,14,22,5.9,"PAH",296,1,10,0)="3.  The Lab Order Entry (#69) file Lab Arrival Date/Time (#20) field is "
^DIC(9.4,14,22,5.9,"PAH",296,1,11,0)="erroneously set during collection list generation."
^DIC(9.4,14,22,5.9,"PAH",297,0)="497 SEQ #396^3180129.162016^54"
^DIC(9.4,14,22,5.9,"PAH",297,1,0)="^^3^3^3180129"
^DIC(9.4,14,22,5.9,"PAH",297,1,1,0)="This patch addresses one (1) VistA Laboratory issue related to Interim "
^DIC(9.4,14,22,5.9,"PAH",297,1,2,0)="Report option description updates and an update to the VistA Laboratory"
^DIC(9.4,14,22,5.9,"PAH",297,1,3,0)="User Manual."
^DIC(9.4,14,22,5.9,"PAH",298,0)="496 SEQ #397^3180130.151336^54"
^DIC(9.4,14,22,5.9,"PAH",298,1,0)="^^3^3^3180130"
^DIC(9.4,14,22,5.9,"PAH",298,1,1,0)="This patch addresses one (1) VistA Laboratory issue related to a software "
^DIC(9.4,14,22,5.9,"PAH",298,1,2,0)="error that occurs during Anatomic Pathology data entry of inactive CPT "
^DIC(9.4,14,22,5.9,"PAH",298,1,3,0)="codes which have replacement CPT codes."
^DIC(9.4,14,22,5.9,"PAH",299,0)="486 SEQ #398^3180227.140041^54"
^DIC(9.4,14,22,5.9,"PAH",299,1,0)="^^4^4^3180227"
^DIC(9.4,14,22,5.9,"PAH",299,1,1,0)="This patch addresses two (2) VistA Laboratory issues:"
^DIC(9.4,14,22,5.9,"PAH",299,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",299,1,3,0)="1)  LEDI Microbiology Results Endless Loop Issue"
^DIC(9.4,14,22,5.9,"PAH",299,1,4,0)="2)  Lapsed/Canceled Orders and Added Test Issue"
^DIC(9.4,14,22,5.9,"PAH",300,0)="495 SEQ #399^3180301.141803^54"
^DIC(9.4,14,22,5.9,"PAH",300,1,0)="^^1^1^3180301"
^DIC(9.4,14,22,5.9,"PAH",300,1,1,0)="See National Patch Module for details."
^DIC(9.4,14,22,5.9,"PAH",301,0)="461 SEQ #400^3180301.153039^54"
^DIC(9.4,14,22,5.9,"PAH",301,1,0)="^^8^8^3180301"
^DIC(9.4,14,22,5.9,"PAH",301,1,1,0)="This patch addresses two (2) issues:"
^DIC(9.4,14,22,5.9,"PAH",301,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",301,1,3,0)="1. Accessions which have been merged to other accessions or marked as "
^DIC(9.4,14,22,5.9,"PAH",301,1,4,0)="   ""not performed"" may be resulted even though these accessions are"
^DIC(9.4,14,22,5.9,"PAH",301,1,5,0)="   cancelled."
^DIC(9.4,14,22,5.9,"PAH",301,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",301,1,7,0)="2. Anatomic Pathology labels do not print while using the option "
^DIC(9.4,14,22,5.9,"PAH",301,1,8,0)="   REFERRAL PATIENT MULTI-PURPOSE option for accessioning orders."
^DIC(9.4,14,22,5.9,"PAH",302,0)="494 SEQ #401^3180302.135926^54"
^DIC(9.4,14,22,5.9,"PAH",302,1,0)="^^4^4^3180302"
^DIC(9.4,14,22,5.9,"PAH",302,1,1,0)="This patch addresses one (1) VistA Laboratory issue related to the "
^DIC(9.4,14,22,5.9,"PAH",302,1,2,0)="processing of workload transactions received from VBECS (VistA Blood "
^DIC(9.4,14,22,5.9,"PAH",302,1,3,0)="Establishment Computer Software).  Incorrect Lab Order Entry (#69) file "
^DIC(9.4,14,22,5.9,"PAH",302,1,4,0)="entries are sometimes created."
^DIC(9.4,14,22,5.9,"PAH",303,0)="471 SEQ #402^3180403.154622^54"
^DIC(9.4,14,22,5.9,"PAH",303,1,0)="^^10^10^3180403"
^DIC(9.4,14,22,5.9,"PAH",303,1,1,0)="The patch addresses two (2) issues:"
^DIC(9.4,14,22,5.9,"PAH",303,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",303,1,3,0)="1.   When the legacy CPRS List Manager option CPRS Ward Clerk"
^DIC(9.4,14,22,5.9,"PAH",303,1,4,0)="     Menu [OR OR/RR MENU WARD CLERK] is used to call Lab "
^DIC(9.4,14,22,5.9,"PAH",303,1,5,0)="     package routines (SET1^LRGEN) to display Lab Results by "
^DIC(9.4,14,22,5.9,"PAH",303,1,6,0)="     Test, a program error (UNDEFINED) is encountered."
^DIC(9.4,14,22,5.9,"PAH",303,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",303,1,8,0)="2.   The VistA routine ^LRX performs a FileMan database server"
^DIC(9.4,14,22,5.9,"PAH",303,1,9,0)="     call ($$GET1^DID) to retrieve a global reference.  The "
^DIC(9.4,14,22,5.9,"PAH",303,1,10,0)="     parameters used in the call are improper. "
^DIC(9.4,14,22,5.9,"PAH",304,0)="490 SEQ #403^3180403.165627^54"
^DIC(9.4,14,22,5.9,"PAH",304,1,0)="^^11^11^3180403"
^DIC(9.4,14,22,5.9,"PAH",304,1,1,0)="The patch addresses two (2) issues:"
^DIC(9.4,14,22,5.9,"PAH",304,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",304,1,3,0)="1.   When a user goes to the Multipurpose accessioning option [LRQUICK] "
^DIC(9.4,14,22,5.9,"PAH",304,1,4,0)="     in the Accessioning menu option [LR IN], the variable LRORDR may "
^DIC(9.4,14,22,5.9,"PAH",304,1,5,0)="     still be set and causes the accessioning routine to erroneously "
^DIC(9.4,14,22,5.9,"PAH",304,1,6,0)="     assume that specimen collection will be by Ward Collect."
^DIC(9.4,14,22,5.9,"PAH",304,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",304,1,8,0)="2.   When Anatomic Pathology Electronic Signatures are turned off and "
^DIC(9.4,14,22,5.9,"PAH",304,1,9,0)="     the Verify/release reports, anat path [LRAPR] option is selected to"
^DIC(9.4,14,22,5.9,"PAH",304,1,10,0)="     unrelease a verified provisional report, the prompt to ""Unrelease"
^DIC(9.4,14,22,5.9,"PAH",304,1,11,0)="     Report"" is not displayed."
^DIC(9.4,14,22,5.9,"PAH",305,0)="502^3180403.171755^54"
^DIC(9.4,14,22,5.9,"PAH",305,1,0)="^^2^2^3180403"
^DIC(9.4,14,22,5.9,"PAH",305,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,14,22,5.9,"PAH",305,1,2,0)="included in this patch."
^DIC(9.4,14,22,5.9,"PAH",306,0)="503 SEQ #405^3180601.140149^54"
^DIC(9.4,14,22,5.9,"PAH",306,1,0)="^^4^4^3180601"
^DIC(9.4,14,22,5.9,"PAH",306,1,1,0)="This patch addresses two (2) VistA Laboratory issues:"
^DIC(9.4,14,22,5.9,"PAH",306,1,2,0)="(1) Statistical reports might list inaccurate information for monthly "
^DIC(9.4,14,22,5.9,"PAH",306,1,3,0)="accession areas."
^DIC(9.4,14,22,5.9,"PAH",306,1,4,0)="(2) Inactive providers are displayed during Anatomic Pathology Log-In."
^DIC(9.4,14,22,5.9,"PAH",307,0)="476 SEQ #406^3180601.150428^54"
^DIC(9.4,14,22,5.9,"PAH",307,1,0)="^^7^7^3180601"
^DIC(9.4,14,22,5.9,"PAH",307,1,1,0)="This build exports changes to the field #1 of the Execute Code "
^DIC(9.4,14,22,5.9,"PAH",307,1,2,0)="file (#62.07) and affects the option RB Results Entry (Batch) "
^DIC(9.4,14,22,5.9,"PAH",307,1,3,0)="for Microbiology. "
^DIC(9.4,14,22,5.9,"PAH",307,1,4,0)="Also a new FileMan function is exported for reporting on lab "
^DIC(9.4,14,22,5.9,"PAH",307,1,5,0)="results for patients with a given specimen type, a lab test, and looking"
^DIC(9.4,14,22,5.9,"PAH",307,1,6,0)="back over a specified number of days."
^DIC(9.4,14,22,5.9,"PAH",307,1,7,0)="The Forum patch description offers more details and the NSRs involved."
^DIC(9.4,14,22,5.9,"PAH",308,0)="454 SEQ #407^3180706.132259^54"
^DIC(9.4,14,22,5.9,"PAH",308,1,0)="^^4^4^3180706"
^DIC(9.4,14,22,5.9,"PAH",308,1,1,0)="This patch addresses one (1) issue in the Lab package:"
^DIC(9.4,14,22,5.9,"PAH",308,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",308,1,3,0)="Prevent error which can occur when incorrect facility identifier is "
^DIC(9.4,14,22,5.9,"PAH",308,1,4,0)="received from the Point of Care (POC) interface."
^DIC(9.4,14,22,5.9,"PAH",309,0)="500 SEQ #408^3180706.143852^54"
^DIC(9.4,14,22,5.9,"PAH",309,1,0)="^^1^1^3180706"
^DIC(9.4,14,22,5.9,"PAH",309,1,1,0)="See National Patch Module for details."
^DIC(9.4,14,22,5.9,"PAH",310,0)="505 SEQ #409^3180904.153945^54"
^DIC(9.4,14,22,5.9,"PAH",310,1,0)="^^1^1^3180904"
^DIC(9.4,14,22,5.9,"PAH",310,1,1,0)="NOTIFY TIER 2 OF FILE 60 UNDEF IF PRESENT"
^DIC(9.4,14,22,5.9,"PAH",311,0)="507 SEQ #410^3180907.130032^54"
^DIC(9.4,14,22,5.9,"PAH",311,1,0)="^^7^7^3180907"
^DIC(9.4,14,22,5.9,"PAH",311,1,1,0)="The patch addresses one (1) issue:"
^DIC(9.4,14,22,5.9,"PAH",311,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",311,1,3,0)="1.   When a lab panel (cosmic) test is set up so the atomic tests in "
^DIC(9.4,14,22,5.9,"PAH",311,1,4,0)="     the panel split to separate accession areas (e.g.: one Chemistry"
^DIC(9.4,14,22,5.9,"PAH",311,1,5,0)="     and one Toxicology), results of the ordered panel test do not "
^DIC(9.4,14,22,5.9,"PAH",311,1,6,0)="     display all of the results of the atomic tests in the panel when "
^DIC(9.4,14,22,5.9,"PAH",311,1,7,0)="     viewed in CPRS from the Orders tab or from the Cover Sheet."
^DIC(9.4,14,22,5.9,"PAH",312,0)="499 SEQ #411^3181004.162123^54"
^DIC(9.4,14,22,5.9,"PAH",312,1,0)="^^4^4^3181004"
^DIC(9.4,14,22,5.9,"PAH",312,1,1,0)="This patch addresses two (2) VistA Laboratory issues related to accession "
^DIC(9.4,14,22,5.9,"PAH",312,1,2,0)="labels being skipped or the printing process generating duplicate labels "
^DIC(9.4,14,22,5.9,"PAH",312,1,3,0)="endlessly as well as results being verified when the user has no initials "
^DIC(9.4,14,22,5.9,"PAH",312,1,4,0)="on file in the New Person (#200) file."
^DIC(9.4,14,22,5.9,"PAH",313,0)="511^3181101.162138^54"
^DIC(9.4,14,22,5.9,"PAH",313,1,0)="^^2^2^3181101"
^DIC(9.4,14,22,5.9,"PAH",313,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,14,22,5.9,"PAH",313,1,2,0)="included in this patch."
^DIC(9.4,14,22,5.9,"PAH",314,0)="498 SEQ #413^3181102.153233^54"
^DIC(9.4,14,22,5.9,"PAH",314,1,0)="^^4^4^3181102"
^DIC(9.4,14,22,5.9,"PAH",314,1,1,0)="This patch addresses the following one (1) VistA Laboratory issue: When a"
^DIC(9.4,14,22,5.9,"PAH",314,1,2,0)="LEDI Host facility adds a new lab test to an accessioned order shipped "
^DIC(9.4,14,22,5.9,"PAH",314,1,3,0)="from a Collection facility the UID is improperly assigned with the "
^DIC(9.4,14,22,5.9,"PAH",314,1,4,0)="ordering site's UID instead of the host site's UID. "
^DIC(9.4,14,22,5.9,"PAH",315,0)="510 SEQ #414^3181102.15563^54"
^DIC(9.4,14,22,5.9,"PAH",316,0)="509 SEQ #415^3181206.155945^54"
^DIC(9.4,14,22,5.9,"PAH",316,1,0)="^^22^22^3181206"
^DIC(9.4,14,22,5.9,"PAH",316,1,1,0)="The patch addresses four (4) issues:"
^DIC(9.4,14,22,5.9,"PAH",316,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",316,1,3,0)="1.  Emerging Pathogen Initiative (EPI) data is collected in VistA and "
^DIC(9.4,14,22,5.9,"PAH",316,1,4,0)="    forwarded to the Austin Information Technology Center (AITC) for"
^DIC(9.4,14,22,5.9,"PAH",316,1,5,0)="    national roll-up monthly.  Part of the collected data has to do with"
^DIC(9.4,14,22,5.9,"PAH",316,1,6,0)="    Clinical Reminders related to Hepatitis C.  The Clinical Reminder data"
^DIC(9.4,14,22,5.9,"PAH",316,1,7,0)="    is formatted into the DSP segment of a HL7 record for delivery to the"
^DIC(9.4,14,22,5.9,"PAH",316,1,8,0)="    AITC.  The data is currently being formatted improperly."
^DIC(9.4,14,22,5.9,"PAH",316,1,9,0)=" "
^DIC(9.4,14,22,5.9,"PAH",316,1,10,0)="2.  When USING AP Log-in, anat path [option LRAPLG], an <UNDEFINED> error"
^DIC(9.4,14,22,5.9,"PAH",316,1,11,0)="    occurs in the NEXT subroutine of routine LRAPKOE when logging in a "
^DIC(9.4,14,22,5.9,"PAH",316,1,12,0)="    case for a deceased veteran ordered in CPRS."
^DIC(9.4,14,22,5.9,"PAH",316,1,13,0)=" "
^DIC(9.4,14,22,5.9,"PAH",316,1,14,0)="3.  In AP Log-in, anat path [option LRAPLG], the PATHOLOGIST prompt is a "
^DIC(9.4,14,22,5.9,"PAH",316,1,15,0)="    required entry.  The pathologist who will read the case is usually "
^DIC(9.4,14,22,5.9,"PAH",316,1,16,0)="    not known at the time the case is logged into the laboratory.  The "
^DIC(9.4,14,22,5.9,"PAH",316,1,17,0)="    process should be modified to make entry of PATHOLOGIST optional."
^DIC(9.4,14,22,5.9,"PAH",316,1,18,0)=" "
^DIC(9.4,14,22,5.9,"PAH",316,1,19,0)="4.  The routine (LRAPKOE) that processes Anatomic Pathology orders entered"
^DIC(9.4,14,22,5.9,"PAH",316,1,20,0)="    in CPRS needs to be modified to call VistA Imaging to add the case to"
^DIC(9.4,14,22,5.9,"PAH",316,1,21,0)="    the MAG PATH CASELIST file (#2005.42) to support Telepathology and to"
^DIC(9.4,14,22,5.9,"PAH",316,1,22,0)="    generate the HL7 message that is sent to digital pathology systems."
^DIC(9.4,14,22,5.9,"PAH",317,0)="508 SEQ #416^3181206.161753^54"
^DIC(9.4,14,22,5.9,"PAH",317,1,0)="^^20^20^3181206"
^DIC(9.4,14,22,5.9,"PAH",317,1,1,0)="This patch will update the DESCRIPTION field (#6) in file #62.07 with the"
^DIC(9.4,14,22,5.9,"PAH",317,1,2,0)="Preliminary Comments field for Bacteriology, TB Bacteriology, and"
^DIC(9.4,14,22,5.9,"PAH",317,1,3,0)="Mycology."
^DIC(9.4,14,22,5.9,"PAH",317,1,4,0)="Also, it will clean up obsolete codes in the EXECUTE CODE field #1 of"
^DIC(9.4,14,22,5.9,"PAH",317,1,5,0)="the EXECUTE CODE file (#62.07), that were discovered after the release of"
^DIC(9.4,14,22,5.9,"PAH",317,1,6,0)="LR*5.2*476. The obsolete execute codes were not introduced by LR*5.2*476"
^DIC(9.4,14,22,5.9,"PAH",317,1,7,0)="because it was found that many sites have the codes before LR*5.2*476"
^DIC(9.4,14,22,5.9,"PAH",317,1,8,0)="was installed. In a nutshell, Mycology will be cleaned up of obsolete"
^DIC(9.4,14,22,5.9,"PAH",317,1,9,0)="field #19.2; in Bacteriology, the expression LRSPEC=68 will be replaced"
^DIC(9.4,14,22,5.9,"PAH",317,1,10,0)="with LRSPEC=360."
^DIC(9.4,14,22,5.9,"PAH",317,1,11,0)="When the patch is installed, it saves the existing DESCRIPTION field "
^DIC(9.4,14,22,5.9,"PAH",317,1,12,0)="contents and the Execute codes in the installation log for later review "
^DIC(9.4,14,22,5.9,"PAH",317,1,13,0)="if desired. The log can be used to manually restore local changes found"
^DIC(9.4,14,22,5.9,"PAH",317,1,14,0)="and not restored by this patch."
^DIC(9.4,14,22,5.9,"PAH",317,1,15,0)=" "
^DIC(9.4,14,22,5.9,"PAH",317,1,16,0)="This patch also modifies the routine LRMISTF by adding the "
^DIC(9.4,14,22,5.9,"PAH",317,1,17,0)="preliminary comment fields for Bacteriology, TB Bacteriology, and "
^DIC(9.4,14,22,5.9,"PAH",317,1,18,0)="Mycology with corresponding expansion codes so that the canned messages "
^DIC(9.4,14,22,5.9,"PAH",317,1,19,0)="from the LAB DESCRIPTIONS file (#62.5) appear during Results Entry "
^DIC(9.4,14,22,5.9,"PAH",317,1,20,0)="(Batch)."
^DIC(9.4,14,22,5.9,"PAH",318,0)="504 SEQ #417^3190301.154037^54"
^DIC(9.4,14,22,5.9,"PAH",318,1,0)="^^20^20^3190301"
^DIC(9.4,14,22,5.9,"PAH",318,1,1,0)="R18600337FY18: Missing Anatomic Pathology Alerts"
^DIC(9.4,14,22,5.9,"PAH",318,1,2,0)="R19264009FY18 (d)"
^DIC(9.4,14,22,5.9,"PAH",318,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",318,1,4,0)="Problem:"
^DIC(9.4,14,22,5.9,"PAH",318,1,5,0)="-------"
^DIC(9.4,14,22,5.9,"PAH",318,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",318,1,7,0)="Alerts might not be generated after Anatomic Pathology cases are verified."
^DIC(9.4,14,22,5.9,"PAH",318,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",318,1,9,0)="Resolution: "
^DIC(9.4,14,22,5.9,"PAH",318,1,10,0)="----------"
^DIC(9.4,14,22,5.9,"PAH",318,1,11,0)=" "
^DIC(9.4,14,22,5.9,"PAH",318,1,12,0)="The root cause of this issue is not yet known.  In the meantime, this "
^DIC(9.4,14,22,5.9,"PAH",318,1,13,0)="patch provides an option which will search for missing Anatomic"
^DIC(9.4,14,22,5.9,"PAH",318,1,14,0)="Pathology alerts as well as other issues known to occur along with "
^DIC(9.4,14,22,5.9,"PAH",318,1,15,0)="missing alerts such as fields in the ORDERS (#100) file which are set "
^DIC(9.4,14,22,5.9,"PAH",318,1,16,0)="incorrectly."
^DIC(9.4,14,22,5.9,"PAH",318,1,17,0)=" "
^DIC(9.4,14,22,5.9,"PAH",318,1,18,0)="Refer to the FORUM patch description for detailed information on alerts "
^DIC(9.4,14,22,5.9,"PAH",318,1,19,0)="and MailMan messages which are generated after the search option "
^DIC(9.4,14,22,5.9,"PAH",318,1,20,0)="completes."
^DIC(9.4,14,22,5.9,"PAH",319,0)="513 SEQ #418^3190401.165915^54"
^DIC(9.4,14,22,5.9,"PAH",319,1,0)="^^1^1^3190401"
^DIC(9.4,14,22,5.9,"PAH",319,1,1,0)="Problem with option Results entry (batch) [LRMISTUF]"
^DIC(9.4,14,22,5.9,"PAH",320,0)="514 SEQ #419^3190402.16491^54"
^DIC(9.4,14,22,5.9,"PAH",320,1,0)="^^5^5^3190402"
^DIC(9.4,14,22,5.9,"PAH",320,1,1,0)="This patch addresses one (1) issue:"
^DIC(9.4,14,22,5.9,"PAH",320,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",320,1,3,0)="Anatomic Pathology Log-In does not require that the patient's sex must "
^DIC(9.4,14,22,5.9,"PAH",320,1,4,0)="match the SEX SPECIFIC (#2.5) field in the TOPOGRAPHY FIELD (#61) file for"
^DIC(9.4,14,22,5.9,"PAH",320,1,5,0)="specimens (if the sex specific field is defined)."
^DIC(9.4,14,22,5.9,"PAH",321,0)="515^3190402.171457^54"
^DIC(9.4,14,22,5.9,"PAH",321,1,0)="^^2^2^3190402"
^DIC(9.4,14,22,5.9,"PAH",321,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,14,22,5.9,"PAH",321,1,2,0)="included in this patch."
^DIC(9.4,14,22,5.9,"PAH",322,0)="516 SEQ #421^3190501.150236^54"
^DIC(9.4,14,22,5.9,"PAH",322,1,0)="^^1^1^3190501"
^DIC(9.4,14,22,5.9,"PAH",322,1,1,0)="LAB TEST NOT DISPLAYED IN CPRS MOST RECENT VIEW"
^DIC(9.4,14,22,5.9,"PAH",323,0)="512 SEQ #422^3190501.164457^54"
^DIC(9.4,14,22,5.9,"PAH",323,1,0)="^^4^4^3190501"
^DIC(9.4,14,22,5.9,"PAH",323,1,1,0)="This patch addresses one (1) VistA Laboratory issue:"
^DIC(9.4,14,22,5.9,"PAH",323,1,2,0)="  "
^DIC(9.4,14,22,5.9,"PAH",323,1,3,0)="The status for a lab order in CPRS displays as ""active"" when the status"
^DIC(9.4,14,22,5.9,"PAH",323,1,4,0)="should display as ""complete""."
^DIC(9.4,14,22,5.9,"PAH",324,0)="520 SEQ #423^3190530.123324^17"
^DIC(9.4,14,22,5.9,"PAH",324,1,0)="^^1^1^3190530"
^DIC(9.4,14,22,5.9,"PAH",324,1,1,0)="CANCELED LAB TEST PROBLEM"
^DIC(9.4,14,22,5.9,"PAH",325,0)="517 SEQ #424^3190604.181555^54"
^DIC(9.4,14,22,5.9,"PAH",325,1,0)="^^3^3^3190604"
^DIC(9.4,14,22,5.9,"PAH",325,1,1,0)="This patch will prevent an error in CPRS that is occuring when a user is "
^DIC(9.4,14,22,5.9,"PAH",325,1,2,0)="placing a lab test order that has had a site/specimen deleted from the "
^DIC(9.4,14,22,5.9,"PAH",325,1,3,0)="lab test setup."
^DIC(9.4,14,22,5.9,"PAH",326,0)="523 SEQ #425^3190708.215811^65"
^DIC(9.4,14,22,5.9,"PAH",326,1,0)="^^1^1^3190708"
^DIC(9.4,14,22,5.9,"PAH",326,1,1,0)="Most Recent report in CPRS buttons greyed out"
^DIC(9.4,14,22,5.9,"PAH",327,0)="525^3190930.112856^65"
^DIC(9.4,14,22,5.9,"PAH",327,1,0)="^^2^2^3190930"
^DIC(9.4,14,22,5.9,"PAH",327,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,14,22,5.9,"PAH",327,1,2,0)="included in this patch."
^DIC(9.4,14,22,5.9,"PAH",328,0)="519 SEQ #428^3191016.162313^65"
^DIC(9.4,14,22,5.9,"PAH",328,1,0)="^^15^15^3191016"
^DIC(9.4,14,22,5.9,"PAH",328,1,1,0)="The patch addresses three (3) issues: "
^DIC(9.4,14,22,5.9,"PAH",328,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",328,1,3,0)="1. When a lab panel (cosmic) test is set up so the atomic tests in the "
^DIC(9.4,14,22,5.9,"PAH",328,1,4,0)="   panel split to separate accession areas (e.g. one Chemistry and one"
^DIC(9.4,14,22,5.9,"PAH",328,1,5,0)="   Toxicology), results of the ordered panel test do not display all of"
^DIC(9.4,14,22,5.9,"PAH",328,1,6,0)="   the results of the atomic tests in the panel when viewed in the "
^DIC(9.4,14,22,5.9,"PAH",328,1,7,0)="   Computerized Patient Record System (CPRS) from the Orders tab or "
^DIC(9.4,14,22,5.9,"PAH",328,1,8,0)="   from the Cover Sheet."
^DIC(9.4,14,22,5.9,"PAH",328,1,9,0)=" "
^DIC(9.4,14,22,5.9,"PAH",328,1,10,0)="2. Data corruption might occur in the data dictionary for file 63.04 if "
^DIC(9.4,14,22,5.9,"PAH",328,1,11,0)="   one or more users are adding or editing data names for Laboratory"
^DIC(9.4,14,22,5.9,"PAH",328,1,12,0)="   tests."
^DIC(9.4,14,22,5.9,"PAH",328,1,13,0)=" "
^DIC(9.4,14,22,5.9,"PAH",328,1,14,0)="3. A VistA software error might be generated during execution of option "
^DIC(9.4,14,22,5.9,"PAH",328,1,15,0)="   ""Group verify (EA, EL, EW)"" if results are being printed."
^DIC(9.4,14,22,5.9,"PAH",329,0)="526 SEQ #429^3191206.145247^65"
^DIC(9.4,14,22,5.9,"PAH",329,1,0)="^^4^4^3191206"
^DIC(9.4,14,22,5.9,"PAH",329,1,1,0)="This patch addresses one (1) issue:"
^DIC(9.4,14,22,5.9,"PAH",329,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",329,1,3,0)="A Social Work package Integration Control Registration (ICR) of 1528 is "
^DIC(9.4,14,22,5.9,"PAH",329,1,4,0)="being retired."
^DIC(9.4,14,22,5.9,"PAH",330,0)="528 SEQ #430^3191206.145439^65"
^DIC(9.4,14,22,5.9,"PAH",330,1,0)="^^7^7^3191206"
^DIC(9.4,14,22,5.9,"PAH",330,1,1,0)="The patch addresses one (1) issue:"
^DIC(9.4,14,22,5.9,"PAH",330,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",330,1,3,0)="1. When the Itemized routine lab collection [LRPHITEM] option is used,"
^DIC(9.4,14,22,5.9,"PAH",330,1,4,0)="   a previously deleted order marked as Not Performed can be entered"
^DIC(9.4,14,22,5.9,"PAH",330,1,5,0)="   as collected.  This sets the Lab Arrival Time (#69.01,20) in the"
^DIC(9.4,14,22,5.9,"PAH",330,1,6,0)="   LAB ORDER ENTRY file (#69) for the accession to the curent system"
^DIC(9.4,14,22,5.9,"PAH",330,1,7,0)="   time even when the order was cancelled."
^DIC(9.4,14,22,5.9,"PAH",331,0)="531 SEQ #431^3200122.111528^65"
^DIC(9.4,14,22,5.9,"PAH",331,1,0)="^^1^1^3200122"
^DIC(9.4,14,22,5.9,"PAH",331,1,1,0)="LRCONJAM AND CUMULATIVE HEADER ISSUES"
^DIC(9.4,14,22,5.9,"PAH",332,0)="534 SEQ #432^3200211.095943^65"
^DIC(9.4,14,22,5.9,"PAH",332,1,0)="^^9^9^3200211"
^DIC(9.4,14,22,5.9,"PAH",332,1,1,0)="The patch addresses one (1) issue: "
^DIC(9.4,14,22,5.9,"PAH",332,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",332,1,3,0)="1.  Patch LR*5.2*519 dealt with the proper display of lab results on"
^DIC(9.4,14,22,5.9,"PAH",332,1,4,0)="    panels with multiple ACCESSION AREAs. The new code in the patch "
^DIC(9.4,14,22,5.9,"PAH",332,1,5,0)="    revealed that the LAB DATA FILE (#63) at some sites may contain "
^DIC(9.4,14,22,5.9,"PAH",332,1,6,0)="    orphan zero nodes.  These zero nodes are global records (i.e.: "
^DIC(9.4,14,22,5.9,"PAH",332,1,7,0)="    ^LR(D0,CH,D1,0)) that have no results.  Encountering these orphan"
^DIC(9.4,14,22,5.9,"PAH",332,1,8,0)="    nodes in the database when rendering results for the same patient"
^DIC(9.4,14,22,5.9,"PAH",332,1,9,0)="    causes a SUBSCRIPT error."
^DIC(9.4,14,22,5.9,"PAH",333,0)="524 SEQ #433^3200324.164926^70"
^DIC(9.4,14,22,5.9,"PAH",333,1,0)="^^10^10^3200324"
^DIC(9.4,14,22,5.9,"PAH",333,1,1,0)="This patch addresses three (3) issues:"
^DIC(9.4,14,22,5.9,"PAH",333,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",333,1,3,0)="1. An atomic test which is a component of a panel might appear on the "
^DIC(9.4,14,22,5.9,"PAH",333,1,4,0)="   pending list even though the test is verified."
^DIC(9.4,14,22,5.9,"PAH",333,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",333,1,6,0)="2. A lab panel might appear on the pending list even though all components"
^DIC(9.4,14,22,5.9,"PAH",333,1,7,0)="   have been verified."
^DIC(9.4,14,22,5.9,"PAH",333,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",333,1,9,0)="3. If a test is marked as ""not performed"", the LRVR result verification "
^DIC(9.4,14,22,5.9,"PAH",333,1,10,0)="   option might delete the ""not performed"" status of the test."
^DIC(9.4,14,22,5.9,"PAH",334,0)="533 SEQ #434^3200410.155548^70"
^DIC(9.4,14,22,5.9,"PAH",334,1,0)="^^5^5^3200410"
^DIC(9.4,14,22,5.9,"PAH",334,1,1,0)="This patch addresses two (2) issues:"
^DIC(9.4,14,22,5.9,"PAH",334,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",334,1,3,0)="1. Microbiology reports might not display the accurate status of a test.  "
^DIC(9.4,14,22,5.9,"PAH",334,1,4,0)="2. Unverified Microbiology results are visible in CPRS reports during"
^DIC(9.4,14,22,5.9,"PAH",334,1,5,0)="   results verification sessions."
^DIC(9.4,14,22,5.9,"PAH",335,0)="532^3200601.160848^70"
^DIC(9.4,14,22,5.9,"PAH",335,1,0)="^^2^2^3200601"
^DIC(9.4,14,22,5.9,"PAH",335,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,14,22,5.9,"PAH",335,1,2,0)="included in this patch."
^DIC(9.4,14,22,5.9,"PAH",336,0)="535 SEQ #436^3200923.104745^65"
^DIC(9.4,14,22,5.9,"PAH",336,1,0)="^^133^133^3200923"
^DIC(9.4,14,22,5.9,"PAH",336,1,1,0)="This patch is being released in conjunction with VBEC 2.3.2 Rev F. "
^DIC(9.4,14,22,5.9,"PAH",336,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,3,0)="A full description of patch changes and implementation process are "
^DIC(9.4,14,22,5.9,"PAH",336,1,4,0)="included in the VBECS 2.3.2 Rev F Release Notes."
^DIC(9.4,14,22,5.9,"PAH",336,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,6,0)="The Test and Production accounts will be installed separately. There is "
^DIC(9.4,14,22,5.9,"PAH",336,1,7,0)="no downtime associated with this patch installation. Refer to the VBECS "
^DIC(9.4,14,22,5.9,"PAH",336,1,8,0)="2.3.2 Rev F Release Notes for further installation details."
^DIC(9.4,14,22,5.9,"PAH",336,1,9,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,10,0)="Items addressed in VBECS 2.3.2 Rev F are listed in the VistA Blood "
^DIC(9.4,14,22,5.9,"PAH",336,1,11,0)="Establishment Computer Software (VBECS) 2.3.2 Rev F Release Notes."
^DIC(9.4,14,22,5.9,"PAH",336,1,12,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,13,0)="Associated ticket(s):"
^DIC(9.4,14,22,5.9,"PAH",336,1,14,0)="====================="
^DIC(9.4,14,22,5.9,"PAH",336,1,15,0)=" N/A"
^DIC(9.4,14,22,5.9,"PAH",336,1,16,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,17,0)="Associated NSR(s):"
^DIC(9.4,14,22,5.9,"PAH",336,1,18,0)="=================="
^DIC(9.4,14,22,5.9,"PAH",336,1,19,0)=" N/A"
^DIC(9.4,14,22,5.9,"PAH",336,1,20,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,21,0)="Patient Safety Issues (PSIs):"
^DIC(9.4,14,22,5.9,"PAH",336,1,22,0)="============================"
^DIC(9.4,14,22,5.9,"PAH",336,1,23,0)=" N/A"
^DIC(9.4,14,22,5.9,"PAH",336,1,24,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,25,0)="Participating Test Sites:"
^DIC(9.4,14,22,5.9,"PAH",336,1,26,0)="========================="
^DIC(9.4,14,22,5.9,"PAH",336,1,27,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,28,0)="TBD"
^DIC(9.4,14,22,5.9,"PAH",336,1,29,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,30,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,14,22,5.9,"PAH",336,1,31,0)="============================================"
^DIC(9.4,14,22,5.9,"PAH",336,1,32,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,33,0)=" N/A"
^DIC(9.4,14,22,5.9,"PAH",336,1,34,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,35,0)="Additional Information:"
^DIC(9.4,14,22,5.9,"PAH",336,1,36,0)="-----------------------"
^DIC(9.4,14,22,5.9,"PAH",336,1,37,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,38,0)="Blood Bank Team Coordination:"
^DIC(9.4,14,22,5.9,"PAH",336,1,39,0)="-----------------------------"
^DIC(9.4,14,22,5.9,"PAH",336,1,40,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*535 does not "
^DIC(9.4,14,22,5.9,"PAH",336,1,41,0)="contain any changes to the VISTA BLOOD BANK Software as defined by "
^DIC(9.4,14,22,5.9,"PAH",336,1,42,0)="ProPath standard titled: BBM Team Review of VistA Patches."
^DIC(9.4,14,22,5.9,"PAH",336,1,43,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,44,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*535 does not "
^DIC(9.4,14,22,5.9,"PAH",336,1,45,0)="alter or modify any software design safeguards or safety critical "
^DIC(9.4,14,22,5.9,"PAH",336,1,46,0)="elements functions."
^DIC(9.4,14,22,5.9,"PAH",336,1,47,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,48,0)="RISK ANALYSIS: Changes made by patch LR*5.2*535 have no adverse effect on "
^DIC(9.4,14,22,5.9,"PAH",336,1,49,0)="Blood Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",336,1,50,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,51,0)="VALIDATION REQUIREMENTS BY OPTION: Because of the nature of the changes "
^DIC(9.4,14,22,5.9,"PAH",336,1,52,0)="made, no specific validation requirements exist as a result of "
^DIC(9.4,14,22,5.9,"PAH",336,1,53,0)="installation of this patch."
^DIC(9.4,14,22,5.9,"PAH",336,1,54,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,55,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,56,0)="Software and Documentation Retrieval Instructions:"
^DIC(9.4,14,22,5.9,"PAH",336,1,57,0)="--------------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",336,1,58,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,59,0)="Documentation describing the new functionality introduced by this patch "
^DIC(9.4,14,22,5.9,"PAH",336,1,60,0)="is available on the VA Software Documentation Library at:"
^DIC(9.4,14,22,5.9,"PAH",336,1,61,0)="http://www.domain.ext/vdl/application.asp?appid=182"
^DIC(9.4,14,22,5.9,"PAH",336,1,62,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,63,0)="Refer to the VBECS 2.3.2 Rev F Release Notes for a list of the user "
^DIC(9.4,14,22,5.9,"PAH",336,1,64,0)="documentation associated with this revision letter patch."
^DIC(9.4,14,22,5.9,"PAH",336,1,65,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,66,0)="Additional VBECS information can be accessed on the VBECS SharePoint site "
^DIC(9.4,14,22,5.9,"PAH",336,1,67,0)="at: https://dvagov.sharepoint.com/sites/oitepmovbecs"
^DIC(9.4,14,22,5.9,"PAH",336,1,68,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,69,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,70,0)="Patch Installation:"
^DIC(9.4,14,22,5.9,"PAH",336,1,71,0)="-------------------"
^DIC(9.4,14,22,5.9,"PAH",336,1,72,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,73,0)="Pre-Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",336,1,74,0)="This patch may be installed with users on the system although it is "
^DIC(9.4,14,22,5.9,"PAH",336,1,75,0)="recommended that it be installed during non-peak hours to minimize "
^DIC(9.4,14,22,5.9,"PAH",336,1,76,0)="potential disruption to users.  This patch should take less than 5 "
^DIC(9.4,14,22,5.9,"PAH",336,1,77,0)="minutes to install."
^DIC(9.4,14,22,5.9,"PAH",336,1,78,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,79,0)="No options need to be disabled during installation."
^DIC(9.4,14,22,5.9,"PAH",336,1,80,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,81,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,82,0)="Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",336,1,83,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,84,0)=" 1. Choose the PackMan message containing this build. Then select the"
^DIC(9.4,14,22,5.9,"PAH",336,1,85,0)="    INSTALL/CHECK MESSAGE PackMan option to load the build."
^DIC(9.4,14,22,5.9,"PAH",336,1,86,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,87,0)=" 2. From the Kernel Installation and Distribution System Menu, select the"
^DIC(9.4,14,22,5.9,"PAH",336,1,88,0)="    Installation Menu.  From this menu, "
^DIC(9.4,14,22,5.9,"PAH",336,1,89,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,90,0)="    A. Select the Verify Checksums in Transport Global option to confirm "
^DIC(9.4,14,22,5.9,"PAH",336,1,91,0)="       the integrity of the routines that are in the transport global."
^DIC(9.4,14,22,5.9,"PAH",336,1,92,0)="       When prompted for the INSTALL NAME enter the patch name LR*5.2*535."
^DIC(9.4,14,22,5.9,"PAH",336,1,93,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,94,0)="    B. Select the Backup a Transport Global option to create a backup"
^DIC(9.4,14,22,5.9,"PAH",336,1,95,0)="       message of any routines exported with this patch. It will not"
^DIC(9.4,14,22,5.9,"PAH",336,1,96,0)="       backup any other changes such as DDs or templates. "
^DIC(9.4,14,22,5.9,"PAH",336,1,97,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,98,0)="    C. You may also elect to use the following options: "
^DIC(9.4,14,22,5.9,"PAH",336,1,99,0)="         i.  Print Transport Global - This option will allow you to view"
^DIC(9.4,14,22,5.9,"PAH",336,1,100,0)="             the components of the KIDS build."
^DIC(9.4,14,22,5.9,"PAH",336,1,101,0)="         ii. Compare Transport Global to Current System - This option"
^DIC(9.4,14,22,5.9,"PAH",336,1,102,0)="             will allow you to view all changes that will be made when"
^DIC(9.4,14,22,5.9,"PAH",336,1,103,0)="             this patch is installed.  It compares all of the components"
^DIC(9.4,14,22,5.9,"PAH",336,1,104,0)="             of this patch, such as routines, DDs, templates, etc."
^DIC(9.4,14,22,5.9,"PAH",336,1,105,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,106,0)="    D. Select the Install Package(s) option and choose the patch to"
^DIC(9.4,14,22,5.9,"PAH",336,1,107,0)="       install. "
^DIC(9.4,14,22,5.9,"PAH",336,1,108,0)="  "
^DIC(9.4,14,22,5.9,"PAH",336,1,109,0)="       i.  If prompted 'Want KIDS to Rebuild Menu Trees Upon Completion"
^DIC(9.4,14,22,5.9,"PAH",336,1,110,0)="           of Install? NO//', answer No"
^DIC(9.4,14,22,5.9,"PAH",336,1,111,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,112,0)="      ii. When prompted 'Want KIDS to INHIBIT LOGONs during the install?"
^DIC(9.4,14,22,5.9,"PAH",336,1,113,0)="          NO//', answer No"
^DIC(9.4,14,22,5.9,"PAH",336,1,114,0)="  "
^DIC(9.4,14,22,5.9,"PAH",336,1,115,0)="      iii. When prompted 'Want to DISABLE Scheduled Options, Menu"
^DIC(9.4,14,22,5.9,"PAH",336,1,116,0)="           Options, and Protocols? NO//', answer No"
^DIC(9.4,14,22,5.9,"PAH",336,1,117,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,118,0)="Post-Installation Instructions:"
^DIC(9.4,14,22,5.9,"PAH",336,1,119,0)=" N/A"
^DIC(9.4,14,22,5.9,"PAH",336,1,120,0)=" "
^DIC(9.4,14,22,5.9,"PAH",336,1,121,0)="Back-Out/Roll Back Plan:"
^DIC(9.4,14,22,5.9,"PAH",336,1,122,0)="------------------------"
^DIC(9.4,14,22,5.9,"PAH",336,1,123,0)=" This patch consists of one routine. During the VistA Installation "
^DIC(9.4,14,22,5.9,"PAH",336,1,124,0)=" Procedure the installer should back up the modified routines by the"
^DIC(9.4,14,22,5.9,"PAH",336,1,125,0)=" use of the 'Backup a Transport Global' action (step 2B in"
^DIC(9.4,14,22,5.9,"PAH",336,1,126,0)=" the Installations Instructions)."
^DIC(9.4,14,22,5.9,"PAH",336,1,127,0)="  "
^DIC(9.4,14,22,5.9,"PAH",336,1,128,0)=" If rollback/backout is required, the installer can restore the routines"
^DIC(9.4,14,22,5.9,"PAH",336,1,129,0)=" using the MailMan message that were saved prior to installing the"
^DIC(9.4,14,22,5.9,"PAH",336,1,130,0)=" patch."
^DIC(9.4,14,22,5.9,"PAH",336,1,131,0)="  "
^DIC(9.4,14,22,5.9,"PAH",336,1,132,0)=" If assistance is needed to rollback/backout the patch, please log a"
^DIC(9.4,14,22,5.9,"PAH",336,1,133,0)=" Service Now ticket."
^DIC(9.4,14,22,5.9,"PAH",337,0)="539^3200923.160333^65"
^DIC(9.4,14,22,5.9,"PAH",337,1,0)="^^2^2^3200923"
^DIC(9.4,14,22,5.9,"PAH",337,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,14,22,5.9,"PAH",337,1,2,0)="included in this patch."
^DIC(9.4,14,22,5.9,"PAH",338,0)="538 SEQ #438^3200923.161015^65"
^DIC(9.4,14,22,5.9,"PAH",338,1,0)="^^7^7^3200923"
^DIC(9.4,14,22,5.9,"PAH",338,1,1,0)="This patch addresses two (2) issues:"
^DIC(9.4,14,22,5.9,"PAH",338,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",338,1,3,0)="1. A panel might remain on the ""Incomplete test status list"" if it was "
^DIC(9.4,14,22,5.9,"PAH",338,1,4,0)="   ordered twice as Lab Collect."
^DIC(9.4,14,22,5.9,"PAH",338,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",338,1,6,0)="2. Building a Load/Worklist for a yearly accession area will cause a "
^DIC(9.4,14,22,5.9,"PAH",338,1,7,0)="   corrupted entry in the ACCESSION (#68) file."
^DIC(9.4,14,22,5.9,"PAH",339,0)="527 SEQ #439^3200923.161809^65"
^DIC(9.4,14,22,5.9,"PAH",339,1,0)="^^13^13^3200923"
^DIC(9.4,14,22,5.9,"PAH",339,1,1,0)="This patch addresses four (4) issues:"
^DIC(9.4,14,22,5.9,"PAH",339,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",339,1,3,0)="1.  The CPRS status of an order might not be correct when panel "
^DIC(9.4,14,22,5.9,"PAH",339,1,4,0)="    components are deleted using option LRTSTOUT."
^DIC(9.4,14,22,5.9,"PAH",339,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",339,1,6,0)="2.  Service correction comments are not displaying on canceled orders."
^DIC(9.4,14,22,5.9,"PAH",339,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",339,1,8,0)="3.  A VistA software error might occur during background processing "
^DIC(9.4,14,22,5.9,"PAH",339,1,9,0)="    involving the LABORATORY TEST (#60) file due to an incompletely filed"
^DIC(9.4,14,22,5.9,"PAH",339,1,10,0)="    test."
^DIC(9.4,14,22,5.9,"PAH",339,1,11,0)=" "
^DIC(9.4,14,22,5.9,"PAH",339,1,12,0)="4.  The ""NIGHTLY WKLD CODE CHECK REPORT"" contains orders which have been "
^DIC(9.4,14,22,5.9,"PAH",339,1,13,0)="    purged from the environment."
^DIC(9.4,14,22,5.9,"PAH",340,0)="540 SEQ #440^3201008.085849^17"
^DIC(9.4,14,22,5.9,"PAH",340,1,0)="^^4^4^3201008"
^DIC(9.4,14,22,5.9,"PAH",340,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,14,22,5.9,"PAH",340,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",340,1,3,0)="Any provider who is defined with the ""MOHS"" person class should be allowed"
^DIC(9.4,14,22,5.9,"PAH",340,1,4,0)="to electronically sign Anatomic Pathology cases."
^DIC(9.4,14,22,5.9,"PAH",341,0)="537 SEQ #441^3201112.17524^17"
^DIC(9.4,14,22,5.9,"PAH",341,1,0)="^^2^2^3201112"
^DIC(9.4,14,22,5.9,"PAH",341,1,1,0)="This patch addresses one (1) issue:"
^DIC(9.4,14,22,5.9,"PAH",341,1,2,0)="Workload is not captured for Class I Microbiology interfaces."
^DIC(9.4,14,22,5.9,"PAH",342,0)="536 SEQ #442^3210211.13071^17"
^DIC(9.4,14,22,5.9,"PAH",342,1,0)="^^11^11^3210211"
^DIC(9.4,14,22,5.9,"PAH",342,1,1,0)="This patch addresses four (4) issues:"
^DIC(9.4,14,22,5.9,"PAH",342,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",342,1,3,0)="1. Microbiology reports might not display the accurate status of a test. "
^DIC(9.4,14,22,5.9,"PAH",342,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",342,1,5,0)="2. Unverified Microbiology results are visible in CPRS reports."
^DIC(9.4,14,22,5.9,"PAH",342,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",342,1,7,0)="3. VistA reports might not list an accurate status for Microbiology "
^DIC(9.4,14,22,5.9,"PAH",342,1,8,0)="   accessions."
^DIC(9.4,14,22,5.9,"PAH",342,1,9,0)=" "
^DIC(9.4,14,22,5.9,"PAH",342,1,10,0)="4. If a session times out while entering Microbiology sensitivity results,"
^DIC(9.4,14,22,5.9,"PAH",342,1,11,0)="   the user may not be aware that the sensitivity results were not stored."
^DIC(9.4,14,22,5.9,"PAH",343,0)="542b^3210504"
^DIC(9.4,14,22,5.9,"PAH",343,1,0)="^^5^5^3210504"
^DIC(9.4,14,22,5.9,"PAH",343,1,1,0)="Backup of LR*5.2*542 on May 04, 2021"
^DIC(9.4,14,22,5.9,"PAH",343,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",343,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,14,22,5.9,"PAH",343,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,14,22,5.9,"PAH",343,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,14,22,5.9,"PAH",344,0)="542^3210504.155531^17"
^DIC(9.4,14,22,5.9,"PAH",344,1,0)="^^2^2^3210504"
^DIC(9.4,14,22,5.9,"PAH",344,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,14,22,5.9,"PAH",344,1,2,0)="included in this patch."
^DIC(9.4,14,22,5.9,"PAH",345,0)="543b^3210525"
^DIC(9.4,14,22,5.9,"PAH",345,1,0)="^^5^5^3210525"
^DIC(9.4,14,22,5.9,"PAH",345,1,1,0)="Backup of LR*5.2*543 on May 25, 2021"
^DIC(9.4,14,22,5.9,"PAH",345,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",345,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,14,22,5.9,"PAH",345,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,14,22,5.9,"PAH",345,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,14,22,5.9,"PAH",346,0)="543 SEQ #444^3210525.103848^17"
^DIC(9.4,14,22,5.9,"PAH",346,1,0)="^^6^6^3210525"
^DIC(9.4,14,22,5.9,"PAH",346,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,14,22,5.9,"PAH",346,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",346,1,3,0)="1. CPRS orderable items might be defined for non-existent Laboratory tests."
^DIC(9.4,14,22,5.9,"PAH",346,1,4,0)=" "
^DIC(9.4,14,22,5.9,"PAH",346,1,5,0)="2. Canceled Microbiology accessions might appear on Laboratory statistical"
^DIC(9.4,14,22,5.9,"PAH",346,1,6,0)="   reports as pending and not canceled."
^DIC(9.4,14,22,5.9,"PAH",347,0)="545b^3210629"
^DIC(9.4,14,22,5.9,"PAH",347,1,0)="^^5^5^3210629"
^DIC(9.4,14,22,5.9,"PAH",347,1,1,0)="Backup of LR*5.2*545 on Jun 29, 2021"
^DIC(9.4,14,22,5.9,"PAH",347,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",347,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,14,22,5.9,"PAH",347,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,14,22,5.9,"PAH",347,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,14,22,5.9,"PAH",348,0)="545 SEQ #446^3210629.161048^17"
^DIC(9.4,14,22,5.9,"PAH",348,1,0)="^^6^6^3210629"
^DIC(9.4,14,22,5.9,"PAH",348,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,14,22,5.9,"PAH",348,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",348,1,3,0)="If a test is canceled from an accession or merged to another accession"
^DIC(9.4,14,22,5.9,"PAH",348,1,4,0)="after the accession has been resulted on an instrument, it is possible to"
^DIC(9.4,14,22,5.9,"PAH",348,1,5,0)="verify a result on the canceled or merged test using option ""Enter/verify"
^DIC(9.4,14,22,5.9,"PAH",348,1,6,0)="data (auto instrument) (LRVR)""."
^DIC(9.4,14,22,5.9,"PAH",349,0)="544^3210701.1128^17"
^DIC(9.4,14,22,5.9,"PAH",349,1,0)="^^2^2^3210701"
^DIC(9.4,14,22,5.9,"PAH",349,1,1,0)="This patch updates the contents of the LR AP DIALOG CONFIG File (#69.73)"
^DIC(9.4,14,22,5.9,"PAH",349,1,2,0)="in preparation for Anatomic Pathology order dialogs in CPRS v32A."
^DIC(9.4,14,22,5.9,"PAH",350,0)="541b^3210720"
^DIC(9.4,14,22,5.9,"PAH",350,1,0)="^^5^5^3210720"
^DIC(9.4,14,22,5.9,"PAH",350,1,1,0)="Backup of LR*5.2*541 on Jul 20, 2021"
^DIC(9.4,14,22,5.9,"PAH",350,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",350,1,3,0)="Warning:  Installing this backup patch message will install older versions"
^DIC(9.4,14,22,5.9,"PAH",350,1,4,0)="of routines and Build Components (options, protocols, templates, etc.)."
^DIC(9.4,14,22,5.9,"PAH",350,1,5,0)="Please verify with the Development Team that it is safe to install."
^DIC(9.4,14,22,5.9,"PAH",351,0)="541 SEQ #448^3210720.110805^17"
^DIC(9.4,14,22,5.9,"PAH",351,1,0)="^^9^9^3210720"
^DIC(9.4,14,22,5.9,"PAH",351,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,14,22,5.9,"PAH",351,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",351,1,3,0)="1. An error will occur when canceling a component test in partially "
^DIC(9.4,14,22,5.9,"PAH",351,1,4,0)="   verified panels on referral orders."
^DIC(9.4,14,22,5.9,"PAH",351,1,5,0)="2. Some workflows for verification of Microbiology interfaced results will"
^DIC(9.4,14,22,5.9,"PAH",351,1,6,0)="   cause the CPRS order status to remain at ""active"" instead of changing"
^DIC(9.4,14,22,5.9,"PAH",351,1,7,0)="   to ""complete""."
^DIC(9.4,14,22,5.9,"PAH",351,1,8,0)="3. An invalid collection date/time could be entered when manually "
^DIC(9.4,14,22,5.9,"PAH",351,1,9,0)="   accessioning an order."
^DIC(9.4,14,22,5.9,"PAH",352,0)="549 SEQ #449^3210920.131439^17"
^DIC(9.4,14,22,5.9,"PAH",352,1,0)="^^24^24^3210920"
^DIC(9.4,14,22,5.9,"PAH",352,1,1,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,14,22,5.9,"PAH",352,1,2,0)="==========================================="
^DIC(9.4,14,22,5.9,"PAH",352,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",352,1,4,0)="1. INC17480746 Frequent M Errors at multiple sites: LST^LR7OSMZ2"
^DIC(9.4,14,22,5.9,"PAH",352,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",352,1,6,0)="   Problem:"
^DIC(9.4,14,22,5.9,"PAH",352,1,7,0)="   -------"
^DIC(9.4,14,22,5.9,"PAH",352,1,8,0)="   We are seeing errors in LST^LR7OSMZ2 at multiple sites due to "
^DIC(9.4,14,22,5.9,"PAH",352,1,9,0)="   Corrupted Organism nodes in the MI section of the ^LR global. "
^DIC(9.4,14,22,5.9,"PAH",352,1,10,0)="   Two errors are recurring and preventing microbiology reports"
^DIC(9.4,14,22,5.9,"PAH",352,1,11,0)="   from being generated:"
^DIC(9.4,14,22,5.9,"PAH",352,1,12,0)="   - If the zero node is missing in this sub-file, an undefined "
^DIC(9.4,14,22,5.9,"PAH",352,1,13,0)="     error occurs in LST+3."
^DIC(9.4,14,22,5.9,"PAH",352,1,14,0)="   - If the organism pointer to file #61.2 is null in the first "
^DIC(9.4,14,22,5.9,"PAH",352,1,15,0)="     piece of the zero node, a subscript error occurs at the end "
^DIC(9.4,14,22,5.9,"PAH",352,1,16,0)="     of LST+4"
^DIC(9.4,14,22,5.9,"PAH",352,1,17,0)=" "
^DIC(9.4,14,22,5.9,"PAH",352,1,18,0)="   Resolution:"
^DIC(9.4,14,22,5.9,"PAH",352,1,19,0)="   ----------"
^DIC(9.4,14,22,5.9,"PAH",352,1,20,0)="   For sites to be able to find and report Corrupted Organism nodes "
^DIC(9.4,14,22,5.9,"PAH",352,1,21,0)="   to their regional support group, an update to the nightly LAB "
^DIC(9.4,14,22,5.9,"PAH",352,1,22,0)="   Cleanup routine is implemented.  This update will search for "
^DIC(9.4,14,22,5.9,"PAH",352,1,23,0)="   Corrupted Organism nodes and send a mailman message to the LMI "
^DIC(9.4,14,22,5.9,"PAH",352,1,24,0)="   mailman group."
^DIC(9.4,14,22,5.9,"PAH",353,0)="550^3211004.135404^17"
^DIC(9.4,14,22,5.9,"PAH",353,1,0)="^^2^2^3211004"
^DIC(9.4,14,22,5.9,"PAH",353,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,14,22,5.9,"PAH",353,1,2,0)="included in this patch."
^DIC(9.4,14,22,5.9,"PAH",354,0)="547 SEQ #451^3211012.113106^17"
^DIC(9.4,14,22,5.9,"PAH",354,1,0)="^^14^14^3211012"
^DIC(9.4,14,22,5.9,"PAH",354,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,14,22,5.9,"PAH",354,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",354,1,3,0)="1. Laboratory users may not be aware that accessing a previously verified "
^DIC(9.4,14,22,5.9,"PAH",354,1,4,0)="   accession in Microbiology results entry causes the ""RPT DATE APPROVED"" "
^DIC(9.4,14,22,5.9,"PAH",354,1,5,0)="   field to be removed. If the users exit without entering a new ""RPT DATE"
^DIC(9.4,14,22,5.9,"PAH",354,1,6,0)="   APPROVED"", the results are not viewable in CPRS. "
^DIC(9.4,14,22,5.9,"PAH",354,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",354,1,8,0)="2. It has been causing confusion for physicians and other users when a "
^DIC(9.4,14,22,5.9,"PAH",354,1,9,0)="   Microbiology report previously contained results but is now not"
^DIC(9.4,14,22,5.9,"PAH",354,1,10,0)="   displaying any results during the time that the Laboratory is editing"
^DIC(9.4,14,22,5.9,"PAH",354,1,11,0)="   the results. "
^DIC(9.4,14,22,5.9,"PAH",354,1,12,0)=" "
^DIC(9.4,14,22,5.9,"PAH",354,1,13,0)="3. This patch also includes a documentation update for another issue."
^DIC(9.4,14,22,5.9,"PAH",354,1,14,0)="   No code changes are required for that issue."
^DIC(9.4,14,22,5.9,"PAH",355,0)="552 SEQ #452^3220301.144912^84"
^DIC(9.4,14,22,5.9,"PAH",355,1,0)="^^13^13^3220301"
^DIC(9.4,14,22,5.9,"PAH",355,1,1,0)="This patch addresses the following issues:"
^DIC(9.4,14,22,5.9,"PAH",355,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",355,1,3,0)="1. Non-numeric data entries may be defined as minimum and maximum values"
^DIC(9.4,14,22,5.9,"PAH",355,1,4,0)="   as well as number of decimal places for numeric data names."
^DIC(9.4,14,22,5.9,"PAH",355,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",355,1,6,0)="2. An error might occur during generation of the Epidemiology report if"
^DIC(9.4,14,22,5.9,"PAH",355,1,7,0)="   the LAB OOS encounter is edited for the addition of one or more CPT"
^DIC(9.4,14,22,5.9,"PAH",355,1,8,0)="   codes. In addition, a logic error was found during testing of this "
^DIC(9.4,14,22,5.9,"PAH",355,1,9,0)="   patch for the date range being searched."
^DIC(9.4,14,22,5.9,"PAH",355,1,10,0)="    "
^DIC(9.4,14,22,5.9,"PAH",355,1,11,0)="3. Accessions which roll over from the previous day to ""today"" will not "
^DIC(9.4,14,22,5.9,"PAH",355,1,12,0)="   build to a Load/Worklist if the HOLD-OVER SORT URGENCY (#300) field in "
^DIC(9.4,14,22,5.9,"PAH",355,1,13,0)="   the LABORATORY SITE (#69.9) file is defined as ""zero""."
^DIC(9.4,14,22,5.9,"PAH",356,0)="554 SEQ #453^3220329.141259^86"
^DIC(9.4,14,22,5.9,"PAH",356,1,0)="^^56^56^3220329"
^DIC(9.4,14,22,5.9,"PAH",356,1,1,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,14,22,5.9,"PAH",356,1,2,0)="==========================================="
^DIC(9.4,14,22,5.9,"PAH",356,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",356,1,4,0)="1.      INC20231002 - CTX Incorrect Information in VistA Track Collection"
^DIC(9.4,14,22,5.9,"PAH",356,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",356,1,6,0)="   Problem:"
^DIC(9.4,14,22,5.9,"PAH",356,1,7,0)="   -------"
^DIC(9.4,14,22,5.9,"PAH",356,1,8,0)="Incorrect information is being populated in the VistA Track Collection on "
^DIC(9.4,14,22,5.9,"PAH",356,1,9,0)="several patients. It is displaying incorrect information for the WALK-UP "
^DIC(9.4,14,22,5.9,"PAH",356,1,10,0)="SCAN TIME, TIME SPECIMEN COLLECTED and TIME SCANED INTO LAB from "
^DIC(9.4,14,22,5.9,"PAH",356,1,11,0)="approximately 10 years ago. Entries in the HOWDY SPECIMEN TIMES BY UID "
^DIC(9.4,14,22,5.9,"PAH",356,1,12,0)="file #69.87 are never deleted. After 10 years, when lab accessions (UIDs) "
^DIC(9.4,14,22,5.9,"PAH",356,1,13,0)="are no longer unique, data for current UIDs can no longer be added to "
^DIC(9.4,14,22,5.9,"PAH",356,1,14,0)="file #69.87, because the software checks for the presence of the UID and "
^DIC(9.4,14,22,5.9,"PAH",356,1,15,0)="does not allow duplicates."
^DIC(9.4,14,22,5.9,"PAH",356,1,16,0)=" "
^DIC(9.4,14,22,5.9,"PAH",356,1,17,0)="The site that reported the issue is using the option LRHY TRACK "
^DIC(9.4,14,22,5.9,"PAH",356,1,18,0)="COLLECTION to produce a report of patient specimens collected via Howdy. "
^DIC(9.4,14,22,5.9,"PAH",356,1,19,0)="That report retrieves data from the HOWDY SPECIMEN TIMES BY UID file "
^DIC(9.4,14,22,5.9,"PAH",356,1,20,0)="(#69.87). The site gave several examples of accessions (UIDs) that are "
^DIC(9.4,14,22,5.9,"PAH",356,1,21,0)="showing data from 2011. Lab accession numbers (UIDs) are only unique for "
^DIC(9.4,14,22,5.9,"PAH",356,1,22,0)="10 years. Many of the entries in this site's file #69.87 are > 9 years "
^DIC(9.4,14,22,5.9,"PAH",356,1,23,0)="old, and thus have UIDs that are no longer unique and are the source of "
^DIC(9.4,14,22,5.9,"PAH",356,1,24,0)="this data error on the report."
^DIC(9.4,14,22,5.9,"PAH",356,1,25,0)=" "
^DIC(9.4,14,22,5.9,"PAH",356,1,26,0)="The option that creates the entries in file #69.87 is LRHY PHLEBOTOMY "
^DIC(9.4,14,22,5.9,"PAH",356,1,27,0)="LOG. The routine for that option checks to see if the UID entered in the "
^DIC(9.4,14,22,5.9,"PAH",356,1,28,0)="option is already in file #69.87. If it is, the option does not add the "
^DIC(9.4,14,22,5.9,"PAH",356,1,29,0)="UID to the file again. Because the only UID from 10 years ago is in the "
^DIC(9.4,14,22,5.9,"PAH",356,1,30,0)="file, the current UID cannot be added, and this is the real source of the "
^DIC(9.4,14,22,5.9,"PAH",356,1,31,0)="problem."
^DIC(9.4,14,22,5.9,"PAH",356,1,32,0)=" "
^DIC(9.4,14,22,5.9,"PAH",356,1,33,0)="There should really be a utility added, perhaps called from LRNIGHT, that "
^DIC(9.4,14,22,5.9,"PAH",356,1,34,0)="checks file #69.87 for entries >9 years old and deletes those entries "
^DIC(9.4,14,22,5.9,"PAH",356,1,35,0)="from the file. Note that this will eventually affect all VA sites that "
^DIC(9.4,14,22,5.9,"PAH",356,1,36,0)="use Howdy, and specifically those that use the LRHY PHLEBOTOMY LOG option."
^DIC(9.4,14,22,5.9,"PAH",356,1,37,0)=" "
^DIC(9.4,14,22,5.9,"PAH",356,1,38,0)=" "
^DIC(9.4,14,22,5.9,"PAH",356,1,39,0)="   Resolution:"
^DIC(9.4,14,22,5.9,"PAH",356,1,40,0)="   ----------"
^DIC(9.4,14,22,5.9,"PAH",356,1,41,0)="Logic is added to the NIGHTLY LAB CLEANUP process.  The routine LRNIGHT "
^DIC(9.4,14,22,5.9,"PAH",356,1,42,0)="will run LRHOWDY^LRWU9A in the background.  LRHOWDY^LRWU9A will delete "
^DIC(9.4,14,22,5.9,"PAH",356,1,43,0)="records that are more than 9 years old from file #69.87."
^DIC(9.4,14,22,5.9,"PAH",356,1,44,0)=" "
^DIC(9.4,14,22,5.9,"PAH",356,1,45,0)=" "
^DIC(9.4,14,22,5.9,"PAH",356,1,46,0)="   Technical Resolution:"
^DIC(9.4,14,22,5.9,"PAH",356,1,47,0)="   ---------------------"
^DIC(9.4,14,22,5.9,"PAH",356,1,48,0)="Within the SUBTASKS section of routine LRNIGHT, code is added to job off "
^DIC(9.4,14,22,5.9,"PAH",356,1,49,0)="LRHOWDY^LRWU9A to background processing.  "
^DIC(9.4,14,22,5.9,"PAH",356,1,50,0)=" "
^DIC(9.4,14,22,5.9,"PAH",356,1,51,0)="Entry point LRHOWDY is added to routine LRWU9A. "
^DIC(9.4,14,22,5.9,"PAH",356,1,52,0)=" "
^DIC(9.4,14,22,5.9,"PAH",356,1,53,0)="LRHOWDY loops through the SCAN index of file #69.87 and deletes records "
^DIC(9.4,14,22,5.9,"PAH",356,1,54,0)="that are greater than 9 years old, time is not considered so a record "
^DIC(9.4,14,22,5.9,"PAH",356,1,55,0)="that was scanned anytime today exactly 9 years ago is not deleted, the "
^DIC(9.4,14,22,5.9,"PAH",356,1,56,0)="record must have been scanned over 9 years ago to be purged."
^DIC(9.4,14,22,5.9,"PAH",357,0)="556^3220613.153134^86"
^DIC(9.4,14,22,5.9,"PAH",357,1,0)="^^2^2^3220613"
^DIC(9.4,14,22,5.9,"PAH",357,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,14,22,5.9,"PAH",357,1,2,0)="included in this patch."
^DIC(9.4,14,22,5.9,"PAH",358,0)="558 SEQ #455^3220616.113303^86"
^DIC(9.4,14,22,5.9,"PAH",358,1,0)="^^7^7^3220616"
^DIC(9.4,14,22,5.9,"PAH",358,1,1,0)="The patch addresses one (1) issue: "
^DIC(9.4,14,22,5.9,"PAH",358,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",358,1,3,0)="1. When using the Lab liaison menu option Add a new data name "
^DIC(9.4,14,22,5.9,"PAH",358,1,4,0)="   [LRWU5] or Modify an existing data name [LRWU6], one cannot enter a"
^DIC(9.4,14,22,5.9,"PAH",358,1,5,0)="   value less than one (1) at the Minimum value query. It displays the"
^DIC(9.4,14,22,5.9,"PAH",358,1,6,0)="   Help text (The smallest result value) and represents the Minimum value"
^DIC(9.4,14,22,5.9,"PAH",358,1,7,0)="   query."
^DIC(9.4,14,22,5.9,"PAH",359,0)="557 SEQ #456^3220630.170653^86"
^DIC(9.4,14,22,5.9,"PAH",359,1,0)="^^6^6^3220630"
^DIC(9.4,14,22,5.9,"PAH",359,1,1,0)="This patch addresses the following issue:"
^DIC(9.4,14,22,5.9,"PAH",359,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",359,1,3,0)="If duplicate VBECS orders are ordered as ""Lab Collect"", the process of "
^DIC(9.4,14,22,5.9,"PAH",359,1,4,0)="rejecting the duplicate order in VBECS and completing the other order "
^DIC(9.4,14,22,5.9,"PAH",359,1,5,0)="will cause the completed order to not have a status of ""complete"" in "
^DIC(9.4,14,22,5.9,"PAH",359,1,6,0)="VistA and CPRS."
^DIC(9.4,14,22,5.9,"PAH",360,0)="555 SEQ #457^3220811.151502^86"
^DIC(9.4,14,22,5.9,"PAH",360,1,0)="^^8^8^3220811"
^DIC(9.4,14,22,5.9,"PAH",360,1,1,0)="The patch addresses one (1) issue: "
^DIC(9.4,14,22,5.9,"PAH",360,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",360,1,3,0)="1.      When using auto-verification and not releasing all tests on a "
^DIC(9.4,14,22,5.9,"PAH",360,1,4,0)="panel at the same time, the statement ""ALL COMPLETED"" Is not"
^DIC(9.4,14,22,5.9,"PAH",360,1,5,0)="DISPLAYED when using the LOOKUP ACCESSION option [LR LOOKUP "
^DIC(9.4,14,22,5.9,"PAH",360,1,6,0)="ACCESSION]. This omission does not happen if all results are"
^DIC(9.4,14,22,5.9,"PAH",360,1,7,0)="released at once, it is only a problem when some results are"
^DIC(9.4,14,22,5.9,"PAH",360,1,8,0)="auto verified and then the rest released at a later time."
^DIC(9.4,14,22,5.9,"PAH",361,0)="559 SEQ #458^3220915.154652^86"
^DIC(9.4,14,22,5.9,"PAH",361,1,0)="^^12^12^3220915"
^DIC(9.4,14,22,5.9,"PAH",361,1,1,0)="This patch addresses two issues:"
^DIC(9.4,14,22,5.9,"PAH",361,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",361,1,3,0)="1. An invalid ""seconds"" value for an accession's collection date/time "
^DIC(9.4,14,22,5.9,"PAH",361,1,4,0)="   might be stored when using option ""Accessioning tests ordered by ward "
^DIC(9.4,14,22,5.9,"PAH",361,1,5,0)="   order entry (LROE)"". This has caused problems downstream when "
^DIC(9.4,14,22,5.9,"PAH",361,1,6,0)="   transmitting information to Corporate Data Warehouse (CDW.). Research"
^DIC(9.4,14,22,5.9,"PAH",361,1,7,0)="   of the issue uncovered the fact that when used a certain way, the"
^DIC(9.4,14,22,5.9,"PAH",361,1,8,0)="   option will add ten seconds to the collection date/time entered by the"
^DIC(9.4,14,22,5.9,"PAH",361,1,9,0)="   user."
^DIC(9.4,14,22,5.9,"PAH",361,1,10,0)=" "
^DIC(9.4,14,22,5.9,"PAH",361,1,11,0)="2. The option ""Set a new starting accession number"" does not set a new "
^DIC(9.4,14,22,5.9,"PAH",361,1,12,0)="   starting number for monthly accession areas."
^DIC(9.4,14,22,5.9,"PAH",362,0)="553^3220920.221458^90"
^DIC(9.4,14,22,5.9,"PAH",363,0)="561 SEQ #460^3221122.083828^90"
^DIC(9.4,14,22,5.9,"PAH",363,1,0)="^^4^4^3221122"
^DIC(9.4,14,22,5.9,"PAH",363,1,1,0)="This patch addresses one issue:"
^DIC(9.4,14,22,5.9,"PAH",363,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",363,1,3,0)="A Microbiology result status might be marked as ""completed"" when it is "
^DIC(9.4,14,22,5.9,"PAH",363,1,4,0)="not complete."
^DIC(9.4,14,22,5.9,"PAH",364,0)="560^3230118.160814^89"
^DIC(9.4,14,22,5.9,"PAH",364,1,0)="^^2^2^3230118"
^DIC(9.4,14,22,5.9,"PAH",364,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,14,22,5.9,"PAH",364,1,2,0)="included in this patch."
^DIC(9.4,14,22,5.9,"PAH",365,0)="562 SEQ #462^3230523.10591^89"
^DIC(9.4,14,22,5.9,"PAH",365,1,0)="^^4^4^3230523"
^DIC(9.4,14,22,5.9,"PAH",365,1,1,0)="This patch addresses one issue:"
^DIC(9.4,14,22,5.9,"PAH",365,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",365,1,3,0)="A test might not display a status of ""Results received"" at a LEDI"
^DIC(9.4,14,22,5.9,"PAH",365,1,4,0)="collecting site after results have been received."
^DIC(9.4,14,22,5.9,"PAH",366,0)="563^3230817.125347^89"
^DIC(9.4,14,22,5.9,"PAH",366,1,0)="^^2^2^3230817"
^DIC(9.4,14,22,5.9,"PAH",366,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,14,22,5.9,"PAH",366,1,2,0)="included in this patch."
^DIC(9.4,14,22,5.9,"PAH",367,0)="565 SEQ #464^3230901.140835^89"
^DIC(9.4,14,22,5.9,"PAH",367,1,0)="^^9^9^3230901"
^DIC(9.4,14,22,5.9,"PAH",367,1,1,0)="This patch addresses two issues:"
^DIC(9.4,14,22,5.9,"PAH",367,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",367,1,3,0)="1. The entry for ""TRIMETHOPRIM/SULFAMETHOXAZOLE"" is incorrectly spelled as"
^DIC(9.4,14,22,5.9,"PAH",367,1,4,0)="   ""TRIMETHAPRIM/SULFAMETHOXAZOLE"" in the ORGANISM SUB-FIELD FILE (#63.3) "
^DIC(9.4,14,22,5.9,"PAH",367,1,5,0)="   file as well as in the ANTIMICROBIAL SUSCEPTIBILITY (#62.06) file."
^DIC(9.4,14,22,5.9,"PAH",367,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",367,1,7,0)="2. The Lookup Accession report will show an inaccurate status for a panel "
^DIC(9.4,14,22,5.9,"PAH",367,1,8,0)="   if the full accession is specified and if the panel was not partially"
^DIC(9.4,14,22,5.9,"PAH",367,1,9,0)="   verified on the original accession date."
^DIC(9.4,14,22,5.9,"PAH",368,0)="567^3240221.10012^89"
^DIC(9.4,14,22,5.9,"PAH",368,1,0)="^^2^2^3240221"
^DIC(9.4,14,22,5.9,"PAH",368,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,14,22,5.9,"PAH",368,1,2,0)="included in this patch."
^DIC(9.4,14,22,5.9,"PAH",369,0)="568 SEQ #467^3240506.120107^89"
^DIC(9.4,14,22,5.9,"PAH",369,1,0)="^^4^4^3240506"
^DIC(9.4,14,22,5.9,"PAH",369,1,1,0)="This patch along with LA*5.2*104 addresses one issue:"
^DIC(9.4,14,22,5.9,"PAH",369,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",369,1,3,0)="VistA Laboratory (POC) Point of Care interface logic might incorrectly "
^DIC(9.4,14,22,5.9,"PAH",369,1,4,0)="determine the reporting facility for POC results."
^DIC(9.4,14,22,5.9,"PAH",370,0)="569^3240726.104346^89"
^DIC(9.4,14,22,5.9,"PAH",370,1,0)="^^8^8^3240726"
^DIC(9.4,14,22,5.9,"PAH",370,1,1,0)="Multidivisional sites have requested the ability to fine-tune the list of "
^DIC(9.4,14,22,5.9,"PAH",370,1,2,0)="orderable lab tests displayed to a user. This patch adds a flag field to "
^DIC(9.4,14,22,5.9,"PAH",370,1,3,0)="the ACCESSION AREA multiple-valued field (#6) in the LABORATORY TEST file "
^DIC(9.4,14,22,5.9,"PAH",370,1,4,0)="(#60) that when set for an accession area at a site, will block users "
^DIC(9.4,14,22,5.9,"PAH",370,1,5,0)="signed in to that site from seeing that test in the list of orderable "
^DIC(9.4,14,22,5.9,"PAH",370,1,6,0)="items."
^DIC(9.4,14,22,5.9,"PAH",370,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",370,1,8,0)="Refer to the patch description for full details."
^DIC(9.4,14,22,5.9,"PAH",371,0)="566 SEQ #469^3240808.172714^89"
^DIC(9.4,14,22,5.9,"PAH",371,1,0)="^^10^10^3240808"
^DIC(9.4,14,22,5.9,"PAH",371,1,1,0)="This patch addresses three issues:"
^DIC(9.4,14,22,5.9,"PAH",371,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",371,1,3,0)="1. The status in CPRS might be incorrect for one or more tests if"
^DIC(9.4,14,22,5.9,"PAH",371,1,4,0)="   accessions were merged."
^DIC(9.4,14,22,5.9,"PAH",371,1,5,0)=" "
^DIC(9.4,14,22,5.9,"PAH",371,1,6,0)="2. The Incomplete test status report (LRWRKINC) might display inaccurate "
^DIC(9.4,14,22,5.9,"PAH",371,1,7,0)="   information if the user specified a past date instead of today."
^DIC(9.4,14,22,5.9,"PAH",371,1,8,0)=" "
^DIC(9.4,14,22,5.9,"PAH",371,1,9,0)="3. When merging is performed on an Emergency Room patient's accessions "
^DIC(9.4,14,22,5.9,"PAH",371,1,10,0)="   which contain at least one profile, an error might occur."
^DIC(9.4,14,22,5.9,"PAH",372,0)="571^3240808.17333^89"
^DIC(9.4,14,22,5.9,"PAH",372,1,0)="^^2^2^3240808"
^DIC(9.4,14,22,5.9,"PAH",372,1,1,0)="Please see the National Patch Module for details of the enhancements"
^DIC(9.4,14,22,5.9,"PAH",372,1,2,0)="included in this patch."
^DIC(9.4,14,22,5.9,"PAH",373,0)="572 SEQ #471^3240930.180233^89"
^DIC(9.4,14,22,5.9,"PAH",373,1,0)="^^2^2^3240930"
^DIC(9.4,14,22,5.9,"PAH",373,1,1,0)="1. INC31264131 - Option LROS (Order/test status) Report Issue with "
^DIC(9.4,14,22,5.9,"PAH",373,1,2,0)="                 Partially Verified."
^DIC(9.4,14,22,5.9,"PAH",374,0)="573 SEQ #472^3241030.123612^89"
^DIC(9.4,14,22,5.9,"PAH",374,1,0)="^^13^13^3241030"
^DIC(9.4,14,22,5.9,"PAH",374,1,1,0)="The patch addresses one (1) issue: "
^DIC(9.4,14,22,5.9,"PAH",374,1,2,0)=" "
^DIC(9.4,14,22,5.9,"PAH",374,1,3,0)="1.      In certain situations, tests that are showing as collected do not "
^DIC(9.4,14,22,5.9,"PAH",374,1,4,0)="have an accession number.  This happens when the user that accessions the "
^DIC(9.4,14,22,5.9,"PAH",374,1,5,0)="test is logged into a division that is not defined in the LAB TEST FILE "
^DIC(9.4,14,22,5.9,"PAH",374,1,6,0)="(#60) for that test with an ACCESSION AREA. When the user uses the option "
^DIC(9.4,14,22,5.9,"PAH",374,1,7,0)="Accession tests ordered by ward order entry [LROE] there is a message "
^DIC(9.4,14,22,5.9,"PAH",374,1,8,0)="that displays, but it is easily missed by the user causing lab tests to "
^DIC(9.4,14,22,5.9,"PAH",374,1,9,0)="be presumed accessioned by the provider when the lab does not know that "
^DIC(9.4,14,22,5.9,"PAH",374,1,10,0)="the order still needs to be collected and processed."
^DIC(9.4,14,22,5.9,"PAH",374,1,11,0)=" "
^DIC(9.4,14,22,5.9,"PAH",374,1,12,0)="When the order is accessioned by Howdy, no error message is displayed on "
^DIC(9.4,14,22,5.9,"PAH",374,1,13,0)="the screen and there is no way for the lab to know the order was needed."
^DIC(9.4,14,22,5.9,"PAH",375,0)="574 SEQ #473^3241115.143256^89"
^DIC(9.4,14,22,5.9,"PAH",375,1,0)="^^2^2^3241115"
^DIC(9.4,14,22,5.9,"PAH",375,1,1,0)="Please review FORUM's Patch Module description and installation "
^DIC(9.4,14,22,5.9,"PAH",375,1,2,0)="instructions before installing this patch."
