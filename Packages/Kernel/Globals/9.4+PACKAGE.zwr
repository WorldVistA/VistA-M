^DIC(9.4,59,22,5,"PAH",231,0)="108 SEQ #231^3100518.152332^17"
^DIC(9.4,59,22,5,"PAH",231,1,0)="^^17^17^3100518"
^DIC(9.4,59,22,5,"PAH",231,1,1,0)="In preparation for printing FDA Medication Guides, this patch adds a new"
^DIC(9.4,59,22,5,"PAH",231,1,2,0)="field, FDA MED GUIDE (#100) to the VA PRODUCT FILE (#50.68)."
^DIC(9.4,59,22,5,"PAH",231,1,3,0)="This patch does not enter data into this field.  Data is entered into this"
^DIC(9.4,59,22,5,"PAH",231,1,4,0)="field as part of the monthly NDF Data Update patches. "
^DIC(9.4,59,22,5,"PAH",231,1,5,0)=" "
^DIC(9.4,59,22,5,"PAH",231,1,6,0)="This patch also adds a new option, Display FDA Medication Guide"
^DIC(9.4,59,22,5,"PAH",231,1,7,0)="[PSN MED GUIDE], to the National Drug File Menu [PSNMGR]."
^DIC(9.4,59,22,5,"PAH",231,1,8,0)=" "
^DIC(9.4,59,22,5,"PAH",231,1,9,0)="This patch also creates a new application programmer interface (API) for the"
^DIC(9.4,59,22,5,"PAH",231,1,10,0)="National Drug File application (NDF) to return an FDA Medication Guide link."
^DIC(9.4,59,22,5,"PAH",231,1,11,0)="The call is S <variable>=$$FDAMG^PSNAPIS(ien)."
^DIC(9.4,59,22,5,"PAH",231,1,12,0)=" "
^DIC(9.4,59,22,5,"PAH",231,1,13,0)="This patch also provides a new Remote Procedure Call that will be used by"
^DIC(9.4,59,22,5,"PAH",231,1,14,0)="subsequent Outpatient Pharmacy and NDF functions to display FDA Medication"
^DIC(9.4,59,22,5,"PAH",231,1,15,0)="Guides.  The functions to utilize the new RPC will be provided in patches"
^DIC(9.4,59,22,5,"PAH",231,1,16,0)="planned for release at a later date.  The RPC is named"
^DIC(9.4,59,22,5,"PAH",231,1,17,0)="PSN FDA MED GUIDE PRINT QUEUE."
^DIC(9.4,59,22,5,"PAH",232,0)="241^3100526.095514^17"
^DIC(9.4,59,22,5,"PAH",232,1,0)="^^16^16^3100526"
