^DIC(9.4,11,22,5.03,"PAH",34,1,66,0)="Northern Indiana HCS (610) (medium) (integrated) "
^DIC(9.4,11,22,5.03,"PAH",34,1,67,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,68,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,69,0)="ROUTINE SUMMARY"
^DIC(9.4,11,22,5.03,"PAH",34,1,70,0)="==============="
^DIC(9.4,11,22,5.03,"PAH",34,1,71,0)="  The following routines are included in this patch.  The second line"
^DIC(9.4,11,22,5.03,"PAH",34,1,72,0)="  of each of these routines now looks like:"
^DIC(9.4,11,22,5.03,"PAH",34,1,73,0)="  <tab> ;;5.2;AUTOMATED LAB INSTRUMENTS;<patchlist>;Sep 27, 1994"
^DIC(9.4,11,22,5.03,"PAH",34,1,74,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,75,0)="                  Checksum       Checksum"
^DIC(9.4,11,22,5.03,"PAH",34,1,76,0)=" Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,11,22,5.03,"PAH",34,1,77,0)="     LA7VIN5A     9628469        9655113        46,64,67,72"
^DIC(9.4,11,22,5.03,"PAH",34,1,78,0)="     LA72         N/A            4388949        72 (D)"
^DIC(9.4,11,22,5.03,"PAH",34,1,79,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,80,0)="     (D) -- Routine deleted by KIDS after installation"
^DIC(9.4,11,22,5.03,"PAH",34,1,81,0)="     List of preceding patches: 67"
^DIC(9.4,11,22,5.03,"PAH",34,1,82,0)="     Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,11,22,5.03,"PAH",34,1,83,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,84,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,85,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,11,22,5.03,"PAH",34,1,86,0)="========================="
^DIC(9.4,11,22,5.03,"PAH",34,1,87,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,88,0)="  The install time for this patch is less than 2 minutes.  This patch"
^DIC(9.4,11,22,5.03,"PAH",34,1,89,0)="  should be installed when Laboratory users are off the system."
^DIC(9.4,11,22,5.03,"PAH",34,1,90,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,91,0)="  Suggested time to install: non-peak requirement hours."
^DIC(9.4,11,22,5.03,"PAH",34,1,92,0)="  The installation should NOT be queued."
^DIC(9.4,11,22,5.03,"PAH",34,1,93,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,94,0)="  NOTE: Kernel patches must be current on the target system to avoid"
^DIC(9.4,11,22,5.03,"PAH",34,1,95,0)="        problems loading and/or installing this patch."
^DIC(9.4,11,22,5.03,"PAH",34,1,96,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,97,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,11,22,5.03,"PAH",34,1,98,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,11,22,5.03,"PAH",34,1,99,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,100,0)="  1.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,11,22,5.03,"PAH",34,1,101,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,11,22,5.03,"PAH",34,1,102,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,103,0)="  2.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,11,22,5.03,"PAH",34,1,104,0)="      select the 'Installation' menu."
^DIC(9.4,11,22,5.03,"PAH",34,1,105,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,106,0)="  3.  Use the 'Verify Checksum in Transport Global' option and verify"
^DIC(9.4,11,22,5.03,"PAH",34,1,107,0)="      that all routines have the correct checksums."
^DIC(9.4,11,22,5.03,"PAH",34,1,108,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,109,0)="  4.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,11,22,5.03,"PAH",34,1,110,0)="      options:"
^DIC(9.4,11,22,5.03,"PAH",34,1,111,0)="        Print Transport Global"
^DIC(9.4,11,22,5.03,"PAH",34,1,112,0)="        Compare Transport Global to Current System"
^DIC(9.4,11,22,5.03,"PAH",34,1,113,0)="        Backup a Transport Global"
^DIC(9.4,11,22,5.03,"PAH",34,1,114,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,115,0)="  5.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,11,22,5.03,"PAH",34,1,116,0)="      and select the package 'LA*5.2*72'"
^DIC(9.4,11,22,5.03,"PAH",34,1,117,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,118,0)="      When prompted"
^DIC(9.4,11,22,5.03,"PAH",34,1,119,0)="        'Want KIDS to Rebuild Menu Trees Upon Completion of Install?' "
^DIC(9.4,11,22,5.03,"PAH",34,1,120,0)="      choose 'NO'.  Note: Responding ""Yes"" to the prompt for rebuilding"
^DIC(9.4,11,22,5.03,"PAH",34,1,121,0)="      menu trees can significantly increase install time."
^DIC(9.4,11,22,5.03,"PAH",34,1,122,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,123,0)="      When prompted "
^DIC(9.4,11,22,5.03,"PAH",34,1,124,0)="         'Want KIDS to INHIBIT LOGONs during the install? "
^DIC(9.4,11,22,5.03,"PAH",34,1,125,0)="      choose 'NO'."
^DIC(9.4,11,22,5.03,"PAH",34,1,126,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,127,0)="      When prompted "
^DIC(9.4,11,22,5.03,"PAH",34,1,128,0)="          'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,11,22,5.03,"PAH",34,1,129,0)="           Protocols?  YES//'"
^DIC(9.4,11,22,5.03,"PAH",34,1,130,0)="      choose 'NO' unless site has additional local laboratory  "
^DIC(9.4,11,22,5.03,"PAH",34,1,131,0)="      options that should be disabled during install."
^DIC(9.4,11,22,5.03,"PAH",34,1,132,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,133,0)=" "
^DIC(9.4,11,22,5.03,"PAH",34,1,134,0)=" "
