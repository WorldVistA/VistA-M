^DIC(9.4,3,22,21,"PAH",64,1,110,0)="NOTE:  the ""<=="" represent comments made by the author and are not part of the "
^DIC(9.4,3,22,21,"PAH",64,1,111,0)="captures."
^DIC(9.4,3,22,21,"PAH",64,1,112,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,113,0)="FIGURE 1:  Using FM, a protocol, ZZKYLE MENU 1, is displayed with four "
^DIC(9.4,3,22,21,"PAH",64,1,114,0)="protocols (ITEMs) attached."
^DIC(9.4,3,22,21,"PAH",64,1,115,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,116,0)="NXT,KDE>D P^DI"
^DIC(9.4,3,22,21,"PAH",64,1,117,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,118,0)="VA FileMan 21.0"
^DIC(9.4,3,22,21,"PAH",64,1,119,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,120,0)="Select OPTION: 5  INQUIRE TO FILE ENTRIES"
^DIC(9.4,3,22,21,"PAH",64,1,121,0)="OUTPUT FROM WHAT FILE: PROTOCOL// "
^DIC(9.4,3,22,21,"PAH",64,1,122,0)="Select PROTOCOL NAME: ZZKYLE MENU 1          ItemText      "
^DIC(9.4,3,22,21,"PAH",64,1,123,0)="ANOTHER ONE: "
^DIC(9.4,3,22,21,"PAH",64,1,124,0)="STANDARD CAPTIONED OUTPUT? Yes//   (Yes)"
^DIC(9.4,3,22,21,"PAH",64,1,125,0)="Include COMPUTED fields:  (N/Y/R/B): NO//  - No record number (IEN), no "
^DIC(9.4,3,22,21,"PAH",64,1,126,0)="Computed Fields"
^DIC(9.4,3,22,21,"PAH",64,1,127,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,128,0)="NAME: ZZKYLE MENU 1                     ITEM TEXT: ItemText"
^DIC(9.4,3,22,21,"PAH",64,1,129,0)="  TYPE: menu                            CREATOR: DIMICELI,RON"
^DIC(9.4,3,22,21,"PAH",64,1,130,0)="  PACKAGE: 283                          COLUMN WIDTH: 26"
^DIC(9.4,3,22,21,"PAH",64,1,131,0)="  MNEMONIC WIDTH: 4"
^DIC(9.4,3,22,21,"PAH",64,1,132,0)="ITEM: ZZKYLE ACTION 1                   MNEMONIC: ZZ    <== 1st Item"
^DIC(9.4,3,22,21,"PAH",64,1,133,0)="  SEQUENCE: 1"
^DIC(9.4,3,22,21,"PAH",64,1,134,0)="ITEM: ZZKYLE ACTION 2                                   <== 2nd Item"
^DIC(9.4,3,22,21,"PAH",64,1,135,0)="ITEM: ZZKYLE ACTION 3                                   <== 3rd Item"
^DIC(9.4,3,22,21,"PAH",64,1,136,0)="ITEM: ZZKYLE ACTION 4                                   <== 4th Item"
^DIC(9.4,3,22,21,"PAH",64,1,137,0)="  HEADER: D SHOW^VALM                   MENU PROMPT: Select ZZ Action:"
^DIC(9.4,3,22,21,"PAH",64,1,138,0)="  TIMESTAMP: 57379,39444"
^DIC(9.4,3,22,21,"PAH",64,1,139,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,140,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,141,0)="STEP 1: Review the Protocols that were identified above as having a protocol "
^DIC(9.4,3,22,21,"PAH",64,1,142,0)="deleted by a KIDS patch (i.e. PXCE ADD/EDIT MENU, DGPM MOVEMENT EVENTS, etc.)."
^DIC(9.4,3,22,21,"PAH",64,1,143,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,144,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,145,0)="FIGURE 2:  Here two protocols have been deleted, ZZKYLE ACTION 2 and ZZKYLE "
^DIC(9.4,3,22,21,"PAH",64,1,146,0)="ACTION 3, similar to the way a KIDS patch would have deleted them prior to "
^DIC(9.4,3,22,21,"PAH",64,1,147,0)="XU*8*68."
^DIC(9.4,3,22,21,"PAH",64,1,148,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,149,0)="NXT,KDE>D P^DI"
^DIC(9.4,3,22,21,"PAH",64,1,150,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,151,0)="VA FileMan 21.0"
^DIC(9.4,3,22,21,"PAH",64,1,152,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,153,0)="Select OPTION: 5  INQUIRE TO FILE ENTRIES"
^DIC(9.4,3,22,21,"PAH",64,1,154,0)="OUTPUT FROM WHAT FILE: PROTOCOL//  "
^DIC(9.4,3,22,21,"PAH",64,1,155,0)="Select PROTOCOL NAME:    ZZKYLE MENU 1        ItemText      "
^DIC(9.4,3,22,21,"PAH",64,1,156,0)="ANOTHER ONE: "
^DIC(9.4,3,22,21,"PAH",64,1,157,0)="STANDARD CAPTIONED OUTPUT? Yes//   (Yes)"
^DIC(9.4,3,22,21,"PAH",64,1,158,0)="Include COMPUTED fields:  (N/Y/R/B): NO//  - No record number (IEN), no "
^DIC(9.4,3,22,21,"PAH",64,1,159,0)="Computed Fields"
^DIC(9.4,3,22,21,"PAH",64,1,160,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,161,0)="NAME: ZZKYLE MENU 1                     ITEM TEXT: ItemText"
^DIC(9.4,3,22,21,"PAH",64,1,162,0)="  TYPE: menu                            CREATOR: DIMICELI,RON"
^DIC(9.4,3,22,21,"PAH",64,1,163,0)="  PACKAGE: 283                          COLUMN WIDTH: 26"
^DIC(9.4,3,22,21,"PAH",64,1,164,0)="  MNEMONIC WIDTH: 4"
^DIC(9.4,3,22,21,"PAH",64,1,165,0)="ITEM: ZZKYLE ACTION 1                   MNEMONIC: ZZ    <== 1st Item"
^DIC(9.4,3,22,21,"PAH",64,1,166,0)="  SEQUENCE: 1"
^DIC(9.4,3,22,21,"PAH",64,1,167,0)="ITEM: 194                                               <== Broken Pointer"
^DIC(9.4,3,22,21,"PAH",64,1,168,0)="ITEM: 195                                               <== Broken Pointer"
^DIC(9.4,3,22,21,"PAH",64,1,169,0)="ITEM: ZZKYLE ACTION 4                                   <== 4th Item"
^DIC(9.4,3,22,21,"PAH",64,1,170,0)="  HEADER: D SHOW^VALM                   MENU PROMPT: Select ZZ Action:"
^DIC(9.4,3,22,21,"PAH",64,1,171,0)="  TIMESTAMP: 57379,39444"
^DIC(9.4,3,22,21,"PAH",64,1,172,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,173,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,174,0)="STEP 2: Broken pointers can be easily identified because a numeric will appear "
^DIC(9.4,3,22,21,"PAH",64,1,175,0)="in the ITEM field.  The routine XQ3 (shown in figure 4) will clean these up.  "
^DIC(9.4,3,22,21,"PAH",64,1,176,0)="You must verify that the others actually should be connected to this protocol."
^DIC(9.4,3,22,21,"PAH",64,1,177,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,178,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,179,0)="FIGURE 3: Here a new protocol was created, ZZJACK.  However, the new protocol "
^DIC(9.4,3,22,21,"PAH",64,1,180,0)="was created in IEN 194, covering up the previous broken pointer."
^DIC(9.4,3,22,21,"PAH",64,1,181,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,182,0)="NXT,KDE>D P^DI"
^DIC(9.4,3,22,21,"PAH",64,1,183,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,184,0)="VA FileMan 21.0"
^DIC(9.4,3,22,21,"PAH",64,1,185,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,186,0)="Select OPTION: 5  INQUIRE TO FILE ENTRIES"
^DIC(9.4,3,22,21,"PAH",64,1,187,0)="OUTPUT FROM WHAT FILE: PROTOCOL// "
^DIC(9.4,3,22,21,"PAH",64,1,188,0)="Select PROTOCOL NAME: ZZKYLE MENU 1          ItemText      "
^DIC(9.4,3,22,21,"PAH",64,1,189,0)="ANOTHER ONE: "
^DIC(9.4,3,22,21,"PAH",64,1,190,0)="STANDARD CAPTIONED OUTPUT? Yes//   (Yes)"
^DIC(9.4,3,22,21,"PAH",64,1,191,0)="Include COMPUTED fields:  (N/Y/R/B): NO//  - No record number (IEN), no "
^DIC(9.4,3,22,21,"PAH",64,1,192,0)="Computed Fields"
^DIC(9.4,3,22,21,"PAH",64,1,193,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,194,0)="NAME: ZZKYLE MENU 1                     ITEM TEXT: ItemText"
^DIC(9.4,3,22,21,"PAH",64,1,195,0)="  TYPE: menu                            CREATOR: DIMICELI,RON"
^DIC(9.4,3,22,21,"PAH",64,1,196,0)="  PACKAGE: 283                          COLUMN WIDTH: 26"
^DIC(9.4,3,22,21,"PAH",64,1,197,0)="  MNEMONIC WIDTH: 4"
^DIC(9.4,3,22,21,"PAH",64,1,198,0)="ITEM: ZZKYLE ACTION 1                   MNEMONIC: ZZ    <== 1st Item"
^DIC(9.4,3,22,21,"PAH",64,1,199,0)="  SEQUENCE: 1"
^DIC(9.4,3,22,21,"PAH",64,1,200,0)="ITEM: ZZJACK                                            <== 2nd Item (Bogus)"
^DIC(9.4,3,22,21,"PAH",64,1,201,0)="ITEM: 195                                               <== Broken Pointer"
^DIC(9.4,3,22,21,"PAH",64,1,202,0)="ITEM: ZZKYLE ACTION 4                                   <== 4th Item"
^DIC(9.4,3,22,21,"PAH",64,1,203,0)="  HEADER: D SHOW^VALM                   MENU PROMPT: Select ZZ Action:"
^DIC(9.4,3,22,21,"PAH",64,1,204,0)="  TIMESTAMP: 57379,39444"
^DIC(9.4,3,22,21,"PAH",64,1,205,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,206,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,207,0)="STEP 3: In the above figure (Figure 3), it was verify that the 1st ITEM, "
^DIC(9.4,3,22,21,"PAH",64,1,208,0)="ZZKYLE ACTION 1, should be attached to this protocol.  The 2nd ITEM, ZZJACK, "
^DIC(9.4,3,22,21,"PAH",64,1,209,0)="is discovered to belong to a different protocol entry and should be removed "
^DIC(9.4,3,22,21,"PAH",64,1,210,0)="from this entry.  Use FM to manually remove it from the multiple attached to "
^DIC(9.4,3,22,21,"PAH",64,1,211,0)="this protocol (shown in figure 5).  The 3rd ITEM is broken and XQ3 will clean "
^DIC(9.4,3,22,21,"PAH",64,1,212,0)="it out (shown in figure 4).  The 4th ITEM is verified as valid."
^DIC(9.4,3,22,21,"PAH",64,1,213,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,214,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,215,0)="FIGURE 4: Execute ENASK^XQ3 setting ""%=2"" from programmers mode."
^DIC(9.4,3,22,21,"PAH",64,1,216,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,217,0)="NXT,KDE>S %=2 D ENASK^XQ3"
^DIC(9.4,3,22,21,"PAH",64,1,218,0)="Do you want to remove any 'Dangling Pointers' from your PROTOCOL File?  Y// Y"
^DIC(9.4,3,22,21,"PAH",64,1,219,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,220,0)="PLEASE WAIT while I check this out . . . "
^DIC(9.4,3,22,21,"PAH",64,1,221,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,222,0)="Option ZZKYLE MENU 1 points to missing option 195"
^DIC(9.4,3,22,21,"PAH",64,1,223,0)="Your PROTOCOL File is OK now (1 pointer fixed)."
^DIC(9.4,3,22,21,"PAH",64,1,224,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,225,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,226,0)="NXT,KDE>D P^DI"
^DIC(9.4,3,22,21,"PAH",64,1,227,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,228,0)="VA FileMan 21.0"
^DIC(9.4,3,22,21,"PAH",64,1,229,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,230,0)="Select OPTION: 5  INQUIRE TO FILE ENTRIES"
^DIC(9.4,3,22,21,"PAH",64,1,231,0)="OUTPUT FROM WHAT FILE: PROTOCOL// "
^DIC(9.4,3,22,21,"PAH",64,1,232,0)="Select PROTOCOL NAME:    ZZKYLE MENU 1        ItemText      "
^DIC(9.4,3,22,21,"PAH",64,1,233,0)="ANOTHER ONE: "
^DIC(9.4,3,22,21,"PAH",64,1,234,0)="STANDARD CAPTIONED OUTPUT? Yes//   (Yes)"
^DIC(9.4,3,22,21,"PAH",64,1,235,0)="Include COMPUTED fields:  (N/Y/R/B): NO//  - No record number (IEN), no "
^DIC(9.4,3,22,21,"PAH",64,1,236,0)="Computed Fields"
^DIC(9.4,3,22,21,"PAH",64,1,237,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,238,0)="NAME: ZZKYLE MENU 1                     ITEM TEXT: ItemText"
^DIC(9.4,3,22,21,"PAH",64,1,239,0)="  TYPE: menu                            CREATOR: DIMICELI,RON"
^DIC(9.4,3,22,21,"PAH",64,1,240,0)="  PACKAGE: 283                          COLUMN WIDTH: 26"
^DIC(9.4,3,22,21,"PAH",64,1,241,0)="  MNEMONIC WIDTH: 4"
^DIC(9.4,3,22,21,"PAH",64,1,242,0)="ITEM: ZZKYLE ACTION 1                   MNEMONIC: ZZ    <== 1st Item"
^DIC(9.4,3,22,21,"PAH",64,1,243,0)="  SEQUENCE: 1"
^DIC(9.4,3,22,21,"PAH",64,1,244,0)="ITEM: ZZJACK                                            <== 2nd Item (Bogus)"
^DIC(9.4,3,22,21,"PAH",64,1,245,0)="ITEM: ZZKYLE ACTION 4                                   <== 3rd Item (was 4th)"
^DIC(9.4,3,22,21,"PAH",64,1,246,0)="  HEADER: D SHOW^VALM                   MENU PROMPT: Select ZZ Action:"
^DIC(9.4,3,22,21,"PAH",64,1,247,0)="  TIMESTAMP: 57379,39444"
^DIC(9.4,3,22,21,"PAH",64,1,248,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,249,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,250,0)="FIGURE 5:  Use FM to remove the bogus protocol, ZZJACK."
^DIC(9.4,3,22,21,"PAH",64,1,251,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,252,0)="NXT,KDE>D P^DI"
^DIC(9.4,3,22,21,"PAH",64,1,253,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,254,0)="VA FileMan 21.0"
^DIC(9.4,3,22,21,"PAH",64,1,255,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,256,0)="Select OPTION: 1  ENTER OR EDIT FILE ENTRIES"
^DIC(9.4,3,22,21,"PAH",64,1,257,0)="INPUT TO WHAT FILE: PROTOCOL// "
^DIC(9.4,3,22,21,"PAH",64,1,258,0)="EDIT WHICH FIELD: ALL// 10  ITEM    (multiple)"
^DIC(9.4,3,22,21,"PAH",64,1,259,0)="   EDIT WHICH ITEM SUB-FIELD: ALL// .01  ITEM  "
^DIC(9.4,3,22,21,"PAH",64,1,260,0)="   THEN EDIT ITEM SUB-FIELD: "
^DIC(9.4,3,22,21,"PAH",64,1,261,0)="THEN EDIT FIELD: "
^DIC(9.4,3,22,21,"PAH",64,1,262,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,263,0)="Select PROTOCOL NAME: ZZKYLE MENU 1          ItemText      "
^DIC(9.4,3,22,21,"PAH",64,1,264,0)="Select ITEM: ZZKYLE ACTION 4// ZZJACK          BOGUS PROTOCOL ENTRY   "
^DIC(9.4,3,22,21,"PAH",64,1,265,0)="         ...OK? Yes//   (Yes)"
^DIC(9.4,3,22,21,"PAH",64,1,266,0)="  ITEM: ZZJACK// @"
^DIC(9.4,3,22,21,"PAH",64,1,267,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,268,0)="   SURE YOU WANT TO DELETE THE ENTIRE ITEM? Y  (Yes)"
^DIC(9.4,3,22,21,"PAH",64,1,269,0)=" "
^DIC(9.4,3,22,21,"PAH",64,1,270,0)="Select ITEM: "
^DIC(9.4,3,22,21,"PAH",64,1,271,0)=" "
