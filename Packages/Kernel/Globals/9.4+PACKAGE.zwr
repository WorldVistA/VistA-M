^DIC(9.4,175,22,2,"PAH",145,0)="215^3181004.162345^54"
^DIC(9.4,175,22,2,"PAH",145,1,0)="^^6^6^3181004"
^DIC(9.4,175,22,2,"PAH",145,1,1,0)="VistA Imaging Capture 215"
^DIC(9.4,175,22,2,"PAH",145,1,2,0)="This patch fixes 1 issue."
^DIC(9.4,175,22,2,"PAH",145,1,3,0)="In the Capture Application, when capturing images to Clinical"
^DIC(9.4,175,22,2,"PAH",145,1,4,0)="Procedures, sometimes an error will occur. The error message"
^DIC(9.4,175,22,2,"PAH",145,1,5,0)="states: Cannot focus an Invisible window."
^DIC(9.4,175,22,2,"PAH",145,1,6,0)="This issue is fixed. "
^DIC(9.4,175,22,2,"PAH",146,0)="214^3181102.152609^54"
^DIC(9.4,175,22,2,"PAH",146,1,0)="^^13^13^3181102"
^DIC(9.4,175,22,2,"PAH",146,1,1,0)="VistA Imaging Patch 214 - BackGround Processor (BP)"
^DIC(9.4,175,22,2,"PAH",146,1,2,0)="This patch fixes the following issues:"
^DIC(9.4,175,22,2,"PAH",146,1,3,0)="The BP gets stuck in a loop displaying the error message 'Can't"
^DIC(9.4,175,22,2,"PAH",146,1,4,0)="find file'.  the BP must be killed using TaskManager."
^DIC(9.4,175,22,2,"PAH",146,1,5,0)="The BP Site Parameter Window will not open.  the error message"
^DIC(9.4,175,22,2,"PAH",146,1,6,0)="is shown 'Value not Initialized'."
^DIC(9.4,175,22,2,"PAH",146,1,7,0)="The BP user is prompted to enter their PIV/PIN.  this should"
^DIC(9.4,175,22,2,"PAH",146,1,8,0)="not happen"
^DIC(9.4,175,22,2,"PAH",146,1,9,0)="The BP uses Kernel utilities to generate encrypted passwords.  "
^DIC(9.4,175,22,2,"PAH",146,1,10,0)="This patch will assure there are no 'spaces' in the generated"
^DIC(9.4,175,22,2,"PAH",146,1,11,0)="password."
^DIC(9.4,175,22,2,"PAH",146,1,12,0)="When Patch 214 KIDs is installed,  BP Client versions"
^DIC(9.4,175,22,2,"PAH",146,1,13,0)="135, 196, 198 and 214 will all be supported."
^DIC(9.4,175,22,2,"PAH",147,0)="216^3181102.15432^54"
^DIC(9.4,175,22,2,"PAH",147,1,0)="^^5^5^3181102"
^DIC(9.4,175,22,2,"PAH",147,1,1,0)="MAG*3.0*216"
^DIC(9.4,175,22,2,"PAH",147,1,2,0)="This patch fixes the Clinical Display Setup.exe that causes"
^DIC(9.4,175,22,2,"PAH",147,1,3,0)="the FBCS software to stop working after a Clinical Display "
^DIC(9.4,175,22,2,"PAH",147,1,4,0)="install."
^DIC(9.4,175,22,2,"PAH",147,1,5,0)="This will check the routines from a BUILD file."
^DIC(9.4,175,22,2,"PAH",148,0)="220^3181203.181236^54"
^DIC(9.4,175,22,2,"PAH",148,1,0)="^^8^8^3181203"
^DIC(9.4,175,22,2,"PAH",148,1,1,0)="VistA Imaging V3.0 - Patch 220 VistARAD Timestamp Issue"
^DIC(9.4,175,22,2,"PAH",148,1,2,0)="Routines:"
^DIC(9.4,175,22,2,"PAH",148,1,3,0)=" "
^DIC(9.4,175,22,2,"PAH",148,1,4,0)="MAGIP220"
^DIC(9.4,175,22,2,"PAH",148,1,5,0)="MAGJUTL2"
^DIC(9.4,175,22,2,"PAH",148,1,6,0)=" "
^DIC(9.4,175,22,2,"PAH",148,1,7,0)="Please note that routine MAGIP220 is deleted after the KIDS build is"
^DIC(9.4,175,22,2,"PAH",148,1,8,0)="installed."
^DIC(9.4,175,22,2,"PAH",149,0)="208^3190103.165349^54"
^DIC(9.4,175,22,2,"PAH",149,1,0)="^^15^15^3190103"
^DIC(9.4,175,22,2,"PAH",149,1,1,0)="Clinical Procedures and DICOM Consult Request Tracking."
^DIC(9.4,175,22,2,"PAH",149,1,2,0)=" "
^DIC(9.4,175,22,2,"PAH",149,1,3,0)="This patch and MD*1.0*60 work together to greatly imnprove"
^DIC(9.4,175,22,2,"PAH",149,1,4,0)="interoperability between Clinical Procedures and Vist Imaging"
^DIC(9.4,175,22,2,"PAH",149,1,5,0)="CPRS Consult Request Tracking DICOM."
^DIC(9.4,175,22,2,"PAH",149,1,6,0)=" "
^DIC(9.4,175,22,2,"PAH",149,1,7,0)="The CP studies have the same Instrument Order Number as the"
^DIC(9.4,175,22,2,"PAH",149,1,8,0)="regular consult and procedure Accession Number (sss-GMR-nnnnnnnn)."
^DIC(9.4,175,22,2,"PAH",149,1,9,0)=" "
^DIC(9.4,175,22,2,"PAH",149,1,10,0)="This allows DICOM objects created during a CP examination to be sent"
^DIC(9.4,175,22,2,"PAH",149,1,11,0)="to VistA Imaging and be processed automatically.  It also allows them"
^DIC(9.4,175,22,2,"PAH",149,1,12,0)="to be used with all of the other DICOM services, like query/retrieve"
^DIC(9.4,175,22,2,"PAH",149,1,13,0)="and export."
^DIC(9.4,175,22,2,"PAH",149,1,14,0)=" "
^DIC(9.4,175,22,2,"PAH",149,1,15,0)="Reports in DICOM Encapsulated PDF are highly recommended."
^DIC(9.4,175,22,2,"PAH",150,0)="194^3190103.165725^54"
^DIC(9.4,175,22,2,"PAH",150,1,0)="^^10^10^3190103"
^DIC(9.4,175,22,2,"PAH",150,1,1,0)="VistA Imaging V3.0 - Patch 194 - Duplicate Rad Order Defect"
