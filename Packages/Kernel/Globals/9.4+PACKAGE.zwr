^DIC(9.4,48,22,5.28,"PAH",666,1,1,0)="Stop Codes to be updated in accordance with the MCAO FY24 (April 2024) "
^DIC(9.4,48,22,5.28,"PAH",666,1,2,0)="Updates: "
^DIC(9.4,48,22,5.28,"PAH",666,1,3,0)=" "
^DIC(9.4,48,22,5.28,"PAH",666,1,4,0)="Stop Code 355 - Headache Center of Excellence (HCoE) is in the SD TELE"
^DIC(9.4,48,22,5.28,"PAH",666,1,5,0)="HEALTH STOP CODE FILE file (#40.6)."
^DIC(9.4,48,22,5.28,"PAH",666,1,6,0)=" "
