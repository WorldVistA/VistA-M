^DIC(9.4,147,5)="SALT LAKE CITY"
^DIC(9.4,147,7)="^^I"
^DIC(9.4,147,9)="^"
^DIC(9.4,147,11)="791810^791813"
^DIC(9.4,147,14,0)="^9.4014^1^1"
^DIC(9.4,147,14,1,0)="RMPJ"
