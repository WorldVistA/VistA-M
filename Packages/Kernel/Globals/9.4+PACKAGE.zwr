^DIC(9.4,11,22,5.03,"PAH",31,1,176,0)=" The files listed above may be obtained via FTP.  The preferred method is"
^DIC(9.4,11,22,5.03,"PAH",31,1,177,0)=" to FTP the files from:"
^DIC(9.4,11,22,5.03,"PAH",31,1,178,0)=" "
^DIC(9.4,11,22,5.03,"PAH",31,1,179,0)="    download.vista.domain.ext"
^DIC(9.4,11,22,5.03,"PAH",31,1,180,0)=" "
^DIC(9.4,11,22,5.03,"PAH",31,1,181,0)=" This transmits the files from the first available FTP server.  Sites may"
^DIC(9.4,11,22,5.03,"PAH",31,1,182,0)=" also elect to retrieve software directly from a specific server as"
^DIC(9.4,11,22,5.03,"PAH",31,1,183,0)=" follows:"
