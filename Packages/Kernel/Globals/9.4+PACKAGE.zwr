^DIC(9.4,3,22,21,"PAH",189,1,25,0)=">>>TaskMan does *not* need to be stopped."
^DIC(9.4,3,22,21,"PAH",189,1,26,0)=""
^DIC(9.4,3,22,21,"PAH",189,1,27,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",189,1,28,0)="      so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",189,1,29,0)=""
^DIC(9.4,3,22,21,"PAH",189,1,30,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",189,1,31,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",189,1,32,0)=""
^DIC(9.4,3,22,21,"PAH",189,1,33,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",189,1,34,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",189,1,35,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",189,1,36,0)="      options:"
^DIC(9.4,3,22,21,"PAH",189,1,37,0)=""
^DIC(9.4,3,22,21,"PAH",189,1,38,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",189,1,39,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",189,1,40,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",189,1,41,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",189,1,42,0)=""
^DIC(9.4,3,22,21,"PAH",189,1,43,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",189,1,44,0)="      non-peak time."
^DIC(9.4,3,22,21,"PAH",189,1,45,0)="      This patch can be queued for install at non-peak hours."
^DIC(9.4,3,22,21,"PAH",189,1,46,0)="      TaskMan can remain running."
^DIC(9.4,3,22,21,"PAH",189,1,47,0)=""
^DIC(9.4,3,22,21,"PAH",189,1,48,0)="  5.  Installation will take less than 2 minutes."
^DIC(9.4,3,22,21,"PAH",189,1,49,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",189,1,50,0)="      option:"
^DIC(9.4,3,22,21,"PAH",189,1,51,0)="        Install Package(s)  'XU*8.0*228'"
^DIC(9.4,3,22,21,"PAH",189,1,52,0)="                             =========="
^DIC(9.4,3,22,21,"PAH",189,1,53,0)=""
^DIC(9.4,3,22,21,"PAH",189,1,54,0)="        Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",189,1,55,0)=""
^DIC(9.4,3,22,21,"PAH",189,1,56,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",189,1,57,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",189,1,58,0)=""
^DIC(9.4,3,22,21,"PAH",189,1,59,0)="  6.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",189,1,60,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",190,0)="232 SEQ #197^3020814^1"
^DIC(9.4,3,22,21,"PAH",191,0)="233 SEQ #198^3020814^1"
^DIC(9.4,3,22,21,"PAH",192,0)="156 SEQ #199^3020814^1"
^DIC(9.4,3,22,21,"PAH",192,1,0)="^^4^4^3020814"
^DIC(9.4,3,22,21,"PAH",192,1,1,0)="XU*8*156"
^DIC(9.4,3,22,21,"PAH",192,1,2,0)="Menu Rebuild Rewrite - Part 1"
^DIC(9.4,3,22,21,"PAH",192,1,3,0)="Refer to patch XU*8*156 in the FORUM Patch Module for a complete"
^DIC(9.4,3,22,21,"PAH",192,1,4,0)="description."
^DIC(9.4,3,22,21,"PAH",193,0)="157 SEQ #200^3020814^1"
^DIC(9.4,3,22,21,"PAH",193,1,0)="^^4^4^3020814"
^DIC(9.4,3,22,21,"PAH",193,1,1,0)="XU*8*157"
^DIC(9.4,3,22,21,"PAH",193,1,2,0)="Menu Rebuild Rewrite - Part 2"
^DIC(9.4,3,22,21,"PAH",193,1,3,0)="Refer to patch XU*8*157 in the FORUM Patch Module for a complete"
^DIC(9.4,3,22,21,"PAH",193,1,4,0)="description."
^DIC(9.4,3,22,21,"PAH",194,0)="225 SEQ #201^3020814^1"
^DIC(9.4,3,22,21,"PAH",194,1,0)="^^100^100^3020814"
^DIC(9.4,3,22,21,"PAH",194,1,1,0)="Test Site: ANCHORAGE"
^DIC(9.4,3,22,21,"PAH",194,1,2,0)="Blood Bank Clearence: 4/12/2002"
^DIC(9.4,3,22,21,"PAH",194,1,3,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,4,0)="Problem: The call to Intersystems' license share should only be called for "
^DIC(9.4,3,22,21,"PAH",194,1,5,0)="Telnet and TCP connections. Not for LAT."
^DIC(9.4,3,22,21,"PAH",194,1,6,0)="Fix: This patch changes ZU to check the type of device and only call the "
^DIC(9.4,3,22,21,"PAH",194,1,7,0)="Intersystems License share code for Telnet connections, this is done "
^DIC(9.4,3,22,21,"PAH",194,1,8,0)="for both DSM and Cache. "
^DIC(9.4,3,22,21,"PAH",194,1,9,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,10,0)="NOIS: LOU-0601-40314, LEX-0401-42341, COA-0401-21786, HVH-0101-11346"
^DIC(9.4,3,22,21,"PAH",194,1,11,0)="Problem: TCP clients on Cache were opened in 'mumps' mode, this caused some "
^DIC(9.4,3,22,21,"PAH",194,1,12,0)="problems when talking with DSM systems. This caused problems with HL7."
^DIC(9.4,3,22,21,"PAH",194,1,13,0)="Fix: This patch changes the way that TCP devices are opened on Cache "
^DIC(9.4,3,22,21,"PAH",194,1,14,0)="systems to be in packet mode.  This makes it behave more like the way that "
^DIC(9.4,3,22,21,"PAH",194,1,15,0)="DSM does."
^DIC(9.4,3,22,21,"PAH",194,1,16,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,17,0)="NOIS: HVH-0101-11346, COA-0401-21786, LEX-0401-42341, LOU-0601-40314"
^DIC(9.4,3,22,21,"PAH",194,1,18,0)="Problem: ZISTCPS would halt when told to stop.  When called from a job "
^DIC(9.4,3,22,21,"PAH",194,1,19,0)="started by Taskman the task would not be cleaned up. This caused problems "
^DIC(9.4,3,22,21,"PAH",194,1,20,0)="with HL7."
^DIC(9.4,3,22,21,"PAH",194,1,21,0)="Fix: To have ZISTCPS just QUIT when told to stop."
^DIC(9.4,3,22,21,"PAH",194,1,22,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,23,0)="Problem: VMS and DSM utilities require the job number in hex, but Taskman "
^DIC(9.4,3,22,21,"PAH",194,1,24,0)="listing would just show the job number in decimal."
^DIC(9.4,3,22,21,"PAH",194,1,25,0)="Fix: In a task listing of running tasks, include the job number in hex when "
^DIC(9.4,3,22,21,"PAH",194,1,26,0)="the job numbers is greater that 2048."
^DIC(9.4,3,22,21,"PAH",194,1,27,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,28,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,29,0)="Routine Summary"
^DIC(9.4,3,22,21,"PAH",194,1,30,0)="The following routines are included in this patch.  The second line of each"
^DIC(9.4,3,22,21,"PAH",194,1,31,0)="of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",194,1,32,0)=" ;;8.0;KERNEL;<patchlist>;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",194,1,33,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,34,0)="                 Checksum"
^DIC(9.4,3,22,21,"PAH",194,1,35,0)="Routine         Old       New      2nd Line"
^DIC(9.4,3,22,21,"PAH",194,1,36,0)="XUTMTP1       5115647   5550117    **20,225**"
^DIC(9.4,3,22,21,"PAH",194,1,37,0)="ZISTCP        2703750   3208452    **36,34,59,69,118,225**"
^DIC(9.4,3,22,21,"PAH",194,1,38,0)="ZISTCPS       1115181   1281564    **78,118,127,225**"
^DIC(9.4,3,22,21,"PAH",194,1,39,0)="ZUONT         2038331   2065413    **34,94,118,162,170,225**"
^DIC(9.4,3,22,21,"PAH",194,1,40,0)="ZUSET         1042105   1042105    **162,170,225**"
^DIC(9.4,3,22,21,"PAH",194,1,41,0)="ZUVXD         4620305   4178529    **13,24,84,94,118,162,225**"
^DIC(9.4,3,22,21,"PAH",194,1,42,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,43,0)="List of preceding patches: 20, 127, 170"
^DIC(9.4,3,22,21,"PAH",194,1,44,0)="Sites should use CHECK^XTSUMBLD to verify checksums."
^DIC(9.4,3,22,21,"PAH",194,1,45,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,46,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",194,1,47,0)="Installation:"
^DIC(9.4,3,22,21,"PAH",194,1,48,0)=">>>Users may remain on the system."
^DIC(9.4,3,22,21,"PAH",194,1,49,0)=">>>TaskMan does not need to be stopped."
^DIC(9.4,3,22,21,"PAH",194,1,50,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,51,0)="  1.  DSM sites - Some of these routines are usually mapped,"
^DIC(9.4,3,22,21,"PAH",194,1,52,0)="      so you will need to disable mapping for the affected routines."
^DIC(9.4,3,22,21,"PAH",194,1,53,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,54,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option on the PackMan menu. This"
^DIC(9.4,3,22,21,"PAH",194,1,55,0)="      option will load the KIDS package onto your system."
^DIC(9.4,3,22,21,"PAH",194,1,56,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,57,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,3,22,21,"PAH",194,1,58,0)="      system. You now need to use KIDS to install the Transport global."
^DIC(9.4,3,22,21,"PAH",194,1,59,0)="      On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,3,22,21,"PAH",194,1,60,0)="      options:"
^DIC(9.4,3,22,21,"PAH",194,1,61,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,62,0)="         Verify Checksums in Transport Global"
^DIC(9.4,3,22,21,"PAH",194,1,63,0)="         Print Transport Global"
^DIC(9.4,3,22,21,"PAH",194,1,64,0)="         Compare Transport Global to Current System"
^DIC(9.4,3,22,21,"PAH",194,1,65,0)="         Backup a Transport Global"
^DIC(9.4,3,22,21,"PAH",194,1,66,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,67,0)="  4.  Users can remain on the system. This patch can be loaded any"
^DIC(9.4,3,22,21,"PAH",194,1,68,0)="      non-peak time."
^DIC(9.4,3,22,21,"PAH",194,1,69,0)="      This patch can not be queued."
^DIC(9.4,3,22,21,"PAH",194,1,70,0)="      TaskMan can remain running."
^DIC(9.4,3,22,21,"PAH",194,1,71,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,72,0)="  5.  In Programmer mode:"
^DIC(9.4,3,22,21,"PAH",194,1,73,0)="         Install Package(s)  'XU*8.0*225'"
^DIC(9.4,3,22,21,"PAH",194,1,74,0)="                              =========="
^DIC(9.4,3,22,21,"PAH",194,1,75,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,76,0)="        Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,3,22,21,"PAH",194,1,77,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,78,0)="        No Options or Protocols need to be placed out-of-order."
^DIC(9.4,3,22,21,"PAH",194,1,79,0)="        Want to DISABLE Scheduled Options, Menu Options, and Protocols? NO"
^DIC(9.4,3,22,21,"PAH",194,1,80,0)="                                                                        =="
^DIC(9.4,3,22,21,"PAH",194,1,81,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,82,0)="  6.  After installing this patch,"
^DIC(9.4,3,22,21,"PAH",194,1,83,0)="      Cache Sites - you don't need to move anything, skip this step."
^DIC(9.4,3,22,21,"PAH",194,1,84,0)="      DSM/MSM sites - you need to move several routines from"
^DIC(9.4,3,22,21,"PAH",194,1,85,0)="      your production account to each manager account:"
^DIC(9.4,3,22,21,"PAH",194,1,86,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,87,0)="ZISTCP"
^DIC(9.4,3,22,21,"PAH",194,1,88,0)="ZISTCPS"
^DIC(9.4,3,22,21,"PAH",194,1,89,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,90,0)="  7.  And in the manager account,  (OpenM sites remain in VAH)"
^DIC(9.4,3,22,21,"PAH",194,1,91,0)="      All sites:"
^DIC(9.4,3,22,21,"PAH",194,1,92,0)="      DO RELOAD^ZTMGRSET"
^DIC(9.4,3,22,21,"PAH",194,1,93,0)="      Select the System"
^DIC(9.4,3,22,21,"PAH",194,1,94,0)="      Patch number to load: 225"
^DIC(9.4,3,22,21,"PAH",194,1,95,0)="                            ==="
^DIC(9.4,3,22,21,"PAH",194,1,96,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,97,0)="  8.  DSM Sites, after patch has installed, rebuild your map set."
^DIC(9.4,3,22,21,"PAH",194,1,98,0)=""
^DIC(9.4,3,22,21,"PAH",194,1,99,0)="========================================================================="
^DIC(9.4,3,22,21,"PAH",194,1,100,0)=""
^DIC(9.4,3,22,21,"PAH",195,0)="245 SEQ #202^3020814^1"
^DIC(9.4,3,22,21,"PAH",195,1,0)="^^1^1^3020814"
^DIC(9.4,3,22,21,"PAH",195,1,1,0)="Please refer to the Description in FORUM Patch Module for details."
^DIC(9.4,3,22,21,"PAH",196,0)="147 SEQ #203^3020814^1"
^DIC(9.4,3,22,21,"PAH",196,1,0)="^9.49011^2^2^3020906^"
^DIC(9.4,3,22,21,"PAH",196,1,1,0)="See patch XU*8*147 in the National Patch Module for complete information"
^DIC(9.4,3,22,21,"PAH",196,1,2,0)="on this patch."
^DIC(9.4,3,22,21,"PAH",197,0)="237 SEQ #204^3020906^1"
^DIC(9.4,3,22,21,"PAH",198,0)="243 SEQ #205^3020906^1"
^DIC(9.4,3,22,21,"PAH",199,0)="174 SEQ #206^3020927^1"
^DIC(9.4,3,22,21,"PAH",199,1,0)="^^112^112^3020927"
^DIC(9.4,3,22,21,"PAH",199,1,1,0)="Alerts are used to send time sensitive notifications for information or"
^DIC(9.4,3,22,21,"PAH",199,1,2,0)="for further processing.  When created, some alerts may specify a number of"
^DIC(9.4,3,22,21,"PAH",199,1,3,0)="days for forwarding to a supervisor or to e-mail surrogates.  If the alert"
^DIC(9.4,3,22,21,"PAH",199,1,4,0)="remains unread after this period of time the alert is forwarded, if"
^DIC(9.4,3,22,21,"PAH",199,1,5,0)="possible, to a supervisor or e-mail surrogate as indicated.  A problem has"
^DIC(9.4,3,22,21,"PAH",199,1,6,0)="been reported when after the alert has been forwarded to the backup"
^DIC(9.4,3,22,21,"PAH",199,1,7,0)="individual, it is repeatedly reforwarded on following days until the alert"
^DIC(9.4,3,22,21,"PAH",199,1,8,0)="is removed either manually or as a result of normal alert removal"
^DIC(9.4,3,22,21,"PAH",199,1,9,0)="(SHR-0100-70069).  This patch corrects this behavior, so the alert will"
^DIC(9.4,3,22,21,"PAH",199,1,10,0)="only be forwarded once."
^DIC(9.4,3,22,21,"PAH",199,1,11,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,12,0)="In addition, there have been some who wanted these unread alerts forwarded"
^DIC(9.4,3,22,21,"PAH",199,1,13,0)="to a specific individual, e.g., someone in QA, who would monitor unread"
^DIC(9.4,3,22,21,"PAH",199,1,14,0)="alerts and could insure forwarding to proper individuals if they could not"
^DIC(9.4,3,22,21,"PAH",199,1,15,0)="process them fully (ASH-0100-31970).  To assist in this capability, the"
^DIC(9.4,3,22,21,"PAH",199,1,16,0)="current patch also adds a 'DAYS FOR BACKUP REVIEWER' (#.15) field to the"
^DIC(9.4,3,22,21,"PAH",199,1,17,0)="'ALERT DATE/TIME(#1)' subfile of the 'ALERT(#8992)' file.  In addition, it"
^DIC(9.4,3,22,21,"PAH",199,1,18,0)="adds an 'XQAL BACKUP REVIEWER' entry in the PARAMETER DEFINITION "
^DIC(9.4,3,22,21,"PAH",199,1,19,0)="(#8989.51) file, and an option, Set Backup Reviewer for Alerts [XQAL SET"
^DIC(9.4,3,22,21,"PAH",199,1,20,0)="BACKUP REVIEWER] on the Alert Management [XQALERT MGR] menu."
^DIC(9.4,3,22,21,"PAH",199,1,21,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,22,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,23,0)="If an alert is generated with a number of days specified in the variable"
^DIC(9.4,3,22,21,"PAH",199,1,24,0)="XQAREVUE, after the specified number of days has passed if the alert"
^DIC(9.4,3,22,21,"PAH",199,1,25,0)="remains unread, and if a valid entry is present in the ALERT BACKUP"
^DIC(9.4,3,22,21,"PAH",199,1,26,0)="REVIEWER parameter for the User, Service, Division, or System "
^DIC(9.4,3,22,21,"PAH",199,1,27,0)="entities,        "
^DIC(9.4,3,22,21,"PAH",199,1,28,0)="the  alert will be forwarded to the indicated individual at the lowest"
^DIC(9.4,3,22,21,"PAH",199,1,29,0)="level found for processing."
^DIC(9.4,3,22,21,"PAH",199,1,30,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,31,0)="NOISs (SHR-0100-70069; SHR-1099-70923; ASH-0100-31970)"
^DIC(9.4,3,22,21,"PAH",199,1,32,0)="E3Rs (13228, 13229)"
^DIC(9.4,3,22,21,"PAH",199,1,33,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,34,0)="List of Test Sites"
^DIC(9.4,3,22,21,"PAH",199,1,35,0)="=================="
^DIC(9.4,3,22,21,"PAH",199,1,36,0)="BATTLE CREEK, MI                                       "
^DIC(9.4,3,22,21,"PAH",199,1,37,0)="CHARLESTON, SC                                       "
^DIC(9.4,3,22,21,"PAH",199,1,38,0)="DUBLIN, GA                                       "
^DIC(9.4,3,22,21,"PAH",199,1,39,0)="NORTHERN CALIFORNIA HCS                                       "
^DIC(9.4,3,22,21,"PAH",199,1,40,0)="OIFO-SAN FRANCISCO                                       "
^DIC(9.4,3,22,21,"PAH",199,1,41,0)="PUGET SOUND HCS                                       "
^DIC(9.4,3,22,21,"PAH",199,1,42,0)="SAN FRANCISCO, CA                                       "
^DIC(9.4,3,22,21,"PAH",199,1,43,0)="SHREVEPORT, LA                                       "
^DIC(9.4,3,22,21,"PAH",199,1,44,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,45,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,46,0)="Routine Summary:"
^DIC(9.4,3,22,21,"PAH",199,1,47,0)="================"
^DIC(9.4,3,22,21,"PAH",199,1,48,0)="The following routines are included in this patch.  The second"
^DIC(9.4,3,22,21,"PAH",199,1,49,0)="line of each of these routines now looks like:"
^DIC(9.4,3,22,21,"PAH",199,1,50,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,51,0)="     <tab>;;8.0;KERNEL;**[patch list]**;Jul 10, 1995"
^DIC(9.4,3,22,21,"PAH",199,1,52,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,53,0)="Checksums:"
^DIC(9.4,3,22,21,"PAH",199,1,54,0)="=========="
^DIC(9.4,3,22,21,"PAH",199,1,55,0)="Checksums obtained using CHECK^XTSUMBLD"
^DIC(9.4,3,22,21,"PAH",199,1,56,0)=" "
^DIC(9.4,3,22,21,"PAH",199,1,57,0)=" Rtn Nm    Chksum Before   Chksum After    Patch List"
^DIC(9.4,3,22,21,"PAH",199,1,58,0)=" ------    -------------   ------------    ----------"
