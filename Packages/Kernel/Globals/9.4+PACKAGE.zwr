^DIC(9.4,14,22,5.9,"PAH",108,1,237,0)="Select CPT Code: ASSAY FOR ETHANOL ??"
^DIC(9.4,14,22,5.9,"PAH",108,1,238,0)=" Answer with CPT NUMBER, or CPT CODE, or CPT CATEGORY, or DESCRIPTION"
