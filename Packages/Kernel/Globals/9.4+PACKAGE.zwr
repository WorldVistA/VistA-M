^DIC(9.4,4,22,1,"PAH",88,1,6,0)="NOIS: PUG-0200-50349"
^DIC(9.4,4,22,1,"PAH",88,1,7,0)="Test Site:  Puget Sound HCS"
^DIC(9.4,4,22,1,"PAH",88,1,8,0)="Resequencing one of the Postmaster's transmit queue baskets while messages"
^DIC(9.4,4,22,1,"PAH",88,1,9,0)="in that queue are transmitting may result in an abort in the resequencing"
^DIC(9.4,4,22,1,"PAH",88,1,10,0)="process. This patch fixes that."
^DIC(9.4,4,22,1,"PAH",88,1,11,0)=""
^DIC(9.4,4,22,1,"PAH",88,1,12,0)="NOTE: This patch should be installed during off hours, when user activity"
