^DIC(9.4,96,22,1.2,"PAH",21,1,194,0)="   DENTVRH     6800370      7889749        31,37,38,39"
^DIC(9.4,96,22,1.2,"PAH",21,1,195,0)="   DENTVRHD    1034441      1569611        31,39"
^DIC(9.4,96,22,1.2,"PAH",21,1,196,0)="   DENTVRP1    5080599      5103649        30,34,36,31,37,39"
^DIC(9.4,96,22,1.2,"PAH",21,1,197,0)="   DENTVRP3    6062351      6412654        30,32,35,31,39"
^DIC(9.4,96,22,1.2,"PAH",21,1,198,0)="   DENTVRP8    3913187      4052725        38,39"
^DIC(9.4,96,22,1.2,"PAH",21,1,199,0)="   DENTVRP9    6021572      6935679        30,32,34,31,38,39"
^DIC(9.4,96,22,1.2,"PAH",21,1,200,0)="   DENTVTP0      n/a        830603         39"
^DIC(9.4,96,22,1.2,"PAH",21,1,201,0)="   DENTVTP1      n/a        5103282        39"
^DIC(9.4,96,22,1.2,"PAH",21,1,202,0)="   DENTVTP2    3443632      2998057        38,39"
^DIC(9.4,96,22,1.2,"PAH",21,1,203,0)="   DENTVTP3      n/a        5419608        39"
^DIC(9.4,96,22,1.2,"PAH",21,1,204,0)="   DENTVTP4      n/a        10224521       39"
^DIC(9.4,96,22,1.2,"PAH",21,1,205,0)="   DENTVTP5      n/a        4674885        39"
^DIC(9.4,96,22,1.2,"PAH",21,1,206,0)="   DENTVTP6      n/a        5267534        39"
^DIC(9.4,96,22,1.2,"PAH",21,1,207,0)="   DENTVTP7      n/a        3312894        39"
^DIC(9.4,96,22,1.2,"PAH",21,1,208,0)="   DENTVTPA      n/a        4823862        39"
^DIC(9.4,96,22,1.2,"PAH",21,1,209,0)="   DENTVTPB      n/a        8540067        39"
^DIC(9.4,96,22,1.2,"PAH",21,1,210,0)="   DENTVTPC      n/a        10530540       39"
