^DIC(9.4,77,22,16,"PAH","B",32,3)=""
^DIC(9.4,77,22,16,"PAH","B",46,17)=""
^DIC(9.4,77,22,16,"PAH","B",55,26)=""
^DIC(9.4,77,22,16,"PAH","B",56,27)=""
^DIC(9.4,77,22,16,"PAH","B",57,28)=""
^DIC(9.4,77,22,16,"PAH","B",58,29)=""
^DIC(9.4,77,22,16,"PAH","B",59,30)=""
^DIC(9.4,77,22,16,"PAH","B",66,37)=""
^DIC(9.4,77,22,16,"PAH","B",67,38)=""
