^DIC(9.4,134,22,17,"PAH",20,1,152,0)="===================="
^DIC(9.4,134,22,17,"PAH",20,1,153,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,154,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,155,0)="The second line of each of these routines now looks like:"
^DIC(9.4,134,22,17,"PAH",20,1,156,0)=" ;;2.0;Patient Representative;**[Patch List]**;07/25/1995;Build 4"
^DIC(9.4,134,22,17,"PAH",20,1,157,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,158,0)="The checksums below are new checksums, and"
^DIC(9.4,134,22,17,"PAH",20,1,159,0)=" can be checked with CHECK1^XTSUMBLD."
^DIC(9.4,134,22,17,"PAH",20,1,160,0)=" "
^DIC(9.4,134,22,17,"PAH",20,1,161,0)="Routine Name: QACVEMPX"
