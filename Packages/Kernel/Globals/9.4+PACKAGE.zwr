^DIC(9.4,52,22,0)="^9.49I^29^2"
^DIC(9.4,52,22,28,0)="5.0^2950921^2960627"
^DIC(9.4,52,22,28,"PAH",0)="^9.4901^164^164"
^DIC(9.4,52,22,28,"PAH",1,0)="70^2960703^1"
^DIC(9.4,52,22,28,"PAH",1,1,0)="^^2^2^2960703"
^DIC(9.4,52,22,28,"PAH",1,1,1,0)="Patch routine to update file 2100.1 entries from TRANSMITTED to ACCEPTED"
^DIC(9.4,52,22,28,"PAH",1,1,2,0)="that have a date entered before March 1st, 1996."
^DIC(9.4,52,22,28,"PAH",2,0)="66^2960703^1"
^DIC(9.4,52,22,28,"PAH",2,1,0)="^^1^1^2960703"
^DIC(9.4,52,22,28,"PAH",2,1,1,0)="This KIDS distribution will allow FISCAL to review any VRQs."
^DIC(9.4,52,22,28,"PAH",3,0)="55^2960703^1"
^DIC(9.4,52,22,28,"PAH",3,1,0)="^^1^1^2960703"
^DIC(9.4,52,22,28,"PAH",3,1,1,0)="Patch PRC*5*55 for carry forward enhancement."
^DIC(9.4,52,22,28,"PAH",4,0)="51^2960703^1"
^DIC(9.4,52,22,28,"PAH",4,1,0)="^^2^2^2960703"
^DIC(9.4,52,22,28,"PAH",4,1,1,0)="Creation of PRCS REINSTATE option."
^DIC(9.4,52,22,28,"PAH",4,1,2,0)="NOIS fixes."
^DIC(9.4,52,22,28,"PAH",5,0)="42^2960703^1"
^DIC(9.4,52,22,28,"PAH",5,1,0)="^^2^2^2960703"
^DIC(9.4,52,22,28,"PAH",5,1,1,0)="New Janus Barcode Functionality"
^DIC(9.4,52,22,28,"PAH",5,1,2,0)=""
^DIC(9.4,52,22,28,"PAH",6,0)="73^2960703^1"
^DIC(9.4,52,22,28,"PAH",6,1,0)="^^1^1^2960703"
^DIC(9.4,52,22,28,"PAH",6,1,1,0)="Corrections to patch PRC*5*66."
^DIC(9.4,52,22,28,"PAH",7,0)="59^2960703^1"
^DIC(9.4,52,22,28,"PAH",7,1,0)="^^1^1^2960703"
^DIC(9.4,52,22,28,"PAH",7,1,1,0)="1358 PROCESSING"
^DIC(9.4,52,22,28,"PAH",8,0)="75^2960807^1"
^DIC(9.4,52,22,28,"PAH",8,1,0)="^^2^2^2960807"
^DIC(9.4,52,22,28,"PAH",8,1,1,0)="This patch will eliminate different parts of a multipart MailMan message"
^DIC(9.4,52,22,28,"PAH",8,1,2,0)="from being placed into different records in file 423.6."
^DIC(9.4,52,22,28,"PAH",9,0)="77^2960823^1"
^DIC(9.4,52,22,28,"PAH",9,1,0)="^^1^1^2960823"
^DIC(9.4,52,22,28,"PAH",9,1,1,0)="ERROR WHEN COPYING A TEMPORARY TRANSACTION"
^DIC(9.4,52,22,28,"PAH",10,0)="84^2960923^1"
^DIC(9.4,52,22,28,"PAH",10,1,0)="^^3^3^2960923"
^DIC(9.4,52,22,28,"PAH",10,1,1,0)="This patch is being issued to extract data from the Vendor file (#440) at"
^DIC(9.4,52,22,28,"PAH",10,1,2,0)="each facility and forward that data to Dunn & Bradstreet to obtain Dun and"
^DIC(9.4,52,22,28,"PAH",10,1,3,0)="Bradstreet Numbers (#18.3) for each vendor"
^DIC(9.4,52,22,28,"PAH",11,0)="48^2960923^1"
^DIC(9.4,52,22,28,"PAH",11,1,0)="^^1^1^2960923"
^DIC(9.4,52,22,28,"PAH",11,1,1,0)="General Post Fund/CP Approval Queueing & Printing Fixes"
^DIC(9.4,52,22,28,"PAH",12,0)="83^2960924^1"
^DIC(9.4,52,22,28,"PAH",12,1,0)="^^3^3^2960924"
^DIC(9.4,52,22,28,"PAH",12,1,1,0)="This patch contains the Purchase Card Registration option, the"
^DIC(9.4,52,22,28,"PAH",12,1,2,0)="PRCH PURCHASE CARD input template, the PRCHUSER routine, and"
^DIC(9.4,52,22,28,"PAH",12,1,3,0)="the data dictionary for file 440.5"
^DIC(9.4,52,22,28,"PAH",13,0)="17^2960925^1"
^DIC(9.4,52,22,28,"PAH",13,1,0)="^^1^1^2960925"
^DIC(9.4,52,22,28,"PAH",13,1,1,0)="Undelivered Orders Reports"
^DIC(9.4,52,22,28,"PAH",14,0)="76^2960925^1"
^DIC(9.4,52,22,28,"PAH",14,1,0)="^^1^1^2960925"
^DIC(9.4,52,22,28,"PAH",14,1,1,0)="PICKING TICKET FIXES"
^DIC(9.4,52,22,28,"PAH",15,0)="96^2960926^1"
^DIC(9.4,52,22,28,"PAH",15,1,0)="^^29^29^2960926"
^DIC(9.4,52,22,28,"PAH",15,1,1,0)="FMS EOY EMERGENCY CHANGES"
^DIC(9.4,52,22,28,"PAH",15,1,2,0)=" "
^DIC(9.4,52,22,28,"PAH",15,1,3,0)="This patch is being issued to sychronize IFCAP with the End-of-the-Year"
^DIC(9.4,52,22,28,"PAH",15,1,4,0)="processing at Austin and to implement the OMB decision to prohibit Carry "
^DIC(9.4,52,22,28,"PAH",15,1,5,0)="Forward of non-revolving (multi-year) funds."
^DIC(9.4,52,22,28,"PAH",15,1,6,0)=" "
^DIC(9.4,52,22,28,"PAH",15,1,7,0)="This patch must be installed prior to the Sept 30, 1996 to ensure that"
^DIC(9.4,52,22,28,"PAH",15,1,8,0)="payments between 10/1 and 10/11 are able to be processed in a timely and"
^DIC(9.4,52,22,28,"PAH",15,1,9,0)="uninterrupted manner."
^DIC(9.4,52,22,28,"PAH",15,1,10,0)=" "
^DIC(9.4,52,22,28,"PAH",15,1,11,0)="Functionality Provided"
^DIC(9.4,52,22,28,"PAH",15,1,12,0)="----------------------"
^DIC(9.4,52,22,28,"PAH",15,1,13,0)=" "
^DIC(9.4,52,22,28,"PAH",15,1,14,0)="1. To implement an OMB decision, only revolving funds are automatically"
^DIC(9.4,52,22,28,"PAH",15,1,15,0)="carried forward."
^DIC(9.4,52,22,28,"PAH",15,1,16,0)=" "
^DIC(9.4,52,22,28,"PAH",15,1,17,0)="2. To sychronize IFCAP with Austin, the IFCAP PARAMETERS Cross-reference"
^DIC(9.4,52,22,28,"PAH",15,1,18,0)="for the ADMIN. ACTIVITY SITE PARAMETER file (#411) is created to contain"
^DIC(9.4,52,22,28,"PAH",15,1,19,0)="non-site specific data.  The cross-reference is NOT record oriented and"
^DIC(9.4,52,22,28,"PAH",15,1,20,0)="will initially have only one entry:"
^DIC(9.4,52,22,28,"PAH",15,1,21,0)=" "
^DIC(9.4,52,22,28,"PAH",15,1,22,0)="        ^PRC(411,""A IFCAP-Wide Parameters"",""SO 2 AR Date"") = date"
^DIC(9.4,52,22,28,"PAH",15,1,23,0)=" "
^DIC(9.4,52,22,28,"PAH",15,1,24,0)="being that date on which Austin will convert ""this year's unpaid POs"" to"
^DIC(9.4,52,22,28,"PAH",15,1,25,0)="""Last Year's"", i.e. that date on which IFCAP must convert to ""SO""s and"
^DIC(9.4,52,22,28,"PAH",15,1,26,0)="""AR""s -- SO TO AR DATE (#2)."
^DIC(9.4,52,22,28,"PAH",15,1,27,0)=" "
^DIC(9.4,52,22,28,"PAH",15,1,28,0)="The option Enter the ""SO"" to ""AR"" Shift Date for Austin/IFCAP"
^DIC(9.4,52,22,28,"PAH",15,1,29,0)="Sychronization [PRCB SO TO AR] is provided to enter that date."
^DIC(9.4,52,22,28,"PAH",16,0)="71^2961008^1"
^DIC(9.4,52,22,28,"PAH",16,1,0)="^^1^1^2961008"
^DIC(9.4,52,22,28,"PAH",16,1,1,0)="Problems with amendment obligation."
