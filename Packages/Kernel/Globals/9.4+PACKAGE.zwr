^DIC(9.4,115,22,2,"PAH",9,0)="14 SEQ #9^2990914^1"
^DIC(9.4,115,22,2,"PAH",10,0)="13 SEQ #10^2991003^1"
^DIC(9.4,115,22,2,"PAH",10,1,0)="^^1^1^2991003"
^DIC(9.4,115,22,2,"PAH",10,1,1,0)="Service Patch Release"
^DIC(9.4,115,22,2,"PAH",11,0)="8 SEQ #11^2991019^1"
^DIC(9.4,115,22,2,"PAH",11,1,0)="^^1^1^2991019"
^DIC(9.4,115,22,2,"PAH",11,1,1,0)="This is the KIDS build for Radiology 5.0 patch 8."
^DIC(9.4,115,22,2,"PAH",12,0)="12 SEQ #12^2991210^1"
^DIC(9.4,115,22,2,"PAH",12,1,0)="^^25^25^2991210"
^DIC(9.4,115,22,2,"PAH",12,1,1,0)="Full TCP/IP support for HL7 messaging is available with patch HL*1.6*19."
^DIC(9.4,115,22,2,"PAH",12,1,2,0)="Two links are required for message transactions.  One link is used by"
^DIC(9.4,115,22,2,"PAH",12,1,3,0)="VISTA to send messages and receive acknowledgements to those messages."
^DIC(9.4,115,22,2,"PAH",12,1,4,0)="The other link is used by a commercial off the shelf (COTS) voice"
^DIC(9.4,115,22,2,"PAH",12,1,5,0)="recognition unit to send messages and receive acknowledgments to those"
^DIC(9.4,115,22,2,"PAH",12,1,6,0)="messages.  (The message sent and the acknowledgement to that message"
^DIC(9.4,115,22,2,"PAH",12,1,7,0)="comprise a full transaction.)"
^DIC(9.4,115,22,2,"PAH",12,1,8,0)=" "
^DIC(9.4,115,22,2,"PAH",12,1,9,0)="Patch RA*5*12 includes protocols that now enable Radiology/Nuclear"
^DIC(9.4,115,22,2,"PAH",12,1,10,0)="Medicine to communicate with COTS systems using HL7 v2.3 messages over"
^DIC(9.4,115,22,2,"PAH",12,1,11,0)="TCP/IP. The original release of Rad/Nuc Med v5.0 supports HL7 v2.1"
^DIC(9.4,115,22,2,"PAH",12,1,12,0)="messages.  Patch RA*5*12 also supports the VISTA HL7 v2.3 Interface to the"
^DIC(9.4,115,22,2,"PAH",12,1,13,0)="PowerScribe for Radiology COTS voice recognition system.  Any one of"
^DIC(9.4,115,22,2,"PAH",12,1,14,0)="the following events generate VISTA HL7 messages:"
^DIC(9.4,115,22,2,"PAH",12,1,15,0)="1) Registration"
^DIC(9.4,115,22,2,"PAH",12,1,16,0)="2) Cancellation"
^DIC(9.4,115,22,2,"PAH",12,1,17,0)="3) Examined (i.e., images collected, usually set up in sites using the"
^DIC(9.4,115,22,2,"PAH",12,1,18,0)="VISTA Imaging package and/or a PACS system)"
^DIC(9.4,115,22,2,"PAH",12,1,19,0)=" "
^DIC(9.4,115,22,2,"PAH",12,1,20,0)="This patch also includes an exceptions file and a ListMan option to view"
^DIC(9.4,115,22,2,"PAH",12,1,21,0)="or print the HL7 exceptions and take appropriate action to resolve the"
^DIC(9.4,115,22,2,"PAH",12,1,22,0)="problem."
^DIC(9.4,115,22,2,"PAH",12,1,23,0)=" "
^DIC(9.4,115,22,2,"PAH",12,1,24,0)="Please consult the Radiology/Nuclear Medicine Technical Manual for further"
^DIC(9.4,115,22,2,"PAH",12,1,25,0)="information concerning TCP/IP messaging."
