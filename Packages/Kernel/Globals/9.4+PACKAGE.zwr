^DIC(9.4,83,22,16,"PAH",62,1,135,0)="   Schedules when running the report as seen below:"
^DIC(9.4,83,22,16,"PAH",62,1,136,0)="  "
^DIC(9.4,83,22,16,"PAH",62,1,137,0)="      ..."
^DIC(9.4,83,22,16,"PAH",62,1,138,0)="      "
^DIC(9.4,83,22,16,"PAH",62,1,139,0)="      Select Primary Dispensing Site: OPC VAULT//     "
^DIC(9.4,83,22,16,"PAH",62,1,140,0)="      Select Schedule/Drug"
^DIC(9.4,83,22,16,"PAH",62,1,141,0)=" "
^DIC(9.4,83,22,16,"PAH",62,1,142,0)="        Select one of the following:"
^DIC(9.4,83,22,16,"PAH",62,1,143,0)=" "
^DIC(9.4,83,22,16,"PAH",62,1,144,0)="             1         SCHEDULES I - II"
^DIC(9.4,83,22,16,"PAH",62,1,145,0)="             2         SCHEDULES III - V"
^DIC(9.4,83,22,16,"PAH",62,1,146,0)="             3         SCHEDULES I - V"
^DIC(9.4,83,22,16,"PAH",62,1,147,0)="             4         INDIVIDUAL DRUG"
