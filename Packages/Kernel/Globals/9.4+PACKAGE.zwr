^DIC(9.4,4,22,1,"PAH",108,1,129,0)="This patch introduces no new routines."
^DIC(9.4,4,22,1,"PAH",108,1,130,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",108,1,131,0)=" "
^DIC(9.4,4,22,1,"PAH",108,1,132,0)="INSTALLATION:"
^DIC(9.4,4,22,1,"PAH",108,1,133,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",108,1,134,0)="is at a minimum.  It requires MailMan patches XM*7.1*107, XM*7.1*124,"
^DIC(9.4,4,22,1,"PAH",108,1,135,0)="XM*7.1*127, and XM*7.1*130."
^DIC(9.4,4,22,1,"PAH",108,1,136,0)="1.  Users may be on the system during installation of this patch."
^DIC(9.4,4,22,1,"PAH",108,1,137,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,4,22,1,"PAH",108,1,138,0)="    affected routine(s).  "
^DIC(9.4,4,22,1,"PAH",108,1,139,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,4,22,1,"PAH",108,1,140,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,4,22,1,"PAH",108,1,141,0)="4.  You do not need to stop TaskMan or the background filer."
^DIC(9.4,4,22,1,"PAH",108,1,142,0)="    Users may be on the system."
^DIC(9.4,4,22,1,"PAH",108,1,143,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,4,22,1,"PAH",108,1,144,0)="    Transport Global:"
^DIC(9.4,4,22,1,"PAH",108,1,145,0)="       Verify Checksums in Transport Global"
^DIC(9.4,4,22,1,"PAH",108,1,146,0)="       Print Transport Global"
^DIC(9.4,4,22,1,"PAH",108,1,147,0)="       Compare Transport Global to Current System"
^DIC(9.4,4,22,1,"PAH",108,1,148,0)="       Backup a Transport Global"
^DIC(9.4,4,22,1,"PAH",108,1,149,0)="       Install Package(s)"
^DIC(9.4,4,22,1,"PAH",108,1,150,0)=" Select INSTALL NAME:    XM*7.1*131    Loaded from Distribution  <date/time>"
^DIC(9.4,4,22,1,"PAH",108,1,151,0)="                         =========="
^DIC(9.4,4,22,1,"PAH",108,1,152,0)=" Install Questions:"
^DIC(9.4,4,22,1,"PAH",108,1,153,0)=" Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES// YES"
^DIC(9.4,4,22,1,"PAH",108,1,154,0)="                                                                   ==="
^DIC(9.4,4,22,1,"PAH",108,1,155,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,4,22,1,"PAH",108,1,156,0)="                                                       =="
^DIC(9.4,4,22,1,"PAH",108,1,157,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,4,22,1,"PAH",108,1,158,0)="                                                                       =="
^DIC(9.4,4,22,1,"PAH",108,1,159,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,4,22,1,"PAH",108,1,160,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,4,22,1,"PAH",108,1,161,0)=" Enter a '^' to abort the install."
^DIC(9.4,4,22,1,"PAH",108,1,162,0)=""
^DIC(9.4,4,22,1,"PAH",108,1,163,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,4,22,1,"PAH",108,1,164,0)="                ------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",108,1,165,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,4,22,1,"PAH",108,1,166,0)="==========================================================================="
^DIC(9.4,4,22,1,"PAH",109,0)="136 SEQ #134^3000724^1"
^DIC(9.4,4,22,1,"PAH",109,1,0)="^^64^64^3000724"
