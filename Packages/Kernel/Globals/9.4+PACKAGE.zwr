^DIC(9.4,35,22,3,"PAH",17,1,1,0)="See National Patch Module (NPM) on FORUM."
^DIC(9.4,35,22,3,"PAH",18,0)="20^2990416^1"
^DIC(9.4,35,22,3,"PAH",18,1,0)="^^1^1^2990416"
^DIC(9.4,35,22,3,"PAH",18,1,1,0)="See description on patch message."
^DIC(9.4,35,22,3,"PAH",19,0)="6^2990416^1"
^DIC(9.4,35,22,3,"PAH",19,1,0)="^^6^6^2990416"
^DIC(9.4,35,22,3,"PAH",19,1,1,0)="Note: This patch can only be installed at sites running CPRS."
^DIC(9.4,35,22,3,"PAH",19,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",19,1,3,0)="The entry point to do medication order checks for drug-drug interactions,"
^DIC(9.4,35,22,3,"PAH",19,1,4,0)="duplicate drug orders and duplicate drug class orders was changed from"
^DIC(9.4,35,22,3,"PAH",19,1,5,0)="^PSOORDRG to EN^PSOORDRG.  This patch changes references in routine ORKPS"
^DIC(9.4,35,22,3,"PAH",19,1,6,0)="to the new entry point EN^PSOORDRG."
^DIC(9.4,35,22,3,"PAH",20,0)="28^2990416^1"
^DIC(9.4,35,22,3,"PAH",20,1,0)="^^1^1^2990416"
^DIC(9.4,35,22,3,"PAH",20,1,1,0)="See the patch description on the patch message."
^DIC(9.4,35,22,3,"PAH",21,0)="33^2990416^1"
^DIC(9.4,35,22,3,"PAH",21,1,0)="^^2^2^2990416"
^DIC(9.4,35,22,3,"PAH",21,1,1,0)="This patch will make the CPRS-ARTS interface compatible with the re-design"
^DIC(9.4,35,22,3,"PAH",21,1,2,0)="of the National Drug File."
^DIC(9.4,35,22,3,"PAH",22,0)="30^2990416^1"
^DIC(9.4,35,22,3,"PAH",22,1,0)="^^1^1^2990416"
^DIC(9.4,35,22,3,"PAH",22,1,1,0)="Refer to the patch description on the patch message."
^DIC(9.4,35,22,3,"PAH",23,0)="8^2990416^1"
^DIC(9.4,35,22,3,"PAH",24,0)="35^2990416^1"
^DIC(9.4,35,22,3,"PAH",24,1,0)="^^1^1^2990416"
^DIC(9.4,35,22,3,"PAH",24,1,1,0)="Refer to the patch description on the patch message."
^DIC(9.4,35,22,3,"PAH",25,0)="37^2990416^1"
^DIC(9.4,35,22,3,"PAH",25,1,0)="^^3^3^2990416"
^DIC(9.4,35,22,3,"PAH",25,1,1,0)=" "
^DIC(9.4,35,22,3,"PAH",25,1,2,0)="See patch OR*3*37 in the National Patch Module for description on this"
^DIC(9.4,35,22,3,"PAH",25,1,3,0)="build."
^DIC(9.4,35,22,3,"PAH",26,0)="24^2990416^1"
^DIC(9.4,35,22,3,"PAH",27,0)="41^2990416^1"
^DIC(9.4,35,22,3,"PAH",28,0)="29^2990416^1"
^DIC(9.4,35,22,3,"PAH",28,1,0)="^^2^2^2990416"
^DIC(9.4,35,22,3,"PAH",28,1,1,0)="This patch corrects several problems withg Lab ordering via CPRS List"
^DIC(9.4,35,22,3,"PAH",28,1,2,0)="Manager.  "
^DIC(9.4,35,22,3,"PAH",29,0)="36^2990416^1"
^DIC(9.4,35,22,3,"PAH",30,0)="34^2990416^1"
^DIC(9.4,35,22,3,"PAH",31,0)="38^2990416^1"
^DIC(9.4,35,22,3,"PAH",32,0)="39^2990416^1"
^DIC(9.4,35,22,3,"PAH",32,1,0)="^^23^23^2990416"
^DIC(9.4,35,22,3,"PAH",32,1,1,0)="Delayed orders for allergies were not properly released to the ADVERSE"
^DIC(9.4,35,22,3,"PAH",32,1,2,0)="REACTION TRACKING (ART) package upon patient movement. The status of the"
^DIC(9.4,35,22,3,"PAH",32,1,3,0)="orders was not properly updated to active upon patient movement."
^DIC(9.4,35,22,3,"PAH",32,1,4,0)=" "
^DIC(9.4,35,22,3,"PAH",32,1,5,0)="When an order for NO KNOWN ALLERGIES was entered, these orders were not"
^DIC(9.4,35,22,3,"PAH",32,1,6,0)="displaying properly with allergy orders. The post-install for this patch"
^DIC(9.4,35,22,3,"PAH",32,1,7,0)="will correct the ""AW"" cross-reference on all NKA orders in the file."
^DIC(9.4,35,22,3,"PAH",32,1,8,0)=" "
^DIC(9.4,35,22,3,"PAH",32,1,9,0)="When a reaction to a causitive agent was entered, pre-existing NKA"
^DIC(9.4,35,22,3,"PAH",32,1,10,0)="orders were being left in an active status. This caused confusion in the"
^DIC(9.4,35,22,3,"PAH",32,1,11,0)="display of allergy orders. "
^DIC(9.4,35,22,3,"PAH",32,1,12,0)=" "
^DIC(9.4,35,22,3,"PAH",32,1,13,0)=" "
^DIC(9.4,35,22,3,"PAH",32,1,14,0)="This patch will correct the above problems."
^DIC(9.4,35,22,3,"PAH",32,1,15,0)=" "
^DIC(9.4,35,22,3,"PAH",32,1,16,0)=" "
^DIC(9.4,35,22,3,"PAH",32,1,17,0)="This patch includes one new protocol, OR GMRA UPDATE and also includes the"
^DIC(9.4,35,22,3,"PAH",32,1,18,0)="GMRAOR ALLERGY ENTER/EDIT order dialog. "
^DIC(9.4,35,22,3,"PAH",32,1,19,0)=" "
^DIC(9.4,35,22,3,"PAH",32,1,20,0)="Changes have been made to the GMRAOR ALLERGY ENTER/EDIT order dialog and"
^DIC(9.4,35,22,3,"PAH",32,1,21,0)="its items in support of allergy entry via the CPRS GUI. "
^DIC(9.4,35,22,3,"PAH",32,1,22,0)=" "
^DIC(9.4,35,22,3,"PAH",32,1,23,0)="A new routine ORMGMRA is also exported with this patch."
^DIC(9.4,35,22,3,"PAH",33,0)="27^2990416^1"
^DIC(9.4,35,22,3,"PAH",34,0)="9^2990416^1"
^DIC(9.4,35,22,3,"PAH",34,1,0)="^^62^62^2990416"
^DIC(9.4,35,22,3,"PAH",34,1,1,0)="Note: This patch can only be installed at sites running CPRS."
^DIC(9.4,35,22,3,"PAH",34,1,2,0)=" "
^DIC(9.4,35,22,3,"PAH",34,1,3,0)="Addresses NOIS: SFC-0198-60744"
^DIC(9.4,35,22,3,"PAH",34,1,4,0)=" "
^DIC(9.4,35,22,3,"PAH",34,1,5,0)="Fixes a team list display problem as reported and described by Nancy"
^DIC(9.4,35,22,3,"PAH",34,1,6,0)="Shapiro at San Francisco:"
^DIC(9.4,35,22,3,"PAH",34,1,7,0)=" "
^DIC(9.4,35,22,3,"PAH",34,1,8,0)=" "
^DIC(9.4,35,22,3,"PAH",34,1,9,0)="Subj: CPRS TEAM DISPLAY PROBLEM  [#491781] 31 Dec 97 10:59 PDT  74 Lines"
^DIC(9.4,35,22,3,"PAH",34,1,10,0)="From: SHAPIRO.NANCY@SANFRANCISCO.DOMAIN.EXT    Page 1"
^DIC(9.4,35,22,3,"PAH",34,1,11,0)="--------------------------------------------------------------------------"
^DIC(9.4,35,22,3,"PAH",34,1,12,0)=" "
^DIC(9.4,35,22,3,"PAH",34,1,13,0)="I stumbled onto this minor problem.  If I access options in"
^DIC(9.4,35,22,3,"PAH",34,1,14,0)="the following order, I get my DUZ displayed instead of my name."
^DIC(9.4,35,22,3,"PAH",34,1,15,0)=" "
^DIC(9.4,35,22,3,"PAH",34,1,16,0)="PATIENT LIST MGMT MENU"
^DIC(9.4,35,22,3,"PAH",34,1,17,0)=" DISPLAY USER'S TEAMS"
^DIC(9.4,35,22,3,"PAH",34,1,18,0)="TEAM LIST MGMT MENU"
^DIC(9.4,35,22,3,"PAH",34,1,19,0)=" EXAMINE/PRINT EXISTING LIST(S)  <--- DUZ appears instead of user's name"
^DIC(9.4,35,22,3,"PAH",34,1,20,0)=" "
^DIC(9.4,35,22,3,"PAH",34,1,21,0)="Select Patient List Mgmt Menu Option [TEST]: ?"
^DIC(9.4,35,22,3,"PAH",34,1,22,0)=" "
^DIC(9.4,35,22,3,"PAH",34,1,23,0)="   PS     Patient Selection Preference Mgmt ..."
^DIC(9.4,35,22,3,"PAH",34,1,24,0)="   TM     Display User's Teams"
^DIC(9.4,35,22,3,"PAH",34,1,25,0)="   PT     Display Patients Linked to a User via Teams"
^DIC(9.4,35,22,3,"PAH",34,1,26,0)="   TE     Team List Mgmt Menu ..."
^DIC(9.4,35,22,3,"PAH",34,1,27,0)=" "
^DIC(9.4,35,22,3,"PAH",34,1,28,0)="Select Patient List Mgmt Menu Option [TEST]: TM  Display User's Teams"
^DIC(9.4,35,22,3,"PAH",34,1,29,0)=" "
^DIC(9.4,35,22,3,"PAH",34,1,30,0)="Find teams linked to user: SHAPIRO,NANCY//          NS     IRM"
^DIC(9.4,35,22,3,"PAH",34,1,31,0)=" "
^DIC(9.4,35,22,3,"PAH",34,1,32,0)=" "
^DIC(9.4,35,22,3,"PAH",34,1,33,0)="             SHAPIRO,NANCY IS ON THE FOLLOWING TEAMS:"
^DIC(9.4,35,22,3,"PAH",34,1,34,0)=" "
^DIC(9.4,35,22,3,"PAH",34,1,35,0)="12/31/97                                      PAGE:  001"
