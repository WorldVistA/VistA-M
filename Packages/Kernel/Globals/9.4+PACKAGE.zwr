^DIC(9.4,53,22,20,"PAH",260,1,210,0)="-----------                     ----          --------------------"
^DIC(9.4,53,22,20,"PAH",260,1,211,0)="PRCA ARDC REPORT                ROUTINE       NEW"
^DIC(9.4,53,22,20,"PAH",260,1,212,0)=" "
