^DIC(9.4,104,22,9,"PAH",28,1,1,0)="FIX LOADING HELP VIA NETWORK INSTALL"
^DIC(9.4,104,22,9,"PAH",29,0)="37 SEQ #29^3180425.173017^54"
^DIC(9.4,104,22,9,"PAH",29,1,0)="^^2^2^3180425"
^DIC(9.4,104,22,9,"PAH",29,1,1,0)="This patch will resolve the following issues in the Vitals Lite DLL"
