^DIC(9.4,11,22,5.03,"PAH",12,0)="48 SEQ #32^2990510^1"
^DIC(9.4,11,22,5.03,"PAH",12,1,0)="^^1^1^2990510"
^DIC(9.4,11,22,5.03,"PAH",12,1,1,0)="Fixes Date problems occurring after installation of Vitek's Y2K software. "
^DIC(9.4,11,22,5.03,"PAH",13,0)="47 SEQ #33^2990719^1"
^DIC(9.4,11,22,5.03,"PAH",13,1,0)="^^157^157^2990719"
^DIC(9.4,11,22,5.03,"PAH",13,1,1,0)="Patch LA*5.2*47 VISTA BLOOD BANK SOFTWARE V5.2 "
^DIC(9.4,11,22,5.03,"PAH",13,1,2,0)="DEVICE PRODUCT LABELING STATEMENT"
^DIC(9.4,11,22,5.03,"PAH",13,1,3,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,4,0)="May 10, 1999"
^DIC(9.4,11,22,5.03,"PAH",13,1,5,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,6,0)="VISTA Laboratory Package patch LA*5.2*47 contains no changes to software"
^DIC(9.4,11,22,5.03,"PAH",13,1,7,0)="controlled by VHA DIRECTIVE 97-033, titled VISTA BLOOD BANK SOFTWARE"
^DIC(9.4,11,22,5.03,"PAH",13,1,8,0)="VERSION 5.2."
^DIC(9.4,11,22,5.03,"PAH",13,1,9,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,10,0)="All changes have been reviewed by the VISTA Blood Bank Developer and found"
^DIC(9.4,11,22,5.03,"PAH",13,1,11,0)="to have no impact on the VISTA BLOOD BANK SOFTWARE version 5.2 control"
^DIC(9.4,11,22,5.03,"PAH",13,1,12,0)="functions."
^DIC(9.4,11,22,5.03,"PAH",13,1,13,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,14,0)="RISK ANALYSIS: Changes made by patch LA*5.2*47 have no effect on Blood"
^DIC(9.4,11,22,5.03,"PAH",13,1,15,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,11,22,5.03,"PAH",13,1,16,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,17,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LA*5.2*47 does not"
^DIC(9.4,11,22,5.03,"PAH",13,1,18,0)="alter or modify any software design safeguards or safety critical element"
^DIC(9.4,11,22,5.03,"PAH",13,1,19,0)="functions."
^DIC(9.4,11,22,5.03,"PAH",13,1,20,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,21,0)="POTENTIAL IMPACT ON SITES: This patch contains no changes to files and"
^DIC(9.4,11,22,5.03,"PAH",13,1,22,0)="routines identified in Veterans Health Administration (VHA) Directive"
^DIC(9.4,11,22,5.03,"PAH",13,1,23,0)="97-033. The changes that are made have no effect to Blood Bank"
^DIC(9.4,11,22,5.03,"PAH",13,1,24,0)="functionality or medical device control functions. There is no adverse"
^DIC(9.4,11,22,5.03,"PAH",13,1,25,0)="potential to sites."
^DIC(9.4,11,22,5.03,"PAH",13,1,26,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,27,0)="VALIDATION REQUIREMENTS BY OPTION: There are no required validation"
^DIC(9.4,11,22,5.03,"PAH",13,1,28,0)="scenarios to be completed by sites after installing this patch."
^DIC(9.4,11,22,5.03,"PAH",13,1,29,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,30,0)="========================================"
^DIC(9.4,11,22,5.03,"PAH",13,1,31,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,32,0)="Patch Description: "
^DIC(9.4,11,22,5.03,"PAH",13,1,33,0)="This is the companion patch for LR*5.2*221. Full description of ALL"
^DIC(9.4,11,22,5.03,"PAH",13,1,34,0)="enhancements are given in LR*5.2*221.  "
^DIC(9.4,11,22,5.03,"PAH",13,1,35,0)="  "
^DIC(9.4,11,22,5.03,"PAH",13,1,36,0)="This patch support the ability to purge Automated Instrument data based on"
^DIC(9.4,11,22,5.03,"PAH",13,1,37,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,38,0)="date range or inactivity range. This enhancement is to support Laboratory "
^DIC(9.4,11,22,5.03,"PAH",13,1,39,0)="Electronic Data Interchange (LEDI) sites ability to purge automated"
^DIC(9.4,11,22,5.03,"PAH",13,1,40,0)="instrument data based on user's supplied parameters.  "
^DIC(9.4,11,22,5.03,"PAH",13,1,41,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,42,0)="The functionality of this patch is coupled with the features and function"
^DIC(9.4,11,22,5.03,"PAH",13,1,43,0)="of patch LR*5.2*221. LA*5.2*47 is required for LR*5.2*221 installation."
^DIC(9.4,11,22,5.03,"PAH",13,1,44,0)="The functionality of the patch is expressed after patch LR*5.2*221 has"
^DIC(9.4,11,22,5.03,"PAH",13,1,45,0)="been installed."
^DIC(9.4,11,22,5.03,"PAH",13,1,46,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,47,0)="ONLY THE ROUTINE 'LAGEN' IS CONTAINED IN THIS PATCH. All other LR*"
^DIC(9.4,11,22,5.03,"PAH",13,1,48,0)="associated name spaced routines and options are contained in LR*5.2*221."
^DIC(9.4,11,22,5.03,"PAH",13,1,49,0)="The following options are transported and installed by LR*5.2*221."
^DIC(9.4,11,22,5.03,"PAH",13,1,50,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,51,0)="The 'Clear instrument/worklist data' [LRINSTCLR] option has been enhanced."
^DIC(9.4,11,22,5.03,"PAH",13,1,52,0)="The changes to this option implements selective clearing of instrument"
^DIC(9.4,11,22,5.03,"PAH",13,1,53,0)="data from the ^LAH global. When entries are made in the ^LAH global to"
^DIC(9.4,11,22,5.03,"PAH",13,1,54,0)="store instrument data pending verification, the date/time stamp of"
^DIC(9.4,11,22,5.03,"PAH",13,1,55,0)="creation and result updating is now recorded. This date will be used to"
^DIC(9.4,11,22,5.03,"PAH",13,1,56,0)="selectively remove data from the ^LAH global based on the date original"
^DIC(9.4,11,22,5.03,"PAH",13,1,57,0)="result was received or last updated."
^DIC(9.4,11,22,5.03,"PAH",13,1,58,0)="    If during the clearing process an entry in ^LAH global is found with"
^DIC(9.4,11,22,5.03,"PAH",13,1,59,0)="no date/time in the creation/update field, the current date/time is"
^DIC(9.4,11,22,5.03,"PAH",13,1,60,0)="entered into the entry. This entry is then eligible for clearing the next"
^DIC(9.4,11,22,5.03,"PAH",13,1,61,0)="time the option is ran."
^DIC(9.4,11,22,5.03,"PAH",13,1,62,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,63,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,64,0)=" The 'Clear instrument/worklist data' option will allow clearing by either"
^DIC(9.4,11,22,5.03,"PAH",13,1,65,0)="of the following ways. Data received before the selected date (optional"
^DIC(9.4,11,22,5.03,"PAH",13,1,66,0)="time) is purged. If you enter a date only then data received before that"
^DIC(9.4,11,22,5.03,"PAH",13,1,67,0)="date is cleared. If you enter a date/time then data received before that"
^DIC(9.4,11,22,5.03,"PAH",13,1,68,0)="date/time is cleared."
^DIC(9.4,11,22,5.03,"PAH",13,1,69,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,70,0)=" Example:"
^DIC(9.4,11,22,5.03,"PAH",13,1,71,0)="If you enter Sept 4, 1998 then data received through Sept 3, 1998 is"
^DIC(9.4,11,22,5.03,"PAH",13,1,72,0)="cleared. If you enter Sept 4, 1998 @1200 then data through Sept 4, 1998 is"
^DIC(9.4,11,22,5.03,"PAH",13,1,73,0)="cleared."
^DIC(9.4,11,22,5.03,"PAH",13,1,74,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,75,0)=" The following routines support purge enhancement:"
^DIC(9.4,11,22,5.03,"PAH",13,1,76,0)="   LAGEN [LA*5.2*47]- Changes were made to set date/time of entry creation"
^DIC(9.4,11,22,5.03,"PAH",13,1,77,0)="and last update. Last update can be different than creation date if data"
^DIC(9.4,11,22,5.03,"PAH",13,1,78,0)="is retransmitted (overlay data = yes) or additional results received."
^DIC(9.4,11,22,5.03,"PAH",13,1,79,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,80,0)="   LRLLS [LR*5.2*221]- Clear instrument data option that does actual"
^DIC(9.4,11,22,5.03,"PAH",13,1,81,0)="clearing based on user's parameters. User can purge by date/time or"
^DIC(9.4,11,22,5.03,"PAH",13,1,82,0)="blanket purge when using Clear instrument/worklist data [LRINSTCLR]"
^DIC(9.4,11,22,5.03,"PAH",13,1,83,0)="option."
^DIC(9.4,11,22,5.03,"PAH",13,1,84,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,85,0)="   LRVR1 [LR*5.2*221]-  Verifying routine with changes to setup date/time"
^DIC(9.4,11,22,5.03,"PAH",13,1,86,0)="information when manual data entry is used during Enter/Verify Automated"
^DIC(9.4,11,22,5.03,"PAH",13,1,87,0)="Instrument [LRVR] option."
^DIC(9.4,11,22,5.03,"PAH",13,1,88,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,89,0)="   LRVRW [LR*5.2*221]-  Verifying routine with changes to setup date/time"
^DIC(9.4,11,22,5.03,"PAH",13,1,90,0)="information when load/work list data entry is used during the Enter/verify"
^DIC(9.4,11,22,5.03,"PAH",13,1,91,0)="data (Work list) [LRVRW] option."
^DIC(9.4,11,22,5.03,"PAH",13,1,92,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,93,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,94,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,95,0)="Installation Instructions:"
^DIC(9.4,11,22,5.03,"PAH",13,1,96,0)="=========================="
^DIC(9.4,11,22,5.03,"PAH",13,1,97,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,98,0)="Required Patch Installation List:"
^DIC(9.4,11,22,5.03,"PAH",13,1,99,0)="LA*5.2*27"
^DIC(9.4,11,22,5.03,"PAH",13,1,100,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,101,0)="This patch is compatible with OERR 2.5 and both versions of CPRS ,GUI and"
^DIC(9.4,11,22,5.03,"PAH",13,1,102,0)="List Manager."
^DIC(9.4,11,22,5.03,"PAH",13,1,103,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,104,0)="         1. Use the 'INSTALL/CHECK MESSAGE' option on the PackMan "
^DIC(9.4,11,22,5.03,"PAH",13,1,105,0)="         menu. This option will load the KIDS package onto your system."
^DIC(9.4,11,22,5.03,"PAH",13,1,106,0)="         2. Review your mapped set.  If the routines are mapped,"
^DIC(9.4,11,22,5.03,"PAH",13,1,107,0)="         they should be removed from the mapped set at this time."
^DIC(9.4,11,22,5.03,"PAH",13,1,108,0)="         3. The patch has now been loaded into a Transport global "
^DIC(9.4,11,22,5.03,"PAH",13,1,109,0)="         on your system. You now need to use KIDS to install the "
^DIC(9.4,11,22,5.03,"PAH",13,1,110,0)="         Transport global."
^DIC(9.4,11,22,5.03,"PAH",13,1,111,0)="         "
^DIC(9.4,11,22,5.03,"PAH",13,1,112,0)="         On the KIDS menu, under the 'Installation' menu, use the"
^DIC(9.4,11,22,5.03,"PAH",13,1,113,0)="         following options:"
^DIC(9.4,11,22,5.03,"PAH",13,1,114,0)="                Print Transport Global"
^DIC(9.4,11,22,5.03,"PAH",13,1,115,0)="                Compare Transport Global to Current System"
^DIC(9.4,11,22,5.03,"PAH",13,1,116,0)="                Verify Checksums in Transport Global"
^DIC(9.4,11,22,5.03,"PAH",13,1,117,0)="                Backup a Transport Global"
^DIC(9.4,11,22,5.03,"PAH",13,1,118,0)="         4. Users may remain on the system, but installation "
^DIC(9.4,11,22,5.03,"PAH",13,1,119,0)="            should be done during off peak hours and when the Laboratory "
^DIC(9.4,11,22,5.03,"PAH",13,1,120,0)="            computer users are idle."
^DIC(9.4,11,22,5.03,"PAH",13,1,121,0)="         5. No options need to be placed out of service."
^DIC(9.4,11,22,5.03,"PAH",13,1,122,0)="         6. Installation time is less than 2 minutes during off "
^DIC(9.4,11,22,5.03,"PAH",13,1,123,0)="            peak hours, and less than 5 minutes during peak hours"
^DIC(9.4,11,22,5.03,"PAH",13,1,124,0)="            which is NOT RECOMMENDED."
^DIC(9.4,11,22,5.03,"PAH",13,1,125,0)="         7. Installation of this patch does not require any additional "
^DIC(9.4,11,22,5.03,"PAH",13,1,126,0)="            memory space."
^DIC(9.4,11,22,5.03,"PAH",13,1,127,0)="         8. From the 'Installation Menu' of the KIDS menu, run the "
^DIC(9.4,11,22,5.03,"PAH",13,1,128,0)="            option 'Install Package(s)'. Select the package "
^DIC(9.4,11,22,5.03,"PAH",13,1,129,0)="            'LA*5.2*47' and proceed with the install."
^DIC(9.4,11,22,5.03,"PAH",13,1,130,0)="         9. If any routines were unmapped as part of step 2, they "
^DIC(9.4,11,22,5.03,"PAH",13,1,131,0)="            should be returned to the mapped set once the "
^DIC(9.4,11,22,5.03,"PAH",13,1,132,0)="            installation has run to completion."
^DIC(9.4,11,22,5.03,"PAH",13,1,133,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,134,0)="======================"
^DIC(9.4,11,22,5.03,"PAH",13,1,135,0)="Test Sites:"
^DIC(9.4,11,22,5.03,"PAH",13,1,136,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,137,0)="Long Beach, CA"
^DIC(9.4,11,22,5.03,"PAH",13,1,138,0)="Milwaukee, WI"
^DIC(9.4,11,22,5.03,"PAH",13,1,139,0)="Loma Linda, CA"
^DIC(9.4,11,22,5.03,"PAH",13,1,140,0)="North Chicago, IL"
^DIC(9.4,11,22,5.03,"PAH",13,1,141,0)="West Palm Beach, FL"
^DIC(9.4,11,22,5.03,"PAH",13,1,142,0)="====================="
^DIC(9.4,11,22,5.03,"PAH",13,1,143,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,144,0)="DD Changes:"
^DIC(9.4,11,22,5.03,"PAH",13,1,145,0)="None"
^DIC(9.4,11,22,5.03,"PAH",13,1,146,0)="====================="
^DIC(9.4,11,22,5.03,"PAH",13,1,147,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,148,0)="Routine Listing:"
^DIC(9.4,11,22,5.03,"PAH",13,1,149,0)="The second line of the routine now looks like:"
^DIC(9.4,11,22,5.03,"PAH",13,1,150,0)="<TAB>  ;;5.2;AUTOMATED LAB INSTRUMENTS;**[Patch List]**;Sep 27, 1994"
^DIC(9.4,11,22,5.03,"PAH",13,1,151,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,152,0)="Routines:        Before       After           Patch"
^DIC(9.4,11,22,5.03,"PAH",13,1,153,0)="                 Check        Check           List"
^DIC(9.4,11,22,5.03,"PAH",13,1,154,0)="LA47             N/A          2222265         47"
^DIC(9.4,11,22,5.03,"PAH",13,1,155,0)="LAGEN           8395369       9445120      1,17,22,27,47"
^DIC(9.4,11,22,5.03,"PAH",13,1,156,0)=" "
^DIC(9.4,11,22,5.03,"PAH",13,1,157,0)="==================="
^DIC(9.4,11,22,5.03,"PAH",14,0)="51 SEQ #34^3000405^1"
^DIC(9.4,11,22,5.03,"PAH",14,1,0)="^^345^345^3000405"
^DIC(9.4,11,22,5.03,"PAH",14,1,1,0)="VISTA Laboratory Package patch LA*5.2*51 contains no changes to software"
^DIC(9.4,11,22,5.03,"PAH",14,1,2,0)="controlled by VHA DIRECTIVE 99-053, titled VISTA BLOOD BANK SOFTWARE."
^DIC(9.4,11,22,5.03,"PAH",14,1,3,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,4,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,5,0)="NOTE: PATCH HL*1.6*57 MUST BE INSTALLED PRIOR TO INSTALLATION OF THIS PATCH."
^DIC(9.4,11,22,5.03,"PAH",14,1,6,0)="      LA*5.2*51 SHOULD BE INSTALLED IMMEDIATELY FOLLOWING INSTALLATION OF"
^DIC(9.4,11,22,5.03,"PAH",14,1,7,0)="      PATCH HL*1.6*57 TO AVOID INTERRUPTION OF LABORATORY ELECTRONIC DATA"
^DIC(9.4,11,22,5.03,"PAH",14,1,8,0)="      INTERCHANGE (LEDI) HL7 MESSAGE TRANSMISSION."
^DIC(9.4,11,22,5.03,"PAH",14,1,9,0)="  "
^DIC(9.4,11,22,5.03,"PAH",14,1,10,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,11,0)="With the release of patch HL*1.6*57 several changes need to be made to the"
^DIC(9.4,11,22,5.03,"PAH",14,1,12,0)="Lab LEDI Setup [LA7V SETUP] option. Patch LA*5.2*51 will make the following"
^DIC(9.4,11,22,5.03,"PAH",14,1,13,0)="changes to allow Lab LEDI HL7 interfaces to continue to function."
^DIC(9.4,11,22,5.03,"PAH",14,1,14,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,15,0)=" 1. The patch removes references to HL LOWER LEVEL PROTOCOL PARAMETER file"
^DIC(9.4,11,22,5.03,"PAH",14,1,16,0)="    (#869.2) by the LEDI Setup [LA7V SETUP] option."
^DIC(9.4,11,22,5.03,"PAH",14,1,17,0)="  "
^DIC(9.4,11,22,5.03,"PAH",14,1,18,0)=" 2. The post-install deletes entries with the LA7V* namespace from the"
^DIC(9.4,11,22,5.03,"PAH",14,1,19,0)="    HL LOWER LEVEL PROTOCOL PARAMETER file (#869.2). This file is no longer"
^DIC(9.4,11,22,5.03,"PAH",14,1,20,0)="    used by the Health Level Seven (HL) software to store communication"
^DIC(9.4,11,22,5.03,"PAH",14,1,21,0)="    parameters. This data has been moved to the HL LOGICAL LINK file (#870)"
^DIC(9.4,11,22,5.03,"PAH",14,1,22,0)="    by patch HL*1.6*57."
^DIC(9.4,11,22,5.03,"PAH",14,1,23,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,24,0)=" 3. The post-install changes the name of protocol LA7V Order from xxx to"
^DIC(9.4,11,22,5.03,"PAH",14,1,25,0)="    LA7V Order to xxx in the PROTOCOL file (#101), where xxx is the VA"
^DIC(9.4,11,22,5.03,"PAH",14,1,26,0)="    station number that an order message (ORM) is being sent to."
^DIC(9.4,11,22,5.03,"PAH",14,1,27,0)="    The protocol was incorrectly named which could be confusing."
^DIC(9.4,11,22,5.03,"PAH",14,1,28,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,29,0)=" 4. The post-install deletes protocols that were previously setup by the"
^DIC(9.4,11,22,5.03,"PAH",14,1,30,0)="    LEDI Setup option but which are presently not being used."
^DIC(9.4,11,22,5.03,"PAH",14,1,31,0)="    If protocols are found with the following names they will be deleted:"
^DIC(9.4,11,22,5.03,"PAH",14,1,32,0)="     LA7V Query Response to xxx"
^DIC(9.4,11,22,5.03,"PAH",14,1,33,0)="     LA7V Query for Results from xxx"
^DIC(9.4,11,22,5.03,"PAH",14,1,34,0)="     LA7V Receive Query from xxx"
^DIC(9.4,11,22,5.03,"PAH",14,1,35,0)="     LA7V Send Query to xxx"
^DIC(9.4,11,22,5.03,"PAH",14,1,36,0)="     LA7V Send Response to xxx"
^DIC(9.4,11,22,5.03,"PAH",14,1,37,0)="     LA7V Order Response to xxx"
^DIC(9.4,11,22,5.03,"PAH",14,1,38,0)="     (where xxx is the VA station number)"
^DIC(9.4,11,22,5.03,"PAH",14,1,39,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,40,0)=" 5. The post-install converts and updates existing LA7V* protocols to"
^DIC(9.4,11,22,5.03,"PAH",14,1,41,0)="    conform to the new rules introduced by patch HL*1.6*57."
^DIC(9.4,11,22,5.03,"PAH",14,1,42,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,43,0)=" 6. The patch changes the LEDI Setup option to create protocols based on"
^DIC(9.4,11,22,5.03,"PAH",14,1,44,0)="    the rules implemented with patch HL*1.6*57."
^DIC(9.4,11,22,5.03,"PAH",14,1,45,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,46,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,47,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,48,0)="ASSOCIATED NOIS"
^DIC(9.4,11,22,5.03,"PAH",14,1,49,0)="---------------"
^DIC(9.4,11,22,5.03,"PAH",14,1,50,0)="  DUB-0300-30697 "
^DIC(9.4,11,22,5.03,"PAH",14,1,51,0)="  MUS-0200-71248"
^DIC(9.4,11,22,5.03,"PAH",14,1,52,0)="  PRE-0200-61136"
^DIC(9.4,11,22,5.03,"PAH",14,1,53,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,54,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,55,0)="TEST SITES"
^DIC(9.4,11,22,5.03,"PAH",14,1,56,0)="----------"
^DIC(9.4,11,22,5.03,"PAH",14,1,57,0)="  Battle Creek VAMC"
^DIC(9.4,11,22,5.03,"PAH",14,1,58,0)="  Dublin VAMC"
^DIC(9.4,11,22,5.03,"PAH",14,1,59,0)="  Indianapolis VAMC"
^DIC(9.4,11,22,5.03,"PAH",14,1,60,0)="  Milwaukee VAMC"
^DIC(9.4,11,22,5.03,"PAH",14,1,61,0)="  Muskogee VAMC"
^DIC(9.4,11,22,5.03,"PAH",14,1,62,0)="  Prescott VAMC"
^DIC(9.4,11,22,5.03,"PAH",14,1,63,0)="  West Palm Beach VAMC"
^DIC(9.4,11,22,5.03,"PAH",14,1,64,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,65,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,66,0)="ROUTINE SUMMARY"
^DIC(9.4,11,22,5.03,"PAH",14,1,67,0)="==============="
^DIC(9.4,11,22,5.03,"PAH",14,1,68,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,69,0)="  The following is a list of routines included in this patch."
^DIC(9.4,11,22,5.03,"PAH",14,1,70,0)="  The second line of each routine now looks like:"
^DIC(9.4,11,22,5.03,"PAH",14,1,71,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,72,0)="  <tab>;;5.2;AUTOMATED LAB INSTRUMENTS;**[Patch List]**;Sep 27, 1994"
^DIC(9.4,11,22,5.03,"PAH",14,1,73,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,74,0)="                    CHECK^XTSUMBLD results"
^DIC(9.4,11,22,5.03,"PAH",14,1,75,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,76,0)="                    Checksum       Checksum"
^DIC(9.4,11,22,5.03,"PAH",14,1,77,0)="   Routine Name     Before Patch   After Patch    Patch List"
^DIC(9.4,11,22,5.03,"PAH",14,1,78,0)="   ------------     ------------   -----------    ------------"
^DIC(9.4,11,22,5.03,"PAH",14,1,79,0)="   LA51             N/A            16393090       **51**"
^DIC(9.4,11,22,5.03,"PAH",14,1,80,0)="   LA7VLL           14468424       4967061        **27,51**"
^DIC(9.4,11,22,5.03,"PAH",14,1,81,0)="   LA7VORM1         20938223       20868841       **27,51**"
^DIC(9.4,11,22,5.03,"PAH",14,1,82,0)="   LA7VSET          29695063       19562009       **27,51**"
^DIC(9.4,11,22,5.03,"PAH",14,1,83,0)="   LA7VSET1         19867155       12823333       **27,51**"
^DIC(9.4,11,22,5.03,"PAH",14,1,84,0)="   LA7VSTP          24725864       6154318        **27,44,51**"
^DIC(9.4,11,22,5.03,"PAH",14,1,85,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,86,0)="   "
^DIC(9.4,11,22,5.03,"PAH",14,1,87,0)="    "
^DIC(9.4,11,22,5.03,"PAH",14,1,88,0)="************************************************************************ "
^DIC(9.4,11,22,5.03,"PAH",14,1,89,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,90,0)="Installation Instructions"
^DIC(9.4,11,22,5.03,"PAH",14,1,91,0)="========================="
^DIC(9.4,11,22,5.03,"PAH",14,1,92,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,93,0)="  The install time for this patch is less than 5 minutes. This patch"
^DIC(9.4,11,22,5.03,"PAH",14,1,94,0)="  can be installed with Laboratory users on the system. Recommend"
^DIC(9.4,11,22,5.03,"PAH",14,1,95,0)="  that the patch be installed during a period of minimum Laboratory"
^DIC(9.4,11,22,5.03,"PAH",14,1,96,0)="  package activity."
^DIC(9.4,11,22,5.03,"PAH",14,1,97,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,98,0)="  However, the following conditions apply:"
^DIC(9.4,11,22,5.03,"PAH",14,1,99,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,100,0)="     - All Lab LEDI (LA7V*) related HL v1.6 LLPs should be shutdown."
^DIC(9.4,11,22,5.03,"PAH",14,1,101,0)="       These LLPs are name spaced LA7V* when viewed in the HL package"
^DIC(9.4,11,22,5.03,"PAH",14,1,102,0)="       Systems Link Monitor [HL MESSAGE MONITOR] option."
^DIC(9.4,11,22,5.03,"PAH",14,1,103,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,104,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,105,0)="NOTE: Kernel, MailMan and HL patches must be current on the target system"
^DIC(9.4,11,22,5.03,"PAH",14,1,106,0)="      to avoid problems loading and/or installing this patch."
^DIC(9.4,11,22,5.03,"PAH",14,1,107,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,108,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,11,22,5.03,"PAH",14,1,109,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,11,22,5.03,"PAH",14,1,110,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,111,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,112,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,11,22,5.03,"PAH",14,1,113,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,114,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,11,22,5.03,"PAH",14,1,115,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,11,22,5.03,"PAH",14,1,116,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,117,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,11,22,5.03,"PAH",14,1,118,0)="      system.  You now need to use KIDS to install the transport global."
^DIC(9.4,11,22,5.03,"PAH",14,1,119,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,120,0)="  4.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,11,22,5.03,"PAH",14,1,121,0)="      select the 'Installation' menu."
^DIC(9.4,11,22,5.03,"PAH",14,1,122,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,123,0)="  5.  Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,11,22,5.03,"PAH",14,1,124,0)="      all routines have the correct checksums."
^DIC(9.4,11,22,5.03,"PAH",14,1,125,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,126,0)="  6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,11,22,5.03,"PAH",14,1,127,0)="      options:"
^DIC(9.4,11,22,5.03,"PAH",14,1,128,0)="        Print Transport Global"
^DIC(9.4,11,22,5.03,"PAH",14,1,129,0)="        Compare Transport Global to Current System"
^DIC(9.4,11,22,5.03,"PAH",14,1,130,0)="        Backup a Transport Global"
^DIC(9.4,11,22,5.03,"PAH",14,1,131,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,132,0)="      If you wish to preserve a copy of the routines exported in this patch"
^DIC(9.4,11,22,5.03,"PAH",14,1,133,0)="      prior to installation, you should use the 'Backup a Transport Global'"
^DIC(9.4,11,22,5.03,"PAH",14,1,134,0)="      option at this time.  You may also compare the routines in your"
^DIC(9.4,11,22,5.03,"PAH",14,1,135,0)="      production account to the routines in the patch by using the 'Compare"
^DIC(9.4,11,22,5.03,"PAH",14,1,136,0)="      a Transport Global to Current System' option."
^DIC(9.4,11,22,5.03,"PAH",14,1,137,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,138,0)="  7.  Perform the following step if applicable:"
^DIC(9.4,11,22,5.03,"PAH",14,1,139,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,140,0)="      All Lab LEDI (LA7V*) related HL v1.6 LLPs should be shutdown."
^DIC(9.4,11,22,5.03,"PAH",14,1,141,0)="      Use Start/Stop Links [HL START] option to shutdown these LLPs if"
^DIC(9.4,11,22,5.03,"PAH",14,1,142,0)="      they are running."
^DIC(9.4,11,22,5.03,"PAH",14,1,143,0)="   "
^DIC(9.4,11,22,5.03,"PAH",14,1,144,0)="  8.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,11,22,5.03,"PAH",14,1,145,0)="      and select the package 'LA*5.2*51'.  When prompted 'Want to"
^DIC(9.4,11,22,5.03,"PAH",14,1,146,0)="      DISABLE Scheduled Options, Menu Options, and Protocols? YES//',"
^DIC(9.4,11,22,5.03,"PAH",14,1,147,0)="      choose 'YES'."
^DIC(9.4,11,22,5.03,"PAH",14,1,148,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,149,0)="      Disable the LEDI Setup [LA7V LEDI] option by having KIDS mark the"
^DIC(9.4,11,22,5.03,"PAH",14,1,150,0)="      option 'Out Of Order'."
^DIC(9.4,11,22,5.03,"PAH",14,1,151,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,152,0)="  9.  On a mapped system, rebuild your map set."
^DIC(9.4,11,22,5.03,"PAH",14,1,153,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,154,0)=" 10.  Routine LA51 will be deleted after successful patch installation."
^DIC(9.4,11,22,5.03,"PAH",14,1,155,0)=""
^DIC(9.4,11,22,5.03,"PAH",14,1,156,0)=""
^DIC(9.4,11,22,5.03,"PAH",14,1,157,0)="Post-Installation Instructions:"
^DIC(9.4,11,22,5.03,"PAH",14,1,158,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,159,0)="  "
^DIC(9.4,11,22,5.03,"PAH",14,1,160,0)="1. Restart any LA7V* LLPs that were shutdown before patch installation."
^DIC(9.4,11,22,5.03,"PAH",14,1,161,0)="   Use Start/Stop Links [HL START] option."
^DIC(9.4,11,22,5.03,"PAH",14,1,162,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,163,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,164,0)=""
^DIC(9.4,11,22,5.03,"PAH",14,1,165,0)="************************************************************************ "
^DIC(9.4,11,22,5.03,"PAH",14,1,166,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,167,0)="Installation example: "
^DIC(9.4,11,22,5.03,"PAH",14,1,168,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,169,0)="Select Installation Option: 6  Install Package(s)"
^DIC(9.4,11,22,5.03,"PAH",14,1,170,0)="Select INSTALL NAME:    LA*5.2*51     Loaded from Distribution  3/3/00@14:53:29"
^DIC(9.4,11,22,5.03,"PAH",14,1,171,0)="     => LA*5.2*51"
^DIC(9.4,11,22,5.03,"PAH",14,1,172,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,173,0)="This Distribution was loaded on Mar 03, 2000@14:53:29 with header of"
^DIC(9.4,11,22,5.03,"PAH",14,1,174,0)="   LA*5.2*51"
^DIC(9.4,11,22,5.03,"PAH",14,1,175,0)="   It consisted of the following Install(s):"
^DIC(9.4,11,22,5.03,"PAH",14,1,176,0)="      LA*5.2*51"
^DIC(9.4,11,22,5.03,"PAH",14,1,177,0)="Checking Install for Package LA*5.2*51"
^DIC(9.4,11,22,5.03,"PAH",14,1,178,0)="Will first run the Environment Check Routine, LA51"
^DIC(9.4,11,22,5.03,"PAH",14,1,179,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,180,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,181,0)="                        --- Environment Check is Ok ---"
^DIC(9.4,11,22,5.03,"PAH",14,1,182,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,183,0)="Install Questions for LA*5.2*51"
^DIC(9.4,11,22,5.03,"PAH",14,1,184,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,185,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,186,0)="Want KIDS to Rebuild Menu Trees Upon Completion of Install? YES// NO"
^DIC(9.4,11,22,5.03,"PAH",14,1,187,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,188,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,189,0)="Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,11,22,5.03,"PAH",14,1,190,0)="Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES//"
^DIC(9.4,11,22,5.03,"PAH",14,1,191,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,192,0)="Enter options you wish to mark as 'Out Of Order': LA7V SETUP       LEDI Setup"
^DIC(9.4,11,22,5.03,"PAH",14,1,193,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,194,0)="Enter options you wish to mark as 'Out Of Order':"
^DIC(9.4,11,22,5.03,"PAH",14,1,195,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,196,0)="Enter protocols you wish to mark as 'Out Of Order':"
^DIC(9.4,11,22,5.03,"PAH",14,1,197,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,198,0)="Delay Install (Minutes):  (0-60): 0//"
^DIC(9.4,11,22,5.03,"PAH",14,1,199,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,200,0)="Enter the Device you want to print the Install messages."
^DIC(9.4,11,22,5.03,"PAH",14,1,201,0)="You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,11,22,5.03,"PAH",14,1,202,0)="Enter a '^' to abort the install."
^DIC(9.4,11,22,5.03,"PAH",14,1,203,0)=" "
^DIC(9.4,11,22,5.03,"PAH",14,1,204,0)="DEVICE: HOME//   TELNET VIRTUAL"
