^DIC(9.4,2,0)="KIDS^XPD^Kernel Installation & Distribution System"
^DIC(9.4,2,1,0)="^^3^3^2990601^^^^"
^DIC(9.4,2,1,1,0)="Kernel Installation and Distribution System first time install. This"
^DIC(9.4,2,1,2,0)="package is used to install Kernel for the first time. It will install"
^DIC(9.4,2,1,3,0)="a part of KIDS that will then allow you to use KIDS to install Kernel."
^DIC(9.4,2,4,0)="^9.44PA^3^2"
