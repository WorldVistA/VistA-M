^DIC(9.4,14,22,5.9,"PAH",125,1,363,0)="SFC-1299-60391"
^DIC(9.4,14,22,5.9,"PAH",125,1,364,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,365,0)=" A problem with Interim report by provider [LRRD] option which prints numerous"
^DIC(9.4,14,22,5.9,"PAH",125,1,366,0)=" provider name pages equal to the number of days the report is queued to"
^DIC(9.4,14,22,5.9,"PAH",125,1,367,0)=" print when printing a hard copy is fixed.  The provider name in large "
^DIC(9.4,14,22,5.9,"PAH",125,1,368,0)=" letters pages are no longer printed."
^DIC(9.4,14,22,5.9,"PAH",125,1,369,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,370,0)="ASSOCIATED NOIS:"
^DIC(9.4,14,22,5.9,"PAH",125,1,371,0)="================"
^DIC(9.4,14,22,5.9,"PAH",125,1,372,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,373,0)="IOW-0897-20334"
^DIC(9.4,14,22,5.9,"PAH",125,1,374,0)="PUG-0198-52088"
^DIC(9.4,14,22,5.9,"PAH",125,1,375,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,376,0)="**********************************************************************"
^DIC(9.4,14,22,5.9,"PAH",125,1,377,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,378,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",125,1,379,0)="========================="
^DIC(9.4,14,22,5.9,"PAH",125,1,380,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,381,0)="  The install time for this patch is less than 2 minutes. This patch"
^DIC(9.4,14,22,5.9,"PAH",125,1,382,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,14,22,5.9,"PAH",125,1,383,0)="  Suggested time to install: Off peak hours when cumulative and interim "
^DIC(9.4,14,22,5.9,"PAH",125,1,384,0)="  reports are not running."
^DIC(9.4,14,22,5.9,"PAH",125,1,385,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,386,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,387,0)="NOTE: Kernel patches must be current on the target system"
^DIC(9.4,14,22,5.9,"PAH",125,1,388,0)="      to avoid problems loading and/or installing this patch."
^DIC(9.4,14,22,5.9,"PAH",125,1,389,0)=""
^DIC(9.4,14,22,5.9,"PAH",125,1,390,0)=" ***** Kernel patch XU*8.0*217 must be installed prior to this patch.*****"
^DIC(9.4,14,22,5.9,"PAH",125,1,391,0)="       This patch contains the physical location address fields and an"
^DIC(9.4,14,22,5.9,"PAH",125,1,392,0)="       option to edit these fields.  Each site must assign the "
^DIC(9.4,14,22,5.9,"PAH",125,1,393,0)="       responsibility of data entry for the lab sites/institutions."
^DIC(9.4,14,22,5.9,"PAH",125,1,394,0)="       The person(s) responsible should be assigned the Kernel "
^DIC(9.4,14,22,5.9,"PAH",125,1,395,0)="       IMF address edit [XUMF IMF ADD EDIT] option to edit the physical address."
^DIC(9.4,14,22,5.9,"PAH",125,1,396,0)="      "
^DIC(9.4,14,22,5.9,"PAH",125,1,397,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,14,22,5.9,"PAH",125,1,398,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,14,22,5.9,"PAH",125,1,399,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,400,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,401,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,14,22,5.9,"PAH",125,1,402,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,403,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,14,22,5.9,"PAH",125,1,404,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,14,22,5.9,"PAH",125,1,405,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,406,0)="  3.  The patch has now been loaded into a Transport global on your"
^DIC(9.4,14,22,5.9,"PAH",125,1,407,0)="      system.  You now need to use KIDS to install the transport global."
^DIC(9.4,14,22,5.9,"PAH",125,1,408,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,409,0)="  4.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,14,22,5.9,"PAH",125,1,410,0)="      select the 'Installation' menu."
^DIC(9.4,14,22,5.9,"PAH",125,1,411,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,412,0)="  5.  Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,14,22,5.9,"PAH",125,1,413,0)="      all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",125,1,414,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,415,0)="  6.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,14,22,5.9,"PAH",125,1,416,0)="      options:"
^DIC(9.4,14,22,5.9,"PAH",125,1,417,0)="        Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",125,1,418,0)="        Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",125,1,419,0)="        Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",125,1,420,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,421,0)="      If you wish to preserve a copy of the routines exported in this "
^DIC(9.4,14,22,5.9,"PAH",125,1,422,0)="      patch prior to installation, you should use the 'Backup a Transport"
^DIC(9.4,14,22,5.9,"PAH",125,1,423,0)="      Global' option at this time.  You may also compare the routines in"
^DIC(9.4,14,22,5.9,"PAH",125,1,424,0)="      your production account to the routines in the patch by using the"
^DIC(9.4,14,22,5.9,"PAH",125,1,425,0)="      'Compare a Transport Global to Current System' option."
^DIC(9.4,14,22,5.9,"PAH",125,1,426,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,427,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,428,0)="  8.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,14,22,5.9,"PAH",125,1,429,0)="      and select the package 'LR*5.2*283'."
^DIC(9.4,14,22,5.9,"PAH",125,1,430,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,431,0)="      If prompted ' Want KIDS to Rebuild Menu Trees Upon Completion of "
^DIC(9.4,14,22,5.9,"PAH",125,1,432,0)="      Install? YES//' choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",125,1,433,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,434,0)="      If prompted ' Want KIDS to INHIBIT LOGONs during the install? YES// '"
^DIC(9.4,14,22,5.9,"PAH",125,1,435,0)="      choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",125,1,436,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,437,0)="      If prompted 'Want to DISABLE Scheduled Options, Menu Options, and"
^DIC(9.4,14,22,5.9,"PAH",125,1,438,0)="      Protocols? YES//', choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",125,1,439,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,440,0)="  9. On a mapped system, rebuild your map set."
^DIC(9.4,14,22,5.9,"PAH",125,1,441,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,442,0)=" 10. Routine LR283 will be deleted after successful patch installation."
^DIC(9.4,14,22,5.9,"PAH",125,1,443,0)=" "
^DIC(9.4,14,22,5.9,"PAH",125,1,444,0)="  "
^DIC(9.4,14,22,5.9,"PAH",126,0)="274^3030109^1"
^DIC(9.4,14,22,5.9,"PAH",126,1,0)="^^567^567^3030109"
^DIC(9.4,14,22,5.9,"PAH",126,1,1,0)="VISTA Laboratory Package patch LR*5.2*274 contains no changes to software "
^DIC(9.4,14,22,5.9,"PAH",126,1,2,0)="controlled by VHA DIRECTIVE 99-053, titled VISTA BLOOD BANK SOFTWARE.  "
^DIC(9.4,14,22,5.9,"PAH",126,1,3,0)="  "
^DIC(9.4,14,22,5.9,"PAH",126,1,4,0)="==================== "
^DIC(9.4,14,22,5.9,"PAH",126,1,5,0)="Patch Description:"
^DIC(9.4,14,22,5.9,"PAH",126,1,6,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,7,0)="(1) WKLD CODE (#64) file is updated with the latest released National "
^DIC(9.4,14,22,5.9,"PAH",126,1,8,0)="Laboratory Test (NLT) codes."
^DIC(9.4,14,22,5.9,"PAH",126,1,9,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,10,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,11,0)="(2) This patch allows the user to manually encode CPT codes for a given "
^DIC(9.4,14,22,5.9,"PAH",126,1,12,0)="accession. This method of CPT coding does not use the CPT codes "
^DIC(9.4,14,22,5.9,"PAH",126,1,13,0)="associated by the mapping of LABORATORY TEST file (#60) entries to WKLD "
^DIC(9.4,14,22,5.9,"PAH",126,1,14,0)="CODE file (#64)."
^DIC(9.4,14,22,5.9,"PAH",126,1,15,0)="    The user can select any appropriate CPT code(s) to identify the "
^DIC(9.4,14,22,5.9,"PAH",126,1,16,0)="professional service(s) rendered during this particular tissue exam. The "
^DIC(9.4,14,22,5.9,"PAH",126,1,17,0)="user can select from a pre-defined pick list or enter CPT codes "
^DIC(9.4,14,22,5.9,"PAH",126,1,18,0)="individually separated by commas "",""."
^DIC(9.4,14,22,5.9,"PAH",126,1,19,0)="    The pick list can be defined by editing the ES DISPLAY ORDER field "
^DIC(9.4,14,22,5.9,"PAH",126,1,20,0)="(#26) of the WKLD CODE file (#64). The number entered in the ES DISPLAY "
^DIC(9.4,14,22,5.9,"PAH",126,1,21,0)="ORDER field controls the order of CPT codes in the pick list. The "
^DIC(9.4,14,22,5.9,"PAH",126,1,22,0)="numerical order of the pick list uses the number entered in ES DISPLAY "
^DIC(9.4,14,22,5.9,"PAH",126,1,23,0)="ORDER field for each WKLD CODE defined."
^DIC(9.4,14,22,5.9,"PAH",126,1,24,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,25,0)="(3) The NLT Mapped Code Search [LRCAP64S] option has been changed to "
^DIC(9.4,14,22,5.9,"PAH",126,1,26,0)="correctly respond to the following prompt at the end of each page:"
^DIC(9.4,14,22,5.9,"PAH",126,1,27,0)="""Enter RETURN to continue or '^' to exit:"""
^DIC(9.4,14,22,5.9,"PAH",126,1,28,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,29,0)="======================= "
^DIC(9.4,14,22,5.9,"PAH",126,1,30,0)="New/Enhanced Options:"
^DIC(9.4,14,22,5.9,"PAH",126,1,31,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,32,0)="1. Edit or Print WKLD CODES [LR WKLD CODE EDIT PRINT] option has been "
^DIC(9.4,14,22,5.9,"PAH",126,1,33,0)="enhanced to include the new field ES DISPLAY ORDER (#26) of WKLD CODE "
^DIC(9.4,14,22,5.9,"PAH",126,1,34,0)="(#64) file. This option is used to print or edit fields in the WKLD CODE "
^DIC(9.4,14,22,5.9,"PAH",126,1,35,0)="(#64) file. "
^DIC(9.4,14,22,5.9,"PAH",126,1,36,0)="2. The new option LAB CPT BILLING [LRCAPES] has been created to provide "
^DIC(9.4,14,22,5.9,"PAH",126,1,37,0)="manual CPT billing and laboratory workload capture. The LAB CPT BILLING "
^DIC(9.4,14,22,5.9,"PAH",126,1,38,0)="option has no security key restriction. The option has been added to the "
^DIC(9.4,14,22,5.9,"PAH",126,1,39,0)="Verify/release menu, anat path [LRAPVR] option."
^DIC(9.4,14,22,5.9,"PAH",126,1,40,0)="    The LAB CPT BILLING option can be used anytime after the accession "
^DIC(9.4,14,22,5.9,"PAH",126,1,41,0)="has been created. If the accession has been purged, the option cannot be "
^DIC(9.4,14,22,5.9,"PAH",126,1,42,0)="used. The LAB CPT BILLING option has two functions:"
^DIC(9.4,14,22,5.9,"PAH",126,1,43,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,44,0)="   A.  If the procedure was ordered on a patient from PATIENT (#2) file, "
^DIC(9.4,14,22,5.9,"PAH",126,1,45,0)="from a location that has TYPE (#2) of CLINIC, MODULE or OTHER as defined "
^DIC(9.4,14,22,5.9,"PAH",126,1,46,0)="in the HOSPITAL LOCATION (#44) file, the user identified CPT codes will "
^DIC(9.4,14,22,5.9,"PAH",126,1,47,0)="be passed to the Laboratory PCE API. If the PCE API accepts the passed "
^DIC(9.4,14,22,5.9,"PAH",126,1,48,0)="data, the PCE ENC # (30) field of the ACCESSION NUMBER SUB-FIELD (#68.02 "
^DIC(9.4,14,22,5.9,"PAH",126,1,49,0)="of the DATE SUB-FIELD (68.01) of the ACCESSION (#68) file will be "
^DIC(9.4,14,22,5.9,"PAH",126,1,50,0)="populated with the PCE visit number. CPT billing can be done multiple "
^DIC(9.4,14,22,5.9,"PAH",126,1,51,0)="times for the same accession. "
^DIC(9.4,14,22,5.9,"PAH",126,1,52,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,53,0)="   B. The software will also capture the WKLD CODE(s) associated with the "
^DIC(9.4,14,22,5.9,"PAH",126,1,54,0)="ES DISPLAY ORDER number. This data will be captured as laboratory "
^DIC(9.4,14,22,5.9,"PAH",126,1,55,0)="workload. It will be reported based on the current LMIP workload "
^DIC(9.4,14,22,5.9,"PAH",126,1,56,0)="reporting protocol."
^DIC(9.4,14,22,5.9,"PAH",126,1,57,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,58,0)="3. Electronic Catalog Print [LA7S PRINT CATALOG] option [LA7S PRINT] "
^DIC(9.4,14,22,5.9,"PAH",126,1,59,0)="template has been modified to display the LEDI HL7 (#.09) field of the "
^DIC(9.4,14,22,5.9,"PAH",126,1,60,0)="TOPOGRAPHY FIELD (#61) file instead of the SNOMED CODE (#2) field. This "
^DIC(9.4,14,22,5.9,"PAH",126,1,61,0)="is to assist LEDI collection sites with defining the LAB SHIPPING "
^DIC(9.4,14,22,5.9,"PAH",126,1,62,0)="CONFIGURATION (#62.9) file."
^DIC(9.4,14,22,5.9,"PAH",126,1,63,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,64,0)="4. Print log book [LRAPBK] option has been enhanced to display a list of "
^DIC(9.4,14,22,5.9,"PAH",126,1,65,0)="CPT codes passed to PCE for outpatients. This option can also be used to "
^DIC(9.4,14,22,5.9,"PAH",126,1,66,0)="provide a partial audit of CPT coding practices."
^DIC(9.4,14,22,5.9,"PAH",126,1,67,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,68,0)="================="
^DIC(9.4,14,22,5.9,"PAH",126,1,69,0)="Required Patch List: LR*5.2*163"
^DIC(9.4,14,22,5.9,"PAH",126,1,70,0)="                     LR*5.2*264"
^DIC(9.4,14,22,5.9,"PAH",126,1,71,0)="                     LR*5.2*258"
^DIC(9.4,14,22,5.9,"PAH",126,1,72,0)="                     LR*5.2*266"
^DIC(9.4,14,22,5.9,"PAH",126,1,73,0)="================="
^DIC(9.4,14,22,5.9,"PAH",126,1,74,0)="NOIS:       SAM-1102-20599"
^DIC(9.4,14,22,5.9,"PAH",126,1,75,0)="            BHS-0990-11616 "
^DIC(9.4,14,22,5.9,"PAH",126,1,76,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,77,0)="================="
^DIC(9.4,14,22,5.9,"PAH",126,1,78,0)="Files:"
^DIC(9.4,14,22,5.9,"PAH",126,1,79,0)="There are no new files contained in this patch. However the following "
^DIC(9.4,14,22,5.9,"PAH",126,1,80,0)="files will be updated with additional data."
^DIC(9.4,14,22,5.9,"PAH",126,1,81,0)="(1) WKLD CODE (#64) file will be updated with any missing National "
^DIC(9.4,14,22,5.9,"PAH",126,1,82,0)="Laboratory Test (NLT) codes during the post installation phase. LAB "
^DIC(9.4,14,22,5.9,"PAH",126,1,83,0)="NLT/CPT CODES (#64.81) contains a complete listing of NLT codes. WKLD "
^DIC(9.4,14,22,5.9,"PAH",126,1,84,0)="CODE (#64) file is checked to determine if an NLT code should be added. "
^DIC(9.4,14,22,5.9,"PAH",126,1,85,0)="If the new NLT code is successfully added to WKLD CODE (#64) file or the "
^DIC(9.4,14,22,5.9,"PAH",126,1,86,0)="NLT code already exists, the entry in LAB NLT/CPT CODES (#64.81) file is "
^DIC(9.4,14,22,5.9,"PAH",126,1,87,0)="deleted."
^DIC(9.4,14,22,5.9,"PAH",126,1,88,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,89,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,90,0)="(2) The TEST/PROCEDURE (#.01) field of the SPECIMEN # (#1) subfile of LAB "
^DIC(9.4,14,22,5.9,"PAH",126,1,91,0)="ORDER ENTRY (#69) file, input screen has been changed to allow the entry "
^DIC(9.4,14,22,5.9,"PAH",126,1,92,0)="of LABORATORY TEST (#60) that have the TYPE (#3) field set to OUPUT. This "
^DIC(9.4,14,22,5.9,"PAH",126,1,93,0)="screen was changed in the software of an earlier released patch. The user "
^DIC(9.4,14,22,5.9,"PAH",126,1,94,0)="should see no difference in software behavior."
^DIC(9.4,14,22,5.9,"PAH",126,1,95,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,96,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,97,0)="(3) The DSS TEST NUMBER (#.01) field of the RESULT (#8) subfile of LAR "
^DIC(9.4,14,22,5.9,"PAH",126,1,98,0)="DSS LAR EXTRACT (#64.036) file has been increased from 50 to 300 to "
^DIC(9.4,14,22,5.9,"PAH",126,1,99,0)="accommodate patch ECX*3*47 number of tests to be extract."
^DIC(9.4,14,22,5.9,"PAH",126,1,100,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,101,0)="Below is a listing of files exported by this patch, indicating if the "
^DIC(9.4,14,22,5.9,"PAH",126,1,102,0)="imported file will contain additional data."
^DIC(9.4,14,22,5.9,"PAH",126,1,103,0)="                                           "
^DIC(9.4,14,22,5.9,"PAH",126,1,104,0)="FILE #      NAME                       With Data    "
^DIC(9.4,14,22,5.9,"PAH",126,1,105,0)="----------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",126,1,106,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,107,0)="64          WKLD CODE                    NO   "
^DIC(9.4,14,22,5.9,"PAH",126,1,108,0)="64.036      LAB DSS LAR EXTRACT          NO"
^DIC(9.4,14,22,5.9,"PAH",126,1,109,0)="64.2        WKLD SUFFIX CODES            YES"
^DIC(9.4,14,22,5.9,"PAH",126,1,110,0)="64.21       WKLD CODE LAB SECT           YES"
^DIC(9.4,14,22,5.9,"PAH",126,1,111,0)="64.22       WKLD ITEM FOR COUNT          YES"
^DIC(9.4,14,22,5.9,"PAH",126,1,112,0)="64.3        WKLD INSTRUMENT MANUFACTURER YES"
^DIC(9.4,14,22,5.9,"PAH",126,1,113,0)="64.81       LAB NLT/CPT CODES            YES"
^DIC(9.4,14,22,5.9,"PAH",126,1,114,0)="68          ACCESSION                    NO    "
^DIC(9.4,14,22,5.9,"PAH",126,1,115,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,116,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,117,0)="Note:"
^DIC(9.4,14,22,5.9,"PAH",126,1,118,0)="The LAB NLT/CPT CODES (#64.81) file is purged during the pre-installation "
^DIC(9.4,14,22,5.9,"PAH",126,1,119,0)="phase. This file is only used to update THE WKLD CODE (#64) file and has "
^DIC(9.4,14,22,5.9,"PAH",126,1,120,0)="no other purpose or function. This file will have no data after the post "
^DIC(9.4,14,22,5.9,"PAH",126,1,121,0)="installation routine has successfully run to completion."
^DIC(9.4,14,22,5.9,"PAH",126,1,122,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,123,0)="====================== "
^DIC(9.4,14,22,5.9,"PAH",126,1,124,0)="New Fields:"
^DIC(9.4,14,22,5.9,"PAH",126,1,125,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,126,0)="ES DISPLAY ORDER(#26) field has been added to the WKLD CODE (#64) file. "
^DIC(9.4,14,22,5.9,"PAH",126,1,127,0)="This field is used by the LAB CPT BILLING option to display a pick list "
^DIC(9.4,14,22,5.9,"PAH",126,1,128,0)="of those CPT codes defined by the NLT code. CPT codes can be selected by "
^DIC(9.4,14,22,5.9,"PAH",126,1,129,0)="using this number."
^DIC(9.4,14,22,5.9,"PAH",126,1,130,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,131,0)="PCE ENC # (#30) of ACCESSION NUMBER SUB-FIELD (#1) of ACCESSION (#68) "
^DIC(9.4,14,22,5.9,"PAH",126,1,132,0)="file has been added. This free text field contains a list of PCE Visit "
^DIC(9.4,14,22,5.9,"PAH",126,1,133,0)="numbers generated for this accession. If there are multiple visit numbers "
^DIC(9.4,14,22,5.9,"PAH",126,1,134,0)="for this accession they are separated by ';'. This field is only "
^DIC(9.4,14,22,5.9,"PAH",126,1,135,0)="populated if professional service PCE workload is generated. This is "
^DIC(9.4,14,22,5.9,"PAH",126,1,136,0)="usually the type of PCE workload generated by the Pathologist reporting "
^DIC(9.4,14,22,5.9,"PAH",126,1,137,0)="anatomic pathology services. PCE workload is only generated for those "
^DIC(9.4,14,22,5.9,"PAH",126,1,138,0)="hospital locations with the type of clinic, module or other. "
^DIC(9.4,14,22,5.9,"PAH",126,1,139,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,140,0)="Note:"
^DIC(9.4,14,22,5.9,"PAH",126,1,141,0)="No PCE workload is generated for inpatient locations."
^DIC(9.4,14,22,5.9,"PAH",126,1,142,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,143,0)="========================= "
^DIC(9.4,14,22,5.9,"PAH",126,1,144,0)="Modified Print Template:"
^DIC(9.4,14,22,5.9,"PAH",126,1,145,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,146,0)="Electronic Catalog Print [LA7S PRINT CATALOG] option LA7S PRINT template "
^DIC(9.4,14,22,5.9,"PAH",126,1,147,0)="has been changed to display the LEDI HL7 (#.09) field instead of SNOMED "
^DIC(9.4,14,22,5.9,"PAH",126,1,148,0)="CODE (#2) in TOPOGRAPHY FIELD (#61) field. The LEDI HL7 field is required "
^DIC(9.4,14,22,5.9,"PAH",126,1,149,0)="by LEDI collecting sites when defining tests to be sent to the Host "
^DIC(9.4,14,22,5.9,"PAH",126,1,150,0)="laboratory and shipping manifest. The LEDI HL7 specimen must match the "
^DIC(9.4,14,22,5.9,"PAH",126,1,151,0)="specimen the HOST laboratory requires."
^DIC(9.4,14,22,5.9,"PAH",126,1,152,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,153,0)="=========================="
^DIC(9.4,14,22,5.9,"PAH",126,1,154,0)="Input Template:"
^DIC(9.4,14,22,5.9,"PAH",126,1,155,0)="  Input Template [LR WKLD EDIT ALL] has been modified to allow editing of "
^DIC(9.4,14,22,5.9,"PAH",126,1,156,0)="all user definable fields in the WKLD CODE (#64) file. Most notable is "
^DIC(9.4,14,22,5.9,"PAH",126,1,157,0)="that the LOINC CODE (#4) field of the TIME ASPECT (#30) sub-file of the "
^DIC(9.4,14,22,5.9,"PAH",126,1,158,0)="WKLD CODE (#64) file. This template is very useful to delete or correct "
^DIC(9.4,14,22,5.9,"PAH",126,1,159,0)="LOINC CODE entry in the WKLD CODE (#64) file."
^DIC(9.4,14,22,5.9,"PAH",126,1,160,0)="  Input Template [LR WKLD ES CPT] is designed to allow quick editing of "
^DIC(9.4,14,22,5.9,"PAH",126,1,161,0)="the ES DISPLAY ORDER (#26) field and to edit all CODE (#18) sub-file "
^DIC(9.4,14,22,5.9,"PAH",126,1,162,0)="entries. The CODE sub-file is where CPT CODE assignments are entered. "
^DIC(9.4,14,22,5.9,"PAH",126,1,163,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,164,0)="========================="
^DIC(9.4,14,22,5.9,"PAH",126,1,165,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,166,0)="Test Sites: Muskogee, OK"
^DIC(9.4,14,22,5.9,"PAH",126,1,167,0)="            Long Beach, CA"
^DIC(9.4,14,22,5.9,"PAH",126,1,168,0)="            Durham, NC"
^DIC(9.4,14,22,5.9,"PAH",126,1,169,0)="            Lake City, FL"
^DIC(9.4,14,22,5.9,"PAH",126,1,170,0)="            Central Texas"
^DIC(9.4,14,22,5.9,"PAH",126,1,171,0)="            Gainesville, FL"
^DIC(9.4,14,22,5.9,"PAH",126,1,172,0)="            Boston, HCS"
^DIC(9.4,14,22,5.9,"PAH",126,1,173,0)="            St. Louis, MO"
^DIC(9.4,14,22,5.9,"PAH",126,1,174,0)="            "
^DIC(9.4,14,22,5.9,"PAH",126,1,175,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,176,0)="========================= "
^DIC(9.4,14,22,5.9,"PAH",126,1,177,0)="Routine Summary:"
^DIC(9.4,14,22,5.9,"PAH",126,1,178,0)=" "
^DIC(9.4,14,22,5.9,"PAH",126,1,179,0)="  The following is a list of the routine(s) included in this patch.  The"
^DIC(9.4,14,22,5.9,"PAH",126,1,180,0)="  second line of each of these routine(s) will look like:"
^DIC(9.4,14,22,5.9,"PAH",126,1,181,0)="  "
^DIC(9.4,14,22,5.9,"PAH",126,1,182,0)="      <tab>;;5.2;LAB SERVICE;**[patch list]**;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",126,1,183,0)="  "
^DIC(9.4,14,22,5.9,"PAH",126,1,184,0)="                             CHECK^XTSUMBLD results"
