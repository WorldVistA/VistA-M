^DIC(9.4,42,"VERSION")=2.7
^DIC(9.4,43,0)="LIST MANAGER^VALM^List Manager Developer Tool"
^DIC(9.4,43,4,0)="^9.44PA^1^1"
^DIC(9.4,43,4,1,0)=409.61
^DIC(9.4,43,4,1,222)="y^y^^n^^^n"
^DIC(9.4,43,4,"B",409.61,1)=""
^DIC(9.4,43,5)="ALBANY"
^DIC(9.4,43,7)="^^I"
^DIC(9.4,43,22,0)="^9.49I^6^1"
^DIC(9.4,43,22,1,0)="1.0^3051119^2960613"
^DIC(9.4,43,22,1,"PAH",0)="^9.4901^10^10"
^DIC(9.4,43,22,1,"PAH",1,0)="2^2980808^1"
^DIC(9.4,43,22,1,"PAH",1,1,0)="^^15^15^2980808"
^DIC(9.4,43,22,1,"PAH",1,1,1,0)="This patch is being released by Capacity Management (CM) in anticiptaion"
^DIC(9.4,43,22,1,"PAH",1,1,2,0)="of the national release of the Resource Usage Monitor (RUM) Version 1.0"
^DIC(9.4,43,22,1,"PAH",1,1,3,0)="software package."
^DIC(9.4,43,22,1,"PAH",1,1,4,0)=" "
^DIC(9.4,43,22,1,"PAH",1,1,5,0)="This patch will not affect the current versions of the RUM software that"
^DIC(9.4,43,22,1,"PAH",1,1,6,0)="are running at the sites.  Therefore, all DSM, MSM and OpenM-NT sites are"
^DIC(9.4,43,22,1,"PAH",1,1,7,0)="instructed to install this patch.  Test sites which had a pre-release of"
^DIC(9.4,43,22,1,"PAH",1,1,8,0)="the RUM software should also install this patch."
^DIC(9.4,43,22,1,"PAH",1,1,9,0)=" "
^DIC(9.4,43,22,1,"PAH",1,1,10,0)="The Capacity Management (CM) development team is removing obsolete"
^DIC(9.4,43,22,1,"PAH",1,1,11,0)="references to the Resource Usage Monitor (RUM) code.  CM has deemed that"
^DIC(9.4,43,22,1,"PAH",1,1,12,0)="these references are no longer necessary in order to monitor system"
^DIC(9.4,43,22,1,"PAH",1,1,13,0)="resource consumption.  The system workload data that was gleaned from the"
^DIC(9.4,43,22,1,"PAH",1,1,14,0)="existing code in these routines will be located within Kernel's menu"
^DIC(9.4,43,22,1,"PAH",1,1,15,0)="manager routines."
^DIC(9.4,43,22,1,"PAH",2,0)="3 SEQ #3^2991210^1"
^DIC(9.4,43,22,1,"PAH",2,1,0)="^^41^41^2991210"
^DIC(9.4,43,22,1,"PAH",2,1,1,0)=" "
^DIC(9.4,43,22,1,"PAH",2,1,2,0)="                        List Manager Print Problems"
^DIC(9.4,43,22,1,"PAH",2,1,3,0)=" "
^DIC(9.4,43,22,1,"PAH",2,1,4,0)="       This patch fixes a couple of problems reported by the CPRS Team."
^DIC(9.4,43,22,1,"PAH",2,1,5,0)="When printing the list or printing the screen an extra page feed would"
^DIC(9.4,43,22,1,"PAH",2,1,6,0)="cause a blank page before printing began.  Also, when the list item is"
^DIC(9.4,43,22,1,"PAH",2,1,7,0)="longer than the device's column width in characters, data could be lost or"
^DIC(9.4,43,22,1,"PAH",2,1,8,0)="hard to read. The software now eliminates the page feed and warns the user"
^DIC(9.4,43,22,1,"PAH",2,1,9,0)="that the list item may be too long to print properly."
^DIC(9.4,43,22,1,"PAH",2,1,10,0)=" "
^DIC(9.4,43,22,1,"PAH",2,1,11,0)="    This patch contains 2 routines."
^DIC(9.4,43,22,1,"PAH",2,1,12,0)=" "
^DIC(9.4,43,22,1,"PAH",2,1,13,0)="     Checksums were calculated by CHECK^XTSUMBLD"
^DIC(9.4,43,22,1,"PAH",2,1,14,0)=" "
^DIC(9.4,43,22,1,"PAH",2,1,15,0)="Routine      Before       After           Patch List"
^DIC(9.4,43,22,1,"PAH",2,1,16,0)=" "
^DIC(9.4,43,22,1,"PAH",2,1,17,0)="VALM         8568102      8970241         **1,3**"
^DIC(9.4,43,22,1,"PAH",2,1,18,0)="VALM1        5659194      6964336         **3**"
^DIC(9.4,43,22,1,"PAH",2,1,19,0)=" "
^DIC(9.4,43,22,1,"PAH",2,1,20,0)="============================================================"
^DIC(9.4,43,22,1,"PAH",2,1,21,0)=" "
^DIC(9.4,43,22,1,"PAH",2,1,22,0)="Installation Instructions:"
^DIC(9.4,43,22,1,"PAH",2,1,23,0)=" "
^DIC(9.4,43,22,1,"PAH",2,1,24,0)="1.  Users are allowed on the system, and this patch may be queued."
^DIC(9.4,43,22,1,"PAH",2,1,25,0)="    A ""clobber"" error may result if users are in these routines."
^DIC(9.4,43,22,1,"PAH",2,1,26,0)=" "
^DIC(9.4,43,22,1,"PAH",2,1,27,0)="2.  These routines are usually mapped, so you might have to"
^DIC(9.4,43,22,1,"PAH",2,1,28,0)="    disable mapping on those machines that allow mapping."
^DIC(9.4,43,22,1,"PAH",2,1,29,0)=" "
^DIC(9.4,43,22,1,"PAH",2,1,30,0)="3.  Use the ""Install/Check Message"" option on the PackMan menu to "
^DIC(9.4,43,22,1,"PAH",2,1,31,0)="    load the package."
^DIC(9.4,43,22,1,"PAH",2,1,32,0)=" "
^DIC(9.4,43,22,1,"PAH",2,1,33,0)="4.  On the KIDS menu use the following options:"
^DIC(9.4,43,22,1,"PAH",2,1,34,0)=" "
^DIC(9.4,43,22,1,"PAH",2,1,35,0)="     Veryify Checksums in Transport Global"
^DIC(9.4,43,22,1,"PAH",2,1,36,0)="     Print Transport Global (Optional)"
^DIC(9.4,43,22,1,"PAH",2,1,37,0)="     Compare Trasport Global to Current System"
^DIC(9.4,43,22,1,"PAH",2,1,38,0)="     Backup Transport Global"
^DIC(9.4,43,22,1,"PAH",2,1,39,0)="     Install VALM*1.0*3"
^DIC(9.4,43,22,1,"PAH",2,1,40,0)=" "
^DIC(9.4,43,22,1,"PAH",2,1,41,0)="5.  Reload mapped set if appropriate. "
^DIC(9.4,43,22,1,"PAH",3,0)="4 SEQ #4^3000626^1"
^DIC(9.4,43,22,1,"PAH",3,1,0)="^^62^62^3000626"
^DIC(9.4,43,22,1,"PAH",3,1,1,0)="Patch VALM*1.0*4"
^DIC(9.4,43,22,1,"PAH",3,1,2,0)=""
^DIC(9.4,43,22,1,"PAH",3,1,3,0)="NOIS: HUN-1198-20777"
^DIC(9.4,43,22,1,"PAH",3,1,4,0)="Test Site:  Huntington, WV"
^DIC(9.4,43,22,1,"PAH",3,1,5,0)="If the text contains control characters, it can mess up the printing and"
^DIC(9.4,43,22,1,"PAH",3,1,6,0)="cause List Manager to fail to print some lines of text.  This patch"
^DIC(9.4,43,22,1,"PAH",3,1,7,0)="checks text for control characters and strips any off before printing."
^DIC(9.4,43,22,1,"PAH",3,1,8,0)=""
^DIC(9.4,43,22,1,"PAH",3,1,9,0)="NOTE: Users should not be on the system during installation of this patch."
^DIC(9.4,43,22,1,"PAH",3,1,10,0)="If they are using any application which uses List Manager (e.g. CPRS,"
^DIC(9.4,43,22,1,"PAH",3,1,11,0)="Outpatient Pharmacy, Appointment Management), they may experience a Clobber"
^DIC(9.4,43,22,1,"PAH",3,1,12,0)="Error.  This patch requires MailMan patch XM*7.1*50. "
^DIC(9.4,43,22,1,"PAH",3,1,13,0)="============================================================================ "
^DIC(9.4,43,22,1,"PAH",3,1,14,0)=""
^DIC(9.4,43,22,1,"PAH",3,1,15,0)="ROUTINES:"
^DIC(9.4,43,22,1,"PAH",3,1,16,0)="The second line of the routine now looks like:"
^DIC(9.4,43,22,1,"PAH",3,1,17,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,43,22,1,"PAH",3,1,18,0)=" "
^DIC(9.4,43,22,1,"PAH",3,1,19,0)="              Before          After"
^DIC(9.4,43,22,1,"PAH",3,1,20,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,43,22,1,"PAH",3,1,21,0)="--------------------------------------------------------------"
^DIC(9.4,43,22,1,"PAH",3,1,22,0)="VALM4          6209662         6275971        4"
^DIC(9.4,43,22,1,"PAH",3,1,23,0)=""
^DIC(9.4,43,22,1,"PAH",3,1,24,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,43,22,1,"PAH",3,1,25,0)=""
^DIC(9.4,43,22,1,"PAH",3,1,26,0)="This patch introduces no new routines."
^DIC(9.4,43,22,1,"PAH",3,1,27,0)="==========================================================================="
^DIC(9.4,43,22,1,"PAH",3,1,28,0)=" "
^DIC(9.4,43,22,1,"PAH",3,1,29,0)="INSTALLATION:"
^DIC(9.4,43,22,1,"PAH",3,1,30,0)="NOTE: Users should not be on the system during installation of this patch."
^DIC(9.4,43,22,1,"PAH",3,1,31,0)="If they are using any application which uses List Manager (e.g. CPRS,"
^DIC(9.4,43,22,1,"PAH",3,1,32,0)="Outpatient Pharmacy, Appointment Management), they may experience a Clobber"
^DIC(9.4,43,22,1,"PAH",3,1,33,0)="Error.  This patch requires MailMan patch XM*7.1*50. "
^DIC(9.4,43,22,1,"PAH",3,1,34,0)="1.  Users should NOT be on the system during installation of this patch."
^DIC(9.4,43,22,1,"PAH",3,1,35,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,43,22,1,"PAH",3,1,36,0)="    affected routine(s).  "
^DIC(9.4,43,22,1,"PAH",3,1,37,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,43,22,1,"PAH",3,1,38,0)="    the patch into a Transport Global on your system.  "
^DIC(9.4,43,22,1,"PAH",3,1,39,0)="4.  You do not need to stop TaskMan."
^DIC(9.4,43,22,1,"PAH",3,1,40,0)="    Users should NOT be on the system."
^DIC(9.4,43,22,1,"PAH",3,1,41,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,43,22,1,"PAH",3,1,42,0)="    Transport Global:"
^DIC(9.4,43,22,1,"PAH",3,1,43,0)="       Verify Checksums in Transport Global"
^DIC(9.4,43,22,1,"PAH",3,1,44,0)="       Print Transport Global"
^DIC(9.4,43,22,1,"PAH",3,1,45,0)="       Compare Transport Global to Current System"
^DIC(9.4,43,22,1,"PAH",3,1,46,0)="       Backup a Transport Global"
^DIC(9.4,43,22,1,"PAH",3,1,47,0)="       Install Package(s)"
^DIC(9.4,43,22,1,"PAH",3,1,48,0)=" Select INSTALL NAME:    VALM*1.0*4    Loaded from Distribution  <date/time>"
^DIC(9.4,43,22,1,"PAH",3,1,49,0)="                         =========="
^DIC(9.4,43,22,1,"PAH",3,1,50,0)=" Install Questions:"
^DIC(9.4,43,22,1,"PAH",3,1,51,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,43,22,1,"PAH",3,1,52,0)="                                                       =="
^DIC(9.4,43,22,1,"PAH",3,1,53,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,43,22,1,"PAH",3,1,54,0)="                                                                       =="
^DIC(9.4,43,22,1,"PAH",3,1,55,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,43,22,1,"PAH",3,1,56,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,43,22,1,"PAH",3,1,57,0)=" Enter a '^' to abort the install."
^DIC(9.4,43,22,1,"PAH",3,1,58,0)=""
^DIC(9.4,43,22,1,"PAH",3,1,59,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,43,22,1,"PAH",3,1,60,0)="                ------------------------------------------------"
^DIC(9.4,43,22,1,"PAH",3,1,61,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,43,22,1,"PAH",3,1,62,0)="==========================================================================="
^DIC(9.4,43,22,1,"PAH",4,0)="1 SEQ #1"
^DIC(9.4,43,22,1,"PAH",5,0)="5 SEQ #5^3000711^1"
^DIC(9.4,43,22,1,"PAH",5,1,0)="^^107^107^3000711"
^DIC(9.4,43,22,1,"PAH",5,1,1,0)="Patch VALM*1.0*5"
^DIC(9.4,43,22,1,"PAH",5,1,2,0)=""
^DIC(9.4,43,22,1,"PAH",5,1,3,0)="NOIS: BAC-1299-40994, BIG-0100-70871, BUT-0200-20477, CHA-1299-30668,"
^DIC(9.4,43,22,1,"PAH",5,1,4,0)="      CLL-0300-40521, CMO-1299-40623, FAV-0200-71768, HUN-1299-20803,"
^DIC(9.4,43,22,1,"PAH",5,1,5,0)="      IOW-0200-40725, LOM-1299-61417, MAD-1299-40809, STL-1299-40640,"
^DIC(9.4,43,22,1,"PAH",5,1,6,0)="      WIM-1299-20665"
^DIC(9.4,43,22,1,"PAH",5,1,7,0)="Test Sites:  Columbia, MO; Butler, PA; Battle Creek, MI; Wilmington, DE"
^DIC(9.4,43,22,1,"PAH",5,1,8,0)=""
^DIC(9.4,43,22,1,"PAH",5,1,9,0)="Background: Patch VALM*1.0*3 introduced an error when printing directly (not"
^DIC(9.4,43,22,1,"PAH",5,1,10,0)="queued) to a device.  Although patch VALM*1.0*3 was subsequently marked"
^DIC(9.4,43,22,1,"PAH",5,1,11,0)="""entered in error"", many sites did not back it out, because it also contained"
^DIC(9.4,43,22,1,"PAH",5,1,12,0)="some desired new features.  Patch VALM*1.0*3 remains ""entered in error""."
^DIC(9.4,43,22,1,"PAH",5,1,13,0)=""
^DIC(9.4,43,22,1,"PAH",5,1,14,0)="Patch VALM*1.0*5 replaces patch VALM*1.0*3.  It corrects the errors and"
^DIC(9.4,43,22,1,"PAH",5,1,15,0)="retains the desired features introduced in patch VALM*1.0*3."
^DIC(9.4,43,22,1,"PAH",5,1,16,0)="When printing a list (PL) or printing a screen (PS):"
^DIC(9.4,43,22,1,"PAH",5,1,17,0)="  - Do not eject an extra blank page before starting the print."
^DIC(9.4,43,22,1,"PAH",5,1,18,0)="  - If the list item width is greater than the device width, print a warning"
^DIC(9.4,43,22,1,"PAH",5,1,19,0)="    message."
^DIC(9.4,43,22,1,"PAH",5,1,20,0)=""
^DIC(9.4,43,22,1,"PAH",5,1,21,0)="NOTE: Users should not be on the system during installation of this patch."
^DIC(9.4,43,22,1,"PAH",5,1,22,0)="If they are using any application which uses List Manager (e.g. CPRS,"
^DIC(9.4,43,22,1,"PAH",5,1,23,0)="Outpatient Pharmacy, Appointment Management), they may experience a Clobber"
^DIC(9.4,43,22,1,"PAH",5,1,24,0)="Error.  This patch requires patch VALM*1.0*1. "
^DIC(9.4,43,22,1,"PAH",5,1,25,0)="============================================================================ "
^DIC(9.4,43,22,1,"PAH",5,1,26,0)=""
^DIC(9.4,43,22,1,"PAH",5,1,27,0)="ROUTINES:"
^DIC(9.4,43,22,1,"PAH",5,1,28,0)="The second line of the routine now looks like:"
^DIC(9.4,43,22,1,"PAH",5,1,29,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,43,22,1,"PAH",5,1,30,0)=" "
^DIC(9.4,43,22,1,"PAH",5,1,31,0)="              Before          After"
^DIC(9.4,43,22,1,"PAH",5,1,32,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,43,22,1,"PAH",5,1,33,0)="--------------------------------------------------------------"
^DIC(9.4,43,22,1,"PAH",5,1,34,0)="VALM           8568102         8596069        1,5"
^DIC(9.4,43,22,1,"PAH",5,1,35,0)="VALM1          5659194         6138029        5"
^DIC(9.4,43,22,1,"PAH",5,1,36,0)=""
^DIC(9.4,43,22,1,"PAH",5,1,37,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,43,22,1,"PAH",5,1,38,0)=""
^DIC(9.4,43,22,1,"PAH",5,1,39,0)="This patch introduces no new routines."
^DIC(9.4,43,22,1,"PAH",5,1,40,0)="==========================================================================="
^DIC(9.4,43,22,1,"PAH",5,1,41,0)=" "
^DIC(9.4,43,22,1,"PAH",5,1,42,0)="INSTALLATION:"
^DIC(9.4,43,22,1,"PAH",5,1,43,0)="NOTE: Users should not be on the system during installation of this patch."
^DIC(9.4,43,22,1,"PAH",5,1,44,0)="If they are using any application which uses List Manager (e.g. CPRS,"
^DIC(9.4,43,22,1,"PAH",5,1,45,0)="Outpatient Pharmacy, Appointment Management), they may experience a Clobber"
^DIC(9.4,43,22,1,"PAH",5,1,46,0)="Error.  This patch requires patch VALM*1.0*1. "
^DIC(9.4,43,22,1,"PAH",5,1,47,0)="1.  Users should NOT be on the system during installation of this patch."
^DIC(9.4,43,22,1,"PAH",5,1,48,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,43,22,1,"PAH",5,1,49,0)="    affected routine(s).  "
^DIC(9.4,43,22,1,"PAH",5,1,50,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,43,22,1,"PAH",5,1,51,0)="    the patch into a Transport Global on your system."
^DIC(9.4,43,22,1,"PAH",5,1,52,0)="    If it loads, go on to step 4."
^DIC(9.4,43,22,1,"PAH",5,1,53,0)="    If you get the following error message:"
^DIC(9.4,43,22,1,"PAH",5,1,54,0)="**INSTALL ABORTED** Patch VALM*1.0*1 is Required to install this package!!"
^DIC(9.4,43,22,1,"PAH",5,1,55,0)="VALM*1.0*5 Build will not be installed, Transport Global deleted! "
^DIC(9.4,43,22,1,"PAH",5,1,56,0)="    and you are sure that you have installed VALM*1.0*1, you probably need"
^DIC(9.4,43,22,1,"PAH",5,1,57,0)="    to use FileMan to edit the package entry as follows.  (This problem was"
^DIC(9.4,43,22,1,"PAH",5,1,58,0)="    caused because VALM*1.0*1 was released without a package file link.)"
^DIC(9.4,43,22,1,"PAH",5,1,59,0)="D Q^DI"
^DIC(9.4,43,22,1,"PAH",5,1,60,0)="Select OPTION: ENTER OR EDIT FILE ENTRIES"
^DIC(9.4,43,22,1,"PAH",5,1,61,0)="               ====="
^DIC(9.4,43,22,1,"PAH",5,1,62,0)="INPUT TO WHAT FILE: PACKAGE// <press enter>"
^DIC(9.4,43,22,1,"PAH",5,1,63,0)="EDIT WHICH FIELD: ALL// 22  VERSION  (multiple)"
^DIC(9.4,43,22,1,"PAH",5,1,64,0)="                        =="
^DIC(9.4,43,22,1,"PAH",5,1,65,0)="   EDIT WHICH VERSION SUB-FIELD: ALL// 1105  PATCH APPLICATION HISTORY"
^DIC(9.4,43,22,1,"PAH",5,1,66,0)="(multiple)                             ===="
^DIC(9.4,43,22,1,"PAH",5,1,67,0)="      EDIT WHICH PATCH APPLICATION HISTORY SUB-FIELD: ALL// .01  PATCH"
^DIC(9.4,43,22,1,"PAH",5,1,68,0)="APPLICATION HISTORY                                         ==="
^DIC(9.4,43,22,1,"PAH",5,1,69,0)="      THEN EDIT PATCH APPLICATION HISTORY SUB-FIELD: <press enter>"
^DIC(9.4,43,22,1,"PAH",5,1,70,0)="   THEN EDIT VERSION SUB-FIELD: <press enter>"
^DIC(9.4,43,22,1,"PAH",5,1,71,0)="THEN EDIT FIELD: <press enter>"
^DIC(9.4,43,22,1,"PAH",5,1,72,0)=""
^DIC(9.4,43,22,1,"PAH",5,1,73,0)="Select PACKAGE NAME: VALM  LIST MANAGER     VALM"
^DIC(9.4,43,22,1,"PAH",5,1,74,0)="                     ===="
^DIC(9.4,43,22,1,"PAH",5,1,75,0)="Select VERSION: 1.0// <press enter>"
^DIC(9.4,43,22,1,"PAH",5,1,76,0)="  Select PATCH APPLICATION HISTORY: 1 SEQ #1"
^DIC(9.4,43,22,1,"PAH",5,1,77,0)="                                    ========"
^DIC(9.4,43,22,1,"PAH",5,1,78,0)="  Are you adding '1 SEQ #1' as "
^DIC(9.4,43,22,1,"PAH",5,1,79,0)="    a new PATCH APPLICATION HISTORY (the 3RD for this VERSION)? No// Y  (Yes)"
^DIC(9.4,43,22,1,"PAH",5,1,80,0)="                                                                    ==="
^DIC(9.4,43,22,1,"PAH",5,1,81,0)="  Select PATCH APPLICATION HISTORY: <press enter>"
^DIC(9.4,43,22,1,"PAH",5,1,82,0)="    Now try loading it again."
^DIC(9.4,43,22,1,"PAH",5,1,83,0)=""
^DIC(9.4,43,22,1,"PAH",5,1,84,0)="4.  You do not need to stop TaskMan."
^DIC(9.4,43,22,1,"PAH",5,1,85,0)="    Users should NOT be on the system."
^DIC(9.4,43,22,1,"PAH",5,1,86,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,43,22,1,"PAH",5,1,87,0)="    Transport Global:"
^DIC(9.4,43,22,1,"PAH",5,1,88,0)="       Verify Checksums in Transport Global"
^DIC(9.4,43,22,1,"PAH",5,1,89,0)="       Print Transport Global"
^DIC(9.4,43,22,1,"PAH",5,1,90,0)="       Compare Transport Global to Current System"
^DIC(9.4,43,22,1,"PAH",5,1,91,0)="       Backup a Transport Global"
^DIC(9.4,43,22,1,"PAH",5,1,92,0)="       Install Package(s)"
^DIC(9.4,43,22,1,"PAH",5,1,93,0)=" Select INSTALL NAME:    VALM*1.0*5    Loaded from Distribution  <date/time>"
^DIC(9.4,43,22,1,"PAH",5,1,94,0)="                         =========="
^DIC(9.4,43,22,1,"PAH",5,1,95,0)=" Install Questions:"
^DIC(9.4,43,22,1,"PAH",5,1,96,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,43,22,1,"PAH",5,1,97,0)="                                                       =="
^DIC(9.4,43,22,1,"PAH",5,1,98,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,43,22,1,"PAH",5,1,99,0)="                                                                       =="
^DIC(9.4,43,22,1,"PAH",5,1,100,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,43,22,1,"PAH",5,1,101,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,43,22,1,"PAH",5,1,102,0)=" Enter a '^' to abort the install."
^DIC(9.4,43,22,1,"PAH",5,1,103,0)=""
^DIC(9.4,43,22,1,"PAH",5,1,104,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,43,22,1,"PAH",5,1,105,0)="                ------------------------------------------------"
^DIC(9.4,43,22,1,"PAH",5,1,106,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,43,22,1,"PAH",5,1,107,0)="==========================================================================="
^DIC(9.4,43,22,1,"PAH",6,0)="6 SEQ #6^3010228^1"
^DIC(9.4,43,22,1,"PAH",6,1,0)="^^83^83^3010228"
^DIC(9.4,43,22,1,"PAH",6,1,1,0)="Patch VALM*1.0*6"
^DIC(9.4,43,22,1,"PAH",6,1,2,0)=""
^DIC(9.4,43,22,1,"PAH",6,1,3,0)="NOIS: ZZZ-1200-N0512"
^DIC(9.4,43,22,1,"PAH",6,1,4,0)="Test Site:  FORUM, CPRS"
^DIC(9.4,43,22,1,"PAH",6,1,5,0)=""
^DIC(9.4,43,22,1,"PAH",6,1,6,0)="Recognize up-arrow so that the user can exit help text smoothly."
^DIC(9.4,43,22,1,"PAH",6,1,7,0)=""
^DIC(9.4,43,22,1,"PAH",6,1,8,0)="Also, List Manager no longer calls its Date/Time or string manipulation"
^DIC(9.4,43,22,1,"PAH",6,1,9,0)="APIs.  Instead, it calls the equivalent Kernel APIs.  (The ListManager"
^DIC(9.4,43,22,1,"PAH",6,1,10,0)="APIs have not been changed at all.)  Although these APIs will continue"
^DIC(9.4,43,22,1,"PAH",6,1,11,0)="to be supported, applications which use them might consider switching"
^DIC(9.4,43,22,1,"PAH",6,1,12,0)="to the standard Kernel APIs, too."
^DIC(9.4,43,22,1,"PAH",6,1,13,0)=""
^DIC(9.4,43,22,1,"PAH",6,1,14,0)="The following are the ListManager APIs which are no longer called,"
^DIC(9.4,43,22,1,"PAH",6,1,15,0)="along with their Kernel equivalents:"
^DIC(9.4,43,22,1,"PAH",6,1,16,0)=""
^DIC(9.4,43,22,1,"PAH",6,1,17,0)="ListManager           Kernel"
^DIC(9.4,43,22,1,"PAH",6,1,18,0)="-----------           ------"
^DIC(9.4,43,22,1,"PAH",6,1,19,0)="$$FDATE^VALM1(X)      $$FMTE^XLFDT(X,""2D"")"
^DIC(9.4,43,22,1,"PAH",6,1,20,0)="$$FTIME^VALM1(X)      $$FMTE^XLFDT(X)"
^DIC(9.4,43,22,1,"PAH",6,1,21,0)="$$FDTTM^VALM1(X)      $$FMTE^XLFDT(X,2)"
^DIC(9.4,43,22,1,"PAH",6,1,22,0)="$$NOW^VALM1()         $$FMTE^XLFDT($$NOW^XLFDT)"
^DIC(9.4,43,22,1,"PAH",6,1,23,0)="$$UPPER^VALM1(X)      $$UP^XLFSTR(X)"
^DIC(9.4,43,22,1,"PAH",6,1,24,0)="$$LOWER^VALM1(X)      no equivalent - too esoteric"
^DIC(9.4,43,22,1,"PAH",6,1,25,0)=""
^DIC(9.4,43,22,1,"PAH",6,1,26,0)="NOTE: Users should not be on the system during installation of this patch."
^DIC(9.4,43,22,1,"PAH",6,1,27,0)="If they are using any application which uses List Manager (e.g. CPRS,"
^DIC(9.4,43,22,1,"PAH",6,1,28,0)="Outpatient Pharmacy, Appointment Management), they may experience a Clobber"
^DIC(9.4,43,22,1,"PAH",6,1,29,0)="Error.  This patch requires patch VALM*1.0*4 and VALM*1.0*5."
^DIC(9.4,43,22,1,"PAH",6,1,30,0)="============================================================================ "
^DIC(9.4,43,22,1,"PAH",6,1,31,0)=""
^DIC(9.4,43,22,1,"PAH",6,1,32,0)="ROUTINES:"
^DIC(9.4,43,22,1,"PAH",6,1,33,0)="The second line of the routine now looks like:"
^DIC(9.4,43,22,1,"PAH",6,1,34,0)="       ;;1.0;List Manager;**[patch list]**;Aug 13, 1993"
^DIC(9.4,43,22,1,"PAH",6,1,35,0)=" "
^DIC(9.4,43,22,1,"PAH",6,1,36,0)="              Before          After"
^DIC(9.4,43,22,1,"PAH",6,1,37,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,43,22,1,"PAH",6,1,38,0)="--------------------------------------------------------------"
^DIC(9.4,43,22,1,"PAH",6,1,39,0)="VALM           8596069         8483757        1,5,6"
^DIC(9.4,43,22,1,"PAH",6,1,40,0)="VALM1          6138029         6406024        5,6"
^DIC(9.4,43,22,1,"PAH",6,1,41,0)="VALM11         1873339         1738235        6"
^DIC(9.4,43,22,1,"PAH",6,1,42,0)="VALM2          5605143         4952899        6"
^DIC(9.4,43,22,1,"PAH",6,1,43,0)="VALM4          6275971         6223503        4,6"
^DIC(9.4,43,22,1,"PAH",6,1,44,0)="VALM40         6770263         6733503        6"
^DIC(9.4,43,22,1,"PAH",6,1,45,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,43,22,1,"PAH",6,1,46,0)=""
^DIC(9.4,43,22,1,"PAH",6,1,47,0)="This patch introduces no new routines."
^DIC(9.4,43,22,1,"PAH",6,1,48,0)="==========================================================================="
^DIC(9.4,43,22,1,"PAH",6,1,49,0)=" "
^DIC(9.4,43,22,1,"PAH",6,1,50,0)="INSTALLATION:"
^DIC(9.4,43,22,1,"PAH",6,1,51,0)="NOTE: Users should not be on the system during installation of this patch."
^DIC(9.4,43,22,1,"PAH",6,1,52,0)="If they are using any application which uses List Manager (e.g. CPRS,"
^DIC(9.4,43,22,1,"PAH",6,1,53,0)="Outpatient Pharmacy, Appointment Management), they may experience a Clobber"
^DIC(9.4,43,22,1,"PAH",6,1,54,0)="Error.  This patch requires patch VALM*1.0*4 and VALM*1.0*5."
^DIC(9.4,43,22,1,"PAH",6,1,55,0)="1.  Users should NOT be on the system during installation of this patch."
^DIC(9.4,43,22,1,"PAH",6,1,56,0)="2.  DSM Sites: If any of these routines is mapped, disable mapping for the "
^DIC(9.4,43,22,1,"PAH",6,1,57,0)="    affected routine(s).  "
^DIC(9.4,43,22,1,"PAH",6,1,58,0)="3.  On the PackMan menu, use the 'INSTALL/CHECK MESSAGE' option.  This loads "
^DIC(9.4,43,22,1,"PAH",6,1,59,0)="    the patch into a Transport Global on your system."
^DIC(9.4,43,22,1,"PAH",6,1,60,0)="4.  You do not need to stop TaskMan."
^DIC(9.4,43,22,1,"PAH",6,1,61,0)="    Users should NOT be on the system."
^DIC(9.4,43,22,1,"PAH",6,1,62,0)="5.  On the KIDS:Installation menu, use the following options to install the"
^DIC(9.4,43,22,1,"PAH",6,1,63,0)="    Transport Global:"
^DIC(9.4,43,22,1,"PAH",6,1,64,0)="       Verify Checksums in Transport Global"
^DIC(9.4,43,22,1,"PAH",6,1,65,0)="       Print Transport Global"
^DIC(9.4,43,22,1,"PAH",6,1,66,0)="       Compare Transport Global to Current System"
^DIC(9.4,43,22,1,"PAH",6,1,67,0)="       Backup a Transport Global"
^DIC(9.4,43,22,1,"PAH",6,1,68,0)="       Install Package(s)"
^DIC(9.4,43,22,1,"PAH",6,1,69,0)=" Select INSTALL NAME:    VALM*1.0*6    Loaded from Distribution  <date/time>"
^DIC(9.4,43,22,1,"PAH",6,1,70,0)="                         =========="
^DIC(9.4,43,22,1,"PAH",6,1,71,0)=" Install Questions:"
^DIC(9.4,43,22,1,"PAH",6,1,72,0)=" Want KIDS to INHIBIT LOGONs during the install? YES// NO"
^DIC(9.4,43,22,1,"PAH",6,1,73,0)="                                                       =="
^DIC(9.4,43,22,1,"PAH",6,1,74,0)=" Want to DISABLE Scheduled Options, Menu Options, and Protocols? YES// NO"
^DIC(9.4,43,22,1,"PAH",6,1,75,0)="                                                                       =="
^DIC(9.4,43,22,1,"PAH",6,1,76,0)=" Enter the Device you want to print the Install messages."
^DIC(9.4,43,22,1,"PAH",6,1,77,0)=" You can queue the install by enter a 'Q' at the device prompt."
^DIC(9.4,43,22,1,"PAH",6,1,78,0)=" Enter a '^' to abort the install."
^DIC(9.4,43,22,1,"PAH",6,1,79,0)=""
^DIC(9.4,43,22,1,"PAH",6,1,80,0)=" DEVICE: HOME// <It's up to you.  You may queue it if you wish.>"
^DIC(9.4,43,22,1,"PAH",6,1,81,0)="                ------------------------------------------------"
^DIC(9.4,43,22,1,"PAH",6,1,82,0)="6.  DSM Sites: After patch has installed, rebuild your map set, if necessary."
^DIC(9.4,43,22,1,"PAH",6,1,83,0)="==========================================================================="
^DIC(9.4,43,22,1,"PAH",7,0)="7 SEQ #7^3030520^1"
^DIC(9.4,43,22,1,"PAH",7,1,0)="^^61^61^3030520"
^DIC(9.4,43,22,1,"PAH",7,1,1,0)="Patch VALM*1.0*7"
^DIC(9.4,43,22,1,"PAH",7,1,2,0)=""
^DIC(9.4,43,22,1,"PAH",7,1,3,0)="NOIS: none"
^DIC(9.4,43,22,1,"PAH",7,1,4,0)="Test Site: BCMA Contingency"
^DIC(9.4,43,22,1,"PAH",7,1,5,0)=""
^DIC(9.4,43,22,1,"PAH",7,1,6,0)="This patch changes one line of code so that List Manager will work"
^DIC(9.4,43,22,1,"PAH",7,1,7,0)="under GT.M, too.  All sites should install this patch."
^DIC(9.4,43,22,1,"PAH",7,1,8,0)=""
