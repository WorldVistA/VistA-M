^DIC(9.4,163,22,"B","1.0",1)=""
^DIC(9.4,163,"DEV")="JER/SLC"
^DIC(9.4,163,"VERSION")="1.0"
^DIC(9.4,164,0)="PHARMACY DATA MANAGEMENT^PSS^Maintenance of Pharmacy files."
^DIC(9.4,164,1,0)="^^1^1^2970912^^^^"
^DIC(9.4,164,1,1,0)="For maintenance of Pharmacy files and fields."
^DIC(9.4,164,5)="BIR"
^DIC(9.4,164,7)=""
^DIC(9.4,164,20,0)="^9.402P^^"
^DIC(9.4,164,22,0)="^9.49I^1^1"
^DIC(9.4,164,22,1,0)="1.0^3051119^2971028^1"
^DIC(9.4,164,22,1,1,0)="^^1^1^3051119"
^DIC(9.4,164,22,1,1,1,0)="MANAGEMENT OF PHARMACY DATA FILES."
^DIC(9.4,164,22,1,"PAH",0)="^9.4901^237^237"
^DIC(9.4,164,22,1,"PAH",1,0)="2 SEQ #1^2971105^1"
^DIC(9.4,164,22,1,"PAH",1,1,0)="^^2^2^2971105"
^DIC(9.4,164,22,1,"PAH",1,1,1,0)="Pharmacy Data Management PATCH PSS*1*2. This fixes a no-compiled routine"
^DIC(9.4,164,22,1,"PAH",1,1,2,0)="and null subscript error."
^DIC(9.4,164,22,1,"PAH",2,0)="3 SEQ #2^2971118^1"
^DIC(9.4,164,22,1,"PAH",2,1,0)="^^3^3^2971118"
^DIC(9.4,164,22,1,"PAH",2,1,1,0)="Pharmacy Data Management PATCH PSS*1*3. This patch fixes the"
^DIC(9.4,164,22,1,"PAH",2,1,2,0)="Mark/Unmarking of a drug for Controlled Substances vs. Drug"
^DIC(9.4,164,22,1,"PAH",2,1,3,0)="Accountability/Inventory Interface."
^DIC(9.4,164,22,1,"PAH",3,0)="4 SEQ #3^2980227^1"
^DIC(9.4,164,22,1,"PAH",3,1,0)="^^6^6^2980227"
^DIC(9.4,164,22,1,"PAH",3,1,1,0)=" This patch removes the INPATIENT PRESCRIPTION PROFILE (#70) and the"
^DIC(9.4,164,22,1,"PAH",3,1,2,0)=" INPATIENT NARRATIVE (#21) fields from the PHARMACY PATIENT file (#55)."
^DIC(9.4,164,22,1,"PAH",3,1,3,0)=" Field #21 was added with the release of Pharmacy Data Management (PDM)"
^DIC(9.4,164,22,1,"PAH",3,1,4,0)=" and it is conflicting with reserved fields designated for Outpatient"
^DIC(9.4,164,22,1,"PAH",3,1,5,0)=" Pharmacy. This patch will delete all data and DDs related to these"
^DIC(9.4,164,22,1,"PAH",3,1,6,0)=" fields. "
^DIC(9.4,164,22,1,"PAH",4,0)="6 SEQ #4^2980318^1"
^DIC(9.4,164,22,1,"PAH",4,1,0)="^^4^4^2980318"
^DIC(9.4,164,22,1,"PAH",4,1,1,0)="This patch contains an update to the ^DD global for the field TO"
^DIC(9.4,164,22,1,"PAH",4,1,2,0)="SERVICE (1) of the D/C ON SERVICE TRANSFER (#23) multiple in the"
^DIC(9.4,164,22,1,"PAH",4,1,3,0)="PHARMACY SYSTEM file (#59.7). This field had a typographical error in the"
^DIC(9.4,164,22,1,"PAH",4,1,4,0)="executable help, resulting in an error."
^DIC(9.4,164,22,1,"PAH",5,0)="7 SEQ #5^2980318^1"
^DIC(9.4,164,22,1,"PAH",5,1,0)="^^6^6^2980318"
^DIC(9.4,164,22,1,"PAH",5,1,1,0)="This patch corrects a problem when using the option Lookup into Dispense"
^DIC(9.4,164,22,1,"PAH",5,1,2,0)="Drug File [PSS LOOK].  Drugs with an application defined for use were"
^DIC(9.4,164,22,1,"PAH",5,1,3,0)="inadvertently displayed as ""none"" under some circumstances."
^DIC(9.4,164,22,1,"PAH",5,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",5,1,5,0)="This patch also corrects a problem with the display of synonyms under"
^DIC(9.4,164,22,1,"PAH",5,1,6,0)="certain circumstances."
^DIC(9.4,164,22,1,"PAH",6,0)="5 SEQ #6^2980403^1"
^DIC(9.4,164,22,1,"PAH",6,1,0)="^^18^18^2980403"
^DIC(9.4,164,22,1,"PAH",6,1,1,0)=" **NOTE** THIS PATCH SHOULD BE LOADED BEFORE PATCH OR*2.5*49."
^DIC(9.4,164,22,1,"PAH",6,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",6,1,3,0)=" The PSS*1*5 patch resolves two problems with the Pharmacy Data"
^DIC(9.4,164,22,1,"PAH",6,1,4,0)=" Management package.  They are listed below."
^DIC(9.4,164,22,1,"PAH",6,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",6,1,6,0)=" Problem #1:  This patch contains modifications to routine PSSJORDF."
^DIC(9.4,164,22,1,"PAH",6,1,7,0)=" The procedure call START^PSSJORDF(PSJORD) is called by Consolidated"
^DIC(9.4,164,22,1,"PAH",6,1,8,0)=" Patient Record System (CPRS) and passes the Orderable Item internal"
^DIC(9.4,164,22,1,"PAH",6,1,9,0)=" entry number."
^DIC(9.4,164,22,1,"PAH",6,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",6,1,11,0)=" This procedure call has been changed to return an additional data"
^DIC(9.4,164,22,1,"PAH",6,1,12,0)=" element.  The Default Schedule name for the Orderable Item is now"
^DIC(9.4,164,22,1,"PAH",6,1,13,0)=" returned in ^TMP(""PSJSCH"",$J). ^TMP(""PSJSCH"",$J)= DEFAULT SCHEDULE"
^DIC(9.4,164,22,1,"PAH",6,1,14,0)=" NAME."
^DIC(9.4,164,22,1,"PAH",6,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",6,1,16,0)=" Problem #2:  This patch resolves a problem related to the Drug"
^DIC(9.4,164,22,1,"PAH",6,1,17,0)=" Enter/Edit [PSS DRUG ENTER/EDIT] option.  In routine PSSDEE,"
^DIC(9.4,164,22,1,"PAH",6,1,18,0)=" modifications were made to allow the user to enter a new drug."
^DIC(9.4,164,22,1,"PAH",7,0)="8 SEQ #7^2980403^1"
^DIC(9.4,164,22,1,"PAH",7,1,0)="^^26^26^2980403"
^DIC(9.4,164,22,1,"PAH",7,1,1,0)=" This patch makes the following changes to address Year 2000 compliance"
^DIC(9.4,164,22,1,"PAH",7,1,2,0)=" issues in the Pharmacy Data Management package."
^DIC(9.4,164,22,1,"PAH",7,1,3,0)=" "
^DIC(9.4,164,22,1,"PAH",7,1,4,0)=" Routine   : PSSLAB"
^DIC(9.4,164,22,1,"PAH",7,1,5,0)=" Line Tag  : BEG+4"
^DIC(9.4,164,22,1,"PAH",7,1,6,0)="             BEG+5"
^DIC(9.4,164,22,1,"PAH",7,1,7,0)=" Exception : Not a legal document; two digit year is allowed."
^DIC(9.4,164,22,1,"PAH",7,1,8,0)=" Resolution: Later determined no action necessary."
^DIC(9.4,164,22,1,"PAH",7,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",7,1,10,0)=" Routine   : PSSCREAT"
^DIC(9.4,164,22,1,"PAH",7,1,11,0)=" Line Tag  : PSSCREAT+12"
^DIC(9.4,164,22,1,"PAH",7,1,12,0)=" Exception : Failure to include ""F"" in %DT parameter string"
^DIC(9.4,164,22,1,"PAH",7,1,13,0)=" Resolution: Replaces call to %DT with call that includes ""F"" in %DT"
^DIC(9.4,164,22,1,"PAH",7,1,14,0)="             parameter string."
^DIC(9.4,164,22,1,"PAH",7,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",7,1,16,0)=" Routine   : PSSPOIM1"
^DIC(9.4,164,22,1,"PAH",7,1,17,0)=" Line Tag  : CHECK+1"
^DIC(9.4,164,22,1,"PAH",7,1,18,0)=" Exception : The call C^%DTC makes a comparison to an FileMan internal "
^DIC(9.4,164,22,1,"PAH",7,1,19,0)="             date format. FileMan dates are within compliances."
^DIC(9.4,164,22,1,"PAH",7,1,20,0)=" Resolution: Later determined no action necessary"
^DIC(9.4,164,22,1,"PAH",7,1,21,0)=" "
^DIC(9.4,164,22,1,"PAH",7,1,22,0)=" Routine   : PSSGMI"
^DIC(9.4,164,22,1,"PAH",7,1,23,0)=" Line Tag  : ENDTC+2"
^DIC(9.4,164,22,1,"PAH",7,1,24,0)="             ENDTC1+2"
^DIC(9.4,164,22,1,"PAH",7,1,25,0)=" Exception : Not a legal document; two digit year is allowed."
^DIC(9.4,164,22,1,"PAH",7,1,26,0)=" Resolution: Later determined no action necessary"
^DIC(9.4,164,22,1,"PAH",8,0)="9 SEQ #8^2980423^1"
^DIC(9.4,164,22,1,"PAH",8,1,0)="^^1^1^2980423"
^DIC(9.4,164,22,1,"PAH",8,1,1,0)="Install new Dose Forms in DOSAGE FORM file (#50.606)."
^DIC(9.4,164,22,1,"PAH",9,0)="10 SEQ #11^2980622^1"
^DIC(9.4,164,22,1,"PAH",9,1,0)="^^6^6^2980622"
^DIC(9.4,164,22,1,"PAH",9,1,1,0)="This patch fixes three problems and provides one enhancement. It will allow"
^DIC(9.4,164,22,1,"PAH",9,1,2,0)="you to edit the IV Additives and IV Solutions Print Names. The patch"
^DIC(9.4,164,22,1,"PAH",9,1,3,0)="expands the help text on the GENERIC NAME field and updates a typo in"
^DIC(9.4,164,22,1,"PAH",9,1,4,0)="the data dictionary in the VA Classification field in DRUG file (#50)."
^DIC(9.4,164,22,1,"PAH",9,1,5,0)="The post-install routine re-indexes the NATIONAL DRUG CLASS field, also"
^DIC(9.4,164,22,1,"PAH",9,1,6,0)="in DRUG file (#50)."
^DIC(9.4,164,22,1,"PAH",10,0)="15 SEQ #12^2980923^1"
^DIC(9.4,164,22,1,"PAH",10,1,0)="^^1^1^2980923"
^DIC(9.4,164,22,1,"PAH",10,1,1,0)="This patch utilizes the new NDF APIs."
^DIC(9.4,164,22,1,"PAH",11,0)="13^2981007^1"
^DIC(9.4,164,22,1,"PAH",11,1,0)="^^3^3^2981007"
^DIC(9.4,164,22,1,"PAH",11,1,1,0)="This patch fixes data dictionaries for Pharmacy Patient (#55), Pharmacy"
^DIC(9.4,164,22,1,"PAH",11,1,2,0)="System (#59.7), and Drug (#50) files, as well as a couple of enhancement"
^DIC(9.4,164,22,1,"PAH",11,1,3,0)="routines."
^DIC(9.4,164,22,1,"PAH",12,0)="12 SEQ #14^2981104^1"
^DIC(9.4,164,22,1,"PAH",12,1,0)="^^7^7^2981104"
^DIC(9.4,164,22,1,"PAH",12,1,1,0)="This patch fixes an error which occurs when an IV order is entered"
^DIC(9.4,164,22,1,"PAH",12,1,2,0)="with a non-standard schedule which contains a leading space. It also"
^DIC(9.4,164,22,1,"PAH",12,1,3,0)="corrects an error that occurs when an IV or Unit Dose order is entered in"
^DIC(9.4,164,22,1,"PAH",12,1,4,0)="the Computerized Patient Record System (CPRS) that contains an invalid"
^DIC(9.4,164,22,1,"PAH",12,1,5,0)="schedule. This patch makes changes to the Pharmacy Data Management"
^DIC(9.4,164,22,1,"PAH",12,1,6,0)="routines that are used to control the validation of schedules when orders"
^DIC(9.4,164,22,1,"PAH",12,1,7,0)="are entered in CPRS and Inpatient Medications."
^DIC(9.4,164,22,1,"PAH",13,0)="17^2981120^1"
^DIC(9.4,164,22,1,"PAH",13,1,0)="^^4^4^2981120"
^DIC(9.4,164,22,1,"PAH",13,1,1,0)="This build is a patch to DRUG file (#50) which changes the data"
^DIC(9.4,164,22,1,"PAH",13,1,2,0)="dictionary for fields NATIONAL DRUG FILE ENTRY (#20) and PSNDF"
^DIC(9.4,164,22,1,"PAH",13,1,3,0)="VA PRODUCT NAME ENTRY (#22) to pointers. This patch requires"
^DIC(9.4,164,22,1,"PAH",13,1,4,0)="National Drug File V. 4.0 to be installed."
^DIC(9.4,164,22,1,"PAH",14,0)="18 SEQ #16^2981125^1"
^DIC(9.4,164,22,1,"PAH",14,1,0)="^^14^14^2981125"
^DIC(9.4,164,22,1,"PAH",14,1,1,0)="Patch PSS*1*18 has three purposes."
^DIC(9.4,164,22,1,"PAH",14,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",14,1,3,0)=" 1. This patch corrects a problem with patch PSS*1*13. A routine entry"
^DIC(9.4,164,22,1,"PAH",14,1,4,0)="    call was changed to access three entry points in routine PSSGS0."
^DIC(9.4,164,22,1,"PAH",14,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",14,1,6,0)=" 2. This patch contains a new field called MAR SORT (#26.4).  It is"
^DIC(9.4,164,22,1,"PAH",14,1,7,0)="    located in the PHARMACY SYSTEM file (#59.7). This field is a set of"
^DIC(9.4,164,22,1,"PAH",14,1,8,0)="    codes that allows the user to (0) sort by order's Schedule Type and"
^DIC(9.4,164,22,1,"PAH",14,1,9,0)="    then Medication Names and (1) sort by order's Medication Names."
^DIC(9.4,164,22,1,"PAH",14,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",14,1,11,0)=" 3. This patch contains a minor change to the DDs in the PHARMACY PATIENT"
^DIC(9.4,164,22,1,"PAH",14,1,12,0)="    file (#55).  In reference to the Volume field (#1) under the IV"
^DIC(9.4,164,22,1,"PAH",14,1,13,0)="    sub-file, we changed the input transformer by increasing the range"
^DIC(9.4,164,22,1,"PAH",14,1,14,0)="    from 3000 to 9999."
^DIC(9.4,164,22,1,"PAH",15,0)="14 SEQ #17^2981214^1"
^DIC(9.4,164,22,1,"PAH",15,1,0)="^^9^9^2981214"
^DIC(9.4,164,22,1,"PAH",15,1,1,0)="This patch creates a new Pharmacy Data Management option, Pharmacy quick"
^DIC(9.4,164,22,1,"PAH",15,1,2,0)="order correction for CPRS [PSS QUICK1].  This option will allow the"
^DIC(9.4,164,22,1,"PAH",15,1,3,0)="pharmacy quick orders that weren't converted in the OR*2.5*49 patch"
^DIC(9.4,164,22,1,"PAH",15,1,4,0)="conversion to be manually corrected and converted to the quick order in"
^DIC(9.4,164,22,1,"PAH",15,1,5,0)="Computerized Patient Record System.  The invalid data in each quick order"
^DIC(9.4,164,22,1,"PAH",15,1,6,0)="will be shown and the user will be prompted to correct the item.  This"
^DIC(9.4,164,22,1,"PAH",15,1,7,0)="option is not distributed on any menu. It should be assigned to the"
^DIC(9.4,164,22,1,"PAH",15,1,8,0)="appropriate person in pharmacy that would make decisions about editing"
^DIC(9.4,164,22,1,"PAH",15,1,9,0)="these quick orders."
^DIC(9.4,164,22,1,"PAH",16,0)="16 SEQ #18^2981229^1"
^DIC(9.4,164,22,1,"PAH",16,1,0)="^^19^19^2981229"
^DIC(9.4,164,22,1,"PAH",16,1,1,0)=" Patch PSS*1*16 contains resolutions to the following issues:"
^DIC(9.4,164,22,1,"PAH",16,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",16,1,3,0)=" 1.  It corrects a problem indicated in NOIS LOU-0698-40167.  In the "
^DIC(9.4,164,22,1,"PAH",16,1,4,0)="     Drug Enter/Edit [PSS DRUG ENTER/EDIT] option, the system encountered "
^DIC(9.4,164,22,1,"PAH",16,1,5,0)="     an undefined variable (DA) when a user tried to mark a drug as "
^DIC(9.4,164,22,1,"PAH",16,1,6,0)="     Clozapine.  The error was detected at UD^PSSDEE; however after "
^DIC(9.4,164,22,1,"PAH",16,1,7,0)="     further analysis, the culprit was really discovered in routine "
^DIC(9.4,164,22,1,"PAH",16,1,8,0)="     PSSCLDRG. In routine PSSCLDRG, ASK+3,END+0, and UNMARK+1, the DA "
^DIC(9.4,164,22,1,"PAH",16,1,9,0)="     variable is a part of the Kill logic.  In this patch, we removed the "
^DIC(9.4,164,22,1,"PAH",16,1,10,0)="     DA variable from the Kill logic and placed it in a clean up routine "
^DIC(9.4,164,22,1,"PAH",16,1,11,0)="     PSSDEE2.  "
^DIC(9.4,164,22,1,"PAH",16,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",16,1,13,0)=" 2.  In routine PSSDEE at APP+0, we changed the statement, ""MARK "
^DIC(9.4,164,22,1,"PAH",16,1,14,0)="     THIS DRUG FOR AND EDIT"" to ""MARK THIS DRUG AND EDIT IT FOR:"".  "
^DIC(9.4,164,22,1,"PAH",16,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",16,1,16,0)=" 3.  It corrects a problem indicated in NOIS BIR-1098-32686. The site "
^DIC(9.4,164,22,1,"PAH",16,1,17,0)="     indicated that the CMOP ID is no longer appearing in the Lookup into "
^DIC(9.4,164,22,1,"PAH",16,1,18,0)="     Dispense Drug File [PSS LOOK] option.  This patch will correct "
^DIC(9.4,164,22,1,"PAH",16,1,19,0)="     this problem.  "
^DIC(9.4,164,22,1,"PAH",17,0)="20 SEQ #19^2990223^1"
^DIC(9.4,164,22,1,"PAH",17,1,0)="^^29^29^2990420^"
^DIC(9.4,164,22,1,"PAH",17,1,1,0)=" This KIDS Build contains the Pharmacy Data Management Enhancement patch."
^DIC(9.4,164,22,1,"PAH",17,1,2,0)=" It contains DDs for specific files and routines."
^DIC(9.4,164,22,1,"PAH",17,1,3,0)=" "
^DIC(9.4,164,22,1,"PAH",17,1,4,0)=" The following issues are included in the KIDS Build:"
^DIC(9.4,164,22,1,"PAH",17,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",17,1,6,0)=" 1. A new INACTIVATION DATE field (#7) was added to the DOSAGE FORUM"
^DIC(9.4,164,22,1,"PAH",17,1,7,0)="    file #50.606. Also, a new INACTIVATION DATE field (#5) was added to"
^DIC(9.4,164,22,1,"PAH",17,1,8,0)="    the MEDICATION ROUTES file (#51.2)."
^DIC(9.4,164,22,1,"PAH",17,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",17,1,10,0)=" 2. The Enter/Edit Drug Interaction [PSS INTERACTION LOCAL ADD] option"
^DIC(9.4,164,22,1,"PAH",17,1,11,0)="    will be modified to generate a MailMan message whenever a local drug"
^DIC(9.4,164,22,1,"PAH",17,1,12,0)="    interaction are added or a change is made to the severity of a"
^DIC(9.4,164,22,1,"PAH",17,1,13,0)="    nationally entered drug interaction."
^DIC(9.4,164,22,1,"PAH",17,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",17,1,15,0)=" 3. Two new fields were added to the PHARMACY SYSTEM file (#59.7). The"
^DIC(9.4,164,22,1,"PAH",17,1,16,0)="    fields are PMIS PRINTER (#13) and PMIS LANGUAGE (#14). The Parameters"
^DIC(9.4,164,22,1,"PAH",17,1,17,0)="    Edit [PSS SYS EDIT] option will allow the user to access the fields."
^DIC(9.4,164,22,1,"PAH",17,1,18,0)=" "
^DIC(9.4,164,22,1,"PAH",17,1,19,0)=" 4. In reference to the Lookup into Dispense Drug File [PSS LOOK] option,"
^DIC(9.4,164,22,1,"PAH",17,1,20,0)="    code was added to routine PSSLOOK to display the National Formulary"
^DIC(9.4,164,22,1,"PAH",17,1,21,0)="    and National Restriction fields."
^DIC(9.4,164,22,1,"PAH",17,1,22,0)=" "
^DIC(9.4,164,22,1,"PAH",17,1,23,0)=" 5. In reference to the CMOP Mark/Unmark [PSXX MARK] option, code was"
^DIC(9.4,164,22,1,"PAH",17,1,24,0)="    added to routine PSSDINT to display the reasons why a drug cannot be"
^DIC(9.4,164,22,1,"PAH",17,1,25,0)="    marked for CMOP use."
^DIC(9.4,164,22,1,"PAH",17,1,26,0)=" "
^DIC(9.4,164,22,1,"PAH",17,1,27,0)=" 6. This patch also corrects a potential problem found when generating"
^DIC(9.4,164,22,1,"PAH",17,1,28,0)="    the default frequency using the option Standard Schedule Edit [PSS"
^DIC(9.4,164,22,1,"PAH",17,1,29,0)="    SCHEDULE EDIT]."
^DIC(9.4,164,22,1,"PAH",18,0)="1^2990416^1"
^DIC(9.4,164,22,1,"PAH",18,1,0)="^^13^13^2990416"
^DIC(9.4,164,22,1,"PAH",18,1,1,0)="This patch is only installed by the CPRS group of package builds."
^DIC(9.4,164,22,1,"PAH",18,1,2,0)="This patch SHOULD NOT be installed outside of the CPRS build."
^DIC(9.4,164,22,1,"PAH",18,1,3,0)=" "
^DIC(9.4,164,22,1,"PAH",18,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",18,1,5,0)="Re-Install File 55 (Pharmacy Patient) for Inpatient Medications V. 5.0."
^DIC(9.4,164,22,1,"PAH",18,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",18,1,7,0)="Options PSS CREATE ORDERABLE ITEMS"
^DIC(9.4,164,22,1,"PAH",18,1,8,0)="        PSS ORDERABLE ITEM STATUS"
^DIC(9.4,164,22,1,"PAH",18,1,9,0)="        PSS PRE-RELEASE MANUAL MATCH"
^DIC(9.4,164,22,1,"PAH",18,1,10,0)="        PSS PRIMARY DRUG EDIT"
^DIC(9.4,164,22,1,"PAH",18,1,11,0)="        PSS PRIMARY/VA GENERIC REPORT"
^DIC(9.4,164,22,1,"PAH",18,1,12,0)="        PSS VA GENERIC DRUG REPORT"
^DIC(9.4,164,22,1,"PAH",18,1,13,0)="These options are deleted at the site."
^DIC(9.4,164,22,1,"PAH",19,0)="21 SEQ #20^2990417^1"
^DIC(9.4,164,22,1,"PAH",19,1,0)="^^14^14^2990417"
^DIC(9.4,164,22,1,"PAH",19,1,1,0)=" This patch addresses three issues."
^DIC(9.4,164,22,1,"PAH",19,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",19,1,3,0)=" 1. The IV SOLUTIONS file (#52.7) VOLUME field (#2) has an upper limit"
^DIC(9.4,164,22,1,"PAH",19,1,4,0)=" of 4000ml.  This patch will increase the volume field to 9999ml to meet"
^DIC(9.4,164,22,1,"PAH",19,1,5,0)=" the needs of the sites to enter solutions with a volume of greater than"
^DIC(9.4,164,22,1,"PAH",19,1,6,0)=" 4000ml."
^DIC(9.4,164,22,1,"PAH",19,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",19,1,8,0)=" 2. It corrects a problem when displaying non-formulary drugs"
^DIC(9.4,164,22,1,"PAH",19,1,9,0)=" associated with the formulary alternative during the drug enter and edit"
^DIC(9.4,164,22,1,"PAH",19,1,10,0)=" processes."
^DIC(9.4,164,22,1,"PAH",19,1,11,0)=" "
^DIC(9.4,164,22,1,"PAH",19,1,12,0)=" 3. It corrects a typo in the data dictionary for the DISPENSE DRUG field"
^DIC(9.4,164,22,1,"PAH",19,1,13,0)=" (#.02) of the DISPENSE LOG sub-file (#55.0611) in the PHARMACY PATIENT"
^DIC(9.4,164,22,1,"PAH",19,1,14,0)=" file (#55).  The sub-file number was changed from 5506.11 to 55.0611."
^DIC(9.4,164,22,1,"PAH",20,0)="23 SEQ #21^2990510^1"
^DIC(9.4,164,22,1,"PAH",20,1,0)="^^12^12^2990510"
^DIC(9.4,164,22,1,"PAH",20,1,1,0)="This patch resolves two issues."
^DIC(9.4,164,22,1,"PAH",20,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",20,1,3,0)="1. It creates a new sub-file EXEMPT WARD FROM AUTOCANCEL (#59.701) in the"
^DIC(9.4,164,22,1,"PAH",20,1,4,0)="PHARMACY SYSTEM file (#59.7).  This new sub-file will be used by"
^DIC(9.4,164,22,1,"PAH",20,1,5,0)="Outpatient Pharmacy to exempt ward locations when prescriptions are"
^DIC(9.4,164,22,1,"PAH",20,1,6,0)="auto-canceled."
^DIC(9.4,164,22,1,"PAH",20,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",20,1,8,0)="2. It deletes the PHARMACISTS field (#6) from the INPATIENT SITE file"
^DIC(9.4,164,22,1,"PAH",20,1,9,0)="(#59.4) and PSJIORE input template from the PHARMACY PATIENT file (#55)."
^DIC(9.4,164,22,1,"PAH",20,1,10,0)="Neither the field nor template is used by current software. References to"
^DIC(9.4,164,22,1,"PAH",20,1,11,0)="the USER file (#3) are contained in the field and template. The"
^DIC(9.4,164,22,1,"PAH",20,1,12,0)="PHARMACISTS field was flagged for deletion.  "
^DIC(9.4,164,22,1,"PAH",21,0)="19 SEQ #22^2990622^1"
^DIC(9.4,164,22,1,"PAH",21,1,0)="^^28^28^2990622"
^DIC(9.4,164,22,1,"PAH",21,1,1,0)=" This patch contains the following enhancements:"
^DIC(9.4,164,22,1,"PAH",21,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",21,1,3,0)=" 1.  In the pre-installation process, we added code to:"
^DIC(9.4,164,22,1,"PAH",21,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",21,1,5,0)="     A. Delete the DRUG GROUP/INTERACTION field (#7) from the DRUG file"
^DIC(9.4,164,22,1,"PAH",21,1,6,0)="        (#50). This field has been marked for deletion."
^DIC(9.4,164,22,1,"PAH",21,1,7,0)="     B. Delete the ""I"" node in the DRUG file (#50) if it does not contain"
^DIC(9.4,164,22,1,"PAH",21,1,8,0)="        data."
^DIC(9.4,164,22,1,"PAH",21,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",21,1,10,0)=" 2.  Within the Drug Enter/Edit [PSS DRUG ENTER/EDIT] option, a"
^DIC(9.4,164,22,1,"PAH",21,1,11,0)="     significant enhancement to the Mark/Unmark for Lab Monitor or"
^DIC(9.4,164,22,1,"PAH",21,1,12,0)="     Clozapine procedure was made."
^DIC(9.4,164,22,1,"PAH",21,1,13,0)=" "
^DIC(9.4,164,22,1,"PAH",21,1,14,0)="     A. When updating Clozapine information, the user will have a choice"
^DIC(9.4,164,22,1,"PAH",21,1,15,0)="        to add, edit, or delete Clozapine Lab Test(s) for the selected"
^DIC(9.4,164,22,1,"PAH",21,1,16,0)="        drug."
^DIC(9.4,164,22,1,"PAH",21,1,17,0)="     B. When updating Clozapine information, the user will have to add"
^DIC(9.4,164,22,1,"PAH",21,1,18,0)="        identification of two laboratory tests, WBC and Absolute"
^DIC(9.4,164,22,1,"PAH",21,1,19,0)="         Neutrophil Count (ANC)."
^DIC(9.4,164,22,1,"PAH",21,1,20,0)="     C. In the post-installation process, we added code to move data from"
^DIC(9.4,164,22,1,"PAH",21,1,21,0)="        the CLOZ node to the CLOZ2 node in the DRUG file (#50).  (This is"
^DIC(9.4,164,22,1,"PAH",21,1,22,0)=" "
^DIC(9.4,164,22,1,"PAH",21,1,23,0)=" 3.  In the DRUG file (#50), we expanded the field length of the WARNING"
^DIC(9.4,164,22,1,"PAH",21,1,24,0)="     LABEL field (#8) to 25 characters to allow longer names."
^DIC(9.4,164,22,1,"PAH",21,1,25,0)=" "
^DIC(9.4,164,22,1,"PAH",21,1,26,0)=" 4.  The routine PSSPOIDT was updated to properly delete data from the"
^DIC(9.4,164,22,1,"PAH",21,1,27,0)="     INACTIVE DATE field (#100) in the DRUG file (#50) when a drug is"
^DIC(9.4,164,22,1,"PAH",21,1,28,0)="     reactivated."
^DIC(9.4,164,22,1,"PAH",22,0)="22 SEQ #23^2990622^1"
^DIC(9.4,164,22,1,"PAH",22,1,0)="^^10^10^2990622"
^DIC(9.4,164,22,1,"PAH",22,1,1,0)=" This patch contains two enhancements:"
^DIC(9.4,164,22,1,"PAH",22,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",22,1,3,0)=" 1. In the Drug Enter/Edit [PSS DRUG ENTER/EDIT] option, we made"
^DIC(9.4,164,22,1,"PAH",22,1,4,0)="    modifications to routine PSSDEE to identify an entry when it is marked"
^DIC(9.4,164,22,1,"PAH",22,1,5,0)="    for Ward Stock. "
^DIC(9.4,164,22,1,"PAH",22,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",22,1,7,0)=" 2. A new option, Report of Locally Entered Interactions [PSS REPORT LOCAL"
^DIC(9.4,164,22,1,"PAH",22,1,8,0)="    INTERACTIONS] has been added. This report displays locally entered"
^DIC(9.4,164,22,1,"PAH",22,1,9,0)="    drug interactions and their severity. It is included on the Drug"
^DIC(9.4,164,22,1,"PAH",22,1,10,0)="    Interaction Management [PSS DRG INTER MANAGEMENT] menu."
^DIC(9.4,164,22,1,"PAH",23,0)="24 SEQ #24^2990628^1"
^DIC(9.4,164,22,1,"PAH",23,1,0)="^^9^9^2990628"
^DIC(9.4,164,22,1,"PAH",23,1,1,0)=" This patch contains two enhancements:"
^DIC(9.4,164,22,1,"PAH",23,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",23,1,3,0)=" 1. In the Lookup into Dispense Drug File [PSS LOOK] option, we made"
^DIC(9.4,164,22,1,"PAH",23,1,4,0)=" modifications to routine PSSLOOK to correct a typo.  Indicatior changed"
^DIC(9.4,164,22,1,"PAH",23,1,5,0)=" to Indicator."
^DIC(9.4,164,22,1,"PAH",23,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",23,1,7,0)=" 2. In the Standard Schedule Edit [PSS SCHEDULE EDIT] option, we made"
^DIC(9.4,164,22,1,"PAH",23,1,8,0)=" modifications to routine PSSJEEU to set DLAYGO to the file number.  This"
^DIC(9.4,164,22,1,"PAH",23,1,9,0)=" correction should allow users to look up and add new entries to the file."
^DIC(9.4,164,22,1,"PAH",24,0)="25 SEQ #25^2990803^1"
^DIC(9.4,164,22,1,"PAH",24,1,0)="^^16^16^2990803"
^DIC(9.4,164,22,1,"PAH",24,1,1,0)=" "
^DIC(9.4,164,22,1,"PAH",24,1,2,0)=" **NOTE** This patch requires the installation of Inpatient Medications"
^DIC(9.4,164,22,1,"PAH",24,1,3,0)="          V. 5.0. Facilities using Inpatient Medications V. 4.5 do"
^DIC(9.4,164,22,1,"PAH",24,1,4,0)="          not need to install this patch.  Inpatient Medications V. 5.0"
^DIC(9.4,164,22,1,"PAH",24,1,5,0)="          patch PSJ*5.0*30 contains enhancements that utilize changes"
^DIC(9.4,164,22,1,"PAH",24,1,6,0)="          introduced in this patch."
^DIC(9.4,164,22,1,"PAH",24,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",24,1,8,0)=" This patch addresses two issues. "
^DIC(9.4,164,22,1,"PAH",24,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",24,1,10,0)=" 1. It adds a new AOC cross-reference to the VA CLASSIFICATION field (#2)"
^DIC(9.4,164,22,1,"PAH",24,1,11,0)="    in the DRUG file (#50)."
^DIC(9.4,164,22,1,"PAH",24,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",24,1,13,0)=" 2. In the PHARMACY PATIENT file (#55), it corrects a typo in a screen"
^DIC(9.4,164,22,1,"PAH",24,1,14,0)="    placed on the DISPENSE DRUG field (#.01) from the DISPENSE DRUG"
^DIC(9.4,164,22,1,"PAH",24,1,15,0)="    multiple (#55.07). The code was modified to reference the PHARMACY"
^DIC(9.4,164,22,1,"PAH",24,1,16,0)="    ORDERABLE ITEM field (#2.1) instead of the PRIMARY DRUG field (#64)."
^DIC(9.4,164,22,1,"PAH",25,0)="26 SEQ #26^2990914^1"
^DIC(9.4,164,22,1,"PAH",25,1,0)="^^5^5^2990914"
^DIC(9.4,164,22,1,"PAH",25,1,1,0)="This patch distributes a common pharmacy locking routine (PSSLOCK). This"
^DIC(9.4,164,22,1,"PAH",25,1,2,0)="patch supports the patient and single order locking changes in Inpatient"
^DIC(9.4,164,22,1,"PAH",25,1,3,0)="Medications V. 5.0 and Outpatient Pharmacy V. 7.0. This patch will NOT"
^DIC(9.4,164,22,1,"PAH",25,1,4,0)="change locking functionality until patches OR*3.0*48, PSJ*5.0*29 and"
^DIC(9.4,164,22,1,"PAH",25,1,5,0)="PSO*7.0*27 are installed."
^DIC(9.4,164,22,1,"PAH",26,0)="30 SEQ #27^3000229^1"
^DIC(9.4,164,22,1,"PAH",26,1,0)="^^16^16^3000229"
^DIC(9.4,164,22,1,"PAH",26,1,1,0)=" This patch deletes the VENDOR sub-file (#50.535001) from the DRUG file"
^DIC(9.4,164,22,1,"PAH",26,1,2,0)=" (#50) and the associated data. The VENDOR sub-file (#50.535001) does not"
^DIC(9.4,164,22,1,"PAH",26,1,3,0)="     "
^DIC(9.4,164,22,1,"PAH",26,1,4,0)=" provide national support of current activities related to the Pharmacy"
^DIC(9.4,164,22,1,"PAH",26,1,5,0)=" Data Management (PDM) application."
^DIC(9.4,164,22,1,"PAH",26,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",26,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",26,1,8,0)=" The following multiple and associated data will be deleted with this"
^DIC(9.4,164,22,1,"PAH",26,1,9,0)=" patch:"
^DIC(9.4,164,22,1,"PAH",26,1,10,0)="       ^PSDRUG(D0,535000,D1,0)"
^DIC(9.4,164,22,1,"PAH",26,1,11,0)="       ==>(#.01) VENDOR [1P] ^ (#1) PRIMARY VENDOR [2S] ^ (#2)"
^DIC(9.4,164,22,1,"PAH",26,1,12,0)="       ==>VENDOR'S PRICE PER ORDER UNIT [3N] ^ (#3) VENDOR'S"
^DIC(9.4,164,22,1,"PAH",26,1,13,0)="       ==>ORDER UNIT [4P] ^ (#4) DISPENSE UNITS PER ORDER UNIT"
^DIC(9.4,164,22,1,"PAH",26,1,14,0)="       ==> [5N] ^ (#5) COMPANY STOCK NUMBER [6F] ^ (#6) START"
^DIC(9.4,164,22,1,"PAH",26,1,15,0)="       ==>DATE [7D] ^ (#7) STOP DATE [8D] ^ (#8) DUMMY [9F] ^"
^DIC(9.4,164,22,1,"PAH",26,1,16,0)="       ==>(#9) PRICE PER DISPENSE UNIT [10N] ^ "
^DIC(9.4,164,22,1,"PAH",27,0)="29 SEQ #28^3000229^1"
^DIC(9.4,164,22,1,"PAH",27,1,0)="^^2^2^3000229"
^DIC(9.4,164,22,1,"PAH",27,1,1,0)="This build contains routines, options, files, fields, and templates"
^DIC(9.4,164,22,1,"PAH",27,1,2,0)="for the National Formulary Indicator enhancement patch."
^DIC(9.4,164,22,1,"PAH",28,0)="27 SEQ #29^3000405^1"
^DIC(9.4,164,22,1,"PAH",28,1,0)="^^24^24^3000405"
^DIC(9.4,164,22,1,"PAH",28,1,1,0)=" This patch contains the following enhancements."
^DIC(9.4,164,22,1,"PAH",28,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",28,1,3,0)=" 1.  In the Standard Schedule Edit [PSS SCHEDULE EDIT] option, it"
^DIC(9.4,164,22,1,"PAH",28,1,4,0)="     increases the maximum value of the Frequency (IN MINUTES) field (#2)"
^DIC(9.4,164,22,1,"PAH",28,1,5,0)="     from 50000 to 129600 minutes in the ADMINISTRATION SCHEDULE file"
^DIC(9.4,164,22,1,"PAH",28,1,6,0)="     (#51.1)."
^DIC(9.4,164,22,1,"PAH",28,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",28,1,8,0)=" 2.  In the Drug Enter/Edit [PSS DRUG ENTER/EDIT] option, it increases"
^DIC(9.4,164,22,1,"PAH",28,1,9,0)="     the decimal length from three to four digits when displaying the"
^DIC(9.4,164,22,1,"PAH",28,1,10,0)="     DISPENSE UNITS PER ORDER UNIT field (#15) in the DRUG file (#50)."
^DIC(9.4,164,22,1,"PAH",28,1,11,0)=" "
^DIC(9.4,164,22,1,"PAH",28,1,12,0)=" 3.  In reference to the MEDICATION INSTRUCTION file (#51), this patch:"
^DIC(9.4,164,22,1,"PAH",28,1,13,0)="     a.  Replaces erroneous %D subscripts in the ^PS(51 data globals by"
^DIC(9.4,164,22,1,"PAH",28,1,14,0)="         restoring the MEDICATION INSTRUCTION file (#51) data dictionary."
^DIC(9.4,164,22,1,"PAH",28,1,15,0)="         (ex. ^PS(51,%D,...)."
^DIC(9.4,164,22,1,"PAH",28,1,16,0)="     b.  Re-indexes the ""A"" cross-references on the NAME field (#.01)."
^DIC(9.4,164,22,1,"PAH",28,1,17,0)="     c.  Reinstalls full set of DDs related to the MEDICATION INSTRUCTION"
^DIC(9.4,164,22,1,"PAH",28,1,18,0)="        file (#51)."
^DIC(9.4,164,22,1,"PAH",28,1,19,0)=" "
^DIC(9.4,164,22,1,"PAH",28,1,20,0)=" 4.  During the Computerize Patient Record System (CPRS) Order Entry"
^DIC(9.4,164,22,1,"PAH",28,1,21,0)="     process, the schedule input transform routine PSSGSO was not allowing"
^DIC(9.4,164,22,1,"PAH",28,1,22,0)="     schedules 5TIMES/DAY and 5X/DAY to pass as valid non-standard"
^DIC(9.4,164,22,1,"PAH",28,1,23,0)="     schedules. This patch contains modifications to routine PSSGS0"
^DIC(9.4,164,22,1,"PAH",28,1,24,0)="     to allow these schedules to be entered. "
^DIC(9.4,164,22,1,"PAH",29,0)="28 SEQ #30^3000516^1"
^DIC(9.4,164,22,1,"PAH",29,1,0)="^^33^33^3000516"
^DIC(9.4,164,22,1,"PAH",29,1,1,0)=" Modifications were made to two options, CMOP Mark/Unmark (Single drug) "
^DIC(9.4,164,22,1,"PAH",29,1,2,0)=" [PSSXX MARK] and Drug Enter/Edit [PSS DRUG ENTER/EDIT]. These "
^DIC(9.4,164,22,1,"PAH",29,1,3,0)=" modifications were required to enable drugs identified as a Schedule "
^DIC(9.4,164,22,1,"PAH",29,1,4,0)=" III-V controlled substance to be marked for CMOP transmission.  "
^DIC(9.4,164,22,1,"PAH",29,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",29,1,6,0)=" 1. Both options were modified to remove the screen that disallows a drug "
^DIC(9.4,164,22,1,"PAH",29,1,7,0)="    identified as a Schedule III-V controlled substance to be marked for "
^DIC(9.4,164,22,1,"PAH",29,1,8,0)="    CMOP transmission. "
^DIC(9.4,164,22,1,"PAH",29,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",29,1,10,0)=" 2. The program currently checks for a ""C"" - CONTROLLED SUBSTANCES - NON "
^DIC(9.4,164,22,1,"PAH",29,1,11,0)="    NARCOTIC in the DEA, SPECIAL HDLG field (#3) of the drug to be marked "
^DIC(9.4,164,22,1,"PAH",29,1,12,0)="    for transmission.  Routine PSSMARK was modified to check for a ""1"" - "
^DIC(9.4,164,22,1,"PAH",29,1,13,0)="    SCHEDULE 1, or a ""2"" - SCHEDULE 2 in the DEA, SPECIAL HDLG field (#3)."
^DIC(9.4,164,22,1,"PAH",29,1,14,0)="    If these values are assigned to the selected drug, the option will"
^DIC(9.4,164,22,1,"PAH",29,1,15,0)="    not allow the user to mark the drug for CMOP transmission."
^DIC(9.4,164,22,1,"PAH",29,1,16,0)=" "
^DIC(9.4,164,22,1,"PAH",29,1,17,0)=" 3. Routines PSSMARK and PSSDEE were modified to change the current "
^DIC(9.4,164,22,1,"PAH",29,1,18,0)="    message display, ""It is a controlled substance"" to ""It is a schedule "
^DIC(9.4,164,22,1,"PAH",29,1,19,0)="    I or schedule II controlled substance"" when a user attempts to mark"
^DIC(9.4,164,22,1,"PAH",29,1,20,0)="    a controlled substance drug that does contains a ""1"" or ""2"" in the"
^DIC(9.4,164,22,1,"PAH",29,1,21,0)="    DEA SPECIAL HDLG field (#3).  "
^DIC(9.4,164,22,1,"PAH",29,1,22,0)=" "
^DIC(9.4,164,22,1,"PAH",29,1,23,0)=" 4. The Drug Enter/Edit [PSS DRUG ENTER/EDIT] option was modified to "
^DIC(9.4,164,22,1,"PAH",29,1,24,0)="    display a new message to reflect changes to the option. Routine "
^DIC(9.4,164,22,1,"PAH",29,1,25,0)="    PSSMARK was modified to check for a ""1"" or a ""2"" in the DEA,"
^DIC(9.4,164,22,1,"PAH",29,1,26,0)="    SPECIAL HDLG field (#3). If either of these values exist and the drug"
^DIC(9.4,164,22,1,"PAH",29,1,27,0)="    is already marked for CMOP transmission, the option shall display a"
^DIC(9.4,164,22,1,"PAH",29,1,28,0)="    message to the user indicating that the drug has been unmarked for "
^DIC(9.4,164,22,1,"PAH",29,1,29,0)="    CMOP transmission.  "
^DIC(9.4,164,22,1,"PAH",29,1,30,0)=" "
^DIC(9.4,164,22,1,"PAH",29,1,31,0)=" 5. The Drug Enter/Edit [PSS DRUG ENTER/EDIT] option has been enhanced to "
^DIC(9.4,164,22,1,"PAH",29,1,32,0)="    provide a list of reasons why a drug can not be marked for CMOP "
^DIC(9.4,164,22,1,"PAH",29,1,33,0)="    transmission.  "
^DIC(9.4,164,22,1,"PAH",30,0)="37 SEQ #32^3000710^1"
^DIC(9.4,164,22,1,"PAH",30,1,0)="^^3^3^3000710"
^DIC(9.4,164,22,1,"PAH",30,1,1,0)="The option, Synonym Enter/Edit [PSS SYNONYM], has been created to provide"
^DIC(9.4,164,22,1,"PAH",30,1,2,0)="easy access to the update the synonym information for an entry in the local"
^DIC(9.4,164,22,1,"PAH",30,1,3,0)="DRUG file (#50)."
^DIC(9.4,164,22,1,"PAH",31,0)="31 SEQ #31^3000710^1"
^DIC(9.4,164,22,1,"PAH",31,1,0)="^^7^7^3000710"
^DIC(9.4,164,22,1,"PAH",31,1,1,0)=" This patch contain two enhanancements:"
^DIC(9.4,164,22,1,"PAH",31,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",31,1,3,0)=" 1. It restores the DDs related to the ""AND"" cross-reference placed on the"
^DIC(9.4,164,22,1,"PAH",31,1,4,0)="    NATIONAL DRUG FILE ENTRY field (#20) in the DRUG file (#50)."
^DIC(9.4,164,22,1,"PAH",31,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",31,1,6,0)=" 2. It removes the CHEMOTHERAPY DRUG field (#202) and data from the DRUG"
^DIC(9.4,164,22,1,"PAH",31,1,7,0)="    File (#50)."
^DIC(9.4,164,22,1,"PAH",32,0)="36 SEQ #33^3000710^1"
^DIC(9.4,164,22,1,"PAH",32,1,0)="^^20^20^3000710"
^DIC(9.4,164,22,1,"PAH",32,1,1,0)=" This patch contains one resolution."
^DIC(9.4,164,22,1,"PAH",32,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",32,1,3,0)=" Problem: This patch resolves a problem related to a report created by the"
^DIC(9.4,164,22,1,"PAH",32,1,4,0)=" Patients on Specific Drug(s) [PSJ PDV] option associated with the"
^DIC(9.4,164,22,1,"PAH",32,1,5,0)=" Inpatient Medications V. 5.0 application.  The Pharmacy Data Management"
^DIC(9.4,164,22,1,"PAH",32,1,6,0)=" (PDM) V. 1.0 application allows the Patients on Specific Drug(s) [PSJ"
^DIC(9.4,164,22,1,"PAH",32,1,7,0)=" PDV] option to access data stored in the ""AOC"" MUMPS cross-reference to"
^DIC(9.4,164,22,1,"PAH",32,1,8,0)=" produce a report on specific VA Classification.  A facility reported that"
^DIC(9.4,164,22,1,"PAH",32,1,9,0)=" they noticed missing entries after generating the report.  When using the"
^DIC(9.4,164,22,1,"PAH",32,1,10,0)=" Drug Enter/Edit [PSS DRUG ENTER/EDIT] option, entries in the ""AOC"" MUMPS"
^DIC(9.4,164,22,1,"PAH",32,1,11,0)=" cross-reference only exist if the VA CLASSIFICATION field (#2) was"
^DIC(9.4,164,22,1,"PAH",32,1,12,0)=" entered after the PHARMACY ORDERABLE ITEM field (#2.1) in the DRUG file"
^DIC(9.4,164,22,1,"PAH",32,1,13,0)=" (#50)."
^DIC(9.4,164,22,1,"PAH",32,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",32,1,15,0)=" Solution: To make sure entries are properly set, this patch replaces the"
^DIC(9.4,164,22,1,"PAH",32,1,16,0)=" ""AOC"" MUMPS cross-reference with a new ""AOC"" compound index associated"
^DIC(9.4,164,22,1,"PAH",32,1,17,0)=" with the VA CLASSIFICATION field (#2) and PHARMACY ORDERABLE ITEM field"
^DIC(9.4,164,22,1,"PAH",32,1,18,0)=" (#2.1) in the DRUG file (#50). This solution will create an entry in the"
^DIC(9.4,164,22,1,"PAH",32,1,19,0)=" ""AOC"" compound index anytime both fields are modified regardless of the"
^DIC(9.4,164,22,1,"PAH",32,1,20,0)=" order."
^DIC(9.4,164,22,1,"PAH",33,0)="32 SEQ #34^3000816^1"
^DIC(9.4,164,22,1,"PAH",33,1,0)="^^75^75^3000816"
^DIC(9.4,164,22,1,"PAH",33,1,1,0)=" This patch contains several problems and resolutions related Pharmacy "
^DIC(9.4,164,22,1,"PAH",33,1,2,0)=" Data Management V. 1.0. "
^DIC(9.4,164,22,1,"PAH",33,1,3,0)=" "
^DIC(9.4,164,22,1,"PAH",33,1,4,0)=" 1.  Problem:  In the Drug Enter/Edit [PSS DRUG ENTER/EDIT] option, a "
^DIC(9.4,164,22,1,"PAH",33,1,5,0)=" problem was discovered with identifying an inactive orderable item "
^DIC(9.4,164,22,1,"PAH",33,1,6,0)=" before it is matched or tied to a dispense drug. Users find it difficult"
^DIC(9.4,164,22,1,"PAH",33,1,7,0)=" to select an active orderable item since the inactive date is not "
^DIC(9.4,164,22,1,"PAH",33,1,8,0)=" displayed.  "
^DIC(9.4,164,22,1,"PAH",33,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",33,1,10,0)=" Resolution:  The characteristics of the INACTIVE DATE field (#.04) in the"
^DIC(9.4,164,22,1,"PAH",33,1,11,0)=" PHARMACY ORDERABLE ITEM file (#50.7) was enhanced by classifying the"
^DIC(9.4,164,22,1,"PAH",33,1,12,0)=" field as an identifier.  When the user performs a lookup on selectable"
^DIC(9.4,164,22,1,"PAH",33,1,13,0)=" orderable items, the option will display the inactive date associated"
^DIC(9.4,164,22,1,"PAH",33,1,14,0)=" with the orderable item."
^DIC(9.4,164,22,1,"PAH",33,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",33,1,16,0)=" 2.  Problem:  In the Drug Enter/Edit [PSS DRUG ENTER/EDIT] option, the "
^DIC(9.4,164,22,1,"PAH",33,1,17,0)=" user noticed excessive looping after matching or tying an IV Additive or "
^DIC(9.4,164,22,1,"PAH",33,1,18,0)=" Solution to an orderable item.  The user is asked repeatedly to enter "
^DIC(9.4,164,22,1,"PAH",33,1,19,0)=" another IV Additive or Solution.  The user has to press return several "
^DIC(9.4,164,22,1,"PAH",33,1,20,0)=" times to move to the next section in the option.  "
^DIC(9.4,164,22,1,"PAH",33,1,21,0)=" "
^DIC(9.4,164,22,1,"PAH",33,1,22,0)=" Resolution:  The Drug Enter/Edit [PSS DRUG ENTER/EDIT] option was "
^DIC(9.4,164,22,1,"PAH",33,1,23,0)=" enhanced to allow the user to decide whether to enter another IV "
^DIC(9.4,164,22,1,"PAH",33,1,24,0)=" Additive or Solution before moving to the next section.  "
^DIC(9.4,164,22,1,"PAH",33,1,25,0)=" "
^DIC(9.4,164,22,1,"PAH",33,1,26,0)=" 3.  Problem: In the Drug Enter/Edit [PSS DRUG ENTER/EDIT] option, the "
^DIC(9.4,164,22,1,"PAH",33,1,27,0)=" user encountered an <UNDEFINED> UD^PSSDEE error when editing a drug that "
^DIC(9.4,164,22,1,"PAH",33,1,28,0)=" has been previously marked for CMOP. After the ""Do you wish to UNmark "
^DIC(9.4,164,22,1,"PAH",33,1,29,0)=" this drug to transmit to CMOP? "" prompt, the problem occurred as a result"
^DIC(9.4,164,22,1,"PAH",33,1,30,0)=" of killing the DA variable found at line tag UNMARK+1 in the PSSMARK "
^DIC(9.4,164,22,1,"PAH",33,1,31,0)=" routine. When the coding logic returned to the PSSDEE routine, the DA "
^DIC(9.4,164,22,1,"PAH",33,1,32,0)=" variable was detected as undefined since it was not reset to its "
^DIC(9.4,164,22,1,"PAH",33,1,33,0)=" original value. "
^DIC(9.4,164,22,1,"PAH",33,1,34,0)=" "
^DIC(9.4,164,22,1,"PAH",33,1,35,0)=" Resolution:  In reference to the Drug Enter/Edit [PSS DRUG ENTER/EDIT] "
^DIC(9.4,164,22,1,"PAH",33,1,36,0)=" option, the PSSDEE routine was modified to store the value of the DA "
^DIC(9.4,164,22,1,"PAH",33,1,37,0)=" variable into an alternate variable so that the value of the DA variable "
^DIC(9.4,164,22,1,"PAH",33,1,38,0)=" can be retained for further use.  "
^DIC(9.4,164,22,1,"PAH",33,1,39,0)=" "
^DIC(9.4,164,22,1,"PAH",33,1,40,0)=" 4.  Problem:  A minor enhancement was added to the Edit Orderable Items "
^DIC(9.4,164,22,1,"PAH",33,1,41,0)=" [PSS EDIT ORDERABLE ITEMS] option.  When editing the CORRESPONDING IV "
^DIC(9.4,164,22,1,"PAH",33,1,42,0)=" ITEM field (#4) or CORRESPONDING UD ITEM field (#3) in the PHARMACY "
^DIC(9.4,164,22,1,"PAH",33,1,43,0)=" ORDERABLE ITEM file (#50.7), the default prompt only showed the orderable"
^DIC(9.4,164,22,1,"PAH",33,1,44,0)=" item name and did not include any reference to the DOSAGE FORM field "
^DIC(9.4,164,22,1,"PAH",33,1,45,0)=" (#.02) in the PHARMACY ORDERABLE ITEM file (#50.7).  The selection "
^DIC(9.4,164,22,1,"PAH",33,1,46,0)=" process was confusing if there were multiple orderable items with the "
^DIC(9.4,164,22,1,"PAH",33,1,47,0)=" same name with different dosage forms.  "
^DIC(9.4,164,22,1,"PAH",33,1,48,0)=" "
^DIC(9.4,164,22,1,"PAH",33,1,49,0)=" Resolution: To alleviate confusion, the Edit Orderable Items [PSS EDIT "
^DIC(9.4,164,22,1,"PAH",33,1,50,0)=" ORDERABLE ITEMS] option was enhanced to display a message to the user "
^DIC(9.4,164,22,1,"PAH",33,1,51,0)=" prior to the prompt. The message will indicate both the orderable item "
^DIC(9.4,164,22,1,"PAH",33,1,52,0)=" name and dosage form information.  "
^DIC(9.4,164,22,1,"PAH",33,1,53,0)=" "
^DIC(9.4,164,22,1,"PAH",33,1,54,0)=" 5.  Problem: In the Edit Orderable Items [PSS EDIT ORDERABLE ITEMS] "
^DIC(9.4,164,22,1,"PAH",33,1,55,0)=" option, the user noticed a problem with modifying and storing information"
^DIC(9.4,164,22,1,"PAH",33,1,56,0)=" related to the orderable item. The problem was related to an outdated "
^DIC(9.4,164,22,1,"PAH",33,1,57,0)=" global reference to a reconstructed National Drug File (NDF) file within "
^DIC(9.4,164,22,1,"PAH",33,1,58,0)=" the input transform placed on the PHARMACY ORDERABLE ITEM field (#2.1) in"
^DIC(9.4,164,22,1,"PAH",33,1,59,0)=" the DRUG file (#50).  "
^DIC(9.4,164,22,1,"PAH",33,1,60,0)=" "
^DIC(9.4,164,22,1,"PAH",33,1,61,0)=" Resolution: To resolve this problem, the input transform associated with "
^DIC(9.4,164,22,1,"PAH",33,1,62,0)=" the PHARMACY ORDERABLE ITEM field (#2.1) was modified by replacing the "
^DIC(9.4,164,22,1,"PAH",33,1,63,0)=" old NDF global reference with a NDF Application Programming Interfaces "
^DIC(9.4,164,22,1,"PAH",33,1,64,0)=" (API) call to retrieve the dosage form information from the proper file."
^DIC(9.4,164,22,1,"PAH",33,1,65,0)=" "
^DIC(9.4,164,22,1,"PAH",33,1,66,0)=" "
^DIC(9.4,164,22,1,"PAH",33,1,67,0)=" 6.  Problem: The Drug Enter/Edit [PSS DRUG ENTER/EDIT] option failed to "
^DIC(9.4,164,22,1,"PAH",33,1,68,0)=" notify the user when a dispense drug is matched or tied to an inactive "
^DIC(9.4,164,22,1,"PAH",33,1,69,0)=" orderable item. The user would like to see a warning message before s/he "
^DIC(9.4,164,22,1,"PAH",33,1,70,0)=" is asked, ""Do you want to match to a different Orderable Item? NO//."" "
^DIC(9.4,164,22,1,"PAH",33,1,71,0)=" "
^DIC(9.4,164,22,1,"PAH",33,1,72,0)=" Resolution:  To resolve this problem, the Drug Enter/Edit [PSS DRUG "
^DIC(9.4,164,22,1,"PAH",33,1,73,0)=" ENTER/EDIT] option was enhanced to warn the user when a dispense drug is "
^DIC(9.4,164,22,1,"PAH",33,1,74,0)=" matched or tied to an inactive orderable item and provide the name of the"
^DIC(9.4,164,22,1,"PAH",33,1,75,0)=" option where the user can make the proper changes.  "
^DIC(9.4,164,22,1,"PAH",34,0)="34 SEQ #35^3001027^1"
^DIC(9.4,164,22,1,"PAH",34,1,0)="^^24^24^3001027"
^DIC(9.4,164,22,1,"PAH",34,1,1,0)="This patch provides the functionality needed to prepare for the Pharmacy"
^DIC(9.4,164,22,1,"PAH",34,1,2,0)="Ordering Enhancements project. This project will involve patches by four"
^DIC(9.4,164,22,1,"PAH",34,1,3,0)="packages; Computerized Patient Record System (CPRS), Inpatient"
^DIC(9.4,164,22,1,"PAH",34,1,4,0)="Medications, Outpatient Pharmacy, and Pharmacy Data Management. This"
^DIC(9.4,164,22,1,"PAH",34,1,5,0)="Pharmacy Data Management patch, PSS*1*34, provides the tools necessary to"
^DIC(9.4,164,22,1,"PAH",34,1,6,0)="set up the Pharmacy files in advance of the Pharmacy Ordering Enhancements"
^DIC(9.4,164,22,1,"PAH",34,1,7,0)="project."
^DIC(9.4,164,22,1,"PAH",34,1,8,0)=" "
^DIC(9.4,164,22,1,"PAH",34,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",34,1,10,0)="The Implementation Guide and Installation Guide for this patch can be"
^DIC(9.4,164,22,1,"PAH",34,1,11,0)="obtained on the VISTA Pharmacy Data Management web page. The address is"
^DIC(9.4,164,22,1,"PAH",34,1,12,0)="http://vista.domain.ext/pdm."
^DIC(9.4,164,22,1,"PAH",34,1,13,0)=" "
^DIC(9.4,164,22,1,"PAH",34,1,14,0)="  "
^DIC(9.4,164,22,1,"PAH",34,1,15,0)="The Implementation Guide and Installation Guide are also available on"
^DIC(9.4,164,22,1,"PAH",34,1,16,0)="the ANONYMOUS.SOFTWARE directory at one of the following Office of"
^DIC(9.4,164,22,1,"PAH",34,1,17,0)="Information (OI) Field Offices. The file names are PDM1P34_IG.PDF for"
^DIC(9.4,164,22,1,"PAH",34,1,18,0)="the Installation Guide, and PDM1P34_IMPG.PDF for the Implementation Guide."
^DIC(9.4,164,22,1,"PAH",34,1,19,0)=" "
^DIC(9.4,164,22,1,"PAH",34,1,20,0)="  OI FIELD OFFICE                FTP ADDRESS          DIRECTORY"
^DIC(9.4,164,22,1,"PAH",34,1,21,0)="  ===============                ===========          ========="
^DIC(9.4,164,22,1,"PAH",34,1,22,0)="  Albany                         152.127.1.5          anonymous.software"
^DIC(9.4,164,22,1,"PAH",34,1,23,0)="  Hines                          152.129.1.110        anonymous.software"
^DIC(9.4,164,22,1,"PAH",34,1,24,0)="  Salt Lake City                 152.131.2.1          anonymous.software "
^DIC(9.4,164,22,1,"PAH",35,0)="35 SEQ #36^3001027^1"
^DIC(9.4,164,22,1,"PAH",35,1,0)="^^48^48^3001027"
^DIC(9.4,164,22,1,"PAH",35,1,1,0)="1.  Several sites have reported a problem when trying to document the"
^DIC(9.4,164,22,1,"PAH",35,1,2,0)="dispensing of medications through the Bar Code Med Admin (BCMA)"
^DIC(9.4,164,22,1,"PAH",35,1,3,0)="software.  The sites have reported receiving the following error:"
^DIC(9.4,164,22,1,"PAH",35,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",35,1,5,0)="1. Data Validation Error: 701: The value 'AC' for field DOSES ORDERED in"
^DIC(9.4,164,22,1,"PAH",35,1,6,0)="DISPENSE DRUG SUB-FIELD in file BCMA MEDICATION LOG is not valid."
^DIC(9.4,164,22,1,"PAH",35,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",35,1,8,0)="The problem was with the input transform on the UNITS PER DOSE field"
^DIC(9.4,164,22,1,"PAH",35,1,9,0)="(#.02) in the DISPENSE DRUG sub-file (#53.4502) of the INPATIENT USER"
^DIC(9.4,164,22,1,"PAH",35,1,10,0)="PARAMETERS file (#53.45) and the DISPENSE DRUG sub-file (#53.11) of the"
^DIC(9.4,164,22,1,"PAH",35,1,11,0)="NON-VERIFIED ORDERS file (#53.1). The problem with the input transform"
^DIC(9.4,164,22,1,"PAH",35,1,12,0)="also exists in the PHARMACY PATIENT file (#55), UNIT DOSE sub-file"
^DIC(9.4,164,22,1,"PAH",35,1,13,0)="(#55.06), DISPENSE DRUG sub-file (#55.07), UNITS PER DOSE field (#.02)."
^DIC(9.4,164,22,1,"PAH",35,1,14,0)="Patch PSJ*5*43 corrects the problem in the INPATIENT USER PARAMETERS file"
^DIC(9.4,164,22,1,"PAH",35,1,15,0)="(#53.45) and the NON-VERIFIED ORDERS file (#53.1). This patch corrects"
^DIC(9.4,164,22,1,"PAH",35,1,16,0)="this problem in the PHARMACY PATIENT file (#55). NOIS#s NOL-0300-71473,"
^DIC(9.4,164,22,1,"PAH",35,1,17,0)="HOU-0300-71626, and CMO-0300-43187."
^DIC(9.4,164,22,1,"PAH",35,1,18,0)=" "
^DIC(9.4,164,22,1,"PAH",35,1,19,0)="2.  Site reported a problem where they entered an infusion rate of @x and"
^DIC(9.4,164,22,1,"PAH",35,1,20,0)="x labels didn't print.  Only 1 label printed.  The issue is that only one"
^DIC(9.4,164,22,1,"PAH",35,1,21,0)="administration time was specified.  The administration time overrides the"
^DIC(9.4,164,22,1,"PAH",35,1,22,0)="entry of @x when determining how many labels will print.  This patch"
^DIC(9.4,164,22,1,"PAH",35,1,23,0)="modifies the field descriptions and the documentation for INFUSION RATE in"
^DIC(9.4,164,22,1,"PAH",35,1,24,0)="order to clarify which field determines the number of labels.  Modified"
^DIC(9.4,164,22,1,"PAH",35,1,25,0)="USUAL INFUSION RATE field (#2) in the IV ADDITIVES file (#52.6), QUICK"
^DIC(9.4,164,22,1,"PAH",35,1,26,0)="CODE sub-file (#52.61) and the INFUSION RATE field (#.08) in the PHARMACY"
^DIC(9.4,164,22,1,"PAH",35,1,27,0)="PATIENT file (#55), IV sub-file (#55.01)."
^DIC(9.4,164,22,1,"PAH",35,1,28,0)=" "
^DIC(9.4,164,22,1,"PAH",35,1,29,0)="3.  The vendor for the ATC systems called to say they now have two"
^DIC(9.4,164,22,1,"PAH",35,1,30,0)="machines with canister numbers higher than currently allowed.  This patch"
^DIC(9.4,164,22,1,"PAH",35,1,31,0)="modifies the ATC CANISTER field (#1) of the DRUG file (#50), ATC CANISTER"
^DIC(9.4,164,22,1,"PAH",35,1,32,0)="sub-file (#50.0212) to increase the canister limit from 500 to 800 and"
^DIC(9.4,164,22,1,"PAH",35,1,33,0)="remove the references to Baxter since the company name has changed.  This"
^DIC(9.4,164,22,1,"PAH",35,1,34,0)="patch also modified the following entries to remove the references to the"
^DIC(9.4,164,22,1,"PAH",35,1,35,0)="company name of Baxter:  DRUG file (#50), ATC CANISTER sub-file (#212),"
^DIC(9.4,164,22,1,"PAH",35,1,36,0)="field description, DRUG file (#50), ATC MNEMONIC field (#212.2), DRUG file"
^DIC(9.4,164,22,1,"PAH",35,1,37,0)="(#50), ATC CANISTER sub-file (#212), WARD GROUP FOR ATC CANISTER field"
^DIC(9.4,164,22,1,"PAH",35,1,38,0)="(.01)."
^DIC(9.4,164,22,1,"PAH",35,1,39,0)=" "
^DIC(9.4,164,22,1,"PAH",35,1,40,0)="4.  An inconsistency was discovered between the Computerized "
^DIC(9.4,164,22,1,"PAH",35,1,41,0)="Patient Record System (CPRS) and the Inpatient Medications validation of"
^DIC(9.4,164,22,1,"PAH",35,1,42,0)="Provider Comments/Special Instructions.  CPRS allows entry of text with no"
^DIC(9.4,164,22,1,"PAH",35,1,43,0)="spaces while Inpatient Medications requires spaces.  This patch corrects"
^DIC(9.4,164,22,1,"PAH",35,1,44,0)="this problem by modifying the validation of Special Instructions to allow"
^DIC(9.4,164,22,1,"PAH",35,1,45,0)="an entry with no spaces."
^DIC(9.4,164,22,1,"PAH",35,1,46,0)=" "
^DIC(9.4,164,22,1,"PAH",35,1,47,0)="5.  The INPATIENT PRESCRIPTION PROFILE field (#70) in the PHARMACY PATIENT"
^DIC(9.4,164,22,1,"PAH",35,1,48,0)="file (#55) is no longer used.  This patch deletes this field."
^DIC(9.4,164,22,1,"PAH",36,0)="33 SEQ #37^3010205^1"
^DIC(9.4,164,22,1,"PAH",36,1,0)="^^2^2^3010205"
^DIC(9.4,164,22,1,"PAH",36,1,1,0)="See Patch PSS*1*33 in the National Patch Module for description of the"
^DIC(9.4,164,22,1,"PAH",36,1,2,0)="Build."
^DIC(9.4,164,22,1,"PAH",37,0)="39 SEQ #38^3010227^1"
^DIC(9.4,164,22,1,"PAH",37,1,0)="^^2^2^3010227"
^DIC(9.4,164,22,1,"PAH",37,1,1,0)="See patch PSS*1*39 in the National Patch Module for description of the"
^DIC(9.4,164,22,1,"PAH",37,1,2,0)="build."
^DIC(9.4,164,22,1,"PAH",38,0)="42 SEQ #39^3010319^1"
^DIC(9.4,164,22,1,"PAH",38,1,0)="^^2^2^3010319"
^DIC(9.4,164,22,1,"PAH",38,1,1,0)="This patch adds a new field, NDF UPDATE (#5) to the ACTIVITY LOG"
^DIC(9.4,164,22,1,"PAH",38,1,2,0)="multiple (#214) in the DRUG file (#50)."
^DIC(9.4,164,22,1,"PAH",39,0)="40 SEQ #40^3010319^1"
^DIC(9.4,164,22,1,"PAH",39,1,0)="^^68^68^3010319"
^DIC(9.4,164,22,1,"PAH",39,1,1,0)="This patch exports two new options that can be used to assist sites in the"
^DIC(9.4,164,22,1,"PAH",39,1,2,0)="pharmacy set-up work for the Pharmacy Ordering Enhancements (POE) project."
^DIC(9.4,164,22,1,"PAH",39,1,3,0)="The two options are named:"
^DIC(9.4,164,22,1,"PAH",39,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",39,1,5,0)="          Orderable Item/Dosages Report [PSS ORDERABLE ITEM DOSAGES]"
^DIC(9.4,164,22,1,"PAH",39,1,6,0)="          Patient Instructions Report [PSS INSTRUCTIONS/ITEMS REPORT]"
^DIC(9.4,164,22,1,"PAH",39,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",39,1,8,0)="These options will be accessible under the Orderable Item Management [PSS"
^DIC(9.4,164,22,1,"PAH",39,1,9,0)="ORDERABLE ITEM MANAGEMENT] menu option."
^DIC(9.4,164,22,1,"PAH",39,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",39,1,11,0)="Orderable Item/Dosages Report [PSS ORDERABLE ITEM DOSAGES] option:"
^DIC(9.4,164,22,1,"PAH",39,1,12,0)="This option prints a report that displays Inpatient and Outpatient"
^DIC(9.4,164,22,1,"PAH",39,1,13,0)="Dosages for Pharmacy Orderable Items. These are the dosages that will"
^DIC(9.4,164,22,1,"PAH",39,1,14,0)="display for selection through Computerized Patient Record System (CPRS)"
^DIC(9.4,164,22,1,"PAH",39,1,15,0)="when an Orderable Item is selected for a medication order. The report is"
^DIC(9.4,164,22,1,"PAH",39,1,16,0)="sorted by Pharmacy Orderable Item. Along with each dosage that is"
^DIC(9.4,164,22,1,"PAH",39,1,17,0)="displayed on the report, the name of the Drug entry from the DRUG file"
^DIC(9.4,164,22,1,"PAH",39,1,18,0)="(#50) that provides the dosage will also display. Not every dosage from"
^DIC(9.4,164,22,1,"PAH",39,1,19,0)="the DRUG file (#50) will display on this report. For example, if there are"
^DIC(9.4,164,22,1,"PAH",39,1,20,0)="duplicate Possible Dosages for a Pharmacy Orderable Item, and there are"
^DIC(9.4,164,22,1,"PAH",39,1,21,0)="different Dispense Units per Dose, then only the Possible Dosage with the"
^DIC(9.4,164,22,1,"PAH",39,1,22,0)="lowest Dispense Units per Dose will display on the report. If there are"
^DIC(9.4,164,22,1,"PAH",39,1,23,0)="Possible Dosages and Local Possible Dosages for drugs tied to the Pharmacy"
^DIC(9.4,164,22,1,"PAH",39,1,24,0)="Orderable Item, then only the Possible Dosages will display on the report."
^DIC(9.4,164,22,1,"PAH",39,1,25,0)="In summary, this report will screen out Possible Dosages and Local"
^DIC(9.4,164,22,1,"PAH",39,1,26,0)="Possible Dosage when appropriate, so only the dosages selectable through"
^DIC(9.4,164,22,1,"PAH",39,1,27,0)="CPRS will display on this report."
^DIC(9.4,164,22,1,"PAH",39,1,28,0)=" "
^DIC(9.4,164,22,1,"PAH",39,1,29,0)=" "
^DIC(9.4,164,22,1,"PAH",39,1,30,0)="Patient Instructions Report [PSS INSTRUCTIONS/ITEMS REPORT] option:"
^DIC(9.4,164,22,1,"PAH",39,1,31,0)="Due to numerous requests, a change has been made to the PATIENT"
^DIC(9.4,164,22,1,"PAH",39,1,32,0)="INSTRUCTIONS field (#7) of the PHARMACY ORDERABLE ITEM file (#50.7). Data"
^DIC(9.4,164,22,1,"PAH",39,1,33,0)="in this field will now be checked for possible expansions, by running each"
^DIC(9.4,164,22,1,"PAH",39,1,34,0)="word through the MEDICATION INSTRUCTION file (#51), similar to how the"
^DIC(9.4,164,22,1,"PAH",39,1,35,0)="SIG has been traditionally expanded in the Outpatient Pharmacy"
^DIC(9.4,164,22,1,"PAH",39,1,36,0)="application. The data will still be stored in condensed form, but will"
^DIC(9.4,164,22,1,"PAH",39,1,37,0)="print in expanded form when used by the various applications in POE. This"
^DIC(9.4,164,22,1,"PAH",39,1,38,0)="includes all reports, displays in CPRS, displays in Outpatient Pharmacy,"
^DIC(9.4,164,22,1,"PAH",39,1,39,0)="and when the SIG prints on the Outpatient Pharmacy labels. It is important"
^DIC(9.4,164,22,1,"PAH",39,1,40,0)="that any Patient Instructions entered prior the installation of this patch"
^DIC(9.4,164,22,1,"PAH",39,1,41,0)="be reviewed, to ensure that if a word didn't expand when originally"
^DIC(9.4,164,22,1,"PAH",39,1,42,0)="entered and now does expand, that the expansion is appropriate. The"
^DIC(9.4,164,22,1,"PAH",39,1,43,0)="Patient Instructions Report option can be used to review any Patient"
^DIC(9.4,164,22,1,"PAH",39,1,44,0)="Instructions that are entered in the PHARMACY ORDERABLE ITEM file (#50.7)."
^DIC(9.4,164,22,1,"PAH",39,1,45,0)=" "
^DIC(9.4,164,22,1,"PAH",39,1,46,0)="In addition to the new Patient Instructions Report, this patch makes a"
^DIC(9.4,164,22,1,"PAH",39,1,47,0)="change to the PATIENT INSTRUCTIONS field (#7) of the PHARMACY ORDERABLE"
^DIC(9.4,164,22,1,"PAH",39,1,48,0)="ITEM file (#50.7). When data is entered into this field, the expanded"
^DIC(9.4,164,22,1,"PAH",39,1,49,0)="version of the data will now echo back to the user."
^DIC(9.4,164,22,1,"PAH",39,1,50,0)=" "
^DIC(9.4,164,22,1,"PAH",39,1,51,0)=" "
^DIC(9.4,164,22,1,"PAH",39,1,52,0)=" "
^DIC(9.4,164,22,1,"PAH",39,1,53,0)="Change pages have been issued for the Pharmacy Ordering Enhancements"
^DIC(9.4,164,22,1,"PAH",39,1,54,0)="Pharmacy Data Management Pre-Release Implementation Guide, initially"
^DIC(9.4,164,22,1,"PAH",39,1,55,0)="distributed with patch PSS*1*34. These change pages can be obtained on the"
^DIC(9.4,164,22,1,"PAH",39,1,56,0)="VISTA Pharmacy Data Management web page at"
^DIC(9.4,164,22,1,"PAH",39,1,57,0)="http://vista.domain.ext/PDM/pdm_documentation.htm ."
^DIC(9.4,164,22,1,"PAH",39,1,58,0)=" "
^DIC(9.4,164,22,1,"PAH",39,1,59,0)="The Pharmacy Ordering Enhancements Pharmacy Data Management Pre-Release"
^DIC(9.4,164,22,1,"PAH",39,1,60,0)="Implementation Guide is also available on the ANONYMOUS.SOFTWARE directory"
^DIC(9.4,164,22,1,"PAH",39,1,61,0)="at one of the following Office of Information (OI) Field Offices. The"
^DIC(9.4,164,22,1,"PAH",39,1,62,0)="Implementation Guide's file name is PDM1P34_IMPG.PDF."
^DIC(9.4,164,22,1,"PAH",39,1,63,0)=" "
^DIC(9.4,164,22,1,"PAH",39,1,64,0)="  OI FIELD OFFICE                FTP ADDRESS          DIRECTORY"
^DIC(9.4,164,22,1,"PAH",39,1,65,0)="  ===============                ===========          ========="
^DIC(9.4,164,22,1,"PAH",39,1,66,0)="  Albany                         152.127.1.5          anonymous.software"
^DIC(9.4,164,22,1,"PAH",39,1,67,0)="  Hines                          152.129.1.110        anonymous.software"
^DIC(9.4,164,22,1,"PAH",39,1,68,0)="  Salt Lake City                 152.131.2.1          anonymous.software "
^DIC(9.4,164,22,1,"PAH",40,0)="43 SEQ #41^3010430^1"
^DIC(9.4,164,22,1,"PAH",40,1,0)="^^3^3^3010430"
^DIC(9.4,164,22,1,"PAH",40,1,1,0)="This patch provides the functionality needed to fix NOIS PTH-0301-21164."
^DIC(9.4,164,22,1,"PAH",40,1,2,0)="This will fix the problem of bad interactions presently on your system"
^DIC(9.4,164,22,1,"PAH",40,1,3,0)="as well."
^DIC(9.4,164,22,1,"PAH",41,0)="41 SEQ #42^3010608^1"
^DIC(9.4,164,22,1,"PAH",41,1,0)="^^5^5^3010608"
^DIC(9.4,164,22,1,"PAH",41,1,1,0)="When using the PRimary Solution File (IV) [PSSJI SOLN] option, and"
^DIC(9.4,164,22,1,"PAH",41,1,2,0)="the ADditives File [PSSJI DRUG] option, it was reported that at the end"
^DIC(9.4,164,22,1,"PAH",41,1,3,0)="of the dialogue, the system is not responding correctly to the"
^DIC(9.4,164,22,1,"PAH",41,1,4,0)="""YES"" answer when prompted ""Would you like to enter another IV Additive"
^DIC(9.4,164,22,1,"PAH",41,1,5,0)="or Solution? NO//"". This patch fixes this problem."
^DIC(9.4,164,22,1,"PAH",42,0)="45 SEQ #43^3010608^1"
^DIC(9.4,164,22,1,"PAH",42,1,0)="^^32^32^3010608"
^DIC(9.4,164,22,1,"PAH",42,1,1,0)="Phase 1 of the Pharmacy Ordering Enhancements (POE) project introduced"
^DIC(9.4,164,22,1,"PAH",42,1,2,0)="functionality to create Possible Dosages and Local Possible Dosages in the"
^DIC(9.4,164,22,1,"PAH",42,1,3,0)="DRUG (#50) file. This work is being done in preparation of phase 2 of the"
^DIC(9.4,164,22,1,"PAH",42,1,4,0)="POE project, when these Possible Dosages and Local Possible Dosages will"
^DIC(9.4,164,22,1,"PAH",42,1,5,0)="be selectable during the Medication Ordering process in Outpatient"
^DIC(9.4,164,22,1,"PAH",42,1,6,0)="Pharmacy, Inpatient Medications, and Computerized Patient Record System"
^DIC(9.4,164,22,1,"PAH",42,1,7,0)="(CPRS)."
^DIC(9.4,164,22,1,"PAH",42,1,8,0)=" "
^DIC(9.4,164,22,1,"PAH",42,1,9,0)="One of the criteria that an entry in the DRUG (#50) file must meet for"
^DIC(9.4,164,22,1,"PAH",42,1,10,0)="that entry to have Possible Dosages is that the combination of Dosage Form"
^DIC(9.4,164,22,1,"PAH",42,1,11,0)="and Unit from the National Drug File match must be marked as convertible"
^DIC(9.4,164,22,1,"PAH",42,1,12,0)="in the DOSAGE FORM (#50.606) file. This data in the DOSAGE FORM (#50.606)"
^DIC(9.4,164,22,1,"PAH",42,1,13,0)="file was populated at the Field Office and exported with patch PSS*1*34."
^DIC(9.4,164,22,1,"PAH",42,1,14,0)="This data should only be edited and exported from the Field Office,"
^DIC(9.4,164,22,1,"PAH",42,1,15,0)="so this patch is exporting the data again, and will put restrictions on"
^DIC(9.4,164,22,1,"PAH",42,1,16,0)="those particular fields. This patch will also put restrictions on fields"
^DIC(9.4,164,22,1,"PAH",42,1,17,0)="in the DRUG (#50) file, to prevent invalid Possible Dosages from being"
^DIC(9.4,164,22,1,"PAH",42,1,18,0)="created. In addition, this patch will look for any invalid Possible"
^DIC(9.4,164,22,1,"PAH",42,1,19,0)="Dosages in the DRUG (#50) file, and either delete that Possible Dosage, or"
^DIC(9.4,164,22,1,"PAH",42,1,20,0)="remove the invalid package reference from that Possible Dosage. A mail"
^DIC(9.4,164,22,1,"PAH",42,1,21,0)="message will also be generated that lists any drugs that were affected by"
^DIC(9.4,164,22,1,"PAH",42,1,22,0)="this install. This message will be sent to the person installing the"
^DIC(9.4,164,22,1,"PAH",42,1,23,0)="patch, and all PSNMGR key holders. Reasons that a Possible Dosage would"
^DIC(9.4,164,22,1,"PAH",42,1,24,0)="have to be deleted are:"
^DIC(9.4,164,22,1,"PAH",42,1,25,0)=" "
^DIC(9.4,164,22,1,"PAH",42,1,26,0)="1) The drug is not matched to the National Drug File."
^DIC(9.4,164,22,1,"PAH",42,1,27,0)="2) The match to the National Drug File does not produce a valid Unit or"
^DIC(9.4,164,22,1,"PAH",42,1,28,0)="   Dosage Form."
^DIC(9.4,164,22,1,"PAH",42,1,29,0)="3) The Unit from the National Drug File match does not match the Unit in"
^DIC(9.4,164,22,1,"PAH",42,1,30,0)="   the DRUG (#50) file."
^DIC(9.4,164,22,1,"PAH",42,1,31,0)="4) The combination of Dosage Form/Unit from the National Drug File match"
^DIC(9.4,164,22,1,"PAH",42,1,32,0)="   is not marked as convertible in the DOSAGE FORM (#50.606) file."
^DIC(9.4,164,22,1,"PAH",43,0)="38^3010926^1"
^DIC(9.4,164,22,1,"PAH",43,1,0)="^^64^64^3010926"
^DIC(9.4,164,22,1,"PAH",43,1,1,0)="The Pharmacy Ordering Enhancements (POE) project provides enhancements"
^DIC(9.4,164,22,1,"PAH",43,1,2,0)="to Pharmacy Data Management (PDM) V. 1.0, Inpatient Medications"
^DIC(9.4,164,22,1,"PAH",43,1,3,0)="V. 5.0, Outpatient Pharmacy V. 7.0, and Order Entry/Results Reporting"
^DIC(9.4,164,22,1,"PAH",43,1,4,0)="(OE/RR) V. 3.0 medication ordering dialogues to eliminate redundant entry"
^DIC(9.4,164,22,1,"PAH",43,1,5,0)="of drug information during medication order entry, provide a more"
^DIC(9.4,164,22,1,"PAH",43,1,6,0)="consistent medication order entry process, provide expanded order"
^DIC(9.4,164,22,1,"PAH",43,1,7,0)="checking, display documented drug formulary statuses and corresponding"
^DIC(9.4,164,22,1,"PAH",43,1,8,0)="restriction/guidelines to the provider and pharmacist at the time of order"
^DIC(9.4,164,22,1,"PAH",43,1,9,0)="entry, and improve the process of medication order transfer between"
^DIC(9.4,164,22,1,"PAH",43,1,10,0)="Inpatient Medications and Outpatient Pharmacy applications.  This project"
^DIC(9.4,164,22,1,"PAH",43,1,11,0)="directly supports Computerized Patient Record System (CPRS), which is a"
^DIC(9.4,164,22,1,"PAH",43,1,12,0)="key component of Veterans Health Administration's (VHA) plan to expand"
^DIC(9.4,164,22,1,"PAH",43,1,13,0)="support for clinical operations. Additionally, order checks will be"
^DIC(9.4,164,22,1,"PAH",43,1,14,0)="provided for medication orders for which a dispense drug has not been"
^DIC(9.4,164,22,1,"PAH",43,1,15,0)="selected during the CPRS order entry process. It is also intended as a way"
^DIC(9.4,164,22,1,"PAH",43,1,16,0)="to help meet the goal outlined in Objective 8, Action 1 in the"
^DIC(9.4,164,22,1,"PAH",43,1,17,0)="Prescription for Change, which outlines the need to coordinate"
^DIC(9.4,164,22,1,"PAH",43,1,18,0)="national/Veterans Integrated Service Network (VISN) formularies and share"
^DIC(9.4,164,22,1,"PAH",43,1,19,0)="drug treatment guideline information. This project will promote system-"
^DIC(9.4,164,22,1,"PAH",43,1,20,0)="wide sharing of drug reviews and treatment guidelines thereby enhancing"
^DIC(9.4,164,22,1,"PAH",43,1,21,0)="patient safety."
^DIC(9.4,164,22,1,"PAH",43,1,22,0)=" "
^DIC(9.4,164,22,1,"PAH",43,1,23,0)="This project consists of four patches that work together to accomplish"
^DIC(9.4,164,22,1,"PAH",43,1,24,0)="these goals listed in order of install:"
^DIC(9.4,164,22,1,"PAH",43,1,25,0)=" "
^DIC(9.4,164,22,1,"PAH",43,1,26,0)="     PSO*7*46"
^DIC(9.4,164,22,1,"PAH",43,1,27,0)="     OR*3*94"
^DIC(9.4,164,22,1,"PAH",43,1,28,0)="     PSS*1*38"
^DIC(9.4,164,22,1,"PAH",43,1,29,0)="     PSJ*5*50"
^DIC(9.4,164,22,1,"PAH",43,1,30,0)=" "
^DIC(9.4,164,22,1,"PAH",43,1,31,0)=" "
^DIC(9.4,164,22,1,"PAH",43,1,32,0)="Installation Instructions and Documentation Retrieval:"
^DIC(9.4,164,22,1,"PAH",43,1,33,0)="======================================================"
^DIC(9.4,164,22,1,"PAH",43,1,34,0)=" "
^DIC(9.4,164,22,1,"PAH",43,1,35,0)="The Installation Guide, Release Notes, revised Pharmacy Data Management"
^DIC(9.4,164,22,1,"PAH",43,1,36,0)="(PDM) Technical Manual, and Pharmacy Data Management (PDM) User Manual are"
^DIC(9.4,164,22,1,"PAH",43,1,37,0)="on the ANONYMOUS.SOFTWARE directory at one of the following Office of"
^DIC(9.4,164,22,1,"PAH",43,1,38,0)="Information (OI) Field Offices."
^DIC(9.4,164,22,1,"PAH",43,1,39,0)="  "
^DIC(9.4,164,22,1,"PAH",43,1,40,0)="Sites may retrieve documentation in one of the following ways:"
^DIC(9.4,164,22,1,"PAH",43,1,41,0)=" "
^DIC(9.4,164,22,1,"PAH",43,1,42,0)="(1) The preferred method is to FTP the files from"
^DIC(9.4,164,22,1,"PAH",43,1,43,0)="download.vista.domain.ext, which will transmit the files from the first"
^DIC(9.4,164,22,1,"PAH",43,1,44,0)="available FTP server."
^DIC(9.4,164,22,1,"PAH",43,1,45,0)=" "
^DIC(9.4,164,22,1,"PAH",43,1,46,0)="(2) Sites may also elect to retrieve documentation directly from a"
^DIC(9.4,164,22,1,"PAH",43,1,47,0)="specific server as follows:"
^DIC(9.4,164,22,1,"PAH",43,1,48,0)=" "
^DIC(9.4,164,22,1,"PAH",43,1,49,0)="Albany          ftp.fo-albany.domain.ext"
^DIC(9.4,164,22,1,"PAH",43,1,50,0)="Hines           ftp.fo-hines.domain.ext"
^DIC(9.4,164,22,1,"PAH",43,1,51,0)="Salt Lake City  ftp.fo-slc.domain.ext"
^DIC(9.4,164,22,1,"PAH",43,1,52,0)=" "
^DIC(9.4,164,22,1,"PAH",43,1,53,0)="  The software distribution includes:"
^DIC(9.4,164,22,1,"PAH",43,1,54,0)=" "
^DIC(9.4,164,22,1,"PAH",43,1,55,0)=" FILE NAMES          DESCRIPTION"
^DIC(9.4,164,22,1,"PAH",43,1,56,0)=" "
^DIC(9.4,164,22,1,"PAH",43,1,57,0)=" CPRS_POE_10.KID     CPRS/Pharmacy Ordering Enhancements 1.0 Master Build"
^DIC(9.4,164,22,1,"PAH",43,1,58,0)=" CPRS_POE_1_1_IG.PDF Installation Guide"
^DIC(9.4,164,22,1,"PAH",43,1,59,0)=" CPRS_POE_1_0_RN.PDF Release Notes"
^DIC(9.4,164,22,1,"PAH",43,1,60,0)=" PDM_1_0_TM.PDF      Technical Manual/Security Guide"
^DIC(9.4,164,22,1,"PAH",43,1,61,0)=" PDM_1_0_UM.PDF      User Manual "
^DIC(9.4,164,22,1,"PAH",43,1,62,0)=" "
^DIC(9.4,164,22,1,"PAH",43,1,63,0)="(3) Documentation can also be retrieved from VISTA Document Library (VDL)"
^DIC(9.4,164,22,1,"PAH",43,1,64,0)="on the VA Intranet at the following address, http:/vista.domain.ext/vdl."
^DIC(9.4,164,22,1,"PAH",44,0)="49 SEQ #45^3011231^1"
^DIC(9.4,164,22,1,"PAH",44,1,0)="^^35^35^3011231"
^DIC(9.4,164,22,1,"PAH",44,1,1,0)="1) A problem has been reported concerning certain dosage selections in"
^DIC(9.4,164,22,1,"PAH",44,1,2,0)="   Inpatient Medications V. 5.0 and Computerized Patient Record System"
^DIC(9.4,164,22,1,"PAH",44,1,3,0)="   (CPRS) V. 3.0. The problem is in the Dosages that contain a ""/"", and"
^DIC(9.4,164,22,1,"PAH",44,1,4,0)="   when the second part of that Dosage begins with a decimal point. A"
^DIC(9.4,164,22,1,"PAH",44,1,5,0)="   leading zero was not being added to that second part of the Dosage. For"
^DIC(9.4,164,22,1,"PAH",44,1,6,0)="   example, a Dosage that is currently being displayed as 0.25MG/.5ML will"
^DIC(9.4,164,22,1,"PAH",44,1,7,0)="   be displayed as 0.25MG/0.5ML."
^DIC(9.4,164,22,1,"PAH",44,1,8,0)=" "
^DIC(9.4,164,22,1,"PAH",44,1,9,0)="  This change will affect the following:"
^DIC(9.4,164,22,1,"PAH",44,1,10,0)="  - The Review Dosages Report [PSS DOSAGE REVIEW REPORT] option."
^DIC(9.4,164,22,1,"PAH",44,1,11,0)="  - The Orderable Item/Dosages Report [PSS ORDERABLE ITEM DOSAGES] option."
^DIC(9.4,164,22,1,"PAH",44,1,12,0)="  - Display the leading zero when editing Dosages through either the Drug"
^DIC(9.4,164,22,1,"PAH",44,1,13,0)="    Enter/Edit [PSS DRUG ENTER/EDIT] option or the Enter/Edit Dosages [PSS"
^DIC(9.4,164,22,1,"PAH",44,1,14,0)="    EDIT DOSAGES] option."
^DIC(9.4,164,22,1,"PAH",44,1,15,0)="  - The display of Dispense Units per Dose has also been changed in the"
^DIC(9.4,164,22,1,"PAH",44,1,16,0)="    Pharmacy Data Management options to display a leading zero when the"
^DIC(9.4,164,22,1,"PAH",44,1,17,0)="    number begins with a decimal point."
^DIC(9.4,164,22,1,"PAH",44,1,18,0)=" "
^DIC(9.4,164,22,1,"PAH",44,1,19,0)="2) This patch also contains a change that will affect Computerized Patient"
^DIC(9.4,164,22,1,"PAH",44,1,20,0)="   Record System (CPRS). The Pharmacy Data Management package returns"
^DIC(9.4,164,22,1,"PAH",44,1,21,0)="   information to CPRS regarding the DEA Special Handling indication of a"
^DIC(9.4,164,22,1,"PAH",44,1,22,0)="   Pharmacy Orderable item, which is based on the DEA Special Handling"
^DIC(9.4,164,22,1,"PAH",44,1,23,0)="   information from the Dispense Drugs tied to the Pharmacy Orderable"
^DIC(9.4,164,22,1,"PAH",44,1,24,0)="   Item. Currently, if the DEA Special Handling code contains a ""1"", or"
^DIC(9.4,164,22,1,"PAH",44,1,25,0)="   contains a ""2"", or contains both the ""3"" and the ""A"", this indicates to"
^DIC(9.4,164,22,1,"PAH",44,1,26,0)="   CPRS that a wet signature is required. If this first condition is not"
^DIC(9.4,164,22,1,"PAH",44,1,27,0)="   met, but the DEA Special Handling code contains a ""4"", or contains a"
^DIC(9.4,164,22,1,"PAH",44,1,28,0)="   ""5"", or contains a ""3"" and not the ""A"", then a wet signature is not"
^DIC(9.4,164,22,1,"PAH",44,1,29,0)="   required, but it does indicate that it is a controlled substance. This"
^DIC(9.4,164,22,1,"PAH",44,1,30,0)="   patch changes that logic. With the installation of this patch, if the"
^DIC(9.4,164,22,1,"PAH",44,1,31,0)="   DEA Special Handling code contains a ""1"", or contains a ""2"", this"
^DIC(9.4,164,22,1,"PAH",44,1,32,0)="   indicates to CPRS that a wet signature is required. If this first"
^DIC(9.4,164,22,1,"PAH",44,1,33,0)="   condition is not met, but the DEA Special Handling code contains a ""3"","
^DIC(9.4,164,22,1,"PAH",44,1,34,0)="   or contains a ""4"", or contains a ""5"", then a wet signature is not"
^DIC(9.4,164,22,1,"PAH",44,1,35,0)="   required, but it does indicate that it is a controlled substance."
^DIC(9.4,164,22,1,"PAH",45,0)="44^3011231^1"
^DIC(9.4,164,22,1,"PAH",45,1,0)="^^20^20^3011231"
^DIC(9.4,164,22,1,"PAH",45,1,1,0)="1. A site reported a problem where a one-time order could not be"
^DIC(9.4,164,22,1,"PAH",45,1,2,0)="discontinued by the provider because it was expired due to the start and"
^DIC(9.4,164,22,1,"PAH",45,1,3,0)="stop date being the same. However, the medication still displayed in Bar"
^DIC(9.4,164,22,1,"PAH",45,1,4,0)="Code Medication Administration (BCMA) V. 1.0 because of the 12-hour rule"
^DIC(9.4,164,22,1,"PAH",45,1,5,0)="for displaying one-time orders on the Virtual Due List.  This patch"
^DIC(9.4,164,22,1,"PAH",45,1,6,0)="corrects this problem by changing the way the stop date for one-time"
^DIC(9.4,164,22,1,"PAH",45,1,7,0)="orders is calculated. There will be a ward parameter, system parameter and"
^DIC(9.4,164,22,1,"PAH",45,1,8,0)="the standard calculation. The hierarchy will be to check the one-time ward"
^DIC(9.4,164,22,1,"PAH",45,1,9,0)="parameter first, if not defined, check the system parameter.  If the"
^DIC(9.4,164,22,1,"PAH",45,1,10,0)="system parameter is not defined, the system will use the continuous order"
^DIC(9.4,164,22,1,"PAH",45,1,11,0)="parameters to determine the stop date, rather than the start and stop date"
^DIC(9.4,164,22,1,"PAH",45,1,12,0)="being equal.  Then, when BCMA marks the medication as 'Given', Inpatient"
^DIC(9.4,164,22,1,"PAH",45,1,13,0)="Medications will expire the order. NOIS# BUT-0501-20609"
^DIC(9.4,164,22,1,"PAH",45,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",45,1,15,0)="2. With the release of the Pharmacy Ordering Enhancements patches two"
^DIC(9.4,164,22,1,"PAH",45,1,16,0)="spaces were allowed in the schedule field.  In testing, it was discovered"
^DIC(9.4,164,22,1,"PAH",45,1,17,0)="that a user could enter the two spaces at the end of the schedule and it"
^DIC(9.4,164,22,1,"PAH",45,1,18,0)="was accepted by the software.  The software was not intended to work this"
^DIC(9.4,164,22,1,"PAH",45,1,19,0)="way.  Upon installation of this patch, the trailing spaces will be"
^DIC(9.4,164,22,1,"PAH",45,1,20,0)="stripped off the text the user enters at the schedule prompt."
^DIC(9.4,164,22,1,"PAH",46,0)="51 SEQ #47^3020204^1"
^DIC(9.4,164,22,1,"PAH",46,1,0)="^^16^16^3020204"
^DIC(9.4,164,22,1,"PAH",46,1,1,0)="1. A problem has been reported in the Drug Enter/Edit [PSS DRUG"
^DIC(9.4,164,22,1,"PAH",46,1,2,0)="   ENTER/EDIT] option. If a drug is edited that is not matched to Pharmacy"
^DIC(9.4,164,22,1,"PAH",46,1,3,0)="   Orderable Item, and the drug is matched to a Pharmacy Orderable Item in"
^DIC(9.4,164,22,1,"PAH",46,1,4,0)="   this option, then the Possible Dosages are reset after completion of"
^DIC(9.4,164,22,1,"PAH",46,1,5,0)="   the match. Possible Dosages should only be reset if the drug is matched"
^DIC(9.4,164,22,1,"PAH",46,1,6,0)="   to a Pharmacy Orderable Item when the option is first accessed, and the"
^DIC(9.4,164,22,1,"PAH",46,1,7,0)="   drug is rematched to a different Pharmacy Orderable Item with a"
^DIC(9.4,164,22,1,"PAH",46,1,8,0)="   different Dosage Form."
^DIC(9.4,164,22,1,"PAH",46,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",46,1,10,0)="2. A problem was reported in the Dispense Drug/Orderable Item Maintenance"
^DIC(9.4,164,22,1,"PAH",46,1,11,0)="   [PSS MAINTAIN ORDERABLE ITEMS] option. If a drug is not marked for"
^DIC(9.4,164,22,1,"PAH",46,1,12,0)="   Outpatient (O), Unit Dose (U), or IV (I) in the APPLICATION PACKAGES'"
^DIC(9.4,164,22,1,"PAH",46,1,13,0)="   USE (#63) field of the DRUG (#50) file, then it is not selectable in"
^DIC(9.4,164,22,1,"PAH",46,1,14,0)="   this option. These drugs will now be selectable. They will still not be"
^DIC(9.4,164,22,1,"PAH",46,1,15,0)="   selectable for ordering, but now they can be matched to a Pharmacy"
^DIC(9.4,164,22,1,"PAH",46,1,16,0)="   Orderable Item."
^DIC(9.4,164,22,1,"PAH",47,0)="53 SEQ #48^3020226^1"
^DIC(9.4,164,22,1,"PAH",47,1,0)="^^27^27^3020226"
^DIC(9.4,164,22,1,"PAH",47,1,1,0)="A problem can occur in Computerized Patient Record System (CPRS) when "
^DIC(9.4,164,22,1,"PAH",47,1,2,0)="duplicate Local Possible Dosages are displayed for selection in the "
^DIC(9.4,164,22,1,"PAH",47,1,3,0)="medication order entry process, and these duplicate Local Possible "
^DIC(9.4,164,22,1,"PAH",47,1,4,0)="Dosages have a duplicate Strength and Unit as part of the display. For "
^DIC(9.4,164,22,1,"PAH",47,1,5,0)="example, a dosage selection display such as:"
^DIC(9.4,164,22,1,"PAH",47,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",47,1,7,0)="SMALL AMOUNT OF 0.1%"
^DIC(9.4,164,22,1,"PAH",47,1,8,0)="SMALL AMOUNT OF 0.025%"
^DIC(9.4,164,22,1,"PAH",47,1,9,0)="SMALL AMOUNT OF 0.1%"
^DIC(9.4,164,22,1,"PAH",47,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",47,1,11,0)="In this example, the first and third Dosages come from different Dispense "
^DIC(9.4,164,22,1,"PAH",47,1,12,0)="Drugs, but since each of these drugs has a top level Strength and Unit "
^DIC(9.4,164,22,1,"PAH",47,1,13,0)="from the National Drug File match, the Strength and Unit are displayed "
^DIC(9.4,164,22,1,"PAH",47,1,14,0)="instead of the Dispense Drug name, which makes the selection ambiguous. "
^DIC(9.4,164,22,1,"PAH",47,1,15,0)="In addition, no matter which of these Local Possible Dosages is selected, "
^DIC(9.4,164,22,1,"PAH",47,1,16,0)="the first or the third, the same Dispense Drug is assigned to the order."
^DIC(9.4,164,22,1,"PAH",47,1,17,0)=" "
^DIC(9.4,164,22,1,"PAH",47,1,18,0)="To fix this problem, this patch will make a change to the way Local "
^DIC(9.4,164,22,1,"PAH",47,1,19,0)="Possible Dosages are returned to CPRS for display and selection. As in "
^DIC(9.4,164,22,1,"PAH",47,1,20,0)="this case, if there are duplicate Local Possible Dosages in the list, and "
^DIC(9.4,164,22,1,"PAH",47,1,21,0)="one of the duplicate sets also has a duplicate Strength and Unit for"
^DIC(9.4,164,22,1,"PAH",47,1,22,0)="different Dispense Drugs, then the Strength will not be returned to CPRS"
^DIC(9.4,164,22,1,"PAH",47,1,23,0)="along with the Local Possible Dosages. Then instead of CPRS displaying the"
^DIC(9.4,164,22,1,"PAH",47,1,24,0)="Strength and Unit, CPRS will display the Dispense Drug name, which should"
^DIC(9.4,164,22,1,"PAH",47,1,25,0)="differentiate the selection display, as long as the Dispense Drug names"
^DIC(9.4,164,22,1,"PAH",47,1,26,0)="are different. This will also resolve the selection problem of the same"
^DIC(9.4,164,22,1,"PAH",47,1,27,0)="Dispense Drug being assigned to the order, regardless of the selection."
^DIC(9.4,164,22,1,"PAH",48,0)="48 SEQ #49^3020315^1"
^DIC(9.4,164,22,1,"PAH",48,1,0)="^^12^12^3020315"
^DIC(9.4,164,22,1,"PAH",48,1,1,0)="1. It was reported that although some Dosage Form entries are inactivated,"
^DIC(9.4,164,22,1,"PAH",48,1,2,0)="   they are still showing up in the following options:"
^DIC(9.4,164,22,1,"PAH",48,1,3,0)="      -Dosage Form File Enter/Edit [PSS DOSAGE FORM EDIT]."
^DIC(9.4,164,22,1,"PAH",48,1,4,0)="      -Noun/Dosage Form Report [PSS DOSE FORM/NOUN REPORT]."
^DIC(9.4,164,22,1,"PAH",48,1,5,0)="   This patch insures that the inactivated entries will not be displayed"
^DIC(9.4,164,22,1,"PAH",48,1,6,0)="   in those options."
^DIC(9.4,164,22,1,"PAH",48,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",48,1,8,0)="2. When using the Drug Enter/Edit [PSS DRUG ENTER/EDIT] option, it was"
^DIC(9.4,164,22,1,"PAH",48,1,9,0)="   reported that if the drug is selected using the synonym entry, some-"
^DIC(9.4,164,22,1,"PAH",48,1,10,0)="   times it picks a wrong drug. This problem is due to the existence of"
^DIC(9.4,164,22,1,"PAH",48,1,11,0)="   an old cross-references (""IV"", ""IV1"", and ""IV2"") in the DRUG file"
^DIC(9.4,164,22,1,"PAH",48,1,12,0)="   (#50). This patch fixes this problem."
^DIC(9.4,164,22,1,"PAH",49,0)="50 SEQ #50^3020408^1"
^DIC(9.4,164,22,1,"PAH",49,1,0)="^^30^30^3020408"
^DIC(9.4,164,22,1,"PAH",49,1,1,0)="1. When using the Drug Enter/edit [PSS DRUG ENTER/EDIT] option and the"
^DIC(9.4,164,22,1,"PAH",49,1,2,0)="   Enter/Edit dosages [PSS EDIT DOSAGES] option, currently the software"
^DIC(9.4,164,22,1,"PAH",49,1,3,0)="   displays the Strength and the Unit of a drug only if it finds Possible"
^DIC(9.4,164,22,1,"PAH",49,1,4,0)="   Dosages assigned to that drug. This patch modifies routines PSSDOS and"
^DIC(9.4,164,22,1,"PAH",49,1,5,0)="   PSSDOSER to display the Strength, and the Unit of a drug that also has"
^DIC(9.4,164,22,1,"PAH",49,1,6,0)="   Local Possible Dosages assigned for the following conditions:"
^DIC(9.4,164,22,1,"PAH",49,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",49,1,8,0)=" - The software will populate the Strength of the drug from the STRENGTH"
^DIC(9.4,164,22,1,"PAH",49,1,9,0)="   field (#901) of the DRUG file (#50) if it is defined, otherwise it will"
^DIC(9.4,164,22,1,"PAH",49,1,10,0)="   populate from the STRENGTH field (#2) of the VA PRODUCT file (#50.68)."
^DIC(9.4,164,22,1,"PAH",49,1,11,0)=" "
^DIC(9.4,164,22,1,"PAH",49,1,12,0)=" - The software will populate the Unit of the drug from the UNIT field"
^DIC(9.4,164,22,1,"PAH",49,1,13,0)="   (#902) of the DRUG file (#50) if it is defined, otherwise it will"
^DIC(9.4,164,22,1,"PAH",49,1,14,0)="   populate from the UNIT field (#3) of the VA PRODUCT file (#50.68)."
^DIC(9.4,164,22,1,"PAH",49,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",49,1,16,0)=" - If both the Strength and the Unit fields are not populated then the"
^DIC(9.4,164,22,1,"PAH",49,1,17,0)="   software will display null values."
^DIC(9.4,164,22,1,"PAH",49,1,18,0)=" "
^DIC(9.4,164,22,1,"PAH",49,1,19,0)="2. When creating new dosages for a drug, the PACKAGE field (#3) in"
^DIC(9.4,164,22,1,"PAH",49,1,20,0)="   the DOSAGES multiple (#903) of the DRUG file (#50) is case-"
^DIC(9.4,164,22,1,"PAH",49,1,21,0)="   sensitive (allows only capital letters). This patch modifies the Input"
^DIC(9.4,164,22,1,"PAH",49,1,22,0)="   Transform of the PACKAGE field to accept lowercase letters as well."
^DIC(9.4,164,22,1,"PAH",49,1,23,0)=" "
^DIC(9.4,164,22,1,"PAH",49,1,24,0)="3. When using the Dosage Form File Enter/Edit [PSS DOSAGE FORM EDIT]"
^DIC(9.4,164,22,1,"PAH",49,1,25,0)="   option, it was reported that the MED ROUTE FOR DOSAGE FORM field (#.01)"
^DIC(9.4,164,22,1,"PAH",49,1,26,0)="   in the MED ROUTE FOR DOSAGE FORM multiple (#50.6061) of the DOSAGE FORM"
^DIC(9.4,164,22,1,"PAH",49,1,27,0)="   file (#50.606) can be assigned a Medication Route entry with a PACKAGE"
^DIC(9.4,164,22,1,"PAH",49,1,28,0)="   USE field (#3) of ""FOR NATIONAL DRUG FILE ONLY"" from the MEDICATION"
^DIC(9.4,164,22,1,"PAH",49,1,29,0)="   ROUTES file (#51.2). This patch prevents such Medication Route entries"
^DIC(9.4,164,22,1,"PAH",49,1,30,0)="   from being assigned to the MED ROUTE FOR DOSAGE FORM multiple."
^DIC(9.4,164,22,1,"PAH",50,0)="52^3020423^1"
^DIC(9.4,164,22,1,"PAH",50,1,0)="^^22^22^3020423"
^DIC(9.4,164,22,1,"PAH",50,1,1,0)="As a part of the Pharmacy Benefits Management (PBM) Extract enhancement"
^DIC(9.4,164,22,1,"PAH",50,1,2,0)="project, two new fields were added to the PHARMACY PATIENT file (#55)."
^DIC(9.4,164,22,1,"PAH",50,1,3,0)="They are FIRST SERVICE DATE (#.07) and ACTUAL/HISTORICAL FLAG (#.08)."
^DIC(9.4,164,22,1,"PAH",50,1,4,0)="With the addition of these two fields, Inpatient Medications V. 5.0 and"
^DIC(9.4,164,22,1,"PAH",50,1,5,0)="Outpatient Pharmacy V. 7.0 have been modified to set this information"
^DIC(9.4,164,22,1,"PAH",50,1,6,0)="when the first order for a patient becomes active."
^DIC(9.4,164,22,1,"PAH",50,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",50,1,8,0)="This project consists of three patches combined in a master build."
^DIC(9.4,164,22,1,"PAH",50,1,9,0)="Installation of this master build should be coordinated among the three"
^DIC(9.4,164,22,1,"PAH",50,1,10,0)="packages affected since only one installation is necessary.  The patches,"
^DIC(9.4,164,22,1,"PAH",50,1,11,0)="in order of install, are:"
^DIC(9.4,164,22,1,"PAH",50,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",50,1,13,0)="      PSS*1*52  PHARMACY DATA MANAGEMENT V. 1.0"
^DIC(9.4,164,22,1,"PAH",50,1,14,0)="      PSJ*5*68  INPATIENT MEDICATIONS V. 5.0"
^DIC(9.4,164,22,1,"PAH",50,1,15,0)="      PSO*7*95  OUTPATIENT PHARMACY V. 7.0"
^DIC(9.4,164,22,1,"PAH",50,1,16,0)=" "
^DIC(9.4,164,22,1,"PAH",50,1,17,0)="Upon completion of the installation of these three patches, the master"
^DIC(9.4,164,22,1,"PAH",50,1,18,0)="build will start a routine that will build the two new fields from"
^DIC(9.4,164,22,1,"PAH",50,1,19,0)="historical data in the PHARMACY PATIENT file (#55).  When the build is"
^DIC(9.4,164,22,1,"PAH",50,1,20,0)="complete, the user who initiated the install and the members of the"
^DIC(9.4,164,22,1,"PAH",50,1,21,0)="PSU PBM mail group will receive a message with a subject of BUILD OF FIRST"
^DIC(9.4,164,22,1,"PAH",50,1,22,0)="PHARMACY SERVICE INFO COMPLETE."
^DIC(9.4,164,22,1,"PAH",51,0)="46^3020528^1"
^DIC(9.4,164,22,1,"PAH",51,1,0)="^^17^17^3020528"
^DIC(9.4,164,22,1,"PAH",51,1,1,0)="1. The Bar Code Medication Administration (BCMA) V. 2.0 release provides "
^DIC(9.4,164,22,1,"PAH",51,1,2,0)="enhancements to Pharmacy Data Management (PDM) V. 1.0, and Inpatient "
^DIC(9.4,164,22,1,"PAH",51,1,3,0)="Medications V. 5.0. The BCMA V. 2.0 release expands and improves the"
^DIC(9.4,164,22,1,"PAH",51,1,4,0)="process of medication administration, especially in the area of IV"
^DIC(9.4,164,22,1,"PAH",51,1,5,0)="medications."
^DIC(9.4,164,22,1,"PAH",51,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",51,1,7,0)="In support of this, Inpatient Medications V. 5.0 and PDM V. 1.0 have added"
^DIC(9.4,164,22,1,"PAH",51,1,8,0)="the ability to print barcode identifiers on IV labels, IV order "
^DIC(9.4,164,22,1,"PAH",51,1,9,0)="verification and the ability to receive done priority orders via the CPRS "
^DIC(9.4,164,22,1,"PAH",51,1,10,0)="Med Order button in BCMA V. 2.0."
^DIC(9.4,164,22,1,"PAH",51,1,11,0)=" "
^DIC(9.4,164,22,1,"PAH",51,1,12,0)="This project consists of two patches and a new version of BCMA that work"
^DIC(9.4,164,22,1,"PAH",51,1,13,0)="together to accomplish these goals listed in order of install:"
^DIC(9.4,164,22,1,"PAH",51,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",51,1,15,0)="     PSS*1*46  PHARMACY DATA MANAGEMENT V. 1.0"
^DIC(9.4,164,22,1,"PAH",51,1,16,0)="     PSJ*5*58  INPATIENT MEDICATIONS V. 5.0"
^DIC(9.4,164,22,1,"PAH",51,1,17,0)="     BAR CODE MED ADMIN 2.0"
^DIC(9.4,164,22,1,"PAH",52,0)="54 SEQ #53^3020906^1"
^DIC(9.4,164,22,1,"PAH",52,1,0)="^^9^9^3020906"
^DIC(9.4,164,22,1,"PAH",52,1,1,0)="1. A site reported a problem with quitting the Drug Enter/Edit [PSS DRUG"
^DIC(9.4,164,22,1,"PAH",52,1,2,0)="ENTER/EDIT] option using the ""^"". When the user quits with an ""^"" at "
^DIC(9.4,164,22,1,"PAH",52,1,3,0)="the prompt ""Match to another Orderable Item with same Dosage Form?"" this"
^DIC(9.4,164,22,1,"PAH",52,1,4,0)="will not properly clean up. This has resulted in improper prompting when"
^DIC(9.4,164,22,1,"PAH",52,1,5,0)="using the Edit Data for a Patient in the Clozapine Program [PSO EDIT]"
^DIC(9.4,164,22,1,"PAH",52,1,6,0)="option. This patch fixes this problem. NOIS PUG-0202-52260"
^DIC(9.4,164,22,1,"PAH",52,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",52,1,8,0)="2. A site reported a problem with the display of the cost information for "
^DIC(9.4,164,22,1,"PAH",52,1,9,0)="a drug. This patch corrects this problem. NOIS NYH-1001-12352"
^DIC(9.4,164,22,1,"PAH",53,0)="60 SEQ #54^3021008^1"
^DIC(9.4,164,22,1,"PAH",53,1,0)="^^7^7^3021008"
^DIC(9.4,164,22,1,"PAH",53,1,1,0)=" A new field is being added to the IV multiple of the Pharmacy Patient "
^DIC(9.4,164,22,1,"PAH",53,1,2,0)="file (#55) to support a change in functionality for auto-reinstating"
^DIC(9.4,164,22,1,"PAH",53,1,3,0)="Inpatient Medications orders."
^DIC(9.4,164,22,1,"PAH",53,1,4,0)=" Inpatient Medications orders which were on hold at the time a patient"
^DIC(9.4,164,22,1,"PAH",53,1,5,0)="movement occurred which caused them to be auto-discontinued were not"
^DIC(9.4,164,22,1,"PAH",53,1,6,0)="returned to on hold if the movement was deleted and the orders were"
^DIC(9.4,164,22,1,"PAH",53,1,7,0)="auto-reinstated.  This patch corrects this problem.  NOIS: AAA-0802-N1994."
^DIC(9.4,164,22,1,"PAH",54,0)="56 SEQ #55^3021008^1"
^DIC(9.4,164,22,1,"PAH",54,1,0)="^^17^17^3021008"
^DIC(9.4,164,22,1,"PAH",54,1,1,0)="1. Currently Inpatient Medications V. 5.0 recognizes the following"
^DIC(9.4,164,22,1,"PAH",54,1,2,0)="schedules as One Time schedules: NOW, ONCE, STAT, ONE TIME, 1 TIME, 1TIME,"
^DIC(9.4,164,22,1,"PAH",54,1,3,0)="1-TIME , ONE-TIME, ONETIME"
^DIC(9.4,164,22,1,"PAH",54,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",54,1,5,0)="This patch will update the routines that Pharmacy Data Management (PDM)"
^DIC(9.4,164,22,1,"PAH",54,1,6,0)="V. 1.0 uses to validate schedules for Computerized Patient Record System"
^DIC(9.4,164,22,1,"PAH",54,1,7,0)="(CPRS) V. 1.0 to be consistent with Inpatient Medications V. 5.0."
^DIC(9.4,164,22,1,"PAH",54,1,8,0)=" "
^DIC(9.4,164,22,1,"PAH",54,1,9,0)="2. A site reported a problem with an order not appearing in Bar Code "
^DIC(9.4,164,22,1,"PAH",54,1,10,0)="Medication Administration (BCMA) V. 1.0 correctly. The problem was that "
^DIC(9.4,164,22,1,"PAH",54,1,11,0)="the frequency for the medication administration was being calculated "
^DIC(9.4,164,22,1,"PAH",54,1,12,0)="inappropriately. This patch corrects this problem. NOIS: HUN-0502-22756"
^DIC(9.4,164,22,1,"PAH",54,1,13,0)=" "
^DIC(9.4,164,22,1,"PAH",54,1,14,0)="3. A site reported a problem quick orders not displaying entries from the"
^DIC(9.4,164,22,1,"PAH",54,1,15,0)="SCHEDULE ADMINISTRATION file (#51.1) correctly when attempting to define "
^DIC(9.4,164,22,1,"PAH",54,1,16,0)="outpatient quick orders. This patch corrects this problem. "
^DIC(9.4,164,22,1,"PAH",54,1,17,0)="NOIS: DUB-1201-30587"
^DIC(9.4,164,22,1,"PAH",55,0)="57 SEQ #56^3021025^1"
^DIC(9.4,164,22,1,"PAH",55,1,0)="^^28^28^3021025"
^DIC(9.4,164,22,1,"PAH",55,1,1,0)="HUI/VHA CIO SD&D PHARMACY DATA INTERCHANGE"
^DIC(9.4,164,22,1,"PAH",55,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",55,1,3,0)="1. This patch is in support of the Hui/VHA CIO SD&D Pharmacy Data"
^DIC(9.4,164,22,1,"PAH",55,1,4,0)="Interchange project. The project provides a method for the one-way"
^DIC(9.4,164,22,1,"PAH",55,1,5,0)="electronic transfer of prescription orders from an external system to VistA"
^DIC(9.4,164,22,1,"PAH",55,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",55,1,7,0)="The purpose of this patch is to provide an HL7 notification of the addition"
^DIC(9.4,164,22,1,"PAH",55,1,8,0)="of new drugs and drug updates to the DRUG file (#50). To receive this "
^DIC(9.4,164,22,1,"PAH",55,1,9,0)="notification, the receiving protocol must be attached to the sending"
^DIC(9.4,164,22,1,"PAH",55,1,10,0)="protocol SEND DRUG UPDATE MESSAGE [PSS HUI DRUG UPDATE] as a subscriber."
^DIC(9.4,164,22,1,"PAH",55,1,11,0)="To activate the sending of these HL7 messages the text from DISABLE field"
^DIC(9.4,164,22,1,"PAH",55,1,12,0)="must be deleted and at least one receiving protocol added as a subscriber.  "
^DIC(9.4,164,22,1,"PAH",55,1,13,0)=" "
^DIC(9.4,164,22,1,"PAH",55,1,14,0)="For those sites who ARE NOT part of the Hui/VHA CIO SD&D Pharmacy Data "
^DIC(9.4,164,22,1,"PAH",55,1,15,0)="Interchange project, NO FURTHER ACTION is necessary after installation of"
^DIC(9.4,164,22,1,"PAH",55,1,16,0)="the patch.  "
^DIC(9.4,164,22,1,"PAH",55,1,17,0)=" "
^DIC(9.4,164,22,1,"PAH",55,1,18,0)=" "
^DIC(9.4,164,22,1,"PAH",55,1,19,0)="2. When performing drug lookups, two issues were identified. First, the was"
^DIC(9.4,164,22,1,"PAH",55,1,20,0)="not aware of which item was being matched. For example, was the match for"
^DIC(9.4,164,22,1,"PAH",55,1,21,0)="the GENERIC NAME of the drug or was it the SYNONYM. The second issue had to"
^DIC(9.4,164,22,1,"PAH",55,1,22,0)="do with the search matching to the NATIONAL DRUG CLASS NAME first, before"
^DIC(9.4,164,22,1,"PAH",55,1,23,0)="checking for a GENERIC NAME. "
^DIC(9.4,164,22,1,"PAH",55,1,24,0)=" "
^DIC(9.4,164,22,1,"PAH",55,1,25,0)="This patch makes two changes to the drug lookup. First, the search will"
^DIC(9.4,164,22,1,"PAH",55,1,26,0)="display the item being searched on. Second, if a match is found on an item,"
^DIC(9.4,164,22,1,"PAH",55,1,27,0)="but the user doesn't select one of the matches displayed, the search will"
^DIC(9.4,164,22,1,"PAH",55,1,28,0)="continue through all other items."
^DIC(9.4,164,22,1,"PAH",56,0)="55 SEQ #57^3021116^1"
^DIC(9.4,164,22,1,"PAH",56,1,0)="^^39^39^3021116"
^DIC(9.4,164,22,1,"PAH",56,1,1,0)=" "
^DIC(9.4,164,22,1,"PAH",56,1,2,0)="The Pharmacy Data Management Drug Text Enter/Edit [PSS DRUG TEXT"
^DIC(9.4,164,22,1,"PAH",56,1,3,0)="ENTER/EDIT] option is being enhanced and a new Drug Text File Report [PSS"
^DIC(9.4,164,22,1,"PAH",56,1,4,0)="DRUG TEXT FILE REPORT] option is being added."
^DIC(9.4,164,22,1,"PAH",56,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",56,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",56,1,7,0)="The Drug Text File Report [PSS DRUG TEXT FILE REPORT] option displays the"
^DIC(9.4,164,22,1,"PAH",56,1,8,0)="drug text name, synonyms, drug text, inactive date if inactive, and lists"
^DIC(9.4,164,22,1,"PAH",56,1,9,0)="all drug and orderable items linked to it. This report can be printed for"
^DIC(9.4,164,22,1,"PAH",56,1,10,0)="one or all entries."
^DIC(9.4,164,22,1,"PAH",56,1,11,0)=" "
^DIC(9.4,164,22,1,"PAH",56,1,12,0)="The Drug Text Enter/Edit [PSS DRUG TEXT ENTER/EDIT] option was changed to"
^DIC(9.4,164,22,1,"PAH",56,1,13,0)="enhance the text displayed when editing or inactivating an entry. The new"
^DIC(9.4,164,22,1,"PAH",56,1,14,0)="text identifies the specific option that can be used to display linked"
^DIC(9.4,164,22,1,"PAH",56,1,15,0)="items."
^DIC(9.4,164,22,1,"PAH",56,1,16,0)=" "
^DIC(9.4,164,22,1,"PAH",56,1,17,0)="The following cross-references were created for use in generating a list"
^DIC(9.4,164,22,1,"PAH",56,1,18,0)="of DRUG file (#50) entries and PHARMACY ORDERABLE ITEM file (#50.7)"
^DIC(9.4,164,22,1,"PAH",56,1,19,0)="entries associated with a DRUG TEXT file (#51.7) entry and for generating"
^DIC(9.4,164,22,1,"PAH",56,1,20,0)="the report in the Drug Text File Report [PSS DRUG TEXT FILE REPORT]"
^DIC(9.4,164,22,1,"PAH",56,1,21,0)="option:"
^DIC(9.4,164,22,1,"PAH",56,1,22,0)="  1. A full file cross-reference on the DRUG TEXT ENTRY field"
^DIC(9.4,164,22,1,"PAH",56,1,23,0)="(#50.037) in the DRUG file (#50)."
^DIC(9.4,164,22,1,"PAH",56,1,24,0)="  2. A full file cross-reference on the OI-DRUG TEXT ENTRY field (#50.76)"
^DIC(9.4,164,22,1,"PAH",56,1,25,0)="of the PHARMACY ORDERABLE ITEM file (#50.7)."
^DIC(9.4,164,22,1,"PAH",56,1,26,0)=" "
^DIC(9.4,164,22,1,"PAH",56,1,27,0)="Note: The population of the new 'DTXT' cross reference is done in a"
^DIC(9.4,164,22,1,"PAH",56,1,28,0)="post-install background job. When this job completes, it will send a"
^DIC(9.4,164,22,1,"PAH",56,1,29,0)="MailMan message to the installer of the patch and holders of the"
^DIC(9.4,164,22,1,"PAH",56,1,30,0)="PSNMGR key. The new Drug Text File Report [PSS DRUG TEXT FILE REPORT]"
^DIC(9.4,164,22,1,"PAH",56,1,31,0)="option should then be run for all drug text entries in the DRUG TEXT"
^DIC(9.4,164,22,1,"PAH",56,1,32,0)="file (#51.7) to verify that the correct drug text is associated with the"
^DIC(9.4,164,22,1,"PAH",56,1,33,0)="correct entries in the PHARMACY ORDERABLE ITEM file (#50.7) and the DRUG"
^DIC(9.4,164,22,1,"PAH",56,1,34,0)="file (#50). A listing of the original drug text file entries distributed"
^DIC(9.4,164,22,1,"PAH",56,1,35,0)="with Patch PSS*1*29 is provided in the Pharmacy Data Management user"
^DIC(9.4,164,22,1,"PAH",56,1,36,0)="manual."
^DIC(9.4,164,22,1,"PAH",56,1,37,0)=" "
^DIC(9.4,164,22,1,"PAH",56,1,38,0)="There will be updates to the Pharmacy Data Management V.1.0 User and"
^DIC(9.4,164,22,1,"PAH",56,1,39,0)="Technical manuals for this patch."
^DIC(9.4,164,22,1,"PAH",57,0)="58 SEQ #58^3021209^1"
^DIC(9.4,164,22,1,"PAH",57,1,0)="^^19^19^3021209"
^DIC(9.4,164,22,1,"PAH",57,1,1,0)="1. When a user cannot access a patient order due to the order being locked"
^DIC(9.4,164,22,1,"PAH",57,1,2,0)="by another user, a warning message is displayed and hung for a couple "
^DIC(9.4,164,22,1,"PAH",57,1,3,0)="second before scrolling off the screen.  This patch will pause and "
^DIC(9.4,164,22,1,"PAH",57,1,4,0)="require a return from the user before continuing with the process."
^DIC(9.4,164,22,1,"PAH",57,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",57,1,6,0)="2. The following DD changes are being made in order to support requested "
^DIC(9.4,164,22,1,"PAH",57,1,7,0)="changes to Inpatient Medications to allow flagging functionality. E3R"
^DIC(9.4,164,22,1,"PAH",57,1,8,0)="#11177 and #12382"
^DIC(9.4,164,22,1,"PAH",57,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",57,1,10,0)="Add field# 148 FLAGGED to the IV multiple of the PHARMACY PATIENT file "
^DIC(9.4,164,22,1,"PAH",57,1,11,0)="(#55)."
^DIC(9.4,164,22,1,"PAH",57,1,12,0)="Add field# 124 FLAGGED to the UNIT DOSE multiple of the PHARMACY PATIENT"
^DIC(9.4,164,22,1,"PAH",57,1,13,0)="file (#55)."
^DIC(9.4,164,22,1,"PAH",57,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",57,1,15,0)="Changed field# .02 TYPE OF ACTIVITY, added two new codes to the existing "
^DIC(9.4,164,22,1,"PAH",57,1,16,0)="set of codes. 'G' FOR FLAGGED; 'UG' FOR UNFLAGGED. This is in the "
^DIC(9.4,164,22,1,"PAH",57,1,17,0)="ACTIVITY LOG multiple (#55.04)."
^DIC(9.4,164,22,1,"PAH",57,1,18,0)="Changed field# .04 REASON FOR ACTIVITY, increased the field size from 75 "
^DIC(9.4,164,22,1,"PAH",57,1,19,0)="to 102.  This is also in the ACTIVITY LOG multiple (#55.04)."
^DIC(9.4,164,22,1,"PAH",58,0)="66 SEQ #59^3030329^1"
^DIC(9.4,164,22,1,"PAH",58,1,0)="^^29^29^3030329"
^DIC(9.4,164,22,1,"PAH",58,1,1,0)="1. This patch, in conjunction with CPRS patches OR*3.0*149 and OR*3.0*158,"
^DIC(9.4,164,22,1,"PAH",58,1,2,0)="   fixes a problem that can occur when entering an order for an outpatient"
^DIC(9.4,164,22,1,"PAH",58,1,3,0)="   in Computerized Patient Record System (CPRS) using the IV Fluids order"
^DIC(9.4,164,22,1,"PAH",58,1,4,0)="   dialogue. The DEA Special Handling check does not always function when"
^DIC(9.4,164,22,1,"PAH",58,1,5,0)="   entering those orders. So it is possible for a Provider without a DEA#"
^DIC(9.4,164,22,1,"PAH",58,1,6,0)="   or a VA# to enter an order through this dialogue for an Orderable Item,"
^DIC(9.4,164,22,1,"PAH",58,1,7,0)="   when that order should not be allowed to be placed. When this patch and"
^DIC(9.4,164,22,1,"PAH",58,1,8,0)="   both CPRS patches OR*3.0*149 and OR*3.0*158 are installed, this"
^DIC(9.4,164,22,1,"PAH",58,1,9,0)="   functionality will work properly. Patch OR*3.0*149 will fix this"
^DIC(9.4,164,22,1,"PAH",58,1,10,0)="   problem for orders entered through CPRS GUI, and patch OR*3.0*158 will"
^DIC(9.4,164,22,1,"PAH",58,1,11,0)="   fix this problem for orders entered through CPRS ListMan. No problems"
^DIC(9.4,164,22,1,"PAH",58,1,12,0)="   will occur if the PSS*1.0*66 patch is installed without either one or"
^DIC(9.4,164,22,1,"PAH",58,1,13,0)="   both of the CPRS patches, but the functionality will not work properly"
^DIC(9.4,164,22,1,"PAH",58,1,14,0)="   until all patches are installed. NOIS JAC-0602-72390"
^DIC(9.4,164,22,1,"PAH",58,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",58,1,16,0)="2. A site reported a problem with entering the cost information for drugs"
^DIC(9.4,164,22,1,"PAH",58,1,17,0)="   with cost like NNNNN.NNN per order unit. Currently, the PRICE PER ORDER"
^DIC(9.4,164,22,1,"PAH",58,1,18,0)="   UNIT field (#13) in the DRUG file (#50) only allows 4 digits before the"
^DIC(9.4,164,22,1,"PAH",58,1,19,0)="   decimal point. This patch modifies the Data Dictionary of this field to"
^DIC(9.4,164,22,1,"PAH",58,1,20,0)="   accommodate 5 digits. NOIS POR-0902-50198"
^DIC(9.4,164,22,1,"PAH",58,1,21,0)=" "
^DIC(9.4,164,22,1,"PAH",58,1,22,0)="3. A minor change has been made to the Pharmacy Data Management (PDM) "
^DIC(9.4,164,22,1,"PAH",58,1,23,0)="   Application Program Interface (API) to allow other pharmacy packages to"
^DIC(9.4,164,22,1,"PAH",58,1,24,0)="   make use of it, whenever they update the DRUG file (#50) so that PDM "
^DIC(9.4,164,22,1,"PAH",58,1,25,0)="   possibly generates an HL7 outgoing drug message."
^DIC(9.4,164,22,1,"PAH",58,1,26,0)=" "
^DIC(9.4,164,22,1,"PAH",58,1,27,0)="4. A site reported a problem with the display of the cost information"
^DIC(9.4,164,22,1,"PAH",58,1,28,0)="   for drugs with local possible dosages. This patch corrects this"
^DIC(9.4,164,22,1,"PAH",58,1,29,0)="   problem. NOIS REN-0902-60126"
^DIC(9.4,164,22,1,"PAH",59,0)="67 SEQ #60^3030329^1"
^DIC(9.4,164,22,1,"PAH",59,1,0)="^^6^6^3030329"
^DIC(9.4,164,22,1,"PAH",59,1,1,0)="As part of the Outpatient Pharmacy V. 7.0 project to add Patient "
^DIC(9.4,164,22,1,"PAH",59,1,2,0)="Medication Information (PMI) print to labels, a new field must be added to"
^DIC(9.4,164,22,1,"PAH",59,1,3,0)="the PHARMACY SYSTEM file (#59.7). The new field, PMIS SECTION DELETE (#15)"
^DIC(9.4,164,22,1,"PAH",59,1,4,0)="will allow the Pharmacy Benefits Manager to mark certain PMI sections to"
^DIC(9.4,164,22,1,"PAH",59,1,5,0)="delete them from printing on labels. This patch adds this new field and"
^DIC(9.4,164,22,1,"PAH",59,1,6,0)="populates it appropriately."
^DIC(9.4,164,22,1,"PAH",60,0)="47 SEQ #61^3030403^1"
^DIC(9.4,164,22,1,"PAH",60,1,0)="^^24^24^3030403"
^DIC(9.4,164,22,1,"PAH",60,1,1,0)="This patch provides new functionality that allows the Veteran Affairs"
^DIC(9.4,164,22,1,"PAH",60,1,2,0)="Medical Centers to print a patient's prescription bottle label in another"
^DIC(9.4,164,22,1,"PAH",60,1,3,0)="language.  This functionality is accomplished by identifying which patients"
^DIC(9.4,164,22,1,"PAH",60,1,4,0)="has another language preference. To identify patients as having another"
^DIC(9.4,164,22,1,"PAH",60,1,5,0)="language preference use the option UPDATE PATIENT RECORD [PSO PAT]"
^DIC(9.4,164,22,1,"PAH",60,1,6,0)="and the protocol action PATIENT RECORD UPDATE [PSO PATIENT RECORD"
^DIC(9.4,164,22,1,"PAH",60,1,7,0)="UPDATE] and enter Yes in the new field OTHER LANGUAGE PREFERENCE field"
^DIC(9.4,164,22,1,"PAH",60,1,8,0)="(#106) in the PHARMACY PATIENT file (#55).  "
^DIC(9.4,164,22,1,"PAH",60,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",60,1,10,0)="The other language translations are entered by using the new option OTHER"
^DIC(9.4,164,22,1,"PAH",60,1,11,0)="LANGUAGE TRANSLATION SETUP [PSS OTHER LANGUAGE SETUP]. This new option is"
^DIC(9.4,164,22,1,"PAH",60,1,12,0)="not linked to any menu, but must be assigned to the person(s) responsible"
^DIC(9.4,164,22,1,"PAH",60,1,13,0)="for maintaining this functionality.  "
^DIC(9.4,164,22,1,"PAH",60,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",60,1,15,0)="The following options must be used to enter the remaining language"
^DIC(9.4,164,22,1,"PAH",60,1,16,0)="translations data: "
^DIC(9.4,164,22,1,"PAH",60,1,17,0)=" DRUG ENTER/EDIT [PSS DRUG ENTER/EDIT] "
^DIC(9.4,164,22,1,"PAH",60,1,18,0)=" DOSAGES ...[PSS DOSAGES MANAGEMENT] "
^DIC(9.4,164,22,1,"PAH",60,1,19,0)="     DOSAGE FORM FILE ENTER/EDIT [PSS DOSAGE FORM EDIT] "
^DIC(9.4,164,22,1,"PAH",60,1,20,0)=" MEDICATION INSTRUCTION FILE ADD/EDIT [PSSJU MI] "
^DIC(9.4,164,22,1,"PAH",60,1,21,0)=" MEDICATION ROUTE FILE ENTER/EDIT [PSS MEDICATION ROUTES EDIT] "
^DIC(9.4,164,22,1,"PAH",60,1,22,0)=" ORDERABLE ITEM MANAGEMENT ... [PSS ORDERABLE ITEM MANAGEMENT] "
^DIC(9.4,164,22,1,"PAH",60,1,23,0)="     EDIT ORDERABLE ITEMS [PSS EDIT ORDERABLE ITEMS] "
^DIC(9.4,164,22,1,"PAH",60,1,24,0)=" STANDARD SCHEDULE EDIT [PSS SCHEDULE EDIT]"
^DIC(9.4,164,22,1,"PAH",61,0)="64 SEQ #62^3030520^1"
^DIC(9.4,164,22,1,"PAH",62,0)="68 SEQ #63^3030628^1"
^DIC(9.4,164,22,1,"PAH",62,1,0)="^^68^68^3030628"
^DIC(9.4,164,22,1,"PAH",62,1,1,0)="PSS*1*68 and OR*3*176 are the first of a total of 6 patches that will "
^DIC(9.4,164,22,1,"PAH",62,1,2,0)="comprise the Non-VA Meds (Herbals/OTC) project. These two patches are"
^DIC(9.4,164,22,1,"PAH",62,1,3,0)="being released together to deliver Phase 1 of this project, which is"
^DIC(9.4,164,22,1,"PAH",62,1,4,0)="explained in more details below. Phase 2 will contain the following 4"
^DIC(9.4,164,22,1,"PAH",62,1,5,0)="patches: PSS*1*69, PSO*7*132, PSJ*5*107 and OR*3*187. They will be"
^DIC(9.4,164,22,1,"PAH",62,1,6,0)="released in a later time. Once all patches are installed, they will"
^DIC(9.4,164,22,1,"PAH",62,1,7,0)="provide the sites the ability to document herbal supplements,"
^DIC(9.4,164,22,1,"PAH",62,1,8,0)="over-the-counter (OTC)(non-prescription) medications and other "
^DIC(9.4,164,22,1,"PAH",62,1,9,0)="medications taken by patients but not dispensed by the Department of"
^DIC(9.4,164,22,1,"PAH",62,1,10,0)="Veterans Affairs (VA). These types of medications are commonly referred"
^DIC(9.4,164,22,1,"PAH",62,1,11,0)="to as ""Non-VA Meds."""
^DIC(9.4,164,22,1,"PAH",62,1,12,0)="  "
^DIC(9.4,164,22,1,"PAH",62,1,13,0)="Below is a list of functionalities that will be available at your site"
^DIC(9.4,164,22,1,"PAH",62,1,14,0)="once all 6 patches are installed: "
^DIC(9.4,164,22,1,"PAH",62,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",62,1,16,0)="  1. Add common herbal and OTC products to the DRUG File and mark them "
^DIC(9.4,164,22,1,"PAH",62,1,17,0)="     as Non-VA Med.  "
^DIC(9.4,164,22,1,"PAH",62,1,18,0)="  2. Enhance current Outpatient Pharmacy software to display patients "
^DIC(9.4,164,22,1,"PAH",62,1,19,0)="     use of Non-VA Med.  "
^DIC(9.4,164,22,1,"PAH",62,1,20,0)="  3. Screen for drug-herbal and drug-drug interactions and display the "
^DIC(9.4,164,22,1,"PAH",62,1,21,0)="     results in both Inpatient and Outpatient Pharmacy.  "
^DIC(9.4,164,22,1,"PAH",62,1,22,0)="  4. Display Non-VA Med drugs on the Orders and Meds tab in CPRS.  "
^DIC(9.4,164,22,1,"PAH",62,1,23,0)="  5. Display of drug interaction information involving Non-VA Med "
^DIC(9.4,164,22,1,"PAH",62,1,24,0)="     through CPRS.  "
^DIC(9.4,164,22,1,"PAH",62,1,25,0)=" "
^DIC(9.4,164,22,1,"PAH",62,1,26,0)="The Phase 1 of this project comprises functionality 1 only. It gives the"
^DIC(9.4,164,22,1,"PAH",62,1,27,0)="sites the ability to add common herbal and OTC products to the DRUG File"
^DIC(9.4,164,22,1,"PAH",62,1,28,0)="and mark them as Non-VA Med through the Drug Enter/Edit [PSS DRUG"
^DIC(9.4,164,22,1,"PAH",62,1,29,0)="ENTER/EDIT] option. Furthermore, it also allows the user to mark existing"
^DIC(9.4,164,22,1,"PAH",62,1,30,0)="dispense drugs as Non-VA Med. Once a drug is marked as Non-VA Med, a"
^DIC(9.4,164,22,1,"PAH",62,1,31,0)="physician using the CPRS GUI Version 23 application will be able to"
^DIC(9.4,164,22,1,"PAH",62,1,32,0)="document the patient's use of such drug. Which is done by entering a"
^DIC(9.4,164,22,1,"PAH",62,1,33,0)="Non-VA Med order for the patient. Functionalities 2 through 5 are part of"
^DIC(9.4,164,22,1,"PAH",62,1,34,0)="the Phase 2 of this project and will be delivered in a later time."
^DIC(9.4,164,22,1,"PAH",62,1,35,0)=" "
^DIC(9.4,164,22,1,"PAH",62,1,36,0)="An important part of this patch is the update of the Drug file. As"
^DIC(9.4,164,22,1,"PAH",62,1,37,0)="mentioned before, besides Herbal supplements and Over-the-Counter drugs"
^DIC(9.4,164,22,1,"PAH",62,1,38,0)="(usually non-prescription drugs), any prescribed medication currently"
^DIC(9.4,164,22,1,"PAH",62,1,39,0)="dispensed by the VA could be acquired by the patient from another source"
^DIC(9.4,164,22,1,"PAH",62,1,40,0)="other than the VA. Therefore, these drugs must also be marked as Non-VA"
^DIC(9.4,164,22,1,"PAH",62,1,41,0)="Med. In order to reduce the amount of work necessary to mark the existing"
^DIC(9.4,164,22,1,"PAH",62,1,42,0)="dispense drug for Non-VA Med use, the following update will occur"
^DIC(9.4,164,22,1,"PAH",62,1,43,0)="automatically with the installation of this patch: "
^DIC(9.4,164,22,1,"PAH",62,1,44,0)=" "
^DIC(9.4,164,22,1,"PAH",62,1,45,0)=" EVERY ACTIVE DISPENSE DRUG MARKED FOR OUTPATIENT USE WILL BE MARKED FOR "
^DIC(9.4,164,22,1,"PAH",62,1,46,0)=" NON-VA MED USE.  "
^DIC(9.4,164,22,1,"PAH",62,1,47,0)=" "
^DIC(9.4,164,22,1,"PAH",62,1,48,0)="The following menu options have also been modified: "
^DIC(9.4,164,22,1,"PAH",62,1,49,0)=" "
^DIC(9.4,164,22,1,"PAH",62,1,50,0)="  1. Lookup into Dispense Drug File [PSS LOOK] "
^DIC(9.4,164,22,1,"PAH",62,1,51,0)=" "
^DIC(9.4,164,22,1,"PAH",62,1,52,0)="     If the dispense drug is marked as Non-VA, it will now print ""Non-VA "
^DIC(9.4,164,22,1,"PAH",62,1,53,0)="     Med"" in the ""APPL PKG USE:"" field.  "
^DIC(9.4,164,22,1,"PAH",62,1,54,0)=" "
^DIC(9.4,164,22,1,"PAH",62,1,55,0)="  2. Enter/Edit Dosages [PSS EDIT DOSAGES] "
^DIC(9.4,164,22,1,"PAH",62,1,56,0)="     "
^DIC(9.4,164,22,1,"PAH",62,1,57,0)="     If the dispense drug is marked as Non-VA, it will now print ""Non-VA"
^DIC(9.4,164,22,1,"PAH",62,1,58,0)="     Med"" under ""This entry is marked for the following "
^DIC(9.4,164,22,1,"PAH",62,1,59,0)="     PHARMACY packages:."" "
^DIC(9.4,164,22,1,"PAH",62,1,60,0)=" "
^DIC(9.4,164,22,1,"PAH",62,1,61,0)="  3. Edit Orderable Items [PSS EDIT ORDERABLE ITEMS] "
^DIC(9.4,164,22,1,"PAH",62,1,62,0)=" "
^DIC(9.4,164,22,1,"PAH",62,1,63,0)="     If the orderable item is marked as Non-VA, it will now print ""This "
^DIC(9.4,164,22,1,"PAH",62,1,64,0)="     Orderable Item is marked as a Non-VA Med."" right after the indication"
^DIC(9.4,164,22,1,"PAH",62,1,65,0)="     of Formulary/Non-Formulary is printed.  "
^DIC(9.4,164,22,1,"PAH",62,1,66,0)=" "
^DIC(9.4,164,22,1,"PAH",62,1,67,0)="A new field NON-VA MED (#8) has been added to the PHARMACY ORDERABLE ITEM"
^DIC(9.4,164,22,1,"PAH",62,1,68,0)="File (#50.7)."
^DIC(9.4,164,22,1,"PAH",63,0)="71 SEQ #64^3030628^1"
^DIC(9.4,164,22,1,"PAH",63,1,0)="^^14^14^3030628"
^DIC(9.4,164,22,1,"PAH",63,1,1,0)=" Data Dictionary (DD) changes are being made in order to support requested"
^DIC(9.4,164,22,1,"PAH",63,1,2,0)=" changes to Inpatient Medications V. 5.0 included in patch PSJ*5*80."
^DIC(9.4,164,22,1,"PAH",63,1,3,0)=" "
^DIC(9.4,164,22,1,"PAH",63,1,4,0)=" The REQUESTED DURATION sub-field (#151) was added to the IV multiple"
^DIC(9.4,164,22,1,"PAH",63,1,5,0)=" (#100) of the PHARMACY PATIENT file (#55)."
^DIC(9.4,164,22,1,"PAH",63,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",63,1,7,0)=" The REQUESTED DURATION sub-field (#126) was added to the UNIT DOSE"
^DIC(9.4,164,22,1,"PAH",63,1,8,0)=" multiple (#62) of the PHARMACY PATIENT file (#55)."
^DIC(9.4,164,22,1,"PAH",63,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",63,1,10,0)=" The ORDERS FILE PARENT ORDER sub-field (#150) was added to the IV"
^DIC(9.4,164,22,1,"PAH",63,1,11,0)=" multiple (#100) of the PHARMACY PATIENT file (#55)."
^DIC(9.4,164,22,1,"PAH",63,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",63,1,13,0)=" The ORDERS FILE PARENT ORDER  sub-field (#125) was added to the UNIT DOSE"
^DIC(9.4,164,22,1,"PAH",63,1,14,0)=" multiple (#62) of the PHARMACY PATIENT file (#55)."
^DIC(9.4,164,22,1,"PAH",64,0)="73 SEQ #65^3030802^1"
^DIC(9.4,164,22,1,"PAH",64,1,0)="^^7^7^3030802"
^DIC(9.4,164,22,1,"PAH",64,1,1,0)=" Several sites have noted that the common brand names printed on a"
^DIC(9.4,164,22,1,"PAH",64,1,2,0)=" Patient Medication Instruction Sheet are not always appropriate."
^DIC(9.4,164,22,1,"PAH",64,1,3,0)=" This patch stops the printing of common brand names on PMIs printed"
^DIC(9.4,164,22,1,"PAH",64,1,4,0)=" in conjunction with the laser label."
^DIC(9.4,164,22,1,"PAH",64,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",64,1,6,0)=" ****NOTE**** The stand alone option Print a PMI Sheet [PSNPMIS PRINT]"
^DIC(9.4,164,22,1,"PAH",64,1,7,0)=" is not modified by this patch."
^DIC(9.4,164,22,1,"PAH",65,0)="70 SEQ #66^3030802^1"
^DIC(9.4,164,22,1,"PAH",65,1,0)="^^15^15^3030802"
^DIC(9.4,164,22,1,"PAH",65,1,1,0)="1. This patch fixes the problem reported in NOIS HON-0403-60272 to"
^DIC(9.4,164,22,1,"PAH",65,1,2,0)="   prevent the undefined variable error that occurs whenever DRUG file"
^DIC(9.4,164,22,1,"PAH",65,1,3,0)="   (#50) get updates and HL7 outgining drug message is sent out."
^DIC(9.4,164,22,1,"PAH",65,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",65,1,5,0)="2. This patch deletes the Pharmacy quick order correction for CPRS"
^DIC(9.4,164,22,1,"PAH",65,1,6,0)="   [PSS QUICK1] option, as it is an obsolete option. NOIS SBY-0403-30493"
^DIC(9.4,164,22,1,"PAH",65,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",65,1,8,0)="3. This patch modifies the SYNONYM field (#.01) in the DRUG file (#50) to "
^DIC(9.4,164,22,1,"PAH",65,1,9,0)="   allow data entry using the new Reduced Space Symbology (RSS) bar "
^DIC(9.4,164,22,1,"PAH",65,1,10,0)="   codes contains the National Drug Code (NDC) number in a new format"
^DIC(9.4,164,22,1,"PAH",65,1,11,0)="   called ""Global Trade Item Number (GTIN)"". The GTIN has a 14-digit data"
^DIC(9.4,164,22,1,"PAH",65,1,12,0)="   structure, which is used within the EAN.UCC system for unique "
^DIC(9.4,164,22,1,"PAH",65,1,13,0)="   identification of trade items worldwide. This will allow BCMA GUI will "
^DIC(9.4,164,22,1,"PAH",65,1,14,0)="   correctly read the GTIN and search the synonym field for a matching NDC"
^DIC(9.4,164,22,1,"PAH",65,1,15,0)="   number."
^DIC(9.4,164,22,1,"PAH",66,0)="61 SEQ #67^3030802^1"
^DIC(9.4,164,22,1,"PAH",66,1,0)="^^90^90^3030802"
^DIC(9.4,164,22,1,"PAH",66,1,1,0)="Pharmacy Benefits Management (PBM) Strategic Healthcare Group in"
^DIC(9.4,164,22,1,"PAH",66,1,2,0)="collaboration with the Drug Enforcement Administration (DEA), requested"
^DIC(9.4,164,22,1,"PAH",66,1,3,0)="the development of the first Public Key Infrastructure (PKI) VistA"
^DIC(9.4,164,22,1,"PAH",66,1,4,0)="pilot project, named Electronic Prescription Order Entry for Schedule II"
^DIC(9.4,164,22,1,"PAH",66,1,5,0)="Controlled Substances. The objective is to develop an electronic order"
^DIC(9.4,164,22,1,"PAH",66,1,6,0)="entry system for Schedule II controlled substances using digital"
^DIC(9.4,164,22,1,"PAH",66,1,7,0)="signatures. To make this project viable, modifications to the following"
^DIC(9.4,164,22,1,"PAH",66,1,8,0)="packages were identified:"
^DIC(9.4,164,22,1,"PAH",66,1,9,0)="National Drug File (NDF) V. 4.0"
^DIC(9.4,164,22,1,"PAH",66,1,10,0)="Kernel V. 8.0"
^DIC(9.4,164,22,1,"PAH",66,1,11,0)="Computerized Patient Record System (CPRS) V. 1.0"
^DIC(9.4,164,22,1,"PAH",66,1,12,0)="Pharmacy Data Management (PDM) V. 1.0"
^DIC(9.4,164,22,1,"PAH",66,1,13,0)="Outpatient Pharmacy (OP) V. 7.0"
^DIC(9.4,164,22,1,"PAH",66,1,14,0)="Controlled Substances (CS) V. 3.0"
^DIC(9.4,164,22,1,"PAH",66,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",66,1,16,0)="This is the PDM patch that provides the following new functionalities:"
^DIC(9.4,164,22,1,"PAH",66,1,17,0)=" "
^DIC(9.4,164,22,1,"PAH",66,1,18,0)="1. It provides CPRS with new API's 3737 and 3739 (these are modifications"
^DIC(9.4,164,22,1,"PAH",66,1,19,0)="of existing API's 3373 and 3233 which shall remain unchanged). The logic"
^DIC(9.4,164,22,1,"PAH",66,1,20,0)="of deriving at the DEA SPECIAL HDLG code for drugs associated with an"
^DIC(9.4,164,22,1,"PAH",66,1,21,0)="orderable item has changed. The National Drug File data update patches"
^DIC(9.4,164,22,1,"PAH",66,1,22,0)="PSN*4*64 and PSN*4*66 assign a CS Federal Schedule to controlled"
^DIC(9.4,164,22,1,"PAH",66,1,23,0)="substances and identify controlled substances as narcotics or"
^DIC(9.4,164,22,1,"PAH",66,1,24,0)="non-narcotics by populating the CS FEDERAL SCHEDULE field (#19) of the VA"
^DIC(9.4,164,22,1,"PAH",66,1,25,0)="PRODUCT file (#50.68). If any of the active dispense drugs associated with"
^DIC(9.4,164,22,1,"PAH",66,1,26,0)="the Pharmacy orderable item for the specified package are matched to an"
^DIC(9.4,164,22,1,"PAH",66,1,27,0)="entry in NDF, then the most restrictive CS FEDERAL SCHEDULE code will be"
^DIC(9.4,164,22,1,"PAH",66,1,28,0)="returned. If there is no match or the CS FEDERAL SCHEDULE code is"
^DIC(9.4,164,22,1,"PAH",66,1,29,0)="undefined, then the most restrictive DEA SPECIAL HDLG code mapped to the"
^DIC(9.4,164,22,1,"PAH",66,1,30,0)="corresponding CS FEDERAL SCHEDULE code will be returned using the"
^DIC(9.4,164,22,1,"PAH",66,1,31,0)="following table:"
^DIC(9.4,164,22,1,"PAH",66,1,32,0)=" "
^DIC(9.4,164,22,1,"PAH",66,1,33,0)="                         CS FEDERAL SCHEDULE     DEA, SPECIAL HDLG"
^DIC(9.4,164,22,1,"PAH",66,1,34,0)="Code"
^DIC(9.4,164,22,1,"PAH",66,1,35,0)="Schedule I narcotics            1                        1"
^DIC(9.4,164,22,1,"PAH",66,1,36,0)="Schedule II narcotics           2                       2A"
^DIC(9.4,164,22,1,"PAH",66,1,37,0)="Schedule II non-narcotics      2n                       2C"
^DIC(9.4,164,22,1,"PAH",66,1,38,0)="Schedule III narcotics          3                       3A"
^DIC(9.4,164,22,1,"PAH",66,1,39,0)="Schedule III non-narcotics     3n                       3C"
^DIC(9.4,164,22,1,"PAH",66,1,40,0)="Schedule IV narcotics           4                        4"
^DIC(9.4,164,22,1,"PAH",66,1,41,0)="Schedule V narcotics            5                        5"
^DIC(9.4,164,22,1,"PAH",66,1,42,0)=" "
^DIC(9.4,164,22,1,"PAH",66,1,43,0)="2. It includes a Post-Install routine to identify those drugs that show"
^DIC(9.4,164,22,1,"PAH",66,1,44,0)="discrepancies between the CS FEDERAL SCHEDULE field (#19) of the VA"
^DIC(9.4,164,22,1,"PAH",66,1,45,0)="PRODUCT file (#50.68) and DEA SPECIAL HDLG field (#3) of the DRUG file"
^DIC(9.4,164,22,1,"PAH",66,1,46,0)="(#50), and generates the following 4 mail messages to the installer and"
^DIC(9.4,164,22,1,"PAH",66,1,47,0)="the holders of the PSNMGR keys:"
^DIC(9.4,164,22,1,"PAH",66,1,48,0)="CS FEDERAL SCHEDULE AND DEA, SPECIAL HDLG DISCREPANCIES"
^DIC(9.4,164,22,1,"PAH",66,1,49,0)="CONTROLLED SUBSTANCES NOT MATCHED"
^DIC(9.4,164,22,1,"PAH",66,1,50,0)="CONTROLLED SUBSTANCES NOT SET CORRECTLY"
^DIC(9.4,164,22,1,"PAH",66,1,51,0)="DISCREPANCY IN DEA WITHIN DRUGS TIED TO AN OI"
^DIC(9.4,164,22,1,"PAH",66,1,52,0)=" "
^DIC(9.4,164,22,1,"PAH",66,1,53,0)="These mail messages can be used to clean up the DEA SPECIAL HDLG code in"
^DIC(9.4,164,22,1,"PAH",66,1,54,0)="the DRUG file where appropriate."
^DIC(9.4,164,22,1,"PAH",66,1,55,0)=" "
^DIC(9.4,164,22,1,"PAH",66,1,56,0)="3. It also provides the following new menu options to generate reports of"
^DIC(9.4,164,22,1,"PAH",66,1,57,0)="the above mail messages:"
^DIC(9.4,164,22,1,"PAH",66,1,58,0)="Controlled Substances/PKI Reports [PSS CS/PKI REPORTS] menu has the"
^DIC(9.4,164,22,1,"PAH",66,1,59,0)="following 4 new options:"
^DIC(9.4,164,22,1,"PAH",66,1,60,0)="  1 DEA Spec Hdlg & CS Fed Sch Discrepancy [PSS DEA VS CS FED. SCH."
^DIC(9.4,164,22,1,"PAH",66,1,61,0)="    DISCR.]"
^DIC(9.4,164,22,1,"PAH",66,1,62,0)="  2 Controlled Substances Not Matched to NDF [PSS CS NOT MATCHED TO NDF]"
^DIC(9.4,164,22,1,"PAH",66,1,63,0)="  3 CS (DRUGS) Inconsistent with DEA Spec Hdlg [PSS CS DRUGS INCON WITH"
^DIC(9.4,164,22,1,"PAH",66,1,64,0)="    DEA]"
^DIC(9.4,164,22,1,"PAH",66,1,65,0)="  4 CS (Ord. Item) Inconsistent with DEA Spec Hdlg [PSS CS (OI) INCON WITH"
^DIC(9.4,164,22,1,"PAH",66,1,66,0)="    DEA]"
^DIC(9.4,164,22,1,"PAH",66,1,67,0)="This new menu Controlled Substances/PKI Reports [PSS CS/PKI REPORTS],"
^DIC(9.4,164,22,1,"PAH",66,1,68,0)="will be added to the Pharmacy Data Management [PSS MGR] menu."
^DIC(9.4,164,22,1,"PAH",66,1,69,0)=" "
^DIC(9.4,164,22,1,"PAH",66,1,70,0)="4. When using the Drug Enter/Edit [PSS DRUG ENTER/EDIT] option, if the CS"
^DIC(9.4,164,22,1,"PAH",66,1,71,0)="FEDERAL SCHEDULE field (#19) of the VA PRODUCT file (#50.68) and the DEA"
^DIC(9.4,164,22,1,"PAH",66,1,72,0)="SPECIAL HDLG field (#3) of the DRUG file (#50) have a discrepancy, then"
^DIC(9.4,164,22,1,"PAH",66,1,73,0)="this patch displays a warning message, ""The CS Federal Schedule associated"
^DIC(9.4,164,22,1,"PAH",66,1,74,0)="with this drug in the VA Product file represents a DEA, Special Handling"
^DIC(9.4,164,22,1,"PAH",66,1,75,0)="code of XX"", where XX is the CS FEDERAL SCHEDULE code mapped to"
^DIC(9.4,164,22,1,"PAH",66,1,76,0)="corresponding DEA SPECIAL HDLG code as defined in the above table."
^DIC(9.4,164,22,1,"PAH",66,1,77,0)=" "
^DIC(9.4,164,22,1,"PAH",66,1,78,0)="5. This patch ensures that the newly populated CS FEDERAL SCHEDULE field"
^DIC(9.4,164,22,1,"PAH",66,1,79,0)="(#19) of the VA PRODUCT file (#50.68) is also included as part of the"
^DIC(9.4,164,22,1,"PAH",66,1,80,0)="drug details in the Lookup into Dispense Drug File [PSS LOOK] option."
^DIC(9.4,164,22,1,"PAH",66,1,81,0)=" "
^DIC(9.4,164,22,1,"PAH",66,1,82,0)="6. This patch introduces a new code ""F"" for NON REFILLABLE for the DEA"
^DIC(9.4,164,22,1,"PAH",66,1,83,0)="SPECIAL HDLG field (#3) of the DRUG file (#50). This will allow sites to"
^DIC(9.4,164,22,1,"PAH",66,1,84,0)="mark drugs other than controlled substances or clozapine drugs as NON"
^DIC(9.4,164,22,1,"PAH",66,1,85,0)="REFILLABLE. This functionality will be effective in the Outpatient"
^DIC(9.4,164,22,1,"PAH",66,1,86,0)="Pharmacy V. 7.0 package only if the patch PSO*7.0*131 is installed."
^DIC(9.4,164,22,1,"PAH",66,1,87,0)=" "
^DIC(9.4,164,22,1,"PAH",66,1,88,0)="7. The designation ""A"" which stands for ""NARCOTICS AND ALCOHOLICS"" used in"
^DIC(9.4,164,22,1,"PAH",66,1,89,0)="the DEA, SPECIAL HDLG field (#3) of the DRUG file (#50), is changed in"
^DIC(9.4,164,22,1,"PAH",66,1,90,0)="this patch to read as ""NARCOTICS AND ALCOHOLS""."
^DIC(9.4,164,22,1,"PAH",67,0)="69 SEQ #68^3031002^1"
^DIC(9.4,164,22,1,"PAH",67,1,0)="^^28^28^3031002"
^DIC(9.4,164,22,1,"PAH",67,1,1,0)="1. PSS*1*69 provides additional internal preparation at your site for "
^DIC(9.4,164,22,1,"PAH",67,1,2,0)="   the eventual release of the Herbal/OTC/Non-VA Meds Documentation "
^DIC(9.4,164,22,1,"PAH",67,1,3,0)="   project.  "
^DIC(9.4,164,22,1,"PAH",67,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",67,1,5,0)="   An important part of this patch is the update of the DRUG file (#50).  "
^DIC(9.4,164,22,1,"PAH",67,1,6,0)="   The Post-install routine for patch PSS*1*68 automatically marked for "
^DIC(9.4,164,22,1,"PAH",67,1,7,0)="   Non-VA Med use every active dispense drug that was marked for "
^DIC(9.4,164,22,1,"PAH",67,1,8,0)="   outpatient use. Some of these dispense drugs marked for Non-VA Med use "
^DIC(9.4,164,22,1,"PAH",67,1,9,0)="   were actually being used as supply items. A dispense drug is being "
^DIC(9.4,164,22,1,"PAH",67,1,10,0)="   used as a supply if the entry in the PHARMACY ORDERABLE ITEM file "
^DIC(9.4,164,22,1,"PAH",67,1,11,0)="   (#50.7) it is associated with has the SUPPLY field (#.09) set to 1 "
^DIC(9.4,164,22,1,"PAH",67,1,12,0)="   (one). Many sites have expressed their concern about having supply "
^DIC(9.4,164,22,1,"PAH",67,1,13,0)="   items automatically marked for Non-VA Med use. Therefore, sites can "
^DIC(9.4,164,22,1,"PAH",67,1,14,0)="   automatically unmark such items through this patch. The unmarking of "
^DIC(9.4,164,22,1,"PAH",67,1,15,0)="   supply items as Non-VA Meds will be optional. During the patch "
^DIC(9.4,164,22,1,"PAH",67,1,16,0)="   installation the installer will be prompted ""Unmark supply items as "
^DIC(9.4,164,22,1,"PAH",67,1,17,0)="   Non-VA Meds? Y //"". If 'YES' is selected, every supply item in the "
^DIC(9.4,164,22,1,"PAH",67,1,18,0)="   DRUG file (#50) marked for Non-VA Med use will be unmarked. If for any "
^DIC(9.4,164,22,1,"PAH",67,1,19,0)="   reason the installer chooses NOT to un-mark supply items for Non-VA "
^DIC(9.4,164,22,1,"PAH",67,1,20,0)="   Med use and later wishes to do so, run the Mumps routine PSSUNMSI "
^DIC(9.4,164,22,1,"PAH",67,1,21,0)="   distributed with this patch.  "
^DIC(9.4,164,22,1,"PAH",67,1,22,0)=" "
^DIC(9.4,164,22,1,"PAH",67,1,23,0)="2. A new multiple field NON-VA MEDS (#52.2), has been added to the "
^DIC(9.4,164,22,1,"PAH",67,1,24,0)="   PHARMACY PATIENT file (#55). This field will be used in the future "
^DIC(9.4,164,22,1,"PAH",67,1,25,0)="   to store Non-VA Med orders."
^DIC(9.4,164,22,1,"PAH",67,1,26,0)=" "
^DIC(9.4,164,22,1,"PAH",67,1,27,0)="3. The NON-VA MED field (#8) in the PHARMACY ORDERABLE ITEM file (#50.7)"
^DIC(9.4,164,22,1,"PAH",67,1,28,0)="   is being modified to be ""Uneditable""."
^DIC(9.4,164,22,1,"PAH",68,0)="75 SEQ #69^3031023^1"
^DIC(9.4,164,22,1,"PAH",68,1,0)="^^7^7^3031023"
^DIC(9.4,164,22,1,"PAH",68,1,1,0)=" This patch provides functionality to allow an indicator to determine if a "
^DIC(9.4,164,22,1,"PAH",68,1,2,0)=" patient has at least one active prescription.  This new routine PSSRXACT "
^DIC(9.4,164,22,1,"PAH",68,1,3,0)=" is to be used as a function call.  The patient's internal dfn is required.  "
^DIC(9.4,164,22,1,"PAH",68,1,4,0)=" the number 1 is returned to indicate that the patient has at least one "
^DIC(9.4,164,22,1,"PAH",68,1,5,0)=" active prescription, otherwise 0 (zero) is returned.  "
^DIC(9.4,164,22,1,"PAH",68,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",68,1,7,0)=" S X=$$EN^PSSRXACT(DFN)"
^DIC(9.4,164,22,1,"PAH",69,0)="76 SEQ #70^3031023^1"
^DIC(9.4,164,22,1,"PAH",69,1,0)="^^4^4^3031023"
^DIC(9.4,164,22,1,"PAH",69,1,1,0)="This patch will fix an undefined error encountered when using the DEA Spec"
^DIC(9.4,164,22,1,"PAH",69,1,2,0)="Hdlg & CS Fed Sch Discrepancy [PSS DEA VS CS FED. SCH. DISCR.] option"
^DIC(9.4,164,22,1,"PAH",69,1,3,0)="which is under the Controlled Substances/PKI Reports [PSS CS/PKI REPORTS]"
^DIC(9.4,164,22,1,"PAH",69,1,4,0)="menu. PSSPKIPR is the only routine contained in this patch."
^DIC(9.4,164,22,1,"PAH",70,0)="77 SEQ #71^3031121^1"
^DIC(9.4,164,22,1,"PAH",70,1,0)="^^8^8^3031121"
^DIC(9.4,164,22,1,"PAH",70,1,1,0)="This patch modifies the SYNONYM field (#.01) in the DRUG file (#50)."
^DIC(9.4,164,22,1,"PAH",70,1,2,0)="Barcode Medication Administration (BCMA) uses the Global Trade Item"
^DIC(9.4,164,22,1,"PAH",70,1,3,0)="Number (GTIN) format for barcodes. The GTIN has a 14-digit data"
^DIC(9.4,164,22,1,"PAH",70,1,4,0)="structure, which is used within the Uniform Code Council/European Article"
^DIC(9.4,164,22,1,"PAH",70,1,5,0)="Numbering (UCC/EAN) system for unique identification of trade items"
^DIC(9.4,164,22,1,"PAH",70,1,6,0)="worldwide. This patch corrects the problem in which scanned GTIN entries"
^DIC(9.4,164,22,1,"PAH",70,1,7,0)="stored in the SYNONYM field were not recognized when doing a lookup on"
^DIC(9.4,164,22,1,"PAH",70,1,8,0)="entries withing the DRUG file (#50)."
^DIC(9.4,164,22,1,"PAH",71,0)="72 SEQ #72^3031121^1"
^DIC(9.4,164,22,1,"PAH",71,1,0)="^^8^8^3031121"
^DIC(9.4,164,22,1,"PAH",71,1,1,0)="Data Dictionary (DD) changes are being made to support requested changes"
^DIC(9.4,164,22,1,"PAH",71,1,2,0)="for Outpatient Pharmacy V. 7.0 patch PSO*7*135. Patch PSO*7*135 implements"
^DIC(9.4,164,22,1,"PAH",71,1,3,0)="the ScripTalk(R) 'talking' prescription labels functionality. The DD"
^DIC(9.4,164,22,1,"PAH",71,1,4,0)="changes in this patch are to provide new fields to store the history of"
^DIC(9.4,164,22,1,"PAH",71,1,5,0)="patients' ScripTalk(R) enrollment activity."
^DIC(9.4,164,22,1,"PAH",71,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",71,1,7,0)="The SCRIPTALK ENROLLMENT ACTIVITY multiple (#55.0108) was added to the"
^DIC(9.4,164,22,1,"PAH",71,1,8,0)="PHARMACY PATIENT file (#55)."
^DIC(9.4,164,22,1,"PAH",72,0)="74 SEQ #73^3031231^1"
^DIC(9.4,164,22,1,"PAH",72,1,0)="^^3^3^3031231"
^DIC(9.4,164,22,1,"PAH",72,1,1,0)=" This change will add the new ROUND ATC PICK LIST UNITS field (#26.7)"
^DIC(9.4,164,22,1,"PAH",72,1,2,0)=" in the PHARMACY SYSTEM file (#59.7) for Inpatient Medications V 5.0 patch"
^DIC(9.4,164,22,1,"PAH",72,1,3,0)=" PSJ*5*119.  NOIS ALT-0403-20970"
^DIC(9.4,164,22,1,"PAH",73,0)="62 SEQ #74^3040330^1"
^DIC(9.4,164,22,1,"PAH",73,1,0)="^^27^27^3040330"
^DIC(9.4,164,22,1,"PAH",73,1,1,0)="This project consists of 12 patches that work together to create a new"
^DIC(9.4,164,22,1,"PAH",73,1,2,0)="Clinical Reminders index global. The purpose of this index is to provide"
^DIC(9.4,164,22,1,"PAH",73,1,3,0)="rapid access to clinical data. All of the standard Clinical Reminders"
^DIC(9.4,164,22,1,"PAH",73,1,4,0)="finding types are included in the index."
^DIC(9.4,164,22,1,"PAH",73,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",73,1,6,0)="The 12 patches that comprise this project are:"
^DIC(9.4,164,22,1,"PAH",73,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",73,1,8,0)=" PXRM*1.5*12"
^DIC(9.4,164,22,1,"PAH",73,1,9,0)=" DG*5.3*478"
^DIC(9.4,164,22,1,"PAH",73,1,10,0)=" GMPL*2*27"
^DIC(9.4,164,22,1,"PAH",73,1,11,0)=" GMRV*4*15"
^DIC(9.4,164,22,1,"PAH",73,1,12,0)=" LR*5.2*295"
^DIC(9.4,164,22,1,"PAH",73,1,13,0)=" OR*3*157"
^DIC(9.4,164,22,1,"PAH",73,1,14,0)=" PSS*1*62"
^DIC(9.4,164,22,1,"PAH",73,1,15,0)=" PSJ*5*90"
^DIC(9.4,164,22,1,"PAH",73,1,16,0)=" PSO*7*118"
^DIC(9.4,164,22,1,"PAH",73,1,17,0)=" PX*1*119"
^DIC(9.4,164,22,1,"PAH",73,1,18,0)=" RA*5*33"
^DIC(9.4,164,22,1,"PAH",73,1,19,0)=" YS*5.01*77"
^DIC(9.4,164,22,1,"PAH",73,1,20,0)=" "
^DIC(9.4,164,22,1,"PAH",73,1,21,0)="The purpose of this patch (PSS*1*62) is to lay the groundwork for these"
^DIC(9.4,164,22,1,"PAH",73,1,22,0)="changes by creating a new cross-reference in the PHARMACY PATIENT file"
^DIC(9.4,164,22,1,"PAH",73,1,23,0)="(#55) at both the UNIT DOSE multiple (#62) and the IV multiple (#100)."
^DIC(9.4,164,22,1,"PAH",73,1,24,0)=" "
^DIC(9.4,164,22,1,"PAH",73,1,25,0)="This patch can be installed independently of the other patches. The "
^DIC(9.4,164,22,1,"PAH",73,1,26,0)="documentation describing the new functionality will be available when all "
^DIC(9.4,164,22,1,"PAH",73,1,27,0)="associated patches are released."
^DIC(9.4,164,22,1,"PAH",74,0)="80 SEQ #75^3040427^1"
^DIC(9.4,164,22,1,"PAH",74,1,0)="^^5^5^3040427"
^DIC(9.4,164,22,1,"PAH",74,1,1,0)="The VAPN index for the Drug File (#50) was incorrectly set to the length "
^DIC(9.4,164,22,1,"PAH",74,1,2,0)="of the VA Product Name All the routines that use the index use a "
^DIC(9.4,164,22,1,"PAH",74,1,3,0)="maximum of 30 characters to do the lookup.  This patch deletes the "
^DIC(9.4,164,22,1,"PAH",74,1,4,0)="existing VAPN index and creates a new one using the DD definition for the "
^DIC(9.4,164,22,1,"PAH",74,1,5,0)="VA Product Name field."
^DIC(9.4,164,22,1,"PAH",75,0)="84 SEQ #76^3040521^1"
^DIC(9.4,164,22,1,"PAH",75,1,0)="^^1^1^3040521"
^DIC(9.4,164,22,1,"PAH",75,1,1,0)="Correct typo in file 54 (RX CONSULT), entry NO TRANSFER."
^DIC(9.4,164,22,1,"PAH",76,0)="79^3041015^1"
^DIC(9.4,164,22,1,"PAH",76,1,0)="^^72^72^3041015"
^DIC(9.4,164,22,1,"PAH",76,1,1,0)=" Phase I of the Inpatient Medications Requirements for the Special Focus"
^DIC(9.4,164,22,1,"PAH",76,1,2,0)=" Group IRA project consists of four patches. The patches are combined in"
^DIC(9.4,164,22,1,"PAH",76,1,3,0)=" host file PSJ_PSS_OR_PSU_110.KID in order to simplify installation at VHA"
^DIC(9.4,164,22,1,"PAH",76,1,4,0)=" facilities. Installation of this host file should be coordinated among"
^DIC(9.4,164,22,1,"PAH",76,1,5,0)=" the four packages affected since only one installation is necessary. The"
^DIC(9.4,164,22,1,"PAH",76,1,6,0)=" patches, in order of install, are:"
^DIC(9.4,164,22,1,"PAH",76,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",76,1,8,0)="      PSS*1*79   PHARMACY DATA MANAGEMENT V. 1.0"
^DIC(9.4,164,22,1,"PAH",76,1,9,0)="      PSJ*5*110  INPATIENT MEDICATIONS V. 5.0"
^DIC(9.4,164,22,1,"PAH",76,1,10,0)="      OR*3*213   ORDER ENTRY/RESULTS REPORTING V. 1.0"
^DIC(9.4,164,22,1,"PAH",76,1,11,0)="      PSU*3*34   PHARMACY BENEFITS MANAGEMENT V. 3.0"
^DIC(9.4,164,22,1,"PAH",76,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",76,1,13,0)=" Patches PSS*1*79, OR*3*213, and PSU*3*34 contain changes to support the"
^DIC(9.4,164,22,1,"PAH",76,1,14,0)=" following enhancements in PSJ*5*110:"
^DIC(9.4,164,22,1,"PAH",76,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",76,1,16,0)=" 1. The Extend Stop Date on Renewal enhancements will allow an order to be"
^DIC(9.4,164,22,1,"PAH",76,1,17,0)=" renewed without creating a new order. Editing of the start date will no"
^DIC(9.4,164,22,1,"PAH",76,1,18,0)=" longer be allowed during the renewal process. In addition, limits have"
^DIC(9.4,164,22,1,"PAH",76,1,19,0)=" been set on the length of time after an order expires that it may be"
^DIC(9.4,164,22,1,"PAH",76,1,20,0)=" renewed. This is outlined in the BCMA 2001 Special Focus Report,"
^DIC(9.4,164,22,1,"PAH",76,1,21,0)=" Requirement #11."
^DIC(9.4,164,22,1,"PAH",76,1,22,0)="  "
^DIC(9.4,164,22,1,"PAH",76,1,23,0)=" 2. The Complex Order enhancements will change the way complex orders are"
^DIC(9.4,164,22,1,"PAH",76,1,24,0)=" handled by linking complex components (child orders) together. If the"
^DIC(9.4,164,22,1,"PAH",76,1,25,0)=" actions Finish, Verify, Discontinue, or Renew are taken on one child"
^DIC(9.4,164,22,1,"PAH",76,1,26,0)=" order, the user will be alerted that the action must be taken on all of"
^DIC(9.4,164,22,1,"PAH",76,1,27,0)=" the complex component orders in the set. The user will then be prompted"
^DIC(9.4,164,22,1,"PAH",76,1,28,0)=" to take the appropriate action on each child order in the complex order"
^DIC(9.4,164,22,1,"PAH",76,1,29,0)=" set. This is outlined in BCMA 2001 Special Focus Report, Requirement #8."
^DIC(9.4,164,22,1,"PAH",76,1,30,0)=" "
^DIC(9.4,164,22,1,"PAH",76,1,31,0)=" 3. The STAT and NOW Order Notification enhancements will alert users"
^DIC(9.4,164,22,1,"PAH",76,1,32,0)=" subscribing to new mail group PSJ STAT NOW PENDING ORDER when a pending"
^DIC(9.4,164,22,1,"PAH",76,1,33,0)=" STAT or NOW order has been received from Computerized Patient Record"
^DIC(9.4,164,22,1,"PAH",76,1,34,0)=" System (CPRS) V. 1.0. Users subscribing to the new mail group PSJ STAT"
^DIC(9.4,164,22,1,"PAH",76,1,35,0)=" NOW ACTIVE ORDER will receive an alert when a STAT or NOW order is made"
^DIC(9.4,164,22,1,"PAH",76,1,36,0)=" active. This is outlined in BCMA 2001 Special Focus Report, Requirement"
^DIC(9.4,164,22,1,"PAH",76,1,37,0)=" #12."
^DIC(9.4,164,22,1,"PAH",76,1,38,0)=" "
^DIC(9.4,164,22,1,"PAH",76,1,39,0)=" In order to support the Extend Stop Date for Renewals changes, new fields"
^DIC(9.4,164,22,1,"PAH",76,1,40,0)=" will be created in the PHARMACY PATIENT file (#55) and the PHARMACY"
^DIC(9.4,164,22,1,"PAH",76,1,41,0)=" SYSTEM file (#59.7)."
^DIC(9.4,164,22,1,"PAH",76,1,42,0)=" "
^DIC(9.4,164,22,1,"PAH",76,1,43,0)=" 1. The PREVIOUS ORDERS FILE ENTRY sub-field (#4) will be added to the"
^DIC(9.4,164,22,1,"PAH",76,1,44,0)=" LAST RENEW multiple (#114) in the UNIT DOSE multiple (#62) in the"
^DIC(9.4,164,22,1,"PAH",76,1,45,0)=" PHARMACY PATIENT file (#55)."
^DIC(9.4,164,22,1,"PAH",76,1,46,0)=" "
^DIC(9.4,164,22,1,"PAH",76,1,47,0)=" 2. The PREVIOUS ORDERS FILE ENTRY sub-field (#4) will be added to the"
^DIC(9.4,164,22,1,"PAH",76,1,48,0)=" LAST RENEW multiple (#138) in the IV multiple (#100) in the PHARMACY"
^DIC(9.4,164,22,1,"PAH",76,1,49,0)=" PATIENT file (#55)."
^DIC(9.4,164,22,1,"PAH",76,1,50,0)=" "
^DIC(9.4,164,22,1,"PAH",76,1,51,0)=" 3. The EXPIRED IV TIME LIMIT field (#34) will be added to the PHARMACY"
^DIC(9.4,164,22,1,"PAH",76,1,52,0)=" SYSTEM file (#59.7)."
^DIC(9.4,164,22,1,"PAH",76,1,53,0)=" "
^DIC(9.4,164,22,1,"PAH",76,1,54,0)=" 4. In support of Complex Orders changes, a new cross-reference will be"
^DIC(9.4,164,22,1,"PAH",76,1,55,0)=" created to group complex child orders by their parent order. For Unit"
^DIC(9.4,164,22,1,"PAH",76,1,56,0)=" Dose orders, the cross-reference will be indexed by the ORDERS FILE"
^DIC(9.4,164,22,1,"PAH",76,1,57,0)=" PARENT ORDER field (#125), the ORDERS FILE ENTRY field (#66), and the"
^DIC(9.4,164,22,1,"PAH",76,1,58,0)=" Unit Dose order number appended with ""U"". For IV orders, the cross-"
^DIC(9.4,164,22,1,"PAH",76,1,59,0)=" reference will be indexed by the ORDERS FILE PARENT ORDER field (#150),"
^DIC(9.4,164,22,1,"PAH",76,1,60,0)=" the ORDERS FILE ENTRY field (#110), and the IV order number appended with"
^DIC(9.4,164,22,1,"PAH",76,1,61,0)=" ""V"". The cross-reference definition will be created by the pre-install"
^DIC(9.4,164,22,1,"PAH",76,1,62,0)=" routine PSSCMPLX. These are the new cross-references added to the"
^DIC(9.4,164,22,1,"PAH",76,1,63,0)=" PHARMACY PATIENT file (#55) and the fields used as the trigger-points."
^DIC(9.4,164,22,1,"PAH",76,1,64,0)=" The type of these cross-references is ""New"", not ""Traditional""."
^DIC(9.4,164,22,1,"PAH",76,1,65,0)=" "
^DIC(9.4,164,22,1,"PAH",76,1,66,0)="  X-ref  File/Sub-file              Trigger-point field(s)"
^DIC(9.4,164,22,1,"PAH",76,1,67,0)="  -----------------------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",76,1,68,0)="  ACX    PHARMACY PATIENT (#55)     ORDERS FILE PARENT ORDER (#125)"
^DIC(9.4,164,22,1,"PAH",76,1,69,0)="         /UNIT DOSE (#62)           ORDERS FILE ENTRY (#66)"
^DIC(9.4,164,22,1,"PAH",76,1,70,0)=" "
^DIC(9.4,164,22,1,"PAH",76,1,71,0)="  ACX1   PHARMACY PATIENT (#55)     ORDERS FILE PARENT ORDER (#150)"
^DIC(9.4,164,22,1,"PAH",76,1,72,0)="         /IV (#100)                 ORDERS FILE ENTRY (#110)"
^DIC(9.4,164,22,1,"PAH",77,0)="82 SEQ #78^3041029^1"
^DIC(9.4,164,22,1,"PAH",77,1,0)="^^71^71^3041029"
^DIC(9.4,164,22,1,"PAH",77,1,1,0)=" **********************************************************************"
^DIC(9.4,164,22,1,"PAH",77,1,2,0)=" * This patch is part of the Outpatient Pharmacy Automation Interface *"
^DIC(9.4,164,22,1,"PAH",77,1,3,0)=" *           Project and must be installed at all sites by            *"
^DIC(9.4,164,22,1,"PAH",77,1,4,0)=" *                          December 31, 2004                         *"
^DIC(9.4,164,22,1,"PAH",77,1,5,0)=" *                                                                    *"
^DIC(9.4,164,22,1,"PAH",77,1,6,0)=" *      Please review the Installation heading of this patch for      *"
^DIC(9.4,164,22,1,"PAH",77,1,7,0)=" *              Installation Guide retrieval information              *"
^DIC(9.4,164,22,1,"PAH",77,1,8,0)=" *                                                                    *"
^DIC(9.4,164,22,1,"PAH",77,1,9,0)=" **********************************************************************"
^DIC(9.4,164,22,1,"PAH",77,1,10,0)="  "
^DIC(9.4,164,22,1,"PAH",77,1,11,0)=" There are three patches to support the Outpatient Pharmacy Automation"
^DIC(9.4,164,22,1,"PAH",77,1,12,0)=" Interface project. These patches should be installed separately in the"
^DIC(9.4,164,22,1,"PAH",77,1,13,0)=" following order:"
^DIC(9.4,164,22,1,"PAH",77,1,14,0)="                   PSO*7*156      Outpatient Pharmacy"
^DIC(9.4,164,22,1,"PAH",77,1,15,0)="                   PSS*1*82       Pharmacy Data Management"
^DIC(9.4,164,22,1,"PAH",77,1,16,0)="                   PSN*4*84       National Drug File"
^DIC(9.4,164,22,1,"PAH",77,1,17,0)=" "
^DIC(9.4,164,22,1,"PAH",77,1,18,0)=" They contain routines, templates, options, and data dictionary changes to"
^DIC(9.4,164,22,1,"PAH",77,1,19,0)=" implement the Outpatient Pharmacy Automation Interface features. Please"
^DIC(9.4,164,22,1,"PAH",77,1,20,0)=" refer to the individual patch description of the other patches to get the"
^DIC(9.4,164,22,1,"PAH",77,1,21,0)=" names of the documentation files."
^DIC(9.4,164,22,1,"PAH",77,1,22,0)=" "
^DIC(9.4,164,22,1,"PAH",77,1,23,0)=" Each patch will share the same starting description with more detail"
^DIC(9.4,164,22,1,"PAH",77,1,24,0)=" for each patch in the corresponding namespace patch number.  There is"
^DIC(9.4,164,22,1,"PAH",77,1,25,0)=" only one installation guide.  It can be found on the anonymous "
^DIC(9.4,164,22,1,"PAH",77,1,26,0)=" directory.  The name of the installation guide "
^DIC(9.4,164,22,1,"PAH",77,1,27,0)=" PS_OUTPATIENT_AUTOMATION_INTERFACE_IG.doc."
^DIC(9.4,164,22,1,"PAH",77,1,28,0)=" "
^DIC(9.4,164,22,1,"PAH",77,1,29,0)="                   "
^DIC(9.4,164,22,1,"PAH",77,1,30,0)=" The patch enhances the current Health Level Seven (HL7) interface to"
^DIC(9.4,164,22,1,"PAH",77,1,31,0)=" ensure that the interface is compatible with all current Outpatient"
^DIC(9.4,164,22,1,"PAH",77,1,32,0)=" Pharmacy package V. 7.0 automation systems used by the Veterans Affairs"
^DIC(9.4,164,22,1,"PAH",77,1,33,0)=" Medical Centers (VAMCs).  The current national VISTA HL7 interface is"
^DIC(9.4,164,22,1,"PAH",77,1,34,0)=" written to HL7 standard V. 2.2.  Automated dispensing systems, such as"
^DIC(9.4,164,22,1,"PAH",77,1,35,0)=" the Baker APS Pharmacy 2000, are currently using an interface written to"
^DIC(9.4,164,22,1,"PAH",77,1,36,0)=" HL7 V. 2.3.1 standard using locally developed software.  The automated"
^DIC(9.4,164,22,1,"PAH",77,1,37,0)=" dispensing systems have committed to be HL7 V. 2.4 compliant."
^DIC(9.4,164,22,1,"PAH",77,1,38,0)=" "
^DIC(9.4,164,22,1,"PAH",77,1,39,0)=" This patch includes the following new features:"
^DIC(9.4,164,22,1,"PAH",77,1,40,0)=" 1.  Creates an HL7 interface to the current HL7 V. 2.4 standard."
^DIC(9.4,164,22,1,"PAH",77,1,41,0)=" 2.  The interface transmits drug data to multiple vendor systems"
^DIC(9.4,164,22,1,"PAH",77,1,42,0)="     utilized by VAMCs whenever the following options are selected:"
^DIC(9.4,164,22,1,"PAH",77,1,43,0)="     A. Drug Enter/Edit [PSS DRUG ENTER/EDIT] option."
^DIC(9.4,164,22,1,"PAH",77,1,44,0)="     B. Edit Orderable Items [PSS EDIT ORDERABLE ITEMS] option."
^DIC(9.4,164,22,1,"PAH",77,1,45,0)="     C. Enter/Edit Dosages [PSS EDIT DOSAGES] option."
^DIC(9.4,164,22,1,"PAH",77,1,46,0)="     D. Dispense Drug/Orderable Item Maintenance [PSS MAINTAIN ORDERABLE "
^DIC(9.4,164,22,1,"PAH",77,1,47,0)="        ITEMS] option."
^DIC(9.4,164,22,1,"PAH",77,1,48,0)="     E. CMOP Mark/Unmark (Single drug) [PSSXX MARK] option."
^DIC(9.4,164,22,1,"PAH",77,1,49,0)="     F. Synonym Enter/Edit [PSS SYNONYM EDIT] option."
^DIC(9.4,164,22,1,"PAH",77,1,50,0)=" "
^DIC(9.4,164,22,1,"PAH",77,1,51,0)=" "
^DIC(9.4,164,22,1,"PAH",77,1,52,0)=" HL7 Interface:"
^DIC(9.4,164,22,1,"PAH",77,1,53,0)=" =============="
^DIC(9.4,164,22,1,"PAH",77,1,54,0)=" This patch installs the following new HL7 Protocols:"
^DIC(9.4,164,22,1,"PAH",77,1,55,0)=" 1. PDM Master File Update [PSS EXT MFU SERVER] protocol."
^DIC(9.4,164,22,1,"PAH",77,1,56,0)=" 2. PDM Master File Update Client [PSS EXT MFU CLIENT] protocol."
^DIC(9.4,164,22,1,"PAH",77,1,57,0)=" "
^DIC(9.4,164,22,1,"PAH",77,1,58,0)=" This patch installs the following new HL7 Application Parameters:"
^DIC(9.4,164,22,1,"PAH",77,1,59,0)=" 1. PSS VISTA"
^DIC(9.4,164,22,1,"PAH",77,1,60,0)=" 2. PSS DISPENSE"
^DIC(9.4,164,22,1,"PAH",77,1,61,0)=" "
^DIC(9.4,164,22,1,"PAH",77,1,62,0)=" New Option:"
^DIC(9.4,164,22,1,"PAH",77,1,63,0)=" ==========="
^DIC(9.4,164,22,1,"PAH",77,1,64,0)=" A new option has been added to the PSS MGR menu called Send Entire "
^DIC(9.4,164,22,1,"PAH",77,1,65,0)=" Drug File to External Interface [PSS MASTER FILE ALL]. This is used to"
^DIC(9.4,164,22,1,"PAH",77,1,66,0)=" send the entire drug file to a dispensing system at first start-up to "
^DIC(9.4,164,22,1,"PAH",77,1,67,0)=" bring the dispensing system in synch with the National Drug file (#50)."
^DIC(9.4,164,22,1,"PAH",77,1,68,0)=" Each dispensing system will decide if they can receive these messages and"
^DIC(9.4,164,22,1,"PAH",77,1,69,0)=" a parameter setting ENABLE MASTER FILE UPDATE will need to be turned on"
^DIC(9.4,164,22,1,"PAH",77,1,70,0)=" in the OUTPATIENT SITE file (#59) in order for these messages to be sent"
^DIC(9.4,164,22,1,"PAH",77,1,71,0)=" across."
^DIC(9.4,164,22,1,"PAH",78,0)="85 SEQ #79^3041029^1"
^DIC(9.4,164,22,1,"PAH",78,1,0)="^^28^28^3041029"
^DIC(9.4,164,22,1,"PAH",78,1,1,0)="This patch contains Application Programmer Interface's (API's) that will "
^DIC(9.4,164,22,1,"PAH",78,1,2,0)="be used by calling applications that currently do direct global reads or "
^DIC(9.4,164,22,1,"PAH",78,1,3,0)="writes to the Pharmacy Data Management files.  Since the DRUG file (#50), "
^DIC(9.4,164,22,1,"PAH",78,1,4,0)="and other drug-related files are being replaced by a vendor product, any "
^DIC(9.4,164,22,1,"PAH",78,1,5,0)="direct M-based global reads or writes to these files must be replaced by "
^DIC(9.4,164,22,1,"PAH",78,1,6,0)="calling the API's provided in this patch. When the new data source is in "
^DIC(9.4,164,22,1,"PAH",78,1,7,0)="place, the calling applications will not be required to make any changes, "
^DIC(9.4,164,22,1,"PAH",78,1,8,0)="because these API's will be flexible enough to retrieve the requested "
^DIC(9.4,164,22,1,"PAH",78,1,9,0)="data from the vendor product, when the time comes."
^DIC(9.4,164,22,1,"PAH",78,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",78,1,11,0)="These are the files that are affected. If any application is making "
^DIC(9.4,164,22,1,"PAH",78,1,12,0)="direct global reads or writes to any of these files, they must be "
^DIC(9.4,164,22,1,"PAH",78,1,13,0)="replaced by using the API's exported with this patch."
^DIC(9.4,164,22,1,"PAH",78,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",78,1,15,0)="File Name:                        File Number:"
^DIC(9.4,164,22,1,"PAH",78,1,16,0)="DRUG                              50"
^DIC(9.4,164,22,1,"PAH",78,1,17,0)="DRUG ELECTROLYTES                 50.4"
^DIC(9.4,164,22,1,"PAH",78,1,18,0)="DOSAGE FORM                       50.606"
^DIC(9.4,164,22,1,"PAH",78,1,19,0)="PHARMACY ORDERABLE ITEM           50.7"
^DIC(9.4,164,22,1,"PAH",78,1,20,0)="MEDICATION INSTRUCTION            51"
^DIC(9.4,164,22,1,"PAH",78,1,21,0)="ADMINISTRATION SCHEDULE           51.1"
^DIC(9.4,164,22,1,"PAH",78,1,22,0)="MEDICATION ROUTES                 51.2"
^DIC(9.4,164,22,1,"PAH",78,1,23,0)="ORDER UNIT                        51.5"
^DIC(9.4,164,22,1,"PAH",78,1,24,0)="IV ADDITIVES                      52.6"
^DIC(9.4,164,22,1,"PAH",78,1,25,0)="IV SOLUTIONS                      52.7"
^DIC(9.4,164,22,1,"PAH",78,1,26,0)="RX CONSULT                        54"
^DIC(9.4,164,22,1,"PAH",78,1,27,0)="APSP INTERVENTION TYPE            9009032.3"
^DIC(9.4,164,22,1,"PAH",78,1,28,0)="APSP INTERVENTION RECOMMENDATION  9009032.5"
^DIC(9.4,164,22,1,"PAH",79,0)="81^3041029^1"
^DIC(9.4,164,22,1,"PAH",79,1,0)="^^223^223^3041029"
^DIC(9.4,164,22,1,"PAH",79,1,1,0)="Description:"
^DIC(9.4,164,22,1,"PAH",79,1,2,0)="==========="
^DIC(9.4,164,22,1,"PAH",79,1,3,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,4,0)="PATCH OVERVIEW"
^DIC(9.4,164,22,1,"PAH",79,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,6,0)="The Healthcare Insurance Portability and Accountability Act National "
^DIC(9.4,164,22,1,"PAH",79,1,7,0)="Council for Prescription Drug Programs (HIPAA NCPDP) initiative, whose "
^DIC(9.4,164,22,1,"PAH",79,1,8,0)="ultimate goal is to provide functionality allowing electronic transmission"
^DIC(9.4,164,22,1,"PAH",79,1,9,0)="of Outpatient Pharmacy (OP) prescription claims to payers and the receipt "
^DIC(9.4,164,22,1,"PAH",79,1,10,0)="of claim responses (including drug utilization review responses and "
^DIC(9.4,164,22,1,"PAH",79,1,11,0)="warnings) on a real-time basis, is being developed and introduced in a "
^DIC(9.4,164,22,1,"PAH",79,1,12,0)="phased implementation strategy. This deployment strategy was utilized due "
^DIC(9.4,164,22,1,"PAH",79,1,13,0)="to the complexity of the functionality and the number of product line "
^DIC(9.4,164,22,1,"PAH",79,1,14,0)="dependencies."
^DIC(9.4,164,22,1,"PAH",79,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,16,0)="The first release of this two part implementation is BPS*1*0, comprised of"
^DIC(9.4,164,22,1,"PAH",79,1,17,0)="the new Electronic Claims Management Engine (ECME) package (in the BPS "
^DIC(9.4,164,22,1,"PAH",79,1,18,0)="namespace), plus the patches PSS*1*81, IB*2.0*223, IB*2.0*251, and "
^DIC(9.4,164,22,1,"PAH",79,1,19,0)="PRCA*4.5*202, which are listed here in order of installation. BPS*1*0 is a"
^DIC(9.4,164,22,1,"PAH",79,1,20,0)="dormant release that only allows each site to perform preliminary setup "
^DIC(9.4,164,22,1,"PAH",79,1,21,0)="work and to confirm that the software does not adversely affect other "
^DIC(9.4,164,22,1,"PAH",79,1,22,0)="packages."
^DIC(9.4,164,22,1,"PAH",79,1,23,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,24,0)="There are two main areas addressed by BPS*1*0:"
^DIC(9.4,164,22,1,"PAH",79,1,25,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,26,0)="a. Registration of the Pharmacy with the Vitria BusinessWare IE."
^DIC(9.4,164,22,1,"PAH",79,1,27,0)="b. The Insurance Matching of Group Plans with Pharmacy Plans"
^DIC(9.4,164,22,1,"PAH",79,1,28,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,29,0)="Following the installation of BPS*1*0, each site must register their "
^DIC(9.4,164,22,1,"PAH",79,1,30,0)="pharmacy with Vitria and match applicable insurance group plans using the "
^DIC(9.4,164,22,1,"PAH",79,1,31,0)="insurance matching screens. These processes are detailed in the HIPAA "
^DIC(9.4,164,22,1,"PAH",79,1,32,0)="NCPDP CONNECTION FOR EDI PHARMACY INSTALLATION GUIDE and the E-PHARMACY"
^DIC(9.4,164,22,1,"PAH",79,1,33,0)="CLAIMS INSURANCE PROCESS document. Both of these documents are located on"
^DIC(9.4,164,22,1,"PAH",79,1,34,0)="the anonymous directory. It is very important that the IRM or person"
^DIC(9.4,164,22,1,"PAH",79,1,35,0)="installing the patch at each facility provide a copy of these documents to"
^DIC(9.4,164,22,1,"PAH",79,1,36,0)="its ADPAC(s) and any other relevant staff who will be responsible for"
^DIC(9.4,164,22,1,"PAH",79,1,37,0)="registering their pharmacy with Vitria and completing the insurance "
^DIC(9.4,164,22,1,"PAH",79,1,38,0)="matching process."
^DIC(9.4,164,22,1,"PAH",79,1,39,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,40,0)="At a later date, additional HIPAA NCPDP patches will be released to "
^DIC(9.4,164,22,1,"PAH",79,1,41,0)="activate all of the HIPAA NCPDP functionality. Until that time, sites will"
^DIC(9.4,164,22,1,"PAH",79,1,42,0)="not be able to electronically submit claims utilizing this new "
^DIC(9.4,164,22,1,"PAH",79,1,43,0)="functionality."
^DIC(9.4,164,22,1,"PAH",79,1,44,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,45,0)="The HIPAA NCPDP project was created in response to a Chief Business Office"
^DIC(9.4,164,22,1,"PAH",79,1,46,0)="(CBO) request for modifications to several Veterans Health Information "
^DIC(9.4,164,22,1,"PAH",79,1,47,0)="Systems and Technology Architecture (VistA) software applications in "
^DIC(9.4,164,22,1,"PAH",79,1,48,0)="accordance with HIPAA Electronic Data Interchange (EDI) transactions and "
^DIC(9.4,164,22,1,"PAH",79,1,49,0)="NCPDP mandated format standards, specifically the NCPDP Telecommunication "
^DIC(9.4,164,22,1,"PAH",79,1,50,0)="Standard v.5.1."
^DIC(9.4,164,22,1,"PAH",79,1,51,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,52,0)="The specific functionality for this patch is listed below."
^DIC(9.4,164,22,1,"PAH",79,1,53,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,54,0)="Overview of the Process:"
^DIC(9.4,164,22,1,"PAH",79,1,55,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,56,0)="The changes to Pharmacy Data Management are as follows:"
^DIC(9.4,164,22,1,"PAH",79,1,57,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,58,0)="1. DEA, SPECIAL HDLG field (#3) in the DRUG (#50) file."
^DIC(9.4,164,22,1,"PAH",79,1,59,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,60,0)="Routine PSSDDUT2 was modified to accommodate the use of the letter 'E' "
^DIC(9.4,164,22,1,"PAH",79,1,61,0)="within the DEA, SPECIAL HDLG field (#3) of the DRUG file (#50)."
^DIC(9.4,164,22,1,"PAH",79,1,62,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,63,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,64,0)="Data Dictionary Changes in Outpatient Pharmacy:"
^DIC(9.4,164,22,1,"PAH",79,1,65,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,66,0)="1. For the DRUG file (#50), the DEA, SPECIAL HDLG (#3) field for the drug"
^DIC(9.4,164,22,1,"PAH",79,1,67,0)="will need to accommodate the use of the letter 'E' to indicate that a drug"
^DIC(9.4,164,22,1,"PAH",79,1,68,0)="is billable for ECME purposes.  The routine dealing with the Help Text of"
^DIC(9.4,164,22,1,"PAH",79,1,69,0)="this field was modified to accommodate the inclusion of an 'E' within the"
^DIC(9.4,164,22,1,"PAH",79,1,70,0)="list of possible entries."
^DIC(9.4,164,22,1,"PAH",79,1,71,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,72,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,73,0)="Associated NOISs:"
^DIC(9.4,164,22,1,"PAH",79,1,74,0)="================="
^DIC(9.4,164,22,1,"PAH",79,1,75,0)="N/A"
^DIC(9.4,164,22,1,"PAH",79,1,76,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,77,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,78,0)="Test Sites:"
^DIC(9.4,164,22,1,"PAH",79,1,79,0)="==========="
^DIC(9.4,164,22,1,"PAH",79,1,80,0)="NEW YORK HARBOR HCS"
^DIC(9.4,164,22,1,"PAH",79,1,81,0)="NORTH TEXAS HCS"
^DIC(9.4,164,22,1,"PAH",79,1,82,0)="ANN ARBOR, MI       "
^DIC(9.4,164,22,1,"PAH",79,1,83,0)="BATTLE CREEK, MI     "
^DIC(9.4,164,22,1,"PAH",79,1,84,0)="DETROIT, MI"
^DIC(9.4,164,22,1,"PAH",79,1,85,0)="IRON MOUNTAIN, MI"
^DIC(9.4,164,22,1,"PAH",79,1,86,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,87,0)="Routine Summary: "
^DIC(9.4,164,22,1,"PAH",79,1,88,0)="================"
^DIC(9.4,164,22,1,"PAH",79,1,89,0)="The second line now reads as follows: "
^DIC(9.4,164,22,1,"PAH",79,1,90,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,91,0)="    <TAB>;;7.0;PHARMACY DATA MANAGEMENT;**[patch list]**; 9/30/97"
^DIC(9.4,164,22,1,"PAH",79,1,92,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,93,0)=" CHECK^XTSUMBLD results: "
^DIC(9.4,164,22,1,"PAH",79,1,94,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,95,0)="Routine    Before Patch  After Patch  Patch List "
^DIC(9.4,164,22,1,"PAH",79,1,96,0)="=======    ============  ===========  =========="
^DIC(9.4,164,22,1,"PAH",79,1,97,0)="PSSDDUT2       16160245     16615950  3,21,61,81"
^DIC(9.4,164,22,1,"PAH",79,1,98,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,99,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,100,0)="Documentation Retrieval:"
^DIC(9.4,164,22,1,"PAH",79,1,101,0)="========================"
^DIC(9.4,164,22,1,"PAH",79,1,102,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,103,0)="The ECME documentation is available on the ANONYMOUS.SOFTWARE directory"
^DIC(9.4,164,22,1,"PAH",79,1,104,0)="at one of the following Office of Information (OI) Field Offices."
^DIC(9.4,164,22,1,"PAH",79,1,105,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,106,0)="Sites may retrieve documentation in one of the following ways:"
^DIC(9.4,164,22,1,"PAH",79,1,107,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,108,0)="(1) The preferred method is to FTP the files from"
^DIC(9.4,164,22,1,"PAH",79,1,109,0)="    download.vista.domain.ext, which will transmit the files from the"
^DIC(9.4,164,22,1,"PAH",79,1,110,0)="    first available FTP server."
^DIC(9.4,164,22,1,"PAH",79,1,111,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,112,0)="(2) Sites may also elect to retrieve documentation directly from a"
^DIC(9.4,164,22,1,"PAH",79,1,113,0)="    specific server as follows:"
^DIC(9.4,164,22,1,"PAH",79,1,114,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,115,0)="    Albany          ftp.fo-albany.domain.ext"
^DIC(9.4,164,22,1,"PAH",79,1,116,0)="    Hines           ftp.fo-hines.domain.ext"
^DIC(9.4,164,22,1,"PAH",79,1,117,0)="    Salt Lake City  ftp.fo-slc.domain.ext "
^DIC(9.4,164,22,1,"PAH",79,1,118,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,119,0)="The documentation distribution includes:"
^DIC(9.4,164,22,1,"PAH",79,1,120,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,121,0)="   FILE NAME                        DESCRIPTION"
^DIC(9.4,164,22,1,"PAH",79,1,122,0)="   BPS_1_0_IG.PDF                   HIPAA NCPDP CONNECTION FOR EDI "
^DIC(9.4,164,22,1,"PAH",79,1,123,0)="                                    PHARMACY "
^DIC(9.4,164,22,1,"PAH",79,1,124,0)="                                    (DORMANT RELEASE) INSTALLATION GUIDE"
^DIC(9.4,164,22,1,"PAH",79,1,125,0)="   BPS_1_0_RN.PDF                   HIPAA NCPDP CONNECTION FOR EDI "
^DIC(9.4,164,22,1,"PAH",79,1,126,0)="                                    PHARMACY"
^DIC(9.4,164,22,1,"PAH",79,1,127,0)="                                    (DORMANT RELEASE) RELEASE NOTES"
^DIC(9.4,164,22,1,"PAH",79,1,128,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,129,0)="(3) Documentation can also be retrieved from VISTA Documentation Library"
^DIC(9.4,164,22,1,"PAH",79,1,130,0)="(VDL) on the Internet at the following address, http://www.domain.ext/vdl."
^DIC(9.4,164,22,1,"PAH",79,1,131,0)="   "
^DIC(9.4,164,22,1,"PAH",79,1,132,0)="Installation Instructions:"
^DIC(9.4,164,22,1,"PAH",79,1,133,0)="==========================  "
^DIC(9.4,164,22,1,"PAH",79,1,134,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,135,0)="The software for this patch is being distributed via a host file.  The "
^DIC(9.4,164,22,1,"PAH",79,1,136,0)="host file will contain the following package and builds:"
^DIC(9.4,164,22,1,"PAH",79,1,137,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,138,0)="       Host file name BPS_1_0.KID"
^DIC(9.4,164,22,1,"PAH",79,1,139,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,140,0)="               Package:"
^DIC(9.4,164,22,1,"PAH",79,1,141,0)="                       BPS_1"
^DIC(9.4,164,22,1,"PAH",79,1,142,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,143,0)="               Builds:"
^DIC(9.4,164,22,1,"PAH",79,1,144,0)="                       PSS*1.0*81 "
^DIC(9.4,164,22,1,"PAH",79,1,145,0)="                       IB*2.0*223"
^DIC(9.4,164,22,1,"PAH",79,1,146,0)="                       IB*2.0*251"
^DIC(9.4,164,22,1,"PAH",79,1,147,0)="                       PRCA*4.5*202"
^DIC(9.4,164,22,1,"PAH",79,1,148,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,149,0)="Sites may retrieve the software directly by using FTP from the "
^DIC(9.4,164,22,1,"PAH",79,1,150,0)="ANONYMOUS.SOFTWARE directory at the following OI Field Offices:"
^DIC(9.4,164,22,1,"PAH",79,1,151,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,152,0)="       Albany:         ftp.fo-albany.domain.ext"
^DIC(9.4,164,22,1,"PAH",79,1,153,0)="       Hines:          ftp.fo-hines.domain.ext"
^DIC(9.4,164,22,1,"PAH",79,1,154,0)="       Salt Lake City: ftp.fo-slc.domain.ext"
^DIC(9.4,164,22,1,"PAH",79,1,155,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,156,0)="Do not install this patch while Pharmacy Data Management users are using "
^DIC(9.4,164,22,1,"PAH",79,1,157,0)="the software. Installation will take no longer than 15 minutes. There are"
^DIC(9.4,164,22,1,"PAH",79,1,158,0)="no scheduling restrictions or recommendations."
^DIC(9.4,164,22,1,"PAH",79,1,159,0)="  "
^DIC(9.4,164,22,1,"PAH",79,1,160,0)="Installation Steps"
^DIC(9.4,164,22,1,"PAH",79,1,161,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,162,0)=" 1. Use VA FileMan to add the new domain, EPHARMACY.VITRIA-EDI.AAC.DOMAIN.EXT,"
^DIC(9.4,164,22,1,"PAH",79,1,163,0)="    to the DOMAIN file (#4.2). The installation instructions are included"
^DIC(9.4,164,22,1,"PAH",79,1,164,0)="    in the patch description for the XM*DBA*160 patch. This domain must be"
^DIC(9.4,164,22,1,"PAH",79,1,165,0)="    in place before the installation of the IB*2*251 patch that is"
^DIC(9.4,164,22,1,"PAH",79,1,166,0)="    included in the BPS 1.0 Master Build."
^DIC(9.4,164,22,1,"PAH",79,1,167,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,168,0)=" 2. Download the KIDS file BPS_1_0.KID via FTP. This file needs to be "
^DIC(9.4,164,22,1,"PAH",79,1,169,0)="    retrieved in ASCII format."
^DIC(9.4,164,22,1,"PAH",79,1,170,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,171,0)=" 3. Review mapped sets for the PSS*, IB*, and PRCA*namespaces.  If the "
^DIC(9.4,164,22,1,"PAH",79,1,172,0)="    routines are mapped, they should be removed from the mapped set at"
^DIC(9.4,164,22,1,"PAH",79,1,173,0)="    this time."
^DIC(9.4,164,22,1,"PAH",79,1,174,0)="  "
^DIC(9.4,164,22,1,"PAH",79,1,175,0)=" 4. From the Kernel Installation & Distribution System menu, select the "
^DIC(9.4,164,22,1,"PAH",79,1,176,0)="    Installation menu."
^DIC(9.4,164,22,1,"PAH",79,1,177,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,178,0)=" 5. From this menu, select the Load a Distribution option. When prompted "
^DIC(9.4,164,22,1,"PAH",79,1,179,0)="    for a file name, enter the directory name where you FTPd the build, "
^DIC(9.4,164,22,1,"PAH",79,1,180,0)="    followed by BPS_1_0. In our example, the file name is"
^DIC(9.4,164,22,1,"PAH",79,1,181,0)="    USER$:[ANONYMOUS]BPS_1_0.KID. Determine the location where you stored"
^DIC(9.4,164,22,1,"PAH",79,1,182,0)="    your build to decide the correct file name entry."
^DIC(9.4,164,22,1,"PAH",79,1,183,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,184,0)=" 6. At the ""Want to Continue with Load? YES//"" prompt, enter YES."
^DIC(9.4,164,22,1,"PAH",79,1,185,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,186,0)=" 7. At the ""Want to RUN the Environment Check Routine: YES//"" prompt, "
^DIC(9.4,164,22,1,"PAH",79,1,187,0)="    answer YES."
^DIC(9.4,164,22,1,"PAH",79,1,188,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,189,0)=" 8. From this menu, the installer may select to use the following options:"
^DIC(9.4,164,22,1,"PAH",79,1,190,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,191,0)="(When prompted for INSTALL NAME, enter BPS 1.0)"
^DIC(9.4,164,22,1,"PAH",79,1,192,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,193,0)="    a. Backup a Transport Global - This option will create a backup "
^DIC(9.4,164,22,1,"PAH",79,1,194,0)="    message of any routines exported with the patch. It will NOT backup"
^DIC(9.4,164,22,1,"PAH",79,1,195,0)="    any other changes such as DDs or templates."
^DIC(9.4,164,22,1,"PAH",79,1,196,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,197,0)="    b. Compare Transport Global to Current System - This option will allow"
^DIC(9.4,164,22,1,"PAH",79,1,198,0)="    you to view all changes that will be made when the patch is installed."
^DIC(9.4,164,22,1,"PAH",79,1,199,0)="    It compares all components of the patch (routines, DDs, templates,"
^DIC(9.4,164,22,1,"PAH",79,1,200,0)="    etc.)."
^DIC(9.4,164,22,1,"PAH",79,1,201,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,202,0)="    c. Verify Checksums in Transport Global - This option will ensure the "
^DIC(9.4,164,22,1,"PAH",79,1,203,0)="    integrity of the routines that are in the transport global."
^DIC(9.4,164,22,1,"PAH",79,1,204,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,205,0)=" 9. At the ""Select Installation Option:"" prompt, enter 6 Install "
^DIC(9.4,164,22,1,"PAH",79,1,206,0)="    Package(s)"
^DIC(9.4,164,22,1,"PAH",79,1,207,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,208,0)="10. At the ""Select INSTALL NAME:"" prompt, enter BPS 1.0."
^DIC(9.4,164,22,1,"PAH",79,1,209,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,210,0)="11. When prompted, ""Want KIDS to Rebuild Menu Trees Upon Completion of "
^DIC(9.4,164,22,1,"PAH",79,1,211,0)="    Install? YES//"" respond NO."
^DIC(9.4,164,22,1,"PAH",79,1,212,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,213,0)="12. When prompted, ""Want KIDS to INHIBIT LOGONs during the install? YES//"""
^DIC(9.4,164,22,1,"PAH",79,1,214,0)="    respond NO."
^DIC(9.4,164,22,1,"PAH",79,1,215,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,216,0)="13. When prompted, ""Want to DISABLE Scheduled Options, Menu Options, and "
^DIC(9.4,164,22,1,"PAH",79,1,217,0)="    Protocols? YES//"" respond NO."
^DIC(9.4,164,22,1,"PAH",79,1,218,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,219,0)="14. When prompted, ""Device:Home//"" respond with the correct device and DO "
^DIC(9.4,164,22,1,"PAH",79,1,220,0)="    NOT queue this to P-Message."
^DIC(9.4,164,22,1,"PAH",79,1,221,0)=" "
^DIC(9.4,164,22,1,"PAH",79,1,222,0)="15. If routines were unmapped as part of step 3, they should be returned "
^DIC(9.4,164,22,1,"PAH",79,1,223,0)="    to the mapped set once the installation has run to completion."
^DIC(9.4,164,22,1,"PAH",80,0)="89^3041228^1"
^DIC(9.4,164,22,1,"PAH",80,1,0)="^^1^1^3041228"
^DIC(9.4,164,22,1,"PAH",80,1,1,0)="Add the non-VA med multiple from file #55 to the Clinical Reminders index."
^DIC(9.4,164,22,1,"PAH",81,0)="91 SEQ #82^3041228^1"
^DIC(9.4,164,22,1,"PAH",81,1,0)="^^13^13^3041228"
^DIC(9.4,164,22,1,"PAH",81,1,1,0)="This patch contains updated Application Program Interfaces (APIs) that "
^DIC(9.4,164,22,1,"PAH",81,1,2,0)="will be used by calling applications that currently do direct global "
^DIC(9.4,164,22,1,"PAH",81,1,3,0)="reads or writes to the Pharmacy Data Management files.  A review of the "
^DIC(9.4,164,22,1,"PAH",81,1,4,0)="previously released APIs showed several entry points where additional "
^DIC(9.4,164,22,1,"PAH",81,1,5,0)="pieces of data were required to be returned."
^DIC(9.4,164,22,1,"PAH",81,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",81,1,7,0)="If you have already made code modifications, or have made plans to make"
^DIC(9.4,164,22,1,"PAH",81,1,8,0)="code modifications to use any of the new APIs, please check the latest"
^DIC(9.4,164,22,1,"PAH",81,1,9,0)="version of the API manual to verify that the API(s) in question have an"
^DIC(9.4,164,22,1,"PAH",81,1,10,0)="Active status. The API manual has been modified since the original version"
^DIC(9.4,164,22,1,"PAH",81,1,11,0)="to indicate Active and Inactive APIs. If the API(s) you need have an"
^DIC(9.4,164,22,1,"PAH",81,1,12,0)="Inactive status, please contact the Pharmacy Re-Engineering team at the"
^DIC(9.4,164,22,1,"PAH",81,1,13,0)="Birmingham Field Office."
^DIC(9.4,164,22,1,"PAH",82,0)="59^3050204^1"
^DIC(9.4,164,22,1,"PAH",82,1,0)="^^48^48^3050204"
^DIC(9.4,164,22,1,"PAH",82,1,1,0)="1. The Inpatient Medications Orders for Outpatients project will allow a"
^DIC(9.4,164,22,1,"PAH",82,1,2,0)="user the ability to order unit dose medications for outpatients. This is "
^DIC(9.4,164,22,1,"PAH",82,1,3,0)="accomplished through modifications to Inpatient Medications V. 5.0,"
^DIC(9.4,164,22,1,"PAH",82,1,4,0)="Computerized Patient Record System (CPRS) V. 1.0, and Scheduling V. 5.3."
^DIC(9.4,164,22,1,"PAH",82,1,5,0)="The purpose of this patch is to create three new fields in the PHARMACY"
^DIC(9.4,164,22,1,"PAH",82,1,6,0)="PATIENT file (#55). In the UNIT DOSE multiple (#62), the CLINIC field"
^DIC(9.4,164,22,1,"PAH",82,1,7,0)="(#130) and the APPOINTMENT DATE/TIME field (#131) have been added. In the"
^DIC(9.4,164,22,1,"PAH",82,1,8,0)="IV multiple (#100), the APPOINTMENT DATE/TIME field (#139) has been added."
^DIC(9.4,164,22,1,"PAH",82,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",82,1,10,0)="2. A new parameter has been added to the PHARMACY SYSTEM file (#59.7). It "
^DIC(9.4,164,22,1,"PAH",82,1,11,0)="is the AUTO-DC IMO ORDERS field (#26.8). This new parameter will allow "
^DIC(9.4,164,22,1,"PAH",82,1,12,0)="sites to control whether or not Inpatient Medications Orders for "
^DIC(9.4,164,22,1,"PAH",82,1,13,0)="Outpatients are automatically discontinued during patient movements. This "
^DIC(9.4,164,22,1,"PAH",82,1,14,0)="parameter will only be effective if sites are using Inpatient Medications "
^DIC(9.4,164,22,1,"PAH",82,1,15,0)="to control discontinues on patient movements. If the site is using the "
^DIC(9.4,164,22,1,"PAH",82,1,16,0)="CPRS auto-dc rules, this parameter will have no effect."
^DIC(9.4,164,22,1,"PAH",82,1,17,0)=" "
^DIC(9.4,164,22,1,"PAH",82,1,18,0)="3. As a part of the Inpatient Medications Requirements for the Special"
^DIC(9.4,164,22,1,"PAH",82,1,19,0)="Focus Group IRA project, this patch modifies the definition of schedules"
^DIC(9.4,164,22,1,"PAH",82,1,20,0)="in the ADMINISTRATION SCHEDULE file (#51.1). TO accomplish this, the "
^DIC(9.4,164,22,1,"PAH",82,1,21,0)="following changes are being made to the PSSJ SCHEDULE EDIT input "
^DIC(9.4,164,22,1,"PAH",82,1,22,0)="template:"
^DIC(9.4,164,22,1,"PAH",82,1,23,0)="     a. Do not allow entry of a schedule with the name of OTHER. "
^DIC(9.4,164,22,1,"PAH",82,1,24,0)="     b. Do not allow entry of administration times for odd schedules. "
^DIC(9.4,164,22,1,"PAH",82,1,25,0)="     c. Display the calculated frequency to the user."
^DIC(9.4,164,22,1,"PAH",82,1,26,0)=" "
^DIC(9.4,164,22,1,"PAH",82,1,27,0)="4. Based on the upcoming requirement from the Joint Commission on"
^DIC(9.4,164,22,1,"PAH",82,1,28,0)="Accreditation of Hospital Organizations, schedule names that are"
^DIC(9.4,164,22,1,"PAH",82,1,29,0)="considered dangerous will no longer be allowed. The four schedules that "
^DIC(9.4,164,22,1,"PAH",82,1,30,0)="will no longer be allowed are: QD, HS, TIW and QOD. These schedules "
^DIC(9.4,164,22,1,"PAH",82,1,31,0)="cannot be used either alone or as part of a schedule name. For example: "
^DIC(9.4,164,22,1,"PAH",82,1,32,0)="QD is not allowed. Neither is QD ONCE."
^DIC(9.4,164,22,1,"PAH",82,1,33,0)=" "
^DIC(9.4,164,22,1,"PAH",82,1,34,0)="5. The Inpatient Medications Requirements for the Special Focus Group IRA"
^DIC(9.4,164,22,1,"PAH",82,1,35,0)="project will prevent users from entering free text schedules for inpatient"
^DIC(9.4,164,22,1,"PAH",82,1,36,0)="medication orders. This patch helps accomplish this by changing the"
^DIC(9.4,164,22,1,"PAH",82,1,37,0)="validation of schedules entered through Computerized Patient Record System"
^DIC(9.4,164,22,1,"PAH",82,1,38,0)="(CPRS) V. 1.0. This validation requires that schedules be defined in the"
^DIC(9.4,164,22,1,"PAH",82,1,39,0)="ADMINISTRATION SCHEDULE file (#51.1) or be a valid day-of-week, PRN or"
^DIC(9.4,164,22,1,"PAH",82,1,40,0)="administration time schedule before allowing the schedule to be added to"
^DIC(9.4,164,22,1,"PAH",82,1,41,0)="an inpatient order."
^DIC(9.4,164,22,1,"PAH",82,1,42,0)=" "
^DIC(9.4,164,22,1,"PAH",82,1,43,0)="6. A provider entering an order into Computerized Patient Record System"
^DIC(9.4,164,22,1,"PAH",82,1,44,0)="(CPRS) V. 1.0 must be permitted to place a limitation on the duration of"
^DIC(9.4,164,22,1,"PAH",82,1,45,0)="an inpatient medication order. This capability exists for Unit Dose orders"
^DIC(9.4,164,22,1,"PAH",82,1,46,0)="and Inpatient IV orders, but not for IV Fluid orders. This patch helps "
^DIC(9.4,164,22,1,"PAH",82,1,47,0)="accomplish this by adding a new field to the PHARMACY PATIENT file (#55), "
^DIC(9.4,164,22,1,"PAH",82,1,48,0)="IV multiple (#100) called REQUESTED IV LIMITATION (#152)."
^DIC(9.4,164,22,1,"PAH",83,0)="83 SEQ #84^3050311^1"
^DIC(9.4,164,22,1,"PAH",83,1,0)="^^1^1^3050311"
^DIC(9.4,164,22,1,"PAH",83,1,1,0)="In some cases when ordering a drug the incorrect dispense unit shows."
^DIC(9.4,164,22,1,"PAH",84,0)="87 SEQ #85^3050426^1"
^DIC(9.4,164,22,1,"PAH",84,1,0)="^^57^57^3050426"
^DIC(9.4,164,22,1,"PAH",84,1,1,0)="As part of the Outpatient Pharmacy V. 7.0 Laser Labels Phase II project, "
^DIC(9.4,164,22,1,"PAH",84,1,2,0)="a new commercial data source will be utilized to provide warning label"
^DIC(9.4,164,22,1,"PAH",84,1,3,0)="information. "
^DIC(9.4,164,22,1,"PAH",84,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",84,1,5,0)="This patch is required by PSO*7*161 which does the printing of the "
^DIC(9.4,164,22,1,"PAH",84,1,6,0)="warning labels on the laser labels form."
^DIC(9.4,164,22,1,"PAH",84,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",84,1,8,0)="The following changes are included in this patch:"
^DIC(9.4,164,22,1,"PAH",84,1,9,0)=" "
^DIC(9.4,164,22,1,"PAH",84,1,10,0)="Data dictionary changes:"
^DIC(9.4,164,22,1,"PAH",84,1,11,0)="==========================="
^DIC(9.4,164,22,1,"PAH",84,1,12,0)="New fields:"
^DIC(9.4,164,22,1,"PAH",84,1,13,0)="1. PHARMACY SYSTEM file (#59.7), WARNING LABEL SOURCE field (#16)"
^DIC(9.4,164,22,1,"PAH",84,1,14,0)="The new warning label processing is not fully functional until this field"
^DIC(9.4,164,22,1,"PAH",84,1,15,0)="is set to ""N"" for ""New"" in the Pharmacy System Parameters Edit [PSS SYS "
^DIC(9.4,164,22,1,"PAH",84,1,16,0)="EDIT] option."
^DIC(9.4,164,22,1,"PAH",84,1,17,0)="2. DRUG file (#50), NEW WARNING LABEL LIST field (#8.1)"
^DIC(9.4,164,22,1,"PAH",84,1,18,0)="If the default warnings for a drug are not sufficient, a custom list of "
^DIC(9.4,164,22,1,"PAH",84,1,19,0)="warning numbers can be created and stored in this field."
^DIC(9.4,164,22,1,"PAH",84,1,20,0)="3. DRUG file (#50), GENDER SPECIFIC LBLS ON ALL RX field (#8.2)"
^DIC(9.4,164,22,1,"PAH",84,1,21,0)="If the commercial data source has indicated that a particular warning "
^DIC(9.4,164,22,1,"PAH",84,1,22,0)="only applies to one gender, then if this flag is null or ""Y"", the warning "
^DIC(9.4,164,22,1,"PAH",84,1,23,0)="will print for all patients. If this field is ""N"", the warning will only"
^DIC(9.4,164,22,1,"PAH",84,1,24,0)="print for this drug when the patient is that specific gender."
^DIC(9.4,164,22,1,"PAH",84,1,25,0)="4. RX CONSULT file (#54), WARNING MAPPING field (#2)"
^DIC(9.4,164,22,1,"PAH",84,1,26,0)="5. RX CONSULT file (#54), SPANISH TRANSLATION field (#3)"
^DIC(9.4,164,22,1,"PAH",84,1,27,0)=" "
^DIC(9.4,164,22,1,"PAH",84,1,28,0)="The last 2 fields in the above list will have some entries populated"
^DIC(9.4,164,22,1,"PAH",84,1,29,0)="automatically in a post-install routine with this patch. The mapping is"
^DIC(9.4,164,22,1,"PAH",84,1,30,0)="used for matching entries in the old RX CONSULT file (#54) with the"
^DIC(9.4,164,22,1,"PAH",84,1,31,0)="equivalent entry in the new WARNING LABEL-ENGLISH file (#50.625)."
^DIC(9.4,164,22,1,"PAH",84,1,32,0)=" "
^DIC(9.4,164,22,1,"PAH",84,1,33,0)="New options under the PSS Manager [PSS MGR] option:"
^DIC(9.4,164,22,1,"PAH",84,1,34,0)="=================================================="
^DIC(9.4,164,22,1,"PAH",84,1,35,0)="1. Warning Builder [PSS WARNING BUILDER] option allows the user to print a"
^DIC(9.4,164,22,1,"PAH",84,1,36,0)="copy of the old and new warning file entries and to choose various ways to"
^DIC(9.4,164,22,1,"PAH",84,1,37,0)="select drugs to review which warnings will print when the flag is turned"
^DIC(9.4,164,22,1,"PAH",84,1,38,0)="to use the new warning label source. It also allows the user to override"
^DIC(9.4,164,22,1,"PAH",84,1,39,0)="the default warning labels to create a custom warning label list for the"
^DIC(9.4,164,22,1,"PAH",84,1,40,0)="selected drug. This is done by specifying a list of warning numbers from"
^DIC(9.4,164,22,1,"PAH",84,1,41,0)="the old RX CONSULT file (#54) and/or the new commercial data source"
^DIC(9.4,164,22,1,"PAH",84,1,42,0)="warning file."
^DIC(9.4,164,22,1,"PAH",84,1,43,0)="2. Warning Mapping [PSS WARNING MAPPING] option can be used to match an"
^DIC(9.4,164,22,1,"PAH",84,1,44,0)="entry from the old RX CONSULT file (#54) to the WARNING LABEL-ENGLISH "
^DIC(9.4,164,22,1,"PAH",84,1,45,0)="file (#50.625) to aid in using the Warning Builder (to identify local"
^DIC(9.4,164,22,1,"PAH",84,1,46,0)="warnings that do not have an equivalent entry in the new commercial data"
^DIC(9.4,164,22,1,"PAH",84,1,47,0)="source). The user can also enter a Spanish translation for an RX CONSULT"
^DIC(9.4,164,22,1,"PAH",84,1,48,0)="file (#54) entry, if desired, but whenever possible, the new commercial"
^DIC(9.4,164,22,1,"PAH",84,1,49,0)="data source's warnings should be used."
^DIC(9.4,164,22,1,"PAH",84,1,50,0)=" "
^DIC(9.4,164,22,1,"PAH",84,1,51,0)="Template changes:"
^DIC(9.4,164,22,1,"PAH",84,1,52,0)="================="
^DIC(9.4,164,22,1,"PAH",84,1,53,0)="This patch modifies the DRUG file (#50) INPUT template [PSSCOMMON] to "
^DIC(9.4,164,22,1,"PAH",84,1,54,0)="allow the user to view the new warning labels for a drug and edit the NEW "
^DIC(9.4,164,22,1,"PAH",84,1,55,0)="WARNING LABEL LIST field (#8.1), if desired. For drugs that have a "
^DIC(9.4,164,22,1,"PAH",84,1,56,0)="gender-specific warning associated with them, the new GENDER SPECIFIC "
^DIC(9.4,164,22,1,"PAH",84,1,57,0)="LBLS ON ALL RX field (#8.2) will also be prompted."
^DIC(9.4,164,22,1,"PAH",85,0)="86 SEQ #86^3050525^1"
^DIC(9.4,164,22,1,"PAH",85,1,0)="^^4^4^3050525"
^DIC(9.4,164,22,1,"PAH",85,1,1,0)="A request has been made to allow sites to define inpatient orders for "
^DIC(9.4,164,22,1,"PAH",85,1,2,0)="outpatients auto-dc capabilities on a clinic-by-clinic basis. This patch "
^DIC(9.4,164,22,1,"PAH",85,1,3,0)="helps to accomplish this goal by removing the AUTO-DC IMO ORDERS field"
^DIC(9.4,164,22,1,"PAH",85,1,4,0)="(#26.8) and associated data from the PHARMACY SYSTEM file (#59.7)."
^DIC(9.4,164,22,1,"PAH",86,0)="95 SEQ #87^3050625^1"
^DIC(9.4,164,22,1,"PAH",86,1,0)="^^6^6^3050625"
^DIC(9.4,164,22,1,"PAH",86,1,1,0)="This patch will correct an undefined variable error that occurred during "
^DIC(9.4,164,22,1,"PAH",86,1,2,0)="SQA testing of the Inpatient Medications patch PSJ*5.0*126.  When the "
^DIC(9.4,164,22,1,"PAH",86,1,3,0)="analyst tried to use the ? or ?? lookup/help functionality for the TO "
^DIC(9.4,164,22,1,"PAH",86,1,4,0)="SERVICE field in option [PSJ AC SETUP], the error occurred and prevented "
^DIC(9.4,164,22,1,"PAH",86,1,5,0)="the analyst from further testing CLE-0604-40092 (NOIS)/HD0000000068038."
^DIC(9.4,164,22,1,"PAH",86,1,6,0)="This patch will be installed with patch PSJ*5.0*126."
^DIC(9.4,164,22,1,"PAH",87,0)="96 SEQ #88^3050813^1"
^DIC(9.4,164,22,1,"PAH",87,1,0)="^^3^3^3050813"
^DIC(9.4,164,22,1,"PAH",87,1,1,0)="CHANGE DATA DESCRIPTION FOR MEDICATION ROUTE FIELD #3 IN NON-VA MEDS "
^DIC(9.4,164,22,1,"PAH",87,1,2,0)="SUB-FILE #55.05 IN PHARMACY PATIENT FILE #55.  CHANGE FIELD LENGTH FROM "
^DIC(9.4,164,22,1,"PAH",87,1,3,0)="20 TO 40."
^DIC(9.4,164,22,1,"PAH",88,0)="97 SEQ #89^3050813^1"
^DIC(9.4,164,22,1,"PAH",88,1,0)="^^4^4^3050813"
^DIC(9.4,164,22,1,"PAH",88,1,1,0)="This patch makes a change to one of the Pharmacy Data Management "
^DIC(9.4,164,22,1,"PAH",88,1,2,0)="encapsulation routines. A new component has been added that will allow "
^DIC(9.4,164,22,1,"PAH",88,1,3,0)="other packages to perform VA FileMan data retrieval through a Pharmacy "
^DIC(9.4,164,22,1,"PAH",88,1,4,0)="Application Program Interface (API)."
^DIC(9.4,164,22,1,"PAH",89,0)="101 SEQ #90^3051202^1"
^DIC(9.4,164,22,1,"PAH",89,1,0)="^^19^19^3051202"
^DIC(9.4,164,22,1,"PAH",89,1,1,0)="This patch contains Application Program Interfaces (APIs) that will be "
^DIC(9.4,164,22,1,"PAH",89,1,2,0)="used by calling applications that currently do direct global reads or "
^DIC(9.4,164,22,1,"PAH",89,1,3,0)="writes to the Pharmacy Data Management files.  Since the PHARMACY PATIENT "
^DIC(9.4,164,22,1,"PAH",89,1,4,0)="file (#55) and PHARMACY SYSTEM file (#59.7) are being replaced as part of "
^DIC(9.4,164,22,1,"PAH",89,1,5,0)="the Pharmacy Re-engineering project, any direct M-based global reads or "
^DIC(9.4,164,22,1,"PAH",89,1,6,0)="writes to these files must be replaced by calling the APIs provided in "
^DIC(9.4,164,22,1,"PAH",89,1,7,0)="this patch. When the new data source is in place, the calling "
^DIC(9.4,164,22,1,"PAH",89,1,8,0)="applications will not be required to make any changes, because these APIs "
^DIC(9.4,164,22,1,"PAH",89,1,9,0)="will be flexible enough to retrieve the requested data from the new data "
^DIC(9.4,164,22,1,"PAH",89,1,10,0)="source, when the time comes."
^DIC(9.4,164,22,1,"PAH",89,1,11,0)=" "
^DIC(9.4,164,22,1,"PAH",89,1,12,0)="These are the files that are affected. If any application is making "
^DIC(9.4,164,22,1,"PAH",89,1,13,0)="direct global reads or writes to any of these files, they must be "
^DIC(9.4,164,22,1,"PAH",89,1,14,0)="replaced by using the APIs exported with this patch."
^DIC(9.4,164,22,1,"PAH",89,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",89,1,16,0)="File Name:                        File Number:"
^DIC(9.4,164,22,1,"PAH",89,1,17,0)="RX PATIENT STATUS                    53"
^DIC(9.4,164,22,1,"PAH",89,1,18,0)="PHARMACY PATIENT                     55"
^DIC(9.4,164,22,1,"PAH",89,1,19,0)="PHARMACY SYSTEM                      59.7"
^DIC(9.4,164,22,1,"PAH",90,0)="102 SEQ #91^3051221^1"
^DIC(9.4,164,22,1,"PAH",90,1,0)="^^2^2^3051221"
^DIC(9.4,164,22,1,"PAH",90,1,1,0)="This patch will fix the problem with lookups in the Pharmacy Orderable "
^DIC(9.4,164,22,1,"PAH",90,1,2,0)="Item file (#50.7) when entering in lowercase drug names."
^DIC(9.4,164,22,1,"PAH",91,0)="103 SEQ #92^3051221^1"
^DIC(9.4,164,22,1,"PAH",91,1,0)="^^18^18^3051221"
^DIC(9.4,164,22,1,"PAH",91,1,1,0)=" 1. PSI-05-051:  A priority status of ASAP is not easily seen by the "
^DIC(9.4,164,22,1,"PAH",91,1,2,0)="    finishing pharmacist.  A STAT order is displayed as blinking and "
^DIC(9.4,164,22,1,"PAH",91,1,3,0)="    highlighted, but a ASAP order does not have any special visual"
^DIC(9.4,164,22,1,"PAH",91,1,4,0)="    effects.  "
^DIC(9.4,164,22,1,"PAH",91,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",91,1,6,0)="    In order to avoid adding more special visual effects to the screen "
^DIC(9.4,164,22,1,"PAH",91,1,7,0)="    this patch is designed to provide two System Parameters that will"
^DIC(9.4,164,22,1,"PAH",91,1,8,0)="    allow the site a choice of what orders are sent to the PSJ STAT"
^DIC(9.4,164,22,1,"PAH",91,1,9,0)="    NOW ACTIVE ORDER and PSJ STAT NOW PENDING ORDER mail groups."
^DIC(9.4,164,22,1,"PAH",91,1,10,0)="    The site can select STAT, ASAP, or NOW orders, or any combination of "
^DIC(9.4,164,22,1,"PAH",91,1,11,0)="    the three for notification via the mail group functionality."
^DIC(9.4,164,22,1,"PAH",91,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",91,1,13,0)="    This patch is adding two additional fields (parameters) to file 59.7, "
^DIC(9.4,164,22,1,"PAH",91,1,14,0)="    PHARMACY SYSTEM FILE to enable the sites to select the priorities that"
^DIC(9.4,164,22,1,"PAH",91,1,15,0)="    will be used in the Inpatient Medications PENDING and ACTIVE order "
^DIC(9.4,164,22,1,"PAH",91,1,16,0)="    notification software.  This will solve the reported problem in "
^DIC(9.4,164,22,1,"PAH",91,1,17,0)="    HD98412 / PSI-05-051 by enabling the site to be notified when ASAP "
^DIC(9.4,164,22,1,"PAH",91,1,18,0)="    orders are submitted by the physician."
^DIC(9.4,164,22,1,"PAH",92,0)="105 SEQ #93^3060308^1"
^DIC(9.4,164,22,1,"PAH",92,1,0)="^^3^3^3060308"
^DIC(9.4,164,22,1,"PAH",92,1,1,0)="This patch fixes an error that could occur when invoking the VAC^PSS50 or"
^DIC(9.4,164,22,1,"PAH",92,1,2,0)="ASP^PSS50 Application Program Interface, which are both supported by"
^DIC(9.4,164,22,1,"PAH",92,1,3,0)="Integration Agreement 4533."
^DIC(9.4,164,22,1,"PAH",93,0)="100^3060308^1"
^DIC(9.4,164,22,1,"PAH",93,1,0)="^^2^2^3060308"
^DIC(9.4,164,22,1,"PAH",93,1,1,0)="This patch will add MG-PE & NANOGRAM to the DRUG UNIT field #2 of"
^DIC(9.4,164,22,1,"PAH",93,1,2,0)="IV ADDITIVES file #52.6"
^DIC(9.4,164,22,1,"PAH",94,0)="104 SEQ #95^3060308^1"
^DIC(9.4,164,22,1,"PAH",94,1,0)="^^16^16^3060308"
^DIC(9.4,164,22,1,"PAH",94,1,1,0)="A change has been made to the DIC^PSSDI and MIX^PSSDI components of DBIA "
^DIC(9.4,164,22,1,"PAH",94,1,2,0)="4551. DIC(""S"") will be killed within these components. Two new input "
^DIC(9.4,164,22,1,"PAH",94,1,3,0)="parameters have been added to address screening issues. If the file you"
^DIC(9.4,164,22,1,"PAH",94,1,4,0)="are passing in has an Inactivation Date field, and you want to screen on "
^DIC(9.4,164,22,1,"PAH",94,1,5,0)="that field, a new date input parameter is being added to the components, "
^DIC(9.4,164,22,1,"PAH",94,1,6,0)="and if a date is passed in, a screen will be set for the calling"
^DIC(9.4,164,22,1,"PAH",94,1,7,0)="application. If the file you are passing in is the DRUG file (#50), and "
^DIC(9.4,164,22,1,"PAH",94,1,8,0)="you want to screen on the APPLICATION PACKAGES' USE field (#63), and new "
^DIC(9.4,164,22,1,"PAH",94,1,9,0)="input paramter has been added for that also."
^DIC(9.4,164,22,1,"PAH",94,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",94,1,11,0)="A new component, FNAME^PSSDI has been added to DBIA 4551. This component "
^DIC(9.4,164,22,1,"PAH",94,1,12,0)="will return the LABEL attribute of the Field passed into the call."
^DIC(9.4,164,22,1,"PAH",94,1,13,0)=" "
^DIC(9.4,164,22,1,"PAH",94,1,14,0)="Patch PSS*1*92 adds the SERVICE CODE field to the output of the "
^DIC(9.4,164,22,1,"PAH",94,1,15,0)="DATA^PSS50 component of DBIA 4533. This patch cirrect the problem where "
^DIC(9.4,164,22,1,"PAH",94,1,16,0)="this field is not being returned if a ""??"" value is passed into the call."
^DIC(9.4,164,22,1,"PAH",95,0)="98 SEQ #96^3060410^1"
^DIC(9.4,164,22,1,"PAH",95,1,0)="^^4^4^3060410"
^DIC(9.4,164,22,1,"PAH",95,1,1,0)="This patch will correct the reported problems with in the "
^DIC(9.4,164,22,1,"PAH",95,1,2,0)="WARNING BUILDER option [PSS WARNING BUILDER].  It will also"
^DIC(9.4,164,22,1,"PAH",95,1,3,0)="modify the input transform for the VOLUME field of IV SOLUTIONS"
^DIC(9.4,164,22,1,"PAH",95,1,4,0)="file #52.7 to allow a leading zero."
^DIC(9.4,164,22,1,"PAH",96,0)="93 SEQ #97^3060504^1"
^DIC(9.4,164,22,1,"PAH",96,1,0)="^^14^14^3060504"
^DIC(9.4,164,22,1,"PAH",96,1,1,0)="1. The Computerized Patient Record System (CPRS) V. 1.0 has requested a "
^DIC(9.4,164,22,1,"PAH",96,1,2,0)="new Application Programming Interface (API) from Pharmacy Data Management "
^DIC(9.4,164,22,1,"PAH",96,1,3,0)="V. 1.0. The new API will allow CPRS to request the current status of any "
^DIC(9.4,164,22,1,"PAH",96,1,4,0)="order for both Inpatient Medications V. 5.0 and Outpatient Pharmacy V. "
^DIC(9.4,164,22,1,"PAH",96,1,5,0)="7.0. "
^DIC(9.4,164,22,1,"PAH",96,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",96,1,7,0)="2. During internal testing, it was discovered that the Expected First "
^DIC(9.4,164,22,1,"PAH",96,1,8,0)="Dose display in CPRS was inconsistent for PRN orders. If a provider "
^DIC(9.4,164,22,1,"PAH",96,1,9,0)="checked the PRN box, no Expected First Dose is displayed. However, if the "
^DIC(9.4,164,22,1,"PAH",96,1,10,0)="schedule selected had PRN in the name, an Expected First Dose is "
^DIC(9.4,164,22,1,"PAH",96,1,11,0)="displayed which is not correct. This patch assists in correcting this"
^DIC(9.4,164,22,1,"PAH",96,1,12,0)="problem by modifying the TYPE OF SCHEDULE field (#5) in the ADMINISTRATION"
^DIC(9.4,164,22,1,"PAH",96,1,13,0)="SCHEDULE file (#51.1) to allow PRN. This information will then be provided"
^DIC(9.4,164,22,1,"PAH",96,1,14,0)="in an API to CPRS. PSI-05-026."
^DIC(9.4,164,22,1,"PAH",97,0)="90 SEQ #98^3060525^1"
^DIC(9.4,164,22,1,"PAH",97,1,0)="^^135^135^3060525"
^DIC(9.4,164,22,1,"PAH",97,1,1,0)="This project involves six different applications that have been significantly"
^DIC(9.4,164,22,1,"PAH",97,1,2,0)="changed to enable VA Medical Centers to perform third party electronic billing"
^DIC(9.4,164,22,1,"PAH",97,1,3,0)="for prescriptions. "
^DIC(9.4,164,22,1,"PAH",97,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",97,1,5,0)="Below is a list of all the applications involved in this project along with"
^DIC(9.4,164,22,1,"PAH",97,1,6,0)="their patch number:"
^DIC(9.4,164,22,1,"PAH",97,1,7,0)="  "
^DIC(9.4,164,22,1,"PAH",97,1,8,0)="   APPLICATION/VERSION                                  PATCH"
^DIC(9.4,164,22,1,"PAH",97,1,9,0)="   -----------------------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",97,1,10,0)="   OUTPATIENT PHARMACY (OP) V. 7.0                      PSO*7*148"
^DIC(9.4,164,22,1,"PAH",97,1,11,0)="   INTEGRATED BILLING (IB) V. 2.0                       IB*2*276"
^DIC(9.4,164,22,1,"PAH",97,1,12,0)="   PHARMACY DATA MANAGEMENT (PDM) V. 1.0                PSS*1*90"
^DIC(9.4,164,22,1,"PAH",97,1,13,0)="   CONSOLIDATED MAIL OUTPATIENT PHARMACY (CMOP) V. 2.0  PSX*2*48"
^DIC(9.4,164,22,1,"PAH",97,1,14,0)="   ACCOUNTS RECEIVABLE (AR) V. 4.5                      PRCA*4.5*230"
^DIC(9.4,164,22,1,"PAH",97,1,15,0)="   ELECTRONIC CLAIMS MANAGEMENT ENGINE (ECME) V. 1.0    BPS*1*1"
^DIC(9.4,164,22,1,"PAH",97,1,16,0)=" "
^DIC(9.4,164,22,1,"PAH",97,1,17,0)="Veterans Health Information Systems and Technology Architecture (VistA) "
^DIC(9.4,164,22,1,"PAH",97,1,18,0)="software applications and infrastructure were enhanced, in order to allow the"
^DIC(9.4,164,22,1,"PAH",97,1,19,0)="electronic transmission of outpatient pharmacy prescription claims (WINDOW and"
^DIC(9.4,164,22,1,"PAH",97,1,20,0)="MAIL fills) to third party payers via the network connections available"
^DIC(9.4,164,22,1,"PAH",97,1,21,0)="through the Austin Automation Center (AAC). VistA will be enhanced to receive"
^DIC(9.4,164,22,1,"PAH",97,1,22,0)="electronic adjudicated responses from the third party payers, which include"
^DIC(9.4,164,22,1,"PAH",97,1,23,0)="real-time processing for Drug Review Utilization and Refill Too Soon rejects."
^DIC(9.4,164,22,1,"PAH",97,1,24,0)="Reject information will be displayed to the pharmacist as the prescription is"
^DIC(9.4,164,22,1,"PAH",97,1,25,0)="being processed. The pharmacist will have the capability to take the"
^DIC(9.4,164,22,1,"PAH",97,1,26,0)="appropriate action to ensure patient safety or to override the reject and"
^DIC(9.4,164,22,1,"PAH",97,1,27,0)="resubmit the claim to the payer for payment. When a status of ""PAYABLE"" is"
^DIC(9.4,164,22,1,"PAH",97,1,28,0)="returned by the payer for a released prescription, VistA will automatically "
^DIC(9.4,164,22,1,"PAH",97,1,29,0)="create the bill in IB, authorize it and immediately create the receivable in"
^DIC(9.4,164,22,1,"PAH",97,1,30,0)="the AR application. Since the exact amount being paid by the payer is known,"
^DIC(9.4,164,22,1,"PAH",97,1,31,0)="a decrease adjustment will be automatically generated and applied so that the"
^DIC(9.4,164,22,1,"PAH",97,1,32,0)="receivable is equal to the net amount due from the payer."
^DIC(9.4,164,22,1,"PAH",97,1,33,0)=" "
^DIC(9.4,164,22,1,"PAH",97,1,34,0)="The system also provides electronic payment matching capability (for"
^DIC(9.4,164,22,1,"PAH",97,1,35,0)="electronically billable outpatient pharmacy prescriptions) using the existing"
^DIC(9.4,164,22,1,"PAH",97,1,36,0)="Electronic Data Interchange (EDI) Lockbox functionality which processes other"
^DIC(9.4,164,22,1,"PAH",97,1,37,0)="electronic payments from third party payers. This real-time electronic claims"
^DIC(9.4,164,22,1,"PAH",97,1,38,0)="processing capability will be provided in accordance with the Healthcare"
^DIC(9.4,164,22,1,"PAH",97,1,39,0)="Insurance Portability and Accountability Act (HIPAA), EDI transactions and "
^DIC(9.4,164,22,1,"PAH",97,1,40,0)="the National Council for Prescription Drug Programs (NCPDP) mandated format "
^DIC(9.4,164,22,1,"PAH",97,1,41,0)="standards, specifically NCPDP Telecommunication Standard V. 5.1. Additional "
^DIC(9.4,164,22,1,"PAH",97,1,42,0)="functionality delivered with this project includes: "
^DIC(9.4,164,22,1,"PAH",97,1,43,0)=" "
^DIC(9.4,164,22,1,"PAH",97,1,44,0)="   . Auto-Release/Outpatient Pharmacy Automation Interface (OPAI) Integration."
^DIC(9.4,164,22,1,"PAH",97,1,45,0)="   . Back-billing capability to allow electronic billing of claims from within "
^DIC(9.4,164,22,1,"PAH",97,1,46,0)="     the IB application."
^DIC(9.4,164,22,1,"PAH",97,1,47,0)="   . Capability to MOVE a group of subscribers from one insurance plan to "
^DIC(9.4,164,22,1,"PAH",97,1,48,0)="     another while automatically ""expiring"" the old plan, which is a major"
^DIC(9.4,164,22,1,"PAH",97,1,49,0)="     time saver."
^DIC(9.4,164,22,1,"PAH",97,1,50,0)="   . Pharmacy Dispensed As Written (DAW) prescription processing."
^DIC(9.4,164,22,1,"PAH",97,1,51,0)="  "
^DIC(9.4,164,22,1,"PAH",97,1,52,0)="Overview of the Process:"
^DIC(9.4,164,22,1,"PAH",97,1,53,0)="  "
^DIC(9.4,164,22,1,"PAH",97,1,54,0)="When a prescription is about to be filled and dispensed by the pharmacy, the "
^DIC(9.4,164,22,1,"PAH",97,1,55,0)="OP application submits the prescription to the new ECME application. ECME then"
^DIC(9.4,164,22,1,"PAH",97,1,56,0)="contacts IB to verify whether or not the prescription is electronically"
^DIC(9.4,164,22,1,"PAH",97,1,57,0)="billable. If so, ECME gathers the information necessary to generate a NCPDP"
^DIC(9.4,164,22,1,"PAH",97,1,58,0)="claim. The claim information is passed to the VistA Health Level Seven (HL7)"
^DIC(9.4,164,22,1,"PAH",97,1,59,0)="package. The HL7 package then sends the billing information to the AAC, where"
^DIC(9.4,164,22,1,"PAH",97,1,60,0)="it is routed to the corresponding third party insurance via Emdeon (formerly"
^DIC(9.4,164,22,1,"PAH",97,1,61,0)="WebMD)."
^DIC(9.4,164,22,1,"PAH",97,1,62,0)="  "
^DIC(9.4,164,22,1,"PAH",97,1,63,0)="Once the payer processes the information, the response coming back from the"
^DIC(9.4,164,22,1,"PAH",97,1,64,0)="payer is passed back to the site that made the request, and the information"
^DIC(9.4,164,22,1,"PAH",97,1,65,0)="is stored in the ECME package. If the third party payer accepted the claim,"
^DIC(9.4,164,22,1,"PAH",97,1,66,0)="the adjudicated information is passed along to IB. If the claim was rejected"
^DIC(9.4,164,22,1,"PAH",97,1,67,0)="the problem can be worked on and a new claim can be submitted to the payer."
^DIC(9.4,164,22,1,"PAH",97,1,68,0)="  "
^DIC(9.4,164,22,1,"PAH",97,1,69,0)="For electronically billable CMOP prescription processing, the third party"
^DIC(9.4,164,22,1,"PAH",97,1,70,0)="claim is sent before the prescription information is transmitted to the"
^DIC(9.4,164,22,1,"PAH",97,1,71,0)="CMOP facility to be filled. Once the adjudicating response is electronically "
^DIC(9.4,164,22,1,"PAH",97,1,72,0)="received from the third party payer, if there are no Drug Utilization Review"
^DIC(9.4,164,22,1,"PAH",97,1,73,0)="or Refill Too Soon rejects, the prescription is then transmitted to the CMOP "
^DIC(9.4,164,22,1,"PAH",97,1,74,0)="facility. When the CMOP center sends the dispensing information back to VistA,"
^DIC(9.4,164,22,1,"PAH",97,1,75,0)="the National Drug Code (NDC) information is checked against the NDC sent to "
^DIC(9.4,164,22,1,"PAH",97,1,76,0)="the third party payer and, if different, a new claim is generated in the "
^DIC(9.4,164,22,1,"PAH",97,1,77,0)="background and is sent to the third party payer. In case the CMOP facility "
^DIC(9.4,164,22,1,"PAH",97,1,78,0)="indicates that it is unable to fill a ""PAYABLE  prescription fill, a reversal"
^DIC(9.4,164,22,1,"PAH",97,1,79,0)="is automatically submitted to the third party payer for the corresponding "
^DIC(9.4,164,22,1,"PAH",97,1,80,0)="fill."
^DIC(9.4,164,22,1,"PAH",97,1,81,0)="   "
^DIC(9.4,164,22,1,"PAH",97,1,82,0)="This patch modifies PDM V. 1.0 to support the other applications in the"
^DIC(9.4,164,22,1,"PAH",97,1,83,0)="electronic claims generation process. It does not interface with the ECME"
^DIC(9.4,164,22,1,"PAH",97,1,84,0)="application at all. The changes to this application are the following:"
^DIC(9.4,164,22,1,"PAH",97,1,85,0)=" "
^DIC(9.4,164,22,1,"PAH",97,1,86,0)="1. A new multiple field has been added to the DRUG file (#50) to store the"
^DIC(9.4,164,22,1,"PAH",97,1,87,0)="   latest NDC numbers that have been dispensed at window as well as by CMOP"
^DIC(9.4,164,22,1,"PAH",97,1,88,0)="   for a specific division. This way, when the next prescription is entered by"
^DIC(9.4,164,22,1,"PAH",97,1,89,0)="   the division for the same drug, the last used NDC is automatically"
^DIC(9.4,164,22,1,"PAH",97,1,90,0)="   retrieved from this new multiple, stored in the PRESCRIPTION file (#52) and"
^DIC(9.4,164,22,1,"PAH",97,1,91,0)="   sent to the third party payer through ECME. Below is the multiple field and"
^DIC(9.4,164,22,1,"PAH",97,1,92,0)="   the fields under it:"
^DIC(9.4,164,22,1,"PAH",97,1,93,0)="  "
^DIC(9.4,164,22,1,"PAH",97,1,94,0)="     32  NDC BY OUTPATIENT SITE"
^DIC(9.4,164,22,1,"PAH",97,1,95,0)="         .01   OUTPATIENT SITE  "
^DIC(9.4,164,22,1,"PAH",97,1,96,0)="           1   LAST LOCAL NDC        "
^DIC(9.4,164,22,1,"PAH",97,1,97,0)="           2   LAST CMOP NDC   "
^DIC(9.4,164,22,1,"PAH",97,1,98,0)="     "
^DIC(9.4,164,22,1,"PAH",97,1,99,0)="2. A new field has been added to the DRUG file (#50) to store the DAW CODE"
^DIC(9.4,164,22,1,"PAH",97,1,100,0)="   field (#81). When a new prescription is entered for a specific drug, the DAW"
^DIC(9.4,164,22,1,"PAH",97,1,101,0)="   CODE from the drug is stored in the PRESCRIPTION file (#52) for each fill."
^DIC(9.4,164,22,1,"PAH",97,1,102,0)="   This field is solely being used for electronic billing purposes. It "
^DIC(9.4,164,22,1,"PAH",97,1,103,0)="   communicates to the third party payer that a drug has a special "
^DIC(9.4,164,22,1,"PAH",97,1,104,0)="   characteristic, which will hopefully prevent the payer from rejecting the"
^DIC(9.4,164,22,1,"PAH",97,1,105,0)="   claim. Below are all 10 existing DAW CODES:"
^DIC(9.4,164,22,1,"PAH",97,1,106,0)=" "
^DIC(9.4,164,22,1,"PAH",97,1,107,0)="     0 - NO PRODUCT SELECTION INDICATED"
^DIC(9.4,164,22,1,"PAH",97,1,108,0)="     1 - SUBSTITUTION NOT ALLOWED BY PRESCRIBER"
^DIC(9.4,164,22,1,"PAH",97,1,109,0)="     2 - SUBSTITUTION ALLOWED-PATIENT REQUESTED PRODUCT DISPENSED"
^DIC(9.4,164,22,1,"PAH",97,1,110,0)="     3 - SUBSTITUTION ALLOWED-PHARMACIST SELECTED PRODUCT DISPENSED"
^DIC(9.4,164,22,1,"PAH",97,1,111,0)="     4 - SUBSTITUTION ALLOWED-GENERIC DRUG NOT IN STOCK"
^DIC(9.4,164,22,1,"PAH",97,1,112,0)="     5 - SUBSTITUTION ALLOWED-BRAND DRUG DISPENSED AS A GENERIC"
^DIC(9.4,164,22,1,"PAH",97,1,113,0)="     6 - OVERRIDE"
^DIC(9.4,164,22,1,"PAH",97,1,114,0)="     7 - SUBSTITUTION NOT ALLOWED-BRAND DRUG MANDATED BY LAW"
^DIC(9.4,164,22,1,"PAH",97,1,115,0)="     8 - SUBSTITUTION ALLOWED-GENERIC DRUG NOT AVAILABLE IN MARKETPLACE"
^DIC(9.4,164,22,1,"PAH",97,1,116,0)="     9 - OTHER"
^DIC(9.4,164,22,1,"PAH",97,1,117,0)=" "
^DIC(9.4,164,22,1,"PAH",97,1,118,0)="   Note: The existing entries in the DRUG file (#50) will NOT be automatically"
^DIC(9.4,164,22,1,"PAH",97,1,119,0)="         populated with a DAW CODE value upon installation of this patch."
^DIC(9.4,164,22,1,"PAH",97,1,120,0)="         However, the null value is automatically save as 0 (zero) - NO PRODUCT"
^DIC(9.4,164,22,1,"PAH",97,1,121,0)="         SELECTION INDICATED in a prescription entered for a drug with a null"
^DIC(9.4,164,22,1,"PAH",97,1,122,0)="         DAW CODE."
^DIC(9.4,164,22,1,"PAH",97,1,123,0)="   "
^DIC(9.4,164,22,1,"PAH",97,1,124,0)="3. The Drug Enter/Edit [PSS DRUG ENTER/EDIT] option has been modified to allow"
^DIC(9.4,164,22,1,"PAH",97,1,125,0)="   the user to associate a DAW CODE to a drug in the DRUG file (#50). "
^DIC(9.4,164,22,1,"PAH",97,1,126,0)=" "
^DIC(9.4,164,22,1,"PAH",97,1,127,0)="4. The Lookup into Dispense Drug File [PSS LOOK] option has been modified to"
^DIC(9.4,164,22,1,"PAH",97,1,128,0)="   display the DAW CODE field (#81) content for the drug being displayed."
^DIC(9.4,164,22,1,"PAH",97,1,129,0)="   Below is the exact point where the DAW CODE is displayed:"
^DIC(9.4,164,22,1,"PAH",97,1,130,0)="   "
^DIC(9.4,164,22,1,"PAH",97,1,131,0)="   ..."
^DIC(9.4,164,22,1,"PAH",97,1,132,0)="   DEA, SPECIAL HDLG: 6                             NDC:     00172-4390-18"
^DIC(9.4,164,22,1,"PAH",97,1,133,0)="   DAW CODE:  5 - SUBSTITUTION ALLOWED-BRAND DRUG DISPENSED AS A GENERIC"
^DIC(9.4,164,22,1,"PAH",97,1,134,0)="   CS FEDERAL SCHEDULE:"
^DIC(9.4,164,22,1,"PAH",97,1,135,0)="   ..."
^DIC(9.4,164,22,1,"PAH",98,0)="107 SEQ #99^3060526^1"
^DIC(9.4,164,22,1,"PAH",98,1,0)="^^4^4^3060526"
^DIC(9.4,164,22,1,"PAH",98,1,1,0)="This patch will fix the UNDEFINED error that occurs when Using "
^DIC(9.4,164,22,1,"PAH",98,1,2,0)="'Drug Enter/Edit' [PSS DRUG ENTER/EDIT] option. It will also"
^DIC(9.4,164,22,1,"PAH",98,1,3,0)="modify the trigger for PRICE PER ORDER UNIT field #13 of the"
^DIC(9.4,164,22,1,"PAH",98,1,4,0)="DRUG file (#50) to use 4 decimal places instead of 3."
^DIC(9.4,164,22,1,"PAH",99,0)="106 SEQ #100^3060711^1"
^DIC(9.4,164,22,1,"PAH",99,1,0)="^^14^14^3060711"
^DIC(9.4,164,22,1,"PAH",99,1,1,0)=" This patch contains Application Program Interfaces (APIs) that will be "
^DIC(9.4,164,22,1,"PAH",99,1,2,0)=" used by calling applications that currently do direct global reads or "
^DIC(9.4,164,22,1,"PAH",99,1,3,0)=" writes to the Pharmacy Data Management file. Since the PHARMACY PATIENT"
^DIC(9.4,164,22,1,"PAH",99,1,4,0)=" file (#55) is being replaced as part of the Pharmacy Re-engineering"
^DIC(9.4,164,22,1,"PAH",99,1,5,0)=" project, any direct M-based global reads or writes to this file must be"
^DIC(9.4,164,22,1,"PAH",99,1,6,0)=" replaced by calling the APIs provided in this patch."
^DIC(9.4,164,22,1,"PAH",99,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",99,1,8,0)=" When the new data source is in place, the calling applications will not"
^DIC(9.4,164,22,1,"PAH",99,1,9,0)=" be required to make any changes, because these APIs will be flexible"
^DIC(9.4,164,22,1,"PAH",99,1,10,0)=" enough to retrieve the requested data from the new data source when"
^DIC(9.4,164,22,1,"PAH",99,1,11,0)=" the time comes."
^DIC(9.4,164,22,1,"PAH",99,1,12,0)="  "
^DIC(9.4,164,22,1,"PAH",99,1,13,0)=" If any application is making direct global reads or writes to this file"
^DIC(9.4,164,22,1,"PAH",99,1,14,0)=" they must be replaced by using the APIs exported with this patch."
^DIC(9.4,164,22,1,"PAH",100,0)="113 SEQ #101^3060711^1"
^DIC(9.4,164,22,1,"PAH",100,1,0)="^^5^5^3060711"
^DIC(9.4,164,22,1,"PAH",100,1,1,0)="The Computerized Patient Record System (CPRS) V. 1.0 has requested a "
^DIC(9.4,164,22,1,"PAH",100,1,2,0)="modification to an Application Programming Interface (API) from Pharmacy"
^DIC(9.4,164,22,1,"PAH",100,1,3,0)="Data Management V. 1.0. The modified API will provide CPRS with a flag to"
^DIC(9.4,164,22,1,"PAH",100,1,4,0)="indicate a default Medication Route is being supplied from the PHARMACY"
^DIC(9.4,164,22,1,"PAH",100,1,5,0)="ORDERABLE ITEM (#50.7) file."
^DIC(9.4,164,22,1,"PAH",101,0)="92 SEQ #102^3060711^1"
^DIC(9.4,164,22,1,"PAH",101,1,0)="^^57^57^3060711"
^DIC(9.4,164,22,1,"PAH",101,1,1,0)="This Pharmacy Data Management (PDM) patch is part of the Patient Financial"
^DIC(9.4,164,22,1,"PAH",101,1,2,0)="Services System (PFSS) project. PFSS patches are being released on various"
^DIC(9.4,164,22,1,"PAH",101,1,3,0)="schedules. Some patch functionality will not be active until a new PFSS"
^DIC(9.4,164,22,1,"PAH",101,1,4,0)="switch is activated during final implementation. PFSS will initially be"
^DIC(9.4,164,22,1,"PAH",101,1,5,0)="implemented at select pilot sites ONLY."
^DIC(9.4,164,22,1,"PAH",101,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",101,1,7,0)="The purpose of the PFSS project is to prepare the Veterans Health"
^DIC(9.4,164,22,1,"PAH",101,1,8,0)="Information Systems and Technology Architecture (VistA) environment for"
^DIC(9.4,164,22,1,"PAH",101,1,9,0)="the implementation of a commercial off-the-shelf (COTS) billing"
^DIC(9.4,164,22,1,"PAH",101,1,10,0)="replacement system. The project consists of the implementation of the"
^DIC(9.4,164,22,1,"PAH",101,1,11,0)="billing replacement system, business process improvements, and"
^DIC(9.4,164,22,1,"PAH",101,1,12,0)="enhancements to VistA to support integration with the COTS billing"
^DIC(9.4,164,22,1,"PAH",101,1,13,0)="replacement system. Significant changes to VistA legacy systems and"
^DIC(9.4,164,22,1,"PAH",101,1,14,0)="ancillary packages are necessary."
^DIC(9.4,164,22,1,"PAH",101,1,15,0)=" "
^DIC(9.4,164,22,1,"PAH",101,1,16,0)="Some of the PFSS software components are not operational until the PFSS"
^DIC(9.4,164,22,1,"PAH",101,1,17,0)="On/Off Switch, distributed with patch IB*2*260, is set to ""ON"". The"
^DIC(9.4,164,22,1,"PAH",101,1,18,0)="ability for the local site to set the switch to ""ON  will be provided at"
^DIC(9.4,164,22,1,"PAH",101,1,19,0)="the appropriate time with the release of a subsequent Integrated Billing"
^DIC(9.4,164,22,1,"PAH",101,1,20,0)="patch."
^DIC(9.4,164,22,1,"PAH",101,1,21,0)=" "
^DIC(9.4,164,22,1,"PAH",101,1,22,0)="For more information about the PFSS project, review the documentation"
^DIC(9.4,164,22,1,"PAH",101,1,23,0)="accompanying this patch and refer to the following website:"
^DIC(9.4,164,22,1,"PAH",101,1,24,0)="http://vista.domain.ext/billreplace/."
^DIC(9.4,164,22,1,"PAH",101,1,25,0)=" "
^DIC(9.4,164,22,1,"PAH",101,1,26,0)=" "
^DIC(9.4,164,22,1,"PAH",101,1,27,0)="Functional Description:"
^DIC(9.4,164,22,1,"PAH",101,1,28,0)="======================="
^DIC(9.4,164,22,1,"PAH",101,1,29,0)="The Charge Description Master (CDM) is an industry standard financial tool"
^DIC(9.4,164,22,1,"PAH",101,1,30,0)="common to all commercial billing systems and used in virtually every"
^DIC(9.4,164,22,1,"PAH",101,1,31,0)="private hospital. The CDM is a comprehensive listing of all services"
^DIC(9.4,164,22,1,"PAH",101,1,32,0)="performed, drugs supplied, or supplies provided in a particular hospital"
^DIC(9.4,164,22,1,"PAH",101,1,33,0)="along with the value of those services/drugs/items, or charge amounts."
^DIC(9.4,164,22,1,"PAH",101,1,34,0)="Each of these entries are represented by a Charge Code, and the Charge"
^DIC(9.4,164,22,1,"PAH",101,1,35,0)="Code is made up of a Department Code and Service Code. The Charge Code for"
^DIC(9.4,164,22,1,"PAH",101,1,36,0)="Pharmacy will be the department code 160 concatenated with the assigned"
^DIC(9.4,164,22,1,"PAH",101,1,37,0)="Service Code for the drug. The Department Code 160 will not be stored in"
^DIC(9.4,164,22,1,"PAH",101,1,38,0)="any files and the Service Code will be established/approved by a central"
^DIC(9.4,164,22,1,"PAH",101,1,39,0)="CDM Change Control Board (CCB). The implementation of the COTS billing"
^DIC(9.4,164,22,1,"PAH",101,1,40,0)="system requires the VA PRODUCT file (#50.68)/DRUG file (#50) to link the"
^DIC(9.4,164,22,1,"PAH",101,1,41,0)="service master Service Code to every Pharmacy prescription fill or refill."
^DIC(9.4,164,22,1,"PAH",101,1,42,0)="For drugs that are not associated with an entry in the VA PRODUCT file"
^DIC(9.4,164,22,1,"PAH",101,1,43,0)="(#50.68), the approved Service Code must be populated by the user."
^DIC(9.4,164,22,1,"PAH",101,1,44,0)=" "
^DIC(9.4,164,22,1,"PAH",101,1,45,0)=" "
^DIC(9.4,164,22,1,"PAH",101,1,46,0)="Technical Description:"
^DIC(9.4,164,22,1,"PAH",101,1,47,0)="======================"
^DIC(9.4,164,22,1,"PAH",101,1,48,0)="This PDM patch PSS*1*92 provides the following functionality needed to"
^DIC(9.4,164,22,1,"PAH",101,1,49,0)="support the PFSS project:"
^DIC(9.4,164,22,1,"PAH",101,1,50,0)=" "
^DIC(9.4,164,22,1,"PAH",101,1,51,0)="1. A new SERVICE CODE field (#400) was added to the DRUG file (#50)."
^DIC(9.4,164,22,1,"PAH",101,1,52,0)="2. The PSSCOMMON Input template was modified to accommodate the new"
^DIC(9.4,164,22,1,"PAH",101,1,53,0)="   SERVICE CODE field (#400) to be used with the DRUG ENTER/EDIT [PSS DRUG"
^DIC(9.4,164,22,1,"PAH",101,1,54,0)="   ENTER/EDIT] option for drugs that are not associated with an entry in"
^DIC(9.4,164,22,1,"PAH",101,1,55,0)="   the VA PRODUCT file (#50.68)."
^DIC(9.4,164,22,1,"PAH",101,1,56,0)="3. The Integration Agreement (IA) #4483 was modified to include the new"
^DIC(9.4,164,22,1,"PAH",101,1,57,0)="   SERVICE CODE field (#400)."
^DIC(9.4,164,22,1,"PAH",102,0)="110 SEQ #103^3060824^1"
^DIC(9.4,164,22,1,"PAH",102,1,0)="^^3^3^3060824"
^DIC(9.4,164,22,1,"PAH",102,1,1,0)="1) Only allow uppercase alphabet for the NAME field in files #51.1"
^DIC(9.4,164,22,1,"PAH",102,1,2,0)="and #51."
^DIC(9.4,164,22,1,"PAH",102,1,3,0)="2) Allow elligible drugs to be marked for 'OP External Dispense'."
^DIC(9.4,164,22,1,"PAH",103,0)="115 SEQ #104^3060923^1"
^DIC(9.4,164,22,1,"PAH",103,1,0)="^^22^22^3060923"
^DIC(9.4,164,22,1,"PAH",103,1,1,0)="This patch supports the National Council for Prescription Drug Programs (NCPDP) "
^DIC(9.4,164,22,1,"PAH",103,1,2,0)="standard which was adopted under the Healthcare Insurance Portability and "
^DIC(9.4,164,22,1,"PAH",103,1,3,0)="Accountability Act (HIPAA) for pharmacy claims. This patch is one of six to be"
^DIC(9.4,164,22,1,"PAH",103,1,4,0)="released.  Three patches will be released in a KIDS multi-build distribution "
^DIC(9.4,164,22,1,"PAH",103,1,5,0)="containing: BPS*1*3, PSO*7*247, and IB*2*342.  Three patches will be released"
^DIC(9.4,164,22,1,"PAH",103,1,6,0)="individually and they are: PRCA*4.5*247, PSX*2.0*62, and PSS*1.0*115."
^DIC(9.4,164,22,1,"PAH",103,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",103,1,8,0)="Enhancements included in the release of the six patches are a new option that "
^DIC(9.4,164,22,1,"PAH",103,1,9,0)="will enable the user to reopen a closed Electron Claims Management Engine (ECME)"
^DIC(9.4,164,22,1,"PAH",103,1,10,0)="claim; updates to the Rx Activity Log; and permanent storage of Claims activity "
^DIC(9.4,164,22,1,"PAH",103,1,11,0)="information as reported by the ECME Billing Events Report.  "
^DIC(9.4,164,22,1,"PAH",103,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",103,1,13,0)="This patch restores the ability to edit the DAW CODE field through the Drug "
^DIC(9.4,164,22,1,"PAH",103,1,14,0)="Enter/Edit [PSS DRUG ENTER/EDIT] option in the Pharmacy Data Management (PDM)"
^DIC(9.4,164,22,1,"PAH",103,1,15,0)="application. This field was originally created by the patch PSS*1*90 (see item"
^DIC(9.4,164,22,1,"PAH",103,1,16,0)="#3) but was unintentionally removed by patch PSS*1*92."
^DIC(9.4,164,22,1,"PAH",103,1,17,0)="     "
^DIC(9.4,164,22,1,"PAH",103,1,18,0)="The following input template is included in this patch:"
^DIC(9.4,164,22,1,"PAH",103,1,19,0)=" "
^DIC(9.4,164,22,1,"PAH",103,1,20,0)="  Template Name                   File Name (Number)"
^DIC(9.4,164,22,1,"PAH",103,1,21,0)="  -------------                   ------------------"
^DIC(9.4,164,22,1,"PAH",103,1,22,0)="  PSSCOMMON                       DRUG        (50)"
^DIC(9.4,164,22,1,"PAH",104,0)="108 SEQ #105^3060923^1"
^DIC(9.4,164,22,1,"PAH",104,1,0)="^^30^30^3060923"
^DIC(9.4,164,22,1,"PAH",104,1,1,0)="This patch contains updated Application Program Interfaces (APIs) that will "
^DIC(9.4,164,22,1,"PAH",104,1,2,0)="be used by calling applications that currently do direct global reads or "
^DIC(9.4,164,22,1,"PAH",104,1,3,0)="writes to the Pharmacy Data Management files."
^DIC(9.4,164,22,1,"PAH",104,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",104,1,5,0)="The ORDERABLE ITEM STATUS TRACKER (#81) field has been added as a returned"
^DIC(9.4,164,22,1,"PAH",104,1,6,0)="data element for the PSS^PSS59P7 API on the Pharmacy System file (#59.7)."
^DIC(9.4,164,22,1,"PAH",104,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",104,1,8,0)="The ORIGINAL WARD (#9), OTHER PRINT INFO (#31) & MED ROUTE (#132) fields "
^DIC(9.4,164,22,1,"PAH",104,1,9,0)="were added to the PSS436 component of the PSS55 API on the Pharmacy "
^DIC(9.4,164,22,1,"PAH",104,1,10,0)="Patient file (#55).  "
^DIC(9.4,164,22,1,"PAH",104,1,11,0)=" "
^DIC(9.4,164,22,1,"PAH",104,1,12,0)="The DIC^PSSDI API has been modified to allow drug selection with matches"
^DIC(9.4,164,22,1,"PAH",104,1,13,0)="to certain VA Classes that are passed to the call."
^DIC(9.4,164,22,1,"PAH",104,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",104,1,15,0)="Classes to be included or excluded are to be set up in the PSSVACL array"
^DIC(9.4,164,22,1,"PAH",104,1,16,0)="within the DIC component."
^DIC(9.4,164,22,1,"PAH",104,1,17,0)=" "
^DIC(9.4,164,22,1,"PAH",104,1,18,0)="For example, if only drugs with a VA Class of DX201 & DX202 were to be"
^DIC(9.4,164,22,1,"PAH",104,1,19,0)="available for selection, the local variable array would look like this:"
^DIC(9.4,164,22,1,"PAH",104,1,20,0)=" "
^DIC(9.4,164,22,1,"PAH",104,1,21,0)="PSSVACL(""DX201"")="""""
^DIC(9.4,164,22,1,"PAH",104,1,22,0)="PSSVACL(""DX202"")="""""
^DIC(9.4,164,22,1,"PAH",104,1,23,0)="PSSVACL(""R"")="""" - The ""R"" means only drugs with these classes will be"
^DIC(9.4,164,22,1,"PAH",104,1,24,0)="                  available for selection. If these classes were to be"
^DIC(9.4,164,22,1,"PAH",104,1,25,0)="                  excluded, the letter ""P"" would be used instead."
^DIC(9.4,164,22,1,"PAH",104,1,26,0)=" "
^DIC(9.4,164,22,1,"PAH",104,1,27,0)=" "
^DIC(9.4,164,22,1,"PAH",104,1,28,0)="A new API was added to routine PSS51P1. The PSSDQ component displays all "
^DIC(9.4,164,22,1,"PAH",104,1,29,0)="the entries in the Administrative Schedules file (#51.1). "
^DIC(9.4,164,22,1,"PAH",104,1,30,0)=" "
^DIC(9.4,164,22,1,"PAH",105,0)="112 SEQ #106^3061122.234359^1"
^DIC(9.4,164,22,1,"PAH",105,1,0)="^^24^24^3061122"
^DIC(9.4,164,22,1,"PAH",105,1,1,0)="This patch enhances an original Pharmacy Data Management API call "
^DIC(9.4,164,22,1,"PAH",105,1,2,0)="DATA^PSS50.  By replacing FileMan calls with direct reads, data retrieval "
^DIC(9.4,164,22,1,"PAH",105,1,3,0)="from the DRUG file (#50) speed has been greatly improved. Specifications "
^DIC(9.4,164,22,1,"PAH",105,1,4,0)="for this API can be found in the Pharmacy Re-Engineering (PRE) API Manual."
^DIC(9.4,164,22,1,"PAH",105,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",105,1,6,0)="This patch also enhances an original Pharmacy Data Management API call "
^DIC(9.4,164,22,1,"PAH",105,1,7,0)="ALL^PSS51P2.  By replacing FileMan calls with direct reads, data "
^DIC(9.4,164,22,1,"PAH",105,1,8,0)="retrieval from the MEDICATION ROUTES file (#51.2) speed has been greatly "
^DIC(9.4,164,22,1,"PAH",105,1,9,0)="improved. Specifications for this API can be found in the Pharmacy "
^DIC(9.4,164,22,1,"PAH",105,1,10,0)="Re-Engineering (PRE) API Manual."
^DIC(9.4,164,22,1,"PAH",105,1,11,0)=" "
^DIC(9.4,164,22,1,"PAH",105,1,12,0)="Additionally, this patch introduces an API STATUS^PSS55MIS which requires"
^DIC(9.4,164,22,1,"PAH",105,1,13,0)="three parameters.  The set of codes for STATUS field in the PHARMACY"
^DIC(9.4,164,22,1,"PAH",105,1,14,0)="PATIENT file (#55) subfiles is returned. This API will invoke the"
^DIC(9.4,164,22,1,"PAH",105,1,15,0)="FIELD^DID Fileman call and data will be returned to the calling"
^DIC(9.4,164,22,1,"PAH",105,1,16,0)="application as specified in the FIELD^DID FileMan documentation. "
^DIC(9.4,164,22,1,"PAH",105,1,17,0)="Specifications for this API can be found in the Pharmacy Re-Engineering"
^DIC(9.4,164,22,1,"PAH",105,1,18,0)="(PRE) API Manual."
^DIC(9.4,164,22,1,"PAH",105,1,19,0)=" "
^DIC(9.4,164,22,1,"PAH",105,1,20,0)="Finally, this patch introduces CLINIC^PSS55MIS which requires three "
^DIC(9.4,164,22,1,"PAH",105,1,21,0)="parameters. This API returns a clinic from the HOSPITAL LOCATION file "
^DIC(9.4,164,22,1,"PAH",105,1,22,0)="(#44) based on a provided order number and patient DFN.  This API invokes "
^DIC(9.4,164,22,1,"PAH",105,1,23,0)="the GETS^DIQ data retrieval call.  Specifications for this API can be "
^DIC(9.4,164,22,1,"PAH",105,1,24,0)="found in the Pharmacy Re-Engineering (PRE) API Manual."
^DIC(9.4,164,22,1,"PAH",106,0)="114 SEQ #107^3070627.213329^1"
^DIC(9.4,164,22,1,"PAH",106,1,0)="^^13^13^3070627"
^DIC(9.4,164,22,1,"PAH",106,1,1,0)="1. In response to a patient safety issue, the Computerized Patient Record "
^DIC(9.4,164,22,1,"PAH",106,1,2,0)="System V. 1.0 was modified to no longer always use a default in the "
^DIC(9.4,164,22,1,"PAH",106,1,3,0)="medication ordering dialog. Therefore, sites are required to enter a "
^DIC(9.4,164,22,1,"PAH",106,1,4,0)="default in the PHARMACY ORDERABLE ITEM file (#50.7). However, in support "
^DIC(9.4,164,22,1,"PAH",106,1,5,0)="of the previous business logic, a default of ORAL was not allowed. This "
^DIC(9.4,164,22,1,"PAH",106,1,6,0)="patch changes this requirement and allows ORAL as a default medication "
^DIC(9.4,164,22,1,"PAH",106,1,7,0)="route. HD 144208, PSI-06-063"
^DIC(9.4,164,22,1,"PAH",106,1,8,0)=" "
^DIC(9.4,164,22,1,"PAH",106,1,9,0)="2. In order to assist sites in assigning a new default medication route, "
^DIC(9.4,164,22,1,"PAH",106,1,10,0)="a utility is provided to allow assignment of a route to multiple "
^DIC(9.4,164,22,1,"PAH",106,1,11,0)="orderable items, based on the dosage form. A new menu option has been set "
^DIC(9.4,164,22,1,"PAH",106,1,12,0)="up for this feature. The new menu option is [PSS ADD DEFAULT MED ROUTE] "
^DIC(9.4,164,22,1,"PAH",106,1,13,0)="and will be removed in a future patch."
^DIC(9.4,164,22,1,"PAH",107,0)="120 SEQ #108^3070627.221307^1"
^DIC(9.4,164,22,1,"PAH",107,1,0)="^^81^81^3070627"
^DIC(9.4,164,22,1,"PAH",107,1,1,0)="As part of the Outpatient Pharmacy V. 7.0 Laser Labels Phase II project, "
^DIC(9.4,164,22,1,"PAH",107,1,2,0)="a new commercial data source is utilized to provide warning label "
^DIC(9.4,164,22,1,"PAH",107,1,3,0)="information. "
^DIC(9.4,164,22,1,"PAH",107,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,5,0)="A parameter was provided by patch PSS*1*87 to turn on the new warning"
^DIC(9.4,164,22,1,"PAH",107,1,6,0)="label format. This is currently being used in association with printing"
^DIC(9.4,164,22,1,"PAH",107,1,7,0)="laser labels. However, since not all Consolidated Mail Outpatient"
^DIC(9.4,164,22,1,"PAH",107,1,8,0)="Pharmacy (CMOP) facilities are reprogrammed to receive the new format, a"
^DIC(9.4,164,22,1,"PAH",107,1,9,0)="new parameter is being added for turning on the new warnings for CMOP. And"
^DIC(9.4,164,22,1,"PAH",107,1,10,0)="another parameter is being added to turn on sending the new warnings to"
^DIC(9.4,164,22,1,"PAH",107,1,11,0)="the Outpatient Pharmacy Automation Interface (OPAI). This is to "
^DIC(9.4,164,22,1,"PAH",107,1,12,0)="accommodate vendors who may need to make changes to receive the new "
^DIC(9.4,164,22,1,"PAH",107,1,13,0)="warnings."
^DIC(9.4,164,22,1,"PAH",107,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,15,0)="Currently the Bedford CMOP is the only CMOP not ready to receive the new"
^DIC(9.4,164,22,1,"PAH",107,1,16,0)="format."
^DIC(9.4,164,22,1,"PAH",107,1,17,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,18,0)="Until the parameters are turned on, warning labels from the old RX CONSULT"
^DIC(9.4,164,22,1,"PAH",107,1,19,0)="file (#54) are used. When they are turned on, warnings from the WARNING"
^DIC(9.4,164,22,1,"PAH",107,1,20,0)="LABEL-ENGLISH (#50.625) or the WARNING LABEL-SPANISH (#50.626) file will"
^DIC(9.4,164,22,1,"PAH",107,1,21,0)="be used. When the parameters are turned on, the ""Do not transfer"" warning"
^DIC(9.4,164,22,1,"PAH",107,1,22,0)="label 20 from the old RX CONSULT file (#54) is automatically added, when"
^DIC(9.4,164,22,1,"PAH",107,1,23,0)="applicable, during label printing, transmitting to CMOP, or sending to"
^DIC(9.4,164,22,1,"PAH",107,1,24,0)="OPAI."
^DIC(9.4,164,22,1,"PAH",107,1,25,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,26,0)="Example warning labels for a drug when the warning source is set to ""New"":"
^DIC(9.4,164,22,1,"PAH",107,1,27,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,28,0)="  Take medication on an empty stomach one hour before or two to the three "
^DIC(9.4,164,22,1,"PAH",107,1,29,0)="  hours after a meal unless otherwise directed by your doctor."
^DIC(9.4,164,22,1,"PAH",107,1,30,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,31,0)="  This drug may impair the ability to drive or operate machinery. Use care"
^DIC(9.4,164,22,1,"PAH",107,1,32,0)="  until you become familiar with its effects."
^DIC(9.4,164,22,1,"PAH",107,1,33,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,34,0)="  CAUTION: Federal law prohibits the transfer of this drug to any person"
^DIC(9.4,164,22,1,"PAH",107,1,35,0)="  other than the patient for whom it was prescribed."
^DIC(9.4,164,22,1,"PAH",107,1,36,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,37,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,38,0)="This patch is required by PSO*7*200 which will send the new warning label "
^DIC(9.4,164,22,1,"PAH",107,1,39,0)="text to OPAI and by PSX*2*54 which will send the new warning label text to"
^DIC(9.4,164,22,1,"PAH",107,1,40,0)="CMOP."
^DIC(9.4,164,22,1,"PAH",107,1,41,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,42,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,43,0)="The following changes are included in this patch:"
^DIC(9.4,164,22,1,"PAH",107,1,44,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,45,0)="Data Dictionary Changes:"
^DIC(9.4,164,22,1,"PAH",107,1,46,0)="======================="
^DIC(9.4,164,22,1,"PAH",107,1,47,0)="New fields:"
^DIC(9.4,164,22,1,"PAH",107,1,48,0)="1. CMOP WARNING LABEL SOURCE field (#16.1) in the PHARMACY SYSTEM file"
^DIC(9.4,164,22,1,"PAH",107,1,49,0)="(#59.7)."
^DIC(9.4,164,22,1,"PAH",107,1,50,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,51,0)="The new warning label processing is not fully functional for CMOP until"
^DIC(9.4,164,22,1,"PAH",107,1,52,0)="this field is set to ""N"" for ""New"" in the Pharmacy System Parameters Edit"
^DIC(9.4,164,22,1,"PAH",107,1,53,0)="[PSS SYS EDIT] option. "
^DIC(9.4,164,22,1,"PAH",107,1,54,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,55,0)="2. OPAI WARNING LABEL SOURCE field (#16.2) in the PHARMACY SYSTEM file"
^DIC(9.4,164,22,1,"PAH",107,1,56,0)="(#59.7)."
^DIC(9.4,164,22,1,"PAH",107,1,57,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,58,0)="The new warning label processing is not fully functional for the "
^DIC(9.4,164,22,1,"PAH",107,1,59,0)="Outpatient Pharmacy Automation Interface (OPAI) until this field is set to"
^DIC(9.4,164,22,1,"PAH",107,1,60,0)="""N"" for ""New"" in the Pharmacy System Parameters Edit [PSS SYS EDIT]"
^DIC(9.4,164,22,1,"PAH",107,1,61,0)="option."
^DIC(9.4,164,22,1,"PAH",107,1,62,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,63,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,64,0)="Routine Changes:"
^DIC(9.4,164,22,1,"PAH",107,1,65,0)="================"
^DIC(9.4,164,22,1,"PAH",107,1,66,0)="Routine PSSYSP was modified to prompt for the above new fields."
^DIC(9.4,164,22,1,"PAH",107,1,67,0)="Example:"
^DIC(9.4,164,22,1,"PAH",107,1,68,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,69,0)="Select OPTION NAME: PSS SYS EDIT       Pharmacy System Parameters Edit"
^DIC(9.4,164,22,1,"PAH",107,1,70,0)="Pharmacy System Parameters Edit"
^DIC(9.4,164,22,1,"PAH",107,1,71,0)=" "
^DIC(9.4,164,22,1,"PAH",107,1,72,0)="PMIS PRINTER: L8150$PRT// "
^DIC(9.4,164,22,1,"PAH",107,1,73,0)="PMIS LANGUAGE: English// "
^DIC(9.4,164,22,1,"PAH",107,1,74,0)="WARNING LABEL SOURCE: NEW// "
^DIC(9.4,164,22,1,"PAH",107,1,75,0)="CMOP WARNING LABEL SOURCE: ?"
^DIC(9.4,164,22,1,"PAH",107,1,76,0)="     Enter ""N"" for NEW to use commercial data source for CMOP warning "
^DIC(9.4,164,22,1,"PAH",107,1,77,0)="labels."
^DIC(9.4,164,22,1,"PAH",107,1,78,0)="     Choose from: "
^DIC(9.4,164,22,1,"PAH",107,1,79,0)="       N        NEW"
^DIC(9.4,164,22,1,"PAH",107,1,80,0)="CMOP WARNING LABEL SOURCE: N  NEW"
^DIC(9.4,164,22,1,"PAH",107,1,81,0)="OPAI WARNING LABEL SOURCE: N  NEW"
^DIC(9.4,164,22,1,"PAH",108,0)="118 SEQ #109^3070629.210718^1"
^DIC(9.4,164,22,1,"PAH",108,1,0)="^^20^20^3070629"
^DIC(9.4,164,22,1,"PAH",108,1,1,0)="This patch adds ORDERABLE ITEM field (#108) from the PHARMACY PATIENT "
^DIC(9.4,164,22,1,"PAH",108,1,2,0)="file (#55), NAME field (#.01) from the PHARMACY ORDERABLE ITEM file "
^DIC(9.4,164,22,1,"PAH",108,1,3,0)="(#50.7), DOSAGE FORM field (#.02) from the PHARMACY ODERABLE ITEM file "
^DIC(9.4,164,22,1,"PAH",108,1,4,0)="(#50.07), and NAME field (#.01) from the DOSAGE FORM file (#50.606) to "
^DIC(9.4,164,22,1,"PAH",108,1,5,0)="the following APIs."
^DIC(9.4,164,22,1,"PAH",108,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",108,1,7,0)="* PSS431^PSS55"
^DIC(9.4,164,22,1,"PAH",108,1,8,0)="* PSS432^PSS55"
^DIC(9.4,164,22,1,"PAH",108,1,9,0)="* PSS433^PSS55"
^DIC(9.4,164,22,1,"PAH",108,1,10,0)="* PSS435^PSS55"
^DIC(9.4,164,22,1,"PAH",108,1,11,0)="* PSS436^PSS55"
^DIC(9.4,164,22,1,"PAH",108,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",108,1,13,0)="Additionally, this patch clears up an issue in DIC^PSSDI, DATA^PSS50, "
^DIC(9.4,164,22,1,"PAH",108,1,14,0)="ALL^PSS51P2, and MIX^PSSDI where in rare circumstances, an error could"
^DIC(9.4,164,22,1,"PAH",108,1,15,0)="occur due to incorrect API initialization."
^DIC(9.4,164,22,1,"PAH",108,1,16,0)=" "
^DIC(9.4,164,22,1,"PAH",108,1,17,0)="Finally, this patch introduces the parameter PSSFREQ to AP^PSS51P1.  "
^DIC(9.4,164,22,1,"PAH",108,1,18,0)="PSSFREQ is compared to the FREQUENCY field (#2) in the ADMINISTRATION "
^DIC(9.4,164,22,1,"PAH",108,1,19,0)="SCHEDULE file (#51.1) to filter records based on the frequency of "
^DIC(9.4,164,22,1,"PAH",108,1,20,0)="delivery."
^DIC(9.4,164,22,1,"PAH",109,0)="121 SEQ #110^3070904.222313^1"
^DIC(9.4,164,22,1,"PAH",109,1,0)="^^1^1^3070904"
^DIC(9.4,164,22,1,"PAH",109,1,1,0)="Fixes the one time PRN orders problem."
^DIC(9.4,164,22,1,"PAH",110,0)="122 SEQ #111^3070904.230912^1"
^DIC(9.4,164,22,1,"PAH",110,1,0)="^^25^25^3070904"
^DIC(9.4,164,22,1,"PAH",110,1,1,0)="This patch contains the second quarter enhancements for the Pharmacy Data "
^DIC(9.4,164,22,1,"PAH",110,1,2,0)="Management V 1.0 package.  The following data dictionary additions are"
^DIC(9.4,164,22,1,"PAH",110,1,3,0)="included for PHARMACY SYSTEM file (#59.7) and supports modifications made "
^DIC(9.4,164,22,1,"PAH",110,1,4,0)="in Outpatient Pharmacy patch PSO*7*200."
^DIC(9.4,164,22,1,"PAH",110,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",110,1,6,0)="1.  SCRIPTALK PRINT DEVICE MAPPING multiple (#47) - adds the capability "
^DIC(9.4,164,22,1,"PAH",110,1,7,0)="to tie a ScripTalk printer to regular Pharmacy label printer(s) to "
^DIC(9.4,164,22,1,"PAH",110,1,8,0)="control where the ScripTalk labels print for multi-divisions.  Multiple "
^DIC(9.4,164,22,1,"PAH",110,1,9,0)="print devices may be mapped to a ScripTalk printer, and any device "
^DIC(9.4,164,22,1,"PAH",110,1,10,0)="defined must have a subtype prefixed with ""P-"".  This prefix in the "
^DIC(9.4,164,22,1,"PAH",110,1,11,0)="subtype indicates that the device is a printer.  If no data is defined in"
^DIC(9.4,164,22,1,"PAH",110,1,12,0)="this multiple, the ScripTalk printer tied to the division will be used.  "
^DIC(9.4,164,22,1,"PAH",110,1,13,0)="The use of this multiple builds upon existing ScripTalk functionality, so"
^DIC(9.4,164,22,1,"PAH",110,1,14,0)="a divisional ScripTalk device must be defined for the mapped device"
^DIC(9.4,164,22,1,"PAH",110,1,15,0)="functionality to work properly and to have a default device defined."
^DIC(9.4,164,22,1,"PAH",110,1,16,0)=" "
^DIC(9.4,164,22,1,"PAH",110,1,17,0)="    a.  LABEL PRINTER TO BE MAPPED field (#.01) -  This field contains "
^DIC(9.4,164,22,1,"PAH",110,1,18,0)="the Pharmacy label printer(s) that the ScripTalk device is mapped.  When "
^DIC(9.4,164,22,1,"PAH",110,1,19,0)="the printer device defined in this field is selected as the Pharmacy "
^DIC(9.4,164,22,1,"PAH",110,1,20,0)="print device by the user, ScripTalk labels will print on the "
^DIC(9.4,164,22,1,"PAH",110,1,21,0)="corresponding mapped ScripTalk device."
^DIC(9.4,164,22,1,"PAH",110,1,22,0)=" "
^DIC(9.4,164,22,1,"PAH",110,1,23,0)="    b.  SCRIPTALK DEVICE field (#.02) - This field contains the ScripTalk "
^DIC(9.4,164,22,1,"PAH",110,1,24,0)="print device that will be tied to regular Pharmacy label device(s) "
^DIC(9.4,164,22,1,"PAH",110,1,25,0)="defined in the ""LABEL PRINTER TO BE MAPPED"" field."
^DIC(9.4,164,22,1,"PAH",111,0)="125 SEQ #112^3070905.011152^1"
^DIC(9.4,164,22,1,"PAH",111,1,0)="^^13^13^3070905"
^DIC(9.4,164,22,1,"PAH",111,1,1,0)="With the deployment of Cache version 5, it was discovered that the short"
^DIC(9.4,164,22,1,"PAH",111,1,2,0)="lock timeout values could generate a lock failure. Patch DI*22*147, which"
^DIC(9.4,164,22,1,"PAH",111,1,3,0)="has already been released, provided a solution to resolve this issue and"
^DIC(9.4,164,22,1,"PAH",111,1,4,0)="future lock issues."
^DIC(9.4,164,22,1,"PAH",111,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",111,1,6,0)="This patch instituted a new default lock timeout of three seconds based on"
^DIC(9.4,164,22,1,"PAH",111,1,7,0)="a global node setting of ^DD(""DILOCKTM"")=3."
^DIC(9.4,164,22,1,"PAH",111,1,8,0)=" "
^DIC(9.4,164,22,1,"PAH",111,1,9,0)="In order to avoid the lock issue in Pharmacy Data Management, this patch"
^DIC(9.4,164,22,1,"PAH",111,1,10,0)="modifies all routines that currently use a lock timeout value of less than"
^DIC(9.4,164,22,1,"PAH",111,1,11,0)="3 seconds to check for the node ^DD(""DILOCKTM"") and to use the value"
^DIC(9.4,164,22,1,"PAH",111,1,12,0)="defined there, otherwise the lock timeout value is set to a default value"
^DIC(9.4,164,22,1,"PAH",111,1,13,0)="of 3 seconds."
^DIC(9.4,164,22,1,"PAH",112,0)="88 SEQ #113^3070905.012127^1"
^DIC(9.4,164,22,1,"PAH",112,1,0)="^^20^20^3070905"
^DIC(9.4,164,22,1,"PAH",112,1,1,0)="1. A site reported a problem with the medication route being blank on the"
^DIC(9.4,164,22,1,"PAH",112,1,2,0)="Bar Code Medication Administration (BCMA) V. 3.0 Virtual Due List. During"
^DIC(9.4,164,22,1,"PAH",112,1,3,0)="investigation of possible corrections for this, it was determined that"
^DIC(9.4,164,22,1,"PAH",112,1,4,0)="another issue needed to be addressed with how to determine when to prompt"
^DIC(9.4,164,22,1,"PAH",112,1,5,0)="for an injection site. This patch assists to correct these problems by"
^DIC(9.4,164,22,1,"PAH",112,1,6,0)="adding the PROMPT FOR INJ. SITE IN BCMA field (#8) to the MEDICATION"
^DIC(9.4,164,22,1,"PAH",112,1,7,0)="ROUTES file (#51.2). In addition, the new field has been added to the"
^DIC(9.4,164,22,1,"PAH",112,1,8,0)="input template PSS MEDICATION ROUTES. HD0000000166204, HD0000000164890,"
^DIC(9.4,164,22,1,"PAH",112,1,9,0)="PSI-06-152, PSI-06-158"
^DIC(9.4,164,22,1,"PAH",112,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",112,1,11,0)="2. During internal testing, it was discovered that there was a problem "
^DIC(9.4,164,22,1,"PAH",112,1,12,0)="with the Application Programming Interface (API) handled by routine "
^DIC(9.4,164,22,1,"PAH",112,1,13,0)="PSS55. This patch corrects this problem."
^DIC(9.4,164,22,1,"PAH",112,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",112,1,15,0)="3. To assist Pharmacy in appropriately setting the new PROMPT FOR INJ. "
^DIC(9.4,164,22,1,"PAH",112,1,16,0)="SITE IN BCMA field (#8), a search routine will execute when this patch is "
^DIC(9.4,164,22,1,"PAH",112,1,17,0)="installed. The purpose of this routine is to look for all Medication "
^DIC(9.4,164,22,1,"PAH",112,1,18,0)="Route abbreviations that contain ID, IV, IM, SC or SQ. A message with the "
^DIC(9.4,164,22,1,"PAH",112,1,19,0)="subject of ""PDM - Check Med Route Abbreviations"" will be sent to the "
^DIC(9.4,164,22,1,"PAH",112,1,20,0)="person who installs the patch."
^DIC(9.4,164,22,1,"PAH",113,0)="127 SEQ #114^3071212.214826^1"
^DIC(9.4,164,22,1,"PAH",113,1,0)="^^85^85^3071212"
^DIC(9.4,164,22,1,"PAH",113,1,1,0)="The general purpose of this patch is to meet the requirements in support"
^DIC(9.4,164,22,1,"PAH",113,1,2,0)="of ePharmacy enhancements. This patch is one of five to be released. Three"
^DIC(9.4,164,22,1,"PAH",113,1,3,0)="patches will be released in the KIDS multi-build distribution BPS PSO IB"
^DIC(9.4,164,22,1,"PAH",113,1,4,0)="BUNDLE 2.0, which contains BPS*1*5, IB*2*363, and PSO*7*260. Patches"
^DIC(9.4,164,22,1,"PAH",113,1,5,0)="PSX*2*63 and PSS*1*127 will be released as stand-alone patches. Since"
^DIC(9.4,164,22,1,"PAH",113,1,6,0)="there is an implementation dependency between the multi-build distribution"
^DIC(9.4,164,22,1,"PAH",113,1,7,0)="and the stand-alone patches, PSX*2*63 and PSS*1*127 must be installed"
^DIC(9.4,164,22,1,"PAH",113,1,8,0)="prior to the installation of the multi-build. For more specific"
^DIC(9.4,164,22,1,"PAH",113,1,9,0)="instructions please refer to the installation steps provided in each of"
^DIC(9.4,164,22,1,"PAH",113,1,10,0)="the patches."
^DIC(9.4,164,22,1,"PAH",113,1,11,0)=" "
^DIC(9.4,164,22,1,"PAH",113,1,12,0)="This patch modifies the Pharmacy Data Management V. 1.0 application as "
^DIC(9.4,164,22,1,"PAH",113,1,13,0)="described below:"
^DIC(9.4,164,22,1,"PAH",113,1,14,0)=" "
^DIC(9.4,164,22,1,"PAH",113,1,15,0)="1. The following fields were added to DRUG file (#50) for determining"
^DIC(9.4,164,22,1,"PAH",113,1,16,0)="   metric quantity for electronic 3rd Party billing:"
^DIC(9.4,164,22,1,"PAH",113,1,17,0)=" "
^DIC(9.4,164,22,1,"PAH",113,1,18,0)="   a.  NCPDP DISPENSE UNIT field (#82) - Allows entry of EA for EACH, GR"
^DIC(9.4,164,22,1,"PAH",113,1,19,0)="       for GRAMS or ML for MILLILITERS."
^DIC(9.4,164,22,1,"PAH",113,1,20,0)=" "
^DIC(9.4,164,22,1,"PAH",113,1,21,0)="   b.  NCPDP QUANTITY MULTIPLIER field (#83) - This field contains the "
^DIC(9.4,164,22,1,"PAH",113,1,22,0)="       number that will be multiplied by the quantity in the prescription"
^DIC(9.4,164,22,1,"PAH",113,1,23,0)="       in order to determine the correct quantity to bill electronic 3rd"
^DIC(9.4,164,22,1,"PAH",113,1,24,0)="       party insurance companies.  Only products with an NCPDP DISPENSE"
^DIC(9.4,164,22,1,"PAH",113,1,25,0)="       UNIT of GM or ML should have a value different than 1 (one) in this"
^DIC(9.4,164,22,1,"PAH",113,1,26,0)="       field. Numbers between 0.001 and 99999.999 are allowed entry "
^DIC(9.4,164,22,1,"PAH",113,1,27,0)="       into this field."
^DIC(9.4,164,22,1,"PAH",113,1,28,0)=" "
^DIC(9.4,164,22,1,"PAH",113,1,29,0)="2. The two fields above will be auto-populated by a post-install routine,"
^DIC(9.4,164,22,1,"PAH",113,1,30,0)="   which will be executed when this patch is installed. Although the "
^DIC(9.4,164,22,1,"PAH",113,1,31,0)="   majority of drugs will be updated with EA (EACH) for the NCPDP DISPENSE "
^DIC(9.4,164,22,1,"PAH",113,1,32,0)="   UNIT and 1 (one) for the NCPDP QUANTITY MULTIPLIER fields, a large "
^DIC(9.4,164,22,1,"PAH",113,1,33,0)="   number of drugs will be updated with GM (GRAMS) or ML (MILILLITERS). "
^DIC(9.4,164,22,1,"PAH",113,1,34,0)="   Furthermore, some drugs will also have a number different for the NCPDP"
^DIC(9.4,164,22,1,"PAH",113,1,35,0)="   QUANTITY MULTIPLIER field. The post-install routine relies on a "
^DIC(9.4,164,22,1,"PAH",113,1,36,0)="   built-in list provided by the National Drug File (NDF) group that "
^DIC(9.4,164,22,1,"PAH",113,1,37,0)="   contains the necessary information for the update being performed. "
^DIC(9.4,164,22,1,"PAH",113,1,38,0)="    "
^DIC(9.4,164,22,1,"PAH",113,1,39,0)="   Once this patch is installed, the user should be able to verify the"
^DIC(9.4,164,22,1,"PAH",113,1,40,0)="   auto-population results by running the following Fileman Print option:"
^DIC(9.4,164,22,1,"PAH",113,1,41,0)=" "
^DIC(9.4,164,22,1,"PAH",113,1,42,0)=" "
^DIC(9.4,164,22,1,"PAH",113,1,43,0)="       OUTPUT FROM WHAT FILE: DRUG// "
^DIC(9.4,164,22,1,"PAH",113,1,44,0)="       SORT BY: GENERIC NAME// NCPDP DISPENSE UNIT  "
^DIC(9.4,164,22,1,"PAH",113,1,45,0)="       START WITH NCPDP DISPENSE UNIT: FIRST// "
^DIC(9.4,164,22,1,"PAH",113,1,46,0)="         WITHIN NCPDP DISPENSE UNIT, SORT BY: GENERIC NAME  "
^DIC(9.4,164,22,1,"PAH",113,1,47,0)="         START WITH GENERIC NAME: FIRST// "
^DIC(9.4,164,22,1,"PAH",113,1,48,0)="           WITHIN GENERIC NAME, SORT BY: "
^DIC(9.4,164,22,1,"PAH",113,1,49,0)="       FIRST PRINT FIELD: GENERIC NAME;@  "
^DIC(9.4,164,22,1,"PAH",113,1,50,0)="       THEN PRINT FIELD: NCPDP DISPENSE UNIT  "
^DIC(9.4,164,22,1,"PAH",113,1,51,0)="       THEN PRINT FIELD: NCPDP QUANTITY MULTIPLIER  "
^DIC(9.4,164,22,1,"PAH",113,1,52,0)="       THEN PRINT FIELD: "
^DIC(9.4,164,22,1,"PAH",113,1,53,0)="       Heading (S/C): DRUG LIST// "
^DIC(9.4,164,22,1,"PAH",113,1,54,0)="       DEVICE: ;;999  UCX/TELNET    Right Margin: 80// "
^DIC(9.4,164,22,1,"PAH",113,1,55,0)="  "
^DIC(9.4,164,22,1,"PAH",113,1,56,0)=" "
^DIC(9.4,164,22,1,"PAH",113,1,57,0)="3. For the DRUG ENTER/EDIT [PSS DRUG ENTER/EDIT] option, the PSSCOMMON "
^DIC(9.4,164,22,1,"PAH",113,1,58,0)="   input template for DRUG file (#50) was modified to allow entry/edit of"
^DIC(9.4,164,22,1,"PAH",113,1,59,0)="   the NCPDP DISPENSE UNIT field (#82) and the NCPDP QUANTITY MULTIPLIER "
^DIC(9.4,164,22,1,"PAH",113,1,60,0)="   field (#83). The following give additional information on definition "
^DIC(9.4,164,22,1,"PAH",113,1,61,0)="   and validation of these fields:"
^DIC(9.4,164,22,1,"PAH",113,1,62,0)=" "
^DIC(9.4,164,22,1,"PAH",113,1,63,0)="   a.  When new drugs are defined, the values of EA for EACH and 1 (one)"
^DIC(9.4,164,22,1,"PAH",113,1,64,0)="       will be the default values for these new fields."
^DIC(9.4,164,22,1,"PAH",113,1,65,0)=" "
^DIC(9.4,164,22,1,"PAH",113,1,66,0)="   b.  When the NCPDP DISPENSE UNIT is changed from one value to another, "
^DIC(9.4,164,22,1,"PAH",113,1,67,0)="       the NCPDP QUANTITY MULTIPLIER will be defaulted to 1 (one) and a "
^DIC(9.4,164,22,1,"PAH",113,1,68,0)="       message stating such will be displayed.  If the NCPDP QUANTITY"
^DIC(9.4,164,22,1,"PAH",113,1,69,0)="       MULTIPLIER field already contains 1 (one), no change will be made"
^DIC(9.4,164,22,1,"PAH",113,1,70,0)="       nor will a message be displayed."
^DIC(9.4,164,22,1,"PAH",113,1,71,0)=" "
^DIC(9.4,164,22,1,"PAH",113,1,72,0)="   c.  When a valid value greater than or less than 1 (one) is entered for"
^DIC(9.4,164,22,1,"PAH",113,1,73,0)="       the NCPDP QUANTITY MULTIPLIER, a warning message will be displayed"
^DIC(9.4,164,22,1,"PAH",113,1,74,0)="       stating that typically a value of 1 (one) should be defined for"
^DIC(9.4,164,22,1,"PAH",113,1,75,0)="       this field.  Then the user will be prompted to continue processing"
^DIC(9.4,164,22,1,"PAH",113,1,76,0)="       thereby accepting the new value or to edit and view extended help"
^DIC(9.4,164,22,1,"PAH",113,1,77,0)="       text for the type of NCPDP DISPENSE UNIT selected. If the user"
^DIC(9.4,164,22,1,"PAH",113,1,78,0)="       elects to ^ (shift six) to exit the ""Ok to continue (Y/N)"" prompt,"
^DIC(9.4,164,22,1,"PAH",113,1,79,0)="       the system will default the NCPCP QUANTITY MULTIPLIER to 1 (one)"
^DIC(9.4,164,22,1,"PAH",113,1,80,0)="       and give a warning message stating such."
^DIC(9.4,164,22,1,"PAH",113,1,81,0)=" "
^DIC(9.4,164,22,1,"PAH",113,1,82,0)=" "
^DIC(9.4,164,22,1,"PAH",113,1,83,0)="4. The LOOKUP INTO DISPENSE DRUG FILE [PSS LOOK] option was modified to "
^DIC(9.4,164,22,1,"PAH",113,1,84,0)="   list the new NCPDP DISPENSE UNIT and NCPDP QUANTITY MULTIPLIER fields"
^DIC(9.4,164,22,1,"PAH",113,1,85,0)="   after the PRICE/DISPENSE UNIT field."
^DIC(9.4,164,22,1,"PAH",114,0)="109 SEQ #115^3071212.221845^1"
^DIC(9.4,164,22,1,"PAH",114,1,0)="^^11^11^3071212"
^DIC(9.4,164,22,1,"PAH",114,1,1,0)="During testing of the Bar Code Medication Administration (BCMA) project "
^DIC(9.4,164,22,1,"PAH",114,1,2,0)="BCMA-HSC Phase III, an issue was discovered with the order flag comments "
^DIC(9.4,164,22,1,"PAH",114,1,3,0)="for unit dose orders. There is not enough space to store the entire "
^DIC(9.4,164,22,1,"PAH",114,1,4,0)="comment, so the text is truncated. This patch corrects this problem for "
^DIC(9.4,164,22,1,"PAH",114,1,5,0)="BCMA by storing the most recent text in an additional location. The "
^DIC(9.4,164,22,1,"PAH",114,1,6,0)="comment will still be stored in the current location. It will also be in "
^DIC(9.4,164,22,1,"PAH",114,1,7,0)="the MOST RECEMT FLAG COMMENT field (#129) of the NON-VERIFIED/PENDING file"
^DIC(9.4,164,22,1,"PAH",114,1,8,0)="(#53.1) which is exported in an Inpatient Medications V5.0 patch. For"
^DIC(9.4,164,22,1,"PAH",114,1,9,0)="active unit dose orders, it will be stored in the MOST RECENT FLAG COMMENT"
^DIC(9.4,164,22,1,"PAH",114,1,10,0)="field (#128) of the UNIT DOSE sub-file (#55.06) of the PHARMACY PATIENT"
^DIC(9.4,164,22,1,"PAH",114,1,11,0)="file (#55) which is exported in this patch."
^DIC(9.4,164,22,1,"PAH",115,0)="124 SEQ #116^3080203.213413^1"
^DIC(9.4,164,22,1,"PAH",115,1,0)="^^6^6^3080203"
^DIC(9.4,164,22,1,"PAH",115,1,1,0)="This patch will correct the issues reported in:"
^DIC(9.4,164,22,1,"PAH",115,1,2,0)="  "
^DIC(9.4,164,22,1,"PAH",115,1,3,0)="1) HD68616  - PSSMARK   DRUG INACTIVE DATE IN FUTURE BLOCKS CMOP MARK"
^DIC(9.4,164,22,1,"PAH",115,1,4,0)="TODAY"
^DIC(9.4,164,22,1,"PAH",115,1,5,0)="2) HD70218  - PSSHLU    Drug file edits change value in orderable item"
^DIC(9.4,164,22,1,"PAH",115,1,6,0)="file"
^DIC(9.4,164,22,1,"PAH",116,0)="126 SEQ #117^3080526.150616^1"
^DIC(9.4,164,22,1,"PAH",116,1,0)="^^2^2^3080526"
^DIC(9.4,164,22,1,"PAH",116,1,1,0)="This patch will update the heptext for the DEA field in the DRUG file. As "
^DIC(9.4,164,22,1,"PAH",116,1,2,0)="well as send a mailman message concerning the changing DEA codes."
^DIC(9.4,164,22,1,"PAH",117,0)="132 SEQ #118^3080526.154719^1"
^DIC(9.4,164,22,1,"PAH",117,1,0)="^^3^3^3080526"
^DIC(9.4,164,22,1,"PAH",117,1,1,0)="This patch will correct the issues reported in:"
^DIC(9.4,164,22,1,"PAH",117,1,2,0)="  "
^DIC(9.4,164,22,1,"PAH",117,1,3,0)="HD229420 - PSSHLU    Orderable item is active but not appearing in CPRS"
^DIC(9.4,164,22,1,"PAH",118,0)="128 SEQ #119^3080526.15525^1"
^DIC(9.4,164,22,1,"PAH",118,1,0)="^^24^24^3080526"
^DIC(9.4,164,22,1,"PAH",118,1,1,0)="The following data dictionary addition is included for PHARMACY SYSTEM"
^DIC(9.4,164,22,1,"PAH",118,1,2,0)="file (#59.7) and supports modifications made in Outpatient Pharmacy patch"
^DIC(9.4,164,22,1,"PAH",118,1,3,0)="PSO*7*257."
^DIC(9.4,164,22,1,"PAH",118,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",118,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",118,1,6,0)="Field Description:"
^DIC(9.4,164,22,1,"PAH",118,1,7,0)="=================="
^DIC(9.4,164,22,1,"PAH",118,1,8,0)=" "
^DIC(9.4,164,22,1,"PAH",118,1,9,0)="59.7,49.95  DATE AUTO-EXPIRE COMPLETED 49.99;8 DATE"
^DIC(9.4,164,22,1,"PAH",118,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",118,1,11,0)="            Last Date Auto-Expire Processed"
^DIC(9.4,164,22,1,"PAH",118,1,12,0)="            INPUT TRANSFORM:  S %DT=""E"" D ^%DT S X=Y K:X<1 X"
^DIC(9.4,164,22,1,"PAH",118,1,13,0)="            LAST EDITED:      MAY 18, 2007"
^DIC(9.4,164,22,1,"PAH",118,1,14,0)="            HELP-PROMPT:      Last Date Auto-Expire Processed"
^DIC(9.4,164,22,1,"PAH",118,1,15,0)="            DESCRIPTION:      This is the last date that the nightly"
^DIC(9.4,164,22,1,"PAH",118,1,16,0)="                              auto-expire processed. Processing will "
^DIC(9.4,164,22,1,"PAH",118,1,17,0)="                              continue from this date the next time the"
^DIC(9.4,164,22,1,"PAH",118,1,18,0)="                              job runs."
^DIC(9.4,164,22,1,"PAH",118,1,19,0)=" "
^DIC(9.4,164,22,1,"PAH",118,1,20,0)="            TECHNICAL DESCR:  This is the last date that the nightly"
^DIC(9.4,164,22,1,"PAH",118,1,21,0)="                              auto-expire processed. Processing will "
^DIC(9.4,164,22,1,"PAH",118,1,22,0)="                              continue from this date the next time the"
^DIC(9.4,164,22,1,"PAH",118,1,23,0)="                              job runs and will expire prescriptions with"
^DIC(9.4,164,22,1,"PAH",118,1,24,0)="                              expiration dates up to and including DT-1."
^DIC(9.4,164,22,1,"PAH",119,0)="130 SEQ #120^3080722.073649^1"
^DIC(9.4,164,22,1,"PAH",119,1,0)="^^14^14^3080722"
^DIC(9.4,164,22,1,"PAH",119,1,1,0)="This patch will correct the issues reported in:"
^DIC(9.4,164,22,1,"PAH",119,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",119,1,3,0)="1) HD0000000194979 - Orderable Item dialog box issue"
^DIC(9.4,164,22,1,"PAH",119,1,4,0)="  Modify the INPUT TRANSFORM for the PHARMACY ORDERABLE ITEM file "
^DIC(9.4,164,22,1,"PAH",119,1,5,0)="  (#50.7) SYNONYM subfile (#50.72) SYNONYM field #2 to use "
^DIC(9.4,164,22,1,"PAH",119,1,6,0)="  S X=$$TRIM^XLFSTR(X,""R"","" "") to strip trailing spaces. "
^DIC(9.4,164,22,1,"PAH",119,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",119,1,8,0)="2) HD0000000177768 - Lookup by VA Class brings up incorrect meds"
^DIC(9.4,164,22,1,"PAH",119,1,9,0)="  Create PSSP130 routine to step through the DRUG file (#50) VA DRUG"
^DIC(9.4,164,22,1,"PAH",119,1,10,0)="  CLASS field (#25) index (^PSDRUG(""VAC"") and identify drugs with"
^DIC(9.4,164,22,1,"PAH",119,1,11,0)="  multiple VAC indexs.  If a drug has multiple indexs, re-index the"
^DIC(9.4,164,22,1,"PAH",119,1,12,0)="  VAC index.  After the ^DRUG(""VAC"" has been re-indexed, send a MailMan "
^DIC(9.4,164,22,1,"PAH",119,1,13,0)="  message with the names, old VA DRUG CLASS indexs and the new VA"
^DIC(9.4,164,22,1,"PAH",119,1,14,0)="  DRUG CLASS index."
^DIC(9.4,164,22,1,"PAH",120,0)="134 SEQ #121^3090420.160804^1"
^DIC(9.4,164,22,1,"PAH",120,1,0)="^^9^9^3090420"
^DIC(9.4,164,22,1,"PAH",120,1,1,0)="This patch will create a post install routine that will loop "
^DIC(9.4,164,22,1,"PAH",120,1,2,0)="through the Drug file (#50) and get all the Local Possible Doses"
^DIC(9.4,164,22,1,"PAH",120,1,3,0)="for each drug and call the API to reformat it.  A report will "
^DIC(9.4,164,22,1,"PAH",120,1,4,0)="then be generated that will display the drug ien, drug name, "
^DIC(9.4,164,22,1,"PAH",120,1,5,0)="original Local Possible Dose and the reformatted Local Possible "
^DIC(9.4,164,22,1,"PAH",120,1,6,0)="Dose.  The report will be sent to the holders of the PSNMGR key"
^DIC(9.4,164,22,1,"PAH",120,1,7,0)="and Venessa France, developer of the patch."
^DIC(9.4,164,22,1,"PAH",120,1,8,0)="                                    ."
^DIC(9.4,164,22,1,"PAH",120,1,9,0)=" Venessa France, developer of the patch."
^DIC(9.4,164,22,1,"PAH",121,0)="94 SEQ #122^3090421.154726^17"
^DIC(9.4,164,22,1,"PAH",121,1,0)="^^66^66^3090421"
^DIC(9.4,164,22,1,"PAH",121,1,1,0)="1. In support of the project Inpatient Medications Requirements for "
^DIC(9.4,164,22,1,"PAH",121,1,2,0)="the Special Focus Group Initial Request Analysis (IMR) Phase III, "
^DIC(9.4,164,22,1,"PAH",121,1,3,0)="two changes have been made in the input template PSSJ SCHEDULE EDIT. "
^DIC(9.4,164,22,1,"PAH",121,1,4,0)="First, if the schedule type is continuous and it is an odd schedule, "
^DIC(9.4,164,22,1,"PAH",121,1,5,0)="the system will no longer allow the entry of administration times. "
^DIC(9.4,164,22,1,"PAH",121,1,6,0)="Continuous, non-odd schedules will still require administration times."
^DIC(9.4,164,22,1,"PAH",121,1,7,0)=" "
^DIC(9.4,164,22,1,"PAH",121,1,8,0)="2. The second IMR change for the input template is if the schedule type"
^DIC(9.4,164,22,1,"PAH",121,1,9,0)="is on-call, the system will no longer require a frequency."
^DIC(9.4,164,22,1,"PAH",121,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",121,1,11,0)="3. In support of the Computerized Patient Record System (CPRS) GUI v27 "
^DIC(9.4,164,22,1,"PAH",121,1,12,0)="release, the validation of schedules from the GUI has been modified. "
^DIC(9.4,164,22,1,"PAH",121,1,13,0)="The change was to allow day-of-week schedules to be entered in the "
^DIC(9.4,164,22,1,"PAH",121,1,14,0)="format: day@schedule. Schedule, in this case, is an already defined "
^DIC(9.4,164,22,1,"PAH",121,1,15,0)="schedule such as BID. So, now a day-of-week schedule may be entered as"
^DIC(9.4,164,22,1,"PAH",121,1,16,0)="MO-WE-FR@BID to signify you want to use the BID administration times "
^DIC(9.4,164,22,1,"PAH",121,1,17,0)="on Monday, Wednesday and Friday."
^DIC(9.4,164,22,1,"PAH",121,1,18,0)=" "
^DIC(9.4,164,22,1,"PAH",121,1,19,0)="4. In support of CPRS GUI v27, a modification has been made to the "
^DIC(9.4,164,22,1,"PAH",121,1,20,0)="list of available Medication Routes sent back to CPRS from Inpatient"
^DIC(9.4,164,22,1,"PAH",121,1,21,0)="Pharmacy when using the IV Dialog.  If there is one orderable item"
^DIC(9.4,164,22,1,"PAH",121,1,22,0)="in the order, Inpatient Pharmacy will return any default med route"
^DIC(9.4,164,22,1,"PAH",121,1,23,0)="that may be defined in the Pharmacy Orderable Item File #50.7 along"
^DIC(9.4,164,22,1,"PAH",121,1,24,0)="with any other med routes defined for the dosage form #50.606.  "
^DIC(9.4,164,22,1,"PAH",121,1,25,0)="Duplicate entries will be removed.  If there is more than one orderable "
^DIC(9.4,164,22,1,"PAH",121,1,26,0)="item in the order, Inpatient Pharmacy will return a list of the common"
^DIC(9.4,164,22,1,"PAH",121,1,27,0)="med routes that match all orderable items."
^DIC(9.4,164,22,1,"PAH",121,1,28,0)=" "
^DIC(9.4,164,22,1,"PAH",121,1,29,0)="5. In support of CPRS GUI v27, remedy ticket, HD0000000220080 - ""^ in "
^DIC(9.4,164,22,1,"PAH",121,1,30,0)="the Schedule field"" was addressed."
^DIC(9.4,164,22,1,"PAH",121,1,31,0)="  "
^DIC(9.4,164,22,1,"PAH",121,1,32,0)="Problem:"
^DIC(9.4,164,22,1,"PAH",121,1,33,0)="--------"
^DIC(9.4,164,22,1,"PAH",121,1,34,0)="Users are allowed to include an ""^"" in the schedule when placing an "
^DIC(9.4,164,22,1,"PAH",121,1,35,0)="order in CPRS GUI."
^DIC(9.4,164,22,1,"PAH",121,1,36,0)="  "
^DIC(9.4,164,22,1,"PAH",121,1,37,0)="Resolution:"
^DIC(9.4,164,22,1,"PAH",121,1,38,0)="-----------"
^DIC(9.4,164,22,1,"PAH",121,1,39,0)="Routine PSSGSGUI will be modified to disallow an ""^"" in the text of a"
^DIC(9.4,164,22,1,"PAH",121,1,40,0)="schedule."
^DIC(9.4,164,22,1,"PAH",121,1,41,0)=" "
^DIC(9.4,164,22,1,"PAH",121,1,42,0)="6. The routine PSS0088 is being deleted with this patch.  The routine"
^DIC(9.4,164,22,1,"PAH",121,1,43,0)="was part of patch PSS*1.0*88, and was used simply as a tally routine"
^DIC(9.4,164,22,1,"PAH",121,1,44,0)="to identify medication routes that needed to be reviewed when the"
^DIC(9.4,164,22,1,"PAH",121,1,45,0)="functionality of PSS*1.0*88 was installed.  The tally routine's"
^DIC(9.4,164,22,1,"PAH",121,1,46,0)="functionality is no longer necessary, so the routine will be deleted."
^DIC(9.4,164,22,1,"PAH",121,1,47,0)=" "
^DIC(9.4,164,22,1,"PAH",121,1,48,0)="7. In support of CPRS GUI v27, the array of schedules from the "
^DIC(9.4,164,22,1,"PAH",121,1,49,0)="ADMINISTRATION SCHEDULE file #51.1 that is returned to CPRS for schedule"
^DIC(9.4,164,22,1,"PAH",121,1,50,0)="selection on an order is being modified.  Currently, a site can have"
^DIC(9.4,164,22,1,"PAH",121,1,51,0)="multiple schedules with the same name for the same package.  The array"
^DIC(9.4,164,22,1,"PAH",121,1,52,0)="of schedules presented for selection in CPRS GUI v26 only takes the"
^DIC(9.4,164,22,1,"PAH",121,1,53,0)="schedule with the lowest IEN number in the ADMINISTRATION SCHEDULE file"
^DIC(9.4,164,22,1,"PAH",121,1,54,0)="#51.1 if a duplicate exists."
^DIC(9.4,164,22,1,"PAH",121,1,55,0)=" "
^DIC(9.4,164,22,1,"PAH",121,1,56,0)="With the changes in CPRS GUI v27, if there is a duplicate schedule,"
^DIC(9.4,164,22,1,"PAH",121,1,57,0)="and if one of them contains ward-specific admin times for the ward"
^DIC(9.4,164,22,1,"PAH",121,1,58,0)="location of the patient, the schedule returned for inclusion in the"
^DIC(9.4,164,22,1,"PAH",121,1,59,0)="array of selectable schedules in CPRS will be the one with the ward-"
^DIC(9.4,164,22,1,"PAH",121,1,60,0)="specific admin times.  If no duplicate has ward-specific admin times"
^DIC(9.4,164,22,1,"PAH",121,1,61,0)="for the ward location of the patient, the schedule with the lowest"
^DIC(9.4,164,22,1,"PAH",121,1,62,0)="IEN number will be returned.  If both (or more than one)"
^DIC(9.4,164,22,1,"PAH",121,1,63,0)="duplicate schedules have ward-specific admin times for the ward"
^DIC(9.4,164,22,1,"PAH",121,1,64,0)="location of the patient, the schedule with the lowest IEN number in the"
^DIC(9.4,164,22,1,"PAH",121,1,65,0)="ADMINISTRATION SCHEDULE file #51.1 will be the schedule in the array"
^DIC(9.4,164,22,1,"PAH",121,1,66,0)="returned to CPRS."
^DIC(9.4,164,22,1,"PAH",122,0)="123 SEQ #123^3090421.155223^17"
^DIC(9.4,164,22,1,"PAH",123,0)="138 SEQ #124^3090422.120422^17"
^DIC(9.4,164,22,1,"PAH",123,1,0)="^^9^9^3090422"
^DIC(9.4,164,22,1,"PAH",123,1,1,0)="This patch will address the issues in Remedy tickets:"
^DIC(9.4,164,22,1,"PAH",123,1,2,0)=" "
^DIC(9.4,164,22,1,"PAH",123,1,3,0)="1)HD0000000206450 - & in the NOUN field of the Dosage Form file"
^DIC(9.4,164,22,1,"PAH",123,1,4,0)="  When the NOUN in the DOSAGE FORM contains a ""&"", it causes"
^DIC(9.4,164,22,1,"PAH",123,1,5,0)="  CPRS to error when ordering medications."
^DIC(9.4,164,22,1,"PAH",123,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",123,1,7,0)="2)HD0000000249646 - 6 VA CLASSIFICATION Field"
^DIC(9.4,164,22,1,"PAH",123,1,8,0)="  The VA CLASSIFICATION field (#2) of the DRUG file (#50) allows user to "
^DIC(9.4,164,22,1,"PAH",123,1,9,0)="  delete the data in this field which is matched to National Drug File."
^DIC(9.4,164,22,1,"PAH",124,0)="133 SEQ #125^3090422.122135^17"
^DIC(9.4,164,22,1,"PAH",124,1,0)="^^8^8^3090422"
^DIC(9.4,164,22,1,"PAH",124,1,1,0)="This patch contains a set of APIs to be used by Clinical Reminders. "
^DIC(9.4,164,22,1,"PAH",124,1,2,0)="The calls are all to routine PSSCLINR. The APIs are:"
^DIC(9.4,164,22,1,"PAH",124,1,3,0)=" "
^DIC(9.4,164,22,1,"PAH",124,1,4,0)="IX(PSSCRIX,PSSCRIV) Returns AND or VAC index of File 50"
^DIC(9.4,164,22,1,"PAH",124,1,5,0)="DRUG(PSSCLID) Returns the Drug name from file 50 "
^DIC(9.4,164,22,1,"PAH",124,1,6,0)="ITEM(PSSCLII) Returns the Pharmacy Orderable Item pointer from file 50."
^DIC(9.4,164,22,1,"PAH",124,1,7,0)="ING(PSSING)   Return Drug Ingredient IEN from file 50.416 "
^DIC(9.4,164,22,1,"PAH",124,1,8,0)="NEPS() Return Number of entries in file 55 "
^DIC(9.4,164,22,1,"PAH",125,0)="139 SEQ #126^3090422.155236^17"
^DIC(9.4,164,22,1,"PAH",125,1,0)="^^26^26^3090422"
^DIC(9.4,164,22,1,"PAH",125,1,1,0)="This patch has enhancements which extend the capabilities of the Veterans "
^DIC(9.4,164,22,1,"PAH",125,1,2,0)="Health Information Systems and Technology Architecture (VistA) electronic "
^DIC(9.4,164,22,1,"PAH",125,1,3,0)="pharmacy (ePharmacy) billing system."
^DIC(9.4,164,22,1,"PAH",125,1,4,0)=" "
^DIC(9.4,164,22,1,"PAH",125,1,5,0)="All sites should install this patches regardless of whether or not they "
^DIC(9.4,164,22,1,"PAH",125,1,6,0)="have been activated for ePharmacy by the Central Business Office (CBO).  "
^DIC(9.4,164,22,1,"PAH",125,1,7,0)="After the installation of these patches, the activation status of the "
^DIC(9.4,164,22,1,"PAH",125,1,8,0)="site will not be impacted.  As before, activation of the ePharmacy "
^DIC(9.4,164,22,1,"PAH",125,1,9,0)="product will require instructions provided by the CBO.  Sites are not to "
^DIC(9.4,164,22,1,"PAH",125,1,10,0)="activate unless instructed specifically by the CBO."
^DIC(9.4,164,22,1,"PAH",125,1,11,0)=" "
^DIC(9.4,164,22,1,"PAH",125,1,12,0)="This patch is being released along with PSO*7*303 and IB*2*405.  These "
^DIC(9.4,164,22,1,"PAH",125,1,13,0)="patches can be installed in any order but the full functionality contained"
^DIC(9.4,164,22,1,"PAH",125,1,14,0)="within these patches will not be available until all 3 patches are"
^DIC(9.4,164,22,1,"PAH",125,1,15,0)="installed."
^DIC(9.4,164,22,1,"PAH",125,1,16,0)=" "
^DIC(9.4,164,22,1,"PAH",125,1,17,0)="This patch modifies the Pharmacy Data Management v1.0 application as "
^DIC(9.4,164,22,1,"PAH",125,1,18,0)="described below:"
^DIC(9.4,164,22,1,"PAH",125,1,19,0)=" "
^DIC(9.4,164,22,1,"PAH",125,1,20,0)="1. A new Drug Enforcement Administration (DEA) Special Handling code, N"
^DIC(9.4,164,22,1,"PAH",125,1,21,0)="for Nutritional Supplement, was added as a selection to the DEA SPECIAL"
^DIC(9.4,164,22,1,"PAH",125,1,22,0)="HDLG prompt for DRUG ENTER/EDIT [PSS DRUG ENTER/EDIT] option.  Once "
^DIC(9.4,164,22,1,"PAH",125,1,23,0)="Outpatient Pharmacy patch PSO*7*303 and Integrated Billing patch IB*2*405"
^DIC(9.4,164,22,1,"PAH",125,1,24,0)="is installed, any drug defined with this new code will be treated in the"
^DIC(9.4,164,22,1,"PAH",125,1,25,0)="same manner as supply items and investigational drugs.  The N DEA Special "
^DIC(9.4,164,22,1,"PAH",125,1,26,0)="Handling code must be defined manually."
^DIC(9.4,164,22,1,"PAH",126,0)="129 SEQ #127^3090423.105033^17"
^DIC(9.4,164,22,1,"PAH",126,1,0)="^^7^7^3090423"
^DIC(9.4,164,22,1,"PAH",126,1,1,0)="This patch provides the functionality needed to prepare for the release of"
^DIC(9.4,164,22,1,"PAH",126,1,2,0)="Pharmacy Re-Engineering V. 0.5, which will change the current Pharmacy"
^DIC(9.4,164,22,1,"PAH",126,1,3,0)="Order Checking system from using the data stored in Vista to using data"
^DIC(9.4,164,22,1,"PAH",126,1,4,0)="from the First DataBank commercial database system. There is set-up work "
^DIC(9.4,164,22,1,"PAH",126,1,5,0)="that is requred to be completed prior to the installation of Pharmacy "
^DIC(9.4,164,22,1,"PAH",126,1,6,0)="Re-Engneering V. 0.5, and this patch provides the tools needed to complete"
^DIC(9.4,164,22,1,"PAH",126,1,7,0)="that set-up work."
^DIC(9.4,164,22,1,"PAH",127,0)="137 SEQ #128^3090603.113643^17"
^DIC(9.4,164,22,1,"PAH",128,0)="131 SEQ #129^3090714.09095^17"
^DIC(9.4,164,22,1,"PAH",128,1,0)="^^39^39^3090714"
^DIC(9.4,164,22,1,"PAH",128,1,1,0)="This patch has enhancements which extend the capabilities of the Veterans "
^DIC(9.4,164,22,1,"PAH",128,1,2,0)="Health Information Systems and Technology Architecture (VistA) electronic "
^DIC(9.4,164,22,1,"PAH",128,1,3,0)="pharmacy (ePharmacy) billing system.  Below is a list of all the "
^DIC(9.4,164,22,1,"PAH",128,1,4,0)="applications involved in this project along with their patch number:"
^DIC(9.4,164,22,1,"PAH",128,1,5,0)=" "
^DIC(9.4,164,22,1,"PAH",128,1,6,0)="   APPLICATION/VERSION                                  PATCH"
^DIC(9.4,164,22,1,"PAH",128,1,7,0)="   --------------------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",128,1,8,0)="   CONSOLIDATED MAIL OUTPATIENT PHARMACY (CMOP) V. 2.0  PSX*2*65"
^DIC(9.4,164,22,1,"PAH",128,1,9,0)="   PHARMACY DATA MANAGEMENT (PDM) V. 1.0                PSS*1*131"
^DIC(9.4,164,22,1,"PAH",128,1,10,0)="   OUTPATIENT PHARMACY (OP) V. 7.0                      PSO*7*289"
^DIC(9.4,164,22,1,"PAH",128,1,11,0)="   INTEGRATED BILLING (IB) V. 2.0                       IB*2*384"
^DIC(9.4,164,22,1,"PAH",128,1,12,0)="   ELECTRONIC CLAIMS MANAGEMENT ENGINE (ECME) V. 1.0    BPS*1*7"
^DIC(9.4,164,22,1,"PAH",128,1,13,0)=" "
^DIC(9.4,164,22,1,"PAH",128,1,14,0)="The last three patches (PSO*7*289, IB*2*384 and BPS*1*7) will be released "
^DIC(9.4,164,22,1,"PAH",128,1,15,0)="in the Kernel Installation and Distribution System (KIDS) multi-build "
^DIC(9.4,164,22,1,"PAH",128,1,16,0)="distribution BPS PSO IB BUNDLE 3.0.  Patches PSX*2*65 and PSS*1*131 will "
^DIC(9.4,164,22,1,"PAH",128,1,17,0)="be released as stand-alone patches.  Since there is an implementation "
^DIC(9.4,164,22,1,"PAH",128,1,18,0)="dependency between the multi-build distribution and the stand-alone "
^DIC(9.4,164,22,1,"PAH",128,1,19,0)="patches, PSX*2*65 and PSS*1*131 must be installed prior to the "
^DIC(9.4,164,22,1,"PAH",128,1,20,0)="installation of the multi-build.  For more specific instructions please "
^DIC(9.4,164,22,1,"PAH",128,1,21,0)="refer to the installation steps provided in each of the patches."
^DIC(9.4,164,22,1,"PAH",128,1,22,0)=" "
^DIC(9.4,164,22,1,"PAH",128,1,23,0)="All sites should install these patches regardless of whether or not they "
^DIC(9.4,164,22,1,"PAH",128,1,24,0)="have been activated for ePharmacy by the Central Business Office (CBO).  "
^DIC(9.4,164,22,1,"PAH",128,1,25,0)="After the installation of these patches, the activation status of the "
^DIC(9.4,164,22,1,"PAH",128,1,26,0)="site will not be impacted.  As before, activation of the ePharmacy "
^DIC(9.4,164,22,1,"PAH",128,1,27,0)="product will require instructions provided by the CBO.  Sites are not to "
^DIC(9.4,164,22,1,"PAH",128,1,28,0)="activate unless instructed specifically by the CBO."
^DIC(9.4,164,22,1,"PAH",128,1,29,0)=" "
^DIC(9.4,164,22,1,"PAH",128,1,30,0)="This patch modifies the Pharmacy Data Management v1.0 application as "
^DIC(9.4,164,22,1,"PAH",128,1,31,0)="described below:"
^DIC(9.4,164,22,1,"PAH",128,1,32,0)=" "
^DIC(9.4,164,22,1,"PAH",128,1,33,0)="1. A new Drug Enforcement Administration (DEA) Special Handling code, U"
^DIC(9.4,164,22,1,"PAH",128,1,34,0)="for Sensitive Diagnosis, was added as a selection to the DEA SPECIAL HDLG"
^DIC(9.4,164,22,1,"PAH",128,1,35,0)="prompt for DRUG ENTER/EDIT [PSS DRUG ENTER/EDIT] option. When a signed"
^DIC(9.4,164,22,1,"PAH",128,1,36,0)="Release of Information (ROI) is on file and the drug is marked with this"
^DIC(9.4,164,22,1,"PAH",128,1,37,0)="new code, the drug may be third party billable.  Drugs must be manually"
^DIC(9.4,164,22,1,"PAH",128,1,38,0)="marked with this new code, and this functionality works in conjunction"
^DIC(9.4,164,22,1,"PAH",128,1,39,0)="with ROI modifications made in IB*2*384."
^DIC(9.4,164,22,1,"PAH",129,0)="99 SEQ #130^3090714.152144^17"
^DIC(9.4,164,22,1,"PAH",129,1,0)="^^28^28^3090714"
^DIC(9.4,164,22,1,"PAH",129,1,1,0)=""
^DIC(9.4,164,22,1,"PAH",129,1,2,0)="This patch addresses a request which support the Pharmacy "
^DIC(9.4,164,22,1,"PAH",129,1,3,0)="Benefits Management (PBM) Extracts Enhancement #3 "
^DIC(9.4,164,22,1,"PAH",129,1,4,0)="project. In order to allow the retransmission of only those "
^DIC(9.4,164,22,1,"PAH",129,1,5,0)="patients who have had demographic updates, Pharmacy "
^DIC(9.4,164,22,1,"PAH",129,1,6,0)="Data Management V. 1.0 was modified to build an entry "
^DIC(9.4,164,22,1,"PAH",129,1,7,0)="for re-transmission in PBM PATIENT DEMOGRAPHICS "
^DIC(9.4,164,22,1,"PAH",129,1,8,0)="file (#59.9) whenever the FIRST SERVICE DATE field (#.07) "
^DIC(9.4,164,22,1,"PAH",129,1,9,0)="in the PHARMACY PATIENT file (#55) is updated."
^DIC(9.4,164,22,1,"PAH",129,1,10,0)=""
^DIC(9.4,164,22,1,"PAH",129,1,11,0)="This patch adds a MUMPS style cross-reference to the FIRST "
^DIC(9.4,164,22,1,"PAH",129,1,12,0)="SERVICE DATE field (#.07) in the PHARMACY PATIENT file (#55). "
^DIC(9.4,164,22,1,"PAH",129,1,13,0)="When the FIRST SERVICE DATE field (#.07) is updated for a "
^DIC(9.4,164,22,1,"PAH",129,1,14,0)="patient then the cross-reference is triggered and the patient "
^DIC(9.4,164,22,1,"PAH",129,1,15,0)="is queued for transmission."
^DIC(9.4,164,22,1,"PAH",129,1,16,0)=""
^DIC(9.4,164,22,1,"PAH",129,1,17,0)="The following applications were also updated as part of the "
^DIC(9.4,164,22,1,"PAH",129,1,18,0)="PBM Extracts Enhancement #3 project:"
^DIC(9.4,164,22,1,"PAH",129,1,19,0)=" "
^DIC(9.4,164,22,1,"PAH",129,1,20,0)="   Application/Version                             Patch"
^DIC(9.4,164,22,1,"PAH",129,1,21,0)="   -------------------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",129,1,22,0)="   Pharmacy Benefits Management V. 4.0             PSU*4.0*5"
^DIC(9.4,164,22,1,"PAH",129,1,23,0)="   Inpatient Medications V. 5.0                    PSJ*5.0*161"
^DIC(9.4,164,22,1,"PAH",129,1,24,0)="   Outpatient Pharmacy V. 7.0                      PSO*7.0*170"
^DIC(9.4,164,22,1,"PAH",129,1,25,0)="   Registration V. 5.3                             DG*5.3*671"
^DIC(9.4,164,22,1,"PAH",129,1,26,0)=" "
^DIC(9.4,164,22,1,"PAH",129,1,27,0)=""
^DIC(9.4,164,22,1,"PAH",129,1,28,0)=""
^DIC(9.4,164,22,1,"PAH",130,0)="140 SEQ #131^3091014.124655^17"
^DIC(9.4,164,22,1,"PAH",130,1,0)="^^133^133^3091014"
^DIC(9.4,164,22,1,"PAH",130,1,1,0)="Description:"
^DIC(9.4,164,22,1,"PAH",130,1,2,0)="==========="
^DIC(9.4,164,22,1,"PAH",130,1,3,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,4,0)="This enhancement is an interim resolution approved by the Inpatient"
^DIC(9.4,164,22,1,"PAH",130,1,5,0)="Medications Workgroup and Pharmacy Legacy Quarterly Enhancement (PLQE)"
^DIC(9.4,164,22,1,"PAH",130,1,6,0)="User Group for Patient Safety Issue PSI 08-026, PSPO #852 as described in"
^DIC(9.4,164,22,1,"PAH",130,1,7,0)="Remedy Ticket HD233682. This patch will help mitigate incorrect medication"
^DIC(9.4,164,22,1,"PAH",130,1,8,0)="routes being displayed for selection in the Computerized Patient Record"
^DIC(9.4,164,22,1,"PAH",130,1,9,0)="System V. 3.0 (CPRS)."
^DIC(9.4,164,22,1,"PAH",130,1,10,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,11,0)="Problem:"
^DIC(9.4,164,22,1,"PAH",130,1,12,0)="--------"
^DIC(9.4,164,22,1,"PAH",130,1,13,0)="Currently, for unit dose orders and Outpatient Pharmacy orders, all"
^DIC(9.4,164,22,1,"PAH",130,1,14,0)="medication routes for the dosage form of the orderable item are being"
^DIC(9.4,164,22,1,"PAH",130,1,15,0)="displayed in CPRS as possible medication routes to be selected. Even if"
^DIC(9.4,164,22,1,"PAH",130,1,16,0)="an orderable item is to be given only Intramuscular (IM), the provider"
^DIC(9.4,164,22,1,"PAH",130,1,17,0)="sees a dropdown list to select a potentially inappropriate medication"
^DIC(9.4,164,22,1,"PAH",130,1,18,0)="route of Subcutaneous (SC) or Intravenous (IV)."
^DIC(9.4,164,22,1,"PAH",130,1,19,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,20,0)="Resolution:"
^DIC(9.4,164,22,1,"PAH",130,1,21,0)="-----------"
^DIC(9.4,164,22,1,"PAH",130,1,22,0)="This enhancement affects both Inpatient Medications unit dose orders"
^DIC(9.4,164,22,1,"PAH",130,1,23,0)="entered via the Inpatient Medications order dialog in CPRS as well as"
^DIC(9.4,164,22,1,"PAH",130,1,24,0)="Outpatient Pharmacy orders entered via CPRS. A new parameter will be added"
^DIC(9.4,164,22,1,"PAH",130,1,25,0)="to the PHARMACY SYSTEM file (#59.7) to support this functionality (see"
^DIC(9.4,164,22,1,"PAH",130,1,26,0)="below). With this parameter set to YES, CPRS order dialogs will display"
^DIC(9.4,164,22,1,"PAH",130,1,27,0)="only the default medication route for the orderable item in the medication"
^DIC(9.4,164,22,1,"PAH",130,1,28,0)="route selection list in CPRS if a default medication route is defined in"
^DIC(9.4,164,22,1,"PAH",130,1,29,0)="the PHARMACY ORDERABLE ITEM file (#50.7). If there is no default"
^DIC(9.4,164,22,1,"PAH",130,1,30,0)="medication route defined for the orderable item, then the current"
^DIC(9.4,164,22,1,"PAH",130,1,31,0)="functionality will be retained and all possible medication routes for the"
^DIC(9.4,164,22,1,"PAH",130,1,32,0)="dosage form will be displayed to the provider for selection in CPRS."
^DIC(9.4,164,22,1,"PAH",130,1,33,0)="Routine PSSJORDF will be modified for this enhancement."
^DIC(9.4,164,22,1,"PAH",130,1,34,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,35,0)="This enhancement adds the DEFAULT MED ROUTE FOR CPRS field (#80.7) to the"
^DIC(9.4,164,22,1,"PAH",130,1,36,0)="PHARMACY SYSTEM file (#59.7) to support the functionality of this patch."
^DIC(9.4,164,22,1,"PAH",130,1,37,0)="The field will serve as a toggle, allowing the site to choose whether they"
^DIC(9.4,164,22,1,"PAH",130,1,38,0)="want to implement the features of this patch in their system. This field"
^DIC(9.4,164,22,1,"PAH",130,1,39,0)="is maintained by the Pharmacy System Parameters Edit [PSS SYS EDIT]"
^DIC(9.4,164,22,1,"PAH",130,1,40,0)="option. The default for this field is YES when first accessing this field"
^DIC(9.4,164,22,1,"PAH",130,1,41,0)="from this option. This field may be set to YES or NO. An example of"
^DIC(9.4,164,22,1,"PAH",130,1,42,0)="setting this to YES appears below."
^DIC(9.4,164,22,1,"PAH",130,1,43,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,44,0)="Example screen:"
^DIC(9.4,164,22,1,"PAH",130,1,45,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,46,0)="  Select Pharmacy Data Management Option:  Pharmacy System Parameters Edit"
^DIC(9.4,164,22,1,"PAH",130,1,47,0)="  PMIS PRINTER: NULL DEVICE//"
^DIC(9.4,164,22,1,"PAH",130,1,48,0)="  PMIS LANGUAGE: English//"
^DIC(9.4,164,22,1,"PAH",130,1,49,0)="  WARNING LABEL SOURCE:"
^DIC(9.4,164,22,1,"PAH",130,1,50,0)="  CMOP WARNING LABEL SOURCE:"
^DIC(9.4,164,22,1,"PAH",130,1,51,0)="  OPAI WARNING LABEL SOURCE:"
^DIC(9.4,164,22,1,"PAH",130,1,52,0)="  AUTOMATE CPRS REFILL:"
^DIC(9.4,164,22,1,"PAH",130,1,53,0)="  DEFAULT MED ROUTE FOR CPRS:  Y  YES"
^DIC(9.4,164,22,1,"PAH",130,1,54,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,55,0)="DATA          NAME                  GLOBAL        DATA"
^DIC(9.4,164,22,1,"PAH",130,1,56,0)="ELEMENT       TITLE                 LOCATION      TYPE"
^DIC(9.4,164,22,1,"PAH",130,1,57,0)="--------------------------------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",130,1,58,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,59,0)="59.7,80.7     DEFAULT MED ROUTE FOR CPRS 80;7 SET"
^DIC(9.4,164,22,1,"PAH",130,1,60,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,61,0)="                                '0' FOR NO;"
^DIC(9.4,164,22,1,"PAH",130,1,62,0)="                                '1' FOR YES;"
^DIC(9.4,164,22,1,"PAH",130,1,63,0)="            LAST EDITED:     MAY 28, 2009"
^DIC(9.4,164,22,1,"PAH",130,1,64,0)="            HELP-PROMPT:     Enter Y to display only the default med route"
^DIC(9.4,164,22,1,"PAH",130,1,65,0)="                             in CPRS or N to continue with the current"
^DIC(9.4,164,22,1,"PAH",130,1,66,0)="                             functionality."
^DIC(9.4,164,22,1,"PAH",130,1,67,0)="            DESCRIPTION:     This field should be marked ""YES"" if the site"
^DIC(9.4,164,22,1,"PAH",130,1,68,0)="                             prefers the MED ROUTE field (#.06) in the"
^DIC(9.4,164,22,1,"PAH",130,1,69,0)="                             PHARMACY ORDERABLE ITEM file (#50.7) to"
^DIC(9.4,164,22,1,"PAH",130,1,70,0)="                             appear as the default/only entry during CPRS"
^DIC(9.4,164,22,1,"PAH",130,1,71,0)="                             order entry. If no default medication route"
^DIC(9.4,164,22,1,"PAH",130,1,72,0)="                             is defined in the PHARMACY ORDERABLE ITEM"
^DIC(9.4,164,22,1,"PAH",130,1,73,0)="                             file (#50.7), then the routes from the DOSAGE"
^DIC(9.4,164,22,1,"PAH",130,1,74,0)="                             FORM file (#50.606) will display."
^DIC(9.4,164,22,1,"PAH",130,1,75,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,76,0)="                             This field will affect only orders entered"
^DIC(9.4,164,22,1,"PAH",130,1,77,0)="                             via the Inpatient Medications dialog or the"
^DIC(9.4,164,22,1,"PAH",130,1,78,0)="                             Outpatient Medications dialog in CPRS. It "
^DIC(9.4,164,22,1,"PAH",130,1,79,0)="                             will not impact IV Fluids entered via CPRS or"
^DIC(9.4,164,22,1,"PAH",130,1,80,0)="                             orders entered via backdoor Pharmacy."
^DIC(9.4,164,22,1,"PAH",130,1,81,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,82,0)="           TECHNICAL DESCR:  Set of codes. ""YES"" to display only the"
^DIC(9.4,164,22,1,"PAH",130,1,83,0)="                             default med route in CPRS and ""NO"" to "
^DIC(9.4,164,22,1,"PAH",130,1,84,0)="                             continue with the current functionality."
^DIC(9.4,164,22,1,"PAH",130,1,85,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,86,0)="The following table summarizes the functionality of this patch."
^DIC(9.4,164,22,1,"PAH",130,1,87,0)="**NOTE** This patch will be exported with the new parameter set to YES."
^DIC(9.4,164,22,1,"PAH",130,1,88,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,89,0)="                  Default OI Med"
^DIC(9.4,164,22,1,"PAH",130,1,90,0)="Site Parameter    Route Defined     CPRS Med Route Selection List"
^DIC(9.4,164,22,1,"PAH",130,1,91,0)="--------------    --------------    -----------------------------"
^DIC(9.4,164,22,1,"PAH",130,1,92,0)="YES               YES               Default med route is the only route in"
^DIC(9.4,164,22,1,"PAH",130,1,93,0)="                                    selection list. Default med route"
^DIC(9.4,164,22,1,"PAH",130,1,94,0)="                                    pre-populates the selection box."
^DIC(9.4,164,22,1,"PAH",130,1,95,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,96,0)="YES               NO                All med routes from dosage form "
^DIC(9.4,164,22,1,"PAH",130,1,97,0)="                                    display. Nothing pre-populates the"
^DIC(9.4,164,22,1,"PAH",130,1,98,0)="                                    selection box."
^DIC(9.4,164,22,1,"PAH",130,1,99,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,100,0)="NO                YES               All med routes from dosage form "
^DIC(9.4,164,22,1,"PAH",130,1,101,0)="                                    display. Default med route "
^DIC(9.4,164,22,1,"PAH",130,1,102,0)="                                    pre-populates the selection box."
^DIC(9.4,164,22,1,"PAH",130,1,103,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,104,0)="NO                NO                All med routes from dosage form "
^DIC(9.4,164,22,1,"PAH",130,1,105,0)="                                    display. Nothing pre-populates the"
^DIC(9.4,164,22,1,"PAH",130,1,106,0)="                                    selection box."
^DIC(9.4,164,22,1,"PAH",130,1,107,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,108,0)="Additionally, this patch will provide a new option called Default Med"
^DIC(9.4,164,22,1,"PAH",130,1,109,0)="Route For OI Report [PSS DEF MED ROUTE OI RPT] that will be added to the"
^DIC(9.4,164,22,1,"PAH",130,1,110,0)="Medication Routes Management [PSS MEDICATION ROUTES MGMT] menu. The site"
^DIC(9.4,164,22,1,"PAH",130,1,111,0)="can use this report to identify the current default medication route for"
^DIC(9.4,164,22,1,"PAH",130,1,112,0)="the orderable item. Here is an example of the report:"
^DIC(9.4,164,22,1,"PAH",130,1,113,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,114,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,115,0)="DEFAULT MED ROUTE FOR ORDERABLE ITEM REPORT      JUN 17,2009     PAGE 1"
^DIC(9.4,164,22,1,"PAH",130,1,116,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,117,0)="OI NAME     DOSAGE FORM ASSOCIATED ROUTES  DEFAULT ROUTE DRUG"
^DIC(9.4,164,22,1,"PAH",130,1,118,0)="--------------------------------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",130,1,119,0)=" "
^DIC(9.4,164,22,1,"PAH",130,1,120,0)="IBERET      LIQUID      ORAL (BY MOUTH)                 IBERET-500 ORAL"
^DIC(9.4,164,22,1,"PAH",130,1,121,0)="IBUPROFEN   TAB         ORAL (BY MOUTH)                 IBUPROFEN 600MG"
^DIC(9.4,164,22,1,"PAH",130,1,122,0)="IDOXURIDINE OINT,OPH    RIGHT EYE"
^DIC(9.4,164,22,1,"PAH",130,1,123,0)="                        LEFT EYE"
^DIC(9.4,164,22,1,"PAH",130,1,124,0)="                        BOTH EYES                       IDOXURIDINE 0.5%"
^DIC(9.4,164,22,1,"PAH",130,1,125,0)="IMIPRAMINE  TAB         ORAL (BY MOUTH)                 IMIPRAMINE 25MG"
^DIC(9.4,164,22,1,"PAH",130,1,126,0)="                                                        IMIPRAMINE 50MG"
^DIC(9.4,164,22,1,"PAH",130,1,127,0)="INDOCYANINE INJ,SOLN    INTRAMUSCULAR"
^DIC(9.4,164,22,1,"PAH",130,1,128,0)="                        INTRAVENOUS       INTRAVENOUS   INDOCYANINE 25MG"
^DIC(9.4,164,22,1,"PAH",130,1,129,0)="INSULIN     INJ         INTRAMUSCULAR"
^DIC(9.4,164,22,1,"PAH",130,1,130,0)="                        INTRAVENOUS"
^DIC(9.4,164,22,1,"PAH",130,1,131,0)="                        ORAL"
^DIC(9.4,164,22,1,"PAH",130,1,132,0)="                        SUBCUTANEOUS      INTRAVENOUS   INSULIN LENTE"
^DIC(9.4,164,22,1,"PAH",130,1,133,0)="                                                        INSULIN NPH"
^DIC(9.4,164,22,1,"PAH",131,0)="141 SEQ #132^3091201.14255^17"
^DIC(9.4,164,22,1,"PAH",131,1,0)="^^9^9^3091201"
^DIC(9.4,164,22,1,"PAH",131,1,1,0)="This patch provides the Pharmacy Data Management support for the Class"
^DIC(9.4,164,22,1,"PAH",131,1,2,0)="III to Class I conversion project Immunizations Documentation by BCMA."
^DIC(9.4,164,22,1,"PAH",131,1,3,0)=" "
^DIC(9.4,164,22,1,"PAH",131,1,4,0)="Included in the patch is the addition of the ASSOCIATED IMMUNIZATION field"
^DIC(9.4,164,22,1,"PAH",131,1,5,0)="(#9) in the PHARMACY ORDERABLE ITEM file (#50.7) and revisions to the"
^DIC(9.4,164,22,1,"PAH",131,1,6,0)="options Edit Orderable Items [PSS EDIT ORDERABLE ITEMS] and Dispense "
^DIC(9.4,164,22,1,"PAH",131,1,7,0)="Drug/Orderable Item Maintenance [PSS MAINTAIN ORDERABLE ITEMS]."
^DIC(9.4,164,22,1,"PAH",131,1,8,0)=" "
^DIC(9.4,164,22,1,"PAH",131,1,9,0)="Patch PSB*3*47 provides the BCMA portion of the project."
^DIC(9.4,164,22,1,"PAH",132,0)="147 SEQ #133^3100302.101132^17"
^DIC(9.4,164,22,1,"PAH",132,1,0)="^^114^114^3100302"
^DIC(9.4,164,22,1,"PAH",132,1,1,0)="This patch will make some additional enhancements to the Pharmacy"
^DIC(9.4,164,22,1,"PAH",132,1,2,0)="Re-Engineering (PRE) V. 0.5 Pre-Release functionality that was released in"
^DIC(9.4,164,22,1,"PAH",132,1,3,0)="patch PSS*1.0*129. This patch also sends out four Vista Security Keys to"
^DIC(9.4,164,22,1,"PAH",132,1,4,0)="be used in the Pharmacy Enterprise Customization System (PECS)"
^DIC(9.4,164,22,1,"PAH",132,1,5,0)="Application, which will be released at a later date."
^DIC(9.4,164,22,1,"PAH",132,1,6,0)=" "
^DIC(9.4,164,22,1,"PAH",132,1,7,0)="The enhancements to the Pre-Release functionality include:"
^DIC(9.4,164,22,1,"PAH",132,1,8,0)="                                  "
^DIC(9.4,164,22,1,"PAH",132,1,9,0)="1) A new PSS ORDER CHECKS Mail Group will be created upon installation of"
^DIC(9.4,164,22,1,"PAH",132,1,10,0)="this patch. This mail group will be used for various purposes, all"
^DIC(9.4,164,22,1,"PAH",132,1,11,0)="relating to the Pharmacy Re-Engineering (PRE) V. 0.5 project."
^DIC(9.4,164,22,1,"PAH",132,1,12,0)=" "
^DIC(9.4,164,22,1,"PAH",132,1,13,0)="2) Data from the DOSE UNIT (#4) Field and the NUMERIC DOSE (#5) Field of"
^DIC(9.4,164,22,1,"PAH",132,1,14,0)="the LOCAL POSSIBLE DOSAGE (#50.0904) Subfile of the DRUG (#50) File will"
^DIC(9.4,164,22,1,"PAH",132,1,15,0)="be added as display elements to the Lookup into Dispense Drug File"
^DIC(9.4,164,22,1,"PAH",132,1,16,0)="[PSS LOOK] option and the Drug Enter/Edit [PSS DRUG ENTER/EDIT] option."
^DIC(9.4,164,22,1,"PAH",132,1,17,0)=" "
^DIC(9.4,164,22,1,"PAH",132,1,18,0)="3) A Vista Mail message will be sent to the PSS ORDER CHECKS Mail Group"
^DIC(9.4,164,22,1,"PAH",132,1,19,0)="when an update is made to the STANDARD MEDICATION ROUTES (#51.23) File by"
^DIC(9.4,164,22,1,"PAH",132,1,20,0)="the New Term Rapid Turnaround (NTRT) process. This mail message will"
^DIC(9.4,164,22,1,"PAH",132,1,21,0)="include what was updated, and will also include any automatic mapping"
^DIC(9.4,164,22,1,"PAH",132,1,22,0)="activities that occurred from the MEDICATION ROUTES (#51.2) File to the"
^DIC(9.4,164,22,1,"PAH",132,1,23,0)="STANDARD MEDICATION ROUTES (#51.23) File."
^DIC(9.4,164,22,1,"PAH",132,1,24,0)=" "
^DIC(9.4,164,22,1,"PAH",132,1,25,0)="4) The Request Change to Standard Medication Route [PSS MEDICATION ROUTE "
^DIC(9.4,164,22,1,"PAH",132,1,26,0)="REQUEST] option has been changed to now refer the requestor to a web site"
^DIC(9.4,164,22,1,"PAH",132,1,27,0)="to make the request."
^DIC(9.4,164,22,1,"PAH",132,1,28,0)=" "
^DIC(9.4,164,22,1,"PAH",132,1,29,0)="5) A new ADDITIVE FREQUENCY (#18) Field has been added to the IV ADDITIVES"
^DIC(9.4,164,22,1,"PAH",132,1,30,0)="(#52.6) File. This field will be used to provide a default value for the"
^DIC(9.4,164,22,1,"PAH",132,1,31,0)="Additive Frequency field in Computerized Patient Record System (CPRS) when"
^DIC(9.4,164,22,1,"PAH",132,1,32,0)="continuous IV orders with additives are entered. Data will be"
^DIC(9.4,164,22,1,"PAH",132,1,33,0)="auto-populated by a Post-Install routine for this patch, and this data"
^DIC(9.4,164,22,1,"PAH",132,1,34,0)="should be reviewed and edited as necessary. This new field can be edited"
^DIC(9.4,164,22,1,"PAH",132,1,35,0)="using the Drug Enter/Edit [PSS DRUG ENTER/EDIT] option or the ADditives"
^DIC(9.4,164,22,1,"PAH",132,1,36,0)="File [PSSJI DRUG] option. These defaults will not start to appear in CPRS"
^DIC(9.4,164,22,1,"PAH",132,1,37,0)="until Pharmacy Re-Engineering (PRE) V. 0.5. A new IV Additive Report [PSS"
^DIC(9.4,164,22,1,"PAH",132,1,38,0)="IV ADDITIVE REPORT] option has also been added, and this report, in"
^DIC(9.4,164,22,1,"PAH",132,1,39,0)="addition to the current IV Solution Report [PSS IV SOLUTION REPORT] "
^DIC(9.4,164,22,1,"PAH",132,1,40,0)="option, will now be located under the new IV Additive/Solution Reports"
^DIC(9.4,164,22,1,"PAH",132,1,41,0)="[PSS ADDITIVE/SOLUTION REPORTS] Menu option, which will be located under"
^DIC(9.4,164,22,1,"PAH",132,1,42,0)="the Pharmacy Data Management [PSS MGR] Menu option."
^DIC(9.4,164,22,1,"PAH",132,1,43,0)=" "
^DIC(9.4,164,22,1,"PAH",132,1,44,0)="A Mail Message will be sent to the PSS ORDER CHECKS Mail Group and the"
^DIC(9.4,164,22,1,"PAH",132,1,45,0)="patch installer upon completion of patch installation."
^DIC(9.4,164,22,1,"PAH",132,1,46,0)="                                 "
^DIC(9.4,164,22,1,"PAH",132,1,47,0)=" "
^DIC(9.4,164,22,1,"PAH",132,1,48,0)="This patch addresses the following New Service Request (NSR):"
^DIC(9.4,164,22,1,"PAH",132,1,49,0)="-------------------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",132,1,50,0)="There is no NSR associated with this patch. "
^DIC(9.4,164,22,1,"PAH",132,1,51,0)=" "
^DIC(9.4,164,22,1,"PAH",132,1,52,0)=" "
^DIC(9.4,164,22,1,"PAH",132,1,53,0)="This patch addresses the following Remedy Ticket(s):"
^DIC(9.4,164,22,1,"PAH",132,1,54,0)="----------------------------------------------------"
^DIC(9.4,164,22,1,"PAH",132,1,55,0)="There are no Remedy tickets associated with this patch."
^DIC(9.4,164,22,1,"PAH",132,1,56,0)=" "
^DIC(9.4,164,22,1,"PAH",132,1,57,0)=" "
^DIC(9.4,164,22,1,"PAH",132,1,58,0)="Overview of Remedy Ticket(s):"
^DIC(9.4,164,22,1,"PAH",132,1,59,0)="-----------------------------"
^DIC(9.4,164,22,1,"PAH",132,1,60,0)="There are no Remedy tickets associated with this patch. "
^DIC(9.4,164,22,1,"PAH",132,1,61,0)=" "
^DIC(9.4,164,22,1,"PAH",132,1,62,0)=" "
^DIC(9.4,164,22,1,"PAH",132,1,63,0)="Components Exported With Patch: "
^DIC(9.4,164,22,1,"PAH",132,1,64,0)="-------------------------------"
^DIC(9.4,164,22,1,"PAH",132,1,65,0)=" "
^DIC(9.4,164,22,1,"PAH",132,1,66,0)=" "
^DIC(9.4,164,22,1,"PAH",132,1,67,0)="The following is a list of fields included in this patch:"
^DIC(9.4,164,22,1,"PAH",132,1,68,0)=" "
^DIC(9.4,164,22,1,"PAH",132,1,69,0)="Field Name                 (Number)     File Name             (Number)"
^DIC(9.4,164,22,1,"PAH",132,1,70,0)="-----------------------------------     ------------------------------"
