^DIC(9.4,76,22,2,0)="3.0^3051119^2970501^1"
^DIC(9.4,76,22,2,1,0)="^^1^1^3051119"
^DIC(9.4,76,22,2,1,1,0)="AICS v3.0, including scannable encounter form support."
^DIC(9.4,76,22,2,"PAH",0)="^9.4901^58^58"
^DIC(9.4,76,22,2,"PAH",1,0)="4 SEQ #2^2970619^1"
^DIC(9.4,76,22,2,"PAH",1,1,0)="^^3^3^2970619"
^DIC(9.4,76,22,2,"PAH",1,1,1,0)="This patch fixes the sites inability to exit out of the provider prompt,"
^DIC(9.4,76,22,2,"PAH",1,1,2,0)="as well as a problem whereby duplicate diagnoses were being added to"
^DIC(9.4,76,22,2,"PAH",1,1,3,0)="the V POV file (#9000010.07)."
^DIC(9.4,76,22,2,"PAH",2,0)="1 SEQ #3^2970626^1"
^DIC(9.4,76,22,2,"PAH",2,1,0)="^^4^4^2980217^"
^DIC(9.4,76,22,2,"PAH",2,1,1,0)=" "
^DIC(9.4,76,22,2,"PAH",2,1,2,0)="IBDF18E1"
^DIC(9.4,76,22,2,"PAH",2,1,3,0)="IBDF2A"
^DIC(9.4,76,22,2,"PAH",2,1,4,0)="IBDFRPC"
^DIC(9.4,76,22,2,"PAH",3,0)="6 SEQ #4^2970626^1"
^DIC(9.4,76,22,2,"PAH",3,1,0)="^^5^5^2970626"
^DIC(9.4,76,22,2,"PAH",3,1,1,0)="When using the 'Pre-printed Form Data entry' option to add a stand alone"
^DIC(9.4,76,22,2,"PAH",3,1,2,0)="encounter for a service connected patient, the service connected questions"
^DIC(9.4,76,22,2,"PAH",3,1,3,0)="are not being asked if the patient has multiple stand alone encounters"
^DIC(9.4,76,22,2,"PAH",3,1,4,0)="for that day.  This patch will allow the service connected questions"
^DIC(9.4,76,22,2,"PAH",3,1,5,0)="to be asked regardless of the number of stand alone encounters for the day."
^DIC(9.4,76,22,2,"PAH",4,0)="5 SEQ #6^2970627^1"
^DIC(9.4,76,22,2,"PAH",4,1,0)="^^7^7^2970627"
^DIC(9.4,76,22,2,"PAH",4,1,1,0)="This KIDS build sends the routines IBDF18C and IBDF18D which"
^DIC(9.4,76,22,2,"PAH",4,1,2,0)="resolves a problem with exclusive locks not being unlocked when"
^DIC(9.4,76,22,2,"PAH",4,1,3,0)="printing encounter forms.  A lock is set on the Forms Tracking global"
^DIC(9.4,76,22,2,"PAH",4,1,4,0)="^IBD(357.96, and the Form Definition global ^IBD(357.95.  When the locks"
^DIC(9.4,76,22,2,"PAH",4,1,5,0)="are not cleared, an entry remains in the lock table for each file."
^DIC(9.4,76,22,2,"PAH",4,1,6,0)="This KIDS build resolves this problem by releasing the locks from each"
^DIC(9.4,76,22,2,"PAH",4,1,7,0)="file after successful filing of the data."
^DIC(9.4,76,22,2,"PAH",5,0)="5^2970611"
^DIC(9.4,76,22,2,"PAH",5,1,0)="^^7^7^2970627"
^DIC(9.4,76,22,2,"PAH",5,1,1,0)="This KIDS build sends the routines IBDF18C and IBDF18D which"
^DIC(9.4,76,22,2,"PAH",5,1,2,0)="resolves a problem with exclusive locks not being unlocked when"
^DIC(9.4,76,22,2,"PAH",5,1,3,0)="printing encounter forms.  A lock is set on the Forms Tracking global"
^DIC(9.4,76,22,2,"PAH",5,1,4,0)="^IBD(357.96, and the Form Definition global ^IBD(357.95.  When the locks"
^DIC(9.4,76,22,2,"PAH",5,1,5,0)="are not cleared, an entry remains in the lock table for each file."
^DIC(9.4,76,22,2,"PAH",5,1,6,0)="This KIDS build resolves this problem by releasing the locks from each"
^DIC(9.4,76,22,2,"PAH",5,1,7,0)="file after successful filing of the data."
^DIC(9.4,76,22,2,"PAH",6,0)="8 SEQ #7^2970710^1"
^DIC(9.4,76,22,2,"PAH",6,1,0)="^^5^5^2970710"
^DIC(9.4,76,22,2,"PAH",6,1,1,0)="This patch fixes a syntax error on field .09"
^DIC(9.4,76,22,2,"PAH",6,1,2,0)="SUPPLMNTL FORM #3 ALL PATIENTS of the file"
^DIC(9.4,76,22,2,"PAH",6,1,3,0)="409.95 PRINT MANAGER CLINIC SETUP.  There is a "
^DIC(9.4,76,22,2,"PAH",6,1,4,0)="comma missing between U4.  It should be"
^DIC(9.4,76,22,2,"PAH",6,1,5,0)="U,4 in the screen for that field.  "
^DIC(9.4,76,22,2,"PAH",7,0)="10 SEQ #8^2970804^1"
^DIC(9.4,76,22,2,"PAH",7,1,0)="^^9^9^2970804"
^DIC(9.4,76,22,2,"PAH",7,1,1,0)="When editing a form that is used by more than 4 clinics, it is possible"
^DIC(9.4,76,22,2,"PAH",7,1,2,0)="to have the clinic listing scroll off of the view screen.  This patch"
^DIC(9.4,76,22,2,"PAH",7,1,3,0)="will limit the viewing of clinics to four at a time, so the display does"
^DIC(9.4,76,22,2,"PAH",7,1,4,0)="not scroll off of the viewing area."
^DIC(9.4,76,22,2,"PAH",7,1,5,0)=" "
^DIC(9.4,76,22,2,"PAH",7,1,6,0)="Additionally, entering an '^' at the completion of the first screen of"
^DIC(9.4,76,22,2,"PAH",7,1,7,0)="clinics does not exit the display.  This patch will allow the clinic listing"
^DIC(9.4,76,22,2,"PAH",7,1,8,0)="to abort appropriately upon entering an '^' at the 'Enter RETURN to"
^DIC(9.4,76,22,2,"PAH",7,1,9,0)="continue or '^' to exit:' prompt."
^DIC(9.4,76,22,2,"PAH",8,0)="9^2970808^1"
^DIC(9.4,76,22,2,"PAH",8,1,0)="^^1^1^2970808"
^DIC(9.4,76,22,2,"PAH",8,1,1,0)="This patch contains multiple fixes for AICS v3.0 reported by NOIS entries."
^DIC(9.4,76,22,2,"PAH",9,0)="11 SEQ #10^2971007^1"
^DIC(9.4,76,22,2,"PAH",9,1,0)="^^2^2^2971007"
^DIC(9.4,76,22,2,"PAH",9,1,1,0)=" "
^DIC(9.4,76,22,2,"PAH",9,1,2,0)="AICS v3.0 patch IBD*3*11 - AICS MULTIPLE OPTION FIXES"
^DIC(9.4,76,22,2,"PAH",10,0)="12 SEQ #11^2971021^1"
^DIC(9.4,76,22,2,"PAH",10,1,0)="^^3^3^2971021"
^DIC(9.4,76,22,2,"PAH",10,1,1,0)=" "
^DIC(9.4,76,22,2,"PAH",10,1,2,0)="Patch IBD*3.0*12 - files 357.6, 359.1 updates"
^DIC(9.4,76,22,2,"PAH",10,1,3,0)="                 routines IBDFBK3, IBDFN12, IBDFN14, IBDFQS"
^DIC(9.4,76,22,2,"PAH",11,0)="19 SEQ #12^2971127^1"
^DIC(9.4,76,22,2,"PAH",11,1,0)="^^1^1^2971127"
^DIC(9.4,76,22,2,"PAH",11,1,1,0)="Modification to routine IBDF4 in support of Lexicon Utility v2.0."
^DIC(9.4,76,22,2,"PAH",12,0)="3^2980129^1"
^DIC(9.4,76,22,2,"PAH",12,1,0)="^^1^1^2980129"
^DIC(9.4,76,22,2,"PAH",12,1,1,0)="AICS scanning patch to fix duplex scanning and anchor location."
^DIC(9.4,76,22,2,"PAH",13,0)="13 SEQ #15^2980220^1"
^DIC(9.4,76,22,2,"PAH",13,1,0)="^^2^2^2980220"
^DIC(9.4,76,22,2,"PAH",13,1,1,0)="Patched routine IBDFM1 to translate quote '""' and backslash '\' characters"
^DIC(9.4,76,22,2,"PAH",13,1,2,0)="for Paper Keyboard."
^DIC(9.4,76,22,2,"PAH",14,0)="16^2980305^1"
^DIC(9.4,76,22,2,"PAH",14,1,0)="^^8^8^2980305"
^DIC(9.4,76,22,2,"PAH",14,1,1,0)=" "
^DIC(9.4,76,22,2,"PAH",14,1,2,0)="This patch fixes some misc. Forms Tracking items..."
^DIC(9.4,76,22,2,"PAH",14,1,3,0)="When a new clinic is created and has appts., encounter"
^DIC(9.4,76,22,2,"PAH",14,1,4,0)="forms print but they are not included on Forms Tracking"
^DIC(9.4,76,22,2,"PAH",14,1,5,0)="list for a single division facility without the division"
^DIC(9.4,76,22,2,"PAH",14,1,6,0)="field filled in."
^DIC(9.4,76,22,2,"PAH",14,1,7,0)="Fixes Forms Tracking action SS Status Select for "
^DIC(9.4,76,22,2,"PAH",14,1,8,0)="Pending Pages and Error Detected, Not Transmitted."
^DIC(9.4,76,22,2,"PAH",15,0)="20 SEQ #17^2980318^1"
^DIC(9.4,76,22,2,"PAH",15,1,0)="^^5^5^2980318"
^DIC(9.4,76,22,2,"PAH",15,1,1,0)="This patch corrects a problem with AICS printing Pharmacy"
^DIC(9.4,76,22,2,"PAH",15,1,2,0)="Action/Informational Profile reports and associated DUE sheets. Prior"
^DIC(9.4,76,22,2,"PAH",15,1,3,0)="to this patch, Pharmacy DUE sheets were not printing with the profiles."
^DIC(9.4,76,22,2,"PAH",15,1,4,0)=" "
^DIC(9.4,76,22,2,"PAH",15,1,5,0)="This patch includes routine IBDFN3."
^DIC(9.4,76,22,2,"PAH",16,0)="17 SEQ #18^2980616^1"
^DIC(9.4,76,22,2,"PAH",16,1,0)="^^3^3^2980616"
^DIC(9.4,76,22,2,"PAH",16,1,1,0)="AICS changes to accommodate the ACRP conversion changes for outpatient"
^DIC(9.4,76,22,2,"PAH",16,1,2,0)="encounter retrieval.  Refer to the national patch module for more detailed"
^DIC(9.4,76,22,2,"PAH",16,1,3,0)="information."
^DIC(9.4,76,22,2,"PAH",17,0)="31 SEQ #20^2981214^1"
^DIC(9.4,76,22,2,"PAH",17,1,0)="^^3^3^2981214"
^DIC(9.4,76,22,2,"PAH",17,1,1,0)="This patch will print NKA (no known allergies) in the allergies block on"
^DIC(9.4,76,22,2,"PAH",17,1,2,0)="Encounter Forms.  A change to IBDFN2 was necessary because patch GMRA*4*10"
^DIC(9.4,76,22,2,"PAH",17,1,3,0)="no longer sets the GMRAL array if the patient is unassessed or NKA."
^DIC(9.4,76,22,2,"PAH",18,0)="15 SEQ #21^2990201^1"
^DIC(9.4,76,22,2,"PAH",18,1,0)="^^10^10^2990201"
^DIC(9.4,76,22,2,"PAH",18,1,1,0)="Automatic sending of Forms Tracking entries in a Pending Pages status"
^DIC(9.4,76,22,2,"PAH",18,1,2,0)="to PCE."
^DIC(9.4,76,22,2,"PAH",18,1,3,0)=" "
^DIC(9.4,76,22,2,"PAH",18,1,4,0)="Add a new package interface and toolkit component to display clinical"
^DIC(9.4,76,22,2,"PAH",18,1,5,0)="reminders on an encounter form"
^DIC(9.4,76,22,2,"PAH",18,1,6,0)=" "
^DIC(9.4,76,22,2,"PAH",18,1,7,0)="This patch fixes the IBDF Background Job for the printing of"
^DIC(9.4,76,22,2,"PAH",18,1,8,0)="Encounter Forms ignoring the time queued (starting time ) for"
^DIC(9.4,76,22,2,"PAH",18,1,9,0)="print jobs.  It also allows only numerics to be entered in the"
^DIC(9.4,76,22,2,"PAH",18,1,10,0)="Time Queued field of the Encounter Form Parameters file #357.09."
^DIC(9.4,76,22,2,"PAH",19,0)="25 SEQ #22^2990417^1"
^DIC(9.4,76,22,2,"PAH",19,1,0)="^^5^5^2990417"
^DIC(9.4,76,22,2,"PAH",19,1,1,0)="This patch comprises a change to the recognition of encounter form anchors."
^DIC(9.4,76,22,2,"PAH",19,1,2,0)="It includes a new routine that causes the formspec files that do the actual"
^DIC(9.4,76,22,2,"PAH",19,1,3,0)="recognition to function correctly.  We used to use all 4 anchors printed one"
^DIC(9.4,76,22,2,"PAH",19,1,4,0)="in each corner.  With this new functionality we will first use the left pair"
^DIC(9.4,76,22,2,"PAH",19,1,5,0)="of anchors and if those aren't found we will use the right pair."
^DIC(9.4,76,22,2,"PAH",20,0)="32 SEQ #23^2990510^1"
^DIC(9.4,76,22,2,"PAH",20,1,0)="^^4^4^2990510"
^DIC(9.4,76,22,2,"PAH",20,1,1,0)="This patch will eliminate an <UNDEF> MUMPS error at line OUT1+14^IBDFUTL"
^DIC(9.4,76,22,2,"PAH",20,1,2,0)="by using a $G() of the variable ""DIC."", $Gets have been placed around "
^DIC(9.4,76,22,2,"PAH",20,1,3,0)="variable IBDFCODE in ^IBDFUTL1.  The choices presented to users when"
^DIC(9.4,76,22,2,"PAH",20,1,4,0)="running the Maintenance Utility Option have been limited to valid choices."
^DIC(9.4,76,22,2,"PAH",21,0)="39 SEQ #24^2990803^1"
^DIC(9.4,76,22,2,"PAH",21,1,0)="^^11^11^2990803"
^DIC(9.4,76,22,2,"PAH",21,1,1,0)="When AICS users print encounter forms that contain"
^DIC(9.4,76,22,2,"PAH",21,1,2,0)="'an overflow list' of problems, a null subscript"
^DIC(9.4,76,22,2,"PAH",21,1,3,0)="error occurs."
^DIC(9.4,76,22,2,"PAH",21,1,4,0)=""
^DIC(9.4,76,22,2,"PAH",21,1,5,0)="IBD*3.0*39 resolves this problem, and addresses the"
^DIC(9.4,76,22,2,"PAH",21,1,6,0)="following NOIS(s):"
^DIC(9.4,76,22,2,"PAH",21,1,7,0)=""
^DIC(9.4,76,22,2,"PAH",21,1,8,0)="1. RIC-0599-20455"
^DIC(9.4,76,22,2,"PAH",21,1,9,0)="2. DAY-1298-40380"
^DIC(9.4,76,22,2,"PAH",21,1,10,0)="3. CLA-0399-22584"
^DIC(9.4,76,22,2,"PAH",21,1,11,0)="4. NJH-1198-20059"
^DIC(9.4,76,22,2,"PAH",22,0)="34 SEQ #25^3000204^1"
^DIC(9.4,76,22,2,"PAH",22,1,0)="^^27^27^3000204"
^DIC(9.4,76,22,2,"PAH",22,1,1,0)="AICS provides the packages PCE and CPRS the ability to display"
^DIC(9.4,76,22,2,"PAH",22,1,2,0)="to users the lists of items that are printed on encounter forms."
^DIC(9.4,76,22,2,"PAH",22,1,3,0)="This functionality then provides some consistency to all the "
^DIC(9.4,76,22,2,"PAH",22,1,4,0)="Ambulatory Care data capture for sites that use encounter forms."
^DIC(9.4,76,22,2,"PAH",22,1,5,0)=" "
^DIC(9.4,76,22,2,"PAH",22,1,6,0)="A number of problems have been reported that relate to the display"
^DIC(9.4,76,22,2,"PAH",22,1,7,0)="of this data in these packages.  This patch corrects the following"
^DIC(9.4,76,22,2,"PAH",22,1,8,0)="problems:"
^DIC(9.4,76,22,2,"PAH",22,1,9,0)=" "
^DIC(9.4,76,22,2,"PAH",22,1,10,0)="1.  It was possible that the display order for groups of items"
^DIC(9.4,76,22,2,"PAH",22,1,11,0)="    on encounter forms did not necessarily match the display order"
^DIC(9.4,76,22,2,"PAH",22,1,12,0)="    in other patckages, especially CPRS.  This was due to using"
^DIC(9.4,76,22,2,"PAH",22,1,13,0)="    the internal entry number to sort groups rather that the user"
^DIC(9.4,76,22,2,"PAH",22,1,14,0)="    specified display order."
^DIC(9.4,76,22,2,"PAH",22,1,15,0)=" "
^DIC(9.4,76,22,2,"PAH",22,1,16,0)="2.  If the first character in a group had a code value of that"
^DIC(9.4,76,22,2,"PAH",22,1,17,0)="    began with an alpha character then it was possible for the"
^DIC(9.4,76,22,2,"PAH",22,1,18,0)="    header to not appear.  If the entire group consisted of items"
^DIC(9.4,76,22,2,"PAH",22,1,19,0)="    with codes that began with alpha characters then the whole"
^DIC(9.4,76,22,2,"PAH",22,1,20,0)="    group may not appear. "
^DIC(9.4,76,22,2,"PAH",22,1,21,0)=" "
^DIC(9.4,76,22,2,"PAH",22,1,22,0)="3.  If an item was in a long list twice with exactly the same"
^DIC(9.4,76,22,2,"PAH",22,1,23,0)="    code and description then it would not appear in other packages"
^DIC(9.4,76,22,2,"PAH",22,1,24,0)="    after the first display."
^DIC(9.4,76,22,2,"PAH",22,1,25,0)=" "
^DIC(9.4,76,22,2,"PAH",22,1,26,0)="4.  Occasionally there were Allocation errors generated when long"
^DIC(9.4,76,22,2,"PAH",22,1,27,0)="    (generally a full page) lists were processed."
^DIC(9.4,76,22,2,"PAH",23,0)="38 SEQ #26^3000313^1"
^DIC(9.4,76,22,2,"PAH",23,1,0)="^^1^1^3000313"
^DIC(9.4,76,22,2,"PAH",23,1,1,0)="See patch description on NPM for complete details of this patch."
^DIC(9.4,76,22,2,"PAH",24,0)="14 SEQ #28^3000501^1"
^DIC(9.4,76,22,2,"PAH",24,1,0)="^^2^2^3000501"
^DIC(9.4,76,22,2,"PAH",24,1,1,0)="This patch cleans up AICS DATA QUALIFIERS that may be causing problems with"
^DIC(9.4,76,22,2,"PAH",24,1,2,0)="scanning."
^DIC(9.4,76,22,2,"PAH",25,0)="40 SEQ #29^3000711^1"
^DIC(9.4,76,22,2,"PAH",25,1,0)="^^1^1^3000711"
^DIC(9.4,76,22,2,"PAH",25,1,1,0)="INACTIVE HEALTH FACTORS NOT SCREENING"
^DIC(9.4,76,22,2,"PAH",26,0)="29 SEQ #30^3000711^1"
^DIC(9.4,76,22,2,"PAH",26,1,0)="^^1^1^3000711"
^DIC(9.4,76,22,2,"PAH",26,1,1,0)="MISCELLANEOUS FIXES"
^DIC(9.4,76,22,2,"PAH",27,0)="36 SEQ #32^3001027^1"
^DIC(9.4,76,22,2,"PAH",27,1,0)="^^3^3^3001027"
^DIC(9.4,76,22,2,"PAH",27,1,1,0)="Patch IBD*3*36 adds the Military Sexual Trauma (MST) indicator to AICS"
^DIC(9.4,76,22,2,"PAH",27,1,2,0)="encounter form blocks and AICS manual data entry processes.  See the"
^DIC(9.4,76,22,2,"PAH",27,1,3,0)="NPM on FORUM for complete information."
^DIC(9.4,76,22,2,"PAH",28,0)="21 SEQ #33^3001127^1"
^DIC(9.4,76,22,2,"PAH",28,1,0)="^^1^1^3001127"
^DIC(9.4,76,22,2,"PAH",28,1,1,0)="Printer Setup in [IBDF AUTO CLINIC PRINT]"
^DIC(9.4,76,22,2,"PAH",29,0)="23 SEQ #34^3010319^1"
^DIC(9.4,76,22,2,"PAH",29,1,0)="^^1^1^3010319"
^DIC(9.4,76,22,2,"PAH",29,1,1,0)="Fixes problems with 2nd and 3rd diagnosis codes."
^DIC(9.4,76,22,2,"PAH",30,0)="42 SEQ #35^3010529^1"
^DIC(9.4,76,22,2,"PAH",30,1,0)="^^2^2^3010529"
^DIC(9.4,76,22,2,"PAH",30,1,1,0)="While using Clinic Setup/Edit Forms option and printing an Encounter form,"
^DIC(9.4,76,22,2,"PAH",30,1,2,0)="the option errors if a slave device is selected."
^DIC(9.4,76,22,2,"PAH",31,0)="44 SEQ #37^3010802^1"
^DIC(9.4,76,22,2,"PAH",31,1,0)="^^5^5^3010802"
^DIC(9.4,76,22,2,"PAH",31,1,1,0)="When AICS is used for checkout on patients who are being treated for an SC"
^DIC(9.4,76,22,2,"PAH",31,1,2,0)="condition and have reported MST, the encounter STATUS results in ACTION        "
^DIC(9.4,76,22,2,"PAH",31,1,3,0)="REQUIRED.  Both the SC/MST Classification and Hidden Classification (V3.0"
^DIC(9.4,76,22,2,"PAH",31,1,4,0)="MST) blocks ask the appropriate SC question but if answered YES, the MST"
^DIC(9.4,76,22,2,"PAH",31,1,5,0)="question is not presented."
^DIC(9.4,76,22,2,"PAH",32,0)="43 SEQ #38^3010802^1"
^DIC(9.4,76,22,2,"PAH",32,1,0)="^^2^2^3010802"
^DIC(9.4,76,22,2,"PAH",32,1,1,0)="Export new encounter form blocks with Enrollment Priority instead of "
^DIC(9.4,76,22,2,"PAH",32,1,2,0)="Means Test Category."
^DIC(9.4,76,22,2,"PAH",33,0)="45 SEQ #39^3010815^1"
^DIC(9.4,76,22,2,"PAH",33,1,0)="^^3^3^3010815"
^DIC(9.4,76,22,2,"PAH",33,1,1,0)="When printing Action Profiles with Encounter Forms, an extra page feed is"
^DIC(9.4,76,22,2,"PAH",33,1,2,0)="printed. Either a page is wasted or the Action Profile is printed on the "
^DIC(9.4,76,22,2,"PAH",33,1,3,0)="back of a duplexed page.  "
^DIC(9.4,76,22,2,"PAH",34,0)="30 SEQ #40^3010906^1"
^DIC(9.4,76,22,2,"PAH",34,1,0)="^^2^2^3010906"
^DIC(9.4,76,22,2,"PAH",34,1,1,0)="Sample distribution to all allocation of encounter forms for wards.  Done in"
^DIC(9.4,76,22,2,"PAH",34,1,2,0)="support of changes to CPRS."
^DIC(9.4,76,22,2,"PAH",35,0)="37 SEQ #41^3010926^1"
^DIC(9.4,76,22,2,"PAH",35,1,0)="^^2^2^3010926"
^DIC(9.4,76,22,2,"PAH",35,1,1,0)="This project is to allow for the input and data capture of GAF scores"
^DIC(9.4,76,22,2,"PAH",35,1,2,0)="while using AICS."
^DIC(9.4,76,22,2,"PAH",36,0)="46 SEQ #42^3010926^1"
^DIC(9.4,76,22,2,"PAH",36,1,0)="^^12^12^3010926"
^DIC(9.4,76,22,2,"PAH",36,1,1,0)="Problems with printing Encounter Forms to a VMS Queue using Host Files."
^DIC(9.4,76,22,2,"PAH",36,1,2,0)="When the first Encounter Form is printed and the print is ""reset"" to the"
^DIC(9.4,76,22,2,"PAH",36,1,3,0)="original settings in the specified terminal type, a second VMS file is"
^DIC(9.4,76,22,2,"PAH",36,1,4,0)="opened.  When the final printing is completed, the first VMS file is"
^DIC(9.4,76,22,2,"PAH",36,1,5,0)="closed leaving the second VMS file open.  Therefore, unless the second VMS"
^DIC(9.4,76,22,2,"PAH",36,1,6,0)="file is manual close or forced to print, it will not print.  This problem"
^DIC(9.4,76,22,2,"PAH",36,1,7,0)="is resolved by resetting the printer with a direct call to %ZIS global"
^DIC(9.4,76,22,2,"PAH",36,1,8,0)="instead of a call to ^%ZIS routine."
^DIC(9.4,76,22,2,"PAH",36,1,9,0)=" "
^DIC(9.4,76,22,2,"PAH",36,1,10,0)="NOIS(s): "
^DIC(9.4,76,22,2,"PAH",36,1,11,0)="ATG-0701-32125, LEX-1200-40929, HVH-0900-10840, UNY-0800-12067,"
^DIC(9.4,76,22,2,"PAH",36,1,12,0)="ALN-0600-10776, DEN-0600-51325"
^DIC(9.4,76,22,2,"PAH",37,0)="48 SEQ #43^3020710^1"
^DIC(9.4,76,22,2,"PAH",37,1,0)="^^39^39^3020710"
^DIC(9.4,76,22,2,"PAH",37,1,1,0)="This patch is a means to distribute National Mental Health Encounter"
^DIC(9.4,76,22,2,"PAH",37,1,2,0)="Forms to the field in accordance to ""Veterans Health Administration"
