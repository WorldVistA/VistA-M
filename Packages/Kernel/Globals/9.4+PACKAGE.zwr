^DIC(9.4,83,22,16,"PAH",62,1,149,0)="      Select Schedule(s): 3//   SCHEDULES I - V"
^DIC(9.4,83,22,16,"PAH",62,1,150,0)=" "
^DIC(9.4,83,22,16,"PAH",62,1,151,0)="      DEVICE: "
^DIC(9.4,83,22,16,"PAH",62,1,152,0)="  "
^DIC(9.4,83,22,16,"PAH",62,1,153,0)="      ..."
^DIC(9.4,83,22,16,"PAH",62,1,154,0)=" "
^DIC(9.4,83,22,16,"PAH",62,1,155,0)="6. Controlled Substance Prescriptions Report [PSD CS PRESCRIPTIONS REPORT]"
^DIC(9.4,83,22,16,"PAH",62,1,156,0)="   -----------------------------------------------------------------------"
^DIC(9.4,83,22,16,"PAH",62,1,157,0)="   This option is a new option. It will provide a report of digitally "
^DIC(9.4,83,22,16,"PAH",62,1,158,0)="   signed orders that have been filled for Schedules I-V CS. The report"
^DIC(9.4,83,22,16,"PAH",62,1,159,0)="   will be for a date range with the option of including discontinued"
^DIC(9.4,83,22,16,"PAH",62,1,160,0)="   and/or expired orders and various sort criteria, list by patient, by"
^DIC(9.4,83,22,16,"PAH",62,1,161,0)="   provider, by drug and by schedule, etc. It will be an 80-column report"
^DIC(9.4,83,22,16,"PAH",62,1,162,0)="   and will be queued to a printer."
^DIC(9.4,83,22,16,"PAH",62,1,163,0)="  "
^DIC(9.4,83,22,16,"PAH",62,1,164,0)="7. DEA DATA - Waived Practitioner Report [PSD DEA SUBOXONE]"
^DIC(9.4,83,22,16,"PAH",62,1,165,0)="   --------------------------------------------------------"
^DIC(9.4,83,22,16,"PAH",62,1,166,0)="   This option is a new option. This report provides a list of patients "
^DIC(9.4,83,22,16,"PAH",62,1,167,0)="   that were prescribed Suboxone drugs. Two views are available, one with"
^DIC(9.4,83,22,16,"PAH",62,1,168,0)="   details, and another with just the counts of Suboxone patients per"
^DIC(9.4,83,22,16,"PAH",62,1,169,0)="   prescriber. "
^DIC(9.4,83,22,16,"PAH",63,0)="72 SEQ #63^3140403.143259^17"
^DIC(9.4,83,22,16,"PAH",63,1,0)="^^12^12^3140403"
^DIC(9.4,83,22,16,"PAH",63,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,83,22,16,"PAH",63,1,2,0)="1. HD0000000438928 - Balance Adjustment Problem w/Activity Report"
^DIC(9.4,83,22,16,"PAH",63,1,3,0)="The Activity Report [PSD NURSE DISP REPORT] option does not print the"
^DIC(9.4,83,22,16,"PAH",63,1,4,0)="corrected drug balances for drugs that have a combination of Verify"
^DIC(9.4,83,22,16,"PAH",63,1,5,0)="Count, Sign Out Dose for Patient with a balance adjustment and then "
^DIC(9.4,83,22,16,"PAH",63,1,6,0)="Verify Count a second time."
^DIC(9.4,83,22,16,"PAH",63,1,7,0)=" "
^DIC(9.4,83,22,16,"PAH",63,1,8,0)="2. HD0000000457994 - RX not showing on report"
^DIC(9.4,83,22,16,"PAH",63,1,9,0)="When there are multiple transactions for the same date/time and"
^DIC(9.4,83,22,16,"PAH",63,1,10,0)="different pharmacy locations, not all of transactions show up on"
^DIC(9.4,83,22,16,"PAH",63,1,11,0)="the RX (Prescription) Outpatient Dispensing Report [PSD RX DISPENSING"
^DIC(9.4,83,22,16,"PAH",63,1,12,0)="REPORT]."
^DIC(9.4,83,22,16,"PAH",64,0)="75 SEQ #64^3141216.133507^17"
^DIC(9.4,83,22,16,"PAH",64,1,0)="^^9^9^3141216"
^DIC(9.4,83,22,16,"PAH",64,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,83,22,16,"PAH",64,1,2,0)=" "
^DIC(9.4,83,22,16,"PAH",64,1,3,0)="1. A portion of this report is not working correctly Rx (Prescription)"
^DIC(9.4,83,22,16,"PAH",64,1,4,0)="   Outpatient Dispensing Report"
^DIC(9.4,83,22,16,"PAH",64,1,5,0)=" "
^DIC(9.4,83,22,16,"PAH",64,1,6,0)="2. Destruction holding numbers do not appear on the Destroyed Drugs Report"
^DIC(9.4,83,22,16,"PAH",64,1,7,0)="   after being destroyed."
^DIC(9.4,83,22,16,"PAH",64,1,8,0)=" "
^DIC(9.4,83,22,16,"PAH",64,1,9,0)="3. Printing Issue"
^DIC(9.4,83,22,16,"PAH",65,0)="80 SEQ #65^3161118.172208^54"
^DIC(9.4,83,22,16,"PAH",65,1,0)="^^18^18^3161118"
^DIC(9.4,83,22,16,"PAH",65,1,1,0)="This patch addresses the following problems:"
^DIC(9.4,83,22,16,"PAH",65,1,2,0)=" "
^DIC(9.4,83,22,16,"PAH",65,1,3,0)="1. INC000000997119 - PRESCRIPTION TRANSACTION"
^DIC(9.4,83,22,16,"PAH",65,1,4,0)=" "
^DIC(9.4,83,22,16,"PAH",65,1,5,0)="Problem:"
^DIC(9.4,83,22,16,"PAH",65,1,6,0)="--------"
^DIC(9.4,83,22,16,"PAH",65,1,7,0)="If two outpatient prescription transaction are created at the same "
^DIC(9.4,83,22,16,"PAH",65,1,8,0)="date/time for the same pharmacy location, both will not display in the "
^DIC(9.4,83,22,16,"PAH",65,1,9,0)="Rx (Prescription) Outpatient Dispensing Report [PSD RX DISPENSING REPORT]."
^DIC(9.4,83,22,16,"PAH",65,1,10,0)=" "
^DIC(9.4,83,22,16,"PAH",65,1,11,0)=" "
^DIC(9.4,83,22,16,"PAH",65,1,12,0)="2. INC000001234782 - Ordered By Field"
^DIC(9.4,83,22,16,"PAH",65,1,13,0)=" "
^DIC(9.4,83,22,16,"PAH",65,1,14,0)="Problem:"
^DIC(9.4,83,22,16,"PAH",65,1,15,0)="--------"
^DIC(9.4,83,22,16,"PAH",65,1,16,0)="The CS WORKSHEET (#58.85) file ORDERED BY (#12) field is not being "
^DIC(9.4,83,22,16,"PAH",65,1,17,0)="updated correctly when someone edits a controlled substance order for an "
^DIC(9.4,83,22,16,"PAH",65,1,18,0)="NAOU using the CS Order Entry for Ward [PSD ORDER ENTRY] option."
^DIC(9.4,83,22,16,"PAH",66,0)="79 SEQ #66^3170928.152836^54"
^DIC(9.4,83,22,16,"PAH",66,1,0)="^^197^197^3170928"
^DIC(9.4,83,22,16,"PAH",66,1,1,0)="This patch addresses the following problems: "
^DIC(9.4,83,22,16,"PAH",66,1,2,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,3,0)="1. Return to Stock Issue "
^DIC(9.4,83,22,16,"PAH",66,1,4,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,5,0)="2. Return to stock entry not always accepted "
^DIC(9.4,83,22,16,"PAH",66,1,6,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,7,0)="3. Site Reporting Problems with Controlled Substance Green Sheets "
^DIC(9.4,83,22,16,"PAH",66,1,8,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,9,0)="4. Inventory Sheet inaccurate for Biloxi inpatient Vault  "
^DIC(9.4,83,22,16,"PAH",66,1,10,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,11,0)="5. Using option ""PSD DESTROY DRUGS"" to process a destruction cancellation,"
^DIC(9.4,83,22,16,"PAH",66,1,12,0)="   resulted in an error"
^DIC(9.4,83,22,16,"PAH",66,1,13,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,14,0)="ASSOCIATED REMEDY TICKET(S): "
^DIC(9.4,83,22,16,"PAH",66,1,15,0)="============================"
^DIC(9.4,83,22,16,"PAH",66,1,16,0)="1. I10091822FY16 - Return to Stock Issue "
^DIC(9.4,83,22,16,"PAH",66,1,17,0)="2. I10140662FY16 - Return to stock entry not always accepted "
^DIC(9.4,83,22,16,"PAH",66,1,18,0)="3. I10152355FY16 - Site reporting problems with Controlled Substance Green Sheets "
^DIC(9.4,83,22,16,"PAH",66,1,19,0)="4. R11999082FY17 - Inventory Sheet inaccurate for Biloxi inpatient Vault "
^DIC(9.4,83,22,16,"PAH",66,1,20,0)="5. Using option ""PSD DESTROY DRUGS"" to process a destruction cancellation,"
^DIC(9.4,83,22,16,"PAH",66,1,21,0)="   resulted in an error"
^DIC(9.4,83,22,16,"PAH",66,1,22,0)="6. I14905678FY17 - Similar issue as in R14730330FY17, but in the drug item"
^DIC(9.4,83,22,16,"PAH",66,1,23,0)="                   field (free text)"
^DIC(9.4,83,22,16,"PAH",66,1,24,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,25,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,26,0)="ASSOCIATED NSR(s): "
^DIC(9.4,83,22,16,"PAH",66,1,27,0)="=================="
^DIC(9.4,83,22,16,"PAH",66,1,28,0)="N/A "
^DIC(9.4,83,22,16,"PAH",66,1,29,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,30,0)="PARTICIPATING TEST SITES: "
^DIC(9.4,83,22,16,"PAH",66,1,31,0)="========================="
^DIC(9.4,83,22,16,"PAH",66,1,32,0)="OKLAHOMA CITY, OK"
^DIC(9.4,83,22,16,"PAH",66,1,33,0)="HUDSON VALLEY HCS "
^DIC(9.4,83,22,16,"PAH",66,1,34,0)="  "
^DIC(9.4,83,22,16,"PAH",66,1,35,0)="OVERVIEW: "
^DIC(9.4,83,22,16,"PAH",66,1,36,0)="========="
^DIC(9.4,83,22,16,"PAH",66,1,37,0)="1. I10091822FY16 - Return to Stock Issue "
^DIC(9.4,83,22,16,"PAH",66,1,38,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,39,0)="Problem: "
^DIC(9.4,83,22,16,"PAH",66,1,40,0)="--------"
^DIC(9.4,83,22,16,"PAH",66,1,41,0)="A Controlled Substance (CS) Refill is returned to stock through Outpatient"
^DIC(9.4,83,22,16,"PAH",66,1,42,0)="Pharmacy (OP) package. When prompted, the user selects NO to add the stock to"
^DIC(9.4,83,22,16,"PAH",66,1,43,0)="the balance in the Narcotic vault because the medication was going to be"
^DIC(9.4,83,22,16,"PAH",66,1,44,0)="destroyed if it is left in the pharmacy. (They cannot add it back to stock in"
^DIC(9.4,83,22,16,"PAH",66,1,45,0)="this case.)  The refill was marked as Returned to Stock in the OP package. "
^DIC(9.4,83,22,16,"PAH",66,1,46,0)="When the user re-submitted the refill, they tried to post it in the CS package."
^DIC(9.4,83,22,16,"PAH",66,1,47,0)="The system allows the user to release the refill in the OP package, but since"
^DIC(9.4,83,22,16,"PAH",66,1,48,0)="the refill had not been added back to inventory, the CS package did not"
^DIC(9.4,83,22,16,"PAH",66,1,49,0)="recognize that the refill had been filled again, and did not allow them to post"
^DIC(9.4,83,22,16,"PAH",66,1,50,0)="the refill.  "
^DIC(9.4,83,22,16,"PAH",66,1,51,0)="  "
^DIC(9.4,83,22,16,"PAH",66,1,52,0)="Resolution: "
^DIC(9.4,83,22,16,"PAH",66,1,53,0)="-----------"
^DIC(9.4,83,22,16,"PAH",66,1,54,0)="The routine PSDOPT0 that is called from the Outpatient Pharmacy system that"
^DIC(9.4,83,22,16,"PAH",66,1,55,0)="performs the Return To Stock for Controlled Substances will be modified to "
^DIC(9.4,83,22,16,"PAH",66,1,56,0)="account for a Controlled Substance drug that is being returned with the intent"
^DIC(9.4,83,22,16,"PAH",66,1,57,0)="to destroy.  "
^DIC(9.4,83,22,16,"PAH",66,1,58,0)="  "
^DIC(9.4,83,22,16,"PAH",66,1,59,0)="Technical: "
^DIC(9.4,83,22,16,"PAH",66,1,60,0)="----------"
^DIC(9.4,83,22,16,"PAH",66,1,61,0)="Routine PSDOPT0 will be modified to set the return to stock quantity to zero"
^DIC(9.4,83,22,16,"PAH",66,1,62,0)="if the user answers NO to the Do you want ## added to balance in the Narcotic"
^DIC(9.4,83,22,16,"PAH",66,1,63,0)="vault? Yes// prompt. (## is the quantity that that was dispensed) "
^DIC(9.4,83,22,16,"PAH",66,1,64,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,65,0)="2. I10140662FY16 - Return to stock entry not always accepted "
^DIC(9.4,83,22,16,"PAH",66,1,66,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,67,0)="Problem: "
^DIC(9.4,83,22,16,"PAH",66,1,68,0)="--------"
^DIC(9.4,83,22,16,"PAH",66,1,69,0)="When a pharmacist is entering return to stock in the Controlled substance "
^DIC(9.4,83,22,16,"PAH",66,1,70,0)="package, it is not being accepted if the user does not select a Controlled"
^DIC(9.4,83,22,16,"PAH",66,1,71,0)="Substance vault to return it to.  "
^DIC(9.4,83,22,16,"PAH",66,1,72,0)="  "
^DIC(9.4,83,22,16,"PAH",66,1,73,0)="Resolution: "
^DIC(9.4,83,22,16,"PAH",66,1,74,0)="-----------"
^DIC(9.4,83,22,16,"PAH",66,1,75,0)="The routine PSDOPT0 that performs the 'Return to Stock' for Controlled"
^DIC(9.4,83,22,16,"PAH",66,1,76,0)="Substances will be changed to force a user to select a Vault and not enter"
^DIC(9.4,83,22,16,"PAH",66,1,77,0)="past. The ""Prescription Not Returned to Stock"" message will also be displayed.  "
^DIC(9.4,83,22,16,"PAH",66,1,78,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,79,0)="Technical: "
^DIC(9.4,83,22,16,"PAH",66,1,80,0)="----------"
^DIC(9.4,83,22,16,"PAH",66,1,81,0)="Routine PSDOPT0 will be modified to exit properly without making any updates if"
^DIC(9.4,83,22,16,"PAH",66,1,82,0)="the user does not select a Controlled Substance vault to return the drug to.  "
^DIC(9.4,83,22,16,"PAH",66,1,83,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,84,0)="3. I10152355FY16 - SITE Reporting Problems with Controlled Substance "
^DIC(9.4,83,22,16,"PAH",66,1,85,0)="                   Green Sheets "
^DIC(9.4,83,22,16,"PAH",66,1,86,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,87,0)="Problem: "
^DIC(9.4,83,22,16,"PAH",66,1,88,0)="--------"
^DIC(9.4,83,22,16,"PAH",66,1,89,0)="The Green Sheet Ready for Pickup Log [PSD PRINT GS PICKUP] option does not show"
^DIC(9.4,83,22,16,"PAH",66,1,90,0)="all of the Green Sheets Ready for Pickup. This is caused when 2 users order the"
^DIC(9.4,83,22,16,"PAH",66,1,91,0)="same drug from the same Narcotics Area Of Use (NAOU) at the same time. This"
^DIC(9.4,83,22,16,"PAH",66,1,92,0)="results in multiple orders being assigned to the same request number for a drug"
^DIC(9.4,83,22,16,"PAH",66,1,93,0)="in the Drug Accountability Stats file (#58.8).  "
^DIC(9.4,83,22,16,"PAH",66,1,94,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,95,0)="Resolution: "
^DIC(9.4,83,22,16,"PAH",66,1,96,0)="-----------"
^DIC(9.4,83,22,16,"PAH",66,1,97,0)="The routines that create the entries in the Drug Accountability Stats file"
^DIC(9.4,83,22,16,"PAH",66,1,98,0)="(#58.8) will be modified to lock drug at the pharmacy location prior to"
^DIC(9.4,83,22,16,"PAH",66,1,99,0)="acquiring and setting request number in the Drug Accountability Stats file"
^DIC(9.4,83,22,16,"PAH",66,1,100,0)="(#58.8) during ordering.  "
^DIC(9.4,83,22,16,"PAH",66,1,101,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,102,0)="A post-install cleanup routine will search any transactions that have different"
^DIC(9.4,83,22,16,"PAH",66,1,103,0)="pharmacy dispensing numbers and the same Drug Accountability Stats file (#58.8)"
^DIC(9.4,83,22,16,"PAH",66,1,104,0)="request number. Once these transactions have been identified, a new request"
^DIC(9.4,83,22,16,"PAH",66,1,105,0)="number will be assigned and saved.  "
^DIC(9.4,83,22,16,"PAH",66,1,106,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,107,0)="An informational report will be sent in MailMan to all the users that hold the"
^DIC(9.4,83,22,16,"PAH",66,1,108,0)="PSDMGR security key.  "
^DIC(9.4,83,22,16,"PAH",66,1,109,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,110,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,111,0)="Example Report: Subj: PSD*3*79 TRANSACTION REPORT  [#141412] 04/18/12@14:49  15"
^DIC(9.4,83,22,16,"PAH",66,1,112,0)="lines From: PSD*3*79 POST INSTALL  In 'IN' basket.   Page 1  *New* "
^DIC(9.4,83,22,16,"PAH",66,1,113,0)="--------------------------------------------------------------------------"
^DIC(9.4,83,22,16,"PAH",66,1,114,0)="  This report contains Controlled Substance drugs that assigned multiple "
^DIC(9.4,83,22,16,"PAH",66,1,115,0)="  Pharmacy Dispensing numbers to a single request number in the Narcotics "
^DIC(9.4,83,22,16,"PAH",66,1,116,0)="  Area Of Use (NAOU) during order processing.  "
^DIC(9.4,83,22,16,"PAH",66,1,117,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,118,0)="  These transactions have been identified and corrected.  "
^DIC(9.4,83,22,16,"PAH",66,1,119,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,120,0)="NAOU                                       Pharmacy   Transaction    Old/New "
^DIC(9.4,83,22,16,"PAH",66,1,121,0)=" Drug Name                                Dispensing #   Number     Request # "
^DIC(9.4,83,22,16,"PAH",66,1,122,0)="=========================================================================="
^DIC(9.4,83,22,16,"PAH",66,1,123,0)="ECU-EAST "
^DIC(9.4,83,22,16,"PAH",66,1,124,0)=" LEVORPHANOL TARTRATE 2MG TAB               31359       347041         2/3 "
^DIC(9.4,83,22,16,"PAH",66,1,125,0)="                                            31360       347042         2/NA "
^DIC(9.4,83,22,16,"PAH",66,1,126,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,127,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,128,0)="***** End Of Report ***** "
^DIC(9.4,83,22,16,"PAH",66,1,129,0)="  "
^DIC(9.4,83,22,16,"PAH",66,1,130,0)="In case no transactions need to be fixed the Mailman message below will be"
^DIC(9.4,83,22,16,"PAH",66,1,131,0)="sent:"
^DIC(9.4,83,22,16,"PAH",66,1,132,0)="  "
^DIC(9.4,83,22,16,"PAH",66,1,133,0)="Subj: PSD*3*79 TRANSACTION REPORT  [#141414] 04/18/12@14:53  4 lines From:"
^DIC(9.4,83,22,16,"PAH",66,1,134,0)="PSD*3*79 POST INSTALL  In 'IN' basket.   Page 1  *New* "
^DIC(9.4,83,22,16,"PAH",66,1,135,0)="--------------------------------------------------------------------------"
^DIC(9.4,83,22,16,"PAH",66,1,136,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,137,0)="THERE WERE NO TRANSACTIONS TO REPORT.  "
^DIC(9.4,83,22,16,"PAH",66,1,138,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,139,0)="***** End Of Report ***** "
^DIC(9.4,83,22,16,"PAH",66,1,140,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,141,0)="Technical: "
^DIC(9.4,83,22,16,"PAH",66,1,142,0)="----------"
^DIC(9.4,83,22,16,"PAH",66,1,143,0)="^PSDEXGS1, ^PSDNTT1, ^PSDNTTP1, ^PSDOPT0, ^PSDOR2, ^PSDORD, ^PSDORD3, ^PSDORD4,"
^DIC(9.4,83,22,16,"PAH",66,1,144,0)="^PSDORN0, ^PSDORNO, ^PSDORP, ^PSDORP2 and ^PSDORV routines will be modified to"
^DIC(9.4,83,22,16,"PAH",66,1,145,0)="lock the pharmacy location at the drug level prior to acquiring and"
^DIC(9.4,83,22,16,"PAH",66,1,146,0)="incrementing the request number in the Drug Accountability Stats file (#58.8)"
^DIC(9.4,83,22,16,"PAH",66,1,147,0)="when a user orders a drug.  "
^DIC(9.4,83,22,16,"PAH",66,1,148,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,149,0)="4. R11999082FY17 - Inventory Sheet inaccurate for Biloxi inpatient Vault "
^DIC(9.4,83,22,16,"PAH",66,1,150,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,151,0)="Problem: "
^DIC(9.4,83,22,16,"PAH",66,1,152,0)="--------"
^DIC(9.4,83,22,16,"PAH",66,1,153,0)="When the user up-carets (^) out at the prompt, ""REASON EDITED"" during "
^DIC(9.4,83,22,16,"PAH",66,1,154,0)="Edit/Cancel Verified Orders [PSD EDIT/CANC VER ORD] option with the intent of"
^DIC(9.4,83,22,16,"PAH",66,1,155,0)="cancelling the request, it displays ""** No action taken. **"", indicating the"
^DIC(9.4,83,22,16,"PAH",66,1,156,0)="transaction was aborted. When you look at the master vault inventory, it has"
^DIC(9.4,83,22,16,"PAH",66,1,157,0)="been updated, however, the Controlled Substance order for the NAOU and the"
^DIC(9.4,83,22,16,"PAH",66,1,158,0)="green sheet are not updated, creating a discrepancy.  "
^DIC(9.4,83,22,16,"PAH",66,1,159,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,160,0)="Resolution: "
^DIC(9.4,83,22,16,"PAH",66,1,161,0)="-----------"
^DIC(9.4,83,22,16,"PAH",66,1,162,0)="The routine that performs the transaction updates has been modified to perform"
^DIC(9.4,83,22,16,"PAH",66,1,163,0)="all updates after all the user prompts. If the user up-carets (^) out then the"
^DIC(9.4,83,22,16,"PAH",66,1,164,0)="changes are aborted.  "
^DIC(9.4,83,22,16,"PAH",66,1,165,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,166,0)="Technical: "
^DIC(9.4,83,22,16,"PAH",66,1,167,0)="----------"
^DIC(9.4,83,22,16,"PAH",66,1,168,0)="Routine PSDEVO1 has been modified to update the master vault inventory, NAOU"
^DIC(9.4,83,22,16,"PAH",66,1,169,0)="Controlled Substance order and the green sheet only after the user completes"
^DIC(9.4,83,22,16,"PAH",66,1,170,0)="all the prompts."
^DIC(9.4,83,22,16,"PAH",66,1,171,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,172,0)="5. R14730330FY17 - Reporting event of errors that occurred during VISTA"
^DIC(9.4,83,22,16,"PAH",66,1,173,0)="                   operations"
^DIC(9.4,83,22,16,"PAH",66,1,174,0)="6. I14905678FY17 - Similar issue as in R14730330FY17, but in the drug item"
^DIC(9.4,83,22,16,"PAH",66,1,175,0)="                   field (free text)"
^DIC(9.4,83,22,16,"PAH",66,1,176,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,177,0)="Problem: "
^DIC(9.4,83,22,16,"PAH",66,1,178,0)="--------"
^DIC(9.4,83,22,16,"PAH",66,1,179,0)="When using the options, Non-VA Drug Placed on Hold for Destruction [PSD "
^DIC(9.4,83,22,16,"PAH",66,1,180,0)="DEST TEXT DRUG] and Destroy a Controlled Substances Drug [PSD DESTROY "
^DIC(9.4,83,22,16,"PAH",66,1,181,0)="DRUGS], entering a "";"" in a free text field such as drug item or the "
^DIC(9.4,83,22,16,"PAH",66,1,182,0)="comment field causes a hard error."
^DIC(9.4,83,22,16,"PAH",66,1,183,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,184,0)="Resolution: "
^DIC(9.4,83,22,16,"PAH",66,1,185,0)="-----------"
^DIC(9.4,83,22,16,"PAH",66,1,186,0)="To prevent the hard error, the drug item and the comment field will be"
^DIC(9.4,83,22,16,"PAH",66,1,187,0)="validated to not allow entry of a "";""."
^DIC(9.4,83,22,16,"PAH",66,1,188,0)="  "
^DIC(9.4,83,22,16,"PAH",66,1,189,0)="Technical: "
^DIC(9.4,83,22,16,"PAH",66,1,190,0)="----------"
^DIC(9.4,83,22,16,"PAH",66,1,191,0)="Routine PSDEST and PSDESTF will be modified to check for "";"" in the "
^DIC(9.4,83,22,16,"PAH",66,1,192,0)="comment field and to display a message, ""A semicolon is not allowed in the"
^DIC(9.4,83,22,16,"PAH",66,1,193,0)="COMMENTS field. Please edit your entry."""
^DIC(9.4,83,22,16,"PAH",66,1,194,0)=" "
^DIC(9.4,83,22,16,"PAH",66,1,195,0)="Routine PSDESTF will be modified to check for "";"" in the drug item field"
^DIC(9.4,83,22,16,"PAH",66,1,196,0)="and to display a message, ""A semicolon is not allowed in the DRUG ITEM"
^DIC(9.4,83,22,16,"PAH",66,1,197,0)="field. Please edit your entry."""
^DIC(9.4,83,22,16,"PAH",67,0)="81 SEQ #67^3170929.164435^54"
^DIC(9.4,83,22,16,"PAH",68,0)="82 SEQ #68^3180706.132048^54"
^DIC(9.4,83,22,16,"PAH",68,1,0)="^^2^2^3180706"
^DIC(9.4,83,22,16,"PAH",68,1,1,0)="NSR20160911 To allow PSD TECH ADV key holders to run the Controlled "
^DIC(9.4,83,22,16,"PAH",68,1,2,0)="Substances NAOU Usage Report."
^DIC(9.4,83,22,16,"PAH",69,0)="85 SEQ #69^3180706.143806^54"
^DIC(9.4,83,22,16,"PAH",69,1,0)="^^15^15^3180706"
^DIC(9.4,83,22,16,"PAH",69,1,1,0)="Defect Tracking System Ticket(s) & Overview:"
^DIC(9.4,83,22,16,"PAH",69,1,2,0)="--------------------------------------------"
^DIC(9.4,83,22,16,"PAH",69,1,3,0)="1. R19391179FY18  - Rx not showing on Rx Disp Report"
^DIC(9.4,83,22,16,"PAH",69,1,4,0)="  "
^DIC(9.4,83,22,16,"PAH",69,1,5,0)="Problem: "
^DIC(9.4,83,22,16,"PAH",69,1,6,0)="--------"
^DIC(9.4,83,22,16,"PAH",69,1,7,0)="Togus VA noticed a problem with a controlled substance prescription that"
^DIC(9.4,83,22,16,"PAH",69,1,8,0)="was filled locally and released but was not showing up on the Rx"
^DIC(9.4,83,22,16,"PAH",69,1,9,0)="(Prescription) Outpatient Dispensing Report [PSD RX DISPENSING REPORT] "
^DIC(9.4,83,22,16,"PAH",69,1,10,0)="report option. Upon further research it was determined that if a "
^DIC(9.4,83,22,16,"PAH",69,1,11,0)="prescription had at least one fill that was transmitted to CMOP (not yet"
^DIC(9.4,83,22,16,"PAH",69,1,12,0)="released) it would prevent all the prescription fills from being listed on"
^DIC(9.4,83,22,16,"PAH",69,1,13,0)="this report even though they could have been dispensed locally, which is the"
^DIC(9.4,83,22,16,"PAH",69,1,14,0)="purpose of the report, to list locally dispensed controlled substance"
^DIC(9.4,83,22,16,"PAH",69,1,15,0)="prescription fills that have not posted on the CS Vault inventory."
^DIC(9.4,83,22,16,"PAH",70,0)="83 SEQ #70^3180803.155008^54"
^DIC(9.4,83,22,16,"PAH",70,1,0)="^^2^2^3180803"
^DIC(9.4,83,22,16,"PAH",70,1,1,0)="Medication Prescribing and Dispensing Updates. Modification to Digitally "
^DIC(9.4,83,22,16,"PAH",70,1,2,0)="signed CS Orders Report."
^DIC(9.4,83,22,16,"PAH",71,0)="84 SEQ #71^3181204.154513^54"
^DIC(9.4,83,22,16,"PAH",71,1,0)="^^4^4^3181204"
^DIC(9.4,83,22,16,"PAH",71,1,1,0)="This patch is in support of two NSRs"
^DIC(9.4,83,22,16,"PAH",71,1,2,0)="NSR20171101 Controlled_Substance Narcotic Count Input"
^DIC(9.4,83,22,16,"PAH",71,1,3,0)="NSR20171111 Pharmacy Activity Report Sched II Meds"
^DIC(9.4,83,22,16,"PAH",71,1,4,0)="See forum for a complete description of this patch PSD*3.0*84"
^DIC(9.4,83,22,16,"PAH",72,0)="87 SEQ #72^3190301.153822^54"
^DIC(9.4,83,22,16,"PAH",72,1,0)="^^11^11^3190301"
^DIC(9.4,83,22,16,"PAH",72,1,1,0)="This patch for a patch is created in support of PSD*3.0*84. "
^DIC(9.4,83,22,16,"PAH",72,1,2,0)="PSD*3.0*84 added the BALANCE DISCREPANCY CHECK field (#37) to the DRUG "
^DIC(9.4,83,22,16,"PAH",72,1,3,0)="ACCOUNTABILITY STATS file (#58.8). Routine PSDEN is used to display "
^DIC(9.4,83,22,16,"PAH",72,1,4,0)="fields from this file for editing based on when the 'Location Type' field "
^DIC(9.4,83,22,16,"PAH",72,1,5,0)="is set to 'MASTER VAULT'. After release of PSD*3.0*84 it was discovered "
^DIC(9.4,83,22,16,"PAH",72,1,6,0)="that if another field 'PRIME VENDOR' was set to NO or null the BALANCE "
^DIC(9.4,83,22,16,"PAH",72,1,7,0)="DISCREPANCY CHECK field would not display as expected. This patch "
^DIC(9.4,83,22,16,"PAH",72,1,8,0)="PSD*3.0*87 will allow the field the BALANCE DISCREPANCY CHECK fiel #37"
^DIC(9.4,83,22,16,"PAH",72,1,9,0)="to be edited regardless of the state of the PRIME VENDOR field #12, while "
^DIC(9.4,83,22,16,"PAH",72,1,10,0)="maintaining the original branching flow connected to the PRIME VENDOR "
^DIC(9.4,83,22,16,"PAH",72,1,11,0)="field."
^DIC(9.4,83,22,16,"PAH",73,0)="88 SEQ #73^3190815.160652^65"
^DIC(9.4,83,22,16,"PAH",73,1,0)="^^2^2^3190815"
^DIC(9.4,83,22,16,"PAH",73,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,83,22,16,"PAH",73,1,2,0)="under PSD*3.0*88."
^DIC(9.4,83,22,16,"PAH",74,0)="90 SEQ #74^3210218.143929^17"
^DIC(9.4,83,22,16,"PAH",74,1,0)="^^7^7^3210218"
^DIC(9.4,83,22,16,"PAH",74,1,1,0)="This patch will fix 3 incidents. Two of these will address an issue that "
^DIC(9.4,83,22,16,"PAH",74,1,2,0)="occurs after a controlled substance is returned to stock and users are"
^DIC(9.4,83,22,16,"PAH",74,1,3,0)="able to update the CS vault without the reprinting of the Rx label. The"
^DIC(9.4,83,22,16,"PAH",74,1,4,0)="other incident that will be addressed is when an CS Rx has been released"
^DIC(9.4,83,22,16,"PAH",74,1,5,0)="by the Outpatient Pharmacy package after the CS has been returned to stock"
^DIC(9.4,83,22,16,"PAH",74,1,6,0)="and the label reprinted, users are unable to update the CS vault "
^DIC(9.4,83,22,16,"PAH",74,1,7,0)="inventory."
^DIC(9.4,83,22,16,"PAH",75,0)="89 SEQ #75^3211119.15273^17"
^DIC(9.4,83,22,16,"PAH",75,1,0)="^^9^9^3211119"
^DIC(9.4,83,22,16,"PAH",75,1,1,0)="This patch contains updates to the following reports to support eRx:"
^DIC(9.4,83,22,16,"PAH",75,1,2,0)=" - Controlled Substance Prescriptions Report [PSD CS PRESCRIPTIONS REPORT]"
^DIC(9.4,83,22,16,"PAH",75,1,3,0)=" -  OP CS Orders Report [PSD DIGITALLY SIGNED ORDERS]"
^DIC(9.4,83,22,16,"PAH",75,1,4,0)=" -  OP Released Rx Report [PSD DIG. SIGNED RELEASED RX]"
^DIC(9.4,83,22,16,"PAH",75,1,5,0)="In addition, the Option Menu Text was changed for the following Options:"
^DIC(9.4,83,22,16,"PAH",75,1,6,0)=" - Digitally Signed CS Orders Report [PSD DIGITALLY SIGNED ORDERS]"
^DIC(9.4,83,22,16,"PAH",75,1,7,0)="   Changed Text: OP CS Orders Report [PSD DIGITALLY SIGNED ORDERS]"
^DIC(9.4,83,22,16,"PAH",75,1,8,0)=" - Digitally Signed OP Released Rx Report [PSD DIG. SIGNED RELEASED RX]"
^DIC(9.4,83,22,16,"PAH",75,1,9,0)="   Changed Text: OP Released Rx Report [PSD DIG. SIGNED RELEASED RX]"
^DIC(9.4,83,22,16,"PAH",76,0)="92 SEQ #76^3220518.165613^86"
^DIC(9.4,83,22,16,"PAH",76,1,0)="^^4^4^3220518"
^DIC(9.4,83,22,16,"PAH",76,1,1,0)="This patch will fix the following issue:"
^DIC(9.4,83,22,16,"PAH",76,1,2,0)=" "
^DIC(9.4,83,22,16,"PAH",76,1,3,0)="The Controlled Substance's Balance Discrepancy Check does not count a "
^DIC(9.4,83,22,16,"PAH",76,1,4,0)="quantity entered that contains a decimal as an attemnpt."
^DIC(9.4,83,22,16,"PAH",77,0)="93 SEQ #77^3230919.111638^89"
^DIC(9.4,83,22,16,"PAH",77,1,0)="^^6^6^3230919"
^DIC(9.4,83,22,16,"PAH",77,1,1,0)="This patch will fix the following issue:"
^DIC(9.4,83,22,16,"PAH",77,1,2,0)=" "
^DIC(9.4,83,22,16,"PAH",77,1,3,0)="An issue was reported that when using the VistA option Outpatient Rx's "
^DIC(9.4,83,22,16,"PAH",77,1,4,0)="[PSD OUTPATIENT] to sign out a controlled substance after a refill was "
^DIC(9.4,83,22,16,"PAH",77,1,5,0)="previously returned to stock, a user is presented with the opportunity to "
^DIC(9.4,83,22,16,"PAH",77,1,6,0)="sign out the original fill even though it had previously been signed out."
^DIC(9.4,83,22,16,"PAH",78,0)="94 SEQ #78^3231206.154035^89"
^DIC(9.4,83,22,16,"PAH",78,1,0)="^^1^1^3231206"
^DIC(9.4,83,22,16,"PAH",78,1,1,0)="Please see FORUM for PSD*3.0*94 patch description."
