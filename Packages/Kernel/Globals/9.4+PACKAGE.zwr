^DIC(9.4,47,22,5.9,"PAH",737,1,5,0)="Changed label Temporary Address to Temporary Mailing Address"
^DIC(9.4,47,22,5.9,"PAH",737,1,6,0)="Display Residential Address"
^DIC(9.4,47,22,5.9,"PAH",737,1,7,0)="Expanded Health Benefit Plan details"
