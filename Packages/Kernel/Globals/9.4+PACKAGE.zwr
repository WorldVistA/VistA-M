^DIC(9.4,11,22,5.03,"PAH",24,1,333,0)="------------------------------"
^DIC(9.4,11,22,5.03,"PAH",24,1,334,0)=" "
^DIC(9.4,11,22,5.03,"PAH",24,1,335,0)=" "
^DIC(9.4,11,22,5.03,"PAH",24,1,336,0)="  The post-instructions for installation of the software are included in"
^DIC(9.4,11,22,5.03,"PAH",24,1,337,0)="  the installation guide."
^DIC(9.4,11,22,5.03,"PAH",24,1,338,0)="  "
^DIC(9.4,11,22,5.03,"PAH",24,1,339,0)=" "
^DIC(9.4,11,22,5.03,"PAH",24,1,340,0)="INSTALLATION EXAMPLE"
