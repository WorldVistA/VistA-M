^DIC(9.4,100,22,15,"PAH",31,1,258,0)=""
^DIC(9.4,100,22,15,"PAH",31,1,259,0)="Example:"
^DIC(9.4,100,22,15,"PAH",31,1,260,0)="Input"
^DIC(9.4,100,22,15,"PAH",31,1,261,0)="-----"
