^DIC(9.4,162,22,1,"PAH",15,1,3,0)="USR*1.0*16."
^DIC(9.4,162,22,1,"PAH",16,0)="17 SEQ #16^3001127^1"
^DIC(9.4,162,22,1,"PAH",16,1,0)="^^2^2^3001127"
