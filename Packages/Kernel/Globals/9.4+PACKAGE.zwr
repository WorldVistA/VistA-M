^DIC(9.4,3,22,21,"PAH",614,0)="801 SEQ #647^3250324.122246^90"
^DIC(9.4,3,22,21,"PAH",614,1,0)="^^1^1^3250324"
^DIC(9.4,3,22,21,"PAH",614,1,1,0)="Kernel patch XU*8*801, FIX ALERTS for SURROGATES and TERMINATED"
^DIC(9.4,3,22,21,"PAH",615,0)="761 SEQ #648^3250324.12252^90"
^DIC(9.4,3,22,21,"PAH",615,1,0)="^^6^6^3250324"
^DIC(9.4,3,22,21,"PAH",615,1,1,0)="This patch fixes some issues found with the TaskMan Sync Flag "
^DIC(9.4,3,22,21,"PAH",615,1,2,0)="functionality.  A bug has been found with the XUTM SYNC option where the "
^DIC(9.4,3,22,21,"PAH",615,1,3,0)="calls that pass Sync Flag and the ZIO are flipped, thus not working as"
^DIC(9.4,3,22,21,"PAH",615,1,4,0)="intended.  Also, an overall analysis of the Sync Flag functionality"
^DIC(9.4,3,22,21,"PAH",615,1,5,0)="throughout TaskMan is being done to see if other bugs exist that hinder"
^DIC(9.4,3,22,21,"PAH",615,1,6,0)="its use."
^DIC(9.4,3,22,21,"PAH",616,0)="808 SEQ #649^3250324.123814^90"
^DIC(9.4,3,22,21,"PAH",616,1,0)="^^3^3^3250324"
^DIC(9.4,3,22,21,"PAH",616,1,1,0)="This build transports the $I field (#1) of the DEVICE (#3.5) file. The "
^DIC(9.4,3,22,21,"PAH",616,1,2,0)="field is modified to have a maximum lengh of 250 in order to support "
^DIC(9.4,3,22,21,"PAH",616,1,3,0)="devices coresponding to Linux path names."
^DIC(9.4,3,22,21,"PAH",617,0)="801b^3250430.100807^90"
