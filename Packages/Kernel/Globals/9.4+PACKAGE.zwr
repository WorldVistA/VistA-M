^DIC(9.4,14,22,5.9,"PAH",154,1,202,0)="ROUTINE SUMMARY:"
^DIC(9.4,14,22,5.9,"PAH",154,1,203,0)="================"
^DIC(9.4,14,22,5.9,"PAH",154,1,204,0)="The following is a list of the routine(s) included in this patch.  The"
^DIC(9.4,14,22,5.9,"PAH",154,1,205,0)="second line of each of these routine(s) will look like:"
^DIC(9.4,14,22,5.9,"PAH",154,1,206,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,207,0)="   <tab>;;5.2;LAB SERVICE;**[patch list]**;Sep 27, 1994"
^DIC(9.4,14,22,5.9,"PAH",154,1,208,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,209,0)="                          CHECK^XTSUMBLD results"
^DIC(9.4,14,22,5.9,"PAH",154,1,210,0)="Routine name    Before Patch          After Patch          Patch List"
^DIC(9.4,14,22,5.9,"PAH",154,1,211,0)="============    ============          ===========          =========="
^DIC(9.4,14,22,5.9,"PAH",154,1,212,0)="LR257              NONE                 2442358               257(Deleted by"
^DIC(9.4,14,22,5.9,"PAH",154,1,213,0)="                                                                  KIDS) "
^DIC(9.4,14,22,5.9,"PAH",154,1,214,0)="LRMITSE          6478419                8737276              96,257"
^DIC(9.4,14,22,5.9,"PAH",154,1,215,0)="LRMITSES         7787667                7819718              96,257"
^DIC(9.4,14,22,5.9,"PAH",154,1,216,0)="LRMITSPE         6091299                7314510              96,257"
^DIC(9.4,14,22,5.9,"PAH",154,1,217,0)="LRMITSPS         3052409                3271788               257"
^DIC(9.4,14,22,5.9,"PAH",154,1,218,0)="LRMITSR          11570196               11570170             96,257"
^DIC(9.4,14,22,5.9,"PAH",154,1,219,0)="LRMITSRH         2059425                2320614               257"
^DIC(9.4,14,22,5.9,"PAH",154,1,220,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,221,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,222,0)="INSTALLATION INSTRUCTIONS"
^DIC(9.4,14,22,5.9,"PAH",154,1,223,0)="========================="
^DIC(9.4,14,22,5.9,"PAH",154,1,224,0)="  The install time for this patch is less than 5 minutes.  This patch"
^DIC(9.4,14,22,5.9,"PAH",154,1,225,0)="  can be installed when Laboratory users are on the system."
^DIC(9.4,14,22,5.9,"PAH",154,1,226,0)="  Suggested time to install:  non-peak requirement hours."
^DIC(9.4,14,22,5.9,"PAH",154,1,227,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,228,0)="      Patch installation needs to be coordinated with the Laboratory"
^DIC(9.4,14,22,5.9,"PAH",154,1,229,0)="      Information Manager (LIM/ADPAC)."
^DIC(9.4,14,22,5.9,"PAH",154,1,230,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,231,0)="  1.  If any of the above routines are mapped, disable mapping for them."
^DIC(9.4,14,22,5.9,"PAH",154,1,232,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,233,0)="  2.  Use the 'INSTALL/CHECK MESSAGE' option of the PackMan menu.  This"
^DIC(9.4,14,22,5.9,"PAH",154,1,234,0)="      option will load the KIDS patch onto your system."
^DIC(9.4,14,22,5.9,"PAH",154,1,235,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,236,0)="  3.  On the 'Kernel Installation & Distribution System' Menu (KIDS),"
^DIC(9.4,14,22,5.9,"PAH",154,1,237,0)="      select the 'Installation ' menu."
^DIC(9.4,14,22,5.9,"PAH",154,1,238,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,239,0)="  4.  Use the 'Verify Checksum in Transport Global' option and verify that"
^DIC(9.4,14,22,5.9,"PAH",154,1,240,0)="      all routines have the correct checksums."
^DIC(9.4,14,22,5.9,"PAH",154,1,241,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,242,0)="  5.  On the KIDS menu, under the 'Installation' menu, use the following"
^DIC(9.4,14,22,5.9,"PAH",154,1,243,0)="      options:"
^DIC(9.4,14,22,5.9,"PAH",154,1,244,0)="        Print Transport Global"
^DIC(9.4,14,22,5.9,"PAH",154,1,245,0)="        Compare Transport Global to Current System"
^DIC(9.4,14,22,5.9,"PAH",154,1,246,0)="        Backup a Transport Global"
^DIC(9.4,14,22,5.9,"PAH",154,1,247,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,248,0)="  6.  Use the 'Install Package(s)' option under the 'Installation' menu"
^DIC(9.4,14,22,5.9,"PAH",154,1,249,0)="      and select the package 'LR*5.2*257'.  When prompted 'Want KIDS to"
^DIC(9.4,14,22,5.9,"PAH",154,1,250,0)="      INHIBIT LOGONS during the install? YES//', choose 'NO'.  When prompted"
^DIC(9.4,14,22,5.9,"PAH",154,1,251,0)="      'Want to DISABLE Scheduled Options, Menu Options, and Protocols?"
^DIC(9.4,14,22,5.9,"PAH",154,1,252,0)="      YES//', choose 'NO'.  When prompted 'Want KIDS to Rebuild Menu Trees"
^DIC(9.4,14,22,5.9,"PAH",154,1,253,0)="      Upon Completion of Install? YES//""', choose 'NO'."
^DIC(9.4,14,22,5.9,"PAH",154,1,254,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,255,0)="  7.  On a mapped system, rebuild your map set."
^DIC(9.4,14,22,5.9,"PAH",154,1,256,0)=""
^DIC(9.4,14,22,5.9,"PAH",154,1,257,0)="NOTE:  Routine LR257 will be deleted after successful patch installation."
^DIC(9.4,14,22,5.9,"PAH",155,0)="323 SEQ #253^3050905^1"
^DIC(9.4,14,22,5.9,"PAH",155,1,0)="^^2^2^3050905"
^DIC(9.4,14,22,5.9,"PAH",155,1,1,0)="During the verification of Micro Data, an undefined error has occurred at "
^DIC(9.4,14,22,5.9,"PAH",155,1,2,0)="line APP+5^LRMIUT1. This patch corrects this defect."
^DIC(9.4,14,22,5.9,"PAH",156,0)="330 SEQ #254^3050905^1"
^DIC(9.4,14,22,5.9,"PAH",156,1,0)="^^214^214^3050905"
^DIC(9.4,14,22,5.9,"PAH",156,1,1,0)="Blood Bank Clearance"
^DIC(9.4,14,22,5.9,"PAH",156,1,2,0)="==================== "
^DIC(9.4,14,22,5.9,"PAH",156,1,3,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,4,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*330 does not"
^DIC(9.4,14,22,5.9,"PAH",156,1,5,0)="contain any changes to the VISTA BLOOD BANK Software as defined by VHA"
^DIC(9.4,14,22,5.9,"PAH",156,1,6,0)="DIRECTIVE 2004-058 titled VISTA BLOOD BANK SOFTWARE VERSION 5.2."
^DIC(9.4,14,22,5.9,"PAH",156,1,7,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,8,0)="EFFECT ON BLOOD BANK FUNCTIONAL REQUIREMENTS: Patch LR*5.2*330 does not"
^DIC(9.4,14,22,5.9,"PAH",156,1,9,0)="alter or modify any software design safeguards or safety critical elements"
^DIC(9.4,14,22,5.9,"PAH",156,1,10,0)="functions."
^DIC(9.4,14,22,5.9,"PAH",156,1,11,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,12,0)="RISK ANALYSIS: Changes made by patch LR*5.2*330 have no effect on Blood"
^DIC(9.4,14,22,5.9,"PAH",156,1,13,0)="Bank software functionality, therefore RISK is none."
^DIC(9.4,14,22,5.9,"PAH",156,1,14,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,15,0)="VALIDATION REQUIREMENTS BY OPTION: Because of the nature of the changes"
^DIC(9.4,14,22,5.9,"PAH",156,1,16,0)="made, no specific validation requirements exist as a result of installation"
^DIC(9.4,14,22,5.9,"PAH",156,1,17,0)="of this patch."
^DIC(9.4,14,22,5.9,"PAH",156,1,18,0)="--------------------------------------------------------------------------"
^DIC(9.4,14,22,5.9,"PAH",156,1,19,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,20,0)="   "
^DIC(9.4,14,22,5.9,"PAH",156,1,21,0)="NOIS FAV-0105-71385 reported the inability to verify Laboratory Electronic"
^DIC(9.4,14,22,5.9,"PAH",156,1,22,0)="Data Interchange (LEDI) results when one or all of the lab results being"
^DIC(9.4,14,22,5.9,"PAH",156,1,23,0)="processed have 'comment' as the result. Functionality, released in patch"
^DIC(9.4,14,22,5.9,"PAH",156,1,24,0)="LR*5.2*286, to prevent editing of reference laboratory results using option"
^DIC(9.4,14,22,5.9,"PAH",156,1,25,0)="Enter/verify data (auto instrument) [LRVR] prevented user from releasing"
^DIC(9.4,14,22,5.9,"PAH",156,1,26,0)="LEDI results."
^DIC(9.4,14,22,5.9,"PAH",156,1,27,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,28,0)="NOIS ASH-0105-31055 reported the inability to verify LEDI results when"
^DIC(9.4,14,22,5.9,"PAH",156,1,29,0)="one or all of the lab results being processed have 'canc' as the"
^DIC(9.4,14,22,5.9,"PAH",156,1,30,0)="result. Functionality, released in patch LR*5.2*286, to prevent"
^DIC(9.4,14,22,5.9,"PAH",156,1,31,0)="editing of reference laboratory results using option Enter/verify data"
^DIC(9.4,14,22,5.9,"PAH",156,1,32,0)="(auto instrument) [LRVR] prevented user from releasing LEDI results."
^DIC(9.4,14,22,5.9,"PAH",156,1,33,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,34,0)="This patch allows users verifying reference laboratory results to"
^DIC(9.4,14,22,5.9,"PAH",156,1,35,0)="release results that consist only of 'comment' or 'canc' type results."
^DIC(9.4,14,22,5.9,"PAH",156,1,36,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,37,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,38,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,39,0)=" ASSOCIATED E3R"
^DIC(9.4,14,22,5.9,"PAH",156,1,40,0)=" --------------"
^DIC(9.4,14,22,5.9,"PAH",156,1,41,0)=" None"
^DIC(9.4,14,22,5.9,"PAH",156,1,42,0)=" "
^DIC(9.4,14,22,5.9,"PAH",156,1,43,0)=" ASSOCIATED NOIS"
^DIC(9.4,14,22,5.9,"PAH",156,1,44,0)=" ---------------"
^DIC(9.4,14,22,5.9,"PAH",156,1,45,0)=" ASH-0105-31055/Remedy ticket HD0000000071185"
^DIC(9.4,14,22,5.9,"PAH",156,1,46,0)=" FAV-0105-71385/Remedy ticket HD0000000071204"
