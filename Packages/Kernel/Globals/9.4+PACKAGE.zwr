^DIC(9.4,4,22,1,"PAH",155,0)="185 SEQ #180^3010608^1"
^DIC(9.4,4,22,1,"PAH",155,1,0)="^^57^57^3010608"
^DIC(9.4,4,22,1,"PAH",155,1,1,0)="Patch XM*7.1*185"
^DIC(9.4,4,22,1,"PAH",155,1,2,0)=""
^DIC(9.4,4,22,1,"PAH",155,1,3,0)="NOIS: REN-0501-61987"
^DIC(9.4,4,22,1,"PAH",155,1,4,0)="Test Site:  Reno, NV"
^DIC(9.4,4,22,1,"PAH",155,1,5,0)="If you create a broadcast message and enter ""Later"" at the ""Transmit"""
^DIC(9.4,4,22,1,"PAH",155,1,6,0)="prompt to send the message later, the job is tasked, but the message"
^DIC(9.4,4,22,1,"PAH",155,1,7,0)="never gets sent.  This patch fixes it so that it does get sent."
^DIC(9.4,4,22,1,"PAH",155,1,8,0)=""
^DIC(9.4,4,22,1,"PAH",155,1,9,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,1,"PAH",155,1,10,0)="is at a minimum.  It requires MailMan patch XM*7.1*177."
^DIC(9.4,4,22,1,"PAH",155,1,11,0)="============================================================================ "
^DIC(9.4,4,22,1,"PAH",155,1,12,0)=""
^DIC(9.4,4,22,1,"PAH",155,1,13,0)="ROUTINES:"
^DIC(9.4,4,22,1,"PAH",155,1,14,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,1,"PAH",155,1,15,0)="       ;;7.1;MailMan;**[patch list]**;Jun 02, 1994"
^DIC(9.4,4,22,1,"PAH",155,1,16,0)=" "
^DIC(9.4,4,22,1,"PAH",155,1,17,0)="             Before       After"
^DIC(9.4,4,22,1,"PAH",155,1,18,0)="Name         Checksum     Checksum     Patch List"
^DIC(9.4,4,22,1,"PAH",155,1,19,0)="----------------------------------------------------------------------"
^DIC(9.4,4,22,1,"PAH",155,1,20,0)="XMXSEND      10382185     10773097     50,106,107,116,168,177,185"
^DIC(9.4,4,22,1,"PAH",155,1,21,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,1,"PAH",155,1,22,0)=""
^DIC(9.4,4,22,1,"PAH",155,1,23,0)="This patch introduces no new routines."
