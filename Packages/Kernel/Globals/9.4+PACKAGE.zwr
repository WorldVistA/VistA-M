^DIC(9.4,4,22,2,"PAH",17,0)="17 SEQ #17^3030430^1"
^DIC(9.4,4,22,2,"PAH",17,1,0)="^^59^59^3030430"
^DIC(9.4,4,22,2,"PAH",17,1,1,0)="Patch XM*8.0*17"
^DIC(9.4,4,22,2,"PAH",17,1,2,0)=""
^DIC(9.4,4,22,2,"PAH",17,1,3,0)="NOIS: MWV-0403-20860"
^DIC(9.4,4,22,2,"PAH",17,1,4,0)="Test Site: Martinsburg, WV"
^DIC(9.4,4,22,2,"PAH",17,1,5,0)=""
^DIC(9.4,4,22,2,"PAH",17,1,6,0)="P-MESSAGE assumes that if there are more than 66 consecutive null lines in a"
^DIC(9.4,4,22,2,"PAH",17,1,7,0)="print-out, that we must have reached the EOF.  This patch changes that limit"
^DIC(9.4,4,22,2,"PAH",17,1,8,0)="to 250."
^DIC(9.4,4,22,2,"PAH",17,1,9,0)=""
^DIC(9.4,4,22,2,"PAH",17,1,10,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",17,1,11,0)="is at a minimum.  It requires MailMan patch XM*8.0*2."
^DIC(9.4,4,22,2,"PAH",17,1,12,0)="============================================================================ "
^DIC(9.4,4,22,2,"PAH",17,1,13,0)=""
^DIC(9.4,4,22,2,"PAH",17,1,14,0)="ROUTINES:"
^DIC(9.4,4,22,2,"PAH",17,1,15,0)="The second line of the routine now looks like:"
^DIC(9.4,4,22,2,"PAH",17,1,16,0)="       ;;8.0;MailMan;**[patch list]**;Jun 28, 2002"
^DIC(9.4,4,22,2,"PAH",17,1,17,0)=""
^DIC(9.4,4,22,2,"PAH",17,1,18,0)="              Before          After"
^DIC(9.4,4,22,2,"PAH",17,1,19,0)="Name          Checksum        Checksum        Patch List"
^DIC(9.4,4,22,2,"PAH",17,1,20,0)="------------------------------------------------------------------"
^DIC(9.4,4,22,2,"PAH",17,1,21,0)="XMAPHOST       9091852         9096253        2,17"
^DIC(9.4,4,22,2,"PAH",17,1,22,0)="* Checksums produced by CHECK^XTSUMBLD"
^DIC(9.4,4,22,2,"PAH",17,1,23,0)=""
