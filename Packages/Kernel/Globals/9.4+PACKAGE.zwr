^DIC(9.4,14,22,5.9,"PAH",99,1,292,0)="   LRLABELA         2536685        1741393        **161,218**"
^DIC(9.4,14,22,5.9,"PAH",99,1,293,0)="   LRLABELB         6023279        5187746        **161,218**"
^DIC(9.4,14,22,5.9,"PAH",99,1,294,0)="   LRLABELD         N/A            3621894        **218**"
^DIC(9.4,14,22,5.9,"PAH",99,1,295,0)="   LRLABELE         N/A            6156659        **218**"
^DIC(9.4,14,22,5.9,"PAH",99,1,296,0)="   LRLABELG         N/A            1534246        **218**"
^DIC(9.4,14,22,5.9,"PAH",99,1,297,0)="   LRLABLD          8089099        7185434        **65,161,218**"
^DIC(9.4,14,22,5.9,"PAH",99,1,298,0)="   LRLABLD0         9351158        9284158        **1,65,121,161,218**"
^DIC(9.4,14,22,5.9,"PAH",99,1,299,0)="   LRLABLDS         4835286        4940823        **161,218**"
