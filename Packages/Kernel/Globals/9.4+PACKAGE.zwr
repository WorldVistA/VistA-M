^DIC(9.4,197,22,1,"PAH",28,1,182,0)="===================="
^DIC(9.4,197,22,1,"PAH",28,1,183,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,184,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,185,0)="The second line of each of these routines now looks like:"
^DIC(9.4,197,22,1,"PAH",28,1,186,0)=" ;;1.0;CLINICAL PROCEDURES;**[Patch List]**;Apr 01, 2004;Build 7"
^DIC(9.4,197,22,1,"PAH",28,1,187,0)=" "
^DIC(9.4,197,22,1,"PAH",28,1,188,0)="The checksums below are new checksums, and"
^DIC(9.4,197,22,1,"PAH",28,1,189,0)=" can be checked with CHECK1^XTSUMBLD."
^DIC(9.4,197,22,1,"PAH",28,1,190,0)=" "
