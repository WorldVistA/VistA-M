^DIC(9.4,60,22,13,"PAH",625,1,148,0)=" "
^DIC(9.4,60,22,13,"PAH",625,1,149,0)="1. Patient address and primary phone displayed on the Single eRx View screen"
^DIC(9.4,60,22,13,"PAH",625,1,150,0)="   ---------------------------------------------------------------------------"
^DIC(9.4,60,22,13,"PAH",625,1,151,0)="   To easily confirm the patient's identity, the patient's address and"
^DIC(9.4,60,22,13,"PAH",625,1,152,0)="   phone number are included on both the eRx and VistA sides of the Single"
^DIC(9.4,60,22,13,"PAH",625,1,153,0)="   eRx View/Display landing page, as shown below (without the reverse or"
^DIC(9.4,60,22,13,"PAH",625,1,154,0)="   highlighted video features)."
