^DIC(9.4,14,22,5.9,"PAH",281,1,418,0)="COLLECT THURSDAY: YES// "
^DIC(9.4,14,22,5.9,"PAH",281,1,419,0)="COLLECT FRIDAY: YES// "
^DIC(9.4,14,22,5.9,"PAH",281,1,420,0)="COLLECT SATURDAY: YES// "
^DIC(9.4,14,22,5.9,"PAH",281,1,421,0)="COLLECT SUNDAY: YES// "
^DIC(9.4,14,22,5.9,"PAH",281,1,422,0)="IGNORE HOLIDAYS: YES// "
