^DIC(9.4,4,22,2,"PAH",11,1,0)="^^76^76^3030123"
^DIC(9.4,4,22,2,"PAH",11,1,1,0)="Patch XM*8.0*10"
^DIC(9.4,4,22,2,"PAH",11,1,2,0)=""
^DIC(9.4,4,22,2,"PAH",11,1,3,0)="NOIS: CPH-0601-42716"
^DIC(9.4,4,22,2,"PAH",11,1,4,0)="Test Site: Central Plains HCS"
^DIC(9.4,4,22,2,"PAH",11,1,5,0)=""
^DIC(9.4,4,22,2,"PAH",11,1,6,0)="This patch corrects the check to see if a device is a Video Terminal."
^DIC(9.4,4,22,2,"PAH",11,1,7,0)="Video Terminal names *start* with ""C-"".  The check now reflects this."
^DIC(9.4,4,22,2,"PAH",11,1,8,0)="(Previously, MailMan assumed, wrongly, that if the device name *contained*"
^DIC(9.4,4,22,2,"PAH",11,1,9,0)="""C-"", that it was a Video Terminal.)"
^DIC(9.4,4,22,2,"PAH",11,1,10,0)=""
^DIC(9.4,4,22,2,"PAH",11,1,11,0)="NOTE: This patch should be installed during off hours, when user activity"
^DIC(9.4,4,22,2,"PAH",11,1,12,0)="is at a minimum. It requires MailMan patches XM*8.0*6 and XM*8.0*8."
^DIC(9.4,4,22,2,"PAH",11,1,13,0)="============================================================================ "
^DIC(9.4,4,22,2,"PAH",11,1,14,0)=""
