^DIC(9.4,233,0)="CAPACITY MANAGEMENT^KMP^Capacity and resource measurements for software & hardware"
^DIC(9.4,233,20,0)="^9.402P^^"
^DIC(9.4,233,22,0)="^9.49I^2^2"
^DIC(9.4,233,22,1,0)="4.0"
^DIC(9.4,233,22,1,"PAH",0)="^9.4901^6^6"
^DIC(9.4,233,22,1,"PAH",1,0)="0^3180501.141314^54"
^DIC(9.4,233,22,1,"PAH",1,1,0)="^9.49011^10^10^3180501"
^DIC(9.4,233,22,1,"PAH",1,1,1,0)="The purpose of patch KMP*4.0*0 is to deploy the VistA Business Event "
^DIC(9.4,233,22,1,"PAH",1,1,2,0)="Monitor  (VBEM) as part of the Capacity Management (KMP*) VistA System"
^DIC(9.4,233,22,1,"PAH",1,1,3,0)="Monitor (KMPV) tools suite. T VBEM will collect Cache metrics for VistA"
^DIC(9.4,233,22,1,"PAH",1,1,4,0)="functions  (Menu Options, TaskMan Jobs and Remote Procedure Calls) such"
^DIC(9.4,233,22,1,"PAH",1,1,5,0)="that they can be used in conjunction with metrics collected via other"
^DIC(9.4,233,22,1,"PAH",1,1,6,0)="deployed capacity management tools. This functionality will replace"
^DIC(9.4,233,22,1,"PAH",1,1,7,0)="current Resource Utilization Monitor (RUM) functionality."
^DIC(9.4,233,22,1,"PAH",1,1,8,0)=" "
^DIC(9.4,233,22,1,"PAH",1,1,9,0)="This patch also updates the existing VistA Timed Collection Monitor (VTCM)"
^DIC(9.4,233,22,1,"PAH",1,1,10,0)="to collect metrics using standard InterSystems provided APIs."
^DIC(9.4,233,22,1,"PAH",2,0)="1 SEQ #1^3201218.152233^17"
^DIC(9.4,233,22,1,"PAH",2,1,0)="^^3^3^3201218"
^DIC(9.4,233,22,1,"PAH",2,1,1,0)="Installs version 3 of the VistA System Monitor. This includes real time "
^DIC(9.4,233,22,1,"PAH",2,1,2,0)="data transmissions and the addition of the Coversheet and Errortrap "
^DIC(9.4,233,22,1,"PAH",2,1,3,0)="monitors."
^DIC(9.4,233,22,1,"PAH",3,0)="2 SEQ #2^3210901.114341^17"
^DIC(9.4,233,22,1,"PAH",3,1,0)="^^1^1^3210901"
^DIC(9.4,233,22,1,"PAH",3,1,1,0)="Configurations needed to run efficiently on IRIS VistA systems."
^DIC(9.4,233,22,1,"PAH",4,0)="3 SEQ #3^3230323.121753^89"
^DIC(9.4,233,22,1,"PAH",4,1,0)="^^2^2^3230323"
^DIC(9.4,233,22,1,"PAH",4,1,1,0)="This patch is intended to fix a number of small defects in VistA System "
^DIC(9.4,233,22,1,"PAH",4,1,2,0)="Monitor code."
^DIC(9.4,233,22,1,"PAH",5,0)="4 SEQ #4^3240125.115546^89"
^DIC(9.4,233,22,1,"PAH",6,0)="5 SEQ #5^3260327.104405^90"
^DIC(9.4,233,22,1,"PAH",6,1,0)="^^6^6^3260327"
^DIC(9.4,233,22,1,"PAH",6,1,1,0)="Updates to the VistA System Monitor to include:"
^DIC(9.4,233,22,1,"PAH",6,1,2,0)="1) Added functionality to support a real-time operational dashboard."
^DIC(9.4,233,22,1,"PAH",6,1,3,0)="2) Added collection of Error Trap Summary metrics."
^DIC(9.4,233,22,1,"PAH",6,1,4,0)="3) Added functions to collect HL7 Views."
^DIC(9.4,233,22,1,"PAH",6,1,5,0)="4) Fixed date in VSTM collection."
^DIC(9.4,233,22,1,"PAH",6,1,6,0)="5) Removed deprecated code."
^DIC(9.4,233,22,1,"PAH","B",0,1)=""
^DIC(9.4,233,22,1,"PAH","B","1 SEQ #1",2)=""
^DIC(9.4,233,22,1,"PAH","B","2 SEQ #2",3)=""
^DIC(9.4,233,22,1,"PAH","B","3 SEQ #3",4)=""
^DIC(9.4,233,22,1,"PAH","B","4 SEQ #4",5)=""
^DIC(9.4,233,22,1,"PAH","B","5 SEQ #5",6)=""
^DIC(9.4,233,22,2,0)="4^3180419^3210901^17"
^DIC(9.4,233,22,"B",4,2)=""
^DIC(9.4,233,22,"B","4.0",1)=""
^DIC(9.4,233,"VERSION")=4
^DIC(9.4,235,0)="WEB VISTA REMOTE ACCESS MANAGEMENT^WEBG^WebVRAM is a tool to help CLAIMS users access VistA systems"
^DIC(9.4,235,22,0)="^9.49I^2^2"
^DIC(9.4,235,22,1,0)="1.0"
^DIC(9.4,235,22,1,"PAH",0)="^9.4901^2^2"
^DIC(9.4,235,22,1,"PAH",1,0)="0^3200122.153105^65"
^DIC(9.4,235,22,1,"PAH",1,1,0)="^^1^1^3200122"
^DIC(9.4,235,22,1,"PAH",1,1,1,0)="Web VistA Remote Access Management (WebVRAM) Initial Release"
^DIC(9.4,235,22,1,"PAH",2,0)="3 SEQ #2^3200803.111741^65"
^DIC(9.4,235,22,1,"PAH",2,1,0)="^^2^2^3200803"
^DIC(9.4,235,22,1,"PAH",2,1,1,0)="The description of this build can be found in the National Patch Module "
^DIC(9.4,235,22,1,"PAH",2,1,2,0)="under WEBG*1*3."
^DIC(9.4,235,22,1,"PAH","B",0,1)=""
^DIC(9.4,235,22,1,"PAH","B","3 SEQ #2",2)=""
^DIC(9.4,235,22,2,0)="3.0"
^DIC(9.4,235,22,2,"PAH",0)="^9.4901^4^4"
^DIC(9.4,235,22,2,"PAH",1,0)="12 SEQ #9^3230509.1739^89"
^DIC(9.4,235,22,2,"PAH",1,1,0)="^^9^9^3230509"
^DIC(9.4,235,22,2,"PAH",1,1,1,0)="The CPRS Team will no longer send the Mental Health dll in the CPRS "
^DIC(9.4,235,22,2,"PAH",1,1,2,0)="packaged releases.  "
^DIC(9.4,235,22,2,"PAH",1,1,3,0)=" "
^DIC(9.4,235,22,2,"PAH",1,1,4,0)="To prepare for this change in the CPRS release process, the WebVRAM "
^DIC(9.4,235,22,2,"PAH",1,1,5,0)="Product will programmatically determine which version of the Mental "
^DIC(9.4,235,22,2,"PAH",1,1,6,0)="Health dll needs to be launched for a WebVRAM user at any given site. "
^DIC(9.4,235,22,2,"PAH",1,1,7,0)=" "
^DIC(9.4,235,22,2,"PAH",1,1,8,0)="The Mental Health RPC, YTQ VERSRV, will be added to the WEBG WEBVRAM GUI "
^DIC(9.4,235,22,2,"PAH",1,1,9,0)="user-context option, which is covered by ICR 7418."
^DIC(9.4,235,22,2,"PAH",2,0)="13 SEQ #10^3230614.174524^89"
^DIC(9.4,235,22,2,"PAH",2,1,0)="^^11^11^3230614"
^DIC(9.4,235,22,2,"PAH",2,1,1,0)="The Computerized Patient Record System (CPRS) Team will no longer "
^DIC(9.4,235,22,2,"PAH",2,1,2,0)="send the General Medical Record Vitals (GMRV) Dynamic-Link Library "
^DIC(9.4,235,22,2,"PAH",2,1,3,0)="(DLL) in the CPRS packaged releases.  "
^DIC(9.4,235,22,2,"PAH",2,1,4,0)=" "
^DIC(9.4,235,22,2,"PAH",2,1,5,0)="To prepare for this change in the CPRS release process, the Web VistA "
^DIC(9.4,235,22,2,"PAH",2,1,6,0)="Remote Access Management (WebVRAM) Product will programmatically "
^DIC(9.4,235,22,2,"PAH",2,1,7,0)="determine which version of the Vitals DLL needs to be launched "
^DIC(9.4,235,22,2,"PAH",2,1,8,0)="for a WebVRAM user at any given site. "
^DIC(9.4,235,22,2,"PAH",2,1,9,0)=" "
^DIC(9.4,235,22,2,"PAH",2,1,10,0)="The new WebVRAM Remote Procedure Call (RPC), WEBG GMRV VERSRV, will be"
^DIC(9.4,235,22,2,"PAH",2,1,11,0)="added to the WEBG WEBVRAM GUI [WEBG WEBVRAM GUI] option."
^DIC(9.4,235,22,2,"PAH",3,0)="17 SEQ #12^3231122.115432^89"
^DIC(9.4,235,22,2,"PAH",4,0)="21 SEQ #15^3241004.10191^89"
^DIC(9.4,235,22,2,"PAH","B","12 SEQ #9",1)=""
^DIC(9.4,235,22,2,"PAH","B","13 SEQ #10",2)=""
^DIC(9.4,235,22,2,"PAH","B","17 SEQ #12",3)=""
^DIC(9.4,235,22,2,"PAH","B","21 SEQ #15",4)=""
^DIC(9.4,235,22,"B","1.0",1)=""
^DIC(9.4,235,22,"B","3.0",2)=""
^DIC(9.4,235,"VERSION")="3.0"
^DIC(9.4,236,0)="ADVANCED PROSTHETICS ACQ TOOL^DSSO^ADVANCED PROSTHETICS ACQUISITION TOOL (APAT)"
^DIC(9.4,236,7)="^^I"
^DIC(9.4,236,22,0)="^9.49I^1^1"
^DIC(9.4,236,22,1,0)="2.0^3190404^3200420^70"
^DIC(9.4,236,22,1,1,0)="^^1^1^3200420"
^DIC(9.4,236,22,1,1,1,0)="Contains components for the DSS APAT product"
^DIC(9.4,236,22,1,"PAH",0)="^9.4901^5^5"
^DIC(9.4,236,22,1,"PAH",1,0)="2^3220225.145334^17"
^DIC(9.4,236,22,1,"PAH",1,1,0)="^^2^2^3220225"
^DIC(9.4,236,22,1,"PAH",1,1,1,0)="APAT patch 2 contains fixes to DSSO 2.0 and corresponds to executable"
^DIC(9.4,236,22,1,"PAH",1,1,2,0)="DSSAPAT 2.3.2."
^DIC(9.4,236,22,1,"PAH",2,0)="1^3220225.154544^84"
^DIC(9.4,236,22,1,"PAH",2,1,0)="^^1^1^3220225"
^DIC(9.4,236,22,1,"PAH",2,1,1,0)="Contains components for the DSS APAT product"
^DIC(9.4,236,22,1,"PAH",3,0)="7^3221025.150226^90"
^DIC(9.4,236,22,1,"PAH",3,1,0)="^^3^3^3221025"
^DIC(9.4,236,22,1,"PAH",3,1,1,0)="This patch removes checks of the AUTOMATED INVENTORY (GIP) field (#2)"
^DIC(9.4,236,22,1,"PAH",3,1,2,0)="in the PROSTHETIC SITE PARAMETERS (#669.9) file and INVENTORY FLAG field "
^DIC(9.4,236,22,1,"PAH",3,1,3,0)="(#10) in the PROSTHETIC HCPCS (#661.1) file."
^DIC(9.4,236,22,1,"PAH",4,0)="5^3231026.104353^89"
^DIC(9.4,236,22,1,"PAH",4,1,0)="^^5^5^3231026"
^DIC(9.4,236,22,1,"PAH",4,1,1,0)="DSSO*2.0*5 contains enhancements and maintenance to DSSO*2*0 and "
^DIC(9.4,236,22,1,"PAH",4,1,2,0)="corresponds to executable DSSAPAT 2.4.3.  The main enhancements delivered"
^DIC(9.4,236,22,1,"PAH",4,1,3,0)="by this patch are modifications to the HL7 extract and the Duplicate "
^DIC(9.4,236,22,1,"PAH",4,1,4,0)="Appliance Transaction (DAT) Prepopulator and involves conversion of dates "
^DIC(9.4,236,22,1,"PAH",4,1,5,0)="to HL7 format."
^DIC(9.4,236,22,1,"PAH",5,0)="3^3241219.135323^89"
^DIC(9.4,236,22,1,"PAH",5,1,0)="^^2^2^3241219"
^DIC(9.4,236,22,1,"PAH",5,1,1,0)="DSSO*2.0*3 contains enhancements and maintenance to DSSO 2.0 and"
^DIC(9.4,236,22,1,"PAH",5,1,2,0)="corresponds to executable DSSAPAT 2.5."
^DIC(9.4,236,22,1,"PAH","B",1,2)=""
^DIC(9.4,236,22,1,"PAH","B",2,1)=""
^DIC(9.4,236,22,1,"PAH","B",3,5)=""
^DIC(9.4,236,22,1,"PAH","B",5,4)=""
^DIC(9.4,236,22,1,"PAH","B",7,3)=""
^DIC(9.4,236,22,"B","2.0",1)=""
^DIC(9.4,236,"VERSION")="2.0"
^DIC(9.4,237,0)="ADVANCED MEDICATION PLATFORM^PREA^This application is a front end GUI for VA Pharmacists."
^DIC(9.4,237,22,0)="^9.49I^1^1"
^DIC(9.4,237,22,1,0)="1.0^3200901"
^DIC(9.4,237,22,1,"PAH",0)="^9.4901^3^3"
^DIC(9.4,237,22,1,"PAH",1,0)="2^3201106"
^DIC(9.4,237,22,1,"PAH",1,1,0)="^^12^12^3201106"
^DIC(9.4,237,22,1,"PAH",1,1,1,0)="This patch exports the new option PREA AMPL GUI. This patch also contains"
^DIC(9.4,237,22,1,"PAH",1,1,2,0)="a post-init routine that adds ADVANCED MEDICATION PLATFORM (AMPL) as an"
^DIC(9.4,237,22,1,"PAH",1,1,3,0)="entry in the REMOTE APPLICATION (#8994.5) File, and links it to the new"
^DIC(9.4,237,22,1,"PAH",1,1,4,0)="PRE AMPL GUI option. This must occur prior to the release of the full AMPL"
^DIC(9.4,237,22,1,"PAH",1,1,5,0)="project. When using the AMPL application, if a user makes a request to see"
^DIC(9.4,237,22,1,"PAH",1,1,6,0)="VistA data from a VistA instance where the user does not have an entry in"
^DIC(9.4,237,22,1,"PAH",1,1,7,0)="the NEW PERSON (#200) File, this VistA system will use the Security"
^DIC(9.4,237,22,1,"PAH",1,1,8,0)="Assertion Mark-up Language (SAML) token to authenticate the user and"
^DIC(9.4,237,22,1,"PAH",1,1,9,0)="authorize that user to view the requested data. Part of that process is to"
^DIC(9.4,237,22,1,"PAH",1,1,10,0)="validate that AMPL is an entry in the REMOTE APPLICATION (#8994.5) File,"
^DIC(9.4,237,22,1,"PAH",1,1,11,0)="and then the VistA can add that user to the NEW PERSON (#200) File without"
^DIC(9.4,237,22,1,"PAH",1,1,12,0)="user intervention and return the requested data."
^DIC(9.4,237,22,1,"PAH",2,0)="2 SEQ #1^3201218.15225^17"
^DIC(9.4,237,22,1,"PAH",2,1,0)="^^12^12^3201218"
^DIC(9.4,237,22,1,"PAH",2,1,1,0)="This patch exports the new option PREA AMPL GUI. This patch also contains"
^DIC(9.4,237,22,1,"PAH",2,1,2,0)="a post-init routine that adds ADVANCED MEDICATION PLATFORM (AMPL) as an"
^DIC(9.4,237,22,1,"PAH",2,1,3,0)="entry in the REMOTE APPLICATION (#8994.5) File, and links it to the new"
^DIC(9.4,237,22,1,"PAH",2,1,4,0)="PRE AMPL GUI option. This must occur prior to the release of the full AMPL"
^DIC(9.4,237,22,1,"PAH",2,1,5,0)="project. When using the AMPL application, if a user makes a request to see"
^DIC(9.4,237,22,1,"PAH",2,1,6,0)="VistA data from a VistA instance where the user does not have an entry in"
^DIC(9.4,237,22,1,"PAH",2,1,7,0)="the NEW PERSON (#200) File, this VistA system will use the Security"
^DIC(9.4,237,22,1,"PAH",2,1,8,0)="Assertion Mark-up Language (SAML) token to authenticate the user and"
^DIC(9.4,237,22,1,"PAH",2,1,9,0)="authorize that user to view the requested data. Part of that process is to"
^DIC(9.4,237,22,1,"PAH",2,1,10,0)="validate that AMPL is an entry in the REMOTE APPLICATION (#8994.5) File,"
^DIC(9.4,237,22,1,"PAH",2,1,11,0)="and then the VistA can add that user to the NEW PERSON (#200) File without"
^DIC(9.4,237,22,1,"PAH",2,1,12,0)="user intervention and return the requested data."
^DIC(9.4,237,22,1,"PAH",3,0)="3 SEQ #2^3210310.120617^17"
^DIC(9.4,237,22,1,"PAH",3,1,0)="^^69^69^3210310"
^DIC(9.4,237,22,1,"PAH",3,1,1,0)="This patch exports a new option that will identify the users who will "
^DIC(9.4,237,22,1,"PAH",3,1,2,0)="receive access to the Advanced Medication Platform (AMPL) GUI application"
^DIC(9.4,237,22,1,"PAH",3,1,3,0)="when it is initially installed at each site at a later date."
^DIC(9.4,237,22,1,"PAH",3,1,4,0)=" "
^DIC(9.4,237,22,1,"PAH",3,1,5,0)="Other than verifying successful patch PREA*1*3 installation, no further "
^DIC(9.4,237,22,1,"PAH",3,1,6,0)="action is required at this time. The AMPL application will be a phased "
^DIC(9.4,237,22,1,"PAH",3,1,7,0)="rollout, and the AMPL Implementation Manager will be in contact with each"
^DIC(9.4,237,22,1,"PAH",3,1,8,0)="site at the appropriate time prior to the site's AMPL implementation, and"
^DIC(9.4,237,22,1,"PAH",3,1,9,0)="will coordinate with the appropriate site personnel the running of the"
^DIC(9.4,237,22,1,"PAH",3,1,10,0)="option exported with this patch."
^DIC(9.4,237,22,1,"PAH",3,1,11,0)=" "
^DIC(9.4,237,22,1,"PAH",3,1,12,0)=" "
^DIC(9.4,237,22,1,"PAH",3,1,13,0)="The option will work as follows:"
^DIC(9.4,237,22,1,"PAH",3,1,14,0)=" "
^DIC(9.4,237,22,1,"PAH",3,1,15,0)="The stand-alone option, PREA AMPL GUI ACCESS, when invoked creates the"
^DIC(9.4,237,22,1,"PAH",3,1,16,0)="list of users that will receive AMPL access based on VistA Security Key"
^DIC(9.4,237,22,1,"PAH",3,1,17,0)="ownership and Person Class affiliation. When the option is run in the test"
^DIC(9.4,237,22,1,"PAH",3,1,18,0)="account, the list will only be sent to the person who ran the option, in a"
^DIC(9.4,237,22,1,"PAH",3,1,19,0)="VistA Mail Message. The message might also be sent in outlook, but that"
^DIC(9.4,237,22,1,"PAH",3,1,20,0)="depends on the mail configuration at each site. When the option is run in"
^DIC(9.4,237,22,1,"PAH",3,1,21,0)="production the user will be given the choice to only send the list to the"
^DIC(9.4,237,22,1,"PAH",3,1,22,0)="person who ran the option, or additionally send it to the VA IT EPMO EPMD"
^DIC(9.4,237,22,1,"PAH",3,1,23,0)="PRE Pharm GUI SSOi Outlook Mail Group that will handle the granting of"
^DIC(9.4,237,22,1,"PAH",3,1,24,0)="AMPL access to everyone on the list. When the option is run and the list"
^DIC(9.4,237,22,1,"PAH",3,1,25,0)="goes to the mail group, the option will be inactivated. The list will not"
^DIC(9.4,237,22,1,"PAH",3,1,26,0)="be submitted immediately to get the access granted, so until that time it"
^DIC(9.4,237,22,1,"PAH",3,1,27,0)="is submitted, the site contact can request changes to the user list by"
^DIC(9.4,237,22,1,"PAH",3,1,28,0)="messaging the VA IT EPMO EPMD PRE Pharm GUI SSOi Outlook Mail Group. The"
^DIC(9.4,237,22,1,"PAH",3,1,29,0)="site will be notified when the list is submitted. After submission, access"
^DIC(9.4,237,22,1,"PAH",3,1,30,0)="can still be granted to users or removed from users on an individual basis"
^DIC(9.4,237,22,1,"PAH",3,1,31,0)="by following the steps provided by Appendix A of the PREA Technical"
^DIC(9.4,237,22,1,"PAH",3,1,32,0)="Manual."
^DIC(9.4,237,22,1,"PAH",3,1,33,0)=" "
^DIC(9.4,237,22,1,"PAH",3,1,34,0)="The option uses the following hierarchy to determine the granting of AMPL"
^DIC(9.4,237,22,1,"PAH",3,1,35,0)="access:"
^DIC(9.4,237,22,1,"PAH",3,1,36,0)=" "
^DIC(9.4,237,22,1,"PAH",3,1,37,0)="1) A user is not granted AMPL access if the user has a past date or the "
^DIC(9.4,237,22,1,"PAH",3,1,38,0)="current date in the TERMINATION DATE Field (#9.2) of the NEW PERSON File"
^DIC(9.4,237,22,1,"PAH",3,1,39,0)="(#200)."
^DIC(9.4,237,22,1,"PAH",3,1,40,0)=" "
^DIC(9.4,237,22,1,"PAH",3,1,41,0)="2) A user is not granted AMPL access if the DISUSER Field (#7) of the NEW "
^DIC(9.4,237,22,1,"PAH",3,1,42,0)="PERSON File (#200) is set to '1' (YES) for that user."
^DIC(9.4,237,22,1,"PAH",3,1,43,0)=" "
^DIC(9.4,237,22,1,"PAH",3,1,44,0)="3) A user is granted AMPL access if they are assigned any of the following"
^DIC(9.4,237,22,1,"PAH",3,1,45,0)="VistA Security Keys:"
^DIC(9.4,237,22,1,"PAH",3,1,46,0)=" "
^DIC(9.4,237,22,1,"PAH",3,1,47,0)="        PSORPH"
^DIC(9.4,237,22,1,"PAH",3,1,48,0)="        PSO TECH ADV"
^DIC(9.4,237,22,1,"PAH",3,1,49,0)="        PSD TECH"
^DIC(9.4,237,22,1,"PAH",3,1,50,0)="        PSD TECH ADV"
^DIC(9.4,237,22,1,"PAH",3,1,51,0)="        PSDRPH"
^DIC(9.4,237,22,1,"PAH",3,1,52,0)="        PSDMGR"
^DIC(9.4,237,22,1,"PAH",3,1,53,0)="        PSJ PHARM TECH"
^DIC(9.4,237,22,1,"PAH",3,1,54,0)="        PSJ RPHARM"
^DIC(9.4,237,22,1,"PAH",3,1,55,0)="        PSJI MGR"
^DIC(9.4,237,22,1,"PAH",3,1,56,0)="        PSJI PHARM TECH"
^DIC(9.4,237,22,1,"PAH",3,1,57,0)="        PSJU MGR"
^DIC(9.4,237,22,1,"PAH",3,1,58,0)="        PSJU RPH"
^DIC(9.4,237,22,1,"PAH",3,1,59,0)="  "
^DIC(9.4,237,22,1,"PAH",3,1,60,0)="4) A user is granted AMPL access if that user has an active entry in the"
^DIC(9.4,237,22,1,"PAH",3,1,61,0)="PERSON CLASS Subfile (#200.05) of the NEW PERSON File (#200), and that"
^DIC(9.4,237,22,1,"PAH",3,1,62,0)="Person Class entry in the PERSON CLASS File (#8932.1) has the text ""PHARM"""
^DIC(9.4,237,22,1,"PAH",3,1,63,0)="contained in the PROVIDER TYPE Field (.01) or the CLASSIFICATION Field "
^DIC(9.4,237,22,1,"PAH",3,1,64,0)="(#1). The text ""PHARM"" can be in uppercase, lowercase, or any combination."
^DIC(9.4,237,22,1,"PAH",3,1,65,0)="                      "
^DIC(9.4,237,22,1,"PAH",3,1,66,0)=" "
^DIC(9.4,237,22,1,"PAH",3,1,67,0)="Note: Routine PREAPO2 is included in this patch only to correct some minor"
^DIC(9.4,237,22,1,"PAH",3,1,68,0)="issues to non-executable code to adhere to the M Programming Standards "
^DIC(9.4,237,22,1,"PAH",3,1,69,0)="and Conventions."
^DIC(9.4,237,22,1,"PAH","B",2,1)=""
^DIC(9.4,237,22,1,"PAH","B","2 SEQ #1",2)=""
^DIC(9.4,237,22,1,"PAH","B","3 SEQ #2",3)=""
^DIC(9.4,237,22,"B","1.0",1)=""
^DIC(9.4,237,"VERSION")=1
^DIC(9.4,238,0)="MEDICAL HEALTH ESCREENING^MHE^MEDICAL HEALTH ESCREENING APPLICATION PROXY"
^DIC(9.4,238,22,0)="^9.49I^1^1"
^DIC(9.4,238,22,1,0)="1.0"
^DIC(9.4,238,22,1,"PAH",1,0)="0^3210809.123948^17"
^DIC(9.4,238,22,1,"PAH",1,1,0)="^^2^2^3210809"
^DIC(9.4,238,22,1,"PAH",1,1,1,0)="This patch will distribute the Medical Health eScreening (MHE) option"
^DIC(9.4,238,22,1,"PAH",1,1,2,0)="required for the MHE Proxy User."
^DIC(9.4,238,22,1,"PAH","B",0,1)=""
^DIC(9.4,238,22,"B","1.0",1)=""
^DIC(9.4,238,"VERSION")=1
^DIC(9.4,239,0)="LIGHTHOUSE^LHS^Lighthouse is an API platform"
^DIC(9.4,239,1,0)="^9.41A^2^2^3210316^^^^"
^DIC(9.4,239,1,1,0)="Lighthouse is an API platform that gives developers secure access to the "
^DIC(9.4,239,1,2,0)="VA data they need to build helpful tools and services for Veterans."
^DIC(9.4,239,7)="^^I"
^DIC(9.4,239,22,0)="^9.49I^1^1"
^DIC(9.4,239,22,1,0)="1.0^3210330^3210812^17"
^DIC(9.4,239,22,"B","1.0",1)=""
^DIC(9.4,239,"VERSION")="1.0"
^DIC(9.4,240,0)="VETERANS DATA INTEGRATION AND FEDERATION^VDI^VDIF Enterprise Platform"
^DIC(9.4,240,1,0)="^^4^4^3220216^"
^DIC(9.4,240,1,1,0)="Veterans Data Integration and Federation Enterprise Platform (VDIF-EP)"
^DIC(9.4,240,1,2,0)="is a standards based, healthcare IT integration and interoperability"
^DIC(9.4,240,1,3,0)="platform using Intersystems' HealthShare suite of products. It includes"
^DIC(9.4,240,1,4,0)="the ability to read, write, and share VistA data."
^DIC(9.4,240,7)="^^I"
^DIC(9.4,240,22,0)="^9.49I^1^1"
^DIC(9.4,240,22,1,0)="1.0^3220216^3220329^86"
^DIC(9.4,240,22,1,"PAH",0)="^9.4901^2^2"
^DIC(9.4,240,22,1,"PAH",1,0)="1 SEQ #1^3230606.123158^89"
^DIC(9.4,240,22,1,"PAH",1,1,0)="^^3^3^3230606"
^DIC(9.4,240,22,1,"PAH",1,1,1,0)="This patch will add non person users to file 200 so the Immunization"
^DIC(9.4,240,22,1,"PAH",1,1,2,0)="Gateway (IZG) and MyHealtheVet (MHV) applications may use IAM established"
^DIC(9.4,240,22,1,"PAH",1,1,3,0)="authorization to establish a VistA context."
^DIC(9.4,240,22,1,"PAH",2,0)="2 SEQ #2^3260210.131121^90"
^DIC(9.4,240,22,1,"PAH",2,1,0)="^^1^1^3260210"
^DIC(9.4,240,22,1,"PAH",2,1,1,0)="Add REMOTE APPLICATION for DENTAL ELIGIBILITY"
^DIC(9.4,240,22,1,"PAH","B","1 SEQ #1",1)=""
^DIC(9.4,240,22,1,"PAH","B","2 SEQ #2",2)=""
^DIC(9.4,240,22,"B","1.0",1)=""
^DIC(9.4,240,"VERSION")="1.0"
^DIC(9.4,241,0)="ISI IMAGING^ISI^ISI Extensions for VistA IMAGING 3.0"
^DIC(9.4,241,22,0)="^9.49I^1^1"
^DIC(9.4,241,22,1,0)=1.1
^DIC(9.4,241,22,1,"PAH",0)="^9.4901^2^2"
^DIC(9.4,241,22,1,"PAH",1,0)="0^3230609.10261^89"
^DIC(9.4,241,22,1,"PAH",1,1,0)="^^1^1^3230609"
^DIC(9.4,241,22,1,"PAH",1,1,1,0)="Initialize Package File entry for ISI IMAGING"
^DIC(9.4,241,22,1,"PAH",2,0)="110^3231201.124535^89"
^DIC(9.4,241,22,1,"PAH",2,1,0)="^^1^1^3231201"
^DIC(9.4,241,22,1,"PAH",2,1,1,0)="ISI patch 1.1*110 (companion to VA patch 3.0*341) -- ISI Rad; replaces VistARad"
^DIC(9.4,241,22,1,"PAH","B",0,1)=""
^DIC(9.4,241,22,1,"PAH","B",110,2)=""
^DIC(9.4,241,22,"B",1.1,1)=""
