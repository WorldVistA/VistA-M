^DIC(9.4,42,22,7,"PAH",103,1,53,0)=" "
^DIC(9.4,42,22,7,"PAH",103,1,54,0)="Patch Installation:"
^DIC(9.4,42,22,7,"PAH",103,1,55,0)="------------------"
^DIC(9.4,42,22,7,"PAH",103,1,56,0)=" "
^DIC(9.4,42,22,7,"PAH",103,1,57,0)="  Instructions for installation of the software are included in the "
^DIC(9.4,42,22,7,"PAH",103,1,58,0)="  Mental Health PCL-5 patch YS*5.01*119."
