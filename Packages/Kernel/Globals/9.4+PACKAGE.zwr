^DIC(9.4,194,0)="HEALTHEVET DESKTOP^XHD^HealtheVet Desktop"
^DIC(9.4,194,20,0)="^9.402P^^"
^DIC(9.4,194,22,0)="^9.49I^1^1"
^DIC(9.4,194,22,1,0)="1.0^3040116^3040302^1"
^DIC(9.4,194,22,1,1,0)="^^3^3^3040302"
^DIC(9.4,194,22,1,1,1,0)="This is the build for the HealtheVet Desktop.  The desktop is primarily"
^DIC(9.4,194,22,1,1,2,0)="a client-side Java application.  Some server-side components may be added"
^DIC(9.4,194,22,1,1,3,0)="in the future."
^DIC(9.4,194,22,"B","1.0",1)=""
^DIC(9.4,194,"VERSION")="1.0"
^DIC(9.4,195,0)="CARE MANAGEMENT^ORRC^Care Mgt Modules"
^DIC(9.4,195,20,0)="^9.402P^^"
^DIC(9.4,195,22,0)="^9.49I^1^1"
^DIC(9.4,195,22,1,0)="1.0^3051119^3040302^1"
^DIC(9.4,195,22,1,1,0)="^9.54^4^4^3081218^"
^DIC(9.4,195,22,1,1,1,0)="This package contains the Care Management modules.  These modules include "
^DIC(9.4,195,22,1,1,2,0)="the clinician dashboard, the nursing dashboard, the query tool, and the "
^DIC(9.4,195,22,1,1,3,0)="task editor.  Options are used to grant access to the modules or "
^DIC(9.4,195,22,1,1,4,0)="components within the modules."
^DIC(9.4,195,22,1,"PAH",0)="^9.4901^8^8"
^DIC(9.4,195,22,1,"PAH",1,0)="1 SEQ #1^3050204^1"
^DIC(9.4,195,22,1,"PAH",1,1,0)="^^6^6^3050204"
^DIC(9.4,195,22,1,"PAH",1,1,1,0)="This patch will enhance the identification of the VistA system connected "
^DIC(9.4,195,22,1,"PAH",1,1,2,0)="to, such that when patient context is established or subscribed to, the "
^DIC(9.4,195,22,1,"PAH",1,1,3,0)="proper VistA system will be used to match patient context."
^DIC(9.4,195,22,1,"PAH",1,1,4,0)=" "
^DIC(9.4,195,22,1,"PAH",1,1,5,0)="This patch takes advantage of a system identifier used to flag a "
^DIC(9.4,195,22,1,"PAH",1,1,6,0)="production system definitively."
^DIC(9.4,195,22,1,"PAH",2,0)="3 SEQ #2^3060711^1"
^DIC(9.4,195,22,1,"PAH",2,1,0)="^^2^2^3060711"
^DIC(9.4,195,22,1,"PAH",2,1,1,0)="Refer to the National Patch Module for complete details of the "
^DIC(9.4,195,22,1,"PAH",2,1,2,0)="enhancements included in this patch."
^DIC(9.4,195,22,1,"PAH",3,0)="2 SEQ #3^3061227.143839^1"
^DIC(9.4,195,22,1,"PAH",3,1,0)="^^2^2^3061227"
^DIC(9.4,195,22,1,"PAH",3,1,1,0)="Refer to the National Patch Module for complete details of the "
^DIC(9.4,195,22,1,"PAH",3,1,2,0)="enhancements included in this patch."
^DIC(9.4,195,22,1,"PAH",4,0)="5 SEQ #4^3070904.22582^1"
^DIC(9.4,195,22,1,"PAH",5,0)="7 SEQ #5^3070905.012005^1"
^DIC(9.4,195,22,1,"PAH",6,0)="8 SEQ #7^3160829.124821^54"
^DIC(9.4,195,22,1,"PAH",7,0)="12 SEQ #9^3190530.123829^17"
^DIC(9.4,195,22,1,"PAH",7,1,0)="^^21^21^3190530"
^DIC(9.4,195,22,1,"PAH",7,1,1,0)="This patch is designated for the decommissioning of the Care Management "
^DIC(9.4,195,22,1,"PAH",7,1,2,0)="(CM) application. "
^DIC(9.4,195,22,1,"PAH",7,1,3,0)=" "
^DIC(9.4,195,22,1,"PAH",7,1,4,0)="The follow options will be removed from Vista:"
^DIC(9.4,195,22,1,"PAH",7,1,5,0)="  "
^DIC(9.4,195,22,1,"PAH",7,1,6,0)="     1   ORRC CM MENU       Care Management Menu"
^DIC(9.4,195,22,1,"PAH",7,1,7,0)="     2   ORRC ORD ACK INQ BY ORDER       ORDER ACKNOWLEDGEMENT INQUIRY BY "
^DIC(9.4,195,22,1,"PAH",7,1,8,0)="ORDER"
^DIC(9.4,195,22,1,"PAH",7,1,9,0)="     3   ORRC ORD ACK INQ BY PROV       ORDER ACKNOWLEDGEMENT INQUIRY BY "
^DIC(9.4,195,22,1,"PAH",7,1,10,0)="PROVIDER"
^DIC(9.4,195,22,1,"PAH",7,1,11,0)="     4   ORRCM CLIENT       Care Management Client Context"
^DIC(9.4,195,22,1,"PAH",7,1,12,0)="     5   ORRCMC DASHBOARD       Care Management Dashboard 1.8.0"
^DIC(9.4,195,22,1,"PAH",7,1,13,0)="     6   ORRCMC PATIENT TASK       Care Management Task 1.0"
^DIC(9.4,195,22,1,"PAH",7,1,14,0)="     7  ORRCMC SIGN LIST       Sign List 1.0"
^DIC(9.4,195,22,1,"PAH",7,1,15,0)="     8  ORRCMM CLINICIAN       Clinician Perspective Selector"
^DIC(9.4,195,22,1,"PAH",7,1,16,0)="     9  ORRCMM CLINICIAN NURSE       Clinician Nurse and Sign List "
^DIC(9.4,195,22,1,"PAH",7,1,17,0)="Perspectives"
^DIC(9.4,195,22,1,"PAH",7,1,18,0)="     10  ORRCMM CLINICIAN QUERY       Clinician Dashboard and Query "
^DIC(9.4,195,22,1,"PAH",7,1,19,0)="Selector"
^DIC(9.4,195,22,1,"PAH",7,1,20,0)="     11  ORRCMM CM ALL       All Care Management Perspectives"
^DIC(9.4,195,22,1,"PAH",7,1,21,0)="     12  ORRCMM NURSE QUERY       Nursing Dashboard and Query Selector"
^DIC(9.4,195,22,1,"PAH",8,0)="13 SEQ #10^3190604.18114^54"
^DIC(9.4,195,22,1,"PAH",8,1,0)="^^2^2^3190604"
^DIC(9.4,195,22,1,"PAH",8,1,1,0)="The purpose of this patch is to remove unused routines in the Care "
^DIC(9.4,195,22,1,"PAH",8,1,2,0)="Management (CM) package from VistA. "
