^DIC(9.4,100,22,15,"PAH",138,1,3,0)="Fix MH TEST/SURVEY SPEC for EDE-Q to fix blank instrument print."
^DIC(9.4,100,22,15,"PAH",138,1,4,0)="Fix scale group name for MBMD."
^DIC(9.4,100,22,15,"PAH",138,1,5,0)="Add SIP-AD-START_V2 and SIP-AD-30_V2"
^DIC(9.4,100,22,15,"PAH",138,1,6,0)="Deactivate SIP-AD-START and SIP-AD-30"
^DIC(9.4,100,22,15,"PAH",138,1,7,0)="Deactivate SCL90R"
