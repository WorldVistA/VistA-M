^XWB(8994,4564,1,0)="^^11^11^3180216^"
^XWB(8994,4564,1,1,0)="The Conversion Factor Report will display the inventory point items with "
^XWB(8994,4564,1,2,0)="procurement sources and conversion factors.  The report will print the "
^XWB(8994,4564,1,3,0)="item master number, description, nsn, unit per issue, quantity on-hand, "
^XWB(8994,4564,1,4,0)="procurement sources, unit per receipt and conversion factor."
^XWB(8994,4564,1,5,0)=" "
^XWB(8994,4564,1,6,0)="The warehouse will have the option to select specific item nsn's to "
^XWB(8994,4564,1,7,0)="display. The report will sort by nsn."
^XWB(8994,4564,1,8,0)=" "
^XWB(8994,4564,1,9,0)="The primary and secondary will have the option to select specific group "
^XWB(8994,4564,1,10,0)="categories to display.  The report will sort by group category and "
^XWB(8994,4564,1,11,0)="description."
^XWB(8994,4564,2,0)="^8994.02A^2^2"
^XWB(8994,4564,2,1,0)="ESTART^1^^0^1"
^XWB(8994,4564,2,1,1,0)="^^1^1^3180216^"
