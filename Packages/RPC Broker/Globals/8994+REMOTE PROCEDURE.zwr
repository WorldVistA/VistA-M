^XWB(8994,4508,1,1,0)="Returns a list of providers and/or teams to receive alerts, based on "
^XWB(8994,4508,1,2,0)="an order number, determined by the ORB PROVIDER RECIPIENTS parameter."
^XWB(8994,4508,2,0)="^8994.02A^2^2"
^XWB(8994,4508,2,1,0)="ORNUM^1^^1^1"
^XWB(8994,4508,2,1,1,0)="^8994.021^1^1^3201210^^^^"
^XWB(8994,4508,2,1,1,1,0)="The order number to include in the search."
^XWB(8994,4508,2,2,0)="ORDFN^1^^0^2"
^XWB(8994,4508,2,2,1,0)="^8994.021^1^1^3201210^^^^"
^XWB(8994,4508,2,2,1,1,0)="This is the patient dfn."
^XWB(8994,4508,2,"B","ORDFN",2)=""
^XWB(8994,4508,2,"B","ORNUM",1)=""
^XWB(8994,4508,2,"PARAMSEQ",1,1)=""
^XWB(8994,4508,2,"PARAMSEQ",2,2)=""
^XWB(8994,4508,3,0)="^8994.03^2^2^3201210^^^^"
^XWB(8994,4508,3,1,0)="List array containing the names of the Providers and Teams whom are able"
^XWB(8994,4508,3,2,0)="to receive the notification."
^XWB(8994,4509,0)="ORWDAL32 SENDALRT^SENDALRT^ORWDAL32^1^^0"
^XWB(8994,4509,1,0)="^8994.01^2^2^3201211^^^^"
^XWB(8994,4509,1,1,0)="Called to send a group of alerts to specified recipients for new"
^XWB(8994,4509,1,2,0)="allergies impacting existing med orders."
^XWB(8994,4509,2,0)="^8994.02A^2^2"
^XWB(8994,4509,2,1,0)="ORDNUM^1^^1^1"
^XWB(8994,4509,2,1,1,0)="^8994.021^1^1^3201210^^^"
^XWB(8994,4509,2,1,1,1,0)="Order IEN to send related alerts."
^XWB(8994,4509,2,2,0)="PROVLST^2^^1^2"
^XWB(8994,4509,2,2,1,0)="^8994.021^1^1^3201211^^^"
^XWB(8994,4509,2,2,1,1,0)="List of additional providers or teams to send alerts."
^XWB(8994,4509,2,"B","ORDNUM",1)=""
^XWB(8994,4509,2,"B","PROVLST",2)=""
^XWB(8994,4509,2,"PARAMSEQ",1,1)=""
^XWB(8994,4509,2,"PARAMSEQ",2,2)=""
^XWB(8994,4509,3,0)="^8994.03^1^1^3201211^^^"
^XWB(8994,4509,3,1,0)="Confirmation of completion. 1 = success, 0 = fail"
^XWB(8994,4510,0)="ORWTPP GETSURRS^GETSURRS^ORWTPP^2"
^XWB(8994,4510,1,0)="^^1^1^3150108^"
^XWB(8994,4510,1,1,0)="This RPC returns the full list of available surrogates for the current user."
^XWB(8994,4510,3,0)="^^5^5^3150108^"
^XWB(8994,4510,3,1,0)="Returns an array containing the following information:"
^XWB(8994,4510,3,2,0)=" "
^XWB(8994,4510,3,3,0)="   ARY=n (Total number of surrogates returned)"
^XWB(8994,4510,3,4,0)="   ARY(1)=Surrogate IEN (200 file)^Surrogate Name^Start Date^End Date"
^XWB(8994,4510,3,5,0)="   ARY(n)..."
^XWB(8994,4511,0)="ORWTPP SURRDFLT^SURRDFLT^ORWTPP^1"
^XWB(8994,4511,1,0)="^8994.01^1^1^3171116^^^"
^XWB(8994,4511,1,1,0)="This rpc allows the setting and retrieval of the default surrogate settings."
^XWB(8994,4511,2,0)="^8994.02A^2^2"
^XWB(8994,4511,2,1,0)="ACTION^1^^1^1"
^XWB(8994,4511,2,1,1,0)="^^4^4^3171116^"
^XWB(8994,4511,2,1,1,1,0)="This is the action to be performed.  Available actions:"
^XWB(8994,4511,2,1,1,2,0)=" "
^XWB(8994,4511,2,1,1,3,0)="   GET   - Retrieves the current surrogate settings"
^XWB(8994,4511,2,1,1,4,0)="   SAVE  - Saves the user level surrogate settings"
^XWB(8994,4511,2,2,0)="VALUES^1^^1^2"
^XWB(8994,4511,2,2,1,0)="^8994.021^13^13^3171116^^^"
^XWB(8994,4511,2,2,1,1,0)="This parameter depends on the ACTION that is being performed."
^XWB(8994,4511,2,2,1,2,0)=" "
^XWB(8994,4511,2,2,1,3,0)="   ACTION = GET"
^XWB(8994,4511,2,2,1,4,0)="        VALUES = USER DUZ"
^XWB(8994,4511,2,2,1,5,0)=" "
^XWB(8994,4511,2,2,1,6,0)="   ACTION = SAVE"
^XWB(8994,4511,2,2,1,7,0)="        VALUES = USER DUZ^ENABLE/DISABLE^DAYS"
^XWB(8994,4511,2,2,1,8,0)="           USER - DUZ OF USER"
^XWB(8994,4511,2,2,1,9,0)="           ENABLE/DISABLE -"
^XWB(8994,4511,2,2,1,10,0)="              1 = Enable default start/stop date/time for surrogates"
^XWB(8994,4511,2,2,1,11,0)="              0 = Disable default start/stop date/time for surrogates"
^XWB(8994,4511,2,2,1,12,0)="           DAYS - Number of days to default the surrogate stop date after"
^XWB(8994,4511,2,2,1,13,0)="                  the start date/time"
^XWB(8994,4511,2,"B","ACTION",1)=""
^XWB(8994,4511,2,"B","VALUES",2)=""
^XWB(8994,4511,2,"PARAMSEQ",1,1)=""
^XWB(8994,4511,2,"PARAMSEQ",2,2)=""
^XWB(8994,4511,3,0)="^8994.03^9^9^3171116^^^"
^XWB(8994,4511,3,1,0)="Returns the default surrogate settings:"
^XWB(8994,4511,3,2,0)=" "
^XWB(8994,4511,3,3,0)="   ENABLE/DISABLE^DAYS"
^XWB(8994,4511,3,4,0)=" "
^XWB(8994,4511,3,5,0)="        ENABLE/DISABLE -"
^XWB(8994,4511,3,6,0)="           1 = Enable default start/stop date/time for surrogates"
^XWB(8994,4511,3,7,0)="           0 = Disable default start/stop date/time for surrogates"
^XWB(8994,4511,3,8,0)="        DAYS - Number of days to default the surrogate stop date after"
^XWB(8994,4511,3,9,0)="               the start date/time"
^XWB(8994,4512,0)="ORWDXA1 FLAGACT^FLAGACT^ORWDXA1^2"
^XWB(8994,4512,1,0)="^8994.01^1^1^3210115^^^"
^XWB(8994,4512,1,1,0)="Returns information on a flagged order based on the ACTION specified."
^XWB(8994,4512,2,0)="^8994.02A^2^2"
^XWB(8994,4512,2,1,0)="ORIFN^1^^1^1"
^XWB(8994,4512,2,2,0)="ACTION^1^^^2"
^XWB(8994,4512,2,2,1,0)="^^4^4^3210115^"
^XWB(8994,4512,2,2,1,1,0)="The action to be performed."
^XWB(8994,4512,2,2,1,2,0)="ACTION=""RECIPIENTS"" returns a list of recipients receiving the order flag."
^XWB(8994,4512,2,2,1,3,0)="ACTION=""COMMENTS"" returns a list of comments on the flagged order."
^XWB(8994,4512,2,2,1,4,0)="ACTION=""ALL"" returns both recipients and comments on the flagged order."
^XWB(8994,4512,2,"B","ACTION",2)=""
^XWB(8994,4512,2,"B","ORIFN",1)=""
^XWB(8994,4512,2,"PARAMSEQ",1,1)=""
^XWB(8994,4512,2,"PARAMSEQ",2,2)=""
^XWB(8994,4513,0)="ORWDXA1 FLAGCOM^FLAGCOM^ORWDXA1^2"
^XWB(8994,4513,1,0)="^^1^1^3201124^"
^XWB(8994,4513,1,1,0)="Add comments to a flagged order."
^XWB(8994,4513,2,0)="^8994.02A^3^3"
^XWB(8994,4513,2,1,0)="ORFIN^1^^1^1"
^XWB(8994,4513,2,1,1,0)="^^1^1^3201124^"
^XWB(8994,4513,2,1,1,1,0)="Order Identification"
^XWB(8994,4513,2,2,0)="ORCOM^2^^1^2"
^XWB(8994,4513,2,2,1,0)="^^1^1^3201124^"
^XWB(8994,4513,2,2,1,1,0)="Comments added by a recipient for the flagged order."
^XWB(8994,4513,2,3,0)="ORALRP^2^^^3"
^XWB(8994,4513,2,3,1,0)="^^1^1^3201124^"
^XWB(8994,4513,2,3,1,1,0)="List of recipients to receive the alert."
^XWB(8994,4513,2,"B","ORALRP",3)=""
^XWB(8994,4513,2,"B","ORCOM",2)=""
^XWB(8994,4513,2,"B","ORFIN",1)=""
^XWB(8994,4513,2,"PARAMSEQ",1,1)=""
^XWB(8994,4513,2,"PARAMSEQ",2,2)=""
^XWB(8994,4513,2,"PARAMSEQ",3,3)=""
^XWB(8994,4514,0)="ORWDXA1 FLAGTXTS^FLAGTXTS^ORWDXA1^2"
^XWB(8994,4514,1,0)="^8994.01^2^2^3210208^^^^"
^XWB(8994,4514,1,1,0)="Returns flag reason, recipients and the comments associated with the list "
^XWB(8994,4514,1,2,0)="of flagged orders."
^XWB(8994,4514,2,0)="^8994.02A^1^1"
^XWB(8994,4514,2,1,0)="IFNS^2^^1^1"
^XWB(8994,4514,2,1,1,0)="^8994.021^1^1^3210208^^"
^XWB(8994,4514,2,1,1,1,0)="List of Order numbers."
^XWB(8994,4514,2,"B","IFNS",1)=""
^XWB(8994,4514,2,"PARAMSEQ",1,1)=""
^XWB(8994,4515,0)="ORWPS1 NVADLG^NVADLG^ORWPS1^1"
^XWB(8994,4515,1,0)="^^1^1^3210128^"
^XWB(8994,4515,1,1,0)="Returns order dialog information for a non-VA medications (PSH OERR)."
^XWB(8994,4515,3,0)="^^14^14^3210128^"
^XWB(8994,4515,3,1,0)="Output:"
^XWB(8994,4515,3,2,0)="  IEN;ID;DGRP;TYP^TXT"
^XWB(8994,4515,3,3,0)=" "
^XWB(8994,4515,3,4,0)="     Where:"
^XWB(8994,4515,3,5,0)="        IEN = Internal Entry Number of PSH OERR in the Order Dialog"
^XWB(8994,4515,3,6,0)="              (#101.41) file"
^XWB(8994,4515,3,7,0)="        ID = Window Form ID (#55) field in Order Dialog (#101.41) file "
^XWB(8994,4515,3,8,0)="        DGRP = Display Group (#5) field in Order Dialog (#101.41) file"
^XWB(8994,4515,3,9,0)="        TYP = Type (#4) field in Order Dialog (#101.41) file"
^XWB(8994,4515,3,10,0)="        TXT = Listbox Text (#54) field in Order Dialog (#101.41) file"
^XWB(8994,4515,3,11,0)=" "
^XWB(8994,4515,3,12,0)=" "
^XWB(8994,4515,3,13,0)="  If PSH OERR not found returns:"
^XWB(8994,4515,3,14,0)="     -1^PSH OERR (Non VA Medications (Documentation)) dialog does not exist"
^XWB(8994,4517,0)="DVBA ACTIVE DBQ LIST^ACTIVE^DVBCPNCS^2^R^^^^1"
^XWB(8994,4517,1,0)="^^3^3^3201221^"
^XWB(8994,4517,1,1,0)="This RPC will return the list of active DBQ's from file 396.18."
^XWB(8994,4517,1,2,0)="The Array will contain the DBQ name, active date, version and PNCS file "
^XWB(8994,4517,1,3,0)="name"
^XWB(8994,4518,0)="DVBA DBQ CHECK^DBQCHECK^DVBCPNCS^2^R^^^^1"
^XWB(8994,4518,1,0)="^^7^7^3210218^"
^XWB(8994,4518,1,1,0)="This RPC is used by the CAPRI GUI to verify that a started DBQ is still "
^XWB(8994,4518,1,2,0)="active and has not been marked as inactive in File ^DVB(396.18)"
^XWB(8994,4518,1,3,0)="Return Data example, 1st Piece is the DBQ Template Status and 2nd Piece "
^XWB(8994,4518,1,4,0)="is the DBQ Template Name:"
^XWB(8994,4518,1,5,0)="RTN(1)=""FALSE^DBQ ENDO THYROID & PARATHYROID"""
^XWB(8994,4518,1,6,0)="RTN(2)=""FALSE^VBMS EAR CONDITIONS"""
^XWB(8994,4518,1,7,0)="RTN(3)=""FALSE^VBMS URINARY TRACT"""
^XWB(8994,4518,2,0)="^8994.02A^1^1"
^XWB(8994,4518,2,1,0)="IEN^1^^1"
^XWB(8994,4518,2,"B","IEN",1)=""
^XWB(8994,4518,3,0)="^^8^8^3210218^"
^XWB(8994,4518,3,1,0)="An array is returned, 1st Piece is the DBQ Template Status and 2nd Piece "
^XWB(8994,4518,3,2,0)="is the DBQ Template Name, example:"
^XWB(8994,4518,3,3,0)="RTN(1)=""FALSE^DBQ ENDO THYROID & PARATHYROID"""
^XWB(8994,4518,3,4,0)="RTN(2)=""FALSE^VBMS EAR CONDITIONS"""
^XWB(8994,4518,3,5,0)="RTN(3)=""FALSE^VBMS URINARY TRACT"""
^XWB(8994,4518,3,6,0)=" "
^XWB(8994,4518,3,7,0)="If the template is Outdated or has a return value of False, the template "
^XWB(8994,4518,3,8,0)="status is marked as ""Outdated"" in File 396.17."
^XWB(8994,4519,0)="DVBA DBQ GEN CHECK^DBQCK^DVBCPNCS^1^R^^^^1"
^XWB(8994,4519,1,0)="^8994.01^4^4^3210112^^^^"
^XWB(8994,4519,1,1,0)="This RPC will be used to check if a draft DBQ is using the correct "
^XWB(8994,4519,1,2,0)="version.  This will accept a general DBQ name and specific date to use "
^XWB(8994,4519,1,3,0)="for verification.  The RPC verifies the DBQ has not been De-Activated and "
^XWB(8994,4519,1,4,0)="the Activation Date is before the date sent for verification."
^XWB(8994,4519,2,0)="^8994.02A^2^2"
^XWB(8994,4519,2,1,0)="DVBDBQ^1^^1"
^XWB(8994,4519,2,1,1,0)="^^1^1^3210112^"
^XWB(8994,4519,2,1,1,1,0)="This will be the name of the DBQ to be checked."
^XWB(8994,4519,2,2,0)="DVBDATE^1^^1"
^XWB(8994,4519,2,2,1,0)="^8994.021^1^1^3210112^^^"
^XWB(8994,4519,2,2,1,1,0)="This will be the date to use for verification"
^XWB(8994,4519,2,"B","DVBDATE",2)=""
^XWB(8994,4519,2,"B","DVBDBQ",1)=""
^XWB(8994,4519,3,0)="^^2^2^3210112^"
^XWB(8994,4519,3,1,0)="The RPC will return ""TRUE"" if the DBQ is the most current version and "
^XWB(8994,4519,3,2,0)="""FALSE"" if it is not using the most current version."
^XWB(8994,4520,0)="DVBA REPORT BUILDER^REPORT^DVBCREPT^4^P^^^1^1"
^XWB(8994,4520,2,0)="^8994.02A^1^1"
^XWB(8994,4520,2,1,0)="ARRAY^2^^1"
^XWB(8994,4520,2,"B","ARRAY",1)=""
^XWB(8994,4521,0)="DVBA CAPRI DBQ STATUS^DBQSTAT^DVBCPNCS^1^R^^^^1"
^XWB(8994,4521,1,0)="^^2^2^3210218^"
^XWB(8994,4521,1,1,0)="This RPC will change the status of an DBQ Template to the status sent "
^XWB(8994,4521,1,2,0)="from the CAPRI GUI.  Once successfully changed it will return a 1."
^XWB(8994,4521,2,0)="^8994.02A^2^2"
^XWB(8994,4521,2,1,0)="IEN^1^^1"
^XWB(8994,4521,2,1,1,0)="^^1^1^3210218^"
^XWB(8994,4521,2,1,1,1,0)="DBQ IEN "
^XWB(8994,4521,2,2,0)="DBQ STATUS^1^^1"
^XWB(8994,4521,2,"B","DBQ STATUS",2)=""
^XWB(8994,4521,2,"B","IEN",1)=""
^XWB(8994,4521,3,0)="^^2^2^3210218^"
^XWB(8994,4521,3,1,0)="Once status is changed a 1 will be returned upon success, if any required "
^XWB(8994,4521,3,2,0)="data is missing a -1 is returned"
^XWB(8994,4522,0)="SDEC GET PATIENT DEMOG^GETPATDEMOG^SDEC1^4^R^0^^0"
^XWB(8994,4522,1,0)="^^14^14^3210428^"
^XWB(8994,4522,1,1,0)="This RPC is a ""LITE"" version of the RPC ""SDEC PTLOOKRS-Patient info "
^XWB(8994,4522,1,2,0)="lookup"" (in rtn SDEC28). This RPC (in rtn SDEC28L) finds up to ""SDECC"" "
^XWB(8994,4522,1,3,0)="number of patients that match the ""SDECP"" Patient Identification "
^XWB(8994,4522,1,4,0)="criteria, which can be any one of the following types of input:"
^XWB(8994,4522,1,5,0)=" a)#DFN, b)DOB, c)SSN, d)First letter of LastName followed by L4SSN, "
^XWB(8994,4522,1,6,0)="e)PartalName or f)NULL for ALL"
^XWB(8994,4522,1,7,0)=" "
^XWB(8994,4522,1,8,0)="Variables In:"
^XWB(8994,4522,1,9,0)="    SDECP   - (optional) Free-Text - Partial name to look up"
^XWB(8994,4522,1,10,0)="    SDECC   - (optional) Max number of patients to return; defaults to 10"
^XWB(8994,4522,1,11,0)="    LASTSUB - (optional) last subscripts from previous call"
^XWB(8994,4522,1,12,0)="Variables Out:"
^XWB(8994,4522,1,13,0)="    SDECY (^TMP(""SDEC"",$J)), which includes records found that consist of "
^XWB(8994,4522,1,14,0)="the PATIENT NAME, SSN, DOB, DFN, SEX, and ELIGIBILITY fields."
^XWB(8994,4522,2,0)="^8994.02A^3^3"
^XWB(8994,4522,2,1,0)="SDECP^1^^0^1"
^XWB(8994,4522,2,1,1,0)="^^4^4^3210428^"
^XWB(8994,4522,2,1,1,1,0)="The Patient Identification criteria, which can be any one of the "
^XWB(8994,4522,2,1,1,2,0)="following types of input:"
^XWB(8994,4522,2,1,1,3,0)=" a)#DFN, b)DOB, c)SSN, d)First letter of LastName followed by L4SSN, "
^XWB(8994,4522,2,1,1,4,0)=" e)PartalName or f)NULL for ALL"
^XWB(8994,4522,2,2,0)="SDECC^1^^0^2"
^XWB(8994,4522,2,2,1,0)="^^1^1^3210428^"
^XWB(8994,4522,2,2,1,1,0)="The Max number of patients to return in the list, defaults to 10."
^XWB(8994,4522,2,3,0)="LASTSUB^1^^0^3"
^XWB(8994,4522,2,3,1,0)="^^1^1^3210428^"
^XWB(8994,4522,2,3,1,1,0)="The last subscript from list of returned records from the previous call."
^XWB(8994,4522,2,"B","LASTSUB",3)=""
^XWB(8994,4522,2,"B","SDECC",2)=""
^XWB(8994,4522,2,"B","SDECP",1)=""
^XWB(8994,4522,2,"PARAMSEQ",1,1)=""
^XWB(8994,4522,2,"PARAMSEQ",2,2)=""
^XWB(8994,4522,2,"PARAMSEQ",3,3)=""
^XWB(8994,4522,3,0)="^^5^5^3220728^"
^XWB(8994,4522,3,1,0)="The RETURN values are imbedded in the Global array defined in SDECY, "
^XWB(8994,4522,3,2,0)="These entries reflect the records that match the Patient"
^XWB(8994,4522,3,3,0)="Identifying criteria that was supplied. The records reflect the abridged "
^XWB(8994,4522,3,4,0)="Patient Lookup information and only report the following fields:  "
^XWB(8994,4522,3,5,0)="     PATIENT NAME, SSN (last4), DOB, DFN, SEX, and ELIGIBILITY"
^XWB(8994,4523,0)="SDEC GET PATIENT RECALL BY IEN^RECGETONE^SDEC1^4^R^0^^0"
^XWB(8994,4523,1,0)="^8994.01^1^1^3210429^"
^XWB(8994,4523,1,1,0)="GET entry from the RECALL REMINDERS file 403.5 for a given IEN"
^XWB(8994,4523,2,0)="^8994.02A^1^1"
^XWB(8994,4523,2,1,0)="IEN^1^32000^1^1"
^XWB(8994,4523,2,1,1,0)="^^1^1^3210429^"
^XWB(8994,4523,2,1,1,1,0)="IEN of RECALL REMINDERS file"
^XWB(8994,4523,2,"B","IEN",1)=""
^XWB(8994,4523,2,"PARAMSEQ",1,1)=""
^XWB(8994,4524,0)="SDEC GET PAT CONSULT BY IEN^CONSULT1^SDEC1^4^R^0"
^XWB(8994,4524,1,0)="^8994.01^2^2^3210505^^^^"
^XWB(8994,4524,1,1,0)="This RPC returns a global array of output parameters for given Consult "
^XWB(8994,4524,1,2,0)="ID with a CPRS STATUS of ""ACTIVE"" or ""PENDING""."
^XWB(8994,4524,2,0)="^8994.02A^1^1"
^XWB(8994,4524,2,1,0)="CONSULT ID^1^^1^1"
^XWB(8994,4524,2,1,1,0)="^8994.021^1^1^3210505^^^^"
^XWB(8994,4524,2,1,1,1,0)="Consult ID number (IEN) from CONSULTS/REQUESTS (#123) file."
