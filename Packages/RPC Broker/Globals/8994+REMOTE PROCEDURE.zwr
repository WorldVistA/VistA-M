^XWB(8994,3289,1,15,0)=" "
^XWB(8994,3289,1,16,0)="This RPC creates a new MAG WORK ITEM file (#2006.941) entry for the StorageCommit"
^XWB(8994,3289,1,17,0)="WORKLIST type, optionally querying the item's deep archive status first,"
^XWB(8994,3289,1,18,0)="and echoes back the submitted item as a response (MAG*3.0*79)."
^XWB(8994,3289,2,0)="^8994.02A^3^2"
^XWB(8994,3289,2,2,0)="MSGTAGS^2^^^1"
^XWB(8994,3289,2,2,1,0)="^8994.021^2^2^3120613^^^"
^XWB(8994,3289,2,2,1,1,0)="This is an array of tag names and values describing the work item and"
^XWB(8994,3289,2,2,1,2,0)="its child objects."
^XWB(8994,3289,2,3,0)="STAT^1^^0^2"
^XWB(8994,3289,2,3,1,0)="^8994.021^1^1^3120613^^^^"
^XWB(8994,3289,2,3,1,1,0)="The STAT flag, set to 1, initiates a query before returning data."
^XWB(8994,3289,2,"B","MSGTAGS",2)=""
