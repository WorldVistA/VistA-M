^XWB(8994,4163,3,3,0)="Otherwise, returns:"
^XWB(8994,4163,3,4,0)=" -1^[Error Message]"
^XWB(8994,4164,0)="DSIYAD02 FMUSERA^FMUSERA^DSIYAD02^4^^^^1"
^XWB(8994,4164,1,0)="^8994.01^6^6^3170726^^^^"
^XWB(8994,4164,1,1,0)="FMUSER"
^XWB(8994,4164,1,2,0)=" "
^XWB(8994,4164,1,3,0)="Returns file for either the current user or a specific user to show which "
^XWB(8994,4164,1,4,0)="files they have READ access to within FileMan"
^XWB(8994,4164,1,5,0)=" "
^XWB(8994,4164,1,6,0)="This RPC also returns the mapping of these files for AdHoc "
^XWB(8994,4164,2,0)="^8994.02A^4^4"
^XWB(8994,4164,2,1,0)="USER^1^20^0^1"
^XWB(8994,4164,2,1,1,0)="^^7^7^3160715^"
^XWB(8994,4164,2,1,1,1,0)="USER"
^XWB(8994,4164,2,1,1,2,0)=" "
^XWB(8994,4164,2,1,1,3,0)="If nothing is sent, data is returned for the current user (assuming DUZ "
^XWB(8994,4164,2,1,1,4,0)="value is set up)."
^XWB(8994,4164,2,1,1,5,0)=" "
^XWB(8994,4164,2,1,1,6,0)="If a value is sent, data is returned for the DUZ value sent in this "
^XWB(8994,4164,2,1,1,7,0)="parameter."
^XWB(8994,4164,2,2,0)="NOREC^1^5^0^2"
^XWB(8994,4164,2,2,1,0)="^^3^3^3160715^"
^XWB(8994,4164,2,2,1,1,0)="NOREC"
^XWB(8994,4164,2,2,1,2,0)=" "
^XWB(8994,4164,2,2,1,3,0)="Number of records to return, if nothing sent defaults to 500"
^XWB(8994,4164,2,3,0)="LAST^1^15^0^3"
^XWB(8994,4164,2,3,1,0)="^^5^5^3160715^"
^XWB(8994,4164,2,3,1,1,0)="LAST"
^XWB(8994,4164,2,3,1,2,0)=" "
^XWB(8994,4164,2,3,1,3,0)="This is the last record returned the last time this was called (if the "
^XWB(8994,4164,2,3,1,4,0)="GUI is calling it iteratively).  The next set of records will start with "
^XWB(8994,4164,2,3,1,5,0)="the next FILE."
^XWB(8994,4164,2,4,0)="SYS^1^1^1^4"
^XWB(8994,4164,2,4,1,0)="^8994.021^6^6^3170720^^"
^XWB(8994,4164,2,4,1,1,0)="SYS"
^XWB(8994,4164,2,4,1,2,0)=" "
^XWB(8994,4164,2,4,1,3,0)="Send 1:  Above PAR"
^XWB(8994,4164,2,4,1,4,0)="Send 2:  DSS Data Miner"
^XWB(8994,4164,2,4,1,5,0)=" "
^XWB(8994,4164,2,4,1,6,0)="Required"
^XWB(8994,4164,2,"B","LAST",3)=""
