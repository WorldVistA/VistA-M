^XWB(8994,3126,2,0)="^8994.02A^1^1"
^XWB(8994,3126,2,1,0)="PATIEN^1^128^1^1"
^XWB(8994,3126,2,1,1,0)="^8994.021^2^2^3100421^^^^"
