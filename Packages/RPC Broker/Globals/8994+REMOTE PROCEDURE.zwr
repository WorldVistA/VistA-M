^XWB(8994,3408,2,1,1,1,0)="Position Assignment History Record IEN"
^XWB(8994,3408,2,2,0)="SCFTIEN^1^20^1^2"
^XWB(8994,3408,2,2,1,0)="^^1^1^3150107^"
^XWB(8994,3408,2,2,1,1,0)="FTEE History Sub-Record IEN"
^XWB(8994,3408,2,"B","SCFTIEN",2)=""
