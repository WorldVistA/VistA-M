^XWB(8994,4982,2,2,1,11,0)="                '8' FOR VET SELF-CANCEL;"
^XWB(8994,4982,2,2,1,12,0)="SDINPUT(""COMMENT"")=FREE TEXT (1-80)                        OPTIONAL"
