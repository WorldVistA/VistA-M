^XWB(8994,2547,3,0)="^^13^13^3070820^"
^XWB(8994,2547,3,1,0)=" Global array.  Each node has 7 to 9 ^-pieces.  First 6 are described in"
^XWB(8994,2547,3,2,0)=" the VEJDSD GET SCHEDULED APPTS remote procedure return parameter"
^XWB(8994,2547,3,3,0)=" description.  The 7th ^-piece is a flag -"
^XWB(8994,2547,3,4,0)=" "
^XWB(8994,2547,3,5,0)=" Flag value 1=Either of the following conditions are met"
^XWB(8994,2547,3,6,0)="              A. Field #.3192 COVERED BY INSURANCE=NO or UNKNOWN"
^XWB(8994,2547,3,7,0)="              B. For ANY .312 field 3 entry"
^XWB(8994,2547,3,8,0)="                 IF Last verified more than n DAYS days before today"
^XWB(8994,2547,3,9,0)="                 AND  expiration date is > today OR"
^XWB(8994,2547,3,10,0)="                      expiration date is NULL"
^XWB(8994,2547,3,11,0)=" Flag value 0=Otherwise"
^XWB(8994,2547,3,12,0)=" Optionally, 8th and 9th ^-pieces have additional information"
^XWB(8994,2547,3,13,0)=" if insurance is verified as NO coverage."
^XWB(8994,2548,0)="DSIV PATIENT INSURANCE CHECK^CKINS^DSIVIC1^1^P"
^XWB(8994,2548,1,0)="^^1^1^3050325^"
^XWB(8994,2548,1,1,0)="Checks insurance for a single patient."
