^XWB(8994,4912,0)="SDES BLOCK AND MOVE^BLOCKANDMOVE^SDESBLOCKANDMOVE^2^R^0^^0^^^1"
^XWB(8994,4912,1,0)="^^5^5^3250206^"
^XWB(8994,4912,1,1,0)="This RPC allows the user to block and move an appointment. This will "
^XWB(8994,4912,1,2,0)="block the availability in the slot the appointment was originally in and "
^XWB(8994,4912,1,3,0)="move it to a new clinic."
^XWB(8994,4912,1,4,0)=" "
^XWB(8994,4912,1,5,0)="Can only be invoked by Acheron"
^XWB(8994,4912,2,0)="^8994.02A^1^1"
^XWB(8994,4912,2,1,0)="BLOCKANDMOVE^2^32000^1^1"
^XWB(8994,4912,2,1,1,0)="^8994.021^6^6^3250206^^"
^XWB(8994,4912,2,1,1,1,0)="This array contains the input parameters that are to be passed into block "
^XWB(8994,4912,2,1,1,2,0)="and move."
^XWB(8994,4912,2,1,1,3,0)=" "
^XWB(8994,4912,2,1,1,4,0)="S BLOCKANDMOVE(""APPOINTMENT IEN"")=297027"
^XWB(8994,4912,2,1,1,5,0)="S BLOCKANDMOVE(""TARGET CLINIC"")=4118"
^XWB(8994,4912,2,1,1,6,0)="S BLOCKANDMOVE(""TARGET DATE TIME"")=""2023-08-11T11:00-04:00"""
^XWB(8994,4912,2,"B","BLOCKANDMOVE",1)=""
