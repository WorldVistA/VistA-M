^XWB(8994,4594,2,2,1,9,0)="APPT SCHEDULED"
^XWB(8994,4594,2,2,1,10,0)="VET SELF-CANCEL"
^XWB(8994,4594,2,3,0)="COMMENTS^1^^0^3"
^XWB(8994,4594,2,3,1,0)="^8994.021^4^4^3211210^^"
