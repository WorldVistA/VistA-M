^XWB(8994,2540,3,0)="^^6^6^3101202^"
^XWB(8994,2540,3,1,0)="Returns INSURANCE BUFFER file entries for a specified patient."
^XWB(8994,2540,3,2,0)="  Each return value has the form -"
^XWB(8994,2540,3,3,0)="  BUFFER IEN^ << requested fields >> ^FLAGS^SYMBOL^ERR"
^XWB(8994,2540,3,4,0)="  FLAGS are the ""iIEYH"" flags,"
^XWB(8994,2540,3,5,0)="  SYMBOL is the IIV status (where the record is in electronic processing),"
^XWB(8994,2540,3,6,0)="  ERR is the one-line eIV error message (if applicable)"
