^XWB(8994,3147,2,4,1,1,0)="Desired date for the exam in HL7 format (TS): YYYYMMDD. If time is "
^XWB(8994,3147,2,4,1,2,0)="provided, it is ignored. The date must be exact."
^XWB(8994,3147,2,5,0)="RACAT^1^^1^5"
^XWB(8994,3147,2,5,1,0)="^^2^2^3080222^"
^XWB(8994,3147,2,5,1,1,0)="Exam category: internal value of the CATEGORY OF EXAM field (4) of the "
^XWB(8994,3147,2,5,1,2,0)="RAD/NUC MED ORDERS file (#75.1)."
^XWB(8994,3147,2,6,0)="REQLOC^1^^1^6"
^XWB(8994,3147,2,6,1,0)="^^1^1^3070515^"
^XWB(8994,3147,2,6,1,1,0)="IEN of the requesting location in the HOSPITAL LOCATION file (#44)."
^XWB(8994,3147,2,7,0)="REQPHYS^1^^1^7"
^XWB(8994,3147,2,7,1,0)="^^1^1^3070515^"
^XWB(8994,3147,2,7,1,1,0)="IEN of the requesting physician in the NEW PERSON file (#200)."
^XWB(8994,3147,2,8,0)="REASON^1^^1^8"
^XWB(8994,3147,2,8,1,0)="^8994.021^2^2^3070621^^"
^XWB(8994,3147,2,8,1,1,0)="Reason for study. See the REASON FOR STUDY field (1.1) of the RAD/NUC MED "
^XWB(8994,3147,2,8,1,2,0)="ORDERS file (#75.1) for details."
^XWB(8994,3147,2,9,0)="RAMSC^2^^^9"
^XWB(8994,3147,2,9,1,0)="^8994.021^54^54^3110519^^"
^XWB(8994,3147,2,9,1,1,0)="Items of this list define miscellaneous/optional order parameters. Each"
^XWB(8994,3147,2,9,1,2,0)="record has 3 or more pieces separated by '^':"
^XWB(8994,3147,2,9,1,3,0)=" "
^XWB(8994,3147,2,9,1,4,0)="  ^01: Parameter name"
^XWB(8994,3147,2,9,1,5,0)="  ^02: Index (for multiples and word-processing values)"
^XWB(8994,3147,2,9,1,6,0)="  ^03: Value1"
^XWB(8994,3147,2,9,1,7,0)="  ^04: Value2"
^XWB(8994,3147,2,9,1,8,0)="  ..."
^XWB(8994,3147,2,9,1,9,0)=" "
^XWB(8994,3147,2,9,1,10,0)="The following parameters are supported by this remote procedure:"
^XWB(8994,3147,2,9,1,11,0)="  "
^XWB(8994,3147,2,9,1,12,0)="  CLINHIST^{Seq#}^{Line of clinical history}"
^XWB(8994,3147,2,9,1,13,0)="    Text for the CLINICAL HISTORY FOR EXAM field (400)"
^XWB(8994,3147,2,9,1,14,0)="    of the file #75.1"
^XWB(8994,3147,2,9,1,15,0)=" "
^XWB(8994,3147,2,9,1,16,0)="  ISOLPROC^^{n|y}"
^XWB(8994,3147,2,9,1,17,0)="    Value for the ISOLATION PROCEDURES field (24)"
^XWB(8994,3147,2,9,1,18,0)="    of the file #75.1"
^XWB(8994,3147,2,9,1,19,0)=" "
^XWB(8994,3147,2,9,1,20,0)="  PREGNANT^^{n|u|y}"
^XWB(8994,3147,2,9,1,21,0)="    Value for the PREGNANT field (13) of the file #75.1"
^XWB(8994,3147,2,9,1,22,0)=" "
^XWB(8994,3147,2,9,1,23,0)="  PREOPDT^^{Internal date value}"
^XWB(8994,3147,2,9,1,24,0)="    Date and time for the PRE-OP SCHEDULED DATE/TIME"
^XWB(8994,3147,2,9,1,25,0)="    field (12) of the file #75.1 in HL7 format (TS):"
^XWB(8994,3147,2,9,1,26,0)="    YYYYMMDD[HHMM[+/-ZZZZ]]. If seconds are provided,"
^XWB(8994,3147,2,9,1,27,0)="    they are ignored. The date must be exact."
^XWB(8994,3147,2,9,1,28,0)=" "
^XWB(8994,3147,2,9,1,29,0)="  REQNATURE^^{e|i|p|s|v|w}"
^XWB(8994,3147,2,9,1,30,0)="    Value for the NATURE OF (NEW) ORDER ACTIVITY field (26)"
^XWB(8994,3147,2,9,1,31,0)="    of the file #75.1"
^XWB(8994,3147,2,9,1,32,0)=" "
^XWB(8994,3147,2,9,1,33,0)="  REQURG^^{1|2|9}"
^XWB(8994,3147,2,9,1,34,0)="    Value for the REQUEST URGENCY field (6)"
^XWB(8994,3147,2,9,1,35,0)="    of the file #75.1"
^XWB(8994,3147,2,9,1,36,0)=" "
^XWB(8994,3147,2,9,1,37,0)="  TRANSPMODE^^{a|p|s|w}"
^XWB(8994,3147,2,9,1,38,0)="    Value for the MODE OF TRANSPORT field (19)"
^XWB(8994,3147,2,9,1,39,0)="    of the file #75.1"
^XWB(8994,3147,2,9,1,40,0)=" "
^XWB(8994,3147,2,9,1,41,0)="Records can be added to the list in any order. See the comments preceding"
^XWB(8994,3147,2,9,1,42,0)="the $$ORDER^RAMAG02 for more details."
^XWB(8994,3147,2,9,1,43,0)=" "
^XWB(8994,3147,2,9,1,44,0)="Example:"
^XWB(8994,3147,2,9,1,45,0)=" "
^XWB(8994,3147,2,9,1,46,0)="  with RPCBroker.Param[8] do"
^XWB(8994,3147,2,9,1,47,0)="    begin"
^XWB(8994,3147,2,9,1,48,0)="      PType := list;"
^XWB(8994,3147,2,9,1,49,0)="      Mult[1] := 'PREGNANT^^y';"
^XWB(8994,3147,2,9,1,50,0)="      Mult[2] := 'PREOPDT^^200001041400';"
^XWB(8994,3147,2,9,1,51,0)="      Mult[3] := 'CLINHIST^1^Clinical history line #1';"
^XWB(8994,3147,2,9,1,52,0)="      Mult[4] := 'CLINHIST^2^Clinical history line #2';"
^XWB(8994,3147,2,9,1,53,0)="      Mult[5] := 'CLINHIST^3^Clinical history line #3';"
^XWB(8994,3147,2,9,1,54,0)="    end;"
^XWB(8994,3147,2,"B","RACAT",5)=""
^XWB(8994,3147,2,"B","RADFN",1)=""
^XWB(8994,3147,2,"B","RAMLC",2)=""
^XWB(8994,3147,2,"B","RAMSC",9)=""
^XWB(8994,3147,2,"B","RAPROC",3)=""
^XWB(8994,3147,2,"B","REASON",8)=""
^XWB(8994,3147,2,"B","REQDTE",4)=""
^XWB(8994,3147,2,"B","REQLOC",6)=""
^XWB(8994,3147,2,"B","REQPHYS",7)=""
^XWB(8994,3147,2,"PARAMSEQ",1,1)=""
^XWB(8994,3147,2,"PARAMSEQ",2,2)=""
^XWB(8994,3147,2,"PARAMSEQ",3,3)=""
^XWB(8994,3147,2,"PARAMSEQ",4,4)=""
^XWB(8994,3147,2,"PARAMSEQ",5,5)=""
^XWB(8994,3147,2,"PARAMSEQ",6,6)=""
^XWB(8994,3147,2,"PARAMSEQ",7,7)=""
^XWB(8994,3147,2,"PARAMSEQ",8,8)=""
^XWB(8994,3147,2,"PARAMSEQ",9,9)=""
^XWB(8994,3147,3,0)="^8994.03^24^24^3110519^^^"
^XWB(8994,3147,3,1,0)="A negative value of the first '^'-piece of the Results[0] indicates that"
^XWB(8994,3147,3,2,0)="an error occurred during the execution of the remote procedure. In this"
^XWB(8994,3147,3,3,0)="case, the second piece of the Results[0] will contain number of the error"
^XWB(8994,3147,3,4,0)="descriptors returned in the subsequent nodes of the Results array."
^XWB(8994,3147,3,5,0)=" "
^XWB(8994,3147,3,6,0)="  Results[0]            Result descriptor"
^XWB(8994,3147,3,7,0)="                          ^01: The last error code"
^XWB(8994,3147,3,8,0)="                          ^02: Number of error descriptors"
^XWB(8994,3147,3,9,0)="  "
^XWB(8994,3147,3,10,0)="  Results[i]            Error descriptor"
^XWB(8994,3147,3,11,0)="                          ^01: Error code"
^XWB(8994,3147,3,12,0)="                          ^02: Message"
^XWB(8994,3147,3,13,0)="                          ^03: Error location"
^XWB(8994,3147,3,14,0)="                          ^04: Error type"
^XWB(8994,3147,3,15,0)="  "
^XWB(8994,3147,3,16,0)="  Results[j]            Line of the additional info"
^XWB(8994,3147,3,17,0)="                          ^01: """" (empty)"
^XWB(8994,3147,3,18,0)="                          ^02: Text"
^XWB(8994,3147,3,19,0)=" "
^XWB(8994,3147,3,20,0)="Error descriptors are returned in reverse chronological order (most recent"
^XWB(8994,3147,3,21,0)="first)."
^XWB(8994,3147,3,22,0)=" "
^XWB(8994,3147,3,23,0)="Otherwise, the Results[0] contains IEN of the new order in the RAD/NUC MED"
^XWB(8994,3147,3,24,0)="ORDERS file (#75.1)."
^XWB(8994,3148,0)="MAGV RAD EXAM REGISTER^XMREGSTR^MAGVIM05^2^R^^^1"
^XWB(8994,3148,1,0)="^8994.01^4^4^3110519^^^^"
^XWB(8994,3148,1,1,0)="Wraps a call to the RAMAG EXAM REGISTER remote procedure, and re-formats"
^XWB(8994,3148,1,2,0)="the output for the DICOM Importer II application. Returns the IEN of"
^XWB(8994,3148,1,3,0)="the new case in the RAD/NUC MED PATIENT file (#70), or an array"
^XWB(8994,3148,1,4,0)="of error messages."
^XWB(8994,3148,2,0)="^8994.02A^3^3"
^XWB(8994,3148,2,1,0)="RAOIFN^1^^1^1"
^XWB(8994,3148,2,1,1,0)="^8994.021^1^1^3070621^^"
^XWB(8994,3148,2,1,1,1,0)="IEN of the order in the RAD/NUC MED ORDERS file (#75.1)."
^XWB(8994,3148,2,2,0)="EXMDTE^1^^1^2"
^XWB(8994,3148,2,2,1,0)="^^3^3^3090224^"
^XWB(8994,3148,2,2,1,1,0)="Date and time of the exam in HL7 format (TS): YYYYMMDDHHMM[+/-ZZZZ]. If "
^XWB(8994,3148,2,2,1,2,0)="seconds are provided, they are ignored. The date must be exact and the "
^XWB(8994,3148,2,2,1,3,0)="time is required."
^XWB(8994,3148,2,3,0)="RAMSC^2^^^3"
^XWB(8994,3148,2,3,1,0)="^8994.021^83^83^3080606^^^"
^XWB(8994,3148,2,3,1,1,0)="Items of this list define miscellaneous/optional exam parameters. Each"
^XWB(8994,3148,2,3,1,2,0)="record has 3 or more pieces separated by '^':"
^XWB(8994,3148,2,3,1,3,0)=" "
^XWB(8994,3148,2,3,1,4,0)="  ^01: Parameter name"
^XWB(8994,3148,2,3,1,5,0)="  ^02: Index (for multiples and word-processing values)"
^XWB(8994,3148,2,3,1,6,0)="  ^03: Value1"
^XWB(8994,3148,2,3,1,7,0)="  ^04: Value2"
^XWB(8994,3148,2,3,1,8,0)="  ..."
^XWB(8994,3148,2,3,1,9,0)=" "
^XWB(8994,3148,2,3,1,10,0)="The following parameters are supported by this remote procedure:"
^XWB(8994,3148,2,3,1,11,0)=" "
^XWB(8994,3148,2,3,1,12,0)="  BEDSECT^^{IEN #42.4}"
^XWB(8994,3148,2,3,1,13,0)="    Internal value for the BEDSECTION field (19) of"
^XWB(8994,3148,2,3,1,14,0)="    the EXAMINATIONS multiple (sub-file #70.03)."
^XWB(8994,3148,2,3,1,15,0)=" "
^XWB(8994,3148,2,3,1,16,0)="  EXAMCAT^^{C|E|I|O|R|S}"
^XWB(8994,3148,2,3,1,17,0)="    Value for the CATEGORY OF EXAM field (4) of the"
^XWB(8994,3148,2,3,1,18,0)="    EXAMINATIONS multiple (sub-file #70.03)."
^XWB(8994,3148,2,3,1,19,0)=" "
^XWB(8994,3148,2,3,1,20,0)="  FLAGS^^{flags}"
^XWB(8994,3148,2,3,1,21,0)="    Flags that control the execution (can be combined):"
^XWB(8994,3148,2,3,1,22,0)=" "
^XWB(8994,3148,2,3,1,23,0)="    A  If this flag is provided, then the registration "
^XWB(8994,3148,2,3,1,24,0)="       entry point adds the new case to the existing"
^XWB(8994,3148,2,3,1,25,0)="       ones with the same date/time instead of "
^XWB(8994,3148,2,3,1,26,0)="       returning the error code -28."
^XWB(8994,3148,2,3,1,27,0)=" "
^XWB(8994,3148,2,3,1,28,0)="       If the existing date/time record stores an exam "
^XWB(8994,3148,2,3,1,29,0)="       set and the ""D"" flag is not provided, then the"
^XWB(8994,3148,2,3,1,30,0)="       error code -54 is returned."
^XWB(8994,3148,2,3,1,31,0)=" "
^XWB(8994,3148,2,3,1,32,0)="    D  If there is an existing case with the same "
^XWB(8994,3148,2,3,1,33,0)="       date/time, then the time of the new case is"
^XWB(8994,3148,2,3,1,34,0)="       incremented by 1 minute until an unused date/time"
^XWB(8994,3148,2,3,1,35,0)="       is found."
^XWB(8994,3148,2,3,1,36,0)=" "
^XWB(8994,3148,2,3,1,37,0)="       If the ""A"" flag is also provided, then time "
^XWB(8994,3148,2,3,1,38,0)="       increments also stop when a non-examset"
^XWB(8994,3148,2,3,1,39,0)="       date/time record is found."
^XWB(8994,3148,2,3,1,40,0)=" "
^XWB(8994,3148,2,3,1,41,0)="       If the date is also changed during the time "
^XWB(8994,3148,2,3,1,42,0)="       modification, then the case is not registered and"
^XWB(8994,3148,2,3,1,43,0)="       the error code -29 is returned."
^XWB(8994,3148,2,3,1,44,0)=" "
^XWB(8994,3148,2,3,1,45,0)="  PRINCLIN^^{IEN #44}"
^XWB(8994,3148,2,3,1,46,0)="    Internal value for the PRINCIPAL CLINIC field (8) of"
^XWB(8994,3148,2,3,1,47,0)="    the EXAMINATIONS multiple (sub-file #70.03)."
^XWB(8994,3148,2,3,1,48,0)=" "
^XWB(8994,3148,2,3,1,49,0)="  RAPROC^{Seq#}^{IEN #71}^{IEN #71.2}^{IEN #71.2}^..."
^XWB(8994,3148,2,3,1,50,0)="    Radiology procedure and optional modifiers."
^XWB(8994,3148,2,3,1,51,0)=" "
^XWB(8994,3148,2,3,1,52,0)="  SERVICE^^{IEN #49}"
^XWB(8994,3148,2,3,1,53,0)="    Internal value for the SERVICE field (7) of"
^XWB(8994,3148,2,3,1,54,0)="    the EXAMINATIONS multiple (sub-file #70.03)."
^XWB(8994,3148,2,3,1,55,0)=" "
^XWB(8994,3148,2,3,1,56,0)="  SINGLERPT^^{0|1}"
^XWB(8994,3148,2,3,1,57,0)="    If this parameter is defined and not 0, then all"
^XWB(8994,3148,2,3,1,58,0)="    cases should be associated with the same order"
^XWB(8994,3148,2,3,1,59,0)="    and they will share the same report. See the"
^XWB(8994,3148,2,3,1,60,0)="    MEMBER OF SET (25) and IMAGING ORDER (11) fields"
^XWB(8994,3148,2,3,1,61,0)="    of the sub-file #70.03 for more details."
^XWB(8994,3148,2,3,1,62,0)=" "
^XWB(8994,3148,2,3,1,63,0)="  TECHCOMM^^{text}"
^XWB(8994,3148,2,3,1,64,0)="    Value for the TECHNOLOGIST COMMENT field (4) of the"
^XWB(8994,3148,2,3,1,65,0)="    ACTIVITY LOG multiple (sub-file #70.07). "
^XWB(8994,3148,2,3,1,66,0)=" "
^XWB(8994,3148,2,3,1,67,0)="  WARD^^{IEN #42}"
^XWB(8994,3148,2,3,1,68,0)="    Internal value for the WARD field (6) of"
^XWB(8994,3148,2,3,1,69,0)="    the EXAMINATIONS multiple (sub-file #70.03)."
^XWB(8994,3148,2,3,1,70,0)=" "
^XWB(8994,3148,2,3,1,71,0)="Records can be added to the list in any order. See the comments preceding"
^XWB(8994,3148,2,3,1,72,0)="the $$REGISTER^RAMAG03 for more details."
^XWB(8994,3148,2,3,1,73,0)=" "
^XWB(8994,3148,2,3,1,74,0)="Example:"
^XWB(8994,3148,2,3,1,75,0)=" "
^XWB(8994,3148,2,3,1,76,0)="  with RPCBroker.Param[2] do"
^XWB(8994,3148,2,3,1,77,0)="    begin"
^XWB(8994,3148,2,3,1,78,0)="      PType := list;"
^XWB(8994,3148,2,3,1,79,0)="      Mult[1] := 'BEDSECT^^12';"
^XWB(8994,3148,2,3,1,80,0)="      Mult[2] := 'SERVICE^^43';"
^XWB(8994,3148,2,3,1,81,0)="      Mult[3] := 'WARD^^456';"
^XWB(8994,3148,2,3,1,82,0)="      Mult[4] := 'EXAMCAT^^I';"
^XWB(8994,3148,2,3,1,83,0)="    end;"
^XWB(8994,3148,2,"B","EXMDTE",2)=""
^XWB(8994,3148,2,"B","RAMSC",3)=""
^XWB(8994,3148,2,"B","RAOIFN",1)=""
^XWB(8994,3148,2,"PARAMSEQ",1,1)=""
^XWB(8994,3148,2,"PARAMSEQ",2,2)=""
^XWB(8994,3148,2,"PARAMSEQ",3,3)=""
^XWB(8994,3148,3,0)="^8994.03^39^39^3090224^^"
^XWB(8994,3148,3,1,0)="A negative value of the first '^'-piece of the Results[0] indicates that"
^XWB(8994,3148,3,2,0)="an error occurred during the execution of the remote procedure. In this"
^XWB(8994,3148,3,3,0)="case, the second piece of the Results[0] will contain number of the error"
^XWB(8994,3148,3,4,0)="descriptors returned in the subsequent nodes of the Results array."
^XWB(8994,3148,3,5,0)=" "
^XWB(8994,3148,3,6,0)="  Results[0]            Result descriptor"
^XWB(8994,3148,3,7,0)="                          ^01: The last error code"
^XWB(8994,3148,3,8,0)="                          ^02: Number of error descriptors"
^XWB(8994,3148,3,9,0)="  "
^XWB(8994,3148,3,10,0)="  Results[i]            Error descriptor"
^XWB(8994,3148,3,11,0)="                          ^01: Error code"
^XWB(8994,3148,3,12,0)="                          ^02: Message"
^XWB(8994,3148,3,13,0)="                          ^03: Error location"
^XWB(8994,3148,3,14,0)="                          ^04: Error type"
^XWB(8994,3148,3,15,0)="  "
^XWB(8994,3148,3,16,0)="  Results[j]            Line of the additional info"
^XWB(8994,3148,3,17,0)="                          ^01: """" (empty)"
^XWB(8994,3148,3,18,0)="                          ^02: Text"
^XWB(8994,3148,3,19,0)=" "
^XWB(8994,3148,3,20,0)="Error descriptors are returned in reverse chronological order (most recent"
^XWB(8994,3148,3,21,0)="first)."
^XWB(8994,3148,3,22,0)=" "
^XWB(8994,3148,3,23,0)="Otherwise, number of registered examinations is returned in the Results[0]"
^XWB(8994,3148,3,24,0)="and identifiers of the examinations are returned in the subsequent"
^XWB(8994,3148,3,25,0)="elements of the array. "
^XWB(8994,3148,3,26,0)=" "
^XWB(8994,3148,3,27,0)="  Results[0]            Number of registered examinations "
^XWB(8994,3148,3,28,0)=" "
^XWB(8994,3148,3,29,0)="  Results[i]            Exam/case identifiers"
^XWB(8994,3148,3,30,0)="                          ^01: IEN of the patient in the file #70"
^XWB(8994,3148,3,31,0)="                          ^02: IEN in the REGISTERED EXAMS multiple"
^XWB(8994,3148,3,32,0)="                          ^03: IEN in the EXAMINATIONS multiple"
^XWB(8994,3148,3,33,0)="                          ^04: Case number"
^XWB(8994,3148,3,34,0)="                          ^05: Accession number"
^XWB(8994,3148,3,35,0)="                                SSS-MMDDYY-NNNNN  if RA*5*47 is installed;"
^XWB(8994,3148,3,36,0)="                                    MMDDYY-NNNNN  otherwise."
^XWB(8994,3148,3,37,0)="                          ^06: Actual date and time of the case (value of"
