^XWB(8994,977,1,0)="^8994.01^2^2^3000516^^^^"
^XWB(8994,977,1,1,0)="Certain actions performed by a user are tracked for statistical purposes"
^XWB(8994,977,1,2,0)="in the IMAGING WINDOWS SESSIONS and IMAGING WINDOWS WORKSTATIONS files."
^XWB(8994,977,2,0)="^8994.02A^1^1"
