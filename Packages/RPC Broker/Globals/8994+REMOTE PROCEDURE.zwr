^XWB(8994,896,2,3,1,0)="^^3^3^3101006^"
^XWB(8994,896,2,3,1,1,0)="Defines the scope of the report:"
^XWB(8994,896,2,3,1,2,0)="  'H' indicates HOSPITAL"
^XWB(8994,896,2,3,1,3,0)="  'D' indicates DOM"
^XWB(8994,896,2,4,0)="DVBADLMTR^1^^0^4"
^XWB(8994,896,2,4,1,0)="^8994.021^3^3^3120307^^^^"
^XWB(8994,896,2,4,1,1,0)="This is an optional parameter, which when defined with the final end date "
^XWB(8994,896,2,4,1,2,0)="selected in the GUI, will produce a delimited report. If this parameter "
^XWB(8994,896,2,4,1,3,0)="is undefined, null or 0 then the standard report format will be generated."
^XWB(8994,896,2,"B","BDATE",1)=""
