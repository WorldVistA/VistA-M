^XWB(8994,4019,2,4,1,17,0)="                    Limit = 40 characters"
^XWB(8994,4019,2,4,1,18,0)=" "
^XWB(8994,4019,2,4,1,19,0)="GROUP CATEGORY (445.6)"
^XWB(8994,4019,2,4,1,20,0)="  DSIYDAT(.01) = Group Category Code"
