^XWB(8994,4970,0)="SDES2 PATIENT SEARCH^SEARCH^SDES2PATSEARCH^2^R^^^^^^1"
^XWB(8994,4970,1,0)="^^5^5^3250214^"
^XWB(8994,4970,1,1,0)="This RPC will return patients and their associated data based on search "
^XWB(8994,4970,1,2,0)=" criteria passed in by the user (PARTIAL NAME, DOB, SSN, FIRST INITIAL OF "
^XWB(8994,4970,1,3,0)=" LAST NAME+LAST4 OF SSN)."
^XWB(8994,4970,1,4,0)=" "
^XWB(8994,4970,1,5,0)="Can only be invoked by Acheron"
^XWB(8994,4970,2,0)="^8994.02A^4^2"
^XWB(8994,4970,2,3,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,4970,2,3,1,0)="^^10^10^3231115^"
^XWB(8994,4970,2,3,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number. "
^XWB(8994,4970,2,3,1,2,0)="            Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,4970,2,3,1,3,0)=" SDCONTEXT(""PATIENT DFN"") = The DFN/IEN of the target patient from the"
^XWB(8994,4970,2,3,1,4,0)="            calling application."
^XWB(8994,4970,2,3,1,5,0)=" SDCONTEXT(""PATIENT ICN"") = The ICN of the target patient from the"
^XWB(8994,4970,2,3,1,6,0)="            calling application."
^XWB(8994,4970,2,3,1,7,0)=" SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action in the"
^XWB(8994,4970,2,3,1,8,0)="            calling application."
^XWB(8994,4970,2,3,1,9,0)=" SDCONTEXT(""USER SECID"") = The SECID of the user taking action in"
^XWB(8994,4970,2,3,1,10,0)="            the calling application."
^XWB(8994,4970,2,4,0)="PARAMS^2^32000^1^2"
^XWB(8994,4970,2,4,1,0)="^8994.021^6^6^3250214^^"
^XWB(8994,4970,2,4,1,1,0)="PARAMS(""SEARCHSTRING"")= This is a free text input parameter that holds "
^XWB(8994,4970,2,4,1,2,0)="the search criteria entered by the user. Minimum of 3 characters required."
^XWB(8994,4970,2,4,1,3,0)=" "
^XWB(8994,4970,2,4,1,4,0)="PARAMS(""NUMOFRECORDS"")= This is the number of records the user is "
^XWB(8994,4970,2,4,1,5,0)="requesting be passed back. This number has an upper limit of 50. If it is"
^XWB(8994,4970,2,4,1,6,0)="not passed in, it will default to 10 records."
