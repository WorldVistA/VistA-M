^XWB(8994,4018,2,1,1,4,0)="Special input:"
^XWB(8994,4018,2,1,1,5,0)="""P"" indicates to return totals for all Primary DP's"
^XWB(8994,4018,2,1,1,6,0)="""S"" indicates to return totals for all Secondary DP's"
^XWB(8994,4018,2,1,1,7,0)="""A"" indicates to return totals for the entire inventory"
