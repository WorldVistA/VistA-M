^XWB(8994,2566,3,10,0)="                          ^01: Error code"
^XWB(8994,2566,3,11,0)="                          ^02: Message"
^XWB(8994,2566,3,12,0)="                          ^03: Error location"
^XWB(8994,2566,3,13,0)="                          ^04: Message type"
^XWB(8994,2566,3,14,0)=" "
^XWB(8994,2566,3,15,0)="  Results[j]            Line of the additional info (optional)"
^XWB(8994,2566,3,16,0)="                          ^01: """""
^XWB(8994,2566,3,17,0)="                          ^02: Text"
^XWB(8994,2566,3,18,0)="  "
^XWB(8994,2566,3,19,0)="Otherwise, '1^Ok' is returned in the Results[0]."
^XWB(8994,2567,0)="MAGG IMAGE GET PROPERTIES^GETPROPS^MAGGA02^2^R^^^1"
^XWB(8994,2567,1,0)="^8994.01^5^5^3090501^^^"
^XWB(8994,2567,1,1,0)="This remote procedure returns values of one or more image properties"
^XWB(8994,2567,1,2,0)="(fields of the record of the IMAGE (#2005) or IMAGE AUDIT (#2005.1) file)."
^XWB(8994,2567,1,3,0)=" "
^XWB(8994,2567,1,4,0)="If a field is tracked (audited), then a previous value of this field on a "
^XWB(8994,2567,1,5,0)="certain date/time can be requested (see the ADT parameter)."
^XWB(8994,2567,2,0)="^8994.02A^4^4"
^XWB(8994,2567,2,1,0)="IMGIEN^1^^1^1"
^XWB(8994,2567,2,1,1,0)="^^1^1^3080404^"
^XWB(8994,2567,2,1,1,1,0)="IEN of the image record in the IMAGE file (#2005)."
^XWB(8994,2567,2,2,0)="PROPLST^1^^1^2"
^XWB(8994,2567,2,2,1,0)="^^40^40^3081216^"
^XWB(8994,2567,2,2,1,1,0)="Property names separated by semicolons or one of the following special"
^XWB(8994,2567,2,2,1,2,0)="characters:"
^XWB(8994,2567,2,2,1,3,0)=" "
^XWB(8994,2567,2,2,1,4,0)="  *  All supported properties"
^XWB(8994,2567,2,2,1,5,0)=" "
^XWB(8994,2567,2,2,1,6,0)="  #  Image indexes (IXCLASS, IXORIGIN, IXPKG, "
^XWB(8994,2567,2,2,1,7,0)="     IXPROC, IXSPEC, and IXTYPE)."
^XWB(8994,2567,2,2,1,8,0)=" "
^XWB(8994,2567,2,2,1,9,0)="Below is the list of properties supported by this remote procedure:"
^XWB(8994,2567,2,2,1,10,0)=" "
^XWB(8994,2567,2,2,1,11,0)="  Property Name   Field Name and Number"
^XWB(8994,2567,2,2,1,12,0)="  -------------   ------------------------------"
^XWB(8994,2567,2,2,1,13,0)="  CAPTAPP         CAPTURE APPLICATION (8.1)"
^XWB(8994,2567,2,2,1,14,0)="  CRTNDT          CREATION DATE (110)"
^XWB(8994,2567,2,2,1,15,0)="  DTSAVED         DATE/TIME IMAGE SAVED (7)"
^XWB(8994,2567,2,2,1,16,0)="  GDESC           SHORT DESCRIPTION (10)"
^XWB(8994,2567,2,2,1,17,0)="  IDFN            PATIENT (5)"
^XWB(8994,2567,2,2,1,18,0)="  ISTAT           STATUS (113)"
^XWB(8994,2567,2,2,1,19,0)="  ISTATBY         STATUS BY (113.2)"
^XWB(8994,2567,2,2,1,20,0)="  ISTATDT         STATUS DATE (113.1)"
