^XWB(8994,4410,2,1,0)="ORTXT^2^^1^1"
^XWB(8994,4410,2,1,1,0)="^8994.021^13^13^3160317^^^^"
^XWB(8994,4410,2,1,1,1,0)="ORTXT - Array containing data to be saved into the Copy Buffer"
^XWB(8994,4410,2,1,1,2,0)="    Components of ORTXT:"
^XWB(8994,4410,2,1,1,3,0)="      ORTXT(1..n,0)=""dfn^dt^ien;pkg^capturepkg"""
^XWB(8994,4410,2,1,1,4,0)="        Piece 1: Input User DUZ"
