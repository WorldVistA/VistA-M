^XWB(8994,921,3,6,0)="  3.  National Number"
^XWB(8994,921,3,7,0)="  4.  Inactive Date"
^XWB(8994,921,3,8,0)="  5.  Synonym"
^XWB(8994,921,3,9,0)="  6.  CPT IEN"
^XWB(8994,921,3,10,0)="  7.  CPT code"
^XWB(8994,921,3,11,0)="  8.  CPT Short Name"
