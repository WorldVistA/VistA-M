^XWB(8994,3800,3,3,0)=" if success"
^XWB(8994,3800,3,4,0)="  MAGRY(0)    = Success status ^^#CNT - where #CNT is a number of records returned"
^XWB(8994,3800,3,5,0)="  MAGRY(1)    = ""^"" delimited string with all field names in NETWORK LOCATION file (#2005.2)"
^XWB(8994,3800,3,6,0)="  MAGRY(2..n) = ""^"" delimited string with values of fields listed in MAGRY(1) "
^XWB(8994,3801,0)="MAGN PARAM GET LIST^GPARLIST^MAGNPARM^2^R^0"
