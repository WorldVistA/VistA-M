^XWB(8994,4288,2,2,1,2,0)=" "
^XWB(8994,4288,2,2,1,3,0)="DSSOITM - If null, all items in the Item Master file (#441)"
^XWB(8994,4288,2,2,1,4,0)="             are returned."
^XWB(8994,4288,2,2,1,5,0)="           If a starting value is requested, a list of items"
^XWB(8994,4288,2,2,1,6,0)="             beginning with that value are returned."
^XWB(8994,4288,2,2,1,7,0)="           If a particular item is specified, information for"
^XWB(8994,4288,2,2,1,8,0)="             that item is returned."
^XWB(8994,4288,2,2,1,9,0)="  NOTE:  If input, the item must be at least three characters."
