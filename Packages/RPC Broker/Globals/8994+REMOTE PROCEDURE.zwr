^XWB(8994,2536,2,11,1,3,0)="0=FALSE (Default - Do not create new entry)."
^XWB(8994,2536,2,12,0)="IVMREPTR^1^4^0^12"
^XWB(8994,2536,2,12,1,0)="^8994.021^2^2^3050510^^^"
^XWB(8994,2536,2,12,1,1,0)="Internal entry number in IVM REASONS FOR NOT UPLOADING INSURANCE"
