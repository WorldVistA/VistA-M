^XWB(8994,3282,2,1,1,10,0)="        (n)=VST^OL^ Outside Location for Historical visits"
^XWB(8994,3282,2,1,1,11,0)="        (n)=VST^SC^ Service Connected related?"
^XWB(8994,3282,2,1,1,12,0)="        (n)=VST^AO^ Agent Orange related?"
^XWB(8994,3282,2,1,1,13,0)="        (n)=VST^IR^ Ionizing Radiation related?"
^XWB(8994,3282,2,1,1,14,0)="        (n)=VST^EC^ Environmental Contaminates related?"
^XWB(8994,3282,2,1,1,15,0)="        (n)=VST^MST^ Military Sexual Trauma related?"
^XWB(8994,3282,2,1,1,16,0)="        (n)=VST^HNC^ Head and/or Neck Cancer related?"
^XWB(8994,3282,2,1,1,17,0)="        (n)=VST^CV^ Combat Vet related?"
^XWB(8994,3282,2,1,1,18,0)="        (n)=VST^SHD^ Shipboard Hazard and Defense related?"
^XWB(8994,3282,2,1,1,19,0)="        (n)=PRV(+:  add, -: delete) ^ Provider IEN ^^^ Provider Name ^"
^XWB(8994,3282,2,1,1,20,0)="            Primary Provider?"
^XWB(8994,3282,2,1,1,21,0)="        (n)=POV(+:  add, -: delete) ^ ICD diagnosis code ^ Category  ^ "
^XWB(8994,3282,2,1,1,22,0)="            Narrative (Diagnosis description) ^ Primary Diagnosis? ^"
^XWB(8994,3282,2,1,1,23,0)="            Provider String ^ Add to Problem List? ^^^ Next comment"
^XWB(8994,3282,2,1,1,24,0)="            sequence # if saving comments"
^XWB(8994,3282,2,1,1,25,0)="        (n)=COM^COM (Comments) ^ Next comment sequence # ^ @ = no "
^XWB(8994,3282,2,1,1,26,0)="            comments added"
^XWB(8994,3282,2,1,1,27,0)="        (n)=CPT (+:  add, -: delete) ^ Procedural  CPT code ^ Category ^ "
^XWB(8994,3282,2,1,1,28,0)="            Narrative (Procedure description) ^ Quantity ^ Provider IEN"
^XWB(8994,3282,2,1,1,29,0)="            ^^^ [# of modifiers;  Modifier code/Modifier IEN ^ Next"
^XWB(8994,3282,2,1,1,30,0)="            comment sequence # ^"
^XWB(8994,3282,2,1,1,31,0)="        (n)=IMM (+:  add, -: delete) ^ Immunization IEN ^ Category ^ "
^XWB(8994,3282,2,1,1,32,0)="            Narrative (Immunization description/name) ^ Series ^"
^XWB(8994,3282,2,1,1,33,0)="            Encounter Provider ^ Reaction ^ Contraindicated? ^ ^"
^XWB(8994,3282,2,1,1,34,0)="            Next comment sequence # ^ CVX Code ^ Event Info Source HL7 "
^XWB(8994,3282,2,1,1,35,0)="            Code;IEN ^ Dose;Units;Units IEN ^ Route Name;HL7 Code;IEN ^"
^XWB(8994,3282,2,1,1,36,0)="            Admin Site Name;HL7 Code;IEN ^ Lot#;IEN ^ Manufacturer ^"
^XWB(8994,3282,2,1,1,37,0)="            Expiration Date ^ Event Date and Time ^ Ordering Provider ^"
^XWB(8994,3282,2,1,1,38,0)="            VIS IEN/VIS Date; VIS IEN n/VIS Date n ^ Remarks Start Seq"
^XWB(8994,3282,2,1,1,39,0)="            #;Remarks End Seq # ^ Warning Ack ^ Override Reason (Seq #)"
^XWB(8994,3282,2,1,1,40,0)="            ^ Result (Smallpox) ^ Reading ^ D/T Read ^ Reader ^ Reading"
^XWB(8994,3282,2,1,1,41,0)="            Comment Seq # ^ V Immunization IEN (should only be populated"
^XWB(8994,3282,2,1,1,42,0)="            for a reading) ^ Ordered By Policy"
^XWB(8994,3282,2,1,1,43,0)="        (n)=SK (+:  add, -: delete) ^ Skin Test IEN ^ Category ^ "
^XWB(8994,3282,2,1,1,44,0)="            Narrative (Skin Test description/name) ^ Results ^ Enc"
^XWB(8994,3282,2,1,1,45,0)="            Provider ^ Reading ^ D/T Read ^ ^ Next comment sequence # ^"
^XWB(8994,3282,2,1,1,46,0)="            Reader ^ ^ ^ Reading Comment (Seq #) ^ Anatomic Location of"
^XWB(8994,3282,2,1,1,47,0)="            Placement;HL7 Code;IEN ^ Placement V Skin Test IEN ^ ^ ^ Event"
^XWB(8994,3282,2,1,1,48,0)="            D/T ^ Ordering Provider"
^XWB(8994,3282,2,1,1,49,0)="        (n)=PED (+:  add, -: delete) ^ Patient Education IEN ^ Category ^ "
^XWB(8994,3282,2,1,1,50,0)="            Narrative (Patient Education description/name) ^ Level of"
^XWB(8994,3282,2,1,1,51,0)="            understanding ^^^^^ ^^ Next comment sequence #"
^XWB(8994,3282,2,1,1,52,0)="        (n)=HF (+:  add, -: delete) ^ Health Factor IEN ^ Category ^ "
^XWB(8994,3282,2,1,1,53,0)="            Narrative (Health Factor description/name) ^ Level ^^^^^ Next"
^XWB(8994,3282,2,1,1,54,0)="            comment sequence # ^ Get Reminder"
^XWB(8994,3282,2,1,1,55,0)="        (n)=XAM(+:  add, -: delete) ^ Exam IEN ^ Category ^ Narrative "
^XWB(8994,3282,2,1,1,56,0)="            (Exam description/name) ^ Results ^^^^^ Next comment sequence"
^XWB(8994,3282,2,1,1,57,0)="            #"
^XWB(8994,3282,2,1,1,58,0)="        (n)=ICR (+:  add, -: delete) ^ Variable Pointer IMM"
^XWB(8994,3282,2,1,1,59,0)="            Contraindication Reasons/IMM Refusal Reasons ^ Category ^"
^XWB(8994,3282,2,1,1,60,0)="            Narrative ^ Immunization IEN ^ Warn Until Date ^ Event"
^XWB(8994,3282,2,1,1,61,0)="            Date/Time ^ Enc Provider IEN ^ Refused Vaccine Group"
^XWB(8994,3282,2,1,1,62,0)="            ^ Next comment sequence #"
^XWB(8994,3282,2,1,1,63,0)="        (n)=SC (+:  add, -: delete) ^ Code ^ Category ^ Narrative ^ "
^XWB(8994,3282,2,1,1,64,0)="            Coding System ^ Enc Provider ^ Magnitude ^ UCUM Code ^ ^ Next"
^XWB(8994,3282,2,1,1,65,0)="            comment sequence # ^ Event D/T ^ Ordering Provider"
^XWB(8994,3282,2,2,0)="LOC^1^40^0^2"
^XWB(8994,3282,2,2,1,0)="^^2^2^3140225^"
^XWB(8994,3282,2,2,1,1,0)="This is the hospital location. This is not used when the information is "
^XWB(8994,3282,2,2,1,2,0)="from an outside source."
^XWB(8994,3282,2,3,0)="PKGNAME^1^60^1^3"
^XWB(8994,3282,2,3,1,0)="^^2^2^3140225^"
^XWB(8994,3282,2,3,1,1,0)="The package name that is sending the data to PCE. This should be the "
^XWB(8994,3282,2,3,1,2,0)="full package name, such as PATIENT CARE ENCOUNTERS. "
^XWB(8994,3282,2,4,0)="SRC^1^60^1^4"
^XWB(8994,3282,2,4,1,0)="^8994.021^1^1^3160627^^^^"
^XWB(8994,3282,2,4,1,1,0)="The source of the data - such as VLER E-HEALTH EXCHANGE."
^XWB(8994,3282,2,5,0)="VISIT^1^30^0^5"
^XWB(8994,3282,2,5,1,0)="^^2^2^3190401^"
^XWB(8994,3282,2,5,1,1,0)="(Optional) A pointer to the Visit file (9000010), which identifies the "
^XWB(8994,3282,2,5,1,2,0)="encounter that this data should be associated with."
^XWB(8994,3282,2,6,0)="RETVISIT^1^1^0^6"
^XWB(8994,3282,2,6,1,0)="^^2^2^3190401^"
^XWB(8994,3282,2,6,1,1,0)="Set to 1 if you want the Visit IEN to be returned to the calling "
^XWB(8994,3282,2,6,1,2,0)="application."
^XWB(8994,3282,2,"B","LOC",2)=""
^XWB(8994,3282,2,"B","PCELIST",1)=""
^XWB(8994,3282,2,"B","PKGNAME",3)=""
^XWB(8994,3282,2,"B","RETVISIT",6)=""
^XWB(8994,3282,2,"B","SRC",4)=""
^XWB(8994,3282,2,"B","VISIT",5)=""
^XWB(8994,3282,2,"PARAMSEQ",1,1)=""
^XWB(8994,3282,2,"PARAMSEQ",2,2)=""
^XWB(8994,3282,2,"PARAMSEQ",3,3)=""
^XWB(8994,3282,2,"PARAMSEQ",4,4)=""
^XWB(8994,3282,2,"PARAMSEQ",5,5)=""
^XWB(8994,3282,2,"PARAMSEQ",6,6)=""
^XWB(8994,3282,3,0)="^8994.03^12^12^3211101^^^"
^XWB(8994,3282,3,1,0)="The only return will be the one passed back to the calling application."
^XWB(8994,3282,3,2,0)=" "
^XWB(8994,3282,3,3,0)="Returned Value:"
^XWB(8994,3282,3,4,0)="  1  If no errors occurred and data was processed.  "
^XWB(8994,3282,3,5,0)=" -1  If errors occurred, but data was processed as completely as possible."
^XWB(8994,3282,3,6,0)=" -2  Unable to identify a valid Visit. No data was processed."
^XWB(8994,3282,3,7,0)=" -3  RPC was called incorrectly. No data was processed."
^XWB(8994,3282,3,8,0)=" -4  If cannot get a lock on the encounter."
^XWB(8994,3282,3,9,0)=" -5  If there were only warnings."
^XWB(8994,3282,3,10,0)=" "
^XWB(8994,3282,3,11,0)="Optionally, if the argument RETVISIT was ""1"", than the Visit IEN will be "
^XWB(8994,3282,3,12,0)="returned as the second piece (e.g., ""1^65234"")."
^XWB(8994,3283,0)="MAG DICOM GET EXPORT IMAGE STS^LOOKUP^MAGDIWDV^2^R"
^XWB(8994,3283,1,0)="^8994.01^2^2^3130301^^^^"
^XWB(8994,3283,1,1,0)="Return a list of the studies in the DICOM OBJECT EXPORT file (#2006.574),"
^XWB(8994,3283,1,2,0)="along with the status of the transmission."
^XWB(8994,3283,3,0)="^8994.03^12^12^3130301^^^^"
^XWB(8994,3283,3,1,0)="A list of the studies in the DICOM OBJECT EXPORT file (#2006.574) is"
^XWB(8994,3283,3,2,0)="returned, along with the status of the transmission."
^XWB(8994,3283,3,3,0)="Field 1 -- Transmitting location"
^XWB(8994,3283,3,4,0)="Field 2 -- Name of Store SCP (from SCU_LIST.DIC)"
^XWB(8994,3283,3,5,0)="Field 3 -- Priority (default is 500)"
^XWB(8994,3283,3,6,0)="Field 4 -- D0 subscript in ^MAGDOUTP(2006.574,D0,...)"
^XWB(8994,3283,3,7,0)="Field 5 -- Accession Number"
^XWB(8994,3283,3,8,0)="Field 6 -- Image IEN -- pointer to the Image file (#2005)"
^XWB(8994,3283,3,9,0)="Field 7.1 -- Status (FAILED, WAITING, NOT SENT, TRANSMIT, SUCCESS)"
^XWB(8994,3283,3,10,0)="Field 7.2 -- $H of status update"
^XWB(8994,3283,3,11,0)="Field 7.3 -- Number of DICOM objects with this status for this date/time"
^XWB(8994,3283,3,12,0)="Additional Fields -- Like Field 7, for additional status date/time pairs"
^XWB(8994,3284,0)="MAG DICOM GET PROCESS ID^GETPID^MAGDRPC1^1^P"
^XWB(8994,3284,1,0)="^8994.01^1^1^3120106^^"
^XWB(8994,3284,1,1,0)="Return the $J process id of the RPC backend"
^XWB(8994,3284,3,0)="^8994.03^1^1^3120106^^"
^XWB(8994,3284,3,1,0)="$J process id of the RPC backend"
^XWB(8994,3285,0)="MAG3 TELEREADER CPT CODELOOKUP^CPTFIND^MAGNTLR7^2^R"
^XWB(8994,3285,1,0)="^8994.01^16^16^3120522^^^"
^XWB(8994,3285,1,1,0)="Per VHA Directive 2004-038, this RPC should not be modified."
