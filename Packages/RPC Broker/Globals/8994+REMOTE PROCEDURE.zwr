^XWB(8994,4671,1,15,0)=" "
^XWB(8994,4671,1,16,0)=" "
^XWB(8994,4671,1,17,0)=" This RPC queries the VistA system for the status of an exported"
^XWB(8994,4671,1,18,0)=" DICOM study."
^XWB(8994,4671,2,0)="^8994.02A^1^1"
^XWB(8994,4671,2,1,0)="D0^1^30^1^1"
^XWB(8994,4671,2,1,1,0)="^^2^2^3211013^"
^XWB(8994,4671,2,1,1,1,0)="This is the internal entry number of the study in the DICOM"
^XWB(8994,4671,2,1,1,2,0)="OBJECT EXPORT file (#2006.574)."
^XWB(8994,4671,2,"B","D0",1)=""
^XWB(8994,4671,2,"PARAMSEQ",1,1)=""
^XWB(8994,4671,3,0)="^^15^15^3211013^"
^XWB(8994,4671,3,1,0)=" When an error occurs during the processing of this RPC,"
^XWB(8994,4671,3,2,0)=" the output array consists only one element:"
^XWB(8994,4671,3,3,0)="     OUT(1) = -1,IEN for DICOM OBJECT EXPORT file (#2006.574) is missing"
^XWB(8994,4671,3,4,0)="     OUT(1) = -2,No entry #nnn in DICOM OBJECT EXPORT file (#2006.574)"
^XWB(8994,4671,3,5,0)=" "
^XWB(8994,4671,3,6,0)=" Otherwise, the value of OUT(1) = 1, and there will be status counters."
^XWB(8994,4671,3,7,0)="     OUT(""SUCCESS"") = nnn"
^XWB(8994,4671,3,8,0)="     OUT(""XMIT"") = nnn"
^XWB(8994,4671,3,9,0)="     OUT(""FAIL"") = nnn"
^XWB(8994,4671,3,10,0)="     OUT(""WAITING"") =  nnn"
^XWB(8994,4671,3,11,0)="     OUT(""HOLD"") = nnn"
^XWB(8994,4671,3,12,0)="     OUT(""IGNORE"") = nnn"
^XWB(8994,4671,3,13,0)="     OUT(""NOT ON FILE"") = nnn"
^XWB(8994,4671,3,14,0)=" "
^XWB(8994,4671,3,15,0)=" If there are no images with a particular status, that status is not incuded."
^XWB(8994,4672,0)="MAG DICOM GET EXPORT QUEUE STS^STATS^MAGDRPC9^2"
^XWB(8994,4672,1,0)="^^2^2^3211210^"
^XWB(8994,4672,1,1,0)="Retrieve data from the DICOM OBJECT EXPORT file (#2006.574)."
^XWB(8994,4672,1,2,0)="This provides real-time feedback on the operation of the Export application."
^XWB(8994,4672,2,0)="^8994.02A^1^1"
^XWB(8994,4672,2,1,0)="SITE^1^5^1^1"
^XWB(8994,4672,2,1,1,0)="^^1^1^3211210^"
^XWB(8994,4672,2,1,1,1,0)="Export location origin - INSTITUTION file (#4) ien"
^XWB(8994,4672,2,"B","SITE",1)=""
^XWB(8994,4672,2,"PARAMSEQ",1,1)=""
^XWB(8994,4672,3,0)="^^18^18^3211210^"
^XWB(8994,4672,3,1,0)="Information on export images that are in either the FAIL, WAITING, or"
^XWB(8994,4672,3,2,0)="XMIT state.  (Images in the SUCCCESS, NOT ON FIE, IGNORE or HOLD state"
^XWB(8994,4672,3,3,0)="are ignored.)"
^XWB(8994,4672,3,4,0)=" "
^XWB(8994,4672,3,5,0)=" Field 1: Internal entry number of the study in the DICOM OBJECT EXPORT file (#2006.574)."
^XWB(8994,4672,3,6,0)=" Field 2: Image state: FIAL, WAITING, or XMIT"
^XWB(8994,4672,3,7,0)=" Field 3: Count of images in the study for that state"
^XWB(8994,4672,3,8,0)=" Field 4: Time of last state transition for the image"
^XWB(8994,4672,3,9,0)=" Field 5: Destination storage SCP"
^XWB(8994,4672,3,10,0)=" Field 6: Image group number"
^XWB(8994,4672,3,11,0)=" Field 7: Accession number"
^XWB(8994,4672,3,12,0)=" Field 8: Originating site (file 4 ien)"
^XWB(8994,4672,3,13,0)=" Field 9: Priority"
^XWB(8994,4672,3,14,0)=" Field 10: Copy to raid"
^XWB(8994,4672,3,15,0)=" Field 11: Export request date/time (FM D/T format)"
^XWB(8994,4672,3,16,0)=" "
^XWB(8994,4672,3,17,0)="Fields 5-11 are copied from the 0-node for the study in the DICOM"
^XWB(8994,4672,3,18,0)="Object Export file (#2006.574)"
^XWB(8994,4673,0)="EC GETPRBLST^GETPLST^ECUERPC2^4^S^0^^1"
^XWB(8994,4673,1,0)="^8994.01^1^1^3220104^^"
^XWB(8994,4673,1,1,0)="Returns a problem list for an Event Capture patient."
^XWB(8994,4673,2,0)="^8994.02A^3^1"
^XWB(8994,4673,2,3,0)="ECARY^1^^1"
^XWB(8994,4673,2,3,1,0)="^8994.021^6^6^3220104^^"
^XWB(8994,4673,2,3,1,1,0)="Input value, ECARY, contains the following values separated by ""^"""
^XWB(8994,4673,2,3,1,2,0)="ECIEN - Event Capture Patient IEN"
^XWB(8994,4673,2,3,1,3,0)="ECSTAT - The status of the problems to retrieve. "
^XWB(8994,4673,2,3,1,4,0)="         A = Active problems only."
^XWB(8994,4673,2,3,1,5,0)="         I = Inactive problems only."
^XWB(8994,4673,2,3,1,6,0)="         """" or undefined = all problems regardless of status."
^XWB(8994,4673,2,"B","ECARY",3)=""
^XWB(8994,4673,3,0)="^^11^11^3230113^"
^XWB(8994,4673,3,1,0)="Returns an array of problem list for an Event Capture patient.  Data "
^XWB(8994,4673,3,2,0)="pieces are:"
^XWB(8994,4673,3,3,0)="1. Problem Status"
^XWB(8994,4673,3,4,0)="2. ICD Code"
^XWB(8994,4673,3,5,0)="3. ICD Code Description"
^XWB(8994,4673,3,6,0)="4. Onset Date"
^XWB(8994,4673,3,7,0)="5. Date of Last Modified"
^XWB(8994,4673,3,8,0)="6. Provider"
^XWB(8994,4673,3,9,0)="7. Service"
^XWB(8994,4673,3,10,0)="8. Current Coding System Flag (0,1)"
^XWB(8994,4673,3,11,0)="9. ICD Code IEN"
^XWB(8994,4674,0)="EC DELETE FILE ENTRY^ECDEL^ECUMRPC2^4^R^0^^1"
^XWB(8994,4674,1,0)="^8994.01^1^1^3220104^^"
^XWB(8994,4674,1,1,0)="A general pupose for deletion of entry in ECS files."
^XWB(8994,4674,2,0)="^8994.02A^1^1"
^XWB(8994,4674,2,1,0)="ECARY^2^^1"
^XWB(8994,4674,2,1,1,0)="^^10^10^3220104^"
^XWB(8994,4674,2,1,1,1,0)="The input array ECARY contains the file number and the IEN number of the "
^XWB(8994,4674,2,1,1,2,0)="entry to be deleted.  "
^XWB(8994,4674,2,1,1,3,0)=" "
^XWB(8994,4674,2,1,1,4,0)="ECARY(""ECFILE"") is the file number where the entry to be deleted."
^XWB(8994,4674,2,1,1,5,0)="ECARY(""IEN"") is the entry number to be deleted."
^XWB(8994,4674,2,1,1,6,0)=" "
^XWB(8994,4674,2,1,1,7,0)="    ECFILE     Option"
^XWB(8994,4674,2,1,1,8,0)="    ------     ------"
^XWB(8994,4674,2,1,1,9,0)="    720.3      EC Event Code Screens"
^XWB(8994,4674,2,1,1,10,0)="    724        DSS Unit"
^XWB(8994,4674,2,"B","ECARY",1)=""
^XWB(8994,4674,3,0)="^8994.03^1^1^3220104^^^^"
^XWB(8994,4674,3,1,0)="Returns a flag of success or failure and error message."
