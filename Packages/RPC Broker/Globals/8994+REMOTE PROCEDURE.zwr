^XWB(8994,5012,0)="SDES2 GET RECALLS BY DFN^GETBYDFN^SDES2GETRECALL^2^R^^^^^^1"
^XWB(8994,5012,1,0)="^^4^4^3250214^"
^XWB(8994,5012,1,1,0)="Returns a list of RECALL REMINDER file (#403.5) requests based"
^XWB(8994,5012,1,2,0)="on PATIENT file (#2) DFN passed to the RPC."
^XWB(8994,5012,1,3,0)=" "
^XWB(8994,5012,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,5012,2,0)="^8994.02A^2^2"
^XWB(8994,5012,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,5012,2,1,1,0)="^^10^10^3240126^"
^XWB(8994,5012,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number. "
^XWB(8994,5012,2,1,1,2,0)="     Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5012,2,1,1,3,0)="SDCONTEXT(""PATIENT DFN"") = The DFN/IEN of the target patient from"
^XWB(8994,5012,2,1,1,4,0)="     the calling application."
^XWB(8994,5012,2,1,1,5,0)="SDCONTEXT(""PATIENT ICN"") = The ICN of the target patient from the"
^XWB(8994,5012,2,1,1,6,0)="     calling application."
^XWB(8994,5012,2,1,1,7,0)="SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action in the"
^XWB(8994,5012,2,1,1,8,0)="     calling application."
^XWB(8994,5012,2,1,1,9,0)="SDCONTEXT(""USER SECID"") = The SECID of the user taking action in"
^XWB(8994,5012,2,1,1,10,0)="     the calling application."
^XWB(8994,5012,2,2,0)="SDPARAM^2^32000^1^2"
^XWB(8994,5012,2,2,1,0)="^8994.021^1^1^3250214^^^"
^XWB(8994,5012,2,2,1,1,0)="SDPARAM(""PATIENT IEN"") = Pointer to PATIENT (#2) file (required)"
^XWB(8994,5012,2,"B","SDCONTEXT",1)=""
^XWB(8994,5012,2,"B","SDPARAM",2)=""
^XWB(8994,5012,2,"PARAMSEQ",1,1)=""
^XWB(8994,5012,2,"PARAMSEQ",2,2)=""
^XWB(8994,5012,3,0)="^8994.03^224^224^3250214^^"
