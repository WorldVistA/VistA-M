^XWB(8994,3509,3,88,0)=" 103 RET(""PTEND"") - Patient Temporary Address End Date (.1218) "
^XWB(8994,3509,3,89,0)=" 104 RET(""PCELL"") - Patient Cell Phone (.134) "
^XWB(8994,3509,3,90,0)=" 105 RET(""PPAGER"") - Patient Pager Number (.135) "
^XWB(8994,3509,3,91,0)=" 106 RET(""PEMAIL"") - Patient Email Address (.133) "
^XWB(8994,3509,3,92,0)=" 107 RET(""PF_FFF"") - Patient FUGITIVE FELON FLAG 1=YES "
^XWB(8994,3509,3,93,0)=" 108 RET(""PF_VCD"") - Patient VETERAN CATASTROPHICALLY DISABLED? Y=YES "
^XWB(8994,3509,3,94,0)="N=NO "
^XWB(8994,3509,3,95,0)=" 109 PFNATIONAL - Patient national Flags "
^XWB(8994,3509,3,96,0)="                         (PRF ASSIGNMENT/PRF NATIONAL FLAG) separated by "
^XWB(8994,3509,3,97,0)="| "
^XWB(8994,3509,3,98,0)="        Each | piece contains the following ;; pieces: "
^XWB(8994,3509,3,99,0)="        1. PRFAID - PRF Assignment ID pointer to PRF ASSIGNMENT file "
^XWB(8994,3509,3,100,0)="(#26.13)"
^XWB(8994,3509,3,101,0)="        2. PRFSTAT - PRF Assignment Status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3509,3,102,0)="        3. PRFNID - PRF National Flag ID pointer to"
^XWB(8994,3509,3,103,0)="                    PRF NATIONAL FLAG file (#26.15)"
^XWB(8994,3509,3,104,0)="        4. PRFNNAME - PRF National Flag name "
^XWB(8994,3509,3,105,0)="        5. PRFNSTAT - PRF National Flag status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3509,3,106,0)=" 110. PFLOCAL - Patient Local Flags "
^XWB(8994,3509,3,107,0)="                      (PRF ASSIGNMENT/PRF Local FLAG) separated by | "
^XWB(8994,3509,3,108,0)="        Each | piece contains the following ;; pieces: "
^XWB(8994,3509,3,109,0)="        1. PRFAID - PRF Assignment ID pointer to PRF ASSIGNMENT file "
^XWB(8994,3509,3,110,0)="(#26.13)"
^XWB(8994,3509,3,111,0)="        2. PRFSTAT - PRF Assignment Status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3509,3,112,0)="        3. PRFLID - PRF Local Flag ID pointer to PRF LOCAL FLAG file "
^XWB(8994,3509,3,113,0)="(#26.11)"
^XWB(8994,3509,3,114,0)="        4. PRFLNAME - PRF Local Flag name "
^XWB(8994,3509,3,115,0)="        5. PRFLSTAT - PRF Local Flag status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3509,3,116,0)=" 111. SUBGRP - value from the ENROLLMENT SUBGROUP field of the"
^XWB(8994,3509,3,117,0)="               PATIENT ENROLLMENT file"
^XWB(8994,3509,3,118,0)="               (#27.11) "
^XWB(8994,3509,3,119,0)="               Valid values are a b c d e g "
^XWB(8994,3509,3,120,0)=" 112. CAT8G  - Category 8g flag - True if PriGRP ='Group 8' AND "
^XWB(8994,3509,3,121,0)="SUBGRP-'g' "
