^XWB(8994,2977,3,3,0)="  -1^error message if not successful"
^XWB(8994,2978,0)="DSIROI GETREQST GET REQUEST^GETREQST^DSIROI^4^^^^1"
^XWB(8994,2978,1,0)="^8994.01^2^2^3170216^^^^"
^XWB(8994,2978,1,1,0)="This RPC invokes the GETS^DIQ api to retrieve all the data for a given "
