^XWB(8994,3607,2,"B","INP",1)=""
^XWB(8994,3607,2,"PARAMSEQ",1,1)=""
^XWB(8994,3607,2,"PARAMSEQ",2,2)=""
^XWB(8994,3607,3,0)="^^11^11^3150420^"
^XWB(8994,3607,3,1,0)="A single entry in the Global Array in the format"
^XWB(8994,3607,3,2,0)="       ""0^<optional msg text>"""
^XWB(8994,3607,3,3,0)="       ""T00020RETURNCODE^T00100TEXT"""
^XWB(8994,3607,3,4,0)="    Caught Exception Return:"
^XWB(8994,3607,3,5,0)="     A single entry in the Global Array in the format ""-1^<error text>"""
^XWB(8994,3607,3,6,0)="     ""T00020RETURNCODE^T00100TEXT"""
^XWB(8994,3607,3,7,0)="    Unexpected Exception Return:"
^XWB(8994,3607,3,8,0)="       Handled by the RPC Broker."
^XWB(8994,3607,3,9,0)="       M errors are trapped by the use of M and Kernel error handling."
^XWB(8994,3607,3,10,0)="       The RPC execution stops and the RPC Broker sends the error"
^XWB(8994,3607,3,11,0)="       generated text back to the client."
^XWB(8994,3608,0)="SDEC HIDE^HIDE^SDEC^4^R^0^^0"
^XWB(8994,3608,1,0)="^^4^4^3150423^"
^XWB(8994,3608,1,1,0)="This RPC returns a list of IENs and NAMEs of the clinics that are flagged "
^XWB(8994,3608,1,2,0)="to be hidden from the display in the scheduler."
^XWB(8994,3608,1,3,0)="This are identified when the HIDE FROM DISPLAY IN VSE GUI? field in the "
^XWB(8994,3608,1,4,0)="HOSPITAL LOCATION file is defined as 'YES'."
^XWB(8994,3608,3,0)="^^2^2^3150423^"
^XWB(8994,3608,3,1,0)="This remote procedure returns an array in which each entry is of the "
^XWB(8994,3608,3,2,0)="format IEN ^ NAME."
^XWB(8994,3609,0)="SDECLOC UPDPRIV^UPDPRIV^SDECLOC^2^R^0^^0"
^XWB(8994,3609,1,0)="^8994.01^2^2^3150427^^"
^XWB(8994,3609,1,1,0)="Supports updating the list of privileged users for a hospital location."
^XWB(8994,3609,1,2,0)="This RPC will purge existing entries and populate with the passed array."
^XWB(8994,3609,2,0)="^8994.02A^2^2"
^XWB(8994,3609,2,1,0)="LOC^1^^1^1"
^XWB(8994,3609,2,1,1,0)="^8994.021^1^1^3150427^^"
^XWB(8994,3609,2,1,1,1,0)="IEN to the HOSPITAL LOCATION file."
^XWB(8994,3609,2,2,0)="LST^2^^^2"
^XWB(8994,3609,2,2,1,0)="^^5^5^3150427^"
^XWB(8994,3609,2,2,1,1,0)="Array in the following format:"
^XWB(8994,3609,2,2,1,2,0)=" "
^XWB(8994,3609,2,2,1,3,0)="LST(1)=NEW PERSON IEN"
^XWB(8994,3609,2,2,1,4,0)="LST(2)=NEW PERSON IEN"
^XWB(8994,3609,2,2,1,5,0)="LST(3)=NEW PERSON IEN"
^XWB(8994,3609,2,"B","LOC",1)=""
^XWB(8994,3609,2,"B","LST",2)=""
^XWB(8994,3609,2,"PARAMSEQ",1,1)=""
^XWB(8994,3609,2,"PARAMSEQ",2,2)=""
^XWB(8994,3609,3,0)="^8994.03^5^5^3150427^^"
^XWB(8994,3609,3,1,0)="1^SUCCESSFUL"
^XWB(8994,3609,3,2,0)=" "
^XWB(8994,3609,3,3,0)="or"
^XWB(8994,3609,3,4,0)=" "
^XWB(8994,3609,3,5,0)="-1^Error message"
^XWB(8994,3610,0)="SDECAR ARMRTC^ARMRTC^SDECAR^4^R^0^^0"
^XWB(8994,3610,1,0)="^^1^1^3150511^"
^XWB(8994,3610,1,1,0)="GET the number of MRTC appointments made for this request."
^XWB(8994,3610,2,0)="^8994.02A^1^1"
^XWB(8994,3610,2,1,0)="ARIEN^1^^1^1"
^XWB(8994,3610,2,1,1,0)="^^1^1^3150511^"
^XWB(8994,3610,2,1,1,1,0)="Pointer to SDEC APPT REQUEST file 409.85."
^XWB(8994,3610,2,"B","ARIEN",1)=""
^XWB(8994,3610,2,"PARAMSEQ",1,1)=""
^XWB(8994,3610,3,0)="^^2^2^3150511^"
^XWB(8994,3610,3,1,0)="Global array with 1 entry containing the count of the appointments made "
^XWB(8994,3610,3,2,0)="under the COUNT header."
^XWB(8994,3611,0)="SDECRMG2 URGENCY^URGENCY^SDECRMG2^4^R^0^^0"
^XWB(8994,3611,1,0)="^^2^2^3150522^"
^XWB(8994,3611,1,1,0)="GET valid urgency protocol values that are used in the URGENCY field 5 of "
^XWB(8994,3611,1,2,0)="the REQUEST CONSULTATION file 123."
^XWB(8994,3611,3,0)="^^5^5^3150522^"
^XWB(8994,3611,3,1,0)="Global array in which each entry contains the IEN and NAME of a protocol "
^XWB(8994,3611,3,2,0)="entry:"
^XWB(8994,3611,3,3,0)="  1. IEN     - pointer to PROTOCOL file 101"
^XWB(8994,3611,3,4,0)="  2. NAME    - name field from PROTOCOL file"
^XWB(8994,3611,3,5,0)="  3. SYNONYM - Short name list separated by pipe."
^XWB(8994,3612,0)="SDECAR ARAPPT^ARAPPT^SDECAR^4^R^0^^0"
^XWB(8994,3612,1,0)="^^1^1^3150713^"
^XWB(8994,3612,1,1,0)="GET appointment request for given SDEC APPOINTMENT id."
^XWB(8994,3612,2,0)="^8994.02A^1^1"
^XWB(8994,3612,2,1,0)="SDAPPT^1^^1^1"
^XWB(8994,3612,2,1,1,0)="^^1^1^3150713^"
^XWB(8994,3612,2,1,1,1,0)="Pointer to SDEC APPOINTMENT file 409.84."
^XWB(8994,3612,2,"B","SDAPPT",1)=""
^XWB(8994,3612,2,"PARAMSEQ",1,1)=""
^XWB(8994,3612,3,0)="^^10^10^3150713^"
^XWB(8994,3612,3,1,0)="Global array with 1 entry containing the REQUEST TYPE and IEN of the "
^XWB(8994,3612,3,2,0)="associated appointment separated by pipe |:"
^XWB(8994,3612,3,3,0)="  1. Request Type - A  APPT"
^XWB(8994,3612,3,4,0)="                    C  Consult"
^XWB(8994,3612,3,5,0)="                    E  EWL"
^XWB(8994,3612,3,6,0)="                    R  Recall"
^XWB(8994,3612,3,7,0)="  2. IEN - pointer to either the SDEC APPT REQUEST"
^XWB(8994,3612,3,8,0)="                                 REQUEST/CONSULTATION"
^XWB(8994,3612,3,9,0)="                                 SD WAIT LIST"
^XWB(8994,3612,3,10,0)="                              or RECALL REMINDERS file."
^XWB(8994,3613,0)="SDECLK LOCK^LOCK^SDECLK^4^R^0^^0"
^XWB(8994,3613,1,0)="^^6^6^3150723^"
^XWB(8994,3613,1,1,0)="This RPC attempts to lock a request record."
^XWB(8994,3613,1,2,0)="Request records are in one of these files:"
^XWB(8994,3613,1,3,0)="SDEC APPT REQUEST"
^XWB(8994,3613,1,4,0)="REQUEST/CONSULTATION"
^XWB(8994,3613,1,5,0)="SD WAIT LIST"
^XWB(8994,3613,1,6,0)="RECALL REMINDERS"
^XWB(8994,3613,2,0)="^8994.02A^1^1"
^XWB(8994,3613,2,1,0)="REQ^1^^1^1"
^XWB(8994,3613,2,1,1,0)="^^6^6^3150723^"
^XWB(8994,3613,2,1,1,1,0)="Appt Request type - variable pointer pointer"
^XWB(8994,3613,2,1,1,2,0)="                    to one of these files:"
^XWB(8994,3613,2,1,1,3,0)="                      SDEC APPT REQUEST    - A|<APPT IEN>     A|123"
^XWB(8994,3613,2,1,1,4,0)="                      SD WAIT LIST         - E|<WL IEN>       E|123"
^XWB(8994,3613,2,1,1,5,0)="                      REQUEST/CONSULTATION - C|<CONSULT IEN>  C|123"
^XWB(8994,3613,2,1,1,6,0)="                      RECALL REMINDERS     - R|^<RECALL IEN>  R|123"
^XWB(8994,3613,2,"B","REQ",1)=""
^XWB(8994,3613,2,"PARAMSEQ",1,1)=""
^XWB(8994,3613,3,0)="^^4^4^3150723^"
^XWB(8994,3613,3,1,0)="A single entry in the global array indicating the success/failure"
^XWB(8994,3613,3,2,0)="of getting the lock:"
^XWB(8994,3613,3,3,0)="   1. CODE    -  1 if successful, or 0^Message if could not get lock"
^XWB(8994,3613,3,4,0)="   2. MESSAGE -  Message Text"
^XWB(8994,3614,0)="SDECLK UNLOCK^UNLOCK^SDECLK^4^R^0^^0"
^XWB(8994,3614,1,0)="^^1^1^3150723^"
^XWB(8994,3614,1,1,0)="This RPC unlocks the request record that was locked using SDECLK LOCK."
^XWB(8994,3614,2,0)="^8994.02A^2^2"
^XWB(8994,3614,2,1,0)="REQ^1^^1^1"
^XWB(8994,3614,2,1,1,0)="^^6^6^3150723^"
^XWB(8994,3614,2,1,1,1,0)="Appt Request type - variable pointer pointer"
^XWB(8994,3614,2,1,1,2,0)="                    to one of these files:"
^XWB(8994,3614,2,1,1,3,0)="                      SDEC APPT REQUEST    - A|<APPT IEN>     A|123"
^XWB(8994,3614,2,1,1,4,0)="                      SD WAIT LIST         - E|<WL IEN>       E|123"
^XWB(8994,3614,2,1,1,5,0)="                      REQUEST/CONSULTATION - C|<CONSULT IEN>  C|123"
^XWB(8994,3614,2,1,1,6,0)="                      RECALL REMINDERS     - R|^<RECALL IEN>  R|123"
^XWB(8994,3614,2,2,0)="FLG^1^^0^2"
^XWB(8994,3614,2,2,1,0)="^^5^5^3150723^"
^XWB(8994,3614,2,2,1,1,0)="Unlock if other job"
^XWB(8994,3614,2,2,1,2,0)="        0 = (default) only unlock if lock belongs to current user"
^XWB(8994,3614,2,2,1,3,0)="                      and current $J job"
^XWB(8994,3614,2,2,1,4,0)="        1 = unlock even if the lock does not belong to current"
^XWB(8994,3614,2,2,1,5,0)="            user and current $J job"
^XWB(8994,3614,2,"B","FLG",2)=""
^XWB(8994,3614,2,"B","REQ",1)=""
^XWB(8994,3614,2,"PARAMSEQ",1,1)=""
^XWB(8994,3614,2,"PARAMSEQ",2,2)=""
^XWB(8994,3614,3,0)="^^6^6^3150723^"
^XWB(8994,3614,3,1,0)="A single entry in the global array indicating the success/failure of"
^XWB(8994,3614,3,2,0)="releasing the lock:"
^XWB(8994,3614,3,3,0)="   1. CODE    -  1 if successful, or 0^Message if could not get lock"
^XWB(8994,3614,3,4,0)="   2. MESSAGE -  Message Text"
^XWB(8994,3614,3,5,0)="                 If message text=""Not your lock"" you can call again and"
^XWB(8994,3614,3,6,0)="                 send 1 as the 2nd input to unlock anyway."
^XWB(8994,3615,0)="SDEC PRIV^PRIV^SDEC^4^R^0^^0"
^XWB(8994,3615,1,0)="^^1^1^3150724^"
^XWB(8994,3615,1,1,0)="IS this USER in the PRIVILEGED USER multiple for the clinic."
^XWB(8994,3615,2,0)="^8994.02A^2^2"
^XWB(8994,3615,2,1,0)="CLINIEN^1^^1^1"
^XWB(8994,3615,2,1,1,0)="^^1^1^3150724^"
^XWB(8994,3615,2,1,1,1,0)="Pointer to the HOSPITAL LOCATION file 44."
^XWB(8994,3615,2,2,0)="USER^1^^1^2"
^XWB(8994,3615,2,2,1,0)="^^1^1^3150724^"
^XWB(8994,3615,2,2,1,1,0)="Pointer to the NEW PERSON file 200."
^XWB(8994,3615,2,"B","CLINIEN",1)=""
^XWB(8994,3615,2,"B","USER",2)=""
^XWB(8994,3615,2,"PARAMSEQ",1,1)=""
^XWB(8994,3615,2,"PARAMSEQ",2,2)=""
^XWB(8994,3615,3,0)="^^4^4^3150724^"
^XWB(8994,3615,3,1,0)="A single boolean entry indicating that the USER is a PRIVILEGED USER for "
^XWB(8994,3615,3,2,0)="the clinic."
^XWB(8994,3615,3,3,0)="     RETURNCODE - 0=NO; 1=YES; -1=error"
^XWB(8994,3615,3,4,0)="     MESSAGE"
^XWB(8994,3616,0)="SDECDIS DISABIL^DISABIL^SDECDIS^4^R^0^^0"
^XWB(8994,3616,1,0)="^^1^1^3150807^"
^XWB(8994,3616,1,1,0)="GET rated disabilities for the given patient"
^XWB(8994,3616,2,0)="^8994.02A^1^1"
^XWB(8994,3616,2,1,0)="DFN^1^^1^1"
^XWB(8994,3616,2,1,1,0)="^^1^1^3150807^"
^XWB(8994,3616,2,1,1,1,0)="pointer to PATIENT file 2"
^XWB(8994,3616,2,"B","DFN",1)=""
^XWB(8994,3616,2,"PARAMSEQ",1,1)=""
^XWB(8994,3616,3,0)="^^33^33^3150807^"
^XWB(8994,3616,3,1,0)="1. DFN          - patient ID pointer to PATIENT file 2"
^XWB(8994,3616,3,2,0)="2. DISABILITIES - RATED DISABILITIES from multiple field .3721"
^XWB(8994,3616,3,3,0)="                  separated by pipe"
^XWB(8994,3616,3,4,0)="                  Each pipe piece contains the following ;; pieces:"
^XWB(8994,3616,3,5,0)="                   1. DISABILITY id pointer to DISABILITY CONDITION file "
^XWB(8994,3616,3,6,0)=31
^XWB(8994,3616,3,7,0)="                   2. DISABILITY NAME from DISABILITY CONDITION file"
^XWB(8994,3616,3,8,0)="                   3. DISABILITY % - percentage at which the VA rated this"
^XWB(8994,3616,3,9,0)="                                     disability"
^XWB(8994,3616,3,10,0)="                   4. SERVICE_CONNECTED - 0=NO=Patient is not service"
^XWB(8994,3616,3,11,0)="                                            connected for this disability"
^XWB(8994,3616,3,12,0)="                                          1=YES=Patient IS service"
^XWB(8994,3616,3,13,0)="                                            connected for this disability"
^XWB(8994,3616,3,14,0)="                   5. EXTREMITY - BL = BOTH LOWER"
^XWB(8994,3616,3,15,0)="                                  BU = BOTH UPPER"
^XWB(8994,3616,3,16,0)="                                  RL = RIGHT LOWER"
^XWB(8994,3616,3,17,0)="                                  RU = RIGHT UPPER"
^XWB(8994,3616,3,18,0)="                                  LL = LEFT LOWER"
^XWB(8994,3616,3,19,0)="                                  LU = LEFT UPPER"
^XWB(8994,3616,3,20,0)="                   6. ORIG_DATE - ORIGINAL EFFECTIVE DATE in external "
^XWB(8994,3616,3,21,0)="format"
^XWB(8994,3616,3,22,0)="                   7. CURR_DATE         - CURRENT EFFECTIVE DATE"
^XWB(8994,3616,3,23,0)="                                          in external format"
^XWB(8994,3616,3,24,0)="3. SVCCONN - Y=YES=Patient Service Connected"
^XWB(8994,3616,3,25,0)="             N=NO=Patient NOT Service Connected"
^XWB(8994,3616,3,26,0)="4. SVCCONNP - Patient's service connected percentage"
^XWB(8994,3616,3,27,0)="5. PRIMARY  - from field .361 pointer to ELIGIBILITY CODE file 8"
^XWB(8994,3616,3,28,0)="6. PRIMARY_NAME - name from ELIGIBILITY CODE file"
^XWB(8994,3616,3,29,0)="7. SECONDARY - from PATIENT ELIGIBILITIES multiple field 361 separated by"
^XWB(8994,3616,3,30,0)="               pipe"
^XWB(8994,3616,3,31,0)="               Each pipe piece contains the following ;; pieces:"
^XWB(8994,3616,3,32,0)="               1. ELIGIBILITY id pointer to ELIGIBILITY CODE file 8"
^XWB(8994,3616,3,33,0)="               2. ELIGIBILITY name from ELIGIBILITY CODE file"
^XWB(8994,3617,0)="SDECDEV DEVICE^DEVICE^SDECDEV^4^R^0^^0"
^XWB(8994,3617,1,0)="^^1^1^3150914^"
^XWB(8994,3617,1,1,0)="List of devices in the device file that are active printers."
^XWB(8994,3617,3,0)="^^2^2^3150914^"
^XWB(8994,3617,3,1,0)="Global Array in the format:"
^XWB(8994,3617,3,2,0)="   S @SDECY@(CNT)=""I00030PRINTER_IEN^T00040PRINTER_NAME"""
^XWB(8994,3618,0)="SD VSE REPORT RPC^REPORT^SDECXML^4^P^^^0^1"
^XWB(8994,3618,1,0)="^8994.01^6^6^3141215^^^^"
^XWB(8994,3618,1,1,0)="Returns Scheduling appointment and encounter report data in XML format. "
^XWB(8994,3618,1,2,0)="The report data will be exclusive to one of three report types:"
^XWB(8994,3618,1,3,0)="    Mental Health"
^XWB(8994,3618,1,4,0)="    Primary Care"
^XWB(8994,3618,1,5,0)="    Specialty Care"
^XWB(8994,3618,1,6,0)="The returned data will be aggregated for the requested date range."
^XWB(8994,3618,2,0)="^8994.02A^3^3"
^XWB(8994,3618,2,1,0)="SDRPTLST^1^1^1^1"
^XWB(8994,3618,2,1,1,0)="^^6^6^3141215^"
^XWB(8994,3618,2,1,1,1,0)=" This parameter is the type of VSE Scheduling Report being run. "
^XWB(8994,3618,2,1,1,2,0)="  Currently, the choices are as follows:"
^XWB(8994,3618,2,1,1,3,0)="   ""M"" (Mental Health)"
^XWB(8994,3618,2,1,1,4,0)="   ""P"" (Primary Care)"
^XWB(8994,3618,2,1,1,5,0)="   ""S"" (Specialty Care)"
^XWB(8994,3618,2,1,1,6,0)="  Only one type of report may be run at at ime."
^XWB(8994,3618,2,2,0)="SDBEGRNG^1^12^1^2"
^XWB(8994,3618,2,2,1,0)="^^5^5^3141215^"
^XWB(8994,3618,2,2,1,1,0)="  This parameter is the beginning date of the desired aggregated report data."
^XWB(8994,3618,2,2,1,2,0)="  The date should be in internal FileMan format.  "
^XWB(8994,3618,2,2,1,3,0)="  Example: 3141115 = Nov 15, 2014"
^XWB(8994,3618,2,2,1,4,0)="      3140901 = Sep 01, 2014."
^XWB(8994,3618,2,2,1,5,0)=" Time is accepted but ignored."
^XWB(8994,3618,2,3,0)="SDENDRNG^1^12^1^3"
^XWB(8994,3618,2,3,1,0)="^^5^5^3141215^"
^XWB(8994,3618,2,3,1,1,0)=" This is the ending date of the date range for the desired report."
^XWB(8994,3618,2,3,1,2,0)=" The date should be in internal FileMan format."
^XWB(8994,3618,2,3,1,3,0)=" Example: 3140901 = Sep 01,2014"
^XWB(8994,3618,2,3,1,4,0)="          3141115 = Nov 15, 2014"
^XWB(8994,3618,2,3,1,5,0)=" Time is accepted but ignored."
^XWB(8994,3618,2,"B","SDBEGRNG",2)=""
^XWB(8994,3618,2,"B","SDENDRNG",3)=""
^XWB(8994,3618,2,"B","SDRPTLST",1)=""
^XWB(8994,3618,2,"PARAMSEQ",1,1)=""
^XWB(8994,3618,2,"PARAMSEQ",2,2)=""
^XWB(8994,3618,2,"PARAMSEQ",3,3)=""
^XWB(8994,3618,3,0)="^8994.03^40^40^3141215^^^^"
^XWB(8994,3618,3,1,0)=" Clinic Appointment and Encounter Data for previous 12 months is returned "
^XWB(8994,3618,3,2,0)=" in XML format."
^XWB(8994,3618,3,3,0)="  "
^XWB(8994,3618,3,4,0)=" Example:"
^XWB(8994,3618,3,5,0)="<?xml version=""1.0"" encoding=""UTF-8""?>"
^XWB(8994,3618,3,6,0)=" <VAFacility Name=""CHEYENNE VAMC"" ID=""442"">"
^XWB(8994,3618,3,7,0)="   <ReportType ReportType=""Specialty Care"">"
^XWB(8994,3618,3,8,0)="      <DateAggregate DateAgg=""Date"">"
^XWB(8994,3618,3,9,0)="        <Date ActivityDate=""10/01/2011"" DateName=""11/04/2010"">"
^XWB(8994,3618,3,10,0)="           <Division Name=""All"">"
^XWB(8994,3618,3,11,0)="            <Rg Rg=""All"">"
^XWB(8994,3618,3,12,0)="               <Rs Rn=""All"">"
^XWB(8994,3618,3,13,0)="                <Rc Pr=""All"" Mn=""Encounters"" Vt=""Actual"" Vl=""133""/>"
^XWB(8994,3618,3,14,0)="               </Rs>"
^XWB(8994,3618,3,15,0)="             </Rg>"
^XWB(8994,3618,3,16,0)="            </Division>"
^XWB(8994,3618,3,17,0)="          <Division Name=""DIV1 VAMROC"">"
^XWB(8994,3618,3,18,0)="            <Rg Rg=""All"">"
^XWB(8994,3618,3,19,0)="               <Rs Rn=""All"">"
^XWB(8994,3618,3,20,0)="                   <Rc Pr=""All"" Mn=""Encounters"" Vt=""Actual"" Vl=""100""/>"
^XWB(8994,3618,3,21,0)="                </Rs>"
^XWB(8994,3618,3,22,0)="               <Rs Rn=""CLIN 1"">"
^XWB(8994,3618,3,23,0)="                   <Rc Pr=""All"" Mn=""Encounters"" Vt=""Actual"" Vl=""4""/>"
^XWB(8994,3618,3,24,0)="             </Rs>"
^XWB(8994,3618,3,25,0)="               <Rs Rn=""CLIN 2"">"
^XWB(8994,3618,3,26,0)="                   <Rc Pr=""All"" Mn=""Encounters"" Vt=""Actual"" Vl=""8""/>"
^XWB(8994,3618,3,27,0)="             </Rs>"
^XWB(8994,3618,3,28,0)="            </Rg>"
^XWB(8994,3618,3,29,0)="          </Division>"
^XWB(8994,3618,3,30,0)="          <Division Name=""DIV 2"">"
^XWB(8994,3618,3,31,0)="            <Rg Rg=""All"">"
^XWB(8994,3618,3,32,0)="               <Rs Rn=""All"">"
^XWB(8994,3618,3,33,0)="                   <Rc Pr=""All"" Mn=""Encounters"" Vt=""Actual"" Vl=""21""/>"
^XWB(8994,3618,3,34,0)="                </Rs>"
^XWB(8994,3618,3,35,0)="            </Rg>"
^XWB(8994,3618,3,36,0)="          </Division>"
^XWB(8994,3618,3,37,0)="        </Date>"
^XWB(8994,3618,3,38,0)="      </DateAggregate>"
^XWB(8994,3618,3,39,0)="    </ReportType>"
^XWB(8994,3618,3,40,0)="  </VAFacility>"
^XWB(8994,3619,0)="SD VSE FILTER RPC^GETFLT^SDECXML^4^P^^^0^1"
^XWB(8994,3619,1,0)="^8994.01^3^3^3141215^^"
^XWB(8994,3619,1,1,0)="This RPC returns the available Report Types, Date Increments, and specific Dates for which"
^XWB(8994,3619,1,2,0)="Scheduling Report data is available. "
^XWB(8994,3619,1,3,0)="Data is returned is XML format. Example:"
^XWB(8994,3619,3,0)="^8994.03^39^39^3141215^^^"
^XWB(8994,3619,3,1,0)="Scheduling data for VSE report is returned in XML format."
^XWB(8994,3619,3,2,0)="Example data:"
^XWB(8994,3619,3,3,0)="<?xml version=""1.0"" encoding=""UTF-8""?>"
^XWB(8994,3619,3,4,0)=" <VAFacility Name=""CHEYENNE VAMC"" ID=""442"">"
^XWB(8994,3619,3,5,0)="   <ReportType ReportType=""Mental Health"">"
^XWB(8994,3619,3,6,0)="      <DateAggregate DateAgg=""Year"">"
^XWB(8994,3619,3,7,0)="        <Date ActivityDate=""12/15/2014"" DateName=""12/15/2013"">"
^XWB(8994,3619,3,8,0)="        </Date>"
^XWB(8994,3619,3,9,0)="      </DateAggregate>"
^XWB(8994,3619,3,10,0)="      <DateAggregate DateAgg=""Quarter"">"
^XWB(8994,3619,3,11,0)="        <Date ActivityDate=""12/15/2014"" DateName=""Q4-2014"">"
^XWB(8994,3619,3,12,0)="        </Date>"
^XWB(8994,3619,3,13,0)="      </DateAggregate>"
^XWB(8994,3619,3,14,0)="      <DateAggregate DateAgg=""Month"">"
^XWB(8994,3619,3,15,0)="        <Date ActivityDate=""12/15/2014"" DateName=""Oct 2014"">"
^XWB(8994,3619,3,16,0)="        </Date>"
^XWB(8994,3619,3,17,0)="        <Date ActivityDate=""12/15/2014"" DateName=""Nov 2014"">"
^XWB(8994,3619,3,18,0)="        </Date>"
^XWB(8994,3619,3,19,0)="        <Date ActivityDate=""12/15/2014"" DateName=""Dec 2014"">"
^XWB(8994,3619,3,20,0)="        </Date>"
^XWB(8994,3619,3,21,0)="      </DateAggregate>"
^XWB(8994,3619,3,22,0)="      <DateAggregate DateAgg=""Week"">"
^XWB(8994,3619,3,23,0)="        <Date ActivityDate=""12/15/2014"" DateName=""10/06/2014"">"
^XWB(8994,3619,3,24,0)="        </Date>"
^XWB(8994,3619,3,25,0)="        <Date ActivityDate=""12/15/2014"" DateName=""11/03/2014"">"
^XWB(8994,3619,3,26,0)="        </Date>"
^XWB(8994,3619,3,27,0)="        <Date ActivityDate=""12/15/2014"" DateName=""12/15/2014"">"
^XWB(8994,3619,3,28,0)="        </Date>"
^XWB(8994,3619,3,29,0)="      </DateAggregate>"
^XWB(8994,3619,3,30,0)="      <DateAggregate DateAgg=""Date"">"
^XWB(8994,3619,3,31,0)="        <Date ActivityDate=""12/15/2014"" DateName=""10/09/2014"">"
^XWB(8994,3619,3,32,0)="        </Date>"
^XWB(8994,3619,3,33,0)="        <Date ActivityDate=""12/15/2014"" DateName=""11/06/2014"">"
^XWB(8994,3619,3,34,0)="        </Date>"
^XWB(8994,3619,3,35,0)="        <Date ActivityDate=""12/15/2014"" DateName=""12/15/2014"">"
^XWB(8994,3619,3,36,0)="        </Date>"
^XWB(8994,3619,3,37,0)="      </DateAggregate>"
^XWB(8994,3619,3,38,0)="    </ReportType>"
^XWB(8994,3619,3,39,0)="  </VAFacility>"
^XWB(8994,3620,0)="SDEC APPSLOTS^APPSLOTS^SDEC^4^R^0^^0^^^1"
^XWB(8994,3620,1,0)="^^1^1^3151201^"
^XWB(8994,3620,1,1,0)="Return global array of available appointment slots."
^XWB(8994,3620,2,0)="^8994.02A^3^3"
^XWB(8994,3620,2,1,0)="SDCL^1^^1^1"
^XWB(8994,3620,2,1,1,0)="^^1^1^3151201^"
^XWB(8994,3620,2,1,1,1,0)="Pointer to HOSPITAL LOCATION file 44."
^XWB(8994,3620,2,2,0)="SDBEG^1^^1^2"
^XWB(8994,3620,2,2,1,0)="^^1^1^3151201^"
^XWB(8994,3620,2,2,1,1,0)="Begin date/time."
^XWB(8994,3620,2,3,0)="SDEND^1^^1^3"
^XWB(8994,3620,2,3,1,0)="^^1^1^3151201^"
^XWB(8994,3620,2,3,1,1,0)="End date/time."
^XWB(8994,3620,2,"B","SDBEG",2)=""
^XWB(8994,3620,2,"B","SDCL",1)=""
^XWB(8994,3620,2,"B","SDEND",3)=""
^XWB(8994,3620,2,"PARAMSEQ",1,1)=""
^XWB(8994,3620,2,"PARAMSEQ",2,2)=""
^XWB(8994,3620,2,"PARAMSEQ",3,3)=""
^XWB(8994,3620,3,0)="^^2^2^3151201^"
^XWB(8994,3620,3,1,0)="Returns an array with entries:"
^XWB(8994,3620,3,2,0)="  FM DATE^SLOT START TIME^SLOT END TIME^AVAILABILITY CODE"
^XWB(8994,3621,0)="SDEC NOAVAIL^NOAVAIL^SDEC04^4^R^0^^0"
^XWB(8994,3621,1,0)="^^1^1^3151201^"
^XWB(8994,3621,1,1,0)="GET: has the given clinic ever had any availability defined?"
^XWB(8994,3621,2,0)="^8994.02A^1^1"
^XWB(8994,3621,2,1,0)="SDCL^1^^1^1"
^XWB(8994,3621,2,1,1,0)="^^1^1^3151201^"
^XWB(8994,3621,2,1,1,1,0)="Clinic ID pointer to HOSPITAL LOCATION file 44."
^XWB(8994,3621,2,"B","SDCL",1)=""
^XWB(8994,3621,2,"PARAMSEQ",1,1)=""
^XWB(8994,3621,3,0)="^^4^4^3151201^"
^XWB(8994,3621,3,1,0)="1. AVAILABILITY:"
^XWB(8994,3621,3,2,0)="    YES = Availability has been defined for this clinic"
^XWB(8994,3621,3,3,0)="          (even if there is no availability defined 'now')"
^XWB(8994,3621,3,4,0)="    NO  = Availability has never been defined for this clinic"
^XWB(8994,3622,0)="SDECAR AUDITGET^AUDITGET^SDECAR^4^R^0^^0"
^XWB(8994,3622,1,0)="^^1^1^3151201^"
^XWB(8994,3622,1,1,0)="GET entries from VS AUDIT field of SDEC APPT REQUEST file 409.85."
^XWB(8994,3622,2,0)="^8994.02A^1^1"
^XWB(8994,3622,2,1,0)="ARIEN^1^^1^1"
^XWB(8994,3622,2,1,1,0)="^^1^1^3151201^"
^XWB(8994,3622,2,1,1,1,0)="Pointer to SDEC APPT REQUEST file 409.85."
^XWB(8994,3622,2,"B","ARIEN",1)=""
^XWB(8994,3622,2,"PARAMSEQ",1,1)=""
^XWB(8994,3622,3,0)="^^15^15^3151201^"
^XWB(8994,3622,3,1,0)="Global Array in which each array entry contains an Audit entry with ^ "
^XWB(8994,3622,3,2,0)="pieces as listed below."
^XWB(8994,3622,3,3,0)="Note that the first entry contains the current definition."
^XWB(8994,3622,3,4,0)=" "
^XWB(8994,3622,3,5,0)="   1. IEN    - pointer to SDEC APPT REQUEST file 409.85"
^XWB(8994,3622,3,6,0)="   2. ID     - pointer to the multiple entry of 'this' audit entry"
^XWB(8994,3622,3,7,0)="   3. DATE   - Date/Time entered in external format"
^XWB(8994,3622,3,8,0)="   4. USERIEN - Edited By user ID pointer to NEW PERSON file 200"
^XWB(8994,3622,3,9,0)="   5. USERNAME - Edit By user name from NEW PERSON file 200"
^XWB(8994,3622,3,10,0)="   6. CLINIEN  - REQ SPECIFIC CLINIC id pointer to HOSPITAL LOCATION"
^XWB(8994,3622,3,11,0)="                 FILE 44"
^XWB(8994,3622,3,12,0)="   7. CLINNAME - REQ SPECIFIC CLINIC name"
^XWB(8994,3622,3,13,0)="   8. STOPIEN  - REQ SERVICE/SPECIALTY id pointer to CLINIC STOP"
^XWB(8994,3622,3,14,0)="                 file 40.7"
^XWB(8994,3622,3,15,0)="   9. STOPNAME - REQ SERVICE/SPECIALTY name"
^XWB(8994,3623,0)="SDECWL AUDITGET^AUDITGET^SDECWL^4^R^0^^0"
^XWB(8994,3623,1,0)="^^1^1^3151201^"
^XWB(8994,3623,1,1,0)="GET entries from VS AUDIT field of SD WAIT LIST file 409.3."
^XWB(8994,3623,2,0)="^8994.02A^1^1"
^XWB(8994,3623,2,1,0)="WLIEN^1^^1^1"
^XWB(8994,3623,2,1,1,0)="^^1^1^3151201^"
^XWB(8994,3623,2,1,1,1,0)="Pointer to SD WAIT LIST file 409.3."
^XWB(8994,3623,2,"B","WLIEN",1)=""
^XWB(8994,3623,2,"PARAMSEQ",1,1)=""
^XWB(8994,3623,3,0)="^^17^17^3151201^"
^XWB(8994,3623,3,1,0)="Global Array in which each array entry contains an Audit entry with ^ "
^XWB(8994,3623,3,2,0)="pieces as listed below."
^XWB(8994,3623,3,3,0)="Note that the first entry contains the current definition."
^XWB(8994,3623,3,4,0)="  "
^XWB(8994,3623,3,5,0)="   1. IEN    - pointer to SD WAIT LIST file 409.3"
^XWB(8994,3623,3,6,0)="   2. ID     - pointer to the multiple entry of 'this' audit entry"
^XWB(8994,3623,3,7,0)="   3. DATE   - Date/Time entered in external format"
^XWB(8994,3623,3,8,0)="   4. USERIEN - Edited By user ID pointer to NEW PERSON file 200"
^XWB(8994,3623,3,9,0)="   5. USERNAME - Edit By user name from NEW PERSON file 200"
^XWB(8994,3623,3,10,0)="   6. WLCLINIEN  - Clinic Location id pointer to SD WL CLINIC LOCATION"
^XWB(8994,3623,3,11,0)="   7. WLCLINNAME - Clinic Location name from SD WL CLINIC LOCATION"
^XWB(8994,3623,3,12,0)="   8. CLINIEN - WL SPECIFIC CLINIC id pointer to HOSPITAL LOCATION"
^XWB(8994,3623,3,13,0)="                file 44"
^XWB(8994,3623,3,14,0)="   9. CLINNAME - WL SPECIFIC CLINIC name"
^XWB(8994,3623,3,15,0)="  10. STOPIEN  - WL SERVICE SPECIALTY id pointer to CLINIC STOP"
^XWB(8994,3623,3,16,0)="                 file 40.7"
^XWB(8994,3623,3,17,0)="  11. STOPNAME - WL SERVICE/SPECIALTY name"
^XWB(8994,3624,0)="SDECCAP GET^GET^SDECCAP^4^R^0^^0"
^XWB(8994,3624,1,0)="^8994.01^1^1^3151222^^"
^XWB(8994,3624,1,1,0)="GET entries from 2507 REQUEST file 396.3"
^XWB(8994,3624,2,0)="^8994.02A^5^5"
^XWB(8994,3624,2,1,0)="DFN^1^^1^1"
^XWB(8994,3624,2,1,1,0)="^^1^1^3151221^"
^XWB(8994,3624,2,1,1,1,0)="Patient ID pointer to PATIENT file 2"
^XWB(8994,3624,2,2,0)="SDCL^1^^1^2"
^XWB(8994,3624,2,2,1,0)="^^1^1^3151221^"
^XWB(8994,3624,2,2,1,1,0)="Clinic ID pointer to HOSPITAL LOCATION file 44"
^XWB(8994,3624,2,3,0)="SDT^1^^1^3"
^XWB(8994,3624,2,3,1,0)="^^1^1^3151221^"
^XWB(8994,3624,2,3,1,1,0)="Appointment Date/Time in external format"
^XWB(8994,3624,2,4,0)="TYPE^1^^1^4"
^XWB(8994,3624,2,4,1,0)="^^3^3^3151221^"
^XWB(8994,3624,2,4,1,1,0)="O:MAKE"
^XWB(8994,3624,2,4,1,2,0)="R:REBOOK"
^XWB(8994,3624,2,4,1,3,0)="C:CANCEL or NO SHOW"
^XWB(8994,3624,2,5,0)="APTYPE^1^^1^5"
^XWB(8994,3624,2,5,1,0)="^8994.021^2^2^3151222^^"
^XWB(8994,3624,2,5,1,1,0)="Must be 1."
^XWB(8994,3624,2,5,1,2,0)="Only COMP and PEN is currently supported."
^XWB(8994,3624,2,"B","APTYPE",5)=""
^XWB(8994,3624,2,"B","DFN",1)=""
^XWB(8994,3624,2,"B","SDCL",2)=""
^XWB(8994,3624,2,"B","SDT",3)=""
^XWB(8994,3624,2,"B","TYPE",4)=""
^XWB(8994,3624,2,"PARAMSEQ",1,1)=""
^XWB(8994,3624,2,"PARAMSEQ",2,2)=""
^XWB(8994,3624,2,"PARAMSEQ",3,3)=""
^XWB(8994,3624,2,"PARAMSEQ",4,4)=""
^XWB(8994,3624,2,"PARAMSEQ",5,5)=""
^XWB(8994,3624,3,0)="^^16^16^3151222^"
^XWB(8994,3624,3,1,0)="REQIEN - 2507 REQUEST id pointer to 2507 REQUEST file 396.3"
^XWB(8994,3624,3,2,0)="IEN    - Patient ID pointer to PATIENT file 2"
^XWB(8994,3624,3,3,0)="NAME   - Patient name from PATIENT file 2"
^XWB(8994,3624,3,4,0)="DATE   - Request Date in external format (field #1)"
^XWB(8994,3624,3,5,0)="EXISTS - Flag to indicate that a 2507 REQUEST already has an appointment."
^XWB(8994,3624,3,6,0)="         This is indicated by an entry in file 396.95"
^XWB(8994,3624,3,7,0)="         0=No; 1=Yes"
^XWB(8994,3624,3,8,0)="APPT_LINKS - Appointment Links separated by pipe |"
^XWB(8994,3624,3,9,0)="              each pipe piece contains the following ~ pieces"
^XWB(8994,3624,3,10,0)="              1. Link ID         - Pointer to AMIE C&P EXAM TRACKING file "
^XWB(8994,3624,3,11,0)=396.95
^XWB(8994,3624,3,12,0)="              2. Initial Appt    - Date/time in external format"
^XWB(8994,3624,3,13,0)="              3. Clock Stop Appt - Date/time in external format"
^XWB(8994,3624,3,14,0)="              4. Current Appt    - Date/time in external format"
^XWB(8994,3624,3,15,0)=" "
^XWB(8994,3624,3,16,0)="              5. Clinic Name     - Name from HOSPITAL LOCATION"
^XWB(8994,3625,0)="SDECCAP SET^SET^SDECCAP^4^R^0^^0"
^XWB(8994,3625,1,0)="^8994.01^1^1^3151222^^"
^XWB(8994,3625,1,1,0)="SET entries to AMIE C&P EXAM TRACKING file 396.95 and update file 396.3"
^XWB(8994,3625,2,0)="^8994.02A^5^5"
^XWB(8994,3625,2,1,0)="REQIEN^1^^1^1"
^XWB(8994,3625,2,1,1,0)="^^1^1^3151221^"
^XWB(8994,3625,2,1,1,1,0)="2507 REQUEST id pointer to 2507 REQUEST file 396.3"
^XWB(8994,3625,2,2,0)="APPTLNK^1^^0^2"
^XWB(8994,3625,2,2,1,0)="^^9^9^3151221^"
^XWB(8994,3625,2,2,1,1,0)="Appointment Link with the following ~ pieces:"
^XWB(8994,3625,2,2,1,2,0)="(a new link will be made if this is null)"
^XWB(8994,3625,2,2,1,3,0)="               1. Link ID         - Pointer to AMIE C&P EXAM TRACKING"
^XWB(8994,3625,2,2,1,4,0)="                                    file 396.95"
^XWB(8994,3625,2,2,1,5,0)="               2. Initial Appt    - Date/time in external format"
^XWB(8994,3625,2,2,1,6,0)="               3. Clock Stop Appt - Date/time in external format"
^XWB(8994,3625,2,2,1,7,0)="               4. Current Appt    - Date/time in external format"
^XWB(8994,3625,2,2,1,8,0)="               5. Clinic IEN      - Pointer to HOSPITAL LOCATION"
^XWB(8994,3625,2,2,1,9,0)="               6. Clinic Name     - Name from HOSPITAL LOCATION"
^XWB(8994,3625,2,3,0)="VETREQ^1^^0^3"
^XWB(8994,3625,2,3,1,0)="^^4^4^3151221^"
^XWB(8994,3625,2,3,1,1,0)="Veteran Request flag - (field .04 in file 396.95)"
^XWB(8994,3625,2,3,1,2,0)="        ""Is this appointment due to a veteran requested cancellation"
^XWB(8994,3625,2,3,1,3,0)="         or 'No Show'"""
^XWB(8994,3625,2,3,1,4,0)="        0=NO; 1=YES"
^XWB(8994,3625,2,4,0)="SDCL^1^^1^4"
^XWB(8994,3625,2,4,1,0)="^^1^1^3151221^"
^XWB(8994,3625,2,4,1,1,0)="pointer to HOSPITAL LOCATION file 44"
^XWB(8994,3625,2,5,0)="SDT^1^^1^5"
^XWB(8994,3625,2,5,1,0)="^8994.021^1^1^3151222^^"
^XWB(8994,3625,2,5,1,1,0)="Appointment date/time in external format"
^XWB(8994,3625,2,"B","APPTLNK",2)=""
^XWB(8994,3625,2,"B","REQIEN",1)=""
^XWB(8994,3625,2,"B","SDCL",4)=""
^XWB(8994,3625,2,"B","SDT",5)=""
^XWB(8994,3625,2,"B","VETREQ",3)=""
^XWB(8994,3625,2,"PARAMSEQ",1,1)=""
^XWB(8994,3625,2,"PARAMSEQ",2,2)=""
^XWB(8994,3625,2,"PARAMSEQ",3,3)=""
^XWB(8994,3625,2,"PARAMSEQ",4,4)=""
^XWB(8994,3625,2,"PARAMSEQ",5,5)=""
^XWB(8994,3625,3,0)="^8994.03^1^1^3151222^^"
^XWB(8994,3625,3,1,0)="CODE ^ MESSAGE"
^XWB(8994,3626,0)="SDECCAP CAN^CAN^SDECCAP^4^R^0^^0"
^XWB(8994,3626,1,0)="^^1^1^3151222^"
^XWB(8994,3626,1,1,0)="SET AMIE C&P EXAM TRACKING entry as cancel"
