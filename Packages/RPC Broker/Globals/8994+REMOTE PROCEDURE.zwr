^XWB(8994,5004,2,2,1,1,0)="CANCEL(""CLINIC IEN"")=4118"
^XWB(8994,5004,2,2,1,2,0)="CANCEL(""FULL PARTIAL FLAG"")=""P"""
^XWB(8994,5004,2,2,1,3,0)="    * If ""FULL PARTIAL FLAG"" is ""P"" (Partial Day), the START DATE TIME "
^XWB(8994,5004,2,2,1,4,0)="      and END DATE TIME must fall on the same calendar day and include"
^XWB(8994,5004,2,2,1,5,0)="      both date and time."
^XWB(8994,5004,2,2,1,6,0)="    * If the flag is ""F"" (Full Day), only the date portion is required for"
^XWB(8994,5004,2,2,1,7,0)="      both START DATE TIME and END DATE TIME, and the cancellation window"
^XWB(8994,5004,2,2,1,8,0)="      may span multiple days."
