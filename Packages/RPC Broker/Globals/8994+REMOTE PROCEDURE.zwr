^XWB(8994,3703,2,4,1,1,0)="Par level used for Normal Stock Level."
^XWB(8994,3703,2,5,0)="PAR2^1^6^1^4"
^XWB(8994,3703,2,5,1,0)="^8994.021^1^1^3130513^^"
^XWB(8994,3703,2,5,1,1,0)="Par level used for Standard Reorder Level."
^XWB(8994,3703,2,6,0)="PAR3^1^6^1^5"
^XWB(8994,3703,2,6,1,0)="^8994.021^1^1^3130513^^"
^XWB(8994,3703,2,6,1,1,0)="Par level used for Optional Reorder Level."
^XWB(8994,3703,2,7,0)="PAR4^1^6^1^6"
