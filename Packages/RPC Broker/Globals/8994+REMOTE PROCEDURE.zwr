^XWB(8994,3920,1,2,0)="file# 445) to which a user is entered as an Inventory User."
^XWB(8994,3920,2,0)="^8994.02A^2^2"
^XWB(8994,3920,2,1,0)="USER^1^30^^1"
^XWB(8994,3920,2,1,1,0)="^^1^1^3130108^"
^XWB(8994,3920,2,1,1,1,0)="The user's DUZ.  If nothing is passed, then DUZ is assumed."
^XWB(8994,3920,2,2,0)="DPTYPE^1^1^0^2"
^XWB(8994,3920,2,2,1,0)="^8994.021^1^1^3150415^^"
^XWB(8994,3920,2,2,1,1,0)="DPTYPE is ""P"" for Primary, ""S"" for Secondary, ""W"" for Warehouse"
^XWB(8994,3920,2,"B","DPTYPE",2)=""
^XWB(8994,3920,2,"B","USER",1)=""
^XWB(8994,3920,2,"PARAMSEQ",1,1)=""
^XWB(8994,3920,2,"PARAMSEQ",2,2)=""
^XWB(8994,3920,3,0)="^8994.03^3^3^3150415^^^"
^XWB(8994,3920,3,1,0)="Returns array:"
^XWB(8994,3920,3,2,0)="RET(n)=Inventory Point IEN (file #445)^Inventory Point name^Type"
