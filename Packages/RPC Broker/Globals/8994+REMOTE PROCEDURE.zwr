^XWB(8994,2915,2,1,0)="MDCPMSG^1^250^1^1"
^XWB(8994,2915,2,1,1,0)="^^1^1^3061211^"
^XWB(8994,2915,2,1,1,1,0)="This is the IFN of the HL7 message in the CLIO_HL7_LOG file."
