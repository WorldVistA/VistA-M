^XWB(8994,4561,3,0)="^8994.03^7^7^3170825^^"
^XWB(8994,4561,3,1,0)="If there is a signture available at the level indicated, returns:"
^XWB(8994,4561,3,2,0)="TYPE OF SIGNATURE^Name: LAST,FIRST^Email: EMAIL^Phone: PHONE^Signed: DATE"
^XWB(8994,4561,3,3,0)=" "
^XWB(8994,4561,3,4,0)="If any of above information is unavailable, it returns 'Not available'"
^XWB(8994,4561,3,5,0)=" "
^XWB(8994,4561,3,6,0)="If there is no signature yet at that level, it returns:"
^XWB(8994,4561,3,7,0)="TYPE OF SIGNATURE^Not signed yet"
