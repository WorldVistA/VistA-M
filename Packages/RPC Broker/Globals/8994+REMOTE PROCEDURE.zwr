^XWB(8994,3313,2,1,1,0)="^8994.021^7^7^3120510^^^^"
^XWB(8994,3313,2,1,1,1,0)="Information about the client and its workstation."
^XWB(8994,3313,2,1,1,2,0)="^01: MAMMORES -- Screen resolution of main viewer display:"
^XWB(8994,3313,2,1,1,3,0)="format is X_""x""_Y_"",""_ColorType (e.g., 2048x2580,GRAY)"
