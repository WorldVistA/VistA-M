^XWB(8994,4021,3,13,0)=" "
^XWB(8994,4021,3,14,0)="   DSIYRET(""ORDNO"")=the new starting order # (used in DSIYGO01 AUTOGENP)"
^XWB(8994,4022,0)="DSIYGO02 DELREP DEL REP ITEM^DELREP^DSIYGO02^2"
^XWB(8994,4022,1,0)="^8994.01^5^5^3131121^^"
