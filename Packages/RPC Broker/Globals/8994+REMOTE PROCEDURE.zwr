^XWB(8994,3371,2,"PARAMSEQ",5,4)=""
^XWB(8994,3371,2,"PARAMSEQ",6,5)=""
^XWB(8994,3371,2,"PARAMSEQ",7,6)=""
^XWB(8994,3371,2,"PARAMSEQ",8,8)=""
^XWB(8994,3371,3,0)="^^42^42^3151013^"
^XWB(8994,3371,3,1,0)="AN array is returned."
^XWB(8994,3371,3,2,0)=" "
^XWB(8994,3371,3,3,0)=" OUTPUT"
^XWB(8994,3371,3,4,0)="  If error"
^XWB(8994,3371,3,5,0)="   VPSRES(0)=-1^Error Message"
^XWB(8994,3371,3,6,0)=" "
^XWB(8994,3371,3,7,0)="  otherwise"
^XWB(8994,3371,3,8,0)="   VPSRES(0)=1^Number of Questionnaires"
^XWB(8994,3371,3,9,0)="   VPSRES(1) = <CSQ>"
^XWB(8994,3371,3,10,0)="   VPSRES(2) =     PATIENT ^ QUESTIONNAIRE TEMPLATE ID ^ QUESTIONNAIRE "
^XWB(8994,3371,3,11,0)="TEMPLATE NAME ^ QUESTIONNAIRE TEMPLATE IEN ^ VERSION"
^XWB(8994,3371,3,12,0)="   VPSRES(3) =     <RESPONSE>"
^XWB(8994,3371,3,13,0)="   VPSRES(4) =          RESPONSE IDENTIFIER ^ DATE/TIME TAKEN ^ DATE/TIME "
^XWB(8994,3371,3,14,0)="LAST MODIFIED"
^XWB(8994,3371,3,15,0)="   VPSRES(5) =          COMPLETION STATUS ^ PATIENT SAFETY ^ IMMEDIATE "
^XWB(8994,3371,3,16,0)="ACTION ^ SURVEY CALCULATED VALUE"
^XWB(8994,3371,3,17,0)="   VPSRES(6) =          <APPOINTMENT CHECK-IN>"
^XWB(8994,3371,3,18,0)="   VPSRES(7) =               APPOINTMENT CHECK-IN ID"
^XWB(8994,3371,3,19,0)="   VPSRES(8) =          </APPOINTMENT CHECK-IN>"
^XWB(8994,3371,3,20,0)="   VPSRES(9) =          <ADDITIONAL CALCULATED VALUE>"
^XWB(8994,3371,3,21,0)="   VPSRES(10) =               ADDITIONAL CALC VALUE NAME ^ ADDITIONAL "
^XWB(8994,3371,3,22,0)="CALC VALUE SCORE"
^XWB(8994,3371,3,23,0)="   VPSRES(11) =          </ADDITIONAL CALCULATED VALUE>"
^XWB(8994,3371,3,24,0)="   VPSRES(12) =          <QUESTIONS>"
^XWB(8994,3371,3,25,0)="   VPSRES(13) =               QUESTION NUMBER ^ QUESTION CALCULATED VALUE"
^XWB(8994,3371,3,26,0)="   VPSRES(14) =               <QUESTION PRESENTED>"
^XWB(8994,3371,3,27,0)="   VPSRES(15) =                    QUESTION TEXT...."
^XWB(8994,3371,3,28,0)="   VPSRES(16) =               </QUESTION PRESENTED>"
^XWB(8994,3371,3,29,0)="   VPSRES(17) =               <ANSWER>"
^XWB(8994,3371,3,30,0)="   VPSRES(18) =                    ANSWER IDENTIFIER ^ INTERFACE USED ^ "
^XWB(8994,3371,3,31,0)="RESPONDENT ^ RESPONDENT NAME ^ ANSWER DATE/TIME ^ INTERVIEWER NAME ^ "
^XWB(8994,3371,3,32,0)="KIOSK IDENTIFIER ^ KIOSK SESSION IDENTIFIER ^ KIOSK GROUP IDENTIFIER"
^XWB(8994,3371,3,33,0)="   VPSRES(19) =                    <ANSWER RESPONSE>"
^XWB(8994,3371,3,34,0)="   VPSRES(20) =                         ANSWER TEXT"
^XWB(8994,3371,3,35,0)="   VPSRES(21) =                    </ANSWER RESPONSE>"
^XWB(8994,3371,3,36,0)="   VPSRES(22) =               </ANSWER>"
^XWB(8994,3371,3,37,0)="   VPSRES(23) =          </QUESTIONS>"
^XWB(8994,3371,3,38,0)="   VPSRES(24) =     </RESPONSE>"
^XWB(8994,3371,3,39,0)="   VPSRES(25) = </CSQ>"
^XWB(8994,3371,3,40,0)="   VPSRES(26) = <CSQ> "
^XWB(8994,3371,3,41,0)="   ..."
^XWB(8994,3371,3,42,0)="   VPSRES(n) = </CSQ>"
^XWB(8994,3372,0)="VPS GET ALLERGIES^GET^VPSALL01^2^R^0"
^XWB(8994,3372,1,0)="^8994.01^3^3^3120915^^"
^XWB(8994,3372,1,1,0)="Called by the Vetlink Kiosk system.   VPS GET ALLEGIES retrieves patient "
^XWB(8994,3372,1,2,0)="allergy data stored in an entry or entries in the PATIENT ALLERGIES file "
^XWB(8994,3372,1,3,0)="(120.8).  The retrieved data is made available to the Vetlink system. "
^XWB(8994,3372,2,0)="^8994.02A^1^1"
^XWB(8994,3372,2,1,0)="DFN^1^30^1^1"
^XWB(8994,3372,2,1,1,0)="^8994.021^2^2^3120915^^^"
^XWB(8994,3372,2,1,1,1,0)="The patient DFN is used to collect the various allergy related fields "
^XWB(8994,3372,2,1,1,2,0)="stored in the Adverse Reaction Tracking package."
^XWB(8994,3372,2,"B","DFN",1)=""
^XWB(8994,3372,2,"PARAMSEQ",1,1)=""
^XWB(8994,3372,3,0)="^8994.03^19^19^3120915^^"
^XWB(8994,3372,3,1,0)="Data taken from an entry or entries stored in the PATIENT ALLERGIES "
^XWB(8994,3372,3,2,0)="file (120.8) are populated into the local array."
^XWB(8994,3372,3,3,0)=" "
^XWB(8994,3372,3,4,0)="Each element in the subscripted array is constructed as:"
^XWB(8994,3372,3,5,0)="subscriptedArray(n)= ""file number^iens (sub-entry ien, ien)^field "
^XWB(8994,3372,3,6,0)="number^field label^data value"""
^XWB(8994,3372,3,7,0)="1.      where n is an incremental number that acts as an index in the "
^XWB(8994,3372,3,8,0)="array"
^XWB(8994,3372,3,9,0)="2.      file number is the file or sub-file reference from where the "
^XWB(8994,3372,3,10,0)="field is defined "
^XWB(8994,3372,3,11,0)="3.      iens are the internal entry numbers at which the allergy record "
^XWB(8994,3372,3,12,0)="is stored.  This element can have either the entry level ien for "
^XWB(8994,3372,3,13,0)="non-multiple or it can have both the entry level ien and the sub-entry "
^XWB(8994,3372,3,14,0)="ien.   It is constructed as ""sub-entry ien, entry ien""  for data coming "
^XWB(8994,3372,3,15,0)="from sub-files (multiples)"
^XWB(8994,3372,3,16,0)="4.      field number is the numeric field reference from where the data "
^XWB(8994,3372,3,17,0)="has been retrieved"
^XWB(8994,3372,3,18,0)="5.       field label is the name of the field"
^XWB(8994,3372,3,19,0)="6.      data value  is the data that was retrieved from the field"
^XWB(8994,3373,0)="VPS WRITE MRAR PDO^WRITE^VPSMRAR1^2^R^0"
^XWB(8994,3373,1,0)="^8994.01^7^7^3150501^^^^"
^XWB(8994,3373,1,1,0)="Called by the Vetlink Kiosk system.  The RPC will accept 4 input "
^XWB(8994,3373,1,2,0)="parameters; and will return output when processing completes or ends with "
^XWB(8994,3373,1,3,0)="an exception.  Vetlink Kiosk has the Medication Review Allergy Review "
^XWB(8994,3373,1,4,0)="modules where a  veteran can review and make changes to his medications"
^XWB(8994,3373,1,5,0)="and any allergies.  The MRAR can also be facilitated by a provider.  The"
^XWB(8994,3373,1,6,0)="local arrays identify the field to be updated along with the respective"
^XWB(8994,3373,1,7,0)="data changes and serves to the RPC."
^XWB(8994,3373,2,0)="^8994.02A^7^2"
^XWB(8994,3373,2,1,0)="VPSPID^1^30^1^1"
^XWB(8994,3373,2,1,1,0)="^8994.021^2^2^3150501^^"
^XWB(8994,3373,2,1,1,1,0)="The patient identifier value corresponding to the provided identifier"
^XWB(8994,3373,2,1,1,2,0)="type, VPSTYP."
^XWB(8994,3373,2,4,0)="VPSMRAR^2^^1^4"
^XWB(8994,3373,2,4,1,0)="^^25^25^3150501^"
^XWB(8994,3373,2,4,1,1,0)="Local array representing the kiosk Medication and Allergy "
^XWB(8994,3373,2,4,1,2,0)="Review passed in by reference.   VPSMRAR represents allergy related"
^XWB(8994,3373,2,4,1,3,0)="fields, medication related fields, and statistical information about the"
^XWB(8994,3373,2,4,1,4,0)="MRAR session."
^XWB(8994,3373,2,4,1,5,0)=" "
^XWB(8994,3373,2,4,1,6,0)="Each subscript in the array is assigned a composite, delimited string."
^XWB(8994,3373,2,4,1,7,0)=" "
^XWB(8994,3373,2,4,1,8,0)=" localArray(n) = FIELD NAME^ARRAY IENS^DATA "
^XWB(8994,3373,2,4,1,9,0)=" "
^XWB(8994,3373,2,4,1,10,0)="where "
^XWB(8994,3373,2,4,1,11,0)=" "
^XWB(8994,3373,2,4,1,12,0)="     n is an incremental number"
^XWB(8994,3373,2,4,1,13,0)=" "
^XWB(8994,3373,2,4,1,14,0)="     FIELD NAME represents the name of the field in 853.5 file "
^XWB(8994,3373,2,4,1,15,0)=" "
^XWB(8994,3373,2,4,1,16,0)="     ARRAY IENS represent entry and sub-entry ctrs (e.g., if patient has 3"
^XWB(8994,3373,2,4,1,17,0)="     allergies then a given value would be ""1,2"" where ""1"" represents top"
^XWB(8994,3373,2,4,1,18,0)="     level entry and ""2"" represents the sub-entry or the 2nd allergy"
^XWB(8994,3373,2,4,1,19,0)="     record.)"
^XWB(8994,3373,2,4,1,20,0)=" "
^XWB(8994,3373,2,4,1,21,0)="     DATA is the actual data that is populated at an entry in 853.5"
^XWB(8994,3373,2,4,1,22,0)=" "
^XWB(8994,3373,2,4,1,23,0)="Note:  Each element in VPSMRAR will accept values in the above format. "
^XWB(8994,3373,2,4,1,24,0)="However, elements of some multiple fields use the third index as the "
^XWB(8994,3373,2,4,1,25,0)="value and will ignore provided input values.  "
^XWB(8994,3373,2,6,0)="VPSINTFC^1^1^1^3"
^XWB(8994,3373,2,6,1,0)="^8994.021^3^3^3150126^^^"
^XWB(8994,3373,2,6,1,1,0)="Interface Module."
^XWB(8994,3373,2,6,1,2,0)="'S' represents Staff-facing Interface Module"
^XWB(8994,3373,2,6,1,3,0)="'P' represents Patient-facing Interface Module"
^XWB(8994,3373,2,7,0)="VPSTYP^1^7^1^2"
^XWB(8994,3373,2,7,1,0)="^^2^2^3150501^"
^XWB(8994,3373,2,7,1,1,0)="Patient ID Type. Valid Values for this parameter are SSN, DFN, ICN, or"
^XWB(8994,3373,2,7,1,2,0)="VIC/CAC."
^XWB(8994,3373,2,"B","VPSDFN",5)=""
^XWB(8994,3373,2,"B","VPSINTFC",6)=""
^XWB(8994,3373,2,"B","VPSMRAR",4)=""
^XWB(8994,3373,2,"B","VPSPID",1)=""
^XWB(8994,3373,2,"B","VPSTYP",7)=""
^XWB(8994,3373,2,"PARAMSEQ",1,1)=""
^XWB(8994,3373,2,"PARAMSEQ",2,4)=""
^XWB(8994,3373,2,"PARAMSEQ",2,6)=""
^XWB(8994,3373,2,"PARAMSEQ",2,7)=""
^XWB(8994,3373,2,"PARAMSEQ",3,4)=""
^XWB(8994,3373,2,"PARAMSEQ",3,6)=""
^XWB(8994,3373,2,"PARAMSEQ",4,4)=""
^XWB(8994,3373,3,0)="^^10^10^3150501^"
^XWB(8994,3373,3,1,0)="Local array that returns the results of each updated field per array data"
^XWB(8994,3373,3,2,0)="element."
^XWB(8994,3373,3,3,0)="        "
^XWB(8994,3373,3,4,0)="SUCCESS : localArray(n) = FIELD NAME^ARRAY IENS^DATA^1 "
^XWB(8994,3373,3,5,0)="  1 equals successful update to the database of the specific"
^XWB(8994,3373,3,6,0)="  field declared at field label.  "
^XWB(8994,3373,3,7,0)="          "
^XWB(8994,3373,3,8,0)="FAILED  : localArray(n)=""FIELD NAME^ARRAY IENS^DATA^99^exception message"""
^XWB(8994,3373,3,9,0)="  99 means an exception and no update was made to the database for that"
^XWB(8994,3373,3,10,0)="  specific field and exception message describes the error."
^XWB(8994,3374,0)="VPS WRITE KIOSK PARAMETERS^WRITE^VPSPARAM^2^R^0^^1"
^XWB(8994,3374,1,0)="^^23^23^3150501^"
^XWB(8994,3374,1,1,0)="Called by the VetLink Kiosk system. This RPC will accept three input"
^XWB(8994,3374,1,2,0)="parameters and will return result output when processing complete. The"
^XWB(8994,3374,1,3,0)="input parameters are Kiosk Group (literal value) and the changed "
^XWB(8994,3374,1,4,0)="configuration values (array)"
^XWB(8994,3374,1,5,0)=" "
^XWB(8994,3374,1,6,0)="Kiosk Group: when an administrator of VetLink Kiosk is making any Kiosk"
^XWB(8994,3374,1,7,0)="             configuration changes, he/she is making changes for a Kiosk Group."
^XWB(8994,3374,1,8,0)="Each element in the array is constructed as:"
^XWB(8994,3374,1,9,0)="        array(n)  = field label^field value"
^XWB(8994,3374,1,10,0)="        where      n           : an incremental number that acts as an index"
^XWB(8994,3374,1,11,0)="                   field label : the name of VistA Field Name"
^XWB(8994,3374,1,12,0)="                   field value : the parameter value to be stored in VistA"
^XWB(8994,3374,1,13,0)=" "
^XWB(8994,3374,1,14,0)="The output result has similar array structure as the array(n) with an addition"
^XWB(8994,3374,1,15,0)="of the result code and potential exception message"
^XWB(8994,3374,1,16,0)="Successful output structure is constructed as:"
^XWB(8994,3374,1,17,0)="       output(n)  = field label^field value^1"
^XWB(8994,3374,1,18,0)="                    value '1' at the end indicates the field value was stored "
^XWB(8994,3374,1,19,0)="                    successfully"
^XWB(8994,3374,1,20,0)="Failed output structure is constructed as:"
^XWB(8994,3374,1,21,0)="       output(n)  = field label^field value^99^exception message"
^XWB(8994,3374,1,22,0)="                    value '99' at the end indicates either field label doesn't"
^XWB(8994,3374,1,23,0)="                    exist in VistA or the field value is invalid."
^XWB(8994,3374,2,0)="^8994.02A^3^3"
^XWB(8994,3374,2,1,0)="PARAMNAM^1^30^1^2"
^XWB(8994,3374,2,1,1,0)="^8994.021^2^2^3130104^^^^"
^XWB(8994,3374,2,1,1,1,0)="When An Administrator of VetLink Kiosk system made any"
^XWB(8994,3374,2,1,1,2,0)="configuration changes, the changes were made against this Kiosk Group or Clinic"
^XWB(8994,3374,2,2,0)="PARAMETERS^2^^^3"
^XWB(8994,3374,2,2,1,0)="^8994.021^7^7^3130104^^^^"
^XWB(8994,3374,2,2,1,1,0)="A subscripted array that represents the list of parameter changes to "
^XWB(8994,3374,2,2,1,2,0)="the VetLink's Kiosk Configuration."
^XWB(8994,3374,2,2,1,3,0)="Each element in the subscripted array is constructed as:"
^XWB(8994,3374,2,2,1,4,0)="PARAMETERS(n) = field label^field value"
^XWB(8994,3374,2,2,1,5,0)="        where   n           : an incremental number that acts as an index"
^XWB(8994,3374,2,2,1,6,0)="                field label : the name of VistA Field Name"
^XWB(8994,3374,2,2,1,7,0)="                field value : the parameter value to be stored in VistA"
^XWB(8994,3374,2,3,0)="PARAMTYP^1^1^1^1"
^XWB(8994,3374,2,3,1,0)="^8994.021^1^1^3150213^^^"
^XWB(8994,3374,2,3,1,1,0)="This parameter contains either 'K' for KIOSK GROUP or 'C' for CLINIC."
^XWB(8994,3374,2,"B","PARAMETERS",2)=""
^XWB(8994,3374,2,"B","PARAMNAM",1)=""
^XWB(8994,3374,2,"B","PARAMTYP",3)=""
^XWB(8994,3374,2,"PARAMSEQ",1,3)=""
^XWB(8994,3374,2,"PARAMSEQ",2,1)=""
^XWB(8994,3374,2,"PARAMSEQ",3,2)=""
^XWB(8994,3375,0)="VPS GET MRAR PDO^GET^VPSPDO1^4^R^0^^1"
^XWB(8994,3375,1,0)="^8994.01^6^6^3150213^^^^"
^XWB(8994,3375,1,1,0)="Software that supports this procedure will build a global array with each "
^XWB(8994,3375,1,2,0)="subscript in the array assigned a line of text representing clinical data "
^XWB(8994,3375,1,3,0)="(allergy and medications) associated with the results of a Medication "
^XWB(8994,3375,1,4,0)="Review Allergy Review with the veteran.  This is referred to as PDO output"
^XWB(8994,3375,1,5,0)="and will be presented as a note on the STAFF-FACING interface on "
^XWB(8994,3375,1,6,0)="Vetlink."
^XWB(8994,3375,2,0)="^8994.02A^2^2"
^XWB(8994,3375,2,1,0)="VPSNUM^1^30^1^1"
^XWB(8994,3375,2,1,1,0)="^8994.021^1^1^3150126^^^^"
^XWB(8994,3375,2,1,1,1,0)="Patient ID. This parameter value could be SSN, DFN, ICN, or VIC/CAC based on Patient ID Type."
^XWB(8994,3375,2,2,0)="VPSTYP^1^7^1^2"
^XWB(8994,3375,2,2,1,0)="^8994.021^1^1^3150213^^^^"
^XWB(8994,3375,2,2,1,1,0)="Patient ID Type. Valid Value is SSN, DFN, ICN, or VIC/CAC"
^XWB(8994,3375,2,"B","PTIEN",1)=""
^XWB(8994,3375,2,"B","VPSNUM",1)=""
^XWB(8994,3375,2,"B","VPSTYP",2)=""
^XWB(8994,3375,2,"PARAMSEQ",1,1)=""
^XWB(8994,3375,2,"PARAMSEQ",2,2)=""
^XWB(8994,3375,3,0)="^8994.03^3^3^3150213^^^^"
^XWB(8994,3375,3,1,0)="A global array with each subscript in the array assigned a line of text"
^XWB(8994,3375,3,2,0)="representing clinical data (allergy and medications) associated with the"
^XWB(8994,3375,3,3,0)="results of a Medication Review Allergy Review with the veteran. "
^XWB(8994,3376,0)="VPS UPDATE LAST MRAR TIU IEN^UPDATE^VPSMRARU^1^R^0"
^XWB(8994,3376,1,0)="^8994.01^4^4^3150213^^^^"
^XWB(8994,3376,1,1,0)="This RPC will update the last Allergy and Modication review (MRAR) for"
^XWB(8994,3376,1,2,0)="a patient with TIU Document IEN."
^XWB(8994,3376,1,3,0)="The last MRAR is defined as the last transaction date for a patient in"
^XWB(8994,3376,1,4,0)="file 853.5 (VPS MRAR PDO)"
^XWB(8994,3376,2,0)="^8994.02A^3^3"
^XWB(8994,3376,2,1,0)="VPSNUM^1^10^1^1"
^XWB(8994,3376,2,1,1,0)="^8994.021^2^2^3150213^^"
^XWB(8994,3376,2,1,1,1,0)="This input parameter is the patient ID of the last MRAR record to be "
^XWB(8994,3376,2,1,1,2,0)="updated. Patient ID could be value of DFN, ICN, SSN, or VIC/CAC."
^XWB(8994,3376,2,2,0)="VPSTIEN^1^10^1^3"
^XWB(8994,3376,2,2,1,0)="^8994.021^3^3^3150213^^^^"
^XWB(8994,3376,2,2,1,1,0)="This input parameter is the TIU Document IEN which is the value to store "
^XWB(8994,3376,2,2,1,2,0)="in the TIU NOTE IEN field of the last MRAR record for the patient in VPS"
^XWB(8994,3376,2,2,1,3,0)="MRAR PDO File (#853.5)."
^XWB(8994,3376,2,3,0)="VPSTYP^1^7^1^2"
^XWB(8994,3376,2,3,1,0)="^8994.021^2^2^3150213^^"
^XWB(8994,3376,2,3,1,1,0)="This input parameter is the Patient Type. Valid Value is DFN, SSN, "
^XWB(8994,3376,2,3,1,2,0)="VIC/CAC, or ICN"
^XWB(8994,3376,2,"B","VPSNUM",1)=""
^XWB(8994,3376,2,"B","VPSTIEN",2)=""
^XWB(8994,3376,2,"B","VPSTYP",3)=""
^XWB(8994,3376,2,"PARAMSEQ",1,1)=""
^XWB(8994,3376,2,"PARAMSEQ",2,3)=""
^XWB(8994,3376,2,"PARAMSEQ",3,2)=""
^XWB(8994,3377,0)="VPS GET LAST MRAR^GET^VPSMRAR9^2^R"
^XWB(8994,3377,1,0)="^^2^2^3150129^"
^XWB(8994,3377,1,1,0)="Given Patient ID (in ID/Type pair), this RPC return the last Medication "
^XWB(8994,3377,1,2,0)="and Allergy Review data for the patient."
^XWB(8994,3377,2,0)="^8994.02A^2^2"
^XWB(8994,3377,2,1,0)="VPSNUM^1^30^1^1"
^XWB(8994,3377,2,1,1,0)="^^4^4^3150129^"
^XWB(8994,3377,2,1,1,1,0)="This is the Patient ID based on Patient ID Type. The value could be "
^XWB(8994,3377,2,1,1,2,0)="the SSN, ICN or VIC/CAC number."
^XWB(8994,3377,2,1,1,3,0)=" "
^XWB(8994,3377,2,1,1,4,0)="ICN, DFN, or VIC/CAC"
^XWB(8994,3377,2,2,0)="VPSTYP^1^7^1^2"
^XWB(8994,3377,2,2,1,0)="^8994.021^1^1^3150129^^"
^XWB(8994,3377,2,2,1,1,0)="This is the Patient ID Type. Valid type is DFN, SSN, ICN, or VIC/CAC."
^XWB(8994,3377,2,"B","VPSNUM",1)=""
^XWB(8994,3377,2,"B","VPSTYP",2)=""
^XWB(8994,3377,2,"PARAMSEQ",1,1)=""
^XWB(8994,3377,2,"PARAMSEQ",2,2)=""
^XWB(8994,3377,3,0)="^8994.03^2^2^3150129^^"
^XWB(8994,3377,3,1,0)="This RPC will return the last Medication and Allergy Review for the "
^XWB(8994,3377,3,2,0)="patient."
^XWB(8994,3378,0)="DENTVX2 GETWP^GETWP^DENTVX2^2^A^^^1"
^XWB(8994,3378,1,0)="^8994.01^3^3^3131011^^"
^XWB(8994,3378,1,1,0)="This RPC takes in an entity, parameter name, and instance number and "
^XWB(8994,3378,1,2,0)="returns the word processing information for the given instance of the "
^XWB(8994,3378,1,3,0)="parameter."
^XWB(8994,3378,2,0)="^8994.02A^3^3"
^XWB(8994,3378,2,1,0)="ENT^1^30^1^1"
^XWB(8994,3378,2,1,1,0)="^^2^2^3131011^"
^XWB(8994,3378,2,1,1,1,0)="Entity Name"
^XWB(8994,3378,2,1,1,2,0)="   SYS = System"
^XWB(8994,3378,2,2,0)="PAR^1^30^1^2"
^XWB(8994,3378,2,2,1,0)="^^2^2^3131011^"
^XWB(8994,3378,2,2,1,1,0)="The name of the stored parameter from which you wish to obtain word "
^XWB(8994,3378,2,2,1,2,0)="processing fields."
^XWB(8994,3378,2,3,0)="INST^1^30^0^3"
^XWB(8994,3378,2,3,1,0)="^^3^3^3131011^"
^XWB(8994,3378,2,3,1,1,0)="This is the instance of the parameter you wish to return."
^XWB(8994,3378,2,3,1,2,0)=" "
^XWB(8994,3378,2,3,1,3,0)="If no value is passed, it will default to 1."
^XWB(8994,3378,2,"B","ENT",1)=""
^XWB(8994,3378,2,"B","INST",3)=""
^XWB(8994,3378,2,"B","PAR",2)=""
^XWB(8994,3378,2,"PARAMSEQ",1,1)=""
^XWB(8994,3378,2,"PARAMSEQ",2,2)=""
^XWB(8994,3378,2,"PARAMSEQ",3,3)=""
^XWB(8994,3378,3,0)="^8994.03^8^8^3131011^^"
^XWB(8994,3378,3,1,0)="Returns an array List[n]."
^XWB(8994,3378,3,2,0)=" "
^XWB(8994,3378,3,3,0)="The format of the returned array will be as follows:"
^XWB(8994,3378,3,4,0)="  List[n] = Word processing text"
^XWB(8994,3378,3,5,0)=" "
^XWB(8994,3378,3,6,0)="If nothing is found, the return will be List[n] = 0^No data."
^XWB(8994,3378,3,7,0)=" "
^XWB(8994,3378,3,8,0)="If an error occurs, the return will be List[n] = -1^message."
^XWB(8994,3379,0)="DENTVX2 FILEWP^FILEWP^DENTVX2^1^A^^^1"
^XWB(8994,3379,1,0)="^8994.01^2^2^3140408^^"
^XWB(8994,3379,1,1,0)="This RPC takes in an entity, parameter name, instance number, and the "
^XWB(8994,3379,1,2,0)="data to be filed.  "
^XWB(8994,3379,2,0)="^8994.02A^4^4"
^XWB(8994,3379,2,1,0)="ENT^1^3^1^1"
^XWB(8994,3379,2,1,1,0)="^^1^1^3140408^"
^XWB(8994,3379,2,1,1,1,0)="Entity you wish to assign this Word Processing parameter to."
^XWB(8994,3379,2,2,0)="PAR^1^250^1^2"
^XWB(8994,3379,2,2,1,0)="^^1^1^3140408^"
^XWB(8994,3379,2,2,1,1,0)="The word processing parameter you wish to file."
^XWB(8994,3379,2,3,0)="INST^1^3^0^3"
^XWB(8994,3379,2,3,1,0)="^^1^1^3140408^"
^XWB(8994,3379,2,3,1,1,0)="Instance value of the filed parameter."
^XWB(8994,3379,2,4,0)="DATA^2^250^1^4"
^XWB(8994,3379,2,4,1,0)="^^1^1^3140408^"
^XWB(8994,3379,2,4,1,1,0)="This is an array which contains the data to be stored in the parameter."
^XWB(8994,3379,2,"B","DATA",4)=""
^XWB(8994,3379,2,"B","ENT",1)=""
^XWB(8994,3379,2,"B","INST",3)=""
^XWB(8994,3379,2,"B","PAR",2)=""
^XWB(8994,3379,2,"PARAMSEQ",1,1)=""
^XWB(8994,3379,2,"PARAMSEQ",2,2)=""
^XWB(8994,3379,2,"PARAMSEQ",3,3)=""
^XWB(8994,3379,2,"PARAMSEQ",4,4)=""
^XWB(8994,3379,3,0)="^^2^2^3140408^"
^XWB(8994,3379,3,1,0)="If successful, the return will be 1^Success."
^XWB(8994,3379,3,2,0)="If unsuccessful, the return will be -1^error message."
^XWB(8994,3380,0)="DENTVGUI VERSION GET^VERSION^DENTVGUI^1^A"
^XWB(8994,3380,1,0)="^^2^2^3131031^"
^XWB(8994,3380,1,1,0)="This is an RPC which returns the current valid DRM Plus GUI version and "
^XWB(8994,3380,1,2,0)="the current valid KID patch number."
^XWB(8994,3380,3,0)="^^6^6^3131031^"
^XWB(8994,3380,3,1,0)="The result will be returned as a single value List[1]."
^XWB(8994,3380,3,2,0)=" "
^XWB(8994,3380,3,3,0)="The value will be returned in the following format:"
^XWB(8994,3380,3,4,0)="  List[1] = p1^p2"
^XWB(8994,3380,3,5,0)="    p1 = GUI Version"
^XWB(8994,3380,3,6,0)="    p2 = KID Build"
^XWB(8994,3381,0)="DENTVICD ACTICD^ACTICD^DENTVICD^1^A^^^1"
^XWB(8994,3381,1,0)="^^1^1^3131205^"
^XWB(8994,3381,1,1,0)="Verify that an ICD code is active as of a certain date"
^XWB(8994,3381,2,0)="^8994.02A^4^4"
^XWB(8994,3381,2,1,0)="VICD^1^7^1^1"
^XWB(8994,3381,2,1,1,0)="^^1^1^3131205^"
^XWB(8994,3381,2,1,1,1,0)="This is the IEN or .01 field value from the DIAGNOSIS file (#80 - ^ICD9)"
^XWB(8994,3381,2,2,0)="CDT^1^14^0^2"
^XWB(8994,3381,2,2,1,0)="^^3^3^3131205^"
^XWB(8994,3381,2,2,1,1,0)="This date will be sued to check if the code was active as of that date."
^XWB(8994,3381,2,2,1,2,0)=" "
^XWB(8994,3381,2,2,1,3,0)="Default is today."
^XWB(8994,3381,2,3,0)="FUN^1^1^0^3"
^XWB(8994,3381,2,3,1,0)="^^3^3^3131205^"
^XWB(8994,3381,2,3,1,1,0)="This flag will allow for the RPC to be used as an intrensic function."
^XWB(8994,3381,2,3,1,2,0)=" "
^XWB(8994,3381,2,3,1,3,0)="This value is not needed for GUI calls."
^XWB(8994,3381,2,4,0)="SYS^1^2^0^4"
^XWB(8994,3381,2,4,1,0)="^^6^6^3131205^"
^XWB(8994,3381,2,4,1,1,0)="This is the ICD coding system you wish to use."
^XWB(8994,3381,2,4,1,2,0)=" "
^XWB(8994,3381,2,4,1,3,0)="1  = ICD-9 Diagnosis"
^XWB(8994,3381,2,4,1,4,0)="2  = ICD-9 Procedure"
^XWB(8994,3381,2,4,1,5,0)="30 = ICD-10 Diagnosis (Default)"
^XWB(8994,3381,2,4,1,6,0)="31 = ICD-10 Procedure"
^XWB(8994,3381,2,"B","CDT",2)=""
^XWB(8994,3381,2,"B","FUN",3)=""
^XWB(8994,3381,2,"B","SYS",4)=""
^XWB(8994,3381,2,"B","VICD",1)=""
^XWB(8994,3381,2,"PARAMSEQ",1,1)=""
^XWB(8994,3381,2,"PARAMSEQ",2,2)=""
^XWB(8994,3381,2,"PARAMSEQ",3,3)=""
^XWB(8994,3381,2,"PARAMSEQ",4,4)=""
^XWB(8994,3381,3,0)="^^6^6^3131205^"
^XWB(8994,3381,3,1,0)="Returns a single value List[n]."
^XWB(8994,3381,3,2,0)=" "
^XWB(8994,3381,3,3,0)="If the code is active, List[n] = 1."
^XWB(8994,3381,3,4,0)="If the code is inactive, List[n] = 0^message."
^XWB(8994,3381,3,5,0)=" "
^XWB(8994,3381,3,6,0)="If an error occured, List[i] = -1^message."
^XWB(8994,3382,0)="DENTVICD ICD GET DIAG^ICD^DENTVICD^1^A^^^1"
^XWB(8994,3382,1,0)="^8994.01^1^1^3131206^^^"
^XWB(8994,3382,1,1,0)="This will return specific information for a diagnosis code"
^XWB(8994,3382,2,0)="^8994.02A^2^2"
^XWB(8994,3382,2,1,0)="VICD^1^7^1^1"
^XWB(8994,3382,2,1,1,0)="^^1^1^3131206^"
^XWB(8994,3382,2,1,1,1,0)="This is the IEN or .01 field value from the DIAGNOSIS file (#80)"
^XWB(8994,3382,2,2,0)="CDT^1^14^0^2"
^XWB(8994,3382,2,2,1,0)="^8994.021^4^4^3131206^^"
^XWB(8994,3382,2,2,1,1,0)="This is the date to be used to check if the code was active as of that "
^XWB(8994,3382,2,2,1,2,0)="date."
^XWB(8994,3382,2,2,1,3,0)=" "
^XWB(8994,3382,2,2,1,4,0)="The default value is TODAY."
^XWB(8994,3382,2,"B","CDT",2)=""
^XWB(8994,3382,2,"B","VICD",1)=""
^XWB(8994,3382,2,"PARAMSEQ",1,1)=""
^XWB(8994,3382,2,"PARAMSEQ",2,2)=""
^XWB(8994,3382,3,0)="^8994.03^19^19^3131206^^"
^XWB(8994,3382,3,1,0)="Return:"
^XWB(8994,3382,3,2,0)="  If problems encountered, -1^error message"
^XWB(8994,3382,3,3,0)="  If valid diagnosis but failed input screen, 0^message"
^XWB(8994,3382,3,4,0)="  If valid daignosis and passes input screen, p1^p2^..."
^XWB(8994,3382,3,5,0)=" "
^XWB(8994,3382,3,6,0)="  p1  = ien"
^XWB(8994,3382,3,7,0)="  p2  = code number"
^XWB(8994,3382,3,8,0)="  p3  = IDENTIFIER (#2)"
^XWB(8994,3382,3,9,0)="  p4  = DIAGNOSIS (#3)"
^XWB(8994,3382,3,10,0)="  p5  = UNACCEPTABLE AS PRINCIPAL DX (#101) (1:yes)"
^XWB(8994,3382,3,11,0)="  p6  = MAJOR DIAGNOSTIC CATEGORY ien (#5)"
^XWB(8994,3382,3,12,0)="  p7  = MDC13 (#5.5)"
^XWB(8994,3382,3,13,0)="  p8  = COMPLICATION/COMORBIDITY (#70)"
^XWB(8994,3382,3,14,0)="  p9  = ICD EXPANDED (#8)"
^XWB(8994,3382,3,15,0)="  p10 = STATUS where 0:inactive;1:active"
^XWB(8994,3382,3,16,0)="  p11 = SEX (#9.5) [M/F]          p15 = AGE LOW (#14)"
^XWB(8994,3382,3,17,0)="  p12 = INACTIVE DATE [int;ext]   p16 = AGE HIGH (#15)"
^XWB(8994,3382,3,18,0)="  p13 = MDC24 (#5.7)              p17 = ACTIVATION DATE"
^XWB(8994,3382,3,19,0)="  p14 = MDC25 (#5.9)              p18 = NOTICE OF TEXTUAL INACCURACY "
^XWB(8994,3383,0)="DENTVICD LIST^LIST^DENTVICD^4^A^^^1"
^XWB(8994,3383,1,0)="^8994.01^1^1^3140206^^^"
^XWB(8994,3383,1,1,0)="This will return a list of active ICD codes for a lookup value."
^XWB(8994,3383,2,0)="^8994.02A^1^1"
^XWB(8994,3383,2,1,0)="DENTVA^2^^1^1"
^XWB(8994,3383,2,1,1,0)="^8994.021^12^12^3140206^^^"
^XWB(8994,3383,2,1,1,1,0)="An input array ""DENTVA"" will have to be set up in following format:"
^XWB(8994,3383,2,1,1,2,0)=" "
^XWB(8994,3383,2,1,1,3,0)="  DENTVA(0) = ""LOOKUP^Value"""
^XWB(8994,3383,2,1,1,4,0)="      user input lookup value"
^XWB(8994,3383,2,1,1,5,0)="  DENTVA(1) = ""CHKSCR^Value"""
^XWB(8994,3383,2,1,1,6,0)="      If value set to ""P"", only valid ICD9 codes that are eligible to be"
^XWB(8994,3383,2,1,1,7,0)="      principle diagnosis will be returned."
^XWB(8994,3383,2,1,1,8,0)="  DENTVA(2) = ""ACTDATE^Value"" "
^XWB(8994,3383,2,1,1,9,0)="      (ACTDATE is in Fileman format, NULL dates will be set to Today)"
^XWB(8994,3383,2,1,1,10,0)="      The visit date of the ICD code."
^XWB(8994,3383,2,1,1,11,0)="  DENTVA(3) = ""MAX^Value"" (100 is the default)   "
^XWB(8994,3383,2,1,1,12,0)="      The maximum number of diagnosis you want returned."
^XWB(8994,3383,2,"B","DENTVA",1)=""
^XWB(8994,3383,2,"PARAMSEQ",1,1)=""
^XWB(8994,3383,3,0)="^^17^17^3140206^"
^XWB(8994,3383,3,1,0)="This returns a list of active diagnosis codes matching the lookup value."
^XWB(8994,3383,3,2,0)=" "
^XWB(8994,3383,3,3,0)="  For ICD-9 Lookup:"
^XWB(8994,3383,3,4,0)="    List[n] := p1^p2^p3"
^XWB(8994,3383,3,5,0)="        p1 = DIAGNOSIS IEN (#80)"
^XWB(8994,3383,3,6,0)="        p2 = ICD code"
^XWB(8994,3383,3,7,0)="        p3 = Diagnosis short description"
^XWB(8994,3383,3,8,0)=" "
^XWB(8994,3383,3,9,0)="  For ICD-10 Lookup:"
^XWB(8994,3383,3,10,0)="    List[n] := p1^p2^p3^p4^p5"
^XWB(8994,3383,3,11,0)="        p1 = DIAGNOSIS IEN (#80)"
^XWB(8994,3383,3,12,0)="        p2 = Diagnosis Code"
^XWB(8994,3383,3,13,0)="        p3 = Activation Date"
^XWB(8994,3383,3,14,0)="        p4 = # of Sub-Diagnoses"
^XWB(8994,3383,3,15,0)="        p5 = Short Description"
^XWB(8994,3383,3,16,0)=" "
^XWB(8994,3383,3,17,0)="On error or problems, List[0] = -1^message"
^XWB(8994,3384,0)="DENTVICD ICD10 ACTIVATION DATE^ICD10^DENTVICD^1^A^^^1"
^XWB(8994,3384,1,0)="^^1^1^3131206^"
^XWB(8994,3384,1,1,0)="This RPC will return the activation date of ICD-10."
^XWB(8994,3384,3,0)="^^1^1^3131206^"
^XWB(8994,3384,3,1,0)="The RPC will return a single value, List[0] = ICD-10 activation date."
^XWB(8994,3385,0)="XUS IAM ADD USER^IAMAU^XUESSO3^2^S^^^^1^^0"
^XWB(8994,3385,1,0)="^^7^7^3160225^"
^XWB(8994,3385,1,1,0)="RPC ICR #6290 - API ICR #none"
^XWB(8994,3385,1,2,0)="This restricted RPC is used exclusively by the Identity and Access "
^XWB(8994,3385,1,3,0)="Management (IAM) Provisioning application to add a user to the VistA NEW"
^XWB(8994,3385,1,4,0)="PERSON file (#200)."
^XWB(8994,3385,1,5,0)=" "
^XWB(8994,3385,1,6,0)="The XUSPF200 Security Key is required to add a user without an SSN (file"
^XWB(8994,3385,1,7,0)="#200 special privileges)."
^XWB(8994,3385,2,0)="^8994.02A^8^8"
^XWB(8994,3385,2,1,0)="NAME^1^35^1^1"
^XWB(8994,3385,2,1,1,0)="^^2^2^3150206^"
^XWB(8994,3385,2,1,1,1,0)="NAME field (#.01) in the NEW PERSON file (#200) to match the SubjectID in "
^XWB(8994,3385,2,1,1,2,0)="the user's SAML Token."
^XWB(8994,3385,2,2,0)="SECID^1^30^1^2"
^XWB(8994,3385,2,2,1,0)="^8994.021^2^2^3150210^^"
^XWB(8994,3385,2,2,1,1,0)="SECID field (#205.1) in the NEW PERSON file (#200) to match the SecID in "
^XWB(8994,3385,2,2,1,2,0)="the user's SAML Token."
^XWB(8994,3385,2,3,0)="EMAIL^1^50^0^3"
^XWB(8994,3385,2,3,1,0)="^^1^1^3150206^"
^XWB(8994,3385,2,3,1,1,0)="EMAIL field (#.151) in the NEW PERSON file (#200)."
^XWB(8994,3385,2,4,0)="ADUPN^1^50^0^4"
^XWB(8994,3385,2,4,1,0)="^^2^2^3150211^"
^XWB(8994,3385,2,4,1,1,0)="AD UPN field (#205.5) in the NEW PERSON file (#200) to match user's Active"
^XWB(8994,3385,2,4,1,2,0)="Directory UPN."
^XWB(8994,3385,2,4,2)=""
^XWB(8994,3385,2,5,0)="SSN^1^9^0^5"
^XWB(8994,3385,2,5,1,0)="^^4^4^3150206^"
^XWB(8994,3385,2,5,1,1,0)="SSN field (#9) in the NEW PERSON file (#200) to match the user's Social "
^XWB(8994,3385,2,5,1,2,0)="Security Number or Taxpayer Identification Number. While not required to "
^XWB(8994,3385,2,5,1,3,0)="provision a VistA user, not populating this field with a valid SSN could"
^XWB(8994,3385,2,5,1,4,0)="prevent access to some applications and data in VistA."
^XWB(8994,3385,2,6,0)="DOB^1^20^0^6"
^XWB(8994,3385,2,6,1,0)="^^2^2^3150206^"
^XWB(8994,3385,2,6,1,1,0)="DOB field (#5) in the NEW PERSON file (#200) to match the user's Date of "
^XWB(8994,3385,2,6,1,2,0)="Birth."
^XWB(8994,3385,2,7,0)="STATION^1^20^0^7"
^XWB(8994,3385,2,7,1,0)="^8994.021^3^3^3150210^^"
^XWB(8994,3385,2,7,1,1,0)="DIVISION field (#.01) of the DIVISION multiple (#16) in the NEW PERSON "
^XWB(8994,3385,2,7,1,2,0)="file (#200). The name of a Division that this user may sign on to. The "
^XWB(8994,3385,2,7,1,3,0)="Division should be an active treating facility."
^XWB(8994,3385,2,8,0)="AUTHCODE^1^80^1^8"
^XWB(8994,3385,2,8,1,0)="^8994.021^1^1^3150730^^^^"
^XWB(8994,3385,2,8,1,1,0)="Security Phrase for IAM Provisioning Application."
^XWB(8994,3385,2,"B","ADUPN",4)=""
^XWB(8994,3385,2,"B","AUTHCODE",8)=""
^XWB(8994,3385,2,"B","DOB",6)=""
^XWB(8994,3385,2,"B","EMAIL",3)=""
^XWB(8994,3385,2,"B","NAME",1)=""
^XWB(8994,3385,2,"B","SECID",2)=""
^XWB(8994,3385,2,"B","SSN",5)=""
^XWB(8994,3385,2,"B","STATION",7)=""
^XWB(8994,3385,2,"PARAMSEQ",1,1)=""
^XWB(8994,3385,2,"PARAMSEQ",2,2)=""
^XWB(8994,3385,2,"PARAMSEQ",3,3)=""
^XWB(8994,3385,2,"PARAMSEQ",4,4)=""
^XWB(8994,3385,2,"PARAMSEQ",5,5)=""
^XWB(8994,3385,2,"PARAMSEQ",6,6)=""
^XWB(8994,3385,2,"PARAMSEQ",7,7)=""
^XWB(8994,3385,2,"PARAMSEQ",8,8)=""
^XWB(8994,3385,3,0)="^^3^3^3150730^"
^XWB(8994,3385,3,1,0)="Fail    R(0)               = ""-1^Number of Errors"""
^XWB(8994,3385,3,2,0)="        R(1) through R(n)  = ""Error Message"""
^XWB(8994,3385,3,3,0)="Success R(0)               = ""DUZ^STATION"""
^XWB(8994,3386,0)="XUS IAM EDIT USER^IAMEU^XUESSO3^2^S^^^^1^^0"
^XWB(8994,3386,1,0)="^^11^11^3151209^"
^XWB(8994,3386,1,1,0)="RPC ICR #6291 - API ICR #none"
^XWB(8994,3386,1,2,0)="This restricted RPC is used exclusively by the Identity and Access "
^XWB(8994,3386,1,3,0)="Management (IAM) Provisioning application to edit an existing user in the"
^XWB(8994,3386,1,4,0)="VistA NEW PERSON file (#200)."
^XWB(8994,3386,1,5,0)=" "
^XWB(8994,3386,1,6,0)="The XUSHOWSSN Security Key is required to edit Personally Identifiable"
^XWB(8994,3386,1,7,0)="Information (PII) such as Social Security Number (SSN) or Date of Birth"
^XWB(8994,3386,1,8,0)="(DOB)."
^XWB(8994,3386,1,9,0)=" "
^XWB(8994,3386,1,10,0)="The XUSPF200 Security Key is required to edit a user without an SSN (file"
^XWB(8994,3386,1,11,0)="#200 special privileges)."
^XWB(8994,3386,2,0)="^8994.02A^2^2"
^XWB(8994,3386,2,1,0)="INARRY^2^240^1^1"
^XWB(8994,3386,2,1,1,0)="^^13^13^3150707^"
^XWB(8994,3386,2,1,1,1,0)="INARRY(""SECID"") = SecID (not edited, but used to identify entry to be "
^XWB(8994,3386,2,1,1,2,0)="                  edited)"
^XWB(8994,3386,2,1,1,3,0)="INARRY(""LASTNAME"") = User NAME is concatenation of ""LASTNAME,FIRSTNAME "
^XWB(8994,3386,2,1,1,4,0)="                     MIDDLENAME SUFFIX"""
^XWB(8994,3386,2,1,1,5,0)="INARRY(""FIRSTNAME"")"
^XWB(8994,3386,2,1,1,6,0)="INARRY(""MIDDLENAME"")"
^XWB(8994,3386,2,1,1,7,0)="INARRY(""SUFFIX"")"
^XWB(8994,3386,2,1,1,8,0)="INARRY(""ORGANIZATIONNAME"") = SUBJECT ORGANIZATION (Organization Name)"
^XWB(8994,3386,2,1,1,9,0)="INARRY(""ORGANIZATIONID"") = SUBJECT ORGANIZATION ID (Organization ID)"
^XWB(8994,3386,2,1,1,10,0)="INARRY(""EMAIL"") = EMAIL ADDRESS (E-mail Address)"
^XWB(8994,3386,2,1,1,11,0)="INARRY(""ADUPN"") = ADUPN (Active Directory UPN)"
^XWB(8994,3386,2,1,1,12,0)="INARRY(""SSN"") = SSN (Social Security Number) "
^XWB(8994,3386,2,1,1,13,0)="INARRY(""DOB) = DOB (Date of Birth)"
^XWB(8994,3386,2,2,0)="AUTHCODE^1^80^1^2"
^XWB(8994,3386,2,2,1,0)="^8994.021^1^1^3150629^^^^"
^XWB(8994,3386,2,2,1,1,0)="Security Phrase for IAM Provisioning Application."
^XWB(8994,3386,2,"B","AUTHCODE",2)=""
^XWB(8994,3386,2,"B","INARRY",1)=""
^XWB(8994,3386,2,"PARAMSEQ",1,1)=""
^XWB(8994,3386,2,"PARAMSEQ",2,2)=""
^XWB(8994,3386,3,0)="^^3^3^3150629^"
^XWB(8994,3386,3,1,0)="Success RES(0)=DUZ of NEW PERSON file entry that was edited"
