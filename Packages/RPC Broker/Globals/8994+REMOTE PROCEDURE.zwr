^XWB(8994,2091,3,0)="^8994.03^4^4^3051101^^^"
^XWB(8994,2091,3,1,0)="This Remote Procedure Call will return the primary IEN (DFN) in the "
^XWB(8994,2091,3,2,0)="PATIENT file (#2) along with the Integration Control Number (ICN) if"
^XWB(8994,2091,3,3,0)="available on a successful RETURN, otherwise a -1 along with a problem"
^XWB(8994,2091,3,4,0)="type and problem text."
^XWB(8994,2092,0)="XUS CCOW VAULT PARAM^CCOWPC^XUSRB4^2^R^3^^0"
^XWB(8994,2092,1,0)="^^1^1^3040504^"
^XWB(8994,2092,1,1,0)="This RPC returns a value for use with the CCOW vault."
^XWB(8994,2093,0)="XUS GET CCOW TOKEN^CCOW^XUSRB4^2^R^^^0"
^XWB(8994,2093,1,0)="^^1^1^3040504^"
^XWB(8994,2093,1,1,0)="This RPC gets a token to save in the CCOW context to aid in sign-on."
^XWB(8994,2094,0)="XUS ALLKEYS^ALLKEYS^XUSRB^4^P^^^1^1^^1"
^XWB(8994,2094,1,0)="^^5^5^3151209^"
^XWB(8994,2094,1,1,0)="RPC ICR #6287 - API ICR #3277"
^XWB(8994,2094,1,2,0)="This RPC will return all the KEYS that a user holds. If the FLAG is set to"
^XWB(8994,2094,1,3,0)="some value the list of KEYS will be screened to only be those for J2EE"
^XWB(8994,2094,1,4,0)="use. The RPC was designed for FATKAAT and KAAJEE (VistALink clients) but "
^XWB(8994,2094,1,5,0)="may be used by other applications."
^XWB(8994,2094,2,0)="^8994.02A^2^2"
^XWB(8994,2094,2,1,0)="IEN^1^10^0^1"
^XWB(8994,2094,2,1,1,0)="^8994.021^2^2^3151209^^"
^XWB(8994,2094,2,1,1,1,0)="This is the IEN or DUZ of the user in question. If not passed in the RPC"
^XWB(8994,2094,2,1,1,2,0)="will use the current DUZ."
^XWB(8994,2094,2,2,0)="FLAG^1^3^0^2"
^XWB(8994,2094,2,2,1,0)="^8994.021^1^1^3151209^^^^"
^XWB(8994,2094,2,2,1,1,0)="Not in use at this time."
