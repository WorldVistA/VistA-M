^XWB(8994,2567,2,2,1,26,0)="  IXSPEC          SPEC/SUBSPEC INDEX (44)"
^XWB(8994,2567,2,2,1,27,0)="  IXTYPE          TYPE INDEX (42)"
^XWB(8994,2567,2,2,1,28,0)="  LDESCR          LONG DESCRIPTION (11)"
