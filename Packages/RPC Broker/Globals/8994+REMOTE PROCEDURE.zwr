^XWB(8994,4376,2,5,0)="DSSOFLEX3^1^5^0^5"
^XWB(8994,4376,2,5,1,0)="^8994.021^1^1^3180813^^^"
^XWB(8994,4376,2,5,1,1,0)="Optional Flex Field"
^XWB(8994,4376,2,6,0)="DSSOLAST^1^30^0^6"
