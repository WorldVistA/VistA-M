^XWB(8994,896,2,"PARAMSEQ",4,4)=""
^XWB(8994,897,0)="DVBAB REPORT ADMISSIONS^STRT^DVBAB54^4^R^0^^1"
^XWB(8994,897,1,0)="^8994.01^2^2^3130604^^^^"
^XWB(8994,897,1,1,0)="Generates an admission report, in either standard or delimited format,"
^XWB(8994,897,1,2,0)="for the specified date range."
^XWB(8994,897,2,0)="^8994.02A^3^3"
^XWB(8994,897,2,1,0)="BDATE^1^^1^1"
^XWB(8994,897,2,1,1,0)="^8994.021^2^2^3101006^^"
^XWB(8994,897,2,1,1,1,0)="Beginning date in a date range to use for retrieving results for the "
^XWB(8994,897,2,1,1,2,0)="report."
^XWB(8994,897,2,2,0)="EDATE^1^^1^2"
^XWB(8994,897,2,2,1,0)="^8994.021^1^1^3101006^^"
^XWB(8994,897,2,2,1,1,0)="Ending date in a date range to use for retrieving results for the report."
^XWB(8994,897,2,3,0)="DVBADLMTR^1^^0^3"
^XWB(8994,897,2,3,1,0)="^8994.021^3^3^3101006^^"
^XWB(8994,897,2,3,1,1,0)="This is an optional parameter, which when defined with the final end date "
^XWB(8994,897,2,3,1,2,0)="selected in the GUI, will produce a delimited report. If this parameter "
^XWB(8994,897,2,3,1,3,0)="is undefined, null or 0 then the standard report format will be generated."
