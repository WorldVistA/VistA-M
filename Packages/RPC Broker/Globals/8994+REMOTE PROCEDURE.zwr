^XWB(8994,2888,3,1,0)=" if error found during execution"
^XWB(8994,2888,3,2,0)="   MAGRY = 0^Error message"
^XWB(8994,2888,3,3,0)=" if success"
^XWB(8994,2888,3,4,0)="   MAGRY    = 1^UID"
^XWB(8994,2889,0)="MAG3 TELEREADER READ/UNRD ADD^FILE^MAGNGMR^1^R"
^XWB(8994,2889,1,0)="^8994.01^3^3^3090819^^^"
^XWB(8994,2889,1,1,0)="Add a consult and image pointers to"
^XWB(8994,2889,1,2,0)="Unread/Read List file (#2006.5849)"
^XWB(8994,2889,1,3,0)="and DICOM GMRC TEMP LIST file (#2006.5839)"
^XWB(8994,2889,2,0)="^8994.02A^3^3"
^XWB(8994,2889,2,1,0)="MAGDA^1^^^1"
^XWB(8994,2889,2,1,1,0)="^^1^1^3090814^"
^XWB(8994,2889,2,1,1,1,0)="An image IEN in IMAGE file (#2005) - ^MAG(2005,MAGDA)"
^XWB(8994,2889,2,2,0)="MAGCNT^1^^1^2"
^XWB(8994,2889,2,2,1,0)="^^1^1^3090814^"
^XWB(8994,2889,2,2,1,1,0)="Count of new images captured"
^XWB(8994,2889,2,3,0)="MAGRIEN^1^^1^3"
^XWB(8994,2889,2,3,1,0)="^8994.021^1^1^3090819^^^"
^XWB(8994,2889,2,3,1,1,0)="a request/consult IEN in REQUEST/CONSULTATION file (#123)"
^XWB(8994,2889,2,"B","MAGCNT",2)=""
^XWB(8994,2889,2,"B","MAGDA",1)=""
^XWB(8994,2889,2,"B","MAGRIEN",3)=""
^XWB(8994,2889,2,"PARAMSEQ",1,1)=""
^XWB(8994,2889,2,"PARAMSEQ",2,2)=""
^XWB(8994,2889,2,"PARAMSEQ",3,3)=""
^XWB(8994,2889,3,0)="^8994.03^2^2^3090819^^^"
^XWB(8994,2889,3,1,0)="if error MAGRY = The first ""^"" piece is zero if error occurs. The second piece is an error message"
^XWB(8994,2889,3,2,0)="if success MAGRY = The first ""^"" piece is one and the second is update message"
^XWB(8994,2890,0)="MAG3 TR THIN CLIENT ALLOWED^TCALLOW^MAGNTLR3^1^R^0"
^XWB(8994,2890,1,0)="^^1^1^3100415^"
^XWB(8994,2890,1,1,0)="Check for thin client settings by User (DUZ)"
^XWB(8994,2890,3,0)="^^2^2^3100415^"
^XWB(8994,2890,3,1,0)=" if error MAGRY = first ""^"" piece is zero if error occurs"
^XWB(8994,2890,3,2,0)=" if success MAGRY = ""1^0|1"" - 0 - not allowed; 1 - allowed"
^XWB(8994,2891,0)="DVBAB GET SET^GETSET^DVBABDDU^2^R^^^^1"
^XWB(8994,2891,1,0)="^8994.01^2^2^3100805^^^"
^XWB(8994,2891,1,1,0)="This remote procedure retrieves the SET OF CODES for a given file and "
^XWB(8994,2891,1,2,0)="field for use in populating controls."
^XWB(8994,2891,2,0)="^8994.02A^2^2"
^XWB(8994,2891,2,1,0)="DVBFIL^1^^1^1"
^XWB(8994,2891,2,1,1,0)="^^1^1^3100805^"
^XWB(8994,2891,2,1,1,1,0)="This paramater contains a valid file number."
^XWB(8994,2891,2,2,0)="DVBFLD^1^^1^2"
^XWB(8994,2891,2,2,1,0)="^8994.021^1^1^3100805^^^"
^XWB(8994,2891,2,2,1,1,0)="This parameter contains a field in the file passed as DVBFIL."
^XWB(8994,2891,2,"B","DVBFIL",1)=""
^XWB(8994,2891,2,"B","DVBFLD",2)=""
^XWB(8994,2891,2,"PARAMSEQ",1,1)=""
^XWB(8994,2891,2,"PARAMSEQ",2,2)=""
^XWB(8994,2891,3,0)="^^12^12^3100805^"
^XWB(8994,2891,3,1,0)="The results will be returned as an array of strings, each containing the "
^XWB(8994,2891,3,2,0)="internal set of codes value and the external set of codes value delimited "
^XWB(8994,2891,3,3,0)="by a caret (""^"")."
^XWB(8994,2891,3,4,0)=" "
^XWB(8994,2891,3,5,0)="Example results:"
^XWB(8994,2891,3,6,0)="DVBRSLT(1)=""T^TERMINAL"""
^XWB(8994,2891,3,7,0)="DVBRSLT(2)=""P^POW"""
^XWB(8994,2891,3,8,0)="DVBRSLT(3)=""OS^ORIGINAL SC"""
^XWB(8994,2891,3,9,0)="DVBRSLT(4)=""ON^ORIGINAL NSC"""
^XWB(8994,2891,3,10,0)="DVBRSLT(5)=""I^INCREASE"""
^XWB(8994,2891,3,11,0)="DVBRSLT(6)=""R^REVIEW"""
^XWB(8994,2891,3,12,0)="DVBRSLT(7)=""OTR^OTHER"""
^XWB(8994,2892,0)="DSIV XPAR GET ALL FOR ENT^GET^DSIVXPR^2^A^^^1"
^XWB(8994,2892,1,0)="^8994.01^1^1^3030422^^^^"
^XWB(8994,2892,1,1,0)="This will get all instances of a parameter for an entity"
^XWB(8994,2892,2,0)="^8994.02A^1^1"
^XWB(8994,2892,2,1,0)="DATA^1^250^1^1"
^XWB(8994,2892,2,1,1,0)="^^12^12^3030422^"
^XWB(8994,2892,2,1,1,1,0)="DATA - required - p1~p2~~~~p6"
^XWB(8994,2892,2,1,1,2,0)=" p1 := optional - entity(s) - if not passed, set to ""USR"" for"
^XWB(8994,2892,2,1,1,3,0)="                  current user"
^XWB(8994,2892,2,1,1,4,0)=" p2 := required - parameter name"
^XWB(8994,2892,2,1,1,5,0)=" p6 := optional - format code determines return values"
^XWB(8994,2892,2,1,1,6,0)="       Q - internal instance, internal value"
^XWB(8994,2892,2,1,1,7,0)="       E - external instance, external value"
^XWB(8994,2892,2,1,1,8,0)="       N - external instance, internal value"
^XWB(8994,2892,2,1,1,9,0)="       B - internal & external instances and values"
^XWB(8994,2892,2,1,1,10,0)="           [default value]"
^XWB(8994,2892,2,1,1,11,0)=" "
^XWB(8994,2892,2,1,1,12,0)="Actually, p6 is ignored and is always set to B"
^XWB(8994,2892,2,"B","DATA",1)=""
^XWB(8994,2892,2,"PARAMSEQ",1,1)=""
^XWB(8994,2892,3,0)="^^7^7^3030422^"
^XWB(8994,2892,3,1,0)="Return a list of values"
^XWB(8994,2892,3,2,0)="On error return list[1] = -1^error message"
^XWB(8994,2892,3,3,0)="Else return list[n] = p1^p2^p3^p4  where n = 1,2,3,4,5,6,..."
^XWB(8994,2892,3,4,0)="     p1 = internal instance"
^XWB(8994,2892,3,5,0)="     p2 = external instance"
^XWB(8994,2892,3,6,0)="     p3 = internal value"
^XWB(8994,2892,3,7,0)="     p4 = extenral value"
^XWB(8994,2892,3,8,0)=" "
^XWB(8994,2892,3,9,0)="p1,p2,p3,p4 may be <null> depending upon the format parameter passed in "
^XWB(8994,2892,3,10,0)="the 6th piece of the DATA input variable."
^XWB(8994,2893,0)="MAG FIELD VALIDATE^DVAL^MAGQBUT4^1^R^0"
^XWB(8994,2893,1,0)="^8994.01^2^2^3100908^^^^"
^XWB(8994,2893,1,1,0)="This provides an interface with the VA Fileman Database Server (DBS)"
^XWB(8994,2893,1,2,0)="API for the single field validator: VAL^DIE."
^XWB(8994,2893,2,0)="^8994.02A^5^5"
^XWB(8994,2893,2,1,0)="FILE^1^99^1^1"
^XWB(8994,2893,2,1,1,0)="^8994.021^1^1^3100908^^"
^XWB(8994,2893,2,1,1,1,0)="This is the file number that contains the attribute to be validated."
^XWB(8994,2893,2,2,0)="IENS^1^99^1^2"
^XWB(8994,2893,2,2,1,0)="^8994.021^1^1^3100908^^"
^XWB(8994,2893,2,2,1,1,0)="This is the record number or place holder of the entry being validated."
^XWB(8994,2893,2,3,0)="FIELD^1^99^1^3"
^XWB(8994,2893,2,3,1,0)="^8994.021^1^1^3100908^^"
^XWB(8994,2893,2,3,1,1,0)="This is the number of the file attribute to be validated."
^XWB(8994,2893,2,4,0)="FLAGS^1^99^0^4"
^XWB(8994,2893,2,4,1,0)="^8994.021^13^13^3100908^^"
^XWB(8994,2893,2,4,1,1,0)="This is the option set of parameters defined for the VAL^DIE"
^XWB(8994,2893,2,4,1,2,0)="E External value is returned in RESULT(0)."
^XWB(8994,2893,2,4,1,3,0)=" "
^XWB(8994,2893,2,4,1,4,0)="F FDA node is set for valid data in array identified by FDA_ROOT."
^XWB(8994,2893,2,4,1,5,0)=" "
^XWB(8994,2893,2,4,1,6,0)="H Help (single ?) is returned if VALUE is not valid."
^XWB(8994,2893,2,4,1,7,0)=" "
^XWB(8994,2893,2,4,1,8,0)="R Record identified by IENS is verified to exist and to be editable. Do"
^XWB(8994,2893,2,4,1,9,0)="not  include ""R"" if there are placeholders in the IENS."
^XWB(8994,2893,2,4,1,10,0)=" "
^XWB(8994,2893,2,4,1,11,0)="U Don't perform key validation. Without this flag, the data in VALUE is"
^XWB(8994,2893,2,4,1,12,0)="checked to ensure that no duplicate keys are created and that key field "
^XWB(8994,2893,2,4,1,13,0)="values are not deleted."
^XWB(8994,2893,2,5,0)="VALUE^1^99^1^5"
^XWB(8994,2893,2,5,1,0)="^8994.021^1^1^3100908^^^^"
^XWB(8994,2893,2,5,1,1,0)="This is the value to be validated."
^XWB(8994,2893,2,"B","FIELD",3)=""
^XWB(8994,2893,2,"B","FILE",1)=""
^XWB(8994,2893,2,"B","FLAGS",4)=""
^XWB(8994,2893,2,"B","IENS",2)=""
^XWB(8994,2893,2,"B","VALUE",5)=""
^XWB(8994,2893,2,"PARAMSEQ",1,1)=""
^XWB(8994,2893,2,"PARAMSEQ",2,2)=""
^XWB(8994,2893,2,"PARAMSEQ",3,3)=""
^XWB(8994,2893,2,"PARAMSEQ",4,4)=""
^XWB(8994,2893,2,"PARAMSEQ",5,5)=""
^XWB(8994,2893,3,0)="^8994.03^14^14^3100908^^^^"
^XWB(8994,2893,3,1,0)="It returns the resolved external value or -1 followed by the carat "
^XWB(8994,2893,3,2,0)="delimiter and one of the following error messages:"
^XWB(8994,2893,3,3,0)=" "
^XWB(8994,2893,3,4,0)="120 Error occurred during execution of a FileMan hook."
^XWB(8994,2893,3,5,0)="299 Ambiguous value. (Variable Pointer data type only.)"
^XWB(8994,2893,3,6,0)="405 The file is uneditable."
^XWB(8994,2893,3,7,0)="520 The field's data type or INPUT transform is inappropriate."
^XWB(8994,2893,3,8,0)="602 The entry cannot be edited."
^XWB(8994,2893,3,9,0)="701 Value is invalid."
^XWB(8994,2893,3,10,0)="710 The field is uneditable."
^XWB(8994,2893,3,11,0)="712 An inappropriate deletion of a field's value is being attempted."
^XWB(8994,2893,3,12,0)="740 A duplicate key is produced by a field's new value."
^XWB(8994,2893,3,13,0)="742 A value for a field in a key is being deleted."
^XWB(8994,2893,3,14,0)="1610 Help was improperly requested."
^XWB(8994,2894,0)="MAG KEY VALIDATE^KVAL^MAGQBUT4^1^R^0"
^XWB(8994,2894,1,0)="^^8^8^3100326^"
^XWB(8994,2894,1,1,0)="This is a an interface to the Database Server (DBS) utility:"
^XWB(8994,2894,1,2,0)="Key Validator"
^XWB(8994,2894,1,3,0)=" "
^XWB(8994,2894,1,4,0)="The Key Validator extrinsic function verifies that new values contained "
^XWB(8994,2894,1,5,0)="in the FDA do not produce an invalid key. All keys in which any field in "
^XWB(8994,2894,1,6,0)="the FDA participates are checked. If the value for a field in a key being "
^XWB(8994,2894,1,7,0)="checked is not present in the FDA, the value used to verify the key is "
^XWB(8994,2894,1,8,0)="obtained from the previously filed data."
^XWB(8994,2894,2,0)="^8994.02A^2^2"
^XWB(8994,2894,2,1,0)="FLAGS^1^9^0^1"
^XWB(8994,2894,2,1,1,0)="^^3^3^3100326^"
^XWB(8994,2894,2,1,1,1,0)="(Optional) Flags to control processing. The possible values are:"
^XWB(8994,2894,2,1,1,2,0)=" "
^XWB(8994,2894,2,1,1,3,0)="Q  Quit when the first problem in the FDA is encountered."
^XWB(8994,2894,2,2,0)="FDA^2^99^1^2"
^XWB(8994,2894,2,2,1,0)="^^7^7^3100326^"
^XWB(8994,2894,2,2,1,1,0)="The root of the FDA that contains the data to be checked. The array can "
^XWB(8994,2894,2,2,1,2,0)="be a local or global one. See the Database Server Introduction for "
^XWB(8994,2894,2,2,1,3,0)="details of the structure of the FDA."
^XWB(8994,2894,2,2,1,4,0)="The value of fields in the FDA must be the internal value. Do not pass "
^XWB(8994,2894,2,2,1,5,0)="external (e.g., unresolved pointer values, non-FileMan dates) in the FDA."
^XWB(8994,2894,2,2,1,6,0)="No action is taken on fields in the referenced FDA if those fields do not "
^XWB(8994,2894,2,2,1,7,0)="participate in a Key defined in the KEY file."
^XWB(8994,2894,2,"B","FDA",2)=""
^XWB(8994,2894,2,"B","FLAGS",1)=""
^XWB(8994,2894,2,"PARAMSEQ",1,1)=""
^XWB(8994,2894,2,"PARAMSEQ",2,2)=""
^XWB(8994,2894,3,0)="^^8^8^3100326^"
^XWB(8994,2894,3,1,0)="This Boolean function returns a 1 if key integrity is not violated by any "
^XWB(8994,2894,3,2,0)="value in the FDA and a -1 followed by a carat delimiter and an error "
^XWB(8994,2894,3,3,0)="message describing the nature of an invalid key that  was produced by any"
^XWB(8994,2894,3,4,0)="of the values. "
^XWB(8994,2894,3,5,0)=" "
^XWB(8994,2894,3,6,0)="740 A duplicate key is produced by a field's new value."
^XWB(8994,2894,3,7,0)="742 A value for a field in a key is being deleted."
^XWB(8994,2894,3,8,0)="744 Not all fields in a key have a value."
^XWB(8994,2895,0)="MAGQ ADD RAID GROUP^ADDRG^MAGQBUT5^1^R"
