^XWB(8994,4556,1,1,0)="Dispositioning/closing an appointment request"
^XWB(8994,4556,1,2,0)=" "
^XWB(8994,4556,1,3,0)="Can only be invoked by Acheron"
^XWB(8994,4556,2,0)="^8994.02A^7^6"
