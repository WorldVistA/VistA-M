^XWB(8994,2563,1,14,0)="  +---------------------------------------------------------------+"
^XWB(8994,2563,1,15,0)="Imaging Vistarad RPC for displaying internal Imaging data"
^XWB(8994,2563,2,0)="^8994.02A^1^1"
^XWB(8994,2563,2,1,0)="DATA^1^256^1^1"
^XWB(8994,2563,2,1,1,0)="^8994.021^10^10^3090420^^^^"
^XWB(8994,2563,2,1,1,1,0)="'DATA' HAS THE FOLLOWING STRUCTURE: ""REQUEST^PARAM1|PARAM2"""
^XWB(8994,2563,2,1,1,2,0)="   'REQUEST' IS REQUIRED AND MUST BE A MEMBER OF ""CPT,FLDS,GLB""."
^XWB(8994,2563,2,1,1,3,0)="      'PARAM1' IS REQUIRED TO HOLD A CPT CODE IFF 'REQUEST'=""CPT""."
^XWB(8994,2563,2,1,1,4,0)="      'PARAM1' IS OPTIONAL TO HOLD FILEMAN FLAGS IFF 'REQUEST'=""FLDS""."
^XWB(8994,2563,2,1,1,5,0)="      'PARAM2' IS NOT USED IFF 'REQUEST'=""CPT""."
^XWB(8994,2563,2,1,1,6,0)="      'PARAM2' IS REQUIRED IF 'REQUEST'=""FLDS"" OR 'REQUEST'=""GLB""."
^XWB(8994,2563,2,1,1,7,0)="         IN EITHER CASE, 'PARAM2' MAY HOLD:"
^XWB(8994,2563,2,1,1,8,0)="           AN INTEGER REPRESENTING THE IMAGE IEN, OR"
^XWB(8994,2563,2,1,1,9,0)="           A CARET-DELIMITED 3 PIECE PARTIAL CASE/EXAM ID STRING, OR"
^XWB(8994,2563,2,1,1,10,0)="           A CARET-DELIMITED 4 PIECE COMPLETE CASE/EXAM ID STRING."
^XWB(8994,2563,2,"B","DATA",1)=""
^XWB(8994,2563,2,"PARAMSEQ",1,1)=""
^XWB(8994,2563,3,0)="^8994.03^4^4^3090420^^^^"
^XWB(8994,2563,3,1,0)="THIS RPC RETURNS 1:N TEXT LINES, PER INPUT REQUEST:"
^XWB(8994,2563,3,2,0)="  'CPT' : CPT DESCRIPTION, BODY PART, MODALITY AND MATCHING CPTS."
^XWB(8994,2563,3,3,0)="  'FLDS': A LISTING OF ^MAG(2005, FIELDS FOR A PROVIDED IMAGE IEN."
^XWB(8994,2563,3,4,0)="  'GLB' : A LISTING OF THE ^MAG(2005, ""RAW"" GLOBAL DATA."
^XWB(8994,2564,0)="MAGG REASON LIST^LSTRSNS^MAGGA01^4^R^^^1"
^XWB(8994,2564,1,0)="^8994.01^2^2^3080728^^^^"
^XWB(8994,2564,1,1,0)="This remote procedure returns the list of reasons for actions performed on"
^XWB(8994,2564,1,2,0)="images. This data is loaded from the MAG REASON file (#2005.88)."
^XWB(8994,2564,2,0)="^8994.02A^3^3"
^XWB(8994,2564,2,1,0)="TYPE^1^^1^1"
^XWB(8994,2564,2,1,1,0)="^^14^14^3080717^"
^XWB(8994,2564,2,1,1,1,0)="This parameter defines the type(s) of reasons that are returned by the "
^XWB(8994,2564,2,1,1,2,0)="remote procedure. Its value should consist of one or more of the following"
^XWB(8994,2564,2,1,1,3,0)="characters:"
^XWB(8994,2564,2,1,1,4,0)=" "
^XWB(8994,2564,2,1,1,5,0)="  C  Reasons for copying images"
^XWB(8994,2564,2,1,1,6,0)=" "
^XWB(8994,2564,2,1,1,7,0)="  D  Reasons for deleting images"
^XWB(8994,2564,2,1,1,8,0)=" "
^XWB(8994,2564,2,1,1,9,0)="  P  Reasons for printing images"
^XWB(8994,2564,2,1,1,10,0)=" "
^XWB(8994,2564,2,1,1,11,0)="  S  Reasons for changing image status"
^XWB(8994,2564,2,1,1,12,0)=" "
^XWB(8994,2564,2,1,1,13,0)="For example, if the ""CD"" value is assigned to the parameter, the RPC"
^XWB(8994,2564,2,1,1,14,0)="returns the reasons for copying and deleting images."
^XWB(8994,2564,2,2,0)="FLAGS^1^^^2"
^XWB(8994,2564,2,2,1,0)="^^8^8^3080229^"
^XWB(8994,2564,2,2,1,1,0)="Flags that control execution (can be combined):"
^XWB(8994,2564,2,2,1,2,0)=" "
^XWB(8994,2564,2,2,1,3,0)="  F  Include full details (description text, etc.)"
^XWB(8994,2564,2,2,1,4,0)=" "
^XWB(8994,2564,2,2,1,5,0)="  I  Include inactivated reasons"
^XWB(8994,2564,2,2,1,6,0)=" "
^XWB(8994,2564,2,2,1,7,0)="If this parameter is not defined or empty, only the summary data for"
^XWB(8994,2564,2,2,1,8,0)="currently active reasons is returned."
^XWB(8994,2564,2,3,0)="PART^1^^^3"
^XWB(8994,2564,2,3,1,0)="^8994.021^6^6^3080728^^^^"
^XWB(8994,2564,2,3,1,1,0)="The partial match restriction (case sensitive). For example, a PART value"
^XWB(8994,2564,2,3,1,2,0)="of ""ZZ"" would restrict the list to those entries starting with the letters"
^XWB(8994,2564,2,3,1,3,0)="""ZZ""."
^XWB(8994,2564,2,3,1,4,0)=" "
^XWB(8994,2564,2,3,1,5,0)="If this parameter is not defined or empty, no text restrictions are "
^XWB(8994,2564,2,3,1,6,0)="applied."
^XWB(8994,2564,2,"B","FLAGS",2)=""
^XWB(8994,2564,2,"B","PART",3)=""
^XWB(8994,2564,2,"B","TYPE",1)=""
^XWB(8994,2564,2,"PARAMSEQ",1,1)=""
^XWB(8994,2564,2,"PARAMSEQ",2,2)=""
^XWB(8994,2564,2,"PARAMSEQ",3,3)=""
^XWB(8994,2564,3,0)="^^47^47^3080728^"
^XWB(8994,2564,3,1,0)="Zero value of the first '^'-piece of the Results[0] indicates that an"
^XWB(8994,2564,3,2,0)="error occurred during the execution of the procedure. In this case, the"
^XWB(8994,2564,3,3,0)="errors are returned in the Results array as shown below:"
^XWB(8994,2564,3,4,0)="  "
^XWB(8994,2564,3,5,0)="  Results[0]            Result descriptor"
^XWB(8994,2564,3,6,0)="                          ^01: 0"
^XWB(8994,2564,3,7,0)="                          ^02: Message"
^XWB(8994,2564,3,8,0)="  "
^XWB(8994,2564,3,9,0)="  Results[i]            Error descriptor"
^XWB(8994,2564,3,10,0)="                          ^01: Error code"
^XWB(8994,2564,3,11,0)="                          ^02: Message"
^XWB(8994,2564,3,12,0)="                          ^03: Error location"
^XWB(8994,2564,3,13,0)="                          ^04: Message type"
^XWB(8994,2564,3,14,0)=" "
^XWB(8994,2564,3,15,0)="  Results[j]            Line of the additional info (optional)"
^XWB(8994,2564,3,16,0)="                          ^01: """""
^XWB(8994,2564,3,17,0)="                          ^02: Text"
^XWB(8994,2564,3,18,0)=" "
^XWB(8994,2564,3,19,0)="Otherwise, the Results[0] contains '1^OK' and the list of reasons is"
^XWB(8994,2564,3,20,0)="returned in the subsequent elements of the Results array as follows:"
^XWB(8994,2564,3,21,0)=" "
^XWB(8994,2564,3,22,0)="  Results[i]            Reason summary"
^XWB(8994,2564,3,23,0)="                          ^01: IEN of the reason (file #2005.88)"
^XWB(8994,2564,3,24,0)="                          ^02: Text of the reason"
^XWB(8994,2564,3,25,0)="                          ^03: Types of the reason (combination of ""C"","
^XWB(8994,2564,3,26,0)="                               ""D"", ""P"", and/or ""S"")"
^XWB(8994,2564,3,27,0)="                          ^04: Date of inactivation (FileMan). "
^XWB(8994,2564,3,28,0)="                               This piece is always empty if the value"
^XWB(8994,2564,3,29,0)="                               of the FLAGS parameter does not contain"
^XWB(8994,2564,3,30,0)="                               ""I"". Otherwise, a date in internal FileMan"
^XWB(8994,2564,3,31,0)="                               format is returned here for inactivated"
^XWB(8994,2564,3,32,0)="                               reasons."
^XWB(8994,2564,3,33,0)="                          ^05: Unique code of the reason (only for "
^XWB(8994,2564,3,34,0)="                               standard reasons distributed nationally;"
^XWB(8994,2564,3,35,0)="                               reasons defined by the sites do not have"
^XWB(8994,2564,3,36,0)="                               codes).                        "
^XWB(8994,2564,3,37,0)=" "
^XWB(8994,2564,3,38,0)="  Results[i+j]          Line of the description of the reason (optional)"
^XWB(8994,2564,3,39,0)="                          ^01: ""D"""
^XWB(8994,2564,3,40,0)="                          ^02: Text line"
^XWB(8994,2564,3,41,0)=" "
^XWB(8994,2564,3,42,0)="                        The description text is returned only if the"
^XWB(8994,2564,3,43,0)="                        value of the FLAGS parameter contains ""F"" and "
^XWB(8994,2564,3,44,0)="                        the DESCRIPTION field (1) of the MAG REASON file"
^XWB(8994,2564,3,45,0)="                        (#2005.88) is not empty."
^XWB(8994,2564,3,46,0)=" "
^XWB(8994,2564,3,47,0)="The reasons are sorted alphabetically (case sensitive)."
^XWB(8994,2565,0)="MAG4 IMAGE LIST^GETIMGS^MAGSIXG1^2^R^^^1"
^XWB(8994,2565,1,0)="^8994.01^2^2^3101022^^^^"
^XWB(8994,2565,1,1,0)="This remote procedure returns information about images that conform to "
^XWB(8994,2565,1,2,0)="the provided criteria."
^XWB(8994,2565,2,0)="^8994.02A^6^5"
^XWB(8994,2565,2,2,0)="FLAGS^1^^1^1"
^XWB(8994,2565,2,2,1,0)="^^53^53^3240221^"
^XWB(8994,2565,2,2,1,1,0)="Flags that control the execution (can be combined):"
^XWB(8994,2565,2,2,1,2,0)=" "
^XWB(8994,2565,2,2,1,3,0)="  C  Capture date range. If this flag is provided, then the"
^XWB(8994,2565,2,2,1,4,0)="     remote procedure uses values of the FROMDATE and TODATE"
^XWB(8994,2565,2,2,1,5,0)="     parameters to select images that were captured in this"
^XWB(8994,2565,2,2,1,6,0)="     date range (see the DATE/TIME IMAGE SAVED field (7) and"
^XWB(8994,2565,2,2,1,7,0)="     the ""AD"" cross-reference)."
^XWB(8994,2565,2,2,1,8,0)=" "
^XWB(8994,2565,2,2,1,9,0)="     Otherwise, values of those parameters are treated as "
^XWB(8994,2565,2,2,1,10,0)="     the date range when procedures were performed (see the"
^XWB(8994,2565,2,2,1,11,0)="     PROCEDURE/EXAM DATE/TIME field (15) and cross-references "
^XWB(8994,2565,2,2,1,12,0)="     ""APDTPX"" and ""APDT"")."
^XWB(8994,2565,2,2,1,13,0)=" "
^XWB(8994,2565,2,2,1,14,0)="  D  Include only deleted images (file #2005.1)"
^XWB(8994,2565,2,2,1,15,0)="  E  Include only existing images (file #2005)"
^XWB(8994,2565,2,2,1,16,0)=" "
^XWB(8994,2565,2,2,1,17,0)="  S  Return the sparse subset of images captured by the user"
^XWB(8994,2565,2,2,1,18,0)="     defined by the miscellaneous ""SAVEDBY"" filter parameter"
^XWB(8994,2565,2,2,1,19,0)="     (see the MISCPRMS parameter). The ""SAVEDBY"" becomes a"
^XWB(8994,2565,2,2,1,20,0)="     required parameter in this case."
^XWB(8994,2565,2,2,1,21,0)=" "
^XWB(8994,2565,2,2,1,22,0)="     Firstly, images are preselected according to the date "
^XWB(8994,2565,2,2,1,23,0)="     range and other criteria. Those of them that were captured"
^XWB(8994,2565,2,2,1,24,0)="     immediately before and after patient changes are stored to"
^XWB(8994,2565,2,2,1,25,0)="     the ""priority"" temporary buffer. The others are stored to"
^XWB(8994,2565,2,2,1,26,0)="     the regular temporary buffer."
^XWB(8994,2565,2,2,1,27,0)=" "
^XWB(8994,2565,2,2,1,28,0)="     Then, the requested maximum number of images is calculated"
^XWB(8994,2565,2,2,1,29,0)="     according to the total number of preselected entries and"
^XWB(8994,2565,2,2,1,30,0)="     the percentage value defined by the MAXNUM parameter."
^XWB(8994,2565,2,2,1,31,0)="     "
^XWB(8994,2565,2,2,1,32,0)="     If the number of entries in the ""priority"" buffer less"
^XWB(8994,2565,2,2,1,33,0)="     than the maximum number of images and the regular buffer"
^XWB(8994,2565,2,2,1,34,0)="     is not empty, then missing quantity of preselected images"
^XWB(8994,2565,2,2,1,35,0)="     is merged to the ""priority"" buffer from the regular one."
^XWB(8994,2565,2,2,1,36,0)=" "
^XWB(8994,2565,2,2,1,37,0)="     Finally, no more than maximum number of entries is copied"
^XWB(8994,2565,2,2,1,38,0)="     from the ""priority"" buffer to the remote procedure's"
^XWB(8994,2565,2,2,1,39,0)="     result array."
^XWB(8994,2565,2,2,1,40,0)="     "
^XWB(8994,2565,2,2,1,41,0)="  G  Include Group Images in the list of images returned. "
^XWB(8994,2565,2,2,1,42,0)="     If any image in a group has an image that matches the "
^XWB(8994,2565,2,2,1,43,0)="     status provided in the search criteria then "
^XWB(8994,2565,2,2,1,44,0)="     the group will be returned."
^XWB(8994,2565,2,2,1,45,0)="                  "
^XWB(8994,2565,2,2,1,46,0)="     If the G flag is not set then only the status of the "
^XWB(8994,2565,2,2,1,47,0)="     Group entry will be checked and the group will be "
^XWB(8994,2565,2,2,1,48,0)="     returned if it passes."
^XWB(8994,2565,2,2,1,49,0)=" "
^XWB(8994,2565,2,2,1,50,0)="  O  Omit non-printable and delimiter characters from SHORT DESCRIPTION"
^XWB(8994,2565,2,2,1,51,0)=" "
^XWB(8994,2565,2,2,1,52,0)="If neither 'E' nor 'D' flag is provided, then an error code (-6) is"
^XWB(8994,2565,2,2,1,53,0)="returned."
^XWB(8994,2565,2,3,0)="FROMDATE^1^^^2"
^XWB(8994,2565,2,3,1,0)="^^11^11^3081107^"
^XWB(8994,2565,2,3,1,1,0)="Beginning of the date range for image selection. Date can be in internal"
^XWB(8994,2565,2,3,1,2,0)="or external FileMan format. If the parameter is not defined or empty, then"
^XWB(8994,2565,2,3,1,3,0)="the date range remains open on this side."
^XWB(8994,2565,2,3,1,4,0)=" "
^XWB(8994,2565,2,3,1,5,0)="Depending on the value of the FLAGS parameter, the date range filter is"
^XWB(8994,2565,2,3,1,6,0)="applied either to the exam/procedure dates (PROCEDURE/EXAM DATE/TIME field"
^XWB(8994,2565,2,3,1,7,0)="(15)) or image capture dates (DATE/TIME IMAGE SAVED field (7))."
^XWB(8994,2565,2,3,1,8,0)=" "
^XWB(8994,2565,2,3,1,9,0)="Time parts of date range parameters are ignored and both ends of the date"
^XWB(8994,2565,2,3,1,10,0)="range are included in the search. For example, in order to search images"
^XWB(8994,2565,2,3,1,11,0)="for May 21, 2008, the internal value of both parameters should be 3080521."
^XWB(8994,2565,2,4,0)="TODATE^1^^^3"
^XWB(8994,2565,2,4,1,0)="^^11^11^3081107^"
^XWB(8994,2565,2,4,1,1,0)="End of the date range for image selection. Dates can be in internal or"
^XWB(8994,2565,2,4,1,2,0)="external FileMan format. If the parameter is not defined or empty, then"
^XWB(8994,2565,2,4,1,3,0)="the date range remains open on this side."
^XWB(8994,2565,2,4,1,4,0)=" "
^XWB(8994,2565,2,4,1,5,0)="Depending on the value of the FLAGS parameter, the date range filter is"
^XWB(8994,2565,2,4,1,6,0)="applied either to the exam/procedure dates (PROCEDURE/EXAM DATE/TIME field"
^XWB(8994,2565,2,4,1,7,0)="(15)) or image capture dates (DATE/TIME IMAGE SAVED field (7))."
^XWB(8994,2565,2,4,1,8,0)=" "
^XWB(8994,2565,2,4,1,9,0)="Time parts of date range parameters are ignored and both ends of the date"
^XWB(8994,2565,2,4,1,10,0)="range are included in the search. For example, in order to search images"
^XWB(8994,2565,2,4,1,11,0)="for May 21, 2008, the internal value of both parameters should be 3080521."
^XWB(8994,2565,2,5,0)="MISCPRMS^2^^^5"
^XWB(8994,2565,2,5,1,0)="^^78^78^3090126^"
^XWB(8994,2565,2,5,1,1,0)="Items of this list define various filter parameters. Each item has 3 or"
^XWB(8994,2565,2,5,1,2,0)="more pieces separated by '^':"
^XWB(8994,2565,2,5,1,3,0)=" "
^XWB(8994,2565,2,5,1,4,0)="  ^01: Parameter name"
^XWB(8994,2565,2,5,1,5,0)="  ^02: Index (for multiples and word-processing values)"
^XWB(8994,2565,2,5,1,6,0)="  ^03: Value1"
^XWB(8994,2565,2,5,1,7,0)="  ^04: Value2"
^XWB(8994,2565,2,5,1,8,0)="  ..."
^XWB(8994,2565,2,5,1,9,0)=" "
^XWB(8994,2565,2,5,1,10,0)="The following filter parameters are supported by this remote procedure:"
^XWB(8994,2565,2,5,1,11,0)=" "
^XWB(8994,2565,2,5,1,12,0)="  CAPTAPP^^{Name or Code}^{Name or Code}^..."
^XWB(8994,2565,2,5,1,13,0)="    Internal or external values of the CAPTURE APPLICATION"
^XWB(8994,2565,2,5,1,14,0)="    field (8.1) of the file #2005."
^XWB(8994,2565,2,5,1,15,0)=" "
^XWB(8994,2565,2,5,1,16,0)="  GDESC^^{Text}"
^XWB(8994,2565,2,5,1,17,0)="    Text that should be present in the SHORT DESCRIPTION"
^XWB(8994,2565,2,5,1,18,0)="    field (10) of the IMAGE file (#2005). The comparison"
^XWB(8994,2565,2,5,1,19,0)="    is case-insensitive."
^XWB(8994,2565,2,5,1,20,0)=" "
^XWB(8994,2565,2,5,1,21,0)="  IDFN^^{DFN}"
^XWB(8994,2565,2,5,1,22,0)="    Patient IEN (DFN). If this parameter is not defined, all"
^XWB(8994,2565,2,5,1,23,0)="    patients' images are considered."
^XWB(8994,2565,2,5,1,24,0)=" "
^XWB(8994,2565,2,5,1,25,0)="  ISTAT^^{Name or Code}^{Name or Code}^..."
^XWB(8994,2565,2,5,1,26,0)="    Internal or external values of the STATUS field (113)"
^XWB(8994,2565,2,5,1,27,0)="    of the file #2005. 0 (zero) code selects image records"
^XWB(8994,2565,2,5,1,28,0)="    with empty STATUS field."
^XWB(8994,2565,2,5,1,29,0)=" "
^XWB(8994,2565,2,5,1,30,0)="  IXCLASS^^{Name or IEN}^{Name or IEN}^..."
^XWB(8994,2565,2,5,1,31,0)="    Image class names or IENs (see the CLASS INDEX field (41)"
^XWB(8994,2565,2,5,1,32,0)="    of the file #2005 for details)."
^XWB(8994,2565,2,5,1,33,0)=" "
^XWB(8994,2565,2,5,1,34,0)="  IXORIGIN^^{Name or Code}^{Name or Code}^..."
^XWB(8994,2565,2,5,1,35,0)="    Internal or external values of the ORIGIN INDEX field (45)"
^XWB(8994,2565,2,5,1,36,0)="    of the file #2005."
^XWB(8994,2565,2,5,1,37,0)=" "
^XWB(8994,2565,2,5,1,38,0)="  IXPKG^^{Name or Code}^{Name or Code}^..."
^XWB(8994,2565,2,5,1,39,0)="    Internal or external values of the PACKAGE INDEX field (40)"
^XWB(8994,2565,2,5,1,40,0)="    of the file #2005."
^XWB(8994,2565,2,5,1,41,0)=" "
^XWB(8994,2565,2,5,1,42,0)="  IXPROC^^{Name or IEN}^{Name or IEN}^..."
^XWB(8994,2565,2,5,1,43,0)="    Procedure/Event names or IENs (see the PROC/EVENT INDEX"
^XWB(8994,2565,2,5,1,44,0)="    field (43) of the file #2005 for details)."
^XWB(8994,2565,2,5,1,45,0)=" "
^XWB(8994,2565,2,5,1,46,0)="  IXSPEC^^{Name or IEN}^{Name or IEN}^..."
^XWB(8994,2565,2,5,1,47,0)="    Specialty/SubSpecialty names or IENs (see the SPEC/SUBSPEC"
^XWB(8994,2565,2,5,1,48,0)="    INDEX field (44) of the file #2005 for details)."
^XWB(8994,2565,2,5,1,49,0)=" "
^XWB(8994,2565,2,5,1,50,0)="  IXTYPE^^{Name or IEN}^{Name or IEN}^..."
^XWB(8994,2565,2,5,1,51,0)="    Image type names or IENs (see the TYPE INDEX field (42) of"
^XWB(8994,2565,2,5,1,52,0)="    the file #2005 for details)."
^XWB(8994,2565,2,5,1,53,0)=" "
^XWB(8994,2565,2,5,1,54,0)="  SAVEDBY^^{DUZ}"
^XWB(8994,2565,2,5,1,55,0)="    If this parameter is defined, then only those images that were"
^XWB(8994,2565,2,5,1,56,0)="    captured by this user (see the IMAGE SAVE BY field (8) of the"
^XWB(8994,2565,2,5,1,57,0)="    file #2005 for details) are considered."
^XWB(8994,2565,2,5,1,58,0)=" "
^XWB(8994,2565,2,5,1,59,0)="  SENSIMG^^{Name or Code}^{Name or Code}^..."
^XWB(8994,2565,2,5,1,60,0)="    Internal or external values of the CONTROLLED IMAGE field (112)"
^XWB(8994,2565,2,5,1,61,0)="    of the file #2005."
^XWB(8994,2565,2,5,1,62,0)=" "
^XWB(8994,2565,2,5,1,63,0)="For pointer type parameters, pure numeric values are always treated as"
^XWB(8994,2565,2,5,1,64,0)="internal entry numbers (IEN)."
^XWB(8994,2565,2,5,1,65,0)=" "
^XWB(8994,2565,2,5,1,66,0)="Parameters can be added to the list in any order. See comments preceding"
^XWB(8994,2565,2,5,1,67,0)="the GETIMGS^MAGSIXG1 for more details."
^XWB(8994,2565,2,5,1,68,0)=" "
^XWB(8994,2565,2,5,1,69,0)="Example:"
^XWB(8994,2565,2,5,1,70,0)=" "
^XWB(8994,2565,2,5,1,71,0)="  with RPCBroker.Param[4] do"
^XWB(8994,2565,2,5,1,72,0)="    begin"
^XWB(8994,2565,2,5,1,73,0)="      PType := list;"
^XWB(8994,2565,2,5,1,74,0)="      Mult[1] := 'IXPKG^^RAD^LAB';"
^XWB(8994,2565,2,5,1,75,0)="      Mult[2] := 'IXCLASS^^1^ADMIN';"
^XWB(8994,2565,2,5,1,76,0)="      Mult[3] := 'IXORIGIN^^NON-VA^F';"
^XWB(8994,2565,2,5,1,77,0)="      Mult[4] := 'IDFN^^2341'; "
^XWB(8994,2565,2,5,1,78,0)="    end;"
^XWB(8994,2565,2,6,0)="MAXNUM^1^^^4"
^XWB(8994,2565,2,6,1,0)="^8994.021^9^9^3101022^^^^"
^XWB(8994,2565,2,6,1,1,0)="If this parameter is defined and greater than 0, then it determines the"
^XWB(8994,2565,2,6,1,2,0)="maximum number of images returned by the call."
^XWB(8994,2565,2,6,1,3,0)=" "
^XWB(8994,2565,2,6,1,4,0)="If the S flag is included in the value of the FLAGS parameter, then the "
^XWB(8994,2565,2,6,1,5,0)="MAXNUM parameter must be defined and greater than 0. Its value determines"
^XWB(8994,2565,2,6,1,6,0)="the percentage of preselected images to be returned in the result array."
^XWB(8994,2565,2,6,1,7,0)="For example, if the value of this parameter is 35 and 230 images are"
^XWB(8994,2565,2,6,1,8,0)="preselected (according to the user, date range, and other selection"
^XWB(8994,2565,2,6,1,9,0)="criteria), then 81 images will be returned."
^XWB(8994,2565,2,"B","FLAGS",2)=""
^XWB(8994,2565,2,"B","FROMDATE",3)=""
^XWB(8994,2565,2,"B","MAXNUM",6)=""
^XWB(8994,2565,2,"B","MISCPRMS",5)=""
^XWB(8994,2565,2,"B","TODATE",4)=""
^XWB(8994,2565,2,"PARAMSEQ",1,2)=""
