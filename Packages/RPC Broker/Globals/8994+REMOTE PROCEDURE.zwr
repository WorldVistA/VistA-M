^XWB(8994,3948,2,"PARAMSEQ",2,2)=""
^XWB(8994,3948,2,"PARAMSEQ",3,3)=""
^XWB(8994,3948,3,0)="^8994.03^3^3^3140508^^"
^XWB(8994,3948,3,1,0)="RETURN PARAMETER"
^XWB(8994,3948,3,2,0)=" "
^XWB(8994,3948,3,3,0)="If successful DSIYRET(1)=1^IEN^Turn-In Reference #"
^XWB(8994,3949,0)="DSIYAUDR AUDRPT AUDIT REPORT^AUDRPT^DSIYAUDR^4"
^XWB(8994,3949,1,0)="^8994.01^16^16^3170322^^^"
^XWB(8994,3949,1,1,0)="Schedules a report consisting of dates selected for Above PAR Audit. "
^XWB(8994,3949,1,2,0)="Displays data of a changed record.The data for  this report can be "
^XWB(8994,3949,1,3,0)="retrieved via the DSIYRPTR GETRPT GET RPT DATA RPC. "
^XWB(8994,3949,1,4,0)=" "
^XWB(8994,3949,1,5,0)="The data returned by the DSIYRPTR GETRPT GET RPT DATA is as follows:"
^XWB(8994,3949,1,6,0)="RET(0) is header column data"
^XWB(8994,3949,1,7,0)="RET(1-n) is record data, each record will begin with Date of change in "
^XWB(8994,3949,1,8,0)="piece 1"
^XWB(8994,3949,1,9,0)=" "
^XWB(8994,3949,1,10,0)="Example:"
^XWB(8994,3949,1,11,0)="RET(0)=Change D/T(date)^File/Sub-File(text)^Record "
^XWB(8994,3949,1,12,0)="(IEN)(number)^User(text)^Action(text)^Origin of "
^XWB(8994,3949,1,13,0)="Change(text)^Field(number)^"
^XWB(8994,3949,1,14,0)="Old Value(text)^New Value(text)"
^XWB(8994,3949,1,15,0)="RET(1)=6/27/2013@13:37:52^6914: EQUIPMENT INV.^10^ROISTAFF,CHIEF "
^XWB(8994,3949,1,16,0)="O^UPDATE^EQUIPMENT^4: MODEL^H6445L1845^H6445L1845A "
^XWB(8994,3949,2,0)="^8994.02A^4^4"
^XWB(8994,3949,2,1,0)="FROMDT^1^10^1^1"
^XWB(8994,3949,2,1,1,0)="^^1^1^3130201^"
^XWB(8994,3949,2,1,1,1,0)="First date to audit"
^XWB(8994,3949,2,2,0)="TODT^1^10^1^2"
^XWB(8994,3949,2,2,1,0)="^^1^1^3130201^"
^XWB(8994,3949,2,2,1,1,0)="Last date to audit."
^XWB(8994,3949,2,3,0)="ESTART^1^10^0^4"
^XWB(8994,3949,2,3,1,0)="^8994.021^1^1^3130710^^^^"
^XWB(8994,3949,2,3,1,1,0)="Earliest time to schedule report (defaults to ""NOW"")"
^XWB(8994,3949,2,4,0)="ORIGIN^1^1^0^3"
^XWB(8994,3949,2,4,1,0)="^8994.021^4^4^3170322^^"
^XWB(8994,3949,2,4,1,1,0)="Optional Origin of Change filter. Use this parameter to specify that the "
^XWB(8994,3949,2,4,1,2,0)="report should only be run for 'G'IP, 'W'ork Orders, 'V'endor or"
^XWB(8994,3949,2,4,1,3,0)="'E'quipment"
^XWB(8994,3949,2,4,1,4,0)="changesets. Default is to return all origins."
^XWB(8994,3949,2,"B","ESTART",3)=""
^XWB(8994,3949,2,"B","FROMDT",1)=""
^XWB(8994,3949,2,"B","ORIGIN",4)=""
^XWB(8994,3949,2,"B","TODT",2)=""
^XWB(8994,3949,2,"PARAMSEQ",1,1)=""
^XWB(8994,3949,2,"PARAMSEQ",2,2)=""
^XWB(8994,3949,2,"PARAMSEQ",3,3)=""
^XWB(8994,3949,2,"PARAMSEQ",3,4)=""
^XWB(8994,3949,2,"PARAMSEQ",4,3)=""
^XWB(8994,3949,3,0)="^8994.03^4^4^3170322^^^"
^XWB(8994,3949,3,1,0)=" "
^XWB(8994,3949,3,2,0)="[Task Number]^REPORT AFTER [time report is scheduled to run]"
^XWB(8994,3949,3,3,0)=" Otherwise, returns:"
^XWB(8994,3949,3,4,0)="    -1^[Error Message]"
^XWB(8994,3950,0)="DSIYX1 SETUSRXP USER PARAM^SETUSRXP^DSIYX1^2"
^XWB(8994,3950,1,0)="^^4^4^3130205^"
^XWB(8994,3950,1,1,0)="SETUSRXP"
^XWB(8994,3950,1,2,0)=" "
^XWB(8994,3950,1,3,0)="Sets up a single parameter.  GUI must know whether this can be set at a "
^XWB(8994,3950,1,4,0)="USER level, SYSTEM level or both"
^XWB(8994,3950,2,0)="^8994.02A^3^3"
^XWB(8994,3950,2,1,0)="PARAM^1^60^1^1"
^XWB(8994,3950,2,1,1,0)="^^3^3^3130205^"
^XWB(8994,3950,2,1,1,1,0)="PARAM"
^XWB(8994,3950,2,1,1,2,0)=" "
^XWB(8994,3950,2,1,1,3,0)="Name of the parameter to be set up."
^XWB(8994,3950,2,2,0)="USER^1^30^1^2"
^XWB(8994,3950,2,2,1,0)="^^5^5^3130205^"
^XWB(8994,3950,2,2,1,1,0)="USER"
^XWB(8994,3950,2,2,1,2,0)=" "
^XWB(8994,3950,2,2,1,3,0)="If setting a SYSTEM-wide parameter use ""SYS"" as the user parameter."
^XWB(8994,3950,2,2,1,4,0)=" "
^XWB(8994,3950,2,2,1,5,0)="If setting a USER parameter, use the user's DUZ value in the parameter."
^XWB(8994,3950,2,3,0)="VALUE^1^60^1^3"
^XWB(8994,3950,2,3,1,0)="^8994.021^4^4^3130205^^"
^XWB(8994,3950,2,3,1,1,0)="VALUE"
^XWB(8994,3950,2,3,1,2,0)=" "
^XWB(8994,3950,2,3,1,3,0)="Depending on the parameter definition, send in an appropriate value for "
^XWB(8994,3950,2,3,1,4,0)="this parameter"
^XWB(8994,3950,2,"B","PARAM",1)=""
^XWB(8994,3950,2,"B","USER",2)=""
^XWB(8994,3950,2,"B","VALUE",3)=""
