^XWB(8994,3853,1,5,0)="Serial#^Equipment Category^Replacement Date^Use Status^VA PM Number^Local "
^XWB(8994,3853,1,6,0)="Identifier"
^XWB(8994,3853,2,0)="^8994.02A^2^2"
^XWB(8994,3853,2,1,0)="TODT^1^7^1^1"
^XWB(8994,3853,2,1,1,0)="^^3^3^3120605^"
^XWB(8994,3853,2,1,1,1,0)="Future date limit of replacement dates to display. Only equipment with a "
^XWB(8994,3853,2,1,1,2,0)="replacement date between the current date and this parameter will be "
^XWB(8994,3853,2,1,1,3,0)="retreived."
^XWB(8994,3853,2,2,0)="ESTART^1^30^0^2"
^XWB(8994,3853,2,2,1,0)="^8994.021^1^1^3120621^^"
^XWB(8994,3853,2,2,1,1,0)="Earliest time to start scheduled report. Defaults to ""NOW""."
