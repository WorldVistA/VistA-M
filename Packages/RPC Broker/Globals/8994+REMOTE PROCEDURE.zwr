^XWB(8994,4582,3,9,0)="            ""SlotsAvail"": 1"
^XWB(8994,4582,3,10,0)="         }"
^XWB(8994,4582,3,11,0)="     ]"
^XWB(8994,4582,3,12,0)=" }"
^XWB(8994,4582,3,13,0)=" "
^XWB(8994,4582,3,14,0)="SlotsAvail can have the following values:"
^XWB(8994,4582,3,15,0)=" NULL     Not Available/Overbooked"
^XWB(8994,4582,3,16,0)=" 1,2,..   # of Available Slots"
^XWB(8994,4582,3,17,0)=" X        Cancelled"
^XWB(8994,4582,3,18,0)=" "
^XWB(8994,4582,3,19,0)=" "
