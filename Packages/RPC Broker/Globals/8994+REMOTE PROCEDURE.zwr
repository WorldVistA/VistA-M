^XWB(8994,5183,0)="SDES2 UNDO CHECKIN^UNDOCHECKIN^SDES2UNDOCHECKIN^2^R^^^^^^1"
^XWB(8994,5183,1,0)="^8994.01^5^5^3260323^^^^"
^XWB(8994,5183,1,1,0)="This RPC allows the user to remove an appointment check-in "
^XWB(8994,5183,1,2,0)="information given the appointment IEN. It returns the entire"
^XWB(8994,5183,1,3,0)="appointment object with an updated EAS tracking number."
^XWB(8994,5183,1,4,0)=" "
^XWB(8994,5183,1,5,0)="Can only be invoked by Acheron "
^XWB(8994,5183,2,0)="^8994.02A^2^2"
^XWB(8994,5183,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,5183,2,1,1,0)="^^10^10^3260316^"
^XWB(8994,5183,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,5183,2,1,1,2,0)="                            Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5183,2,1,1,3,0)="SDCONTEXT(""PATIENT DFN"") = The DFN/IEN of the target patient from the"
^XWB(8994,5183,2,1,1,4,0)="                           calling application."
^XWB(8994,5183,2,1,1,5,0)="SDCONTEXT(""PATIENT ICN"") = The ICN of the target patient from the"
^XWB(8994,5183,2,1,1,6,0)="                           calling application."
^XWB(8994,5183,2,1,1,7,0)="SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action in the"
^XWB(8994,5183,2,1,1,8,0)="                        calling application."
^XWB(8994,5183,2,1,1,9,0)="SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,5183,2,1,1,10,0)="                          calling application."
^XWB(8994,5183,2,2,0)="SDINPUT^2^32000^1^2"
^XWB(8994,5183,2,2,1,0)="^8994.021^3^3^3260323^^^^"
^XWB(8994,5183,2,2,1,1,0)="SDINPUT(""APPT IEN"") = IEN of SDEC APPOINTMENT (#409.84) file record to"
^XWB(8994,5183,2,2,1,2,0)="                      remove check-in (required)."
^XWB(8994,5183,2,2,1,3,0)="SDINPUT(""FULL OBJECT"") = 1 to return the full appointment object (optional)"
^XWB(8994,5183,2,"B","SDCONTEXT",1)=""
