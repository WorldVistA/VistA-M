^XWB(8994,3117,1,16,0)="This RPC returns an array of work items with values that match the"
^XWB(8994,3117,1,17,0)="parameters provided."
^XWB(8994,3117,2,0)="^8994.02A^8^8"
^XWB(8994,3117,2,1,0)="TYPE^1^^^1"
^XWB(8994,3117,2,1,1,0)="^8994.021^2^2^3111103^^"
^XWB(8994,3117,2,1,1,1,0)="This is the type of work item.  Work item types are stored in the"
^XWB(8994,3117,2,1,1,2,0)="WORKLIST file (#2006.9412)."
^XWB(8994,3117,2,2,0)="SUBTYPE^1^^^2"
^XWB(8994,3117,2,2,1,0)="^^1^1^3110407^"
^XWB(8994,3117,2,2,1,1,0)="This is the subtype of the work item."
^XWB(8994,3117,2,3,0)="STATUS^1^^^3"
^XWB(8994,3117,2,3,1,0)="^^1^1^3110407^"
^XWB(8994,3117,2,3,1,1,0)="This is the current status of the work item."
^XWB(8994,3117,2,4,0)="PLACEID^1^^^4"
^XWB(8994,3117,2,4,1,0)="^^2^2^3110407^"
^XWB(8994,3117,2,4,1,1,0)="This is a place ID of a work item.  The place ID is an entry in the"
^XWB(8994,3117,2,4,1,2,0)="INSTITUTION file (#4)."
^XWB(8994,3117,2,5,0)="PRIORITY^1^^^5"
^XWB(8994,3117,2,5,1,0)="^^1^1^3110407^"
^XWB(8994,3117,2,5,1,1,0)="This is the numeric priority given to a work item."
^XWB(8994,3117,2,6,0)="TAGS^2^^^8"
^XWB(8994,3117,2,6,1,0)="^8994.021^1^1^3120618^^^^"
^XWB(8994,3117,2,6,1,1,0)="This is an array of tag names and values."
^XWB(8994,3117,2,7,0)="STOPTAG^1^^^6"
^XWB(8994,3117,2,7,1,0)="^8994.021^3^3^3120618^^^^"
^XWB(8994,3117,2,7,1,1,0)="If this parameter is set then the tag list may be truncated. If a tag"
^XWB(8994,3117,2,7,1,2,0)="value matching the parameter value is returned then no more tags will"
^XWB(8994,3117,2,7,1,3,0)="be returned."
^XWB(8994,3117,2,8,0)="MAXROWS^1^^^7"
^XWB(8994,3117,2,8,1,0)="^^3^3^3120618^"
^XWB(8994,3117,2,8,1,1,0)="This parameter determines the number of work items to return.  If this"
^XWB(8994,3117,2,8,1,2,0)="parameter is not set all matching work items will be sent.  If this parameter"
^XWB(8994,3117,2,8,1,3,0)="is defined it will determine the maximum number of work items to return"
^XWB(8994,3117,2,"B","MAXROWS",8)=""
^XWB(8994,3117,2,"B","PLACEID",4)=""
^XWB(8994,3117,2,"B","PRIORITY",5)=""
^XWB(8994,3117,2,"B","STATUS",3)=""
^XWB(8994,3117,2,"B","STOPTAG",7)=""
