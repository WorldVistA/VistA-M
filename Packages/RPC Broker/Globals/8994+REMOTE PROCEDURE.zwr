^XWB(8994,4019,2,4,1,7,0)=" "
^XWB(8994,4019,2,4,1,8,0)="STORAGE LOCATION (445.4)"
^XWB(8994,4019,2,4,1,9,0)="  DSIYDAT(.01) = Storage Location - Vista Requires one punctuation mark"
^XWB(8994,4019,2,4,1,10,0)="                 Usually this is stored as Section-Bin-Shelf"
^XWB(8994,4019,2,4,1,11,0)="                   Limit = 13 characters"
^XWB(8994,4019,2,4,1,12,0)=" "
