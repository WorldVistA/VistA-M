^XWB(8994,3003,0)="DSIROIC ZIP CODE LOOKUP^ZIP^DSIROIC^1"
^XWB(8994,3003,1,0)="^^2^2^3111208^"
^XWB(8994,3003,1,1,0)="Looks up location information, city, state, and county based on inputted "
^XWB(8994,3003,1,2,0)="zip code."
^XWB(8994,3003,2,0)="^8994.02A^2^2"
^XWB(8994,3003,2,1,0)="PCODE^1^10^1^1"
^XWB(8994,3003,2,1,1,0)="^^1^1^3111208^"
^XWB(8994,3003,2,1,1,1,0)="PCODE - required - 5 or 9 digit zip code - must be a string"
^XWB(8994,3003,2,2,0)="ACTDATE^1^7^0^2"
^XWB(8994,3003,2,2,1,0)="^^2^2^3111208^"
^XWB(8994,3003,2,2,1,1,0)="ACTDATE - optional - Fileman date for which the zip code must have been"
^XWB(8994,3003,2,2,1,2,0)="active - default is to ignore date sndn return all."
^XWB(8994,3003,2,"B","ACTDATE",2)=""
^XWB(8994,3003,2,"B","PCODE",1)=""
^XWB(8994,3003,2,"PARAMSEQ",1,1)=""
^XWB(8994,3003,2,"PARAMSEQ",2,2)=""
^XWB(8994,3003,3,0)="^^6^6^3111208^"
^XWB(8994,3003,3,1,0)="RETURN: on error return -1^error message"
^XWB(8994,3003,3,2,0)="        else return p1^p2^p3^p4^p5^p6^p7^p8  where"
^XWB(8994,3003,3,3,0)="        p1 = inputted zip code     p5 = FIPS county code"
^XWB(8994,3003,3,4,0)="        p2 = city                  p6 = state abbreviation"
^XWB(8994,3003,3,5,0)="        p3 = state (full name)     p7 = ptr to STATE file (#5)"
^XWB(8994,3003,3,6,0)="        p4 = county (full name)    p8 = ptr to COUNTY CODE file (#5.13)"
^XWB(8994,3004,0)="DSIROIC GETSTLST STATE LIST^GETSTLST^DSIROIC^4^^^^1"
^XWB(8994,3004,1,0)="^8994.01^1^1^3120109^^"
^XWB(8994,3004,1,1,0)="Gets state information from file 5."
^XWB(8994,3004,3,0)="^8994.03^4^4^3120109^^"
^XWB(8994,3004,3,1,0)="RETURNS State information as an array of strings as follows:"
^XWB(8994,3004,3,2,0)="  IEN^STATE NAME^ABREVIATION"
^XWB(8994,3004,3,3,0)="  or"
^XWB(8994,3004,3,4,0)="  -1^Error Message"
^XWB(8994,3005,0)="DSIROIC CLKDAT GET CLERK INFO^CLKDAT^DSIROIC^1"
^XWB(8994,3005,1,0)="^8994.01^1^1^3111208^"
^XWB(8994,3005,1,1,0)="Look up for clerk info."
^XWB(8994,3005,2,0)="^8994.02A^1^1"
^XWB(8994,3005,2,1,0)="IEN^1^30^1^1"
^XWB(8994,3005,2,1,1,0)="^^1^1^3111208^"
^XWB(8994,3005,2,1,1,1,0)="IEN of clerk from file 200."
^XWB(8994,3005,2,"B","IEN",1)=""
^XWB(8994,3005,2,"PARAMSEQ",1,1)=""
^XWB(8994,3005,3,0)="^^8^8^3111208^"
^XWB(8994,3005,3,1,0)="RETURNS A 5 PIECE STRING FORMATTED AS FOLLOWS"
^XWB(8994,3005,3,2,0)="  NAME^"
^XWB(8994,3005,3,3,0)="  OFFICE PHONE"
^XWB(8994,3005,3,4,0)="  ^SIGNATURE BLOCK NAME"
^XWB(8994,3005,3,5,0)="  ^SIGNATURE BLOCK "
^XWB(8994,3005,3,6,0)="  TITLE^SERVICE/SECTION"
^XWB(8994,3005,3,7,0)="  or"
^XWB(8994,3005,3,8,0)="  -1^ERROR MESSAGE"
^XWB(8994,3006,0)="DSIROIC DOD GET DATE OF DEATH^DOD^DSIROIC^1"
^XWB(8994,3006,1,0)="^^1^1^3111208^"
^XWB(8994,3006,1,1,0)="Get a patient's date of death."
^XWB(8994,3006,2,0)="^8994.02A^1^1"
^XWB(8994,3006,2,1,0)="IEN^1^30^1^1"
^XWB(8994,3006,2,1,1,0)="^^1^1^3111208^"
^XWB(8994,3006,2,1,1,1,0)="Patient DFN from file 2."
^XWB(8994,3006,2,"B","IEN",1)=""
^XWB(8994,3006,2,"PARAMSEQ",1,1)=""
^XWB(8994,3006,3,0)="^^3^3^3111208^"
^XWB(8994,3006,3,1,0)="RETURNS A single date or a null if no date found"
^XWB(8994,3006,3,2,0)="  OR AN ERROR"
^XWB(8994,3006,3,3,0)="  -1^ERROR MESSAGE"
^XWB(8994,3007,0)="DSIROIC PATID GET DFN AND NAME^PATINFO^DSIROIC^1"
^XWB(8994,3007,1,0)="^^1^1^3111208^"
^XWB(8994,3007,1,1,0)="Get patient information form a request."
^XWB(8994,3007,2,0)="^8994.02A^1^1"
^XWB(8994,3007,2,1,0)="IEN^1^30^1^1"
^XWB(8994,3007,2,1,1,0)="^^1^1^3111208^"
^XWB(8994,3007,2,1,1,1,0)="IEN of a request in 19620 fro which patient information is needed."
^XWB(8994,3007,2,"B","IEN",1)=""
^XWB(8994,3007,2,"PARAMSEQ",1,1)=""
^XWB(8994,3007,3,0)="^^4^4^3111208^"
^XWB(8994,3007,3,1,0)="RETURNS A 2 PIECE STRING FORMATTED AS FOLLOWS"
^XWB(8994,3007,3,2,0)="  IEN of patient^NAME of patient"
^XWB(8994,3007,3,3,0)="  OR AN ERROR"
^XWB(8994,3007,3,4,0)="  -1^ERROR MESSAGE"
^XWB(8994,3008,0)="DSIROI3 CKRQ CHK PAT REQUESTOR^CKRQ^DSIROI3^2"
^XWB(8994,3008,1,0)="^^1^1^3111208^"
^XWB(8994,3008,1,1,0)="Checks requestor file for entries for a selected patient. "
^XWB(8994,3008,2,0)="^8994.02A^1^1"
^XWB(8994,3008,2,1,0)="DFN^1^30^1^1"
^XWB(8994,3008,2,1,1,0)="^^1^1^3111208^"
^XWB(8994,3008,2,1,1,1,0)="FULLY QUALIFIED POINTER TO ^DPT OR ^DSIR(19520.96."
^XWB(8994,3008,2,"B","DFN",1)=""
^XWB(8994,3008,2,"PARAMSEQ",1,1)=""
^XWB(8994,3008,3,0)="^^2^2^3111208^"
^XWB(8994,3008,3,1,0)="RETURNS - ARRAY: IEN^LOOKUP NAME (.01 FIELD OF 19620.12)"
^XWB(8994,3008,3,2,0)="          OR -1^PATIENT NOT IN REQUESTOR TABLE    "
^XWB(8994,3009,0)="DSIROI STBLFLG SET BILL FLAG^STBLFLG^DSIROI^1"
^XWB(8994,3009,1,0)="^^2^2^3120104^"
^XWB(8994,3009,1,1,0)="This routine checks the requestor attached to a request to see if there "
^XWB(8994,3009,1,2,0)="are any outstanding bills other than the current request. "
^XWB(8994,3009,2,0)="^8994.02A^1^1"
^XWB(8994,3009,2,1,0)="IEN^1^20^1^1"
^XWB(8994,3009,2,1,1,0)="^^2^2^3120104^"
^XWB(8994,3009,2,1,1,1,0)="This is the IEN of the request whose reqyestor is being checked for an "
^XWB(8994,3009,2,1,1,2,0)="outstanding balance."
^XWB(8994,3009,2,"B","IEN",1)=""
^XWB(8994,3009,2,"PARAMSEQ",1,1)=""
^XWB(8994,3009,3,0)="^^5^5^3120104^"
^XWB(8994,3009,3,1,0)="RETURNS"
^XWB(8994,3009,3,2,0)="   1 = One or more outstanding balances exits"
^XWB(8994,3009,3,3,0)="   0 = No outstanding balances"
^XWB(8994,3009,3,4,0)="   or"
^XWB(8994,3009,3,5,0)="   -1^error message"
^XWB(8994,3014,0)="TIU TEMPLATE GET TEMPLATE^GETTMPLT^TIUSRVT2^2^A"
^XWB(8994,3014,1,0)="^8994.01^1^1^3090915^^^"
^XWB(8994,3014,1,1,0)="This RPC gets basic attributes of a given TIU Template (file 8927)."
^XWB(8994,3014,2,0)="^8994.02A^2^1"
^XWB(8994,3014,2,2,0)="IEN^1^^1^1"
^XWB(8994,3014,2,2,1,0)="^8994.021^2^2^3090915^^"
^XWB(8994,3014,2,2,1,1,0)="This is the internal entry number in the TIU TEMPLATE FILE 8927 of the "
^XWB(8994,3014,2,2,1,2,0)="template."
^XWB(8994,3014,2,"B","IEN",2)=""
^XWB(8994,3014,2,"PARAMSEQ",1,2)=""
^XWB(8994,3014,3,0)="^^1^1^3090915^"
^XWB(8994,3014,3,1,0)="Basic attributes of the given template are returned in '^'-delimited form."
^XWB(8994,3015,0)="DENTV DELETE UNFILED DATA^DELU^DENTVRHD^2^A^0"
^XWB(8994,3015,1,0)="^^3^3^3100114^"
^XWB(8994,3015,1,1,0)="Input takes in an array of IENS for deletion. Upon completion, the RPC "
^XWB(8994,3015,1,2,0)="will return an array of IENS with a message. 0^File record deleted if "
^XWB(8994,3015,1,3,0)="successful, or -1^Error deleting record if unsuccessful."
^XWB(8994,3015,2,0)="^8994.02A^2^1"
^XWB(8994,3015,2,2,0)="DATA^2^^1^1"
^XWB(8994,3015,2,2,1,0)="^8994.021^1^1^3100114^^"
^XWB(8994,3015,2,2,1,1,0)="This is an array of IEN records to be deleted from file 228.7"
^XWB(8994,3015,2,"B","DATA",2)=""
^XWB(8994,3015,2,"PARAMSEQ",1,2)=""
^XWB(8994,3015,3,0)="^^3^3^3100114^"
^XWB(8994,3015,3,1,0)="The return array is formatted the same as the input array. It will return "
^XWB(8994,3015,3,2,0)="an array of IENS with a message specifying if the delete was "
^XWB(8994,3015,3,3,0)="successful or unsuccessful."
^XWB(8994,3016,0)="DENTV GET UNFILED DETAIL^GETUN^DENTVTP7^4^A^0^^1"
^XWB(8994,3016,1,0)="^8994.01^2^2^3100127^^^^"
^XWB(8994,3016,1,1,0)="This procedure will take in a single IEN to return all data for the IEN "
^XWB(8994,3016,1,2,0)="in ^TMP(""DENT"",$J,N)=value."
^XWB(8994,3016,2,0)="^8994.02A^1^1"
^XWB(8994,3016,2,1,0)="IEN^1^^1^1"
^XWB(8994,3016,2,1,1,0)="^8994.021^2^2^3100127^^^^"
^XWB(8994,3016,2,1,1,1,0)="This input should be a number coinciding with an IEN for the record you "
^XWB(8994,3016,2,1,1,2,0)="wish to retreive."
^XWB(8994,3016,2,"B","IEN",1)=""
^XWB(8994,3016,2,"PARAMSEQ",1,1)=""
^XWB(8994,3016,3,0)="^8994.03^3^3^3100127^^^^"
^XWB(8994,3016,3,1,0)="The return global array is in format ^TMP(""DENT"",$J,N)=value. There will "
^XWB(8994,3016,3,2,0)="be M number of nodes within the return where N is the first record and M "
^XWB(8994,3016,3,3,0)="is the last record."
^XWB(8994,3017,0)="DENTV TP CLEAN SLATE^CLNSLT^DENTVTP7^1^A^0"
^XWB(8994,3017,1,0)="^8994.01^8^8^3100127^^"
^XWB(8994,3017,1,1,0)="This will process a clean slate on DPAT passed in. The RPC processes both "
^XWB(8994,3017,1,2,0)="clean slate, and undo clean slate. You must pass a flag to determine "
^XWB(8994,3017,1,3,0)="which process you want completed. ACT=1 means you want to process a clean "
^XWB(8994,3017,1,4,0)="slate, ACT=-1 means you want to undo a clean slate."
^XWB(8994,3017,1,5,0)=" "
^XWB(8994,3017,1,6,0)="The clean slate can only be processed if there is no unfiled data for the "
^XWB(8994,3017,1,7,0)="patient. A clean slate undo can only be done if there no newer filed "
^XWB(8994,3017,1,8,0)="transactions for the patient."
^XWB(8994,3017,2,0)="^8994.02A^2^2"
^XWB(8994,3017,2,1,0)="DPAT^1^^1^1"
^XWB(8994,3017,2,2,0)="ACT^1^^1^2"
^XWB(8994,3017,2,2,1,0)="^8994.021^3^3^3100127^^"
^XWB(8994,3017,2,2,1,1,0)="ACT is used to tell the RPC which process to run:"
^XWB(8994,3017,2,2,1,2,0)="ACT=1 means you want to process a clean slate."
^XWB(8994,3017,2,2,1,3,0)="ACT=-1 means you want to undo a clean slate."
^XWB(8994,3017,2,"B","ACT",2)=""
^XWB(8994,3017,2,"B","DPAT",1)=""
^XWB(8994,3017,2,"PARAMSEQ",1,1)=""
^XWB(8994,3017,2,"PARAMSEQ",2,2)=""
^XWB(8994,3017,3,0)="^^3^3^3100127^"
^XWB(8994,3017,3,1,0)="Returns 1^Message if successful clean slate."
^XWB(8994,3017,3,2,0)="        0^Message if clean slate undo is successful."
^XWB(8994,3017,3,3,0)="       -1^Message if clean slate has an error."
^XWB(8994,3018,0)="DENTV TP FILE EXAM TRANSACTION^FILEX^DENTVTPA^1^A^0"
^XWB(8994,3018,1,0)="^8994.01^39^39^3101103^^"
^XWB(8994,3018,1,1,0)="Files the new exam template modal data (OHA,PAR,OCC,TMJ) into a record in "
^XWB(8994,3018,1,2,0)="228.2 of type 5:EXAM"
^XWB(8994,3018,1,3,0)=" "
^XWB(8994,3018,1,4,0)="Input variables:"
^XWB(8994,3018,1,5,0)=" "
^XWB(8994,3018,1,6,0)=" SAVE DATA IN (FILED/UNFILED)"
^XWB(8994,3018,1,7,0)=" **************************************"
^XWB(8994,3018,1,8,0)=" DATA(""FLAG"")= ACTION FLAG, A OR BLANK FOR ADD, M FOR MODIFY"
^XWB(8994,3018,1,9,0)=" DATA(""DPAT"")= Patient IEN"
^XWB(8994,3018,1,10,0)=" DATA(""PROV"")= Provider IEN"
^XWB(8994,3018,1,11,0)=" DATA(""DATE"")= Date of transaction"
^XWB(8994,3018,1,12,0)=" DATA(""OHA"")=CI PLAQUE INDEX^CARIES RISK^ORAL HYGIENE^XEROSTOMIA"
^XWB(8994,3018,1,13,0)=" DATA(""OCC"")=MANDIBULAR^OPEN BITE^CROSS BITE^LEFT MOLAR RELAT^RIGHT MOLAR "
^XWB(8994,3018,1,14,0)="RELAT^LEFT CUSPID RELAT^RIGHT CUSPID RELAT^OVERBITE^OVERJET"
^XWB(8994,3018,1,15,0)=" DATA(""PAR"")=BRUXING^CLENCHING^HISTORY^"
^XWB(8994,3018,1,16,0)=" DATA(""PARWP"",N)=PARAFUNCTIONAL HABIT NOTES (WORD PROCESSING)"
^XWB(8994,3018,1,17,0)=" DATA(""PARC"")=ATTRITION^ABRASION^EROSION^HYPERTROPHY^OBSERVED^FACETED^ABFR"
^XWB(8994,3018,1,18,0)="ACTION"
^XWB(8994,3018,1,19,0)=" DATA(""PARCWP"",N)=PARAFUNCTIONAL HABITS CLINICAL FINDINGS NOTES (WORD "
^XWB(8994,3018,1,20,0)="PROCESSING)"
^XWB(8994,3018,1,21,0)=" DATA(""TMJ"")=TRAUMA^SPONT PAIN^POPPING^CLICKING^PAIN OPENING^PAIN "
^XWB(8994,3018,1,22,0)="CHEWING^LIMITED OPENING^"
^XWB(8994,3018,1,23,0)=" DATA(""TMJWP"",N)=TMJ OTHER NOTES (WORD PROCESSING)"
^XWB(8994,3018,1,24,0)=" DATA(""TMJC"")=MAX INCISAL OPENING^LEFT LATERAL^RIGHT LATERAL^CF "
^XWB(8994,3018,1,25,0)="POPPING^CF CLICKING^CF PAIN^DEVIATION^"
^XWB(8994,3018,1,26,0)=" DATA(""TMJCWP"",N)=TMJ CF NOTES (WORD PROCESSING)"
^XWB(8994,3018,1,27,0)=" DATA(""SOCH"")=PAT REP SOCH^SH CIGARETTES^CIGARETTE QUANTITY^CIGARETTE "
^XWB(8994,3018,1,28,0)="FREQUENCY^CIGARETTE YEARS^SH PIPE/CIGAR^PIPE QUANTITY^PIPE FREQUENCY^PIPE "
^XWB(8994,3018,1,29,0)="YEARS^SH SMOKELESS^SMOKELESS QUANTITY^SMOKELESS FREQUENCY^SMOKELESS "
^XWB(8994,3018,1,30,0)="YEARS^SH"
^XWB(8994,3018,1,31,0)="ALCOHOL^ALCOHOL QUANTITY^ALOCHOL FREQUENCY^ALCOHOL YEARS^"
^XWB(8994,3018,1,32,0)=" DATA(""SHDA"")=SH DRUG ABUSE^SH DRUG ABUSE DESCRIPTION^"
^XWB(8994,3018,1,33,0)=" DATA(""SHWP"",N)=SH NOTES (WORD PROCESSING)"
^XWB(8994,3018,1,34,0)=" "
^XWB(8994,3018,1,35,0)=" "
^XWB(8994,3018,1,36,0)="Return variables:"
^XWB(8994,3018,1,37,0)=" "
^XWB(8994,3018,1,38,0)=" 1^Successful message"
^XWB(8994,3018,1,39,0)=" -1^Error Message"
^XWB(8994,3018,2,0)="^8994.02A^1^1"
^XWB(8994,3018,2,1,0)="DATA^2^^1^1"
^XWB(8994,3018,2,1,1,0)="^8994.021^1^1^3100114^^"
^XWB(8994,3018,2,1,1,1,0)="See documentation in FILEX^DENTVTPA."
^XWB(8994,3018,2,"B","DATA",1)=""
^XWB(8994,3018,2,"PARAMSEQ",1,1)=""
^XWB(8994,3018,3,0)="^8994.03^2^2^3100114^^"
^XWB(8994,3018,3,1,0)="Returns a message 1^Message if the file is completed successfully. A "
^XWB(8994,3018,3,2,0)="-1^message will be returned when an error occurs."
^XWB(8994,3019,0)="DENTV TP GET EXAM TRANSACTIONS^GETFEX^DENTVTP7^2^A^0"
^XWB(8994,3019,1,0)="^8994.01^4^4^3100323^^^^"
^XWB(8994,3019,1,1,0)="This will return a complete list of exam transactions for a specified "
^XWB(8994,3019,1,2,0)="patient. The array is organized by node, not by date. For example all of "
^XWB(8994,3019,1,3,0)="the ""OHA"" Oral Health Assessment data is returned together. See "
^XWB(8994,3019,1,4,0)="GETFEX^DENTVTP7 comments for details."
^XWB(8994,3019,2,0)="^8994.02A^1^1"
^XWB(8994,3019,2,1,0)="DPAT^1^^1^1"
^XWB(8994,3019,2,1,1,0)="^8994.021^1^1^3100323^^^^"
^XWB(8994,3019,2,1,1,1,0)="This value should be the Patient IEN."
^XWB(8994,3019,2,"B","DPAT",1)=""
^XWB(8994,3019,2,"PARAMSEQ",1,1)=""
^XWB(8994,3019,3,0)="^^33^33^3100323^"
^XWB(8994,3019,3,1,0)="The return will group all return values by type (ex. ""OHA"" data will be "
^XWB(8994,3019,3,2,0)="returned in one group, then ""OCC"" in another group). If there is no data "
^XWB(8994,3019,3,3,0)="in a specific group to be returned, there will be no header ($$START^OHA "
^XWB(8994,3019,3,4,0)="for example)."
^XWB(8994,3019,3,5,0)=" "
^XWB(8994,3019,3,6,0)="DATA(1)=$$START^OHA"
^XWB(8994,3019,3,7,0)="DATA(2+N)=IEN^DATE^PROV^CI PLAQUE INDEX^CARIES RISK^ORAL "
^XWB(8994,3019,3,8,0)="HYGIENE^XEROSTOMIA^PROV INITIALS"
^XWB(8994,3019,3,9,0)="DATA(3)=$$START^OCC"
^XWB(8994,3019,3,10,0)="DATA(4+N)=IEN^DATE^PROV^MANDIBULAR^OPEN BITE^CROSS BITE^LEFT MOLAR "
^XWB(8994,3019,3,11,0)="RELAT^RIGHT MOLAR RELAT^LEFT CUSPID RELAT^RIGHT CUSPID "
^XWB(8994,3019,3,12,0)="RELAT^OVERBITE^OVERJET"
^XWB(8994,3019,3,13,0)="DATA(5)=$$START^PAR"
^XWB(8994,3019,3,14,0)="DATA(6+N)=IEN^DATE^PROV^PAT REPORTS PAR^BRUXING^CLENCHING^HISTORY^OTHER "
^XWB(8994,3019,3,15,0)="FLAG (1 OR NULL)"
^XWB(8994,3019,3,16,0)="DATA(7)=$$START^PARC"
^XWB(8994,3019,3,17,0)="DATA(8+N)=IEN^DATE^PROV^PAR "
^XWB(8994,3019,3,18,0)="EVIDENCED^ATTRITION^ABRASION^EROSION^HYPERTROPHY^OTHER FLAG (1 OR NULL)"
^XWB(8994,3019,3,19,0)="DATA(9)=$$START^TMJ"
^XWB(8994,3019,3,20,0)="DATA(10+N)=IEN^DATE^PROV^PAT REPORTS TMJ^TRAUMA^SPONT "
^XWB(8994,3019,3,21,0)="PAIN^POPPING^CLICKING^PAIN OPENING^PAIN CHEWING^LIMITED OPENING^OTHER "
^XWB(8994,3019,3,22,0)="FLAG (1 OR NULL)"
^XWB(8994,3019,3,23,0)="DATA(11)=$$START^TMJC"
^XWB(8994,3019,3,24,0)="DATA(12+N)=IEN^DATE^PROV^MAX INCISAL OPENING^LEFT LATERAL^RIGHT "
^XWB(8994,3019,3,25,0)="LATERAL^CF POPPING^CF CLICKING^CF PAIN^DEVIATION^OTHER FLAG (1 OR NULL)"
^XWB(8994,3019,3,26,0)="DATA(13)=$$START^PARWP"
^XWB(8994,3019,3,27,0)="DATA(14+N)=IEN^TEXT FROM WP FIELD PARWP"
^XWB(8994,3019,3,28,0)="DATA(15)=$$START^PARCWP"
^XWB(8994,3019,3,29,0)="DATA(16+N)=IEN^TEXT FROM WP FIELD PARCWP"
^XWB(8994,3019,3,30,0)="DATA(17)=$$START^TMJWP"
^XWB(8994,3019,3,31,0)="DATA(18+N)=IEN^TEXT FROM WP FIELD TMJWP"
^XWB(8994,3019,3,32,0)="DATA(19)=$$START^TMJCWP"
^XWB(8994,3019,3,33,0)="DATA(20+N)=IEN^TEXT FROM WP FIELD TMJCWP"
^XWB(8994,3020,0)="DENTV GET CLEAN SLATE LIST^GETCSL^DENTVTP7^2^A^0"
^XWB(8994,3020,1,0)="^^4^4^3100211^"
^XWB(8994,3020,1,1,0)="Returns a list of all clean slates applied to a patient."
^XWB(8994,3020,1,2,0)="   Return example: RETURN(1)=""1^Dates found"""
^XWB(8994,3020,1,3,0)="                   RETURN(2)=3100101.120345"
^XWB(8994,3020,1,4,0)="   OR              RETURN(1)=""-1^No clean slate present"""
^XWB(8994,3020,2,0)="^8994.02A^1^1"
^XWB(8994,3020,2,1,0)="DPAT^1^^1^1"
^XWB(8994,3020,2,1,1,0)="^^1^1^3100211^"
^XWB(8994,3020,2,1,1,1,0)="The patient IEN."
^XWB(8994,3020,2,"B","DPAT",1)=""
^XWB(8994,3020,2,"PARAMSEQ",1,1)=""
^XWB(8994,3020,3,0)="^^2^2^3100211^"
^XWB(8994,3020,3,1,0)="Returns a list of all dates that a clean slate has been applied to the "
^XWB(8994,3020,3,2,0)="specified patient."
^XWB(8994,3021,0)="DENTV UPDATE COMMENT SORT^UPDATE^DENTVCC^1^A^0"
^XWB(8994,3021,1,0)="^8994.01^2^2^3100414^^"
^XWB(8994,3021,1,1,0)="This will re-sort a providers canned comments within a category. It will "
^XWB(8994,3021,1,2,0)="return a 1^Successful or -1^Unsuccessful."
^XWB(8994,3021,2,0)="^8994.02A^1^1"
^XWB(8994,3021,2,1,0)="DENTV^2^^1^1"
^XWB(8994,3021,2,1,1,0)="^8994.021^2^2^3100414^^"
^XWB(8994,3021,2,1,1,1,0)="This should be a list of ""CATEGORY^SORT ORDER^IEN"" for all of the canned "
^XWB(8994,3021,2,1,1,2,0)="comments for the provider."
^XWB(8994,3021,2,"B","DENTV",1)=""
^XWB(8994,3021,2,"PARAMSEQ",1,1)=""
^XWB(8994,3021,3,0)="^8994.03^1^1^3100414^^"
^XWB(8994,3021,3,1,0)="The return will return a 1^Successful or a -1^Unsuccessful message."
^XWB(8994,3022,0)="DENTV GET CANNED COMMENTS^GET^DENTVCC^2^A^0"
^XWB(8994,3022,1,0)="^^2^2^3100414^"
^XWB(8994,3022,1,1,0)="Returns the canned comments by provider, system, or both. The maximum "
^XWB(8994,3022,1,2,0)="number returned is 12. This limit is set by the GUI."
^XWB(8994,3022,2,0)="^8994.02A^3^3"
^XWB(8994,3022,2,1,0)="PROV^1^32^1^1"
^XWB(8994,3022,2,1,1,0)="^^1^1^3100414^"
^XWB(8994,3022,2,1,1,1,0)="Provider IEN."
^XWB(8994,3022,2,2,0)="TYP^1^1^1^2"
^XWB(8994,3022,2,2,1,0)="^^1^1^3100414^"
^XWB(8994,3022,2,2,1,1,0)="Type returns either S-system,U-user/provider,A-Both."
^XWB(8994,3022,2,3,0)="CAT^1^1^1^3"
^XWB(8994,3022,2,3,1,0)="^^6^6^3100414^"
^XWB(8994,3022,2,3,1,1,0)="Category of the canned statements."
^XWB(8994,3022,2,3,1,2,0)="1-Radiographic Findings"
^XWB(8994,3022,2,3,1,3,0)="2-Summary Assessment"
^XWB(8994,3022,2,3,1,4,0)="3-Treatment Plan"
^XWB(8994,3022,2,3,1,5,0)="4-Patient Education"
^XWB(8994,3022,2,3,1,6,0)="5-Disposition"
^XWB(8994,3022,2,"B","CAT",3)=""
^XWB(8994,3022,2,"B","PROV",1)=""
^XWB(8994,3022,2,"B","TYP",2)=""
^XWB(8994,3022,2,"PARAMSEQ",1,1)=""
^XWB(8994,3022,2,"PARAMSEQ",2,2)=""
^XWB(8994,3022,2,"PARAMSEQ",3,3)=""
^XWB(8994,3022,3,0)="^^3^3^3100414^"
^XWB(8994,3022,3,1,0)="Returns an array of up to 12 canned statements for a category. It will "
^XWB(8994,3022,3,2,0)="return all of the system specific statements first and any remainder up "
^XWB(8994,3022,3,3,0)="to 12 will be user/provider statements."
^XWB(8994,3023,0)="DENTV FILE CANNED COMMENTS^FILE^DENTVCC^1^A^0"
^XWB(8994,3023,1,0)="^^12^12^3100519^"
^XWB(8994,3023,1,1,0)="This rpc will file/update canned statements."
^XWB(8994,3023,1,2,0)="The array must contain the following:"
^XWB(8994,3023,1,3,0)="      DENTV(""PROV"") - Provider IEN"
^XWB(8994,3023,1,4,0)="      DENTV(""TYP"") - 1: system, 2: user/provider"
^XWB(8994,3023,1,5,0)="      DENTV(""CAT"") - 1: radio, 2: summary, 3: treatment, 4: educ, 5: disp"
^XWB(8994,3023,1,6,0)="      DENTV(n) - n number of records for the WP field (the comment)"
^XWB(8994,3023,1,7,0)="      DENTV(""IEN"") - Only Send this only if a record is being updated, a"
^XWB(8994,3023,1,8,0)="                     null IEN means add."
^XWB(8994,3023,1,9,0)=" "
^XWB(8994,3023,1,10,0)="      There is no sort stored in this call. The record is automatically "
^XWB(8994,3023,1,11,0)="added to the bottom. You must use DENTV UPDATE COMMENT SORT to update "
^XWB(8994,3023,1,12,0)="sorting."
^XWB(8994,3023,2,0)="^8994.02A^1^1"
^XWB(8994,3023,2,1,0)="DENTV^2^255^1^1"
^XWB(8994,3023,2,1,1,0)="^^8^8^3100519^"
^XWB(8994,3023,2,1,1,1,0)="This is the comment information that must be entered to save/update the "
^XWB(8994,3023,2,1,1,2,0)="record."
^XWB(8994,3023,2,1,1,3,0)="     DENTV(""PROV"") - Provider IEN"
^XWB(8994,3023,2,1,1,4,0)="     DENTV(""TYP"") - 1: system, 2: user"
^XWB(8994,3023,2,1,1,5,0)="     DENTV(""CAT"") - 1:radio,2:summary,3:treatment,4:educ,5:disp"
^XWB(8994,3023,2,1,1,6,0)="     DENTV(n) - n number of records for the WP field (the comment)"
^XWB(8994,3023,2,1,1,7,0)="     DENTV(""IEN"") - IEN is only used to updated an existing, null means "
^XWB(8994,3023,2,1,1,8,0)="                    add."
^XWB(8994,3023,2,"B","DENTV",1)=""
^XWB(8994,3023,2,"PARAMSEQ",1,1)=""
^XWB(8994,3023,3,0)="^^1^1^3100519^"
^XWB(8994,3023,3,1,0)="Returns 1^message^IEN^ if successful or -1^message if there is an error."
^XWB(8994,3024,0)="DENTV DEL CANNED COMMENT^DEL^DENTVCC^1^A^0"
^XWB(8994,3024,1,0)="^^3^3^3100414^"
^XWB(8994,3024,1,1,0)="Will delete a canned comment from the system. This will automatically "
^XWB(8994,3024,1,2,0)="resort the remaining records by filling in the gap (if any) left by "
^XWB(8994,3024,1,3,0)="removing the record."
^XWB(8994,3024,2,0)="^8994.02A^1^1"
^XWB(8994,3024,2,1,0)="CIEN^1^^1^1"
^XWB(8994,3024,2,1,1,0)="^8994.021^1^1^3100414^^"
^XWB(8994,3024,2,1,1,1,0)="This is the IEN of the record."
^XWB(8994,3024,2,"B","CIEN",1)=""
^XWB(8994,3024,2,"PARAMSEQ",1,1)=""
^XWB(8994,3024,3,0)="^8994.03^1^1^3100414^^"
^XWB(8994,3024,3,1,0)="Returns 1^message if successful, or -1^message if unsuccessful."
^XWB(8994,3025,0)="DENTV PERSON CLASS INQUIRY^PROVINQ^DENTVUTL^1^S"
^XWB(8994,3025,1,0)="^8994.01^2^2^3110401^"
^XWB(8994,3025,1,1,0)="This is an RPC wrapper for the Kernal call $$GET^XUA4A72 to determine the "
^XWB(8994,3025,1,2,0)="active providers class information."
^XWB(8994,3025,2,0)="^8994.02A^2^2"
^XWB(8994,3025,2,1,0)="PROV^1^^1^1"
^XWB(8994,3025,2,1,1,0)="^^1^1^3110401^"
^XWB(8994,3025,2,1,1,1,0)="The provider DUZ that is to be checked."
^XWB(8994,3025,2,2,0)="DENTDAT^1^^^2"
^XWB(8994,3025,2,2,1,0)="^^2^2^3110401^"
^XWB(8994,3025,2,2,1,1,0)="This is the date used to determine the providers class (in case a "
^XWB(8994,3025,2,2,1,2,0)="historical lookup is required)."
^XWB(8994,3025,2,"B","DENTDAT",2)=""
^XWB(8994,3025,2,"B","PROV",1)=""
^XWB(8994,3025,2,"PARAMSEQ",1,1)=""
^XWB(8994,3025,2,"PARAMSEQ",2,2)=""
^XWB(8994,3025,3,0)="^^4^4^3150226^"
^XWB(8994,3025,3,1,0)="Returns PERSON CLASS IEN^if the provider information is found and"
^XWB(8994,3025,3,2,0)="returned."
^XWB(8994,3025,3,3,0)="Returns a -1^ if an error has occured; with a brief message to determine "
^XWB(8994,3025,3,4,0)="what was wrong."
^XWB(8994,3026,0)="DENTV TP RESERVED INACT CHECK^CHKINA^DENTVTP7^1^A"
^XWB(8994,3026,1,0)="^^4^4^3110408^"
^XWB(8994,3026,1,1,0)="This RPC will perform a check on the IEN inputted and return whether or "
^XWB(8994,3026,1,2,0)="not the transaction found has been inactivated (for view only) or left "
^XWB(8994,3026,1,3,0)="alone. The check will inactivate a reserved transaction if it is more "
^XWB(8994,3026,1,4,0)="than 8 days old."
^XWB(8994,3026,2,0)="^8994.02A^1^1"
^XWB(8994,3026,2,1,0)="DENTIEN^1^^1^1"
^XWB(8994,3026,2,1,1,0)="^^2^2^3110408^"
^XWB(8994,3026,2,1,1,1,0)="This input value must be the IEN for the record contained in the DENTAL "
^XWB(8994,3026,2,1,1,2,0)="TP RESERVE (#228.7) file."
^XWB(8994,3026,2,"B","DENTIEN",1)=""
^XWB(8994,3026,2,"PARAMSEQ",1,1)=""
^XWB(8994,3026,3,0)="^^3^3^3110408^"
^XWB(8994,3026,3,1,0)="The return value will specify whether the reserved transaction has been "
^XWB(8994,3026,3,2,0)="inactivated due to being more than 8 days old, or whether the transaction "
^XWB(8994,3026,3,3,0)="is still allowed to be loaded."
^XWB(8994,3027,0)="DSIV XPAR CHGWP^CHGWP^DSIVXPR^2^A^^^1"
^XWB(8994,3027,1,0)="^8994.01^2^2^3060828^^^^"
^XWB(8994,3027,1,1,0)="This will change an instance of a System Parameter that is of the Word "
^XWB(8994,3027,1,2,0)="Processing type."
^XWB(8994,3027,2,0)="^8994.02A^2^2"
^XWB(8994,3027,2,1,0)="DATA^1^250^1^1"
^XWB(8994,3027,2,1,1,0)="^^10^10^3060828^"
^XWB(8994,3027,2,1,1,1,0)="DATA - required - p1~p2~p3"
^XWB(8994,3027,2,1,1,2,0)="  p1 := optional - entity - if not passed, set to ""SYS"" for"
^XWB(8994,3027,2,1,1,3,0)="                   current user."
^XWB(8994,3027,2,1,1,4,0)="  p2 := required - parameter name"
^XWB(8994,3027,2,1,1,5,0)="  p3 := optional - instance (default is 1)"
^XWB(8994,3027,2,1,1,6,0)=" "
^XWB(8994,3027,2,1,1,7,0)="RETURN PARAMETER DESCRIPTION:"
^XWB(8994,3027,2,1,1,8,0)=" "
^XWB(8994,3027,2,1,1,9,0)="Returns ""1^"" on success"
^XWB(8994,3027,2,1,1,10,0)="        ""-1^Error Message"" on failure"
^XWB(8994,3027,2,2,0)="ARRAY^2^250^1^2"
^XWB(8994,3027,2,2,1,0)="^8994.021^10^10^3060828^^^"
^XWB(8994,3027,2,2,1,1,0)="This is an array of the text to be stored in the parameter."
^XWB(8994,3027,2,2,1,2,0)=" "
^XWB(8994,3027,2,2,1,3,0)="Format is:"
^XWB(8994,3027,2,2,1,4,0)=" "
^XWB(8994,3027,2,2,1,5,0)="ARRAY(1)=1st line of Text"
^XWB(8994,3027,2,2,1,6,0)="ARRAY(2)=2nd line of Text"
^XWB(8994,3027,2,2,1,7,0)="ARRAY(n)=nth line of Text"
^XWB(8994,3027,2,2,1,8,0)=" "
^XWB(8994,3027,2,2,1,9,0)="ARRAY(n)="""" to store blank lines for formatting, such as paragraph "
^XWB(8994,3027,2,2,1,10,0)="            separation."
^XWB(8994,3027,2,"B","ARRAY",2)=""
^XWB(8994,3027,2,"B","DATA",1)=""
^XWB(8994,3027,2,"PARAMSEQ",1,1)=""
^XWB(8994,3027,2,"PARAMSEQ",2,2)=""
^XWB(8994,3027,3,0)="^8994.03^4^4^3060828^^^"
^XWB(8994,3027,3,1,0)="RET(0) = Code^Description     where"
^XWB(8994,3027,3,2,0)=" "
^XWB(8994,3027,3,3,0)="1^ = success."
^XWB(8994,3027,3,4,0)="-1^error message = indicates failure and reason for failure."
^XWB(8994,3028,0)="DSIV VALIDATE VI INDEX TERMS^VLDTSP^DSIVTSP^2^A^0"
^XWB(8994,3028,1,0)="^8994.01^6^6^3111027^^^^"
^XWB(8994,3028,1,1,0)="This Remote Procedure Call validates the interdependency of VI"
^XWB(8994,3028,1,2,0)="index terms.  It ensures that Type, Procedure/Event, and"
^XWB(8994,3028,1,3,0)="Specialty/SubSpecialty are active, checks to see if Type is Clinical if"
^XWB(8994,3028,1,4,0)="Procedure/Event or Specialty/SubSpecialty are input, and makes sure that"
^XWB(8994,3028,1,5,0)="the input Specialty/SubSpecialty is associated with the input"
^XWB(8994,3028,1,6,0)="Procedure/Event."
^XWB(8994,3028,2,0)="^8994.02A^3^3"
^XWB(8994,3028,2,1,0)="PROC^1^50^0^3"
^XWB(8994,3028,2,1,1,0)="^8994.021^2^2^3110829^^^"
^XWB(8994,3028,2,1,1,1,0)="PROC is the Procedure/Event which is found in file ^MAG(2005.84) as field"
^XWB(8994,3028,2,1,1,2,0)="NAME."
^XWB(8994,3028,2,2,0)="TYPE^1^40^1^1"
^XWB(8994,3028,2,2,1,0)="^8994.021^1^1^3110829^^"
^XWB(8994,3028,2,2,1,1,0)="TYPE is the Type Index which is found in file ^MAG(2005.83) as field NAME."
^XWB(8994,3028,2,3,0)="SPEC^1^30^0^2"
^XWB(8994,3028,2,3,1,0)="^8994.021^2^2^3111027^^^^"
^XWB(8994,3028,2,3,1,1,0)="SPEC is the Specialty/SubSpecialty which is found in file ^MAG(2005.85) "
^XWB(8994,3028,2,3,1,2,0)="as field NAME."
^XWB(8994,3028,2,"B","PROC",1)=""
^XWB(8994,3028,2,"B","SPEC",3)=""
^XWB(8994,3028,2,"B","TYPE",2)=""
^XWB(8994,3028,2,"PARAMSEQ",1,2)=""
^XWB(8994,3028,2,"PARAMSEQ",2,3)=""
^XWB(8994,3028,2,"PARAMSEQ",3,1)=""
^XWB(8994,3028,3,0)="^8994.03^3^3^3111027^^^^"
^XWB(8994,3028,3,1,0)="An array is returned which contains status and error message (if"
^XWB(8994,3028,3,2,0)="necessary)."
^XWB(8994,3028,3,3,0)="DSIVDV(0)=""1^Okay"" OR ""-1^error message""^error message"""
^XWB(8994,3029,0)="PSB GETINJECTIONSITE^RPC^PSBINJEC^2^P^0^^1^2"
^XWB(8994,3029,1,0)="^8994.01^4^4^3151130^^^"
^XWB(8994,3029,1,1,0)="Get the last nn injections site info from the BCMA MEDICATION LOG file "
^XWB(8994,3029,1,2,0)="#53.9.   Get only of specific Orderable Items per patient in reverse"
^XWB(8994,3029,1,3,0)="chronology date/time order or All Orderable Items per patient in "
^XWB(8994,3029,1,4,0)="reverse chronology date/time order."
^XWB(8994,3029,2,0)="^8994.02A^5^4"
^XWB(8994,3029,2,1,0)="DFN^1^^1^1"
^XWB(8994,3029,2,1,1,0)="^8994.021^1^1^3110912^^"
^XWB(8994,3029,2,1,1,1,0)="Patient IEN number."
^XWB(8994,3029,2,3,0)="TIME^1^^1^3"
^XWB(8994,3029,2,3,1,0)="^^2^2^3111020^"
^XWB(8994,3029,2,3,1,1,0)="A time range, in hours, to search backwards through the BCMA MEDICATION "
^XWB(8994,3029,2,3,1,2,0)="LOG file #53.79 for injection site data. "
^XWB(8994,3029,2,4,0)="MAX^1^^1^4"
^XWB(8994,3029,2,4,1,0)="^8994.021^2^2^3110912^^"
^XWB(8994,3029,2,4,1,1,0)="The maximum number of injection site items to return within the Time "
