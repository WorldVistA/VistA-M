^XWB(8994,3492,2,1,0)="SDECRES^1^^1^1"
^XWB(8994,3492,2,1,1,0)="^^1^1^3150128^"
^XWB(8994,3492,2,1,1,1,0)="Resource ID Pointer to SDEC RESOURCE file 409.831"
^XWB(8994,3492,2,2,0)="SDECLT^1^^1^2"
^XWB(8994,3492,2,2,1,0)="^^4^4^3150128^"
