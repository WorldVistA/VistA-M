^XWB(8994,242,0)="ORWRA REPORT TEXT^RPT^ORWRA^4^S^^^1"
^XWB(8994,242,1,0)="^^3^3^2961009^^^"
^XWB(8994,242,1,1,0)="This remote procedure call returns an array containing"
