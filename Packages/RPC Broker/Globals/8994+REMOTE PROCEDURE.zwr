^XWB(8994,2546,3,1,0)="Return RET(1)=DFN^Data filed successfully"
^XWB(8994,2546,3,2,0)=" "
^XWB(8994,2546,3,3,0)="    or RET(n)=-1^error message"
^XWB(8994,2546,3,4,0)="       RET(n)=additional error text -OPTIONAL (from DSICDDR0)"
^XWB(8994,2547,0)="DSIV ONE LOC APPOINTMENTS^REQONE^DSIVIC1^4^P^^^1"
^XWB(8994,2547,1,0)="^8994.01^2^2^3070820^^^^"
^XWB(8994,2547,1,1,0)="Request all appointments for one hospital location, with insurance"
^XWB(8994,2547,1,2,0)="flag."
^XWB(8994,2547,2,0)="^8994.02A^8^8"
^XWB(8994,2547,2,1,0)="LOCIEN^1^16^1^1"
^XWB(8994,2547,2,1,1,0)="^^1^1^3050322^"
^XWB(8994,2547,2,1,1,1,0)="Hospital Location IEN."
^XWB(8994,2547,2,2,0)="SDT^1^16^0^2"
^XWB(8994,2547,2,2,1,0)="^^1^1^3050322^"
^XWB(8994,2547,2,2,1,1,0)="FileMan start date.time (optional)."
^XWB(8994,2547,2,3,0)="EDT^1^16^0^3"
^XWB(8994,2547,2,3,1,0)=1
^XWB(8994,2547,2,3,1,1,0)="FileMan end date.time (optional)."
^XWB(8994,2547,2,4,0)="DAYS^1^10^0^4"
^XWB(8994,2547,2,4,1,0)="^8994.021^1^1^3050913^^^^"
^XWB(8994,2547,2,4,1,1,0)="Number of days prior to today for last verified check (default=182)."
^XWB(8994,2547,2,5,0)="SCREEN^1^1^0^5"
^XWB(8994,2547,2,5,1,0)="^8994.021^2^2^3060203^^"
^XWB(8994,2547,2,5,1,1,0)="Contains the type of appointment to screen out.  1=checked in (which also"
^XWB(8994,2547,2,5,1,2,0)=" screens checked out appts by default) or 2=checked out."
^XWB(8994,2547,2,6,0)="BUF^1^1^0^6"
^XWB(8994,2547,2,6,1,0)="^^2^2^3060203^"
^XWB(8994,2547,2,6,1,1,0)="This field can be set to 1 to screen out (not return) appointments if "
^XWB(8994,2547,2,6,1,2,0)="there's an existing buffer entry for that patient."
^XWB(8994,2547,2,7,0)="NUMS^1^9^0^7"
^XWB(8994,2547,2,7,1,0)="^^1^1^3060307^"
^XWB(8994,2547,2,7,1,1,0)="Contains the number of records to return for each call."
^XWB(8994,2547,2,8,0)="MORE^1^1^0^8"
^XWB(8994,2547,2,8,1,0)="^8994.021^3^3^3070820^^^"
^XWB(8994,2547,2,8,1,1,0)="Contains a 1 if this is a second call to the rpc to get more records.  "
^XWB(8994,2547,2,8,1,2,0)="Used with the NUMS field to get sets of data and not overwhelm the broker "
^XWB(8994,2547,2,8,1,3,0)="or timeout."
