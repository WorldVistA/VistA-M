^XWB(8994,3852,3,0)="^8994.03^2^2^3120605^^"
^XWB(8994,3852,3,1,0)="Returns progress of report in format:"
^XWB(8994,3852,3,2,0)="   [current progress] ^ [total progress] ^ [percent done]"
^XWB(8994,3853,0)="DSIYRPT1 EOL END OF LIFE^EOL^DSIYRPT1^4"
^XWB(8994,3853,1,0)="^^6^6^3120621^"
^XWB(8994,3853,1,1,0)="Schedules a report to retrieve equipment which has a replacement date "
^XWB(8994,3853,1,2,0)="between ""today"" and a specified future date."
^XWB(8994,3853,1,3,0)=" "
