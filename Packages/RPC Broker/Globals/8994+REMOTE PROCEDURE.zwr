^XWB(8994,5171,3,50,0)="                },"
^XWB(8994,5171,3,51,0)="                {"
^XWB(8994,5171,3,52,0)="                    ""actions"": ["
^XWB(8994,5171,3,53,0)="                        ""Enable"""
^XWB(8994,5171,3,54,0)="                    ],"
^XWB(8994,5171,3,55,0)="                    ""linkedSpecialAuthorities"": ["
^XWB(8994,5171,3,56,0)="                        ""AO"","
^XWB(8994,5171,3,57,0)="                        ""EC"","
^XWB(8994,5171,3,58,0)="                        ""IR"""
^XWB(8994,5171,3,59,0)="                    ],"
^XWB(8994,5171,3,60,0)="                    ""whenValueIs"": ""No"""
^XWB(8994,5171,3,61,0)="                },"
^XWB(8994,5171,3,62,0)="                {"
^XWB(8994,5171,3,63,0)="                    ""actions"": ["
^XWB(8994,5171,3,64,0)="                        ""Enable"""
^XWB(8994,5171,3,65,0)="                    ],"
^XWB(8994,5171,3,66,0)="                    ""linkedSpecialAuthorities"": ["
^XWB(8994,5171,3,67,0)="                        ""AO"","
^XWB(8994,5171,3,68,0)="                        ""EC"","
^XWB(8994,5171,3,69,0)="                        ""IR"""
^XWB(8994,5171,3,70,0)="                    ],"
^XWB(8994,5171,3,71,0)="                    ""whenValueIs"": ""Unanswered"""
^XWB(8994,5171,3,72,0)="                }"
^XWB(8994,5171,3,73,0)="            ]"
^XWB(8994,5171,3,74,0)="        },"
^XWB(8994,5171,3,75,0)="        {"
^XWB(8994,5171,3,76,0)="            ""abbreviation"": ""CV"","
^XWB(8994,5171,3,77,0)="            ""code"": ""CV"","
^XWB(8994,5171,3,78,0)="            ""default"": ""Unanswered"","
^XWB(8994,5171,3,79,0)="            ""description"": ""Combat Veteran (CV):\r\nTo receive CV "
^XWB(8994,5171,3,80,0)="exemption the veteran must have served in combat operations\r\nafter the "
^XWB(8994,5171,3,81,0)="Gulf War or in combat against a hostile force after November "
^XWB(8994,5171,3,82,0)="11,\r\n1998.  In addition, the condition for which the veteran is treated "
^XWB(8994,5171,3,83,0)="must be\r\nrelated to that combat, the veteran must have registered as a "
^XWB(8994,5171,3,84,0)="combat\r\nveteran, and be within two years of separation from active "
^XWB(8994,5171,3,85,0)="military\r\nservice.  Finally, the condition must not be already "
^XWB(8994,5171,3,86,0)="considered to be\r\nservice related or that exemption should apply.  See "
^XWB(8994,5171,3,87,0)="'Help' for additional\r\ninformation.\r\n"","
^XWB(8994,5171,3,88,0)="            ""disabled"": false,"
^XWB(8994,5171,3,89,0)="            ""displayName"": ""Combat &Vet (Combat Related)"","
^XWB(8994,5171,3,90,0)="            ""id"": 8,"
^XWB(8994,5171,3,91,0)="            ""package"": ["
^XWB(8994,5171,3,92,0)="                {"
^XWB(8994,5171,3,93,0)="                    ""excluded"": true,"
^XWB(8994,5171,3,94,0)="                    ""name"": ""PROBLEM LIST"""
^XWB(8994,5171,3,95,0)="                }"
^XWB(8994,5171,3,96,0)="            ],"
^XWB(8994,5171,3,97,0)="            ""sequence"": 20"
^XWB(8994,5171,3,98,0)="        },"
^XWB(8994,5171,3,99,0)="        {"
^XWB(8994,5171,3,100,0)="            ""abbreviation"": ""AO"","
^XWB(8994,5171,3,101,0)="            ""code"": ""AO"","
^XWB(8994,5171,3,102,0)="            ""default"": ""Unanswered"","
^XWB(8994,5171,3,103,0)="            ""description"": ""Agent Orange (AO):\r\nHerbicide used in "
^XWB(8994,5171,3,104,0)="Vietnam.  Veterans who were present within the borders\r\nof the Republic "
^XWB(8994,5171,3,105,0)="of Vietnam from January 1962 through May 1975 are presumed\r\nto have "
^XWB(8994,5171,3,106,0)="been exposed to Agent Orange and are eligible to receive care "
^XWB(8994,5171,3,107,0)="of\r\nconditions possibly for AO exposure without incurring copayment "
^XWB(8994,5171,3,108,0)="charges or\r\nclaims against their insurance. Some conditions associated "
^XWB(8994,5171,3,109,0)="with AO\r\nexposure: diabetes (type 2), chloracne, porphyria cutanea "
^XWB(8994,5171,3,110,0)="tarda,\r\nperipheral neuropathy and some cancers.  See 'Help' for "
^XWB(8994,5171,3,111,0)="additional\r\ninformation.\r\n"","
^XWB(8994,5171,3,112,0)="            ""disabled"": false,"
^XWB(8994,5171,3,113,0)="            ""displayName"": ""Agent &Orange Exposure"","
^XWB(8994,5171,3,114,0)="            ""id"": 2,"
^XWB(8994,5171,3,115,0)="            ""package"": ["
^XWB(8994,5171,3,116,0)="                {"
^XWB(8994,5171,3,117,0)="                    ""excluded"": false,"
^XWB(8994,5171,3,118,0)="                    ""name"": ""ORDER ENTRY\/RESULTS REPORTING"""
^XWB(8994,5171,3,119,0)="                }"
^XWB(8994,5171,3,120,0)="            ],"
^XWB(8994,5171,3,121,0)="            ""sequence"": 30,"
^XWB(8994,5171,3,122,0)="            ""valueChangeActions"": ["
^XWB(8994,5171,3,123,0)="                {"
^XWB(8994,5171,3,124,0)="                    ""actions"": ["
^XWB(8994,5171,3,125,0)="                        ""SetNo"""
^XWB(8994,5171,3,126,0)="                    ],"
^XWB(8994,5171,3,127,0)="                    ""linkedSpecialAuthorities"": ["
^XWB(8994,5171,3,128,0)="                        ""SC"""
^XWB(8994,5171,3,129,0)="                    ],"
^XWB(8994,5171,3,130,0)="                    ""whenValueIs"": ""Yes"""
^XWB(8994,5171,3,131,0)="                }"
^XWB(8994,5171,3,132,0)="            ]"
^XWB(8994,5171,3,133,0)="        },"
^XWB(8994,5171,3,134,0)="        {"
^XWB(8994,5171,3,135,0)="            ""abbreviation"": ""IR"","
^XWB(8994,5171,3,136,0)="            ""code"": ""IR"","
^XWB(8994,5171,3,137,0)="            ""default"": ""Unanswered"","
^XWB(8994,5171,3,138,0)="            ""description"": ""Ionizing Radiation (IR):\r\nVeterans exposed "
^XWB(8994,5171,3,139,0)="to ionizing radiation (IR) as a POW or while on active\r\nduty in "
^XWB(8994,5171,3,140,0)="Hiroshima and\/or Nagasaki, Japan, or who served at a nuclear\r\ndevice "
^XWB(8994,5171,3,141,0)="atmospheric testing site are eligible to receive care of any\r\nmalignant "
^XWB(8994,5171,3,142,0)="condition and certain other non-malignant conditions for IR\r\nexposure "
^XWB(8994,5171,3,143,0)="without incurring copayment charges or claims against "
^XWB(8994,5171,3,144,0)="their\r\ninsurance.  See 'Help' for additional information.\r\n"","
^XWB(8994,5171,3,145,0)="            ""disabled"": false,"
^XWB(8994,5171,3,146,0)="            ""displayName"": ""Ionizing &Radiation Exposure"","
^XWB(8994,5171,3,147,0)="            ""id"": 3,"
^XWB(8994,5171,3,148,0)="            ""sequence"": 40,"
^XWB(8994,5171,3,149,0)="            ""valueChangeActions"": ["
^XWB(8994,5171,3,150,0)="                {"
^XWB(8994,5171,3,151,0)="                    ""actions"": ["
^XWB(8994,5171,3,152,0)="                        ""SetNo"""
^XWB(8994,5171,3,153,0)="                    ],"
^XWB(8994,5171,3,154,0)="                    ""linkedSpecialAuthorities"": ["
^XWB(8994,5171,3,155,0)="                        ""SC"""
^XWB(8994,5171,3,156,0)="                    ],"
^XWB(8994,5171,3,157,0)="                    ""whenValueIs"": ""Yes"""
^XWB(8994,5171,3,158,0)="                }"
^XWB(8994,5171,3,159,0)="            ]"
^XWB(8994,5171,3,160,0)="        },"
^XWB(8994,5171,3,161,0)="        {"
^XWB(8994,5171,3,162,0)="            ""abbreviation"": ""SWAC"","
^XWB(8994,5171,3,163,0)="            ""code"": ""EC"","
^XWB(8994,5171,3,164,0)="            ""default"": ""Unanswered"","
^XWB(8994,5171,3,165,0)="            ""description"": ""Southwest Asia Conditions (SWAC):\r\nVeterans "
^XWB(8994,5171,3,166,0)="who served in Southwest Asia during the Gulf War are eligible "
^XWB(8994,5171,3,167,0)="to\r\nreceive treatment for conditions relating to this service, "
^XWB(8994,5171,3,168,0)="including\r\nexposure to depleted uranium, pesticides, anti- nerve gas "
^XWB(8994,5171,3,169,0)="pill,\r\npyridostigmine bromide, infectious diseases, chemical and "
^XWB(8994,5171,3,170,0)="biological\r\nwarfare agents, etc. without incurring copayment charges or "
