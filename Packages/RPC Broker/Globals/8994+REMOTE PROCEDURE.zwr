^XWB(8994,3921,3,0)="^^23^23^3170530^"
^XWB(8994,3921,3,1,0)="Returns items on order or partials received for a specified inventory "
^XWB(8994,3921,3,2,0)="location (inventory point)."
^XWB(8994,3921,3,3,0)="RET(item desc,txn)="
^XWB(8994,3921,3,4,0)="p1:  TXN Type (P or O)"
^XWB(8994,3921,3,5,0)="p2:   Item IEN"
^XWB(8994,3921,3,6,0)="p3:  Item Description"
^XWB(8994,3921,3,7,0)="p4:  NSN"
^XWB(8994,3921,3,8,0)="p5:  Group Category"
^XWB(8994,3921,3,9,0)="p6:  Unit of Issue"
^XWB(8994,3921,3,10,0)="p7:  TXN #"
^XWB(8994,3921,3,11,0)="p8:  PO#"
^XWB(8994,3921,3,12,0)="p9:  Vendor"
^XWB(8994,3921,3,13,0)="p10: Due In Quantity"
^XWB(8994,3921,3,14,0)="p11: # of Partials (for type ""P"") or Due Date (for type ""O"")"
^XWB(8994,3921,3,15,0)="p12: Purchase Order IEN"
^XWB(8994,3921,3,16,0)="p13: Order IEN"
^XWB(8994,3921,3,17,0)=" "
^XWB(8994,3921,3,18,0)="There may be multiple partials for a transaction in which case they are"
^XWB(8994,3921,3,19,0)="separated by a comma in piece 11, e.g. 1,2."
^XWB(8994,3921,3,20,0)=" "
^XWB(8994,3921,3,21,0)="Upon completion of the search, the value of ""0^End of Due-In Search"" will "
^XWB(8994,3921,3,22,0)="be added to the end of the return array. If this is not added then an "
^XWB(8994,3921,3,23,0)="additional search will be needed to return all Due-Ins."
^XWB(8994,3922,0)="DSIYINI GETSRCS GET SOURCES^GETSRCS^DSIYGNI4^2"
^XWB(8994,3922,1,0)="^8994.01^2^2^3130109^^"
^XWB(8994,3922,1,1,0)="Returns a list of default sources for a new item being added to the "
^XWB(8994,3922,1,2,0)="INVENTORY POINT #445 FILE."
^XWB(8994,3922,2,0)="^8994.02A^4^4"
^XWB(8994,3922,2,1,0)="STN^1^3^1^1"
^XWB(8994,3922,2,1,1,0)="^^1^1^3130109^"
^XWB(8994,3922,2,1,1,1,0)="3 digit station #"
^XWB(8994,3922,2,2,0)="TYPE^1^1^1^2"
^XWB(8994,3922,2,2,1,0)="^^1^1^3130109^"
^XWB(8994,3922,2,2,1,1,0)="Location Type: W=Warehouse, P=Primary, S=Secondary"
^XWB(8994,3922,2,3,0)="DSIYIEN^1^30^1^3"
^XWB(8994,3922,2,3,1,0)="^^1^1^3130109^"
