^XWB(8994,4289,2,"PARAMSEQ",2,2)=""
^XWB(8994,4289,3,0)="^^14^14^3140627^"
^XWB(8994,4289,3,1,0)="Error Messages:  ""-1^""_error message or ""0^""_warning message"
^XWB(8994,4289,3,2,0)="Successful Completion: "
^XWB(8994,4289,3,3,0)="If the Fieldsiptionis set to 1, only the Description field (#.1)"
^XWB(8994,4289,3,4,0)="is returned from the requested Item Master file (#441) record.  If the "
^XWB(8994,4289,3,5,0)="Fields flag is set to ""V"", all fields from the Vendor multiple are "
^XWB(8994,4289,3,6,0)="returned.  For any other value of the Fieldsiption all fields are"
^XWB(8994,4289,3,7,0)="returned from the requested record in the format:."
^XWB(8994,4289,3,8,0)=" "
^XWB(8994,4289,3,9,0)="   file number ^ IEN ^ field number ^ ""E"" ^ data (external format)"
