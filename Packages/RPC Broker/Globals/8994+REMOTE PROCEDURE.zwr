^XWB(8994,3798,3,0)="^^3^3^3170927^"
^XWB(8994,3798,3,1,0)="if error MAGRY(0) = 0 ^Error message^"
^XWB(8994,3798,3,2,0)="if success MAGRY(0) = 1"
^XWB(8994,3798,3,3,0)="           MAGRY(1..n) = images in format defined in RPC [MAGN CPRS IMAGE LIST]"
^XWB(8994,3799,0)="MAGN SET IMAGES PROPS BY IEN^SETIMGS^MAGNISET^2^R^0^^1"
^XWB(8994,3799,1,0)="^^1^1^3170531^"
^XWB(8994,3799,1,1,0)="Updates one or more image properties by image IEN"
^XWB(8994,3799,2,0)="^8994.02A^1^1"
^XWB(8994,3799,2,1,0)="MAGPARAM^2^^1^1"
^XWB(8994,3799,2,1,1,0)="^^1^1^3170531^"
