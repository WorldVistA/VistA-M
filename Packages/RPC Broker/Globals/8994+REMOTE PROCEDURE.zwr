^XWB(8994,4307,2,16,0)="DSSOFSC^1^15^0^13"
^XWB(8994,4307,2,16,1,0)="^8994.021^3^3^3141208^^"
^XWB(8994,4307,2,16,1,1,0)="Federal Supply Classification - if this value is not found in the Item "
^XWB(8994,4307,2,16,1,2,0)="Master file (#441) field FSC/PSC (#2), then it is required - IEN of"
^XWB(8994,4307,2,16,1,3,0)="Federal Supply Classification file (#441.2)"
^XWB(8994,4307,2,17,0)="DSSOPDA^1^10^0^14"
^XWB(8994,4307,2,17,1,0)="^8994.021^8^8^3141208^^"
^XWB(8994,4307,2,17,1,1,0)="Discount - Percent/Dollar Amount - a number between .1 and 99.99 for a"
^XWB(8994,4307,2,17,1,2,0)="         percent discount or a ""$"" and a number from .01 to 999999.99"
^XWB(8994,4307,2,17,1,3,0)="         for a dollar discount"
^XWB(8994,4307,2,17,1,4,0)=" "
^XWB(8994,4307,2,17,1,5,0)="NOTE:  If this purchase order has a quantity discount, then this field is"
^XWB(8994,4307,2,17,1,6,0)="set to ""Q"" and used as a flag to indicate that the discounted amount in"
^XWB(8994,4307,2,17,1,7,0)="field DSSODAM is to be applied to this item as the quantity discount"
^XWB(8994,4307,2,17,1,8,0)="amount."
