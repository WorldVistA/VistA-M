^XWB(8994,1774,3,12,0)="                          ^02: Message"
^XWB(8994,1774,3,13,0)="                          ^03: Place of the error"
^XWB(8994,1774,3,14,0)=" "
^XWB(8994,1774,3,15,0)="Otherwise, the number of users is returned in the Results[0] and the"
