^XWB(8994,4384,2,"PARAMSEQ",1,1)=""
^XWB(8994,4384,3,0)="^^8^8^3180817^"
^XWB(8994,4384,3,1,0)="Output:  "
^XWB(8994,4384,3,2,0)=" Error Message:  ""-1^""_error message"
^XWB(8994,4384,3,3,0)=" Success Message: I^XXX"
^XWB(8994,4384,3,4,0)="   where I   = Age Indicator where: "
^XWB(8994,4384,3,5,0)="                             0 = suspense is < 1 year old"
^XWB(8994,4384,3,6,0)="                             1 = suspense is >= 1 year and < 3 years old"
^XWB(8994,4384,3,7,0)="                             2 = suspense is >= 3 years old"
^XWB(8994,4384,3,8,0)="         XXX = number of days since SUSPENSE DATE"
^XWB(8994,4385,0)="DSSO CREATE PO^CREATEPO^DSSOPPO^2"
^XWB(8994,4385,1,0)="^^18^18^3180822^"
