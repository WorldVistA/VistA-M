^XWB(8994,5038,0)="SDES2 GET CLINIC AVAIL BY SVC^CLINICAVAIL^SDES2GETCLINAVL^4^R^^^0^^^1"
^XWB(8994,5038,1,0)="^8994.01^4^4^3250221^^"
^XWB(8994,5038,1,1,0)="This RPC returns clinic availability given station number, start/end "
^XWB(8994,5038,1,2,0)="dates, and primary/secondary AMIS code(s)."
^XWB(8994,5038,1,3,0)=" "
^XWB(8994,5038,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,5038,2,0)="^8994.02A^2^2"
^XWB(8994,5038,2,1,0)="SDCONTEXT^2^^1^1"
^XWB(8994,5038,2,1,1,0)="^8994.021^11^11^3240612^^"
^XWB(8994,5038,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"")"
^XWB(8994,5038,2,1,1,2,0)=" - Up to 40 Character unique ID number. "
^XWB(8994,5038,2,1,1,3,0)=" - Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5038,2,1,1,4,0)="SDCONTEXT(""USER DUZ"")"
^XWB(8994,5038,2,1,1,5,0)=" - The DUZ of the user taking action in the calling application."
^XWB(8994,5038,2,1,1,6,0)="SDCONTEXT(""USER SECID"")"
^XWB(8994,5038,2,1,1,7,0)=" - The SECID of the user taking action in the calling application."
^XWB(8994,5038,2,1,1,8,0)="SDCONTEXT(""PATIENT DFN"")"
^XWB(8994,5038,2,1,1,9,0)=" - The DFN/IEN of the target patient from the calling application."
^XWB(8994,5038,2,1,1,10,0)="SDCONTEXT(""PATIENT ICN"")"
^XWB(8994,5038,2,1,1,11,0)=" - The ICN of the target patient from the calling application."
^XWB(8994,5038,2,2,0)="SDINPUT^2^^1^2"
^XWB(8994,5038,2,2,1,0)="^8994.021^9^9^3250221^^^^"
^XWB(8994,5038,2,2,1,1,0)=" "
^XWB(8994,5038,2,2,1,2,0)="SDINPUT(""PRIMARY AMIS"")=PRIMARY AMIS CODE"
^XWB(8994,5038,2,2,1,3,0)="SDINPUT(""CREDIT AMIS"",CREDIT AMIS CODE)=""""  - can have multiple credit "
^XWB(8994,5038,2,2,1,4,0)="AMIS codes"
^XWB(8994,5038,2,2,1,5,0)="SDINPUT(""START DATE"")=START DATE"
^XWB(8994,5038,2,2,1,6,0)="SDINPUT(""END DATE"")=ENDDATE"
^XWB(8994,5038,2,2,1,7,0)="SDINPUT(""NUMBER RETURNED"")=NUMBER OF AVAILABLE SLOTS TO RETURN"
^XWB(8994,5038,2,2,1,8,0)="                           1-500, defaults to 500"
^XWB(8994,5038,2,2,1,9,0)="SDINPUT(""STATION"")=STATION NUMBER FOR LOCATION"
