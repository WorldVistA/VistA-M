^XWB(8994,4045,2,2,1,2,0)=" "
^XWB(8994,4045,2,2,1,3,0)="Which parameter file contains the values of which fields can be bulk "
^XWB(8994,4045,2,2,1,4,0)="edited?   Send Parameterfile:Instance - i.e., for equipment send:"
^XWB(8994,4045,2,2,1,5,0)="   DSIY APAR EQ PARAMETERS:DSIY ADMIN EQ"
