^XWB(8994,4094,0)="DSIYPR03 PROSUSP PROS SUSP^PROSUSP^DSIYPR03^4^^^^1"
^XWB(8994,4094,1,0)="^^17^17^3150717^"
^XWB(8994,4094,1,1,0)="PROSUSP"
^XWB(8994,4094,1,2,0)=" "
^XWB(8994,4094,1,3,0)="Display patients from the Prosthetics Suspense File"
^XWB(8994,4094,1,4,0)=" "
^XWB(8994,4094,1,5,0)="If the GUI sends a TERM=""P"", only specific patient data will be returned."
^XWB(8994,4094,1,6,0)=" - If the user enters a full SSN, only that patient's suspense records"
^XWB(8994,4094,1,7,0)="   will be returned for any status"
^XWB(8994,4094,1,8,0)=" - If the user enters a partial SSN (last 4 digits or first letter of"
^XWB(8994,4094,1,9,0)="   the last name and last 4 digits) any matching patient's suspense "
^XWB(8994,4094,1,10,0)="   records will be returned for any status"
^XWB(8994,4094,1,11,0)=" - If the user enters a name, any names which match the beginning"
^XWB(8994,4094,1,12,0)="   characters will be returned for any status"
^XWB(8994,4094,1,13,0)=" "
^XWB(8994,4094,1,14,0)="If the GUI sends no TERM, then all suspense records which are OPEN"
^XWB(8994,4094,1,15,0)="   or PENDING will be returned for any patient"
^XWB(8994,4094,1,16,0)=" "
^XWB(8994,4094,1,17,0)="The GUI may also narrow down by sending a specific STATUS"
^XWB(8994,4094,2,0)="^8994.02A^5^5"
^XWB(8994,4094,2,1,0)="TERM^1^20^0^1"
^XWB(8994,4094,2,1,1,0)="^^8^8^3150717^"
^XWB(8994,4094,2,1,1,1,0)="TERM"
