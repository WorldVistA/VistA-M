^XWB(8994,4689,0)="SDES GET LETTERS BY TYPE^GETLETTERSBYTYPE^SDES2^2^R^0^^0^^^1"
^XWB(8994,4689,1,0)="^^4^4^3250206^"
^XWB(8994,4689,1,1,0)="This RPC will retrieve a list of letters from the LETTER file ($407.5),"
^XWB(8994,4689,1,2,0)="given the letter type (required), and text to match (optional)."
^XWB(8994,4689,1,3,0)=" "
^XWB(8994,4689,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,4689,2,0)="^8994.02A^4^4"
^XWB(8994,4689,2,1,0)="TYPE^1^1^1^1"
^XWB(8994,4689,2,1,1,0)="^^6^6^3220615^"
^XWB(8994,4689,2,1,1,1,0)="This is the type of letter from the LETTER TYPE file (#407.6). Currently "
^XWB(8994,4689,2,1,1,2,0)="the values are:"
^XWB(8994,4689,2,1,1,3,0)=" N - No show"
^XWB(8994,4689,2,1,1,4,0)=" A - Appointment Cancellation"
^XWB(8994,4689,2,1,1,5,0)=" P - Preappointment Cancellation"
^XWB(8994,4689,2,1,1,6,0)=" C - Clinic Cancellation"
^XWB(8994,4689,2,2,0)="TEXT^1^15^0^2"
^XWB(8994,4689,2,2,1,0)="^^3^3^3220615^"
^XWB(8994,4689,2,2,1,1,0)="This is the text used to match record entries. If 'CHY' is passed, only "
^XWB(8994,4689,2,2,1,2,0)="records that begin with 'CHY' will be returned. This text match is in "
^XWB(8994,4689,2,2,1,3,0)="addition to the type provided."
^XWB(8994,4689,2,3,0)="BRIEF^1^1^0^3"
^XWB(8994,4689,2,3,1,0)="^^5^5^3220615^"
^XWB(8994,4689,2,3,1,1,0)="This flag indiciates that the calling application wants a 'brief' list, "
^XWB(8994,4689,2,3,1,2,0)="instead of the 'verbose' list. The verbose list contains the letter text, "
^XWB(8994,4689,2,3,1,3,0)="resulting in a larger returned data set. It may be advantageous in some "
^XWB(8994,4689,2,3,1,4,0)="cases to retrieve a brief list, and use SDES GET LETTER BY IEN to "
^XWB(8994,4689,2,3,1,5,0)="retrieve the details."
^XWB(8994,4689,2,4,0)="EASTRCKNGNMBR^1^40^0^4"
^XWB(8994,4689,2,4,1,0)="^8994.021^2^2^3250206^^^^"
^XWB(8994,4689,2,4,1,1,0)="Enterprise Appointment Scheduling (EAS) Tracking Number associated to an"
^XWB(8994,4689,2,4,1,2,0)="appointment."
^XWB(8994,4689,2,"B","BRIEF",3)=""
^XWB(8994,4689,2,"B","EASTRCKNGNMBR",4)=""
