^XWB(8994,3117,2,"PARAMSEQ",8,6)=""
^XWB(8994,3117,3,0)="^8994.03^2^2^3120618^^^^"
^XWB(8994,3117,3,1,0)="The return parameter returns a ""0"" for success. ""-1"" followed by an error message is returned if an error has occurred."
^XWB(8994,3117,3,2,0)="Subsequently an array of all matching work items and field values are returned."
^XWB(8994,3118,0)="MAGV GET ACCESSION NUM^GETACCNO^MAGVRS08^1^R^0"
^XWB(8994,3118,1,0)="^8994.01^2^2^3100915^^"
^XWB(8994,3118,1,1,0)="This RPC returns an accession number given a patient reference internal "
^XWB(8994,3118,1,2,0)="entry number and procedure reference internal entry number."
^XWB(8994,3118,2,0)="^8994.02A^3^3"
^XWB(8994,3118,2,1,0)="PATREFIEN^1^10^1^1"
^XWB(8994,3118,2,1,1,0)="^8994.021^2^2^3100915^^"
^XWB(8994,3118,2,1,1,1,0)="This is the internal entry number of the entry on the IMAGING PATIENT "
^XWB(8994,3118,2,1,1,2,0)="REFERENCE File (#2005.6) with which the procedure reference is associated."
^XWB(8994,3118,2,2,0)="PROCREFIEN^1^10^1^2"
^XWB(8994,3118,2,2,1,0)="^^2^2^3100915^"
^XWB(8994,3118,2,2,1,1,0)="This is the procedure's internal entry number on the IMAGING PROCEDURE"
^XWB(8994,3118,2,2,1,2,0)="REFERENCE File (#2005.61)."
^XWB(8994,3118,2,3,0)="OVERRIDE^1^3^0^3"
^XWB(8994,3118,2,3,1,0)="^^3^3^3100805^"
^XWB(8994,3118,2,3,1,1,0)="This parameter should be used with EXTREME CAUTION.  If set TRUE"
^XWB(8994,3118,2,3,1,2,0)="(nonzero), will suppress the validation of the procedure reference IEN"
^XWB(8994,3118,2,3,1,3,0)="against the patient reference IEN."
