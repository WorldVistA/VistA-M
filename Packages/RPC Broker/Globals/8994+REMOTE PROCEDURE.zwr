^XWB(8994,3818,0)="XUS MVI NEW PERSON UPDATE^UPDATE^XUMVINPU^1^A^^^^1^^0"
^XWB(8994,3818,1,0)="^8994.01^2^2^3190813^^^^"
^XWB(8994,3818,1,1,0)="This restricted RPC is used exclusively by the Master Veteran Index (MVI) "
^XWB(8994,3818,1,2,0)="to update an entry (by DUZ) in the VistA NEW PERSON file (#200)."
^XWB(8994,3818,2,0)="^8994.02A^2^1"
^XWB(8994,3818,2,2,0)="XUARR^2^255^1^1"
^XWB(8994,3818,2,2,1,0)="^^14^14^3190813^"
^XWB(8994,3818,2,2,1,1,0)="The IEN (DUZ) for the NEW PERSON (#200) file is required to file the other"
^XWB(8994,3818,2,2,1,2,0)="fields."
^XWB(8994,3818,2,2,1,3,0)=" "
^XWB(8994,3818,2,2,1,4,0)="  XUARR(#) = FILE #;FIELD #^FIELD NAME^INTERNAL VALUE^EXTERNAL VALUE"
