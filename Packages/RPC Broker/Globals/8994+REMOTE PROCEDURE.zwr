^XWB(8994,3282,2,1,1,4,0)="        (n)=VST^VC^ Encounter Service Category"
^XWB(8994,3282,2,1,1,5,0)="        (n)=VST^ET^Encounter Type (defaults to 'P')"
^XWB(8994,3282,2,1,1,6,0)=" "
^XWB(8994,3282,2,1,1,7,0)="        If  applicable:"
^XWB(8994,3282,2,1,1,8,0)="              "
