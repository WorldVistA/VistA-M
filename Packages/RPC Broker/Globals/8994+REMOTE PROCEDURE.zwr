^XWB(8994,2875,0)="YTQ ADMIN DELETE^DELADMIN^YTQAPI5^2^S"
^XWB(8994,2875,1,0)="^^10^10^3100923^"
^XWB(8994,2875,1,1,0)="Users who have the MHS Manager menu can delete a specified MH "
^XWB(8994,2875,1,2,0)="Administration and its MH Answers and MH Results."
^XWB(8994,2875,1,3,0)=" "
^XWB(8994,2875,1,4,0)="Please use caution as deletions cannot be restored. Only ADPACs should use"
^XWB(8994,2875,1,5,0)="this feature and in consultation with medical records policy."
^XWB(8994,2875,1,6,0)=" "
^XWB(8994,2875,1,7,0)=" "
^XWB(8994,2875,1,8,0)="Input: YS(""AD"") as internal entry number of MH ADMINISTRATIONS (#601.84) "
^XWB(8994,2875,1,9,0)="file."
^XWB(8994,2875,1,10,0)="Output: Data vs ERROR"
^XWB(8994,2875,2,0)="^8994.02A"
^XWB(8994,2876,0)="YTQ SET ANSWER ALL^SAVEALL^YTQAPI17^2^S^^^^^^1"
^XWB(8994,2876,1,0)="^^5^5^3100923^"
