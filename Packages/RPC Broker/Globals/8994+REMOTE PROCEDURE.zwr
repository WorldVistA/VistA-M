^XWB(8994,3288,1,18,0)="The number of returned array elements can optionally be restricted and"
^XWB(8994,3288,1,19,0)="the IEN of the last record returned in the previous RPC call can"
^XWB(8994,3288,1,20,0)="be provided as a starting point for work item look ups."
^XWB(8994,3288,2,0)="^8994.02A^3^3"
^XWB(8994,3288,2,1,0)="HOSTNAME^1^^0^1"
^XWB(8994,3288,2,1,1,0)="^8994.021^1^1^3151109^^"
^XWB(8994,3288,2,1,1,1,0)="If present, names the host used to select entries to return."
^XWB(8994,3288,2,2,0)="WILIMIT^1^32000^0^2"
^XWB(8994,3288,2,2,1,0)="^8994.021^1^1^3151129^^"
^XWB(8994,3288,2,2,1,1,0)="The maxium number of work items to return in one RPC call."
^XWB(8994,3288,2,3,0)="LASTIEN^1^32000^0^3"
^XWB(8994,3288,2,3,1,0)="^8994.021^1^1^3151129^^"
^XWB(8994,3288,2,3,1,1,0)="The IEN of the last work item record returned in the previous RPC call."
^XWB(8994,3288,2,"B","HOSTNAME",1)=""
^XWB(8994,3288,2,"B","LASTIEN",3)=""
^XWB(8994,3288,2,"B","WILIMIT",2)=""
