^XWB(8994,2909,3,0)="^8994.03^25^25^3090916^^^"
^XWB(8994,2909,3,1,0)="PIECE  1:-3 = FOREIGN FILE, DO NOT PURGE"
^XWB(8994,2909,3,2,0)="         -2 = QUEUED FOR JUKEBOX COPY, DO NOT PURGE"
^XWB(8994,2909,3,3,0)="         -1 = DO NOT PURGE"
^XWB(8994,2909,3,4,0)="          0 = PURGE('MAG 2005 ENTRY)!('JUKEBOX PTRS & 'EXCEPTIONS)"
^XWB(8994,2909,3,5,0)="          1 = PURGE GIVEN NORMAL DATE CRITERIA (NDC) + CONFIRMED ON JB"
^XWB(8994,2909,3,6,0)="          2 = PURGE GIVEN NDC IF TGA PRESENT"
^XWB(8994,2909,3,7,0)="          3 = PURGE IF FILE IS AT ALTERNATE NETWORK LOCATION SITE"
^XWB(8994,2909,3,8,0)="              ELSE PURGE IF AGED & UPDATE FILE REFERENCES"
^XWB(8994,2909,3,9,0)="          5 = PURGE IF AT ALTERNATE SITE,QUEUE JUKEBOX IF NOT ON JB"
^XWB(8994,2909,3,10,0)="          6 = PURGE GIVEN NORMAL DATE CRITERIA"
^XWB(8994,2909,3,11,0)="PIECE   2:0 = NONPACS"
^XWB(8994,2909,3,12,0)="         :1 = PACS"
^XWB(8994,2909,3,13,0)="PIECE    3: RECORD CATEGORY"
^XWB(8994,2909,3,14,0)="          1 = 'NO 2005 ENTRY"
^XWB(8994,2909,3,15,0)="          2 = RADIOLOGY HOLD"
^XWB(8994,2909,3,16,0)="          3 = NO JUKEBOX/JUKEBOX PTRS"
^XWB(8994,2909,3,17,0)="          4 = JUKEBOX - NO JUKEBOX PTRS (P/EXCEPT)ELSE QUEUE"
^XWB(8994,2909,3,18,0)="          5 = JUKEBOX/JUKEBOX PTRS, NO CACHE PTRS,PURGE IF CONFIRMED"
^XWB(8994,2909,3,19,0)="          6 = JUKEBOX/JUKEBOX PTRS, WRONG CACHE PTRS PURGE IF AT ALT"
^XWB(8994,2909,3,20,0)="          7 = JUKEBOX/JUKEBOX PTRS, NO CACHE PTRS, FIX PTRS"
^XWB(8994,2909,3,21,0)="          8 = JUKEBOX/JUKEBOX PTRS, CACHE PTRS, AGE (IF CONFIRMED)"
^XWB(8994,2909,3,22,0)="          9 = RECORD NOT IN THE IMAGE FILE"
^XWB(8994,2909,3,23,0)="         10 = FOREIGN IMAGE FILE"
^XWB(8994,2909,3,24,0)="         11 = NOT AN IMAGE FILE"
^XWB(8994,2909,3,25,0)="         12 = FILE LOCATION NOT VALID"
^XWB(8994,2910,0)="MD CLIO^RPC^MDCLIO^4^P^^^1"
^XWB(8994,2910,1,0)="^8994.01^2^2^3091118^^^^"
^XWB(8994,2910,1,1,0)="This is the primary RPC called by the CliO engine for normal command "
^XWB(8994,2910,1,2,0)="processing."
^XWB(8994,2910,605001)=34028
^XWB(8994,2911,0)="MDCP RESULTS BY STATUS^GTMSGIDS^MDCPHL7B^4^S^0^^1^1"
^XWB(8994,2911,1,0)="^8994.01^2^2^3091118^^^^"
^XWB(8994,2911,1,1,0)="This broker call will return a list of IENS from the CP RESULT REPORT "
^XWB(8994,2911,1,2,0)="file based on the STATUS passed in as a parameter."
^XWB(8994,2911,2,0)="^8994.02A^1^1"
^XWB(8994,2911,2,1,0)="MDCPSTAT^1^1^1^1"
^XWB(8994,2911,2,1,1,0)="^^2^2^3061030^"
^XWB(8994,2911,2,1,1,1,0)="This is the EXTERNAL representation of the status to be used to generate "
^XWB(8994,2911,2,1,1,2,0)="the list of IENs."
^XWB(8994,2911,2,"B","MDCPSTAT",1)=""
^XWB(8994,2911,2,"PARAMSEQ",1,1)=""
^XWB(8994,2911,3,0)="^8994.03^1^1^3061030^^^"
^XWB(8994,2911,3,1,0)="Returns an array of IENs."
^XWB(8994,2912,0)="MDCP MESSAGE BY IEN^GETMSG^MDCPHL7B^4^S^^^1^1"
^XWB(8994,2912,1,0)="^8994.01^1^1^3091118^^^^"
^XWB(8994,2912,1,1,0)="This RPC returns an HL7 message based on its IEN."
^XWB(8994,2912,2,0)="^8994.02A^1^1"
^XWB(8994,2912,2,1,0)="MDCPMSG^1^^1^1"
^XWB(8994,2912,2,1,1,0)="^^1^1^3060825^"
