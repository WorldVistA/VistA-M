^XWB(8994,4190,0)="XULM GET LOCK TABLE^LOCKS^XULMRPC^1^P^0"
^XWB(8994,4190,1,0)="^8994.01^3^3^3120622^^"
^XWB(8994,4190,1,1,0)="This RPC is used by the Lock Manager to obtain the lock table on a specific"
^XWB(8994,4190,1,2,0)="node.  The lock table is returned in a global."
^XWB(8994,4190,1,3,0)=""
^XWB(8994,4190,2,0)="^8994.02A^2^2"
^XWB(8994,4190,2,1,0)="LOCKGBL^1^245^1^1"
^XWB(8994,4190,2,1,1,0)="^^3^3^3120621^"
^XWB(8994,4190,2,1,1,1,0)="This is the global reference of the location where the lock table"
^XWB(8994,4190,2,1,1,2,0)="should be returned."
^XWB(8994,4190,2,1,1,3,0)=""
^XWB(8994,4190,2,2,0)="RESULT^1^200^1^2"
^XWB(8994,4190,2,2,1,0)="^^2^2^3120622^"
^XWB(8994,4190,2,2,1,1,0)="Global location to place the result."
^XWB(8994,4190,2,2,1,2,0)=""
