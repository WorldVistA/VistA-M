^XWB(8994,4370,0)="DSSO FIND SUSPENSE FROM 1358^TO668^DSSOSU5^1"
^XWB(8994,4370,1,0)="^^2^2^3180612^"
^XWB(8994,4370,1,1,0)="This RPC finds the PROSTHETIC SUSPENSE (#668) IEN associated to the "
^XWB(8994,4370,1,2,0)="requested PROSTHETICS 1358 (#664) IEN."
^XWB(8994,4370,2,0)="^8994.02A^1^1"
^XWB(8994,4370,2,1,0)="DSSO664^1^30^1^1"
^XWB(8994,4370,2,1,1,0)="^^1^1^3180612^"
^XWB(8994,4370,2,1,1,1,0)="PROSTHETICS 1358 (#664) IEN"
