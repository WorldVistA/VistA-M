^XWB(8994,4869,1,0)="^8994.01^3^3^3210622^^^^"
^XWB(8994,4869,1,1,0)="INPUT:  DATA - DEA DATA LINE ""^"" DELIMITED."
^XWB(8994,4869,1,2,0)="        NPIEN - IEN OF PROVIDER TO BE LINKED TO THIS DEA NUMBER"
^XWB(8994,4869,1,3,0)="OUTPUT: RET - DEA IEN for SUCCESS, 0 for UNSUCCESSFUL"
^XWB(8994,4869,2,0)="^8994.02A^2^2"
^XWB(8994,4869,2,1,0)="DATA^1^^1^1"
^XWB(8994,4869,2,1,1,0)="^^22^22^3181116^"
^XWB(8994,4869,2,1,1,1,0)="A STRING OF DEA INFORMATION DELIMITED BY THE ""^"""
^XWB(8994,4869,2,1,1,2,0)="  1 - PROVIDER NAME"
^XWB(8994,4869,2,1,1,3,0)="  2 - ADDRESS 1"
^XWB(8994,4869,2,1,1,4,0)="  3 - ADDRESS 2"
^XWB(8994,4869,2,1,1,5,0)="  4 - ADDRESS 3"
^XWB(8994,4869,2,1,1,6,0)="  5 - CITY"
