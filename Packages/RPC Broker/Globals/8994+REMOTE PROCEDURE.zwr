^XWB(8994,4770,2,8,1,1,0)="This is the sequence in which the data will be sorted in the return array."
^XWB(8994,4770,2,8,1,2,0)="Acceptable input:"
^XWB(8994,4770,2,8,1,3,0)="A = Ascending"
^XWB(8994,4770,2,8,1,4,0)="D = Descending"
