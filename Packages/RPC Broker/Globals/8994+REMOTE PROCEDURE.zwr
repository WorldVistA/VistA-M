^XWB(8994,4183,0)="MAGN PRECACHE BY CPT^PRECACHE^MAGNPCHE^2^R"
^XWB(8994,4183,1,0)="^^1^1^3180608^"
^XWB(8994,4183,1,1,0)="Pre-cache patient exams by CPT code"
^XWB(8994,4183,2,0)="^8994.02A^3^3"
^XWB(8994,4183,2,1,0)="IDTYPE^1^^1^1"
^XWB(8994,4183,2,1,1,0)="^^1^1^3180608^"
^XWB(8994,4183,2,1,1,1,0)="Type of ID paramater - ""DFN"" or ""ICN"""
