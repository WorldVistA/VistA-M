^XWB(8994,2545,0)="DSIV LIST ENTRIES2^LIST^DSIVIC3^4^A^^^1"
^XWB(8994,2545,1,0)="^^9^9^3101202^"
^XWB(8994,2545,1,1,0)="Returns INSURANCE BUFFER file entries for specified date range."
^XWB(8994,2545,1,2,0)=" Each return value has the form -"
^XWB(8994,2545,1,3,0)=" BUFFER IEN^DFN^ << requested fields >> ^SSN^FLAGS^SYMBOL^DIV^IMAGES^ERR"
^XWB(8994,2545,1,4,0)=" where SSN is the full patient SSN,"
^XWB(8994,2545,1,5,0)=" FLAGS are the ""iIEYH"" flags,"
^XWB(8994,2545,1,6,0)=" SYMBOL is the IIV status (where the record is in electronic processing),"
^XWB(8994,2545,1,7,0)=" DIV is the users default division, and"
^XWB(8994,2545,1,8,0)=" IMAGES is field #2 IMAGES SCANNED from the DSIV AUDIT file (#19625)"
^XWB(8994,2545,1,9,0)=" ERR is the one-line eIV error message (if applicable)"
^XWB(8994,2545,2,0)="^8994.02A^5^5"
^XWB(8994,2545,2,1,0)="SDT^1^14^1^1"
^XWB(8994,2545,2,1,1,0)="^^1^1^3060605^"
^XWB(8994,2545,2,1,1,1,0)="Start date in FileMan internal format."
^XWB(8994,2545,2,2,0)="EDT^1^14^0^2"
^XWB(8994,2545,2,2,1,0)="^^1^1^3060605^"
^XWB(8994,2545,2,2,1,1,0)="Inclusive end date in FileMan internal format (optional)."
^XWB(8994,2545,2,3,0)="FLDS^1^100^0^3"
^XWB(8994,2545,2,3,1,0)="^^1^1^3060605^"
^XWB(8994,2545,2,3,1,1,0)="Field list (optional).  If not specified .01I;.01 are returned."
^XWB(8994,2545,2,4,0)="NUMS^1^10^0^4"
^XWB(8994,2545,2,4,1,0)="^^2^2^3060605^"
^XWB(8994,2545,2,4,1,1,0)=" Contains the maximum number of entries to return per rpc call. If not"
^XWB(8994,2545,2,4,1,2,0)=" defined, then all entries will be returned (backward compatible)."
^XWB(8994,2545,2,5,0)="MORE^1^1^0^5"
^XWB(8994,2545,2,5,1,0)="^8994.021^3^3^3101202^^^^"
^XWB(8994,2545,2,5,1,1,0)=" Used with the NUMS parameter, More=0 means first call to rpc, More'=0"
^XWB(8994,2545,2,5,1,2,0)=" means get the next 'set' of NUMS records.  The data will end with a"
^XWB(8994,2545,2,5,1,3,0)=" record = $END$ to tell the gui that there are no more records."
^XWB(8994,2545,2,"B","EDT",2)=""
^XWB(8994,2545,2,"B","FLDS",3)=""
^XWB(8994,2545,2,"B","MORE",5)=""
