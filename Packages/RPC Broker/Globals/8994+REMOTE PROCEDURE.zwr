^XWB(8994,3266,0)="DSIRLTRS NATIONAL^NATIONAL^DSIRLTRS^1"
^XWB(8994,3266,1,0)="^^5^5^3130423^"
^XWB(8994,3266,1,1,0)="This RPC is a wrapper around DSIRLTRS UPDATE with the exception that it "
