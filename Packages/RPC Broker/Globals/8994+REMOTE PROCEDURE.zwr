^XWB(8994,3869,2,1,0)="STN^1^5^1^1"
^XWB(8994,3869,2,1,1,0)="^^1^1^3120628^"
^XWB(8994,3869,2,1,1,1,0)="Station Number"
^XWB(8994,3869,2,2,0)="TYPE^1^1^1^2"
^XWB(8994,3869,2,2,1,0)="^^1^1^3120703^"
^XWB(8994,3869,2,2,1,1,0)="The Type of inventory point, W=Warehouse, P=Primary, S=Secondary."
^XWB(8994,3869,2,3,0)="VAL^1^30^1^3"
^XWB(8994,3869,2,3,1,0)="^8994.021^1^1^3120717^^"
^XWB(8994,3869,2,3,1,1,0)="The search value."
