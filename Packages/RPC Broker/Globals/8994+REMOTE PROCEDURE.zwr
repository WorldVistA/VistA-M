^XWB(8994,2723,0)="TIU MED GET OBJECT^GETOBJ^TIUMED1^4^R^0^^1"
^XWB(8994,2723,1,0)="^8994.01^1^1^3090930^^^"
^XWB(8994,2723,1,1,0)="Returns the data from a TIU Object."
^XWB(8994,2723,2,0)="^8994.02A^2^2"
^XWB(8994,2723,2,1,0)="TIUDFN^1^^1^1"
^XWB(8994,2723,2,1,1,0)="^^1^1^3090916^"
^XWB(8994,2723,2,1,1,1,0)="Patient IEN."
^XWB(8994,2723,2,2,0)="TIUOBJ^1^^1^2"
^XWB(8994,2723,2,2,1,0)="^8994.021^1^1^3090930^^^"
^XWB(8994,2723,2,2,1,1,0)="Name of the TIU Object."
^XWB(8994,2723,2,"B","TIUDFN",1)=""
^XWB(8994,2723,2,"B","TIUOBJ",2)=""
^XWB(8994,2723,2,"PARAMSEQ",1,1)=""
^XWB(8994,2723,2,"PARAMSEQ",2,2)=""
^XWB(8994,2723,3,0)="^^2^2^3090930^"
^XWB(8994,2723,3,1,0)="The return array returns the value of the TIU Object in either a single or"
^XWB(8994,2723,3,2,0)="multi-line format."
^XWB(8994,2724,0)="MAG DOD GET STUDIES IEN^STUDY2^MAGDQR21^2^R^0^^0^3"
^XWB(8994,2724,1,0)="^8994.01^3^3^3120510^^^^"
^XWB(8994,2724,1,1,0)="This Remote Procedure returns information about studies,"
^XWB(8994,2724,1,2,0)="based upon the IEN (File #2005 or #2005.1) of the image group, Patient Number,"
^XWB(8994,2724,1,3,0)="Study-Level Only Flag, and Include Deleted Images Flag that are provided as parameters."
^XWB(8994,2724,2,0)="^8994.02A^4^4"
^XWB(8994,2724,2,1,0)="GROUPS^2^1000^1^1"
^XWB(8994,2724,2,1,1,0)="^8994.021^6^6^3120117^^"
^XWB(8994,2724,2,1,1,1,0)="This parameter can either be provided as a single value or as an array."
^XWB(8994,2724,2,1,1,2,0)="Each value found (either GROUPS or GROUPS(i)) will be evaluated by the Remote Procedure."
^XWB(8994,2724,2,1,1,3,0)="Each value found must be the IEN in file #2005 or #2005.1 of a group of images."
^XWB(8994,2724,2,1,1,4,0)="For each group specified, the Remote Procedure will find the study to which"
^XWB(8994,2724,2,1,1,5,0)="that group belongs, and then return"
^XWB(8994,2724,2,1,1,6,0)="a hierarchical list of all series and images in that study."
^XWB(8994,2724,2,2,0)="REQDFN^1^50^1^2"
^XWB(8994,2724,2,2,1,0)="^^1^1^3120117^"
^XWB(8994,2724,2,2,1,1,0)="This parameter is Patient Number who owns the images."
^XWB(8994,2724,2,3,0)="IMGLESS^1^1^0^3"
^XWB(8994,2724,2,3,1,0)="^8994.021^3^3^3120117^^"
^XWB(8994,2724,2,3,1,1,0)="This parameter is an indicator whether to get only Study-Level or include all images."
^XWB(8994,2724,2,3,1,2,0)="Pass ""1"" to get only Study-Level data."
^XWB(8994,2724,2,3,1,3,0)="Pass null or empty string to include all images."
^XWB(8994,2724,2,4,0)="FLAGS^1^1^1^4"
^XWB(8994,2724,2,4,1,0)="^^4^4^3230303^"
^XWB(8994,2724,2,4,1,1,0)="This parameter is a set of indicators that will activate optional return "
^XWB(8994,2724,2,4,1,2,0)="information."
^XWB(8994,2724,2,4,1,3,0)="If FLAGS contains ""D"", the return will include Deleted Images."
^XWB(8994,2724,2,4,1,4,0)="If FLAGS contains ""S"", the return will include the Series Description."
^XWB(8994,2724,2,"B","FLAGS",4)=""
^XWB(8994,2724,2,"B","GROUPS",1)=""
^XWB(8994,2724,2,"B","IMGLESS",3)=""
^XWB(8994,2724,2,"B","REQDFN",2)=""
^XWB(8994,2724,2,"PARAMSEQ",1,1)=""
^XWB(8994,2724,2,"PARAMSEQ",2,2)=""
^XWB(8994,2724,2,"PARAMSEQ",3,3)=""
^XWB(8994,2724,2,"PARAMSEQ",4,4)=""
^XWB(8994,2724,3,0)="^8994.03^28^28^3120510^^^^"
^XWB(8994,2724,3,1,0)="This Remote Procedure returns an array with information."
^XWB(8994,2724,3,2,0)="If there is an error in the execution of the Remote Procedure,"
^XWB(8994,2724,3,3,0)="the first element of this array with start with a negative number,"
^XWB(8994,2724,3,4,0)="and the rest of the value in that array element will describe the error."
^XWB(8994,2724,3,5,0)=" "
^XWB(8994,2724,3,6,0)="Otherwise, the value of the first element is the number of valid further elements"
^XWB(8994,2724,3,7,0)="and each further element of the output array will follow the"
^XWB(8994,2724,3,8,0)="general format of a keyword, then a vertical bar, and then one or more"
^XWB(8994,2724,3,9,0)="values associated with that keyword."
^XWB(8994,2724,3,10,0)="For example:"
^XWB(8994,2724,3,11,0)="    OUT(1)=17"
^XWB(8994,2724,3,12,0)="    OUT(2)=""STUDY_UID|1.2.840.113754.1.4.660.1.108"""
^XWB(8994,2724,3,13,0)="    OUT(3)=""STUDY_PAT|35|9865827312V582731|IMAGPATIENT35,35"""
^XWB(8994,2724,3,14,0)="    OUT(4)=""SERIES_UID|"""
^XWB(8994,2724,3,15,0)="    OUT(5)=""SERIES_IEN|6196"""
^XWB(8994,2724,3,16,0)="    OUT(6)=""SERIES_NUMBER|1"""
^XWB(8994,2724,3,17,0)="    OUT(7)=""IMAGE_UID|1.2.840.113754.1.4.660.1.108.59498.43402.0"""
^XWB(8994,2724,3,18,0)="    OUT(8)=""IMAGE_IEN|6197"""
^XWB(8994,2724,3,19,0)="    OUT(9)=""IMAGE_NUMBER|1"""
^XWB(8994,2724,3,20,0)="   OUT(10)=""IMAGE_ABSTRACT|\\vhaiswclu4\User1$\EdD\Image_Gold\DM\00\61\DM006197.ABS"""
^XWB(8994,2724,3,21,0)="   OUT(11)=""IMAGE_FULL|\\vhaiswclu4\User1$\EdD\Image_Gold\DM\00\61\DM006197.DCM"""
^XWB(8994,2724,3,22,0)="   OUT(12)=""IMAGE_TEXT|\\vhaiswclu4\User1$\EdD\Image_Gold\DM\00\61\DM006197.TXT"""
^XWB(8994,2724,3,23,0)="   OUT(13)=""IMAGE_UID|1.2.840.113754.1.4.660.1.108.59498.43402.1"""
^XWB(8994,2724,3,24,0)="   OUT(14)=""IMAGE_IEN|6198"""
^XWB(8994,2724,3,25,0)="   OUT(15)=""IMAGE_NUMBER|1"""
^XWB(8994,2724,3,26,0)="   OUT(16)=""IMAGE_ABSTRACT|\\vhaiswclu4\User1$\EdD\Image_Gold\DM\00\61\DM006198.ABS"""
^XWB(8994,2724,3,27,0)="   OUT(17)=""IMAGE_FULL|\\vhaiswclu4\User1$\EdD\Image_Gold\DM\00\61\DM006198.DCM"""
^XWB(8994,2724,3,28,0)="   OUT(18)=""IMAGE_TEXT|\\vhaiswclu4\User1$\EdD\Image_Gold\DM\00\61\DM006198.TXT"""
^XWB(8994,2725,0)="MAG DOD GET STUDIES UID^STUDY1^MAGDQR21^2^R^0^^0^3"
^XWB(8994,2725,1,0)="^8994.01^2^2^3061107^^"
^XWB(8994,2725,1,1,0)="This Remote Procedure returns information about studies,"
^XWB(8994,2725,1,2,0)="based upon the Study UID that is provided as a parameter."
^XWB(8994,2725,2,0)="^8994.02A^1^1"
^XWB(8994,2725,2,1,0)="STUDIES^2^1000^1^1"
^XWB(8994,2725,2,1,1,0)="^8994.021^5^5^3061107^^^"
^XWB(8994,2725,2,1,1,1,0)="This parameter can either be provided as a single value or as an array."
^XWB(8994,2725,2,1,1,2,0)="Each value found (either STUDIES or STUDIES(i)) will be evaluated by the Remote Procedure."
^XWB(8994,2725,2,1,1,3,0)="Each value found must be the UID of a study."
^XWB(8994,2725,2,1,1,4,0)="For each study specified, the Remote Procedure will return"
^XWB(8994,2725,2,1,1,5,0)="a hierarchical list of all series and images in that study."
^XWB(8994,2725,2,"B","STUDIES",1)=""
