^XWB(8994,4331,3,0)="^8994.03^7^7^3230104^^^^"
^XWB(8994,4331,3,1,0)="Output:"
^XWB(8994,4331,3,2,0)="  Error Messages:"
^XWB(8994,4331,3,3,0)="    DSSORET=""-1^""_error message or ""0^""_error message"
^XWB(8994,4331,3,4,0)="  Successful Completion:"
^XWB(8994,4331,3,5,0)="    DSSORET= ""1"" ^ AMIS Grouper ^ ""STOCK ISSUE CREATED SUCCESSFULLY"""
^XWB(8994,4331,3,6,0)="      where AMIS Grouper = a number that groups related Stock Issues"
^XWB(8994,4331,3,7,0)="        together"
^XWB(8994,4332,0)="DSSO SI BUILD CPT MODIFIER 1^CPT^DSSOSTC^2^^^^1"
^XWB(8994,4332,1,0)="^^11^11^3150401^"
^XWB(8994,4332,1,1,0)="This RPC provides values that may be selected when building the CPT "
^XWB(8994,4332,1,2,0)="Modifier for a HCPCS on a Stock Issue.  More than one value may be "
^XWB(8994,4332,1,3,0)="selected from several possible groups, but only one value will be"
^XWB(8994,4332,1,4,0)="selected per group. If presented to the user, a value from both groups"
^XWB(8994,4332,1,5,0)="1 and 2 must be selected."
^XWB(8994,4332,1,6,0)=" "
^XWB(8994,4332,1,7,0)="To complete the CPT Modifier, RPC DSSO SI BUILD CPT MODIFIER 2 must"
^XWB(8994,4332,1,8,0)="be run."
^XWB(8994,4332,1,9,0)=" "
^XWB(8994,4332,1,10,0)="NOTE:  CPT Modifier is not a required field, so the return of an empty "
^XWB(8994,4332,1,11,0)="list is a valid response."
^XWB(8994,4332,2,0)="^8994.02A^1^1"
^XWB(8994,4332,2,1,0)="DSSORDA^1^30^1^1"
^XWB(8994,4332,2,1,1,0)="^8994.021^9^9^3150401^^^"
^XWB(8994,4332,2,1,1,1,0)="DSSORDA - string containing:"
^XWB(8994,4332,2,1,1,2,0)="   PSAS HCPCS - file 661.1 IEN"
^XWB(8994,4332,2,1,1,3,0)="   Type of Transaction - ""I"" - Initial Issue"
^XWB(8994,4332,2,1,1,4,0)="                         ""X"" - Repair"
^XWB(8994,4332,2,1,1,5,0)="                         ""R"" - Replace"
^XWB(8994,4332,2,1,1,6,0)="                         ""S"" - Spare"
^XWB(8994,4332,2,1,1,7,0)="   Source - ""V"" - VA"
^XWB(8994,4332,2,1,1,8,0)="            ""C"" - Commercial"
^XWB(8994,4332,2,1,1,9,0)="   File Used:  660, 664, or 664.1"
^XWB(8994,4332,2,"B","DSSORDA",1)=""
^XWB(8994,4332,2,"PARAMSEQ",1,1)=""
^XWB(8994,4332,3,0)="^^31^31^3150401^"
^XWB(8994,4332,3,1,0)="Output:"
^XWB(8994,4332,3,2,0)="  Error Messages: ""-1^"" error message"
^XWB(8994,4332,3,3,0)="   Error Messages returned:"
^XWB(8994,4332,3,4,0)="    ""-1^HCPCS is required."""
^XWB(8994,4332,3,5,0)="    ""-1^Type of Transaction is required."""
^XWB(8994,4332,3,6,0)="    ""-1^Source is required."""
^XWB(8994,4332,3,7,0)=" "
^XWB(8994,4332,3,8,0)="  Warning Messages: ""0^""_warning message"
^XWB(8994,4332,3,9,0)="   Warning Messages returned:"
^XWB(8994,4332,3,10,0)="    ""0^No CPT Modifier found in file 661.1."""
^XWB(8994,4332,3,11,0)="    ""0^No CPT Modifier for this HCPCS."""
^XWB(8994,4332,3,12,0)=" "
^XWB(8994,4332,3,13,0)="  Successful Completion:"
^XWB(8994,4332,3,14,0)="    List of CPT Modifier values that may be chosen in format:"
^XWB(8994,4332,3,15,0)="      Group # ^ CPT Modifier Abbreviation ^ CPT Modifier Description"
^XWB(8994,4332,3,16,0)="    "
^XWB(8994,4332,3,17,0)="    There could be three groups of choices based on the CPT Modifier"
^XWB(8994,4332,3,18,0)="    (#.03) in the Prosthetic HCPCS file (#661.1) for the selected HCPCS"
^XWB(8994,4332,3,19,0)="    (#.01).  If presented to the user, one value must be chosen from "
^XWB(8994,4332,3,20,0)="    groups 1 and 2.  "
^XWB(8994,4332,3,21,0)=" "
^XWB(8994,4332,3,22,0)="      DSSORET(1)=""1^LT^Left"""
^XWB(8994,4332,3,23,0)="      DSSORET(2)=""1^RT^Right"""
^XWB(8994,4332,3,24,0)="      DSSORET(3)=""1^LT,RT^Both Left and Right"""
^XWB(8994,4332,3,25,0)="      DSSORET(4)=""2^KM^New Impression/Moulage"""
^XWB(8994,4332,3,26,0)="      DSSORET(5)=""2^KN^Previous Master Model"""
^XWB(8994,4332,3,27,0)="      DSSORET(6)=""2^KM,KN^Both KM and KN"""
^XWB(8994,4332,3,28,0)="      DSSORET(7)=""3^RR^Rental"""
^XWB(8994,4332,3,29,0)=" "
^XWB(8994,4332,3,30,0)="NOTE:  CPT Modifier is not a required field, so the return of an empty "
^XWB(8994,4332,3,31,0)="list is a valid response."
^XWB(8994,4333,0)="DSSO SI BUILD CPT MODIFIER 2^BLDCPT^DSSOSTC^1"
^XWB(8994,4333,1,0)="^^8^8^3150401^"
^XWB(8994,4333,1,1,0)="This RPC completes the building of the CPT Modifier and must be run "
^XWB(8994,4333,1,2,0)="following RPC DSSO SI BUILD CPT MODIFIER 1.  The CPT Modifier created "
^XWB(8994,4333,1,3,0)="during DSSO SI BUILD CPT MODIFIER 1 is input into this RPC in order for "
^XWB(8994,4333,1,4,0)="the CPT Modifier to be created completely."
^XWB(8994,4333,1,5,0)=" "
^XWB(8994,4333,1,6,0)=" "
^XWB(8994,4333,1,7,0)="NOTE:  CPT Modifier is not a required field, so it is valid for no CPT"
^XWB(8994,4333,1,8,0)="       Modifier to be returned from this RPC."
^XWB(8994,4333,2,0)="^8994.02A^2^2"
^XWB(8994,4333,2,1,0)="RMCPT^1^15^1^1"
^XWB(8994,4333,2,1,1,0)="^^3^3^3150401^"
^XWB(8994,4333,2,1,1,1,0)="RMCPT - The CPT Modifiers chosen in RPC DSSO SI BLD CPT MODIFIER 1 "
^XWB(8994,4333,2,1,1,2,0)="combined into one comma-delimited string.  Do not include a comma on the "
^XWB(8994,4333,2,1,1,3,0)="end of this string."
^XWB(8994,4333,2,2,0)="DSSORDA^1^30^1^2"
^XWB(8994,4333,2,2,1,0)="^8994.021^12^12^3150401^^^"
^XWB(8994,4333,2,2,1,1,0)="DSSORDA - string containing:"
^XWB(8994,4333,2,2,1,2,0)="  PSAS HCPCS - file 661.1 IEN"
^XWB(8994,4333,2,2,1,3,0)="  Type of Transaction - ""I"" - Initial Issue"
^XWB(8994,4333,2,2,1,4,0)="                        ""X"" - Repair"
^XWB(8994,4333,2,2,1,5,0)="                        ""R"" - Replace"
^XWB(8994,4333,2,2,1,6,0)="                        ""S"" - Spare"
^XWB(8994,4333,2,2,1,7,0)="  Source - ""V"" - VA"
^XWB(8994,4333,2,2,1,8,0)="           ""C"" - Commercial"
^XWB(8994,4333,2,2,1,9,0)="  File Used - 660, 664, or 664.1"
^XWB(8994,4333,2,2,1,10,0)=" "
^XWB(8994,4333,2,2,1,11,0)="This parameter is formatted exactly as in RPC DSSO SI BUILD CPT MODIFIER"
^XWB(8994,4333,2,2,1,12,0)="1."
^XWB(8994,4333,2,"B","DSSORDA",2)=""
^XWB(8994,4333,2,"B","RMCPT",1)=""
^XWB(8994,4333,2,"PARAMSEQ",1,1)=""
^XWB(8994,4333,2,"PARAMSEQ",2,2)=""
^XWB(8994,4333,3,0)="^^20^20^3150401^"
^XWB(8994,4333,3,1,0)="Output:"
^XWB(8994,4333,3,2,0)="  Error Messages: ""-1^""_error message"
^XWB(8994,4333,3,3,0)="   Error messages include:"
^XWB(8994,4333,3,4,0)="     ""-1^CPT Modifier is required."""
^XWB(8994,4333,3,5,0)="     ""-1^HCPCS is required."" "
^XWB(8994,4333,3,6,0)="     ""-1^Type of Transaction is required."""
^XWB(8994,4333,3,7,0)="     ""-1^Source is required."""
^XWB(8994,4333,3,8,0)=" "
^XWB(8994,4333,3,9,0)="  Warning Messages:  ""0^""_warning message"
^XWB(8994,4333,3,10,0)="   Warning messages include:"
^XWB(8994,4333,3,11,0)="     ""0^No CPT Modifier found in file 661.1."""
^XWB(8994,4333,3,12,0)="     ""0^No CPT Modifier for this HCPCS."""
^XWB(8994,4333,3,13,0)=" "
^XWB(8994,4333,3,14,0)="  Successful Completion:"
^XWB(8994,4333,3,15,0)="    DSSORET= ""1^""_comma-delimited CPT Modifier string with no final comma"
^XWB(8994,4333,3,16,0)="    "
^XWB(8994,4333,3,17,0)="    Example:  DSSORET=""1^LT,RT,KM,KN,RR,PL,GY,QH,KA"""
^XWB(8994,4333,3,18,0)=" "
^XWB(8994,4333,3,19,0)="NOTE:  CPT Modifier is not a required field, so it is valid for no CPT "
^XWB(8994,4333,3,20,0)="       Modifier to be returned from this RPC."
^XWB(8994,4334,0)="DSSO GET 445 MANDATORY SOURCE^MANDSRC^DSSOSTU^1"
^XWB(8994,4334,1,0)="^8994.01^5^5^3150403^^^"
^XWB(8994,4334,1,1,0)="This RPC returns the Mandatory or Requested Source field (#.4) for a "
^XWB(8994,4334,1,2,0)="specified Inventory Item (sub-file #445.01) from the Generic Inventory "
^XWB(8994,4334,1,3,0)="file (#445).  NOTE:  The internal format of the Mandatory or Requested "
^XWB(8994,4334,1,4,0)="Source field points to either the Vendor file (#440) or the Generic "
^XWB(8994,4334,1,5,0)="Inventory file (#445)."
^XWB(8994,4334,2,0)="^8994.02A^2^2"
^XWB(8994,4334,2,1,0)="DSSO445^1^15^1^1"
^XWB(8994,4334,2,1,1,0)="^^1^1^3150403^"
^XWB(8994,4334,2,1,1,1,0)="DSSO445 - Generic Inventory file (#445) IEN"
^XWB(8994,4334,2,2,0)="DSSO441^1^15^1^2"
^XWB(8994,4334,2,2,1,0)="^8994.021^1^1^3150403^^^"
^XWB(8994,4334,2,2,1,1,0)="DSSO441 - Item Master file (#441) IEN"
^XWB(8994,4334,2,"B","DSSO441",2)=""
^XWB(8994,4334,2,"B","DSSO445",1)=""
^XWB(8994,4334,2,"PARAMSEQ",1,1)=""
^XWB(8994,4334,2,"PARAMSEQ",2,2)=""
^XWB(8994,4334,3,0)="^^15^15^3150403^"
^XWB(8994,4334,3,1,0)="Output:"
^XWB(8994,4334,3,2,0)="  Error Messages:  ""-1^""_error message"
^XWB(8994,4334,3,3,0)="    Error messages sent by this RPC:    "
^XWB(8994,4334,3,4,0)="      ""-1^File 445 IEN is required."""
^XWB(8994,4334,3,5,0)="      ""-1^File 441 IEN is required.""      "
^XWB(8994,4334,3,6,0)="      ""-1^Invalid Inventory Point"""
^XWB(8994,4334,3,7,0)="      ""-1^Invalid Inventory Item"""
^XWB(8994,4334,3,8,0)="    Warning messages sent:"
^XWB(8994,4334,3,9,0)="      ""0^Inventory Item not found.""  "
^XWB(8994,4334,3,10,0)=" "
^XWB(8994,4334,3,11,0)="Successful Completion:"
^XWB(8994,4334,3,12,0)="    DSSORET= ^-pc 1 - ""1"""
^XWB(8994,4334,3,13,0)="              ^-pc 2 - sub-file 445.01 field .4 - external format"
^XWB(8994,4334,3,14,0)="              ^-pc 3 - sub-file 445.01 field .4 - internal format"
^XWB(8994,4334,3,15,0)="      example:  DSSORET=""1^PSC INC.^2571;PRC(440,"""
^XWB(8994,4335,0)="DSSO GET 445 INVENTORY ITEM^ITEM445^DSSOSTU^4^^^^1"
^XWB(8994,4335,1,0)="^^2^2^3150403^"
^XWB(8994,4335,1,1,0)="This RPC returns all fields for a specified Inventory Item and Inventory "
^XWB(8994,4335,1,2,0)="Point from the Generic Inventory file (#445)."
^XWB(8994,4335,2,0)="^8994.02A^2^2"
^XWB(8994,4335,2,1,0)="DSSO445^1^15^1^1"
^XWB(8994,4335,2,1,1,0)="^^1^1^3150403^"
^XWB(8994,4335,2,1,1,1,0)="Generic Inventory file (#445) IEN"
^XWB(8994,4335,2,2,0)="DSSO441^1^15^1^2"
^XWB(8994,4335,2,2,1,0)="^^1^1^3150403^"
