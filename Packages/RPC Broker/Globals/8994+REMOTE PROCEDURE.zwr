^XWB(8994,3976,2,1,0)="TIIEN^1^15^0^1"
^XWB(8994,3976,2,1,1,0)="^8994.021^3^3^3131008^^"
^XWB(8994,3976,2,1,1,1,0)="TIIEN"
^XWB(8994,3976,2,1,1,2,0)=" "
