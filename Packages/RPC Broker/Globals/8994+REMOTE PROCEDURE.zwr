^XWB(8994,3272,2,"PARAMSEQ",4,4)=""
^XWB(8994,3272,3,0)="^8994.03^1^1^3130820^^"
^XWB(8994,3272,3,1,0)="Y Returns successful filing status or error message"
^XWB(8994,3273,0)="DVBA CAPRI EXAM LINK TIU^LINK^DVBAXML^1^S^^^^1"
^XWB(8994,3273,1,0)="^8994.01^1^1^3130829^^^"
^XWB(8994,3273,1,1,0)="Links an exam in CAPRI TEMPLATES #396.17 to TIU DOCUMENT #8925"
^XWB(8994,3273,2,0)="^8994.02A^2^2"
^XWB(8994,3273,2,1,0)="EXAMIEN^1^^1^1"
^XWB(8994,3273,2,1,1,0)="^8994.021^1^1^3130829^^"
^XWB(8994,3273,2,1,1,1,0)="the exam ien in CAPRI TEMPLATES #396.17"
^XWB(8994,3273,2,2,0)="TIUIEN^1^^1^2"
^XWB(8994,3273,2,2,1,0)="^8994.021^1^1^3130829^^"
^XWB(8994,3273,2,2,1,1,0)="the tiu ien in TIU DOCUMENT #8925"
^XWB(8994,3273,2,"B","EXAMIEN",1)=""
^XWB(8994,3273,2,"B","TIUIEN",2)=""
^XWB(8994,3273,2,"PARAMSEQ",1,1)=""
^XWB(8994,3273,2,"PARAMSEQ",2,2)=""
^XWB(8994,3273,3,0)="^8994.03^2^2^3130829^^"
^XWB(8994,3273,3,1,0)="returns 1 if the exam has been successfully linked to the TIU DOCUMENT;"
^XWB(8994,3273,3,2,0)="otherwise return 0^error message"
^XWB(8994,3274,0)="DVBA CAPRI GET EXAM IEN^GETEXAM^DVBAXML^1^S^^^^1"
^XWB(8994,3274,1,0)="^8994.01^2^2^3130829^^^^"
^XWB(8994,3274,1,1,0)="get an exam ien from the CAPRI TEMMPLATE #396.17 given a"
^XWB(8994,3274,1,2,0)="tiu ien from TIU DOCUMENT #8925"
^XWB(8994,3274,2,0)="^8994.02A^1^1"
^XWB(8994,3274,2,1,0)="TIUIEN^1^^1^1"
^XWB(8994,3274,2,1,1,0)="^8994.021^1^1^3130829^^"
^XWB(8994,3274,2,1,1,1,0)="the tiu ien in TIU DOCUMENT #8925"
^XWB(8994,3274,2,"B","TIUIEN",1)=""
^XWB(8994,3274,2,"PARAMSEQ",1,1)=""
^XWB(8994,3274,3,0)="^8994.03^2^2^3130829^^^"
^XWB(8994,3274,3,1,0)="returns a integer greater than zero if the exam can be found;"
^XWB(8994,3274,3,2,0)="otherwise return -1^error message"
^XWB(8994,3275,0)="EC ICD10IMPLEMENTATIONDATE^ICD10^ECVICDDT^4^R^0^^1"
^XWB(8994,3275,1,0)="^8994.01^2^2^3140124^^^"
^XWB(8994,3275,1,1,0)="The EC ICD10IMPLEMENTATIONDATE RPC returns the Implementation Date of"
^XWB(8994,3275,1,2,0)="ICD-10 Code Set in MM/DD/YYYY format OR  -1^Error Message."
^XWB(8994,3276,0)="ROR LIST ICD^ICDLIST^RORRP016^4^R^^^1^1"
^XWB(8994,3276,1,0)="^^3^3^3120229^"
^XWB(8994,3276,1,1,0)="The ROR LIST ICD remote procedure returns a list of ICD codes (from"
^XWB(8994,3276,1,2,0)="the ICD DIAGNOSIS or ICD OPERATION/PROCEDURE file), which conform the"
^XWB(8994,3276,1,3,0)="criteria.                                      "
^XWB(8994,3276,2,0)="^8994.02A^6^6"
^XWB(8994,3276,2,1,0)="PART^1^30^^2"
^XWB(8994,3276,2,1,1,0)="^8994.021^1^1^3050907^^"
^XWB(8994,3276,2,1,1,1,0)="The partial match restriction."
^XWB(8994,3276,2,2,0)="FLAGS^1^^^3"
^XWB(8994,3276,2,2,1,0)="^^23^23^3060622^"
^XWB(8994,3276,2,2,1,1,0)="Flags that control the execution (can be combined):"
^XWB(8994,3276,2,2,1,2,0)=" "
^XWB(8994,3276,2,2,1,3,0)="  A  Exclude active codes"
^XWB(8994,3276,2,2,1,4,0)=" "
^XWB(8994,3276,2,2,1,5,0)="  B  Backwards. Traverses the index in the opposite"
^XWB(8994,3276,2,2,1,6,0)="     direction of normal traversal"
^XWB(8994,3276,2,2,1,7,0)=" "
^XWB(8994,3276,2,2,1,8,0)="  D  Full search by description"
^XWB(8994,3276,2,2,1,9,0)=" "
^XWB(8994,3276,2,2,1,10,0)="  F  Exclude codes applicable to females only"
^XWB(8994,3276,2,2,1,11,0)=" "
^XWB(8994,3276,2,2,1,12,0)="  I  Exclude inactive codes"
^XWB(8994,3276,2,2,1,13,0)=" "
^XWB(8994,3276,2,2,1,14,0)="  K  Search in description keywords"
^XWB(8994,3276,2,2,1,15,0)=" "
^XWB(8994,3276,2,2,1,16,0)="  M  Exclude codes applicable to males only"
^XWB(8994,3276,2,2,1,17,0)=" "
^XWB(8994,3276,2,2,1,18,0)="  0  Return operation/procedure codes from the ICD "
^XWB(8994,3276,2,2,1,19,0)="     OPERATION/PROCEDURE file (#80.1) instead of "
^XWB(8994,3276,2,2,1,20,0)="     diagnosis codes from the ICD DIAGNOSIS file (#80)"
^XWB(8994,3276,2,2,1,21,0)=" "
^XWB(8994,3276,2,2,1,22,0)="  P  Exclude codes that are not acceptable"
^XWB(8994,3276,2,2,1,23,0)="     as primary diagnoses"
^XWB(8994,3276,2,3,0)="NUMBER^1^^^4"
^XWB(8994,3276,2,3,1,0)="^8994.021^2^2^3050907^^"
^XWB(8994,3276,2,3,1,1,0)="Maximum number of entries to return. A value of ""*"" or no value in this "
^XWB(8994,3276,2,3,1,2,0)="parameter designates all entries."
^XWB(8994,3276,2,4,0)="FROM^1^^^5"
^XWB(8994,3276,2,4,1,0)="^8994.021^13^13^3050907^^^^"
^XWB(8994,3276,2,4,1,1,0)="The index entry(s) from which to begin the list"
^XWB(8994,3276,2,4,1,2,0)="   ^01: FromName"
^XWB(8994,3276,2,4,1,3,0)="   ^02: FromIEN"
^XWB(8994,3276,2,4,1,4,0)="  "
^XWB(8994,3276,2,4,1,5,0)="For example, a FROM value of ""18"" would list entries following 18. You can"
^XWB(8994,3276,2,4,1,6,0)="use the 2-nd and 3-rd ""^""- pieces of the Results[0] to continue the"
^XWB(8994,3276,2,4,1,7,0)="listing in the subsequent procedure calls."
^XWB(8994,3276,2,4,1,8,0)="  "
^XWB(8994,3276,2,4,1,9,0)="NOTE: The FROM value itself is not included in the"
^XWB(8994,3276,2,4,1,10,0)="      resulting list."
^XWB(8994,3276,2,4,1,11,0)="  "
^XWB(8994,3276,2,4,1,12,0)="See description of the LIST^DIC for more details about the PART, NUMBER "
^XWB(8994,3276,2,4,1,13,0)="and FROM parameters."
^XWB(8994,3276,2,5,0)="DATE^1^^^1"
^XWB(8994,3276,2,5,1,0)="^8994.021^1^1^3120229^^^^"
^XWB(8994,3276,2,5,1,1,0)="Date for the code set versioning."
^XWB(8994,3276,2,6,0)="ICDTYPE^1^^1^6"
^XWB(8994,3276,2,6,1,0)="^^3^3^3120229^"
^XWB(8994,3276,2,6,1,1,0)="Flag that controls whether ICD-9 or ICD-10 codes are searched."
^XWB(8994,3276,2,6,1,2,0)="  ICD9  -  For ICD-9 codes search"
^XWB(8994,3276,2,6,1,3,0)="  ICD10 -  For ICD-10 codes search"
^XWB(8994,3276,2,"B","DATE",5)=""
^XWB(8994,3276,2,"B","FLAGS",2)=""
^XWB(8994,3276,2,"B","FROM",4)=""
^XWB(8994,3276,2,"B","ICDTYPE",6)=""
^XWB(8994,3276,2,"B","NUMBER",3)=""
^XWB(8994,3276,2,"B","PART",1)=""
^XWB(8994,3276,2,"PARAMSEQ",1,1)=""
^XWB(8994,3276,2,"PARAMSEQ",1,5)=""
^XWB(8994,3276,2,"PARAMSEQ",2,1)=""
^XWB(8994,3276,2,"PARAMSEQ",2,2)=""
^XWB(8994,3276,2,"PARAMSEQ",3,2)=""
^XWB(8994,3276,2,"PARAMSEQ",3,3)=""
^XWB(8994,3276,2,"PARAMSEQ",4,3)=""
^XWB(8994,3276,2,"PARAMSEQ",4,4)=""
^XWB(8994,3276,2,"PARAMSEQ",5,4)=""
^XWB(8994,3276,2,"PARAMSEQ",6,6)=""
^XWB(8994,3276,3,0)="^^32^32^3120229^"
^XWB(8994,3276,3,1,0)="A negative value of the first ""^""-piece of the Results[0] indicates that "
^XWB(8994,3276,3,2,0)="an error occurred during the execution of the remote procedure. In this "
^XWB(8994,3276,3,3,0)="case, the second piece of the Results[0] will contain number of the error "
^XWB(8994,3276,3,4,0)="descriptors returned in the subsequent nodes of the Results array:"
^XWB(8994,3276,3,5,0)="  "
^XWB(8994,3276,3,6,0)="  Results[0]            Result Descriptor"
^XWB(8994,3276,3,7,0)="                          ^01: The last error code"
^XWB(8994,3276,3,8,0)="                          ^02: Number of the error descriptors"
^XWB(8994,3276,3,9,0)="   "
^XWB(8994,3276,3,10,0)="  Results[i]            Error Descriptor"
^XWB(8994,3276,3,11,0)="                          ^01: Error code"
^XWB(8994,3276,3,12,0)="                          ^02: Message"
^XWB(8994,3276,3,13,0)="                          ^03: Place of the error"
^XWB(8994,3276,3,14,0)=" "
^XWB(8994,3276,3,15,0)="Otherwise, number of ICD codes and the value of the FROM parameter for"
^XWB(8994,3276,3,16,0)="the next procedure call are returned in the Results[0] and the subsequent"
^XWB(8994,3276,3,17,0)="nodes of the global array contain the codes."
^XWB(8994,3276,3,18,0)="  "
^XWB(8994,3276,3,19,0)="  Results[0]          Result Descriptor"
^XWB(8994,3276,3,20,0)="                        ^01: Number of codes"
^XWB(8994,3276,3,21,0)="                        ^02: FromName"
^XWB(8994,3276,3,22,0)="                        ^03: FromIEN"
^XWB(8994,3276,3,23,0)=" "
^XWB(8994,3276,3,24,0)="  Results[i]          ICD"
^XWB(8994,3276,3,25,0)="                        ^01: IEN"
^XWB(8994,3276,3,26,0)="                        ^02: Diagnosis or operation/procedure"
^XWB(8994,3276,3,27,0)="                        ^03: Code"
^XWB(8994,3276,3,28,0)="                        ^04: Use only with Sex"
^XWB(8994,3276,3,29,0)="                        ^05: Inactive (""""/1)"
^XWB(8994,3276,3,30,0)="                        ^06: Inactivation Date (FileMan)"
^XWB(8994,3276,3,31,0)=" "
^XWB(8994,3276,3,32,0)="  Results[i+1]        ICD Description"
^XWB(8994,3277,0)="ORWLEX GETI10DX^GETI10DX^ORWLEX^2^S"
^XWB(8994,3277,1,0)="^^2^2^3130116^"
^XWB(8994,3277,1,1,0)="This call wraps the Lexicon API $$DIAGSRCH^LEX10CS to satisfy the "
^XWB(8994,3277,1,2,0)="requirements of the ICD-10-CM diagnosis search."
^XWB(8994,3277,2,0)="^8994.02A^2^2"
^XWB(8994,3277,2,1,0)="ORX^1^^1^1"
^XWB(8994,3277,2,1,1,0)="^^1^1^3130116^"
^XWB(8994,3277,2,1,1,1,0)="This is the search term."
^XWB(8994,3277,2,2,0)="ORDT^1^^0^2"
^XWB(8994,3277,2,2,1,0)="^^2^2^3130116^"
^XWB(8994,3277,2,2,1,1,0)="Optional date (usually corresponding to the encounter date). Defaults to "
^XWB(8994,3277,2,2,1,2,0)="TODAY."
^XWB(8994,3277,2,"B","ORDT",2)=""
^XWB(8994,3277,2,"B","ORX",1)=""
^XWB(8994,3277,2,"PARAMSEQ",1,1)=""
^XWB(8994,3277,2,"PARAMSEQ",2,2)=""
^XWB(8994,3277,3,0)="^^1^1^3130116^"
^XWB(8994,3277,3,1,0)="List of Lexicon expressions for TreeView of categories/codes."
^XWB(8994,3278,0)="ORWPCE I10IMPDT^I10IMPDT^ORWPCE^1^S"
^XWB(8994,3278,1,0)="^^1^1^3130418^"
^XWB(8994,3278,1,1,0)="This RPC returns the ICD-10 implementation date in FM Date/Time format."
^XWB(8994,3278,3,0)="^^1^1^3130418^"
^XWB(8994,3278,3,1,0)="The ICD-10 Implementation Date in FM Date/Time format."
^XWB(8994,3279,0)="ORWLEX GETFREQ^GETFREQ^ORWLEX^1^S^0"
^XWB(8994,3279,1,0)="^^2^2^3131101^"
^XWB(8994,3279,1,1,0)="This call wraps the Lexicon API $$FREQ^LEXU to satisfy the requirements "
^XWB(8994,3279,1,2,0)="of the ICD-10-CM diagnosis search."
^XWB(8994,3279,2,0)="^8994.02A^1^1"
^XWB(8994,3279,2,1,0)="ORSRCHTX^1^^1"
^XWB(8994,3279,2,1,1,0)="^^1^1^3131101^"
^XWB(8994,3279,2,1,1,1,0)="This is the search text/term."
^XWB(8994,3279,2,"B","ORSRCHTX",1)=""
^XWB(8994,3279,3,0)="^^2^2^3131101^"
^XWB(8994,3279,3,1,0)="The maximum number of records that must be inspected during a Lexicon "
^XWB(8994,3279,3,2,0)="search to find matching entries for the input search text."
^XWB(8994,3280,0)="ORWGN IDTVALID^IDTVALID^ORWGN^1^S^0^^^^^1"
^XWB(8994,3280,1,0)="^8994.01^1^1^3120223^^^^"
^XWB(8994,3280,1,1,0)="Returns the implementation date of the coding system passed in"
^XWB(8994,3280,2,0)="^8994.02A^1^1"
^XWB(8994,3280,2,1,0)="CSYS^1^4^1^1"
^XWB(8994,3280,2,1,1,0)="^8994.021^1^1^3120215^^^^"
^XWB(8994,3280,2,1,1,1,0)="Abbreviated text for Coding System"
^XWB(8994,3280,2,"B","CSYS",1)=""
^XWB(8994,3280,2,"PARAMSEQ",1,1)=""
^XWB(8994,3280,3,0)="^8994.03^1^1^3120215^^^^"
^XWB(8994,3280,3,1,0)="Implementation Date for Coding system indicated"
^XWB(8994,3281,0)="ORWGN MAXFRQ^MAXFRQ^ORWGN^1^P^0^^0"
^XWB(8994,3281,1,0)="^8994.01^2^2^3120913^^^"
^XWB(8994,3281,1,1,0)="This RPC checks if the frequency of an ICD-10 search term is than the "
^XWB(8994,3281,1,2,0)="maximum allowed ICD-10 return values."
^XWB(8994,3281,2,0)="^8994.02A^1^1"
^XWB(8994,3281,2,1,0)="ORTRM^1^99^1^1"
^XWB(8994,3281,2,1,1,0)="^8994.021^1^1^3120913^^^"
^XWB(8994,3281,2,1,1,1,0)="This is the search term to be looked up."
^XWB(8994,3281,2,"B","ORTRM",1)=""
^XWB(8994,3281,2,"PARAMSEQ",1,1)=""
^XWB(8994,3281,3,0)="^8994.03^11^11^3120913^^"
^XWB(8994,3281,3,1,0)="Return Value:  "
^XWB(8994,3281,3,2,0)="    ""1^22000"""
^XWB(8994,3281,3,3,0)="  "
^XWB(8994,3281,3,4,0)="    2 pieces (first piece is 0 or 1, second piece is occurrence frequency"
^XWB(8994,3281,3,5,0)="    of search term)"
^XWB(8994,3281,3,6,0)="  "
^XWB(8994,3281,3,7,0)="    First piece:"
^XWB(8994,3281,3,8,0)="                 0 - Search term frequency is less than"
^XWB(8994,3281,3,9,0)="                     maximum allowed"
^XWB(8994,3281,3,10,0)="                 1 - Search term frequency is greater"
^XWB(8994,3281,3,11,0)="                     than maximum allowed"
^XWB(8994,3282,0)="PX SAVE DATA^SAVE^PXRPC^1^S^^^^^^1"
^XWB(8994,3282,1,0)="^8994.01^3^3^3211101^^^^"
^XWB(8994,3282,1,1,0)="The purpose of this RPC is to allow the calling application to save data "
^XWB(8994,3282,1,2,0)="to PCE, such as Immunization data. See the Integration Control "
^XWB(8994,3282,1,3,0)="Registration document for the full description of the data needed."
^XWB(8994,3282,2,0)="^8994.02A^6^6"
^XWB(8994,3282,2,1,0)="PCELIST^2^10000^1^1"
^XWB(8994,3282,2,1,1,0)="^^65^65^3211101^"
^XWB(8994,3282,2,1,1,1,0)="PCELIST (n)=VST^DT^Encounter date/time"
^XWB(8994,3282,2,1,1,2,0)="        (n)=VST^PT^Encounter patient (DFN)"
