^XWB(8994,3776,3,2,0)="Eligibility Code (8.1) file."
^XWB(8994,3777,0)="VIAA ENG ASSET MOVE^EQMVUPD^VIAAEAD^2^R^^^^^^1"
^XWB(8994,3777,1,0)="^8994.01^2^2^3140613^^^^"
^XWB(8994,3777,1,1,0)="This RPC updates the Engineering file #6914 after a piece of equipment "
^XWB(8994,3777,1,2,0)="has moved and its new location is sent to RTLS."
^XWB(8994,3777,2,0)="^8994.02A^^-1"
^XWB(8994,3777,2,1,0)="RETSTA^2^511^1"
^XWB(8994,3777,2,1,1,0)="^8994.021^1^1^3120215^^"
^XWB(8994,3777,2,1,1,1,0)="Return array"
^XWB(8994,3777,2,2,0)="AEMSID^1^30^1^1"
^XWB(8994,3777,2,2,1,0)="^8994.021^1^1^3140206^^"
^XWB(8994,3777,2,2,1,1,0)="AEMS asset identifier"
^XWB(8994,3777,2,3,0)="ROOMNUM^1^30^1^2"
^XWB(8994,3777,2,3,1,0)="^8994.021^1^1^3151104^^^"
^XWB(8994,3777,2,3,1,1,0)="New location of asset"
^XWB(8994,3777,2,5,0)="TMSTMP^1^20^1^3"
^XWB(8994,3777,2,5,1,0)="^8994.021^1^1^3140613^^^^"
