^XWB(8994,3698,0)="DSIRRPTR GETIEN GET REPORT IEN^GETIEN^DSIRRPTR^1"
^XWB(8994,3698,1,0)="^^3^3^3160523^"
^XWB(8994,3698,1,1,0)="This RPC will return the internal entry number (IEN) to the DSIR "
^XWB(8994,3698,1,2,0)="SCHEDULED REPORTS file (#19620.35) based off of the TaskMan task number "
^XWB(8994,3698,1,3,0)="that ran the report."
^XWB(8994,3698,2,0)="^8994.02A^1^1"
^XWB(8994,3698,2,1,0)="TASK^1^99^1^1"
^XWB(8994,3698,2,1,1,0)="^^1^1^3160523^"
^XWB(8994,3698,2,1,1,1,0)="This is the TaskMan task number of the report."
^XWB(8994,3698,2,"B","TASK",1)=""
^XWB(8994,3698,2,"PARAMSEQ",1,1)=""
^XWB(8994,3698,3,0)="^^3^3^3160523^"
^XWB(8994,3698,3,1,0)="Return Value"
^XWB(8994,3698,3,2,0)="        -1 ^ Invalid task number!"
^XWB(8994,3698,3,3,0)="        IEN = The Internal Entry Number to file 19620.35"
^XWB(8994,3699,0)="DSIRRPTR UPGPARM UPD GUI PARMS^UPGPARM^DSIRRPTR^1"
^XWB(8994,3699,1,0)="^^3^3^3160523^"
^XWB(8994,3699,1,1,0)="This RPC allows the graphical user interface (GUI) for the ROI Plus "
^XWB(8994,3699,1,2,0)="application to store, in a meaningful way to the GUI, the parameters and "
^XWB(8994,3699,1,3,0)="values passed for future display to the user."
^XWB(8994,3699,2,0)="^8994.02A^2^2"
^XWB(8994,3699,2,1,0)="IEN^1^99^1^1"
^XWB(8994,3699,2,1,1,0)="^^1^1^3160523^"
^XWB(8994,3699,2,1,1,1,0)="The internal entry number for the DSIR SCHEDULED REPORTS file (#19620.35)."
^XWB(8994,3699,2,2,0)="PARMS^2^245^1^2"
^XWB(8994,3699,2,2,1,0)="^^2^2^3160523^"
^XWB(8994,3699,2,2,1,1,0)="The word-processing text for the GUI PARAMETERS field in the DISR "
^XWB(8994,3699,2,2,1,2,0)="SCHEDULED REPORTS file (#19620.35)."
^XWB(8994,3699,2,"B","IEN",1)=""
^XWB(8994,3699,2,"B","PARMS",2)=""
^XWB(8994,3699,2,"PARAMSEQ",1,1)=""
^XWB(8994,3699,2,"PARAMSEQ",2,2)=""
^XWB(8994,3699,3,0)="^^4^4^3160523^"
^XWB(8994,3699,3,1,0)="Return Values"
^XWB(8994,3699,3,2,0)="        -1 ^ Invalid Report Number!"
^XWB(8994,3699,3,3,0)="        -1 ^ No Text to Store!"
^XWB(8994,3699,3,4,0)="        1 = Update successful"
^XWB(8994,3700,0)="DSIRRPTR GTGPARM GET GUI PARMS^GTGPARM^DSIRRPTR^2^^^^1"
^XWB(8994,3700,1,0)="^^4^4^3160523^"
^XWB(8994,3700,1,1,0)="The VA Privacy Office wanted the ROI Plus application to show the user "
^XWB(8994,3700,1,2,0)="what values were entered the last time a given report was requested.  "
^XWB(8994,3700,1,3,0)="This RPC will retrieve the data the application passed in for this "
^XWB(8994,3700,1,4,0)="purpose."
^XWB(8994,3700,2,0)="^8994.02A^1^1"
^XWB(8994,3700,2,1,0)="IEN^1^99^1^1"
^XWB(8994,3700,2,1,1,0)="^^1^1^3160523^"
^XWB(8994,3700,2,1,1,1,0)="The internal entry number in the DSIR SCHEDULED REPORTS file (#19620.35)."
^XWB(8994,3700,2,"B","IEN",1)=""
^XWB(8994,3700,2,"PARAMSEQ",1,1)=""
^XWB(8994,3700,3,0)="^^4^4^3160523^"
^XWB(8994,3700,3,1,0)="Return Array"
^XWB(8994,3700,3,2,0)="        -1 ^ Invalid Internal Entry Number!"
^XWB(8994,3700,3,3,0)="        0 ^ No Data Found!"
^XWB(8994,3700,3,4,0)="        Text from field 3 of file 19620.35"
^XWB(8994,3701,0)="VIAA GET ITEM MASTER UPDATE^ITEM^VIAAIMUP^4^R^^^1^1^^1"
^XWB(8994,3701,1,0)="^8994.01^3^3^3140423^^^^"
^XWB(8994,3701,1,1,0)="This RPC is part of the Real Time Location System (RTLS), called by"
^XWB(8994,3701,1,2,0)="WaveMark to obtain item detail for a given item in the inventory point "
^XWB(8994,3701,1,3,0)="Cath lab as defined in GIP, a module of IFCAP."
^XWB(8994,3701,2,0)="^8994.02A^3^2"
^XWB(8994,3701,2,1,0)="RETSTA^1^256^1"
^XWB(8994,3701,2,1,1,0)="^^1^1^3130423^"
^XWB(8994,3701,2,1,1,1,0)="This the return array for the calling application."
^XWB(8994,3701,2,2,0)="IPNAME^1^256^1^1"
^XWB(8994,3701,2,2,1,0)="^^2^2^3130423^"
^XWB(8994,3701,2,2,1,1,0)="Inventory Point name from Generic Inventory Point (GIP) in IFCAP. This is "
^XWB(8994,3701,2,2,1,2,0)="expected to be the Cathlab."
^XWB(8994,3701,2,3,0)="ITEM^1^10^1^2"
^XWB(8994,3701,2,3,1,0)="^8994.021^1^1^3140423^^^^"
^XWB(8994,3701,2,3,1,1,0)="This is the internal entry number for the Item Master # from IFCAP/GIP."
^XWB(8994,3701,2,"B","IPNAME",2)=""
^XWB(8994,3701,2,"B","ITEM",3)=""
^XWB(8994,3701,2,"B","RETSTA",1)=""
^XWB(8994,3701,2,"PARAMSEQ",1,2)=""
^XWB(8994,3701,2,"PARAMSEQ",2,3)=""
^XWB(8994,3701,3,0)="^^18^18^3140423^"
^XWB(8994,3701,3,1,0)="RETSTA is the return parameter that carries the reference to ^TMP and "
^XWB(8994,3701,3,2,0)="it can be a single statement to indicate an error condition from the"
^XWB(8994,3701,3,3,0)="call execution, or its success."
^XWB(8994,3701,3,4,0)=" "
^XWB(8994,3701,3,5,0)="For no error situations, the format of the data returned is as follows:"
^XWB(8994,3701,3,6,0)=" "
^XWB(8994,3701,3,7,0)="""itemDescription^itemNumber^vendorName^vendorNumber^vendorStockNumber"
^XWB(8994,3701,3,8,0)="~vendorName~"
^XWB(8994,3701,3,9,0)="vendorNumber~vendorStockNumber^inventoryName^unitOfIssue^averageCost^grou"
^XWB(8994,3701,3,10,0)="pCategoryCode^quantityDueIn"""
^XWB(8994,3701,3,11,0)=" "
^XWB(8994,3701,3,12,0)=" "
^XWB(8994,3701,3,13,0)="The first vendor listed is the mandatory vendor and the second vendor "
^XWB(8994,3701,3,14,0)="corresponds to an alternate vendor called 'procurement source' that can "
^XWB(8994,3701,3,15,0)="be used when the mandatory one is not available."
^XWB(8994,3701,3,16,0)=" "
^XWB(8994,3701,3,17,0)="For an error condition, a message will be sent back to the calling"
^XWB(8994,3701,3,18,0)="application with details of the error."
^XWB(8994,3702,0)="VIAA GET INVENTORY POINT ITEMS^IPQRY^VIAAIPDE^4^R^^^1^1^^1"
^XWB(8994,3702,1,0)="^8994.01^4^4^3140206^^^^"
^XWB(8994,3702,1,1,0)="This RPC is part of the Real Time Location System (RTLS), called by"
^XWB(8994,3702,1,2,0)="WaveMark to obtain all the items in the inventory point Cath lab as"
^XWB(8994,3702,1,3,0)="defined in GIP, a module of IFCAP. However, this RPC can work for any"
^XWB(8994,3702,1,4,0)="inventory point in GIP."
^XWB(8994,3702,2,0)="^8994.02A^2^1"
^XWB(8994,3702,2,1,0)="RETSTA^1^256^1"
^XWB(8994,3702,2,1,1,0)="^^1^1^3130423^"
^XWB(8994,3702,2,1,1,1,0)="This the return array for the calling application."
^XWB(8994,3702,2,2,0)="IPNAME^1^256^1^1"
^XWB(8994,3702,2,2,1,0)="^8994.021^1^1^3131023^^^^"
^XWB(8994,3702,2,2,1,1,0)="This is the inventory point name from GIP."
^XWB(8994,3702,2,"B","IPNAME",2)=""
^XWB(8994,3702,2,"B","RETSTA",1)=""
^XWB(8994,3702,2,"PARAMSEQ",1,2)=""
^XWB(8994,3702,3,0)="^8994.03^10^10^3140206^^^^"
^XWB(8994,3702,3,1,0)="RETSTA is the return parameter that carries the reference to ^TMP and it"
^XWB(8994,3702,3,2,0)="can be a single statement to indicate an error condition from the call"
^XWB(8994,3702,3,3,0)="execution, or it can indicate its success."
^XWB(8994,3702,3,4,0)=" "
^XWB(8994,3702,3,5,0)="The format of the data returned for a successful call is as follows:"
^XWB(8994,3702,3,6,0)=" "
^XWB(8994,3702,3,7,0)="""inventoryPointName^inventoryPointNumber^itemDecription^itemNumber"""
^XWB(8994,3702,3,8,0)=" "
^XWB(8994,3702,3,9,0)="For an error condition, a message will be sent back to the calling"
^XWB(8994,3702,3,10,0)="application with details of the error."
^XWB(8994,3703,0)="VIAA SET PAR LEVELS IN GIP^SETPAR^VIAAPAR^4^R^^^1^1^^1"
^XWB(8994,3703,1,0)="^8994.01^3^3^3140206^^^"
^XWB(8994,3703,1,1,0)="This RPC is part of the Real Time Location System (RTLS), called by"
^XWB(8994,3703,1,2,0)="WaveMark to set the par levels in the Cath lab inventory point of GIP, a "
^XWB(8994,3703,1,3,0)="module of IFCAP."
