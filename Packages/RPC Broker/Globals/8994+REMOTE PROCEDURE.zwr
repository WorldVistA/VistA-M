^XWB(8994,4345,3,6,0)="        ""-1^Invalid Vendor"""
^XWB(8994,4345,3,7,0)="        ""0^No data found for requested Vendor"""
^XWB(8994,4345,3,8,0)=" "
^XWB(8994,4345,3,9,0)="    Successful Completion: Returns external and internal formats of"
^XWB(8994,4345,3,10,0)="      all fields for the requested IEN from the Vendor file (#440) "
^XWB(8994,4345,3,11,0)="      in the format:"
