^XWB(8994,2979,0)="DSIROIR2 RTYP RECEIVED METHOD^RTYP^DSIROIR2^4"
^XWB(8994,2979,1,0)="^^1^1^3110804^"
^XWB(8994,2979,1,1,0)="This is produces the data for the Received Status report. "
^XWB(8994,2979,2,0)="^8994.02A^3^3"
^XWB(8994,2979,2,1,0)="SDATE^1^^0^1"
^XWB(8994,2979,2,1,1,0)="^^2^2^3110804^"
^XWB(8994,2979,2,1,1,1,0)="SDATE - start date.  This is the date to begin pulling data for the "
