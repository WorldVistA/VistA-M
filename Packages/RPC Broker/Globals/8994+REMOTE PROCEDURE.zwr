^XWB(8994,3050,2,1,1,0)="^8994.021^2^2^3091104^^"
^XWB(8994,3050,2,1,1,1,0)="Internal entry for file #3.075 (ERROR LOG).  This value will be "
^XWB(8994,3050,2,1,1,2,0)="$P($H,"","")."
^XWB(8994,3050,2,2,0)="SCREEN^1^254^1^2"
