^XWB(8994,4330,2,2,1,0)="^^1^1^3150320^"
^XWB(8994,4330,2,2,1,1,0)="Prosthetics Site Parameters file (#669.9) IEN"
^XWB(8994,4330,2,3,0)="DSSOIEN^1^15^0^3"
^XWB(8994,4330,2,3,1,0)="^^1^1^3150320^"
^XWB(8994,4330,2,3,1,1,0)="Last Prosthetics Patient file (#665) IEN processed"
^XWB(8994,4330,2,4,0)="DSSONUM^1^3^0^4"
^XWB(8994,4330,2,4,1,0)="^8994.021^1^1^3190725^^^"
^XWB(8994,4330,2,4,1,1,0)="Number of records to be returned at a time to prevent timeout"
^XWB(8994,4330,2,"B","DSSOIEN",3)=""
^XWB(8994,4330,2,"B","DSSONUM",4)=""
^XWB(8994,4330,2,"B","DSSOPAT",1)=""
^XWB(8994,4330,2,"B","DSSOSTE",2)=""
^XWB(8994,4330,2,"PARAMSEQ",1,1)=""
^XWB(8994,4330,2,"PARAMSEQ",2,2)=""
^XWB(8994,4330,2,"PARAMSEQ",3,3)=""
^XWB(8994,4330,2,"PARAMSEQ",4,4)=""
^XWB(8994,4330,3,0)="^^24^24^3190725^"
^XWB(8994,4330,3,1,0)="Output:"
^XWB(8994,4330,3,2,0)="  Error Messages:  ""-1^""_error message or ""0^""_warning message"
^XWB(8994,4330,3,3,0)="    ""-1^Patient name not provided"""
^XWB(8994,4330,3,4,0)="    ""-1^Prosthetics Site Parameters IEN not provided"""
^XWB(8994,4330,3,5,0)="    ""-1^Invalid Prosthetic Site Parameters IEN"""
^XWB(8994,4330,3,6,0)="    ""-1^Invalid Prosthetics Patient IEN"""
^XWB(8994,4330,3,7,0)="    ""0^No Patients with requested value found in Prosthetics Patient"
^XWB(8994,4330,3,8,0)="          file."""
^XWB(8994,4330,3,9,0)="    ""0^No Prosthetics Patients found."""
^XWB(8994,4330,3,10,0)=" "
^XWB(8994,4330,3,11,0)="  Successful Completion:  Returns external and internal formats of patient"
^XWB(8994,4330,3,12,0)="    name, and related fields from the Prosthetics Patient file (#665), "
^XWB(8994,4330,3,13,0)="    the Patient file (#2), and the Outpatient Profile (#404.41) file in "
^XWB(8994,4330,3,14,0)="    the format:"
^XWB(8994,4330,3,15,0)="      ^-piece 1 - DFN"
^XWB(8994,4330,3,16,0)="      ^-piece 2 - Patient Name (file 665 field .01 external)"
^XWB(8994,4330,3,17,0)="      ^-piece 3 - Station (file 665 field 2 internal)"
^XWB(8994,4330,3,18,0)="      ^-piece 4 - Date of Birth (file 2 field .03 external)"
^XWB(8994,4330,3,19,0)="      ^-piece 5 - SSN (file 2 field .09 external)"
^XWB(8994,4330,3,20,0)="      ^-piece 6 - 1U4N (file 2 field .0905 external)"
^XWB(8994,4330,3,21,0)="      ^-piece 7 - Service Connected? (file 2 field .301 external)"
^XWB(8994,4330,3,22,0)="      ^-piece 8 - Current PC Practitioner (file 404.41 field 201)"
^XWB(8994,4330,3,23,0)="      ^-piece 9 - Current PC Team (file 404.41 field 203)"
^XWB(8994,4330,3,24,0)="      ^-piece 10 - Veteran (Y/N)? (file 2 field 1901)"
^XWB(8994,4331,0)="DSSO CREATE STOCK ISSUE^EN^DSSOSTJ^1"
^XWB(8994,4331,1,0)="^8994.01^3^3^3230104^^"
