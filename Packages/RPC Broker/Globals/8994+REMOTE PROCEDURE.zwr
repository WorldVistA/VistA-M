^XWB(8994,2511,2,"PARAMSEQ",2,2)=""
^XWB(8994,2511,2,"PARAMSEQ",3,3)=""
^XWB(8994,2512,0)="MAG GET DICOM XMIT ORIGIN^LISTORIG^MAGDRPC1^2^R^^^^3"
^XWB(8994,2512,1,0)="^8994.01^18^18^3060515^"
^XWB(8994,2512,1,1,0)=" +---------------------------------------------------------------+"
^XWB(8994,2512,1,2,0)=" | Property of the US Government.                                |"
^XWB(8994,2512,1,3,0)=" | No permission to copy or redistribute this software is given. |"
^XWB(8994,2512,1,4,0)=" | Use of unreleased versions of this software requires the user |"
^XWB(8994,2512,1,5,0)=" | to execute a written test agreement with the VistA Imaging    |"
^XWB(8994,2512,1,6,0)=" | Development Office of the Department of Veterans Affairs,     |"
^XWB(8994,2512,1,7,0)=" | telephone (301) 734-0100.                                     |"
^XWB(8994,2512,1,8,0)=" |                                                               |"
^XWB(8994,2512,1,9,0)=" | The Food and Drug Administration classifies this software as  |"
^XWB(8994,2512,1,10,0)=" | a medical device.  As such, it may not be changed in any way. |"
^XWB(8994,2512,1,11,0)=" | Modifications to this software may result in an adulterated   |"
^XWB(8994,2512,1,12,0)=" | medical device under 21CFR820, the use of which is considered |"
^XWB(8994,2512,1,13,0)=" | to be a violation of US Federal Statutes.                     |"
^XWB(8994,2512,1,14,0)=" +---------------------------------------------------------------+"
^XWB(8994,2512,1,15,0)=" "
^XWB(8994,2512,1,16,0)="This Remote Procedure returns the list of locations for which"
^XWB(8994,2512,1,17,0)="currently images are queued to be transmitted using the DICOM"
^XWB(8994,2512,1,18,0)="protocol."
^XWB(8994,2512,3,0)="^^9^9^3070601^"
^XWB(8994,2512,3,1,0)="The return parameter of this remote procedure is an array."
^XWB(8994,2512,3,2,0)="When the transmission queue is empty, this array contains only"
^XWB(8994,2512,3,3,0)="one element, with the value:"
^XWB(8994,2512,3,4,0)="   ""No entries in transmission queue"""
^XWB(8994,2512,3,5,0)="When there are entries in the transmission queue, the first"
^XWB(8994,2512,3,6,0)="element of the array will be a counter, and each further element"
^XWB(8994,2512,3,7,0)="will contain two values:"
^XWB(8994,2512,3,8,0)="    IEN of location ^ name of location"
^XWB(8994,2512,3,9,0)="e.g. ""660^SALT LAKE CITY"""
^XWB(8994,2513,0)="MAG IMAGE CURRENT INFO^INFO^MAGDQR04^2^R^0^^0^3"
^XWB(8994,2513,1,0)="^8994.01^3^3^3200415^^^"
^XWB(8994,2513,1,1,0)="This Remote Procedure returns current values for the various"
^XWB(8994,2513,1,2,0)="DICOM tags that are to be included in the header of an exported"
^XWB(8994,2513,1,3,0)="image."
^XWB(8994,2513,2,0)="^8994.02A^2^2"
^XWB(8994,2513,2,1,0)="IMAGE^1^20^1^1"
^XWB(8994,2513,2,1,1,0)="^8994.021^4^4^3200415^^^"
^XWB(8994,2513,2,1,1,1,0)="The value of this parameter is a number. This number is a pointer"
^XWB(8994,2513,2,1,1,2,0)="into the Image File (#2005 or #2005.65)."
^XWB(8994,2513,2,1,1,3,0)="This RPC will return information for the image that is identified"
^XWB(8994,2513,2,1,1,4,0)="by this pointer-value."
^XWB(8994,2513,2,2,0)="DBTYPE^1^3^0^2"
^XWB(8994,2513,2,2,1,0)="^^3^3^3200415^"
^XWB(8994,2513,2,2,1,1,0)="The SOP database type. The SOP database type may either be ""OLD"" or ""NEW""."
^XWB(8994,2513,2,2,1,2,0)="Old SOP classes are processed by the LDGW. New SOP classes are"
^XWB(8994,2513,2,2,1,3,0)="processed by the HDIG."
^XWB(8994,2513,2,"B","DBTYPE",2)=""
^XWB(8994,2513,2,"B","IMAGE",1)=""
^XWB(8994,2513,2,"PARAMSEQ",1,1)=""
^XWB(8994,2513,2,"PARAMSEQ",2,2)=""
^XWB(8994,2513,3,0)="^8994.03^7^7^3200415^^^"
^XWB(8994,2513,3,1,0)="The return parameter for this Remote Procedure is an array."
^XWB(8994,2513,3,2,0)="The first element contains a status for the execution of"
^XWB(8994,2513,3,3,0)="the request. A negative value indicates a problem,"
^XWB(8994,2513,3,4,0)="a positive value represents the number of DICOM tags returned."
^XWB(8994,2513,3,5,0)=" "
^XWB(8994,2513,3,6,0)="The other array elements contain the relevant return-values"
^XWB(8994,2513,3,7,0)="in the format tag, caret, value."
^XWB(8994,2514,0)="MAG GET SOP CLASS METHOD"
^XWB(8994,2515,0)="DSIR ADD/EDIT REQUESTOR^UPDRQSTR^DSIROI3^1"
^XWB(8994,2515,1,0)="^8994.01^2^2^3111212^^^"
^XWB(8994,2515,1,1,0)="This RPC will add or update an entry in the REQUESTOR FILE in ROI "
^XWB(8994,2515,1,2,0)="(#19620.12)"
^XWB(8994,2515,2,0)="^8994.02A^1^1"
^XWB(8994,2515,2,1,0)="DATA ARRAY^2^^1^1"
^XWB(8994,2515,2,1,1,0)="^8994.021^13^13^3111212^^"
^XWB(8994,2515,2,1,1,1,0)="DATA - ARRAY - This will be a multiple value parameter."
^XWB(8994,2515,2,1,1,2,0)=" The values in order will be as follows: "
^XWB(8994,2515,2,1,1,3,0)=" 1. Requestor File Internal Number (Null if new OR Numeric)"
^XWB(8994,2515,2,1,1,4,0)=" 2. Lookup Name - Text - REQUIRED"
^XWB(8994,2515,2,1,1,5,0)=" 3. Requestor type - Pointer to DSIR BILLING TYPE file (19620.8)"
^XWB(8994,2515,2,1,1,6,0)=" 4. First Name"
^XWB(8994,2515,2,1,1,7,0)=" 5. Middle Name"
^XWB(8994,2515,2,1,1,8,0)=" 6. Last Name"
^XWB(8994,2515,2,1,1,9,0)=" 7. Corporate Name"
^XWB(8994,2515,2,1,1,10,0)=" 8. Salutation"
^XWB(8994,2515,2,1,1,11,0)=" 9. E-mail"
^XWB(8994,2515,2,1,1,12,0)=" 10. Primary address Pointer (IEN in 19620.92)"
^XWB(8994,2515,2,1,1,13,0)=" 11. PATIENT POINTER (IE. ""441;DPT("", ""67:DSIR(19620.96,"")"
^XWB(8994,2515,2,"B","DATA ARRAY",1)=""
^XWB(8994,2515,2,"PARAMSEQ",1,1)=""
^XWB(8994,2515,3,0)="^8994.03^4^4^3111212^^^"
^XWB(8994,2515,3,1,0)="RETURN VALUE"
^XWB(8994,2515,3,2,0)=" Requestor file Internal Number"
^XWB(8994,2515,3,3,0)=" OR"
^XWB(8994,2515,3,4,0)=" -1^ERROR MESSAGE"
^XWB(8994,2516,0)="DSIR CHANGE PRIMARY ADDRESS^CHPRIADD^DSIROI6^1"
^XWB(8994,2516,1,0)="^^2^2^3090819^"
^XWB(8994,2516,1,1,0)="This RPC updates the pointer to the primary address for a given"
^XWB(8994,2516,1,2,0)="requestor.  The addresS is stored in the 5 node of 19620.12."
^XWB(8994,2516,2,0)="^8994.02A^2^2"
^XWB(8994,2516,2,1,0)="RQSTR^1^^1^1"
^XWB(8994,2516,2,1,1,0)="^^1^1^3090819^"
^XWB(8994,2516,2,1,1,1,0)="RQSTR - Pointer to the requestor file (19620.12)"
^XWB(8994,2516,2,2,0)="ADDRPTR^1^^1^2"
^XWB(8994,2516,2,2,1,0)="^^1^1^3090819^"
^XWB(8994,2516,2,2,1,1,0)="ADDRPTR - Pointer to the address file (19620.92)"
^XWB(8994,2516,2,"B","ADDRPTR",2)=""
^XWB(8994,2516,2,"B","RQSTR",1)=""
^XWB(8994,2516,2,"PARAMSEQ",1,1)=""
^XWB(8994,2516,2,"PARAMSEQ",2,2)=""
^XWB(8994,2516,3,0)="^^3^3^3090819^"
^XWB(8994,2516,3,1,0)="RETURN VALUES"
^XWB(8994,2516,3,2,0)="    AXY=""1^CHANGE COMPLETE"" for a successful changeR"
^XWB(8994,2516,3,3,0)="    AXY=""-1^Error Message"" if unsuccessful"
^XWB(8994,2517,0)="DSIR ADD/EDIT ADDRESS^UPDTADDR^DSIROI6^1"
^XWB(8994,2517,1,0)="^^2^2^3090819^"
^XWB(8994,2517,1,1,0)="This RPC is ussed to add or update an address in the ROI ADDRESS file "
^XWB(8994,2517,1,2,0)="(#19620.92)."
^XWB(8994,2517,2,0)="^8994.02A^1^1"
^XWB(8994,2517,2,1,0)="DATA^2^^1^1"
^XWB(8994,2517,2,1,1,0)="^^18^18^3090819^"
^XWB(8994,2517,2,1,1,1,0)="DATA - ARRAY - This will be a multiple value parameter."
^XWB(8994,2517,2,1,1,2,0)="  The values in order will be as follows: "
^XWB(8994,2517,2,1,1,3,0)="  1. Address File Internal Number (Null if new OR Numeric)"
^XWB(8994,2517,2,1,1,4,0)="  2. Patient - Internal Number (""441;DPT(,"")"
^XWB(8994,2517,2,1,1,5,0)="  3. Street Address Line One - Text 35 character max"
^XWB(8994,2517,2,1,1,6,0)="  4. Street Address Line Two - Text 35 character max"
^XWB(8994,2517,2,1,1,7,0)="  5. Street Address Line Three - Text 35 character max"
^XWB(8994,2517,2,1,1,8,0)="  6. City - Text 40 character max"
^XWB(8994,2517,2,1,1,9,0)="  7. State - Internal Number - Numeric (ie. 36 for NY)"
^XWB(8994,2517,2,1,1,10,0)="  8. Zip Code - Numeric 5 or 9 numbers"
^XWB(8994,2517,2,1,1,11,0)="  9. Address Holder - Code ; Description"
^XWB(8994,2517,2,1,1,12,0)="     (Patient/Unregistered Patient/Requestor - P/N/R)"
^XWB(8994,2517,2,1,1,13,0)=" 10. Holder - Internal Number ; File Reference"" "
^XWB(8994,2517,2,1,1,14,0)="     (Patient, Unregistered Patient, or Requestor IEN)"
^XWB(8994,2517,2,1,1,15,0)="     (""441;DPT(,""/""6;DSIR(19620.96,""/""36;DSIR(19620.12,"")"
^XWB(8994,2517,2,1,1,16,0)=" 11. Inactive flag (1=INACTIVE"
^XWB(8994,2517,2,1,1,17,0)=" 12. Phone"
^XWB(8994,2517,2,1,1,18,0)=" 13. Fax"
^XWB(8994,2517,2,"B","DATA",1)=""
^XWB(8994,2517,2,"PARAMSEQ",1,1)=""
^XWB(8994,2517,3,0)="^^4^4^3090819^"
^XWB(8994,2517,3,1,0)="RETURN VALUE"
^XWB(8994,2517,3,2,0)="  Address file Internal Number"
^XWB(8994,2517,3,3,0)="  OR"
^XWB(8994,2517,3,4,0)="  -1^ERROR MESSAGE"
^XWB(8994,2518,0)="DSIR SET ADDRESS INACTIVE^TOGLINAC^DSIROI6^1"
^XWB(8994,2518,1,0)="^8994.01^1^1^3090820^^^^"
^XWB(8994,2518,1,1,0)="This RPC sets or resets the Address Inactive flag in the ROI Address file."
^XWB(8994,2518,2,0)="^8994.02A^2^2"
^XWB(8994,2518,2,1,0)="ADRPTR^1^^1^1"
^XWB(8994,2518,2,1,1,0)="^8994.021^1^1^3090819^^^"
^XWB(8994,2518,2,1,1,1,0)="ADRPTR - IEN of ADDRESS (NUMERIC)"
^XWB(8994,2518,2,2,0)="FLAGVAL^1^1^0^2"
^XWB(8994,2518,2,2,1,0)=2
^XWB(8994,2518,2,2,1,1,0)="FLAGVAL - SET OF VALUES FOR THE INACTIVE FLAG.  ZERO(0) = ACTIVE AND ONE "
^XWB(8994,2518,2,2,1,2,0)="(1) = INACTIVE. (NUMERIC 0 OR 1)"
^XWB(8994,2518,2,"B","ADRPTR",1)=""
^XWB(8994,2518,2,"B","FLAGVAL",2)=""
^XWB(8994,2518,2,"PARAMSEQ",1,1)=""
^XWB(8994,2518,2,"PARAMSEQ",2,2)=""
^XWB(8994,2518,3,0)="^8994.03^4^4^3090820^^^"
^XWB(8994,2518,3,1,0)="RETURN VALUES"
^XWB(8994,2518,3,2,0)="  1^UPDATE COMPLETED"
^XWB(8994,2518,3,3,0)="  OR"
^XWB(8994,2518,3,4,0)="  -1^ERROR MESSAGE"
^XWB(8994,2519,0)="DSIR IS PATIENT REQUESTOR^ISREQSTR^DSIROI3^1"
^XWB(8994,2519,1,0)="^^2^2^3090827^"
^XWB(8994,2519,1,1,0)=" TEST FOR AN ENTRY IN THE ""DPATIENT"" INDEX IN THE REQUESTOR FILE "
^XWB(8994,2519,1,2,0)="(^DSIR(19620.12))"
^XWB(8994,2519,2,0)="^8994.02A^1^1"
^XWB(8994,2519,2,1,0)="DFN^1^^1^1"
^XWB(8994,2519,2,1,1,0)="^^1^1^3090827^"
^XWB(8994,2519,2,1,1,1,0)="FULLY QUALIFIED POINTER TO ^DPT OR ^DSIR(19520.96"
^XWB(8994,2519,2,"B","DFN",1)=""
^XWB(8994,2519,2,"PARAMSEQ",1,1)=""
^XWB(8994,2519,3,0)="^^2^2^3090827^"
^XWB(8994,2519,3,1,0)="RETURNS - IEN^LOOKUP NAME (.01 FIELD OF 19620.12)"
^XWB(8994,2519,3,2,0)="       OR -1^PATIENT NOT IN REQUESTOR TABLE    "
^XWB(8994,2520,0)="DSIR SET LAB TYPE^STLABTYP^DSIROI1^1"
^XWB(8994,2520,1,0)="^8994.01^1^1^3090917^^"
^XWB(8994,2520,1,1,0)="Routine for setting the requested lab type for a given request."
^XWB(8994,2520,2,0)="^8994.02A^2^2"
^XWB(8994,2520,2,1,0)="ROI^1^10^1^1"
^XWB(8994,2520,2,1,1,0)="^8994.021^2^2^3090917^^"
^XWB(8994,2520,2,1,1,1,0)="INPUT PARAMETER "
^XWB(8994,2520,2,1,1,2,0)="  ROI = REQUEST IEN"
^XWB(8994,2520,2,2,0)="TYP^1^2^0^2"
^XWB(8994,2520,2,2,1,0)="^8994.021^2^2^3090917^^^"
^XWB(8994,2520,2,2,1,1,0)="INPUT PARAMETER"
^XWB(8994,2520,2,2,1,2,0)="    TYP = SELECTED LAB TYPE - A NUMERIC VALUE >= 0"
^XWB(8994,2520,2,"B","ROI",1)=""
^XWB(8994,2520,2,"B","TYP",2)=""
^XWB(8994,2520,2,"PARAMSEQ",1,1)=""
^XWB(8994,2520,2,"PARAMSEQ",2,2)=""
^XWB(8994,2520,3,0)="^8994.03^6^6^3090917^^"
^XWB(8994,2520,3,1,0)="RETURNS (ROI is the input parameter for selecting the IEN)"
^XWB(8994,2520,3,2,0)="    Request IEN (same as ROI)"
^XWB(8994,2520,3,3,0)="  OR"
^XWB(8994,2520,3,4,0)="    -1^Invalid request number ROI"
^XWB(8994,2520,3,5,0)="  OR"
^XWB(8994,2520,3,6,0)="    -1^Unable to save the Lab Type for request number ROI"
^XWB(8994,2521,0)="DSIR GET LAB TYPE^GTLABTYP^DSIROI1^1"
^XWB(8994,2521,1,0)="^^3^3^3090917^"
^XWB(8994,2521,1,1,0)="This routine returns the type of lab requested for a given request.  Note "
^XWB(8994,2521,1,2,0)="that if no lab has been requested, this will contain a null or a zero.  "
^XWB(8994,2521,1,3,0)="In either case, this will be treated as a Cumulative Labs type."
^XWB(8994,2521,2,0)="^8994.02A^1^1"
^XWB(8994,2521,2,1,0)="ROI^1^10^1^1"
^XWB(8994,2521,2,1,1,0)="^^2^2^3090917^"
^XWB(8994,2521,2,1,1,1,0)="INPUT PARAMETER"
^XWB(8994,2521,2,1,1,2,0)="   ROI = REQUEST IEN"
^XWB(8994,2521,2,"B","ROI",1)=""
^XWB(8994,2521,2,"PARAMSEQ",1,1)=""
^XWB(8994,2521,3,0)="^^4^4^3090917^"
^XWB(8994,2521,3,1,0)=" RETURNS "
^XWB(8994,2521,3,2,0)="    Request IEN (same as ROI)"
^XWB(8994,2521,3,3,0)="  OR"
^XWB(8994,2521,3,4,0)="    -1^Invalid request number ROI"
^XWB(8994,2522,0)="DSIR GET LAB LIST^GTLABLST^DSIROI1^2"
^XWB(8994,2522,1,0)="^^2^2^3090917^"
^XWB(8994,2522,1,1,0)="This routine returns a list of labs that have been selected for a given "
^XWB(8994,2522,1,2,0)="request."
^XWB(8994,2522,2,0)="^8994.02A^1^1"
^XWB(8994,2522,2,1,0)="ROI^1^10^1^1"
^XWB(8994,2522,2,1,1,0)="^^2^2^3090917^"
^XWB(8994,2522,2,1,1,1,0)=" INPUT PARAMETER"
^XWB(8994,2522,2,1,1,2,0)="    ROI = REQUEST IEN"
^XWB(8994,2522,2,"B","ROI",1)=""
^XWB(8994,2522,2,"PARAMSEQ",1,1)=""
^XWB(8994,2522,3,0)="^^7^7^3090917^"
^XWB(8994,2522,3,1,0)="RETURNS "
^XWB(8994,2522,3,2,0)="    Array containing lab numbers and titles as follows:"
^XWB(8994,2522,3,3,0)="          #^Lab_Title"
^XWB(8994,2522,3,4,0)="  OR"
^XWB(8994,2522,3,5,0)="    -1^Invalid request number ROI"
^XWB(8994,2522,3,6,0)="  OR"
^XWB(8994,2522,3,7,0)="    -1^No selected labs found for this request number ROI"
^XWB(8994,2523,0)="DSIR SET LAB LIST^STLABLST^DSIROI1^1"
^XWB(8994,2523,1,0)="^^7^7^3090917^"
^XWB(8994,2523,1,1,0)="This routine sets the requested labs for a given request. "
^XWB(8994,2523,1,2,0)=" "
^XWB(8994,2523,1,3,0)="NOTE: the labs are deleted every time and then added"
^XWB(8994,2523,1,4,0)="  based on the contents of DTLS.  If at any time"
^XWB(8994,2523,1,5,0)="  an entry in DTLS contains an ""@"" the processing "
^XWB(8994,2523,1,6,0)="  stops.  This will allow an ""@"" in the first "
^XWB(8994,2523,1,7,0)="  entry in DTLS to cause all entries to be deleted."
^XWB(8994,2523,2,0)="^8994.02A^2^2"
