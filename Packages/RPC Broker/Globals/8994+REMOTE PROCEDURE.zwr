^XWB(8994,4288,0)="DSSO DTLD RETRIEVE ITM MASTER^ITMMSTR^DSSODU3^4^^^^1"
^XWB(8994,4288,1,0)="^8994.01^3^3^3140507^^^^"
^XWB(8994,4288,1,1,0)="This RPC returns a list of items from the Item Master file (#441).  All "
^XWB(8994,4288,1,2,0)="items, a list of items beginning with the requested value, or a specific "
^XWB(8994,4288,1,3,0)="item may be returned."
^XWB(8994,4288,2,0)="^8994.02A^3^2"
^XWB(8994,4288,2,2,0)="DSSOITM^1^30^0^1"
^XWB(8994,4288,2,2,1,0)="^8994.021^9^9^3140502^^^"
