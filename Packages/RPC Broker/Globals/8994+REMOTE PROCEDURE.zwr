^XWB(8994,4349,3,3,0)="  List[n] = p1^p2^p3^p4^p5^p6^...^pn"
^XWB(8994,4349,3,4,0)=" "
^XWB(8994,4349,3,5,0)="    p1 = Patient Name          p4 = Purchase Date"
^XWB(8994,4349,3,6,0)="    p2 = Patient SSN           p5 = Reference #"
^XWB(8994,4349,3,7,0)="    p3 = Purchase Card #       p6 = Vendor Name"
^XWB(8994,4349,3,8,0)=" "
^XWB(8994,4349,3,9,0)="  Pieces 7-n will follow the following pattern:"
^XWB(8994,4349,3,10,0)=" "
^XWB(8994,4349,3,11,0)="    p7 = Item Description      p8 = Item Cost"
^XWB(8994,4349,3,12,0)=" "
^XWB(8994,4349,3,13,0)="If there is nothing to report, ""0^Nothing to report"" will be returned."
^XWB(8994,4349,3,14,0)="If an error occurs, the return will be -1^error message."
^XWB(8994,4350,0)="DSSO RC CHSTATE PC STATEMENT^CHSTATE^DSSORC^4^^^^1"
^XWB(8994,4350,1,0)="^^2^2^3150925^"
