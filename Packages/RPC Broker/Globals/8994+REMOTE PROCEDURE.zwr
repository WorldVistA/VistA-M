^XWB(8994,4238,0)="DSSO ADD 664 BILLING ITEM^FILE664^DSSOPP8^1^A^0^^1"
^XWB(8994,4238,1,0)="^^58^58^3130416^"
^XWB(8994,4238,1,1,0)="This RPC accepts an array containing fields and associated data to be"
^XWB(8994,4238,1,2,0)="used in creating a billing item in the Prosthetics Purchase Card Order.  "
^XWB(8994,4238,1,3,0)="A record will be added to multiple 664.02 - Billing Item - in file 664 "
^XWB(8994,4238,1,4,0)="- Prosthetics 1358."
^XWB(8994,4238,1,5,0)=" "
^XWB(8994,4238,1,6,0)=" Input:"
^XWB(8994,4238,1,7,0)="   DSSOIEN - IEN of Prosthetics 1358 file (#664) to which to add the"
^XWB(8994,4238,1,8,0)="              billing item"
^XWB(8994,4238,1,9,0)="   DSSOUPD array contains the following variables and data (in format"
^XWB(8994,4238,1,10,0)="        EXTERNAL/INTERNAL):"
^XWB(8994,4238,1,11,0)="     ""$$DSSOUPD$$"" - first entry in array"
^XWB(8994,4238,1,12,0)="     Field#^External^Internal"
^XWB(8994,4238,1,13,0)="     ..."
^XWB(8994,4238,1,14,0)="     ..."
^XWB(8994,4238,1,15,0)="     14^Line Number^ Extended Description data"
^XWB(8994,4238,1,16,0)="        (max 245 characters per line)"
^XWB(8994,4238,1,17,0)="     ..."
^XWB(8994,4238,1,18,0)="     ..."
^XWB(8994,4238,1,19,0)="     ""$$END$$"" - final entry in array"
^XWB(8994,4238,1,20,0)="  Required billing item fields:"
^XWB(8994,4238,1,21,0)="    .01 Billing Item (from file 661) - billing item should be active"
^XWB(8994,4238,1,22,0)="        (file 441, field 16 Inactivated Item? = """")."
^XWB(8994,4238,1,23,0)="        NOTE:  If the billing item is inactive in file 441, field 16"
^XWB(8994,4238,1,24,0)="               will contain ""INACTIVATED"" if inactivated"
^XWB(8994,4238,1,25,0)="               (internal value = 1)."
^XWB(8994,4238,1,26,0)="    1   Brief Description (3-60 characters)"
^XWB(8994,4238,1,27,0)="    3   Qty - maximum 300 items "
^XWB(8994,4238,1,28,0)="    4   Unit of Issue (from file 420.5)"
^XWB(8994,4238,1,29,0)="    8   Type of Transaction - set of codes -"
^XWB(8994,4238,1,30,0)="        (I=Initial Issue, R=Replace, S=Spare, X=Repair, 5=Rental)"
^XWB(8994,4238,1,31,0)="    9   Patient Category - set of codes -"
^XWB(8994,4238,1,32,0)="        (1=SC/OP, 4=NSC/OP)"
^XWB(8994,4238,1,33,0)="    11  Source (""C"" - always commercial for Prosthetics)commercial)"
^XWB(8994,4238,1,34,0)="    16  PSAS HCPCS (from file 661.1) - should be active"
^XWB(8994,4238,1,35,0)="        NOTE:  Field 3 Status in file 661.1 = ""ACTIVE"" (1)"
^XWB(8994,4238,1,36,0)="        or ""INACTIVE"" (0)."
^XWB(8994,4238,1,37,0)=" "
^XWB(8994,4238,1,38,0)="  Non-required field checks:"
^XWB(8994,4238,1,39,0)="    2     Unit Cost - 0-999999.99, two decimals"
^XWB(8994,4238,1,40,0)="    7     Remarks - 0-30 characters"
^XWB(8994,4238,1,41,0)="    13    Contract # - 1-30 characters"
^XWB(8994,4238,1,42,0)="    15    Serial Number - 3-15 characters"
^XWB(8994,4238,1,43,0)="    15.2  Manufacturer - 1-30 characters"
^XWB(8994,4238,1,44,0)="    15.4  Model - 1-30 characters"
^XWB(8994,4238,1,45,0)="    15.6  Lot # - 1-30 characters"
^XWB(8994,4238,1,46,0)="    18    Exclude/Waiver - set of codes"
^XWB(8994,4238,1,47,0)="          (""E"" - Exclude, ""W"" - Waiver)"
^XWB(8994,4238,1,48,0)="    19    Number of Bids - 0-99, no decimals"
^XWB(8994,4238,1,49,0)="          (Required for these PSAS HCPCS items:"
^XWB(8994,4238,1,50,0)="          HISAN, HISAS, VA105, VA141, VA159)"
^XWB(8994,4238,1,51,0)=" "
^XWB(8994,4238,1,52,0)="  Output:"
^XWB(8994,4238,1,53,0)="    Error Messages:"
^XWB(8994,4238,1,54,0)="      DSSORET=""-1^<error message> (failure) or"
^XWB(8994,4238,1,55,0)="               ""0^""<warning message> (no data found)"
^XWB(8994,4238,1,56,0)="    Successful Completion:"
^XWB(8994,4238,1,57,0)="      DSSORET=File 664 IEN^File 664 Billing Item IEN^""Prosthetics"
^XWB(8994,4238,1,58,0)="        1358 file updated successfully."""
