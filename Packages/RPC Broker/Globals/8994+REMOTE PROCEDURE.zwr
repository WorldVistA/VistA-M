^XWB(8994,3626,2,2,1,0)="^^1^1^3151222^"
^XWB(8994,3626,2,2,1,1,0)="Clinic ID pointer to HOSPITAL LOCATION file 44"
^XWB(8994,3626,2,3,0)="SDT^1^^1^3"
^XWB(8994,3626,2,3,1,0)="^^1^1^3151222^"
^XWB(8994,3626,2,3,1,1,0)="Appointment Date/Time in external format"
^XWB(8994,3626,2,"B","DFN",1)=""
^XWB(8994,3626,2,"B","SDCL",2)=""
^XWB(8994,3626,2,"B","SDT",3)=""
