^XWB(8994,2976,2,0)="^8994.02A^6^4"
^XWB(8994,2976,2,3,0)="STDT^1^7^0^2"
^XWB(8994,2976,2,3,1,0)="^8994.021^2^2^3111221^^^^"
^XWB(8994,2976,2,3,1,1,0)="This is the FileMan date the report should stop counting.  If null the "
^XWB(8994,2976,2,3,1,2,0)="report will count all records from the start date thru the current date."
^XWB(8994,2976,2,4,0)="ENDT^1^7^0^3"
^XWB(8994,2976,2,4,1,0)="^8994.021^1^1^3111221^^"
