^XWB(8994,1975,2,3,0)="EDATE^1^^1^3"
^XWB(8994,1975,2,3,1,0)="^^1^1^3101006^"
^XWB(8994,1975,2,3,1,1,0)="Ending date in a date range to use for retrieving results for the report."
^XWB(8994,1975,2,4,0)="RONUM^1^^0^4"
^XWB(8994,1975,2,4,1,0)="^^3^3^3101006^"
^XWB(8994,1975,2,4,1,1,0)="Regional Office number should be passed if you"
^XWB(8994,1975,2,4,1,2,0)="wish to consider only one specific Regional Office"
^XWB(8994,1975,2,4,1,3,0)="in the report."
^XWB(8994,1975,2,6,0)="REP^1^1^1^5"
^XWB(8994,1975,2,6,1,0)="^8994.021^2^2^3101006^^"
^XWB(8994,1975,2,6,1,1,0)="Pass 'A' for an A&A Report"
^XWB(8994,1975,2,6,1,2,0)="Pass 'P' for a Pension Report"
