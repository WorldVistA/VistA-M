^XWB(8994,4407,3,2,0)="0 = Don't exclude"
^XWB(8994,4407,3,3,0)="-1^Error Message = Error condition"
^XWB(8994,4408,0)="ORWTIU PCTCOPY^PCTCOPY^ORWTIU^1"
