^XWB(8994,4870,0)="PSO EPCS DEADOJ^DEADOJ^PSOEPUT^2^R"
^XWB(8994,4870,1,0)="^8994.01^25^25^3210511^"
^XWB(8994,4870,1,1,0)="This RPC call accepts a DEA Number as input. It calls the DOJ/DEA Web"
^XWB(8994,4870,1,2,0)="Service to get the most recent information for the provider which is "
^XWB(8994,4870,1,3,0)="returned to the calling program in a single string with ""^"" delimited"
^XWB(8994,4870,1,4,0)="data. The values in the string are:"
^XWB(8994,4870,1,5,0)=" "
^XWB(8994,4870,1,6,0)="  1 - PROVIDER NAME"
^XWB(8994,4870,1,7,0)="  2 - ADDRESS 1"
^XWB(8994,4870,1,8,0)="  3 - ADDRESS 2"
^XWB(8994,4870,1,9,0)="  4 - ADDRESS 3"
^XWB(8994,4870,1,10,0)="  5 - CITY"
^XWB(8994,4870,1,11,0)="  6 - STATE"
^XWB(8994,4870,1,12,0)="  7 - STATE POINTER"
^XWB(8994,4870,1,13,0)="  8 - ZIP CODE"
^XWB(8994,4870,1,14,0)="  9 - ACTIVITY CODE"
^XWB(8994,4870,1,15,0)=" 10 - TYPE"
^XWB(8994,4870,1,16,0)=" 11 - DEA NUMBER"
^XWB(8994,4870,1,17,0)=" 12 - EXPIRATION DATE"
^XWB(8994,4870,1,18,0)=" 13 - PROCESSED DATE"
^XWB(8994,4870,1,19,0)=" 14 - DETOX NUMBER"
^XWB(8994,4870,1,20,0)=" 15 - SCHDEULE II NARCOTIC"
^XWB(8994,4870,1,21,0)=" 16 - SCHEDULE II NON-NARCOTIC"
^XWB(8994,4870,1,22,0)=" 17 - SCHEDULE III NARCOTIC"
^XWB(8994,4870,1,23,0)=" 18 - SCHEDULE III NON-NARCOTIC"
^XWB(8994,4870,1,24,0)=" 19 - SCHEDULE IV"
^XWB(8994,4870,1,25,0)=" 20 - SCHEDULE V"
^XWB(8994,4870,2,0)="^8994.02A^1^1"
^XWB(8994,4870,2,1,0)="Provider DEA#^1^^1^1"
^XWB(8994,4870,2,1,1,0)="^8994.021^1^1^3210511^^"
^XWB(8994,4870,2,1,1,1,0)="DEA NUMBER FOR LOOKUP THROUGH THE DOJ/DEA WEB SERVICE."
^XWB(8994,4870,2,"B","Provider DEA#",1)=""
^XWB(8994,4870,2,"PARAMSEQ",1,1)=""
^XWB(8994,4870,3,0)="^8994.03^2^2^3210511^^"
^XWB(8994,4870,3,1,0)="An string of data containing provider information from the DOJ/DEA web"
^XWB(8994,4870,3,2,0)="service."
^XWB(8994,4871,0)="PSO EPCS MBM^MBM^PSOEPUT^1^R"
^XWB(8994,4871,1,0)="^8994.01^2^2^3211029^^^^"
^XWB(8994,4871,1,1,0)="This RPC is provided to ePCS GUI to check if the site is setup for Meds"
^XWB(8994,4871,1,2,0)="by Mail service."
^XWB(8994,4871,2,0)="^8994.02A^^0"
^XWB(8994,4872,0)="PSO EPCS REMOVE DEA^DEAREM^PSOEPUT^1^R"
^XWB(8994,4872,1,0)="^8994.01^4^4^3210511^^^"
^XWB(8994,4872,1,1,0)="Functionality to remove a DEA multiple from file #200, Field 53.21"
^XWB(8994,4872,1,2,0)="  INPUT:  NPIEN - NEW PERSON FILE #200 INTERNAL ENTRY NUMBER"
^XWB(8994,4872,1,3,0)="          DEATXT - PROPERLY FORMATTED DEA NUMBER"
^XWB(8994,4872,1,4,0)="  OUTPUT: RET - 1 for SUCCESS, 0 for UNSUCCESSFUL"
^XWB(8994,4872,2,0)="^8994.02A^2^2"
^XWB(8994,4872,2,1,0)="NPIEN^1^^1^1"
^XWB(8994,4872,2,2,0)="DEATXT^1^^1^2"
^XWB(8994,4872,2,"B","DEATXT",2)=""
^XWB(8994,4872,2,"B","NPIEN",1)=""
^XWB(8994,4872,2,"PARAMSEQ",1,1)=""
^XWB(8994,4872,2,"PARAMSEQ",2,2)=""
^XWB(8994,4872,3,0)="^8994.03^1^1^3210511^^^"
^XWB(8994,4872,3,1,0)="OUTPUT: RET - 1 for SUCCESS, 0 for UNSUCCESSFUL"
^XWB(8994,4873,0)="PSO EPCS DEA DUP CHECK^DUPCHK^PSOEPUT^1^R"
^XWB(8994,4873,1,0)="^8994.01^3^3^3211110^^^^"
^XWB(8994,4873,1,1,0)="This RPC will accept a DEA in text format, and an institutional suffix if "
^XWB(8994,4873,1,2,0)="available.  It will perform checking to determine if the DEA is being "
^XWB(8994,4873,1,3,0)="used by another user."
^XWB(8994,4873,2,0)="^8994.02A^2^2"
^XWB(8994,4873,2,1,0)="DEATXT^1^^1^1"
^XWB(8994,4873,2,1,1,0)="^^1^1^3181116^"
^XWB(8994,4873,2,1,1,1,0)="This is the providers DEA number in text format."
^XWB(8994,4873,2,2,0)="SUFFIX^1^^1^2"
^XWB(8994,4873,2,2,1,0)="^8994.021^1^1^3211110^^^^"
^XWB(8994,4873,2,2,1,1,0)="This is the institutional suffix if available."
^XWB(8994,4873,2,"B","DEATXT",1)=""
^XWB(8994,4873,2,"B","SUFFIX",2)=""
^XWB(8994,4873,2,"PARAMSEQ",1,1)=""
^XWB(8994,4873,2,"PARAMSEQ",2,2)=""
^XWB(8994,4873,3,0)="^8994.03^4^4^3211110^^^^"
^XWB(8994,4873,3,1,0)="The return value will be:"
^XWB(8994,4873,3,2,0)="  1^Success - for a DEA number that does not have any duplicates."
^XWB(8994,4873,3,3,0)="  0^Duplicate information if the DEA number is being used by another "
^XWB(8994,4873,3,4,0)="provider."
^XWB(8994,4874,0)="PSO EPCS DEALIST^DEALIST^PSOEPUT^2^R"
^XWB(8994,4874,1,0)="^8994.01^21^21^3210511^^"
^XWB(8994,4874,1,1,0)="This remote procedure call will provide a list of active DEA #s for a "
^XWB(8994,4874,1,2,0)="given provider."
^XWB(8994,4874,1,3,0)=" "
^XWB(8994,4874,1,4,0)="INPUT:  NPIEN - NEW PERSON FILE #200 INTERNAL ENTRY NUMBER"
^XWB(8994,4874,1,5,0)=" "
^XWB(8994,4874,1,6,0)="OUTPUT: RET - A STRING OF DEA INFORMATION DELIMITED BY THE ""^"""
^XWB(8994,4874,1,7,0)="          1 - DEA NUMBER"
^XWB(8994,4874,1,8,0)="          2 - INDIVIDUAL DEA SUFFIX"
^XWB(8994,4874,1,9,0)="          3 - STATE"
^XWB(8994,4874,1,10,0)="          4 - DETOX NUMBER"
^XWB(8994,4874,1,11,0)="          5 - EXPIRATION DATE: FROM THE DEA NUMBERS FILE (#8991.9), "
^XWB(8994,4874,1,12,0)="              FIELD EXPIRATION DATE (#.04)"
^XWB(8994,4874,1,13,0)="          6 - NPIENS"
^XWB(8994,4874,1,14,0)="          7 - DNIENS"
^XWB(8994,4874,1,15,0)="          8 - SCHEDULE II NARCOTIC"
^XWB(8994,4874,1,16,0)="          9 - SCHEDULE II NON-NARCOTIC"
^XWB(8994,4874,1,17,0)="         10 - SCHEDULE III NARCOTIC"
^XWB(8994,4874,1,18,0)="         11 - SCHEDULE III NON-NARCOTIC"
^XWB(8994,4874,1,19,0)="         12 - SCHEDULE IV"
^XWB(8994,4874,1,20,0)="         13 - SCHEDULE V"
^XWB(8994,4874,1,21,0)="         14 - USE FOR INPATIENT ORDERS?"
^XWB(8994,4874,2,0)="^8994.02A^1^1"
^XWB(8994,4874,2,1,0)="NPIEN^1^^1^1"
^XWB(8994,4874,2,1,1,0)="^8994.021^1^1^3210511^^"
^XWB(8994,4874,2,1,1,1,0)="This is the providers IEN in the NEW PERSON FILE #200."
^XWB(8994,4874,2,"B","NPIEN",1)=""
