^XWB(8994,4190,2,"PARAMSEQ",2,2)=""
^XWB(8994,4190,3,0)="^^2^2^3120622^"
^XWB(8994,4190,3,1,0)="Returns 0 on failure, 1 on success."
^XWB(8994,4190,3,2,0)=""
^XWB(8994,4191,0)="XULM KILL PROCESS^KILLPROC^XULMRPC^1^P^0"
^XWB(8994,4191,1,0)="^8994.01^2^2^3120624^^^^"
^XWB(8994,4191,1,1,0)="This RPC is used by the Kernel Lock Manager to terminate a process."
^XWB(8994,4191,1,2,0)=""
^XWB(8994,4191,2,0)="^8994.02A^2^2"
^XWB(8994,4191,2,1,0)="PID^1^250^1^1"
^XWB(8994,4191,2,1,1,0)="^8994.021^2^2^3120624^^^"
^XWB(8994,4191,2,1,1,1,0)="This is the PID of the process to be killed."
^XWB(8994,4191,2,1,1,2,0)=""
