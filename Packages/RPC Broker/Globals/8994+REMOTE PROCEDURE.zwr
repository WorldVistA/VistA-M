^XWB(8994,3954,2,1,0)="ENT^1^30^1^1"
^XWB(8994,3954,2,1,1,0)="^8994.021^1^1^3130205^^"
^XWB(8994,3954,2,1,1,1,0)="Parameter entity (either ""SYS"" or ""USR"") for which to save instances."
