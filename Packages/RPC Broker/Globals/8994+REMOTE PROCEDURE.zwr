^XWB(8994,3816,1,2,0)="#44)."
^XWB(8994,3816,2,0)="^8994.02A^1^1"
^XWB(8994,3816,2,1,0)="SDECCL^1^10^1^1"
^XWB(8994,3816,2,1,1,0)="^^1^1^3171201^"
