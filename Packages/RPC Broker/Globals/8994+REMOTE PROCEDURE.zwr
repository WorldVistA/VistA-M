^XWB(8994,2914,2,"PARAMSEQ",4,4)=""
^XWB(8994,2914,3,0)="^8994.03^2^2^3061030^^"
^XWB(8994,2914,3,1,0)="Returns a local variable containing the results of the status update in "
^XWB(8994,2914,3,2,0)="DIALOG format."
^XWB(8994,2915,0)="MDCP UPDATE MESSAGE REASON^UPDRSN^MDCPHL7B^4^R^^^1"
^XWB(8994,2915,1,0)="^8994.01^3^3^3091118^^^"
^XWB(8994,2915,1,1,0)="This RPC call will add word processing text to the CLIO_HL7_LOG file to "
^XWB(8994,2915,1,2,0)="explain the reason for the current status.  It is primarily intended to "
^XWB(8994,2915,1,3,0)="be used to store error text from CliO."
