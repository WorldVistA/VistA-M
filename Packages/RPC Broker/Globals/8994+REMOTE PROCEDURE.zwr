^XWB(8994,4313,2,2,1,1,0)="Array of FPDS fields and their associated values to store into the "
^XWB(8994,4313,2,2,1,2,0)="specified Procurement and Accounting Transactions file (#442)."
^XWB(8994,4313,2,2,1,3,0)=" "
^XWB(8994,4313,2,2,1,4,0)="Format - as returned from RPC DSSO DTLD CRT 442 5-FPDS DFLT with changed "
^XWB(8994,4313,2,2,1,5,0)="values based on user input - i.e. - "
^XWB(8994,4313,2,2,1,6,0)="DSSOFPD(field nbr)="
^XWB(8994,4313,2,2,1,7,0)="       442 ^ IEN ^ field number ^ value "
^XWB(8994,4313,2,2,1,8,0)="       where:"
^XWB(8994,4313,2,2,1,9,0)="        pc 1 - file number (""442"")"
^XWB(8994,4313,2,2,1,10,0)="        pc 2 - file 442 IEN"
^XWB(8994,4313,2,2,1,11,0)="        pc 3 - FPDS field number"
^XWB(8994,4313,2,2,1,12,0)="        pc 4 - default field value"
^XWB(8994,4313,2,"B","DSSO442",1)=""
^XWB(8994,4313,2,"B","DSSOFPD",2)=""
^XWB(8994,4313,2,"PARAMSEQ",1,1)=""
^XWB(8994,4313,2,"PARAMSEQ",2,2)=""
^XWB(8994,4313,3,0)="^8994.03^7^7^3141219^^"
^XWB(8994,4313,3,1,0)="Output:"
^XWB(8994,4313,3,2,0)="  Error Messages: ""-1^""_error message or ""0^""_warning message"
^XWB(8994,4313,3,3,0)=" "
^XWB(8994,4313,3,4,0)="    Successful Completion: "
^XWB(8994,4313,3,5,0)="      File 442 IEN_""^FPDS fields updated successfully."""
^XWB(8994,4313,3,6,0)=" "
^XWB(8994,4313,3,7,0)="      Proceed to RPC DSSO DTLD CRT 442 7-COMPLETE."
^XWB(8994,4314,0)="DSSO CLONE CPRS CONSULT^EN^DSSOSUC^1"
^XWB(8994,4314,1,0)="^^4^4^3140930^"
^XWB(8994,4314,1,1,0)="This RPC clones a closed CPRS consult in the Prosthetic Suspense file"
^XWB(8994,4314,1,2,0)="(#668). Only suspense items with Type of Request (field #9) = 1 (ROUTINE"
^XWB(8994,4314,1,3,0)="-> CPRS) and Status (field #14) = ""C"" (Closed) can be cloned by this"
^XWB(8994,4314,1,4,0)="RPC."
^XWB(8994,4314,2,0)="^8994.02A^1^1"
^XWB(8994,4314,2,1,0)="DSSO668^1^15^1^1"
^XWB(8994,4314,2,1,1,0)="^8994.021^1^1^3140930^^"
^XWB(8994,4314,2,1,1,1,0)="Prosthetic Suspense file (#668) IEN"
^XWB(8994,4314,2,"B","DSSO668",1)=""
^XWB(8994,4314,2,"PARAMSEQ",1,1)=""
^XWB(8994,4314,3,0)="^8994.03^4^4^3140930^^"
^XWB(8994,4314,3,1,0)="Output:"
^XWB(8994,4314,3,2,0)="  DSSORET=""-1^""_error message or ""0^""_error message"
^XWB(8994,4314,3,3,0)="  DSSORET=RMPRA_""^New Clone Suspense Created."""
^XWB(8994,4314,3,4,0)="    where RMPRA=IEN of newly-created Prosthetic Suspense record"
^XWB(8994,4316,0)="DSSO DELAYED ORDER REPORT^DSSODOR^DSSOSU^4^A^^^1"
^XWB(8994,4316,1,0)="^8994.01^1^1^3180802^^^^"
^XWB(8994,4316,1,1,0)="This RPC is used to return a Delayed Order Report."
^XWB(8994,4316,2,0)="^8994.02A^7^7"
^XWB(8994,4316,2,1,0)="DSSOUSER^1^30^1^1"
^XWB(8994,4316,2,1,1,0)="^8994.021^1^1^3171013^^^"
^XWB(8994,4316,2,1,1,1,0)="This is the DUZ of the Purchasing Agent."
^XWB(8994,4316,2,2,0)="DSSOSTART^1^2^0^2"
^XWB(8994,4316,2,2,1,0)="^^2^2^3170615^"
^XWB(8994,4316,2,2,1,1,0)="The start of a Purchasing Agent's SSN range.  It consists of the last two "
^XWB(8994,4316,2,2,1,2,0)="digits of an SSN."
^XWB(8994,4316,2,3,0)="DSSOSTOP^1^2^0^3"
^XWB(8994,4316,2,3,1,0)="^^2^2^3170615^"
^XWB(8994,4316,2,3,1,1,0)="The end of a Purchasing Agent's SSN range.  It consists of the last two "
^XWB(8994,4316,2,3,1,2,0)="digits of an SSN."
^XWB(8994,4316,2,4,0)="DSSOSITE^1^30^1^4"
^XWB(8994,4316,2,4,1,0)="^^1^1^3170615^"
^XWB(8994,4316,2,4,1,1,0)="A Prosthetic Site IEN (#669.9)"
^XWB(8994,4316,2,4,1,2,0)=" "
^XWB(8994,4316,2,4,1,3,0)="The value ""ALL"" can be passed to search all Prosthetic Site's."
^XWB(8994,4316,2,5,0)="DSSOSORT^1^4^1^5"
^XWB(8994,4316,2,5,1,0)="^^5^5^3170615^"
^XWB(8994,4316,2,5,1,1,0)="A series of flags which determines what results are returned:"
^XWB(8994,4316,2,5,1,2,0)="  P = Pending"
^XWB(8994,4316,2,5,1,3,0)="  O = Open"
^XWB(8994,4316,2,5,1,4,0)="  C = Closed"
^XWB(8994,4316,2,5,1,5,0)="  X = Cancelled"
^XWB(8994,4316,2,6,0)="DSSODATE^1^7^1^6"
^XWB(8994,4316,2,6,1,0)="^8994.021^1^1^3171013^^^^"
^XWB(8994,4316,2,6,1,1,0)="The date from which the search will start."
^XWB(8994,4316,2,7,0)="DSSOCAL^1^1^0^7"
^XWB(8994,4316,2,7,1,0)="^8994.021^5^5^3180802^^^"
^XWB(8994,4316,2,7,1,1,0)="This is a flag which determines if the RPC returns work days or calendar "
^XWB(8994,4316,2,7,1,2,0)="days for the Delayed Order Report."
^XWB(8994,4316,2,7,1,3,0)=" "
^XWB(8994,4316,2,7,1,4,0)="  0 = Work Days (Default)"
^XWB(8994,4316,2,7,1,5,0)="  1 = Calendar Days"
^XWB(8994,4316,2,"B","DATE",6)=""
^XWB(8994,4316,2,"B","DSSOCAL",7)=""
^XWB(8994,4316,2,"B","DSSODATE",6)=""
^XWB(8994,4316,2,"B","DSSOSITE",4)=""
^XWB(8994,4316,2,"B","DSSOSORT",5)=""
^XWB(8994,4316,2,"B","DSSOSTART",2)=""
^XWB(8994,4316,2,"B","DSSOSTOP",3)=""
^XWB(8994,4316,2,"B","DSSOUSER",1)=""
^XWB(8994,4316,2,"B","DUZ",1)=""
^XWB(8994,4316,2,"B","SITE",4)=""
^XWB(8994,4316,2,"B","SORT",5)=""
^XWB(8994,4316,2,"B","START",2)=""
^XWB(8994,4316,2,"B","STOP",3)=""
^XWB(8994,4316,2,"PARAMSEQ",1,1)=""
^XWB(8994,4316,2,"PARAMSEQ",2,2)=""
^XWB(8994,4316,2,"PARAMSEQ",3,3)=""
^XWB(8994,4316,2,"PARAMSEQ",4,4)=""
^XWB(8994,4316,2,"PARAMSEQ",5,5)=""
^XWB(8994,4316,2,"PARAMSEQ",6,6)=""
^XWB(8994,4316,2,"PARAMSEQ",7,7)=""
^XWB(8994,4316,3,0)="^8994.03^32^32^3180802^^"
^XWB(8994,4316,3,1,0)="Returns an array List[n]."
^XWB(8994,4316,3,2,0)=" "
^XWB(8994,4316,3,3,0)="The format of the returned array will be as follows:"
^XWB(8994,4316,3,4,0)="  List[n] = p1^p2^p3^p4^p5^p6^p7^p8^p8^p10^p11^p12^p13^p14^p15"
^XWB(8994,4316,3,5,0)="            ^p16^p17^p18^p19^p20^p21^p22^p23^p24^p25^p26^p27"
^XWB(8994,4316,3,6,0)=" "
^XWB(8994,4316,3,7,0)="    p1  = Suspense Date                p15 = File #668 IEN"
^XWB(8994,4316,3,8,0)="    p2  = Patient Name                 p16 = Station"
^XWB(8994,4316,3,9,0)="    p3  = Patient SSN                  p17 = Linked (boolean)"
^XWB(8994,4316,3,10,0)="    p4  = Patient Long ID              p19 = # Days Pending"
^XWB(8994,4316,3,11,0)="    p5  = Type of Request              p20 = Work Days Pending"
^XWB(8994,4316,3,12,0)="    p6  = Description of Item/Service  p21 = Work Days Pending"
^XWB(8994,4316,3,13,0)="    p7  = Initial Action Date          p22 = Work Days Pending"
^XWB(8994,4316,3,14,0)="    p8  = Pending > 1 working week     p23 = Work Days Pending"
^XWB(8994,4316,3,15,0)="    p9  = # Days From Create           p24 = Patient IEN"
^XWB(8994,4316,3,16,0)="    p10 = Days From Create             p25 = Work Order IEN (#664.1)"
^XWB(8994,4316,3,17,0)="    p11 = Days From Create             p26 = Work Order #"
^XWB(8994,4316,3,18,0)="    p12 = Days From Create             p27 = Assigned Tech DUZ"
^XWB(8994,4316,3,19,0)="    p13 = Days From Create             "
^XWB(8994,4316,3,20,0)="    p14 = Status                       "
^XWB(8994,4316,3,21,0)=" "
^XWB(8994,4316,3,22,0)="This RPC also returns four lines which contains collective stats about "
^XWB(8994,4316,3,23,0)="the results.  These four lines only contain totals for manuals, consults, "
^XWB(8994,4316,3,24,0)="and pendings.  These four lines also use piece 18, but only to label the "
^XWB(8994,4316,3,25,0)="different totals (0-3)"
^XWB(8994,4316,3,26,0)=" "
^XWB(8994,4316,3,27,0)="  List[n-3] = Manuals"
^XWB(8994,4316,3,28,0)="  List[n-2] = Consults"
^XWB(8994,4316,3,29,0)="  List[n-1] = Pending (First action to current date)"
^XWB(8994,4316,3,30,0)="  List[n]   = Pending (Creation to first action)"
^XWB(8994,4316,3,31,0)=" "
^XWB(8994,4316,3,32,0)="If an error occurs, the return will be List[n] = -1^message."
^XWB(8994,4317,0)="DSSO SSN PO LOOKUP^EN^DSSOUT4^4^A^^^1"
^XWB(8994,4317,1,0)="^^2^2^3141024^"
^XWB(8994,4317,1,1,0)="This RPC performs a search for a patient based on SSN or short SSN and "
^XWB(8994,4317,1,2,0)="then searches for all POs for that patient."
^XWB(8994,4317,2,0)="^8994.02A^1^1"
^XWB(8994,4317,2,1,0)="DSSOSSN^1^9^1^1"
^XWB(8994,4317,2,1,1,0)="^^3^3^3141024^"
^XWB(8994,4317,2,1,1,1,0)="This is the SSN which you wish to search for.  It can be either the full "
^XWB(8994,4317,2,1,1,2,0)="nine digit SSN or it can be the short SSN (first letter of last name and "
^XWB(8994,4317,2,1,1,3,0)="the last four digits of their SSN)."
^XWB(8994,4317,2,"B","DSSOSSN",1)=""
^XWB(8994,4317,2,"PARAMSEQ",1,1)=""
^XWB(8994,4317,3,0)="^^14^14^3141024^"
^XWB(8994,4317,3,1,0)="Returns an array List[n]."
^XWB(8994,4317,3,2,0)=" "
^XWB(8994,4317,3,3,0)="The format of the returned array will be as follows:"
^XWB(8994,4317,3,4,0)="  List[n] = p1^p2^p3^p4^p5^p6^p7^p8^p8^p10"
^XWB(8994,4317,3,5,0)=" "
^XWB(8994,4317,3,6,0)="    p1 = Purchase Order IEN         p6  = Vendor"
^XWB(8994,4317,3,7,0)="    p2 = Purchase Order Date        p7  = Long PO #"
^XWB(8994,4317,3,8,0)="    p3 = Obligation #               p8  = Deliver To"
^XWB(8994,4317,3,9,0)="    p4 = Purchase Order #           p9  = Patient IEN"
^XWB(8994,4317,3,10,0)="    p5 = Patient Name               p10 = Patient SSN"
^XWB(8994,4317,3,11,0)=" "
^XWB(8994,4317,3,12,0)="If nothing is found, the return will be List[n] = 0^NOTHING TO REPORT."
^XWB(8994,4317,3,13,0)=" "
^XWB(8994,4317,3,14,0)="If an error occurs, the return will be List[n] = -1^message."
^XWB(8994,4318,0)="DSSO GET PROS 1358 DATA^DATA^DSSOPP4^4^^^^1"
^XWB(8994,4318,1,0)="^8994.01^2^2^3141106^^^^"
^XWB(8994,4318,1,1,0)="This RPC returns all fields from the Prosthetics 1358 file (#664) for"
^XWB(8994,4318,1,2,0)="the requested Purchase Card Reference (i.e. - C50141)."
^XWB(8994,4318,2,0)="^8994.02A^1^1"
^XWB(8994,4318,2,1,0)="DSSOPCR^1^7^1^1"
^XWB(8994,4318,2,1,1,0)="^8994.021^2^2^3141106^^^^"
^XWB(8994,4318,2,1,1,1,0)="Purchase Card Reference - second ""-""-piece of the purchase card number "
^XWB(8994,4318,2,1,1,2,0)="(i.e. - ""C50141"")"
^XWB(8994,4318,2,"B","DSSOPCR",1)=""
^XWB(8994,4318,2,"PARAMSEQ",1,1)=""
^XWB(8994,4318,3,0)="^^11^11^3141106^"
^XWB(8994,4318,3,1,0)="Output:"
^XWB(8994,4318,3,2,0)="      Error Messages:"
^XWB(8994,4318,3,3,0)="        DSSORET=""-1^""_<error message> (failure) or"
^XWB(8994,4318,3,4,0)="                    ""0^""_<warning message> (no data found)"
^XWB(8994,4318,3,5,0)="      Successful Completion:"
^XWB(8994,4318,3,6,0)="        DSSORET="
^XWB(8994,4318,3,7,0)="          pc 1  File 664 IEN_"",""  OR"
^XWB(8994,4318,3,8,0)="                 File 664.02 Billing Item IEN_"",""_File 664 IEN_"","""
^XWB(8994,4318,3,9,0)="          pc 2       field nuer ^"
^XWB(8994,4318,3,10,0)="          pc 3       ""E"" or ""I"" (external or internal fort) ^"
^XWB(8994,4318,3,11,0)="          pc 4       data value"
^XWB(8994,4319,0)="DSSO XPAR EDIT^CHG^DSSOXP1^1^A^^^1"
^XWB(8994,4319,1,0)="^8994.01^1^1^3180223^^^^"
^XWB(8994,4319,1,1,0)="This is used to change the value or delete an existing parameter value"
^XWB(8994,4319,2,0)="^8994.02A^2^2"
^XWB(8994,4319,2,1,0)="DSSODTA^1^250^1^1"
^XWB(8994,4319,2,1,1,0)="^^6^6^3180223^"
^XWB(8994,4319,2,1,1,1,0)="DSSODTA - required - p1~p2~p3~p4"
^XWB(8994,4319,2,1,1,2,0)=" p1 := optional - entity(s) - if not passed, set to ""USR"" for"
^XWB(8994,4319,2,1,1,3,0)="                  current user"
^XWB(8994,4319,2,1,1,4,0)=" p2 := required - parameter name"
^XWB(8994,4319,2,1,1,5,0)=" p3 := optional - instance"
^XWB(8994,4319,2,1,1,6,0)=" p4 := required - value - see XPAR documentation"
^XWB(8994,4319,2,2,0)="DSSOFUN^1^1^0^2"
^XWB(8994,4319,2,2,1,0)="^8994.021^1^1^3180223^^^^"
^XWB(8994,4319,2,2,1,1,0)="If $G(DSSOFUN) then extrinsic function, else RPC."
^XWB(8994,4319,2,"B","DATA",1)=""
^XWB(8994,4319,2,"B","DSSODTA",1)=""
^XWB(8994,4319,2,"B","DSSOFUN",2)=""
^XWB(8994,4319,2,"PARAMSEQ",1,1)=""
^XWB(8994,4319,2,"PARAMSEQ",2,2)=""
^XWB(8994,4319,3,0)="^8994.03^2^2^3180223^^^^"
^XWB(8994,4319,3,1,0)="If the parameter is successfully changed, return 1"
^XWB(8994,4319,3,2,0)="Else return -1^error message"
^XWB(8994,4320,0)="DSSO XPAR GET VALUE^GET1^DSSOXP1^1^A^^^1"
^XWB(8994,4320,1,0)="^8994.01^1^1^3180223^^^^"
^XWB(8994,4320,1,1,0)="This will return the value of a single entity/param/instance"
^XWB(8994,4320,2,0)="^8994.02A^2^2"
^XWB(8994,4320,2,1,0)="DSSODTA^1^250^1^1"
^XWB(8994,4320,2,1,1,0)="^8994.021^9^9^3180223^^^"
^XWB(8994,4320,2,1,1,1,0)="DATA - required - p1~p2~p3~~~p6"
^XWB(8994,4320,2,1,1,2,0)=" p1 := optional - entity - if not passed, set to ""USR"" for"
^XWB(8994,4320,2,1,1,3,0)="                  current user"
^XWB(8994,4320,2,1,1,4,0)=" p2 := required - parameter name"
^XWB(8994,4320,2,1,1,5,0)=" p3 := optional - instance"
^XWB(8994,4320,2,1,1,6,0)=" p6 := optional - format code determines return values"
^XWB(8994,4320,2,1,1,7,0)="       Q - internal value - [default]"
^XWB(8994,4320,2,1,1,8,0)="       E - external value"
^XWB(8994,4320,2,1,1,9,0)="       B - internal^external values"
^XWB(8994,4320,2,2,0)="DSSOFUN^1^1^0^2"
^XWB(8994,4320,2,2,1,0)="^8994.021^1^1^3180223^^"
^XWB(8994,4320,2,2,1,1,0)="If $G(DSSOFUN) then extrinsic function, else RPC."
^XWB(8994,4320,2,"B","DATA",1)=""
^XWB(8994,4320,2,"B","DSSODTA",1)=""
^XWB(8994,4320,2,"B","DSSOFUN",2)=""
^XWB(8994,4320,2,"PARAMSEQ",1,1)=""
^XWB(8994,4320,2,"PARAMSEQ",2,2)=""
^XWB(8994,4320,3,0)="^8994.03^3^3^3180223^^^^"
^XWB(8994,4320,3,1,0)="If problem encountered getting value, return -1^error message"
^XWB(8994,4320,3,2,0)="Else return the value in the format requested for the"
^XWB(8994,4320,3,3,0)="entity/param/instance"
^XWB(8994,4321,0)="DSSO DTLD RETRIEVE EXT COMP^EXTCOMP^DSSODU6^2"
^XWB(8994,4321,1,0)="^^3^3^3141202^"
^XWB(8994,4321,1,1,0)="This RPC returns a list of Extent Competed codes from the Extent Competed "
^XWB(8994,4321,1,2,0)="file (#420.53).  All codes, a list of codes beginning with the requested "
^XWB(8994,4321,1,3,0)="value, or a specific code may be returned."
^XWB(8994,4321,2,0)="^8994.02A^2^2"
^XWB(8994,4321,2,1,0)="DSSOCDE^1^15^0^1"
^XWB(8994,4321,2,1,1,0)="^^2^2^3141202^"
^XWB(8994,4321,2,1,1,1,0)="Null, partial value, or specific code from the Extent Competed file "
^XWB(8994,4321,2,1,1,2,0)="(#420.53)"
^XWB(8994,4321,2,2,0)="DSSONUM^1^4^0^2"
^XWB(8994,4321,2,2,1,0)="^^1^1^3141202^"
^XWB(8994,4321,2,2,1,1,0)="Maximum number of records to return"
^XWB(8994,4321,2,"B","DSSOCDE",1)=""
^XWB(8994,4321,2,"B","DSSONUM",2)=""
^XWB(8994,4321,2,"PARAMSEQ",1,1)=""
^XWB(8994,4321,2,"PARAMSEQ",2,2)=""
^XWB(8994,4321,3,0)="^^6^6^3141202^"
^XWB(8994,4321,3,1,0)="Output:"
^XWB(8994,4321,3,2,0)="  Error Messages:  DSSORET(0)=""-1^""_error message or ""0^""_warning message"
^XWB(8994,4321,3,3,0)=" "
^XWB(8994,4321,3,4,0)="  Successful Completion:  Data returned in format:"
^XWB(8994,4321,3,5,0)="    420.53 IEN ^ Code (#.01 external) ^ Status (#1 external) ^"
^XWB(8994,4321,3,6,0)="      Description (#2 external)"
^XWB(8994,4322,0)="DSSO DTLD GET EXTENT COMPETED^GT42053^DSSODU6^2"
^XWB(8994,4322,1,0)="^^2^2^3141202^"
^XWB(8994,4322,1,1,0)="This RPC returns all Extent Competed file (#420.53) data for the"
^XWB(8994,4322,1,2,0)="requested IEN."
^XWB(8994,4322,2,0)="^8994.02A^1^1"
^XWB(8994,4322,2,1,0)="DSSOIEN^1^15^1^1"
^XWB(8994,4322,2,1,1,0)="^^1^1^3141202^"
^XWB(8994,4322,2,1,1,1,0)="IEN of Extent Competed file (#420.53)"
^XWB(8994,4322,2,"B","DSSOIEN",1)=""
^XWB(8994,4322,2,"PARAMSEQ",1,1)=""
^XWB(8994,4322,3,0)="^^6^6^3141202^"
^XWB(8994,4322,3,1,0)="Output:"
^XWB(8994,4322,3,2,0)="  Error Messages:  ""-1^""_error message or ""0^""_warning message"
^XWB(8994,4322,3,3,0)=" "
^XWB(8994,4322,3,4,0)="  Successful Completion: Returns all fields from the Extent Competed"
^XWB(8994,4322,3,5,0)="    file (#420.53) with the requested IEN in the format:"
^XWB(8994,4322,3,6,0)="      field number ^ ""E"" ^ data (external format)"
^XWB(8994,4323,0)="DSSO DTLD FIND PARENT STATION^PARENT^DSSOUTS^1"
^XWB(8994,4323,1,0)="^8994.01^2^2^3141203^^"
^XWB(8994,4323,1,1,0)="This RPC provides an indication that the input station is a parent "
^XWB(8994,4323,1,2,0)="station in the Admin. Activity Site Parameters file (#411)."
^XWB(8994,4323,2,0)="^8994.02A^1^1"
^XWB(8994,4323,2,1,0)="DSSOSTE^1^15^1^1"
^XWB(8994,4323,2,1,1,0)="^8994.021^2^2^3141203^^"
^XWB(8994,4323,2,1,1,1,0)="Admin. Activity Site Parameters file (#411) IEN for possible parent "
^XWB(8994,4323,2,1,1,2,0)="station"
^XWB(8994,4323,2,"B","DSSOSTE",1)=""
^XWB(8994,4323,2,"PARAMSEQ",1,1)=""
^XWB(8994,4323,3,0)="^8994.03^5^5^3141203^^"
^XWB(8994,4323,3,1,0)="Output: "
^XWB(8994,4323,3,2,0)="  Error Messages:  ""-1^""_error message or ""0^""_warning message"
^XWB(8994,4323,3,3,0)="  Successful Completion:"
^XWB(8994,4323,3,4,0)="    DSSORET=""1^""_DSSOSTE_"" is a parent station."""
^XWB(8994,4323,3,5,0)="            =""0^""_DSSOSTE_"" is not a parent station."""
^XWB(8994,4324,0)="DSSO DTLD CRT 442-AMTS FPDS^AMTFPDS^DSSODP8^1"
^XWB(8994,4324,1,0)="^8994.01^5^5^3180810^^^"
^XWB(8994,4324,1,1,0)="This RPC stores the FPDS Reporting fields in the Amount multiples "
^XWB(8994,4324,1,2,0)="(#442.1) of the Procurement & Accounting Transactions file (#442)."
^XWB(8994,4324,1,3,0)="This RPC follows DSSO DTLD CRT 442-AMTS if the FPDS indicator"
^XWB(8994,4324,1,4,0)="its Successful Completion message is set to 1. Processing continues "
^XWB(8994,4324,1,5,0)="with RPC DSSO DTLD CRT 442 5-FPDS DFLT."
^XWB(8994,4324,2,0)="^8994.02A^2^2"
^XWB(8994,4324,2,1,0)="DSSO442^1^15^1^1"
^XWB(8994,4324,2,1,1,0)="^^2^2^3141218^"
^XWB(8994,4324,2,1,1,1,0)="IEN of the Procurement & Accounting Transactions file (#442) for which "
^XWB(8994,4324,2,1,1,2,0)="the Amount multiple is being populated"
^XWB(8994,4324,2,2,0)="DSSOAMT^2^65^1^2"
^XWB(8994,4324,2,2,1,0)="^8994.021^15^15^3180810^^^^"
^XWB(8994,4324,2,2,1,1,0)="DSSOAMT - If there is a contract number in the line item, an Amount"
^XWB(8994,4324,2,2,1,2,0)=" multiple will be created for each Contract number with the amount"
^XWB(8994,4324,2,2,1,3,0)=" accumulating for each line item under the specified contract. For line"
^XWB(8994,4324,2,2,1,4,0)=" items with no associated contract number, an Amount entry multiple is "
^XWB(8994,4324,2,2,1,5,0)=" also created with the contract number being set to blank - not null."
^XWB(8994,4324,2,2,1,6,0)=" "
^XWB(8994,4324,2,2,1,7,0)="  The array entry contains the following:"
^XWB(8994,4324,2,2,1,8,0)="   pc 1 - Type Code (file 420.6 IEN)"
^XWB(8994,4324,2,2,1,9,0)="   pc 2 - Comp. Status/Business (file 420.6 IEN)"
^XWB(8994,4324,2,2,1,10,0)="   pc 3 - Preference Program (file 420.6 IEN)"
^XWB(8994,4324,2,2,1,11,0)="   pc 4 - Contract/BOA Number - externally-formatted Contract/BOA Number"
^XWB(8994,4324,2,2,1,12,0)="          from the Vendor file (#440) subfile Contract/BOA Number"
^XWB(8994,4324,2,2,1,13,0)="          (#440.03)."
^XWB(8994,4324,2,2,1,14,0)="            If no contract number is specified for this Line Item, then"
^XWB(8994,4324,2,2,1,15,0)="            set this field to blank (non-null)."
^XWB(8994,4324,2,"B","DSSO442",1)=""
^XWB(8994,4324,2,"B","DSSOAMT",2)=""
^XWB(8994,4324,2,"PARAMSEQ",1,1)=""
^XWB(8994,4324,2,"PARAMSEQ",2,2)=""
^XWB(8994,4324,3,0)="^8994.03^8^8^3180810^^^^"
^XWB(8994,4324,3,1,0)="Output:"
^XWB(8994,4324,3,2,0)="   Error Messages:  DSSORET(0)=""-1^""_error message or ""0^""_warning"
^XWB(8994,4324,3,3,0)="     message"
^XWB(8994,4324,3,4,0)="   Successful Completion: Data returned in format:"
^XWB(8994,4324,3,5,0)="     442 IEN ^ AMTS FPDS Reporting fields added successfully."""
^XWB(8994,4324,3,6,0)=" "
^XWB(8994,4324,3,7,0)="     Upon successful completion of this RPC, since we know that FPDS"
^XWB(8994,4324,3,8,0)="     processing is needed, proceed to RPC DSSO DTLD CRT 442 5-FPDS DFLT."
^XWB(8994,4325,0)="DSSO DTLD CRT 442-COMMENTS^COMMENTS^DSSODP3^1^^^^1"
^XWB(8994,4325,1,0)="^8994.01^5^5^3160301^^^^"
^XWB(8994,4325,1,1,0)="If necessary, this RPC stores the Comments (field 20) for the detailed "
^XWB(8994,4325,1,2,0)="purchase order in the Procurement & Accounting Transactions file (#442)."
^XWB(8994,4325,1,3,0)=" "
^XWB(8994,4325,1,4,0)="This RPC should be run after all of the line items have been stored in "
^XWB(8994,4325,1,5,0)="the detailed purchase order."
^XWB(8994,4325,2,0)="^8994.02A^2^2"
^XWB(8994,4325,2,1,0)="DSSO442^1^15^1^1"
^XWB(8994,4325,2,1,1,0)="^^1^1^3141219^"
^XWB(8994,4325,2,1,1,1,0)="File 442 IEN"
^XWB(8994,4325,2,2,0)="DSSOCMT^2^245^0^2"
^XWB(8994,4325,2,2,1,0)="^8994.021^3^3^3160301^^^^"
^XWB(8994,4325,2,2,1,1,0)="This word-processing field contains the Comments to be stored in field 20 "
^XWB(8994,4325,2,2,1,2,0)="of the Procurement & Accounting Transactions file (#442) for the detailed "
^XWB(8994,4325,2,2,1,3,0)="purchase order being created."
^XWB(8994,4325,2,"B","DSSO442",1)=""
^XWB(8994,4325,2,"B","DSSOCMT",2)=""
^XWB(8994,4325,2,"PARAMSEQ",1,1)=""
^XWB(8994,4325,2,"PARAMSEQ",2,2)=""
^XWB(8994,4325,3,0)="^8994.03^8^8^3160301^^^^"
^XWB(8994,4325,3,1,0)="Output:"
^XWB(8994,4325,3,2,0)="   Error Messages: ""-1^""_error message"
^XWB(8994,4325,3,3,0)=" "
^XWB(8994,4325,3,4,0)="   Successful Completion:"
^XWB(8994,4325,3,5,0)="     DSSORET=File 442 IEN_""Comments stored successfully."""
^XWB(8994,4325,3,6,0)=" "
^XWB(8994,4325,3,7,0)="   Note:  This RPC should be run after all line items have been stored in "
^XWB(8994,4325,3,8,0)="          the detailed purchase order."
^XWB(8994,4326,0)="DSSO FILL SUSPENSE GRID^EN^DSSOSUS^4^A^^^1"
^XWB(8994,4326,1,0)="^8994.01^10^10^3200916^^"
^XWB(8994,4326,1,1,0)="This RPC is used to populate the suspense grid in the GUI."
^XWB(8994,4326,1,2,0)=" "
^XWB(8994,4326,1,3,0)="When using this RPC for the APAT Dashboard, leave Sort="""" and provide the "
^XWB(8994,4326,1,4,0)="starting date from which to retrieve all suspense items for all "
^XWB(8994,4326,1,5,0)="statuses.  This will be more efficient than retrieving each status "
^XWB(8994,4326,1,6,0)="individually."
^XWB(8994,4326,1,7,0)=" "
^XWB(8994,4326,1,8,0)="When a user selects a station, all consults affiliated with that station "
^XWB(8994,4326,1,9,0)="(even CBOCs) will be returned, but when a user selects a CBOC, only"
^XWB(8994,4326,1,10,0)="consults affiliated with that CBOC will be returned."
^XWB(8994,4326,2,0)="^8994.02A^14^7"
^XWB(8994,4326,2,1,0)="DSSOUSER^1^30^1^1"
^XWB(8994,4326,2,1,1,0)="^8994.021^1^1^3171013^^^"
^XWB(8994,4326,2,1,1,1,0)="This is the DUZ of the user."
^XWB(8994,4326,2,4,0)="DSSOSITE^1^30^1^2"
^XWB(8994,4326,2,4,1,0)="^8994.021^3^3^3171013^^^^"
^XWB(8994,4326,2,4,1,1,0)="A Prosthetic Site IEN (#669.9)"
^XWB(8994,4326,2,4,1,2,0)=" "
^XWB(8994,4326,2,4,1,3,0)="The value ""ALL"" can be passed to search all Prosthetic Sites."
^XWB(8994,4326,2,5,0)="DSSOSORT^1^1^0^3"
^XWB(8994,4326,2,5,1,0)="^8994.021^8^8^3171013^^^"
^XWB(8994,4326,2,5,1,1,0)="A flag which determines what results are returned:"
^XWB(8994,4326,2,5,1,2,0)="  P = Pending"
^XWB(8994,4326,2,5,1,3,0)="  O = Open"
^XWB(8994,4326,2,5,1,4,0)=" "
^XWB(8994,4326,2,5,1,5,0)="Only one value may be passed in."
^XWB(8994,4326,2,5,1,6,0)="Only used for Open and Pending requests."
^XWB(8994,4326,2,5,1,7,0)="Closed and Cancelled requests are only returned with all suspense items"
^XWB(8994,4326,2,5,1,8,0)="for a patient."
^XWB(8994,4326,2,9,0)="DSSOIEN^1^15^0^4"
^XWB(8994,4326,2,9,1,0)="^8994.021^1^1^3150129^^^^"
^XWB(8994,4326,2,9,1,1,0)="Last 668 IEN read"
^XWB(8994,4326,2,12,0)="DSSODFN^1^15^0^5"
^XWB(8994,4326,2,12,1,0)="^8994.021^2^2^3150212^^^^"
^XWB(8994,4326,2,12,1,1,0)="Patient file (#2) IEN - required for Closed and Cancelled suspense item "
^XWB(8994,4326,2,12,1,2,0)="requests;  all suspense items for the patient are returned."
^XWB(8994,4326,2,13,0)="DSSODTE^1^14^0^6"
^XWB(8994,4326,2,13,1,0)="^8994.021^7^7^3171013^^^^"
^XWB(8994,4326,2,13,1,1,0)="Starting date of returned suspense items or Last Suspense Date Processed;"
^XWB(8994,4326,2,13,1,2,0)="if Last Suspense Date Processed, must be in date.time format"
^XWB(8994,4326,2,13,1,3,0)="(yyymmdd.hhmmss)."
^XWB(8994,4326,2,13,1,4,0)=" "
^XWB(8994,4326,2,13,1,5,0)="When used, all suspense items of any status (Open, Pending, Closed, and "
^XWB(8994,4326,2,13,1,6,0)="Cancelled) that were created on or after the requested date will be "
^XWB(8994,4326,2,13,1,7,0)="returned."
^XWB(8994,4326,2,14,0)="DSSOCAL^1^1^0^7"
^XWB(8994,4326,2,14,1,0)="^8994.021^2^2^3200916^^^"
^XWB(8994,4326,2,14,1,1,0)="This is a flag to indicate if days should be calculated as work days or "
^XWB(8994,4326,2,14,1,2,0)="calendar days.  Defaults to work days."
^XWB(8994,4326,2,"B","DSSOCAL",14)=""
^XWB(8994,4326,2,"B","DSSODFN",12)=""
^XWB(8994,4326,2,"B","DSSODTE",13)=""
^XWB(8994,4326,2,"B","DSSOIEN",9)=""
^XWB(8994,4326,2,"B","DSSOSITE",4)=""
^XWB(8994,4326,2,"B","DSSOSORT",5)=""
^XWB(8994,4326,2,"B","DSSOUSER",1)=""
^XWB(8994,4326,2,"B","SITE",4)=""
^XWB(8994,4326,2,"B","SORT",5)=""
^XWB(8994,4326,2,"B","USER",1)=""
^XWB(8994,4326,2,"PARAMSEQ",1,1)=""
^XWB(8994,4326,2,"PARAMSEQ",2,4)=""
^XWB(8994,4326,2,"PARAMSEQ",3,5)=""
^XWB(8994,4326,2,"PARAMSEQ",4,9)=""
^XWB(8994,4326,2,"PARAMSEQ",5,12)=""
^XWB(8994,4326,2,"PARAMSEQ",6,13)=""
^XWB(8994,4326,2,"PARAMSEQ",7,14)=""
^XWB(8994,4326,3,0)="^^44^44^3200916^"
^XWB(8994,4326,3,1,0)="Returns an array List[n]."
^XWB(8994,4326,3,2,0)=" "
^XWB(8994,4326,3,3,0)="The first line of the returned array will be in the following format:"
^XWB(8994,4326,3,4,0)="List [0] = Purge Date ^ Create Date ^ descriptive information"
^XWB(8994,4326,3,5,0)="  Example:  3150123^3150123^DSS APAT Suspense Grid temp"""
^XWB(8994,4326,3,6,0)=" "
^XWB(8994,4326,3,7,0)="The format of the returned array will be as follows:"
^XWB(8994,4326,3,8,0)="  List[n] = p1^p2^p3^p4^p5^p6^p7^p8^p8^p10^p11^p12^p13"
^XWB(8994,4326,3,9,0)="            ^p14^p15^p16^p17^p18^p19"
^XWB(8994,4326,3,10,0)=" "
^XWB(8994,4326,3,11,0)="    p1  = Suspense Date"
^XWB(8994,4326,3,12,0)="    p2  = Patient Name "
^XWB(8994,4326,3,13,0)="    p3  = Patient SSN"
^XWB(8994,4326,3,14,0)="    p4  = Type of Request"
^XWB(8994,4326,3,15,0)="    p5  = Description of Item/Service"
^XWB(8994,4326,3,16,0)="    p6  = Initial Action Date"
^XWB(8994,4326,3,17,0)="    p7  = # Days from Create"
^XWB(8994,4326,3,18,0)="    p8  = Status"
^XWB(8994,4326,3,19,0)="    p9  = File #668 IEN"
^XWB(8994,4326,3,20,0)="    p10 = Station"
^XWB(8994,4326,3,21,0)="    p11 = Patient IEN"
^XWB(8994,4326,3,22,0)="    p12 = Work Order IEN (#664.1)"
^XWB(8994,4326,3,23,0)="    p13 = Work Order #"
^XWB(8994,4326,3,24,0)="    p14 = Assigned Tech DUZ"
^XWB(8994,4326,3,25,0)="    p15 = Consult file (#123) IEN"
^XWB(8994,4326,3,26,0)="    p16 = Prosthetic Patient (1=Yes, 0=No)"
^XWB(8994,4326,3,27,0)="    p17 = Consult file (#123) Urgency (#5)"
^XWB(8994,4326,3,28,0)="    p18 = Patient Date of Death"
^XWB(8994,4326,3,29,0)="    p19 = Patient Date of Birth"
^XWB(8994,4326,3,30,0)=" "
^XWB(8994,4326,3,31,0)="The Last Record Processed will appear as:  "
^XWB(8994,4326,3,32,0)="        List[9999999999999998] = ^-pc 1 Text ""$$LAST RCD$$"""
^XWB(8994,4326,3,33,0)="                                 ^-pc 2 IEN of last record processed"
^XWB(8994,4326,3,34,0)="                                 ^-pc 3 yyymmdd.hhmmss of last "
^XWB(8994,4326,3,35,0)="                                          record processed"
^XWB(8994,4326,3,36,0)=" "
^XWB(8994,4326,3,37,0)="The End of the dataset will appear as:"
^XWB(8994,4326,3,38,0)="        List [999999999999999] = Text ""$$END$$"""
^XWB(8994,4326,3,39,0)=" "
^XWB(8994,4326,3,40,0)="If an error occurs, the return will be:"
^XWB(8994,4326,3,41,0)=" List[""E""] = Date^Date.Time^^Error in Suspense Grid:-1^xxxxxxxx"
^XWB(8994,4326,3,42,0)="   where xxxxxxxx=text of error message"
^XWB(8994,4326,3,43,0)="Example: "
^XWB(8994,4326,3,44,0)=" 3150124^3150122.235334^Error in Suspense Grid:-1^SITE not provided"
^XWB(8994,4327,0)="DSSO SEND MAIL MSG^SEND^DSSOXM^1^^^^1"
^XWB(8994,4327,1,0)="^8994.01^1^1^3180223^^"
^XWB(8994,4327,1,1,0)="This RPC will send a Mailman message."
^XWB(8994,4327,2,0)="^8994.02A^1^1"
^XWB(8994,4327,2,1,0)="DSSOARR^2^250^1^1"
^XWB(8994,4327,2,1,1,0)="^^47^47^3180223^"
^XWB(8994,4327,2,1,1,1,0)="This array contains all the data needed to invoke Mailman's send a "
^XWB(8994,4327,2,1,1,2,0)="message API.  DSSOARR format:  DSSOARR(sub) = p1 ^ p2 where"
^XWB(8994,4327,2,1,1,3,0)="    sub = any subscript value [0,1,2,3,...]"
^XWB(8994,4327,2,1,1,4,0)="    p1  = parameter name indicating the mail api entity"
^XWB(8994,4327,2,1,1,5,0)="    p2  = the value of the parameter p1"
^XWB(8994,4327,2,1,1,6,0)=" "
^XWB(8994,4327,2,1,1,7,0)="            Req/"
^XWB(8994,4327,2,1,1,8,0)="     p1      Opt   p2 (and description)"
^XWB(8994,4327,2,1,1,9,0)="  ---------  ----  -------------------------------------------------------"
^XWB(8994,4327,2,1,1,10,0)="   FLAGS     opt   string of characters representing special instructions"
^XWB(8994,4327,2,1,1,11,0)="                    P := priority   I := informational only    X := closed"
^XWB(8994,4327,2,1,1,12,0)="                    C := confidential   R := confirm receipt"
^XWB(8994,4327,2,1,1,13,0)="   FROM      opt   default to DUZ - sender of message"
^XWB(8994,4327,2,1,1,14,0)=" "
^XWB(8994,4327,2,1,1,15,0)="  SELF BSKT  opt   if FROM=DUZ then this canbe the name of DUZ's mail"
^XWB(8994,4327,2,1,1,16,0)="                   basket to deliver the message [basket must already"
^XWB(8994,4327,2,1,1,17,0)="                   exist]"
^XWB(8994,4327,2,1,1,18,0)=" "
^XWB(8994,4327,2,1,1,19,0)="   VAPOR     opt   Fileman date.time for which this message should be"
^XWB(8994,4327,2,1,1,20,0)="                   deleted from recipient's mail baskets"
^XWB(8994,4327,2,1,1,21,0)=" "
^XWB(8994,4327,2,1,1,22,0)="    SUBJ     req   subject of the message [3-65 characters]"
^XWB(8994,4327,2,1,1,23,0)=" "
^XWB(8994,4327,2,1,1,24,0)="   NOTME     opt   if this equals 1, then DO NOT include user DUZ as a"
^XWB(8994,4327,2,1,1,25,0)="                   recipient. Otherwise DUZ will always be a recipient "
^XWB(8994,4327,2,1,1,26,0)="                   even if they are not included in the recipient list"
^XWB(8994,4327,2,1,1,27,0)=" "
^XWB(8994,4327,2,1,1,28,0)="     REC     opt   this is only optional if the mail message will include"
^XWB(8994,4327,2,1,1,29,0)="                   DUZ as a recipient.  These are the recipients of the"
^XWB(8994,4327,2,1,1,30,0)="                   message.   Acceptable values are:"
^XWB(8994,4327,2,1,1,31,0)="                       DUZ number"
^XWB(8994,4327,2,1,1,32,0)="                       G.mail group name"
^XWB(8994,4327,2,1,1,33,0)="                       D.VistA device name"
^XWB(8994,4327,2,1,1,34,0)="                       S.server name"
^XWB(8994,4327,2,1,1,35,0)="                   For DUZ and mail group recipients there are additional"
^XWB(8994,4327,2,1,1,36,0)="                   parameters you can use as prefixes to the recipient:"
^XWB(8994,4327,2,1,1,37,0)="                       I: - indicate this recipient is informational only"
^XWB(8994,4327,2,1,1,38,0)="                       C: - indicate that this recipient is carbon copy"
^XWB(8994,4327,2,1,1,39,0)="                               (cc)"
^XWB(8994,4327,2,1,1,40,0)="                       L@Fileman_date.time: - deliver this message to this"
^XWB(8994,4327,2,1,1,41,0)="                         recipient at the specified date.time"
^XWB(8994,4327,2,1,1,42,0)="                   Examples: for user 1301 -   I:1301"
^XWB(8994,4327,2,1,1,43,0)="                             C:G.IRM STAFF"
^XWB(8994,4327,2,1,1,44,0)="                             IL@3021224.23:G.MCCR"
^XWB(8994,4327,2,1,1,45,0)="      TEXT    req  text of message.  Each line of text will be a "
^XWB(8994,4327,2,1,1,46,0)="                   separate DSSOARR(sub) entry."
^XWB(8994,4327,2,1,1,47,0)="                   No line should exceed 80 characters."
^XWB(8994,4327,2,1,1,48,0)="                  ARR(sub) entry.  No line should exceed 80 characters."
^XWB(8994,4327,2,"B","ARR",1)=""
^XWB(8994,4327,2,"B","DSSOARR",1)=""
^XWB(8994,4327,2,"PARAMSEQ",1,1)=""
^XWB(8994,4327,3,0)="^8994.03^2^2^3180223^^"
^XWB(8994,4327,3,1,0)="If the message is successfully created, return the mail message number"
^XWB(8994,4327,3,2,0)=" Else return -1^error message"
^XWB(8994,4328,0)="DSSO SEND ALERT^ALERT^DSSOXM^1^^^^1"
^XWB(8994,4328,1,0)="^^1^1^3180223^"
^XWB(8994,4328,1,1,0)="RPC to send an alert"
^XWB(8994,4328,2,0)="^8994.02A^2^2"
^XWB(8994,4328,2,1,0)="DSSODATA^2^^1^1"
^XWB(8994,4328,2,1,1,0)="^^13^13^3180223^"
^XWB(8994,4328,2,1,1,1,0)="DSSODATA() is the input data to be passed to the Kernel's alert "
^XWB(8994,4328,2,1,1,2,0)="processor."
^XWB(8994,4328,2,1,1,3,0)=" Prior to 10/1/2003 the subscripts of DATA() were numeric."
^XWB(8994,4328,2,1,1,4,0)=" Since 10/1/2003 the subscripts should be strings.  No one should be using"
^XWB(8994,4328,2,1,1,5,0)=" the numeric subscripts after 10/1/2003."
^XWB(8994,4328,2,1,1,6,0)=" "
^XWB(8994,4328,2,1,1,7,0)=" For detailed description of the input array, see the routine DSICXQA."
^XWB(8994,4328,2,1,1,8,0)=" "
^XWB(8994,4328,2,1,1,9,0)=" End description as of 10/1/2003"
^XWB(8994,4328,2,1,1,10,0)="                   alert should not be deleted for user"
^XWB(8994,4328,2,1,1,11,0)="         (4) = XQA(recipient)="""" - at least one recipient required"
^XWB(8994,4328,2,1,1,12,0)="         (5) = XQA(recipient)="""" - optional - additional recipient"
^XWB(8994,4328,2,1,1,13,0)="         (6,...) = XQA(additional recipients)"
^XWB(8994,4328,2,2,0)="DSSOFUN^1^1^0^2"
^XWB(8994,4328,2,2,1,0)="^^1^1^3180223^"
^XWB(8994,4328,2,2,1,1,0)="If $G(DSSOFUN) then extrinsic function, else RPC."
^XWB(8994,4328,2,"B","DATA",1)=""
^XWB(8994,4328,2,"B","DSSODATA",1)=""
^XWB(8994,4328,2,"B","DSSOFUN",2)=""
^XWB(8994,4328,2,"PARAMSEQ",1,1)=""
^XWB(8994,4328,2,"PARAMSEQ",2,2)=""
^XWB(8994,4328,3,0)="^^1^1^3180223^"
^XWB(8994,4328,3,1,0)="Returns 1 if an alert is sent.  Else returns -1^message"
^XWB(8994,4329,0)="DSSO OWL FILL WORK ORDER LIST^EN^DSSOOWW^4^A^^^1"
^XWB(8994,4329,1,0)="^8994.01^2^2^3150219^^^^"
^XWB(8994,4329,1,1,0)="This RPC returns a list of OWL work orders for all statuses by date,"
^XWB(8994,4329,1,2,0)="returning the most current ones first."
^XWB(8994,4329,2,0)="^8994.02A^4^3"
^XWB(8994,4329,2,2,0)="DSSOIEN^1^15^0^3"
^XWB(8994,4329,2,2,1,0)="^^2^2^3150205^"
^XWB(8994,4329,2,2,1,1,0)="664.1 IEN of last work order processed on a previous run from the $$LAST "
^XWB(8994,4329,2,2,1,2,0)="RCD$$ entry of the returned dataset"
^XWB(8994,4329,2,3,0)="DSSOSDT^1^7^1^1"
^XWB(8994,4329,2,3,1,0)="^^2^2^3150205^"
^XWB(8994,4329,2,3,1,1,0)="Date (.01 field) from the Prosthetic 2529-3 (664.1) file at which the work"
^XWB(8994,4329,2,3,1,2,0)="order list begins; date must be in Fileman format"
^XWB(8994,4329,2,4,0)="DSSOLDT^1^7^0^2"
^XWB(8994,4329,2,4,1,0)="^8994.021^2^2^3150219^^^^"
^XWB(8994,4329,2,4,1,1,0)="Date (.01 field) of last Prosthetic 2529-3 record (#664.1) processed from "
^XWB(8994,4329,2,4,1,2,0)="$$LAST RCD$$ entry in returned dataset; date must be in Fileman format"
^XWB(8994,4329,2,"B","DSSOIEN",2)=""
^XWB(8994,4329,2,"B","DSSOLDT",4)=""
^XWB(8994,4329,2,"B","DSSOSDT",3)=""
^XWB(8994,4329,2,"PARAMSEQ",1,3)=""
^XWB(8994,4329,2,"PARAMSEQ",2,4)=""
^XWB(8994,4329,2,"PARAMSEQ",3,2)=""
^XWB(8994,4329,3,0)="^^41^41^3150219^"
^XWB(8994,4329,3,1,0)="Returns a global array List[n]."
^XWB(8994,4329,3,2,0)=" "
^XWB(8994,4329,3,3,0)="The first line of the returned array will be in the following format:"
^XWB(8994,4329,3,4,0)=" List [0] = Purge Date ^ Create Date ^ descriptive information"
^XWB(8994,4329,3,5,0)="   Example:  3150123^3150123^DSS APAT Work Order List temp"""
^XWB(8994,4329,3,6,0)=" "
^XWB(8994,4329,3,7,0)=" The format of the returned array will be as follows:"
^XWB(8994,4329,3,8,0)="   List[n] = p1^p2^p3^p4^p5^p6^p7^p8^p9^p10^p11^p12^p13"
^XWB(8994,4329,3,9,0)="             ^p14^p15^p16^p17^p18^p19^p20^p21^p22^p23^p24"
^XWB(8994,4329,3,10,0)=" "
^XWB(8994,4329,3,11,0)="     p1  = Suspense Date            p13 = Requesting Official"
^XWB(8994,4329,3,12,0)="     p2  = Patient DFN              p14 = Technician"
^XWB(8994,4329,3,13,0)="     p3  = Patient Name             p15 = Source of Procurement"
^XWB(8994,4329,3,14,0)="     p4  = SSN (no dashes)          p16 = NPPD Station #"
^XWB(8994,4329,3,15,0)="     p5  = SSN (dashes)             p17 = NPPD Station Name"
^XWB(8994,4329,3,16,0)="     p6  = Type of Request          p18 = Requesting Station #"
^XWB(8994,4329,3,17,0)="     p7  = Description              p19 = Requesting Station Name"
^XWB(8994,4329,3,18,0)="     p8  = Status                   p20 = Receiving Station #"
^XWB(8994,4329,3,19,0)="     p9  = Suspense Record IEN      p21 = Receiving Station Name"
^XWB(8994,4329,3,20,0)="     p10 = Prosthetics 2529-3 IEN   p22 = Prosthetic Site Parameter IEN"
^XWB(8994,4329,3,21,0)="     p11 = HCPCS                    p23 = Date Created"
^XWB(8994,4329,3,22,0)="     p12 = Work Order #             p24 = Date Required"
^XWB(8994,4329,3,23,0)="                                    p25 = Assigned By"
^XWB(8994,4329,3,24,0)="                                    p26 = Cancelled By"
^XWB(8994,4329,3,25,0)="                                    p27 = Completed By"
^XWB(8994,4329,3,26,0)=" "
^XWB(8994,4329,3,27,0)="The Last Record Processed will appear as:"
^XWB(8994,4329,3,28,0)="         List[n] = ^-pc 1 Text ""$$LAST RCD$$"""
^XWB(8994,4329,3,29,0)="                   ^-pc 2 Date Last Processed"
^XWB(8994,4329,3,30,0)="                   ^-pc 3 IEN of last record processed"
^XWB(8994,4329,3,31,0)=" "
^XWB(8994,4329,3,32,0)="The end of the dataset will appear as:"
^XWB(8994,4329,3,33,0)="         List [n] = Text ""$$END$$"""
^XWB(8994,4329,3,34,0)=" "
^XWB(8994,4329,3,35,0)=" If an error occurs, the return will be:"
^XWB(8994,4329,3,36,0)="  List[""E""] = Date^Date.Time^^Error in Suspense Grid: -1^xxxxxxxx"
^XWB(8994,4329,3,37,0)="    where xxxxxxxx=text of error message"
^XWB(8994,4329,3,38,0)=" "
^XWB(8994,4329,3,39,0)=" Example:"
^XWB(8994,4329,3,40,0)="  3150124^3150122.235334^Error in Work Order List: -1^Start Date is "
^XWB(8994,4329,3,41,0)="    required."
^XWB(8994,4330,0)="DSSO FIND PROSTHETIC PATIENTS^PROSPAT^DSSOPP^4^^^^1"
^XWB(8994,4330,1,0)="^8994.01^8^8^3190725^^^"
^XWB(8994,4330,1,1,0)="This RPC returns patients from the Prosthetics Patient file (#665) based "
^XWB(8994,4330,1,2,0)="on a starting value.  The number of records to be returned may be "
^XWB(8994,4330,1,3,0)="specified.  If additional records exist, the last IEN processed will be "
^XWB(8994,4330,1,4,0)="returned in the last entry of the returned array (""$$LAST IEN"
^XWB(8994,4330,1,5,0)="PROCESSED$$"").  To retrieve additional patients meeting the starting"
^XWB(8994,4330,1,6,0)="value, include the Last IEN Processed when using the RPC.  When all"
^XWB(8994,4330,1,7,0)="patients meeting the input value have been returned, the last entry in the"
^XWB(8994,4330,1,8,0)="return will be "" $$END$$""."
^XWB(8994,4330,2,0)="^8994.02A^4^4"
^XWB(8994,4330,2,1,0)="DSSOPAT^1^30^1^1"
^XWB(8994,4330,2,1,1,0)="^^1^1^3150320^"
^XWB(8994,4330,2,1,1,1,0)="Partial value or exact name of patient"
