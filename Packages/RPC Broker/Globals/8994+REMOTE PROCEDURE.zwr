^XWB(8994,4698,0)="DVBA CAPRI PURGE MET^PURGEMET^DVBCPUSH^1^R^^^0^1"
^XWB(8994,4698,1,0)="^8994.01^2^2^3220510^^"
^XWB(8994,4698,1,1,0)="This RPC will allow the CAPRI GUI User with the correct security key to "
^XWB(8994,4698,1,2,0)="purge metrics data in File ^DVB(396.21)."
^XWB(8994,4698,2,0)="^8994.02A^2^2"
^XWB(8994,4698,2,1,0)="DUZ^1^250^1^1"
^XWB(8994,4698,2,1,1,0)="^8994.021^1^1^3220510^^"
^XWB(8994,4698,2,1,1,1,0)="DUZ of the user requesting the date to be purged."
^XWB(8994,4698,2,2,0)="DATE^1^250^1^2"
^XWB(8994,4698,2,2,1,0)="^8994.021^3^3^3220510^^"
^XWB(8994,4698,2,2,1,1,0)="Date for the data purge, all data from this date and before will be "
^XWB(8994,4698,2,2,1,2,0)="purged. For example using May, a user enters May 9 as the purge date, "
^XWB(8994,4698,2,2,1,3,0)="data from May 1-May 9 will be purged."
^XWB(8994,4698,2,"B","DATE",2)=""
^XWB(8994,4698,2,"B","DUZ",1)=""
^XWB(8994,4698,2,"PARAMSEQ",1,1)=""
^XWB(8994,4698,2,"PARAMSEQ",2,2)=""
^XWB(8994,4698,3,0)="^8994.03^2^2^3220510^^"
^XWB(8994,4698,3,1,0)="A response of 0 or 1 will be returned, 0 for unsuccessful and 1 for "
^XWB(8994,4698,3,2,0)="successful"
^XWB(8994,4699,0)="DVBA CAPRI GET MET RPT^RPCENTRY^DVBCTOG^2^R^^^^1"
^XWB(8994,4699,1,0)="^^2^2^3220519^"
^XWB(8994,4699,1,1,0)="This RPC is used by the CAPRI GUI to obtain a Metrics Report of Clinical "
^XWB(8994,4699,1,2,0)="Document Transmissions.  Data stored in file ^DVB(396.21)"
^XWB(8994,4699,2,0)="^8994.02A^2^2"
^XWB(8994,4699,2,1,0)="DVBBDT^1^250^1^1"
^XWB(8994,4699,2,1,1,0)="^^1^1^3220519^"
^XWB(8994,4699,2,1,1,1,0)="Beginning date for report"
^XWB(8994,4699,2,2,0)="DVBEDT^1^250^1^2"
^XWB(8994,4699,2,2,1,0)="^^1^1^3220519^"
^XWB(8994,4699,2,2,1,1,0)="End date for report"
^XWB(8994,4699,2,"B","DVBBDT",1)=""
^XWB(8994,4699,2,"B","DVBEDT",2)=""
^XWB(8994,4699,2,"PARAMSEQ",1,1)=""
^XWB(8994,4699,2,"PARAMSEQ",2,2)=""
^XWB(8994,4699,3,0)="^^1^1^3220519^"
^XWB(8994,4699,3,1,0)="Data returned in Array"
^XWB(8994,4700,0)="DSIYV04 UEICKSUM UEI CHECK^UEICKSUM^DSIYV04^1"
^XWB(8994,4700,1,0)="^8994.01^10^10^3220302^^"
^XWB(8994,4700,1,1,0)="RPC: DSIYV04 UEICHK UEI CHECK - Check or create the UEI check digit"
^XWB(8994,4700,1,2,0)=" "
^XWB(8994,4700,1,3,0)=" Input: DSIYX - UEI as passed"
^XWB(8994,4700,1,4,0)="        DSIYC - (optional) "
^XWB(8994,4700,1,5,0)="             applies only if 11 char passed. 1 or 2 calculate check digit,"
^XWB(8994,4700,1,6,0)="                2 then return only the check digit only, "
^XWB(8994,4700,1,7,0)="                1 updated UEI with check digit and return 12 char UEI."
^XWB(8994,4700,1,8,0)=" "
^XWB(8994,4700,1,9,0)=" Return:  12 char UEI or -1^message"
^XWB(8994,4700,1,10,0)="          check digit if DSIYC=2"
^XWB(8994,4700,2,0)="^8994.02A^2^2"
^XWB(8994,4700,2,1,0)="DSIYX^1^12^^1"
^XWB(8994,4700,2,1,1,0)="^^2^2^3220302^"
^XWB(8994,4700,2,1,1,1,0)="DSIYX - 12 character UEI Number or 11 character when the 2nd parameter "
^XWB(8994,4700,2,1,1,2,0)="        DSIYC is passed to calculate the check digit."
^XWB(8994,4700,2,2,0)="DSIYC^1^1^^2"
^XWB(8994,4700,2,2,1,0)="^8994.021^2^2^3220302^^^"
^XWB(8994,4700,2,2,1,1,0)="DSIYC - optional.  Pass 1 to calculate the check digit and pass back the "
^XWB(8994,4700,2,2,1,2,0)="        12 character UEI.  Pass 2 to return only the check digit."
^XWB(8994,4700,2,"B","DSIYC",2)=""
^XWB(8994,4700,2,"B","DSIYX",1)=""
^XWB(8994,4700,2,"PARAMSEQ",1,1)=""
^XWB(8994,4700,2,"PARAMSEQ",2,2)=""
^XWB(8994,4701,0)="IBTAS 837 CLAIM NUMBER^GET^IBCE837N^2^R^0^^^1^^1"
^XWB(8994,4701,2,0)="^8994.02A^1^1"
^XWB(8994,4701,2,1,0)="ARG^2^^1"
^XWB(8994,4701,2,"B","ARG",1)=""
^XWB(8994,4702,0)="SDES CREATE WALKIN APPT^CREATEWALKIN^SDESCRTWALKIN^2^R^^^^^^1"
^XWB(8994,4702,1,0)="^^4^4^3250206^"
^XWB(8994,4702,1,1,0)="Creates appointment request, appointment, and does check-in for walk-in "
^XWB(8994,4702,1,2,0)="appointments. "
^XWB(8994,4702,1,3,0)=" "
^XWB(8994,4702,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,4702,2,0)="^8994.02A^2^1"
^XWB(8994,4702,2,2,0)="WALKINARRAY^2^32000^1^1"
^XWB(8994,4702,2,2,1,0)="^8994.021^25^25^3250206^^^^"
^XWB(8994,4702,2,2,1,1,0)="Information array to create both appointment request and appointment for "
^XWB(8994,4702,2,2,1,2,0)="walkin."
^XWB(8994,4702,2,2,1,3,0)=";(APPTARRAY(""APPT START"")=  APPT. START TIME - (REQUIRED) ISO FORMAT"
^XWB(8994,4702,2,2,1,4,0)=";(APPTARRAY(""APPT END"")=  APPT. END TIME - (REQUIRED) ISO FORMAT"
^XWB(8994,4702,2,2,1,5,0)=";(APPTARRAY(""DFN"")=  PATIENT ID - (REQUIRED)"
^XWB(8994,4702,2,2,1,6,0)=";(APPTARRAY(""PATIENT INDICATED DATE"")=  DESIRED DATE/TIME - (REQUIRED)"
^XWB(8994,4702,2,2,1,7,0)=";(APPTARRAY(""CLINIC IEN"")=  CLINIC IEN - (REQUIRED)"
^XWB(8994,4702,2,2,1,8,0)=";(APPTARRAY(""SDNOTE"")=  NOTE"
^XWB(8994,4702,2,2,1,9,0)=";(APPTARRAY(""APPOINTMENT TYPE IEN"")=  APPOINTMENT TYPE IEN"
^XWB(8994,4702,2,2,1,10,0)=";(APPTARRAY(""APPOINTMENT TYPE NAME"")=  APPT. TYPE NAME - (REQUIRED) Takes precedence over APPT. TYPE IEN"
^XWB(8994,4702,2,2,1,11,0)=";(APPTARRAY(""PATIENT STATUS"")=  PATIENT STATUS - (N/E) N:NEW E:ESTABLISHED"
^XWB(8994,4702,2,2,1,12,0)=";(APPTARRAY(""APPT LENGTH"")= APPT. LENGTH - (REQUIRED)"
^XWB(8994,4702,2,2,1,13,0)=";(APPTARRAY(""SDSERVCONN"")=  SERVICE CONNECTED - YES/NO"
^XWB(8994,4702,2,2,1,14,0)=";(APPTARRAY(""SDSERVCONNPERC"")=  SERVICE CONNECTED PERCENTAGE - 0-100"
^XWB(8994,4702,2,2,1,15,0)=";(APPTARRAY(""SDEAS"")=  EAS TRACKING NUMBER"
^XWB(8994,4702,2,2,1,16,0)=";(APPTARRAY(""SDPATELIG"")=  PATIENT ELIGIBILITY"
^XWB(8994,4702,2,2,1,17,0)=";(APPTARRAY(""OVERBOOK"")=  OVERBOOK"
^XWB(8994,4702,2,2,1,18,0)=";(APPTARRAY(""SDCOLLATERAL"")=  COLLATERAL"
^XWB(8994,4702,2,2,1,19,0)=";(APPTARRAY(""INSTITUTION NAME"")=  INSTITUTION NAME"
^XWB(8994,4702,2,2,1,20,0)=";(APPTARRAY(""VAOS GUID"")=  VAOS GUID"
^XWB(8994,4702,2,2,1,21,0)=";(APPTARRAY(""MODALITY"")=  MODALITY"
^XWB(8994,4702,2,2,1,22,0)=";(APPTARRAY(""STOP CODE"")=  STOP CODE"
^XWB(8994,4702,2,2,1,23,0)=";(APPTARRAY(""SECONDARY STOP CODE"")=  SECONDARY STOP CODE"
^XWB(8994,4702,2,2,1,24,0)=";(APPTARRAY(""PRIORITY GROUP"")=  PRIORITY GROUP"
^XWB(8994,4702,2,2,1,25,0)=";(APPTARRAY(""STATION NUMBER"")=  STATION NUMBER"
^XWB(8994,4702,2,"B","WALKINARRAY",2)=""
^XWB(8994,4702,2,"PARAMSEQ",1,2)=""
^XWB(8994,4702,3,0)="^8994.03^8^8^3250206^^^^"
^XWB(8994,4702,3,1,0)="{"
^XWB(8994,4702,3,2,0)=" ""Appointment"": {"
^XWB(8994,4702,3,3,0)="  ""IEN"": 292182"
^XWB(8994,4702,3,4,0)=" },"
^XWB(8994,4702,3,5,0)="  ""Request"": {"
^XWB(8994,4702,3,6,0)="   ""IEN"": 256229"
^XWB(8994,4702,3,7,0)="  }"
^XWB(8994,4702,3,8,0)="}"
^XWB(8994,4703,0)="SDES CREATE VET REQ SCHED APPT^CREATEREQANDAPPT^SDESREQAPPCREATE^2^R^0^^0^^^1"
^XWB(8994,4703,1,0)="^^6^6^3250206^"
^XWB(8994,4703,1,1,0)="This RPC performs the following events:"
^XWB(8994,4703,1,2,0)="1. Creates a NEW APPOINTMENT REQUEST in File #409.85,"
^XWB(8994,4703,1,3,0)="2. Creates an appointment entry in File 409.84, File 44, and File 2,"
^XWB(8994,4703,1,4,0)="3. Dispositions/Closes the appointment request in File #409.85"
^XWB(8994,4703,1,5,0)=" "
^XWB(8994,4703,1,6,0)="Can only be invoked by Acheron"
^XWB(8994,4703,2,0)="^8994.02A^1^1"
^XWB(8994,4703,2,1,0)="REQUESTARRAY^2^^1^1"
^XWB(8994,4703,2,1,1,0)="^8994.021^87^87^3250206^^^"
^XWB(8994,4703,2,1,1,1,0)="Below is the structure of the REQUEST ARRAY that contains all necessary "
^XWB(8994,4703,2,1,1,2,0)="data for the creation of the appointment request, scheduling the "
^XWB(8994,4703,2,1,1,3,0)="appointment, and then dispositioning the appointment."
^XWB(8994,4703,2,1,1,4,0)=" "
^XWB(8994,4703,2,1,1,5,0)="REQUEST(""APPOINTMENT END TIME"")          = (Required) APPT END TIME - ISO "
^XWB(8994,4703,2,1,1,6,0)="                                            FORMAT"
^XWB(8994,4703,2,1,1,7,0)="REQUEST(""APPOINTMENT LENGTH"")            = (Required) APPT LENGTH IN "
^XWB(8994,4703,2,1,1,8,0)="                                            MINUTES (5-120)"
^XWB(8994,4703,2,1,1,9,0)="REQUEST(""APPOINTMENT START TIME"")        = (Required) APPT START TIME - "
^XWB(8994,4703,2,1,1,10,0)="                                            ISO FORMAT"
^XWB(8994,4703,2,1,1,11,0)="REQUEST(""CLINIC IEN"")                    = (Required) CLINIC IEN"
^XWB(8994,4703,2,1,1,12,0)="REQUEST(""CREATE DATE"")                   = (Required) DATE/TIME ENTERED"
^XWB(8994,4703,2,1,1,13,0)="                                           (#409.85,9.5) in ISO8601"
^XWB(8994,4703,2,1,1,14,0)="                                           date/time format to include"
^XWB(8994,4703,2,1,1,15,0)="                                           offset (e.g."
^XWB(8994,4703,2,1,1,16,0)="                                           CCYY-MM-DDTHH:MM-NNNN) "
^XWB(8994,4703,2,1,1,17,0)="REQUEST(""PATIENT INDICATED DATE"")        = (Required) CID/PID DATE - ISO"
^XWB(8994,4703,2,1,1,18,0)="                                            FORMAT"
^XWB(8994,4703,2,1,1,19,0)="REQUEST(""DFN"")                           = (Required) PATIENT IEN"
^XWB(8994,4703,2,1,1,20,0)="REQUEST(""APPOINTMENT REASON"")            = (Optional) FREE TEXT (1-150)"
^XWB(8994,4703,2,1,1,21,0)="REQUEST(""COLLATERAL VISIT"")              = (Optional) COLLATERAL - 1 FOR "
^XWB(8994,4703,2,1,1,22,0)="                                            YES"
^XWB(8994,4703,2,1,1,23,0)="REQUEST(""APPOINTMENT TYPE IEN"")          = (Optional) POINTER TO "
^XWB(8994,4703,2,1,1,24,0)="                                            APPOINTMENT TYPE FILE #409.1"
^XWB(8994,4703,2,1,1,25,0)="REQUEST(""APPOINTMENT TYPE NAME"")         = (Optional) NAME OF ENTRY IN"
^XWB(8994,4703,2,1,1,26,0)="                                            APPOINTMENT TYPE FILE #409.1"
^XWB(8994,4703,2,1,1,27,0)="                                            Either APPOINTMENT TYPE IEN"
^XWB(8994,4703,2,1,1,28,0)="                                            or APPOINTMENT TYPE NAME"
^XWB(8994,4703,2,1,1,29,0)="                                            is required"
^XWB(8994,4703,2,1,1,30,0)="REQUEST(""EAS"")                           = (Optional) Enterprise APPT"
^XWB(8994,4703,2,1,1,31,0)="                                            Scheduling Tracking Number"
^XWB(8994,4703,2,1,1,32,0)="                                            associated to an appt."
^XWB(8994,4703,2,1,1,33,0)="REQUEST(""FOLLOWUP"")                      = (Optional) FOLLOWUP VISIT - 1 "
^XWB(8994,4703,2,1,1,34,0)="                                            FOR YES 0 FOR NO"
^XWB(8994,4703,2,1,1,35,0)="REQUEST(""INSTITUTION NAME"")              = (Optional) Institution name "
^XWB(8994,4703,2,1,1,36,0)="                                            from the INSTITUTION file"
^XWB(8994,4703,2,1,1,37,0)="REQUEST(""MODALITY"")                      = (Optional) Valid Values: "
^XWB(8994,4703,2,1,1,38,0)="                                            FACE2FACE, TELEPHONE, VIDEO "
^XWB(8994,4703,2,1,1,39,0)="REQUEST(""NOTE"")                          = (Optional) NOTE - FREE TEXT "
^XWB(8994,4703,2,1,1,40,0)="                                            1-150"
^XWB(8994,4703,2,1,1,41,0)="REQUEST(""OVERBOOK"")                      = (Optional) OVERBOOK (0 for no, "
^XWB(8994,4703,2,1,1,42,0)="                                            1 for yes)"
^XWB(8994,4703,2,1,1,43,0)="REQUEST(""PATIENT COMMENT"")               = (Optional) Patient-entered "
^XWB(8994,4703,2,1,1,44,0)="                                            comments when using VAOS or"
^XWB(8994,4703,2,1,1,45,0)="                                            other web-service (stored at"
^XWB(8994,4703,2,1,1,46,0)="                                            409.85,60 a word processing"
^XWB(8994,4703,2,1,1,47,0)="                                            field) "
^XWB(8994,4703,2,1,1,48,0)="REQUEST(""PATIENT ELIGIBILITY IEN"")       = (Optional) ELIGIBILITY IEN"
^XWB(8994,4703,2,1,1,49,0)="REQUEST(""PATIENT PREFERRED END DATE"",1)  = (Optional) PATIENT PREFERRED "
^XWB(8994,4703,2,1,1,50,0)="                                            END DATE 1 - ISO FORMAT"
^XWB(8994,4703,2,1,1,51,0)="REQUEST(""PATIENT PREFERRED END DATE"",2)  = (Optional) PATIENT PREFERRED "
^XWB(8994,4703,2,1,1,52,0)="                                            END DATE 2 - ISO FORMAT"
^XWB(8994,4703,2,1,1,53,0)="REQUEST(""PATIENT PREFERRED END DATE"",3)  = (Optional) PATIENT PREFERRED "
^XWB(8994,4703,2,1,1,54,0)="                                            END DATE 3 - ISO FORMAT"
^XWB(8994,4703,2,1,1,55,0)="REQUEST(""PATIENT PREFERRED START DATE"",1)= (Optional) PATIENT PREFERRED "
^XWB(8994,4703,2,1,1,56,0)="                                            START DATE 1 - ISO FORMAT"
^XWB(8994,4703,2,1,1,57,0)="REQUEST(""PATIENT PREFERRED START DATE"",2)= (Optional) PATIENT PREFERRED "
^XWB(8994,4703,2,1,1,58,0)="                                            START DATE 2 - ISO FORMAT"
^XWB(8994,4703,2,1,1,59,0)="REQUEST(""PATIENT PREFERRED START DATE"",3)= (Optional) PATIENT PREFERRED "
^XWB(8994,4703,2,1,1,60,0)="                                            START DATE 3 - ISO FORMAT"
^XWB(8994,4703,2,1,1,61,0)="REQUEST(""PATIENT STATUS"")                = (Optional) PATIENT STATUS - "
^XWB(8994,4703,2,1,1,62,0)="                                            ""NEW"" OR ""ESTABLISHED"
^XWB(8994,4703,2,1,1,63,0)="REQUEST(""PRIORITY"")                      = (Optional) PRIORITY - ""ASAP"" "
^XWB(8994,4703,2,1,1,64,0)="                                            or FUTURE"
^XWB(8994,4703,2,1,1,65,0)="REQUEST(""PRIORITY GROUP"")                = (Optional) ENROLLMENT PRIORITY "
^XWB(8994,4703,2,1,1,66,0)="                                            - GROUP 1 - GROUP 7"
^XWB(8994,4703,2,1,1,67,0)="REQUEST(""REQUEST COMMENT"")               = (Optional) REQUEST COMMENT"
^XWB(8994,4703,2,1,1,68,0)="REQUEST(""SECONDARY STOP CODE"")           = (Optional) Secondary Stop Code "
^XWB(8994,4703,2,1,1,69,0)="                                            Number pointer to CLINIC STOP"
^XWB(8994,4703,2,1,1,70,0)="                                            file #40.7 used to populate"
^XWB(8994,4703,2,1,1,71,0)="                                            the REQ SECONDARY STOP CODE"
^XWB(8994,4703,2,1,1,72,0)="                                            field in 409.85"
^XWB(8994,4703,2,1,1,73,0)="REQUEST(""SERVICE CONNECTED"")             = (Optional) Valid Values: YES, "
^XWB(8994,4703,2,1,1,74,0)="                                            NO"
^XWB(8994,4703,2,1,1,75,0)="REQUEST(""SERVICE CONNECTED PERCENTAGE"")  = (Optional) SC % = 0-100"
^XWB(8994,4703,2,1,1,76,0)="REQUEST(""STATION NUMBER"")                = (Optional) STATION NUMBER "
^XWB(8994,4703,2,1,1,77,0)="                                            (#99),INSTITUTION (#4)"
^XWB(8994,4703,2,1,1,78,0)="REQUEST(""STATION NAME"")                  = (Optional) STATION NAME"
^XWB(8994,4703,2,1,1,79,0)="                                            (#.01),INSTITUTION (#4)"
^XWB(8994,4703,2,1,1,80,0)="                                           Either STATION NUMBER or"
^XWB(8994,4703,2,1,1,81,0)="                                           STATION NAME is required"
^XWB(8994,4703,2,1,1,82,0)="REQUEST(""STOP CODE"")                     = (Optional) CLINIC STOP pointer"
^XWB(8994,4703,2,1,1,83,0)="                                            to CLINIC STOP file 40.7 used"
^XWB(8994,4703,2,1,1,84,0)="                                            to populate the REQ"
^XWB(8994,4703,2,1,1,85,0)="                                            SERVICE/SPECIALTY field"
^XWB(8994,4703,2,1,1,86,0)="                                            in 409.85"
^XWB(8994,4703,2,1,1,87,0)="REQUEST(""VAOS GUID"")                     = (Optional) VAOS GUID"
^XWB(8994,4703,2,"B","REQUESTARRAY",1)=""
