^XWB(8994,1189,2,1,0)="IBM^1^7^1^2"
^XWB(8994,1189,2,1,1,0)="^8994.021^2^2^3020429^^"
^XWB(8994,1189,2,1,1,1,0)="This is in fileman format the month/year for which the request is being "
