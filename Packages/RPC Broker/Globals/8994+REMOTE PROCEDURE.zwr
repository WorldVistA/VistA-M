^XWB(8994,4995,0)="SDES2 CANCEL APPOINTMENT^CANCELAPPT^SDES2CANCELAPPT^2^R^0^1^^^^1"
^XWB(8994,4995,1,0)="^^4^4^3250213^"
^XWB(8994,4995,1,1,0)=" This RPC will cancel an appointment from the SDEC APPOINTMENT (409.84)"
^XWB(8994,4995,1,2,0)=" file, the PATIENT (#2) file, and the HOSPITAL LOCATION (#44) file."
^XWB(8994,4995,1,3,0)=" "
^XWB(8994,4995,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,4995,2,0)="^8994.02A^2^2"
^XWB(8994,4995,2,1,0)="SDCONTEXT^2^^1^1"
^XWB(8994,4995,2,1,1,0)="^^14^14^3240112^"
^XWB(8994,4995,2,1,1,1,0)="   SDCONTEXT(""ACHERON AUDIT ID"") = 40 character unique ID number."
^XWB(8994,4995,2,1,1,2,0)="                                 Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,4995,2,1,1,3,0)=" "
^XWB(8994,4995,2,1,1,4,0)="   SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action on the "
^XWB(8994,4995,2,1,1,5,0)="                           calling application."
^XWB(8994,4995,2,1,1,6,0)="  "
^XWB(8994,4995,2,1,1,7,0)="   SDCONTEXT(""USER SECID"") = The Security ID of the user taking action on"
^XWB(8994,4995,2,1,1,8,0)="                             the calling application."
^XWB(8994,4995,2,1,1,9,0)="  "
^XWB(8994,4995,2,1,1,10,0)="   SDCONTEXT(""PATIENT DFN"") = The DFN of the Veteran/user taking action on"
^XWB(8994,4995,2,1,1,11,0)="                              the calling application."
^XWB(8994,4995,2,1,1,12,0)="  "
^XWB(8994,4995,2,1,1,13,0)="   SDCONTEXT(""PATIENT ICN"") = The ICN of the Veteran/user taking action "
^XWB(8994,4995,2,1,1,14,0)="                              on the calling application."
^XWB(8994,4995,2,2,0)="PARAMS^2^^1^2"
^XWB(8994,4995,2,2,1,0)="^8994.021^23^23^3250213^^"
^XWB(8994,4995,2,2,1,1,0)="REQUIRED PARAMETERS:"
^XWB(8994,4995,2,2,1,2,0)=" "
^XWB(8994,4995,2,2,1,3,0)="   PARAMS(""APPT IEN"") - IEN of SDEC APPOINTMENT (#409.84) file record"
^XWB(8994,4995,2,2,1,4,0)="                        to be cancelled (req)"
^XWB(8994,4995,2,2,1,5,0)=" "
^XWB(8994,4995,2,2,1,6,0)="   PARAMS(""CLINIC IEN"") - Pointer to the HOSPITAL LOCATION (#44) file"
^XWB(8994,4995,2,2,1,7,0)=" "
^XWB(8994,4995,2,2,1,8,0)="   PARAMS(""DFN"") - Pointer to the PATIENT (#2) file"
^XWB(8994,4995,2,2,1,9,0)=" "
^XWB(8994,4995,2,2,1,10,0)="   PARAMS(""CANCELLED BY"") - Appt Cancelled By: ""C"" - Cancelled By Clinic,"
^XWB(8994,4995,2,2,1,11,0)="                            ""PC"" - Cancelled By Patient"
^XWB(8994,4995,2,2,1,12,0)=" "
^XWB(8994,4995,2,2,1,13,0)="   PARAMS(""CANCEL REASON"") - Cancellation Reason Name in the CANCELLATION"
^XWB(8994,4995,2,2,1,14,0)="                             REASON (#409.2) file"
^XWB(8994,4995,2,2,1,15,0)=" "
^XWB(8994,4995,2,2,1,16,0)="OPTIONAL PARAMETERS:"
^XWB(8994,4995,2,2,1,17,0)=" "
^XWB(8994,4995,2,2,1,18,0)="   PARAMS(""NOTE"") - Comments related to the cancellation"
^XWB(8994,4995,2,2,1,19,0)=" "
^XWB(8994,4995,2,2,1,20,0)="   PARAMS(""CANCEL HASH"") - List of cancellation comment hash tags"
^XWB(8994,4995,2,2,1,21,0)=" "
^XWB(8994,4995,2,2,1,22,0)="   PARAMS(""NEW PID"") - New/edited PID passed in when cancelling an "
^XWB(8994,4995,2,2,1,23,0)="                       appointment by patient"
^XWB(8994,4995,2,"B","PARAMS",2)=""
^XWB(8994,4995,2,"B","SDCONTEXT",1)=""
^XWB(8994,4995,2,"PARAMSEQ",1,1)=""
^XWB(8994,4995,2,"PARAMSEQ",2,2)=""
^XWB(8994,4995,3,0)="^8994.03^20^20^3250213^^^^"
^XWB(8994,4995,3,1,0)="  Successful Cancellation:"
^XWB(8994,4995,3,2,0)="   "
^XWB(8994,4995,3,3,0)="  {"
^XWB(8994,4995,3,4,0)="     ""Appointment"":"
^XWB(8994,4995,3,5,0)="        {"
^XWB(8994,4995,3,6,0)="           ""Cancelled"":{Appointment IEN} "
^XWB(8994,4995,3,7,0)="        }"
^XWB(8994,4995,3,8,0)="  }"
^XWB(8994,4995,3,9,0)="   "
^XWB(8994,4995,3,10,0)="   "
^XWB(8994,4995,3,11,0)="  Unsuccessful Cancellation:"
