^XWB(8994,4189,3,55,0)="    @XURET@(#)=""200;53.9^REMARKS^^^"""
^XWB(8994,4189,3,56,0)="    @XURET@(#)=""200;53.91^NON-VA PRESCRIBER^^^"""
^XWB(8994,4189,3,57,0)="    @XURET@(#)=""200;53.92^TAX ID^^^"""
