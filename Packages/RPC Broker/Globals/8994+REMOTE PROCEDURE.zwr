^XWB(8994,3919,3,1,0)="RETURN PARAMETER"
^XWB(8994,3919,3,2,0)=" "
^XWB(8994,3919,3,3,0)="DSIYRET(1) will return information about the Turn-In request in the "
^XWB(8994,3919,3,4,0)="following pieces - the Levels will help the GUI determine which areas a "
^XWB(8994,3919,3,5,0)="user can edit.  "
^XWB(8994,3919,3,6,0)=" "
^XWB(8994,3919,3,7,0)="DSIYRET(1)="
^XWB(8994,3919,3,8,0)="  Piece 1:  Turn-In Request IEN"
^XWB(8994,3919,3,9,0)="  Piece 2:  Status Code"
^XWB(8994,3919,3,10,0)="  Piece 3:  Status Description"
^XWB(8994,3919,3,11,0)="  Piece 4:  Edit Level (see descriptions below)"
^XWB(8994,3919,3,12,0)="  Piece 5:  Edit Level description"
^XWB(8994,3919,3,13,0)="  Piece 6:  Is this TI Request editable by this user?  Y/N"
^XWB(8994,3919,3,14,0)="  Piece 7:  Can this user add new pieces of equipment?  Y/N"
^XWB(8994,3919,3,15,0)=" "
^XWB(8994,3919,3,16,0)="LEVELS"
^XWB(8994,3919,3,17,0)="  0:  Turn-In is complete or cancelled - no edit"
^XWB(8994,3919,3,18,0)="  1:  PPM Final Disposition Box - Waiting for PPM to sign off"
^XWB(8994,3919,3,19,0)=" "
^XWB(8994,3919,3,20,0)="  2:  Warehouse Box - Waiting for Warehouse user to accept & sign"
^XWB(8994,3919,3,21,0)="  3:  Warehouse Box - Waiting for Warehouse Assignee to be indicated"
^XWB(8994,3919,3,22,0)="  4:  PPM Approval Box - Waiting for Work Order Completion"
^XWB(8994,3919,3,23,0)="  5:  PPM Approval Box - Waiting for PPM to indicate ""Ready for Warehouse"""
^XWB(8994,3919,3,24,0)="      PPM can add additional equipment if needed at this time"
^XWB(8994,3919,3,25,0)="      (As long as Edit piece = ""Y"")"
^XWB(8994,3919,3,26,0)="  6:  CMR Approval Box - Waiting for CMR to approve"
^XWB(8994,3919,3,27,0)="  7:  Original Turn-In Request Box - User/PPM can edit"
^XWB(8994,3919,3,28,0)="      User or PPM can add additional equipment if needed at this time"
^XWB(8994,3919,3,29,0)="      (as long as EDIT piece = ""Y"")"
