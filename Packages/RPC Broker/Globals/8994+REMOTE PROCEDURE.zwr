^XWB(8994,1787,0)="ROR LIST ITEMS^LSTITEMS^RORRP012^2^A^^^1^1"
^XWB(8994,1787,1,0)="^8994.01^2^2^3050526^^^^"
^XWB(8994,1787,1,1,0)="The ROR LIST ITEMS remote procedure returns a list of registry-specific "
