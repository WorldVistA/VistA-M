^XWB(8994,2492,0)="YTQ GET SCRATCH^GETSCR^YTQPXRM8^4^^^^1"
^XWB(8994,2492,1,0)="^8994.01^1^1^3081029^^^^"
^XWB(8994,2492,1,1,0)="Returns data from the scratch file for thr MHA3 Clinical reminders DLL."
^XWB(8994,2492,2,0)="^8994.02A^3^3"
^XWB(8994,2492,2,1,0)="DFN^1^^1"
^XWB(8994,2492,2,1,1,0)="^8994.021^1^1^3081029^^"
^XWB(8994,2492,2,1,1,1,0)="Patient DFN"
^XWB(8994,2492,2,2,0)="CODE^1^^1"
^XWB(8994,2492,2,2,1,0)="^8994.021^1^1^3081029^^"
^XWB(8994,2492,2,2,1,1,0)="Instrument Name from file 601.71"
^XWB(8994,2492,2,3,0)="HANDLE^1^^1"
^XWB(8994,2492,2,3,1,0)="^8994.021^1^1^3081029^^^^"
^XWB(8994,2492,2,3,1,1,0)="Unigue identifier of the GUI session."
