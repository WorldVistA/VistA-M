^XWB(8994,4988,0)="SDES2 GET APPTS CLINIEN LIST^APPTBYCLNLIST^SDES2APPTCLNLST^2^R^^^^1^^1"
^XWB(8994,4988,1,0)="^^4^4^3250213^"
^XWB(8994,4988,1,1,0)="Accepts input array of clinic IENs and returns appointments for today."
^XWB(8994,4988,1,2,0)="Today is defined by the clinic's time zone."
^XWB(8994,4988,1,3,0)=" "
^XWB(8994,4988,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,4988,2,0)="^8994.02A^2^2"
^XWB(8994,4988,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,4988,2,1,1,0)="^^11^11^3231207^"
^XWB(8994,4988,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"")"
^XWB(8994,4988,2,1,1,2,0)=" - Up to 40 Character unique ID number. "
^XWB(8994,4988,2,1,1,3,0)=" - Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,4988,2,1,1,4,0)="SDCONTEXT(""USER DUZ"")"
^XWB(8994,4988,2,1,1,5,0)=" - The DUZ of the user taking action in the calling application."
^XWB(8994,4988,2,1,1,6,0)="SDCONTEXT(""USER SECID"")"
^XWB(8994,4988,2,1,1,7,0)=" - The SECID of the user taking action in the calling application."
^XWB(8994,4988,2,1,1,8,0)="SDCONTEXT(""PATIENT DFN"")"
^XWB(8994,4988,2,1,1,9,0)=" - The DFN/IEN of the target patient from the calling application."
^XWB(8994,4988,2,1,1,10,0)="SDCONTEXT(""PATIENT ICN"")"
^XWB(8994,4988,2,1,1,11,0)=" - The ICN of the target patient from the calling application."
^XWB(8994,4988,2,2,0)="SDPARAM^2^32000^1^2"
^XWB(8994,4988,2,2,1,0)="^8994.021^8^8^3250213^^^^"
^XWB(8994,4988,2,2,1,1,0)="Note: one SDPARAM(""CLINIC IEN"",1) is required additional clinics can be"
^XWB(8994,4988,2,2,1,2,0)="specified but are optional."
^XWB(8994,4988,2,2,1,3,0)=" "
^XWB(8994,4988,2,2,1,4,0)="SDPARAM(""CLINIC IEN"",1)=IEN1   The clinic IEN from HOSPITAL LOCATION "
^XWB(8994,4988,2,2,1,5,0)="(#44) "
^XWB(8994,4988,2,2,1,6,0)="                               to list appointments (required)"
^XWB(8994,4988,2,2,1,7,0)="SDPARAM(""CLINIC IEN"",2)=IEN2   (optional)"
^XWB(8994,4988,2,2,1,8,0)="SDPARAM(""CLINIC IEN"",3)=IEN3   (optional)"
