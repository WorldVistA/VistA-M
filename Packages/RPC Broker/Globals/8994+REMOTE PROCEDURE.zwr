^XWB(8994,3465,1,1,0)="This RPC accepts writeback data from JDS and returns a JSON formatted acknowledgement message. "
^XWB(8994,3465,2,0)="^8994.02A^3^3"
^XWB(8994,3465,2,1,0)="IEN^1^^1^1"
^XWB(8994,3465,2,1,1,0)="^^2^2^3151208^"
^XWB(8994,3465,2,1,1,1,0)="This is the INTERNAL ENTRY NUMBER in the target file for write backs.  "
^XWB(8994,3465,2,1,1,2,0)="The file is determined by the value passed in DATA(""domain"")."
^XWB(8994,3465,2,2,0)="DFN^1^^1^2"
^XWB(8994,3465,2,2,1,0)="^^1^1^3151208^"
^XWB(8994,3465,2,2,1,1,0)="The IEN of the patient in the PATIENT file (#2)."
^XWB(8994,3465,2,3,0)="DATA^2^^1^3"
^XWB(8994,3465,2,3,1,0)="^^4^4^3151208^"
^XWB(8994,3465,2,3,1,1,0)="An array passed-by-reference."
^XWB(8994,3465,2,3,1,2,0)=" "
^XWB(8994,3465,2,3,1,3,0)="DATA(""domain"") determines the data domain for which the desired write "
^XWB(8994,3465,2,3,1,4,0)="back will occur.  An invalid domain will result in data being returned."
^XWB(8994,3465,2,"B","DATA",3)=""
^XWB(8994,3465,2,"B","DFN",2)=""
^XWB(8994,3465,2,"B","IEN",1)=""
^XWB(8994,3465,2,"PARAMSEQ",1,1)=""
^XWB(8994,3465,2,"PARAMSEQ",2,2)=""
^XWB(8994,3465,2,"PARAMSEQ",3,3)=""
^XWB(8994,3466,0)="HMP PATIENT SCHED SYNC^APPT^HMPACT^4^P^^^1^1"
^XWB(8994,3466,1,0)="^^5^5^3150416^"
^XWB(8994,3466,1,1,0)="This RPC looks up patient appointments by date and location and returns "
^XWB(8994,3466,1,2,0)="the following in a global array for patients that are not found in the "
^XWB(8994,3466,1,3,0)="HMP SUBSCRIPTION file (#800000):"
^XWB(8994,3466,1,4,0)=" "
^XWB(8994,3466,1,5,0)="    DFN^Appointment Date^Location Name^Location IEN"
^XWB(8994,3466,2,0)="^8994.02A^3^3"
^XWB(8994,3466,2,1,0)="STARTDT^1^20^1^1"
^XWB(8994,3466,2,1,1,0)="^^1^1^3150416^"
^XWB(8994,3466,2,1,1,1,0)="Start Date for appointment search in VA format.  This is a required field."
^XWB(8994,3466,2,2,0)="ENDDATE^1^20^0^2"
^XWB(8994,3466,2,2,1,0)="^^2^2^3150416^"
^XWB(8994,3466,2,2,1,1,0)="The ending date for the appointment search in VA format.  This field is "
^XWB(8994,3466,2,2,1,2,0)="optional and will default to the current date if not entered."
^XWB(8994,3466,2,3,0)="LOCIEN^1^20^0^3"
^XWB(8994,3466,2,3,1,0)="^^3^3^3150416^"
^XWB(8994,3466,2,3,1,1,0)="The IEN for the clinic location in the HOSPITAL LOCATION File (#44).  "
^XWB(8994,3466,2,3,1,2,0)="This is an optional field.  Appointments for all locations will be "
^XWB(8994,3466,2,3,1,3,0)="evaluated if not entered."
^XWB(8994,3466,2,"B","ENDDATE",2)=""
^XWB(8994,3466,2,"B","LOCIEN",3)=""
^XWB(8994,3466,2,"B","STARTDT",1)=""
^XWB(8994,3466,2,"PARAMSEQ",1,1)=""
^XWB(8994,3466,2,"PARAMSEQ",2,2)=""
^XWB(8994,3466,2,"PARAMSEQ",3,3)=""
^XWB(8994,3466,3,0)="^^3^3^3150416^"
^XWB(8994,3466,3,1,0)="An array of the following patient appointment data:"
^XWB(8994,3466,3,2,0)=" "
^XWB(8994,3466,3,3,0)="    DFN^Appointment Date^Location Name^Location IEN"
^XWB(8994,3467,0)="HMP PATIENT ADMIT SYNC^ADMIT^HMPACT^4^A^^^1^1"
^XWB(8994,3467,1,0)="^8994.01^6^6^3151208^^^"
^XWB(8994,3467,1,1,0)="This RPC looks up patient admissions by location and returns the "
^XWB(8994,3467,1,2,0)="following in a global array for patients that are not found in the HMP "
^XWB(8994,3467,1,3,0)="SUBSCRIPTION file (#800000):"
^XWB(8994,3467,1,4,0)=" "
^XWB(8994,3467,1,5,0)="    DFN^Admission Date^Location Name^Room-Bed^Location IEN"
^XWB(8994,3467,1,6,0)="      The Room-Bed may not be populated for all locations."
^XWB(8994,3467,2,0)="^8994.02A^1^1"
^XWB(8994,3467,2,1,0)="LOCIEN^1^20^0^1"
^XWB(8994,3467,2,1,1,0)="^8994.021^3^3^3151208^^"
^XWB(8994,3467,2,1,1,1,0)="The IEN for the ward location in the WARD LOCATION file (#42).  "
^XWB(8994,3467,2,1,1,2,0)="This is an optional field.  Admissions for all ward locations will be "
^XWB(8994,3467,2,1,1,3,0)="evaluated if not entered."
^XWB(8994,3467,2,"B","LOCIEN",1)=""
^XWB(8994,3467,2,"PARAMSEQ",1,1)=""
^XWB(8994,3467,3,0)="^^3^3^3150416^"
^XWB(8994,3467,3,1,0)="An array of the following patient admission data:"
^XWB(8994,3467,3,2,0)=" "
^XWB(8994,3467,3,3,0)="    DFN^Admission Date^Location Name^Room-Bed^Location IEN"
^XWB(8994,3468,0)="HMP CHKXTMP^CHKXTMP^HMPMONX^2^S^^^0^^^1"
^XWB(8994,3468,1,0)="^8994.01^5^5^3160914^^^^"
^XWB(8994,3468,1,1,0)="This Remote Procedure returns information about the eHMP storage size "
^XWB(8994,3468,1,2,0)="in ^XTMP and the number of patients in the queue.  The site hash plus "
^XWB(8994,3468,1,3,0)="the local date and time are also returned."
^XWB(8994,3468,1,4,0)="  "
^XWB(8994,3468,1,5,0)="No input parameters are required."
^XWB(8994,3468,3,0)="^8994.03^14^14^3160914^^^^"
^XWB(8994,3468,3,1,0)="It returns two lines of text:"
^XWB(8994,3468,3,2,0)=" RESULT(1) - '^' delimited text describing the values returned"
^XWB(8994,3468,3,3,0)=" RESULT(2) - '^' delimited text with values corresponding to the"
^XWB(8994,3468,3,4,0)="              same $PIECE described in RESULT(1)"
^XWB(8994,3468,3,5,0)="   "
^XWB(8994,3468,3,6,0)="For example:"
^XWB(8994,3468,3,7,0)=" Piece 1 - ""site hash"" and ""9E7A"""
^XWB(8994,3468,3,8,0)=" Piece 2 - ""site local date time"" and ""2016-12-20 11:27:15"""
^XWB(8994,3468,3,9,0)=" Piece 3 - ""Patients in queue"" and ""17"""
^XWB(8994,3468,3,10,0)=" Piece 4 - ""Patients complete"" and ""15"""
^XWB(8994,3468,3,11,0)=" Piece 5 - ""Patients staging"" and ""2"""
^XWB(8994,3468,3,12,0)=" Piece 6 - ""XTMP('HMP') bytes"" and ""78445"""
^XWB(8994,3468,3,13,0)=" Piece 7 - ""XTMP('HMP') objects"" and ""2"""
^XWB(8994,3468,3,14,0)=" "
^XWB(8994,3469,0)="HMP GLOBAL SIZE^SIZE^HMPMONX^2^S"
^XWB(8994,3469,1,0)="^^2^2^3160330^"
^XWB(8994,3469,1,1,0)="Remote procedure HMP GLOBAL SIZE takes no input parameters; it returns "
^XWB(8994,3469,1,2,0)="the size of eHMP's current usage of the ^XTMP global."
^XWB(8994,3469,3,0)="^^2^2^3160330^"
^XWB(8994,3469,3,1,0)="result(1) = a single number, the kilobytes of storage in ^XTMP that eHMP "
^XWB(8994,3469,3,2,0)="is responsible for."
^XWB(8994,3470,0)="HMP DEFAULT PATIENT LIST^DEFLIST^HMPPDL^2^^^^^1^^1"
^XWB(8994,3470,1,0)="^^3^3^3150731^"
^XWB(8994,3470,1,1,0)="This RPC will return the default patient list for a specific provider. "
^XWB(8994,3470,1,2,0)="Input parameter is the provider's DUZ. Out put is an array with the "
^XWB(8994,3470,1,3,0)="patient's DFN^Patient Name^Patient Location."
^XWB(8994,3470,2,0)="^8994.02A^1^1"
^XWB(8994,3470,2,1,0)="DUZ^1^200^1^1"
^XWB(8994,3470,2,1,1,0)="^^1^1^3150731^"
^XWB(8994,3470,2,1,1,1,0)="This is the DUZ for the provider. "
^XWB(8994,3470,2,"B","DUZ",1)=""
^XWB(8994,3470,2,"PARAMSEQ",1,1)=""
^XWB(8994,3470,3,0)="^^4^4^3150731^"
^XWB(8994,3470,3,1,0)="Returns an array containing the default list of patients for the "
^XWB(8994,3470,3,2,0)="requested provider. Array is in the format:"
^XWB(8994,3470,3,3,0)=" "
^XWB(8994,3470,3,4,0)="DFN^Patient Name^Patient Location"
^XWB(8994,3473,0)="VPS RETRIEVE PATIENT VITALS^GET^VPSVTL01^2^^^^1"
^XWB(8994,3473,1,0)="^8994.01^2^2^3151026^^"
^XWB(8994,3473,1,1,0)="This RPC is called  by the Vetlink Kiosk (point of service) system."
^XWB(8994,3473,1,2,0)="This RPC returns the patient vitals information for as given patient."
^XWB(8994,3473,2,0)="^8994.02A^5^5"
^XWB(8994,3473,2,1,0)="VPSNUM^1^25^1^1"
^XWB(8994,3473,2,1,1,0)="^^1^1^3150728^"
^XWB(8994,3473,2,1,1,1,0)="Patient ID such as the patient SSN OR DFN OR ICN OR VIC/CAC."
^XWB(8994,3473,2,2,0)="VPSTYP^1^7^1^2"
^XWB(8994,3473,2,2,1,0)="^^1^1^3150728^"
^XWB(8994,3473,2,2,1,1,0)="Patient ID TYPE such as SSN or DFN OR ICN OR VIC/CAC."
^XWB(8994,3473,2,3,0)="VTYP^1^80^1^3"
^XWB(8994,3473,2,3,1,0)="^^3^3^3151026^"
^XWB(8994,3473,2,3,1,1,0)="VTYP is the type of vital to retrieve. It can be ALL, LAST or one or more"
^XWB(8994,3473,2,3,1,2,0)="vital abbreviations concatenated together separated by semi-colons."
^XWB(8994,3473,2,3,1,3,0)="ie VTYP=""BP;T;P"" for vitals of blood pressure, temperature and pulse"
^XWB(8994,3473,2,4,0)="BDT^1^14^1^4"
^XWB(8994,3473,2,4,1,0)="^^1^1^3150728^"
^XWB(8994,3473,2,4,1,1,0)="Starting date for vitals retrieval."
^XWB(8994,3473,2,5,0)="EDT^1^14^1^5"
^XWB(8994,3473,2,5,1,0)="^8994.021^1^1^3151026^^"
^XWB(8994,3473,2,5,1,1,0)="End date for vitals retrieval."
^XWB(8994,3473,2,"B","BDT",4)=""
^XWB(8994,3473,2,"B","EDT",5)=""
^XWB(8994,3473,2,"B","VPSNUM",1)=""
^XWB(8994,3473,2,"B","VPSTYP",2)=""
^XWB(8994,3473,2,"B","VTYP",3)=""
^XWB(8994,3473,2,"PARAMSEQ",1,1)=""
^XWB(8994,3473,2,"PARAMSEQ",2,2)=""
^XWB(8994,3473,2,"PARAMSEQ",3,3)=""
^XWB(8994,3473,2,"PARAMSEQ",4,4)=""
^XWB(8994,3473,2,"PARAMSEQ",5,5)=""
^XWB(8994,3473,3,0)="^8994.03^3^3^3151026^^"
^XWB(8994,3473,3,1,0)="Returns a array of patient vitals."
^XWB(8994,3473,3,2,0)=" VPSARR(1..n)= Vital Date/Time ^ Vital Type ^ Rate ^ High Risk Flag ^"
^XWB(8994,3473,3,3,0)="                    Location ^ Q1 ; Q2 ^ Sup O2"
^XWB(8994,3474,0)="VPS STORE VITALS^WRITE^VPSVTL02^1^^^^1"
^XWB(8994,3474,1,0)="^8994.01^2^2^3150731^^"
^XWB(8994,3474,1,1,0)="This RPC is called  by the Vetlink Kiosk (point of service) system."
^XWB(8994,3474,1,2,0)="This RPC stores the patient vitals sent from the Kiosk."
^XWB(8994,3474,2,0)="^8994.02A^9^9"
^XWB(8994,3474,2,1,0)="VPSNUM^1^25^1^1"
^XWB(8994,3474,2,1,1,0)="^^1^1^3150731^"
^XWB(8994,3474,2,1,1,1,0)="Patient ID such as the patient SSN OR DFN OR ICN OR VIC/CAC."
^XWB(8994,3474,2,2,0)="VPSTYP^1^7^1^2"
^XWB(8994,3474,2,2,1,0)="^^1^1^3150731^"
^XWB(8994,3474,2,2,1,1,0)="Patient ID TYPE such as SSN or DFN OR ICN OR VIC/CAC."
^XWB(8994,3474,2,3,0)="VTYP^1^10^1^3"
^XWB(8994,3474,2,3,1,0)="^^1^1^3150731^"
^XWB(8994,3474,2,3,1,1,0)="Vital type being stored. (i.e. BP for blood pressure)"
^XWB(8994,3474,2,4,0)="VVAL^1^20^1^4"
^XWB(8994,3474,2,4,1,0)="^^1^1^3150731^"
^XWB(8994,3474,2,4,1,1,0)="The rate or value of the vital measurement."
^XWB(8994,3474,2,5,0)="DTM^1^14^1^5"
^XWB(8994,3474,2,5,1,0)="^^1^1^3150731^"
^XWB(8994,3474,2,5,1,1,0)="Date / time vital measurement was taken."
^XWB(8994,3474,2,6,0)="USER^1^9^1^6"
^XWB(8994,3474,2,6,1,0)="^^1^1^3150731^"
^XWB(8994,3474,2,6,1,1,0)="User that is entering the vitals"
^XWB(8994,3474,2,7,0)="LOC^1^9^1^7"
^XWB(8994,3474,2,7,1,0)="^^1^1^3150731^"
^XWB(8994,3474,2,7,1,1,0)="Hospital location where the vitals where obtained."
^XWB(8994,3474,2,8,0)="QLFS^1^32^^8"
^XWB(8994,3474,2,8,1,0)="^^2^2^3150731^"
^XWB(8994,3474,2,8,1,1,0)="Any qualifiers for this vital entry. Qualifiers are concatinated together "
^XWB(8994,3474,2,8,1,2,0)="with colon seperator. (SITTING:R ARM)"
^XWB(8994,3474,2,9,0)="OXY^1^30^^9"
^XWB(8994,3474,2,9,1,0)="^8994.021^1^1^3150731^^"
^XWB(8994,3474,2,9,1,1,0)="Oxygen flow rate and percent value (2 l/min 95%)"
^XWB(8994,3474,2,"B","DTM",5)=""
^XWB(8994,3474,2,"B","LOC",7)=""
^XWB(8994,3474,2,"B","OXY",9)=""
^XWB(8994,3474,2,"B","QLFS",8)=""
^XWB(8994,3474,2,"B","USER",6)=""
^XWB(8994,3474,2,"B","VPSNUM",1)=""
^XWB(8994,3474,2,"B","VPSTYP",2)=""
^XWB(8994,3474,2,"B","VTYP",3)=""
^XWB(8994,3474,2,"B","VVAL",4)=""
^XWB(8994,3474,2,"PARAMSEQ",1,1)=""
^XWB(8994,3474,2,"PARAMSEQ",2,2)=""
^XWB(8994,3474,2,"PARAMSEQ",3,3)=""
^XWB(8994,3474,2,"PARAMSEQ",4,4)=""
^XWB(8994,3474,2,"PARAMSEQ",5,5)=""
^XWB(8994,3474,2,"PARAMSEQ",6,6)=""
^XWB(8994,3474,2,"PARAMSEQ",7,7)=""
^XWB(8994,3474,2,"PARAMSEQ",8,8)=""
^XWB(8994,3474,2,"PARAMSEQ",9,9)=""
^XWB(8994,3474,3,0)="^^1^1^3150731^"
^XWB(8994,3474,3,1,0)="If error returns 0^Error message, otherwise returns 1."
^XWB(8994,3475,0)="VIABPCE2 GET HFACTORS TYPE^HFTYPE^VIABPCE2^2^^^^^^^1"
^XWB(8994,3475,1,0)="^8994.01^1^1^3151204^"
^XWB(8994,3475,1,1,0)="Returns a list of active health factor types."
^XWB(8994,3476,0)="VIABPCE4 LEX^LEX^VIABPCE4^2^^^^^^^1"
^XWB(8994,3476,1,0)="^^1^1^3151204^"
^XWB(8994,3476,1,1,0)="Returns list of coded elements based on lexicon look-up."
^XWB(8994,3477,0)="VIABU EXTNAME^EXTNAME^VIABU^1^^^^^^^1"
^XWB(8994,3477,1,0)="^^2^2^3151204^"
^XWB(8994,3477,1,1,0)="Returns the external form of a pointer value given the IEN and file"
^XWB(8994,3477,1,2,0)="number."
^XWB(8994,3478,0)="SDEC ACCGROUP^ACCGROUP^SDEC^4^R^0^^0"
^XWB(8994,3478,1,0)="^8994.01^1^1^3150126^^"
^XWB(8994,3478,1,1,0)="Return active entries from the SDEC ACCESS GROUP file 409.822"
^XWB(8994,3478,3,0)="^^4^4^3150126^"
^XWB(8994,3478,3,1,0)="Global Array in which each array entry contains data from the SDEC "
^XWB(8994,3478,3,2,0)="ACCESS GROUP file 409.822:"
^XWB(8994,3478,3,3,0)=" 1. IEN"
^XWB(8994,3478,3,4,0)=" 2. NAME"
^XWB(8994,3479,0)="SDEC ACCTYPE^ACCTYPE^SDEC^4^R^0^^0"
^XWB(8994,3479,1,0)="^^1^1^3150126^"
^XWB(8994,3479,1,1,0)="Return active entries from the SDEC ACCESS TYPE file 409.823"
^XWB(8994,3479,3,0)="^^11^11^3150126^"
^XWB(8994,3479,3,1,0)="Global Array in which each entry in the array contains data from"
^XWB(8994,3479,3,2,0)="      the SDEC ACCESS TYPE file 409.823:"
^XWB(8994,3479,3,3,0)="   1. SDEC_ACCESS_TYPE_IEN"
^XWB(8994,3479,3,4,0)="   2. NAME"
^XWB(8994,3479,3,5,0)="   3. INACTIVE"
^XWB(8994,3479,3,6,0)="   4. DEPARTMENT_NAME"
^XWB(8994,3479,3,7,0)="   5. DISPLAY_COLOR"
^XWB(8994,3479,3,8,0)="   6. RED"
^XWB(8994,3479,3,9,0)="   7. GREEN"
^XWB(8994,3479,3,10,0)="   8. BLUE"
^XWB(8994,3479,3,11,0)="   9. PREVENT_ACCESS"
^XWB(8994,3480,0)="SDEC PTLOOKRS^PTLOOKRS^SDEC^4^R^0^^0"
^XWB(8994,3480,1,0)="^8994.01^3^3^3220608^^^^"
^XWB(8994,3480,1,1,0)="GET Patients that match the partial lookup. The partial lookup can be a"
^XWB(8994,3480,1,2,0)="partial name, Date of Birth, Chart Number, SSN, or empty which will"
^XWB(8994,3480,1,3,0)="return all patients."
^XWB(8994,3480,2,0)="^8994.02A^3^3"
^XWB(8994,3480,2,1,0)="SDECP^1^^0^1"
^XWB(8994,3480,2,1,1,0)="^8994.021^1^1^3150806^^"
^XWB(8994,3480,2,1,1,1,0)="Free-Text - Partial name to look up"
^XWB(8994,3480,2,2,0)="SDECC^1^^0^2"
^XWB(8994,3480,2,2,1,0)="^8994.021^2^2^3150806^^"
^XWB(8994,3480,2,2,1,1,0)="Max number of patients to return"
^XWB(8994,3480,2,2,1,2,0)="defaults to 10"
^XWB(8994,3480,2,3,0)="LASTSUB^1^^0^3"
^XWB(8994,3480,2,3,1,0)="^8994.021^1^1^3220608^^"
^XWB(8994,3480,2,3,1,1,0)="last subscripts from previous call"
^XWB(8994,3480,2,"B","LASTSUB",3)=""
^XWB(8994,3480,2,"B","SDECC",2)=""
^XWB(8994,3480,2,"B","SDECP",1)=""
^XWB(8994,3480,2,"PARAMSEQ",1,1)=""
^XWB(8994,3480,2,"PARAMSEQ",2,2)=""
^XWB(8994,3480,2,"PARAMSEQ",3,3)=""
^XWB(8994,3480,3,0)="^8994.03^151^151^3220728^^"
^XWB(8994,3480,3,1,0)="   1. NAME - NAME from PATIENT file "
^XWB(8994,3480,3,2,0)="   2. HRN  "
^XWB(8994,3480,3,3,0)="   3. SSN - last 4 of SSN "
^XWB(8994,3480,3,4,0)="   4. DOB - Date of Birth "
^XWB(8994,3480,3,5,0)="   5. IEN - DFN pointer to PATIENT file "
^XWB(8994,3480,3,6,0)="   6. GENDER "
^XWB(8994,3480,3,7,0)="   7. INSTIEN "
^XWB(8994,3480,3,8,0)="   8. INSTNAME "
^XWB(8994,3480,3,9,0)="   9. USERIEN "
^XWB(8994,3480,3,10,0)="  10. USERNAME "
^XWB(8994,3480,3,11,0)="  11. PRIGRP - ENROLLMENT PRIORITY text from PATIENT ENROLLMENT file "
^XWB(8994,3480,3,12,0)="               Valid Values: "
^XWB(8994,3480,3,13,0)="                  GROUP 1 "
^XWB(8994,3480,3,14,0)="                  GROUP 2 "
^XWB(8994,3480,3,15,0)="                  GROUP 3 "
^XWB(8994,3480,3,16,0)="                  GROUP 4 "
^XWB(8994,3480,3,17,0)="                  GROUP 5 "
^XWB(8994,3480,3,18,0)="                  GROUP 6 "
^XWB(8994,3480,3,19,0)="                  GROUP 7 "
^XWB(8994,3480,3,20,0)="                  GROUP 8 "
^XWB(8994,3480,3,21,0)="  12. ELIGIEN - Pointer to MAS ELIGIBILITY CODE file 8.1 "
^XWB(8994,3480,3,22,0)="  13. ELIGNAME - NAME from MAS ELIGIBILITY CODE file "
^XWB(8994,3480,3,23,0)="  14. SVCCONN - SERVICE CONNECTED field from PATIENT ENROLLMENT file "
^XWB(8994,3480,3,24,0)="                Valid values: "
^XWB(8994,3480,3,25,0)="                 YES "
^XWB(8994,3480,3,26,0)="                 NO "
^XWB(8994,3480,3,27,0)="  15. SVCCONNP - SERVICE CONNECTED PERCENTAGE field from "
^XWB(8994,3480,3,28,0)="                 PATIENT ENROLLMENT file "
^XWB(8994,3480,3,29,0)="                 Numeric between 0-100 "
^XWB(8994,3480,3,30,0)="  16. TYPEIEN - Pointer to TYPE OF PATIENT file 391 "
^XWB(8994,3480,3,31,0)="  17. TYPENAME - NAME from TYPE OF PATIENT file 391 "
^XWB(8994,3480,3,32,0)="  18. PADDRES1 - Patient Address line 1 "
^XWB(8994,3480,3,33,0)="  19. PADDRES2 - Patient Address line 2 "
^XWB(8994,3480,3,34,0)="  20. PADDRES3 - Patient Address line 3 "
^XWB(8994,3480,3,35,0)="  21. PCITY - Patient City "
^XWB(8994,3480,3,36,0)="  22. PSTATE - Patient state name "
^XWB(8994,3480,3,37,0)="  23. PCOUNTRY - Patient country pointer to COUNTRY CODE file "
^XWB(8994,3480,3,38,0)="  24. PZIP4 - Patient Zip+4 "
^XWB(8994,3480,3,39,0)="  25. GAF - <text> | <GAF score> | <GAF date> | <diagnosis by IEN> "
^XWB(8994,3480,3,40,0)="            | <diagnosis by name> "
^XWB(8994,3480,3,41,0)="  26 SENSITIVE - Sensitive Record Access data separated by pipe |: "
^XWB(8994,3480,3,42,0)="     1. return code: "
^XWB(8994,3480,3,43,0)="        -1-RPC/API failed "
^XWB(8994,3480,3,44,0)="           Required variable not defined "
^XWB(8994,3480,3,45,0)="     0-No display/action required "
^XWB(8994,3480,3,46,0)="           Not accessing own, employee, or sensitive record "
^XWB(8994,3480,3,47,0)="     1-Display warning message "
^XWB(8994,3480,3,48,0)="           Sensitive and DG SENSITIVITY key holder "
^XWB(8994,3480,3,49,0)="           or Employee and DG SECURITY OFFICER key holder "
^XWB(8994,3480,3,50,0)="     2-Display warning message/require OK to continue "
^XWB(8994,3480,3,51,0)="           Sensitive and not a DG SENSITIVITY key holder "
^XWB(8994,3480,3,52,0)="           Employee and not a DG SECURITY OFFICER key holder "
^XWB(8994,3480,3,53,0)="     3-Access to record denied "
^XWB(8994,3480,3,54,0)="           Accessing own record "
^XWB(8994,3480,3,55,0)="     4-Access to Patient (#2) file records denied "
^XWB(8994,3480,3,56,0)="           SSN not defined "
^XWB(8994,3480,3,57,0)="  27 PRACE - Patient Race pointer to RACE file 10 | separates entries"
^XWB(8994,3480,3,58,0)="  28 PRACEN - Patient Race name from RACE file | separates entries "
^XWB(8994,3480,3,59,0)="  29 PETH - Patient Ethnicity list separated by pipe | "
^XWB(8994,3480,3,60,0)="            Pointer to ETHNICITY file 10.2 "
^XWB(8994,3480,3,61,0)="  30 PETHN - Patient Ethnicity names spearated by pipe | "
^XWB(8994,3480,3,62,0)="  31 LASTSUB - last subscripts from previous call "
^XWB(8994,3480,3,63,0)="               Supported by DOB, ALL PATIENTS, and Partial name "
^XWB(8994,3480,3,64,0)="               lookup types "
^XWB(8994,3480,3,65,0)="  32 BADADD = BAD ADDRESS INDICATOR (.121) "
^XWB(8994,3480,3,66,0)="      1=UNDELIVERABLE "
^XWB(8994,3480,3,67,0)="      2=HOMELESS "
^XWB(8994,3480,3,68,0)="      3=OTHER "
^XWB(8994,3480,3,69,0)="      4=ADDRESS NOT FOUND "
^XWB(8994,3480,3,70,0)="  33 HPHONE = Home phone (.131) "
^XWB(8994,3480,3,71,0)="  34 OPHONE = Office phone (.132) "
^XWB(8994,3480,3,72,0)="  35 NOK - Primary Next of Kin (.211) "
^XWB(8994,3480,3,73,0)="  36 KNAME - Primary Next of Kin name "
^XWB(8994,3480,3,74,0)="  37 KREL - Primary Next of Kin Relationship to Patient (.212) "
^XWB(8994,3480,3,75,0)="  38 KPHONE - Primary Next of Kin Phone (.219) "
^XWB(8994,3480,3,76,0)="  39 KSTREET - Primary Next of Kin Street Address [Line 1] "
^XWB(8994,3480,3,77,0)="                      (.213) "
^XWB(8994,3480,3,78,0)="  40 KSTREET2 - Primary Next of Kin Street Address [Line 2] "
^XWB(8994,3480,3,79,0)="                        (.214) "
^XWB(8994,3480,3,80,0)="  41 KSTREET3 - Primary Next of Kin Street Address [Line 3] "
^XWB(8994,3480,3,81,0)="                       (.215) "
^XWB(8994,3480,3,82,0)="  42 KCITY - Primary Next of Kin City (.216) "
^XWB(8994,3480,3,83,0)="  43 KSTATE - Primary Next of Kin State (.217) "
^XWB(8994,3480,3,84,0)="  44 KZIP - Primary Next of Kin Zip (.218) "
^XWB(8994,3480,3,85,0)="  45 NOK2 - Secondary Next of Kin (.2191) "
^XWB(8994,3480,3,86,0)="  46 K2NAME - Secondary Next of Kin name (.2191) "
^XWB(8994,3480,3,87,0)="  47 K2REL - Secondary Next of Kin Relationship to Patient "
^XWB(8994,3480,3,88,0)="                    (.2192) "
^XWB(8994,3480,3,89,0)="  48 K2PHONE - Secondary Next of Kin Phone (.2199) "
^XWB(8994,3480,3,90,0)="  49 K2STREET - Secondary Next of Kin Street Address [Line 1] "
^XWB(8994,3480,3,91,0)="                       (.2193) "
^XWB(8994,3480,3,92,0)="  50 K2STREET2 - Secondary Next of Kin Street Address [Line 2] "
^XWB(8994,3480,3,93,0)="                       (.2194) "
^XWB(8994,3480,3,94,0)="  51 K2STREET3 - Secondary Next of Kin Street Address [Line 3] "
^XWB(8994,3480,3,95,0)="                        (.2195) "
^XWB(8994,3480,3,96,0)="  52 K2CITY - Secondary Next of Kin City (.2196) "
^XWB(8994,3480,3,97,0)="  53 K2STATE - Secondary Next of Kin State (.2197) "
^XWB(8994,3480,3,98,0)="  54 K2ZIP - Secondary Next of Kin Zip (.2198) "
^XWB(8994,3480,3,99,0)="  55 PCOUNTY - Patient County (.117) "
^XWB(8994,3480,3,100,0)="  56 PMARITAL - Patient Marital Status "
^XWB(8994,3480,3,101,0)="  57 PRELIGION - Patient Religious Preference "
^XWB(8994,3480,3,102,0)="  58 PTACTIVE - Patient Temporary Address Active? (.12105) "
^XWB(8994,3480,3,103,0)="  59 PTADDRESS1 - Patient Temporary Address Line 1 (.1211) "
^XWB(8994,3480,3,104,0)="  60 PTADDRESS2 - Patient Temporary Address Line 2 (.1212) "
^XWB(8994,3480,3,105,0)="  61 PTADDRESS3 - Patient Temporary Address Line 3 (.1213) "
^XWB(8994,3480,3,106,0)="  62 PTCITY - Patient Temporary City (.1214) "
^XWB(8994,3480,3,107,0)="  63 PTSTATE - Patient Temporary State (.1215) "
^XWB(8994,3480,3,108,0)="  64 PTZIP - Patient Temporary Zip (.1216) "
^XWB(8994,3480,3,109,0)="  65 PTZIP+4 - Patient Temporary Zip+4 (.12112) "
^XWB(8994,3480,3,110,0)="  66 PTCOUNTRY - Patient Temporary Country (.1223) "
^XWB(8994,3480,3,111,0)="  67 PTCOUNTY - Patient Temporary County (.12111) "
^XWB(8994,3480,3,112,0)="  68 PTPHONE - Patient Temporary Phone (.1219) "
^XWB(8994,3480,3,113,0)="  69 PTSTART - Patient Temporary Address Start Date (.1217) "
^XWB(8994,3480,3,114,0)="  70 PTEND - Patient Temporary Address End Date (.1218) "
^XWB(8994,3480,3,115,0)="  71 PCELL - Patient Cell Phone (.134) "
^XWB(8994,3480,3,116,0)="  72 PPAGER - Patient Pager Number (.135) "
^XWB(8994,3480,3,117,0)="  73 PEMAIL - Patient Email Address (.133) "
^XWB(8994,3480,3,118,0)="  74 PF_FFF - Patient FUGITIVE FELON FLAG 1=YES "
^XWB(8994,3480,3,119,0)="  75 PF_VCD - Patient VETERAN CATASTROPHICALLY DISABLED? "
^XWB(8994,3480,3,120,0)="                      Y=YES N=NO "
^XWB(8994,3480,3,121,0)="  76 PFNATIONAL - Patient national Flags "
^XWB(8994,3480,3,122,0)="           (PRF ASSIGNMENT/PRF NATIONAL FLAG) separated by ^ "
^XWB(8994,3480,3,123,0)="     Each ^ piece contains the following | pipe pieces: "
^XWB(8994,3480,3,124,0)="      1. PRFAID - PRF Assignment ID pointer to PRF ASSIGNMENT file "
^XWB(8994,3480,3,125,0)="                  (#26.13) "
^XWB(8994,3480,3,126,0)="      2. PRFSTAT - PRF Assignment Status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3480,3,127,0)="      3. PRFNID - PRF National Flag ID pointer to PRF NATIONAL FLAG file"
^XWB(8994,3480,3,128,0)="                  (#26.15) "
^XWB(8994,3480,3,129,0)="      4. PRFNNAME - PRF National Flag name "
^XWB(8994,3480,3,130,0)="      5. PRFNSTAT - PRF National Flag status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3480,3,131,0)="  77 PFLOCAL - Patient Local Flags"
^XWB(8994,3480,3,132,0)="               (PRF ASSIGNMENT/PRF Local FLAG) separated by ^"
^XWB(8994,3480,3,133,0)="     Each ^ piece contains the following | pipe pieces: "
^XWB(8994,3480,3,134,0)="       1. PRFAID - PRF Assignment ID pointer to PRF ASSIGNMENT file "
^XWB(8994,3480,3,135,0)="(#26.13)"
^XWB(8994,3480,3,136,0)="       2. PRFSTAT - PRF Assignment Status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3480,3,137,0)="       3. PRFLID - PRF Local Flag ID pointer to PRF LOCAL FLAG file "
^XWB(8994,3480,3,138,0)="(#26.11)"
^XWB(8994,3480,3,139,0)="       4. PRFLNAME - PRF Local Flag name "
^XWB(8994,3480,3,140,0)="       5. PRFLSTAT - PRF Local Flag status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3480,3,141,0)=" 78 SUBGRP - value from the ENROLLMENT SUBGROUP field of the"
^XWB(8994,3480,3,142,0)="             PATIENT ENROLLMENT file (#27.11) "
^XWB(8994,3480,3,143,0)="              Valid values are a b c d e g "
^XWB(8994,3480,3,144,0)=" 79 CAT8G  - Category 8g flag - True if PriGRP ='Group 8' AND SUBGRP-'g'"
^XWB(8994,3480,3,145,0)=" 80 SIMILAR = Similar Patients "
^XWB(8994,3480,3,146,0)="      MESSSAGE | Patients "
^XWB(8994,3480,3,147,0)="       Patients separated by ;; "
^XWB(8994,3480,3,148,0)="        Each ;; piece contains the following ~ pieces "
^XWB(8994,3480,3,149,0)="        DFN ~ NAME ~ DOB ~ SSN (last 4)"
^XWB(8994,3480,3,150,0)=" 81 PRIMARY CARE PROVIDER"
^XWB(8994,3480,3,151,0)=" 82 MENTAL HEALTH PROVIDE6R"
^XWB(8994,3481,0)="SDEC WAITLIST^WAITLIST^SDEC^4^R^0^^0"
