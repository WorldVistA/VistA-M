^XWB(8994,4412,2,1,1,10,0)="                 OR   = CPRS (#100)"
^XWB(8994,4412,2,1,1,11,0)="                 ???  = Other packages to be determined"
^XWB(8994,4412,2,1,1,12,0)="                 If only IEN is received (single data piece),"
^XWB(8994,4412,2,1,1,13,0)="                    will assume TIU Note IEN by default "
^XWB(8994,4412,2,1,1,14,0)="        Piece 4: Copy from IEN;Package (1230;GMRC)"
^XWB(8994,4412,2,1,1,15,0)="                 GMRC = Consults (#123)"
^XWB(8994,4412,2,1,1,16,0)="                 TIU  = Text Integration Utilities (#8925)"
