^XWB(8994,4413,0)="ORWTIU VIEWCOPY^VIEWCOPY^ORWTIU^1"
^XWB(8994,4413,2,0)="^8994.02A^3^3"
^XWB(8994,4413,2,1,0)="DUZ^1^^1^1"
^XWB(8994,4413,2,1,1,0)="^8994.021^1^1^3120828^^"
^XWB(8994,4413,2,1,1,1,0)="This is the user's DUZ."
^XWB(8994,4413,2,2,0)="IEN^1^^0^2"
^XWB(8994,4413,2,2,1,0)="^8994.021^2^2^3120828^^"
^XWB(8994,4413,2,2,1,1,0)="This is the TIU note IEN.  It is used to determine if user is an author"
^XWB(8994,4413,2,2,1,2,0)="or cosigner of the note."
^XWB(8994,4413,2,3,0)="INST^1^^1^3"
^XWB(8994,4413,2,3,1,0)="^8994.021^1^1^3160317^^"
^XWB(8994,4413,2,3,1,1,0)="This is the Institution the user is logged into."
^XWB(8994,4413,2,"B","DUZ",1)=""
^XWB(8994,4413,2,"B","IEN",2)=""
^XWB(8994,4413,2,"B","INST",3)=""
^XWB(8994,4413,2,"PARAMSEQ",1,1)=""
^XWB(8994,4413,2,"PARAMSEQ",2,2)=""
^XWB(8994,4413,2,"PARAMSEQ",3,3)=""
^XWB(8994,4413,3,0)="^8994.03^6^6^3160317^^^"
^XWB(8994,4413,3,1,0)="RSLT="
^XWB(8994,4413,3,2,0)="      0 - User is not allowed to view copy/paste information"
^XWB(8994,4413,3,3,0)="      1 - User is AUTHOR and note is UNSIGNED, or user is COSIGNER who has"
^XWB(8994,4413,3,4,0)="          yet to SIGN the note and the AUTHOR has SIGNED the note."
^XWB(8994,4413,3,5,0)="      2 - User has a user class of ""CHIEF, HIMS"", ""CHIEF, MIS"", ""PRIVACY"
^XWB(8994,4413,3,6,0)="          ACT OFFICER"", or a special user class designated by the site."
^XWB(8994,4414,0)="ORWTIU LDCPIDNT^LDCPIDNT^ORWTIU^1"
^XWB(8994,4414,1,0)="^^6^6^3130627^"
^XWB(8994,4414,1,1,0)="This returns the copy/paste identifier options. The returned data will"
^XWB(8994,4414,1,2,0)="contain 4 to 5 data pieces, comma delimited. The five data pieces"
^XWB(8994,4414,1,3,0)="represent Bold (B), Italicize (I), Underline (UL), Highlight (HL), and"
^XWB(8994,4414,1,4,0)="Highlight Color (HLC). The first four pieces are binary (1 or 0) with"
^XWB(8994,4414,1,5,0)="a 1 indicating the attribute is active. The fifth piece is the selected"
^XWB(8994,4414,1,6,0)="color of the Highlight if the Highlight attribute is active (1)."
^XWB(8994,4415,0)="ORWTIU SVCPIDNT^SVCPIDNT^ORWTIU^1"
^XWB(8994,4415,1,0)="^8994.01^8^8^3131002^^"
^XWB(8994,4415,1,1,0)="This saves the copy/paste identifier options. The saved data will"
^XWB(8994,4415,1,2,0)="contain 4 to 5 data pieces, comma delimited. The five data pieces"
^XWB(8994,4415,1,3,0)="represent Bold (B), Italicize (I), Underline (UL), Highlight (HL), and"
^XWB(8994,4415,1,4,0)="Highlight Color (HLC). The first four pieces are binary (1 or 0) with"
^XWB(8994,4415,1,5,0)="a 1 indicating the attribute is active. The fifth piece is the selected"
^XWB(8994,4415,1,6,0)="color of the Highlight if the Highlight attribute is active (1). To"
^XWB(8994,4415,1,7,0)="save yellow highlight and underline the input data might be"
^XWB(8994,4415,1,8,0)="""0,0,1,1,65535"", with 65535 representing the color yellow."
^XWB(8994,4415,2,0)="^8994.02A^1^1"
^XWB(8994,4415,2,1,0)="ORVAL^1^^1^1"
^XWB(8994,4415,2,1,1,0)="^^1^1^3131002^"
