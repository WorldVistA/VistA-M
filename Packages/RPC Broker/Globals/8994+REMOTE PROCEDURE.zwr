^XWB(8994,5138,2,2,1,24,0)="REQUEST(""SERVICE CONNECTED"")=""""                         OPT"
^XWB(8994,5138,2,2,1,25,0)="  (This is for PRIORITY; 1 OR 0, if passed)"
