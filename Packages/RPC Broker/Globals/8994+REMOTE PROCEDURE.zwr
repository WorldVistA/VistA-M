^XWB(8994,2526,1,0)="^^2^2^3090924^"
^XWB(8994,2526,1,1,0)="This RPC returns the default settings for the display of imaging exams on"
^XWB(8994,2526,1,2,0)="the reports tab."
^XWB(8994,2526,3,0)="^^7^7^3090924^"
^XWB(8994,2526,3,1,0)="The format of the returned string is as follows (pieces separated by '^')"
^XWB(8994,2526,3,2,0)=" "
