^XWB(8994,4697,2,1,1,1,0)="Authorized User IEN"
^XWB(8994,4697,2,2,0)="DVBPIEN^1^250^1^2"
^XWB(8994,4697,2,2,1,0)="^^1^1^3220504^"
^XWB(8994,4697,2,2,1,1,0)="Patient IEN"
^XWB(8994,4697,2,3,0)="DVBTRANS^1^250^1^3"
^XWB(8994,4697,2,3,1,0)="^^1^1^3220504^"
^XWB(8994,4697,2,3,1,1,0)="Transmission Status"
^XWB(8994,4697,2,4,0)="DVBERR^1^2^1^5"
^XWB(8994,4697,2,4,1,0)="^^1^1^3220504^"
^XWB(8994,4697,2,4,1,1,0)="Transmission Error Code"
^XWB(8994,4697,2,5,0)="DVBSTAT^1^2^1^4"
^XWB(8994,4697,2,5,1,0)="^^1^1^3220504^"
^XWB(8994,4697,2,5,1,1,0)="Transmission Status 0=Failure, 1=Success"
