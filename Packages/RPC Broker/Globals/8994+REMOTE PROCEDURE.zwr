^XWB(8994,5022,0)="SDES2 GET APPTS BY CLN RES IEN^BYCLINRESOURCE^SDES2GETAPPTRPCS^2^R^^^^^^1"
^XWB(8994,5022,1,0)="^^4^4^3250213^"
^XWB(8994,5022,1,1,0)="This RPC will return back the appointment for a given clinic resource for "
^XWB(8994,5022,1,2,0)="a given time range."
^XWB(8994,5022,1,3,0)=" "
^XWB(8994,5022,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,5022,2,0)="^8994.02A^2^2"
^XWB(8994,5022,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,5022,2,1,1,0)="^^10^10^3240613^"
^XWB(8994,5022,2,1,1,1,0)=" SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,5022,2,1,1,2,0)="                           Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5022,2,1,1,3,0)=" SDCONTEXT(""USER DUZ"")   = The DUZ of the user taking action on the"
^XWB(8994,5022,2,1,1,4,0)="                           calling application. "
^XWB(8994,5022,2,1,1,5,0)=" SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,5022,2,1,1,6,0)="                           calling application."
^XWB(8994,5022,2,1,1,7,0)=" SDCONTEXT(""PATIENT DFN"")= The name of the patient taking action on the"
^XWB(8994,5022,2,1,1,8,0)="                           calling application."
^XWB(8994,5022,2,1,1,9,0)=" SDCONTEXT(""PATIENT ICN"")= The ICN of the patient taking action on the"
^XWB(8994,5022,2,1,1,10,0)="                           calling application."
^XWB(8994,5022,2,2,0)="SDPARAM^2^32000^1^2"
^XWB(8994,5022,2,2,1,0)="^8994.021^3^3^3250213^^"
^XWB(8994,5022,2,2,1,1,0)=" SDPARAM(""ResourceIEN"")"
^XWB(8994,5022,2,2,1,2,0)=" SDPARAM(""BeginDateTime"")"
^XWB(8994,5022,2,2,1,3,0)=" SDPARAM(""EndDateTime"")"
