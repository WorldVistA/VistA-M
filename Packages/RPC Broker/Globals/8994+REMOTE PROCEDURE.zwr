^XWB(8994,5138,0)="SDES2 CREATE APPT REQ2^CREATEREQUEST^SDES2CRTAPREQ2^2^R^^^0^^^1"
^XWB(8994,5138,1,0)="^^3^3^3250616^"
^XWB(8994,5138,1,1,0)="Creates new appointment request in the SDEC APPT REQUEST file (#409.85)."
^XWB(8994,5138,1,2,0)="This will return all the details of the appointment request."
^XWB(8994,5138,1,3,0)="Can only be invoked by Acheron."
^XWB(8994,5138,2,0)="^8994.02A^2^2"
^XWB(8994,5138,2,1,0)="SDCONTEXT^2^^1^1"
^XWB(8994,5138,2,1,1,0)="^^11^11^3250616^"
^XWB(8994,5138,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"")"
^XWB(8994,5138,2,1,1,2,0)=" - Up to 40 Character unique ID number. "
^XWB(8994,5138,2,1,1,3,0)=" - Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5138,2,1,1,4,0)="SDCONTEXT(""USER DUZ"")"
^XWB(8994,5138,2,1,1,5,0)=" - The DUZ of the user taking action in the calling application."
^XWB(8994,5138,2,1,1,6,0)="SDCONTEXT(""USER SECID"")"
^XWB(8994,5138,2,1,1,7,0)=" - The SECID of the user taking action in the calling application."
^XWB(8994,5138,2,1,1,8,0)="SDCONTEXT(""PATIENT DFN"")"
^XWB(8994,5138,2,1,1,9,0)=" - The DFN/IEN of the target patient from the calling application."
^XWB(8994,5138,2,1,1,10,0)="SDCONTEXT(""PATIENT ICN"")"
^XWB(8994,5138,2,1,1,11,0)=" - The ICN of the target patient from the calling application."
^XWB(8994,5138,2,2,0)="REQUEST^2^^1^2"
^XWB(8994,5138,2,2,1,0)="^^43^43^3250626^"
^XWB(8994,5138,2,2,1,1,0)="Appointment request data."
^XWB(8994,5138,2,2,1,2,0)="  "
^XWB(8994,5138,2,2,1,3,0)="REQUEST(""DFN"")=""""                                       REQ"
^XWB(8994,5138,2,2,1,4,0)="  (PATIENT IEN)"
^XWB(8994,5138,2,2,1,5,0)="REQUEST(""APPOINTMENT TYPE"")=""""                          OPT"
^XWB(8994,5138,2,2,1,6,0)="  APPOINTMENT TYPE - can be the Name or IEN"
^XWB(8994,5138,2,2,1,7,0)="REQUEST(""PATIENT INDICATED DATE"")=""""                    REQ"
^XWB(8994,5138,2,2,1,8,0)="  (PID DATE IN ISO FORMAT)"
^XWB(8994,5138,2,2,1,9,0)="REQUEST(""PRIORITY"")=""""                                  REQ"
^XWB(8994,5138,2,2,1,10,0)="REQUEST(""REQUEST SUB TYPE"")=""""                          REQ"
^XWB(8994,5138,2,2,1,11,0)="REQUEST(""REQUESTED BY"")=""""                              REQ"
^XWB(8994,5138,2,2,1,12,0)="REQUEST(""CLINIC IEN"")=""""                                OPT/REQ  \"
^XWB(8994,5138,2,2,1,13,0)="REQUEST(""PRIMARY AMIS"")=""""                              OPT/REQ---> "
^XWB(8994,5138,2,2,1,14,0)="  Either CLINIC IEN or PRIMARY AMIS/CREDIT PRIMARY AMIS must be defined"
^XWB(8994,5138,2,2,1,15,0)="REQUEST(""CREDIT AMIS"")=""""                               OPT/REQ  /"
^XWB(8994,5138,2,2,1,16,0)="REQUEST(""STATION NUMBER"")=""""                            OPT/REQ -- > "
^XWB(8994,5138,2,2,1,17,0)="  Either STATION NUMBER or INSTITUTION NAME is REQUIRED"
^XWB(8994,5138,2,2,1,18,0)="REQUEST(""INSTITUTION NAME"")=""""                          OPT/REQ --/"
^XWB(8994,5138,2,2,1,19,0)="REQUEST(""CREATE DATE"")=""""                               OPT"
^XWB(8994,5138,2,2,1,20,0)="  Defaults to today if not sent"
^XWB(8994,5138,2,2,1,21,0)="REQUEST(""PROVIDER IEN"")=""""                              OPT"
^XWB(8994,5138,2,2,1,22,0)="  (Required if 'REQUESTED BY' is 'PROVIDER')"
