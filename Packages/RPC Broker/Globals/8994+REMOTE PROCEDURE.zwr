^XWB(8994,3487,3,0)="^^17^17^3150128^"
^XWB(8994,3487,3,1,0)="recordset containing the start times of availability blocks"
^XWB(8994,3487,3,2,0)="  meeting the search criteria. Each Array entry contains the"
^XWB(8994,3487,3,3,0)="     following ^ pieces:"
^XWB(8994,3487,3,4,0)="   RESOURCENAME"
^XWB(8994,3487,3,5,0)="   DATE"
^XWB(8994,3487,3,6,0)="   ACCESSTYPE"
^XWB(8994,3487,3,7,0)="   COMMENT"
^XWB(8994,3487,3,8,0)="   AVAILABILITY - separated by pipe | "
^XWB(8994,3487,3,9,0)="     Each pipe piece contains the following tilde ~ pieces:"
^XWB(8994,3487,3,10,0)="     1. AVAILABILITY DATE (no time in external format"
^XWB(8994,3487,3,11,0)="     2. Schedule Times - separated by ;;"
^XWB(8994,3487,3,12,0)="       each ;; piece contains the following :: pieces:"
^XWB(8994,3487,3,13,0)="       1. Schedule Time - 4 character time representation - ie 0800"
^XWB(8994,3487,3,14,0)="       2. Number of Patients - Numeric 1-20"
^XWB(8994,3487,3,15,0)="       3. Day of Week text"
^XWB(8994,3487,3,16,0)="       4. Number of Day text"
^XWB(8994,3487,3,17,0)="   AVAILABILITYF - AVAILABLITY FLAG - Date in external format"
^XWB(8994,3488,0)="SDEC SUSRINFO^SUSRINFO^SDEC^4^R^0^^0"
^XWB(8994,3488,1,0)="^8994.01^1^1^3150128^^"
^XWB(8994,3488,1,1,0)="SCHEDULING USER INFO"
^XWB(8994,3488,2,0)="^8994.02A^1^1"
^XWB(8994,3488,2,1,0)="SDECDUZ^1^^1^1"
^XWB(8994,3488,2,1,1,0)="^^1^1^3150128^"
^XWB(8994,3488,2,1,1,1,0)="User ID pointer to NEW PERSON file 200"
^XWB(8994,3488,2,"B","SDECDUZ",1)=""
^XWB(8994,3488,2,"PARAMSEQ",1,1)=""
^XWB(8994,3488,3,0)="^^11^11^3150128^"
^XWB(8994,3488,3,1,0)="Global Array containing 1 entry with following: "
^XWB(8994,3488,3,2,0)="    Data is separated by ^:"
^XWB(8994,3488,3,3,0)="     1. MANAGER -  YES if the user has the SDECZMGR key"
^XWB(8994,3488,3,4,0)="                   NO  if not"
^XWB(8994,3488,3,5,0)="     2. USER_NAME"
^XWB(8994,3488,3,6,0)="     3. MENU    -  YES if the user has the SDECZMENU key"
^XWB(8994,3488,3,7,0)="                   NO  if not"
^XWB(8994,3488,3,8,0)="     4. SUPER   -  YES if the user has the SD SUPERVISOR key"
^XWB(8994,3488,3,9,0)="                   NO if not"
^XWB(8994,3488,3,10,0)="     5. SDWLMENU - YES if the user has the SDWL MENU key"
^XWB(8994,3488,3,11,0)="                   NO if not"
^XWB(8994,3488,3,12,0)="     6. SDECRMIC - YES if the user has the SDECZ REQUEST key"
^XWB(8994,3488,3,13,0)="                   NO if not"
^XWB(8994,3488,3,14,0)="     7. SDOB     - YES if the user has the SDOB key"
^XWB(8994,3488,3,15,0)="                   NO if not"
^XWB(8994,3488,3,16,0)="     8. SDMOB    - YES if the user has the SDMOB key"
^XWB(8994,3488,3,17,0)="                   NO if not"
^XWB(8994,3488,3,18,0)="     9. SDECVW -   YES if the user has the SDECVIEW key"
^XWB(8994,3488,3,19,0)="                   NO if not"
^XWB(8994,3488,3,20,0)=" "
^XWB(8994,3488,3,21,0)="Unsuccessful return is an error message detailing the reason for "
^XWB(8994,3488,3,22,0)="failure.  At present (after SD*5.3*694), the reason text will indicate "
^XWB(8994,3488,3,23,0)="that the user is employing an obsolete version of the software."
^XWB(8994,3489,0)="SDEC RESOURCE^RESOURCE^SDEC^4^R^0^^0"
^XWB(8994,3489,1,0)="^8994.01^2^2^3150806^^^"
^XWB(8994,3489,1,1,0)="Returns Recordset with ALL RESOURCE names."
^XWB(8994,3489,1,2,0)="Inactive RESOURCES are NOT filtered out."
^XWB(8994,3489,2,0)="^8994.02A^7^7"
^XWB(8994,3489,2,1,0)="SDECDUZ^1^^0^1"
^XWB(8994,3489,2,1,1,0)="^8994.021^3^3^3150806^^"
^XWB(8994,3489,2,1,1,1,0)="User ID pointer to NEW PERSON file 200"
^XWB(8994,3489,2,1,1,2,0)="Defaults to current user."
^XWB(8994,3489,2,1,1,3,0)="Checks that THIS user has the proper SECURITY KEY"
^XWB(8994,3489,2,2,0)="SDACT^1^^0^2"
^XWB(8994,3489,2,2,1,0)="^8994.021^3^3^3150806^^"
^XWB(8994,3489,2,2,1,1,0)="Active Flag:"
^XWB(8994,3489,2,2,1,2,0)=" 1 or YES will return only active resources"
^XWB(8994,3489,2,2,1,3,0)=" 0, NO, or NULL will include inactive resources"
^XWB(8994,3489,2,3,0)="SDTYPE^1^^0^3"
^XWB(8994,3489,2,3,1,0)="^^5^5^3150806^"
^XWB(8994,3489,2,3,1,1,0)="null will return all resource types"
^XWB(8994,3489,2,3,1,2,0)="             H will only return HOSPITAL LOCATION (clinic) resources"
^XWB(8994,3489,2,3,1,3,0)="             P will only return NEW PERSON (Provider) resources"
^XWB(8994,3489,2,3,1,4,0)="             A will only return SDEC ADDITIONAL RESOURCE resources"
^XWB(8994,3489,2,3,1,5,0)="            PH will only return prohibited clinics"
^XWB(8994,3489,2,4,0)="MAXREC^1^^0^4"
^XWB(8994,3489,2,4,1,0)="^^1^1^3150806^"
^XWB(8994,3489,2,4,1,1,0)="Max records returned"
^XWB(8994,3489,2,5,0)="LASTSUBI^1^^0^5"
^XWB(8994,3489,2,5,1,0)="^^1^1^3150806^"
^XWB(8994,3489,2,5,1,1,0)="last subscripts from previous call"
^XWB(8994,3489,2,6,0)="SDIEN^1^^0^6"
^XWB(8994,3489,2,6,1,0)="^^2^2^3150806^"
^XWB(8994,3489,2,6,1,1,0)="pointer to SDEC RESOURCE file"
^XWB(8994,3489,2,6,1,2,0)="only 1 record will be returned if SDIEN is present"
^XWB(8994,3489,2,7,0)="SDECP^1^^0^7"
^XWB(8994,3489,2,7,1,0)="^^1^1^3150806^"
^XWB(8994,3489,2,7,1,1,0)="Partial name text"
^XWB(8994,3489,2,"B","LASTSUBI",5)=""
^XWB(8994,3489,2,"B","MAXREC",4)=""
