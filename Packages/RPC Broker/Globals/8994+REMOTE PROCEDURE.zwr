^XWB(8994,4979,0)="SDES2 CREATE RECALL REQUEST^CREATERECREQ^SDES2RECLLREQ^2^R^^^^1^^1"
^XWB(8994,4979,1,0)="^^4^4^3250213^"
^XWB(8994,4979,1,1,0)="CREATE A NEW ENTRY INTO THE RECALL REMINDERS (#403.5) FILE FOR PATIENT "
^XWB(8994,4979,1,2,0)="DFN."
^XWB(8994,4979,1,3,0)=" "
^XWB(8994,4979,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,4979,2,0)="^8994.02A^2^2"
^XWB(8994,4979,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,4979,2,1,1,0)="^^10^10^3231108^"
^XWB(8994,4979,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number. "
^XWB(8994,4979,2,1,1,2,0)="           Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,4979,2,1,1,3,0)="SDCONTEXT(""PATIENT DFN"") = The DFN/IEN of the target patient from the"
^XWB(8994,4979,2,1,1,4,0)="           calling application."
^XWB(8994,4979,2,1,1,5,0)="SDCONTEXT(""PATIENT ICN"") = The ICN of the target patient from the"
^XWB(8994,4979,2,1,1,6,0)="           calling application."
^XWB(8994,4979,2,1,1,7,0)="SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action in the"
^XWB(8994,4979,2,1,1,8,0)="           calling application."
^XWB(8994,4979,2,1,1,9,0)="SDCONTEXT(""USER SECID"") = The SECID of the user taking action in"
^XWB(8994,4979,2,1,1,10,0)="           the calling application."
^XWB(8994,4979,2,2,0)="SDINPUT^2^32000^1^2"
^XWB(8994,4979,2,2,1,0)="^8994.021^28^28^3250213^^"
^XWB(8994,4979,2,2,1,1,0)="SDINPUT(""DFN"") = POINTER TO PATIENT (#2) FILE "
^XWB(8994,4979,2,2,1,2,0)="                 (required)"
^XWB(8994,4979,2,2,1,3,0)="SDINPUT(""ACCESSION NUMBER"") = ACCESSION # (FREE TEXT)"
^XWB(8994,4979,2,2,1,4,0)="SDINPUT(""COMMENT"") = COMMENT (FREE TEXT)"
^XWB(8994,4979,2,2,1,5,0)="SDINPUT(""FASTING"") = (required)"
^XWB(8994,4979,2,2,1,6,0)="                     Labs:"
^XWB(8994,4979,2,2,1,7,0)="                       FASTING"
^XWB(8994,4979,2,2,1,8,0)="                       NON-FASTING"
^XWB(8994,4979,2,2,1,9,0)="                       @ - None "
^XWB(8994,4979,2,2,1,10,0)="SDINPUT(""APPOINTMENT TYPE"") = (required)"
^XWB(8994,4979,2,2,1,11,0)="         Name of the RECALL REMINDERS APPT TYPE (#403.51) FILE"
^XWB(8994,4979,2,2,1,12,0)="SDINPUT(""RECALL PROVIDER IEN"") = RECALL PROVIDER - POINTER TO RECALL"
^XWB(8994,4979,2,2,1,13,0)="         REMINDERS PROVIDERS (#403.54) FILE (required)"
^XWB(8994,4979,2,2,1,14,0)="SDINPUT(""CLINIC IEN"") = CLINIC POINTER TO HOSPITAL LOCATION (#44) FILE"
^XWB(8994,4979,2,2,1,15,0)="         (required)"
^XWB(8994,4979,2,2,1,16,0)="SDINPUT(""APPOINTMENT LENGTH"") = LENGTH OF APPOINTMENT NUMERIC BETWEEN"
^XWB(8994,4979,2,2,1,17,0)="         10 AND 120. IF VALUE SENT IN IS LESS THAN 10 OR GREATER THAN"
^XWB(8994,4979,2,2,1,18,0)="         120 SETS TO NULL."
^XWB(8994,4979,2,2,1,19,0)="SDINPUT(""RECALL DATE"") = Recall date in ISO8601 date format (no time)."
^XWB(8994,4979,2,2,1,20,0)="         e.g., CCYY-MM-DD (required)"
^XWB(8994,4979,2,2,1,21,0)="SDINPUT(""RECALL DATE PER PATIENT"") = Recall date (per patient) in ISO8601"
^XWB(8994,4979,2,2,1,22,0)="         date format (no time). e.g., CCYY-MM-DD"
^XWB(8994,4979,2,2,1,23,0)="SDINPUT(""DATE REMINDER SENT"") = Date Reminder was sent in ISO8601 date"
^XWB(8994,4979,2,2,1,24,0)="         format (no time). e.g., CCYY-MM-DD"
^XWB(8994,4979,2,2,1,25,0)="SDINPUT(""SECOND PRINT DATE"") = Second print date in ISO8601 date format"
^XWB(8994,4979,2,2,1,26,0)="         (no time). e.g., CCYY-MM-DD"
^XWB(8994,4979,2,2,1,27,0)="SDINPUT(""DATE ENTERED"") = Date recall was added. Date is in ISO8601"
^XWB(8994,4979,2,2,1,28,0)="         format (no time) (e.g., CCYY-MM-DD)"
^XWB(8994,4979,2,"B","SDCONTEXT",1)=""
^XWB(8994,4979,2,"B","SDINPUT",2)=""
^XWB(8994,4979,2,"PARAMSEQ",1,1)=""
^XWB(8994,4979,2,"PARAMSEQ",2,2)=""
^XWB(8994,4979,3,0)="^8994.03^24^24^3250213^^"
^XWB(8994,4979,3,1,0)="Successful Return:"
^XWB(8994,4979,3,2,0)="   "
^XWB(8994,4979,3,3,0)=" {"
^XWB(8994,4979,3,4,0)="         ""RecallReqCreate"": {"
^XWB(8994,4979,3,5,0)="                 ""IEN"": 27557"
^XWB(8994,4979,3,6,0)="         }"
^XWB(8994,4979,3,7,0)=" }"
^XWB(8994,4979,3,8,0)="  "
^XWB(8994,4979,3,9,0)=" Otherwise, JSON Errors will be returned for any invalid/missing "
^XWB(8994,4979,3,10,0)=" parameters."
^XWB(8994,4979,3,11,0)="  "
^XWB(8994,4979,3,12,0)=" {"
^XWB(8994,4979,3,13,0)="         ""Error"": ["
^XWB(8994,4979,3,14,0)="                 ""Missing Patient ID."","
^XWB(8994,4979,3,15,0)="                 ""Missing Fasting value."","
^XWB(8994,4979,3,16,0)="                 ""Missing Recall Reminders Appointment Type ID."","
^XWB(8994,4979,3,17,0)="                 ""Missing Recall Reminders Provider ID."","
^XWB(8994,4979,3,18,0)="                 ""Missing Clinic ID."","
^XWB(8994,4979,3,19,0)="                 ""Missing Recall Date."""
^XWB(8994,4979,3,20,0)="         ],"
^XWB(8994,4979,3,21,0)="         ""RecallReqCreate"": {"
^XWB(8994,4979,3,22,0)="                 ""IEN"": """""
^XWB(8994,4979,3,23,0)="         }"
^XWB(8994,4979,3,24,0)=" }"
^XWB(8994,4980,0)="SDES2 EDIT RECALL REQUEST^UPDRECALLREQ^SDES2RECLLREQ^2^R^^^^1^^1"
^XWB(8994,4980,1,0)="^^4^4^3250214^"
^XWB(8994,4980,1,1,0)="UPDATE AN EXISTING ENTRY IN RECALL REMINDERS (#403.5) BASED ON THE IEN "
^XWB(8994,4980,1,2,0)="PASSED IN."
^XWB(8994,4980,1,3,0)=" "
^XWB(8994,4980,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,4980,2,0)="^8994.02A^2^2"
^XWB(8994,4980,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,4980,2,1,1,0)="^^10^10^3231108^"
^XWB(8994,4980,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number. "
^XWB(8994,4980,2,1,1,2,0)="           Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,4980,2,1,1,3,0)="SDCONTEXT(""PATIENT DFN"") = The DFN/IEN of the target patient from the"
^XWB(8994,4980,2,1,1,4,0)="           calling application."
^XWB(8994,4980,2,1,1,5,0)="SDCONTEXT(""PATIENT ICN"") = The ICN of the target patient from the"
^XWB(8994,4980,2,1,1,6,0)="           calling application."
^XWB(8994,4980,2,1,1,7,0)="SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action in the"
^XWB(8994,4980,2,1,1,8,0)="           calling application."
^XWB(8994,4980,2,1,1,9,0)="SDCONTEXT(""USER SECID"") = The SECID of the user taking action in"
^XWB(8994,4980,2,1,1,10,0)="           the calling application."
^XWB(8994,4980,2,2,0)="SDINPUT^2^32000^1^2"
^XWB(8994,4980,2,2,1,0)="^8994.021^32^32^3250214^^^"
^XWB(8994,4980,2,2,1,1,0)="SDINPUT(""RECALL IEN"") = IEN pointer to RECALL REMINDERS (#403.5)"
^XWB(8994,4980,2,2,1,2,0)="                        (required)"
^XWB(8994,4980,2,2,1,3,0)="SDINPUT(""DFN"") = POINTER TO PATIENT (#2) FILE "
^XWB(8994,4980,2,2,1,4,0)="                 (required)"
^XWB(8994,4980,2,2,1,5,0)="SDINPUT(""ACCESSION NUMBER"") = ACCESSION # (FREE TEXT)"
^XWB(8994,4980,2,2,1,6,0)="SDINPUT(""COMMENT"") = COMMENT (FREE TEXT)"
^XWB(8994,4980,2,2,1,7,0)="SDINPUT(""FASTING"") = (required)"
^XWB(8994,4980,2,2,1,8,0)="                     Labs:"
^XWB(8994,4980,2,2,1,9,0)="                       FASTING"
^XWB(8994,4980,2,2,1,10,0)="                       NON-FASTING"
^XWB(8994,4980,2,2,1,11,0)="                       @ - None "
^XWB(8994,4980,2,2,1,12,0)="SDINPUT(""APPOINTMENT TYPE"") = (required)"
^XWB(8994,4980,2,2,1,13,0)="         Name of the RECALL REMINDERS APPT TYPE (#403.51) FILE"
^XWB(8994,4980,2,2,1,14,0)="            1    FOLLOW-UP          F"
^XWB(8994,4980,2,2,1,15,0)="            4    OTHER              O"
^XWB(8994,4980,2,2,1,16,0)="            3    SEMI-ANNUAL EXAM   SA"
^XWB(8994,4980,2,2,1,17,0)="            2    YEARLY EXAM        YEAR"
^XWB(8994,4980,2,2,1,18,0)="SDINPUT(""RECALL PROVIDER IEN"") = RECALL PROVIDER - POINTER TO RECALL"
^XWB(8994,4980,2,2,1,19,0)="         REMINDERS PROVIDERS (#403.54) FILE (required)"
^XWB(8994,4980,2,2,1,20,0)="SDINPUT(""CLINIC IEN"") = CLINIC POINTER TO HOSPITAL LOCATION (#44) FILE"
^XWB(8994,4980,2,2,1,21,0)="         (required)"
^XWB(8994,4980,2,2,1,22,0)="SDINPUT(""APPOINTMENT LENGTH"") = LENGTH OF APPOINTMENT NUMERIC BETWEEN"
^XWB(8994,4980,2,2,1,23,0)="         10 AND 120."
^XWB(8994,4980,2,2,1,24,0)="SDINPUT(""RECALL DATE"") = Recall date in ISO8601 date format (no time)."
^XWB(8994,4980,2,2,1,25,0)="         e.g., CCYY-MM-DD (required)"
^XWB(8994,4980,2,2,1,26,0)="SDINPUT(""RECALL DATE PER PATIENT"") = Recall date (per patient) in ISO8601"
^XWB(8994,4980,2,2,1,27,0)="         date format (no time). e.g., CCYY-MM-DD"
^XWB(8994,4980,2,2,1,28,0)="SDINPUT(""DATE REMINDER SENT"") = Date Reminder was sent in ISO8601 date"
^XWB(8994,4980,2,2,1,29,0)="         format (no time). e.g., CCYY-MM-DD"
^XWB(8994,4980,2,2,1,30,0)="SDINPUT(""SECOND PRINT DATE"") = Second print date in ISO8601 date format"
^XWB(8994,4980,2,2,1,31,0)="         (no time). e.g., CCYY-MM-DD"
^XWB(8994,4980,2,2,1,32,0)=" "
