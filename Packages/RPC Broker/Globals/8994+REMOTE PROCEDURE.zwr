^XWB(8994,4691,0)="DVBA CAPRI GET EFOLDER TOKEN^EFOLD^DVBABURL^1^R^0^^0^1"
^XWB(8994,4691,1,0)="^^2^2^3240731^"
^XWB(8994,4691,1,1,0)="CAPRI REMOTE PROCEDURE CALL RETURNS DVBAB CAPRI CDEFOLD TOKEN SECURITY "
^XWB(8994,4691,1,2,0)="CODE."
^XWB(8994,4691,2,0)="^8994.02A^1^1"
^XWB(8994,4691,2,1,0)="DUZ^1^30^1^1"
^XWB(8994,4691,2,"B","DUZ",1)=""
^XWB(8994,4691,2,"PARAMSEQ",1,1)=""
^XWB(8994,4692,0)="DVBA CAPRI PARAM INQ^PARAMS^DVBCPUSH^2^R^^^^1"
^XWB(8994,4692,1,0)="^8994.01^2^2^3250225^^^^"
^XWB(8994,4692,1,1,0)="This RPC will return all Parameters under the AMIE(DVBA) namespace."
^XWB(8994,4692,1,2,0)="Multiple instances are separated by vertical bars (""|"")."
^XWB(8994,4692,3,0)="^8994.03^3^3^3250225^^^"
^XWB(8994,4692,3,1,0)="For each parameter in the DVB namespace:"
^XWB(8994,4692,3,2,0)="Parameter definition IEN^parameter name^<instance 1 value>|<instance "
^XWB(8994,4692,3,3,0)="2 value>|<instance 3 value>..."
^XWB(8994,4693,0)="DVBA CAPRI PARAM UPDATE^PARAMED^DVBCPUSH^1^R^^^^1"
^XWB(8994,4693,1,0)="^8994.01^8^8^3250227^^"
^XWB(8994,4693,1,1,0)="This RPC allows CAPRI to update CAPRI Parameter values."
^XWB(8994,4693,1,2,0)="If the parameter has multiples, then the multiple instance values are "
^XWB(8994,4693,1,3,0)="sent in the 3rd input parameter (DVBVAL) separated by vertical bars (""|"")."
^XWB(8994,4693,1,4,0)="The RPC will delete all instances and replace them with the new values in "
^XWB(8994,4693,1,5,0)="DVBVAL.  If a single null value is sent, then all instances are deleted."
^XWB(8994,4693,1,6,0)="For word processing values, the bars ""|"" can be used in place of carriage "
^XWB(8994,4693,1,7,0)="returns. If the information is longer than 250 characters, the RPC will "
^XWB(8994,4693,1,8,0)="break it up into lines of 100 characters. "
^XWB(8994,4693,2,0)="^8994.02A^2^2"
^XWB(8994,4693,2,1,0)="PARAMETER NAME^1^250^1^1"
^XWB(8994,4693,2,1,1,0)="^8994.021^1^1^3250225^^"
^XWB(8994,4693,2,1,1,1,0)="Name of the Parameter to be updated. "
^XWB(8994,4693,2,2,0)="VALUE^1^250^1^2"
^XWB(8994,4693,2,2,1,0)="^8994.021^1^1^3250227^^^"
^XWB(8994,4693,2,2,1,1,0)="Value for parameter to be updated to. "
^XWB(8994,4693,2,"B","PARAMETER NAME",1)=""
^XWB(8994,4693,2,"B","VALUE",2)=""
^XWB(8994,4693,2,"PARAMSEQ",1,1)=""
^XWB(8994,4693,2,"PARAMSEQ",2,2)=""
^XWB(8994,4693,3,0)="^^13^13^3250306^"
^XWB(8994,4693,3,1,0)="Return value will be one of the following:"
^XWB(8994,4693,3,2,0)="<successful update count>/<total update count> was(were) "
^XWB(8994,4693,3,3,0)="successful^<unsuccessful instance and reason>|<unsuccessful instance and "
^XWB(8994,4693,3,4,0)="reason>"
^XWB(8994,4693,3,5,0)="""Word Processing Parameter"" was updated successfully"
^XWB(8994,4693,3,6,0)="OR"
^XWB(8994,4693,3,7,0)="Missing parameter name"
^XWB(8994,4693,3,8,0)="OR"
^XWB(8994,4693,3,9,0)="The entire parameter list has been delete"
^XWB(8994,4693,3,10,0)="OR"
^XWB(8994,4693,3,11,0)="An error message indicating why the parameter list was not deleted"
^XWB(8994,4693,3,12,0)="OR"
