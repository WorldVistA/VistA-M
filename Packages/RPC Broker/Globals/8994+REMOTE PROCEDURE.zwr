^XWB(8994,3493,0)="SDEC RESGRPUS^RESGRPUS^SDEC^4^R^0^^0"
^XWB(8994,3493,1,0)="^^8^8^3150505^"
^XWB(8994,3493,1,1,0)="Returns ADO Recordset with all ACTIVE resource group names to which user "
^XWB(8994,3493,1,2,0)="has access"
^XWB(8994,3493,1,3,0)="based on entries in SDEC RESOURCE USER file"
^XWB(8994,3493,1,4,0)="If SDECDUZ=0 then returns all department names for current DUZ"
^XWB(8994,3493,1,5,0)="If user SDECDUZ possesses the key SDECZMGR"
^XWB(8994,3493,1,6,0)="then ALL resource group names are returned regardless of whether any "
^XWB(8994,3493,1,7,0)="active resources"
^XWB(8994,3493,1,8,0)="are associated with the group or not."
^XWB(8994,3493,2,0)="^8994.02A^1^1"
