^XWB(8994,3888,3,4,0)="DSIYRET(1) = ""0^Warning Message"" if warnings"
^XWB(8994,3888,3,5,0)="DSIYRET(WO Field #) = Field # ^ Table Name ^ Internal ^ External"
^XWB(8994,3888,3,6,0)=" "
^XWB(8994,3888,3,7,0)="Data is returned for Work Order Fields"
^XWB(8994,3888,3,8,0)=" "
^XWB(8994,3888,3,9,0)="3:   Location"
^XWB(8994,3888,3,10,0)="18:  Equipment IEN"
^XWB(8994,3888,3,11,0)="19:  Local Identifier"
^XWB(8994,3888,3,12,0)="20:  PMI #"
^XWB(8994,3888,3,13,0)="21:  Equipment Category"
^XWB(8994,3888,3,14,0)="21.9:Manufacturer"
^XWB(8994,3888,3,15,0)="22.3:Model #"
^XWB(8994,3888,3,16,0)="22.5:Serial #"
^XWB(8994,3888,3,17,0)="23:  Owner/Department"
^XWB(8994,3888,3,18,0)=" "
^XWB(8994,3888,3,19,0)="Information is also returned from the Equipment for the following "
^XWB(8994,3888,3,20,0)="display-only fields.  The subscripts are just placeholders:"
^XWB(8994,3888,3,21,0)=" "
^XWB(8994,3888,3,22,0)="96:  Warranty Expiration Date"
^XWB(8994,3888,3,23,0)="97:  JHACO Status"
^XWB(8994,3888,3,24,0)="98:  Lockout Required?"
^XWB(8994,3888,3,25,0)="99:  Condition Code"
^XWB(8994,3888,3,26,0)="94:  Service Contract"
^XWB(8994,3888,3,27,0)="95:  Mfg Equipment Name"
^XWB(8994,3889,0)="DSIYWO4 WOUPDT UPDATE WO^WOUPDT^DSIYWO4^2^P^0^^1"
^XWB(8994,3889,1,0)="^8994.01^4^4^3130401^^^^"
^XWB(8994,3889,1,1,0)="WOUPDT"
^XWB(8994,3889,1,2,0)=" "
^XWB(8994,3889,1,3,0)="Updates the data in the Work Order file based on data sent from the GUI "
^XWB(8994,3889,1,4,0)="screen."
^XWB(8994,3889,2,0)="^8994.02A^6^5"
^XWB(8994,3889,2,1,0)="DSIYDAT^2^60^1^5"
^XWB(8994,3889,2,1,1,0)="^8994.021^8^8^3121204^^^^"
^XWB(8994,3889,2,1,1,1,0)="DSIYDAT"
^XWB(8994,3889,2,1,1,2,0)=" "
^XWB(8994,3889,2,1,1,3,0)="Send in fields for Work Order information.  "
^XWB(8994,3889,2,1,1,4,0)=" "
^XWB(8994,3889,2,1,1,5,0)="Field .01 should be the IEN of the Work Order - if this is a NEW Work "
^XWB(8994,3889,2,1,1,6,0)="Order, leave this field blank."
^XWB(8994,3889,2,1,1,7,0)=" "
^XWB(8994,3889,2,1,1,8,0)="All Fields should be in the format Internal Value ^ External Value"
^XWB(8994,3889,2,2,0)="DSIYTECH^1^245^0^3"
^XWB(8994,3889,2,2,1,0)="^8994.021^6^6^3121204^^"
^XWB(8994,3889,2,2,1,1,0)="DSIYTECH"
^XWB(8994,3889,2,2,1,2,0)=" "
^XWB(8994,3889,2,2,1,3,0)="Data for Technician Multiple"
^XWB(8994,3889,2,2,1,4,0)=" "
^XWB(8994,3889,2,2,1,5,0)="DSIYTECH = TECH IEN1 ^ TECH HOURS1 ^ TECH SHOP IEN1 ;"
^XWB(8994,3889,2,2,1,6,0)="           TECH IEN2 ^ TECH HOURS2 ^ TECH SHOP IEN2 ; ...ETC."
^XWB(8994,3889,2,3,0)="DSIYWKAC^1^245^0^4"
^XWB(8994,3889,2,3,1,0)="^8994.021^5^5^3121204^^^"
^XWB(8994,3889,2,3,1,1,0)="DSIYWKAC"
