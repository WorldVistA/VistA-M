^XWB(8994,4535,3,40,0)="      ""TimeZoneCode"": ""EST"""
^XWB(8994,4535,3,41,0)="     },"
^XWB(8994,4535,3,42,0)="     {"
^XWB(8994,4535,3,43,0)="      ""Offset"": ""-0400"","
^XWB(8994,4535,3,44,0)="      ""TimeFrame"": ""DAYLIGHT SAVINGS"","
^XWB(8994,4535,3,45,0)="      ""TimeZoneCode"": ""EDT"""
^XWB(8994,4535,3,46,0)="     }"
^XWB(8994,4535,3,47,0)="    ],"
^XWB(8994,4535,3,48,0)="    ""TimeZoneException"": """""
^XWB(8994,4535,3,49,0)="   },"
^XWB(8994,4535,3,50,0)="   ""CurrentStatus"": ""NON-COUNT/CHECKED IN"","
^XWB(8994,4535,3,51,0)="   ""DFN"": 7172311,"
^XWB(8994,4535,3,52,0)="   ""EASTrackingNumber"": """","
^XWB(8994,4535,3,53,0)="   ""EndTime"": ""JAN 23, 2024@09:30"","
^XWB(8994,4535,3,54,0)="   ""LengthOfAppt"": 30,"
^XWB(8994,4535,3,55,0)="   ""Note"": """","
^XWB(8994,4535,3,56,0)="   ""Patient"": {"
^XWB(8994,4535,3,57,0)="    ""DFN"": 7172311,"
^XWB(8994,4535,3,58,0)="    ""DOBE"": ""10/08/1982"","
^XWB(8994,4535,3,59,0)="    ""DOBI"": 2821008,"
^XWB(8994,4535,3,60,0)="    ""DateOfBirth"": ""1982-10-08"","
^XWB(8994,4535,3,61,0)="    ""DateOfDeath"": """","
^XWB(8994,4535,3,62,0)="    ""EligibilityE"": ""TRICARE"","
^XWB(8994,4535,3,63,0)="    ""EligibilityI"": 20,"
^XWB(8994,4535,3,64,0)="    ""EligibilityIEN"": 20,"
^XWB(8994,4535,3,65,0)="    ""Gender"": ""MALE"","
^XWB(8994,4535,3,66,0)="    ""ICN"": ""4420062460V607088"","
^XWB(8994,4535,3,67,0)="    ""Name"": ""VSETEST,ONE D"","
^XWB(8994,4535,3,68,0)="    ""SSN"": 000000000,"
^XWB(8994,4535,3,69,0)="   },"
^XWB(8994,4535,3,70,0)="   ""PatientComments"": ["
^XWB(8994,4535,3,71,0)="    """""
^XWB(8994,4535,3,72,0)="   ],"
^XWB(8994,4535,3,73,0)="   ""Provider"": {"
^XWB(8994,4535,3,74,0)="    ""ID"": """","
^XWB(8994,4535,3,75,0)="    ""Name"": """","
^XWB(8994,4535,3,76,0)="    ""SecId"": """""
^XWB(8994,4535,3,77,0)="   },"
^XWB(8994,4535,3,78,0)="   ""RequestIEN"": 264078,"
^XWB(8994,4535,3,79,0)="   ""RequestType"": ""APPT"","
^XWB(8994,4535,3,80,0)="   ""Resource"": {"
^XWB(8994,4535,3,81,0)="    ""ClinicIEN"": 5263,"
^XWB(8994,4535,3,82,0)="    ""Name"": ""TEST CLINIC 12"""
^XWB(8994,4535,3,83,0)="   },"
^XWB(8994,4535,3,84,0)="   ""ResourceIEN"": 3634,"
^XWB(8994,4535,3,85,0)="   ""StartTime"": ""JAN 23, 2024@09:00"","
^XWB(8994,4535,3,86,0)="   ""StartTimeFM"": 3240123.09,"
^XWB(8994,4535,3,87,0)="   ""Status"": ""NON-COUNT/CHECKED IN"","
^XWB(8994,4535,3,88,0)="   ""StatusCancelDateTime"": """","
^XWB(8994,4535,3,89,0)="   ""Walkin"": """""
^XWB(8994,4535,3,90,0)="  }"
^XWB(8994,4535,3,91,0)=" ]"
^XWB(8994,4535,3,92,0)="}"
^XWB(8994,4539,0)="ORQ3 AUTHUSR^AUTHUSR^ORQ3^1"
^XWB(8994,4540,0)="ORQ3 EN^EN^ORQ3^4^^^^1^^^1"
^XWB(8994,4540,1,0)="^^6^6^3180117^"
^XWB(8994,4540,1,1,0)="This RPC call will generate a list sorted by Patient Name, Patient IEN,"
^XWB(8994,4540,1,2,0)="and Order IEN based on all Orders for a particular PROVIDER at the"
^XWB(8994,4540,1,3,0)="ORDER ACTIONS level where the Activity Date/Time is within the date"
^XWB(8994,4540,1,4,0)="range passed in.  The list will also contain the Order Status and Date"
^XWB(8994,4540,1,5,0)="Order Entered In.  Parameters it accepts are Provider IEN from File"
^XWB(8994,4540,1,6,0)="#200 along with Begin Date and End Date in FileMan format."
^XWB(8994,4540,2,0)="^8994.02A^3^3"
^XWB(8994,4540,2,1,0)="ORPRIEN^1^^1^1"
^XWB(8994,4540,2,1,1,0)="^^1^1^3180117^"
^XWB(8994,4540,2,1,1,1,0)="This is the Provider IEN that gets passed in."
^XWB(8994,4540,2,2,0)="ORDT1^1^^1^2"
^XWB(8994,4540,2,2,1,0)="^^1^1^3180117^"
^XWB(8994,4540,2,2,1,1,0)="This is the Starting Date that gets passed in."
^XWB(8994,4540,2,3,0)="ORDT2^1^^1^3"
^XWB(8994,4540,2,3,1,0)="^^1^1^3180117^"
^XWB(8994,4540,2,3,1,1,0)="This is the Ending Date that gets passed in."
^XWB(8994,4540,2,"B","ORDT1",2)=""
^XWB(8994,4540,2,"B","ORDT2",3)=""
^XWB(8994,4540,2,"B","ORPRIEN",1)=""
^XWB(8994,4540,2,"PARAMSEQ",1,1)=""
^XWB(8994,4540,2,"PARAMSEQ",2,2)=""
^XWB(8994,4540,2,"PARAMSEQ",3,3)=""
^XWB(8994,4540,3,0)="^^4^4^3180117^"
^XWB(8994,4540,3,1,0)="This returns a list of Patient Names, Patient IENs, and Order IENs"
^XWB(8994,4540,3,2,0)="along with Order Status and Date When Order Entered In, e.g.:"
^XWB(8994,4540,3,3,0)="   ^TMP(""ORPATORD"",$J,1)=<Patient Name>^<Patient IEN>^<Order IEN>^"
^XWB(8994,4540,3,4,0)="                         <Order Status>^<Date When Order Entered In>"
^XWB(8994,4541,0)="ORQ3 XFER^XFER^ORQ3^4^^^^1^^^1"
^XWB(8994,4541,1,0)="^^7^7^3180117^"
^XWB(8994,4541,1,1,0)="This RPC call will take a list of Order IENs along with Transferring From"
^XWB(8994,4541,1,2,0)="Provider, Transferring To Provider, Transferring User & Transfer Date/Time"
^XWB(8994,4541,1,3,0)="and will create an entry in the ORDER TRANSFERS Multiple which holds"
^XWB(8994,4541,1,4,0)="the four Transfer related fields just mentioned."
^XWB(8994,4541,1,5,0)=" "
^XWB(8994,4541,1,6,0)="It should return a list of Order IENs with a 0 for Unsuccessful or a 1 for"
^XWB(8994,4541,1,7,0)="Successful.  If 0, then an Error Message will be returned also."
^XWB(8994,4541,2,0)="^8994.02A^1^1"
^XWB(8994,4541,2,1,0)="LST^2^^1^1"
^XWB(8994,4541,2,1,1,0)="^^2^2^3180117^"
^XWB(8994,4541,2,1,1,1,0)="This is the list of Order IENs, Transferring From Providers, Transferring"
^XWB(8994,4541,2,1,1,2,0)="To Providers, Transferring Users and Transfer Date/Times."
^XWB(8994,4541,2,"B","LST",1)=""
^XWB(8994,4541,2,"PARAMSEQ",1,1)=""
^XWB(8994,4541,3,0)="^^3^3^3180117^"
^XWB(8994,4541,3,1,0)="This returns a list of Order IENs, Success or Failure Flag & optionally"
^XWB(8994,4541,3,2,0)="Error Message, e.g.:"
^XWB(8994,4541,3,3,0)="  ^TMP(""ORORDRTN"",$J)=<Order IEN>^1 or 0^Error Message (optionally)"
^XWB(8994,4542,0)="ORQ3 XFER HISTORY^HISTORY^ORQ3^2^S"
^XWB(8994,4542,1,0)="^^4^4^3190819^"
^XWB(8994,4542,1,1,0)="The purpose of this remote procedure call is to return the transfer "
^XWB(8994,4542,1,2,0)="history for the specified order This is related to the Provider Role Tool "
^XWB(8994,4542,1,3,0)="and the transfer of an order (for future alert purposes) from one "
^XWB(8994,4542,1,4,0)="provider to another."
^XWB(8994,4542,2,0)="^8994.02A^1^1"
^XWB(8994,4542,2,1,0)="ORIEN^4^40^1^1"
^XWB(8994,4542,2,1,1,0)="^^1^1^3190819^"
^XWB(8994,4542,2,1,1,1,0)="This is the internal entry number of the order from the ORDER file (#100)"
^XWB(8994,4542,2,"B","ORIEN",1)=""
^XWB(8994,4542,2,"PARAMSEQ",1,1)=""
^XWB(8994,4542,3,0)="^^11^11^3190819^"
^XWB(8994,4542,3,1,0)="The return value for this RPC will be:"
^XWB(8994,4542,3,2,0)="RESULTS(counter) = FROM ^ TO"
^XWB(8994,4542,3,3,0)=" "
^XWB(8994,4542,3,4,0)="Where counter is just a number wheel from 1 to the number of transfers on "
^XWB(8994,4542,3,5,0)="file for this order."
^XWB(8994,4542,3,6,0)=" "
^XWB(8994,4542,3,7,0)="FROM is the internal entry number from the NEW PERSON file (#200) of the"
^XWB(8994,4542,3,8,0)="provider being transferred from."
^XWB(8994,4542,3,9,0)=" "
^XWB(8994,4542,3,10,0)="TO is the interal entry number from the NEW PERSON file (#200) of the "
^XWB(8994,4542,3,11,0)="provider being transferred to."
^XWB(8994,4543,0)="ORQ3 LOADALL^LOADALL^ORQ3^2"
^XWB(8994,4543,1,0)="^^2^2^3190823^"
^XWB(8994,4543,1,1,0)="This RPC returns the sizing related to the PRT GUI chart parameters "
^XWB(8994,4543,1,2,0)=" for the user."
^XWB(8994,4544,0)="ORQ3 SAVEALL^SAVEALL^ORQ3^1"
^XWB(8994,4544,1,0)="^8994.01^2^2^3190823^"
^XWB(8994,4544,1,1,0)=" This RPC saves the sizing related PRT GUI chart parameters for the"
^XWB(8994,4544,1,2,0)=" user."
^XWB(8994,4545,0)="ORQ3 AUDIT^AUDIT^ORQ3^4^R^^^1"
^XWB(8994,4545,1,0)="^^2^2^3200207^"
^XWB(8994,4545,1,1,0)="The purpose of this Remote Procedure Call (RPC) is to return all the "
^XWB(8994,4545,1,2,0)="transfers that were performed during a specified date range."
^XWB(8994,4545,2,0)="^8994.02A^2^2"
^XWB(8994,4545,2,1,0)="ORAUST^1^15^1^1"
^XWB(8994,4545,2,1,1,0)="^^3^3^3200207^"
^XWB(8994,4545,2,1,1,1,0)="This is the starting date for the search. The search is based on the "
^XWB(8994,4545,2,1,1,2,0)="ENTRY DATE/TIME field (.05) from the ORDER TRANSFERS multiple field (#70) "
^XWB(8994,4545,2,1,1,3,0)="from the ORDER file (#100)."
^XWB(8994,4545,2,2,0)="ORAUEN^1^15^1^2"
^XWB(8994,4545,2,2,1,0)="^^3^3^3200207^"
^XWB(8994,4545,2,2,1,1,0)="This is the ending date for the search. The search is based on the ENTRY"
^XWB(8994,4545,2,2,1,2,0)="DATE/TIME field (.05) from the ORDER TRANSFERS multiple field (#70) from"
^XWB(8994,4545,2,2,1,3,0)="the ORDER file (#100)."
^XWB(8994,4545,2,"B","ORAUEN",2)=""
^XWB(8994,4545,2,"B","ORAUST",1)=""
^XWB(8994,4545,2,"PARAMSEQ",1,1)=""
^XWB(8994,4545,2,"PARAMSEQ",2,2)=""
^XWB(8994,4545,3,0)="^^5^5^3200207^"
^XWB(8994,4545,3,1,0)="The data will be returned in a global array in the following format:"
^XWB(8994,4545,3,2,0)=" "
^XWB(8994,4545,3,3,0)="Patient Name ^ ORDER IEN ^ Date/Time Ordered ^ Order Status (External"
^XWB(8994,4545,3,4,0)="Format) ^ Transfer Effective Date/Time ^ Transferred From Provider ^ "
^XWB(8994,4545,3,5,0)="Transferred To Provider ^ User who performed Transfer ^ Entry Date/Time"
^XWB(8994,4546,0)="XUS MVI NEW PERSON RMTE AUDIT^AUDIT^XURNPAUD^4^A^^^1^1^^1"
^XWB(8994,4546,1,0)="^^3^3^3210429^"
^XWB(8994,4546,1,1,0)="This restricted RPC is used exclusively by the Master Veteran Index (MVI)"
^XWB(8994,4546,1,2,0)="to return audit data from the AUDIT (#1.1) file at a facility for a "
^XWB(8994,4546,1,3,0)="specific user's record in the NEW PERSON (#200) file."
^XWB(8994,4546,2,0)="^8994.02A^1^1"
^XWB(8994,4546,2,1,0)="PARAM^2^^1^1"
^XWB(8994,4546,2,1,1,0)="^^16^16^3210429^"
^XWB(8994,4546,2,1,1,1,0)=" Required input:"
^XWB(8994,4546,2,1,1,2,0)=" --------------                     "
^XWB(8994,4546,2,1,1,3,0)="   PARAM(""SourceSystemID"") = Facility Station Number"
^XWB(8994,4546,2,1,1,4,0)="   PARAM(""SourceID"")       = Source ID (DUZ)"
^XWB(8994,4546,2,1,1,5,0)="  "
^XWB(8994,4546,2,1,1,6,0)=" Optional input:"
^XWB(8994,4546,2,1,1,7,0)=" --------------"
^XWB(8994,4546,2,1,1,8,0)="   PARAM(""IDTYPE"")         = Source ID Type (e.g., ""PN"")"
^XWB(8994,4546,2,1,1,9,0)="   PARAM(""ASSIGNAUTH"")     = Assigning Authority (e.g., ""USDVA"") "
^XWB(8994,4546,2,1,1,10,0)="   PARAM(""BegDate"") = The earliest recorded date of the audit records to"
^XWB(8994,4546,2,1,1,11,0)="                      return. Must contain a year, month, and day. "
^XWB(8994,4546,2,1,1,12,0)="                      (Defaults to the date of the first audit record.)"
^XWB(8994,4546,2,1,1,13,0)="  "
^XWB(8994,4546,2,1,1,14,0)="   PARAM(""EndDate"") = The latest recorded date of the audit records to "
^XWB(8994,4546,2,1,1,15,0)="                      return. Must contain a year, month, and day. "
^XWB(8994,4546,2,1,1,16,0)="                      (Defaults to the date of the last audit record.)"
^XWB(8994,4546,2,"B","PARAM",1)=""
^XWB(8994,4546,2,"PARAMSEQ",1,1)=""
^XWB(8994,4546,3,0)="^^67^67^3210429^"
^XWB(8994,4546,3,1,0)=" First Line"
^XWB(8994,4546,3,2,0)=" ----------"
^XWB(8994,4546,3,3,0)=" The first line returned contains basic information, including the data "
^XWB(8994,4546,3,4,0)=" that was passed to the remote procedure:"
^XWB(8994,4546,3,5,0)="  "
^XWB(8994,4546,3,6,0)="   @Return@(0) =  1^<SourceSystemID>^<SourceID>^<IDType>"
^XWB(8994,4546,3,7,0)="                  ^<AssigningAuthority>^<AuditBegDate>^<AuditEndDate>"
^XWB(8994,4546,3,8,0)="                  ^<TotalAuditRecordsReturned>"
^XWB(8994,4546,3,9,0)="  "
^XWB(8994,4546,3,10,0)=" where,"
^XWB(8994,4546,3,11,0)="  "
^XWB(8994,4546,3,12,0)="   <SourceSystemID>     = The Facility Station Number passed in "
^XWB(8994,4546,3,13,0)="                          PARAM(""SourceSystemID"")."
^XWB(8994,4546,3,14,0)="   <SourceID>           = The Source ID passed in PARAM(""SourceID"")."
^XWB(8994,4546,3,15,0)="   <IDType>             = The Source ID Type if passed in PARAM(""IDTYPE"")."
^XWB(8994,4546,3,16,0)="   <AssigningAuthority> = The Assigning Authority if passed in "
^XWB(8994,4546,3,17,0)="                          PARAM(""ASSIGNAUTH"")."
^XWB(8994,4546,3,18,0)="   <AuditBegDate>       = The earliest recorded date passed in"
^XWB(8994,4546,3,19,0)="                          PARAM(""BegDate"") in yyyymmdd format."
^XWB(8994,4546,3,20,0)="   <AuditEndDate>       = The latest recorded date passed in"
^XWB(8994,4546,3,21,0)="                          PARAM(""EndDate"") in yyyymmdd format."
^XWB(8994,4546,3,22,0)="                          "
^XWB(8994,4546,3,23,0)=" Subsequent lines      "
^XWB(8994,4546,3,24,0)=" ----------------"
^XWB(8994,4546,3,25,0)=" Each subsequent line contains data from one of the Audit records that "
^XWB(8994,4546,3,26,0)=" fall within the specified date range:"
^XWB(8994,4546,3,27,0)="  "
^XWB(8994,4546,3,28,0)="   @Return@(n) = <DateTimeRecorded>^<FieldName>"
^XWB(8994,4546,3,29,0)="                  ^<UserName>^<UserDUZ>"
^XWB(8994,4546,3,30,0)="                  ^<OldValue>^<NewValue>"
^XWB(8994,4546,3,31,0)="                  ^<MenuOptionUsed>^<ProtocolOrOptionUsed>"
^XWB(8994,4546,3,32,0)="  "
^XWB(8994,4546,3,33,0)=" where,                     "
^XWB(8994,4546,3,34,0)="                              "
^XWB(8994,4546,3,35,0)="   <DateTimeRecorded>     = The Date and Time the Audit was recorded, in"
^XWB(8994,4546,3,36,0)="                            FileMan external format MMM DD, YYYY@hh:mm:ss"
^XWB(8994,4546,3,37,0)="                            e.g., MAR 03, 2021@14:25:30"
^XWB(8994,4546,3,38,0)="   <FieldName>            = The name of the field that was changed."
^XWB(8994,4546,3,39,0)="   <UserName>             = The name of the user that made the change."
^XWB(8994,4546,3,40,0)="   <UserDUZ>              = The DUZ of the user that made the change."
^XWB(8994,4546,3,41,0)="   <OldValue>             = The old value of the field before the change."
^XWB(8994,4546,3,42,0)="                            If there was no old value, ""<no previous"
^XWB(8994,4546,3,43,0)="                            value>"" is returned."
^XWB(8994,4546,3,44,0)="   <NewValue>             = The new value of the field after the change. "
^XWB(8994,4546,3,45,0)="                            If there was no new value, ""<deleted>"" is "
^XWB(8994,4546,3,46,0)="                            returned."
^XWB(8994,4546,3,47,0)="   <MenuOptionUsed>       = The name of the Option in the Kernel menu"
^XWB(8994,4546,3,48,0)="                            system that was used to change the data (if "
^XWB(8994,4546,3,49,0)="                            any)."
^XWB(8994,4546,3,50,0)="   <ProtocolOrOptionUsed> = The name of the Protocol or the protocol-type "
^XWB(8994,4546,3,51,0)="                            Option that was used (if any)."
^XWB(8994,4546,3,52,0)="  "
^XWB(8994,4546,3,53,0)=" Error"
^XWB(8994,4546,3,54,0)=" -----"
^XWB(8994,4546,3,55,0)=" If there was some problem with the input parameters or in obtaining the "
^XWB(8994,4546,3,56,0)=" audit data, a single line is returned in the following format:"
^XWB(8994,4546,3,57,0)=" "
^XWB(8994,4546,3,58,0)="   @Return@(0) = -1^<errorMessage>"
^XWB(8994,4546,3,59,0)="  "
^XWB(8994,4546,3,60,0)=" where,"
^XWB(8994,4546,3,61,0)="  "
^XWB(8994,4546,3,62,0)="   <errorMessage> = An error message, such as:"
^XWB(8994,4546,3,63,0)="  "
^XWB(8994,4546,3,64,0)="     SourceSystemID: Facility Station Number is required"
^XWB(8994,4546,3,65,0)="     SourceID: Source ID is required"
^XWB(8994,4546,3,66,0)="     BegDate: Beginning Date is not a valid date"
^XWB(8994,4546,3,67,0)="     EndDate: Ending Date is not a valid date"
^XWB(8994,4547,0)="LHS CHECK OPTION ACCESS^OPT^LHSRPC^1^R^^^^^^1"
^XWB(8994,4547,1,0)="^^2^2^3210330^"
^XWB(8994,4547,1,1,0)="This RPC uses the Kernel supported API $$ACCESS^XQCHK to verify if a "
^XWB(8994,4547,1,2,0)="VistA user has access to an option or not."
^XWB(8994,4547,2,0)="^8994.02A^2^2"
^XWB(8994,4547,2,1,0)="USER^1^20^1^1"
^XWB(8994,4547,2,1,1,0)="^^1^1^3210330^"
^XWB(8994,4547,2,1,1,1,0)="This is the user DUZ being checked for option access."
^XWB(8994,4547,2,2,0)="OPTION^1^^1^2"
^XWB(8994,4547,2,2,1,0)="^^1^1^3210330^"
^XWB(8994,4547,2,2,1,1,0)="This is either the IEN or the NAME of an option in the OPTION file #19."
^XWB(8994,4547,2,"B","OPTION",2)=""
^XWB(8994,4547,2,"B","USER",1)=""
^XWB(8994,4547,2,"PARAMSEQ",1,1)=""
^XWB(8994,4547,2,"PARAMSEQ",2,2)=""
^XWB(8994,4547,3,0)="^^23^23^3210330^"
^XWB(8994,4547,3,1,0)="The return data is the same as the Kernel API $$ACCESS^XQCHK supported "
^XWB(8994,4547,3,2,0)="through ICR #10078."
^XWB(8994,4547,3,3,0)=" "
^XWB(8994,4547,3,4,0)="-1:no such user in the New Person File "
^XWB(8994,4547,3,5,0)="-2: User terminated or has no access code "
^XWB(8994,4547,3,6,0)="-3: no such option in the Option File "
^XWB(8994,4547,3,7,0)="0: no access found in any menu tree the user owns "
^XWB(8994,4547,3,8,0)=" "
^XWB(8994,4547,3,9,0)="    All other cases return a 4-piece string stating "
^XWB(8994,4547,3,10,0)="    access ^ menu tree IEN ^ a set of codes ^ key "
^XWB(8994,4547,3,11,0)=" "
^XWB(8994,4547,3,12,0)="O^tree^codes^key: No access because of locks (see XQCODES below) "
^XWB(8994,4547,3,13,0)="  where 'tree' is the menu where access WOULD be allowed "
^XWB(8994,4547,3,14,0)="  and 'key' is the key preventing access "
^XWB(8994,4547,3,15,0)="1^OpIEN^^: Access allowed through Primary Menu "
^XWB(8994,4547,3,16,0)="2^OpIEN^codes^: Access found in the Common Options "
^XWB(8994,4547,3,17,0)="3^OpIEN^codes^: Access found in top level of secondary option "
^XWB(8994,4547,3,18,0)="4^OpIEN^codes^: Access through a the secondary menu tree OpIEN.  "
^XWB(8994,4547,3,19,0)=" "
^XWB(8994,4547,3,20,0)="XQCODES can contain: "
^XWB(8994,4547,3,21,0)="  N=No Primary Menu in the User File (warning only) "
^XWB(8994,4547,3,22,0)="  L=Locked and the user does not have the key (forces 0 in first piece) "
^XWB(8994,4547,3,23,0)="  R=Reverse lock and user has the key (forces 0 in first piece)"
^XWB(8994,4548,0)="SDEC GET RECALLRMV BY DFN JSON^RECGETONERMVJSON^SDEC52CRMVJSON^2^R^0"
^XWB(8994,4548,1,0)="^8994.01^2^2^3210625^^^"
^XWB(8994,4548,1,1,0)="Get LATEST single entry from RECALL REMINDERS REMOVED File #403.56 in "
^XWB(8994,4548,1,2,0)="JSON for a given patient."
^XWB(8994,4548,2,0)="^8994.02A^1^1"
^XWB(8994,4548,2,1,0)="DFN^1^32000^1^1"
^XWB(8994,4548,2,1,1,0)="^8994.021^2^2^3210625^^^"
^XWB(8994,4548,2,1,1,1,0)="DFN of patient associated with this RECALL REMINDER REMOVE record in file "
^XWB(8994,4548,2,1,1,2,0)="#403.56"
^XWB(8994,4548,2,"B","DFN",1)=""
^XWB(8994,4548,2,"PARAMSEQ",1,1)=""
^XWB(8994,4548,3,0)="^8994.03^2^2^3220323^^^^"
^XWB(8994,4548,3,1,0)="JSON array of the associated RECALL REMINDER (REQUEST) that was "
^XWB(8994,4548,3,2,0)="previously removed."
^XWB(8994,4550,0)="IBTAS 277STAT^POST^IBCE277S^2^R^0^^^1^^1"
^XWB(8994,4550,2,0)="^8994.02A^1^1"
^XWB(8994,4550,2,1,0)="ARG^2"
^XWB(8994,4550,2,"B","ARG",1)=""
^XWB(8994,4551,0)="IBTAS 837 FHIR ENABLE^PUT^IBCE837S^2^R^0^^^1^^1"
^XWB(8994,4551,2,0)="^8994.02A^1^1"
^XWB(8994,4551,2,1,0)="ARG^2^^1"
^XWB(8994,4551,2,"B","ARG",1)=""
^XWB(8994,4552,0)="IBTAS 837 TEST CLAIMS^GET^IBCE837T^2^R^0^^^1^^1"
^XWB(8994,4552,2,0)="^8994.02A^1^1"
^XWB(8994,4552,2,1,0)="ARG^2^^1"
^XWB(8994,4552,2,"B","ARG",1)=""
^XWB(8994,4553,0)="SDES GET INSURANCE VERIFY REQ^INSURVERIFYREQ^SDES^2^R^^^^^^1"
^XWB(8994,4553,1,0)="^^3^3^3250206^"
^XWB(8994,4553,1,1,0)="DETERMINE IF A PATIENT'S INSURANCE NEEDS VERIFIED."
^XWB(8994,4553,1,2,0)=" "
^XWB(8994,4553,1,3,0)="Can only be invoked by Acheron"
^XWB(8994,4553,2,0)="^8994.02A^2^2"
^XWB(8994,4553,2,1,0)="DFN^1^30^1^1"
^XWB(8994,4553,2,1,1,0)="^8994.021^1^1^3210728^^^"
^XWB(8994,4553,2,1,1,1,0)="PATIENT DFN FROM PATIENT FILE (#2)"
^XWB(8994,4553,2,2,0)="EASTRCKNGNMBR^1^40^0^2"
^XWB(8994,4553,2,2,1,0)="^8994.021^2^2^3250206^^"
^XWB(8994,4553,2,2,1,1,0)="Enterprise Appointment Scheduling (EAS) Tracking Number associated to an"
^XWB(8994,4553,2,2,1,2,0)="appointment."
^XWB(8994,4553,2,"B","DFN",1)=""
