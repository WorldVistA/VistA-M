^XWB(8994,4216,3,0)="^^12^12^3171017^"
^XWB(8994,4216,3,1,0)="Returns an array List[n]."
^XWB(8994,4216,3,2,0)=" "
^XWB(8994,4216,3,3,0)="The format of the returned array will be as follows:"
^XWB(8994,4216,3,4,0)="  List[n] = p1^p2^p3"
^XWB(8994,4216,3,5,0)=" "
^XWB(8994,4216,3,6,0)="    p1 = Enrollment Clinic"
^XWB(8994,4216,3,7,0)="    p2 = Date of Enrollment"
^XWB(8994,4216,3,8,0)="    p3 = Outpatient or Ambulatory Care (OPT or AC)"
^XWB(8994,4216,3,9,0)=" "
^XWB(8994,4216,3,10,0)="If nothing is found, the return will be List[n] = 0^NOTHING TO REPORT."
^XWB(8994,4216,3,11,0)=" "
^XWB(8994,4216,3,12,0)="If an error occurs, the return will be List[n] = -1^message."
