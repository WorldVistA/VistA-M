^XWB(8994,3288,2,"PARAMSEQ",2,2)=""
^XWB(8994,3288,2,"PARAMSEQ",3,3)=""
^XWB(8994,3288,3,0)="^8994.03^2^2^3151129^^^^"
^XWB(8994,3288,3,1,0)="Returns n < 0`errmsg, or 0`## lines returned, where each line is a"
^XWB(8994,3288,3,2,0)="""|""-delimited list of work item fields."
