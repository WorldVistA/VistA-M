^XWB(8994,1138,2,0)="^8994.02A^1^1"
^XWB(8994,1138,2,1,0)="DATA^1^30^1"
^XWB(8994,1138,2,1,1,0)="^^1^1^3000216^"
^XWB(8994,1138,2,1,1,1,0)="This is the pointer to the Radiology report file."
^XWB(8994,1138,2,"B","DATA",1)=""
^XWB(8994,1138,3,0)="^^2^2^3000216^"
^XWB(8994,1138,3,1,0)="Text of the exam report is returned in a global array.  A header line is"
^XWB(8994,1138,3,2,0)="inserted at the top, to be used for labeling the report display window."
^XWB(8994,1139,0)="MAGJ PT INFO^PINF1^MAGJUTL3^1^R"
^XWB(8994,1139,1,0)="^8994.01^16^16^3020703^^^"
^XWB(8994,1139,1,1,0)=" +---------------------------------------------------------------+"
^XWB(8994,1139,1,2,0)=" | Property of the US Government.                                |"
^XWB(8994,1139,1,3,0)=" | No permission to copy or redistribute this software is given. |"
^XWB(8994,1139,1,4,0)=" | Use of unreleased versions of this software requires the user |"
^XWB(8994,1139,1,5,0)=" | to execute a written test agreement with the VistA Imaging    |"
^XWB(8994,1139,1,6,0)=" | Development Office of the Department of Veterans Affairs,     |"
^XWB(8994,1139,1,7,0)=" | telephone (301) 734-0100.                                     |"
^XWB(8994,1139,1,8,0)=" |                                                               |"
^XWB(8994,1139,1,9,0)=" | The Food and Drug Administration classifies this software as  |"
^XWB(8994,1139,1,10,0)=" | a medical device.  As such, it may not be changed in any way. |"
^XWB(8994,1139,1,11,0)=" | Modifications to this software may result in an adulterated   |"
^XWB(8994,1139,1,12,0)=" | medical device under 21CFR820, the use of which is considered |"
^XWB(8994,1139,1,13,0)=" | to be a violation of US Federal Statutes.                     |"
^XWB(8994,1139,1,14,0)=" +---------------------------------------------------------------+"
^XWB(8994,1139,1,15,0)=" "
^XWB(8994,1139,1,16,0)="Returns Patient data for the DFN input."
^XWB(8994,1139,2,0)="^8994.02A^1^1"
^XWB(8994,1139,2,1,0)="MAGDFN^1^30^1^1"
^XWB(8994,1139,2,1,1,0)="^8994.021^1^1^3020703^^^"
^XWB(8994,1139,2,1,1,1,0)="Patient DFN"
^XWB(8994,1139,2,"B","MAGDFN",1)=""
^XWB(8994,1139,2,"PARAMSEQ",1,1)=""
^XWB(8994,1139,3,0)="^8994.03^10^10^3020703^^"
^XWB(8994,1139,3,1,0)=" "
^XWB(8994,1139,3,2,0)="Returns an '^' delimited string of patient info in the format :"
^XWB(8994,1139,3,3,0)="        Field   Field Description"
^XWB(8994,1139,3,4,0)=" $p(1)  .01      name"
^XWB(8994,1139,3,5,0)=" $p(2)  .02      sex"
^XWB(8994,1139,3,6,0)=" $p(3)  .03      DOB"
^XWB(8994,1139,3,7,0)=" $p(4)  .09      SSN"
^XWB(8994,1139,3,8,0)=" $p(5)  .301    S/C"
^XWB(8994,1139,3,9,0)=" $p(6)  391     TYPE"
^XWB(8994,1139,3,10,0)=" $p(7)  1901   Veteran(y/n)"
^XWB(8994,1140,0)="EC SPACEBAR^ECDEF^ECUERPC1^1^R^^^1"
^XWB(8994,1140,1,0)="^8994.01^2^2^3020305^^"
^XWB(8994,1140,1,1,0)="This RPC would return the value equivalent to when the 'Spacebar and Return' "
^XWB(8994,1140,1,2,0)="keys are entering in the VISTA package."
^XWB(8994,1140,2,0)="^8994.02A^1^1"
^XWB(8994,1140,2,1,0)="ECARY^1^^1"
^XWB(8994,1140,2,1,1,0)="^8994.021^2^2^3020305^^"
^XWB(8994,1140,2,1,1,1,0)="The input variable ECARY contains the value of the file to obtain the VISTA "
^XWB(8994,1140,2,1,1,2,0)="equivalent of 'spacebar return'."
^XWB(8994,1140,2,"B","ECARY",1)=""
^XWB(8994,1140,3,0)="^8994.03^1^1^3020305^^"
^XWB(8994,1140,3,1,0)="The RESULTS variable contains the IEN and the .01 field description."
^XWB(8994,1141,0)="ORBCMA5 GETUD^GETUD^ORBCMA5^1"
^XWB(8994,1142,0)="ORBCMA5 GETUDID^GETUDID^ORBCMA5^1"
^XWB(8994,1143,0)="ORBCMA5 GETIVID^GETIVID^ORBCMA5^1"
^XWB(8994,1144,0)="ORBCMA5 ODITMBC^ODITMBC^ORBCMA5^2^^^^1"
^XWB(8994,1145,0)="ORWUBCMA USERINFO^USERINFO^ORWUBCMA^1"
^XWB(8994,1145,2,0)="^8994.02A^1^1"
^XWB(8994,1145,2,1,0)="ORWDPS5"
^XWB(8994,1145,2,"B","ORWDPS5",1)=""
^XWB(8994,1146,0)="ORBCMA32 DLGSLCT^DLGSLCT^ORBCMA32^2"
^XWB(8994,1147,0)="ORBCMA1 ODSLCT^ODSLCT^ORBCMA1^2"
^XWB(8994,1148,0)="ORBCMA1 CHK94^CHK94^ORBCMA1^1"
^XWB(8994,1149,0)="ORBCMA1 FAILDEA^FAILDEA^ORBCMA1^1"
^XWB(8994,1150,0)="ORBCMA1 FORMALT^FORMALT^ORBCMA1^2^^^^1"
^XWB(8994,1151,0)="ORBCMA1 DOSEALT^DOSEALT^ORBCMA1^2^^^^1"
^XWB(8994,1151,2,0)="^8994.02A^^0"
^XWB(8994,1152,0)="ORBCMA1 SCHALL^SCHALL^ORBCMA1^2^^^^1"
^XWB(8994,1153,0)="ORBCMA32 AUTH^AUTH^ORBCMA32^1"
^XWB(8994,1154,0)="ORBCMA32 DRUGMSG^DRUGMSG^ORBCMA32^1^^^^1"
^XWB(8994,1154,2,0)="^8994.02A^1^1"
^XWB(8994,1154,2,1,0)="BOWDPS32 FORMALT"
^XWB(8994,1154,2,"B","BOWDPS32 FORMALT",1)=""
^XWB(8994,1155,0)="ORBCMA32 FORMALT^FORMALT^ORBCMA32^2^^^^1"
^XWB(8994,1156,0)="ORBCMA32 VALROUTE^VALROUTE^ORBCMA32^1^^^^1"
^XWB(8994,1157,0)="ORBCMA32 ISSPLY^ISSPLY^ORBCMA32^1^^^^1"
^XWB(8994,1158,0)="ORBCMA32 IVAMT^IVAMT^ORBCMA32^1^^^^1"
^XWB(8994,1159,0)="ORBCMA32 VALRATE^VALRATE^ORBCMA32^1^^^^1"
^XWB(8994,1160,0)="ORBCMA32 VALSCH^VALSCH^ORBCMA32^1^^^^1"
^XWB(8994,1161,0)="EC DIEDON^ECDOD^ECUERPC2^1^R^^^1"
^XWB(8994,1161,1,0)="^^1^1^3020424^"
^XWB(8994,1161,1,1,0)="This RPC returns a patient's date of death."
^XWB(8994,1161,2,0)="^8994.02A^1^1"
^XWB(8994,1161,2,1,0)="ECARY^1^^1"
^XWB(8994,1161,2,1,1,0)="^^1^1^3020424^"
^XWB(8994,1161,2,1,1,1,0)="The input variable ECARY contains the patient's DFN."
^XWB(8994,1161,2,"B","ECARY",1)=""
^XWB(8994,1161,3,0)="^^4^4^3020424^"
^XWB(8994,1161,3,1,0)="The RPC returns either of the following pieces of data as output."
^XWB(8994,1161,3,2,0)=" 1. 0^Patient DFN is not defined"
^XWB(8994,1161,3,3,0)=" 2. DOD internal fileman format^message when patient died"
^XWB(8994,1161,3,4,0)=" 3. ^ [if patient is not dead]"
^XWB(8994,1162,0)="ORQPT MAKE RPL^RPLMAKE^ORQPTQ11^1^S"
^XWB(8994,1162,1,0)="^8994.01^2^2^3011126^^^^"
^XWB(8994,1162,1,1,0)="Passes Team List IEN, creates a TMP file entry of patients based thereon, "
^XWB(8994,1162,1,2,0)="and receives a $J job number in return."
^XWB(8994,1162,2,0)="^8994.02A^^0"
^XWB(8994,1162,3,0)="^8994.03^2^2^3011126^^^^"
^XWB(8994,1162,3,1,0)="Job Number ($J) to assist in subsequent reading of TMP global that was "
^XWB(8994,1162,3,2,0)="created."
^XWB(8994,1163,0)="ORQPT READ RPL^RPLREAD^ORQPTQ11^2^^^^"
^XWB(8994,1163,1,0)="^8994.01^3^3^3011129^^^^"
^XWB(8994,1163,1,1,0)="Passes global reference and other parameters, and receives a list of "
^XWB(8994,1163,1,2,0)="patients (up to 44 maximum) with IENs, for use in scrolling a Long List "
^XWB(8994,1163,1,3,0)="Box (LLB) componenet."
^XWB(8994,1163,2,0)="^8994.02A^^0"
^XWB(8994,1163,3,0)="^8994.03^2^2^3011129^^^^"
^XWB(8994,1163,3,1,0)="Array of patients with their IENs for populating Long List Box (LLB) "
^XWB(8994,1163,3,2,0)="component."
^XWB(8994,1164,0)="ORQPT KILL RPL^RPLCLEAN^ORQPTQ11^1^S"
^XWB(8994,1164,1,0)="^8994.01^3^3^3011126^^^^"
^XWB(8994,1164,1,1,0)="This RPC is passed a ^TMP file root and $J"
^XWB(8994,1164,1,2,0)="(job number) and kills the ^TMP(""ORRPL"",$J global"
^XWB(8994,1164,1,3,0)="data based on the passed file root w/job number."
^XWB(8994,1164,2,0)="^8994.02A^^0"
^XWB(8994,1165,0)="ORWDPS1 LOCPICK^LOCPICK^ORWDPS1^1^^^^1"
^XWB(8994,1166,0)="ORWTIU GET SAVED CP FIELDS^GETCP^ORWTIU^1"
^XWB(8994,1166,1,0)="^^3^3^3060911^"
^XWB(8994,1166,1,1,0)="Given a TIU document of the clinical procedures class, return the author, "
^XWB(8994,1166,1,2,0)="title, cosigner, procedure summary code, date/time of procedure, and "
^XWB(8994,1166,1,3,0)="reference date, as stored on the server."
^XWB(8994,1166,2,0)="^8994.02A^1^1"
^XWB(8994,1166,2,1,0)="TIUDA^1^32^1"
^XWB(8994,1166,2,1,1,0)="^8994.021^1^1^3060911^^"
^XWB(8994,1166,2,1,1,1,0)="Pointer to file 8925 for the document."
^XWB(8994,1166,2,"B","TIUDA",1)=""
^XWB(8994,1166,3,0)="^^1^1^3060911^"
^XWB(8994,1166,3,1,0)="AUTHOR^COSIGNER^PROCSUMMCODE^PROCDATE^DOCTITLE^REFDATE"
^XWB(8994,1167,0)="ORWOR PKIUSE^PKIUSE^ORWOR^1"
^XWB(8994,1168,0)="ORWPT LAST5 RPL^LAST5RPL^ORWPT^2"
^XWB(8994,1168,1,0)="^^2^2^3020325^"
^XWB(8994,1168,1,1,0)="Returns a list of patients matching the string of Last Name Initial_Last "
^XWB(8994,1168,1,2,0)="4 SSN (Initial/Last 4 look-up based on Restricted Patient List)."
^XWB(8994,1169,0)="ORWPT FULLSSN RPL^FSSNRPL^ORWPT^2"
^XWB(8994,1169,1,0)="^^2^2^3020325^"
^XWB(8994,1169,1,1,0)="Given an SSN in the format 999999999(P), return a list of matching "
^XWB(8994,1169,1,2,0)="patients based on Restricted Patient List."
^XWB(8994,1169,2,0)="^8994.02A^1^1"
^XWB(8994,1169,2,1,0)="IEN^1^15^1"
^XWB(8994,1169,2,1,1,0)="^^1^1^3020325^"
^XWB(8994,1169,2,1,1,1,0)="SSN in the format '999999999(P)'."
^XWB(8994,1169,2,"B","IEN",1)=""
^XWB(8994,1170,0)="ORWOR1 CHKDIG^CHKDIG^ORWOR1^1"
^XWB(8994,1170,1,0)="^8994.01^1^1^3020403^^"
^XWB(8994,1170,1,1,0)="Returns true if an order requires a digital signature."
^XWB(8994,1171,0)="ORWOR1 GETDTEXT^GETDTEXT^ORWOR1^2"
^XWB(8994,1171,1,0)="^8994.01^1^1^3020403^^^"
^XWB(8994,1171,1,1,0)="Returns the external text of an existing order."
^XWB(8994,1172,0)="ORWOR1 GETDSIG^GETDSIG^ORWOR1^1"
^XWB(8994,1172,1,0)="^8994.01^1^1^3020403^^^^"
^XWB(8994,1172,1,1,0)="Returns the digital signature of an existing order."
^XWB(8994,1173,0)="ORWOR1 SIG^SIG^ORWOR1^1"
^XWB(8994,1173,1,0)="^8994.01^1^1^3020404^^^^"
^XWB(8994,1173,1,1,0)="Returns 1 if signature gets stored."
^XWB(8994,1174,0)="ORWCIRN RESTRICT^RESTRICT^ORWCIRN^2"
^XWB(8994,1174,1,0)="^^1^1^3020418^"
^XWB(8994,1174,1,1,0)="This RPC checks for sensitive patients on a remote system."
^XWB(8994,1174,2,0)="^8994.02A^1^1"
^XWB(8994,1174,2,1,0)="PATID^1^^1^1"
^XWB(8994,1174,2,1,1,0)="^^1^1^3020418^"
^XWB(8994,1174,2,1,1,1,0)="PATID = DFN;ICN"
^XWB(8994,1174,2,"B","PATID",1)=""
^XWB(8994,1174,2,"PARAMSEQ",1,1)=""
^XWB(8994,1175,0)="ORWTPD GETIMG^GETIMG^ORWTPD^1^^^^1"
^XWB(8994,1176,0)="PSB GETORDERTAB^RPC^PSBVDLTB^4^P^^^1^3"
^XWB(8994,1176,1,0)="^8994.01^1^1^3180815^^^^"
^XWB(8994,1176,1,1,0)="Gives the client VDL information for the specified patient and time frame."
^XWB(8994,1176,2,0)="^8994.02A^5^5"
^XWB(8994,1176,2,1,0)="DFN^1^30^1^1"
^XWB(8994,1176,2,1,1,0)="^8994.021^1^1^3070712^^^^"
^XWB(8994,1176,2,1,1,1,0)="The patient IEN from ^DPT."
^XWB(8994,1176,2,2,0)="VDL TAB^1^30^1^2"
^XWB(8994,1176,2,2,1,0)="^8994.021^1^1^3070712^^^"
^XWB(8994,1176,2,2,1,1,0)="The tab from the VDL that is being requested."
^XWB(8994,1176,2,3,0)="VDL DATE^1^30^0^3"
^XWB(8994,1176,2,3,1,0)="^8994.021^2^2^3111020^^^^"
^XWB(8994,1176,2,3,1,1,0)="The date of the requested data.  If not passed then current date/time are"
^XWB(8994,1176,2,3,1,2,0)="used."
^XWB(8994,1176,2,4,0)="PSBSIOPI^1^1^0^4"
^XWB(8994,1176,2,4,1,0)="^8994.021^5^5^3120425^^"
^XWB(8994,1176,2,4,1,1,0)=" This parameter is a true/false flag (1/0).  If true use the new SI/OP Wp"
^XWB(8994,1176,2,4,1,2,0)=" fields and return data in the Results array to the GUI Client."
^XWB(8994,1176,2,4,1,3,0)="  "
^XWB(8994,1176,2,4,1,4,0)=" The field is not required, so a null will convert into a 0, for false,"
^XWB(8994,1176,2,4,1,5,0)=" making this backwards compatible."
^XWB(8994,1176,2,5,0)="PSBCLINORD^1^1^0^5"
^XWB(8994,1176,2,5,1,0)="^8994.021^6^6^3180815^^^^"
^XWB(8994,1176,2,5,1,1,0)="This parameter is a True/False flag (1/0).  If true, then return only"
^XWB(8994,1176,2,5,1,2,0)="Clinic Orders and not Inpatient Medication orders to BCMA, else if false, "
^XWB(8994,1176,2,5,1,3,0)="return only Inpatient Medication orders to BCMA."
^XWB(8994,1176,2,5,1,4,0)=" "
^XWB(8994,1176,2,5,1,5,0)="The field is not required, so a null will convert into a 0, for a "
^XWB(8994,1176,2,5,1,6,0)="default false value, making this backwards compatible."
^XWB(8994,1176,2,"B","DFN",1)=""
^XWB(8994,1176,2,"B","PSBCLINORD",5)=""
^XWB(8994,1176,2,"B","PSBSIOPI",4)=""
^XWB(8994,1176,2,"B","VDL DATE",3)=""
^XWB(8994,1176,2,"B","VDL TAB",2)=""
^XWB(8994,1176,2,"PARAMSEQ",1,1)=""
^XWB(8994,1176,2,"PARAMSEQ",2,2)=""
^XWB(8994,1176,2,"PARAMSEQ",3,3)=""
^XWB(8994,1176,2,"PARAMSEQ",4,4)=""
^XWB(8994,1176,2,"PARAMSEQ",5,5)=""
^XWB(8994,1176,3,0)="^^120^120^3180815^"
^XWB(8994,1176,3,1,0)=" "
^XWB(8994,1176,3,2,0)="If a valid list of orders are found they are returned in a block format"
^XWB(8994,1176,3,3,0)="with the word 'END' delimiting orders/administrations.  Lines for"
^XWB(8994,1176,3,4,0)="subsequent block are numbered sequential.  They are not reset to 1 for"
^XWB(8994,1176,3,5,0)="each"
^XWB(8994,1176,3,6,0)="block."
^XWB(8994,1176,3,7,0)=" "
^XWB(8994,1176,3,8,0)=" "
^XWB(8994,1176,3,9,0)=" "
^XWB(8994,1176,3,10,0)="  Results[0] =  ^1      The number of lines returned(count)"
^XWB(8994,1176,3,11,0)=" "
^XWB(8994,1176,3,12,0)="  Results[1] =  ^1      Data for the Unit Dose tab (0=no, 1=yes)"
^XWB(8994,1176,3,13,0)="                ^2      Data for the Piggy Back tab (0=no, 1=yes)"
^XWB(8994,1176,3,14,0)="                ^3      Data for the IV tab (0=no, 1=yes)"
^XWB(8994,1176,3,15,0)="                ^4      Transfer type if there was a patient movement"
^XWB(8994,1176,3,16,0)="                ^5      Movement type if there was a patient movement"
^XWB(8994,1176,3,17,0)="                ^6      Count of Inpatient Orders for this patient"
^XWB(8994,1176,3,18,0)="                ^7      Count of Clinic Orders for this patient"
^XWB(8994,1176,3,19,0)="                ^8      IV's still infusing indicator light"
^XWB(8994,1176,3,20,0)="                ^9      Patch still on indicator light "
^XWB(8994,1176,3,21,0)=" "
^XWB(8994,1176,3,22,0)="  Results[2] =  ^1      DFN"
^XWB(8994,1176,3,23,0)="                ^2      ORDER NUMBER (20V)"
^XWB(8994,1176,3,24,0)="                ^3      NUMERIC PORTION OF ORDER NUMBER (20)"
^XWB(8994,1176,3,25,0)="                ^4      ALPHA PORTION OF ORDER NUMBER (V)"
^XWB(8994,1176,3,26,0)="                ^5      SCHEDULE TYPE (prn/continuous)"
^XWB(8994,1176,3,27,0)="                ^6      SCHEDULE (Q4H)"
^XWB(8994,1176,3,28,0)="                ^7      SELF MED (SM or HSM)"
^XWB(8994,1176,3,29,0)="                ^8      DRUG NAME"
^XWB(8994,1176,3,30,0)="                ^9      DOSAGE/FLOW RATE"
^XWB(8994,1176,3,31,0)="                ^10     MED ROUTE"
^XWB(8994,1176,3,32,0)="                ^11     LAST ACTION DATE/TIME (FM format)"
^XWB(8994,1176,3,33,0)="                ^12     MED LOG IEN (blank if no action)"
^XWB(8994,1176,3,34,0)="                ^13     LAST ACTION STATUS (this entry)"
^XWB(8994,1176,3,35,0)="                ^14     SCHEDULED ADMIN DATE/TIME"
^XWB(8994,1176,3,36,0)="                ^15     ORDERABLE ITEM IEN (^ORD(101.43)"
^XWB(8994,1176,3,37,0)="                ^16     INJECTABLE (0=no, 1=yes)"
^XWB(8994,1176,3,38,0)="                ^17     VARIABLE DOSE (0=no, 1=yes)"
^XWB(8994,1176,3,39,0)="                ^18     DOSEAGE FORM"
^XWB(8994,1176,3,40,0)="                ^19     VERIFYING NURSE INITIALS (*** if none)"
^XWB(8994,1176,3,41,0)="                ^20     LAST ACTION STATUS (whole order)"
^XWB(8994,1176,3,42,0)="                ^21     ORDER START DATE/TIME (FM)"
^XWB(8994,1176,3,43,0)="                ^22     ORDER STATUS"
^XWB(8994,1176,3,44,0)="                ^23     UNIQUE ID OF BAG"
^XWB(8994,1176,3,45,0)="                ^24     NURSES IEN"
^XWB(8994,1176,3,46,0)="                ^25     TRANSACTION TYPE"
^XWB(8994,1176,3,47,0)="                ^26     ORDER STOP DATE (FM)"
^XWB(8994,1176,3,48,0)="                ^27     LAST ""GIVEN"" DATE (FM)"
^XWB(8994,1176,3,49,0)="                ^28     GIVEN PATCH (1=yes)"
^XWB(8994,1176,3,50,0)="                ^29     OVERRIDE/INTERVENTION REASONS EXIST (0=No;1=Yes)"
^XWB(8994,1176,3,51,0)="                ^30     LAST INJECTION SITE TEXT (per Orderable Item)"
^XWB(8994,1176,3,52,0)="                ^31     PIGGYBACK TAB- ROTATION TYPE IV ORDER INJECTABLE "
