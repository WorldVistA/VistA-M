^XWB(8994,4411,3,15,0)=" "
^XWB(8994,4411,3,16,0)="  Or Error condition:  "
^XWB(8994,4411,3,17,0)="     ORY - ""-1^Error Msg"""
^XWB(8994,4411,3,18,0)="     ORY(-1)=Error Message"
^XWB(8994,4412,0)="ORWTIU SVPASTE^SVPASTE^ORWTIU^2"
^XWB(8994,4412,1,0)="^8994.01^1^1^3160317^^^^"
^XWB(8994,4412,1,1,0)="Saves pasted text to the copy/paste tracking paste file."
