^XWB(8994,3922,3,0)="^^12^12^3130109^"
^XWB(8994,3922,3,1,0)="Returns a list of default procurement sources for the item, in format:"
^XWB(8994,3922,3,2,0)=" "
^XWB(8994,3922,3,3,0)="RET(n)=Procurement Source^Unit of Recepit^Unit of Recepit Package Mult"
^XWB(8994,3922,3,4,0)=" "
^XWB(8994,3922,3,5,0)="Where each ^-delimited piece consists of the data element's external and "
