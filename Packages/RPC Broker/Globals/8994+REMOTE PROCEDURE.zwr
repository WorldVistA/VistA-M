^XWB(8994,2859,2,"B","TYPE",1)=""
^XWB(8994,2859,3,0)="^8994.03^7^7^3100622^^^^"
^XWB(8994,2859,3,1,0)="List of network locations with properties"
^XWB(8994,2859,3,2,0)=" "
^XWB(8994,2859,3,3,0)="ien^\\server\share\^storage type^operational status^uname^password^muse site"
^XWB(8994,2859,3,4,0)="#^Site^PLACE^Name"
^XWB(8994,2859,3,5,0)=" "
^XWB(8994,2859,3,6,0)="This Remote ProcedureCall will list each Online/Offline, even with"
