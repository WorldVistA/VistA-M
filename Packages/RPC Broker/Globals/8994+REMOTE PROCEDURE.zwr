^XWB(8994,2425,0)="DSIR GET SELECTION ITEMS^GETSELS^DSIROIAH^2"
^XWB(8994,2425,1,0)="^8994.01^2^2^3070627^^^^"
^XWB(8994,2425,1,1,0)="THIS ROUTINE PROVIDES THE DATA FOR POPULATING ALL THE DROP DOWN COMBO AND"
^XWB(8994,2425,1,2,0)="LIST BOXES WITH FIELD NAMES FOR THE AD HOC REPORTING SCREEN"
^XWB(8994,2425,3,0)="^^9^9^3070627^"
^XWB(8994,2425,3,1,0)=" ARRAY:"
^XWB(8994,2425,3,2,0)="  IEN^FIELD NAME^X1^X2^X3^X4^X5^X6"
^XWB(8994,2425,3,3,0)="   WHERE X1=INCLUDE IN SELECT LISTS (Y/N)"
^XWB(8994,2425,3,4,0)="         X2=INCLUDE IN DATE LISTS (Y/N)"
^XWB(8994,2425,3,5,0)="         X3=INCLUDE IN PRINT FIELD LIST (Y/N)"
^XWB(8994,2425,3,6,0)="         X4=INCLUDE IN SORT BY LISTS (Y/N)"
^XWB(8994,2425,3,7,0)="         X5=SORT RANKING (0-999 LOWEST IS PRIORITY)"
^XWB(8994,2425,3,8,0)="         X6=IS DATE (Y/N)"
^XWB(8994,2425,3,9,0)="  -1 ^ UNABLE TO BUILD LISTMissing Provider Pointer!"
^XWB(8994,2426,0)="DSIR GET AD HOC REPORT^GETRPT^DSIROIAH^2"
^XWB(8994,2426,1,0)="^8994.01^1^1^3070608^^^^"
^XWB(8994,2426,1,1,0)="Returns all of the definition parameters for a selected report. "
^XWB(8994,2426,2,0)="^8994.02A^1^1"
^XWB(8994,2426,2,1,0)="RPT^1^30^1"
^XWB(8994,2426,2,1,1,0)="^8994.021^1^1^3070608^^"
^XWB(8994,2426,2,1,1,1,0)="THIS IS REPORT IEN YOU WANT TO RETRIEVE."
^XWB(8994,2426,2,"B","RPT",1)=""
^XWB(8994,2426,3,0)="^^40^40^3070608^"
^XWB(8994,2426,3,1,0)=" ;Return Value"
^XWB(8994,2426,3,2,0)=" ;ARRAY:- AS FOLLOWS:"
^XWB(8994,2426,3,3,0)=" ; [1]  RPT NAME^RPT AUTHOR^RPT CREATION DATE^RPT LAST UPDATED"
^XWB(8994,2426,3,4,0)=" ; [2]  RPT SELECTION FIELD 1^RPT SELECTION VALUE 1"
^XWB(8994,2426,3,5,0)=" ; [3]  RPT SELECTION FIELD 2^RPT SELECTION VALUE 2"
^XWB(8994,2426,3,6,0)=" ; [4]  RPT SELECTION FIELD 3^RPT SELECTION VALUE 3"
^XWB(8994,2426,3,7,0)=" ; [5]  RPT DATE RANGE FIELD 1^RPT DATE RANGE FROM 1^"
^XWB(8994,2426,3,8,0)=" ;      ===>RPT DATE RANGE TO 1"
^XWB(8994,2426,3,9,0)=" ; [6]  RPT DATE RANGE FIELD 2^RPT DATE RANGE FROM 2^"
^XWB(8994,2426,3,10,0)=" ;      ===>RPT DATE RANGE TO 2"
^XWB(8994,2426,3,11,0)=" ; [7]  RPT SORT BY FIELD 1^ (#7.02) RPT SORT ASCENDING 1^"
^XWB(8994,2426,3,12,0)=" ;      ===>RPT SORT GROUP 1^"
^XWB(8994,2426,3,13,0)=" ;      ===>RPT SORT COUNT 1^RPT SORT SUM 1"
^XWB(8994,2426,3,14,0)=" ; [8]  RPT SORT BY FIELD 2^RPT SORT ASCENDING 2^RPT SORT GROUP 2^"
^XWB(8994,2426,3,15,0)=" ;      ===>RPT SORT COUNT 2 RPT SORT SUM 2"
^XWB(8994,2426,3,16,0)=" ; [9]  RPT SORT BY FIELD 3^RPT SORT ASCENDING RPT SORT GROUP 3^"
^XWB(8994,2426,3,17,0)=" ;      ===>RPT SORT COUNT 3 RPT SORT SUM 3"
^XWB(8994,2426,3,18,0)=" ; [10] RPT TITLE^RPT TITLE REPEAT^RPT TITLE FONT^RPT TITLE SIZE^"
^XWB(8994,2426,3,19,0)=" ;      ===>RPT TITLE BOLD^RPT TITLE ITALICS^RPT TITLE UNDERLN"
^XWB(8994,2426,3,20,0)=" ; [11] RPT SUB TITLE^RPT SUB TITLE REPEAT^RPT SUB TITLE FONT^"
^XWB(8994,2426,3,21,0)=" ;      ===>RPT SUB TITLE SIZE^RPT SUB TITLE BOLD^"
^XWB(8994,2426,3,22,0)=" ;      ===>RPT SUB TITLE ITALICS^RPT SUB TITLE UNDERLN "
^XWB(8994,2426,3,23,0)=" ; [12] RPT FOOTER^^RPT FOOTER FONT^RPT FOOTER SIZE^"
^XWB(8994,2426,3,24,0)=" ;      ===>RPT FOOTER BOLD^RPT FOOTER ITALICS^RPT FOOTER UNDERLN"
^XWB(8994,2426,3,25,0)=" ; [13] RPT GROUP TITLE 1^RPT GROUP TITLE REPEAT 1^"
^XWB(8994,2426,3,26,0)=" ;      ===>RPT GROUP TITLE FONT 1^RPT GROUP TITLE SIZE 1^"
^XWB(8994,2426,3,27,0)=" ;      ===>RPT GROUP TITLE BOLD 1^RPT GROUP TITLE ITALICS 1^"
^XWB(8994,2426,3,28,0)=" ;      ===>RPT GROUP TITLE UNDERLN 1"
^XWB(8994,2426,3,29,0)=" ; [14] RPT GROUP FOOTER 1^^RPT GROUP FOOTER FONT 1^"
^XWB(8994,2426,3,30,0)=" ;      ===>RPT GROUP FOOTER SIZE 1^RPT FOOTER BOLD 1^"
^XWB(8994,2426,3,31,0)=" ;      ===>RPT GROUP FOOTER ITALACS 1^RPT GROUP FOOTER UNDERLN 1"
^XWB(8994,2426,3,32,0)=" ; [15} RPT GROUP TITLE 2^RPT GROUP TITLE REPEAT 1"
^XWB(8994,2426,3,33,0)=" ; [16} RPT GROUP FOOTER 2"
^XWB(8994,2426,3,34,0)=" ; [17} RPT GROUP TITLE 3"
^XWB(8994,2426,3,35,0)=" ; [18} RPT GROUP FOOTER 3^RPT GROUP TITLE REPEAT 2"
^XWB(8994,2426,3,36,0)=" ; [19] RPT ORIENTATION"
^XWB(8994,2426,3,37,0)=" ; [20] RPT BODY^RPT BODY MULTI LINE^RPT BODY FONT^RPT BODY SIZE^"
^XWB(8994,2426,3,38,0)=" ;      ==>RPT BODY BOLD^RPT BODY ITALICS^RPT BODY UNDERLN"
^XWB(8994,2426,3,39,0)=" ;  OR"
^XWB(8994,2426,3,40,0)=" ; -1 ^ UNABLE TO GET SELECTED REPORT"
^XWB(8994,2427,0)="DSIR GET REPORT LIST^RPTLIST^DSIROIAH^2"
^XWB(8994,2427,1,0)="^^2^2^3070531^"
^XWB(8994,2427,1,1,0)="RETURNS A LIST OR REPORT NAMES AND THEIR IENS OR A SINGLE REPORT AND IT'S "
^XWB(8994,2427,1,2,0)="IEN IF A REPORT NAME IS PASSED IN THE OPTIONAL PARAMETER."
^XWB(8994,2427,2,0)="^8994.02A^1^1"
^XWB(8994,2427,2,1,0)="RNAME^1^30^0^1"
^XWB(8994,2427,2,1,1,0)="^^1^1^3070531^"
^XWB(8994,2427,2,1,1,1,0)="RNAME - (OPTIONAL) REPORT NAME FOR A SPECIFIC REPORT"
^XWB(8994,2427,2,"B","RNAME",1)=""
^XWB(8994,2427,2,"PARAMSEQ",1,1)=""
^XWB(8994,2427,3,0)="^^3^3^3070531^"
^XWB(8994,2427,3,1,0)=" ;RETURN VALUE - ARRAY"
^XWB(8994,2427,3,2,0)=" ; EACH SUBSCRIPT CONTAINS - ""IEN^REPORT_NAME"""
^XWB(8994,2427,3,3,0)=" ; OR -1^REPORT NOT FOUND  "
^XWB(8994,2428,0)="DSIR GET AD HOC DATA^RPTDATA^DSIROIA2^4^^^^1"
^XWB(8994,2428,1,0)="^8994.01^1^1^3080825^^^^"
^XWB(8994,2428,1,1,0)="GET DATA FOR AN AD HOC REPORT"
^XWB(8994,2428,2,0)="^8994.02A^1^1"
^XWB(8994,2428,2,1,0)="INARRAY^2^^1^1"
^XWB(8994,2428,2,1,1,0)="^8994.021^12^12^3070710^^"
^XWB(8994,2428,2,1,1,1,0)="Input Parameter(s) - ARRAY AS FOLLOWS:"
^XWB(8994,2428,2,1,1,2,0)=" ""F1_IEN^F2_IEN^...^Fn_IEN"
^XWB(8994,2428,2,1,1,3,0)=" FILTER/SELECTION FIELDS (OPTIONAL)"
^XWB(8994,2428,2,1,1,4,0)=" ""F1""^F1_IEN^F1_VALUE"
^XWB(8994,2428,2,1,1,5,0)=" ""F2""^F2_IEN^F1_VALUE"
^XWB(8994,2428,2,1,1,6,0)=" ""F3""^F3_IEN^F1_VALUE"
^XWB(8994,2428,2,1,1,7,0)=" DATE RANGE FIELDS (OPTIONAL)"
^XWB(8994,2428,2,1,1,8,0)=" ""R1""^R1_IEN^F1_VALUE1^F1_VALUE2"
^XWB(8994,2428,2,1,1,9,0)=" ""R2""^R2_IEN^R2_VALUE2^R2_VALUE2^ANDOR (A=AND O=OR DATE RANGES)"
^XWB(8994,2428,2,1,1,10,0)=" SORT FIELDS (OPTIONAL)"
^XWB(8994,2428,2,1,1,11,0)=" ""S1""^S1_IEN^[""A""|""D""] (""A - ASCENDING IS THE DEFAULT, ""D"" - DESCENDING)"
^XWB(8994,2428,2,1,1,12,0)=" ""S2""^S2_IEN^[""A""|""D""] (""A - ASCENDING IS THE DEFAULT, ""D"" - DESCENDING)"
^XWB(8994,2428,2,"B","INARRAY",1)=""
^XWB(8994,2428,2,"PARAMSEQ",1,1)=""
^XWB(8994,2428,3,0)="^8994.03^5^5^3080825^^^^"
^XWB(8994,2428,3,1,0)="Return Value"
^XWB(8994,2428,3,2,0)=" ARRAY:- VARIABLE NUMBER OF RECORDS AS FOLLOWS:"
^XWB(8994,2428,3,3,0)="  F1_DATA^F2_DATA^Fn_DATA (VARIABLE NUMBER OF DATA ITEMS)"
^XWB(8994,2428,3,4,0)="  OR"
^XWB(8994,2428,3,5,0)="  -1,NO RECORDS RETRIEVED"
^XWB(8994,2429,0)="DSIR GET REQUESTORS^GTREQSTR^DSIROI3^4^^^^1"
^XWB(8994,2429,1,0)="^8994.01^10^10^3090821^^^^"
^XWB(8994,2429,1,1,0)="THIS RPC WILL RETURN ALL REQUESTORS THAT MEET ONE OF THE FOLLOWING "
^XWB(8994,2429,1,2,0)="CRITERIA:"
^XWB(8994,2429,1,3,0)=" "
^XWB(8994,2429,1,4,0)="THE REQUESTORS LAST NAME STARTS WITH THE CHARACTERS IN THE FIRST INPUT "
^XWB(8994,2429,1,5,0)="PARAMETER AND THE SECOND PARAMETER IS AN ""L"""
^XWB(8994,2429,1,6,0)=" "
^XWB(8994,2429,1,7,0)="OR "
^XWB(8994,2429,1,8,0)=" "
^XWB(8994,2429,1,9,0)="THE REQUESTORS CORPORATE NAME STARTS WITH THE CHARACTERS IN THE FIRST"
^XWB(8994,2429,1,10,0)="INPUT PARAMETER AND THE SECOND PARAMETER IS A ""C""L"""
^XWB(8994,2429,2,0)="^8994.02A^2^2"
^XWB(8994,2429,2,1,0)="PREF^1^30^0^1"
^XWB(8994,2429,2,1,1,0)="^8994.021^1^1^3090819^^^"
^XWB(8994,2429,2,1,1,1,0)="PREF - FIRST PART OF THE REQUESTOR NAME(S) BEING SEARCHED FOR"
^XWB(8994,2429,2,2,0)="STYP^1^1^1^2"
^XWB(8994,2429,2,2,1,0)="^8994.021^2^2^3090821^^^^"
^XWB(8994,2429,2,2,1,1,0)="STYP - ""L"" - USE THE ""AC"" INDEX FOR LAST NAME  "
^XWB(8994,2429,2,2,1,2,0)="       ""C"" - USE THE ""AD"" INDEX FOR CORPORATE NAME"
^XWB(8994,2429,2,"B","PREF",1)=""
^XWB(8994,2429,2,"B","STYP",2)=""
^XWB(8994,2429,2,"PARAMSEQ",1,1)=""
^XWB(8994,2429,2,"PARAMSEQ",2,2)=""
^XWB(8994,2429,3,0)="^^4^4^3090821^"
^XWB(8994,2429,3,1,0)="RETURNS:"
^XWB(8994,2429,3,2,0)=" -1^NO DATA FOUND "
^XWB(8994,2429,3,3,0)=" OR "
^XWB(8994,2429,3,4,0)=" FULL_NAME^CORPORATE_NAME^CITY^STATE^PHONE^IEN^PATIENT POINTER"
^XWB(8994,2430,0)="DSIC XPAR CHG WP^CHGWP^DSICXPR^2^A"
^XWB(8994,2430,1,0)="^8994.01^2^2^3060828^^^^"
^XWB(8994,2430,1,1,0)="This will change an instance of a System Parameter that is of the Word "
^XWB(8994,2430,1,2,0)="Processing type."
^XWB(8994,2430,2,0)="^8994.02A^2^2"
^XWB(8994,2430,2,1,0)="DATA^1^250^1^1"
^XWB(8994,2430,2,1,1,0)="^^10^10^3060828^"
^XWB(8994,2430,2,1,1,1,0)="DATA - required - p1~p2~p3"
^XWB(8994,2430,2,1,1,2,0)="  p1 := optional - entity - if not passed, set to ""SYS"" for"
^XWB(8994,2430,2,1,1,3,0)="                   current user."
^XWB(8994,2430,2,1,1,4,0)="  p2 := required - parameter name"
^XWB(8994,2430,2,1,1,5,0)="  p3 := optional - instance (default is 1)"
^XWB(8994,2430,2,1,1,6,0)=" "
^XWB(8994,2430,2,1,1,7,0)="RETURN PARAMETER DESCRIPTION:"
^XWB(8994,2430,2,1,1,8,0)=" "
^XWB(8994,2430,2,1,1,9,0)="Returns ""1^"" on success"
^XWB(8994,2430,2,1,1,10,0)="        ""-1^Error Message"" on failure"
^XWB(8994,2430,2,2,0)="ARRAY^2^250^1^2"
^XWB(8994,2430,2,2,1,0)="^8994.021^10^10^3060828^^^"
^XWB(8994,2430,2,2,1,1,0)="This is an array of the text to be stored in the parameter."
^XWB(8994,2430,2,2,1,2,0)=" "
^XWB(8994,2430,2,2,1,3,0)="Format is:"
^XWB(8994,2430,2,2,1,4,0)=" "
^XWB(8994,2430,2,2,1,5,0)="ARRAY(1)=1st line of Text"
^XWB(8994,2430,2,2,1,6,0)="ARRAY(2)=2nd line of Text"
^XWB(8994,2430,2,2,1,7,0)="ARRAY(n)=nth line of Text"
^XWB(8994,2430,2,2,1,8,0)=" "
^XWB(8994,2430,2,2,1,9,0)="ARRAY(n)="""" to store blank lines for formatting, such as paragraph "
^XWB(8994,2430,2,2,1,10,0)="            separation."
^XWB(8994,2430,2,"B","ARRAY",2)=""
^XWB(8994,2430,2,"B","DATA",1)=""
^XWB(8994,2430,2,"PARAMSEQ",1,1)=""
^XWB(8994,2430,2,"PARAMSEQ",2,2)=""
^XWB(8994,2430,3,0)="^8994.03^4^4^3060828^^^"
^XWB(8994,2430,3,1,0)="RET(0) = Code^Description     where"
^XWB(8994,2430,3,2,0)=" "
^XWB(8994,2430,3,3,0)="1^ = success."
^XWB(8994,2430,3,4,0)="-1^error message = indicates failure and reason for failure."
^XWB(8994,2431,0)="DSIC XPD INSTALL LIST^INSLIST^DSICXPDU^2^A"
^XWB(8994,2431,1,0)="^^5^5^3060519^"
^XWB(8994,2431,1,1,0)="This will return a list of all the entries in the INSTALL file.  You pass "
^XWB(8994,2431,1,2,0)="in either a KIDS Build name or the name portion of the Build name (a "
^XWB(8994,2431,1,3,0)="Build name without the version number or patch number).  All Installs "
^XWB(8994,2431,1,4,0)="matching that name will be returned in reverse chronological order (the "
^XWB(8994,2431,1,5,0)="newest first)."
^XWB(8994,2431,2,0)="^8994.02A^3^3"
^XWB(8994,2431,2,1,0)="DSIKID^1^30^1^1"
^XWB(8994,2431,2,1,1,0)="^^4^4^3060519^"
^XWB(8994,2431,2,1,1,1,0)="This value will be used to do a Fileman lookup on the INSTALL file .01 "
^XWB(8994,2431,2,1,1,2,0)="Name field.  This value can be a full Build name in the form:"
^XWB(8994,2431,2,1,1,3,0)="  <test><space><version>  or a patch <text>*<version>*<patch>"
^XWB(8994,2431,2,1,1,4,0)="This value can just be the text portion of the Build name."
^XWB(8994,2431,2,2,0)="DSIALL^1^1^0^2"
^XWB(8994,2431,2,2,1,0)="^^8^8^3060519^"
^XWB(8994,2431,2,2,1,1,0)="This parameter will only be used if the DSIKID input value is a patch "
^XWB(8994,2431,2,2,1,2,0)="designation name, that is a Build name with ""*""."
^XWB(8994,2431,2,2,1,3,0)=" "
^XWB(8994,2431,2,2,1,4,0)="This is a Boolean value: 1/0   Default value = 0"
^XWB(8994,2431,2,2,1,5,0)="  if 1 then return only Installs whose Build name exactly matches the"
^XWB(8994,2431,2,2,1,6,0)="    value passed in DSIKID"
^XWB(8994,2431,2,2,1,7,0)="  if 0 then return all Installs whose Build name starts with the text "
^XWB(8994,2431,2,2,1,8,0)="    portion of a patch designation:  <text>*<version>*<patch>"
^XWB(8994,2431,2,3,0)="DSISTAT^1^5^0^3"
^XWB(8994,2431,2,3,1,0)="^^12^12^3060519^"
^XWB(8994,2431,2,3,1,1,0)="This is a string of numbers which can be 0,1,2,3,4"
^XWB(8994,2431,2,3,1,2,0)="These numbers indicate the status of the KIDS Install Status"
^XWB(8994,2431,2,3,1,3,0)="  0:Loaded   1:Queued   2:Install Started   3:Install Completed"
^XWB(8994,2431,2,3,1,4,0)="  4:De-installed"
^XWB(8994,2431,2,3,1,5,0)=" "
^XWB(8994,2431,2,3,1,6,0)="The only statuses that indicate a Build was actually installed are 2,3"
^XWB(8994,2431,2,3,1,7,0)="  3 indicates the install ran to completion successfully"
^XWB(8994,2431,2,3,1,8,0)="  2 indicates that the install started but never ran to completion."
^XWB(8994,2431,2,3,1,9,0)="     There is no way to determine how far the install got just looking at"
^XWB(8994,2431,2,3,1,10,0)="     this status code."
^XWB(8994,2431,2,3,1,11,0)=" "
^XWB(8994,2431,2,3,1,12,0)="Default value = 23"
^XWB(8994,2431,2,"B","DSIALL",2)=""
^XWB(8994,2431,2,"B","DSIKID",1)=""
^XWB(8994,2431,2,"B","DSISTAT",3)=""
^XWB(8994,2431,2,"PARAMSEQ",1,1)=""
^XWB(8994,2431,2,"PARAMSEQ",2,2)=""
^XWB(8994,2431,2,"PARAMSEQ",3,3)=""
^XWB(8994,2431,3,0)="^^11^11^3060519^"
^XWB(8994,2431,3,1,0)="Return List[n] := p1^p2^p3  for n=1,2,3,4,...  where"
^XWB(8994,2431,3,2,0)="  p1 = ifn to file 9.7    p2 = Build name"
^XWB(8994,2431,3,3,0)="  p3 = date [return INSTALL COMPLETE DATE if present, else return"
^XWB(8994,2431,3,4,0)="       DATE LOADED]"
^XWB(8994,2431,3,5,0)=" "
^XWB(8994,2431,3,6,0)="The return list is sorted by Build name root and within name root sort by"
^XWB(8994,2431,3,7,0)="date in reverse chronological order.  The Build name root is the root "
^XWB(8994,2431,3,8,0)="portion of a valid Build name:"
^XWB(8994,2431,3,9,0)="  <root><space><version>      <root>*<version>*<patch>"
^XWB(8994,2431,3,10,0)=" "
^XWB(8994,2431,3,11,0)="If there are problems, return List[1] := -1^message"
^XWB(8994,2432,0)="DSIC FM PULL LIST^PULL^DSICFM^4^A^^^1"
^XWB(8994,2432,1,0)="^8994.01^2^2^3070320^^"
^XWB(8994,2432,1,1,0)="Returns values to populate a list box of choices for a field that is"
^XWB(8994,2432,1,2,0)="SET OF CODES or POINTER or VARIABLE POINTER type."
^XWB(8994,2432,1,3,0)="VARIABLE POINTER."
^XWB(8994,2432,2,0)="^8994.02A^5^5"
^XWB(8994,2432,2,1,0)="FILE^1^20^1^1"
^XWB(8994,2432,2,1,1,0)="^8994.021^1^1^3070320^^"
^XWB(8994,2432,2,1,1,1,0)="File or subfile number (canonic)."
^XWB(8994,2432,2,2,0)="FIELD^1^20^1^2"
^XWB(8994,2432,2,2,1,0)="^8994.021^2^2^3070320^^"
^XWB(8994,2432,2,2,1,1,0)="Field number (canonic) of field for which choices are desired."
^XWB(8994,2432,2,2,1,2,0)="Field must be set of codes or pointer or variable pointer."
^XWB(8994,2432,2,3,0)="START^1^245^0^3"
^XWB(8994,2432,2,3,1,0)="^^8^8^3050930^"
^XWB(8994,2432,2,3,1,1,0)="This parameter is optional and applies only to POINTER and VARIABLE"
^XWB(8994,2432,2,3,1,2,0)="POINTER field types.  It is not used with SET OF CODES type."
^XWB(8994,2432,2,3,1,3,0)=" "
^XWB(8994,2432,2,3,1,4,0)="Starting value for search. If specified this is usually the last"
^XWB(8994,2432,2,3,1,5,0)="value returned from the previous call.  If the field is a POINTER"
^XWB(8994,2432,2,3,1,6,0)="only the value should be argued.  If the field is a VARIABLE"
^XWB(8994,2432,2,3,1,7,0)="POINTER, both value and file should be argued, as VALUE^FILE."
^XWB(8994,2432,2,3,1,8,0)="Both ""^""-pieces can be copied from the last returned value."
^XWB(8994,2432,2,4,0)="MAX^1^20^0^4"
^XWB(8994,2432,2,4,1,0)="^^3^3^3050930^"
^XWB(8994,2432,2,4,1,1,0)="The maximum number of values to return.  The default is 200."
^XWB(8994,2432,2,4,1,2,0)="For VARIABLE POINTER fields the sum accumulates across pointed-to"
^XWB(8994,2432,2,4,1,3,0)="files."
^XWB(8994,2432,2,5,0)="MASK^1^245^0^5"
^XWB(8994,2432,2,5,1,0)="^^4^4^3050930^"
^XWB(8994,2432,2,5,1,1,0)="An optional mask that constrains the values to be returned."
^XWB(8994,2432,2,5,1,2,0)="For example, ""SMI"" returns all values that start with the ""SMI"""
^XWB(8994,2432,2,5,1,3,0)="like SMITH, filtering out values that do not start with the"
^XWB(8994,2432,2,5,1,4,0)="specified mask like SAM."
^XWB(8994,2432,2,5,1,5,0)="value, not the external value of a field.  PART is often a partial match "
^XWB(8994,2432,2,5,1,6,0)="to FROM. For example, FROM(1)=""ZTMMGR"", and PART(1)=""ZTM"" would return "
^XWB(8994,2432,2,5,1,7,0)="only entries that began with ""ZTM"" and came after ""ZTMMGR"". It would not "
^XWB(8994,2432,2,5,1,8,0)="include ""ZTZERO"", even though it comes after ""ZTMMGR"". "
^XWB(8994,2432,2,"B","FIELD",2)=""
^XWB(8994,2432,2,"B","FILE",1)=""
^XWB(8994,2432,2,"B","MASK",5)=""
^XWB(8994,2432,2,"B","MAX",4)=""
^XWB(8994,2432,2,"B","START",3)=""
^XWB(8994,2432,2,"B","STRT",3)=""
^XWB(8994,2432,2,"PARAMSEQ",1,1)=""
^XWB(8994,2432,2,"PARAMSEQ",2,2)=""
^XWB(8994,2432,2,"PARAMSEQ",3,3)=""
^XWB(8994,2432,2,"PARAMSEQ",4,4)=""
^XWB(8994,2432,2,"PARAMSEQ",5,5)=""
^XWB(8994,2432,3,0)="^8994.03^2^2^3070320^^"
^XWB(8994,2432,3,1,0)="Global array of values in the format IEN^NAME[^FILE], where the"
^XWB(8994,2432,3,2,0)="third ""^""-piece applies only to the VARIABLE POINTER field type."
^XWB(8994,2432,3,3,0)="  List[0] := <number of entries>^code  where code equals:"
^XWB(8994,2432,3,4,0)="             S:set of codes   P:pointer   V:variable pointer"
^XWB(8994,2432,3,5,0)="  List[i] := value   for i=1,2,3,4,5,...,n+1 for n entries"
^XWB(8994,2432,3,6,0)="             value equals:"
^XWB(8994,2432,3,7,0)="    for set of codes field type, value = code:code meaning"
^XWB(8994,2432,3,8,0)="    for pointer field type, value = p1^p2"
^XWB(8994,2432,3,9,0)="    for variable pointer field type, value = p1^p2^p3"
^XWB(8994,2432,3,10,0)="        where for pointer type fields,"
^XWB(8994,2432,3,11,0)="          p1 = ien of pointed to file"
^XWB(8994,2432,3,12,0)="          p2 = external representation of .01 field from pointer to file"
^XWB(8994,2432,3,13,0)="          p3 = file number of pointed file [only returned for var ptr]"
^XWB(8994,2432,3,14,0)=" "
^XWB(8994,2432,3,15,0)="If problems or no records found, return List[0] = -1^message"
^XWB(8994,2433,0)="DSIC XPAR ADD WP^ADDWP^DSICXPR^1^A"
^XWB(8994,2433,1,0)="^8994.01^2^2^3070118^^^"
^XWB(8994,2433,1,1,0)="This RPC will allow the addition of a new Word-processing type system "
^XWB(8994,2433,1,2,0)="parameter."
^XWB(8994,2433,2,0)="^8994.02A^2^2"
^XWB(8994,2433,2,1,0)="DATA^1^250^1^1"
^XWB(8994,2433,2,1,1,0)="^8994.021^6^6^3070116^^"
^XWB(8994,2433,2,1,1,1,0)="DATA - required - p1~p2~p3"
^XWB(8994,2433,2,1,1,2,0)="  p1 := optional - entity - if not passed, defaults to SYS for current "
^XWB(8994,2433,2,1,1,3,0)="                            user."
^XWB(8994,2433,2,1,1,4,0)=" "
^XWB(8994,2433,2,1,1,5,0)="  p2 := required - parameter name"
^XWB(8994,2433,2,1,1,6,0)="  p3 := optional - instance (defaults to 1)"
^XWB(8994,2433,2,2,0)="ARRAY^2^250^1^2"
^XWB(8994,2433,2,2,1,0)="^^7^7^3070118^"
^XWB(8994,2433,2,2,1,1,0)="Array of text to add to the parameter where:"
^XWB(8994,2433,2,2,1,2,0)=" "
^XWB(8994,2433,2,2,1,3,0)="  ARRAY(0) = 1st line of text"
^XWB(8994,2433,2,2,1,4,0)="  ARRAY(1) = 2nd line of text"
^XWB(8994,2433,2,2,1,5,0)="  ARRAY(n) = nth line of text"
^XWB(8994,2433,2,2,1,6,0)=" "
^XWB(8994,2433,2,2,1,7,0)=" ARRAY(n)="""" to store blank lines of text, such as paragraph separation."
^XWB(8994,2433,2,"B","ARRAY",2)=""
^XWB(8994,2433,2,"B","DATA",1)=""
^XWB(8994,2433,2,"PARAMSEQ",1,1)=""
^XWB(8994,2433,2,"PARAMSEQ",2,2)=""
^XWB(8994,2433,3,0)="^^6^6^3070118^"
^XWB(8994,2433,3,1,0)="RET= Code^Description"
^XWB(8994,2433,3,2,0)=" "
^XWB(8994,2433,3,3,0)="where:"
^XWB(8994,2433,3,4,0)=" "
^XWB(8994,2433,3,5,0)="1^Parameter added successfully = success"
^XWB(8994,2433,3,6,0)="-1^Error Message = indicates failure and reason for failure."
^XWB(8994,2434,0)="DENTV TP CODE CHECKS^CK^DENTVCK^1^A"
^XWB(8994,2434,1,0)="^^1^1^3070306^"
^XWB(8994,2434,1,1,0)="Processes coding compliance checks for ADA codes entered by the user.  "
^XWB(8994,2434,2,0)="^8994.02A^5^5"
^XWB(8994,2434,2,1,0)="DFN^1^30^1^1"
^XWB(8994,2434,2,1,1,0)="^^1^1^3070306^"
^XWB(8994,2434,2,1,1,1,0)="Contains patient dfn."
^XWB(8994,2434,2,2,0)="ECODE^1^6^1^2"
^XWB(8994,2434,2,2,1,0)="^^2^2^3070306^"
^XWB(8994,2434,2,2,1,1,0)="Contains the internal, or external ADA Code (e.g. 100268, or D0120) "
^XWB(8994,2434,2,2,1,2,0)="followed by a colon and the tooth# for the code entered by the user."
^XWB(8994,2434,2,3,0)="VISDT^1^^1^3"
^XWB(8994,2434,2,3,1,0)="^^3^3^3070306^"
^XWB(8994,2434,2,3,1,1,0)="Contains the visit date to be used to look back for codes.  A visit "
^XWB(8994,2434,2,3,1,2,0)="date=0 means to only check the current session data, not the historical "
^XWB(8994,2434,2,3,1,3,0)="records."
^XWB(8994,2434,2,4,0)="PROV^1^30^1^4"
^XWB(8994,2434,2,4,1,0)="^^1^1^3070306^"
^XWB(8994,2434,2,4,1,1,0)="Contains the provider (DUZ) to be used to check compliance."
^XWB(8994,2434,2,5,0)="DATA^2^10^0^5"
^XWB(8994,2434,2,5,1,0)="^8994.021^2^2^3070306^^"
^XWB(8994,2434,2,5,1,1,0)="Contains an array of the current session's completed procedures as "
^XWB(8994,2434,2,5,1,2,0)="DATA(n)=ADA Code"
^XWB(8994,2434,2,"B","DATA",5)=""
^XWB(8994,2434,2,"B","DFN",1)=""
^XWB(8994,2434,2,"B","ECODE",2)=""
^XWB(8994,2434,2,"B","PROV",4)=""
^XWB(8994,2434,2,"B","VISDT",3)=""
^XWB(8994,2434,2,"PARAMSEQ",1,1)=""
^XWB(8994,2434,2,"PARAMSEQ",2,2)=""
^XWB(8994,2434,2,"PARAMSEQ",3,3)=""
^XWB(8994,2434,2,"PARAMSEQ",4,4)=""
^XWB(8994,2434,2,"PARAMSEQ",5,5)=""
^XWB(8994,2434,3,0)="^^2^2^3070306^"
^XWB(8994,2434,3,1,0)="Returns 0^OK or -1^W:flag:Warning message"
^XWB(8994,2434,3,2,0)="             or -1^E:flag:Error message"
^XWB(8994,2435,0)="DENTV UPDATE PCE^UPD^DENTVTPE^4^A^^^1"
^XWB(8994,2435,1,0)="^^2^2^3070501^"
^XWB(8994,2435,1,1,0)="Deletes procedures, diagnosis and providers from PCE when users delete "
^XWB(8994,2435,1,2,0)="transactions from DRM Plus."
^XWB(8994,2435,2,0)="^8994.02A^1^1"
^XWB(8994,2435,2,1,0)="DATA^2^256^1^1"
^XWB(8994,2435,2,1,1,0)="^^2^2^3070501^"
^XWB(8994,2435,2,1,1,1,0)="Contains a list of transaction ids deleted from DRM Plus in the format:"
^XWB(8994,2435,2,1,1,2,0)="DATA(txnid)."
^XWB(8994,2435,2,"B","DATA",1)=""
^XWB(8994,2435,2,"PARAMSEQ",1,1)=""
^XWB(8994,2435,3,0)="^^8^8^3070501^"
^XWB(8994,2435,3,1,0)="Returns array -1^error or list of visits that were updated:"
^XWB(8994,2435,3,2,0)="RET(n)=$START^visit ien^visit date (external format)"
^XWB(8994,2435,3,3,0)="RET(n)=OK message or the following:"
^XWB(8994,2435,3,4,0)="RET(n)=visit ien^code^data to prompt user for information."
^XWB(8994,2435,3,5,0)=" "
^XWB(8994,2435,3,6,0)=" code^data can be the following to prompt user for primary dx or provider:"
^XWB(8994,2435,3,7,0)=" visit ien^""POV""^dx ien^dx external^^desc"
^XWB(8994,2435,3,8,0)=" visit ien^""PRV""^provider ien(file 200)^provider name"
^XWB(8994,2436,0)="DENTV UPDATE PCE DX^UDX^DENTVTPF^1"
^XWB(8994,2436,1,0)="^^2^2^3070620^"
^XWB(8994,2436,1,1,0)="Updates the PCE Visit to set the Primary Diagnosis and/or Primary "
^XWB(8994,2436,1,2,0)="Provider if they are no longer defined because of deleting procedures."
^XWB(8994,2436,2,0)="^8994.02A^1^1"
^XWB(8994,2436,2,1,0)="DATA^2^256^1^1"
^XWB(8994,2436,2,1,1,0)="^^4^4^3070620^"
^XWB(8994,2436,2,1,1,1,0)="Contains a list with the PCE Visit and Primary Dx and/or Provider defined:"
^XWB(8994,2436,2,1,1,2,0)="DATA(1)=visit ien^visit date"
^XWB(8994,2436,2,1,1,3,0)="DATA(n)=1^""POV""^dx ien^dx external^^desc"
^XWB(8994,2436,2,1,1,4,0)="DATA(n)=1^""PRV""^provider ien(file 200)^provider name"
^XWB(8994,2436,2,"B","DATA",1)=""
^XWB(8994,2436,2,"PARAMSEQ",1,1)=""
^XWB(8994,2436,3,0)="^^1^1^3070620^"
^XWB(8994,2436,3,1,0)="Returns 0^OK or -1^error"
^XWB(8994,2437,0)="DSIC USER ID^ID^DSICDUZ^2^A"
^XWB(8994,2437,1,0)="^^2^2^3070404^"
^XWB(8994,2437,1,1,0)="For a given user DUZ value, return all IDs for that individual.  These "
^XWB(8994,2437,1,2,0)="IDs include SSN, NPI, and the local alternate identifiers if they exist."
^XWB(8994,2437,2,0)="^8994.02A^1^1"
^XWB(8994,2437,2,1,0)="VDUZ^1^15^1^1"
^XWB(8994,2437,2,1,1,0)="^^1^1^3070404^"
^XWB(8994,2437,2,1,1,1,0)="This is the user's internal entry number (DUZ) number from file 200"
^XWB(8994,2437,2,2,0)="FLAGS^1^15^0^2"
^XWB(8994,2437,2,2,1,0)="^^20^20^3070404^"
^XWB(8994,2437,2,2,1,1,0)="A string of characters indicating which identifiers you want returned.  "
^XWB(8994,2437,2,2,1,2,0)="  Default to AaDNSTVv"
^XWB(8994,2437,2,2,1,3,0)=" "
^XWB(8994,2437,2,2,1,4,0)=" Acceptable values"
^XWB(8994,2437,2,2,1,5,0)=" Flag  File 200 field#  Return mnemonic  Description"
^XWB(8994,2437,2,2,1,6,0)=" ----  ---------------  ---------------  ---------------------------------"
^XWB(8994,2437,2,2,1,7,0)="  A      21600(mult)        OAI          Alternate ID"
^XWB(8994,2437,2,2,1,8,0)="  a      21600              OAI          Return default alternate ID only."
^XWB(8994,2437,2,2,1,9,0)="         If one is marked as default then return that value. If none are"
^XWB(8994,2437,2,2,1,10,0)="         marked as default and there is only entry in the Alt ID multiple,"
^XWB(8994,2437,2,2,1,11,0)="         then return that one.  If none are marked as default and more"
^XWB(8994,2437,2,2,1,12,0)="         than one non-expired Alt ID is found, then return error"
^XWB(8994,2437,2,2,1,13,0)="         message. Flags A and a are mutually exclusive.  If both receive"
^XWB(8994,2437,2,2,1,14,0)="         then use A."
^XWB(8994,2437,2,2,1,15,0)="  D      53.2               DEA          DEA#"
^XWB(8994,2437,2,2,1,16,0)="  N      41.99              NPI          NPI#"
^XWB(8994,2437,2,2,1,17,0)="  S      9                  SSN          SSN"
^XWB(8994,2437,2,2,1,18,0)="  T      53.92              TAX          Provider's Tax ID"
^XWB(8994,2437,2,2,1,19,0)="  V      9000               VPID         VPID"
^XWB(8994,2437,2,2,1,20,0)="  v      53.3               VA           VA#"
^XWB(8994,2437,2,"B","FLAGS",2)=""
^XWB(8994,2437,2,"B","VDUZ",1)=""
^XWB(8994,2437,2,"B","XDUZ",1)=""
^XWB(8994,2437,2,"PARAMSEQ",1,1)=""
^XWB(8994,2437,2,"PARAMSEQ",2,2)=""
^XWB(8994,2437,3,0)="^^7^7^3070404^"
^XWB(8994,2437,3,1,0)="If errors, return DSIC(1)=-1^message"
^XWB(8994,2437,3,2,0)="If no IDs found, return DSIC(1)=0^message"
^XWB(8994,2437,3,3,0)="Else return DSIC(n)=p1^p2^p3^p4  where n=1,2,3,4,... and"
^XWB(8994,2437,3,4,0)="  p1 - value for this identifier"
^XWB(8994,2437,3,5,0)="  p2 - mnemonic indicating the type of identifier"
^XWB(8994,2437,3,6,0)="  p3 - default ID - Boolean value, if 1 then the default value"
^XWB(8994,2437,3,7,0)="  p4 - expiration date for this ID (if applicable)"
^XWB(8994,2437,3,8,0)="  For list of mnemonics, see description for FLAGS input parameter"
^XWB(8994,2438,0)="DSIC FM MULTIPLE FILER^MFILE^DSICFM^2^A^^^"
^XWB(8994,2438,1,0)="^^2^2^3060531^"
^XWB(8994,2438,1,1,0)="Calls DSIC FM FILER remote procedure code as often as necessary"
^XWB(8994,2438,1,2,0)="to process multiple file or subfile x IENS combinations."
^XWB(8994,2438,2,0)="^8994.02A^1^1"
^XWB(8994,2438,2,1,0)="INPUT^2^245^1^1"
^XWB(8994,2438,2,1,1,0)="^^30^30^3060531^"
^XWB(8994,2438,2,1,1,1,0)=" ;         LIST[#] = p1^p2^p3^p4^p5^p6 where"
^XWB(8994,2438,2,1,1,2,0)=" ;"
^XWB(8994,2438,2,1,1,3,0)=" ;         p1 - required when file or subfile changes"
^XWB(8994,2438,2,1,1,4,0)=" ;              First record of each group relating to the same"
^XWB(8994,2438,2,1,1,5,0)=" ;              file or subfile must specify the file or subfile"
^XWB(8994,2438,2,1,1,6,0)=" ;              number in the first piece.  This value can be"
^XWB(8994,2438,2,1,1,7,0)=" ;              omitted for subsequent records that pertain to"
^XWB(8994,2438,2,1,1,8,0)=" ;              the same file or subfile."
^XWB(8994,2438,2,1,1,9,0)=" ;         p2 - required when IENS or file/subfile changes"
^XWB(8994,2438,2,1,1,10,0)=" ;              First record of each group to be filed to the same"
^XWB(8994,2438,2,1,1,11,0)=" ;              entry or subentry must specify the IENS."
^XWB(8994,2438,2,1,1,12,0)=" ;              This value can be omitted for subsequent"
^XWB(8994,2438,2,1,1,13,0)=" ;              records that pertain to other fields in the same"
^XWB(8994,2438,2,1,1,14,0)=" ;              entry."
^XWB(8994,2438,2,1,1,15,0)=" ;         p3 - FLAG - optional - only acceptable value is ""T"" -"
^XWB(8994,2438,2,1,1,16,0)=" ;              transaction processing, that is, all the fields must"
^XWB(8994,2438,2,1,1,17,0)=" ;              be successfully updated or none are.  Applies to"
^XWB(8994,2438,2,1,1,18,0)=" ;              the entire group of records for one file or subfile"
^XWB(8994,2438,2,1,1,19,0)=" ;              number and IENS.  May be specified in any record of"
^XWB(8994,2438,2,1,1,20,0)=" ;              the same group."
^XWB(8994,2438,2,1,1,21,0)=" ;         p4 - required - field # (Same as p1 in FILE^DSICFM)"
^XWB(8994,2438,2,1,1,22,0)=" ;         p5 - optional - default value I (Same as p2 in FILE^DSICFM)"
^XWB(8994,2438,2,1,1,23,0)=" ;              if p5="""" then field value in internal format"
^XWB(8994,2438,2,1,1,24,0)=" ;                   =""E"" then field value in external format"
^XWB(8994,2438,2,1,1,25,0)=" ;                   =""I"" then field value in internal format"
^XWB(8994,2438,2,1,1,26,0)=" ;                   =""W"" then field is a word processing"
^XWB(8994,2438,2,1,1,27,0)=" ;                                  see notes for FILE^DSICFM"
^XWB(8994,2438,2,1,1,28,0)=" ;         p6 - value for field# - if value is <null> or ""@"""
^XWB(8994,2438,2,1,1,29,0)=" ;                        then field value will be deleted."
^XWB(8994,2438,2,1,1,30,0)=" ;                        (Same as p3 in FILE^DSICFM)"
^XWB(8994,2438,2,"B","INPUT",1)=""
^XWB(8994,2438,2,"PARAMSEQ",1,1)=""
^XWB(8994,2438,3,0)="^^5^5^3060531^"
^XWB(8994,2438,3,1,0)="RESULT -     return array where"
^XWB(8994,2438,3,2,0)="             RESULT(1) = 1^FILE^IENS  if everything was successfully filed"
^XWB(8994,2438,3,3,0)="                                      for this FILE x IENS combination."
^XWB(8994,2438,3,4,0)="                           = -1^error message if any problems encountered"
^XWB(8994,2438,3,5,0)="             RESULT(2...n) = additional messages in above format"
^XWB(8994,2439,0)="TIU IS USER A USR PROVIDER^USRPROV^TIUSRVP1^1"
^XWB(8994,2439,1,0)="^^2^2^3070815^"
^XWB(8994,2439,1,1,0)="This Boolean RPC returns TRUE if the user was a member of USR CLASS "
^XWB(8994,2439,1,2,0)="PROVIDER on the date specified."
^XWB(8994,2439,2,0)="^8994.02A^2^2"
^XWB(8994,2439,2,1,0)="USER^1^^0^1"
^XWB(8994,2439,2,1,1,0)="^^2^2^3070815^"
^XWB(8994,2439,2,1,1,1,0)="This is the IEN of the user in the NEW PERSON FILE 200.  If no user is "
^XWB(8994,2439,2,1,1,2,0)="specified, DUZ (the current user of the software) is the default."
^XWB(8994,2439,2,2,0)="DATE^1^^0^2"
^XWB(8994,2439,2,2,1,0)="^^4^4^3070815^"
^XWB(8994,2439,2,2,1,1,0)="This is the date in internal FILEMAN format for which the user's "
^XWB(8994,2439,2,2,1,2,0)="membership in USR CLASS PROVIDER is evaluated.  If no date is received, "
^XWB(8994,2439,2,2,1,3,0)="TODAY is the default. Date must be a strict date; time must NOT be"
^XWB(8994,2439,2,2,1,4,0)="included."
^XWB(8994,2439,2,"B","DATE",2)=""
^XWB(8994,2439,2,"B","USER",1)=""
