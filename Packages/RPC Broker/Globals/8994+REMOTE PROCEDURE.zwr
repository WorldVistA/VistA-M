^XWB(8994,4951,0)="ISIJ GET RAD TECHS^RADLST^ISIDICR1^2^R"
^XWB(8994,4951,1,0)="^^1^1^3210723^"
^XWB(8994,4951,1,1,0)="Returns a list of Rad Techs active at the user's logon site."
