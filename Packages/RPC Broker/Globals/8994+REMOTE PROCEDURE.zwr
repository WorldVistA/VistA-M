^XWB(8994,4348,3,3,0)="  Successful Completion:"
^XWB(8994,4348,3,4,0)="    DSSORET = pc 1 ^ pc 2 ^ pc 3 ^ pc 4 ^ pc 5 "
^XWB(8994,4348,3,5,0)="        ^-pc 1 = file number (665 or sub-file number)"
^XWB(8994,4348,3,6,0)="        ^-pc 2 = file 665 IEN (or sub-file IEN_"",""_file 665 IEN)"
^XWB(8994,4348,3,7,0)="        ^-pc 3 = field number"
^XWB(8994,4348,3,8,0)="        ^-pc 4 = ""E"" (external format) or ""I"" (internal format)"
^XWB(8994,4348,3,9,0)="        ^-pc 5 = data (in format specified in ^-pc 4)"
^XWB(8994,4349,0)="DSSO RC LISTOPEN PC TXNS^LISTOPEN^DSSORC^4^^^^1"
^XWB(8994,4349,1,0)="^^2^2^3150925^"
^XWB(8994,4349,1,1,0)="This RPC returns a list of open Purchase Card Transactions for the "
