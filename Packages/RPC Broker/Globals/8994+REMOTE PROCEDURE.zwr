^XWB(8994,4331,2,10,1,1,0)="CPT Modifier - 1-36 characters; CPT modifiers in a comma-delimited format."
^XWB(8994,4331,2,11,0)="DSSOLOC^1^15^0^11"
^XWB(8994,4331,2,11,1,0)="^8994.021^2^2^3150421^^"
^XWB(8994,4331,2,11,1,1,0)="Inventory Location (PIP) - required if PIP Stock Issue - Pros Item"
^XWB(8994,4331,2,11,1,2,0)="Location file (#661.3) IEN"
