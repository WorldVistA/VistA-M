^XWB(8994,4347,3,10,0)="      ^-pc 2  Arabic Disability Name (#.01)"
^XWB(8994,4347,3,11,0)="      ^-pc 3  Major Disability Code Symbols (#4)"
^XWB(8994,4347,3,12,0)="      ^-pc 4  Group Extent of Disability (#5)"
^XWB(8994,4347,3,13,0)="      ^-pc 5  Disability Grouping (#5.5)"
^XWB(8994,4348,0)="DSSO GET 665 PROS PATIENT^GET665^DSSOPP^4^^^^1"
