^XWB(8994,2917,2,3,1,1,0)="The date/time from which to begin searching for data [optional]."
^XWB(8994,2917,2,4,0)="STOP^1^20^0^4"
^XWB(8994,2917,2,4,1,0)="^8994.021^1^1^3100203^^"
^XWB(8994,2917,2,4,1,1,0)="The date/time at which to end searching for data [optional]."
^XWB(8994,2917,2,5,0)="MAX^1^7^0^5"
^XWB(8994,2917,2,5,1,0)="^8994.021^1^1^3100203^^"
^XWB(8994,2917,2,5,1,1,0)="The maximum number of items to return per data type [optional]."
^XWB(8994,2917,2,6,0)="ITEM^1^30^0^6"
^XWB(8994,2917,2,6,1,0)="^8994.021^2^2^3100329^^^"
^XWB(8994,2917,2,6,1,1,0)="The identifier of a single item to return [optional, but TYPE must"
^XWB(8994,2917,2,6,1,2,0)="also be defined when used]."
^XWB(8994,2917,2,7,0)="FILTER^2^^0^7"
^XWB(8994,2917,2,7,1,0)="^8994.021^1^1^3110606^^^^"
^XWB(8994,2917,2,7,1,1,0)="List of name-value pairs, further refining the search."
^XWB(8994,2917,2,"B","DFN",1)=""
^XWB(8994,2917,2,"B","FILTER",7)=""
^XWB(8994,2917,2,"B","ITEM",6)=""
^XWB(8994,2917,2,"B","MAX",5)=""
^XWB(8994,2917,2,"B","START",3)=""
^XWB(8994,2917,2,"B","STOP",4)=""
^XWB(8994,2917,2,"B","TYPE",2)=""
^XWB(8994,2917,2,"PARAMSEQ",1,1)=""
^XWB(8994,2917,2,"PARAMSEQ",2,2)=""
^XWB(8994,2917,2,"PARAMSEQ",3,3)=""
^XWB(8994,2917,2,"PARAMSEQ",4,4)=""
^XWB(8994,2917,2,"PARAMSEQ",5,5)=""
^XWB(8994,2917,2,"PARAMSEQ",6,6)=""
^XWB(8994,2917,2,"PARAMSEQ",7,7)=""
^XWB(8994,2917,3,0)="^8994.03^1^1^3110606^^^^"
^XWB(8994,2917,3,1,0)="Text array formatted as XML"
^XWB(8994,2918,0)="VPR DATA VERSION^VERSION^VPRD^1^S^^^^^^1"
^XWB(8994,2918,1,0)="^^2^2^3110613^"
^XWB(8994,2918,1,1,0)="This RPC returns the current version of the XML returned by the RPC"
^XWB(8994,2918,1,2,0)="'VPR GET PATIENT DATA.'"
^XWB(8994,2918,3,0)="^^2^2^3110613^"
^XWB(8994,2918,3,1,0)="A string identifying the version of the VPR data extracts and the"
^XWB(8994,2918,3,2,0)="resulting XML."
^XWB(8994,2919,0)="MAGG IMAGE STATISTICS BY USER^GETUSRPT^MAGGA03Q^4^R^^^1"
^XWB(8994,2919,1,0)="^8994.01^1^1^3100805^^"
^XWB(8994,2919,1,1,0)="Return all statistics reports previously tasked for a user"
^XWB(8994,2919,2,0)="^8994.02A^1^1"
^XWB(8994,2919,2,1,0)="MAGDUZ^1^^^1"
^XWB(8994,2919,2,1,1,0)="^8994.021^3^3^3100805^^^"
^XWB(8994,2919,2,1,1,1,0)="Internal ID of a user that has previously queued an Image Statistics "
^XWB(8994,2919,2,1,1,2,0)="Report."
^XWB(8994,2919,2,1,1,3,0)="The default value is the current user DUZ."
^XWB(8994,2919,2,"B","MAGDUZ",1)=""
^XWB(8994,2919,2,"PARAMSEQ",1,1)=""
^XWB(8994,2919,3,0)="^8994.03^14^14^3100805^^^^"
^XWB(8994,2919,3,1,0)="MAGRY(0) -  ^01: 1 Successful execution of the remote procedure"
^XWB(8994,2919,3,2,0)="                 0 An error occurred during the execution of the remote procedure"
^XWB(8994,2919,3,3,0)=" "
^XWB(8994,2919,3,4,0)="            ^02: The number of reports identified for the user"
^XWB(8994,2919,3,5,0)=""
^XWB(8994,2919,3,6,0)="MAGRY(1..n) ^01: report FLAGS parameter"
^XWB(8994,2919,3,7,0)="            ^02: report FROMDATE parameter"
^XWB(8994,2919,3,8,0)="            ^03: report TODATE parameter"
^XWB(8994,2919,3,9,0)="            ^04: report REPORT START DATE/TIME parameter"
^XWB(8994,2919,3,10,0)="            ^05: report REPORT COMPLETE DATE/TIEM parameter"
^XWB(8994,2919,3,11,0)="  "
^XWB(8994,2919,3,12,0)="  e.g."
^XWB(8994,2919,3,13,0)="    0)=1^5 Reports found for user IMAGING,USER"
^XWB(8994,2919,3,14,0)="    1)=CDE^2900613^3100503^3100505.09053^3100505.09053"
^XWB(8994,2920,0)="MAGG IMAGE STATISTICS QUE^STATS^MAGGA03Q^4^R^^^1"
^XWB(8994,2920,1,0)="^8994.01^9^9^3100506^^"
^XWB(8994,2920,1,1,0)="The MAGG QUEUE IMAGE STATISTICS remote procedure queues a job through"
^XWB(8994,2920,1,2,0)="TaskMan that queries the image file(s) and returns various"
^XWB(8994,2920,1,3,0)="statistics/summary data. Currently, 2 queries are implemented:"
^XWB(8994,2920,1,4,0)=" "
^XWB(8994,2920,1,5,0)="  Counts of images captured in the provided date range grouped by the "
^XWB(8994,2920,1,6,0)="  image status codes."
^XWB(8994,2920,1,7,0)=" "
^XWB(8994,2920,1,8,0)="  Counts of images captured in the provided date range grouped by users "
^XWB(8994,2920,1,9,0)="  and image status codes."
^XWB(8994,2920,2,0)="^8994.02A^4^4"
^XWB(8994,2920,2,1,0)="FLAGS^1^^1^1"
^XWB(8994,2920,2,1,1,0)="^^26^26^3100506^"
^XWB(8994,2920,2,1,1,1,0)="Flags that control the execution (can be combined):"
^XWB(8994,2920,2,1,1,2,0)="  "
^XWB(8994,2920,2,1,1,3,0)="  C  Capture date range. If this flag is provided,"
^XWB(8994,2920,2,1,1,4,0)="     then the remote procedure uses values of the"
^XWB(8994,2920,2,1,1,5,0)="     FROMDATE and TODATE parameters to select images"
^XWB(8994,2920,2,1,1,6,0)="     that were captured in this date range (see the"
^XWB(8994,2920,2,1,1,7,0)="     DATE/TIME IMAGE SAVED field (7) and the ""AD"""
^XWB(8994,2920,2,1,1,8,0)="     cross-reference)."
^XWB(8994,2920,2,1,1,9,0)="  "
^XWB(8994,2920,2,1,1,10,0)="     Otherwise, values of those parameters are"
^XWB(8994,2920,2,1,1,11,0)="     treated as the date range when procedures were"
^XWB(8994,2920,2,1,1,12,0)="     performed (see the PROCEDURE/EXAM DATE/TIME"
^XWB(8994,2920,2,1,1,13,0)="     field (15) and cross-references ""APDTPX"" and"
^XWB(8994,2920,2,1,1,14,0)="     ""APDT"")."
^XWB(8994,2920,2,1,1,15,0)="  "
^XWB(8994,2920,2,1,1,16,0)="  D  Include only deleted images (file #2005.1)"
^XWB(8994,2920,2,1,1,17,0)="  E  Include only existing images (file #2005)"
^XWB(8994,2920,2,1,1,18,0)="  "
^XWB(8994,2920,2,1,1,19,0)="  S  Return image counts grouped by status"
^XWB(8994,2920,2,1,1,20,0)="  U  Return image counts grouped by users and status"
^XWB(8994,2920,2,1,1,21,0)="  "
^XWB(8994,2920,2,1,1,22,0)="If neither 'E' nor 'D' flag is provided, then an error code (-6) is"
^XWB(8994,2920,2,1,1,23,0)="returned."
^XWB(8994,2920,2,1,1,24,0)="  "
^XWB(8994,2920,2,1,1,25,0)="If neither 'S' nor 'U' flag is provided, then an error code (-6) is"
^XWB(8994,2920,2,1,1,26,0)="returned."
^XWB(8994,2920,2,2,0)="FROMDATE^1^^^2"
^XWB(8994,2920,2,2,1,0)="^8994.021^11^11^3100506^^"
^XWB(8994,2920,2,2,1,1,0)="Beginning of the date range for image selection. Dates can be in internal"
^XWB(8994,2920,2,2,1,2,0)="or external FileMan format. If the parameter is not defined or empty, "
^XWB(8994,2920,2,2,1,3,0)="then the date range remains open on this side."
^XWB(8994,2920,2,2,1,4,0)="  "
^XWB(8994,2920,2,2,1,5,0)="Depending on the value of the FLAGS parameter, the date range filter is"
^XWB(8994,2920,2,2,1,6,0)="applied either to the exam/procedure dates (PROCEDURE/EXAM DATE/TIME "
^XWB(8994,2920,2,2,1,7,0)="field (15)) or image capture dates (DATE/TIME IMAGE SAVED field (7))."
^XWB(8994,2920,2,2,1,8,0)="  "
^XWB(8994,2920,2,2,1,9,0)="Time parts of date range parameters are ignored and both ends of the date"
^XWB(8994,2920,2,2,1,10,0)="range are included in the search. For example, in order to search images"
^XWB(8994,2920,2,2,1,11,0)="for May 21, 2008, the internal value of both parameters should be 3080521."
^XWB(8994,2920,2,3,0)="TODATE^1^^^3"
^XWB(8994,2920,2,3,1,0)="^^11^11^3100506^"
^XWB(8994,2920,2,3,1,1,0)="End of the date range for image selection. Dates can be in internal or"
^XWB(8994,2920,2,3,1,2,0)="external FileMan format. If the parameter is not defined or empty, then"
^XWB(8994,2920,2,3,1,3,0)="the date range remains open on this side."
^XWB(8994,2920,2,3,1,4,0)="  "
^XWB(8994,2920,2,3,1,5,0)="Depending on the value of the FLAGS parameter, the date range filter is"
^XWB(8994,2920,2,3,1,6,0)="applied either to the exam/procedure dates (PROCEDURE/EXAM DATE/TIME "
^XWB(8994,2920,2,3,1,7,0)="field (15)) or image capture dates (DATE/TIME IMAGE SAVED field (7))."
^XWB(8994,2920,2,3,1,8,0)="  "
^XWB(8994,2920,2,3,1,9,0)="Time parts of date range parameters are ignored and both ends of the date"
^XWB(8994,2920,2,3,1,10,0)="range are included in the search. For example, in order to search images"
^XWB(8994,2920,2,3,1,11,0)="for May 21, 2008, the internal value of both parameters should be 3080521."
^XWB(8994,2920,2,4,0)="MQUE^1^^^4"
^XWB(8994,2920,2,4,1,0)="^^11^11^3100506^"
^XWB(8994,2920,2,4,1,1,0)="Flags for tasking reports and action on previously tasked reports."
^XWB(8994,2920,2,4,1,2,0)=" "
^XWB(8994,2920,2,4,1,3,0)="  Q  (Default) Queue a new report task or return the status of In "
^XWB(8994,2920,2,4,1,4,0)="     Progress for a running report. If previously ran task is complete,"
^XWB(8994,2920,2,4,1,5,0)="     then the report data is returned in the output of the RPC."
^XWB(8994,2920,2,4,1,6,0)=" "
^XWB(8994,2920,2,4,1,7,0)="  R  Stop and Re-queue a running report task with the same parameters."
^XWB(8994,2920,2,4,1,8,0)="     Existing data collected is removed from temporary storage."
^XWB(8994,2920,2,4,1,9,0)=" "
^XWB(8994,2920,2,4,1,10,0)="  D  Stop a running or completed report task and delete all associated"
^XWB(8994,2920,2,4,1,11,0)="     data from temporary storage."
^XWB(8994,2920,2,"B","FLAGS",1)=""
^XWB(8994,2920,2,"B","FROMDATE",2)=""
^XWB(8994,2920,2,"B","MQUE",4)=""
^XWB(8994,2920,2,"B","TODATE",3)=""
^XWB(8994,2920,2,"PARAMSEQ",1,1)=""
^XWB(8994,2920,2,"PARAMSEQ",2,2)=""
^XWB(8994,2920,2,"PARAMSEQ",3,3)=""
^XWB(8994,2920,2,"PARAMSEQ",4,4)=""
^XWB(8994,2920,3,0)="^^75^75^3100506^"
^XWB(8994,2920,3,1,0)="Zero value of the first '^'-piece of the Results[0] indicates that an"
^XWB(8994,2920,3,2,0)="error occurred during the execution of the procedure. In this case, the"
^XWB(8994,2920,3,3,0)="errors are returned in the Results array as shown below:"
^XWB(8994,2920,3,4,0)="   "
^XWB(8994,2920,3,5,0)="   Results[0]            Result descriptor"
^XWB(8994,2920,3,6,0)="                           ^01: 0"
^XWB(8994,2920,3,7,0)="                           ^02: Message"
^XWB(8994,2920,3,8,0)="   "
^XWB(8994,2920,3,9,0)="   Results[i]            Error descriptor"
^XWB(8994,2920,3,10,0)="                           ^01: Error code"
^XWB(8994,2920,3,11,0)="                           ^02: Message"
^XWB(8994,2920,3,12,0)="                           ^03: Error location"
^XWB(8994,2920,3,13,0)="                           ^04: Message type"
^XWB(8994,2920,3,14,0)="  "
^XWB(8994,2920,3,15,0)="   Results[j]            Line of the additional info (optional)"
^XWB(8994,2920,3,16,0)="                           ^01: """""
^XWB(8994,2920,3,17,0)="                           ^02: Text  "
^XWB(8994,2920,3,18,0)="  "
^XWB(8994,2920,3,19,0)="Otherwise, '1^Ok' is returned in the Results[0] and subsequent nodes "
^XWB(8994,2920,3,20,0)="contain requested data:"
^XWB(8994,2920,3,21,0)="  "
^XWB(8994,2920,3,22,0)="   Results[i]            Header of the counts grouped by status"
^XWB(8994,2920,3,23,0)="                           ^01: ""S"""
^XWB(8994,2920,3,24,0)="                           ^02: empty"
^XWB(8994,2920,3,25,0)="                           ^03: Number of ""S""-items"
^XWB(8994,2920,3,26,0)="                           ^04: empty"
^XWB(8994,2920,3,27,0)="                           ^05: ""Totals"""
^XWB(8994,2920,3,28,0)="                           ^06: Number of image entries"
^XWB(8994,2920,3,29,0)="                           ^07: Number of images/pages"
^XWB(8994,2920,3,30,0)="          "
^XWB(8994,2920,3,31,0)="   Results[i+j]          Image status record"
^XWB(8994,2920,3,32,0)="                           ^01: ""S"""
^XWB(8994,2920,3,33,0)="                           ^02: Sequential number of the ""S""-item"
^XWB(8994,2920,3,34,0)="                           ^03: empty"
^XWB(8994,2920,3,35,0)="                           ^04: Internal value of the STATUS field (113)."
^XWB(8994,2920,3,36,0)="                                If this piece is empty or 0, then the"
^XWB(8994,2920,3,37,0)="                                record contains counts of images with "
^XWB(8994,2920,3,38,0)="                                empty STATUS field."
^XWB(8994,2920,3,39,0)="                           ^05: External value of the STATUS field (113)"
^XWB(8994,2920,3,40,0)="                           ^06: Number of image entries"
^XWB(8994,2920,3,41,0)="                           ^07: Number of images/pages"
^XWB(8994,2920,3,42,0)="         "
^XWB(8994,2920,3,43,0)="   Results[i]            Header of the counts grouped by users and status"
^XWB(8994,2920,3,44,0)="                           ^01: ""U"""
^XWB(8994,2920,3,45,0)="                           ^02: empty"
^XWB(8994,2920,3,46,0)="                           ^03: Number of ""U""-items"
^XWB(8994,2920,3,47,0)="                           ^04: empty"
^XWB(8994,2920,3,48,0)="                           ^05: ""Totals"""
^XWB(8994,2920,3,49,0)="                           ^06: Number of image entries"
^XWB(8994,2920,3,50,0)="                           ^07: Number of images/pages"
^XWB(8994,2920,3,51,0)="          "
^XWB(8994,2920,3,52,0)="   Results[i+j]          User record"
^XWB(8994,2920,3,53,0)="                           ^01: ""U"""
^XWB(8994,2920,3,54,0)="                           ^02: Sequential number of the ""U""-item"
^XWB(8994,2920,3,55,0)="                           ^03: Number of ""US""-items"
^XWB(8994,2920,3,56,0)="                           ^04: User IEN (DUZ)."
^XWB(8994,2920,3,57,0)="                                If this piece is empty or 0, then the"
^XWB(8994,2920,3,58,0)="                                record contains counts of images that "
^XWB(8994,2920,3,59,0)="                                are not associated with a user."
^XWB(8994,2920,3,60,0)="                           ^05: User name"
^XWB(8994,2920,3,61,0)="                           ^06: Number of image entries"
^XWB(8994,2920,3,62,0)="                           ^07: Number of images/pages"
^XWB(8994,2920,3,63,0)="                           ^08: Percentage of verified images"
^XWB(8994,2920,3,64,0)="          "
^XWB(8994,2920,3,65,0)="   Results[i+j+k]        User/status record"
^XWB(8994,2920,3,66,0)="                           ^01: ""US"""
^XWB(8994,2920,3,67,0)="                           ^02: Sequential number of the ""US""-item"
^XWB(8994,2920,3,68,0)="                           ^03: empty"
^XWB(8994,2920,3,69,0)="                           ^04: Internal value of the STATUS field (113)."
^XWB(8994,2920,3,70,0)="                                If this piece is empty or 0, then the"
^XWB(8994,2920,3,71,0)="                                record contains counts of images with "
^XWB(8994,2920,3,72,0)="                                empty STATUS field."
^XWB(8994,2920,3,73,0)="                           ^05: External value of the STATUS field (113)"
^XWB(8994,2920,3,74,0)="                           ^06: Number of image entries"
^XWB(8994,2920,3,75,0)="                           ^07: Number of images/pages"
^XWB(8994,2921,0)="MAGG JUKE BOX PATH^JB^MAGGUJB^1^R"
^XWB(8994,2921,1,0)="^^1^1^3101201^"
^XWB(8994,2921,1,1,0)="Returns the Juke Box path to an image."
^XWB(8994,2921,2,0)="^8994.02A^1^1"
^XWB(8994,2921,2,1,0)="MAGIEN^1^30^1^1"
^XWB(8994,2921,2,1,1,0)="^^1^1^3101201^"
^XWB(8994,2921,2,1,1,1,0)="MAGIEN is IEN number in IMAGE file (#2005) or IMAGE AUDIT file (#2005.1)"
^XWB(8994,2921,2,"B","MAGIEN",1)=""
^XWB(8994,2921,2,"PARAMSEQ",1,1)=""
^XWB(8994,2921,3,0)="^^2^2^3101201^"
^XWB(8994,2921,3,1,0)="if error MAGRY = 0^error message"
^XWB(8994,2921,3,2,0)="if success MAGRY = 1^full juke box path"
^XWB(8994,2922,0)="MAGG MULTI IMAGE PRINT^LOGPRNT^MAGGROI^1^R"
^XWB(8994,2922,1,0)="^8994.01^2^2^3100608^^^^"
^XWB(8994,2922,1,1,0)="Log multiple images printed for a patient in the "
^XWB(8994,2922,1,2,0)="MULTI IMAGE PRINT file ^MAG(2006.961"
^XWB(8994,2922,2,0)="^8994.02A^2^2"
^XWB(8994,2922,2,1,0)="DATA^1^245^1^1"
^XWB(8994,2922,2,1,1,0)="^^6^6^3100608^"
^XWB(8994,2922,2,1,1,1,0)="""^"" delimited string containing data inserted"
^XWB(8994,2922,2,1,1,2,0)="into the MULTI IMAGE PRINT file #2006.961."
^XWB(8994,2922,2,1,1,3,0)=" "
^XWB(8994,2922,2,1,1,4,0)=" ^01: PATIENT DFN"
^XWB(8994,2922,2,1,1,5,0)=" ^02: REASON FOR PRINT"
^XWB(8994,2922,2,1,1,6,0)=""
^XWB(8994,2922,2,1,1,7,0)="e.g.: 123456^Authorized release of medical records or health information (ROI)"
^XWB(8994,2922,2,2,0)="IMGARR^2^^1^2"
^XWB(8994,2922,2,2,1,0)="^^11^11^3100608^"
^XWB(8994,2922,2,2,1,1,0)="An array of ""^"" delimited string of values for each image printed"
^XWB(8994,2922,2,2,1,2,0)=" "
^XWB(8994,2922,2,2,1,3,0)=" ^01: IEN for the image (Note: This may be a url for a remote image)"
^XWB(8994,2922,2,2,1,4,0)=" ^02: Local/remote indicator (0=local, 1=remote)"
^XWB(8994,2922,2,2,1,5,0)=" ^03: IMAGE PRINT STATUS "
^XWB(8994,2922,2,2,1,6,0)="         (Note: The image information displayed to the user "
^XWB(8994,2922,2,2,1,7,0)="         in the client application.)"
^XWB(8994,2922,2,2,1,8,0)=" "
^XWB(8994,2922,2,2,1,9,0)=" e.g.: IMGARR(0)=^1^SLC-DIABETIC TELERETINAL IMAGING CONSULT REPORT"
^XWB(8994,2922,2,2,1,10,0)="                       -NOTE-04/13/2009 11:31: Image type not printable"
^XWB(8994,2922,2,2,1,11,0)="       IMGARR(1)=123456^0^SLC-AU 01 2-LAB-08/21/2001: Image printed"
^XWB(8994,2922,2,"B","DATA",1)=""
^XWB(8994,2922,2,"B","IMGARR",2)=""
^XWB(8994,2922,2,"PARAMSEQ",1,1)=""
^XWB(8994,2922,2,"PARAMSEQ",2,2)=""
^XWB(8994,2922,3,0)="^8994.03^2^2^3100608^^"
^XWB(8994,2922,3,1,0)="if error   ""0^Error message"""
^XWB(8994,2922,3,2,0)="if success ""1^Printed Images Logged"""
^XWB(8994,2923,0)="ONC VACCR RPC^EN1^ONCRPC^4^R"
^XWB(8994,2923,1,0)="^8994.01^2^2^3110801^^^^"
^XWB(8994,2923,1,1,0)="This REMOTE PROCEDURE outputs OncoTrax data in the VACCR record layout"
^XWB(8994,2923,1,2,0)="format."
^XWB(8994,2923,2,0)="^8994.02A^3^3"
^XWB(8994,2923,2,1,0)="DATEUSED^1^1^1^1"
^XWB(8994,2923,2,1,1,0)="^^5^5^3110614^"
^XWB(8994,2923,2,1,1,1,0)="DATEUSED specifies the date field which will be searched for cases"
^XWB(8994,2923,2,1,1,2,0)="to be extracted:"
^XWB(8994,2923,2,1,1,3,0)=" "
^XWB(8994,2923,2,1,1,4,0)="1 = DATE CASE COMPLETED"
^XWB(8994,2923,2,1,1,5,0)="2 = DATE CASE LAST CHANGED"
^XWB(8994,2923,2,2,0)="START^1^7^1^2"
^XWB(8994,2923,2,2,1,0)="^^1^1^3110614^"
^XWB(8994,2923,2,2,1,1,0)="This parameter specifies the start date of DATE parameter."
^XWB(8994,2923,2,3,0)="END^1^7^1^3"
^XWB(8994,2923,2,3,1,0)="^8994.021^1^1^3110801^^^"
^XWB(8994,2923,2,3,1,1,0)="This parameter specifies the end date of DATE parameter."
^XWB(8994,2923,2,"B","DATEUSED",1)=""
^XWB(8994,2923,2,"B","END",3)=""
^XWB(8994,2923,2,"B","START",2)=""
^XWB(8994,2923,2,"PARAMSEQ",1,1)=""
^XWB(8994,2923,2,"PARAMSEQ",2,2)=""
^XWB(8994,2923,2,"PARAMSEQ",3,3)=""
^XWB(8994,2924,0)="SCMC PRECEPTOR MOVE - LIST^LISTPREC^SCMCPREC^2^P^^^1"
^XWB(8994,2924,2,0)="^8994.02A"
^XWB(8994,2925,0)="SCMC PRECEPTOR MOVE - MOVE^MOVEPREC^SCMCPREC^2^^^^1"
^XWB(8994,2926,0)="SCMC AUTO INACTIVATION RPT^EN^SCMCTSKG^4^P^^^1"
^XWB(8994,2927,0)="DSIROI GETCMTS GET COMMENTS^GETCMTS^DSIROI^4^^^^1"
^XWB(8994,2927,1,0)="^8994.01^2^2^3111222^^"
^XWB(8994,2927,1,1,0)="This routine can return a set of comments including patient comments "
^XWB(8994,2927,1,2,0)="from the 5345, internal comments, and alerts. "
^XWB(8994,2927,2,0)="^8994.02A^2^2"
^XWB(8994,2927,2,1,0)="IEN^1^60^1^1"
^XWB(8994,2927,2,1,1,0)="^^3^3^3111222^"
^XWB(8994,2927,2,1,1,1,0)="IEN = Request internal number"
^XWB(8994,2927,2,1,1,2,0)="      or "
^XWB(8994,2927,2,1,1,3,0)="      If SEL = ""R"" This is the patient DFN"
^XWB(8994,2927,2,2,0)="SEL^1^5^1^2"
^XWB(8994,2927,2,2,1,0)="^^10^10^3111222^"
^XWB(8994,2927,2,2,1,1,0)=" SEL = COMMENT SELECTION (required)"
^XWB(8994,2927,2,2,1,2,0)="     This is a string that will select what type of comments to return "
^XWB(8994,2927,2,2,1,3,0)="       I = INTERNAL COMMENTS (.32 FIELD)"
^XWB(8994,2927,2,2,1,4,0)="       P = PATIENT COMMENTS (.31 FIELD)"
^XWB(8994,2927,2,2,1,5,0)="       A = ALERTS FROM 19620.98"
^XWB(8994,2927,2,2,1,6,0)="       R = PATIENT RECORD - In this case the IEN is the patient DFN."
^XWB(8994,2927,2,2,1,7,0)="           If R is selected, it must be the only selection. "
^XWB(8994,2927,2,2,1,8,0)="     If more than one type of comment is desired, send the selection in a"
^XWB(8994,2927,2,2,1,9,0)="     carrot delimited string (ie. 'A^P^I'). The data will be returned in"
^XWB(8994,2927,2,2,1,10,0)="     the order it is requested."
^XWB(8994,2927,2,"B","IEN",1)=""
^XWB(8994,2927,2,"B","SEL",2)=""
^XWB(8994,2927,2,"PARAMSEQ",1,1)=""
^XWB(8994,2927,2,"PARAMSEQ",2,2)=""
^XWB(8994,2927,3,0)="^8994.03^16^16^3111222^^^^"
^XWB(8994,2927,3,1,0)="  RETURN VALUES"
^XWB(8994,2927,3,2,0)=" "
^XWB(8994,2927,3,3,0)=" THE COMMENTS ARE PRECEDED BY A HEADER RECORD AS FOLLOWS:"
^XWB(8994,2927,3,4,0)=" "
^XWB(8994,2927,3,5,0)="  $$INTERNALCOMMENTS$$  (INDICATES THAT INTERNAL COMMENTS FOLLOW)"
^XWB(8994,2927,3,6,0)="  internal comment line 1 ---- ----------- ---------- ------- ----------"
^XWB(8994,2927,3,7,0)="  internal comment line 2 --------- --------- ---- ----------- ---------"
^XWB(8994,2927,3,8,0)="  ....."
^XWB(8994,2927,3,9,0)="  internal comment line n --- ----------- ---------- ------ ------------"
^XWB(8994,2927,3,10,0)="  $$PATIENTCOMMENTS$$   (INDICATES THAT PATIENT COMMENTS FOLLOW)"
^XWB(8994,2927,3,11,0)="  patient comment line 1 ---- ----------- ---------- ------- ----------"
^XWB(8994,2927,3,12,0)="  patient comment line 2 --------- --------- ---- ----------- ---------"
^XWB(8994,2927,3,13,0)="  ....."
^XWB(8994,2927,3,14,0)="  patient comment line n --- ----------- ---------- ------ ------------"
^XWB(8994,2927,3,15,0)=" "
^XWB(8994,2927,3,16,0)="  NOTE: IF THERE ARE NO COMMENTS, THE ROUTINE RETURNS HEADERS ONLY"
^XWB(8994,2928,0)="DSIROI1 QUEUELBL QUEUE A LABEL^QUEUELBL^DSIROI1^1"
^XWB(8994,2928,1,0)="^8994.01^2^2^3110412^^"
^XWB(8994,2928,1,1,0)="This routine adds a label to an individual clerk's queue for batch "
^XWB(8994,2928,1,2,0)="printing."
^XWB(8994,2928,2,0)="^8994.02A^4^3"
^XWB(8994,2928,2,2,0)="CIEN^1^20^1^1"
^XWB(8994,2928,2,2,1,0)="^^1^1^3110412^"
^XWB(8994,2928,2,2,1,1,0)="CIEN is the clerk IEN.  This points at file 200."
^XWB(8994,2928,2,3,0)="RIEN^1^20^1^2"
^XWB(8994,2928,2,3,1,0)="^^1^1^3110412^"
^XWB(8994,2928,2,3,1,1,0)="RIEN is the requestor IEN.  This points to file 19620.12."
^XWB(8994,2928,2,4,0)="AIEN^1^20^1^3"
^XWB(8994,2928,2,4,1,0)="^^1^1^3110412^"
^XWB(8994,2928,2,4,1,1,0)="AIEN is the address IEN.  This points at file 19620.92."
^XWB(8994,2928,2,"B","AIEN",4)=""
^XWB(8994,2928,2,"B","CIEN",2)=""
^XWB(8994,2928,2,"B","RIEN",3)=""
^XWB(8994,2928,2,"PARAMSEQ",1,2)=""
^XWB(8994,2928,2,"PARAMSEQ",2,3)=""
^XWB(8994,2928,2,"PARAMSEQ",3,4)=""
^XWB(8994,2928,3,0)="^8994.03^5^5^3110412^^"
^XWB(8994,2928,3,1,0)="RETURNS "
^XWB(8994,2928,3,2,0)="   ##^LABEL QUEUED FOR PRINTING"
^XWB(8994,2928,3,3,0)="   where ## = ien in label file (19620.14)"
^XWB(8994,2928,3,4,0)=" "
^XWB(8994,2928,3,5,0)="  or -1^error message"
^XWB(8994,2929,0)="DSIROI1 PRINTLBL PRINT LABELS^PRINTLBL^DSIROI1^4^^^^1"
^XWB(8994,2929,1,0)="^8994.01^1^1^3110412^^^"
^XWB(8994,2929,1,1,0)="This procedure returns a clerk's batch labels for printing.vels"
^XWB(8994,2929,2,0)="^8994.02A^1^1"
^XWB(8994,2929,2,1,0)="CIEN^1^20^1^1"
^XWB(8994,2929,2,1,1,0)="^8994.021^1^1^3110412^^^"
^XWB(8994,2929,2,1,1,1,0)="This is the IEN for file 200 for the requesting clerk."
^XWB(8994,2929,2,"B","CIEN",1)=""
^XWB(8994,2929,2,"PARAMSEQ",1,1)=""
^XWB(8994,2929,3,0)="^8994.03^13^13^3110412^^"
^XWB(8994,2929,3,1,0)="RETURNS an array or lines of text as follows:"
^XWB(8994,2929,3,2,0)=" "
^XWB(8994,2929,3,3,0)="$$LABEL$$^IEN for Requestor(19620.12)^IEN for Requestor Address(19620.92)"
^XWB(8994,2929,3,4,0)="label line 1"
^XWB(8994,2929,3,5,0)="sabel line 2"
^XWB(8994,2929,3,6,0)="....."
^XWB(8994,2929,3,7,0)="label line n where n can be up to 6 lines - no blank lines are returned"
^XWB(8994,2929,3,8,0)="$$LABEL$$^IEN for Requestor(19620.12)^IEN for Requestor Address(19620.92)"
^XWB(8994,2929,3,9,0)="..."
^XWB(8994,2929,3,10,0)="next label text"
^XWB(8994,2929,3,11,0)="..."
^XWB(8994,2929,3,12,0)=" "
^XWB(8994,2929,3,13,0)=" or -1^error message"
^XWB(8994,2930,0)="DSIROI1 PURGELBL PURGE LABELS^PURGELBL^DSIROI1^1"
^XWB(8994,2930,1,0)="^8994.01^1^1^3110412^^"
^XWB(8994,2930,1,1,0)="Purges all labels queued for a specific clerk."
^XWB(8994,2930,2,0)="^8994.02A^1^1"
^XWB(8994,2930,2,1,0)="CIEN^1^20^1^1"
^XWB(8994,2930,2,1,1,0)="^8994.021^1^1^3110412^^"
^XWB(8994,2930,2,1,1,1,0)="This is the IEN of file 200 for the requesting clerk."
^XWB(8994,2930,2,"B","CIEN",1)=""
^XWB(8994,2930,2,"PARAMSEQ",1,1)=""
^XWB(8994,2930,3,0)="^8994.03^1^1^3110412^^"
^XWB(8994,2930,3,1,0)="RETURNS ##^LABELS PURGED"
^XWB(8994,2931,0)="DSIROI1 DEL1LBL DELETE 1 LABEL^DEL1LBL^DSIROI1^1"
^XWB(8994,2931,1,0)="^8994.01^1^1^3110412^^"
^XWB(8994,2931,1,1,0)="This routine deletes one label from the label file (19620.14.)"
^XWB(8994,2931,2,0)="^8994.02A^3^3"
^XWB(8994,2931,2,1,0)="CIEN^1^20^1^1"
^XWB(8994,2931,2,1,1,0)="^8994.021^1^1^3110412^^"
^XWB(8994,2931,2,1,1,1,0)="Clerk ID is the IEN from file 200 for the requesting clerk."
^XWB(8994,2931,2,2,0)="RIEN^1^20^1^2"
^XWB(8994,2931,2,2,1,0)="^^1^1^3110412^"
^XWB(8994,2931,2,2,1,1,0)="RIEN is the Requestor IEN.  This points to file 19620.12"
^XWB(8994,2931,2,3,0)="AIEN^1^20^1^3"
^XWB(8994,2931,2,3,1,0)="^^1^1^3110412^"
^XWB(8994,2931,2,3,1,1,0)="AIEN is the IEN of the address record.  This points at file 19620.92."
^XWB(8994,2931,2,"B","AIEN",3)=""
^XWB(8994,2931,2,"B","CIEN",1)=""
^XWB(8994,2931,2,"B","RIEN",2)=""
^XWB(8994,2931,2,"PARAMSEQ",1,1)=""
^XWB(8994,2931,2,"PARAMSEQ",2,2)=""
^XWB(8994,2931,2,"PARAMSEQ",3,3)=""
^XWB(8994,2931,3,0)="^8994.03^5^5^3110412^^"
^XWB(8994,2931,3,1,0)=" RETURNS "
^XWB(8994,2931,3,2,0)="    ##^LABEL DELETED"
^XWB(8994,2931,3,3,0)="    where ## = ien in label file (19620.14)"
^XWB(8994,2931,3,4,0)=" "
^XWB(8994,2931,3,5,0)="   or -1^error message"
^XWB(8994,2932,0)="DSIROIU LSTIN GET LAST INSTALL^LSTIN^DSIROIU^1"
^XWB(8994,2932,1,0)="^8994.01^2^2^3110525^"
^XWB(8994,2932,1,1,0)="This RPC call returns the latest BUILD name installed in the DSIR "
^XWB(8994,2932,1,2,0)="package. "
^XWB(8994,2932,3,0)="^^6^6^3110525^"
^XWB(8994,2932,3,1,0)="Returns are as follows:"
^XWB(8994,2932,3,2,0)=" -1^error message"
^XWB(8994,2932,3,3,0)=" or "
^XWB(8994,2932,3,4,0)=" Version #"
^XWB(8994,2932,3,5,0)=" or "
^XWB(8994,2932,3,6,0)=" 0 if no version found"
^XWB(8994,2934,0)="PRSN NURS LOCATION EXTRACTION^NURSLOC^PRSN9A^4^A^0^^1"
^XWB(8994,2934,1,0)="^^21^21^3120105^"
^XWB(8994,2934,1,1,0)="VANOD shall have the ability to extract data from the Nursing Location "
^XWB(8994,2934,1,2,0)="(file # 211.4)."
^XWB(8994,2934,1,3,0)=" "
^XWB(8994,2934,1,4,0)="For inpatient settings the location data can be used by VANOD as a map "
^XWB(8994,2934,1,5,0)="between nurse POC data and the patients for whom they provide care.  For "
^XWB(8994,2934,1,6,0)="other care settings the location data can be used to report an activity."
^XWB(8994,2934,1,7,0)=" "
^XWB(8994,2934,1,8,0)="Input Parameter"
^XWB(8994,2934,1,9,0)=" "
^XWB(8994,2934,1,10,0)="Parameter 1:"
^XWB(8994,2934,1,11,0)="The date is in format 'YYYYMMDD' is optional. If there is no"
^XWB(8994,2934,1,12,0)="date then the defult date will be 'TODAY'. The Nursing Location output"
^XWB(8994,2934,1,13,0)="provided in this RPC shall only include data for locations that are active"
^XWB(8994,2934,1,14,0)="in any one of the day # of the Pay Period of the parameter date. If the"
^XWB(8994,2934,1,15,0)="current date is between day 1 and day 11 of the pay period, the Nursing"
^XWB(8994,2934,1,16,0)="Locations RPC shall return locations that were active for the prior pay"
^XWB(8994,2934,1,17,0)="period with the data that currently resides in the NURS LOCATION file"
^XWB(8994,2934,1,18,0)="(211.4).  If the current date is between day 12 and day 14 of the pay"
^XWB(8994,2934,1,19,0)="period the Nursing Locations RPC shall return locations that are active"
^XWB(8994,2934,1,20,0)="for the current pay period with the data that currently resides in the"
^XWB(8994,2934,1,21,0)="NURS LOCATION file (211.4)."
^XWB(8994,2934,2,0)="^8994.02A^1^1"
^XWB(8994,2934,2,1,0)="PRSNDT^1^15^0^1"
^XWB(8994,2934,2,1,1,0)="^^3^3^3120105^"
^XWB(8994,2934,2,1,1,1,0)="The PRSNDT is, in date format 'YYYYMMDD', for extracting all NURS"
^XWB(8994,2934,2,1,1,2,0)="LOCATIONS and their assocated Wards in File #211.4 that is active in any"
^XWB(8994,2934,2,1,1,3,0)="one of the Day# (1-14) of the Pay Period of the PRSNDT."
^XWB(8994,2934,2,"B","PRSNDT",1)=""
^XWB(8994,2934,2,"PARAMSEQ",1,1)=""
^XWB(8994,2934,3,0)="^^32^32^3120105^"
^XWB(8994,2934,3,1,0)="The PEV RPC shall provide a VistA temporary global array of records with "
^XWB(8994,2934,3,2,0)="the name provided with the input parameter 1."
^XWB(8994,2934,3,3,0)=" "
^XWB(8994,2934,3,4,0)="Header Node"
^XWB(8994,2934,3,5,0)="This global array shall have a header node with index 0.  The header node "
^XWB(8994,2934,3,6,0)="is a literal string with delimiter '^'.  Data returned in the header node "
^XWB(8994,2934,3,7,0)="is defined as follows:"
^XWB(8994,2934,3,8,0)=" "
^XWB(8994,2934,3,9,0)="Delimiter       Piece # Data Description"
^XWB(8994,2934,3,10,0)="^       1       Site Name (STATION NUMBER) of VistA Database"
^XWB(8994,2934,3,11,0)="^       2       Total Number of Records Extracted"
^XWB(8994,2934,3,12,0)=" "
^XWB(8994,2934,3,13,0)="Data Nodes"
^XWB(8994,2934,3,14,0)=" "
^XWB(8994,2934,3,15,0)="The output shall be an array of records indexed by sequence number "
^XWB(8994,2934,3,16,0)="beginning at 1.  Each record is a delimited literal string defined as "
^XWB(8994,2934,3,17,0)="follows:"
^XWB(8994,2934,3,18,0)=" "
^XWB(8994,2934,3,19,0)="Delimiter       Piece # Data Description"
^XWB(8994,2934,3,20,0)="^       1       IEN of Nurse Location File #211.4"
^XWB(8994,2934,3,21,0)="^       2       Record Type: L for Location, W for MAS Ward"
^XWB(8994,2934,3,22,0)="^       3       IEN of Hospital Location File #44"
^XWB(8994,2934,3,23,0)="^       4       Hospital Location Name"
^XWB(8994,2934,3,24,0)="^       5       DIVISION (INSTITUTION FILE #4 IEN as defined in the "
^XWB(8994,2934,3,25,0)="                computed expression in .02 field of file 211.4)"
^XWB(8994,2934,3,26,0)="^       6       INSTITUTION FILE NAME"
^XWB(8994,2934,3,27,0)="^       7       Care Setting (I=inpatient/O=other)"
^XWB(8994,2934,3,28,0)="^       8       Pt. Pop (VANOD Unit Type)"
^XWB(8994,2934,3,29,0)="^       9       IEN of MAS Ward File (#42)"
^XWB(8994,2934,3,30,0)="^       10      MAS Ward Name"
^XWB(8994,2934,3,31,0)="^       11      DSS Department"
^XWB(8994,2934,3,32,0)="^       12      Site Name (STATION NUMBER) of VistA Database"
^XWB(8994,2935,0)="PRSN POC DAILY TIME EXTRACTION^POCTIME^PRSN9B^4^A^0^^1"
^XWB(8994,2935,1,0)="^8994.01^13^13^3111209^^^^"
^XWB(8994,2935,1,1,0)="VANOD shall have the ability to extract data from the POC DAILY ACTIVITY"
^XWB(8994,2935,1,2,0)="EXTRACTION File (#451.7)."
^XWB(8994,2935,1,3,0)=" "
^XWB(8994,2935,1,4,0)="Input Parameters: The PEV RPC Broker call shall be called with the"
^XWB(8994,2935,1,5,0)="following input parameters."
^XWB(8994,2935,1,6,0)=" "
^XWB(8994,2935,1,7,0)="Parameter 1:  Integer - records with a sequence number greater than"
^XWB(8994,2935,1,8,0)="this value shall be returned, in sequence.  If you want to return "
^XWB(8994,2935,1,9,0)="records starting at the beginning of the file then a value of 0 should "
^XWB(8994,2935,1,10,0)="be sent as this parameter.  The number of records returned shall not"
^XWB(8994,2935,1,11,0)="exceed the value passed in parameter 2."
^XWB(8994,2935,1,12,0)=" "
^XWB(8994,2935,1,13,0)="Parameter 2:  Integer - Maximum number of records to be returned."
^XWB(8994,2935,2,0)="^8994.02A^4^2"
^XWB(8994,2935,2,3,0)="PRSNSEQ^1^15^1^1"
^XWB(8994,2935,2,3,1,0)="^^4^4^3090731^"
^XWB(8994,2935,2,3,1,1,0)="Any records in POC DAILY ACTIVITY EXTRACTION File (#451.7) with a sequence"
^XWB(8994,2935,2,3,1,2,0)="number greater than this value shall be returned, in sequence.  The number"
^XWB(8994,2935,2,3,1,3,0)="of records returned shall not exceed the value passed in parameter"
^XWB(8994,2935,2,3,1,4,0)="PRSNREC."
^XWB(8994,2935,2,4,0)="PRSNREC^1^15^1^2"
^XWB(8994,2935,2,4,1,0)="^^1^1^3111209^"
^XWB(8994,2935,2,4,1,1,0)="This is the Maximum number of records to be returned."
^XWB(8994,2935,2,"B","PRSNREC",4)=""
^XWB(8994,2935,2,"B","PRSNSEQ",3)=""
^XWB(8994,2935,2,"PARAMSEQ",1,3)=""
^XWB(8994,2935,2,"PARAMSEQ",2,4)=""
^XWB(8994,2935,3,0)="^^66^66^3111209^"
^XWB(8994,2935,3,1,0)="The PEV RPC Broker call shall provide a VistA temporary global array of "
^XWB(8994,2935,3,2,0)="records with the name provided with the input parameter 1."
^XWB(8994,2935,3,3,0)=" "
^XWB(8994,2935,3,4,0)="Header Node"
^XWB(8994,2935,3,5,0)="This global array shall have a header node with index 0.  The header node "
^XWB(8994,2935,3,6,0)="is a literal string with delimiter  ^ .  Data returned in the header node "
^XWB(8994,2935,3,7,0)="is defined as follows:"
^XWB(8994,2935,3,8,0)=" "
^XWB(8994,2935,3,9,0)="Delimiter       Piece # Data Description"
^XWB(8994,2935,3,10,0)="^       1       Site Name (STATION NUMBER) of VistA database"
^XWB(8994,2935,3,11,0)="^       2       Sequence # of first record in returned data"
^XWB(8994,2935,3,12,0)="^       3       Sequence # of last record returned"
^XWB(8994,2935,3,13,0)="^       4       Total number of records returned"
^XWB(8994,2935,3,14,0)="^       5       Sequence # of last record currently in Nurse POC "
^XWB(8994,2935,3,15,0)="                Extraction file (#541.7)"
^XWB(8994,2935,3,16,0)=" "
^XWB(8994,2935,3,17,0)="Data Nodes"
^XWB(8994,2935,3,18,0)="The output shall be an array of records indexed by sequence number as "
^XWB(8994,2935,3,19,0)="defined by the input parameters.  Each record is a delimited literal "
^XWB(8994,2935,3,20,0)="string defined as follows:"
^XWB(8994,2935,3,21,0)=" "
^XWB(8994,2935,3,22,0)="Delimiter       Piece # Data Description"
^XWB(8994,2935,3,23,0)="^       1       Sequence Number"
^XWB(8994,2935,3,24,0)="^       2       Division IEN of Nurse Primary Location"
^XWB(8994,2935,3,25,0)="^       3       Division IEN of Nurse Location Worked"
^XWB(8994,2935,3,26,0)="^       4       Version Number (Sequence Number of Times of Reconciled) "
^XWB(8994,2935,3,27,0)="^       5       Nurse ID (SS# without  - )"
^XWB(8994,2935,3,28,0)="^       6       IEN (Internal Entry Number) of File #450 Paid Employee"
^XWB(8994,2935,3,29,0)="^       7       Time Record Date (YYYYMMDD)"
^XWB(8994,2935,3,30,0)="^       8       Start Time (0000 - 2345)"
^XWB(8994,2935,3,31,0)="^       9       Stop Time (0015 - 2400) (stop time must be greater start"
^XWB(8994,2935,3,32,0)="                time)"
^XWB(8994,2935,3,33,0)="^       10      Type of Time"
^XWB(8994,2935,3,34,0)="^       11      Point of Care derived from  NURS LOCATION 211.4"
^XWB(8994,2935,3,35,0)="^       12      Mandatory Overtime (M or V)"
^XWB(8994,2935,3,36,0)="^       13      Reason for Overtime "
^XWB(8994,2935,3,37,0)="^       14      Types of Work"
^XWB(8994,2935,3,38,0)="^       15      Release Date (CYYMMDD) "
^XWB(8994,2935,3,39,0)="^       16      Nurse T&L Unit at time of POC approval"
^XWB(8994,2935,3,40,0)=" "
^XWB(8994,2935,3,41,0)="Version Number (Piece 4)   Full Day Substitution"
^XWB(8994,2935,3,42,0)="The records with highest version number are the most recently released "
^XWB(8994,2935,3,43,0)="data records.  Records with version number one are original records.  "
^XWB(8994,2935,3,44,0)="Records with a version number greater than 1 are corrections to records "
^XWB(8994,2935,3,45,0)="that have been released previously."
^XWB(8994,2935,3,46,0)="The highest version number for a nurse and a date  is a replacement for "
^XWB(8994,2935,3,47,0)="all data for the earlier version of the data for that nurse on that date. "
^XWB(8994,2935,3,48,0)="(Full day substitution)."
^XWB(8994,2935,3,49,0)="It may be necessary to provide VANOD with a correction to a day off where "
^XWB(8994,2935,3,50,0)="overtime was incorrectly reported and there was no activity on that day.  "
^XWB(8994,2935,3,51,0)="The RPC shall return a record with identifiers but no activity data for "
^XWB(8994,2935,3,52,0)="that day (see sample record 28)."
^XWB(8994,2935,3,53,0)=" "
^XWB(8994,2935,3,54,0)="Seq#    Div.    Sta #   Version #       Nurse ID        Nurse IEN 450"
^XWB(8994,2935,3,55,0)="FM Date   Start Time      Stop Time       Type of Time    Point of Care   "
^XWB(8994,2935,3,56,0)="Mand.  OT       Reason for overtime     Type of Work"
^XWB(8994,2935,3,57,0)="25      688     688     1               000-45-8452     13418"
^XWB(8994,2935,3,58,0)="20091016  0700            1000            Tour Time       2841"
^XWB(8994,2935,3,59,0)="26      7818    688     1               000-45-8452     13418"
^XWB(8994,2935,3,60,0)="20091016  1000            1900            Tour Time       2841"
^XWB(8994,2935,3,61,0)="                                        Sitter"
^XWB(8994,2935,3,62,0)="27      7819    688     1               000-45-8452     13418"
^XWB(8994,2935,3,63,0)="20091016  1900            2100            Overtime        1677"
^XWB(8994,2935,3,64,0)="Mandatory"
^XWB(8994,2935,3,65,0)="28      7736    688     2               000-22-9999     2088    "
^XWB(8994,2935,3,66,0)="20090912  0700            1530            Tour Time       2841"
^XWB(8994,2936,0)="NUPA PAST/FUTURE DATE^PF^NUPABCL^1^^^^1"
^XWB(8994,2936,1,0)="^^2^2^3110707^"
^XWB(8994,2936,1,1,0)="Returns a 1 or a 0 when checking to see if a date is in the past or "
^XWB(8994,2936,1,2,0)="future, based on $H.  "
^XWB(8994,2936,2,0)="^8994.02A^2^2"
^XWB(8994,2936,2,1,0)="VAR 1^1^30^1^1"
^XWB(8994,2936,2,1,1,0)="^^1^1^3110707^"
^XWB(8994,2936,2,1,1,1,0)="The date you want to check.  Should be in ""7/7/11@12:30:00 PM"" format."
^XWB(8994,2936,2,2,0)="VAR 2^1^1^1^2"
^XWB(8994,2936,2,2,1,0)="^^2^2^3110707^"
^XWB(8994,2936,2,2,1,1,0)="Variable should be set to ""P"" if you want to see if the date is in the "
^XWB(8994,2936,2,2,1,2,0)="past, or set it to ""F"" if you want to see if it's in the future."
^XWB(8994,2936,2,"B","VAR 1",1)=""
^XWB(8994,2936,2,"B","VAR 2",2)=""
^XWB(8994,2936,2,"PARAMSEQ",1,1)=""
^XWB(8994,2936,2,"PARAMSEQ",2,2)=""
^XWB(8994,2936,3,0)="^^1^1^3110707^"
^XWB(8994,2936,3,1,0)="Will be a 1 or 0 based upon the future/past parameter."
^XWB(8994,2937,0)="NUPA GET CAREPLAN DA^CPID^NUPABCL1^1^^^^1"
^XWB(8994,2937,1,0)="^8994.01^2^2^3110720^^"
^XWB(8994,2937,1,1,0)="Gets the DA of the latest care plan, or creates a new one if none on "
^XWB(8994,2937,1,2,0)="file since the last admission."
^XWB(8994,2937,2,0)="^8994.02A^1^1"
^XWB(8994,2937,2,1,0)="DFN^1^99^1^1"
^XWB(8994,2937,2,1,1,0)="^^1^1^3110720^"
^XWB(8994,2937,2,1,1,1,0)="Patient's DFN."
^XWB(8994,2937,2,"B","DFN",1)=""
^XWB(8994,2937,2,"PARAMSEQ",1,1)=""
^XWB(8994,2937,3,0)="^^1^1^3110720^"
^XWB(8994,2937,3,1,0)="Returns the DA from file 1927.4."
^XWB(8994,2938,0)="NUPA CAREPLAN PROBS^PICP^NUPABCL1^4^^^^1"
^XWB(8994,2938,1,0)="^^2^2^3090708^"
^XWB(8994,2938,1,1,0)="Provides a list of the problems and interventions for a patient's care"
^XWB(8994,2938,1,2,0)="plan for the current admission."
^XWB(8994,2938,2,0)="^8994.02A^1^1"
^XWB(8994,2938,2,1,0)="DA ^1^^1^1"
^XWB(8994,2938,2,1,1,0)="^^1^1^3090902^"
^XWB(8994,2938,2,1,1,1,0)="IEN of the Care Plan from file 1927.4."
^XWB(8994,2938,2,"B","DA ",1)=""
^XWB(8994,2938,2,"PARAMSEQ",1,1)=""
^XWB(8994,2938,3,0)="^^23^23^3090929^"
^XWB(8994,2938,3,1,0)="Returns a list of problems & interventions from the latest care plan in "
^XWB(8994,2938,3,2,0)="^TMP($J).  Global looks like this:"
^XWB(8994,2938,3,3,0)=" "
^XWB(8994,2938,3,4,0)="^TMP(562303312,""MH"",1176)=MH^Mental Health^Anxiety (Actual)^9/25/09@1407^"
^XWB(8994,2938,3,5,0)="Minimize the feelings of anxiety related to unidentified sources of"
^XWB(8994,2938,3,6,0)="anticipated danger^No change/stable^ 9/29/09@0842^Education - Encourage"
^XWB(8994,2938,3,7,0)="meditation to reduce anxiety^ 9/25/09@1407^Not on file^Not on file^"
^XWB(8994,2938,3,8,0)="167^1176^"
^XWB(8994,2938,3,9,0)=" "
^XWB(8994,2938,3,10,0)="Pieces are:"
^XWB(8994,2938,3,11,0)=" "
^XWB(8994,2938,3,12,0)="1. Tab in the exe"
^XWB(8994,2938,3,13,0)="2. Problem name"
^XWB(8994,2938,3,14,0)="3. Date problem indentified"
^XWB(8994,2938,3,15,0)="4. Desired outcome"
^XWB(8994,2938,3,16,0)="5. Last problem evaluation"
^XWB(8994,2938,3,17,0)="6. Problem evaluation date"
^XWB(8994,2938,3,18,0)="7. Intervention"
^XWB(8994,2938,3,19,0)="8. Intervention date"
^XWB(8994,2938,3,20,0)="9. Intervention status"
^XWB(8994,2938,3,21,0)="10. Intervention status date"
^XWB(8994,2938,3,22,0)="11. Problem IEN from file 1927.2"
^XWB(8994,2938,3,23,0)="12. Intervention IEN from file 1927.24"
^XWB(8994,2939,0)="NUPA SET PU AND ALT^SL^NUPABCL2^1^^^^1"
^XWB(8994,2939,1,0)="^^2^2^3111119^"
^XWB(8994,2939,1,1,0)="Sets Pressure Ulcer and Skin Alteration data.  Deletes old info for this "
^XWB(8994,2939,1,2,0)="careplan and inserts from the reassessment."
^XWB(8994,2939,2,0)="^8994.02A^1^1"
^XWB(8994,2939,2,1,0)="ALT^2^999^1^1"
^XWB(8994,2939,2,1,1,0)="^^10^10^3111119^"
^XWB(8994,2939,2,1,1,1,0)=" String List."
^XWB(8994,2939,2,1,1,2,0)="  "
^XWB(8994,2939,2,1,1,3,0)=" Piece 1 = ""A"" for alterations or ""U"" for pressure ulcers"
^XWB(8994,2939,2,1,1,4,0)=" Piece 2 = CarePlan DA"
^XWB(8994,2939,2,1,1,5,0)=" Piece 3 = Text field 1 from the reassessment"
^XWB(8994,2939,2,1,1,6,0)=" Piece 4 = Text field 2 from the reassessment"
^XWB(8994,2939,2,1,1,7,0)=" Piece 5 = Text field 3 from the reassessment"
^XWB(8994,2939,2,1,1,8,0)=" Piece 6 = Comments number of Lines"
^XWB(8994,2939,2,1,1,9,0)=" Piece 7 = Comments Text"
^XWB(8994,2939,2,1,1,10,0)=" Piece 8 = A 1 if the alteration is healed"
^XWB(8994,2939,2,"B","ALT",1)=""
^XWB(8994,2939,2,"PARAMSEQ",1,1)=""
^XWB(8994,2939,3,0)="^8994.03^1^1^3111119^^^^"
^XWB(8994,2939,3,1,0)="1 if successful, 0 if not."
^XWB(8994,2940,0)="NUPA WP GET^WPGET^NUPABCL^4^^^^1"
^XWB(8994,2940,1,0)="^^1^1^3090708^"
^XWB(8994,2940,1,1,0)="Returns data from a Word Processing field."
^XWB(8994,2940,2,0)="^8994.02A^3^3"
^XWB(8994,2940,2,1,0)="FILE^1^^1^1"
^XWB(8994,2940,2,1,1,0)="^^1^1^3090902^"
^XWB(8994,2940,2,1,1,1,0)="File to get the data from, in ^FILE(subscript, format."
^XWB(8994,2940,2,2,0)="IEN^1^^1^2"
^XWB(8994,2940,2,2,1,0)="^^2^2^3090902^"
^XWB(8994,2940,2,2,1,1,0)="Line number for the data to be put into, in number_"","" format"
^XWB(8994,2940,2,2,1,2,0)="such as ""1,""."
^XWB(8994,2940,2,3,0)="NODE^1^^1^3"
^XWB(8994,2940,2,3,1,0)="^^1^1^3090902^"
