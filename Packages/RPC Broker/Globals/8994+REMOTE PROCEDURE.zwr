^XWB(8994,3580,0)="SDEC PTSET^PTSET^SDEC^4^R^0^^0"
^XWB(8994,3580,1,0)="^8994.01^1^1^3161104^^^"
^XWB(8994,3580,1,1,0)="SET patient demographics"
^XWB(8994,3580,2,0)="^8994.02A^1^1"
^XWB(8994,3580,2,1,0)="INP^4^^1^1"
^XWB(8994,3580,2,1,1,0)="^^77^77^3161104^"
^XWB(8994,3580,2,1,1,1,0)="all input except DFN is optional"
^XWB(8994,3580,2,1,1,2,0)="   INP(1) = DFN - (required) pointer to PATIENT file"
^XWB(8994,3580,2,1,1,3,0)="   INP(2) = RACE - pointer to the RACE file 10 separated by |"
^XWB(8994,3580,2,1,1,4,0)="            Each pipe piece contains the following pieces"
^XWB(8994,3580,2,1,1,5,0)="           (Race1;;Method1|Race2;;Method2):"
^XWB(8994,3580,2,1,1,6,0)="             RACE INFORMATION - pointer to the RACE file 10"
^XWB(8994,3580,2,1,1,7,0)="                               Use @ to delete"
^XWB(8994,3580,2,1,1,8,0)="             METHOD OF COLLECTION - pointer to the RACE AND ETHNICITY"
^XWB(8994,3580,2,1,1,9,0)="                                    COLLECTION METHOD file 10.3"
^XWB(8994,3580,2,1,1,10,0)="            ""2;;1|@12|13;;1"" will add/update 2 & 13 and delete 12"
^XWB(8994,3580,2,1,1,11,0)="   INP(3) = ETHNICITY - Note that the ETHNICITY INFORMATION multiple"
^XWB(8994,3580,2,1,1,12,0)="                        only allows 1 entry."
^XWB(8994,3580,2,1,1,13,0)="                   input contains the following ;; pieces:"
^XWB(8994,3580,2,1,1,14,0)="         1. ETHNICITY INFORMATION - pointer to the ETHNICITY file 10.2"
^XWB(8994,3580,2,1,1,15,0)="                                    @ will delete"
^XWB(8994,3580,2,1,1,16,0)="         2. METHOD OF COLLECTION - pointer to the"
^XWB(8994,3580,2,1,1,17,0)="                                 ETHNICITY COLLECTION METHOD file 10.3"
^XWB(8994,3580,2,1,1,18,0)="          '@4;;1' or just '@' will delete;  '5;;1' will add 5;"
^XWB(8994,3580,2,1,1,19,0)="   INP(4) = ADDRESS1 - Street Address (Line 1) Free text"
^XWB(8994,3580,2,1,1,20,0)="                       3-30 characters"
^XWB(8994,3580,2,1,1,21,0)="                       @ will delete the existing entry"
^XWB(8994,3580,2,1,1,22,0)="   INP(5) = ADDRESS2 - Street Address (Line 2) Free text"
^XWB(8994,3580,2,1,1,23,0)="                       3-30 characters"
^XWB(8994,3580,2,1,1,24,0)="                       @ will delete the existing entry"
^XWB(8994,3580,2,1,1,25,0)="   INP(6) = ADDRESS3 - Street Address (Line 3) Free text"
^XWB(8994,3580,2,1,1,26,0)="                       3-30 characters"
^XWB(8994,3580,2,1,1,27,0)="                       @ will delete the existing entry"
^XWB(8994,3580,2,1,1,28,0)="   INP(7) = ZIP CODE - Zip+4 Free text of 5 or 9 digits"
^XWB(8994,3580,2,1,1,29,0)="                       This populates fields .116 and .1112"
^XWB(8994,3580,2,1,1,30,0)="   INP(8) = CITY - Free text 2-15 characters"
^XWB(8994,3580,2,1,1,31,0)="   INP(9) = STATE - pointer to STATE file 5"
^XWB(8994,3580,2,1,1,32,0)="   INP(10) = COUNTRY - pointer to COUNTRY CODE file 779.004"
^XWB(8994,3580,2,1,1,33,0)="   INP(11) = BAD ADDRESS INDICATOR - Valid Values:"
^XWB(8994,3580,2,1,1,34,0)="                 UNDELIVERABLE"
^XWB(8994,3580,2,1,1,35,0)="                 HOMELESS"
^XWB(8994,3580,2,1,1,36,0)="                 OTHER"
^XWB(8994,3580,2,1,1,37,0)="                 ADDRESS NOT FOUND"
^XWB(8994,3580,2,1,1,38,0)="                 @ will delete the existing entry"
^XWB(8994,3580,2,1,1,39,0)="   INP(12) = PHONE (RESIDENCE) - free text 4-20 characters"
^XWB(8994,3580,2,1,1,40,0)="                                 @ will delete the existing entry"
^XWB(8994,3580,2,1,1,41,0)="   INP(13) = PHONE (WORK) - free text 4-20 characters"
^XWB(8994,3580,2,1,1,42,0)="                            @ will delete the existing entry"
^XWB(8994,3580,2,1,1,43,0)="   INP(14) = COUNTY name - name of a county from the COUNTY multiple"
^XWB(8994,3580,2,1,1,44,0)="                           in the STATE file (#5)"
^XWB(8994,3580,2,1,1,45,0)="   INP(15) = PHONE NUMBER [CELLULAR] 4-20 characters"
^XWB(8994,3580,2,1,1,46,0)="                           @ will delete the existing entry"
^XWB(8994,3580,2,1,1,47,0)="   INP(16) = Patient Email Address - 3-50 characters containing 1 @"
^XWB(8994,3580,2,1,1,48,0)="                   A single character @ will delete the existing entry"
^XWB(8994,3580,2,1,1,49,0)="   INP(17) = Marital Status - pointer to MARITAL STATUS file (#11)"
^XWB(8994,3580,2,1,1,50,0)="   INP(18) = Religious Preference - pointer to RELIGION file (#13)"
^XWB(8994,3580,2,1,1,51,0)="   INP(19) = Patient Temporary Address Active? (.12105) Y:YES N:NO"
^XWB(8994,3580,2,1,1,52,0)="             Temporary Address data can only be edited if INP(19) is"
^XWB(8994,3580,2,1,1,53,0)="            'Y' or the 'TEMPORARY ADDRESS ACTIVE?' field is already"
^XWB(8994,3580,2,1,1,54,0)="            defined as 'Y'."
^XWB(8994,3580,2,1,1,55,0)="   INP(20) = Patient Temporary Address Line 1 (.1211)"
^XWB(8994,3580,2,1,1,56,0)="             @ will delete the existing entry"
^XWB(8994,3580,2,1,1,57,0)="   INP(21) = Patient Temporary Address Line 2 (.1212)"
^XWB(8994,3580,2,1,1,58,0)="             @ will delete the existing entry"
^XWB(8994,3580,2,1,1,59,0)="   INP(22) = Patient Temporary Address Line 3 (.1213)"
^XWB(8994,3580,2,1,1,60,0)="             @ will delete the existing entry"
^XWB(8994,3580,2,1,1,61,0)="   INP(23) = Patient Temporary City (.1214)"
^XWB(8994,3580,2,1,1,62,0)="   INP(24) = Patient Temporary State (.1215)"
^XWB(8994,3580,2,1,1,63,0)="   INP(25) = Patient Temporary Zip (.1216)"
^XWB(8994,3580,2,1,1,64,0)="             [[***Don't use - INP(26) populates both***]]"
^XWB(8994,3580,2,1,1,65,0)="   INP(26) = Patient Temporary Zip+4 (.12112)"
^XWB(8994,3580,2,1,1,66,0)="             Populates fields .1216 and .12112"
^XWB(8994,3580,2,1,1,67,0)="   INP(27) = Patient Temporary Country (.1223)"
^XWB(8994,3580,2,1,1,68,0)="   INP(28) = Patient Temporary County (.12111)"
^XWB(8994,3580,2,1,1,69,0)="   INP(29) = Patient Temporary Phone (.1219)"
^XWB(8994,3580,2,1,1,70,0)="                     (also referred to as Phone #2)"
^XWB(8994,3580,2,1,1,71,0)="                     @ will delete the existing entry"
