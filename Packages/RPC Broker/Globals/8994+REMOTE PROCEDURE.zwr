^XWB(8994,3817,0)="XUS MVI NEW PERSON GET^GET^XUMVINPU^4^A^^^1^1^^0"
^XWB(8994,3817,1,0)="^8994.01^3^3^3190515^^^^"
^XWB(8994,3817,1,1,0)="This restricted RPC is used exclusively by the Master Veteran Index (MVI) "
^XWB(8994,3817,1,2,0)="to retrieve data (by DUZ, SECID, NPI or SSN) from the VistA NEW PERSON "
^XWB(8994,3817,1,3,0)="file (#200)."
^XWB(8994,3817,2,0)="^8994.02A^4^4"
^XWB(8994,3817,2,1,0)="DUZ^1^40^0^1"
^XWB(8994,3817,2,1,1,0)="^8994.021^1^1^3180309^^"
