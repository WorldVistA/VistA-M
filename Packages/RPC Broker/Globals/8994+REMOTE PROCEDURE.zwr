^XWB(8994,4553,3,0)="^8994.03^3^3^3250206^^^^"
^XWB(8994,4553,3,1,0)="RETURN VALUE  "
^XWB(8994,4553,3,2,0)="  1 MEANS VERIFICATION IS NEEDED"
^XWB(8994,4553,3,3,0)="  0 MEANS THERE IS ACTIVE INSURANCE OR VERIFICATION IS STARTED"
