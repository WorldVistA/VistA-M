^XWB(8994,4429,2,"PARAMSEQ",3,3)=""
^XWB(8994,4429,3,0)="^8994.03^20^20^3150618^^"
^XWB(8994,4429,3,1,0)="This RPC will return an array containing the results of the copy buffer"
^XWB(8994,4429,3,2,0)="background retrieval process.  If the process has not completed, it will"
^XWB(8994,4429,3,3,0)="return whatever entries have been completed.  When the process finally"
^XWB(8994,4429,3,4,0)="completes, the final return of data will contain a ""~DONE=1"" as the first "
^XWB(8994,4429,3,5,0)="array entry value, followed by any remaining entries.  Each return will"
^XWB(8994,4429,3,6,0)="only contain unique entries, so it will be additive."
^XWB(8994,4429,3,7,0)=" "
^XWB(8994,4429,3,8,0)="Output"
^XWB(8994,4429,3,9,0)="  ORY - Total number of unique entries^More Boolean (1=more data)"
^XWB(8994,4429,3,10,0)="  0RY(1..n,0) -"
^XWB(8994,4429,3,11,0)="     Piece 1: Date/Time of the copy"
^XWB(8994,4429,3,12,0)="     Piece 2: Date of the ^XTMP global creation"
^XWB(8994,4429,3,13,0)="     Piece 3: Package Prefix of application which captured the copy"
^XWB(8994,4429,3,14,0)="     Piece 4: Copy from location in 2 pieces (ien;package)"
^XWB(8994,4429,3,15,0)="     Piece 5: Number of lines of copied text"
^XWB(8994,4429,3,16,0)="  ORY(1..n,1..n) - Copied text"
^XWB(8994,4429,3,17,0)=" "
^XWB(8994,4429,3,18,0)="  Or Error condition:"
^XWB(8994,4429,3,19,0)="     ORY - ""-1^Error Msg"""
^XWB(8994,4429,3,20,0)="     ORY(-1)=Error Message"
