^XWB(8994,1002,3,0)="^8994.03^3^3^3100819^^^^"
^XWB(8994,1002,3,1,0)="This is a list of the file names and image file (#2005) references"
^XWB(8994,1002,3,2,0)="which could not successfully be evaluated by the purge process."
^XWB(8994,1002,3,3,0)="""filename^2005 ptr"""
^XWB(8994,1003,0)="MAGQ JH RPT^JHRPT^MAGQBJHR^2^R"
^XWB(8994,1003,1,0)="^8994.01^2^2^3000505^^"
^XWB(8994,1003,1,1,0)="Reports on the current set of Jukebox to harddisk (JBTOHD) processes (Who,"
^XWB(8994,1003,1,2,0)="queued, what patients, when, and workstation logons)"
^XWB(8994,1003,2,0)="^8994.02A^1^1"
^XWB(8994,1003,2,1,0)="null^^^0"
^XWB(8994,1003,2,1,1,0)="^^1^1^3000505^"
^XWB(8994,1003,2,1,1,1,0)="No input parameter is defined for this procedure."
^XWB(8994,1003,2,"B","null",1)=""
^XWB(8994,1003,3,0)="^^2^2^3000505^"
^XWB(8994,1003,3,1,0)="This array contains information regarding the queuer, the file types, and"
^XWB(8994,1003,3,2,0)="the patients involved in queues yet to be processed in the queue file."
^XWB(8994,1004,0)="MAGG PAT EACH IMAGE^EACHIMG^MAGGTIG^2^R"
^XWB(8994,1004,1,0)="^8994.01^5^5^3151123^^^^"
^XWB(8994,1004,1,1,0)="Returns a list of Images with Capture date/time, image description for"
^XWB(8994,1004,1,2,0)="each patient image, and it will list all images of all groups and all"
^XWB(8994,1004,1,3,0)="single images."
^XWB(8994,1004,1,4,0)="Called from capture application to list most recent images captured"
^XWB(8994,1004,1,5,0)="for a patient.  "
^XWB(8994,1004,2,0)="^8994.02A^3^3"
^XWB(8994,1004,2,1,0)="MAGDFN^1^30^1^1"
^XWB(8994,1004,2,1,1,0)="^8994.021^1^1^3151123^^^^"
^XWB(8994,1004,2,1,1,1,0)="Patient's DFN."
^XWB(8994,1004,2,2,0)="MAX^1^4^0^2"
^XWB(8994,1004,2,2,1,0)="^8994.021^1^1^3151123^^^^"
^XWB(8994,1004,2,2,1,1,0)="The maximum number of images to return."
^XWB(8994,1004,2,3,0)="FLAGS^1^60^0^3"
^XWB(8994,1004,2,3,1,0)="^^9^9^3151123^"
^XWB(8994,1004,2,3,1,1,0)="FLAGS is a delimited string of values"
^XWB(8994,1004,2,3,1,2,0)="Piece 1 is combination of C,I,D"
^XWB(8994,1004,2,3,1,3,0)="if C then include images captured by Capture Client"
^XWB(8994,1004,2,3,1,4,0)="if I then include images captured by Import API"
^XWB(8994,1004,2,3,1,5,0)="if D then include images captured by DICOM Gateway"
^XWB(8994,1004,2,3,1,6,0)="Piece 2 is the Image IEN to start from"
^XWB(8994,1004,2,3,1,7,0)="IEN is included if the user is adding images to an existing"
^XWB(8994,1004,2,3,1,8,0)="list of images.  the last IEN of the existing list is "
^XWB(8994,1004,2,3,1,9,0)="sent as the IEN to start from."
^XWB(8994,1004,2,"B","FLAGS",3)=""
^XWB(8994,1004,2,"B","MAGDFN",1)=""
