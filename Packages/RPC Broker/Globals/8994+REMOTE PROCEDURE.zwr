^XWB(8994,1440,0)="ORRHCO ORDSTS^ORDSTS^ORRHCO^2^R"
^XWB(8994,1440,1,0)="^^1^1^3021114^"
^XWB(8994,1440,1,1,0)="Returns a list of order statuses"
^XWB(8994,1440,3,0)="^^1^1^3021114^"
^XWB(8994,1440,3,1,0)="Returns a list:  LST(n)=IEN^StatusName"
^XWB(8994,1441,0)="ORRHCO SIGNSTS^SIGNSTS^ORRHCO^2^R"
