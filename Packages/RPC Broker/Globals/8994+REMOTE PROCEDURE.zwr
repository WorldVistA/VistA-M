^XWB(8994,2548,2,1,0)="DFN^1^20^1^1"
^XWB(8994,2548,2,1,1,0)="^^1^1^3050325^"
^XWB(8994,2548,2,1,1,1,0)="Patient Internal Entry Number."
^XWB(8994,2548,2,2,0)="DAYS^1^10^0^2"
^XWB(8994,2548,2,2,1,0)="^^1^1^3050325^"
^XWB(8994,2548,2,2,1,1,0)="Number of days prior to today for last verified check (default=182)."
^XWB(8994,2548,2,"B","DAYS",2)=""
^XWB(8994,2548,2,"B","DFN",1)=""
^XWB(8994,2548,2,"PARAMSEQ",1,1)=""
^XWB(8994,2548,2,"PARAMSEQ",2,2)=""
^XWB(8994,2548,3,0)="^^2^2^3050325^"
^XWB(8994,2548,3,1,0)="Return 1 if insurance check fails for any reason, 0 if check succeeds"
^XWB(8994,2548,3,2,0)="and -1^Error message if error."
^XWB(8994,2549,0)="DSIV PATIENT INSURANCE DATA^INSUR^DSIVIC3^2^A"
^XWB(8994,2549,1,0)="^8994.01^1^1^3050421^^^"
^XWB(8994,2549,1,1,0)="Wraps $$INSUR^IBBAPI to return insurance data for patient."
