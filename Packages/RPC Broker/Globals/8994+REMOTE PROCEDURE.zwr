^XWB(8994,3889,2,3,1,4,0)=" "
^XWB(8994,3889,2,3,1,5,0)="DSIYWKAC = WORK ACTION IEN1;WORK ACTION IEN2  "
^XWB(8994,3889,2,4,0)="DSIYCON^1^10^0^2"
^XWB(8994,3889,2,4,1,0)="^8994.021^6^6^3121204^^^^"
