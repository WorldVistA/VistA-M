^XWB(8994,2882,3,3,0)=" DISCLOSURE ALERT^BILL FLAG^REQUESTOR IEN^20 WORK DAYS FROM RECEIVED DATE"
^XWB(8994,2882,3,4,0)=" ;"
^XWB(8994,2882,3,5,0)=" ;  PATFOIA  - Patient Name/FOIA"
^XWB(8994,2882,3,6,0)=" ;  RECEIVED - External Date Entered"
^XWB(8994,2882,3,7,0)=" ;  STATCODE - Status code (numeric)"
^XWB(8994,2882,3,8,0)=" ;  SSN"
^XWB(8994,2882,3,9,0)=" ;  IEN      - Instance IEN"
^XWB(8994,2882,3,10,0)=" ;  DFN      - Patient/FOIA DFN"
^XWB(8994,2882,3,11,0)=" ;  INTCMNTS - INTERNAL COMMENTS 0=FALSE 1=TRUE"
^XWB(8994,2882,3,12,0)=" ;  DISCALRT - Disclosure Alert"
^XWB(8994,2882,3,13,0)=" ;  BILLFLAG - The requestor has outstanding bills"
^XWB(8994,2882,3,14,0)=" ;  WRKDY20  - 20 Work days from received date"
^XWB(8994,2883,0)="DSIR DELIVERY TYPE SUMMARY RPT^DELIVRY^DSIROIR2^4^^^^1"
^XWB(8994,2883,1,0)="^8994.01^2^2^3101227^^^^"
^XWB(8994,2883,1,1,0)="This RPC returns an array for the Delivery Type Summary Report. The "
^XWB(8994,2883,1,2,0)="optional date parameters work off of the date closed only."
^XWB(8994,2883,2,0)="^8994.02A^3^3"
^XWB(8994,2883,2,1,0)="SDATE^1^7^0^1"
^XWB(8994,2883,2,1,1,0)="^^1^1^3101222^"
^XWB(8994,2883,2,1,1,1,0)="SDATE - Optional - Report start date in Fileman format."
^XWB(8994,2883,2,2,0)="EDATE^1^7^0^2"
^XWB(8994,2883,2,2,1,0)="^8994.021^1^1^3101222^^"
^XWB(8994,2883,2,2,1,1,0)="EDATE - Optional - Report end date in Fileman format."
^XWB(8994,2883,2,3,0)="DIVL^1^150^0^3"
^XWB(8994,2883,2,3,1,0)="^^1^1^3101225^"
^XWB(8994,2883,2,3,1,1,0)="DIVL  - Optional - List of selected divisions - NULL means all divisions."
^XWB(8994,2883,2,"B","DIVL",3)=""
^XWB(8994,2883,2,"B","EDATE",2)=""
^XWB(8994,2883,2,"B","SDATE",1)=""
^XWB(8994,2883,2,"PARAMSEQ",1,1)=""
^XWB(8994,2883,2,"PARAMSEQ",2,2)=""
^XWB(8994,2883,2,"PARAMSEQ",3,3)=""
^XWB(8994,2883,3,0)="^8994.03^6^6^3101225^^^"
^XWB(8994,2883,3,1,0)="RETURN ARRAY "
^XWB(8994,2883,3,2,0)="  ##^DESCRIPTION    Where ## = a positive integer count >= Zero"
^XWB(8994,2883,3,3,0)=" "
^XWB(8994,2883,3,4,0)="  OR"
^XWB(8994,2883,3,5,0)=" "
^XWB(8994,2883,3,6,0)="  -1^Error Message"
^XWB(8994,2884,0)="MAG3 DICOM CAPTURE GE LIST^GGELIST^MAGNDCMC^2^R"
^XWB(8994,2884,1,0)="^^2^2^3090928^"
^XWB(8994,2884,1,1,0)="Return all records in IMAGING DICOM FIELDS file (#2005.71)"
^XWB(8994,2884,1,2,0)="per SOP type  (e.g ""TELEDERM"")"
^XWB(8994,2884,2,0)="^8994.02A^1^1"
^XWB(8994,2884,2,1,0)="MAGSOP^1^^1^1"
^XWB(8994,2884,2,1,1,0)="^^1^1^3090928^"
^XWB(8994,2884,2,1,1,1,0)="SOP type (e.g ""TELEDERM"")"
^XWB(8994,2884,2,"B","MAGSOP",1)=""
^XWB(8994,2884,2,"PARAMSEQ",1,1)=""
^XWB(8994,2884,3,0)="^^6^6^3090928^"
^XWB(8994,2884,3,1,0)="if error found during execution"
^XWB(8994,2884,3,2,0)="  MAGRY(0) = ""0^Error"""
^XWB(8994,2884,3,3,0)="if success"
^XWB(8994,2884,3,4,0)="  MAGRY(0)    = ""1^#CNT"" - where #CNT is a number of records returned"
^XWB(8994,2884,3,5,0)="  MAGRY(1)    = ""MODULE^ELEMENT^ELEMENT NAME^VALUE MULTIPLICITY^VALUE REPRESENTATION^GUI CONTROL"""
^XWB(8994,2884,3,6,0)="  MAGRY(2..n) = ""^"" delimited string with values of vields listed in MAGOUT(1) "
^XWB(8994,2885,0)="MAG3 DICOM CAPTURE SOP CLASS^GSOPCLAS^MAGNDCMC^1^R"
^XWB(8994,2885,1,0)="^^1^1^3101008^"
^XWB(8994,2885,1,1,0)="Returns SOP CLASS UID per SOP type  (e.g. ""TELEDERM"")"
^XWB(8994,2885,2,0)="^8994.02A^1^1"
^XWB(8994,2885,2,1,0)="MAGSOP^1^^1^1"
^XWB(8994,2885,2,1,1,0)="^^1^1^3101008^"
^XWB(8994,2885,2,1,1,1,0)="MAGSOP = SOP type (e.g. ""TELEDERM"")"
^XWB(8994,2885,2,"B","MAGSOP",1)=""
^XWB(8994,2885,2,"PARAMSEQ",1,1)=""
^XWB(8994,2885,3,0)="^^5^5^3101008^"
^XWB(8994,2885,3,1,0)="If error found during execution"
^XWB(8994,2885,3,2,0)="   MAGRY(0) = ""0^Error Message"""
^XWB(8994,2885,3,3,0)="If success"
^XWB(8994,2885,3,4,0)="   MAGRY(0)    = ""1^IEN^SOP CLASS UID"
^XWB(8994,2885,3,5,0)="    where IEN is the IEN of the SOP CLASS UID in DICOM SOP CLASS file (#2006.532)"
^XWB(8994,2886,0)="MAG3 TELEREADER CONSULT LIST^CONSLIST^MAGNGMR^2^R"
^XWB(8994,2886,1,0)="^8994.01^2^2^3090918^^^^"
^XWB(8994,2886,1,1,0)="Return not completed consults for a patient"
^XWB(8994,2886,1,2,0)="where TO SERVICE is setup in TELEREADER ACQUISITION SERVICE file (#2006.5841)"
^XWB(8994,2886,2,0)="^8994.02A^1^1"
^XWB(8994,2886,2,1,0)="DFN^1^^1^1"
^XWB(8994,2886,2,1,1,0)="^8994.021^1^1^3090918^^^^"
^XWB(8994,2886,2,1,1,1,0)="Patient ID"
^XWB(8994,2886,2,"B","DFN",1)=""
^XWB(8994,2886,2,"PARAMSEQ",1,1)=""
^XWB(8994,2886,3,0)="^8994.03^7^7^3090918^^^^"
^XWB(8994,2886,3,1,0)="Returns an array where the zeroeth element will be either:"
^XWB(8994,2886,3,2,0)="  if error found during execution"
^XWB(8994,2886,3,3,0)="     0^Error getting consult list"
^XWB(8994,2886,3,4,0)="   if success"
^XWB(8994,2886,3,5,0)=" MAGRY(0)    = ""1^#CNT"" - where #CNT is a number of records returned"
^XWB(8994,2886,3,6,0)=" MAGRY(1)    = ""Consult ID^Consult Request Date^Service^Procedure^Sending Provider"""
^XWB(8994,2886,3,7,0)=" MAGRY(2..n) = ""^"" delimited string with values of the fields listed in MAGOUT(1) "
^XWB(8994,2887,0)="MAG3 TELEREADER DICOM SER NUM^GETSRNUM^MAGNGMR^1^R"
^XWB(8994,2887,1,0)="^^1^1^3100930^"
^XWB(8994,2887,1,1,0)="Generates DICOM Series Number"
^XWB(8994,2887,3,0)="^^4^4^3100930^"
^XWB(8994,2887,3,1,0)="if error found during execution"
^XWB(8994,2887,3,2,0)="   MAGRY = ""0^Error message"""
^XWB(8994,2887,3,3,0)="if success"
^XWB(8994,2887,3,4,0)="   MAGRY = ""1^DICOM Series Number"
^XWB(8994,2888,0)="MAG3 TELEREADER DICOM UID^GETUID^MAGNGMR^1^R"
^XWB(8994,2888,1,0)="^8994.01^1^1^3100628^^^^"
^XWB(8994,2888,1,1,0)="Returns a new TELEREADER DICOM Study, Series or SOP Instance UID"
^XWB(8994,2888,2,0)="^8994.02A^1^1"
^XWB(8994,2888,2,1,0)="MAGPARAM^2^^1^1"
^XWB(8994,2888,2,1,1,0)="^8994.021^4^4^3100628^^"
^XWB(8994,2888,2,1,1,1,0)="MAGPARAM - array with input values"
^XWB(8994,2888,2,1,1,2,0)="           MAGPARAM(""TYPE"")= Type UID - ""STUDY"", ""SERIES"", ""SOP"""
^XWB(8994,2888,2,1,1,3,0)="           MAGPARAM(""ACNUM"")= Accession number - Patient consult ID"
^XWB(8994,2888,2,1,1,4,0)="           MAGPARAM(""DFN"")= Patient DFN"
^XWB(8994,2888,2,"B","MAGPARAM",1)=""
