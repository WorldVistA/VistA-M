^XWB(8994,5044,0)="SDES2 GET CLINICS BY STATION^GETCLINICS^SDES2GETCLNSTA^4^R^^^0^^^1"
^XWB(8994,5044,1,0)="^^3^3^3250214^"
^XWB(8994,5044,1,1,0)="This RPC returns a list of clinics for a given station number."
^XWB(8994,5044,1,2,0)=" "
^XWB(8994,5044,1,3,0)="Can only be invoked by Acheron"
^XWB(8994,5044,2,0)="^8994.02A^2^2"
^XWB(8994,5044,2,1,0)="SDCONTEXT^2^^1^1"
^XWB(8994,5044,2,1,1,0)="^^11^11^3240719^"
^XWB(8994,5044,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"")"
^XWB(8994,5044,2,1,1,2,0)=" - Up to 40 Character unique ID number. "
^XWB(8994,5044,2,1,1,3,0)=" - Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5044,2,1,1,4,0)="SDCONTEXT(""USER DUZ"")"
^XWB(8994,5044,2,1,1,5,0)=" - The DUZ of the user taking action in the calling application."
^XWB(8994,5044,2,1,1,6,0)="SDCONTEXT(""USER SECID"")"
^XWB(8994,5044,2,1,1,7,0)=" - The SECID of the user taking action in the calling application."
^XWB(8994,5044,2,1,1,8,0)="SDCONTEXT(""PATIENT DFN"")"
^XWB(8994,5044,2,1,1,9,0)=" - The DFN/IEN of the target patient from the calling application."
^XWB(8994,5044,2,1,1,10,0)="SDCONTEXT(""PATIENT ICN"")"
^XWB(8994,5044,2,1,1,11,0)=" - The ICN of the target patient from the calling application."
^XWB(8994,5044,2,2,0)="SDINPUT^2^^1^2"
^XWB(8994,5044,2,2,1,0)="^8994.021^5^5^3250214^^"
^XWB(8994,5044,2,2,1,1,0)="Input values of STATION NUMBER (required), and ACTIVE ONLY (optional)."
^XWB(8994,5044,2,2,1,2,0)=" "
^XWB(8994,5044,2,2,1,3,0)="SDINPUT(""STATION NUMBER"") - station number"
^XWB(8994,5044,2,2,1,4,0)="SDINPUT(""ACTIVE ONLY"") - set to '1' if only active clinics should be "
^XWB(8994,5044,2,2,1,5,0)="  included (if nothing is sent, active and inactive clinics are returned)"
^XWB(8994,5044,2,"B","SDCONTEXT",1)=""
^XWB(8994,5044,2,"B","SDINPUT",2)=""
^XWB(8994,5044,2,"PARAMSEQ",1,1)=""
^XWB(8994,5044,2,"PARAMSEQ",2,2)=""
^XWB(8994,5044,3,0)="^8994.03^14^14^3250214^^"
^XWB(8994,5044,3,1,0)="{"
^XWB(8994,5044,3,2,0)=" ""Clinic"": ["
^XWB(8994,5044,3,3,0)="  {"
^XWB(8994,5044,3,4,0)="   ""ClinicIen"": 2,"
^XWB(8994,5044,3,5,0)="   ""Name"": ""ZZCONTRACT PODIATRY"","
^XWB(8994,5044,3,6,0)="   ""ResourceIen"": 1"
^XWB(8994,5044,3,7,0)="  },"
^XWB(8994,5044,3,8,0)="  {"
^XWB(8994,5044,3,9,0)="   ""ClinicIen"": 4,"
^XWB(8994,5044,3,10,0)="   ""Name"": ""ZZCHY AUDIO CONSULT KIM"","
^XWB(8994,5044,3,11,0)="   ""ResourceIen"": """""
^XWB(8994,5044,3,12,0)="  }"
^XWB(8994,5044,3,13,0)=" ]"
^XWB(8994,5044,3,14,0)="}"
^XWB(8994,5045,0)="SDES2 SEARCH CLIN BY STOP CODE^SEARCHCLIN^SDES2SRCHCLNBYSC^4^R^0^1^^^^1"
^XWB(8994,5045,1,0)="^^4^4^3250214^"
^XWB(8994,5045,1,1,0)="Returns detailed clinic information based on a search on Medical Center "
^XWB(8994,5045,1,2,0)="Division (Station Number) and/or Stop Code and/or Stop Code range."
^XWB(8994,5045,1,3,0)=" "
^XWB(8994,5045,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,5045,2,0)="^8994.02A^2^2"
^XWB(8994,5045,2,1,0)="SDCONTEXT^2^^1^1"
^XWB(8994,5045,2,1,1,0)="^^10^10^3240722^"
^XWB(8994,5045,2,1,1,1,0)="   SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,5045,2,1,1,2,0)="                             Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5045,2,1,1,3,0)="   SDCONTEXT(""USER DUZ"")   = The DUZ of the user taking action on the"
^XWB(8994,5045,2,1,1,4,0)="                             calling application. "
^XWB(8994,5045,2,1,1,5,0)="   SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,5045,2,1,1,6,0)="                             calling application."
^XWB(8994,5045,2,1,1,7,0)="   SDCONTEXT(""PATIENT DFN"")= The name of the patient taking action on the"
^XWB(8994,5045,2,1,1,8,0)="                             calling application."
^XWB(8994,5045,2,1,1,9,0)="   SDCONTEXT(""PATIENT ICN"")= The ICN of the patient taking action on the"
^XWB(8994,5045,2,1,1,10,0)="                             calling application."
^XWB(8994,5045,2,2,0)="SDSEARCH^2^^1^2"
^XWB(8994,5045,2,2,1,0)="^8994.021^22^22^3250214^^^^"
^XWB(8994,5045,2,2,1,1,0)="The SDSEARCH array contains the following array elements:"
^XWB(8994,5045,2,2,1,2,0)=" "
^XWB(8994,5045,2,2,1,3,0)="   SDSEARCH(""STATION"") (Opt) = Station Number: If present, the search "
^XWB(8994,5045,2,2,1,4,0)="     would be limited to matching clinics at the given institution."
^XWB(8994,5045,2,2,1,5,0)="     - If absent, the search would take place across all "
^XWB(8994,5045,2,2,1,6,0)="       divisions/institutions. Example values: 534, 534GB."
^XWB(8994,5045,2,2,1,7,0)="     - If ""STARTING STOP CODE"" is not populated, ""STATION"" will be "
^XWB(8994,5045,2,2,1,8,0)="       REQUIRED."
^XWB(8994,5045,2,2,1,9,0)=" "
^XWB(8994,5045,2,2,1,10,0)="   SDSEARCH(""STARTING STOP CODE"") (Opt) = The beginning range of Stop "
^XWB(8994,5045,2,2,1,11,0)="     Codes to be included in the search."
^XWB(8994,5045,2,2,1,12,0)="     - If ""ENDING STOP CODE"" is not populated, this will be the only Stop "
^XWB(8994,5045,2,2,1,13,0)="       Code not populated, this will be the only Stop Code to be included"
^XWB(8994,5045,2,2,1,14,0)="       in the search."
^XWB(8994,5045,2,2,1,15,0)="     - If ""STATION"" is not populated, ""STARTING STOP"
^XWB(8994,5045,2,2,1,16,0)="       ""CODE"" is REQUIRED."
^XWB(8994,5045,2,2,1,17,0)="  "
^XWB(8994,5045,2,2,1,18,0)="   SDSEARCH(""ENDING STOP CODE"") (Opt) = Boolean to return Active or "
^XWB(8994,5045,2,2,1,19,0)="     Inactive clinics."
^XWB(8994,5045,2,2,1,20,0)="     - If populated, the ""STARTING STOP CODE"" value is REQUIRED."
^XWB(8994,5045,2,2,1,21,0)=" "
^XWB(8994,5045,2,2,1,22,0)="   * Either ""STATION"" or ""STARTING STOP CODE"" must be populated."
^XWB(8994,5045,2,"B","SDCONTEXT",1)=""
^XWB(8994,5045,2,"B","SDSEARCH",2)=""
^XWB(8994,5045,2,"PARAMSEQ",1,1)=""
^XWB(8994,5045,2,"PARAMSEQ",2,2)=""
