^XWB(8994,3915,0)="DSIYUTL4 FAPCHK CHK FOR FAP^FAPCHK^DSIYUTL4^2"
^XWB(8994,3915,1,0)="^^5^5^3121228^"
^XWB(8994,3915,1,1,0)="FAPCHK"
^XWB(8994,3915,1,2,0)=" "
^XWB(8994,3915,1,3,0)="Checks to see if an existing piece of equipment has been reported to the "
^XWB(8994,3915,1,4,0)="Fixed Asset Package.  If so, then a set of uneditable fields is returned "
^XWB(8994,3915,1,5,0)="to the GUI."
^XWB(8994,3915,2,0)="^8994.02A^1^1"
^XWB(8994,3915,2,1,0)="EQIEN^1^11^1^1"
^XWB(8994,3915,2,1,1,0)="^^3^3^3121228^"
^XWB(8994,3915,2,1,1,1,0)="EQIEN"
^XWB(8994,3915,2,1,1,2,0)=" "
^XWB(8994,3915,2,1,1,3,0)="IEN to the Equipment Management File ^ENG(6914)"
^XWB(8994,3915,2,"B","EQIEN",1)=""
^XWB(8994,3915,2,"PARAMSEQ",1,1)=""
^XWB(8994,3915,3,0)="^^7^7^3121228^"
^XWB(8994,3915,3,1,0)="RETURN PARAMETER"
^XWB(8994,3915,3,2,0)=" "
^XWB(8994,3915,3,3,0)="DSIYRET(1) = ""-1^Error message""        if errors"
^XWB(8994,3915,3,4,0)="DSIYRET(1) = "" 0^Message to user""      message to user if FAP exists"
^XWB(8994,3915,3,5,0)="DSIYRET(1) ==  ""FIELD1;FIELD2;FIELD3""    list of fields to make uneditable"
^XWB(8994,3915,3,6,0)="DSIYRET(1) = ""1^Non-FAP""               if this is not a FAP item, nothing "
^XWB(8994,3915,3,7,0)="to do"
