^XWB(8994,3325,0)="DVBA CAPRI GETCANCELREASON^CANRSN^DVBCANRS^2^R^0^^1^189"
^XWB(8994,3325,1,0)="^8994.01^3^3^3150106^^^^"
^XWB(8994,3325,1,1,0)="This returns an array of active 2507 EXAM Cancellation Reasons. New "
^XWB(8994,3325,1,2,0)="active reasons added with Patch DVB*2.7*189. Old list of cancellation "
^XWB(8994,3325,1,3,0)="reasons set to inactive."
^XWB(8994,3325,2,0)="^8994.02A^1^1"
^XWB(8994,3325,2,1,0)="LIST^2^^1^1"
^XWB(8994,3325,2,1,1,0)="^8994.021^1^1^3150106^^^^"
^XWB(8994,3325,2,1,1,1,0)="THE ARRAY OF ACTIVE REASONS"
^XWB(8994,3325,2,"B","LIST",1)=""
