^XWB(8994,4020,3,0)="^8994.03^5^5^3130918^^"
^XWB(8994,4020,3,1,0)="RETURN PARAMETER"
^XWB(8994,4020,3,2,0)=" "
^XWB(8994,4020,3,3,0)="DSIYRET(1)=""0^<Warning Message>    If there are warnings/no data"
^XWB(8994,4020,3,4,0)="DSIYRET(1)=""-1^<Error Message>     if there are errors"
^XWB(8994,4020,3,5,0)="DSIYRET(1)=Distribution Order #    if successful"
^XWB(8994,4021,0)="DSIYGO02 REPITP REPET ITEMS^REPITP^DSIYGO02^2"
^XWB(8994,4021,1,0)="^^8^8^3130918^"
^XWB(8994,4021,1,1,0)="REPITP"
^XWB(8994,4021,1,2,0)=" "
^XWB(8994,4021,1,3,0)="Checks to see if there are any existing Repetitive Item lists for this "
^XWB(8994,4021,1,4,0)="combination of Station, Fiscal Year, Quarter and Control Point.  If so, "
^XWB(8994,4021,1,5,0)="these are returned to the GUI.  The GUI gives the user a chance to delete "
^XWB(8994,4021,1,6,0)="these (using DSIYGO02 DELREP) if the user requests."
^XWB(8994,4021,1,7,0)=" "
^XWB(8994,4021,1,8,0)="Also returns the starting order # for this ordering session"
^XWB(8994,4021,2,0)="^8994.02A^5^5"
^XWB(8994,4021,2,1,0)="STN^1^20^1^1"
^XWB(8994,4021,2,1,1,0)="^^3^3^3130918^"
^XWB(8994,4021,2,1,1,1,0)="STN"
^XWB(8994,4021,2,1,1,2,0)=" "
^XWB(8994,4021,2,1,1,3,0)="Station # - required"
^XWB(8994,4021,2,2,0)="PIEN^1^20^1^2"
^XWB(8994,4021,2,2,1,0)="^^6^6^3130918^"
^XWB(8994,4021,2,2,1,1,0)="PIEN"
^XWB(8994,4021,2,2,1,2,0)=" "
^XWB(8994,4021,2,2,1,3,0)="Primary Distribution Point IEN - Required"
^XWB(8994,4021,2,2,1,4,0)=" "
^XWB(8994,4021,2,2,1,5,0)="ASSUMPTION:  All user validation for this primary distribution point has"
^XWB(8994,4021,2,2,1,6,0)="been done no checking is done in this RPC."
^XWB(8994,4021,2,3,0)="FCP^1^20^1^3"
^XWB(8994,4021,2,3,1,0)="^^3^3^3130918^"
^XWB(8994,4021,2,3,1,1,0)="FCP"
^XWB(8994,4021,2,3,1,2,0)=" "
