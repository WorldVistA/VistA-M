^XWB(8994,5166,0)="IBTAS ACC RPT IENS^GET^IBACCRPT^2^R^0^^^1^^1"
^XWB(8994,5166,1,0)="^^2^2^3260126^"
^XWB(8994,5166,1,1,0)="This RPC returns data for an ACC encounter that has been"
^XWB(8994,5166,1,2,0)="updated since data pull."
^XWB(8994,5166,2,0)="^8994.02A^1^1"
^XWB(8994,5166,2,1,0)="ARG^2"
^XWB(8994,5166,2,"B","ARG",1)=""
^XWB(8994,5167,0)="IBTAS ACC RPT DATA^GET1^IBACCRPT^2^R^0^^^1^^1"
^XWB(8994,5167,1,0)="^^2^2^3260126^"
^XWB(8994,5167,1,1,0)="This RPC returns the Internal Entry Numbers for encounters that have "
^XWB(8994,5167,1,2,0)="specifically identified fields updated since the previous update."
^XWB(8994,5167,2,0)="^8994.02A^1^1"
^XWB(8994,5167,2,1,0)="ARG^2^^1"
^XWB(8994,5167,2,"B","ARG",1)=""
^XWB(8994,5168,0)="IBTAS ACC RPT WRITEBACK^PUT^IBACCRPT^2^R^0^^^1^^1"
^XWB(8994,5168,1,0)="^^3^3^3260126^"
^XWB(8994,5168,1,1,0)="This RPC is used to signify that the data from this specific encounter "
^XWB(8994,5168,1,2,0)="has been successfully updated in the an external database and marks it "
^XWB(8994,5168,1,3,0)="accordingly so it will not continue to be sent."
^XWB(8994,5168,2,0)="^8994.02A^1^1"
^XWB(8994,5168,2,1,0)="ARG^2^^1"
^XWB(8994,5168,2,"B","ARG",1)=""
^XWB(8994,5169,0)="GMPLSPECAUTH SPECAUTHDEF^SPECAUTHDEF^GMPLSPECAUTH^2"
^XWB(8994,5169,2,0)="^8994.02A^1^1"
^XWB(8994,5169,2,1,0)="JSONIN^1^^1^1"
^XWB(8994,5169,2,1,1,0)="^8994.021^11^11^3241218^^^"
^XWB(8994,5169,2,1,1,1,0)="Called by CPRS for valid Special Authorities for a patient."
^XWB(8994,5169,2,1,1,2,0)=" "
^XWB(8994,5169,2,1,1,3,0)="Passes in a JSON String with elements below:"
^XWB(8994,5169,2,1,1,4,0)=" "
^XWB(8994,5169,2,1,1,5,0)="""patientId"" =: Patient unique internal number (DFN)"
^XWB(8994,5169,2,1,1,6,0)=" "
^XWB(8994,5169,2,1,1,7,0)="Example JSON msg:"
^XWB(8994,5169,2,1,1,8,0)=" "
^XWB(8994,5169,2,1,1,9,0)="{"
^XWB(8994,5169,2,1,1,10,0)="    ""patientId"": ""100840"""
^XWB(8994,5169,2,1,1,11,0)="}"
^XWB(8994,5169,2,"B","JSONIN",1)=""
^XWB(8994,5169,2,"PARAMSEQ",1,1)=""
^XWB(8994,5169,3,0)="^8994.03^59^59^3241218^^"
^XWB(8994,5169,3,1,0)="Returns an array with JSON string elements for Special Authorities (SA)."
^XWB(8994,5169,3,2,0)=" "
^XWB(8994,5169,3,3,0)="Elements"
^XWB(8994,5169,3,4,0)=" ""facility"" = Location of the Patient Hospital/Clinic."
^XWB(8994,5169,3,5,0)=" ""specialAuthoritiy"""
^XWB(8994,5169,3,6,0)="   ""code""    = 2-4 characters - internal letter code, e.g. AO Agent Orange"
^XWB(8994,5169,3,7,0)="   ""defalut"" = yes, no, unanswered - default prompt value"
^XWB(8994,5169,3,8,0)="   ""visible"" = true/false - should this SA appear to user for an answer"
^XWB(8994,5169,3,9,0)=" ""patientId""  = nnnnn - patient DFN that data is for"
^XWB(8994,5169,3,10,0)=" ""success""    = true/false - successfully found the patient DFN"
^XWB(8994,5169,3,11,0)=" "
^XWB(8994,5169,3,12,0)="Example:"
^XWB(8994,5169,3,13,0)="{"
^XWB(8994,5169,3,14,0)="    ""facility"": ""21789"","
^XWB(8994,5169,3,15,0)="    ""specialAuthority"": ["
^XWB(8994,5169,3,16,0)="        {"
^XWB(8994,5169,3,17,0)="            ""code"": ""SC"","
^XWB(8994,5169,3,18,0)="            ""default"": ""unknown"","
^XWB(8994,5169,3,19,0)="            ""visible"": true"
^XWB(8994,5169,3,20,0)="        },"
^XWB(8994,5169,3,21,0)="        {"
^XWB(8994,5169,3,22,0)="            ""code"": ""CV"","
^XWB(8994,5169,3,23,0)="            ""default"": ""unknown"","
^XWB(8994,5169,3,24,0)="            ""visible"": true"
^XWB(8994,5169,3,25,0)="        },"
^XWB(8994,5169,3,26,0)="        {"
^XWB(8994,5169,3,27,0)="            ""code"": ""AO"","
^XWB(8994,5169,3,28,0)="            ""default"": ""unknown"","
^XWB(8994,5169,3,29,0)="            ""visible"": true"
^XWB(8994,5169,3,30,0)="        },"
^XWB(8994,5169,3,31,0)="        {"
^XWB(8994,5169,3,32,0)="            ""code"": ""IR"","
^XWB(8994,5169,3,33,0)="            ""default"": ""unknown"","
^XWB(8994,5169,3,34,0)="            ""visible"": true"
^XWB(8994,5169,3,35,0)="        },"
^XWB(8994,5169,3,36,0)="        {"
^XWB(8994,5169,3,37,0)="            ""code"": ""EC"","
^XWB(8994,5169,3,38,0)="            ""default"": ""unknown"","
^XWB(8994,5169,3,39,0)="            ""visible"": false"
^XWB(8994,5169,3,40,0)="        },"
^XWB(8994,5169,3,41,0)="        {"
^XWB(8994,5169,3,42,0)="            ""code"": ""SHAD"","
^XWB(8994,5169,3,43,0)="            ""default"": ""unknown"","
^XWB(8994,5169,3,44,0)="            ""visible"": false"
^XWB(8994,5169,3,45,0)="        },"
^XWB(8994,5169,3,46,0)="        {"
^XWB(8994,5169,3,47,0)="            ""code"": ""MST"","
^XWB(8994,5169,3,48,0)="            ""default"": ""unknown"","
^XWB(8994,5169,3,49,0)="            ""visible"": true"
^XWB(8994,5169,3,50,0)="        },"
^XWB(8994,5169,3,51,0)="        {"
^XWB(8994,5169,3,52,0)="            ""code"": ""HNC"","
^XWB(8994,5169,3,53,0)="            ""default"": ""unknown"","
^XWB(8994,5169,3,54,0)="            ""visible"": false"
^XWB(8994,5169,3,55,0)="        }"
^XWB(8994,5169,3,56,0)="    ],"
^XWB(8994,5169,3,57,0)="    ""ssn4"": ""0902"","
^XWB(8994,5169,3,58,0)="    ""success"": true"
^XWB(8994,5169,3,59,0)="}"
^XWB(8994,5170,0)="GMPLSPECAUTH SAFORPROBLEMS^SAFORPROBLEMS^GMPLSPECAUTH^2"
^XWB(8994,5170,1,0)="^^1^1^3241220^"
^XWB(8994,5170,1,1,0)="Handle RPC calls and retrives Special Authorites per patient Problem."
^XWB(8994,5170,2,0)="^8994.02A^1^1"
^XWB(8994,5170,2,1,0)="JSONIN^1^^1^1"
^XWB(8994,5170,2,1,1,0)="^^4^4^3241220^"
^XWB(8994,5170,2,1,1,1,0)=" JSON string passed back for order(s) to save SA answers."
^XWB(8994,5170,2,1,1,2,0)="   "
^XWB(8994,5170,2,1,1,3,0)="  JSON elements:"
^XWB(8994,5170,2,1,1,4,0)="    patientId       = patient unique numeric DFN"
^XWB(8994,5170,2,"B","JSONIN",1)=""
^XWB(8994,5170,2,"PARAMSEQ",1,1)=""
^XWB(8994,5170,3,0)="^^9^9^3241220^"
^XWB(8994,5170,3,1,0)="JSON return string elements:"
^XWB(8994,5170,3,2,0)="   "
^XWB(8994,5170,3,3,0)="  ""success"" = was value saved?  true/flase"
^XWB(8994,5170,3,4,0)="   "
^XWB(8994,5170,3,5,0)="  Example:"
^XWB(8994,5170,3,6,0)="   "
^XWB(8994,5170,3,7,0)="  {"
^XWB(8994,5170,3,8,0)="      ""success"": true"
^XWB(8994,5170,3,9,0)="  }"
^XWB(8994,5171,0)="PXSPECAUTH SPECAUTHSTRUCT^SPECAUTHSTRUCT^PXSPECAUTH^2"
^XWB(8994,5171,1,0)="^^2^2^3241203^"
^XWB(8994,5171,1,1,0)="This RPC has no input parameters and returns all valid Special Authorities"
^XWB(8994,5171,1,2,0)="and their structure, i.e. their business rules."
^XWB(8994,5171,3,0)="^8994.03^260^260^3241203^^^"
^XWB(8994,5171,3,1,0)="Example returned output:"
^XWB(8994,5171,3,2,0)=" "
^XWB(8994,5171,3,3,0)="{"
^XWB(8994,5171,3,4,0)="    ""specialAuthorityTypes"": ["
^XWB(8994,5171,3,5,0)="        {"
^XWB(8994,5171,3,6,0)="            ""abbreviation"": ""ASC"","
^XWB(8994,5171,3,7,0)="            ""code"": ""ASC"","
^XWB(8994,5171,3,8,0)="            ""default"": ""Unanswered"","
^XWB(8994,5171,3,9,0)="            ""disabled"": false,"
^XWB(8994,5171,3,10,0)="            ""displayName"": ""Acute Suicidal Crisis"","
^XWB(8994,5171,3,11,0)="            ""id"": 9,"
^XWB(8994,5171,3,12,0)="            ""package"": ["
^XWB(8994,5171,3,13,0)="                {"
^XWB(8994,5171,3,14,0)="                    ""excluded"": false,"
^XWB(8994,5171,3,15,0)="                    ""name"": ""PROBLEM LIST"""
^XWB(8994,5171,3,16,0)="                }"
^XWB(8994,5171,3,17,0)="            ],"
^XWB(8994,5171,3,18,0)="            ""sequence"": 5"
^XWB(8994,5171,3,19,0)="        },"
^XWB(8994,5171,3,20,0)="        {"
^XWB(8994,5171,3,21,0)="            ""abbreviation"": ""SC"","
^XWB(8994,5171,3,22,0)="            ""code"": ""SC"","
^XWB(8994,5171,3,23,0)="            ""default"": ""Unanswered"","
^XWB(8994,5171,3,24,0)="            ""description"": ""Service-Connected (SC):\r\nVeterans are "
^XWB(8994,5171,3,25,0)="eligible for medical care for treatment of service-connected\r\n(SC) "
^XWB(8994,5171,3,26,0)="conditions without incurring copayment charges or claims against\r\ntheir "
^XWB(8994,5171,3,27,0)="insurance.  See 'Help' for additional information.\r\n"","
^XWB(8994,5171,3,28,0)="            ""disabled"": false,"
^XWB(8994,5171,3,29,0)="            ""displayName"": ""Service &Connected Condition"","
^XWB(8994,5171,3,30,0)="            ""id"": 1,"
^XWB(8994,5171,3,31,0)="            ""package"": ["
^XWB(8994,5171,3,32,0)="                {"
^XWB(8994,5171,3,33,0)="                    ""excluded"": false,"
^XWB(8994,5171,3,34,0)="                    ""name"": ""ORDER ENTRY\/RESULTS REPORTING"""
^XWB(8994,5171,3,35,0)="                }"
^XWB(8994,5171,3,36,0)="            ],"
^XWB(8994,5171,3,37,0)="            ""sequence"": 10,"
^XWB(8994,5171,3,38,0)="            ""valueChangeActions"": ["
^XWB(8994,5171,3,39,0)="                {"
^XWB(8994,5171,3,40,0)="                    ""actions"": ["
^XWB(8994,5171,3,41,0)="                        ""SetUnanswered"","
^XWB(8994,5171,3,42,0)="                        ""Disable"""
^XWB(8994,5171,3,43,0)="                    ],"
