^XWB(8994,382,0)="TIU TEMPLATE GETBOIL^GETBOIL^TIUSRVT^4^S^^^1"
^XWB(8994,382,2,0)="^8994.02A^1^1"
^XWB(8994,382,2,1,0)="TIUDA^1^^1"
^XWB(8994,382,2,"B","TIUDA",1)=""
^XWB(8994,383,0)="TIU TEMPLATE GETTEXT^GETTEXT^TIUSRVT^4^S^^^1"
^XWB(8994,383,2,0)="^8994.02A^3^3"
^XWB(8994,383,2,1,0)="DFN^1^^1"
^XWB(8994,383,2,2,0)="VSTR^1^^1"
^XWB(8994,383,2,3,0)="TIUX^2^^1"
