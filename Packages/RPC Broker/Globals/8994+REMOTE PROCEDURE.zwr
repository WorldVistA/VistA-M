^XWB(8994,442,0)="DG PATIENT TREATMENT DATA^RPC^DGPTFAPI^2^P"
^XWB(8994,442,1,0)="^^18^18^3150819^"
^XWB(8994,442,1,1,0)="This RPC will return data from the Patient Treatment (#45) file."
^XWB(8994,442,1,2,0)=" "
^XWB(8994,442,1,3,0)="Input: "
^XWB(8994,442,1,4,0)=" PTFNUMBR - The Patient Treatment IFN (.001 of the #45 file record) "
^XWB(8994,442,1,5,0)="  RESULTS - Results array (passed by reference) "
^XWB(8994,442,1,6,0)="    "
^XWB(8994,442,1,7,0)="Output: "
^XWB(8994,442,1,8,0)="    RESULTS - Results array (passed by reference) with the following "
^XWB(8994,442,1,9,0)="              nodes.  "
^XWB(8994,442,1,10,0)=" RESULTS(0) - 1 (entry found) OR -1 (error) "
