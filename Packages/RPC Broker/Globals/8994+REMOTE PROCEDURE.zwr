^XWB(8994,442,1,12,0)="              Principal Diagnosis (#79)^Coding System Version (pointer to"
^XWB(8994,442,1,13,0)="              ICD Coding Systems #80.4 file) "
^XWB(8994,442,1,14,0)=" RESULTS(2) - DX 2^DX 3^...^DX 24 (Secondary Diagnosis 2 through Secondary"
^XWB(8994,442,1,15,0)="              Diagnosis 24) "
^XWB(8994,442,1,16,0)=" RESULTS(3) - POA 1^POA 2^...^POA 25 (Present on Admission indicators for"
^XWB(8994,442,1,17,0)="              Principal Diagnosis and Secondary Diagnosis 2 through "
^XWB(8994,442,1,18,0)="              Secondary Diagnosis 24) "
^XWB(8994,442,2,0)="^8994.02A^1^1"
^XWB(8994,442,2,1,0)="PTFNUMBER^1^^1^1"
^XWB(8994,442,2,1,1,0)="^^1^1^3150819^"
