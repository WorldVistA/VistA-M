^XWB(8994,4372,2,"PARAMSEQ",2,2)=""
^XWB(8994,4372,3,0)="^^7^7^3180813^"
^XWB(8994,4372,3,1,0)=" Output:"
^XWB(8994,4372,3,2,0)="    Error Messages:  DSSORET(0)=""-1^""_error message or ""0^""_warning"
^XWB(8994,4372,3,3,0)="      message"
^XWB(8994,4372,3,4,0)="    Successful Completion: Data returned in format:"
^XWB(8994,4372,3,5,0)="      442 IEN ^ AMOUNT data added successfully. ^ PRCHFPDS: x"""
^XWB(8994,4372,3,6,0)="        where x=0 -> proceed to RPC DSSO DTLD CRT 442 7-COMPLETE"
^XWB(8994,4372,3,7,0)="              x=1 -> proceed to RPC DSSO DTLD CRT 442-AMTS FPDS"
^XWB(8994,4373,0)="DSSO DTLD RETRIEVE INV POINTS^INVDISPT^DSSODU6^4^^^^1"
