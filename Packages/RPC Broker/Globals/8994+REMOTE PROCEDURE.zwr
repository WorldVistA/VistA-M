^XWB(8994,4350,3,0)="^^14^14^3150925^"
^XWB(8994,4350,3,1,0)="The results will be returned in the following format:"
^XWB(8994,4350,3,2,0)=" "
^XWB(8994,4350,3,3,0)="  List[n] = p1^p2^p3^p4^p5^p6^p7^p8^p9^p10^p11"
^XWB(8994,4350,3,4,0)=" "
^XWB(8994,4350,3,5,0)="    p1 = Statement Date          p7  = Transaction Ref #"
^XWB(8994,4350,3,6,0)="    p2 = Purchase Card #         p8  = Amount"
^XWB(8994,4350,3,7,0)="    p3 = Oracle Doc ID           p9  = Purchase Order"
^XWB(8994,4350,3,8,0)="    p4 = Purchase Date           p10 = Transaction Date"
^XWB(8994,4350,3,9,0)="    p5 = Vendor Name             p11 = Status"
^XWB(8994,4350,3,10,0)="    p6 = Vendor PO #"
^XWB(8994,4350,3,11,0)=" "
^XWB(8994,4350,3,12,0)="If nothing is found, the return will be ""0^Nothing to report""."
^XWB(8994,4350,3,13,0)=" "
^XWB(8994,4350,3,14,0)="If an error occurs, the return will be -1^error message."
^XWB(8994,4351,0)="DSSO DTLD 441 DRUG TYPE CODE^DTCREQD^DSSODU3^1"
^XWB(8994,4351,1,0)="^8994.01^3^3^3160412^^^^"
