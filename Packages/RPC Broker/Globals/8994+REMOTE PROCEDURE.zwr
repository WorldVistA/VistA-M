^XWB(8994,1774,3,7,0)="                          ^01: The last error code"
^XWB(8994,1774,3,8,0)="                          ^02: Number of the error descriptors"
^XWB(8994,1774,3,9,0)="                                                                       "
^XWB(8994,1774,3,10,0)="  Results[i]            Error Descriptor"
