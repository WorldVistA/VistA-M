^XWB(8994,3606,3,0)="^^1^1^3150420^"
^XWB(8994,3606,3,1,0)="Single entry in the global array containing a return code and text."
^XWB(8994,3607,0)="SDEC ARPCSET^ARPCSET^SDEC^4^R^0^^0"
^XWB(8994,3607,1,0)="^^1^1^3150420^"
^XWB(8994,3607,1,1,0)="SET/update patient contacts in SDEC APPT REQUEST file"
^XWB(8994,3607,2,0)="^8994.02A^2^2"
^XWB(8994,3607,2,1,0)="INP^1^^1^1"
^XWB(8994,3607,2,1,1,0)="^^8^8^3150420^"
^XWB(8994,3607,2,1,1,1,0)="  ;  INP = Patient Contacts separated by ::"
^XWB(8994,3607,2,1,1,2,0)="  ;            Each :: piece has the following ~~ pieces:  (same as they"
^XWB(8994,3607,2,1,1,3,0)=" are passed into SDEC WLSET)"
^XWB(8994,3607,2,1,1,4,0)="  ;            1) = (required)    DATE ENTERED external date/time"
^XWB(8994,3607,2,1,1,5,0)="  ;            2) = (optional)    PC ENTERED BY USER ID or NAME - Pointer"
^XWB(8994,3607,2,1,1,6,0)=" to NEW PERSON file or NAME"
^XWB(8994,3607,2,1,1,7,0)="  ;            4) = (optional)    ACTION - 'Called' or 'Message Left'"
^XWB(8994,3607,2,1,1,8,0)="  ;            5) = (optional)    PATIENT PHONE Free-Text 4-20 characters"
^XWB(8994,3607,2,2,0)="ARIEN^1^^1^2"
^XWB(8994,3607,2,2,1,0)="^^1^1^3150420^"
^XWB(8994,3607,2,2,1,1,0)="Pointer to SDEC APPT REQUEST file 409.85."
