^XWB(8994,410,0)="PSB CHECK SERVER^CHECK^PSBUTL^2^^^^^2"
^XWB(8994,410,1,0)="^8994.01^1^1^3031006^^^^"
^XWB(8994,410,1,1,0)="Returns -1 or 1 when checking for patches and build on the server."
^XWB(8994,410,2,0)="^8994.02A^2^2"
^XWB(8994,410,2,1,0)="PSBWHAT^2^^1^1"
^XWB(8994,410,2,1,1,0)="^8994.021^2^2^3030314^^^^"
