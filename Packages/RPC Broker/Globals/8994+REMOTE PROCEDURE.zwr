^XWB(8994,4982,2,2,1,1,0)="SDINPUT(""RECALL IEN"")=RECALL IEN                           REQUIRED"
^XWB(8994,4982,2,2,1,2,0)="SDINPUT(""DELETE REASON"")=DELETE REASON From 403.56, 203    OPTIONAL"
^XWB(8994,4982,2,2,1,3,0)="                  Can be the number or name"
