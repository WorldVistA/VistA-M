^XWB(8994,2550,3,3,0)="    Ret(n) = Clinic^Appt Date/time^Patient"
^XWB(8994,2550,3,4,0)="    Ret(~) = $END$QUEUED dttm^rpt START RUN dttm^rpt END RUN dttm"
^XWB(8994,2551,0)="DSIV POLLED DATA^POLL^DSIVICR^4^A^^^1"
^XWB(8994,2551,1,0)="^8994.01^2^2^3070820^^"
^XWB(8994,2551,1,1,0)="Used to check the status of the background job kicked off by the DSIV"
^XWB(8994,2551,1,2,0)=" REPORT QUEUE rpc, and to get the report results."
^XWB(8994,2551,2,0)="^8994.02A^3^3"
^XWB(8994,2551,2,1,0)="DSIVHNDL^1^50^1^1"
^XWB(8994,2551,2,1,1,0)="^^2^2^3070820^"
^XWB(8994,2551,2,1,1,1,0)="Contains the handle returned by the kick-off rpc called DSIV REPORT "
^XWB(8994,2551,2,1,1,2,0)="QUEUE.  This is the ^XTMP global node where the data resides."
^XWB(8994,2551,2,2,0)="NUMS^1^30^0^2"
^XWB(8994,2551,2,2,1,0)="^8994.021^2^2^3060804^^^"
^XWB(8994,2551,2,2,1,1,0)="Contains the number of records to return for each call to the rpc.  If "
^XWB(8994,2551,2,2,1,2,0)="there are no more records, then the data will be followed by ""$END""."
^XWB(8994,2551,2,3,0)="MORE^1^1^0^3"
^XWB(8994,2551,2,3,1,0)="^8994.021^4^4^3070820^^"
