^XWB(8994,3950,3,4,0)=" "
^XWB(8994,3950,3,5,0)="DSIYRET(1)=1^Successfully added user parameter"
^XWB(8994,3950,3,6,0)=" if successful"
^XWB(8994,3951,0)="DSIYX1 GETUSRXP USER PARAM^GETUSRXP^DSIYX1^2"
^XWB(8994,3951,1,0)="^^6^6^3130205^"
^XWB(8994,3951,1,1,0)="GETUSRXP"
^XWB(8994,3951,1,2,0)=" "
^XWB(8994,3951,1,3,0)="Retrieves single values from a parameter file."
^XWB(8994,3951,1,4,0)=" "
^XWB(8994,3951,1,5,0)="The GUI will need to know how to interpret the values based on the "
^XWB(8994,3951,1,6,0)="parameter file used."
^XWB(8994,3951,2,0)="^8994.02A^2^2"
^XWB(8994,3951,2,1,0)="PARAM^1^60^1^1"
^XWB(8994,3951,2,1,1,0)="^^3^3^3130205^"
^XWB(8994,3951,2,1,1,1,0)="PARAM"
^XWB(8994,3951,2,1,1,2,0)=" "
^XWB(8994,3951,2,1,1,3,0)="Naame of the parameter file being used"
^XWB(8994,3951,2,2,0)="USER^1^60^1^2"
^XWB(8994,3951,2,2,1,0)="^8994.021^5^5^3130205^^"
^XWB(8994,3951,2,2,1,1,0)="USER"
^XWB(8994,3951,2,2,1,2,0)=" "
^XWB(8994,3951,2,2,1,3,0)="If getting a system-wide parameter use ""SYS"" in this parameter"
^XWB(8994,3951,2,2,1,4,0)=" "
^XWB(8994,3951,2,2,1,5,0)="If getting a user parameter use the user's DUZ value in this parameter"
^XWB(8994,3951,2,"B","PARAM",1)=""
^XWB(8994,3951,2,"B","USER",2)=""
^XWB(8994,3951,2,"PARAMSEQ",1,1)=""
^XWB(8994,3951,2,"PARAMSEQ",2,2)=""
^XWB(8994,3951,3,0)="^8994.03^3^3^3130205^^"
^XWB(8994,3951,3,1,0)="RETURN PARAMETER"
^XWB(8994,3951,3,2,0)=" "
^XWB(8994,3951,3,3,0)="DSIYRET(1)=INTERNAL^EXTERNAL value of the parameter for this user"
^XWB(8994,3952,0)="DSIYTDEQ TIRBYEQS EQ BY TIR^TIRBYEQS^DSIYTDEQ^4^^^^1"
^XWB(8994,3952,1,0)="^8994.01^7^7^3130725^^^^"
^XWB(8994,3952,1,1,0)="TIRBYEQS"
^XWB(8994,3952,1,2,0)=" "
^XWB(8994,3952,1,3,0)="Returns equipment items which match the statistic chosen in the TIRBYEQ "
^XWB(8994,3952,1,4,0)="RPC."
^XWB(8994,3952,1,5,0)=" "
^XWB(8994,3952,1,6,0)="Data is returned in the same format as all other Equipment-Related "
^XWB(8994,3952,1,7,0)="Searches"
^XWB(8994,3952,2,0)="^8994.02A^2^2"
^XWB(8994,3952,2,1,0)="STAT^1^2^1^1"
^XWB(8994,3952,2,1,1,0)="^^5^5^3130207^"
^XWB(8994,3952,2,1,1,1,0)="STAT"
^XWB(8994,3952,2,1,1,2,0)=" "
^XWB(8994,3952,2,1,1,3,0)="Statistic for which to return individual equipment items.  This statistic "
^XWB(8994,3952,2,1,1,4,0)="value comes from the first piece in the return in TIRBYEQ for this "
^XWB(8994,3952,2,1,1,5,0)="statistic."
^XWB(8994,3952,2,2,0)="NOREC^1^4^0^2"
^XWB(8994,3952,2,2,1,0)="^^3^3^3130725^"
^XWB(8994,3952,2,2,1,1,0)="NOREC"
^XWB(8994,3952,2,2,1,2,0)=" "
^XWB(8994,3952,2,2,1,3,0)="The number of records to return - not required."
^XWB(8994,3952,2,"B","NOREC",2)=""
^XWB(8994,3952,2,"B","STAT",1)=""
^XWB(8994,3952,2,"PARAMSEQ",1,1)=""
^XWB(8994,3952,2,"PARAMSEQ",2,2)=""
^XWB(8994,3952,3,0)="^8994.03^8^8^3130725^^^^"
^XWB(8994,3952,3,1,0)="RETURN PARAMETER"
^XWB(8994,3952,3,2,0)=" "
^XWB(8994,3952,3,3,0)="DSIYRET(EQUIPMENT IEN) = IEN ^ MANUFCATURER ^ ITEM NAME ^ MODEL# ^ SERIAL"
^XWB(8994,3952,3,4,0)="# ^ STATUS ^ PO# ^ CATEGORY ^ CMR ^ ACQUISITION DATE ^ TOTAL ASSET"
^XWB(8994,3952,3,5,0)="VALUE"
^XWB(8994,3952,3,6,0)=" "
^XWB(8994,3952,3,7,0)="NOTE:  This is the same return string as used when doing an equipment "
^XWB(8994,3952,3,8,0)="search"
^XWB(8994,3953,0)="DSIYX GETALL GET ALL FOR ENT^GETALL^DSIYX^2"
^XWB(8994,3953,1,0)="^^1^1^3130205^"
^XWB(8994,3953,1,1,0)="Gets all instances of a parameter and their values."
^XWB(8994,3953,2,0)="^8994.02A^3^3"
^XWB(8994,3953,2,1,0)="ENT^1^30^1^1"
^XWB(8994,3953,2,1,1,0)="^^1^1^3130205^"
^XWB(8994,3953,2,1,1,1,0)="Parameter entity (either ""SYS"" or ""USR"") for which to pull instances."
^XWB(8994,3953,2,2,0)="PARAM^1^50^1^2"
^XWB(8994,3953,2,2,1,0)="^^1^1^3130205^"
^XWB(8994,3953,2,2,1,1,0)="The name of the parameter to pull data for."
^XWB(8994,3953,2,3,0)="USER^1^30^0^3"
^XWB(8994,3953,2,3,1,0)="^^2^2^3130205^"
^XWB(8994,3953,2,3,1,1,0)="If ENTITY=""USR"", this parameter can be used to specify which user's "
^XWB(8994,3953,2,3,1,2,0)="parameter data should be returned (default is current user)."
^XWB(8994,3953,2,"B","ENT",1)=""
^XWB(8994,3953,2,"B","PARAM",2)=""
^XWB(8994,3953,2,"B","USER",3)=""
