^XWB(8994,4888,2,2,1,3,0)=" "
^XWB(8994,4888,2,2,1,4,0)=" - Request IEN (Variable pointer) based on the request type"
^XWB(8994,4888,2,2,1,5,0)="   A,RTC or V - point to SDEC APPT REQUEST (#409.85)"
^XWB(8994,4888,2,2,1,6,0)="   C or P - point to REQUEST/CONSULTATION file (#123)"
^XWB(8994,4888,2,2,1,7,0)="   R - point to RECALL REQUEST file (#403.5)"
