^XWB(8994,4376,2,"PARAMSEQ",5,5)=""
^XWB(8994,4376,2,"PARAMSEQ",6,6)=""
^XWB(8994,4376,3,0)="^^47^47^3200512^"
^XWB(8994,4376,3,1,0)="Returns a global array List[n].  This will be limited to a number of "
^XWB(8994,4376,3,2,0)="records as set in the DSSO APPLIANCE TRANS PER RUN VistA parameter."
^XWB(8994,4376,3,3,0)=" "
^XWB(8994,4376,3,4,0)=" The format of the returned array will be as follows:"
^XWB(8994,4376,3,5,0)="   List[n] = p1^p2^p3^p4^p5^p6^p7^p8^p8^p10^p11^p12^"
^XWB(8994,4376,3,6,0)="              p13^p14^p15^p16^p17^p18^p19^p20^p21"
^XWB(8994,4376,3,7,0)=" "
^XWB(8994,4376,3,8,0)="     p1  = ENTRY DATE"
^XWB(8994,4376,3,9,0)="     p2  = PATIENT NAME  IF OEF/OIF <!> PRECEDES THE NAME"
^XWB(8994,4376,3,10,0)="     p3  = PSAS HCPCS with * if HCPCS has Calculation Flag"
^XWB(8994,4376,3,11,0)="     p4  = QTY"
^XWB(8994,4376,3,12,0)="     p5  = VENDOR"
^XWB(8994,4376,3,13,0)="     p6  = INITIAL ACTION DATE"
^XWB(8994,4376,3,14,0)="     p7  = TOTAL COST"
^XWB(8994,4376,3,15,0)="     p8  = DESCRIPTION"
^XWB(8994,4376,3,16,0)="     p9  = INITIATOR"
^XWB(8994,4376,3,17,0)="     p10 = NPPD LINE BEFORE GROUPER"
^XWB(8994,4376,3,18,0)="     p11 = STATION"
^XWB(8994,4376,3,19,0)="     p12 = GROUPER NUMBER"
^XWB(8994,4376,3,20,0)="     p13 = FORM REQUESTED ON"
^XWB(8994,4376,3,21,0)="     p14 = TYPE OF TRANSACTION"
^XWB(8994,4376,3,22,0)="     p15 = SSN"
^XWB(8994,4376,3,23,0)="     p16 = IEN TO FILE 660"
^XWB(8994,4376,3,24,0)="     p17 = HCPCS SHORT DESCRIPTION"
^XWB(8994,4376,3,25,0)="     p18 = SOURCE"
^XWB(8994,4376,3,26,0)="     p19 = Optional Flex Field"
^XWB(8994,4376,3,27,0)="     p20 = Optional Flex Field"
^XWB(8994,4376,3,28,0)="     p21 = Optional Flex Field"
^XWB(8994,4376,3,29,0)="     p22 = Item Master Number"
^XWB(8994,4376,3,30,0)="     p23 = Inventory Point"
^XWB(8994,4376,3,31,0)=" "
^XWB(8994,4376,3,32,0)="If the final result of a call begins with ""$$MORE$$"", the end date was "
^XWB(8994,4376,3,33,0)="not reached.  It will be formatted as follows:"
^XWB(8994,4376,3,34,0)=" "
^XWB(8994,4376,3,35,0)="      p1 = $$MORE$$"
^XWB(8994,4376,3,36,0)="      p2 = Last date processed; to be used as DSSODATE1 in next call"
^XWB(8994,4376,3,37,0)="      p3 = Last IEN processed; to be used as DSSOLAST in next call"
^XWB(8994,4376,3,38,0)=" "
^XWB(8994,4376,3,39,0)="NOTE: It is possible for their to be no additional results "
^XWB(8994,4376,3,40,0)="following a $$MORE$$ result as the process simply stops and has no "
^XWB(8994,4376,3,41,0)="context of additional data beyond the record accessed.  In such an "
^XWB(8994,4376,3,42,0)="instance, the result will be the same as if if there were no results "
^XWB(8994,4376,3,43,0)="found as illustrated below."
^XWB(8994,4376,3,44,0)=" "
^XWB(8994,4376,3,45,0)=" If nothing is found, the return will be List[n] = 0^NOTHING TO REPORT."
^XWB(8994,4376,3,46,0)=" "
^XWB(8994,4376,3,47,0)=" If an error occurs, the return will be List[n] = -1^message."
^XWB(8994,4377,0)="DSSO OWL ADD ON LIST^OWLADD^DSSOOWA^4^^^^1"
