^XWB(8994,3869,3,1,0)="Array containing -1^error of IEN^Inventory Point Name"
^XWB(8994,3869,3,2,0)="  RET(1)=-1^error   e.g. missing/invalid input param, no data"
^XWB(8994,3869,3,3,0)="or"
^XWB(8994,3869,3,4,0)=" RET(1-n)=IEN^Inventory Point Name"
^XWB(8994,3870,0)="DSIYINP GET INV PT GET DATA^GET^DSIYGNP^2"
^XWB(8994,3870,1,0)="^8994.01^1^1^3120717^^^^"
^XWB(8994,3870,1,1,0)="Returns Inventory Point data from file 445 for view/edit."
^XWB(8994,3870,2,0)="^8994.02A^3^3"
^XWB(8994,3870,2,1,0)="STN^1^5^1^1"
^XWB(8994,3870,2,1,1,0)="^^1^1^3120628^"
^XWB(8994,3870,2,1,1,1,0)="Station Number"
^XWB(8994,3870,2,2,0)="TYPE^1^1^1^2"
^XWB(8994,3870,2,2,1,0)="^^1^1^3120628^"
^XWB(8994,3870,2,2,1,1,0)="The Type of inventory point, W=Warehouse, P=Primary, S=Secondary."
^XWB(8994,3870,2,3,0)="DSIYIEN^1^30^1^3"
^XWB(8994,3870,2,3,1,0)="^8994.021^1^1^3120717^^^^"
^XWB(8994,3870,2,3,1,1,0)="Pointer to file 445."
^XWB(8994,3870,2,4,0)="FLAG^1^4^1^4"
^XWB(8994,3870,2,4,1,0)="^^4^4^3150722^"
^XWB(8994,3870,2,4,1,1,0)="Flag which indicates what information is returned."
^XWB(8994,3870,2,4,1,2,0)=" "
^XWB(8994,3870,2,4,1,3,0)="FLG: ""M""=Main, ""T""=Total Items, ""DP""=Distribution Points, ""SB""=Stocked By"
^XWB(8994,3870,2,4,1,4,0)="     ""IU""=Inventory Users, ""FCP""=Fund Control Points, ""PROS""=Prosthetics"
^XWB(8994,3870,2,5,0)="SIZE^1^^0^5"
^XWB(8994,3870,2,5,1,0)="^8994.021^1^1^3140827^^"
^XWB(8994,3870,2,5,1,1,0)="The number of lines to return"
^XWB(8994,3870,2,"B","DSIYIEN",3)=""
^XWB(8994,3870,2,"B","FLAG",4)=""
^XWB(8994,3870,2,"B","SIZE",5)=""
^XWB(8994,3870,2,"B","STN",1)=""
^XWB(8994,3870,2,"B","TYPE",2)=""
^XWB(8994,3870,2,"PARAMSEQ",1,1)=""
^XWB(8994,3870,2,"PARAMSEQ",2,2)=""
^XWB(8994,3870,2,"PARAMSEQ",3,3)=""
^XWB(8994,3870,2,"PARAMSEQ",4,4)=""
^XWB(8994,3870,2,"PARAMSEQ",5,5)=""
^XWB(8994,3870,3,0)="^8994.03^20^20^3120717^^^"
^XWB(8994,3870,3,1,0)="RET(1)=-1^error   e.g. missing/invalid input param, no data"
^XWB(8994,3870,3,2,0)="or RET(1-n)=Field#^Internal Data^External Data"
^XWB(8994,3870,3,3,0)="Multiples are distinguished from file level data by ""$$START ...$$"" text."
^XWB(8994,3870,3,4,0)="e.g.:"
^XWB(8994,3870,3,5,0)=" RET(n)=.01^500-PHARMACY^500-PHARMACY"
^XWB(8994,3870,3,6,0)=" RET(n)=.5^Y^YES"
^XWB(8994,3870,3,7,0)=" RET(n)=.6^Y^YES"
^XWB(8994,3870,3,8,0)=" RET(n)= RET(4)=.7^P^PRIMARY"
^XWB(8994,3870,3,9,0)="...etc...then special fields/multiples...multiples..."
^XWB(8994,3870,3,10,0)=" RET(n)=$$TOTAL ITEMS$$_total items for this inventory point"
^XWB(8994,3870,3,11,0)=" RET(n)=$$START DISTRIBUTION POINTS$$  (for Warehouse/Primary only)"
^XWB(8994,3870,3,12,0)=" RET(n)=23^500-DRUG CABINET^SECONDARY   IEN^Name^TypeIEN^Name^Type"
^XWB(8994,3870,3,13,0)=" RET(n)=$$START INVENTORY USERS$$      "
^XWB(8994,3870,3,14,0)=" RET(n)=10046^INVENTORY,MGR^MANAGER     IEN^Name^has key (Manager)"
^XWB(8994,3870,3,15,0)=" RET(n)=$$START FUND CONTROL POINTS$$"
^XWB(8994,3870,3,16,0)=" RET(n)=5555^5555 SUPPLY FUND           IEN^Name  (from file 420)"
^XWB(8994,3870,3,17,0)=" RET(n)=$$START STOCKED BY$$           (for Primary/Secondary Only)"
^XWB(8994,3870,3,18,0)=" RET(n)=350^500-WAREHOUSE^SUPPLY WAREHOUSE IEN^Name^Type "
^XWB(8994,3870,3,19,0)=" RET(n)=$$START MIS COSTING$$          (for Primary/Secondary Only)"
^XWB(8994,3870,3,20,0)=" RET(n)=nnn^name                        IEN^Name"
^XWB(8994,3871,0)="DSIYUTL3 GETSET PULL LIST^GETSET^DSIYUTL3^2^P^0"
^XWB(8994,3871,1,0)="^8994.01^6^6^3150114^^^^"
^XWB(8994,3871,1,1,0)="GETSET"
^XWB(8994,3871,1,2,0)=" "
^XWB(8994,3871,1,3,0)="Returns the SET list from a data dictionary field.  Can be used with any "
^XWB(8994,3871,1,4,0)="file, any field (non-word-processing, non-multiple)."
^XWB(8994,3871,1,5,0)=" "
^XWB(8994,3871,1,6,0)="INPUT:  FILE#, FIELD#"
^XWB(8994,3871,2,0)="^8994.02A^2^2"
^XWB(8994,3871,2,1,0)="FILE^1^15^1^1"
^XWB(8994,3871,2,1,1,0)="^8994.021^3^3^3150114^^^"
^XWB(8994,3871,2,1,1,1,0)="FILE"
^XWB(8994,3871,2,1,1,2,0)=" "
^XWB(8994,3871,2,1,1,3,0)="File # of the field for which to get SET Values"
^XWB(8994,3871,2,2,0)="FIELD^1^6^1^2"
^XWB(8994,3871,2,2,1,0)="^8994.021^3^3^3121115^^^^"
^XWB(8994,3871,2,2,1,1,0)="FIELD"
^XWB(8994,3871,2,2,1,2,0)=" "
^XWB(8994,3871,2,2,1,3,0)="Field # of the field for which to obtain SET Values"
^XWB(8994,3871,2,"B","FIELD",2)=""
^XWB(8994,3871,2,"B","FILE",1)=""
^XWB(8994,3871,2,"PARAMSEQ",1,1)=""
^XWB(8994,3871,2,"PARAMSEQ",2,2)=""
^XWB(8994,3871,3,0)="^8994.03^7^7^3150114^^"
^XWB(8994,3871,3,1,0)="RETURN PARAMETER"
^XWB(8994,3871,3,2,0)=" "
^XWB(8994,3871,3,3,0)="DSIYRET(1)=-1^Error message if errors received"
^XWB(8994,3871,3,4,0)="DSIYRET(1)=""0^Warning message"" if Warnings"
^XWB(8994,3871,3,5,0)="DSIYRET(2)=more information on error if needed."
^XWB(8994,3871,3,6,0)=" "
^XWB(8994,3871,3,7,0)="DSIYRET(#) = SET Internal Value ^ SET External Value"
^XWB(8994,3872,0)="DSIYRPT7 SS STOCK STATUS^SS^DSIYRPT7^4^^^^1"
^XWB(8994,3872,1,0)="^8994.01^10^10^3130429^"
^XWB(8994,3872,1,1,0)="The Stock Status Report will print a summary of all issues, receipts, and"
^XWB(8994,3872,1,2,0)="adjustments with the opening and closing balances by account codes.  It"
^XWB(8994,3872,1,3,0)="will calculate the turnover rate, inactive item percent, long supply"
^XWB(8994,3872,1,4,0)="percent, and non-issuable percent."
^XWB(8994,3872,1,5,0)=" "
^XWB(8994,3872,1,6,0)="All inventory points will have the option to select the specified month "
^XWB(8994,3872,1,7,0)="and year for the report.  Also, users can enter the item inactivity cutoff"
^XWB(8994,3872,1,8,0)="month and year.  Items which have not had activity after the specified"
^XWB(8994,3872,1,9,0)="cutoff date, will be used to calculate the inactive item percent on the"
^XWB(8994,3872,1,10,0)="report."
^XWB(8994,3872,2,0)="^8994.02A^5^5"
^XWB(8994,3872,2,1,0)="MONYR^1^7^1^1"
^XWB(8994,3872,2,1,1,0)="^8994.021^2^2^3130429^^"
^XWB(8994,3872,2,1,1,1,0)="Contains the FileMan formatted Month and Year (e.g. 3120700 for July "
^XWB(8994,3872,2,1,1,2,0)="2012) for the report."
^XWB(8994,3872,2,2,0)="CUTDT^1^7^1^2"
^XWB(8994,3872,2,2,1,0)="^8994.021^2^2^3130429^^"
^XWB(8994,3872,2,2,1,1,0)="Contains the FileMan formatted Month and Year (e.g. 3120400 for April "
^XWB(8994,3872,2,2,1,2,0)="2012 to be used as the inactivity cutoff date.0"
^XWB(8994,3872,2,3,0)="INVP^1^5^0^3"
^XWB(8994,3872,2,3,1,0)="^^2^2^3130429^"
^XWB(8994,3872,2,3,1,1,0)="Contains the Inventory point for the report.  This is the pointer to the "
^XWB(8994,3872,2,3,1,2,0)="GENERIC INVENTORY (#445) file."
^XWB(8994,3872,2,4,0)="ESTART^1^30^0^5"
^XWB(8994,3872,2,4,1,0)="^8994.021^1^1^3130429^^^"
^XWB(8994,3872,2,4,1,1,0)="Earliest time to start scheduled report. Defaults to ""NOW""."
^XWB(8994,3872,2,5,0)="GROUP^1^30^0^4"
^XWB(8994,3872,2,5,1,0)="^^4^4^3130429^"
^XWB(8994,3872,2,5,1,1,0)="GROUP"
^XWB(8994,3872,2,5,1,2,0)=" "
^XWB(8994,3872,2,5,1,3,0)="Name of the group for which to report.  Group names come from "
^XWB(8994,3872,2,5,1,4,0)="^DSIY(19685.41)"
^XWB(8994,3872,2,"B","CUTDT",2)=""
^XWB(8994,3872,2,"B","ESTART",4)=""
^XWB(8994,3872,2,"B","GROUP",5)=""
^XWB(8994,3872,2,"B","INVP",3)=""
^XWB(8994,3872,2,"B","MONYR",1)=""
^XWB(8994,3872,2,"PARAMSEQ",1,1)=""
^XWB(8994,3872,2,"PARAMSEQ",2,2)=""
^XWB(8994,3872,2,"PARAMSEQ",3,3)=""
^XWB(8994,3872,2,"PARAMSEQ",4,4)=""
^XWB(8994,3872,2,"PARAMSEQ",4,5)=""
^XWB(8994,3872,2,"PARAMSEQ",5,4)=""
^XWB(8994,3872,3,0)="^^14^14^3130429^"
^XWB(8994,3872,3,1,0)="RETURN PARAMETER"
^XWB(8994,3872,3,2,0)=" "
^XWB(8994,3872,3,3,0)="DSIYRET(1)=""0^<Warning Message>    If there are warnings/no data"
^XWB(8994,3872,3,4,0)="DSIYRET(1)=""-1^<Error Message>     if there are errors"
^XWB(8994,3872,3,5,0)=" "
^XWB(8994,3872,3,6,0)="Sets up return data from the word processing fields.  The first field of "
^XWB(8994,3872,3,7,0)="each line indicates which kind of line it is.  All other delimited fields "
^XWB(8994,3872,3,8,0)="should be displayed printed as is - formatting will be included."
^XWB(8994,3872,3,9,0)=" "
^XWB(8994,3872,3,10,0)="$$RH   Report Header"
^XWB(8994,3872,3,11,0)="$$SH   Summary Header"
^XWB(8994,3872,3,12,0)="$$SR   Summary Record"
^XWB(8994,3872,3,13,0)="$$DH   Detail Header"
^XWB(8994,3872,3,14,0)="$$DR   Detail REcord"
^XWB(8994,3872,3,15,0)="              1 for Standard"
^XWB(8994,3872,3,16,0)="              2 for On Demand"
^XWB(8994,3872,3,17,0)="              3 for Both (totals) "
^XWB(8994,3872,3,18,0)="where acct# = 1,2,3,6,8 or 99 for the totals"
^XWB(8994,3872,3,19,0)=" "
^XWB(8994,3872,3,20,0)="Non issuable counts are only present on warehouse locations."
^XWB(8994,3872,3,21,0)="If there are no 'on-demand' items then type 2 and 3 will not be returned "
^XWB(8994,3872,3,22,0)="because all values and totals are present on the standard items."
^XWB(8994,3873,0)="DSIYUTL7 EQTRIGUP UPDT TRIG^EQTRIGUP^DSIYUTL7^2^P^0"
^XWB(8994,3873,1,0)="^8994.01^32^32^3150305^^"
^XWB(8994,3873,1,1,0)="EQTRIGUP"
^XWB(8994,3873,1,2,0)="This RPC returns the values for triggered fields whenever a trigger field "
^XWB(8994,3873,1,3,0)="is updated."
^XWB(8994,3873,1,4,0)="The GUI will call this whenever one of the following trigger fields is "
^XWB(8994,3873,1,5,0)="changed:"
^XWB(8994,3873,1,6,0)=" "
^XWB(8994,3873,1,7,0)="Field #6   Equipment Category - triggers Lockout (9), JHACO (27)"
^XWB(8994,3873,1,8,0)="Field #11  PO# - Triggers:  Vendor Pointer (10)"
^XWB(8994,3873,1,9,0)="                            Acquisition Source (13.5)"
^XWB(8994,3873,1,10,0)="                            Service Pointer (21)"
^XWB(8994,3873,1,11,0)="                            Fund Control Point (35)"
^XWB(8994,3873,1,12,0)="                            Budget Object Code (61)"
^XWB(8994,3873,1,13,0)="                            Standard General Ledger (38)"
^XWB(8994,3873,1,14,0)="                            Fund (62)"
^XWB(8994,3873,1,15,0)="                            Administrative Office (63)"
^XWB(8994,3873,1,16,0)="                            Equity Account (64)"
^XWB(8994,3873,1,17,0)="Field #13 - Acquisition Date - Triggers Replacement Date (16)"
^XWB(8994,3873,1,18,0)="Field #15 - Life Expectancy - Triggers Replacement Date (16)"
^XWB(8994,3873,1,19,0)="Field # 18 - Category Stock # - Triggers Life Expectancy (15)"
^XWB(8994,3873,1,20,0)="                                which triggers"
^XWB(8994,3873,1,21,0)="Field #19 - CMR - triggers Service Pointer (21)"
^XWB(8994,3873,1,22,0)="                  Station # (60)"
^XWB(8994,3873,1,23,0)="Field #61 - Budget Object Code - triggers Standard General Ledger (38)"
^XWB(8994,3873,1,24,0)="Field #2 - Parent System - Triggers Y2K Utility System (82)"
^XWB(8994,3873,1,25,0)="Field #24 - Location - Triggers adding date to Physical Inventory Date"
^XWB(8994,3873,1,26,0)=" "
^XWB(8994,3873,1,27,0)="The GUI is responsible for checking to see if the user has already "
^XWB(8994,3873,1,28,0)="updated the field being triggered and to deal with asking the user if "
^XWB(8994,3873,1,29,0)="they want to change it or presenting a warning to the user that it will "
^XWB(8994,3873,1,30,0)="be changed."
^XWB(8994,3873,1,31,0)=" "
^XWB(8994,3873,1,32,0)="                                Replacement Date (16)"
^XWB(8994,3873,2,0)="^8994.02A^3^3"
^XWB(8994,3873,2,1,0)="IEN^1^11^0^1"
^XWB(8994,3873,2,1,1,0)="^8994.021^3^3^3150305^^^"
^XWB(8994,3873,2,1,1,1,0)="IEN"
^XWB(8994,3873,2,1,1,2,0)="The IEN to the Equipment Management file ^ENG(6914)"
^XWB(8994,3873,2,1,1,3,0)="Required"
^XWB(8994,3873,2,2,0)="DSIYDAT^2^60^1^3"
^XWB(8994,3873,2,2,1,0)="^8994.021^4^4^3121204^^^^"
^XWB(8994,3873,2,2,1,1,0)="DSIYDAT"
^XWB(8994,3873,2,2,1,2,0)="This is the data for the trigger field which has changed.  Format is:"
^XWB(8994,3873,2,2,1,3,0)=" "
^XWB(8994,3873,2,2,1,4,0)="DSIYDAT(FIELD#) = Internal Value ^ External Value"
^XWB(8994,3873,2,3,0)="FIELD^1^5^1^2"
^XWB(8994,3873,2,3,1,0)="^8994.021^3^3^3130227^^^^"
^XWB(8994,3873,2,3,1,1,0)="FIELD"
^XWB(8994,3873,2,3,1,2,0)="The Field # which was changed (trigger field)"
^XWB(8994,3873,2,3,1,3,0)="Required"
^XWB(8994,3873,2,"B","DSIYDAT",2)=""
^XWB(8994,3873,2,"B","FIELD",3)=""
^XWB(8994,3873,2,"B","IEN",1)=""
^XWB(8994,3873,2,"PARAMSEQ",1,1)=""
^XWB(8994,3873,2,"PARAMSEQ",2,2)=""
^XWB(8994,3873,2,"PARAMSEQ",2,3)=""
^XWB(8994,3873,2,"PARAMSEQ",3,2)=""
^XWB(8994,3873,2,"PARAMSEQ",3,3)=""
^XWB(8994,3873,3,0)="^8994.03^21^21^3150305^^^^"
^XWB(8994,3873,3,1,0)="RETURN PARAMETER"
^XWB(8994,3873,3,2,0)=" "
^XWB(8994,3873,3,3,0)="Errors:"
^XWB(8994,3873,3,4,0)="   DSIYRET(1)=""-1^Error message"""
^XWB(8994,3873,3,5,0)=" "
^XWB(8994,3873,3,6,0)="Warnings:"
^XWB(8994,3873,3,7,0)="   DSIYRET(1)=""0^Warning message"""
^XWB(8994,3873,3,8,0)=" "
^XWB(8994,3873,3,9,0)="Good Data:"
^XWB(8994,3873,3,10,0)="   DSIYDAT(field#) = field#^^external value^internal value"
^XWB(8994,3873,3,11,0)="   NOTE - second piece would be for label to mimic what's returned in"
^XWB(8994,3873,3,12,0)="          RPC EQINFO - not needed here but wanted to keep fields in the"
^XWB(8994,3873,3,13,0)="          same order"
^XWB(8994,3873,3,14,0)="   These are the values for the fields TRIGGERED by the change to the"
^XWB(8994,3873,3,15,0)="   trigger field"
^XWB(8994,3873,3,16,0)=" "
^XWB(8994,3873,3,17,0)="   NOTE:  The user may have already put in new data for these fields"
^XWB(8994,3873,3,18,0)="          the GUI needs to warn the user or check for new entries"
^XWB(8994,3873,3,19,0)=" "
^XWB(8994,3873,3,20,0)="ASSUMPTION:  Whatever is shown on the GUI screen at the time of saving is "
^XWB(8994,3873,3,21,0)="what will be saved in the global."
^XWB(8994,3874,0)="DSIYWO1 WOSCH WORK ORD SCH^WOSCH^DSIYWO1^4^P^0^^1"
^XWB(8994,3874,1,0)="^8994.01^22^22^3190501^^^^"
^XWB(8994,3874,1,1,0)="WOSCH"
^XWB(8994,3874,1,2,0)=" "
^XWB(8994,3874,1,3,0)="RCP to return Work Orders when searching by several types of fields.  "
^XWB(8994,3874,1,4,0)=" "
^XWB(8994,3874,1,5,0)="Because of the nature of this search, not all fields can be combined."
^XWB(8994,3874,1,6,0)=" "
^XWB(8994,3874,1,7,0)=" "
^XWB(8994,3874,1,8,0)=" "
^XWB(8994,3874,1,9,0)=" "
^XWB(8994,3874,1,10,0)=" "
^XWB(8994,3874,1,11,0)=" "
^XWB(8994,3874,1,12,0)=" "
^XWB(8994,3874,1,13,0)=" "
^XWB(8994,3874,1,14,0)=" "
^XWB(8994,3874,1,15,0)=" "
^XWB(8994,3874,1,16,0)=" "
^XWB(8994,3874,1,17,0)=" "
^XWB(8994,3874,1,18,0)=" "
^XWB(8994,3874,1,19,0)=" "
^XWB(8994,3874,1,20,0)="NOTE:  When searching from the dashboard, leave STAT="""" when pulling up "
^XWB(8994,3874,1,21,0)="items by either Status or Priority to retrieve all with that Status or "
^XWB(8994,3874,1,22,0)="Priority."
^XWB(8994,3874,2,0)="^8994.02A^7^6"
^XWB(8994,3874,2,1,0)="TERM^1^20^0^1"
^XWB(8994,3874,2,1,1,0)="^8994.021^6^6^3121204^^"
^XWB(8994,3874,2,1,1,1,0)="TERM"
^XWB(8994,3874,2,1,1,2,0)=" "
^XWB(8994,3874,2,1,1,3,0)="Search term, if nothing sent, assume to stop at the beginning of "
^XWB(8994,3874,2,1,1,4,0)="whichever type of search we are using."
^XWB(8994,3874,2,1,1,5,0)=" "
^XWB(8994,3874,2,1,1,6,0)="This is the starting point for the search."
^XWB(8994,3874,2,2,0)="NOREC^1^4^0^3"
^XWB(8994,3874,2,2,1,0)="^^3^3^3130725^"
^XWB(8994,3874,2,2,1,1,0)="NOREC"
^XWB(8994,3874,2,2,1,2,0)=" "
^XWB(8994,3874,2,2,1,3,0)="Number of records to return - not required."
^XWB(8994,3874,2,2,1,4,0)="= 40."
^XWB(8994,3874,2,3,0)="SCHBY^1^5^1^2"
^XWB(8994,3874,2,3,1,0)="^^15^15^3121204^"
^XWB(8994,3874,2,3,1,1,0)="SCHBY"
^XWB(8994,3874,2,3,1,2,0)=" "
^XWB(8994,3874,2,3,1,3,0)="Type of search, valid values are:"
^XWB(8994,3874,2,3,1,4,0)=" "
^XWB(8994,3874,2,3,1,5,0)=" ""B""            Search by Work Order #& Original WO #"
^XWB(8994,3874,2,3,1,6,0)=" ""C""                 Location"
^XWB(8994,3874,2,3,1,7,0)=" ""F""                 Manufacturer Name"
^XWB(8994,3874,2,3,1,8,0)=" ""E""                 Equipment ID"
^XWB(8994,3874,2,3,1,9,0)=" ""S""                 Equipment Serial #"
^XWB(8994,3874,2,3,1,10,0)=" ""M""                 Equipment Model #"
^XWB(8994,3874,2,3,1,11,0)=" ""P""                 Shop"
^XWB(8994,3874,2,3,1,12,0)=" ""T""                 Status"
^XWB(8994,3874,2,3,1,13,0)=" ""N""                 Search by Technician"
^XWB(8994,3874,2,3,1,14,0)=" ""R""                 Search by Priority"
^XWB(8994,3874,2,3,1,15,0)=" ""D""                 Search by Date Entered"
^XWB(8994,3874,2,3,1,16,0)=" "
^XWB(8994,3874,2,3,1,17,0)="If the search is to be within a field, add a ""+"" to the search type"
^XWB(8994,3874,2,3,1,18,0)="For example, to search within Serial # use ""S+"""
^XWB(8994,3874,2,3,1,19,0)=" "
^XWB(8994,3874,2,3,1,20,0)="The searches which can use the ""within"" feature have asterisk above."
^XWB(8994,3874,2,4,0)="STAT^1^25^0^4"
^XWB(8994,3874,2,4,1,0)="^8994.021^4^4^3130628^^^^"
^XWB(8994,3874,2,4,1,1,0)="STAT"
^XWB(8994,3874,2,4,1,2,0)=" "
^XWB(8994,3874,2,4,1,3,0)="Internal value for status code."
^XWB(8994,3874,2,4,1,4,0)="Not Required, default = all OPEN statuses"
^XWB(8994,3874,2,4,1,5,0)="Multiple statuses can be entered - to enter more than one status, use the "
^XWB(8994,3874,2,4,1,6,0)="format:"
^XWB(8994,3874,2,4,1,7,0)="^STAT^STAT^STAT^"
^XWB(8994,3874,2,4,1,8,0)=" "
^XWB(8994,3874,2,4,1,9,0)="Make sure the ""^"" is before and after the first/last status code."
^XWB(8994,3874,2,4,1,10,0)=" "
^XWB(8994,3874,2,4,1,11,0)="Not Required, default = all OPEN statuses"
^XWB(8994,3874,2,5,0)="SCHTXT^1^1^0^5"
^XWB(8994,3874,2,5,1,0)="^8994.021^5^5^3121204^^^^"
^XWB(8994,3874,2,5,1,1,0)="SCHTXT"
^XWB(8994,3874,2,5,1,2,0)=" "
^XWB(8994,3874,2,5,1,3,0)="Flag can be set to any single-digit positive number.  If flag is set, "
^XWB(8994,3874,2,5,1,4,0)="search will look for any matching text anywhere in the string.  Note, "
^XWB(8994,3874,2,5,1,5,0)="this search will be much slower."
^XWB(8994,3874,2,6,0)="PMWO^1^1^0^6"
^XWB(8994,3874,2,6,1,0)="^8994.021^6^6^3170330^^^^"
^XWB(8994,3874,2,6,1,1,0)="PMWO"
^XWB(8994,3874,2,6,1,2,0)=" "
^XWB(8994,3874,2,6,1,3,0)="Set to ""P"" to pull on ""PM-"" Work Orders"
^XWB(8994,3874,2,6,1,4,0)="Set to ""A"" to pull ALL Work Orders"
^XWB(8994,3874,2,6,1,5,0)=" "
^XWB(8994,3874,2,6,1,6,0)="If not set, only non-PM Work Orders will be pulled (default)"
^XWB(8994,3874,2,7,0)="DSIYNEXT^1^30^0^5"
^XWB(8994,3874,2,7,1,0)="^8994.021^18^18^3190501^^^^"
^XWB(8994,3874,2,7,1,1,0)="DSIYNEXT"
^XWB(8994,3874,2,7,1,2,0)=" "
^XWB(8994,3874,2,7,1,3,0)="This parameter is only used when the user is asking for more data for a"
^XWB(8994,3874,2,7,1,4,0)="search (pressing pageup/pagedown at the end of the data, etc.)  This will"
^XWB(8994,3874,2,7,1,5,0)="allow the RPC to grab the next set of data to display to the user."
^XWB(8994,3874,2,7,1,6,0)=" "
^XWB(8994,3874,2,7,1,7,0)="Format is:"
^XWB(8994,3874,2,7,1,8,0)=" "
^XWB(8994,3874,2,7,1,9,0)="MOVE^FIRST/LAST IEN"
^XWB(8994,3874,2,7,1,10,0)=" "
^XWB(8994,3874,2,7,1,11,0)="If the user indicates they want to move down through the data - send"
^XWB(8994,3874,2,7,1,12,0)="1^the last IEN from the last search"
^XWB(8994,3874,2,7,1,13,0)=" "
^XWB(8994,3874,2,7,1,14,0)="If the user indicates they want to move up through the data - send"
^XWB(8994,3874,2,7,1,15,0)="-1^the first IEN from the last search"
^XWB(8994,3874,2,7,1,16,0)=" "
^XWB(8994,3874,2,7,1,17,0)="All other parameters (TERM, BY, USE, NOREC, SCHTXT) need to be sent"
^XWB(8994,3874,2,7,1,18,0)="exactly as they were for the original search in this session."
