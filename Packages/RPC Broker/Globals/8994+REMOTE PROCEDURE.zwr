^XWB(8994,4379,3,3,0)=" The format of the returned array will be as follows:"
^XWB(8994,4379,3,4,0)="   List[n] = p1^p2^p3^p4^p5^p6^p7^p8^p8^p10^p11^p12^p13"
^XWB(8994,4379,3,5,0)=" "
^XWB(8994,4379,3,6,0)="     p1  = RECORD OF PROS APPLIANCE/REPAIR IEN (#660)"
^XWB(8994,4379,3,7,0)="     p2  = REQUEST DATE (#660)"
^XWB(8994,4379,3,8,0)="     p3  = QUANTITY (#660)"
^XWB(8994,4379,3,9,0)="     p4  = ITEM DESCRIPTION (#661.1)"
^XWB(8994,4379,3,10,0)="     p5  = PSAS HCPCS (#660)"
^XWB(8994,4379,3,11,0)="     p6  = TYPE OF TRANSACTION (#660)"
^XWB(8994,4379,3,12,0)="     p7  = VENDOR (#660)"
^XWB(8994,4379,3,13,0)="     p8  = STATION (#660)"
^XWB(8994,4379,3,14,0)="     p9  = SERIAL NBR (#660)"
^XWB(8994,4379,3,15,0)="     p10 = DELIVERY DATE (#660)"
^XWB(8994,4379,3,16,0)="     p11 = COST (#660)"
^XWB(8994,4379,3,17,0)="     p12 = REMARKS (#660)"
^XWB(8994,4379,3,18,0)="     p13 = CALCULATION FLAG (#661.1)"
^XWB(8994,4379,3,19,0)=" "
^XWB(8994,4379,3,20,0)=" If nothing is found, the return will be List[n] = 0^NOTHING TO REPORT."
^XWB(8994,4379,3,21,0)=" "
^XWB(8994,4379,3,22,0)=" If an error occurs, the return will be List[n] = -1^message."
