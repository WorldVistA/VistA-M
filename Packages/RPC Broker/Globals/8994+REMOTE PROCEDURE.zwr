^XWB(8994,5041,0)="ORQQVI SWPVIT^SWPVIT^ORQQVI^2^R^^^^^^0"
^XWB(8994,5041,1,0)="^^8^8^3210901^"
^XWB(8994,5041,1,1,0)="Array of patient most recent vitals within start and stop date/times.  If"
^XWB(8994,5041,1,2,0)="no start and stop dates are indicated, the most recent are returned."
^XWB(8994,5041,1,3,0)="  "
^XWB(8994,5041,1,4,0)="If no start date is passed then the start date is 1 (i.e. before any"
^XWB(8994,5041,1,5,0)="dates)."
^XWB(8994,5041,1,6,0)="  "
^XWB(8994,5041,1,7,0)="If no stop date is passed then the start date is also the stop date and if"
^XWB(8994,5041,1,8,0)="there is not start date then 9999999 is used as the stop date."
^XWB(8994,5041,2,0)="^8994.02A^4^4"
^XWB(8994,5041,2,1,0)="PATIENT ID^1^16^1^1"
^XWB(8994,5041,2,1,1,0)="^8994.021^1^1^3210901^^"
^XWB(8994,5041,2,1,1,1,0)="Patient id (DFN) from PATIENT file (#2)."
^XWB(8994,5041,2,2,0)="START DATE/TIME^1^16^^3"
^XWB(8994,5041,2,2,1,0)="^8994.021^1^1^3231218^^^"
^XWB(8994,5041,2,2,1,1,0)="Start date/time from vital retrieval in FileMan format."
^XWB(8994,5041,2,3,0)="STOP DATE/TIME^1^16^^4"
^XWB(8994,5041,2,3,1,0)="^^3^3^3231218^"
^XWB(8994,5041,2,3,1,1,0)="Stop date/time for vital retrieval in FileMan format."
^XWB(8994,5041,2,3,1,2,0)="If none is passed then the Start date is also the stop date and if there"
^XWB(8994,5041,2,3,1,3,0)="is not start date then 9999999 is used as the stop date."
^XWB(8994,5041,2,4,0)="SWAP^1^1^^2"
^XWB(8994,5041,2,4,1,0)="^^3^3^3210901^"
^XWB(8994,5041,2,4,1,1,0)="For Vitals measurements that have both imperial and metric values, send a "
^XWB(8994,5041,2,4,1,2,0)="1 to swap the order of the display. Send a 0 to display imperial first "
^XWB(8994,5041,2,4,1,3,0)="and metric in the third column."
^XWB(8994,5041,2,"B","PATIENT ID",1)=""
^XWB(8994,5041,2,"B","START DATE/TIME",2)=""
^XWB(8994,5041,2,"B","STOP DATE/TIME",3)=""
^XWB(8994,5041,2,"B","SWAP",4)=""
^XWB(8994,5041,2,"PARAMSEQ",1,1)=""
^XWB(8994,5041,2,"PARAMSEQ",2,4)=""
^XWB(8994,5041,2,"PARAMSEQ",3,2)=""
^XWB(8994,5041,2,"PARAMSEQ",4,3)=""
^XWB(8994,5041,3,0)="^^4^4^3210901^"
^XWB(8994,5041,3,1,0)="Array of patient most recent vitals within start and stop date/times.  "
^XWB(8994,5041,3,2,0)="If no start and stop dates are indicated, the most recent are returned."
^XWB(8994,5041,3,3,0)="Vitals are returned in the format:"
^XWB(8994,5041,3,4,0)="vital ien^vital type^rate/value^date/time taken"
^XWB(8994,5042,0)="ORWPT2 ID INFO^IDINFO^ORWPT2^1^R^^^^^^1"
^XWB(8994,5042,1,0)="^8994.01^2^2^3170926^^^"
^XWB(8994,5042,1,1,0)="Returns the Inpatient Provider, Primary Care Provider, Last Location Name, "
^XWB(8994,5042,1,2,0)="and Last Visit Date for a patient."
^XWB(8994,5042,2,0)="^8994.02A^1^1"
^XWB(8994,5042,2,1,0)="DFN^1^^1^1"
^XWB(8994,5042,2,1,1,0)="^8994.021^1^1^3170926^^"
^XWB(8994,5042,2,1,1,1,0)="DFN represents the unique IEN into PATIENT file #2."
^XWB(8994,5042,2,"B","DFN",1)=""
^XWB(8994,5042,2,"PARAMSEQ",1,1)=""
^XWB(8994,5042,3,0)="^^2^2^3170926^"
^XWB(8994,5042,3,1,0)="Returned value contains Inpatient Provider^Primary Care Provider^Last"
^XWB(8994,5042,3,2,0)="Location Name^Last Visit Date."
^XWB(8994,5043,0)="ORWPT2 LOOKUP^LOOKUP^ORWPT2^2^R"
^XWB(8994,5043,1,0)="^^10^10^3231121^"
^XWB(8994,5043,1,1,0)="The purpose of this Remote Procedure Call is to improve patient safety by"
^XWB(8994,5043,1,2,0)="providing a methodology for the Computerized Patient Record System (CPRS)"
^XWB(8994,5043,1,3,0)="to include additional information in the similar patient lookup process."
^XWB(8994,5043,1,4,0)=" "
^XWB(8994,5043,1,5,0)="Specifically, this RPC is a wrapper that includes output from the DG CHK"
^XWB(8994,5043,1,6,0)="B25 XREF ARRAY RPC, and portions of the output from three other RPCs. The"
^XWB(8994,5043,1,7,0)="data from these RPCs is combined to build a list of patients meeting the"
^XWB(8994,5043,1,8,0)="similar name criteria, as well as providing additional clarifying"
^XWB(8994,5043,1,9,0)="information to assist providers in selecting the correct patient. See the"
^XWB(8994,5043,1,10,0)="RETURN PARAMETER DESCRIPTION for detailed information and format."
^XWB(8994,5043,2,0)="^8994.02A^1^1"
^XWB(8994,5043,2,1,0)="DFN^1^20^1^1"
^XWB(8994,5043,2,1,1,0)="^8994.021^1^1^3230224^^^"
^XWB(8994,5043,2,1,1,1,0)="This is the internal entry number (IEN) of the patient. "
^XWB(8994,5043,2,"B","DFN",1)=""
^XWB(8994,5043,2,"PARAMSEQ",1,1)=""
^XWB(8994,5043,3,0)="^8994.03^34^34^3230228^^"
^XWB(8994,5043,3,1,0)="The return from this RPC will include, first, the return from DG CHK B25 "
^XWB(8994,5043,3,2,0)="XREF ARRAY."
^XWB(8994,5043,3,3,0)=" "
^XWB(8994,5043,3,4,0)="Appended to that information will be the following:"
^XWB(8994,5043,3,5,0)=" "
^XWB(8994,5043,3,6,0)="Fields 1-5 come from the DG CHK5 B25 XREF ARRAY "
^XWB(8994,5043,3,7,0)="Field 6 is piece 6 (Inpatient Location) from the ORWPT ID INFO RPC"
^XWB(8994,5043,3,8,0)="Field 7 is piece 2 (Primary Care Provider) from the ORWPT2 ID INFO RPC"
^XWB(8994,5043,3,9,0)="Field 8 is piece 3 (Last Visit Location) from the ORWPT2 ID INFO RPC"
^XWB(8994,5043,3,10,0)="Field 9 is piece 4 (Last Visit Date) from the ORWPT2 ID INFO RPC"
^XWB(8994,5043,3,11,0)="Field 10 is piece 3 (Attending Physician) from the ORWPT1 PRCARE RPC"
^XWB(8994,5043,3,12,0)=" "
^XWB(8994,5043,3,13,0)="The data will be returned in an array. DG CHK B25 XREF ARRAY begins the "
^XWB(8994,5043,3,14,0)="patient data at subscript 2 and the first piece of each line will be a 1. "
^XWB(8994,5043,3,15,0)="A first piece of 0 indicates text to be displayed."
^XWB(8994,5043,3,16,0)=" "
^XWB(8994,5043,3,17,0)="Sample output:"
^XWB(8994,5043,3,18,0)="RETURN(1)=1"
^XWB(8994,5043,3,19,0)="RETURN(2)=""0^There is more than one patient whose last name is "
^XWB(8994,5043,3,20,0)="CPRSPATIENT"""
^XWB(8994,5043,3,21,0)="RETURN(3)=""0^and whose social security number ends with 0018"""
^XWB(8994,5043,3,22,0)="RETURN(4)=""1^100033^CPRSPATIENT"
^XWB(8994,5043,3,23,0)=",EIGHTEEN-PATIENT^2350407^666330018^WARD A^^WARD B^Jan 31, 2023"
^XWB(8994,5043,3,24,0)="^CPRSATTENDING,THIRTYNINE"""
^XWB(8994,5043,3,25,0)="RETURN(5)=""1^100058^CPRSPATIENT"
^XWB(8994,5043,3,26,0)=",FORTYTHREE-PATIENT^2350407^666010018^WARD 3S^^20 MINUTE^Jan 2 7,"
^XWB(8994,5043,3,27,0)="2022^CPRSATTENDING,THIRTYNINE"""
^XWB(8994,5043,3,28,0)="RETURN(6)=""1^100103^CPRSPATIENT"
^XWB(8994,5043,3,29,0)=",EIGHTYNINE-PATIENT^2350407^666980018^WARD 3N^^20 MINUTE^Jul 21,"
^XWB(8994,5043,3,30,0)="2014^CPRSATTENDING,THIRTYNINE"""
