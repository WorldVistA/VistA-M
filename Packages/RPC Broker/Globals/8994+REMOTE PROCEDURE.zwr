^XWB(8994,4851,0)="DSIYGR06 METRPT METRICS REPORT^METRPT^DSIYGR06^4^^^^1"
^XWB(8994,4851,1,0)="^^12^12^3190619^"
^XWB(8994,4851,1,1,0)="Generates a report of all of the items that are part of one of the "
^XWB(8994,4851,1,2,0)="following Metrics Statistics:"
^XWB(8994,4851,1,3,0)=" "
