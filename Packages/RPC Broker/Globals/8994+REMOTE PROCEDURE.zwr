^XWB(8994,4663,1,15,0)="  "
^XWB(8994,4663,1,16,0)="Change the status of a study in the DICOM OBJECT EXPORT file (#2006.574)"
^XWB(8994,4663,1,17,0)="from WAITING, XMIT, or FAILED to HOLD.  Change the status of a HOLD study"
^XWB(8994,4663,1,18,0)="to WAITING so that it can be transmitted."
^XWB(8994,4663,1,19,0)=" "
^XWB(8994,4663,1,20,0)="This option is primarily used to remove a problematic study from the"
^XWB(8994,4663,1,21,0)="transmission queue."
^XWB(8994,4663,2,0)="^8994.02A^2^2"
^XWB(8994,4663,2,1,0)="STUDYIEN^1^30^1^1"
^XWB(8994,4663,2,1,1,0)="^8994.021^2^2^3210601^^^^"
^XWB(8994,4663,2,1,1,1,0)="This is the D0 value in the DICOM OBJECT EXPORT file (#2006.574) IMAGE subfile"
^XWB(8994,4663,2,1,1,2,0)="(#2006.5744)."
^XWB(8994,4663,2,2,0)="HOLDREL^1^30^1^2"
^XWB(8994,4663,2,2,1,0)="^8994.021^3^3^3210601^^^"
^XWB(8994,4663,2,2,1,1,0)="Either the value HOLD or RELEASE.  If it is HOLD, all the DICOM objects will"
^XWB(8994,4663,2,2,1,2,0)="have their status set to HOLD.  If it is RELEASE all DICOM objects will"
^XWB(8994,4663,2,2,1,3,0)="will have their status set to WAITING."
