^XWB(8994,4504,0)="ORWTIU TEMPLATE PREFERENCES^REQDFLD^ORWTIU^1"
^XWB(8994,4504,1,0)="^8994.01^1^1^3210218^^^"
^XWB(8994,4504,1,1,0)="Returns or Saves Template Required Fields personal preferences."
^XWB(8994,4504,2,0)="^8994.02A^2^2"
^XWB(8994,4504,2,1,0)="ACTION^1^^1^1"
^XWB(8994,4504,2,1,1,0)="^^3^3^3201022^"
^XWB(8994,4504,2,1,1,1,0)="This is the action to complete.  It will contain one of two values, ""LDPREF"""
^XWB(8994,4504,2,1,1,2,0)="or ""SVPREF"".  These must be sent exactly in order for the action to take"
^XWB(8994,4504,2,1,1,3,0)="place."
^XWB(8994,4504,2,2,0)="SAVE DATA^1^^0^2"
^XWB(8994,4504,2,2,1,0)="^8994.021^10^10^3210218^^^"
^XWB(8994,4504,2,2,1,1,0)="This is the template required fields preferences to be saved.  When ACTION"
^XWB(8994,4504,2,2,1,2,0)="parameter contains LDPREF, then this value must be included."
^XWB(8994,4504,2,2,1,3,0)=" "
^XWB(8994,4504,2,2,1,4,0)="     HIGHLIGHT ON^HIGHLIGHT COLOR^NAVIGATION LOCATION"
^XWB(8994,4504,2,2,1,5,0)=" "
^XWB(8994,4504,2,2,1,6,0)="     HIGHLIGHT ON = 1 (ON) OR 0 (OFF)"
^XWB(8994,4504,2,2,1,7,0)="     HIGHLIGHT COLOR = A NUMBER REPRESENTING THE COLOR FOR HIGHLIGHTS"
^XWB(8994,4504,2,2,1,8,0)="     NAVIGATION LOCATION = THIS IS THE LOCATION OF THE NAVIGATION CONTROLS"
^XWB(8994,4504,2,2,1,9,0)="          USED TO MOVE BETWEEN REQUIRED FIELDS. 0 = TOP, 1 = LEFT,"
^XWB(8994,4504,2,2,1,10,0)="          2 = RIGHT, 3 = BOTTOM"
^XWB(8994,4504,2,"B","ACTION",1)=""
^XWB(8994,4504,2,"B","SAVE DATA",2)=""
^XWB(8994,4504,2,"PARAMSEQ",1,1)=""
^XWB(8994,4504,2,"PARAMSEQ",2,2)=""
^XWB(8994,4504,3,0)="^8994.03^8^8^3210218^^^"
^XWB(8994,4504,3,1,0)="IF ACTION = LDPREF THEN:"
^XWB(8994,4504,3,2,0)=" "
^XWB(8994,4504,3,3,0)="     HIGHLIGHT ON^HIGHLIGHT COLOR^NAVIGATION LOCATION"
^XWB(8994,4504,3,4,0)=" "
^XWB(8994,4504,3,5,0)="IF ACTION = SVPREF THEN:"
^XWB(8994,4504,3,6,0)=" "
^XWB(8994,4504,3,7,0)="     BOOLEAN - 1 = SUCCESS"
^XWB(8994,4504,3,8,0)="               0 = FAIL"
^XWB(8994,4505,0)="ORWLRAP1 CONFIG^CONFIG^ORWLRAP1^4^^^^1"
^XWB(8994,4505,2,0)="^8994.02A^2^2"
