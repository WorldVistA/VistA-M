^XWB(8994,3050,2,"PARAMSEQ",2,2)=""
^XWB(8994,3050,2,"PARAMSEQ",3,3)=""
^XWB(8994,3050,3,0)="^8994.03^1^1^3091104^^"
^XWB(8994,3050,3,1,0)="Array in format: Array(0)=ErrorNumber^ErrorText^TimeOfError"
^XWB(8994,3051,0)="VPS GET CLINIC^GETCLN^VPSRPC1^2^P^0^^1^1^^1"
^XWB(8994,3051,1,0)="^8994.01^5^5^3120709^^"
^XWB(8994,3051,1,1,0)="Called by the Vetlink Kiosk system.  The RPC will accept a single input"
^XWB(8994,3051,1,2,0)="value representing the name of the clinic (full or partial name); and the"
^XWB(8994,3051,1,3,0)="output produced will be an array that returns all the possible matches for"
^XWB(8994,3051,1,4,0)="the clinic (one to many clinics).  Values returned will be the name of the"
^XWB(8994,3051,1,5,0)="clinic and the ien of the clinic."
^XWB(8994,3051,2,0)="^8994.02A^1^1"
^XWB(8994,3051,2,1,0)="CLINICNAME^1^70^1^1"
^XWB(8994,3051,2,1,1,0)="^8994.021^1^1^3120709^^^^"
^XWB(8994,3051,2,1,1,1,0)="The input would represent a full or partial name of a given clinic."
^XWB(8994,3051,2,"B","CLINICNAME",1)=""
^XWB(8994,3051,2,"PARAMSEQ",1,1)=""
^XWB(8994,3051,3,0)="^8994.03^10^10^3120709^^^^"
^XWB(8994,3051,3,1,0)="A single dimensional array that represents each clinic that matched to "
^XWB(8994,3051,3,2,0)="the input value.  The syntax of the array is:"
^XWB(8994,3051,3,3,0)="LIST(n) = ""FileNum^ClinicIEN^FieldNum^Data^FieldName"""
^XWB(8994,3051,3,4,0)="Exception return value:"
^XWB(8994,3051,3,5,0)="LIST(n)=""-1^Error text message"""
^XWB(8994,3051,3,6,0)=" "
^XWB(8994,3051,3,7,0)="Example of successful return values:"
^XWB(8994,3051,3,8,0)="LIST(1003)=""44^1567^.001^1567^CLINIC NUMBER"""
^XWB(8994,3051,3,9,0)="LIST(1004)=""44^1567^.01^CHY SURG CLARKE WALK IN^NAME"""
^XWB(8994,3051,3,10,0)="LIST(1005)=""44^1567^10^^PHYSICAL LOCATION"""
^XWB(8994,3052,0)="VPS GET PATIENT DEMOGRAPHIC^GETDATA^VPSRPC1^2^P^0^^1^1^^1"
^XWB(8994,3052,1,0)="^^4^4^3151020^"
^XWB(8994,3052,1,1,0)="Called by the Vetlink Kiosk system.  The RPC will accept a single input"
^XWB(8994,3052,1,2,0)="value whic is the patient SSN.  The RPC returns the patient demographics,"
^XWB(8994,3052,1,3,0)="insurance, and appointments (Starting from T-60 and including future "
^XWB(8994,3052,1,4,0)="appointments)."
^XWB(8994,3052,2,0)="^8994.02A^1^1"
^XWB(8994,3052,2,1,0)="SSN^1^12^1^1"
^XWB(8994,3052,2,1,1,0)="^8994.021^1^1^3151020^^^^"
^XWB(8994,3052,2,1,1,1,0)="Social Security Number"
^XWB(8994,3052,2,"B","SSN",1)=""
^XWB(8994,3052,2,"PARAMSEQ",1,1)=""
^XWB(8994,3052,3,0)="^8994.03^5^5^3151020^^^^"
^XWB(8994,3052,3,1,0)="Single dimensional array that represents the patient demographics, "
^XWB(8994,3052,3,2,0)="appointments, insurance information."
^XWB(8994,3052,3,3,0)="ARRAY(n)=File#^dfn;multiple entries^field#^Data^Fieldname"""
^XWB(8994,3052,3,4,0)="exception data string:"
^XWB(8994,3052,3,5,0)="ARRAY(n)=""-1^Error text message"""
^XWB(8994,3053,0)="EDPGLOB RPC^RPC^EDPGLOB^4^R^^^^1^^0"
^XWB(8994,3053,1,0)="^8994.01^3^3^3120531^^^^"
^XWB(8994,3053,1,1,0)="This RPC acts as the ""front controller"" for laboratory data calls. The "
^XWB(8994,3053,1,2,0)="RPC uses the parameters passed in to gather lab data for a given patient, "
^XWB(8994,3053,1,3,0)="and return the data in XML format."
^XWB(8994,3053,2,0)="^8994.02A^2^2"
^XWB(8994,3053,2,1,0)="PARAMS^2^^0^1"
^XWB(8994,3053,2,2,0)="PARAMS2^2^^0^2"
^XWB(8994,3053,2,"B","PARAMS",1)=""
^XWB(8994,3053,2,"B","PARAMS2",2)=""
^XWB(8994,3053,2,"PARAMSEQ",1,1)=""
^XWB(8994,3053,2,"PARAMSEQ",2,2)=""
^XWB(8994,3053,3,0)="^8994.03^1^1^3120531^^^"
^XWB(8994,3053,3,1,0)="The return results are formatted as an XML document."
^XWB(8994,3054,0)="DSIV ONE LOC APPTS^RQONELOC^DSIVIC5^4^P^^^1"
^XWB(8994,3054,1,0)="^8994.01^2^2^3120430^^^^"
^XWB(8994,3054,1,1,0)="Request all appointments for one hospital location with insurance flag, "
^XWB(8994,3054,1,2,0)="check-in user, check-out user, and manual patient flag."
^XWB(8994,3054,2,0)="^8994.02A^8^8"
^XWB(8994,3054,2,1,0)="MORE^1^1^0^8"
^XWB(8994,3054,2,1,1,0)="^8994.021^3^3^3120430^^^^"
^XWB(8994,3054,2,1,1,1,0)="Contains a 1 if this is a second call to the rpc to get more records.  "
^XWB(8994,3054,2,1,1,2,0)="Used with the NUMS field to get sets of data and not overwhelm the broker "
^XWB(8994,3054,2,1,1,3,0)="or timeout."
^XWB(8994,3054,2,2,0)="LOCIEN^1^16^1^1"
^XWB(8994,3054,2,2,1,0)="^8994.021^1^1^3120430^^^^"
^XWB(8994,3054,2,2,1,1,0)="Hospital Location IEN"
^XWB(8994,3054,2,3,0)="SDT^1^16^0^2"
^XWB(8994,3054,2,3,1,0)="^8994.021^1^1^3120430^^^^"
^XWB(8994,3054,2,3,1,1,0)="FileMan Start date.time (optional)"
^XWB(8994,3054,2,4,0)="EDT^1^16^0^3"
^XWB(8994,3054,2,4,1,0)="^8994.021^1^1^3120430^^^^"
^XWB(8994,3054,2,4,1,1,0)="FileMan End date.time (optional)"
^XWB(8994,3054,2,5,0)="DAYS^1^10^0^4"
^XWB(8994,3054,2,5,1,0)="^8994.021^1^1^3120430^^^^"
^XWB(8994,3054,2,5,1,1,0)="Number of days prior to today for last verified check (default=182)"
^XWB(8994,3054,2,6,0)="SCREEN^1^1^0^5"
^XWB(8994,3054,2,6,1,0)="^8994.021^2^2^3120430^^^^"
^XWB(8994,3054,2,6,1,1,0)="Contains the type of appointment to screen out:  1=checked in (which also "
^XWB(8994,3054,2,6,1,2,0)="screens checked out appointments by default) or 2=checked out"
^XWB(8994,3054,2,7,0)="NUMS^1^9^0^7"
^XWB(8994,3054,2,7,1,0)="^8994.021^1^1^3120430^^^^"
^XWB(8994,3054,2,7,1,1,0)="Contains the number of records to return for each call."
^XWB(8994,3054,2,8,0)="BUF^1^1^0^6"
^XWB(8994,3054,2,8,1,0)="^8994.021^2^2^3120430^^^^"
^XWB(8994,3054,2,8,1,1,0)="This field can be set to 1 to screen out (not return) appointments if "
^XWB(8994,3054,2,8,1,2,0)="there's an existing buffer entry for that patient."
^XWB(8994,3054,2,"B","BUF",8)=""
^XWB(8994,3054,2,"B","DAYS",5)=""
^XWB(8994,3054,2,"B","EDT",4)=""
^XWB(8994,3054,2,"B","LOCIEN",2)=""
^XWB(8994,3054,2,"B","MORE",1)=""
^XWB(8994,3054,2,"B","NUMS",7)=""
^XWB(8994,3054,2,"B","SCREEN",6)=""
^XWB(8994,3054,2,"B","SDT",3)=""
^XWB(8994,3054,2,"PARAMSEQ",1,2)=""
^XWB(8994,3054,2,"PARAMSEQ",2,3)=""
^XWB(8994,3054,2,"PARAMSEQ",3,4)=""
^XWB(8994,3054,2,"PARAMSEQ",4,5)=""
^XWB(8994,3054,2,"PARAMSEQ",5,6)=""
^XWB(8994,3054,2,"PARAMSEQ",6,8)=""
^XWB(8994,3054,2,"PARAMSEQ",7,7)=""
^XWB(8994,3054,2,"PARAMSEQ",8,1)=""
^XWB(8994,3054,3,0)="^8994.03^28^28^3120430^^^"
^XWB(8994,3054,3,1,0)="Global array.  Each node has 10-12 pieces."
^XWB(8994,3054,3,2,0)="On error, RESULT(1)=-1^Error message"
^XWB(8994,3054,3,3,0)=" "
^XWB(8994,3054,3,4,0)="The first six pieces are the same as those described in the "
^XWB(8994,3054,3,5,0)="VEJDSD GET SCHEDULED APPTS remote procedure return parameter"
^XWB(8994,3054,3,6,0)="description."
^XWB(8994,3054,3,7,0)=" "
^XWB(8994,3054,3,8,0)="The 7th piece is an insurance flag:"
^XWB(8994,3054,3,9,0)="Flag Value 1=Either of the following conditions are met:"
^XWB(8994,3054,3,10,0)="    a.  Field #.3192 COVERED BY INSURANCE=NO or UNKNOWN"
^XWB(8994,3054,3,11,0)="    b.  For ANY .312 field 3 entry"
^XWB(8994,3054,3,12,0)="        If Last Verified > n DAYS before today "
^XWB(8994,3054,3,13,0)="        AND expiration date > today "
^XWB(8994,3054,3,14,0)="        OR  expiration date is NULL"
^XWB(8994,3054,3,15,0)="Flag Value 0=Otherwise"
^XWB(8994,3054,3,16,0)=" "
^XWB(8994,3054,3,17,0)="The 8th and 9th ^-pieces have additional information if"
^XWB(8994,3054,3,18,0)="insurance is verified as NO coverage."
^XWB(8994,3054,3,19,0)=" "
^XWB(8994,3054,3,20,0)="The 10th piece is check-in user from the 7th piece of the"
^XWB(8994,3054,3,21,0)="VEJDSD GET SCHEDULED APPTS return parameter description."
^XWB(8994,3054,3,22,0)=" "
^XWB(8994,3054,3,23,0)="The 11th piece is check-out user from the 8th piece of the"
^XWB(8994,3054,3,24,0)="VEJDSD GET SCHEDULED APPTS return parameter description."
^XWB(8994,3054,3,25,0)=" "
^XWB(8994,3054,3,26,0)="The 12th piece is the manual patient verification flag "
^XWB(8994,3054,3,27,0)="(field .01 PATIENT) from file 19625.3 DSIV ICB MANUAL"
^XWB(8994,3054,3,28,0)="PATIENT FLAG."
^XWB(8994,3055,0)="DSIV PRODUCTIVITY REPORT^RPT^DSIVICR3^1^^^^1"
^XWB(8994,3055,1,0)="^8994.01^2^2^3120627^^"
^XWB(8994,3055,1,1,0)="Returns productivity report data which in a combination of the ICB "
^XWB(8994,3055,1,2,0)="Entered By User and Exception reports."
^XWB(8994,3055,2,0)="^8994.02A^5^5"
^XWB(8994,3055,2,1,0)="DSIVSDT^1^20^1^1"
^XWB(8994,3055,2,1,1,0)="^^1^1^3120508^"
^XWB(8994,3055,2,1,1,1,0)="Start Date of the report"
^XWB(8994,3055,2,2,0)="DSIVEDT^1^20^1^2"
^XWB(8994,3055,2,2,1,0)="^^1^1^3120508^"
^XWB(8994,3055,2,2,1,1,0)="End date of the report."
^XWB(8994,3055,2,3,0)="DSIVRPT^1^2^1^3"
^XWB(8994,3055,2,3,1,0)="^^1^1^3120627^"
^XWB(8994,3055,2,3,1,1,0)="Report type: C=Clinic, U=User, CU=Clinic and User, UC=User and Clinic"
^XWB(8994,3055,2,4,0)="DSIVHNDL^1^30^1^4"
^XWB(8994,3055,2,4,1,0)="^^2^2^3120508^"
^XWB(8994,3055,2,4,1,1,0)="Handle for the background job and XTMP global that contains the report "
^XWB(8994,3055,2,4,1,2,0)="status and data."
^XWB(8994,3055,2,5,0)="DSIVLOCS^2^30^0^5"
^XWB(8994,3055,2,5,1,0)="^^2^2^3120508^"
^XWB(8994,3055,2,5,1,1,0)="Contains an optional list of locations to include or exclude from the "
^XWB(8994,3055,2,5,1,2,0)="report."
^XWB(8994,3055,2,"B","DSIVEDT",2)=""
^XWB(8994,3055,2,"B","DSIVHNDL",4)=""
^XWB(8994,3055,2,"B","DSIVLOCS",5)=""
^XWB(8994,3055,2,"B","DSIVRPT",3)=""
^XWB(8994,3055,2,"B","DSIVSDT",1)=""
^XWB(8994,3055,2,"PARAMSEQ",1,1)=""
^XWB(8994,3055,2,"PARAMSEQ",2,2)=""
^XWB(8994,3055,2,"PARAMSEQ",3,3)=""
^XWB(8994,3055,2,"PARAMSEQ",4,4)=""
^XWB(8994,3055,2,"PARAMSEQ",5,5)=""
^XWB(8994,3055,3,0)="^^9^9^3120627^"
^XWB(8994,3055,3,1,0)="Global array containing report data:"
^XWB(8994,3055,3,2,0)=" when DSIVRPT=""C"" for Clinic then return is:"
^XWB(8994,3055,3,3,0)="       turn=Clinic^totalentries^totalnoins^totalexceptions"
^XWB(8994,3055,3,4,0)=" when DSIVRPT=""U"" for User then return is:"
^XWB(8994,3055,3,5,0)="       Return=User^totalentries^totalnoins^totalexceptions"
^XWB(8994,3055,3,6,0)=" when  DSIVRPT=""CU"" for Both Clinic and User then return is:"
^XWB(8994,3055,3,7,0)="       Clinic|User^totalentries^totalnoins^totalexceptions"
^XWB(8994,3055,3,8,0)=" when  DSIVRPT=""UC"" for User and Clinic then return is:"
^XWB(8994,3055,3,9,0)="       Return=User|Clinic^totalentries^totalnoins^totalexceptions"
^XWB(8994,3056,0)="DSIV POLL PRODUCTIVITY^POLL^DSIVICR3^4^^^^1"
^XWB(8994,3056,1,0)="^8994.01^2^2^3120522^"
^XWB(8994,3056,1,1,0)="Used to check the status of the background job kicked off by the DSIV "
^XWB(8994,3056,1,2,0)="PRODUCTIVITY REPORT rpc and to return results from that report."
^XWB(8994,3056,2,0)="^8994.02A^3^3"
^XWB(8994,3056,2,1,0)="DSIVHNDL^1^50^1^1"
^XWB(8994,3056,2,1,1,0)="^^2^2^3120522^"
^XWB(8994,3056,2,1,1,1,0)="Contains the Handle returned by the kick-off rpc (or sent by the GUI) to "
^XWB(8994,3056,2,1,1,2,0)="uniquely identify a report instance running in the background."
^XWB(8994,3056,2,2,0)="CNT^1^10^0^2"
^XWB(8994,3056,2,2,1,0)="^^2^2^3120522^"
^XWB(8994,3056,2,2,1,1,0)="The number of records to return for each call of the rpc.  This is used "
^XWB(8994,3056,2,2,1,2,0)="to avoid broker timeouts for reports with a lot of data."
^XWB(8994,3056,2,3,0)="MORE^1^1^0^3"
^XWB(8994,3056,2,3,1,0)="^^4^4^3120522^"
^XWB(8994,3056,2,3,1,1,0)="MORE=1 when subsequent calls are made to the rpc to return the next "
^XWB(8994,3056,2,3,1,2,0)="""CNT"" (count) of rows of report data.  The GUI may send MORE=9 to "
^XWB(8994,3056,2,3,1,3,0)="terminate the report and have the M code kill the ^XTMP global as it is "
^XWB(8994,3056,2,3,1,4,0)="no longer needed."
^XWB(8994,3056,2,"B","CNT",2)=""
^XWB(8994,3056,2,"B","DSIVHNDL",1)=""
^XWB(8994,3056,2,"B","MORE",3)=""
^XWB(8994,3056,2,"PARAMSEQ",1,1)=""
^XWB(8994,3056,2,"PARAMSEQ",2,2)=""
^XWB(8994,3056,2,"PARAMSEQ",3,3)=""
^XWB(8994,3056,3,0)="^^7^7^3120522^"
^XWB(8994,3056,3,1,0)="Returns -1^error, or 0^Results not ready, or"
^XWB(8994,3056,3,2,0)="  Ret(1) = $START$report start date^report end date (reqst'd by user)"
^XWB(8994,3056,3,3,0)="  Ret(n) = ReportTypeSort^totalentries^totalnoins^totalexceptions"
^XWB(8994,3056,3,4,0)="  Ret(~) = $END$QUEUED dttm^rpt START RUN dttm^rpt END RUN dttm"
^XWB(8994,3056,3,5,0)=" "
^XWB(8994,3056,3,6,0)="ReportTypeSort will be Clinic for ""C""linic report, User for ""U""ser "
^XWB(8994,3056,3,7,0)="report, Clinic|User for ""B""oth report and User|Clinic for ""UC"" report."
^XWB(8994,3057,0)="DSIV FILE INSURANCE TO AUDIT^IN^DSIVIM^2"
^XWB(8994,3057,1,0)="^8994.01^3^3^3120525^^"
^XWB(8994,3057,1,1,0)="Files new insurance data fields from ICB to the DSIV ICB AUDIT (#19625) "
^XWB(8994,3057,1,2,0)="file that are not part of the INSURANCE BUFFER (#355.33) file so that they"
^XWB(8994,3057,1,3,0)="may be updated as part of buffer processing by insurance verifiers."
^XWB(8994,3057,2,0)="^8994.02A^2^2"
^XWB(8994,3057,2,1,0)="DSIVAUD^1^30^1^1"
^XWB(8994,3057,2,1,1,0)="^^1^1^3120525^"
^XWB(8994,3057,2,1,1,1,0)="Pointer to the DSIV ICB AUDIT (#19625) file."
^XWB(8994,3057,2,2,0)="DATA^2^80^1^2"
^XWB(8994,3057,2,2,1,0)="^8994.021^8^8^3120525^^"
^XWB(8994,3057,2,2,1,1,0)="Contains data to file in the following format: "
^XWB(8994,3057,2,2,1,2,0)="D DATA(n)=field^multi-id^value"
^XWB(8994,3057,2,2,1,3,0)=" e.g. DATA(1)=""6.01^0^1"""
^XWB(8994,3057,2,2,1,4,0)="      DATA(2)=""6.02^0^2"""
^XWB(8994,3057,2,2,1,5,0)="      DATA(3)=""8^1^SYN1"" SYNONYM is fld 8, subfile 19625.08 (multiple)"
^XWB(8994,3057,2,2,1,6,0)="      DATA(4)=""8^2^SYN2"""
^XWB(8994,3057,2,2,1,7,0)="      DATA(5)=""9^1^FIRST LINE OF REMARKS""  REMARKS is field 9, wp field"
^XWB(8994,3057,2,2,1,8,0)="      DATA(6)=""9^2^SECOND LINE OF REMARKS"""
^XWB(8994,3057,2,"B","DATA",2)=""
^XWB(8994,3057,2,"B","DSIVAUD",1)=""
^XWB(8994,3057,2,"PARAMSEQ",1,1)=""
^XWB(8994,3057,2,"PARAMSEQ",2,2)=""
^XWB(8994,3057,3,0)="^8994.03^6^6^3120525^^^"
^XWB(8994,3057,3,1,0)="RET(n) will exist based on what data is sent, if only 6.01-6.09 is sent "
^XWB(8994,3057,3,2,0)="then only RET(1) is returned."
^XWB(8994,3057,3,3,0)=" "
^XWB(8994,3057,3,4,0)=" RET(1)=-1^error or 0^Record updated for fields 6.01-6.09 (NOT 6.08)"
^XWB(8994,3057,3,5,0)=" RET(2)=-1^error or 0^Synonym(s) updated"
^XWB(8994,3057,3,6,0)=" RET(3)=-1^error or 0^Remarks updated"
^XWB(8994,3064,0)="DGBT CLAIM DEDUCTIBLE PAID^RPC^DGBTRDV^2^P^^^0"
^XWB(8994,3064,1,0)="^8994.01^2^2^3180830^^^^"
^XWB(8994,3064,1,1,0)="THIS RPC IS USED BY BENEFICIARY TRAVEL PACKAGE TO RETRIEVE TRAVEL CLAIM "
^XWB(8994,3064,1,2,0)="INFORMATION ABOUT ANY TRAVEL CLAIMS FOR PATIENT."
^XWB(8994,3064,2,0)="^8994.02A^2^1"
^XWB(8994,3064,2,1,0)="PATIENT ICN^1^30^1^1"
^XWB(8994,3064,2,1,1,0)="^8994.021^1^1^3180320^^^^"
^XWB(8994,3064,2,1,1,1,0)="PATIENTS ICN NUMBER FROM ^DPT(DFN)."
^XWB(8994,3064,2,2,0)="CLAIM DATE^1^15^1^2"
^XWB(8994,3064,2,2,1,0)="^8994.021^1^1^3180830^^^^"
^XWB(8994,3064,2,2,1,1,0)="BENEFICIARY TRAVEL CLAIM DATE (NOT THE CURRENT DATE)."
^XWB(8994,3064,2,"B","CLAIM DATE",2)=""
^XWB(8994,3064,2,"B","PATIENT ICN",1)=""
^XWB(8994,3064,2,"PARAMSEQ",1,1)=""
^XWB(8994,3064,2,"PARAMSEQ",2,2)=""
^XWB(8994,3064,3,0)="^8994.03^2^2^3180830^^^^"
^XWB(8994,3064,3,1,0)="THE RPC WILL RETURN THE NUMBER OF CLAIMS AND AMOUNT OF DEDUCTIBLE PAID BY "
^XWB(8994,3064,3,2,0)="A PATIENT DURING THE CURRENT MONTH."
^XWB(8994,3065,0)="DVBAB GET VVA TOKEN^VVATOKEN^DVBABURL^1^R"
^XWB(8994,3065,1,0)="^^2^2^3120531^"
^XWB(8994,3065,1,1,0)="This remote procedure retrieves the username, password, and token value "
^XWB(8994,3065,1,2,0)="passed to the Virtual VA web service."
^XWB(8994,3065,3,0)="^^3^3^3120531^"
^XWB(8994,3065,3,1,0)="Returns the values for username, password, and token as a single "
^XWB(8994,3065,3,2,0)="caret-delimited string."
^XWB(8994,3065,3,3,0)="Example:  capri^XXXXX^Username-1"
^XWB(8994,3066,0)="DVBAB 8861 NOTIFICATIONS^ENTER^DVBANTFY^1^R^0^^0"
^XWB(8994,3066,1,0)="^8994.01^1^1^3120815^^^^"
^XWB(8994,3066,1,1,0)="This will perform MailMan notifications for Form 8861 Requests based on the status of the request."
^XWB(8994,3066,2,0)="^8994.02A^2^2"
^XWB(8994,3066,2,1,0)="IEN^1^5^1^1"
^XWB(8994,3066,2,1,1,0)="^8994.021^1^1^3120628^^^"
^XWB(8994,3066,2,1,1,1,0)="IEN of the request."
^XWB(8994,3066,2,2,0)="STAT^1^9^1^2"
^XWB(8994,3066,2,2,1,0)="^8994.021^1^1^3120815^^^^"
^XWB(8994,3066,2,2,1,1,0)="Status of Form 8861 request. This determines what message is sent and to whom."
^XWB(8994,3066,2,"B","IEN",1)=""
^XWB(8994,3066,2,"B","STAT",2)=""
^XWB(8994,3066,2,"PARAMSEQ",1,1)=""
^XWB(8994,3066,2,"PARAMSEQ",2,2)=""
^XWB(8994,3066,3,0)="^8994.03^1^1^3120711^^^^"
^XWB(8994,3066,3,1,0)="The RPC returns either a success or failure to send the MailMan notification, either 0 or 1."
^XWB(8994,3067,0)="DVBA MVI SEARCH PERSON^FNDPAT^DVBAMVI1^2^A^^^1"
^XWB(8994,3067,1,0)="^8994.01^2^2^3121004^^^^"
^XWB(8994,3067,1,1,0)="This remote procedure passes the delimited person traits to the MVI "
^XWB(8994,3067,1,2,0)="SEARCH PERSON web service and returns the results of the search."
^XWB(8994,3067,2,0)="^8994.02A^4^3"
^XWB(8994,3067,2,2,0)="PERSON TRAITS^1^^1^1"
^XWB(8994,3067,2,2,1,0)="^8994.021^10^10^3120813^^^"
^XWB(8994,3067,2,2,1,1,0)="Patient demographics used for search contained in a single ""^""-delimited "
^XWB(8994,3067,2,2,1,2,0)="string."
^XWB(8994,3067,2,2,1,3,0)=" "
^XWB(8994,3067,2,2,1,4,0)="  Piece 1: FIRSTNAME             (required)"
^XWB(8994,3067,2,2,1,5,0)="  Piece 2: MIDDLENAME or INITIAL (optional)"
^XWB(8994,3067,2,2,1,6,0)="  Piece 3: LASTNAME              (required) "
^XWB(8994,3067,2,2,1,7,0)="  Piece 4: SSN (9 digits)        (required)  "
^XWB(8994,3067,2,2,1,8,0)="  Piece 5: BIRTHDATE (FM format) (required)"
^XWB(8994,3067,2,2,1,9,0)=" "
^XWB(8994,3067,2,2,1,10,0)="  Example:  CAPRI^TEST^PATIENT^999999999^2540101"
^XWB(8994,3067,2,3,0)="INITIAL QUANTITY^1^^0^2"
^XWB(8994,3067,2,3,1,0)="^8994.021^3^3^3121004^^^^"
^XWB(8994,3067,2,3,1,1,0)="This optional parameter populates the initialQuantity value attribute in"
^XWB(8994,3067,2,3,1,2,0)="the 1305 HL7v3 message. The minimum value is 1 and the maximum value is"
^XWB(8994,3067,2,3,1,3,0)="10.  The parameter will default to 10 when the parameter is not defined."
^XWB(8994,3067,2,4,0)="NAME FORMAT^1^^0^3"
^XWB(8994,3067,2,4,1,0)="^8994.021^4^4^3121004^^"
^XWB(8994,3067,2,4,1,1,0)="This optional parameter controls the format of the full name result"
^XWB(8994,3067,2,4,1,2,0)="returned. Setting the parameter to 1 causes the name to be formatted as"
^XWB(8994,3067,2,4,1,3,0)="LASTNAME,FIRSTNAME MIDDLENAME SUFFIX.  Any other value or no value causes"
^XWB(8994,3067,2,4,1,4,0)="the name to be formatted as FIRSTNAME MIDDLENAME LASTNAME SUFFIX."
^XWB(8994,3067,2,"B","INITIAL QUANTITY",3)=""
^XWB(8994,3067,2,"B","NAME FORMAT",4)=""
^XWB(8994,3067,2,"B","PERSON TRAITS",2)=""
^XWB(8994,3067,2,"PARAMSEQ",1,2)=""
^XWB(8994,3067,2,"PARAMSEQ",2,3)=""
^XWB(8994,3067,2,"PARAMSEQ",3,4)=""
^XWB(8994,3067,3,0)="^^31^31^3121004^"
^XWB(8994,3067,3,1,0)="The zero array node returns the caret-delimited record count and search"
^XWB(8994,3067,3,2,0)="status results."
^XWB(8994,3067,3,3,0)=" "
^XWB(8994,3067,3,4,0)="  Piece 1: Returned record count"
^XWB(8994,3067,3,5,0)="  Piece 2: OK or error message text"
^XWB(8994,3067,3,6,0)=" "
^XWB(8994,3067,3,7,0)="Array node 1 starts the list of caret-delimited matching patient"
^XWB(8994,3067,3,8,0)="records."
^XWB(8994,3067,3,9,0)=" "
^XWB(8994,3067,3,10,0)="  Piece 1: FULLNAME                        "
^XWB(8994,3067,3,11,0)="  Piece 2: SSN  (9 digits) "
^XWB(8994,3067,3,12,0)="  Piece 3: DATE OF BIRTH (external format)          "
^XWB(8994,3067,3,13,0)="  Pieces 4-7 contain the MVI ID components              "
^XWB(8994,3067,3,14,0)="    Piece 4:  ID"
^XWB(8994,3067,3,15,0)="    Piece 5:  IdType"
^XWB(8994,3067,3,16,0)="    Piece 6:  Assigning Location"
^XWB(8994,3067,3,17,0)="    Piece 7:  Assigning Issuer"
^XWB(8994,3067,3,18,0)=" "
^XWB(8994,3067,3,19,0)="Example results:"
^XWB(8994,3067,3,20,0)=" "
^XWB(8994,3067,3,21,0)="Default name format:"
^XWB(8994,3067,3,22,0)="R(0)=2^OK"
^XWB(8994,3067,3,23,0)="R(1)=CAPRI PATIENT^111905454^01/01/1980^1062212234V192931^NI^200M^USVHA"
^XWB(8994,3067,3,24,0)="R(2)=CAPRI T PATIENT^111905454^01/01/1980^1008591712V479586^NI^200M^USVHA"
^XWB(8994,3067,3,25,0)=" "
^XWB(8994,3067,3,26,0)="VistA name format:"
^XWB(8994,3067,3,27,0)="R(0)=1^OK"
^XWB(8994,3067,3,28,0)="R(1)=PATIENT,CAPRI T^111905454^01/01/1980^1008591712V479586^NI^200M^USVHA"
^XWB(8994,3067,3,29,0)=" "
^XWB(8994,3067,3,30,0)="Error:"
^XWB(8994,3067,3,31,0)="R(0)=0^Acknowledgement Error: Multiple Matches Found[4]"
^XWB(8994,3068,0)="DVBA MVI GET CORRESPONDING IDS^GETIDS^DVBAMVI2^2^A^^^1"
^XWB(8994,3068,1,0)="^8994.01^3^3^3120813^^"
^XWB(8994,3068,1,1,0)="The remote procedure passes the Integration Control Number ID to the MVI "
^XWB(8994,3068,1,2,0)="GET CORRESPONDING IDS web service and returns the list of VAMC treating"
^XWB(8994,3068,1,3,0)="facilities for the selected identifier."
^XWB(8994,3068,2,0)="^8994.02A^1^1"
^XWB(8994,3068,2,1,0)="SOURCE ID^1^250^1^1"
^XWB(8994,3068,2,1,1,0)="^8994.021^3^3^3120813^^"
^XWB(8994,3068,2,1,1,1,0)="This is the Integration Control Number (ICN) used to identify the patient"
^XWB(8994,3068,2,1,1,2,0)="that is selected from the MVI SEARCH PERSON web service results."
^XWB(8994,3068,2,1,1,3,0)="Format:  ""1008523099V750710^NI^200M^USVHA^"""
^XWB(8994,3068,2,"B","SOURCE ID",1)=""
^XWB(8994,3068,2,"PARAMSEQ",1,1)=""
^XWB(8994,3068,3,0)="^8994.03^10^10^3120813^^"
^XWB(8994,3068,3,1,0)="List of VAMC treating facilities associated with the passed identifier."
^XWB(8994,3068,3,2,0)="Each line contains INSTITUTION (#4) file IEN, station name ,and station"
^XWB(8994,3068,3,3,0)="number delimited by a caret (""^"").  The first entry in the list contains"
^XWB(8994,3068,3,4,0)="the total number of stations returned."
^XWB(8994,3068,3,5,0)=" "
^XWB(8994,3068,3,6,0)="  Format: instutionIEN^stationName^stationNumber"
^XWB(8994,3068,3,7,0)=" "
^XWB(8994,3068,3,8,0)="  Example:  DVBOUT(0)=2"
^XWB(8994,3068,3,9,0)="            DVBOUT(1)=""516^BAY PINES VA HCS^516"""
^XWB(8994,3068,3,10,0)="            DVBOUT(2)=""523^BOSTON HCS VAMC^523"""
^XWB(8994,3069,0)="DSIR RX CHECK^RXEN^DSIROI9^4^^^^1"
^XWB(8994,3069,1,0)="^^3^3^3120823^"
^XWB(8994,3069,1,1,0)="This RPC will take the data returned from ORQQPS LIST and check the FILL "
^XWB(8994,3069,1,2,0)="DATE of the PRESCRIPTION to validate the value falls between the date "
^XWB(8994,3069,1,3,0)="range specified."
^XWB(8994,3069,2,0)="^8994.02A^3^3"
^XWB(8994,3069,2,1,0)="STDT^1^7^1^1"
^XWB(8994,3069,2,1,1,0)="^8994.021^1^1^3120823^^"
^XWB(8994,3069,2,1,1,1,0)="Start Date - Required (FileMan Date Format)"
^XWB(8994,3069,2,2,0)="ENDT^1^7^0^2"
^XWB(8994,3069,2,2,1,0)="^^1^1^3120823^"
^XWB(8994,3069,2,2,1,1,0)="End Date - Optional (FileMan Date Format - Default to current day)"
^XWB(8994,3069,2,3,0)="DATA^2^254^0^3"
^XWB(8994,3069,2,3,1,0)="^^1^1^3120823^"
^XWB(8994,3069,2,3,1,1,0)="Array as returned from RPC: ORQQPS LIST - Optional"
^XWB(8994,3069,2,"B","DATA",3)=""
^XWB(8994,3069,2,"B","ENDT",2)=""
^XWB(8994,3069,2,"B","STDT",1)=""
^XWB(8994,3069,2,"PARAMSEQ",1,1)=""
^XWB(8994,3069,2,"PARAMSEQ",2,2)=""
^XWB(8994,3069,2,"PARAMSEQ",3,3)=""
^XWB(8994,3069,3,0)="^^4^4^3120823^"
^XWB(8994,3069,3,1,0)="Return Array"
^XWB(8994,3069,3,2,0)="        -1 ^ Missing Start Date!"
^XWB(8994,3069,3,3,0)="        0 ^ No Prescriptions for Date Range!"
^XWB(8994,3069,3,4,0)="        Entries left from the DATA array that fall in the date range"
^XWB(8994,3070,0)="XUS PKI GET UPN^GETUPN^XUSER2^1^P^^^0"
^XWB(8994,3070,1,0)="^8994.01^2^2^3120925^^^^"
^XWB(8994,3070,1,1,0)="This RPC gets the SUBJECT ALTERNATIVE NAME field from the New Person (#200) file field 501.2.  It is used to check that the correct PIV card has been put into the reader."
^XWB(8994,3070,1,2,0)=""
^XWB(8994,3071,0)="XUS PKI SET UPN^SETUPN^XUSER2^1^R"
^XWB(8994,3071,1,0)="^8994.01^2^2^3120828^^^^"
^XWB(8994,3071,1,1,0)="This RPC is used to set the SUBJECT ALTERNATIVE NAME in the New Person #(200) file field 501.2. "
^XWB(8994,3071,1,2,0)=""
^XWB(8994,3071,2,0)="^8994.02A^1^1"
^XWB(8994,3071,2,1,0)="UPN^1^50^1^1"
^XWB(8994,3071,2,1,1,0)="^8994.021^2^2^3120828^^^^"
^XWB(8994,3071,2,1,1,1,0)="This is the SUBJECT ALTERNATIVE NAME from the PIV card."
^XWB(8994,3071,2,1,1,2,0)=""
^XWB(8994,3071,2,"B","UPN",1)=""
^XWB(8994,3071,2,"PARAMSEQ",1,1)=""
^XWB(8994,3072,0)="XU EPCS EDIT^ENTRY^XUEPCSED^1^R"
^XWB(8994,3072,1,0)="^8994.01^2^2^3120711^^^^"
^XWB(8994,3072,1,1,0)="This remote procedure stores information on editing changes in file 200"
^XWB(8994,3072,1,2,0)="related to the electronic prescribing of controlled substances."
^XWB(8994,3072,2,0)="^8994.02A^1^1"
^XWB(8994,3072,2,1,0)="DATA^2^^1^1"
^XWB(8994,3072,2,"B","DATA",1)=""
^XWB(8994,3072,2,"PARAMSEQ",1,1)=""
^XWB(8994,3073,0)="ORDEA DEATEXT^DEATEXT^ORDEA^3^S^^^1^^^1"
^XWB(8994,3073,1,0)="^8994.01^2^2^3180618^^^^"
^XWB(8994,3073,1,1,0)="Returns the text to show on the signature dialog mandated by DEA for when "
^XWB(8994,3073,1,2,0)="a controlled substance order is selected to be signed."
^XWB(8994,3074,0)="ORDEA SIGINFO^SIGINFO^ORDEA^3^S^^^1^^^1"
^XWB(8994,3074,1,0)="^8994.01^2^2^3180618^^"
^XWB(8994,3074,1,1,0)="returns the provider/patient info that must be displayed when signing a "
^XWB(8994,3074,1,2,0)="controlled substance order(s)"
^XWB(8994,3075,0)="ORDEA CSVALUE^CSVALUE^ORDEA^1"
^XWB(8994,3076,0)="ORDEA HASHINFO^HASHINFO^ORDEA^2"
^XWB(8994,3077,0)="ORDEA ORDHINFO^ORDHINFO^ORDEA^2"
^XWB(8994,3078,0)="ORWPCE ICDVER^ICDVER^ORWPCE^1^S"
^XWB(8994,3078,1,0)="^^2^2^3120216^"
^XWB(8994,3078,1,1,0)="Returns the ICD coding system version to be used for diagnosis look-up, as"
^XWB(8994,3078,1,2,0)="of a particular date of interest."
^XWB(8994,3078,2,0)="^8994.02A^1^1"
^XWB(8994,3078,2,1,0)="ORDT^1^^0^1"
^XWB(8994,3078,2,1,1,0)="^^2^2^3120216^"
^XWB(8994,3078,2,1,1,1,0)="This is the date of interest (e.g., encounter date - time optional) "
^XWB(8994,3078,2,1,1,2,0)="against which the implementation date for ICD-10-CM will be compared."
^XWB(8994,3078,2,"B","ORDT",1)=""
^XWB(8994,3078,2,"PARAMSEQ",1,1)=""
^XWB(8994,3078,3,0)="^^5^5^3120216^"
^XWB(8994,3078,3,1,0)="Returns a two '^'-piece string with the Coding system abbreviation and the"
^XWB(8994,3078,3,2,0)="Coding System name, as either:"
^XWB(8994,3078,3,3,0)="  "
^XWB(8994,3078,3,4,0)=" ICD^ICD-9-CM, or"
^XWB(8994,3078,3,5,0)=" 10D^ICD-10-CM"
^XWB(8994,3079,0)="ORDEA PINLKCHK^PINLKCHK^ORDEA^1"
^XWB(8994,3080,0)="ORDEA PINLKSET^PINLKSET^ORDEA^1"
^XWB(8994,3081,0)="ORQQPL4 LEX^LEX^ORQQPL4^4^S^^^1"
^XWB(8994,3081,1,0)="^^2^2^3120319^"
^XWB(8994,3081,1,1,0)="This RPC supports the Clinical Lexicon Search for Problem List. It will "
^XWB(8994,3081,1,2,0)="return an indefinite list of terms that match the user's search string."
^XWB(8994,3082,0)="ORDEA PNDHLD^PNDHLD^ORDEA^1"
^XWB(8994,3083,0)="ORDEA LNKMSG^LNKMSG^ORDEA^3^^^^1"
^XWB(8994,3083,1,0)="^^1^1^3120827^"
^XWB(8994,3083,1,1,0)="Returns the text of the OR DEA PIV LINK MSG parameter."
^XWB(8994,3084,0)="ORWPCE4 LEX^LEX^ORWPCE4^2"
^XWB(8994,3084,1,0)="^^2^2^3121105^"
^XWB(8994,3084,1,1,0)="Returns list of coded elements based on lexicon look-up. Introduced with "
^XWB(8994,3084,1,2,0)="CPRS v29 to maintain compatibility of older call ORWPCE LEX."
^XWB(8994,3085,0)="DENTVUTL PNL PANEL CHG^PNL^DENTVUTL^2^A^^^1"
^XWB(8994,3085,1,0)="^8994.01^1^1^3120725^^^"
^XWB(8994,3085,1,1,0)="Returns a list of patients with the provider matching the lookup value."
^XWB(8994,3085,2,0)="^8994.02A^1^1"
^XWB(8994,3085,2,1,0)="PROV^1^15^1^1"
^XWB(8994,3085,2,1,1,0)="^8994.021^3^3^3120725^^"
^XWB(8994,3085,2,1,1,1,0)="The lookup value entered by the user to find all patients with the "
^XWB(8994,3085,2,1,1,2,0)="entered provider in the format p1^p2.  P1 is provider ID and p2 is "
^XWB(8994,3085,2,1,1,3,0)="provider type (P or S)."
^XWB(8994,3085,2,"B","PROV",1)=""
^XWB(8994,3085,2,"PARAMSEQ",1,1)=""
^XWB(8994,3085,3,0)="^^6^6^3120725^"
^XWB(8994,3085,3,1,0)="Data will be returned to RET(n)"
^XWB(8994,3085,3,2,0)="If a successful find for the lookup value, then return the following data:"
^XWB(8994,3085,3,3,0)="   RET(n) = p1^p2"
^XWB(8994,3085,3,4,0)="      for the GUI, you will have List[n] := p1^p2"
^XWB(8994,3085,3,5,0)="      where"
^XWB(8994,3085,3,6,0)="      p1 = ien              p2 = patient name"
^XWB(8994,3086,0)="DENTV DPT GET ICN^ICN^DENTVUTL^1^A^^^1"
^XWB(8994,3086,1,0)="^^1^1^3130219^"
^XWB(8994,3086,1,1,0)="This RPC takes in a patient identifier and returns the patient's ICN."
^XWB(8994,3086,2,0)="^8994.02A^2^2"
^XWB(8994,3086,2,1,0)="PAT^1^30^1^1"
^XWB(8994,3086,2,1,1,0)="^^1^1^3130219^"
^XWB(8994,3086,2,1,1,1,0)="A patient identifier which can be their DFN, Name, or SSN."
^XWB(8994,3086,2,2,0)="ISSSN^1^1^0^2"
^XWB(8994,3086,2,2,1,0)="^^2^2^3130219^"
^XWB(8994,3086,2,2,1,1,0)="A boolean flag (0,1) which indicates whether or not the PAT value is a "
^XWB(8994,3086,2,2,1,2,0)="SSN value.  If a value is not passed, the flag defaults to 0."
^XWB(8994,3086,2,"B","ISSSN",2)=""
^XWB(8994,3086,2,"B","PAT",1)=""
^XWB(8994,3086,2,"PARAMSEQ",1,1)=""
^XWB(8994,3086,2,"PARAMSEQ",2,2)=""
^XWB(8994,3086,3,0)="^^9^9^3130219^"
^XWB(8994,3086,3,1,0)="Returns a single value."
^XWB(8994,3086,3,2,0)=" "
^XWB(8994,3086,3,3,0)="The format of the returned value will be as follows:"
^XWB(8994,3086,3,4,0)="  Result = p1^p2"
^XWB(8994,3086,3,5,0)=" "
^XWB(8994,3086,3,6,0)="    p1 = Patient ICN (local ICN will include checksum)"
^XWB(8994,3086,3,7,0)="    p2 = Location Flag (N: National; L: Local)"
^XWB(8994,3086,3,8,0)=" "
^XWB(8994,3086,3,9,0)="If an error occurs, the return will be Result = -1^message."
^XWB(8994,3087,0)="MAG3 TELEREADER CLONE READER^CLONE^MAGNTLR4^2^R"
