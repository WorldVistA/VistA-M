^XWB(8994,3487,0)="SDEC SEARCHAV^SEARCHAV^SDEC^4^R^0^^0"
^XWB(8994,3487,1,0)="^^5^5^3150128^"
^XWB(8994,3487,1,1,0)="Searches availability database for availability blocks between"
^XWB(8994,3487,1,2,0)="     SDECSTRT and SDECEND for each of the resources in SDECRES."
^XWB(8994,3487,1,3,0)="The av blocks must be one of the types in SDECTYPES, must be"
^XWB(8994,3487,1,4,0)=" AM or PM depending on value in SDECAMPM and"
^XWB(8994,3487,1,5,0)=" must be on one of the weekdays listed in SDECWKDY."
^XWB(8994,3487,2,0)="^8994.02A^6^6"
