^XWB(8994,3118,3,0)="^^2^2^3100805^"
^XWB(8994,3118,3,1,0)="This is the accession number of the radiology procedure or "
^XWB(8994,3118,3,2,0)="consult/request reference, if available.  Defined for VA procedures only."
^XWB(8994,3119,0)="MAGV GET DGW CONFIG^GETGWCFG^MAGVDGWP^1^R"
^XWB(8994,3119,1,0)="^8994.01^2^2^3100816^^^"
^XWB(8994,3119,1,1,0)="Get DICOM Gateway configuration settings from the MAGV GATEWAY"
^XWB(8994,3119,1,2,0)="CONFIGURATION File (#2006.9191)."
^XWB(8994,3119,2,0)="^8994.02A^1^1"
^XWB(8994,3119,2,1,0)="HOSTNAME^1^30^^1"
^XWB(8994,3119,2,1,1,0)="^8994.021^1^1^3100816^^^^"
^XWB(8994,3119,2,1,1,1,0)="NAME OF DICOM GATEWAY COMPUTER"
^XWB(8994,3119,2,"B","HOSTNAME",1)=""
^XWB(8994,3119,2,"PARAMSEQ",1,1)=""
^XWB(8994,3119,3,0)="^8994.03^12^12^3100816^^"
^XWB(8994,3119,3,1,0)="DICOM Gateway Configuration settings returned as a ~ delimited string."
^XWB(8994,3119,3,2,0)="The return string contains the following parameters:"
^XWB(8994,3119,3,3,0)="0~HOSTNAME~EMAIL ADDRESS~POSTOFFICE~PORT~IMPORTER~STATION NUMBER"
^XWB(8994,3119,3,4,0)=" 0 represents a successful operation"
^XWB(8994,3119,3,5,0)="HOSTNAME is the name of the DICOM Gateway Computer"
^XWB(8994,3119,3,6,0)="EMAIL ADDRESS is the email address for support personnel."
^XWB(8994,3119,3,7,0)="POSTOFFICE is the post office address name.]"
^XWB(8994,3119,3,8,0)="PORT is the post office port number"
^XWB(8994,3119,3,9,0)="IMPORTER indicates whether or not the Importer is in use (Yes or No)"
^XWB(8994,3119,3,10,0)="STATION NUMBER is the site location code."
^XWB(8994,3119,3,11,0)=" "
^XWB(8994,3119,3,12,0)="-1 is an error condition message."
^XWB(8994,3120,0)="MAGV GET DICOM FAILED IMAGE^DCRCTGET^MAGVRS51^2^R"
^XWB(8994,3120,1,0)="^8994.01^1^1^3100826^^^"
^XWB(8994,3120,1,1,0)="Returns image attributes given the IEN of the DICOM FAILED IMAGES File (#2006.575)."
^XWB(8994,3120,2,0)="^8994.02A^1^1"
^XWB(8994,3120,2,1,0)="ATTS^2"
^XWB(8994,3120,2,1,1,0)="^8994.021^1^1^3100826^^"
^XWB(8994,3120,2,1,1,1,0)="This attribute identifies the Machine ID to use to look up entries."
^XWB(8994,3120,2,"B","ATTS",1)=""
^XWB(8994,3120,3,0)="^8994.03^2^2^3100826^^"
^XWB(8994,3120,3,1,0)="This RPC returns an array of name-value pairs of failed image"
^XWB(8994,3120,3,2,0)="attributes."
