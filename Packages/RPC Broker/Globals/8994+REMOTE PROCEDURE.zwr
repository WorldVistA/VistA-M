^XWB(8994,4335,3,1,0)="Output:"
^XWB(8994,4335,3,2,0)="   Error Messages:  DSSORET(0)=""-1^""_error message or ""0^""_error message"
^XWB(8994,4335,3,3,0)="     Error messages sent:"
