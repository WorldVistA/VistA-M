^XWB(8994,3923,3,0)="^^9^9^3130109^"
^XWB(8994,3923,3,1,0)="Returns one of the following possible returns:"
^XWB(8994,3923,3,2,0)=" "
^XWB(8994,3923,3,3,0)="RET="""" if no mandatory source is applicable"
^XWB(8994,3923,3,4,0)="RET=""<<NOT DEFINED>>"" if a mandtory source is not defined in the ITEM "
^XWB(8994,3923,3,5,0)="MASTER (#441) FILE"
^XWB(8994,3923,3,6,0)="RET=""<<NOT FOUND>>""^IEN if a mandatory source is defined in the ITEM "
^XWB(8994,3923,3,7,0)="MASTER (#441) FILE, but could not be found in the VENDOR (#440) FILE"
^XWB(8994,3923,3,8,0)="RET=VENDOR NAME^IEN if a mandatory source is defined, applicable, and "
^XWB(8994,3923,3,9,0)="found in the VENDOR (#440) FILE"
