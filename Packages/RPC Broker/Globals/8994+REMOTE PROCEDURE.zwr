^XWB(8994,2493,0)="YTQ KILL SCRATCH^KILLSCR^YTQPXRM8^2^S"
^XWB(8994,2493,1,0)="^8994.01^1^1^3081029^^^"
^XWB(8994,2493,1,1,0)="Delete entires from the scratch file when a clinical reminder is saved."
^XWB(8994,2493,2,0)="^8994.02A^3^3"
^XWB(8994,2493,2,1,0)="DFN^1^^1"
^XWB(8994,2493,2,1,1,0)="^^1^1^3080523^"
^XWB(8994,2493,2,1,1,1,0)="Patient DFN"
^XWB(8994,2493,2,2,0)="CODE^1^^1"
^XWB(8994,2493,2,2,1,0)="^^1^1^3080523^"
