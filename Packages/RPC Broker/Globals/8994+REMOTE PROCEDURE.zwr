^XWB(8994,3948,0)="DSIYTI03 TIUPDT UPDATE TIR^TIUPDT^DSIYTI03^2"
^XWB(8994,3948,1,0)="^8994.01^7^7^3140508^^^"
^XWB(8994,3948,1,1,0)="TIIUPDT"
^XWB(8994,3948,1,2,0)=" "
^XWB(8994,3948,1,3,0)="RPC to update the Turn-In Request file data"
^XWB(8994,3948,1,4,0)=" - also updates:"
^XWB(8994,3948,1,5,0)=" - ^ENG(6914) Equipment Management"
^XWB(8994,3948,1,6,0)=" - ^DSIY(19685.2) = DSIY Xref file for contact email"
^XWB(8994,3948,1,7,0)=" - ^DSIY(19685.31) = DSIY Additional Equipment information file"
^XWB(8994,3948,2,0)="^8994.02A^3^3"
^XWB(8994,3948,2,1,0)="COMPLETE^1^1^1^1"
^XWB(8994,3948,2,1,1,0)="^^11^11^3130201^"
^XWB(8994,3948,2,1,1,1,0)="COMPLETE"
^XWB(8994,3948,2,1,1,2,0)=" "
^XWB(8994,3948,2,1,1,3,0)="Y/N Answer indicating whether the TIR is complete and ready for filing.  "
^XWB(8994,3948,2,1,1,4,0)="Depending on the level of the TIR, this is triggered by different events "
^XWB(8994,3948,2,1,1,5,0)="that the GUI has to track."
^XWB(8994,3948,2,1,1,6,0)=" "
^XWB(8994,3948,2,1,1,7,0)=" For ""Original Turn-In Request Box"" this is ""Ready for CMR""  prompt"
^XWB(8994,3948,2,1,1,8,0)=" For ""CMR Approval Box"" this is if there is an ESIG for CMR"
^XWB(8994,3948,2,1,1,9,0)=" For ""PPM Approval Box"" this is ""Ready for Warehouse Pickup"" prompt"
^XWB(8994,3948,2,1,1,10,0)=" For ""Warehouse Box"" d this is if there is an ESIG for Warehouse"
^XWB(8994,3948,2,1,1,11,0)=" For ""PPM Final Disposition Box"" this is if there is an ESIG for final"
^XWB(8994,3948,2,2,0)="LEVEL^1^2^1^2"
^XWB(8994,3948,2,2,1,0)="^8994.021^5^5^3140508^^"
^XWB(8994,3948,2,2,1,1,0)="LEVEL"
^XWB(8994,3948,2,2,1,2,0)=" "
^XWB(8994,3948,2,2,1,3,0)="This value comes from TIEDIT RPC - it indicates the current level of the "
^XWB(8994,3948,2,2,1,4,0)="Turn-In Request and will be used to build which fields will be allowed to "
^XWB(8994,3948,2,2,1,5,0)="be updated."
^XWB(8994,3948,2,3,0)="DSIYDAT^2^60^1^3"
^XWB(8994,3948,2,3,1,0)="^8994.021^5^5^3140508^^^"
^XWB(8994,3948,2,3,1,1,0)="DSIYDAT"
^XWB(8994,3948,2,3,1,2,0)=" "
^XWB(8994,3948,2,3,1,3,0)="Values for each field to be updated"
^XWB(8994,3948,2,3,1,4,0)=" "
^XWB(8994,3948,2,3,1,5,0)="DSIYDAT(FILE:FIELD)=INTERNAL^EXTERNAL"
