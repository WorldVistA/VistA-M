^XWB(8994,3926,0)="DSIYTI02 TISCH TURN IN SEARCH^TISCH^DSIYTI02^4^^^^1"
^XWB(8994,3926,1,0)="^8994.01^14^14^3150521^^^^"
^XWB(8994,3926,1,1,0)="TISCH"
^XWB(8994,3926,1,2,0)=" "
^XWB(8994,3926,1,3,0)="Searches for Turn-In Requests from the ^PRCN(413.1) file.  This search "
^XWB(8994,3926,1,4,0)="looks for Turn-Ins based on their status in the ""AC"" XREF index"
^XWB(8994,3926,1,5,0)=" "
^XWB(8994,3926,1,6,0)="DSIYRET(#)=the following pieces"
^XWB(8994,3926,1,7,0)="  p1:  Turn-In IEN"
^XWB(8994,3926,1,8,0)="  p2:  Turn-In temporary #"
^XWB(8994,3926,1,9,0)="  p3:  Turn-In Status"
