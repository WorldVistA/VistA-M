^XWB(8994,1442,3,0)="^^1^1^3021114^"
^XWB(8994,1442,3,1,0)="Returns a list where LST(n)=IEN^StatusName"
^XWB(8994,1443,0)="ORRHCU BYREG^BYREG^ORRHCU^2^R"
^XWB(8994,1443,1,0)="^^1^1^3021114^"
