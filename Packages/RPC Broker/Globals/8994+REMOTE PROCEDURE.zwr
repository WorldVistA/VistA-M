^XWB(8994,4987,2,1,1,5,0)="   SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,4987,2,1,1,6,0)="                             calling application."
^XWB(8994,4987,2,1,1,7,0)="   SDCONTEXT(""PATIENT DFN"")= The name of the patient taking action on the"
^XWB(8994,4987,2,1,1,8,0)="                             calling application."
^XWB(8994,4987,2,2,0)="request"
^XWB(8994,4987,2,3,0)="REQUEST^2^32000^1^2"
^XWB(8994,4987,2,3,1,0)="^8994.021^67^67^3250213^^"
^XWB(8994,4987,2,3,1,1,0)=";  REQUEST(""APPOINTMENT END TIME"")          = (Required) APPT END TIME - "
^XWB(8994,4987,2,3,1,2,0)="ISO FORMAT"
^XWB(8994,4987,2,3,1,3,0)=" ;  REQUEST(""APPOINTMENT LENGTH"")            = (Required) APPT LENGTH IN "
^XWB(8994,4987,2,3,1,4,0)="MINUTES (5-120)"
^XWB(8994,4987,2,3,1,5,0)=" ;  REQUEST(""APPOINTMENT START TIME"")        = (Required) APPT START TIME "
^XWB(8994,4987,2,3,1,6,0)="- ISO FORMAT"
^XWB(8994,4987,2,3,1,7,0)=" ;  REQUEST(""CLINIC IEN"")                    = (Required) CLINIC IEN"
^XWB(8994,4987,2,3,1,8,0)=" ;  REQUEST(""CREATE DATE"")                   = (Required) DATE/TIME "
^XWB(8994,4987,2,3,1,9,0)="ENTERED (#409.85,9.5) in ISO8601 date/time format to include offset (e.g. "
^XWB(8994,4987,2,3,1,10,0)="CCYY-MM-DDTHH:MM-NNNN)"
^XWB(8994,4987,2,3,1,11,0)=" ;  REQUEST(""PATIENT INDICATED DATE"")        = (Required) CID/PID DATE - "
^XWB(8994,4987,2,3,1,12,0)="ISO FORMAT"
^XWB(8994,4987,2,3,1,13,0)=" ;  REQUEST(""DFN"")                           = (Required) PATIENT IEN"
^XWB(8994,4987,2,3,1,14,0)=" ;  REQUEST(""APPOINTMENT REASON"")            = (Optional) FREE TEXT "
^XWB(8994,4987,2,3,1,15,0)="(1-150)"
^XWB(8994,4987,2,3,1,16,0)=" ;  REQUEST(""COLLATERAL VISIT"")              = (Optional) COLLATERAL - 1 "
^XWB(8994,4987,2,3,1,17,0)="FOR YES"
^XWB(8994,4987,2,3,1,18,0)=" ;  REQUEST(""APPOINTMENT TYPE IEN"")          = (Optional) POINTER TO "
^XWB(8994,4987,2,3,1,19,0)="APPOINTMENT TYPE FILE (#409.1)"
^XWB(8994,4987,2,3,1,20,0)=" ;   Either APPOINTMENT TYPE IEN or APPOINTMENT TYPE NAME is Required"
^XWB(8994,4987,2,3,1,21,0)=" ;  REQUEST(""APPOINTMENT TYPE NAME"")         = (Optional) NAME from "
^XWB(8994,4987,2,3,1,22,0)="APPOINTMENT TYPE FILE (#409.1)"
^XWB(8994,4987,2,3,1,23,0)=" ;  REQUEST(""FOLLOWUP"")                      = (Optional) FOLLOWUP VISIT "
^XWB(8994,4987,2,3,1,24,0)="- 1 FOR YES 0 FOR NO"
^XWB(8994,4987,2,3,1,25,0)=" ;  REQUEST(""INSTITUTION NAME"")              = (Optional) Institution "
^XWB(8994,4987,2,3,1,26,0)="name from the INSTITUTION file"
^XWB(8994,4987,2,3,1,27,0)=" ;  REQUEST(""MODALITY"")                      = (Optional) Valid Values: "
^XWB(8994,4987,2,3,1,28,0)="FACE2FACE, TELEPHONE, VIDEO"
^XWB(8994,4987,2,3,1,29,0)=" ;  REQUEST(""NOTE"")                          = (Optional) NOTE - FREE "
^XWB(8994,4987,2,3,1,30,0)="TEXT 1-150"
^XWB(8994,4987,2,3,1,31,0)=" ;  REQUEST(""OVERBOOK"")                      = (Optional) OVERBOOK (0 for "
^XWB(8994,4987,2,3,1,32,0)="no, 1 for yes)"
^XWB(8994,4987,2,3,1,33,0)=" ;  REQUEST(""PATIENT COMMENT"")               = (Optional) Patient-entered "
^XWB(8994,4987,2,3,1,34,0)="comments when using VAOS or other web-service (stored at 409.85,60 a word "
^XWB(8994,4987,2,3,1,35,0)="processing field)"
^XWB(8994,4987,2,3,1,36,0)=" ;  REQUEST(""PATIENT ELIGIBILITY IEN"")       = (Optional) ELIGIBILITY IEN"
^XWB(8994,4987,2,3,1,37,0)=" ;  REQUEST(""PATIENT PREFERRED END DATE"",1)  = (Optional) PATIENT "
^XWB(8994,4987,2,3,1,38,0)="PREFERRED END DATE 1 - ISO FORMAT"
^XWB(8994,4987,2,3,1,39,0)=" ;  REQUEST(""PATIENT PREFERRED END DATE"",2)  = (Optional) PATIENT "
^XWB(8994,4987,2,3,1,40,0)="PREFERRED END DATE 2 - ISO FORMAT"
^XWB(8994,4987,2,3,1,41,0)=" ;  REQUEST(""PATIENT PREFERRED END DATE"",3)  = (Optional) PATIENT "
^XWB(8994,4987,2,3,1,42,0)="PREFERRED END DATE 3 - ISO FORMAT"
^XWB(8994,4987,2,3,1,43,0)=" ;  REQUEST(""PATIENT PREFERRED START DATE"",1)= (Optional) PATIENT "
^XWB(8994,4987,2,3,1,44,0)="PREFERRED START DATE 1 - ISO FORMAT"
^XWB(8994,4987,2,3,1,45,0)=" ;  REQUEST(""PATIENT PREFERRED START DATE"",2)= (Optional) PATIENT "
^XWB(8994,4987,2,3,1,46,0)="PREFERRED START DATE 2 - ISO FORMAT"
^XWB(8994,4987,2,3,1,47,0)=" ;  REQUEST(""PATIENT PREFERRED START DATE"",3)= (Optional) PATIENT "
^XWB(8994,4987,2,3,1,48,0)="PREFERRED START DATE 3 - ISO FORMAT"
^XWB(8994,4987,2,3,1,49,0)=" ;  REQUEST(""PATIENT STATUS"")                = (Optional) PATIENT STATUS "
^XWB(8994,4987,2,3,1,50,0)="- ""NEW"" OR ""ESTABLISHED"
^XWB(8994,4987,2,3,1,51,0)=" ;  REQUEST(""PRIORITY"")                      = (Optional) PRIORITY - "
^XWB(8994,4987,2,3,1,52,0)="""ASAP"" or FUTURE"
^XWB(8994,4987,2,3,1,53,0)=" ;  REQUEST(""PRIORITY GROUP"")                = (Optional) ENROLLMENT "
^XWB(8994,4987,2,3,1,54,0)="PRIORITY - GROUP 1 - GROUP 7"
^XWB(8994,4987,2,3,1,55,0)=" ;  REQUEST(""REQUEST COMMENT"")               = (Optional) REQUEST COMMENT"
^XWB(8994,4987,2,3,1,56,0)=" ;  REQUEST(""SECONDARY STOP CODE"")           = (Optional) Secondary Stop "
^XWB(8994,4987,2,3,1,57,0)="Code Number pointer to CLINIC STOP file #40.7 used to populate the REQ "
^XWB(8994,4987,2,3,1,58,0)="SECONDARY STOP CODE field in 409.85"
^XWB(8994,4987,2,3,1,59,0)=" ;  REQUEST(""SERVICE CONNECTED"")             = (Optional) Valid Values: "
^XWB(8994,4987,2,3,1,60,0)="YES, NO"
^XWB(8994,4987,2,3,1,61,0)=" ;  REQUEST(""SERVICE CONNECTED PERCENTAGE"")  = (Optional) SC % = 0-100"
^XWB(8994,4987,2,3,1,62,0)=" ;  REQUEST(""STATION NUMBER"")                = (Optional) STATION NUMBER "
^XWB(8994,4987,2,3,1,63,0)="(#99),INSTITUTION (#4)"
^XWB(8994,4987,2,3,1,64,0)=" ;  REQUEST(""STOP CODE"")                     = (Optional) CLINIC STOP "
^XWB(8994,4987,2,3,1,65,0)="pointer to CLINIC STOP file 40.7 used to populate the REQ "
^XWB(8994,4987,2,3,1,66,0)="SERVICE/SPECIALTY field in 409.85"
^XWB(8994,4987,2,3,1,67,0)=" ;  REQUEST(""VAOS GUID"")                     = (Optional) VAOS GUID"
