^XWB(8994,3891,0)="DSIYWO4A WOVAL VALIDATE^WOVAL^DSIYWO4A^2^P^0^^1"
^XWB(8994,3891,1,0)="^8994.01^4^4^3130401^^^^"
^XWB(8994,3891,1,1,0)="WOVAL"
^XWB(8994,3891,1,2,0)=" "
^XWB(8994,3891,1,3,0)="Validates the data in the Work Order file based on data sent from the"
^XWB(8994,3891,1,4,0)="GUI screen."
^XWB(8994,3891,2,0)="^8994.02A^6^5"
^XWB(8994,3891,2,1,0)="DSIYDAT^2^60^1^5"
^XWB(8994,3891,2,1,1,0)="^8994.021^8^8^3121207^^^^"
^XWB(8994,3891,2,1,1,1,0)="DSIYDAT"
^XWB(8994,3891,2,1,1,2,0)=" "
^XWB(8994,3891,2,1,1,3,0)="Send in fields for Work Order information.  "
^XWB(8994,3891,2,1,1,4,0)=" "
^XWB(8994,3891,2,1,1,5,0)="Field .01 should be the IEN of the Work Order - if this is a NEW Work "
^XWB(8994,3891,2,1,1,6,0)="Order, leave this field blank."
^XWB(8994,3891,2,1,1,7,0)=" "
^XWB(8994,3891,2,1,1,8,0)="All Fields should be in the format Internal Value ^ External Value"
^XWB(8994,3891,2,2,0)="DSIYTECH^1^245^0^3"
^XWB(8994,3891,2,2,1,0)="^8994.021^6^6^3121207^^^"
^XWB(8994,3891,2,2,1,1,0)="DSIYTECH"
^XWB(8994,3891,2,2,1,2,0)=" "
^XWB(8994,3891,2,2,1,3,0)="Data for Technician Multiple"
^XWB(8994,3891,2,2,1,4,0)=" "
^XWB(8994,3891,2,2,1,5,0)="DSIYTECH=  TECH IEN1 ^ TECH HOURS1 ^ TECH SHOP IEN1 ;"
^XWB(8994,3891,2,2,1,6,0)="           TECH IEN2 ^ TECH HOURS2 ^ TECH SHOP IEN2 ; ...ETC."
^XWB(8994,3891,2,3,0)="DSIYWKAC^1^245^0^4"
^XWB(8994,3891,2,3,1,0)="^8994.021^5^5^3121207^^"
^XWB(8994,3891,2,3,1,1,0)="DSIYWKAC"
^XWB(8994,3891,2,3,1,2,0)=" "
^XWB(8994,3891,2,3,1,3,0)="Data for the Work Action Multiple"
^XWB(8994,3891,2,3,1,4,0)=" "
^XWB(8994,3891,2,3,1,5,0)="DSIYWKAC = WORK ACTION IEN1;WORK ACTION IEN2;...ETC."
^XWB(8994,3891,2,4,0)="DSIYCON^1^10^0^2"
^XWB(8994,3891,2,4,1,0)="^8994.021^6^6^3121207^^^^"
^XWB(8994,3891,2,4,1,1,0)="DSIYCON"
^XWB(8994,3891,2,4,1,2,0)=" "
^XWB(8994,3891,2,4,1,3,0)="Value for the Condition Code - this updates data in the Equipment "
^XWB(8994,3891,2,4,1,4,0)="Inventory file ^ENG(6914) rather than the Work Order File"
^XWB(8994,3891,2,4,1,5,0)=" "
^XWB(8994,3891,2,4,1,6,0)="DSIYCON = Internal ^ External"
^XWB(8994,3891,2,5,0)="DSIYCOM^2^60^0^6"
^XWB(8994,3891,2,5,1,0)="^8994.021^5^5^3120921^^^^"
^XWB(8994,3891,2,5,1,1,0)="DSIYCOM"
^XWB(8994,3891,2,5,1,2,0)=" "
^XWB(8994,3891,2,5,1,3,0)="Comment lines for the Work Order File"
^XWB(8994,3891,2,5,1,4,0)=" "
^XWB(8994,3891,2,5,1,5,0)="DSIYCOM(#)=Comment Line"
^XWB(8994,3891,2,6,0)="USER^1^1^0^1"
^XWB(8994,3891,2,6,1,0)="^^3^3^3130401^"
^XWB(8994,3891,2,6,1,1,0)="USER"
^XWB(8994,3891,2,6,1,2,0)=" "
^XWB(8994,3891,2,6,1,3,0)="Not used at this time, may be repurposed later "
^XWB(8994,3891,2,6,1,4,0)="This can be:"
^XWB(8994,3891,2,6,1,5,0)="  ""W""  for WARD User"
^XWB(8994,3891,2,6,1,6,0)="  ""E""  for Engineer"
^XWB(8994,3891,2,6,1,7,0)="  ""Q""  for Equipment Inventory"
