^XWB(8994,2914,2,4,1,0)="^8994.021^2^2^3061030^^"
^XWB(8994,2914,2,4,1,1,0)="If MDCPDFN is set, this tells the linetag that MDCPDFN is a correction, "
^XWB(8994,2914,2,4,1,2,0)="not the original DFN."
^XWB(8994,2914,2,"B","MDCPDFN",3)=""
^XWB(8994,2914,2,"B","MDCPISCR",4)=""
