^XWB(8994,4172,0)="ORTO GETRVW^GETRVW^ORTOULT4^1"
^XWB(8994,4172,1,0)="^^5^5^3161117^"
^XWB(8994,4172,1,1,0)="Unified Action Profile (UAP). This RPC gets the value of the field 'UAP"
^XWB(8994,4172,1,2,0)="Reviewed?' field #100,.61,  Filed as the first piece of 100,.61;1.  This "
^XWB(8994,4172,1,3,0)="is the status of the review. It returns the string from a set of codes "
^XWB(8994,4172,1,4,0)="to CPRS. This includes cont for contiued, chg for changed, dc for"
^XWB(8994,4172,1,5,0)="discontinued, rnw for renewed, and nw for a new order."
^XWB(8994,4172,2,0)="^8994.02A^1^1"
^XWB(8994,4172,2,1,0)="ORDER IEN^1^20^1^1"
^XWB(8994,4172,2,1,1,0)="^8994.021^1^1^3161117^^^^"
^XWB(8994,4172,2,1,1,1,0)="IEN of the order in file 100"
^XWB(8994,4172,2,"B","ORDER IEN",1)=""
^XWB(8994,4172,2,"PARAMSEQ",1,1)=""
^XWB(8994,4173,0)="ORTO SETRVW^SETRVW^ORTOULT4^1"
^XWB(8994,4173,1,0)="^8994.01^5^5^3161108^^"
^XWB(8994,4173,1,1,0)="This RPC sets the value of three fields: first the 'UAP Reviewed?' field"
^XWB(8994,4173,1,2,0)="#100,.61;1, with the passed value (0=NO, 1=YES). Second the 'UAP Date"
^XWB(8994,4173,1,3,0)="Last"
^XWB(8994,4173,1,4,0)="Reviewed' field # 100,.61;2 with the ,current date and time; and third the"
^XWB(8994,4173,1,5,0)="'UAP Last Reviewed By' field #100.61;3 with the DUZ of the reviewer. "
^XWB(8994,4173,2,0)="^8994.02A^2^2"
^XWB(8994,4173,2,1,0)="REVIEW STATUS^1^5^1^1"
^XWB(8994,4173,2,1,1,0)="^^1^1^3161028^"
^XWB(8994,4173,2,1,1,1,0)="Status of the order UAP Reviewed? (0 or 1)"
^XWB(8994,4173,2,2,0)="ORDER IEN^1^20^1^2"
^XWB(8994,4173,2,2,1,0)="^8994.021^1^1^3161108^^^^"
^XWB(8994,4173,2,2,1,1,0)="IEN of the order in file 100."
^XWB(8994,4173,2,"B","ORDER IEN",2)=""
^XWB(8994,4173,2,"B","REVIEW STATUS",1)=""
^XWB(8994,4173,2,"PARAMSEQ",1,1)=""
^XWB(8994,4173,2,"PARAMSEQ",2,2)=""
^XWB(8994,4174,0)="ORTO SET UAP FLAG^SETUAPF^ORTOULT4^1"
^XWB(8994,4174,1,0)="^^5^5^3161108^"
^XWB(8994,4174,1,1,0)="Unified Action Profile (UAP). Pass in 1 to flag that user has entered UAP"
^XWB(8994,4174,1,2,0)="view.  Pass in 0 to flag they have changed to any other view in the"
^XWB(8994,4174,1,3,0)="TfrmOrders.SetOrderView procedure. While in UAP view, new orders will have"
^XWB(8994,4174,1,4,0)="the UAP Reviewed? field (#100,.61) of the order file set to 'N'. Global "
^XWB(8994,4174,1,5,0)="Loaction .61;1 SET of codes."
^XWB(8994,4174,1,6,0)="codes."
^XWB(8994,4174,2,0)="^8994.02A^1^1"
^XWB(8994,4174,2,1,0)="FLAG^1^1^1^1"
^XWB(8994,4174,2,1,1,0)="^8994.021^1^1^3161108^^^"
^XWB(8994,4174,2,1,1,1,0)="Dummy value"
^XWB(8994,4174,2,"B","FLAG",1)=""
^XWB(8994,4174,2,"PARAMSEQ",1,1)=""
^XWB(8994,4175,0)="ORTO UAPOFF^UAPOFF^ORTOULT4^1"
^XWB(8994,4175,1,0)="^^2^2^3170129^"
^XWB(8994,4175,1,1,0)="This is used to turn on or off the Unified Action Profile function in "
^XWB(8994,4175,1,2,0)="CPRS."
^XWB(8994,4175,3,0)="^^2^2^3170129^"
^XWB(8994,4175,3,1,0)="This returns a 1 if the site selected on or 0 if the site selected to "
^XWB(8994,4175,3,2,0)=" turn it off."
^XWB(8994,4176,0)="ORTO DGROUP^DGROUP^ORTOULT4^1^P^0"
