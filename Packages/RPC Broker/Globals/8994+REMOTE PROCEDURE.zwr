^XWB(8994,3409,3,0)="^^12^12^3150108^"
^XWB(8994,3409,3,1,0)="FTEE history record values:"
^XWB(8994,3409,3,2,0)="an array of: ien^history date^ftee value^user ien(duz)"
^XWB(8994,3409,3,3,0)="Example:"
