^XWB(8994,4410,0)="ORWTIU SVCOPY^SVCOPY^ORWTIU^1"
^XWB(8994,4410,1,0)="^8994.01^1^1^3160317^^^^"
^XWB(8994,4410,1,1,0)="Saves copied text to the copy/paste copy buffer."
