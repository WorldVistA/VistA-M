^XWB(8994,3847,3,14,0)="   TOTAL PROGRESS^"
^XWB(8994,3847,3,15,0)="   PERCENT DONE"
^XWB(8994,3847,3,16,0)="    NOTE ALL TIMES ARE IN DATE TIME FORMAT"
^XWB(8994,3847,3,17,0)="  OR"
^XWB(8994,3847,3,18,0)=" -1^error message"
^XWB(8994,3848,0)="DSIYRPTR STOP CANCEL REPORT^STOP^DSIYRPTR^4^^^^1"
^XWB(8994,3848,1,0)="^8994.01^4^4^3150616^^^"
^XWB(8994,3848,1,1,0)="Requests a specified task to stop running. No guarantee that this will "
^XWB(8994,3848,1,2,0)="always work, however, if a report is asked to stop while running and the "
^XWB(8994,3848,1,3,0)="report sees the request, the report will clean up the ^XTMP data, stop "
^XWB(8994,3848,1,4,0)="running and update the DSIYR SCHEDULED REPORTS file."
^XWB(8994,3848,2,0)="^8994.02A^1^1"
