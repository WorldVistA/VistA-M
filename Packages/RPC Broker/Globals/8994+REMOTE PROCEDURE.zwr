^XWB(8994,4162,2,4,1,0)="^8994.021^1^1^3170629^^^^"
^XWB(8994,4162,2,4,1,1,0)="Earliest time to schedule report (defaults to ""NOW"")."
^XWB(8994,4162,2,5,0)="ACTION^1^40^0^4"
^XWB(8994,4162,2,5,1,0)="^^1^1^3170629^"
