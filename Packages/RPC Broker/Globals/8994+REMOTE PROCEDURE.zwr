^XWB(8994,925,3,4,0)="  2. DX IEN"
^XWB(8994,925,3,5,0)="  3. DX code and description"
^XWB(8994,926,0)="EC GETDSSUNIT^DSSUNT^ECUMRPC1^4^A^^^1"
