^XWB(8994,4411,0)="ORWTIU GETPASTE^GETPASTE^ORWTIU^2"
^XWB(8994,4411,1,0)="^8994.01^2^2^3140401^^^"
^XWB(8994,4411,1,1,0)="Given a specific document ien, returns an array containing all previously"
^XWB(8994,4411,1,2,0)="pasted text stored in the copy/paste tracker file for said document."
