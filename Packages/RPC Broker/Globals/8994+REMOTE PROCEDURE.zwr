^XWB(8994,2940,2,"B","IEN",2)=""
^XWB(8994,2940,2,"B","NODE",3)=""
^XWB(8994,2940,2,"PARAMSEQ",1,1)=""
^XWB(8994,2940,2,"PARAMSEQ",2,2)=""
^XWB(8994,2940,2,"PARAMSEQ",3,3)=""
^XWB(8994,2940,3,0)="^^1^1^3090929^"
^XWB(8994,2940,3,1,0)="Returns the text of the word processing field."
^XWB(8994,2941,0)="NUPA WP SET^WPSET^NUPABCL^1^^^^1"
^XWB(8994,2941,1,0)="^8994.01^1^1^3090708^^"
^XWB(8994,2941,1,1,0)="Sets data into a word processing field."
^XWB(8994,2941,2,0)="^8994.02A^4^3"
^XWB(8994,2941,2,2,0)="FILE^1^^1^1"
^XWB(8994,2941,2,2,1,0)="^^1^1^3090902^"
^XWB(8994,2941,2,2,1,1,0)="File to insert the data into, in ^FILE(subscript, format."
^XWB(8994,2941,2,3,0)="LINE^1^^1^2"
^XWB(8994,2941,2,3,1,0)="^^1^1^3090902^"
^XWB(8994,2941,2,3,1,1,0)="Line number for the data to be put into, such as 1, 2, or 3."
