^XWB(8994,1438,2,"PARAMSEQ",3,3)=""
^XWB(8994,1438,3,0)="^^2^2^3021114^"
^XWB(8994,1438,3,1,0)="List in the format:  LST(n)=IEN^DisplayName"
^XWB(8994,1438,3,2,0)="                or:  LST(n)=IEN^Mnemonic  <DisplayName>"
