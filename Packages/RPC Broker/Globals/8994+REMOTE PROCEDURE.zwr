^XWB(8994,3371,0)="VPS GET SURVEY DATA^GETRPC^VPSSRVY2^4^^^^1"
^XWB(8994,3371,1,0)="^8994.01^1^1^3151013^^^^"
^XWB(8994,3371,1,1,0)="Retrieves an array containing the patient's Clinical Survey information."
^XWB(8994,3371,2,0)="^8994.02A^8^8"
^XWB(8994,3371,2,1,0)="VPSPID^1^25^1^1"
^XWB(8994,3371,2,1,1,0)="^8994.021^3^3^3141113^^"
^XWB(8994,3371,2,1,1,1,0)="Patient ID such as the patient SSN OR DFN OR ICN OR VIC/CAC"
^XWB(8994,3371,2,1,1,2,0)="for whom the Clinical Questionnaire information is being"
^XWB(8994,3371,2,1,1,3,0)="requested."
^XWB(8994,3371,2,2,0)="VPSQIEN^1^9^^3"
^XWB(8994,3371,2,2,1,0)="^8994.021^1^1^3141113^^"
^XWB(8994,3371,2,2,1,1,0)="Questionnaire IEN for filtering the results."
^XWB(8994,3371,2,3,0)="VPSQNM^1^60^^4"
^XWB(8994,3371,2,3,1,0)="^8994.021^1^1^3141113^^"
^XWB(8994,3371,2,3,1,1,0)="Questionnaire Name for filtering the results."
^XWB(8994,3371,2,4,0)="VPSFDT^1^14^^5"
^XWB(8994,3371,2,4,1,0)="^8994.021^1^1^3141113^^"
^XWB(8994,3371,2,4,1,1,0)="Date From for filtering the results"
^XWB(8994,3371,2,5,0)="VPSTDT^1^14^^6"
^XWB(8994,3371,2,5,1,0)="^8994.021^1^1^3141113^^"
^XWB(8994,3371,2,5,1,1,0)="Date To for filtering the results"
^XWB(8994,3371,2,6,0)="VPSNUM^1^4^^7"
^XWB(8994,3371,2,6,1,0)="^8994.021^1^1^3141113^^^"
^XWB(8994,3371,2,6,1,1,0)="Maxumum number of occurrences to return."
^XWB(8994,3371,2,7,0)="VPSTYP^1^7^1^2"
^XWB(8994,3371,2,7,1,0)="^8994.021^1^1^3151009^^"
^XWB(8994,3371,2,7,1,1,0)="Patient ID TYPE such as SSN or DFN OR ICN OR VIC/CAC."
^XWB(8994,3371,2,8,0)="AHFLG^1^1^0^8"
^XWB(8994,3371,2,8,1,0)="^8994.021^4^4^3151013^^^"
^XWB(8994,3371,2,8,1,1,0)="Answer History Flag"
^XWB(8994,3371,2,8,1,2,0)=" "
^XWB(8994,3371,2,8,1,3,0)="0 - current answer (default)"
^XWB(8994,3371,2,8,1,4,0)="1 - all answers to the question"
^XWB(8994,3371,2,"B","AHFLG",8)=""
