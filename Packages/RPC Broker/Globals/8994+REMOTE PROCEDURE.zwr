^XWB(8994,4725,0)="PSORPC^RPC^PSORPC01^4^P^0"
^XWB(8994,4725,2,0)="^8994.02A^1^1"
^XWB(8994,4725,2,1,0)="OPTION^1^8^1^1"
^XWB(8994,4725,2,"B","OPTION",1)=""
^XWB(8994,4725,2,"PARAMSEQ",1,1)=""
^XWB(8994,4726,0)="PX ICE WEB^RPC^PXVWICE^4^S^^^1"
^XWB(8994,4726,1,0)="^8994.01^8^8^3161013^^^^"
^XWB(8994,4726,1,1,0)="Call the ICE web service to get the list of recommended immunizations for "
^XWB(8994,4726,1,2,0)="a given patient."
^XWB(8994,4726,1,3,0)="The RPC takes one parameter, the Patient IEN (DFN)."
^XWB(8994,4726,1,4,0)="See the RETURN PARAMETER DESCRIPTION for the details on the format of the "
^XWB(8994,4726,1,5,0)="returned array."
^XWB(8994,4726,1,6,0)="There must be at least one entry defined in File 920.75, PX ICE WEB "
^XWB(8994,4726,1,7,0)="SERVER. If there is more than one entry, then the Site Parameter, PX ICE "
^XWB(8994,4726,1,8,0)="WEB DEFAULT SERVER, specifies which entry is to be used."
^XWB(8994,4726,2,0)="^8994.02A^3^2"
^XWB(8994,4726,2,2,0)="DFN^1^^1^1"
^XWB(8994,4726,2,2,1,0)="^8994.021^1^1^3160912^^^^"
^XWB(8994,4726,2,2,1,1,0)="Patient DFN"
^XWB(8994,4726,2,3,0)="CACHE^1^^0^2"
^XWB(8994,4726,2,3,1,0)="^^1^1^3161013^"
^XWB(8994,4726,2,3,1,1,0)="Use cache? 1=Yes; 0=No (default: 1)."
^XWB(8994,4726,2,"B","CACHE",3)=""
^XWB(8994,4726,2,"B","DFN",2)=""
^XWB(8994,4726,2,"PARAMSEQ",1,2)=""
^XWB(8994,4726,2,"PARAMSEQ",2,3)=""
^XWB(8994,4726,3,0)="^8994.03^59^59^3161013^^"
^XWB(8994,4726,3,1,0)="If Unsuccessful:"
^XWB(8994,4726,3,2,0)="   0) = -X^Error Message"
^XWB(8994,4726,3,3,0)="         Note: -X can be one of the following values:"
^XWB(8994,4726,3,4,0)="                -1: Invalid input"
^XWB(8994,4726,3,5,0)="                -2: Could not make SOAP call (e.g., URL not populated in "
^XWB(8994,4726,3,6,0)="                    920.75, etc.)"
^XWB(8994,4726,3,7,0)="                -3: HTTP call returned unsuccessful status code (i.e., "
^XWB(8994,4726,3,8,0)="                    Server returned status code other than 200)"
^XWB(8994,4726,3,9,0)="                -4: Unable to process incoming message from ICE"
^XWB(8994,4726,3,10,0)="   n) = If SOAP call was unsuccessful, this will be the message returned "
^XWB(8994,4726,3,11,0)="        by the ICE server."
^XWB(8994,4726,3,12,0)=" "
^XWB(8994,4726,3,13,0)="If Successful:"
^XWB(8994,4726,3,14,0)="  0) = 1 ^ Number of Lines"
^XWB(8994,4726,3,15,0)="  n) = GRP ^ Vaccine Group Name ^ Group/CVX Code Recommended ^ Group/CVX "
^XWB(8994,4726,3,16,0)="       Display Name ^ Earliest Recommended Date ^ Overdue Date ^ Recommend"
^XWB(8994,4726,3,17,0)="       Code ^ Recommend Display Name ^ Doses Remaining"
^XWB(8994,4726,3,18,0)="         1: GRP"
^XWB(8994,4726,3,19,0)="         2: Vaccine Group Name - This is the vaccine group for this "
^XWB(8994,4726,3,20,0)="            recommendation"
^XWB(8994,4726,3,21,0)="         3: Group/CVX Code Recommended - Vaccine or vaccine group "
^XWB(8994,4726,3,22,0)="            recommended. If a specific vaccine is recommended, this will"
^XWB(8994,4726,3,23,0)="            be the CVX code, in the format C:CVX_Code. More commonly, this"
^XWB(8994,4726,3,24,0)="            will be populated with the vaccine group, in the format"
^XWB(8994,4726,3,25,0)="            G:Group_Name"
^XWB(8994,4726,3,26,0)="         4: Group/CVX Display Name - Display Name for CVX/Group in piece "
^XWB(8994,4726,3,27,0)="            #3."
^XWB(8994,4726,3,28,0)="         5: Earliest Recommended Date "
^XWB(8994,4726,3,29,0)="         6: Overdue Date "
^XWB(8994,4726,3,30,0)="         7: Recommend Code (currently either RECOMMENDED,"
^XWB(8994,4726,3,31,0)="            FUTURE_RECOMMENDED, CONDITIONALLY_RECOMMENDED, or"
^XWB(8994,4726,3,32,0)="            NOT_RECOMMENDED)"
^XWB(8994,4726,3,33,0)="         8: Recommend Display Name"
^XWB(8994,4726,3,34,0)="         9: Doses Remaining"
^XWB(8994,4726,3,35,0)="  n) = RSN ^ Reason Code ^ Reason Display Name "
^XWB(8994,4726,3,36,0)="         Note: This is the reason(s) for the recommendation above."
^XWB(8994,4726,3,37,0)="         1: RSN"
^XWB(8994,4726,3,38,0)="         2: Reason Code "
^XWB(8994,4726,3,39,0)="         3: Reason Display Name"
^XWB(8994,4726,3,40,0)="  n) = HIST ^ V Immunization IEN ^ Immunization Name ^ Administered CVX"
^XWB(8994,4726,3,41,0)="       Code ^ Admin date/time ^ Dose Number ^ Component CVX Code ^ CVX"
^XWB(8994,4726,3,42,0)="       Display Name ^ Validity Code ^ Validity Display Name"
^XWB(8994,4726,3,43,0)="         1: HIST "
^XWB(8994,4726,3,44,0)="         2: V Immunization IEN (#9000010.11 IEN) "
^XWB(8994,4726,3,45,0)="         3: Immunization Name (#9999999.14, #.01) "
^XWB(8994,4726,3,46,0)="         4: Administered CVX Code (#9999999.14, #.03) "
^XWB(8994,4726,3,47,0)="         5: Admin date/time"
^XWB(8994,4726,3,48,0)="         6: Dose Number "
^XWB(8994,4726,3,49,0)="         7: Component CVX Code (for combination vaccines, this can defer"
^XWB(8994,4726,3,50,0)="            from the CVX administered) "
^XWB(8994,4726,3,51,0)="         8: CVX Display Name "
^XWB(8994,4726,3,52,0)="         9: Validity Code "
^XWB(8994,4726,3,53,0)="        10: Validity Display Name "
^XWB(8994,4726,3,54,0)="  n) = RSN ^ Reason Code ^ Reason Display Name "
^XWB(8994,4726,3,55,0)="         Note: This is the reason(s) why the vaccine is valid, invalid or"
^XWB(8994,4726,3,56,0)="               accepted. "
^XWB(8994,4726,3,57,0)="         1: RSN "
^XWB(8994,4726,3,58,0)="         2: Reason Code "
^XWB(8994,4726,3,59,0)="         3: Reason Display Name"
^XWB(8994,4727,0)="PXRPC SAVE2^SAVE2^PXRPC^2^S"
