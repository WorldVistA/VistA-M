^XWB(8994,4396,2,1,1,0)="^^6^6^3151130^"
^XWB(8994,4396,2,1,1,1,0)="Array of data to save. The array is structured as name value pairs:"
^XWB(8994,4396,2,1,1,2,0)="  DATA(N)=""NAME=value"""
^XWB(8994,4396,2,1,1,3,0)="N is an interger that starts at one and increments by one. The internal"
^XWB(8994,4396,2,1,1,4,0)="entry number (IEN) of the patient in the PATIENT file (#2) should be"
^XWB(8994,4396,2,1,1,5,0)="stored in the ""PATIENT"" pair. The SUBS line-tag in the WVRPCOR"
^XWB(8994,4396,2,1,1,6,0)="routine contains the list of valid names that are accepted."
^XWB(8994,4396,2,"B","DATA",1)=""
^XWB(8994,4396,2,"PARAMSEQ",1,1)=""
^XWB(8994,4396,3,0)="^8994.03^3^3^3151130^^^"
^XWB(8994,4396,3,1,0)="Caret-delimited value indicating the call's status."
^XWB(8994,4396,3,2,0)="  Data successfully saved: ""1^"""
^XWB(8994,4396,3,3,0)="  Data not saved: ""-1^ERROR_MESSAGE"""
^XWB(8994,4397,0)="WVRPCOR EIE^EIE^WVRPCOR1^1^S^0^^^^^0"
