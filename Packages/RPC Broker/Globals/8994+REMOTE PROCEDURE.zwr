^XWB(8994,5174,0)="ORIRPCCL GETCLICK^GETCLICK^ORIRPCCL^4^A^^^0"
^XWB(8994,5174,1,0)="^8994.01^5^5^3250310^^"
^XWB(8994,5174,1,1,0)="This RPC is called when clicking one of the info panel that is set to "
^XWB(8994,5174,1,2,0)="call VistA on the click event. The inputs for this RPC can vary depending "
^XWB(8994,5174,1,3,0)="on which Information Panel Button action event triggers the call. "
^XWB(8994,5174,1,4,0)="Similarly, the output will also differ based on the specific Information "
^XWB(8994,5174,1,5,0)="Panel Button action event."
^XWB(8994,5174,2,0)="^8994.02A^1^1"
^XWB(8994,5174,2,1,0)="IJSON^2^^1^1"
^XWB(8994,5174,2,1,1,0)="^8994.021^17^17^3240123^^"
^XWB(8994,5174,2,1,1,1,0)="This is a JSON format of the input example below:"
^XWB(8994,5174,2,1,1,2,0)=" "
^XWB(8994,5174,2,1,1,3,0)="{"
^XWB(8994,5174,2,1,1,4,0)="    ""id"": 1,"
^XWB(8994,5174,2,1,1,5,0)="    ""patientId"": 2,"
^XWB(8994,5174,2,1,1,6,0)="    ""requiredData"": ["
^XWB(8994,5174,2,1,1,7,0)="        {"
^XWB(8994,5174,2,1,1,8,0)="            ""dataType"": {"
^XWB(8994,5174,2,1,1,9,0)="                ""data"": {"
^XWB(8994,5174,2,1,1,10,0)="                    ""id"": 1,"
^XWB(8994,5174,2,1,1,11,0)="                    ""name"": ""CPRS,PROVIDER"""
^XWB(8994,5174,2,1,1,12,0)="                },"
^XWB(8994,5174,2,1,1,13,0)="                ""name"": ""encounterProvider"""
^XWB(8994,5174,2,1,1,14,0)="            }"
^XWB(8994,5174,2,1,1,15,0)="        }"
^XWB(8994,5174,2,1,1,16,0)="    ]"
^XWB(8994,5174,2,1,1,17,0)="}"
^XWB(8994,5174,2,"B","IJSON",1)=""
^XWB(8994,5174,2,"PARAMSEQ",1,1)=""
^XWB(8994,5175,0)="OREDITOR SAVE^SAVE^OREDITOR^4^A^^^0"
^XWB(8994,5175,1,0)="^^3^3^3250310^"
^XWB(8994,5175,1,1,0)="The inputs for this RPC can vary depending on which Information Panel "
^XWB(8994,5175,1,2,0)="Button action event triggers the call. Similarly, the output will also "
^XWB(8994,5175,1,3,0)="differ based on the specific Information Panel Button action event."
^XWB(8994,5175,2,0)="^8994.02A^1^1"
^XWB(8994,5175,2,1,0)="IJSON^2^^1^1"
^XWB(8994,5175,2,"B","IJSON",1)=""
^XWB(8994,5175,2,"PARAMSEQ",1,1)=""
^XWB(8994,5176,0)="OREDITOR LONGLIST^LONGLIST^OREDITOR^4^A^^^0"
^XWB(8994,5176,1,0)="^^3^3^3250310^"
^XWB(8994,5176,1,1,0)="The inputs for this RPC can vary depending on which Information Panel "
^XWB(8994,5176,1,2,0)="Button action event triggers the call. Similarly, the output will also "
^XWB(8994,5176,1,3,0)="differ based on the specific Information Panel Button action event."
^XWB(8994,5176,2,0)="^8994.02A^1^1"
^XWB(8994,5176,2,1,0)="IJSON^2^^1^1"
^XWB(8994,5176,2,1,1,0)="^^1^1^3240123^"
^XWB(8994,5176,2,1,1,1,0)="This is the json value for the inputs"
^XWB(8994,5176,2,"B","IJSON",1)=""
^XWB(8994,5176,2,"PARAMSEQ",1,1)=""
^XWB(8994,5177,0)="ORSPECAUTH SAFORORDERS^SAFORORDERS^ORSPECAUTH^2^^^^0"
^XWB(8994,5177,1,0)="^^2^2^3241203^"
^XWB(8994,5177,1,1,0)="This RPC will return the valid Special Authority values and rules for the "
^XWB(8994,5177,1,2,0)="specific patient passed in."
^XWB(8994,5177,2,0)="^8994.02A^2^1"
^XWB(8994,5177,2,2,0)="JSONIN^1^^1^1"
^XWB(8994,5177,2,2,1,0)="^^99^99^3241216^"
^XWB(8994,5177,2,2,1,1,0)="JSON string passed in to retrieve valid SA's for a patient per order"
^XWB(8994,5177,2,2,1,2,0)=" "
^XWB(8994,5177,2,2,1,3,0)="""patientId"" = unique patient numeric number (DFN)"
^XWB(8994,5177,2,2,1,4,0)="""orders""    = section for 1 to many orders"
^XWB(8994,5177,2,2,1,5,0)="  ""orderId""  = order unique number in ORDERS file #(100)."
^XWB(8994,5177,2,2,1,6,0)=" "
^XWB(8994,5177,2,2,1,7,0)=" "
^XWB(8994,5177,2,2,1,8,0)=" "
