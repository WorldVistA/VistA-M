^XWB(8994,3370,1,0)="^8994.01^39^39^3151109^^^^"
^XWB(8994,3370,1,1,0)="This RPC will return success flag (1) or error flag (-1^error message)"
^XWB(8994,3370,1,2,0)="VPSDFN  : Patient IEN"
^XWB(8994,3370,1,3,0)="VPSDATA : Array of field-value pair to store"
^XWB(8994,3370,1,4,0)=" "
^XWB(8994,3370,1,5,0)="   Format : VPSDATA(1..n)=FIELD-NAME^SEQ#^FIELD-VALUE"
^XWB(8994,3370,1,6,0)=" "
^XWB(8994,3370,1,7,0)="   Example: "
^XWB(8994,3370,1,8,0)="                       Survey Name"
^XWB(8994,3370,1,9,0)="            VPSDATA(1) = NAME^^Survey #1  "
^XWB(8994,3370,1,10,0)="                       Survey Internal Name"
^XWB(8994,3370,1,11,0)="            VPSDATA(2) = INTERNAL^^Survey Internal #1  "
^XWB(8994,3370,1,12,0)="                       Questionnaire Template ID"
^XWB(8994,3370,1,13,0)="            VPSDATA(3) = TEMPLATE ID^^5     "
^XWB(8994,3370,1,14,0)="                       Survey Version"
^XWB(8994,3370,1,15,0)="            VPSDATA(4) = VERSION^^10    "
^XWB(8994,3370,1,16,0)="                       Date/Time Survey was taken                    "
^XWB(8994,3370,1,17,0)="            VPSDATA(5) = DATE/TIME TAKEN^^9/24/2014@093001  "
^XWB(8994,3370,1,18,0)="                       Date/Time Survey was modified"
^XWB(8994,3370,1,19,0)="            VPSDATA(6) = DATE/TIME MODIFIED^^12/31/2014@153301 "
^XWB(8994,3370,1,20,0)="                       Completion STATUS (C=Completed, I=Incomplete)"
^XWB(8994,3370,1,21,0)="            VPSDATA(7) = STATUS^^C "
^XWB(8994,3370,1,22,0)="                       DUZ of INTERVIEWER"
^XWB(8994,3370,1,23,0)="            VPSDATA(8) = INTERVIEWER^^4667 "
^XWB(8994,3370,1,24,0)="                       Patient Safety (N=NO, Y=YES)"
^XWB(8994,3370,1,25,0)="            VPSDATA(9) = SAFETY^^Y  "
^XWB(8994,3370,1,26,0)="                       Immediate Action (N=NO, Y=YES)                      "
^XWB(8994,3370,1,27,0)="            VPSDATA(10)= ACTION^^Y  "
^XWB(8994,3370,1,28,0)="                       Survey Calculated Value                       "
^XWB(8994,3370,1,29,0)="            The SURVEY CALC field is used to store overall survey "
^XWB(8994,3370,1,30,0)="            calculated values in a delimted string.  The string "
^XWB(8994,3370,1,31,0)="            format is as follows:"
^XWB(8994,3370,1,32,0)=" "
^XWB(8994,3370,1,33,0)="                        OVERALL SURVEY CALCULATED^CALCULATION LABEL_1;VALUE_1~CALCULATION LABEL_2;VALUE_2~~CALCULATION LABEL_NN;CALCULATION VALUE_NN"
^XWB(8994,3370,1,34,0)="                      "
^XWB(8994,3370,1,35,0)="             VPSDATA(11)= SURVEY CALC^^435.9^SCORE;89.5~AVG RATE;24~AVG NO COMPLETE;7"
^XWB(8994,3370,1,36,0)="OUTPUT"
^XWB(8994,3370,1,37,0)="  VPSRES =  1                   (Survey is stored successully)"
^XWB(8994,3370,1,38,0)="           -1^Error Message     (Survey is not stored because an Error)"
^XWB(8994,3370,1,39,0)=" "
^XWB(8994,3370,1,40,0)="LABEL_NN;CALCULATION VALUE_NN"
^XWB(8994,3370,1,41,0)=" "
^XWB(8994,3370,1,42,0)="                "
^XWB(8994,3370,1,43,0)="            VPSDATA(11)= SURVEY CALC^^435.9^SCORE;89.5~AVG RATE;24~AVG "
^XWB(8994,3370,1,44,0)="NO COMPLETE;7"""
^XWB(8994,3370,1,45,0)="                       DUZ of survey creator         "
^XWB(8994,3370,1,46,0)="            VPSDATA(12)= CREATOR^^45465           "
^XWB(8994,3370,1,47,0)="   Multiple Questions"
^XWB(8994,3370,1,48,0)="            VPSDATA(13)= QUESTION^1^Enter Your Name:"
^XWB(8994,3370,1,49,0)="            VPSDATA(14)= QUESTION^2^Do you feel the doctor qualify?"
^XWB(8994,3370,1,50,0)="            VPSDATA(15)= QUESTION^3^Rate visit (1-10) 1=Bad, 10:GREAT?"
^XWB(8994,3370,1,51,0)="   Multiple Response"
^XWB(8994,3370,1,52,0)="            VPSDATA(16)= RESPONSE^1^MCENROE,JOHN"
^XWB(8994,3370,1,53,0)="            VPSDATA(17)= RESPONSE^2^NO"
^XWB(8994,3370,1,54,0)="            VPSDATA(18)= RESPONSE^3^5"
^XWB(8994,3370,1,55,0)="   Multiple Survey Calculated Values"
^XWB(8994,3370,1,56,0)="            VPSDATA(19)= QUESTION CALC^1^Name: John McEnroe"
^XWB(8994,3370,1,57,0)="            VPSDATA(20)= QUESTION CALC^2^Dr. Carter is not qualified to "
^XWB(8994,3370,1,58,0)="treat my illness"
^XWB(8994,3370,1,59,0)="            VPSDATA(21)= QUESTION CALC^3^I rated my visit as "
^XWB(8994,3370,1,60,0)="unsatisfactory"
^XWB(8994,3370,1,61,0)=" "
^XWB(8994,3370,1,62,0)="OUTPUT"
^XWB(8994,3370,1,63,0)="  VPSRES =  1                   (Survey is stored successully)"
^XWB(8994,3370,1,64,0)="           -1^Error Message     (Survey is not stored because an Error)"
^XWB(8994,3370,2,0)="^8994.02A^3^3"
^XWB(8994,3370,2,1,0)="VPSDFN^1^9^1^1"
^XWB(8994,3370,2,1,1,0)="^8994.021^1^1^3140930^^^"
^XWB(8994,3370,2,1,1,1,0)="Patient ID (DFN) who enters the Clinical Survey Questionannire "
^XWB(8994,3370,2,2,0)="VPSDATA^2^255^1^2"
^XWB(8994,3370,2,2,1,0)="^8994.021^1^1^3151109^^^"
^XWB(8994,3370,2,2,1,1,0)="Array of Data containing Clinical Survey Questionnaire to be stored in VistA."
^XWB(8994,3370,2,3,0)="MODFLG^1^1^^3"
^XWB(8994,3370,2,3,1,0)="^^5^5^3151109^"
^XWB(8994,3370,2,3,1,1,0)="A flag to indicate that an existing response is being modified"
^XWB(8994,3370,2,3,1,2,0)="  0 new occurrence"
^XWB(8994,3370,2,3,1,3,0)="  1 edit existing data, but add new responses while keeping previous"
^XWB(8994,3370,2,3,1,4,0)="    response"
^XWB(8994,3370,2,3,1,5,0)="  2 edit existing data, but over write previous response"
