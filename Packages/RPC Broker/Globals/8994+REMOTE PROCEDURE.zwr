^XWB(8994,2726,0)="MAG SCAN IMAGE TEXT FILES^SCANIMG^MAGDOD01^1^R^0^^0^3"
^XWB(8994,2726,1,0)="^8994.01^23^23^3100622^^^^"
^XWB(8994,2726,1,1,0)=" +---------------------------------------------------------------+"
^XWB(8994,2726,1,2,0)=" | Property of the US Government.                                |"
^XWB(8994,2726,1,3,0)=" | No permission to copy or redistribute this software is given. |"
^XWB(8994,2726,1,4,0)=" | Use of unreleased versions of this software requires the user |"
^XWB(8994,2726,1,5,0)=" | to execute a written test agreement with the VistA Imaging    |"
^XWB(8994,2726,1,6,0)=" | Development Office of the Department of Veterans Affairs,     |"
^XWB(8994,2726,1,7,0)=" | telephone (301) 734-0100.                                     |"
^XWB(8994,2726,1,8,0)=" |                                                               |"
^XWB(8994,2726,1,9,0)=" | The Food and Drug Administration classifies this software as  |"
^XWB(8994,2726,1,10,0)=" | a medical device.  As such, it may not be changed in any way. |"
^XWB(8994,2726,1,11,0)=" | Modifications to this software may result in an adulterated   |"
^XWB(8994,2726,1,12,0)=" | medical device under 21CFR820, the use of which is considered |"
^XWB(8994,2726,1,13,0)=" | to be a violation of US Federal Statutes.                     |"
^XWB(8994,2726,1,14,0)=" +---------------------------------------------------------------+"
^XWB(8994,2726,1,15,0)=" "
^XWB(8994,2726,1,16,0)="This Remote Procedure assists the client software in traversing"
^XWB(8994,2726,1,17,0)="the IMAGE file (#2005)"
^XWB(8994,2726,1,18,0)="The following sub-actions are supported:"
^XWB(8994,2726,1,19,0)="  Init    - return information to the client about the"
^XWB(8994,2726,1,20,0)="            current scan-status"
^XWB(8994,2726,1,21,0)="  Restart - reset internal counters so that the next scan"
^XWB(8994,2726,1,22,0)="            will re-scan the whole database"
^XWB(8994,2726,1,23,0)="  Scan    - return the file-name for the next (or previous) image"
^XWB(8994,2726,2,0)="^8994.02A^3^3"
^XWB(8994,2726,2,1,0)="ACTION^1^15^1^1"
^XWB(8994,2726,2,1,1,0)="^^4^4^3061127^"
^XWB(8994,2726,2,1,1,1,0)="The value of this parameter is a string. This string specifies"
^XWB(8994,2726,2,1,1,2,0)="the action to be taken by the Remote Procedure."
^XWB(8994,2726,2,1,1,3,0)=" "
^XWB(8994,2726,2,1,1,4,0)="Possible values are: Init, Restart and Scan."
^XWB(8994,2726,2,2,0)="IMAGE^1^20^1^2"
^XWB(8994,2726,2,2,1,0)="^8994.021^10^10^3100622^^"
^XWB(8994,2726,2,2,1,1,0)="The value of this parameter is a pointer to the IMAGE file (#2005)."
^XWB(8994,2726,2,2,1,2,0)="(In order to start a scan, the special values 9 (zero) and "" "" (space)"
^XWB(8994,2726,2,2,1,3,0)="are also permitted.)"
^XWB(8994,2726,2,2,1,4,0)=" "
^XWB(8994,2726,2,2,1,5,0)="The value of this parameter indicates the image-number from which"
^XWB(8994,2726,2,2,1,6,0)="the Remote Procedure is to start its search for the next (or previous)"
^XWB(8994,2726,2,2,1,7,0)="image."
^XWB(8994,2726,2,2,1,8,0)=" "
^XWB(8994,2726,2,2,1,9,0)="If image=0 and DIR=1, the first image in the database will be found."
^XWB(8994,2726,2,2,1,10,0)="If image="" "" and DIR=-1, the last image in the database will be found."
^XWB(8994,2726,2,3,0)="DIR^1^5^0^3"
^XWB(8994,2726,2,3,1,0)="^8994.021^6^6^3100621^^^"
^XWB(8994,2726,2,3,1,1,0)="The value of this parameter is a number. If the value of this number"
^XWB(8994,2726,2,3,1,2,0)="is less than zero, the value -1 will be used. Otherwise, the value"
^XWB(8994,2726,2,3,1,3,0)="1 will be used."
^XWB(8994,2726,2,3,1,4,0)=" "
^XWB(8994,2726,2,3,1,5,0)="The value of this parameter is used in references to $ORDER to traverse"
^XWB(8994,2726,2,3,1,6,0)="the IMAGE file (#2005)"
^XWB(8994,2726,2,"B","ACTION",1)=""
^XWB(8994,2726,2,"B","DIR",3)=""
^XWB(8994,2726,2,"B","IMAGE",2)=""
^XWB(8994,2726,2,"PARAMSEQ",1,1)=""
^XWB(8994,2726,2,"PARAMSEQ",2,2)=""
^XWB(8994,2726,2,"PARAMSEQ",3,3)=""
^XWB(8994,2726,3,0)="^8994.03^16^16^3100622^^^"
^XWB(8994,2726,3,1,0)="The return value of this remote procedure is a string."
^XWB(8994,2726,3,2,0)=" "
^XWB(8994,2726,3,3,0)="If the numeric interpretation of this string is a negative number,"
^XWB(8994,2726,3,4,0)="the value will contain an error message."
^XWB(8994,2726,3,5,0)=" "
^XWB(8994,2726,3,6,0)="Otherwise, the first comma-separated piece of the return value"
^XWB(8994,2726,3,7,0)="will be the internal entry number of the image found."
^XWB(8994,2726,3,8,0)="The second comma-separated piece will either be the name of"
^XWB(8994,2726,3,9,0)="the ""text"" file for that image, or a negative number."
^XWB(8994,2726,3,10,0)="The third comma-separated piece will be one of the following values, "
^XWB(8994,2726,3,11,0)="indicating the proximity of the nearest version of the file:"
^XWB(8994,2726,3,12,0)="   M:  magnetic"
^XWB(8994,2726,3,13,0)="   W:  WORM (jukebox)"
^XWB(8994,2726,3,14,0)="   A:  archive"
^XWB(8994,2726,3,15,0)="   O:  offline"
^XWB(8994,2726,3,16,0)="   I:  invalid/undeterminable"
^XWB(8994,2727,0)="MAG STORE TEXT FILE DETAILS^STOREUID^MAGDOD01^1^R^0^^0^3"
^XWB(8994,2727,1,0)="^8994.01^18^18^3100621^^^^"
