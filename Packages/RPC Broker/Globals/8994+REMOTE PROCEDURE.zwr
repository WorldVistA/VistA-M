^XWB(8994,4561,0)="DSIYTI05 SIGNINFO^SIGNINFO^DSIYTI05^1^^^^^1.5"
^XWB(8994,4561,1,0)="^8994.01^7^7^3170825^^^"
^XWB(8994,4561,1,1,0)="This rpc provides information regarding the signing of various stages of "
^XWB(8994,4561,1,2,0)="a turn-in.  The rpc is used on the Turn-In enter/edit screen and is "
^XWB(8994,4561,1,3,0)="called through an icon which appears on the header line of each turn-in "
^XWB(8994,4561,1,4,0)="section.  This information will then be displayed on a pop-up.  The text "
^XWB(8994,4561,1,5,0)="of the pop-up will be returned in a single variable, in a '^' delimted "
^XWB(8994,4561,1,6,0)="string.  See description of input parameters and return value for a more "
^XWB(8994,4561,1,7,0)="detailed description."
^XWB(8994,4561,2,0)="^8994.02A^2^2"
^XWB(8994,4561,2,1,0)="TIIEN^1^30^1^1"
^XWB(8994,4561,2,1,1,0)="^^1^1^3170822^"
^XWB(8994,4561,2,1,1,1,0)="The internal number of the turn-in - referring to ^PRCN(413.1,TIIEN"
^XWB(8994,4561,2,2,0)="STAGE^1^10^1^2"
^XWB(8994,4561,2,2,1,0)="^8994.021^5^5^3170825^^"
^XWB(8994,4561,2,2,1,1,0)="The stage of turn-in being requested:"
^XWB(8994,4561,2,2,1,2,0)="  EIL - for the CMR signature info"
^XWB(8994,4561,2,2,1,3,0)="  PPM - for the initial PPM approval"
^XWB(8994,4561,2,2,1,4,0)="  WAR - for the Warehouse approval"
^XWB(8994,4561,2,2,1,5,0)="  FINAL - for the final approval"
