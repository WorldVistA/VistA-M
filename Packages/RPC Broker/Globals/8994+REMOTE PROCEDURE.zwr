^XWB(8994,4980,3,19,0)="                 ""Missing Recall Date."""
^XWB(8994,4980,3,20,0)="         ],"
^XWB(8994,4980,3,21,0)="         ""RecallReqEdit"": {"
^XWB(8994,4980,3,22,0)="              1   ""IEN"": """""
^XWB(8994,4980,3,23,0)="         }"
^XWB(8994,4980,3,24,0)=" }"
^XWB(8994,4980,3,25,0)=" "
^XWB(8994,4981,0)="SDES2 DISPOSITION APPT REQ^DISPOSITION^SDES2ARCLOSE^2^R^^^^^^1"
^XWB(8994,4981,1,0)="^^3^3^3250213^"
^XWB(8994,4981,1,1,0)="Dispositioning/closing an appointment request"
^XWB(8994,4981,1,2,0)=" "
^XWB(8994,4981,1,3,0)="Can only be invoked by Acheron"
^XWB(8994,4981,2,0)="^8994.02A^6^3"
^XWB(8994,4981,2,1,0)="APPTREQ^1"
^XWB(8994,4981,2,2,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,4981,2,2,1,0)="^^11^11^3231113^"
^XWB(8994,4981,2,2,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"")"
^XWB(8994,4981,2,2,1,2,0)="    - Up to 40 Character unique ID number. "
^XWB(8994,4981,2,2,1,3,0)="    - Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,4981,2,2,1,4,0)="   SDCONTEXT(""USER DUZ"")"
^XWB(8994,4981,2,2,1,5,0)="    - The DUZ of the user taking action in the calling application."
^XWB(8994,4981,2,2,1,6,0)="   SDCONTEXT(""USER SECID"")"
^XWB(8994,4981,2,2,1,7,0)="    - The SECID of the user taking action in the calling application."
^XWB(8994,4981,2,2,1,8,0)="   SDCONTEXT(""PATIENT DFN"")"
^XWB(8994,4981,2,2,1,9,0)="    - The DFN/IEN of the target patient from the calling application."
^XWB(8994,4981,2,2,1,10,0)="   SDCONTEXT(""PATIENT ICN"")"
^XWB(8994,4981,2,2,1,11,0)="    - The ICN of the target patient from the calling application."
^XWB(8994,4981,2,6,0)="SDINPUT^2^32000^1^2"
^XWB(8994,4981,2,6,1,0)="^8994.021^28^28^3250213^^"
^XWB(8994,4981,2,6,1,1,0)="1. SDINPUT(DISP) = (Required) Disposition reason associated with the"
^XWB(8994,4981,2,6,1,2,0)="closing"
^XWB(8994,4981,2,6,1,3,0)="of the appointment request.  Enter one of the following reasons:"
^XWB(8994,4981,2,6,1,4,0)=" "
^XWB(8994,4981,2,6,1,5,0)=" ""DEATH"" DISP=1"
^XWB(8994,4981,2,6,1,6,0)=" ""REMOVED/NON-VA CARE"" DISP=2"
^XWB(8994,4981,2,6,1,7,0)=" ""REMOVED/SCHEDULED-ASSIGNED"" DISP=3"
^XWB(8994,4981,2,6,1,8,0)=" ""REMOVED/VA CONTRACT CARE"" DISP=4"
^XWB(8994,4981,2,6,1,9,0)=" ""REMOVED/NO LONGER NECESSARY"" DISP=5"
^XWB(8994,4981,2,6,1,10,0)=" ""ENTERED IN ERROR"" DISP=6"
^XWB(8994,4981,2,6,1,11,0)=" ""TRANSFERRED TO EWL"" DISP=7"
^XWB(8994,4981,2,6,1,12,0)=" ""CHANGED CLINIC"" DISP=8"
^XWB(8994,4981,2,6,1,13,0)=" ""MRTC PARENT CLOSED"" DISP=9"
^XWB(8994,4981,2,6,1,14,0)=" ""REMOVED/EXTERNAL APP"" DISP=10 "
^XWB(8994,4981,2,6,1,15,0)=" ""FAILURE TO RESPOND"" DISP=11"
^XWB(8994,4981,2,6,1,16,0)=" ""VET SELF-CANCEL"" DISP=12"
^XWB(8994,4981,2,6,1,17,0)=" "
^XWB(8994,4981,2,6,1,18,0)=" "
^XWB(8994,4981,2,6,1,19,0)="2. SDINPUT(REQUEST ID) = (Required) Appt request ID from file #409.85."
^XWB(8994,4981,2,6,1,20,0)=" "
^XWB(8994,4981,2,6,1,21,0)="3. SDINPUT(DISPDT) = (Required) Date the request is dispositioned."
^XWB(8994,4981,2,6,1,22,0)="(e.g.,YYYY-MM-DD)"
^XWB(8994,4981,2,6,1,23,0)=" "
^XWB(8994,4981,2,6,1,24,0)="4. SDINPUT(PCMT) = (Optional) Patient-entered"
^XWB(8994,4981,2,6,1,25,0)="comments in which a veteran cancels/edits an appointment request using"
^XWB(8994,4981,2,6,1,26,0)="VAOS or another application to"
^XWB(8994,4981,2,6,1,27,0)="add notes. These comments are stored at PATIENT COMMENTS field"
^XWB(8994,4981,2,6,1,28,0)="(#409.85,60)."
