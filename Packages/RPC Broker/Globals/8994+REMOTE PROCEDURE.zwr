^XWB(8994,5126,0)="PSO ADDRESS UPDATE^PSOVPADDR^PSOVCC0^1^P^^^^^^1"
^XWB(8994,5126,1,0)="^8994.01^4^4^3241120^^^^"
^XWB(8994,5126,1,1,0)="This RPC allows the address fields in the PATIENT (#2)"
^XWB(8994,5126,1,2,0)="file to be updated. It takes two parameters: the patient ICN"
^XWB(8994,5126,1,3,0)="and the temporary address fields that are to be updated."
^XWB(8994,5126,1,4,0)="  "
^XWB(8994,5126,2,0)="^8994.02A^5^5"
^XWB(8994,5126,2,1,0)="PSOVICN^1^31^1^1"
^XWB(8994,5126,2,1,1,0)="^8994.021^1^1^3230324^^^"
^XWB(8994,5126,2,1,1,1,0)="The patient ICN"
^XWB(8994,5126,2,2,0)="PSOVADDR^2^2095^1^2"
^XWB(8994,5126,2,2,1,0)="^8994.021^15^15^3241120^^^^"
^XWB(8994,5126,2,2,1,1,0)="This is a list of the temporary address fields to be updated."
^XWB(8994,5126,2,2,1,2,0)="The fields that can be updated are:"
^XWB(8994,5126,2,2,1,3,0)="County -             .12111"
^XWB(8994,5126,2,2,1,4,0)="Zip+4 -              .12112"
^XWB(8994,5126,2,2,1,5,0)="StreetL2 -           .1212"
^XWB(8994,5126,2,2,1,6,0)="StreetL3 -           .1213"
^XWB(8994,5126,2,2,1,7,0)="TempCity -           .1214"
^XWB(8994,5126,2,2,1,8,0)="TempState -          .1215"
^XWB(8994,5126,2,2,1,9,0)="TempZip -            .1216"
^XWB(8994,5126,2,2,1,10,0)="StartDate -          .1217"
^XWB(8994,5126,2,2,1,11,0)="EndDate -            .1218"
^XWB(8994,5126,2,2,1,12,0)="TempPhoneNumber -    .1219"
^XWB(8994,5126,2,2,1,13,0)="TempProvince -       .1221"
^XWB(8994,5126,2,2,1,14,0)="TempPostCode -       .1222"
^XWB(8994,5126,2,2,1,15,0)="Country -            .1223"
^XWB(8994,5126,2,4,0)="PSOVTYP^1^29^1^3"
^XWB(8994,5126,2,5,0)="PSOVATYP"
