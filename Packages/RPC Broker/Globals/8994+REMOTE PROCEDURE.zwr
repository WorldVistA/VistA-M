^XWB(8994,3388,1,0)="^^7^7^3160225^"
^XWB(8994,3388,1,1,0)="RPC ICE #6289 - API ICR #none"
^XWB(8994,3388,1,2,0)="This restricted RPC is used exclusively by the Identity and Access "
^XWB(8994,3388,1,3,0)="Management (IAM) Provisioning application to display a VistA user."
^XWB(8994,3388,1,4,0)=" "
^XWB(8994,3388,1,5,0)="The XUSHOWSSN Security Key is required to display Personally Identifiable"
^XWB(8994,3388,1,6,0)="Information (PII) such as Social Security Number (SSN) or Date of Birth"
^XWB(8994,3388,1,7,0)="(DOB)."
