^XWB(8994,2912,2,"B","MDCPMSG",1)=""
^XWB(8994,2912,2,"PARAMSEQ",1,1)=""
^XWB(8994,2912,3,0)="^8994.03^3^3^3061211^^^"
^XWB(8994,2912,3,1,0)="This returns the value of the message.  Note that, at least for the "
^XWB(8994,2912,3,2,0)="initial version of this call, the MSH segment will NOT be returned as "
^XWB(8994,2912,3,3,0)="part of the results."
^XWB(8994,2913,0)="MDCP CORRECTIONS BY IEN^GETCORR^MDCPHL7B^2^S^0^^1"
^XWB(8994,2913,1,0)="^8994.01^1^1^3091118^^^^"
^XWB(8994,2913,1,1,0)="Gets a list of corrections for a given HL7 message."
^XWB(8994,2913,2,0)="^8994.02A^1^1"
^XWB(8994,2913,2,1,0)="MDCPMSG^1^^1^1"
^XWB(8994,2913,2,1,1,0)="^8994.021^1^1^3060927^^"
^XWB(8994,2913,2,1,1,1,0)="The IEN of the message in file 703.1 (the CP REPORT RESULTS file)."
^XWB(8994,2913,2,"B","MDCPMSG",1)=""
^XWB(8994,2913,2,"PARAMSEQ",1,1)=""
^XWB(8994,2913,3,0)="^^3^3^3060927^"
^XWB(8994,2913,3,1,0)="Returns a global array in the format:"
^XWB(8994,2913,3,2,0)=" "
^XWB(8994,2913,3,3,0)="Correction Type IEN^Uncorrected Value^Corrected Value"
^XWB(8994,2914,0)="MDCP UPDATE MESSAGE STATUS^UPDATERP^MDCPHL7B^2^P^0^^1^1"
^XWB(8994,2914,1,0)="^8994.01^6^6^3091118^^"
^XWB(8994,2914,1,1,0)="This call will update the status of an entry in file 704.002"
^XWB(8994,2914,1,2,0)="(the CLIO_HL7_LOG file).  Note that if the status passed through is "
^XWB(8994,2914,1,3,0)="'PROCESSED', the CP INSTRUMENT file entry pointed to by field .03 will be "
^XWB(8994,2914,1,4,0)="checked to see if it has a routine in its .11 field.  If it does, the HL7 "
^XWB(8994,2914,1,5,0)="message will be copied to a temp global and the PROCESSING ROUTINE will "
^XWB(8994,2914,1,6,0)="be invoked."
^XWB(8994,2914,2,0)="^8994.02A^4^4"
^XWB(8994,2914,2,1,0)="MDCPMSG^1^^1^1"
^XWB(8994,2914,2,1,1,0)="^^1^1^3060929^"
^XWB(8994,2914,2,1,1,1,0)="The IFN of the message in the CP RESULT REPORT file."
^XWB(8994,2914,2,2,0)="MDCPSTAT^1^1^1^2"
^XWB(8994,2914,2,2,1,0)="^^3^3^3060929^"
^XWB(8994,2914,2,2,1,1,0)="The status to which to change the file entry referenced by the first "
^XWB(8994,2914,2,2,1,2,0)="parameter.  Check the data dictionary for field .09 to get a list of "
^XWB(8994,2914,2,2,1,3,0)="valid codes.  This parameter must be in internal format."
^XWB(8994,2914,2,3,0)="MDCPDFN^1^^0^3"
^XWB(8994,2914,2,3,1,0)="^^1^1^3060929^"
^XWB(8994,2914,2,3,1,1,0)="This is the IFN of the patient in file 2, if available."
