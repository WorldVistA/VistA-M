^XWB(8994,3595,2,5,1,3,0)="type initial:"
^XWB(8994,3595,2,5,1,4,0)="                           A = APPT     A123"
^XWB(8994,3595,2,5,1,5,0)="                           E = EWL      E123"
^XWB(8994,3595,2,5,1,6,0)="                           C = Consult  C123  ;not implemented"
^XWB(8994,3595,2,5,1,7,0)="                           R = Recall   R123  ;not implemented"
^XWB(8994,3595,2,6,0)="SDMAX^1^10^^6"
