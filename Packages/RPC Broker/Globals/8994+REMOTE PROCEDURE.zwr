^XWB(8994,4859,2,"PARAMSEQ",4,4)=""
^XWB(8994,4859,3,0)="^8994.03^1^1^3200930^^^"
^XWB(8994,4859,3,1,0)=" DSIYRET(1)=IEN of Report^TaskMan Job Number^Start Date.Time"
^XWB(8994,4860,0)="DSIY6928 GLIST^GLIST^DSIY6928^4^^^^1"
^XWB(8994,4860,1,0)="^8994.01^8^8^3200617^^"
^XWB(8994,4860,1,1,0)="GLIST - Returns the list of unique codes from in the ENG SPACE (#6928) "
^XWB(8994,4860,1,2,0)="file based on the code type that is submitted."
^XWB(8994,4860,1,3,0)=" "
^XWB(8994,4860,1,4,0)="Code Type"
^XWB(8994,4860,1,5,0)="D for Division"
^XWB(8994,4860,1,6,0)="B for Building"
^XWB(8994,4860,1,7,0)="W for Wing"
^XWB(8994,4860,1,8,0)="R for Room"
^XWB(8994,4860,2,0)="^8994.02A^1^1"
^XWB(8994,4860,2,1,0)="DSIYTYPE^1^1^1^1"
^XWB(8994,4860,2,1,1,0)="^8994.021^7^7^3200617^^"
^XWB(8994,4860,2,1,1,1,0)="Submit a code type D, B, W, or R"
^XWB(8994,4860,2,1,1,2,0)=" "
^XWB(8994,4860,2,1,1,3,0)="Code Type"
^XWB(8994,4860,2,1,1,4,0)="D for Division"
^XWB(8994,4860,2,1,1,5,0)="B for Building"
^XWB(8994,4860,2,1,1,6,0)="W for Wing"
^XWB(8994,4860,2,1,1,7,0)="R for Room"
^XWB(8994,4860,2,"B","DSIYTYPE",1)=""
^XWB(8994,4860,2,"PARAMSEQ",1,1)=""
^XWB(8994,4860,3,0)="^8994.03^11^11^3200617^^"
^XWB(8994,4860,3,1,0)="returns global array containing the unique codes."
^XWB(8994,4860,3,2,0)=" "
^XWB(8994,4860,3,3,0)=" "
^XWB(8994,4860,3,4,0)="Array(##)=Code ^ IEN"
^XWB(8994,4860,3,5,0)=" "
^XWB(8994,4860,3,6,0)="Not that the IEN is the first entry found with the specific code. "
^XWB(8994,4860,3,7,0)="Division JC mya have 100 entries,  IEN = 22 being the 1st"
^XWB(8994,4860,3,8,0)="Array(##)=JC^22"
^XWB(8994,4860,3,9,0)=" "
^XWB(8994,4860,3,10,0)="For the Room array the room entry is unique so the array(##)= room^IEN "
^XWB(8994,4860,3,11,0)="should include all the IENs found in the ENG SPACE (#6928)."
^XWB(8994,4861,0)="DSIYDD1 EXDTCK^EXDTCK^DSIYDD1^1"
^XWB(8994,4861,1,0)="^^10^10^3200520^"
^XWB(8994,4861,1,1,0)="RPC DSIYDD1 EXDTCK used to validate external date, including FM formats "
^XWB(8994,4861,1,2,0)="such as T+3D, T-3W, and T+3M"
^XWB(8994,4861,1,3,0)=" "
^XWB(8994,4861,1,4,0)=" return: status^external date^internal date"
^XWB(8994,4861,1,5,0)="   -1^message"
^XWB(8994,4861,1,6,0)="    1^external date or input string ^ external date value"
^XWB(8994,4861,1,7,0)=" "
^XWB(8994,4861,1,8,0)="  piece 2 with be external format MM/DD/YEAR unless the input "
^XWB(8994,4861,1,9,0)="  contained a FM format beginning with a T"
^XWB(8994,4861,1,10,0)="  If input contained a T then 2nd piece will be equal to the input value."
^XWB(8994,4861,2,0)="^8994.02A^1^1"
^XWB(8994,4861,2,1,0)="DSIYDT^1^12^1^1"
^XWB(8994,4861,2,1,1,0)="^^11^11^3200520^"
^XWB(8994,4861,2,1,1,1,0)="Pass an external date."
^XWB(8994,4861,2,1,1,2,0)=" "
^XWB(8994,4861,2,1,1,3,0)="Acceptable dates are in one of these formats:"
^XWB(8994,4861,2,1,1,4,0)=" Normal MM/DD/YYYY or 1/20/57 format."
^XWB(8994,4861,2,1,1,5,0)=" To create dynamic dates, you can use shortcuts such as T for today,"
^XWB(8994,4861,2,1,1,6,0)=" T-1 for yesterday, or T+1 for tomorrow. Or you can combine T with "
^XWB(8994,4861,2,1,1,7,0)=" D for day, W for week, or M for month:"
^XWB(8994,4861,2,1,1,8,0)=" "
^XWB(8994,4861,2,1,1,9,0)=" T-2D means two days ago, "
^XWB(8994,4861,2,1,1,10,0)=" T+1W means today plus one week,"
^XWB(8994,4861,2,1,1,11,0)=" T+4M means four months from today. "
^XWB(8994,4861,2,"B","DSIYDT",1)=""
^XWB(8994,4861,2,"PARAMSEQ",1,1)=""
^XWB(8994,4861,3,0)="^^7^7^3200520^"
^XWB(8994,4861,3,1,0)=" return: status^external date^internal date"
^XWB(8994,4861,3,2,0)="   -1^message"
^XWB(8994,4861,3,3,0)="    1^external date or input string ^ external date value"
^XWB(8994,4861,3,4,0)=" "
^XWB(8994,4861,3,5,0)="  piece 2 with be external format MM/DD/YEAR unless the input"
^XWB(8994,4861,3,6,0)="  contained a FM format beginning with a T"
^XWB(8994,4861,3,7,0)="  If input contained a T then 2nd piece will be equal to the input value."
^XWB(8994,4862,0)="DSIYAD01 ADHFDESC FIELD DESC^ADHFDESC^DSIYAD01^2"
^XWB(8994,4862,1,0)="^^1^1^3191230^"
^XWB(8994,4862,1,1,0)="This RPC returns the field description for a specified Field."
^XWB(8994,4862,2,0)="^8994.02A^2^2"
^XWB(8994,4862,2,1,0)="DSIYFILE^1^20^1^1"
^XWB(8994,4862,2,1,1,0)="^^1^1^3191230^"
^XWB(8994,4862,2,1,1,1,0)="DSIYFILE - pass a file number."
^XWB(8994,4862,2,2,0)="DSIYFLD^1^20^1^2"
^XWB(8994,4862,2,2,1,0)="^^1^1^3191230^"
^XWB(8994,4862,2,2,1,1,0)="DSIYFLD - pass the field number."
