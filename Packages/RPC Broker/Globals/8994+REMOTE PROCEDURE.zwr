^XWB(8994,2859,0)="MAG UTIL GETNETLOC^SHARE^MAGSDEL5^2^R"
^XWB(8994,2859,1,0)="^8994.01^4^4^3100622^^^^"
^XWB(8994,2859,1,1,0)="Returns a list of entries in the NETWORK LOCATION file(#2005.2)."
^XWB(8994,2859,1,2,0)="The RPC will return each NETWORK LOCATION data along with its "
^XWB(8994,2859,1,3,0)="OPERATIONAL STATUS (offline/online), PHYSICAL REFERENCE, HASH SUBDIRECTORY,"
^XWB(8994,2859,1,4,0)="SITE, PLACE info ...etc."
^XWB(8994,2859,2,0)="^8994.02A^1^1"
