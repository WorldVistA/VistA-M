^XWB(8994,4047,2,1,0)="BKIEN^1^10^1^1"
^XWB(8994,4047,2,1,1,0)="^^3^3^3140528^"
^XWB(8994,4047,2,1,1,1,0)="BKIEN"
^XWB(8994,4047,2,1,1,2,0)=" "
^XWB(8994,4047,2,1,1,3,0)="IEN to the bulk-edit session to cancel"
^XWB(8994,4047,2,2,0)="FORCE^1^1^0^2"
^XWB(8994,4047,2,2,1,0)="^^4^4^3140528^"
^XWB(8994,4047,2,2,1,1,0)="FORCE"
^XWB(8994,4047,2,2,1,2,0)=" "
