^XWB(8994,4236,1,4,0)="  DSSOVND - Field #4 Vendor (pointer to file 440 - required)"
^XWB(8994,4236,1,5,0)="  DSSOIFO - Field #7.1 IFCAP Order (pointer to file 442 - required)"
^XWB(8994,4236,1,6,0)="  DSSOPCR - Field #7.5 Purchase Card Reference (required)"
^XWB(8994,4236,1,7,0)="  DSSOINI - Field #10 Initiator (purchasing agent DUZ)"
^XWB(8994,4236,1,8,0)="  DSSOSHP - Field #11 Est Shipping Charge (0-999999, two decimals)"
^XWB(8994,4236,1,9,0)="  DSSODIS - Field #17 Percent Discount (1-99, one decimal)"
^XWB(8994,4236,1,10,0)="  DSSOSNM - Field #18 Station Name (pointer to file 4 - required)"
^XWB(8994,4236,1,11,0)="  DSSODEL - Field #19 Deliver To (3-30 characters)"
^XWB(8994,4236,1,12,0)="             ""PROSTHETICS"", ""VETERAN"", or ""OTHER LOCATION AT THIS SITE"""
^XWB(8994,4236,1,13,0)="  DSSODRQ - Field #20 Date Required"
^XWB(8994,4236,1,14,0)="  DSSODTM - Field #21 Delivery Time (1-99999, 0 decimals)"
^XWB(8994,4236,1,15,0)="  DSSOATN - Field #21.1 Deliver To Attention (1-45 characters)"
^XWB(8994,4236,1,16,0)="  DSSOPCN - Field #25 Purchase Card Number (16 digits - required)"
^XWB(8994,4236,1,17,0)="  DSSOAMT - Field #27 Est Amount (0-999999, two decimals)"
^XWB(8994,4236,1,18,0)="  DSSOWO  - Field #24 2529-3 (pointer to file 664.1) "
^XWB(8994,4236,1,19,0)=" "
^XWB(8994,4236,1,20,0)="Fields also stored are:"
