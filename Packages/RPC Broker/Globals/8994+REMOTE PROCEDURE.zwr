^XWB(8994,4157,3,0)="^8994.03^1^1^3170531^^"
^XWB(8994,4157,3,1,0)="DSIYRET(IEN)=IEN^Vendor Name"
^XWB(8994,4158,0)="DSIYUT10 STATFILT^STATFILT^DSIYUT10^1"
^XWB(8994,4158,1,0)="^8994.01^2^2^3170518^^^^"
^XWB(8994,4158,1,1,0)="THIS RPC SETS A FLAG FOR EQUIPMENT RELATED RPCS IN ABOVE PAR TO FILTER BY "
^XWB(8994,4158,1,2,0)="STATION."
^XWB(8994,4158,2,0)="^8994.02A^1^1"
^XWB(8994,4158,2,1,0)="SET^1^1^0^1"
^XWB(8994,4158,2,1,1,0)="^^3^3^3170518^"
^XWB(8994,4158,2,1,1,1,0)=" ; SET - 1 TURN ON FILTERING"
^XWB(8994,4158,2,1,1,2,0)=" ;     - 0 TURN OFF FILTERING"
^XWB(8994,4158,2,1,1,3,0)=" ;     - NULL - RETURN CURRENT VALUE, DON'T SET ANYTHING."
^XWB(8994,4158,2,"B","SET",1)=""
^XWB(8994,4158,2,"PARAMSEQ",1,1)=""
^XWB(8994,4158,3,0)="^^3^3^3170518^"
^XWB(8994,4158,3,1,0)=" ; RET 0 - FILTER IS OFF"
^XWB(8994,4158,3,2,0)=" ;     1 - FILTER IS ON"
^XWB(8994,4158,3,3,0)=" ;    -1 - ERROR"
^XWB(8994,4159,0)="DSIYUT10 ALLOFF^ALLOFF^DSIYUT10^1"
^XWB(8994,4159,1,0)="^^1^1^3170518^"
^XWB(8994,4159,1,1,0)="TURN OFF FILTERS FOR ALL DSIY USERS"
^XWB(8994,4159,3,0)="^^2^2^3170518^"
^XWB(8994,4159,3,1,0)="1 - SUCCESS"
^XWB(8994,4159,3,2,0)="-1 - ERROR"
^XWB(8994,4160,0)="DSIYV04 CHKDUP^CHKDUP^DSIYV04^2"
^XWB(8994,4160,1,0)="^8994.01^7^7^3170703^^^"
^XWB(8994,4160,1,1,0)="Returns a list of vendors which are potential duplicates with the entry "
^XWB(8994,4160,1,2,0)="that the user is adding as a new vendor.  It compares the vendor name and "
^XWB(8994,4160,1,3,0)="taxid using the B and D cross-reference of the file.  One of the "
^XWB(8994,4160,1,4,0)="parameters can be null, but not both.  It expects that at least 3 "
^XWB(8994,4160,1,5,0)="characters are entered for the vendor name.  If more than 10 characters "
^XWB(8994,4160,1,6,0)="are entered on the name, it looks for matches with the first 10 "
^XWB(8994,4160,1,7,0)="characters."
^XWB(8994,4160,2,0)="^8994.02A^2^2"
^XWB(8994,4160,2,1,0)="TAXID^1^20^0^1"
^XWB(8994,4160,2,1,1,0)="^^2^2^3170628^"
^XWB(8994,4160,2,1,1,1,0)="The value which the user has entered for the TAXID/SSN.  This will be "
^XWB(8994,4160,2,1,1,2,0)="compared against the FMS VENDOR CODE using the D cross-referece."
^XWB(8994,4160,2,2,0)="NAME^1^36^0^2"
^XWB(8994,4160,2,2,1,0)="^8994.021^3^3^3170703^^^"
^XWB(8994,4160,2,2,1,1,0)="The value that the user has entered for the NAME.  When matching with the "
^XWB(8994,4160,2,2,1,2,0)="B cross-reference, punctuation is removed and only the first 10 "
^XWB(8994,4160,2,2,1,3,0)="characters are used for matches."
^XWB(8994,4160,2,"B","NAME",2)=""
^XWB(8994,4160,2,"B","TAXID",1)=""
^XWB(8994,4160,2,"PARAMSEQ",1,1)=""
^XWB(8994,4160,2,"PARAMSEQ",2,2)=""
^XWB(8994,4160,3,0)="^8994.03^2^2^3170703^^"
^XWB(8994,4160,3,1,0)="DSIYRET(IEN)=IEN^TAXID^NAME - local array"
^XWB(8994,4160,3,2,0)="DSIYRET(1)=0^No potential duplicates found"
^XWB(8994,4161,0)="DSIYV04 SENDVRQ^SENDVRQ^DSIYV04^1"
^XWB(8994,4161,1,0)="^^7^7^3170629^"
^XWB(8994,4161,1,1,0)="Queues a new or edited vendor record to be sent to Austin when a change "
^XWB(8994,4161,1,2,0)="has been made to the record.  This rpc is called under the following "
^XWB(8994,4161,1,3,0)="conditions:"
^XWB(8994,4161,1,4,0)="   1. FISCAL REVIEW OF FMS is 'N'"
^XWB(8994,4161,1,5,0)="   2. All fields required for FMS are entered"
^XWB(8994,4161,1,6,0)="   3. There is a change requiring an FMS transaction"
^XWB(8994,4161,1,7,0)="   4. The user has responding 'Y' to the 'Send a VRQ' question"
^XWB(8994,4161,2,0)="^8994.02A^2^2"
^XWB(8994,4161,2,1,0)="IEN^1^20^1^1"
^XWB(8994,4161,2,1,1,0)="^^1^1^3170629^"
^XWB(8994,4161,2,1,1,1,0)="The internal number of the vendor being added or edited.  VENDOR file #440"
^XWB(8994,4161,2,2,0)="STN^1^20^1^2"
^XWB(8994,4161,2,2,1,0)="^^1^1^3170629^"
^XWB(8994,4161,2,2,1,1,0)="The station number"
^XWB(8994,4161,2,"B","IEN",1)=""
^XWB(8994,4161,2,"B","STN",2)=""
^XWB(8994,4161,2,"PARAMSEQ",1,1)=""
^XWB(8994,4161,2,"PARAMSEQ",2,2)=""
^XWB(8994,4161,3,0)="^^5^5^3170629^"
^XWB(8994,4161,3,1,0)="Indicates whether the vendor request queueing was successful or not."
^XWB(8994,4161,3,2,0)=" "
^XWB(8994,4161,3,3,0)="Either:"
^XWB(8994,4161,3,4,0)="   1^Creating the FMS VENDOR REQUEST"
^XWB(8994,4161,3,5,0)="   0^Unable to create the FMS VENDOR REQUEST"
^XWB(8994,4162,0)="DSIYACCR ACCESS REPORT^ACCRPT^DSIYACCR^4^^^^1"
^XWB(8994,4162,1,0)="^8994.01^2^2^3170629^^"
^XWB(8994,4162,1,1,0)="Schedules a report consisting of dates selected for a list of when a "
^XWB(8994,4162,1,2,0)="given user or all users accessed Above PAR."
^XWB(8994,4162,2,0)="^8994.02A^5^5"
^XWB(8994,4162,2,1,0)="FROMDT^1^14^1^1"
^XWB(8994,4162,2,1,1,0)="^8994.021^1^1^3170628^^"
^XWB(8994,4162,2,1,1,1,0)="Start date to look for when a user accessed Above PAR."
^XWB(8994,4162,2,2,0)="TODT^1^14^1^2"
^XWB(8994,4162,2,2,1,0)="^8994.021^1^1^3170628^^^"
^XWB(8994,4162,2,2,1,1,0)="End date to look for when a user accessed Above PAR."
^XWB(8994,4162,2,3,0)="USER^1^^0^3"
^XWB(8994,4162,2,3,1,0)="^^3^3^3170626^"
^XWB(8994,4162,2,3,1,1,0)="IEN of user from the DSIY USER FILE (#19685.9001). If blank or if"
^XWB(8994,4162,2,3,1,2,0)="""ALL"" is entered, will return entries within the date range for all Above"
^XWB(8994,4162,2,3,1,3,0)="PAR users."
