^XWB(8994,5124,1,2,0)="address, and it also allows the deletion and/or deactivation of a "
^XWB(8994,5124,1,3,0)="patient's temporary address."
^XWB(8994,5124,1,4,0)=" "
^XWB(8994,5124,1,5,0)="Can only be invoked by Acheron."
^XWB(8994,5124,2,0)="^8994.02A^2^2"
^XWB(8994,5124,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,5124,2,1,1,0)="^8994.021^11^11^3250218^^^"
^XWB(8994,5124,2,1,1,1,0)="  SDCONTEXT(""ACHERON AUDIT ID"")"
^XWB(8994,5124,2,1,1,2,0)="   - Up to 40 Character unique ID number. "
^XWB(8994,5124,2,1,1,3,0)="   - Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5124,2,1,1,4,0)="  SDCONTEXT(""USER DUZ"")"
^XWB(8994,5124,2,1,1,5,0)="   - The DUZ of the user taking action in the calling application."
^XWB(8994,5124,2,1,1,6,0)="  SDCONTEXT(""USER SECID"")"
^XWB(8994,5124,2,1,1,7,0)="   - The SECID of the user taking action in the calling application."
^XWB(8994,5124,2,1,1,8,0)="  SDCONTEXT(""PATIENT DFN"")"
^XWB(8994,5124,2,1,1,9,0)="   - The DFN/IEN of the target patient from the calling application."
^XWB(8994,5124,2,1,1,10,0)="  SDCONTEXT(""PATIENT ICN"")"
^XWB(8994,5124,2,1,1,11,0)="   - The ICN of the target patient from the calling application."
^XWB(8994,5124,2,2,0)="TEMPADDRESS^2^32000^1^2"
^XWB(8994,5124,2,2,1,0)="^^14^14^3250219^"
^XWB(8994,5124,2,2,1,1,0)=" TEMPADDRESS(""PATIENT IEN"")       REQ"
^XWB(8994,5124,2,2,1,2,0)=" TEMPADDRESS(""ACTIVE FLAG"")       REQ"
^XWB(8994,5124,2,2,1,3,0)=" TEMPADDRESS(""DELETE FLAG"")       OPT (Defaults to False)"
^XWB(8994,5124,2,2,1,4,0)=" TEMPADDRESS(""STREET LINE ONE"")   OPT (Required if Active Flag is True)"
^XWB(8994,5124,2,2,1,5,0)=" TEMPADDRESS(""STREET LINE TWO"")   OPT"
^XWB(8994,5124,2,2,1,6,0)=" TEMPADDRESS(""STREET LINE THREE"") OPT"
^XWB(8994,5124,2,2,1,7,0)=" TEMPADDRESS(""ZIP CODE"")          OPT (Required if Active Flag is True)"
^XWB(8994,5124,2,2,1,8,0)=" TEMPADDRESS(""CITY"")              OPT (Required if Active Flag is True)"
^XWB(8994,5124,2,2,1,9,0)=" TEMPADDRESS(""STATE"")             OPT (Required if Active Flag is True)"
^XWB(8994,5124,2,2,1,10,0)=" TEMPADDRESS(""COUNTY"")            OPT"
^XWB(8994,5124,2,2,1,11,0)=" TEMPADDRESS(""COUNTRY"")           OPT (Required if Active Flag is True)"
^XWB(8994,5124,2,2,1,12,0)=" TEMPADDRESS(""PHONE"")             OPT"
^XWB(8994,5124,2,2,1,13,0)=" TEMPADDRESS(""START DATE"")        OPT (Required if Active Flag is True) "
^XWB(8994,5124,2,2,1,14,0)=" TEMPADDRESS(""END DATE"")          OPT"
