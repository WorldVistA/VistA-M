^XWB(8994,5016,0)="SDES2 BLOCK AND MOVE^BLOCKANDMOVE^SDES2BLOCKANDMOV^2^R^^^0^^^1"
^XWB(8994,5016,1,0)="^8994.01^5^5^3250213^"
^XWB(8994,5016,1,1,0)="This RPC allows the user to block and move an appointment. This will "
^XWB(8994,5016,1,2,0)="block the availability in the slot the appointment was originally in and "
^XWB(8994,5016,1,3,0)="move it to a new clinic."
^XWB(8994,5016,1,4,0)=" "
^XWB(8994,5016,1,5,0)="Can only be invoked by Acheron"
^XWB(8994,5016,2,0)="^8994.02A^2^2"
^XWB(8994,5016,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,5016,2,1,1,0)="^^10^10^3240617^"
^XWB(8994,5016,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,5016,2,1,1,2,0)="                          Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5016,2,1,1,3,0)="SDCONTEXT(""USER DUZ"")   = The DUZ of the user taking action on the"
^XWB(8994,5016,2,1,1,4,0)="                          calling application. "
^XWB(8994,5016,2,1,1,5,0)="SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,5016,2,1,1,6,0)="                          calling application."
^XWB(8994,5016,2,1,1,7,0)="SDCONTEXT(""PATIENT DFN"")= The name of the patient taking action on the"
^XWB(8994,5016,2,1,1,8,0)="                          calling application."
^XWB(8994,5016,2,1,1,9,0)="SDCONTEXT(""PATIENT ICN"")= The ICN of the patient taking action on the"
^XWB(8994,5016,2,1,1,10,0)="                          calling application."
^XWB(8994,5016,2,2,0)="BLOCKANDMOVE^2^32000^1^2"
^XWB(8994,5016,2,2,1,0)="^8994.021^10^10^3250213^^"
^XWB(8994,5016,2,2,1,1,0)="This array contains the input parameters that are to be passed into block "
^XWB(8994,5016,2,2,1,2,0)="and move."
^XWB(8994,5016,2,2,1,3,0)="  "
^XWB(8994,5016,2,2,1,4,0)="BLOCKANDMOVE(""APPOINTMENT IEN"")= IEN of the Appointment to move from"
^XWB(8994,5016,2,2,1,5,0)="                                 SDEC APPOINTMENT File (#409.84)"
^XWB(8994,5016,2,2,1,6,0)="BLOCKANDMOVE(""TARGET CLINIC"")= The target clinic to that will get the"
^XWB(8994,5016,2,2,1,7,0)="                               moved appointment. This is the IEN"
^XWB(8994,5016,2,2,1,8,0)="                               from HOSPITAL LOCATION File (#44)"
^XWB(8994,5016,2,2,1,9,0)="BLOCKANDMOVE(""TARGET DATE TIME"")= The date and time of the target"
^XWB(8994,5016,2,2,1,10,0)="                                  appointment in ISO date/time format"
^XWB(8994,5016,2,"B","BLOCKANDMOVE",2)=""
^XWB(8994,5016,2,"B","SDCONTEXT",1)=""
^XWB(8994,5016,2,"PARAMSEQ",1,1)=""
^XWB(8994,5016,2,"PARAMSEQ",2,2)=""
^XWB(8994,5016,3,0)="^8994.03^5^5^3250213^^^^"
