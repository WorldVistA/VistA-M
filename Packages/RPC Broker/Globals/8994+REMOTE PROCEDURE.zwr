^XWB(8994,2536,3,7,0)="RESULT(3)=""IBPOLDA^""_IBPOLDA"
^XWB(8994,2537,0)="DSIV ADD BUFFER ENTRY^ADDBUF^DSIVIC^1^P"
^XWB(8994,2537,1,0)="^8994.01^1^1^3070820^^"
^XWB(8994,2537,1,1,0)="Adds a new entry to the INSURANCE BUFFER file #355.33."
^XWB(8994,2537,2,0)="^8994.02A^4^4"
^XWB(8994,2537,2,1,0)="DFN^1^20^1^1"
^XWB(8994,2537,2,1,1,0)="^^1^1^3041214^"
^XWB(8994,2537,2,1,1,1,0)="Patient internal entry number."
^XWB(8994,2537,2,2,0)="TYPE^1^1^0^2"
^XWB(8994,2537,2,2,1,0)="^^1^1^3041214^"
^XWB(8994,2537,2,2,1,1,0)="""M"" for Medicare, ""X"" for all other insurance (default)."
^XWB(8994,2537,2,3,0)="INSCO^1^30^0^3"
^XWB(8994,2537,2,3,1,0)="^8994.021^2^2^3041214^^"
^XWB(8994,2537,2,3,1,1,0)="Insurance company name.  Required for non-Medicare insurance."
^XWB(8994,2537,2,3,1,2,0)="Not required for Medicare type."
^XWB(8994,2537,2,4,0)="DATA^2^80^1^4"
^XWB(8994,2537,2,4,1,0)="^8994.021^5^5^3070820^^"
^XWB(8994,2537,2,4,1,1,0)="Array of keyword^value pairs for Medicare type entry or"
^XWB(8994,2537,2,4,1,2,0)="Field number^value pairs for other insurance type entries."
^XWB(8994,2537,2,4,1,3,0)="For example, SOURCE is a required value.  For non-Medicare"
^XWB(8994,2537,2,4,1,4,0)="entries this could be specified as DATA(1)="".03^1"", meaning"
^XWB(8994,2537,2,4,1,5,0)="source=interview."
