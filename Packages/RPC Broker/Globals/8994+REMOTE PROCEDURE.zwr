^XWB(8994,5036,0)="SDES2 SEARCH RECALL PROVIDERS^RECPROVSEARCH^SDES2RECPRVSRCH^2^R^^^^^^1"
^XWB(8994,5036,1,0)="^^6^6^3250214^"
^XWB(8994,5036,1,1,0)="This RPC allows users to search a recall provider's name either partially"
^XWB(8994,5036,1,2,0)="or fully. The RPC will perform a search that matches the search criteria"
^XWB(8994,5036,1,3,0)="(3-35 characters), and then, retrieves and returns a list of ACTIVE "
^XWB(8994,5036,1,4,0)="Recall Providers."
^XWB(8994,5036,1,5,0)=" "
^XWB(8994,5036,1,6,0)="Can only be invoked by Acheron"
^XWB(8994,5036,2,0)="^8994.02A^2^2"
^XWB(8994,5036,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,5036,2,1,1,0)="^^10^10^3240613^"
^XWB(8994,5036,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,5036,2,1,1,2,0)="                           Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5036,2,1,1,3,0)="SDCONTEXT(""USER DUZ"")   = The DUZ of the user taking action on the"
^XWB(8994,5036,2,1,1,4,0)="                           calling application. "
^XWB(8994,5036,2,1,1,5,0)="SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,5036,2,1,1,6,0)="                           calling application."
^XWB(8994,5036,2,1,1,7,0)="SDCONTEXT(""PATIENT DFN"")= The name of the patient taking action on the"
^XWB(8994,5036,2,1,1,8,0)="                           calling application."
^XWB(8994,5036,2,1,1,9,0)="SDCONTEXT(""PATIENT ICN"")= The ICN of the patient taking action on the"
^XWB(8994,5036,2,1,1,10,0)="                           calling application."
^XWB(8994,5036,2,2,0)="SDINPUT^2^32000^1^2"
^XWB(8994,5036,2,2,1,0)="^8994.021^4^4^3250214^^"
^XWB(8994,5036,2,2,1,1,0)="SDINPUT(""SEARCHSTRING"") = ""search string"" (required)"
^XWB(8994,5036,2,2,1,2,0)=" "
^XWB(8994,5036,2,2,1,3,0)="Search string in SDINPUT(""SEARCHSTRING"") must be between 3 and 35"
^XWB(8994,5036,2,2,1,4,0)="characters."
^XWB(8994,5036,2,"B","SDCONTEXT",1)=""
^XWB(8994,5036,2,"B","SDINPUT",2)=""
^XWB(8994,5036,2,"PARAMSEQ",1,1)=""
^XWB(8994,5036,2,"PARAMSEQ",2,2)=""
^XWB(8994,5036,3,0)="^8994.03^37^37^3250214^^"
^XWB(8994,5036,3,1,0)="List of Recall Providers in JSON format."
^XWB(8994,5036,3,2,0)="  "
^XWB(8994,5036,3,3,0)=" {"
^XWB(8994,5036,3,4,0)="         ""Provider"": ["
^XWB(8994,5036,3,5,0)="                 {"
^XWB(8994,5036,3,6,0)="                         ""CommercialPhone"": """","
^XWB(8994,5036,3,7,0)="                         ""DigitalPager"": """","
^XWB(8994,5036,3,8,0)="                         ""Email"": """","
^XWB(8994,5036,3,9,0)="                         ""Fax"": """","
^XWB(8994,5036,3,10,0)="                         ""Homephone"": """","
