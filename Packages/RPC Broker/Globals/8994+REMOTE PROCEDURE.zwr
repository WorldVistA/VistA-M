^XWB(8994,3325,3,0)="^8994.03^1^1^3150106^^^^"
^XWB(8994,3325,3,1,0)="Returns a 1 when completed"
^XWB(8994,3326,0)="DSIV ACTIVE USER^ACT^DSIVDUZ^1^A"
^XWB(8994,3326,1,0)="^^2^2^3131001^"
^XWB(8994,3326,1,1,0)="This will determine if a user (DUZ value) is valid and is active.  Also,"
^XWB(8994,3326,1,2,0)=" additionally screening logic can be passed in to validate a user."
^XWB(8994,3326,2,0)="^8994.02A^2^2"
^XWB(8994,3326,2,1,0)="XDUZ^1^15^1^1"
^XWB(8994,3326,2,1,1,0)="^^1^1^3131001^"
^XWB(8994,3326,2,1,1,1,0)="This is a pointer value to the NEW PERSON file."
^XWB(8994,3326,2,2,0)="DSISCR^2^250^0^2"
^XWB(8994,3326,2,2,1,0)="^^9^9^3131001^"
^XWB(8994,3326,2,2,1,1,0)="You may pass additional screening criteria to be checked.  For a user to"
^XWB(8994,3326,2,2,1,2,0)=" be returned, all screening criteria must be true in addition to being"
^XWB(8994,3326,2,2,1,3,0)=" Active."
^XWB(8994,3326,2,2,1,4,0)=" "
^XWB(8994,3326,2,2,1,5,0)=" Allowable formats of DSISCR(n) = flag^val1^val2^val3^.."
^XWB(8994,3326,2,2,1,6,0)="   check for security key    KEY^security key name"
^XWB(8994,3326,2,2,1,7,0)="   check for parameter       PARM^ parameter name^parameter instance"
^XWB(8994,3326,2,2,1,8,0)="   execute M code"
^XWB(8994,3326,2,2,1,9,0)="     M^<return message>^<executable M code which sets $T>"
^XWB(8994,3326,2,"B","DSISCR",2)=""
^XWB(8994,3326,2,"B","XDUZ",1)=""
^XWB(8994,3326,2,"PARAMSEQ",1,1)=""
^XWB(8994,3326,2,"PARAMSEQ",2,2)=""
^XWB(8994,3326,3,0)="^^2^2^3131001^"
^XWB(8994,3326,3,1,0)="If user isf found and is active, then return the user's DUZ value."
^XWB(8994,3326,3,2,0)=" Else return -1^message."
^XWB(8994,3327,0)="DSIV XPAR GET VALUE^GET1^DSIVXPR^1^A^^^1"
^XWB(8994,3327,1,0)="^8994.01^1^1^3030422^^^^"
^XWB(8994,3327,1,1,0)="This will return the value of a single entity/param/instance"
^XWB(8994,3327,2,0)="^8994.02A^1^1"
^XWB(8994,3327,2,1,0)="DATA^1^250^1^1"
^XWB(8994,3327,2,1,1,0)="^^9^9^3030422^"
^XWB(8994,3327,2,1,1,1,0)="DATA - required - p1~p2~p3~~~p6"
^XWB(8994,3327,2,1,1,2,0)=" p1 := optional - entity - if not passed, set to ""USR"" for"
^XWB(8994,3327,2,1,1,3,0)="                  current user"
^XWB(8994,3327,2,1,1,4,0)=" p2 := required - parameter name"
^XWB(8994,3327,2,1,1,5,0)=" p3 := optional - instance"
^XWB(8994,3327,2,1,1,6,0)=" p6 := optional - format code determines return values"
^XWB(8994,3327,2,1,1,7,0)="       Q - internal value - [default]"
^XWB(8994,3327,2,1,1,8,0)="       E - external value"
^XWB(8994,3327,2,1,1,9,0)="       B - internal^external values"
^XWB(8994,3327,2,"B","DATA",1)=""
^XWB(8994,3327,2,"PARAMSEQ",1,1)=""
^XWB(8994,3327,3,0)="^8994.03^3^3^3030422^^^^"
^XWB(8994,3327,3,1,0)="If problem encountered getting value, return -1^error message"
^XWB(8994,3327,3,2,0)="Else return the value in the format requested for the"
^XWB(8994,3327,3,3,0)="entity/param/instance"
^XWB(8994,3328,0)="DSIV LOCK^LOCK^DSIVLOCK^1^A^^^1"
^XWB(8994,3328,1,0)="^^1^1^3131021^"
^XWB(8994,3328,1,1,0)="Lock or unlock a global reference from a GUI client"
^XWB(8994,3328,2,0)="^8994.02A^4^4"
^XWB(8994,3328,2,1,0)="REF^1^30^1^1"
^XWB(8994,3328,2,1,1,0)="^^1^1^3131021^"
^XWB(8994,3328,2,1,1,1,0)="FM file number or $NAME(global) to be locked"
^XWB(8994,3328,2,2,0)="IFN^1^30^0^2"
^XWB(8994,3328,2,2,1,0)="^^6^6^3131021^"
^XWB(8994,3328,2,2,1,1,0)="Required if REF is a file (or subfile) number"
^XWB(8994,3328,2,2,1,2,0)="If REF is the top level file number, then IFN is the"
^XWB(8994,3328,2,2,1,3,0)="  IEN of the record"
^XWB(8994,3328,2,2,1,4,0)="If REF is a subdictionary number for a multiple, then"
^XWB(8994,3328,2,2,1,5,0)="  IFN must be the appropriate IENS for that multiple"
^XWB(8994,3328,2,2,1,6,0)="  level"
^XWB(8994,3328,2,3,0)="FLAG^1^2^0^3"
^XWB(8994,3328,2,3,1,0)="^^5^5^3131021^"
^XWB(8994,3328,2,3,1,1,0)="Flag for locking or unlocking"
^XWB(8994,3328,2,3,1,2,0)="  1: Lock"
^XWB(8994,3328,2,3,1,3,0)=" -1: Unlock"
^XWB(8994,3328,2,3,1,4,0)=" "
^XWB(8994,3328,2,3,1,5,0)="Defaults to 1"
^XWB(8994,3328,2,4,0)="FUN^1^1^0^4"
^XWB(8994,3328,2,4,1,0)="^^4^4^3131021^"
^XWB(8994,3328,2,4,1,1,0)="Flag to indicate if the call is extrinsic or RPC"
^XWB(8994,3328,2,4,1,2,0)=" "
^XWB(8994,3328,2,4,1,3,0)="  1: Extrinsic"
^XWB(8994,3328,2,4,1,4,0)="  0: RPC"
^XWB(8994,3328,2,"B","FLAG",3)=""
^XWB(8994,3328,2,"B","FUN",4)=""
^XWB(8994,3328,2,"B","IFN",2)=""
^XWB(8994,3328,2,"B","REF",1)=""
^XWB(8994,3328,2,"PARAMSEQ",1,1)=""
^XWB(8994,3328,2,"PARAMSEQ",2,2)=""
^XWB(8994,3328,2,"PARAMSEQ",3,3)=""
^XWB(8994,3328,2,"PARAMSEQ",4,4)=""
^XWB(8994,3328,3,0)="^^5^5^3131021^"
^XWB(8994,3328,3,1,0)="Returns a boolean value."
^XWB(8994,3328,3,2,0)=" "
^XWB(8994,3328,3,3,0)="If successful, the return will be 1."
^XWB(8994,3328,3,4,0)=" "
^XWB(8994,3328,3,5,0)="If an error occurs, the return will be List[n] = -1^message."
^XWB(8994,3329,0)="DSIV SEND ALERT^SEND^DSIVXQA^1^A"
^XWB(8994,3329,1,0)="^^1^1^3131023^"
^XWB(8994,3329,1,1,0)="RPC to send a user a kernal alert"
^XWB(8994,3329,2,0)="^8994.02A^1^1"
^XWB(8994,3329,2,1,0)="DATA^2^^1^1"
^XWB(8994,3329,2,1,1,0)="^^40^40^3131023^"
^XWB(8994,3329,2,1,1,1,0)="DATA is a list which is expecting data in the following format:"
^XWB(8994,3329,2,1,1,2,0)=" "
^XWB(8994,3329,2,1,1,3,0)="DATA(sub) = value"
^XWB(8994,3329,2,1,1,4,0)="  subscript  required  value"
^XWB(8994,3329,2,1,1,5,0)="  ---------  --------  ---------------------------------------"
^XWB(8994,3329,2,1,1,6,0)="  XQAMSG        Y      message displayed to the user (80 char)"
^XWB(8994,3329,2,1,1,7,0)=" "
^XWB(8994,3329,2,1,1,8,0)="  XQAROU        N      tag^routine to be invoked"
^XWB(8994,3329,2,1,1,9,0)="                       if from RPC this must be silent"
^XWB(8994,3329,2,1,1,10,0)=" "
^XWB(8994,3329,2,1,1,11,0)="  XQAID         N      package identifier for alert"
^XWB(8994,3329,2,1,1,12,0)=" "
^XWB(8994,3329,2,1,1,13,0)="  XQADATA       N      an application specific data string"
^XWB(8994,3329,2,1,1,14,0)="     [the alert processor will set XQADATA equal to this and will"
^XWB(8994,3329,2,1,1,15,0)="      be available to M routine specified in XQAROU]"
^XWB(8994,3329,2,1,1,16,0)=" "
^XWB(8994,3329,2,1,1,17,0)="  XQAARCH       N      # days to keep in alert tracking file"
^XWB(8994,3329,2,1,1,18,0)=" "
^XWB(8994,3329,2,1,1,19,0)="  XQASURO       N      # days to wait before forwarding alert"
^XWB(8994,3329,2,1,1,20,0)="     [forwarded to recipient's Mailman's surrogates if unprocessed"
^XWB(8994,3329,2,1,1,21,0)="      by recipient]"
^XWB(8994,3329,2,1,1,22,0)=" "
^XWB(8994,3329,2,1,1,23,0)="  XQASUPV       N      supervisor forwarding"
^XWB(8994,3329,2,1,1,24,0)="     [# days to wait before forwarding to recipient's supervisor if"
^XWB(8994,3329,2,1,1,25,0)="      unprocessed by recipient.  SUPERVIOR = CHIEF field from file"
^XWB(8994,3329,2,1,1,26,0)="      49 corresponding to recipient's SERVICE/SECTION]"
^XWB(8994,3329,2,1,1,27,0)=" "
^XWB(8994,3329,2,1,1,28,0)="  DFN           N      pointer to PATIENT file"
^XWB(8994,3329,2,1,1,29,0)="     [used to construct XQAID so that it works properly in CPRS]"
^XWB(8994,3329,2,1,1,30,0)=" "
^XWB(8994,3329,2,1,1,31,0)="  PKG           N      namespace of calling app - default=VEJD"
^XWB(8994,3329,2,1,1,32,0)=" "
^XWB(8994,3329,2,1,1,33,0)="  Rn            Y      at least one must be defined - recipients of"
^XWB(8994,3329,2,1,1,34,0)="  R1,R2,R3,...          alert - can be pointer to NEW PERSON file"
^XWB(8994,3329,2,1,1,35,0)="                        or G.<name of mail group>"
^XWB(8994,3329,2,1,1,36,0)=" "
^XWB(8994,3329,2,1,1,37,0)=" Example of setup in the GUI:"
^XWB(8994,3329,2,1,1,38,0)="  Param.List['""XQAMSG""'] := text"
^XWB(8994,3329,2,1,1,39,0)="  Param.list['""R1""']     := duz of recipient"
^XWB(8994,3329,2,1,1,40,0)="  Param.List['""DFN""']    := pointer to PATIENT file"
^XWB(8994,3329,2,"B","DATA",1)=""
^XWB(8994,3329,2,"PARAMSEQ",1,1)=""
^XWB(8994,3329,3,0)="^^3^3^3131023^"
^XWB(8994,3329,3,1,0)="If the process is successful, a value of 1 is returned."
^XWB(8994,3329,3,2,0)=" "
^XWB(8994,3329,3,3,0)="If an error occurred, the value will be -1^message."
^XWB(8994,3330,0)="DSIV VA DEFAULT SITE^SITE^DSIVVA^1^A"
^XWB(8994,3330,1,0)="^8994.01^4^4^3131030^^"
^XWB(8994,3330,1,1,0)="This will return the name and station number for a medical center"
^XWB(8994,3330,1,2,0)="division.  Optional input parameters are allowed.  However, if not passed"
^XWB(8994,3330,1,3,0)="then return the data for the primary division (or institution) as of"
^XWB(8994,3330,1,4,0)="TODAY."
^XWB(8994,3330,2,0)="^8994.02A^2^2"
^XWB(8994,3330,2,1,0)="DIV^1^6^0^1"
^XWB(8994,3330,2,1,1,0)="^^2^2^3131028^"
^XWB(8994,3330,2,1,1,1,0)="This is a pointer to the medical center division file (#40.8).  If it is"
^XWB(8994,3330,2,1,1,2,0)="not passed then return data for the primary division as of that date."
^XWB(8994,3330,2,2,0)="DATE^1^7^0^2"
^XWB(8994,3330,2,2,1,0)="^^2^2^3131028^"
^XWB(8994,3330,2,2,1,1,0)="This optional Fileman date only will be used to return division data of"
^XWB(8994,3330,2,2,1,2,0)="that date.  Default value if not passed is TODAY."
^XWB(8994,3330,2,"B","DATE",2)=""
^XWB(8994,3330,2,"B","DIV",1)=""
^XWB(8994,3330,2,"PARAMSEQ",1,1)=""
^XWB(8994,3330,2,"PARAMSEQ",2,2)=""
^XWB(8994,3330,3,0)="^8994.03^8^8^3131030^^"
^XWB(8994,3330,3,1,0)="On error, return -1^error message"
^XWB(8994,3330,3,2,0)=" "
^XWB(8994,3330,3,3,0)="Else return p1^p2^p3^p4  where"
^XWB(8994,3330,3,4,0)="   p1 = pointer to Institution file (#4)"
^XWB(8994,3330,3,5,0)="   p2 = Institution file name"
^XWB(8994,3330,3,6,0)="   p3 = Station number"
^XWB(8994,3330,3,7,0)="   p4 = pointer to Medical Center Division file (#40.8) for that division"
^XWB(8994,3330,3,8,0)="        which was the primary division as of that date."
^XWB(8994,3331,0)="DSIV USER DEF DIV^DIV^DSIVDUZ^1^A"
^XWB(8994,3331,1,0)="^^8^8^3131030^"
^XWB(8994,3331,1,1,0)="This will return the default division for a user.  If no default is"
^XWB(8994,3331,1,2,0)="indicated in the DIVISION multiple, then the return value will be:"
^XWB(8994,3331,1,3,0)=" "
^XWB(8994,3331,1,4,0)="  1. if the user has only one division, and that division is not"
^XWB(8994,3331,1,5,0)="     explicitly marked as NO for default division, then return that"
^XWB(8994,3331,1,6,0)="     division"
^XWB(8994,3331,1,7,0)="  2. else, if the SITE parameter is passed with a value of 1, then"
^XWB(8994,3331,1,8,0)="     return the default value for the facility."
^XWB(8994,3331,2,0)="^8994.02A^2^2"
^XWB(8994,3331,2,1,0)="XDUZ^1^20^0^1"
^XWB(8994,3331,2,1,1,0)="^^2^2^3131030^"
^XWB(8994,3331,2,1,1,1,0)="This is the pointer to file 200 for the user for which to return the"
^XWB(8994,3331,2,1,1,2,0)="default division.  The default value is DUZ"
^XWB(8994,3331,2,2,0)="SITE^1^1^0^2"
^XWB(8994,3331,2,2,1,0)="^^3^3^3131030^"
^XWB(8994,3331,2,2,1,1,0)="This boolean flag (1 or 0) will be used if the user has no default"
^XWB(8994,3331,2,2,1,2,0)="division specified in the DIVISION multiple in file 200.  If no default"
^XWB(8994,3331,2,2,1,3,0)="division, then return the value from $$SITE^VASITE."
^XWB(8994,3331,2,"B","SITE",2)=""
^XWB(8994,3331,2,"B","XDUZ",1)=""
^XWB(8994,3331,2,"PARAMSEQ",1,1)=""
^XWB(8994,3331,2,"PARAMSEQ",2,2)=""
^XWB(8994,3331,3,0)="^^3^3^3131030^"
^XWB(8994,3331,3,1,0)="Return the default division for the user: "
^XWB(8994,3331,3,2,0)="  ien file 4 ^ institution name ^ institution station number"
^XWB(8994,3331,3,3,0)="  on error, or no default, return -1^message"
^XWB(8994,3332,0)="DSIV SEND MAIL MSG^SEND^DSIVXM^1^A"
^XWB(8994,3332,1,0)="^^1^1^3131030^"
^XWB(8994,3332,1,1,0)="This will send a Mailman message"
^XWB(8994,3332,2,0)="^8994.02A^1^1"
^XWB(8994,3332,2,1,0)="ARR^2^250^1^1"
^XWB(8994,3332,2,1,1,0)="^^46^46^3131030^"
^XWB(8994,3332,2,1,1,1,0)="This array contains all the data needed to invoke Mailman's send a"
^XWB(8994,3332,2,1,1,2,0)="message API.  ARR format:  ARR(sub) = p1 ^ p2  where"
^XWB(8994,3332,2,1,1,3,0)="   sub = any subscript value [0,1,2,3,...]"
^XWB(8994,3332,2,1,1,4,0)="    p1 = parameter name indicating the mail api entity"
^XWB(8994,3332,2,1,1,5,0)="    p2 = the value of the parameter p1"
^XWB(8994,3332,2,1,1,6,0)=" "
^XWB(8994,3332,2,1,1,7,0)="           Req/"
^XWB(8994,3332,2,1,1,8,0)="   p1      Opt   p2 (and description)"
^XWB(8994,3332,2,1,1,9,0)="---------  ----  -------------------------------------------------------"
^XWB(8994,3332,2,1,1,10,0)=" FLAGS     opt   string of characters representing special instructions"
^XWB(8994,3332,2,1,1,11,0)="                  P := priority   I := informational only    X := closed"
^XWB(8994,3332,2,1,1,12,0)="                  C := confidential   R := confirm receipt"
^XWB(8994,3332,2,1,1,13,0)=" "
^XWB(8994,3332,2,1,1,14,0)=" FROM      opt   default to DUZ - sender of message"
^XWB(8994,3332,2,1,1,15,0)=" "
^XWB(8994,3332,2,1,1,16,0)="SELF BSKT  opt   if FROM=DUZ then this canbe the name of DUZ's mail"
^XWB(8994,3332,2,1,1,17,0)="                 basket to deliver the message [basket must already exist]"
^XWB(8994,3332,2,1,1,18,0)=" "
^XWB(8994,3332,2,1,1,19,0)=" VAPOR     opt   Fileman date.time for which thismessage should be deleted"
^XWB(8994,3332,2,1,1,20,0)="                 from recipient's mail baskets"
^XWB(8994,3332,2,1,1,21,0)=" "
^XWB(8994,3332,2,1,1,22,0)="  SUBJ     req   subject of the message [3-65 characters]"
^XWB(8994,3332,2,1,1,23,0)=" "
^XWB(8994,3332,2,1,1,24,0)=" NOTME     opt   if this equals 1, then DO NOT include user DUZ as a"
^XWB(8994,3332,2,1,1,25,0)="                 recipient. Otherwise DUZ will always be a recipient even"
^XWB(8994,3332,2,1,1,26,0)="                 if they are not included in the recipient list"
^XWB(8994,3332,2,1,1,27,0)=" "
^XWB(8994,3332,2,1,1,28,0)="   REC     opt   this is only optional if the mail message will include"
^XWB(8994,3332,2,1,1,29,0)="                 DUZ as a recipient.  These are the recipients of the"
^XWB(8994,3332,2,1,1,30,0)="                 message.   Acceptable values are:"
^XWB(8994,3332,2,1,1,31,0)="                     DUZ number"
^XWB(8994,3332,2,1,1,32,0)="                     G.mail group name"
^XWB(8994,3332,2,1,1,33,0)="                     D.VistA device name"
^XWB(8994,3332,2,1,1,34,0)="                     S.server name"
^XWB(8994,3332,2,1,1,35,0)="                 For DUZ and mail group recipients there are additional"
^XWB(8994,3332,2,1,1,36,0)="                 parameters you can use as prefixes to the recipient:"
^XWB(8994,3332,2,1,1,37,0)="                     I: - indicate this recipient is informational only"
^XWB(8994,3332,2,1,1,38,0)="                     C: - indicate that this recipient is carbon copy (cc)"
^XWB(8994,3332,2,1,1,39,0)="                     L@Fileman_date.time: - deliver this message to this"
^XWB(8994,3332,2,1,1,40,0)="                       recipient at the specified date.time"
^XWB(8994,3332,2,1,1,41,0)="                 Examples: for user 1301 -   I:1301"
^XWB(8994,3332,2,1,1,42,0)="                           C:G.IRM STAFF"
^XWB(8994,3332,2,1,1,43,0)="                           IL@3021224.23:G.MCCR"
^XWB(8994,3332,2,1,1,44,0)=" "
^XWB(8994,3332,2,1,1,45,0)="  TEXT     req   text of message.  Each line of text will be a separate"
^XWB(8994,3332,2,1,1,46,0)="                 ARR(sub) entry.  No line should exceed 80 characters."
^XWB(8994,3332,2,"B","ARR",1)=""
^XWB(8994,3332,2,"PARAMSEQ",1,1)=""
^XWB(8994,3332,3,0)="^^2^2^3131030^"
^XWB(8994,3332,3,1,0)="If the message is successfully created, return the mail message number"
^XWB(8994,3332,3,2,0)="Else return -1^error message"
^XWB(8994,3333,0)="DSIV XPAR ADD^ADD^DSIVXPR^1^A^^^1"
^XWB(8994,3333,1,0)="^8994.01^1^1^3160427^^^^"
^XWB(8994,3333,1,1,0)="This is used to add a new parameter value for an entity."
^XWB(8994,3333,2,0)="^8994.02A^1^1"
^XWB(8994,3333,2,1,0)="DATA^1^250^1^1"
^XWB(8994,3333,2,1,1,0)="^8994.021^7^7^3160427^^"
^XWB(8994,3333,2,1,1,1,0)="This string has different pieces for adding a new parameter for an entity"
^XWB(8994,3333,2,1,1,2,0)="DATA - required - p1~p2~p3~p4"
^XWB(8994,3333,2,1,1,3,0)=" p1 := optional - entity(s) - if not passed, set to ""USR"" for"
^XWB(8994,3333,2,1,1,4,0)="                  current user"
^XWB(8994,3333,2,1,1,5,0)=" p2 := required - parameter name"
^XWB(8994,3333,2,1,1,6,0)=" p3 := optional - instance"
^XWB(8994,3333,2,1,1,7,0)=" p4 := required - value - see XPAR documentation"
^XWB(8994,3333,2,"B","DATA",1)=""
^XWB(8994,3333,2,"PARAMSEQ",1,1)=""
^XWB(8994,3333,3,0)="^8994.03^2^2^3160427^^^^"
^XWB(8994,3333,3,1,0)="If the parameter is successfully added, return 1"
^XWB(8994,3333,3,2,0)="Else return -1^error message"
^XWB(8994,3334,0)="DSIV XPAR ADD WP^ADDWP^DSIVXPR^1^A^^^1"
^XWB(8994,3334,1,0)="^8994.01^2^2^3160427^^^^"
^XWB(8994,3334,1,1,0)="This RPC will allow the addition of a new Word-processing type system "
^XWB(8994,3334,1,2,0)="parameter."
^XWB(8994,3334,2,0)="^8994.02A^2^2"
^XWB(8994,3334,2,1,0)="DATA^1^250^1^1"
^XWB(8994,3334,2,1,1,0)="^8994.021^6^6^3070116^^"
^XWB(8994,3334,2,1,1,1,0)="DATA - required - p1~p2~p3"
^XWB(8994,3334,2,1,1,2,0)="  p1 := optional - entity - if not passed, defaults to SYS for current "
^XWB(8994,3334,2,1,1,3,0)="                            user."
^XWB(8994,3334,2,1,1,4,0)=" "
^XWB(8994,3334,2,1,1,5,0)="  p2 := required - parameter name"
^XWB(8994,3334,2,1,1,6,0)="  p3 := optional - instance (defaults to 1)"
^XWB(8994,3334,2,2,0)="ARRAY^2^250^1^2"
^XWB(8994,3334,2,2,1,0)="^8994.021^7^7^3160427^^"
^XWB(8994,3334,2,2,1,1,0)="Array of text to add to the parameter where:"
^XWB(8994,3334,2,2,1,2,0)=" "
^XWB(8994,3334,2,2,1,3,0)="  ARRAY(0) = 1st line of text"
^XWB(8994,3334,2,2,1,4,0)="  ARRAY(1) = 2nd line of text"
^XWB(8994,3334,2,2,1,5,0)="  ARRAY(n) = nth line of text"
^XWB(8994,3334,2,2,1,6,0)=" "
^XWB(8994,3334,2,2,1,7,0)=" ARRAY(n)="""" to store blank lines of text, such as paragraph separation."
^XWB(8994,3334,2,"B","ARRAY",2)=""
^XWB(8994,3334,2,"B","DATA",1)=""
^XWB(8994,3334,2,"PARAMSEQ",1,1)=""
^XWB(8994,3334,2,"PARAMSEQ",2,2)=""
^XWB(8994,3334,3,0)="^8994.03^6^6^3160427^^"
^XWB(8994,3334,3,1,0)="RET= Code^Description"
^XWB(8994,3334,3,2,0)=" "
^XWB(8994,3334,3,3,0)="where:"
^XWB(8994,3334,3,4,0)=" "
^XWB(8994,3334,3,5,0)="1^Parameter added successfully = success"
^XWB(8994,3334,3,6,0)="-1^Error Message = indicates failure and reason for failure."
^XWB(8994,3335,0)="DSIV XPAR DEL ALL^DELALL^DSIVXPR^1^A^^^1"
^XWB(8994,3335,1,0)="^8994.01^2^2^3030422^^^^"
^XWB(8994,3335,1,1,0)="This is used to delete the value for all instances of a parameter for a "
^XWB(8994,3335,1,2,0)="given entity"
^XWB(8994,3335,2,0)="^8994.02A^1^1"
^XWB(8994,3335,2,1,0)="DATA^1^250^1^1"
^XWB(8994,3335,2,1,1,0)="^^4^4^3030422^"
^XWB(8994,3335,2,1,1,1,0)="DATA - required - p1~p2"
^XWB(8994,3335,2,1,1,2,0)=" p1 := optional - entity(s) - if not passed, set to ""USR"" for"
^XWB(8994,3335,2,1,1,3,0)="                  current user"
^XWB(8994,3335,2,1,1,4,0)=" p2 := required - parameter name"
^XWB(8994,3335,2,"B","DATA",1)=""
^XWB(8994,3335,2,"PARAMSEQ",1,1)=""
^XWB(8994,3335,3,0)="^8994.03^2^2^3030422^^^^"
^XWB(8994,3335,3,1,0)="If the parameter(s) are successfully deleted, return 1"
^XWB(8994,3335,3,2,0)="Else return -1^error message"
^XWB(8994,3336,0)="DSIV XPAR DEL^DEL^DSIVXPR^1^A^^^1"
^XWB(8994,3336,1,0)="^^1^1^3030422^"
^XWB(8994,3336,1,1,0)="Delete an existing parameter for an entity for a specific instance"
^XWB(8994,3336,2,0)="^8994.02A^1^1"
^XWB(8994,3336,2,1,0)="DATA^1^250^1^1"
^XWB(8994,3336,2,1,1,0)="^^5^5^3030422^"
^XWB(8994,3336,2,1,1,1,0)="DATA - required - p1~p2~p3~p4"
^XWB(8994,3336,2,1,1,2,0)=" p1 := optional - entity(s) - if not passed, set to ""USR"" for"
^XWB(8994,3336,2,1,1,3,0)="                  current user"
^XWB(8994,3336,2,1,1,4,0)=" p2 := required - parameter name"
^XWB(8994,3336,2,1,1,5,0)=" p3 := optional - instance"
^XWB(8994,3336,2,"B","DATA",1)=""
^XWB(8994,3336,2,"PARAMSEQ",1,1)=""
^XWB(8994,3336,3,0)="^8994.03^2^2^3030422^^^^"
^XWB(8994,3336,3,1,0)="If the parameter is successfully deleted, return 1"
^XWB(8994,3336,3,2,0)="Else return -1^error message"
^XWB(8994,3337,0)="DSIV XPAR REPLACE INST^REPL^DSIVXPR^1^A^^^1"
^XWB(8994,3337,1,0)="^8994.01^2^2^3030422^^^"
^XWB(8994,3337,1,1,0)="For an existing entity/parameter/instance, this will change the value of "
^XWB(8994,3337,1,2,0)="that instance"
^XWB(8994,3337,2,0)="^8994.02A^1^1"
^XWB(8994,3337,2,1,0)="DATA^1^250^1^1"
^XWB(8994,3337,2,1,1,0)="^^5^5^3030422^"
^XWB(8994,3337,2,1,1,1,0)="DATA = p1~p2~p3~~p5  where"
^XWB(8994,3337,2,1,1,2,0)="  p1 - entity - optional - defaults to ""USR"""
^XWB(8994,3337,2,1,1,3,0)="  p2 - parameter - required"
^XWB(8994,3337,2,1,1,4,0)="  p3 - instance - required - current instance value"
^XWB(8994,3337,2,1,1,5,0)="  p5 - required - replacement value for current instance"
^XWB(8994,3337,2,"B","DATA",1)=""
^XWB(8994,3337,2,"PARAMSEQ",1,1)=""
^XWB(8994,3337,3,0)="^8994.03^2^2^3030422^^^"
^XWB(8994,3337,3,1,0)="If replacement successfully occurred, then return 1"
^XWB(8994,3337,3,2,0)="Else return -1^error message"
^XWB(8994,3338,0)="DSIV XPAR EDIT^CHG^DSIVXPR^1^A^^^1"
^XWB(8994,3338,1,0)="^8994.01^1^1^3160427^^^^"
^XWB(8994,3338,1,1,0)="This is used to change the value or delete an existing parameter value"
^XWB(8994,3338,2,0)="^8994.02A^1^1"
^XWB(8994,3338,2,1,0)="DATA^1^250^1^1"
^XWB(8994,3338,2,1,1,0)="^8994.021^6^6^3160427^^"
^XWB(8994,3338,2,1,1,1,0)="DATA - required - p1~p2~p3~p4"
^XWB(8994,3338,2,1,1,2,0)=" p1 := optional - entity(s) - if not passed, set to ""USR"" for"
^XWB(8994,3338,2,1,1,3,0)="                  current user"
^XWB(8994,3338,2,1,1,4,0)=" p2 := required - parameter name"
^XWB(8994,3338,2,1,1,5,0)=" p3 := optional - instance"
^XWB(8994,3338,2,1,1,6,0)=" p4 := required - value - see XPAR documentation"
^XWB(8994,3338,2,"B","DATA",1)=""
^XWB(8994,3338,2,"PARAMSEQ",1,1)=""
^XWB(8994,3338,3,0)="^8994.03^2^2^3160427^^^^"
^XWB(8994,3338,3,1,0)="If the parameter is successfully changed, return 1"
^XWB(8994,3338,3,2,0)="Else return -1^error message"
^XWB(8994,3339,0)="DSIV XPAR GET ALL^GETALL^DSIVXPR^4^A^^^1"
^XWB(8994,3339,1,0)="^^1^1^3030902^"
^XWB(8994,3339,1,1,0)="This will return all entities for a given parameter and instance"
^XWB(8994,3339,2,0)="^8994.02A^1^1"
^XWB(8994,3339,2,1,0)="DATA^1^250^1^1"
^XWB(8994,3339,2,1,1,0)="^^3^3^3030902^^"
^XWB(8994,3339,2,1,1,1,0)="DATA - required - ~p2~p3~~~p6"
^XWB(8994,3339,2,1,1,2,0)=" p2 := required - parameter name"
^XWB(8994,3339,2,1,1,3,0)=" p3 := optional - instance"
^XWB(8994,3339,2,1,1,4,0)=" p6 := optional - format code - default=Q, anything else besides Q or "
^XWB(8994,3339,2,1,1,5,0)="                  <null> will be treated as code B"
^XWB(8994,3339,2,1,1,6,0)="  p6 := optional - format code - default=Q, anything else besides Q or"
^XWB(8994,3339,2,1,1,7,0)="                   <null> will be treated as code B"
^XWB(8994,3339,2,"B","DATA",1)=""
^XWB(8994,3339,2,"PARAMSEQ",1,1)=""
^XWB(8994,3339,3,0)="^^5^5^3030422^"
^XWB(8994,3339,3,1,0)="On error, return list[1] = -1^error message"
^XWB(8994,3339,3,2,0)="Else return list[n] = p1^p2^p3^  where n = 1,2,3,4,...."
^XWB(8994,3339,3,3,0)="    p1 = 3 character code representing entity class"
^XWB(8994,3339,3,4,0)="    p2 = entity ien"
^XWB(8994,3339,3,5,0)="    p3 = internal value"
^XWB(8994,3339,3,6,0)="    p4 = external instance"
^XWB(8994,3339,3,7,0)="    p5 = internal value"
^XWB(8994,3339,3,8,0)="    p6 = external value"
^XWB(8994,3339,3,9,0)=" "
^XWB(8994,3339,3,10,0)="p3,p4,p5,p6 - data returned depending upon format passed in DATA "
^XWB(8994,3340,0)="DSIV XPAR GET WP^GETWP^DSIVXPR^2^A^^^1"
^XWB(8994,3340,1,0)="^^2^2^3030422^"
^XWB(8994,3340,1,1,0)="This will return text for a word processing type parameter for an entity "
^XWB(8994,3340,1,2,0)="and instance."
^XWB(8994,3340,2,0)="^8994.02A^1^1"
^XWB(8994,3340,2,1,0)="DATA^1^250^1^1"
^XWB(8994,3340,2,1,1,0)="^^5^5^3030422^"
^XWB(8994,3340,2,1,1,1,0)="DATA - required - p1~p2~p3"
^XWB(8994,3340,2,1,1,2,0)=" p1 := optional - entity - if not passed, set to ""USR"" for"
^XWB(8994,3340,2,1,1,3,0)="                  current user"
^XWB(8994,3340,2,1,1,4,0)=" p2 := required - parameter name"
^XWB(8994,3340,2,1,1,5,0)=" p3 := optional - instance"
^XWB(8994,3340,2,"B","DATA",1)=""
^XWB(8994,3340,2,"PARAMSEQ",1,1)=""
^XWB(8994,3340,3,0)="^^2^2^3030422^"
^XWB(8994,3340,3,1,0)="Return the text in List[n] = text  where n=1,2,3,4,..."
^XWB(8994,3340,3,2,0)="On error, return   List[1] = -1^error message"
^XWB(8994,3341,0)="DSIV XPD VERSION^VERSION^DSIVXPDU^1^A"
^XWB(8994,3341,1,0)="^^2^2^3140205^"
^XWB(8994,3341,1,1,0)="This will use the Kernel API to determine the current version of an"
^XWB(8994,3341,1,2,0)="application."
^XWB(8994,3341,2,0)="^8994.02A^1^1"
^XWB(8994,3341,2,1,0)="PKG^1^50^1^1"
^XWB(8994,3341,2,1,1,0)="^^2^2^3140205^"
^XWB(8994,3341,2,1,1,1,0)="This is the full name of the PACKAGE file entry or the namespace for that"
^XWB(8994,3341,2,1,1,2,0)="package."
^XWB(8994,3341,2,"B","PKG",1)=""
^XWB(8994,3341,2,"PARAMSEQ",1,1)=""
^XWB(8994,3341,3,0)="^^6^6^3140205^"
^XWB(8994,3341,3,1,0)="If the PACKAGE file entry is successfully found, then return the CURRENT"
^XWB(8994,3341,3,2,0)="VERSION value from the PACKAGE file.  Else return -1"
^XWB(8994,3341,3,3,0)=" "
^XWB(8994,3341,3,4,0)="This calls a Kernel API.  As such it will only work for an application"
^XWB(8994,3341,3,5,0)="that has an associated PACKAGE file entry.  It will work for DSI"
^XWB(8994,3341,3,6,0)="applications but not for VEJD."
^XWB(8994,3342,0)="DSIV XPD LAST INSTALL^RLAST^DSIVXPDU^1^A"
^XWB(8994,3342,1,0)="^^2^2^3140213^"
^XWB(8994,3342,1,1,0)="This returns the latest installed version of a KIDS build.  It gets the"
^XWB(8994,3342,1,2,0)="data from the INSTALL file."
^XWB(8994,3342,2,0)="^8994.02A^1^1"
^XWB(8994,3342,2,1,0)="PKG^1^50^1^1"
^XWB(8994,3342,2,1,1,0)="^^8^8^3140213^"
^XWB(8994,3342,2,1,1,1,0)="This is the name (.01 field value) from the INSTALL file."
^XWB(8994,3342,2,1,1,2,0)=" "
^XWB(8994,3342,2,1,1,3,0)="The VA naming convention for KIDS builds:"
^XWB(8994,3342,2,1,1,4,0)="  <name><space><version> for a whole package"
^XWB(8994,3342,2,1,1,5,0)="  name*version*patch for a patch"
^XWB(8994,3342,2,1,1,6,0)=" "
^XWB(8994,3342,2,1,1,7,0)="PKG can be the full name KIDS BUILD file name, or it can just be the name"
^XWB(8994,3342,2,1,1,8,0)="portion of the KIDS BUILD file name"
^XWB(8994,3342,2,"B","PKG",1)=""
^XWB(8994,3342,2,"PARAMSEQ",1,1)=""
^XWB(8994,3342,3,0)="^^7^7^3140213^"
^XWB(8994,3342,3,1,0)="This returns the latest version installed for a KIDS package.  It looks"
^XWB(8994,3342,3,2,0)="at the date installed field to determine the latest version installed."
^XWB(8994,3342,3,3,0)=" "
^XWB(8994,3342,3,4,0)="Return values:"
^XWB(8994,3342,3,5,0)="                successful lookup: version number ^ date.time installed"
^XWB(8994,3342,3,6,0)=" no matches found for input value: 0^message"
^XWB(8994,3342,3,7,0)="                         on error: -1^error message"
^XWB(8994,3343,0)="DSIV XPAR MULT ACTION^MULT^DSIVXPR^2^A^^^1"
^XWB(8994,3343,1,0)="^8994.01^9^9^3080423^^"
^XWB(8994,3343,1,1,0)="This is a multi-function front end to the Parameter APIs.  It allows you "
^XWB(8994,3343,1,2,0)="with a single RPC call to take edit type actions on several "
^XWB(8994,3343,1,3,0)="parameter/entity/instance combinations."
^XWB(8994,3343,1,4,0)=" "
^XWB(8994,3343,1,5,0)="You can only do these actions:  add, change, or delete"
^XWB(8994,3343,1,6,0)=" "
^XWB(8994,3343,1,7,0)="Each entry in the passed list is treated as if it was a separate RPC "
^XWB(8994,3343,1,8,0)="call.  Thus each entry is totally independent of the others.  So you can "
^XWB(8994,3343,1,9,0)="mix and match parameters, entities, instances, and actions."
^XWB(8994,3343,2,0)="^8994.02A^1^1"
^XWB(8994,3343,2,1,0)="DSICLIST^2^250^1^1"
^XWB(8994,3343,2,1,1,0)="^8994.021^17^17^3080423^^"
^XWB(8994,3343,2,1,1,1,0)="DSICLIST - required - p1^p2^p3^p4^p5^p6^p7  where"
^XWB(8994,3343,2,1,1,2,0)=" "
^XWB(8994,3343,2,1,1,3,0)="For p1 - p6 see the equivalent DSIC XPAR xxxxxx RPC definition to see "
^XWB(8994,3343,2,1,1,4,0)="which p1 - p6 are required for the action requested"
^XWB(8994,3343,2,1,1,5,0)=" "
^XWB(8994,3343,2,1,1,6,0)="  p1 := entity - default to USR"
^XWB(8994,3343,2,1,1,7,0)="  p2 := parameter name"
^XWB(8994,3343,2,1,1,8,0)="  p3 := instance"
^XWB(8994,3343,2,1,1,9,0)="  p4 := value"
^XWB(8994,3343,2,1,1,10,0)="  p5 := new instance value"
^XWB(8994,3343,2,1,1,11,0)="  p6 := format for GET1 call"
^XWB(8994,3343,2,1,1,12,0)="  p7 := action to be taken - must be ADD, CHG, or DEL"
^XWB(8994,3343,2,1,1,13,0)="        if p7 = ""ADD"" then for this list element perform ADD function"
^XWB(8994,3343,2,1,1,14,0)="        if p7 = ""CHG"" then for this list element perform change value"
^XWB(8994,3343,2,1,1,15,0)="                 for a parameter/entity/instance"
^XWB(8994,3343,2,1,1,16,0)="        if p7 = ""DEL"" then for this list element perform delete of"
^XWB(8994,3343,2,1,1,17,0)="                of a parameter/entity/instance"
^XWB(8994,3343,2,"B","DSICLIST",1)=""
^XWB(8994,3343,2,"B","DSIVLIST",1)=""
^XWB(8994,3343,2,"PARAMSEQ",1,1)=""
^XWB(8994,3343,3,0)="^^12^12^3080423^"
^XWB(8994,3343,3,1,0)="Return the input array exactly like inputted except each array element "
^XWB(8994,3343,3,2,0)="will have an 8th (or 8th and 9th tilde pieces)"
^XWB(8994,3343,3,3,0)=" "
^XWB(8994,3343,3,4,0)="So the return array will be LIST[n] = p1~p2~p3~p4~p5~p6~p7~p8~p9"
^XWB(8994,3343,3,5,0)="where n=1,2,3,4,5,..."
^XWB(8994,3343,3,6,0)="  p1~...~p7 will be exactly what was input"
^XWB(8994,3343,3,7,0)="  if the action was successful, then p8 = 1 and there will be no p9"
^XWB(8994,3343,3,8,0)="  if the action was unsuccessful, the p8 = -1, p9 = error message"
^XWB(8994,3343,3,9,0)=" "
^XWB(8994,3343,3,10,0)="NOTE:  The GUI program should check for the value in the Error Text field "
^XWB(8994,3343,3,11,0)="before reporting an error (p9). A -1 is a possible result from a"
^XWB(8994,3343,3,12,0)="successful call to this RPC."
^XWB(8994,3344,0)="DSIV XPD INSTALL LIST^INSLIST^DSIVXPDU^2^A"
^XWB(8994,3344,1,0)="^^5^5^3140221^"
^XWB(8994,3344,1,1,0)="This will return a list of all the entries in the INSTALL file.  You pass"
^XWB(8994,3344,1,2,0)="in either a KIDS Build name or the name portion of the Build name (a"
^XWB(8994,3344,1,3,0)="Build name without the version number or patch number).  All Installs"
^XWB(8994,3344,1,4,0)="matching that name will be returned in reverse chronological order (the"
^XWB(8994,3344,1,5,0)="newest first)."
^XWB(8994,3344,2,0)="^8994.02A^3^3"
^XWB(8994,3344,2,1,0)="DSIKID^1^30^1^1"
^XWB(8994,3344,2,1,1,0)="^^5^5^3140221^"
^XWB(8994,3344,2,1,1,1,0)="This value will be used to do a Fileman lookup on the INSTALL file .01"
^XWB(8994,3344,2,1,1,2,0)="Name field.  This value can be a full Build name in the form:"
^XWB(8994,3344,2,1,1,3,0)="  <test><space><version>  or a patch <text>*<version>*<patch>"
^XWB(8994,3344,2,1,1,4,0)=" "
^XWB(8994,3344,2,1,1,5,0)="This value can just be the text portion of the Build name."
^XWB(8994,3344,2,2,0)="DSIALL^1^1^0^2"
^XWB(8994,3344,2,2,1,0)="^^8^8^3140221^"
^XWB(8994,3344,2,2,1,1,0)="This parameter will only be used if the DSIKID input value is a patch"
^XWB(8994,3344,2,2,1,2,0)="designation name, that is a Build name with ""*""."
^XWB(8994,3344,2,2,1,3,0)=" "
^XWB(8994,3344,2,2,1,4,0)="This is a Boolean value: 1/0   Default value = 0"
^XWB(8994,3344,2,2,1,5,0)="  if 1 then return only Installs whose Build name exactly matches the"
^XWB(8994,3344,2,2,1,6,0)="    value passed in DSIKID"
^XWB(8994,3344,2,2,1,7,0)="  if 0 then return all Installs whose Build name starts with the text"
^XWB(8994,3344,2,2,1,8,0)="    portion of a patch designation:  <text>*<version>*<patch>"
^XWB(8994,3344,2,3,0)="DSISTAT^1^5^0^3"
^XWB(8994,3344,2,3,1,0)="^^12^12^3140221^"
^XWB(8994,3344,2,3,1,1,0)="This is a string of numbers which can be 0,1,2,3,4"
^XWB(8994,3344,2,3,1,2,0)="These numbers indicate the status of the KIDS Install Status"
^XWB(8994,3344,2,3,1,3,0)="  0:Loaded   1:Queued   2:Install Started   3:Install Completed"
^XWB(8994,3344,2,3,1,4,0)="  4:De-installed"
^XWB(8994,3344,2,3,1,5,0)=" "
^XWB(8994,3344,2,3,1,6,0)="The only statuses that indicate a Build was actually installed are 2,3"
^XWB(8994,3344,2,3,1,7,0)="  3 indicates the install ran to completion successfully"
^XWB(8994,3344,2,3,1,8,0)="  2 indicates that the install started but never ran to completion."
^XWB(8994,3344,2,3,1,9,0)="     There is no way to determine how far the install got just looking at"
^XWB(8994,3344,2,3,1,10,0)="     this status code."
^XWB(8994,3344,2,3,1,11,0)=" "
^XWB(8994,3344,2,3,1,12,0)="Default value = 23"
^XWB(8994,3344,2,"B","DSIALL",2)=""
^XWB(8994,3344,2,"B","DSIKID",1)=""
^XWB(8994,3344,2,"B","DSISTAT",3)=""
^XWB(8994,3344,2,"PARAMSEQ",1,1)=""
^XWB(8994,3344,2,"PARAMSEQ",2,2)=""
^XWB(8994,3344,2,"PARAMSEQ",3,3)=""
^XWB(8994,3344,3,0)="^^11^11^3140221^"
^XWB(8994,3344,3,1,0)="Return List[n] := p1^p2^p3  for n=1,2,3,4,...  where"
^XWB(8994,3344,3,2,0)="  p1 = ifn to file 9.7    p2 = Build name"
^XWB(8994,3344,3,3,0)="  p3 = date [return INSTALL COMPLETE DATE if present, else return"
^XWB(8994,3344,3,4,0)="       DATE LOADED]"
^XWB(8994,3344,3,5,0)=" "
^XWB(8994,3344,3,6,0)="The return list is sorted by Build name root and within name root sort by"
^XWB(8994,3344,3,7,0)="date in reverse chronological order.  The Build name root is the root"
^XWB(8994,3344,3,8,0)="portion of a valid Build name:"
^XWB(8994,3344,3,9,0)="  <root><space><version>      <root>*<version>*<patch>"
^XWB(8994,3344,3,10,0)=" "
^XWB(8994,3344,3,11,0)="If there are problems, return List[1] := -1^message"
^XWB(8994,3345,0)="DSIV ACTIVE USER LIST^LIST^DSIVDUZ^4^A^^^1"
^XWB(8994,3345,1,0)="^8994.01^3^3^3140307^^"
^XWB(8994,3345,1,1,0)="This will return a list of active users matching the lookup value. You "
^XWB(8994,3345,1,2,0)="can pass in additional screening logic if so desired, such as security "
^XWB(8994,3345,1,3,0)="keys."
^XWB(8994,3345,2,0)="^8994.02A^2^2"
^XWB(8994,3345,2,1,0)="VAL^1^50^1^1"
^XWB(8994,3345,2,1,1,0)="^^1^1^3131018^"
^XWB(8994,3345,2,1,1,1,0)="This is the lookup value to find matches in file 200."
^XWB(8994,3345,2,2,0)="SCR^2^250^0^2"
^XWB(8994,3345,2,2,1,0)="^8994.021^6^6^3140307^^"
^XWB(8994,3345,2,2,1,1,0)="This RPC will return a list of active users. You may wish additional "
^XWB(8994,3345,2,2,1,2,0)="screening to occur. For example, return all active users matching SMITH"
^XWB(8994,3345,2,2,1,3,0)="who also own a particular security key.  Acceptable format of SCR():"
^XWB(8994,3345,2,2,1,4,0)="   SCR(n) = KEY^<security key name>"
^XWB(8994,3345,2,2,1,5,0)="   SCR(n) = PARM^<parameter name>^<parameter instance>"
^XWB(8994,3345,2,2,1,6,0)="   SCR(n) = M^<return text>^<executable M code that sets $T>"
^XWB(8994,3345,2,"B","SCR",2)=""
^XWB(8994,3345,2,"B","VAL",1)=""
^XWB(8994,3345,2,"PARAMSEQ",1,1)=""
^XWB(8994,3345,2,"PARAMSEQ",2,2)=""
^XWB(8994,3345,3,0)="^^19^19^3140307^"
^XWB(8994,3345,3,1,0)=" Data will be returned in ^TMP(""DSIV"",$J,""DILIST"",n,0)."
^XWB(8994,3345,3,2,0)=" "
^XWB(8994,3345,3,3,0)=" If a successful find for the lookup value, then return the following "
^XWB(8994,3345,3,4,0)="data:"
^XWB(8994,3345,3,5,0)="   ^TMP(""DSIV"",$J,""DILIST"",n,0) = p1^p2^p3^...^p8  for n=1,2,3,4,..."
^XWB(8994,3345,3,6,0)="      for the GUI, you will have List[n] := p1^p2^...^p8 for n=0,1,2,3,..."
^XWB(8994,3345,3,7,0)="      where"
^XWB(8994,3345,3,8,0)="      p1 = ien                      p5 = first m last   p9 = division"
^XWB(8994,3345,3,9,0)="      p2 = name (.01 field)         p6 = initials"
^XWB(8994,3345,3,10,0)="      p3 = sig block printed name   p7 = title"
^XWB(8994,3345,3,11,0)="      p4 - sig block title          p8 = service"
^XWB(8994,3345,3,12,0)=" "
^XWB(8994,3345,3,13,0)=" If problems are encountered, then return"
^XWB(8994,3345,3,14,0)="   ^TMP(""DSIV"",$J,""DILIST"",1,0) = -1^message"
^XWB(8994,3345,3,15,0)="   If additional messages are provided then they will be at"
^XWB(8994,3345,3,16,0)="     ^TMP(""DSIV"",$J,""DILIST"",n,0) = message   for n=2,3,4,5,..."
^XWB(8994,3345,3,17,0)=" "
^XWB(8994,3345,3,18,0)=" If $Piece(List[0],""^"",1) := -1 then there were problems, else the lookup"
^XWB(8994,3345,3,19,0)=" was successful."
^XWB(8994,3346,0)="DSIV DATE CONVERT^CNVT^DSIVDT^1^A"
^XWB(8994,3346,1,0)="^^1^1^3131022^"
^XWB(8994,3346,1,1,0)="This will take a date in any format and convert it to any other format."
^XWB(8994,3346,2,0)="^8994.02A^5^5"
^XWB(8994,3346,2,1,0)="INVAL^1^25^1^1"
^XWB(8994,3346,2,1,1,0)="^^41^41^3131022^"
^XWB(8994,3346,2,1,1,1,0)=" This is the input date.time value to be converted.  If this parameters"
^XWB(8994,3346,2,1,1,2,0)=" contains any alpha characters, this RPC will always assume that this"
^XWB(8994,3346,2,1,1,3,0)=" input value is in external form (i.e., human readable format).  When"
^XWB(8994,3346,2,1,1,4,0)=" sending external (human readable) date.time, then following applies:"
^XWB(8994,3346,2,1,1,5,0)=" "
^XWB(8994,3346,2,1,1,6,0)=" 1. If a two-digit year is entered, a year less than 20 years in the"
^XWB(8994,3346,2,1,1,7,0)="    future and no more than 80 years in the past is assumed. For"
^XWB(8994,3346,2,1,1,8,0)="    example, in the year 2000, two-digit years are assumed to be"
^XWB(8994,3346,2,1,1,9,0)="    between 1920 through 2019."
^XWB(8994,3346,2,1,1,10,0)=" "
^XWB(8994,3346,2,1,1,11,0)=" 2. For Internationalization, this assumes that in the input, the day"
^XWB(8994,3346,2,1,1,12,0)="    number precedes the month number. For example, input of 05/11/2000"
^XWB(8994,3346,2,1,1,13,0)="    is assumed to be November 5, 2000 (instead of May 11, 2000). Also,"
^XWB(8994,3346,2,1,1,14,0)="    with this flag, the month must be input as a number. For example,"
^XWB(8994,3346,2,1,1,15,0)="    November must be input as 11, not NOV."
^XWB(8994,3346,2,1,1,16,0)=" "
^XWB(8994,3346,2,1,1,17,0)=" 3. To simplify entering dates, you can use shortcuts such as T for"
^XWB(8994,3346,2,1,1,18,0)="    today, T-1 for yesterday, or T+1 for tomorrow. Or you can combine"
^XWB(8994,3346,2,1,1,19,0)="    T with D for day, W for week, M for month, or Y for year; T-2D"
^XWB(8994,3346,2,1,1,20,0)="    means two days ago, T+1W means today plus one week, T+4M means four"
^XWB(8994,3346,2,1,1,21,0)="    months from today, and T-3Y means three years ago from today."
^XWB(8994,3346,2,1,1,22,0)=" "
^XWB(8994,3346,2,1,1,23,0)=" 4. For time input, to be totally unambiguous, time can be as military"
^XWB(8994,3346,2,1,1,24,0)="    time (four or six digits, no colon), hour AM/PM, hour:minute AM/PM,"
^XWB(8994,3346,2,1,1,25,0)="    or hour:minute:second AM/PM. If you do omit an AM/PM notation, the"
^XWB(8994,3346,2,1,1,26,0)="    following assumptions are made:"
^XWB(8994,3346,2,1,1,27,0)="    a. If you enter a single digit for the hour, a time between 6AM"
^XWB(8994,3346,2,1,1,28,0)="       and 6PM is used. Thus, T@330 (or T@3:30) means today at 3:30 PM"
^XWB(8994,3346,2,1,1,29,0)="       and T@945 (or T@9:45) means today at 9:45 AM."
^XWB(8994,3346,2,1,1,30,0)="    b. If you enter two digits for the hour, the actual hour entered is"
^XWB(8994,3346,2,1,1,31,0)="       used (as if military time were being used). Thus, T@0330 (or"
^XWB(8994,3346,2,1,1,32,0)="       T@03:30) means today at 3:30 AM."
^XWB(8994,3346,2,1,1,33,0)="    c. As with dates, there are supported abbreviations you can use"
^XWB(8994,3346,2,1,1,34,0)="       when entering times in DATE/TIME fields."
^XWB(8994,3346,2,1,1,35,0)="       1) To enter the present moment, you can enter the word NOW"
^XWB(8994,3346,2,1,1,36,0)="       2) To enter an hour from the present moment, enter NOW+1H"
^XWB(8994,3346,2,1,1,37,0)="       3) To enter an hour ago from the present moment, enter NOW-1H"
^XWB(8994,3346,2,1,1,38,0)="       4) You can also combine NOW with D for day, M for month, and"
^XWB(8994,3346,2,1,1,39,0)="          ' (apostrophe) for minute (NOW+3' for present time plus 3"
^XWB(8994,3346,2,1,1,40,0)="          minutes."
^XWB(8994,3346,2,1,1,41,0)="       5) And you can enter MID for 12 a.m. and NOON for 12 p.m."
^XWB(8994,3346,2,2,0)="INTYPE^1^2^0^2"
^XWB(8994,3346,2,2,1,0)="^^13^13^3131022^"
^XWB(8994,3346,2,2,1,1,0)=" Optional - only if INVAL contains an alpha character.  Else, this is"
^XWB(8994,3346,2,2,1,2,0)=" required. Usually it is a single character.  If two characters, then it"
^XWB(8994,3346,2,2,1,3,0)=" must be one of the first 6 listed below plus ""I"".  If INVAL=""I"" then"
^XWB(8994,3346,2,2,1,4,0)=" assume INVAL in external format."
^XWB(8994,3346,2,2,1,5,0)=" "
^XWB(8994,3346,2,2,1,6,0)="  ""D"" - INVAL is in Delphi internal format"
^XWB(8994,3346,2,2,1,7,0)="  ""F"" - INVAL is in internal Fileman format"
^XWB(8994,3346,2,2,1,8,0)="  ""E"" - INVAL is in external format (human readable)"
^XWB(8994,3346,2,2,1,9,0)="  ""M"" - INVAL is in internal M format ($H)"
^XWB(8994,3346,2,2,1,10,0)="  ""H"" - INVAL is in HL7 format"
^XWB(8994,3346,2,2,1,11,0)="  ""G"" - INVAL is in UCT format"
^XWB(8994,3346,2,2,1,12,0)="  ""I"" - INVAL is in Internationalized format, i.e.,"
^XWB(8994,3346,2,2,1,13,0)="        the day number precedes the month number"
^XWB(8994,3346,2,3,0)="OUTYPE^1^6^0^3"
^XWB(8994,3346,2,3,1,0)="^^10^10^3131022^"
^XWB(8994,3346,2,3,1,1,0)=" Optional - default value is internal Fileman format ""F"".  This is a"
^XWB(8994,3346,2,3,1,2,0)=" string of characters designating output format(s)"
^XWB(8994,3346,2,3,1,3,0)=" "
^XWB(8994,3346,2,3,1,4,0)=" If OUTYPE contains ""F"" - return internal Fileman format"
^XWB(8994,3346,2,3,1,5,0)="                    ""D"" - return internal Delphi format"
^XWB(8994,3346,2,3,1,6,0)="                    ""E"" - return external format"
^XWB(8994,3346,2,3,1,7,0)="                    ""M"" - return internal M format ($H)"
^XWB(8994,3346,2,3,1,8,0)="                    ""A"" - return all formats"
^XWB(8994,3346,2,3,1,9,0)="                    ""H"" - return HL7 format"
^XWB(8994,3346,2,3,1,10,0)="                    ""G"" - return UCT format"
^XWB(8994,3346,2,4,0)="OUTFMT^1^10^0^4"
^XWB(8994,3346,2,4,1,0)="^^17^17^3131022^"
^XWB(8994,3346,2,4,1,1,0)=" Optional - this param controls the format of the returned value for"
^XWB(8994,3346,2,4,1,2,0)=" external date value only.  OUTFMT can contain only a single digit plus"
^XWB(8994,3346,2,4,1,3,0)=" optional alpha characters."
^XWB(8994,3346,2,4,1,4,0)=" "
^XWB(8994,3346,2,4,1,5,0)=" If OUTFMT = """" - then return mmm dd, yyyy@hh:mm:ss - default"
^XWB(8994,3346,2,4,1,6,0)="           contains 1 -       mmm dd, yyyy@hh:mm:ss - default"
^XWB(8994,3346,2,4,1,7,0)="                    2 -       mm/dd/yy@hh:mm:ss [no leading zeros]"
^XWB(8994,3346,2,4,1,8,0)="                    3 -       dd/mm/yy@hh:mm:ss [no leading zeros]"
^XWB(8994,3346,2,4,1,9,0)="                    4 -       yy/mm/dd@hh:mm:ss [no leading zeros]"
^XWB(8994,3346,2,4,1,10,0)="                    5 -       mm/dd/yyyy@hh:mm:ss [no leading zeros]"
^XWB(8994,3346,2,4,1,11,0)="                    6 -       dd/mm/yyyy@hh:mm:ss [no leading zeros]"
^XWB(8994,3346,2,4,1,12,0)="                    7 -       yyyy/mm/dd@hh:mm:ss [no leading zeros]"
^XWB(8994,3346,2,4,1,13,0)="                    D -       return date only"
^XWB(8994,3346,2,4,1,14,0)="                    F -       output with leading blanks"
^XWB(8994,3346,2,4,1,15,0)="                    S -       force seconds in outputs"
^XWB(8994,3346,2,4,1,16,0)="                    Z -       pad months and days with leading zeros"
^XWB(8994,3346,2,4,1,17,0)="                    P -  output time in ' hh:mm:ss am/pm'"
^XWB(8994,3346,2,5,0)="TIMEFMT^1^1^0^5"
^XWB(8994,3346,2,5,1,0)="^^6^6^3131022^"
^XWB(8994,3346,2,5,1,1,0)=" Optional - controls what portion of the time part of the date will be"
^XWB(8994,3346,2,5,1,2,0)=" returned.  Default value is M"
^XWB(8994,3346,2,5,1,3,0)=" "
^XWB(8994,3346,2,5,1,4,0)=" If TIMEFMT = H, then return only hours"
^XWB(8994,3346,2,5,1,5,0)="            = M, then return only hour:minute"
^XWB(8994,3346,2,5,1,6,0)="            = S, then return seconds"
^XWB(8994,3346,2,"B","INTYPE",2)=""
^XWB(8994,3346,2,"B","INVAL",1)=""
^XWB(8994,3346,2,"B","OUTFMT",4)=""
^XWB(8994,3346,2,"B","OUTYPE",3)=""
^XWB(8994,3346,2,"B","TIMEFMT",5)=""
^XWB(8994,3346,2,"PARAMSEQ",1,1)=""
^XWB(8994,3346,2,"PARAMSEQ",2,2)=""
^XWB(8994,3346,2,"PARAMSEQ",3,3)=""
^XWB(8994,3346,2,"PARAMSEQ",4,4)=""
^XWB(8994,3346,2,"PARAMSEQ",5,5)=""
^XWB(8994,3346,3,0)="^^21^21^3131022^"
^XWB(8994,3346,3,1,0)=" If OUTYPE is a single character, not equal to A, then return a single"
^XWB(8994,3346,3,2,0)=" date.time value in the specified format."
^XWB(8994,3346,3,3,0)=" "
^XWB(8994,3346,3,4,0)=" If OUTYPE is equal to A or is more than one character, then return a"
^XWB(8994,3346,3,5,0)=" string in the format p1^p2^p3^p4^p5^p6  where"
^XWB(8994,3346,3,6,0)="        p1 = internal Delphi format"
^XWB(8994,3346,3,7,0)="        p2 = internal Fileman format"
^XWB(8994,3346,3,8,0)="        p3 = external format (human readable)"
^XWB(8994,3346,3,9,0)="        p4 = internal M format ($H)"
^XWB(8994,3346,3,10,0)="        p5 = HL7 format"
^XWB(8994,3346,3,11,0)="        p6 = UCT format"
^XWB(8994,3346,3,12,0)=" "
^XWB(8994,3346,3,13,0)=" Only those pieces requested in OUTYPE will be returned."
^XWB(8994,3346,3,14,0)=" "
^XWB(8994,3346,3,15,0)=" If problems encountered, return the word ERR"
^XWB(8994,3346,3,16,0)=" NOTES: -1 is a valid return value for an internal Delphi date.time"
^XWB(8994,3346,3,17,0)=" "
^XWB(8994,3346,3,18,0)=" Thus for any problems encountered, return ""ERR^message"".  Not every ERR"
^XWB(8994,3346,3,19,0)=" return value will have a message on the 2nd piece as many of the Kernel"
^XWB(8994,3346,3,20,0)=" and Fileman date utilities only return a value of -1 if any problems"
^XWB(8994,3346,3,21,0)=" encountered with no further explanation"
^XWB(8994,3347,0)="DSIV DPT GET DEMO^DEM^DSIVDPT^2^A"
^XWB(8994,3347,1,0)="^^1^1^3131101^"
^XWB(8994,3347,1,1,0)="This will return specific patient demographic elements for a patient."
^XWB(8994,3347,2,0)="^8994.02A^5^5"
^XWB(8994,3347,2,1,0)="DFN^1^20^0^1"
^XWB(8994,3347,2,1,1,0)="^^1^1^3131101^"
^XWB(8994,3347,2,1,1,1,0)="This is the patient's DFN or pointer (IEN) to the PATIENT file."
^XWB(8994,3347,2,2,0)="SSN^1^10^0^2"
^XWB(8994,3347,2,2,1,0)="^^3^3^3131101^"
^XWB(8994,3347,2,2,1,1,0)="This is the patient's 9 (or 10) digit SSN."
^XWB(8994,3347,2,2,1,2,0)=" "
^XWB(8994,3347,2,2,1,3,0)="You must pass either DFN or SSN."
^XWB(8994,3347,2,3,0)="PERM^1^1^0^3"
^XWB(8994,3347,2,3,1,0)="^^4^4^3131101^"
^XWB(8994,3347,2,3,1,1,0)="This is a boolean flag (1 or 0). The default value is zero."
^XWB(8994,3347,2,3,1,2,0)=" "
^XWB(8994,3347,2,3,1,3,0)="If one, then always return the patient's permanent address information. "
^XWB(8994,3347,2,3,1,4,0)="Otherwise return what is configured in the MAS software."
^XWB(8994,3347,2,4,0)="DSICONF^1^13^0^4"
^XWB(8994,3347,2,4,1,0)="^^18^18^3131101^"
^XWB(8994,3347,2,4,1,1,0)="This flag determins whether or not to return the confidential address "
^XWB(8994,3347,2,4,1,2,0)="information. It is optional. If this is passed, then TODAY will be "
^XWB(8994,3347,2,4,1,3,0)="default date to use to check to see if a confidential address is active "
^XWB(8994,3347,2,4,1,4,0)="for that date."
^XWB(8994,3347,2,4,1,5,0)=" "
^XWB(8994,3347,2,4,1,6,0)="   DSICONF - optional - p1^p2"
^XWB(8994,3347,2,4,1,7,0)="        p1 - required - confidential address category - this is a string "
^XWB(8994,3347,2,4,1,8,0)="of"
^XWB(8994,3347,2,4,1,9,0)="                        one or more numerics, e.g, 134, where category"
^XWB(8994,3347,2,4,1,10,0)="                        numbers are"
^XWB(8994,3347,2,4,1,11,0)="                          1 for Eligibility/Enrollment"
^XWB(8994,3347,2,4,1,12,0)="                          2 for Appointment/Scheduling"
^XWB(8994,3347,2,4,1,13,0)="                          3 for Co-payments/Veterans Billing"
^XWB(8994,3347,2,4,1,14,0)="                          4 for Medical Records"
^XWB(8994,3347,2,4,1,15,0)="                          5 for All Others"
^XWB(8994,3347,2,4,1,16,0)=" "
^XWB(8994,3347,2,4,1,17,0)="        p2 - optional - fileman date to determine if confidential date is"
^XWB(8994,3347,2,4,1,18,0)="                        effective.  Default value is TODAY"
^XWB(8994,3347,2,5,0)="DSIVFLG^1^1^0^5"
^XWB(8994,3347,2,5,1,0)="^^10^10^3131101^"
^XWB(8994,3347,2,5,1,1,0)="This boolean value (1 or 0) will determine the data returned for certain"
^XWB(8994,3347,2,5,1,2,0)="data elements.  The default value is 0.  Any state, county or zip code"
^XWB(8994,3347,2,5,1,3,0)="data elements return value will be affected by this flag"
^XWB(8994,3347,2,5,1,4,0)=" "
^XWB(8994,3347,2,5,1,5,0)="  If DSIVFLG=0, return state abbreviation, a 5 or 9 zip-code, and county"
^XWB(8994,3347,2,5,1,6,0)="                name"
^XWB(8994,3347,2,5,1,7,0)=" "
^XWB(8994,3347,2,5,1,8,0)="  If DSIVFLG=1, return ien to file 5^state name^state abbreviation"
^XWB(8994,3347,2,5,1,9,0)="                internal form of zip code^external zip code"
^XWB(8994,3347,2,5,1,10,0)="                multiple ien value^county name"
^XWB(8994,3347,2,"B","DFN",1)=""
^XWB(8994,3347,2,"B","DSICONF",4)=""
^XWB(8994,3347,2,"B","DSIVFLG",5)=""
^XWB(8994,3347,2,"B","PERM",3)=""
^XWB(8994,3347,2,"B","SSN",2)=""
^XWB(8994,3347,2,"PARAMSEQ",1,1)=""
^XWB(8994,3347,2,"PARAMSEQ",2,2)=""
^XWB(8994,3347,2,"PARAMSEQ",3,3)=""
^XWB(8994,3347,2,"PARAMSEQ",4,4)=""
^XWB(8994,3347,2,"PARAMSEQ",5,5)=""
^XWB(8994,3347,3,0)="^^52^52^3131107^"
^XWB(8994,3347,3,1,0)="On error return -1^error message"
^XWB(8994,3347,3,2,0)=" "
^XWB(8994,3347,3,3,0)=" Else return:"
^XWB(8994,3347,3,4,0)="  DSIVDAT()  Description"
^XWB(8994,3347,3,5,0)="  ---------  ------------------------------------------"
^XWB(8994,3347,3,6,0)="      1      patient name"
^XWB(8994,3347,3,7,0)="      2      ssn;dashed ssn"
^XWB(8994,3347,3,8,0)="      3      dob int;ext"
^XWB(8994,3347,3,9,0)="      4      age"
^XWB(8994,3347,3,10,0)="      5      sex"
^XWB(8994,3347,3,11,0)="      6      date of death int;ext"
^XWB(8994,3347,3,12,0)="      7      race"
^XWB(8994,3347,3,13,0)="      8      religion"
^XWB(8994,3347,3,14,0)="      9      marital status"
^XWB(8994,3347,3,15,0)="     10      employment status"
^XWB(8994,3347,3,16,0)="     11      1st st add"
^XWB(8994,3347,3,17,0)="     12      2nd st add"
^XWB(8994,3347,3,18,0)="     13      3rd st add"
^XWB(8994,3347,3,19,0)="     14      city"
^XWB(8994,3347,3,20,0)="     15      state abbr [or ien^state name^state abbr]"
^XWB(8994,3347,3,21,0)="     16      zip (9 or 5) [or internal zip^external zip]"
^XWB(8994,3347,3,22,0)="     17      county [or multiple ien^county name]"
^XWB(8994,3347,3,23,0)="     18      home phone"
^XWB(8994,3347,3,24,0)="     19      work phone"
^XWB(8994,3347,3,25,0)="     20      LastName^FirstName^Middle^Suffix/Title"
^XWB(8994,3347,3,26,0)="  ---- ret(21) - ret(28) all refer to confidential address  ----"
^XWB(8994,3347,3,27,0)="     21      confidential address category bitmap.  Default value of"
^XWB(8994,3347,3,28,0)="             ""00000"".  This is a 5 char string of 0s and 1s where each bit"
^XWB(8994,3347,3,29,0)="             refers to whether or not the particular category is active or"
^XWB(8994,3347,3,30,0)="             not as of the date in the DSICONF param.  Only those "
^XWB(8994,3347,3,31,0)="             categories requested in DSICONF param will have a bit value"
^XWB(8994,3347,3,32,0)="             of 1"
^XWB(8994,3347,3,33,0)="     22      street address 1"
^XWB(8994,3347,3,34,0)="     23      street address 2"
^XWB(8994,3347,3,35,0)="     24      street address 3"
^XWB(8994,3347,3,36,0)="     25      city"
^XWB(8994,3347,3,37,0)="     26      state abbr [or ien^state name^state abbr]"
^XWB(8994,3347,3,38,0)="     27      zip (9 or 5) [or internal zip^external zip]"
^XWB(8994,3347,3,39,0)="     28      county [or multiple ien^county name]"
^XWB(8994,3347,3,40,0)="  -------------------------------------------------------------"
^XWB(8994,3347,3,41,0)="     29      primary elig ^ other elig ^ other elig ^ ..."
^XWB(8994,3347,3,42,0)="     30      1 if patient is a veteran, else 0"
^XWB(8994,3347,3,43,0)="     31      code^name of current means test status"
^XWB(8994,3347,3,44,0)="           := file 5 ien^state name^state abbr [dsiflg=1]"
^XWB(8994,3347,3,45,0)="   RET(26) := 5 char zip code or 9 digit zip code with dash [dsiflg=0]"
^XWB(8994,3347,3,46,0)="           := internal zip code^external zip code [dsiflg=1]"
^XWB(8994,3347,3,47,0)="   RET(27) := county name [dsiflg=0]"
^XWB(8994,3347,3,48,0)="           := multiple ien value^county name [dsiflg=1]"
^XWB(8994,3347,3,49,0)="   ***********************************************************************"
^XWB(8994,3347,3,50,0)="   RET(28) := primary eligibility ^ other elig ^ other elig ^ ..."
^XWB(8994,3347,3,51,0)="   RET(29) := 1 if patient is a veteran, else 0"
^XWB(8994,3347,3,52,0)="   RET(30) := code^ name for current means test status"
^XWB(8994,3348,0)="DSIV FM LIST^LIST^DSIVFM05^4^A^^^1"
^XWB(8994,3348,1,0)="^^5^5^3131106^"
^XWB(8994,3348,1,1,0)="The RPC provides a wrapper around the LIST^DIC API. It exposes more of "
^XWB(8994,3348,1,2,0)="the functionality of the API than the DSIV DDR LISTER RPC."
^XWB(8994,3348,1,3,0)=" "
^XWB(8994,3348,1,4,0)="For a lookup value, return all entries starting from that lookup value "
^XWB(8994,3348,1,5,0)="and which collates after that lookup value."
^XWB(8994,3348,2,0)="^8994.02A^1^1"
^XWB(8994,3348,2,1,0)="INPUT^2^250^1^1"
^XWB(8994,3348,2,1,1,0)="^^9^9^3131106^"
^XWB(8994,3348,2,1,1,1,0)=" The INPUT(n) = tag^value  where"
^XWB(8994,3348,2,1,1,2,0)="   tag = LIST^DIC input parameter name such as"
^XWB(8994,3348,2,1,1,3,0)="         FILE  IENS  FIELDS  FLAGS  NUMBER  INDEX  FROM  PART  SCREEN"
^XWB(8994,3348,2,1,1,4,0)="   value = value for that input parameter"
^XWB(8994,3348,2,1,1,5,0)=" "
^XWB(8994,3348,2,1,1,6,0)=" The INDEX variable consists only of a single index name."
^XWB(8994,3348,2,1,1,7,0)=" "
^XWB(8994,3348,2,1,1,8,0)=" For those input parameters that allow an array, you can pass that array"
^XWB(8994,3348,2,1,1,9,0)=" in the tag such as FROM(2)^lookup value"
^XWB(8994,3348,2,"B","INPUT",1)=""
^XWB(8994,3348,2,"PARAMSEQ",1,1)=""
^XWB(8994,3348,3,0)="^^10^10^3131106^"
^XWB(8994,3348,3,1,0)=" If problems return List[0] = -1^error message.   There may be addtional"
^XWB(8994,3348,3,2,0)=" messages on subsequent lines where List[n] = message  or  -1^message  for"
^XWB(8994,3348,3,3,0)=" n = 1,2,3,4,..."
^XWB(8994,3348,3,4,0)=" "
^XWB(8994,3348,3,5,0)=" Return values in list[n] = data  where n = 0,1,2,3,4,..."
^XWB(8994,3348,3,6,0)="   1st ^-piece of data is the ien for that record"
^XWB(8994,3348,3,7,0)="   2nd ^-piece is the value of the field in the 1st ;-piece of FIELDS"
^XWB(8994,3348,3,8,0)="   3rd ^-piece is the value of the field in the 2nd ;-piece of FIELDS"
^XWB(8994,3348,3,9,0)="   4th ^-piece is the value of the field in the 3rd ;-piece of FIELDS"
^XWB(8994,3348,3,10,0)="    etc., etc., ..."
^XWB(8994,3349,0)="DSIV FM GET FIELD ATTRIB^FIELD^DSIVFM06^2^A"
^XWB(8994,3349,1,0)="^^27^27^3131106^"
^XWB(8994,3349,1,1,0)="This will return the inputted field attributes for a file."
^XWB(8994,3349,1,2,0)=" "
^XWB(8994,3349,1,3,0)=" As of 7/29/2003, these attributes are available:"
^XWB(8994,3349,1,4,0)=" AUDIT"
^XWB(8994,3349,1,5,0)=" AUDIT CONDITION"
^XWB(8994,3349,1,6,0)=" COMPUTE ALGORITHM"
^XWB(8994,3349,1,7,0)=" COMPUTED FIELDS USED"
^XWB(8994,3349,1,8,0)=" DATE FIELD LAST EDITED"
^XWB(8994,3349,1,9,0)=" DECIMAL DEFAULT"
^XWB(8994,3349,1,10,0)=" DELETE ACCESS"
^XWB(8994,3349,1,11,0)=" DESCRIPTION"
^XWB(8994,3349,1,12,0)=" FIELD LENGTH"
^XWB(8994,3349,1,13,0)=" GLOBAL SUBSCRIPT LOCATION"
^XWB(8994,3349,1,14,0)=" HELP-PROMPT"
^XWB(8994,3349,1,15,0)=" INPUT TRANSFORM"
^XWB(8994,3349,1,16,0)=" LABEL"
^XWB(8994,3349,1,17,0)=" MULTIPLE-VALUED"
^XWB(8994,3349,1,18,0)=" OUTPUT TRANSFORM"
^XWB(8994,3349,1,19,0)=" POINTER"
^XWB(8994,3349,1,20,0)=" READ ACCESS"
^XWB(8994,3349,1,21,0)=" SOURCE"
^XWB(8994,3349,1,22,0)=" SPECIFIER"
^XWB(8994,3349,1,23,0)=" TECHNICAL DESCRIPTION"
^XWB(8994,3349,1,24,0)=" TITLE"
^XWB(8994,3349,1,25,0)=" TYPE"
^XWB(8994,3349,1,26,0)=" WRITE ACCESS"
^XWB(8994,3349,1,27,0)=" XECUTABLE HELP"
^XWB(8994,3349,2,0)="^8994.02A^4^4"
^XWB(8994,3349,2,1,0)="FILE^1^30^1^1"
^XWB(8994,3349,2,1,1,0)="^^2^2^3131106^"
^XWB(8994,3349,2,1,1,1,0)=" This can be the file number or the full name of the file.  For subfiles,"
^XWB(8994,3349,2,1,1,2,0)=" it must be the subfile number."
^XWB(8994,3349,2,2,0)="FIELD^1^30^1^2"
^XWB(8994,3349,2,2,1,0)="^^1^1^3131106^"
^XWB(8994,3349,2,2,1,1,0)=" This is the field number or the full name of the field"
^XWB(8994,3349,2,3,0)="FLAG^1^2^0^3"
^XWB(8994,3349,2,3,1,0)="^^5^5^3131106^"
^XWB(8994,3349,2,3,1,1,0)=" This is a flag controlling what will be returned."
^XWB(8994,3349,2,3,1,2,0)=" The default value is <null>.  FLAG can contain N."
^XWB(8994,3349,2,3,1,3,0)=" If FLAG contains N then do not return attributes whose value is <null>"
^XWB(8994,3349,2,3,1,4,0)=" If FLAGS contains Z, then for WOrd Processing attributes, include"
^XWB(8994,3349,2,3,1,5,0)="   the zeroth node with the text"
^XWB(8994,3349,2,4,0)="ATT^2^30^1^4"
^XWB(8994,3349,2,4,1,0)="^^4^4^3131106^"
^XWB(8994,3349,2,4,1,1,0)=" This is a list of attributes to return."
^XWB(8994,3349,2,4,1,2,0)="   List[n] := attribute name  where n=0,1,2,3,..."
^XWB(8994,3349,2,4,1,3,0)=" "
^XWB(8994,3349,2,4,1,4,0)=" You can send List[0] := ""*"" to get all field attributes"
^XWB(8994,3349,2,"B","ATT",4)=""
^XWB(8994,3349,2,"B","FIELD",2)=""
^XWB(8994,3349,2,"B","FILE",1)=""
^XWB(8994,3349,2,"B","FLAG",3)=""
^XWB(8994,3349,2,"PARAMSEQ",1,1)=""
^XWB(8994,3349,2,"PARAMSEQ",2,2)=""
^XWB(8994,3349,2,"PARAMSEQ",3,3)=""
^XWB(8994,3349,2,"PARAMSEQ",4,4)=""
^XWB(8994,3349,3,0)="^^3^3^3131106^"
^XWB(8994,3349,3,1,0)="If problems or error, return List[0] := -1^message"
^XWB(8994,3349,3,2,0)=" "
^XWB(8994,3349,3,3,0)=" Else return List[n] := attribute name ^ value   for n=0,1,2,3,4,..."
^XWB(8994,3350,0)="DSIV FM FIND^FIND^DSIVFM05^4^A^^^1"
^XWB(8994,3350,1,0)="^^5^5^3131106^"
^XWB(8994,3350,1,1,0)=" This provides a wrapper around the FIND^DIC API.  It exposes more of the"
^XWB(8994,3350,1,2,0)=" functionality of the API to the RPC than the old DSIC DDR FINDER RPC."
^XWB(8994,3350,1,3,0)=" "
^XWB(8994,3350,1,4,0)=" For a lookup value, this RPC will return all matches.  It allows for"
^XWB(8994,3350,1,5,0)=" input a multiple screening logic which would be ANDed together."
^XWB(8994,3350,2,0)="^8994.02A^1^1"
^XWB(8994,3350,2,1,0)="INPUT^2^250^1^1"
^XWB(8994,3350,2,1,1,0)="^^7^7^3131106^"
^XWB(8994,3350,2,1,1,1,0)=" The INPUT(n) = tag^value   where"
^XWB(8994,3350,2,1,1,2,0)="   tag = LIST^DIC input parameter name such as"
^XWB(8994,3350,2,1,1,3,0)="         FILE  IENS  FIELDS  FLAGS  NUMBER  INDEX  VAL  SCREEN"
^XWB(8994,3350,2,1,1,4,0)="   value = value for that input parameter"
^XWB(8994,3350,2,1,1,5,0)=" "
^XWB(8994,3350,2,1,1,6,0)=" For those input parameters that allow an array, you can pass that array"
^XWB(8994,3350,2,1,1,7,0)=" in the tag such as SCREEN()^lookup value"
^XWB(8994,3350,2,"B","INPUT",1)=""
^XWB(8994,3350,2,"PARAMSEQ",1,1)=""
^XWB(8994,3350,3,0)="^^10^10^3131106^"
^XWB(8994,3350,3,1,0)=" If problems return one or more rows:"
^XWB(8994,3350,3,2,0)="    List[0] = - 1^message"
^XWB(8994,3350,3,3,0)="    List[n] = message  or  -1^message   for n=1,2,3,4,..."
^XWB(8994,3350,3,4,0)=" "
^XWB(8994,3350,3,5,0)=" Return entries found that match the input value:"
^XWB(8994,3350,3,6,0)="    List[n] = results    where n=0,1,2,3,4,..."
^XWB(8994,3350,3,7,0)="    1st ^-piece of results is the ien for the record from that file"
^XWB(8994,3350,3,8,0)="    2nd ^-piece equals the value of the field in the 1st ;-piece of FIELDS"
^XWB(8994,3350,3,9,0)="    3rd ^-piece equals the value of the field int he 2nd ;-piece of FIELDS"
^XWB(8994,3350,3,10,0)="    etc., etc., ...."
^XWB(8994,3351,0)="DSIV DDR WP FILER^WP^DSIVDDR0^2^A"
^XWB(8994,3351,1,0)="^^1^1^3131106^"
^XWB(8994,3351,1,1,0)=" This will file the text into the specified word processing field."
^XWB(8994,3351,2,0)="^8994.02A^5^5"
^XWB(8994,3351,2,1,0)="FILE^1^20^1^1"
^XWB(8994,3351,2,1,1,0)="^^2^2^3131106^"
^XWB(8994,3351,2,1,1,1,0)=" This is the file (or subfile) number for which the word processing field"
^XWB(8994,3351,2,1,1,2,0)=" belongs."
^XWB(8994,3351,2,2,0)="IENS^1^50^1^2"
^XWB(8994,3351,2,2,1,0)="^^2^2^3131106^"
^XWB(8994,3351,2,2,1,1,0)=" This is the appropriate Fileman DBS IENS for filing the word processing"
^XWB(8994,3351,2,2,1,2,0)=" field"
^XWB(8994,3351,2,3,0)="FIELD^1^20^1^3"
^XWB(8994,3351,2,3,1,0)="^^1^1^3131106^"
^XWB(8994,3351,2,3,1,1,0)="This is field number of the word processing field"
^XWB(8994,3351,2,4,0)="FLAGS^1^10^0^4"
^XWB(8994,3351,2,4,1,0)="^^1^1^3131106^"
^XWB(8994,3351,2,4,1,1,0)=" This is the FLAGS parameter for the WP^DIE call."
^XWB(8994,3351,2,5,0)="DATA^2^250^1^5"
^XWB(8994,3351,2,5,1,0)="^^1^1^3131106^"
^XWB(8994,3351,2,5,1,1,0)=" This is the text to be filed into the word processing field."
^XWB(8994,3351,2,"B","DATA",5)=""
^XWB(8994,3351,2,"B","FIELD",3)=""
^XWB(8994,3351,2,"B","FILE",1)=""
^XWB(8994,3351,2,"B","FLAGS",4)=""
^XWB(8994,3351,2,"B","IENS",2)=""
^XWB(8994,3351,2,"PARAMSEQ",1,1)=""
^XWB(8994,3351,2,"PARAMSEQ",2,2)=""
^XWB(8994,3351,2,"PARAMSEQ",3,3)=""
^XWB(8994,3351,2,"PARAMSEQ",4,4)=""
^XWB(8994,3351,2,"PARAMSEQ",5,5)=""
^XWB(8994,3351,3,0)="^^2^2^3131106^"
^XWB(8994,3351,3,1,0)=" If the text is successfully filed, then return 1^"
^XWB(8994,3351,3,2,0)=" Else, return -1^error message"
^XWB(8994,3352,0)="DSIV DDR UPDATE SUBFILE^UPDATE1^DSIVDDR0^2^A"
^XWB(8994,3352,1,0)="^^3^3^3131106^"
^XWB(8994,3352,1,1,0)=" This will add a new record to a multiple in a file.   The multiple can be"
^XWB(8994,3352,1,2,0)=" at any level as long as the IENS is properly defined.  Additional fields"
^XWB(8994,3352,1,3,0)=" can filed with the record."
^XWB(8994,3352,2,0)="^8994.02A^3^3"
^XWB(8994,3352,2,1,0)="FILE^1^20^1^1"
^XWB(8994,3352,2,1,1,0)="^^1^1^3131106^"
^XWB(8994,3352,2,1,1,1,0)=" This is the number of the subfile to which a new record is to be added"
^XWB(8994,3352,2,2,0)="IENS^1^50^0^2"
^XWB(8994,3352,2,2,1,0)="^^4^4^3131106^"
^XWB(8994,3352,2,2,1,1,0)=" This is the standard Fileman DBS parameter for calling UPDATE^DIE when"
^XWB(8994,3352,2,2,1,2,0)=" adding a record to a multiple in a file.  If IENS is not passed or is"
^XWB(8994,3352,2,2,1,3,0)=" passed as <null>, then this will add the record at the top level of the"
^XWB(8994,3352,2,2,1,4,0)=" file."
^XWB(8994,3352,2,3,0)="DATA^2^250^1^3"
^XWB(8994,3352,2,3,1,0)="^^5^5^3131106^"
^XWB(8994,3352,2,3,1,1,0)=" This is a list of fields and their internal values to be filed with the"
^XWB(8994,3352,2,3,1,2,0)=" new record.  Obviously the .01 field should have a value to be filed.  "
^XWB(8994,3352,2,3,1,3,0)=" The format of the DATA array: DATA(field#)=value"
^XWB(8994,3352,2,3,1,4,0)=" "
^XWB(8994,3352,2,3,1,5,0)=" On the GUI side this would be:  Param.List['field#'] := value"
^XWB(8994,3352,2,"B","DATA",3)=""
^XWB(8994,3352,2,"B","FILE",1)=""
^XWB(8994,3352,2,"B","IENS",2)=""
^XWB(8994,3352,2,"PARAMSEQ",1,1)=""
^XWB(8994,3352,2,"PARAMSEQ",2,2)=""
^XWB(8994,3352,2,"PARAMSEQ",3,3)=""
^XWB(8994,3352,3,0)="^^2^2^3131106^"
^XWB(8994,3352,3,1,0)=" If the record is successfully created, return -1^new subfile record "
^XWB(8994,3352,3,2,0)="number Else, return -1^message"
^XWB(8994,3353,0)="DSIV DDR LISTER^LIST^DSIVDDR0^4^A^^^1"
^XWB(8994,3353,1,0)="^^2^2^3131106^"
^XWB(8994,3353,1,1,0)=" This calls the Fileman lister, LIST^DIC to get a list of records matching"
^XWB(8994,3353,1,2,0)=" the input value"
^XWB(8994,3353,2,0)="^8994.02A^10^10"
^XWB(8994,3353,2,1,0)="FILE^1^20^1^1"
^XWB(8994,3353,2,1,1,0)="^^1^1^3131106^"
^XWB(8994,3353,2,1,1,1,0)="This is the file number of the file that will be searched"
^XWB(8994,3353,2,2,0)="IENS^1^30^0^2"
^XWB(8994,3353,2,2,1,0)="^^2^2^3131106^"
^XWB(8994,3353,2,2,1,1,0)="This is the standard FileMan IENS string when doing a search/lookup on a "
^XWB(8994,3353,2,2,1,2,0)="multiple in a file."
^XWB(8994,3353,2,3,0)="FIELD^1^250^0^3"
^XWB(8994,3353,2,3,1,0)="^^1^1^3131106^"
^XWB(8994,3353,2,3,1,1,0)="';' delimited list of fields requested for each record"
^XWB(8994,3353,2,4,0)="FLAGS^1^15^0^4"
^XWB(8994,3353,2,4,1,0)="^^1^1^3131106^"
^XWB(8994,3353,2,4,1,1,0)="This is the FLAGS parameter for the LIST^DIC API"
^XWB(8994,3353,2,5,0)="NUMBER^1^4^0^5"
^XWB(8994,3353,2,5,1,0)="^^1^1^3131106^"
^XWB(8994,3353,2,5,1,1,0)="Enter the maximum number of matching records you wish to retrieve."
^XWB(8994,3353,2,6,0)="FROM^1^50^0^6"
^XWB(8994,3353,2,6,1,0)="^^2^2^3131106^"
^XWB(8994,3353,2,6,1,1,0)="Enter the string that will be the starting value to use when transversing "
^XWB(8994,3353,2,6,1,2,0)="the indexes looking for a match."
^XWB(8994,3353,2,7,0)="PARTIAL^1^50^0^7"
^XWB(8994,3353,2,7,1,0)="^^1^1^3131106^"
^XWB(8994,3353,2,7,1,1,0)="This is the PARTIAL parameter in the LIST^DIC call."
^XWB(8994,3353,2,8,0)="INDEX^1^50^0^8"
^XWB(8994,3353,2,8,1,0)="^^2^2^3131106^"
^XWB(8994,3353,2,8,1,1,0)="Enter the string of index names (separated by '^') which the search will "
^XWB(8994,3353,2,8,1,2,0)="transverse"
^XWB(8994,3353,2,9,0)="SCREEN^1^250^0^9"
^XWB(8994,3353,2,9,1,0)="^^2^2^3131106^"
^XWB(8994,3353,2,9,1,1,0)="If you wish to screen entries, then enter that executable M code. This is "
^XWB(8994,3353,2,9,1,2,0)="the same as DIC(""S"")"
^XWB(8994,3353,2,10,0)="IDENTIFY^1^50^0^10"
^XWB(8994,3353,2,10,1,0)="^^1^1^3131106^"
^XWB(8994,3353,2,10,1,1,0)="This is the IDENTIFIER parameter in LIST^DIC call"
^XWB(8994,3353,2,"B","FIELD",3)=""
^XWB(8994,3353,2,"B","FILE",1)=""
^XWB(8994,3353,2,"B","FLAGS",4)=""
^XWB(8994,3353,2,"B","FROM",6)=""
^XWB(8994,3353,2,"B","IDENTIFY",10)=""
^XWB(8994,3353,2,"B","IENS",2)=""
^XWB(8994,3353,2,"B","INDEX",8)=""
^XWB(8994,3353,2,"B","NUMBER",5)=""
^XWB(8994,3353,2,"B","PARTIAL",7)=""
^XWB(8994,3353,2,"B","SCREEN",9)=""
^XWB(8994,3353,2,"PARAMSEQ",1,1)=""
^XWB(8994,3353,2,"PARAMSEQ",2,2)=""
^XWB(8994,3353,2,"PARAMSEQ",3,3)=""
^XWB(8994,3353,2,"PARAMSEQ",4,4)=""
^XWB(8994,3353,2,"PARAMSEQ",5,5)=""
^XWB(8994,3353,2,"PARAMSEQ",6,6)=""
^XWB(8994,3353,2,"PARAMSEQ",7,7)=""
^XWB(8994,3353,2,"PARAMSEQ",8,8)=""
^XWB(8994,3353,2,"PARAMSEQ",9,9)=""
^XWB(8994,3353,2,"PARAMSEQ",10,10)=""
^XWB(8994,3353,3,0)="^^2^2^3131106^"
^XWB(8994,3353,3,1,0)=" If successful, return array will be in the following order:"
^XWB(8994,3353,3,2,0)="  File Number^IEN^Field Number^Text"
^XWB(8994,3354,0)="DSIV DDR GETS ENTRY DATA^GET^DSIVDDR0^4^A^^^1^^^1"
^XWB(8994,3354,1,0)="^^1^1^3131106^"
^XWB(8994,3354,1,1,0)="This calls GETS^DIQ to get a list of field values for a record"
^XWB(8994,3354,2,0)="^8994.02A^4^4"
^XWB(8994,3354,2,1,0)="FILE^1^20^1^1"
^XWB(8994,3354,2,1,1,0)="^^1^1^3131106^"
^XWB(8994,3354,2,1,1,1,0)="This is the number of the file in which you wish to search."
^XWB(8994,3354,2,2,0)="IENS^1^20^1^2"
^XWB(8994,3354,2,2,1,0)="^^2^2^3131106^"
^XWB(8994,3354,2,2,1,1,0)="This is the IENS for the search. See the instructions on constructing an "
^XWB(8994,3354,2,2,1,2,0)="IENS in the FileMan Programmer's Manual"
^XWB(8994,3354,2,3,0)="FIELD^1^250^1^3"
^XWB(8994,3354,2,3,1,0)="^^2^2^3131106^"
^XWB(8994,3354,2,3,1,1,0)="This is an ^ (or "";"") delimited list of field numbers to return from the "
^XWB(8994,3354,2,3,1,2,0)="entry identified in IENS"
^XWB(8994,3354,2,4,0)="FLAGS^1^20^1^4"
^XWB(8994,3354,2,4,1,0)="^^13^13^3131106^"
^XWB(8994,3354,2,4,1,1,0)=" This is a string containing up to 3 characters that will modify how"
^XWB(8994,3354,2,4,1,2,0)=" FileMan presents the results of this operation:"
^XWB(8994,3354,2,4,1,3,0)=" "
^XWB(8994,3354,2,4,1,4,0)="        E: Return data in external format"
^XWB(8994,3354,2,4,1,5,0)="        I: Return data in internal format"
^XWB(8994,3354,2,4,1,6,0)=" "
^XWB(8994,3354,2,4,1,7,0)="        N: Do NOT return null values - not to be used by DSS GUI"
^XWB(8994,3354,2,4,1,8,0)="        R: Resolves field numbers to field names"
^XWB(8994,3354,2,4,1,9,0)="        W: Input field is a word processing field"
^XWB(8994,3354,2,4,1,10,0)=" "
^XWB(8994,3354,2,4,1,11,0)=" If the W flag is passed, then this call expects that the Field parameter"
^XWB(8994,3354,2,4,1,12,0)=" will have a single field number only.  The W flag must be sent by"
^XWB(8994,3354,2,4,1,13,0)=" itself.  It cannot be combined with other flags.  W introduced 12/9/2003."
^XWB(8994,3354,2,"B","FIELD",3)=""
^XWB(8994,3354,2,"B","FILE",1)=""
^XWB(8994,3354,2,"B","FLAGS",4)=""
^XWB(8994,3354,2,"B","IENS",2)=""
^XWB(8994,3354,2,"PARAMSEQ",1,1)=""
^XWB(8994,3354,2,"PARAMSEQ",2,2)=""
^XWB(8994,3354,2,"PARAMSEQ",3,3)=""
^XWB(8994,3354,2,"PARAMSEQ",4,4)=""
^XWB(8994,3354,3,0)="^^10^10^3131106^"
^XWB(8994,3354,3,1,0)=" Returns an array with the following format:"
^XWB(8994,3354,3,2,0)=" "
^XWB(8994,3354,3,3,0)=" For non-word processing fields, List[n] := p1^p2^p3^p4^p5   n=1,2,3,..."
^XWB(8994,3354,3,4,0)="   p1 = file number (or subfile#)"
^XWB(8994,3354,3,5,0)="   p2 = iens"
^XWB(8994,3354,3,6,0)="   p3 = field number or field name"
^XWB(8994,3354,3,7,0)="   p4 = value for that field"
^XWB(8994,3354,3,8,0)="   p5 = I if value in internal format, else E if in external format"
^XWB(8994,3354,3,9,0)=" "
^XWB(8994,3354,3,10,0)=" For a word processing field, return List[n] := text   n=1,2,3,..."
^XWB(8994,3355,0)="DSIV DDR FINDER^FIND^DSIVDDR0^4^A^^^1"
^XWB(8994,3355,1,0)="^8994.01^1^1^3131106^^"
^XWB(8994,3355,1,1,0)="Call FIND^DIC to get a list of matches on the file for the input value"
^XWB(8994,3355,2,0)="^8994.02A^8^8"
^XWB(8994,3355,2,1,0)="FILE^1^20^1^1"
^XWB(8994,3355,2,1,1,0)="^^1^1^3131106^"
^XWB(8994,3355,2,1,1,1,0)="This is the number of the file in which you wish to search."
^XWB(8994,3355,2,2,0)="IENS^1^30^0^2"
^XWB(8994,3355,2,2,1,0)="^^3^3^3131106^"
^XWB(8994,3355,2,2,1,1,0)="This is the IENS through which you wish to search for the value VALUE. If "
^XWB(8994,3355,2,2,1,2,0)="you are searching the top level of a file, this should be null. See the "
^XWB(8994,3355,2,2,1,3,0)="FileMan Programmer's Manual for instructions on constructing IENS strings."
^XWB(8994,3355,2,3,0)="FIELD^1^250^1^3"
^XWB(8994,3355,2,3,1,0)="^^3^3^3131106^"
^XWB(8994,3355,2,3,1,1,0)=" This is an ^ (or "";"") delimited list of fields that you wish returned "
^XWB(8994,3355,2,3,1,2,0)="from each entry that matches the lookup conditions that you have "
^XWB(8994,3355,2,3,1,3,0)="specified."
^XWB(8994,3355,2,4,0)="NUMBER^1^5^0^4"
^XWB(8994,3355,2,4,1,0)="^^2^2^3131106^"
^XWB(8994,3355,2,4,1,1,0)="This is the maximum number of entries to be returned. Defaults to all "
^XWB(8994,3355,2,4,1,2,0)="entries matching the lookup value VALUE."
^XWB(8994,3355,2,5,0)="INDEX^1^50^0^6"
^XWB(8994,3355,2,5,1,0)="^^2^2^3131106^"
^XWB(8994,3355,2,5,1,1,0)="If you wish to do the lookup on specific indexes, then enter that here. "
^XWB(8994,3355,2,5,1,2,0)="The index string must be compliant with the FileMan documentation."
^XWB(8994,3355,2,6,0)="VALUE^1^100^1^5"
^XWB(8994,3355,2,6,1,0)="^^2^2^3131106^"
^XWB(8994,3355,2,6,1,1,0)="Enter a value that will be used by FileMan for the lookup. This call does "
^XWB(8994,3355,2,6,1,2,0)="not support the .VALUE syntax allowed by FIND^DIC."
^XWB(8994,3355,2,7,0)="SCREEN^1^250^0^7"
^XWB(8994,3355,2,7,1,0)="^^1^1^3131106^"
^XWB(8994,3355,2,7,1,1,0)="If you wish to use the DIC(""S"") equivalent then enter it here."
^XWB(8994,3355,2,8,0)="FLAGS^1^20^0^8"
^XWB(8994,3355,2,8,1,0)="^8994.021^1^1^3131106^^"
^XWB(8994,3355,2,8,1,1,0)="This is the FileMan FLAGS parameter used in the FILE^DIC API."
^XWB(8994,3355,2,"B","FIELD",3)=""
^XWB(8994,3355,2,"B","FILE",1)=""
^XWB(8994,3355,2,"B","FLAGS",8)=""
^XWB(8994,3355,2,"B","IENS",2)=""
^XWB(8994,3355,2,"B","INDEX",5)=""
^XWB(8994,3355,2,"B","NUMBER",4)=""
^XWB(8994,3355,2,"B","SCREEN",7)=""
^XWB(8994,3355,2,"B","VALUE",6)=""
^XWB(8994,3355,2,"PARAMSEQ",1,1)=""
^XWB(8994,3355,2,"PARAMSEQ",2,2)=""
^XWB(8994,3355,2,"PARAMSEQ",3,3)=""
^XWB(8994,3355,2,"PARAMSEQ",4,4)=""
^XWB(8994,3355,2,"PARAMSEQ",5,6)=""
^XWB(8994,3355,2,"PARAMSEQ",6,5)=""
^XWB(8994,3355,2,"PARAMSEQ",7,7)=""
^XWB(8994,3355,2,"PARAMSEQ",8,8)=""
^XWB(8994,3355,3,0)="^^17^17^3131106^"
^XWB(8994,3355,3,1,0)=" Returns an array in the following format:"
^XWB(8994,3355,3,2,0)=" "
^XWB(8994,3355,3,3,0)=" Array[0]=Number of entries found^Number of entries requested^Any more"
^XWB(8994,3355,3,4,0)=" entries to return?"
^XWB(8994,3355,3,5,0)=" "
^XWB(8994,3355,3,6,0)=" Array[1]-[n]=IEN^Values of fields requested in VEJDVAL (in order)"
^XWB(8994,3355,3,7,0)=" "
^XWB(8994,3355,3,8,0)=" For instance: if FILE=2 (the PATIENT file) and FIELD="".01^.09"""
^XWB(8994,3355,3,9,0)=" (name and SSAN respectively), then a sample return may look like:"
^XWB(8994,3355,3,10,0)=" "
^XWB(8994,3355,3,11,0)=" 1^CPRSPATIENT,FIRSTNAME1^000000001"
^XWB(8994,3355,3,12,0)=" 2^CPRSPATIENT,FIRSTNAME2^000000002"
^XWB(8994,3355,3,13,0)=" "
^XWB(8994,3355,3,14,0)=" but if FIELD="".09^.01"", you would see:"
^XWB(8994,3355,3,15,0)=" "
^XWB(8994,3355,3,16,0)=" 1^000000001^CPRSPATIENT,FIRSTNAME1"
^XWB(8994,3355,3,17,0)=" 2^000000002^CPRSPATIENT,FIRSTNAME2"
^XWB(8994,3356,0)="DSIV DDR FILER^FILE^DSIVDDR0^2^A"
^XWB(8994,3356,1,0)="^^3^3^3131106^"
^XWB(8994,3356,1,1,0)=" This calls FILE^DIE to file data.  It can only file data at a single"
^XWB(8994,3356,1,2,0)=" level (top, multiple, a multiple within a multiple, etc.).  It presumes"
^XWB(8994,3356,1,3,0)=" you know how to set Param[x] properly in Fileman syntax."
^XWB(8994,3356,2,0)="^8994.02A^4^4"
^XWB(8994,3356,2,1,0)="FILE^1^15^1^1"
^XWB(8994,3356,2,1,1,0)="^^2^2^3131106^"
^XWB(8994,3356,2,1,1,1,0)=" This is the file number (or subfile number) for which data is to be "
^XWB(8994,3356,2,1,1,2,0)="filed."
^XWB(8994,3356,2,2,0)="IENS^1^40^0^2"
^XWB(8994,3356,2,2,1,0)="^^3^3^3131106^"
^XWB(8994,3356,2,2,1,1,0)=" This is the IENS parameter to the FILE^DIE call.   If you are filing data"
^XWB(8994,3356,2,2,1,2,0)=" to a file at top level fields, then IENS must be <null>.   If you are"
^XWB(8994,3356,2,2,1,3,0)=" filing data to a subfile entry then IENS must be properly defined."
^XWB(8994,3356,2,3,0)="FLAGS^1^10^0^3"
^XWB(8994,3356,2,3,1,0)="^^2^2^3131106^"
^XWB(8994,3356,2,3,1,1,0)=" This is the FLAGS parameter used when invoking FILE^DIE."
^XWB(8994,3356,2,3,1,2,0)=" If no value is passed, then the default value is ""KE"""
^XWB(8994,3356,2,4,0)="DATA^2^250^1^4"
^XWB(8994,3356,2,4,1,0)="^^1^1^3131106^"
^XWB(8994,3356,2,4,1,1,0)=" This is an array of fields in format:  DATA(field_num)=value"
^XWB(8994,3356,2,"B","DATA",4)=""
^XWB(8994,3356,2,"B","FILE",1)=""
^XWB(8994,3356,2,"B","FLAGS",3)=""
^XWB(8994,3356,2,"B","IENS",2)=""
^XWB(8994,3356,2,"PARAMSEQ",1,1)=""
^XWB(8994,3356,2,"PARAMSEQ",2,2)=""
^XWB(8994,3356,2,"PARAMSEQ",3,3)=""
^XWB(8994,3356,2,"PARAMSEQ",4,4)=""
^XWB(8994,3356,3,0)="^^2^2^3131106^"
^XWB(8994,3356,3,1,0)="  Successful, return 1^"
^XWB(8994,3356,3,2,0)="  Else return -1^error message"
^XWB(8994,3357,0)="DSIV DDR DELETE ENTRY^KILL^DSIVDDR0^2^A"
^XWB(8994,3357,1,0)="^^1^1^3131106^"
^XWB(8994,3357,1,1,0)="This will delete a record from a file or subfile."
^XWB(8994,3357,2,0)="^8994.02A^2^2"
^XWB(8994,3357,2,1,0)="FILE^1^20^1^1"
^XWB(8994,3357,2,1,1,0)="^^1^1^3131106^"
^XWB(8994,3357,2,1,1,1,0)="This is the number of the file or subfile of the record to be deleted"
^XWB(8994,3357,2,2,0)="IENS^1^50^1^2"
^XWB(8994,3357,2,2,1,0)="^^2^2^3131106^"
^XWB(8994,3357,2,2,1,1,0)="This is the Fileman IENS input parameter.  Its value must be applicable"
^XWB(8994,3357,2,2,1,2,0)=" to the file or subfile for which a record is being deleted."
^XWB(8994,3357,2,"B","FILE",1)=""
^XWB(8994,3357,2,"B","IENS",2)=""
^XWB(8994,3357,2,"PARAMSEQ",1,1)=""
^XWB(8994,3357,2,"PARAMSEQ",2,2)=""
^XWB(8994,3357,3,0)="^^2^2^3131106^"
^XWB(8994,3357,3,1,0)="If the entry is successfully deleted, return 1^"
^XWB(8994,3357,3,2,0)=" Else return 0^message"
^XWB(8994,3358,0)="DSIV DDR UPDATE FILE^UPDATE^DSIVDDR0^2^A"
^XWB(8994,3358,1,0)="^^3^3^3131106^"
^XWB(8994,3358,1,1,0)="This will add a new record to a file, but only at the top level of the"
^XWB(8994,3358,1,2,0)=" file.   It does not allow for adding a new record to a multiple."
^XWB(8994,3358,1,3,0)=" Additional fields to be filed at the same time can be passed."
^XWB(8994,3358,2,0)="^8994.02A^2^2"
^XWB(8994,3358,2,1,0)="FILE^1^20^1^1"
^XWB(8994,3358,2,1,1,0)="^^1^1^3131106^"
^XWB(8994,3358,2,1,1,1,0)="This is the number of the file for which a new record is to be added"
^XWB(8994,3358,2,2,0)="DATA^2^250^1^2"
^XWB(8994,3358,2,2,1,0)="^^5^5^3131106^"
^XWB(8994,3358,2,2,1,1,0)="This is a list of fields which will have data for filing with the new"
^XWB(8994,3358,2,2,1,2,0)="record.  Obviously the .01 field must be present.  Format of data array:"
^XWB(8994,3358,2,2,1,3,0)="  DATA(field#)=internal value"
^XWB(8994,3358,2,2,1,4,0)=" "
^XWB(8994,3358,2,2,1,5,0)="  On the GUI side, Param.List['field#']= value"
^XWB(8994,3358,2,"B","DATA",2)=""
^XWB(8994,3358,2,"B","FILE",1)=""
^XWB(8994,3358,2,"PARAMSEQ",1,1)=""
^XWB(8994,3358,2,"PARAMSEQ",2,2)=""
^XWB(8994,3358,3,0)="^^2^2^3131106^"
^XWB(8994,3358,3,1,0)="If a new record is successfully created, return 1^new record number"
^XWB(8994,3358,3,2,0)="Else return, -1^message"
^XWB(8994,3359,0)="DSIV FM GET FIELD ATTRIB MULT^MULT^DSIVFM06^2^A"
^XWB(8994,3359,1,0)="^^2^2^3131106^"
^XWB(8994,3359,1,1,0)="This will return field attributes from a selected file for one or more "
^XWB(8994,3359,1,2,0)="fields."
^XWB(8994,3359,2,0)="^8994.02A^1^1"
^XWB(8994,3359,2,1,0)="DSIN^2^50^1^1"
^XWB(8994,3359,2,1,1,0)="^^24^24^3131106^"
^XWB(8994,3359,2,1,1,1,0)=" DSIN(i) := label ^ value   for i = 0,1,2,3,4,..."
^XWB(8994,3359,2,1,1,2,0)=" "
^XWB(8994,3359,2,1,1,3,0)=" Label can be one of five values:"
^XWB(8994,3359,2,1,1,4,0)="   FILE - req - file (or subfile) number or file name"
^XWB(8994,3359,2,1,1,5,0)=" "
^XWB(8994,3359,2,1,1,6,0)="   FLAG - opt - N or <null>   - default value is <null>"
^XWB(8994,3359,2,1,1,7,0)="                if FLAG[""N"" - do not return attributes which are <null>"
^XWB(8994,3359,2,1,1,8,0)=" "
^XWB(8994,3359,2,1,1,9,0)="    ATT - req - list of field attributes to return"
^XWB(8994,3359,2,1,1,10,0)="                this can be a ';'-delimited string of field attribute "
^XWB(8994,3359,2,1,1,11,0)="                names or individual field attribute names"
^XWB(8994,3359,2,1,1,12,0)=" "
^XWB(8994,3359,2,1,1,13,0)="                Examples: DSIN(i)=""ATT^LABEL;TYPE;GLOBAL LOCATION;"""
^XWB(8994,3359,2,1,1,14,0)="                          DSIN(i)=""ATT^SPECIFIER"""
^XWB(8994,3359,2,1,1,15,0)="                          DSIN(i)=""ATT^*"" - the '*' means get all field "
^XWB(8994,3359,2,1,1,16,0)="                                   attrib"
^XWB(8994,3359,2,1,1,17,0)=" "
^XWB(8994,3359,2,1,1,18,0)="   FIELD - req - field number or field name"
^XWB(8994,3359,2,1,1,19,0)="                 Examples: DSIN(i)=""FIELD^.01"""
^XWB(8994,3359,2,1,1,20,0)="                           DSIN(i)=""FIELD^.01;.02;.03;.09"""
^XWB(8994,3359,2,1,1,21,0)="                           DSIN(i)=""FIELD^.01:.09"""
^XWB(8994,3359,2,1,1,22,0)="                           DSIN(i)=""FIELD^.01;.02;.03;1:9;99"""
^XWB(8994,3359,2,1,1,23,0)="                 Field numbers (or names) can be separated by ';'"
^XWB(8994,3359,2,1,1,24,0)="                 An inclusive range of field numbers is separated by ':'"
^XWB(8994,3359,2,"B","DSIN",1)=""
^XWB(8994,3359,2,"PARAMSEQ",1,1)=""
^XWB(8994,3359,3,0)="^^8^8^3131106^"
^XWB(8994,3359,3,1,0)=" On error or problems, return List[0] := -1^message"
^XWB(8994,3359,3,2,0)=" "
^XWB(8994,3359,3,3,0)=" Else, return"
^XWB(8994,3359,3,4,0)="   List[i] := field # ^ attribute name ^ attribute value"
^XWB(8994,3359,3,5,0)="     for i = 0,1,2,3,4,..."
^XWB(8994,3359,3,6,0)=" "
^XWB(8994,3359,3,7,0)=" Attribute value will be a line of text if the field attribute is a word"
^XWB(8994,3359,3,8,0)=" processing type."
^XWB(8994,3360,0)="DSIV FM FILER^FILE^DSIVFM04^2^A"
^XWB(8994,3360,1,0)="^^5^5^3131106^"
^XWB(8994,3360,1,1,0)="This invokes the Fileman filer to update records for an existing entry."
^XWB(8994,3360,1,2,0)="This will allow you to update any field at the level of the FILE including"
^XWB(8994,3360,1,3,0)="word processing fields.  It does not allow for updating different levels"
^XWB(8994,3360,1,4,0)="of the file.  If you wish to update a subfile, then you will have to make"
^XWB(8994,3360,1,5,0)="multiple calls to this RPC for each file or subfile."
^XWB(8994,3360,2,0)="^8994.02A^4^4"
^XWB(8994,3360,2,1,0)="FILE^1^20^1^1"
^XWB(8994,3360,2,1,1,0)="^^1^1^3131106^"
^XWB(8994,3360,2,1,1,1,0)="This is the file (or subfile) number for record which you wish to update"
^XWB(8994,3360,2,2,0)="IENS^1^50^1^2"
^XWB(8994,3360,2,2,1,0)="^^6^6^3131106^"
^XWB(8994,3360,2,2,1,1,0)="This is the standard Fileman IENS for calling the Fileman DBS APIs.  The"
^XWB(8994,3360,2,2,1,2,0)="format of iens is as follows (must have trailing commas):"
^XWB(8994,3360,2,2,1,3,0)="   record#, - to update a record at the top level of a file"
^XWB(8994,3360,2,2,1,4,0)=" "
^XWB(8994,3360,2,2,1,5,0)="   sub1,ifn1, - to update multiple record sub1 in the file for record ifn1"
^XWB(8994,3360,2,2,1,6,0)="   sub2,sub1,ifn1 - update a multiple within a multiple within a file"
^XWB(8994,3360,2,3,0)="FLAG^1^1^0^3"
^XWB(8994,3360,2,3,1,0)="^^5^5^3131106^"
^XWB(8994,3360,2,3,1,1,0)="This parameter is optional.  If passed it must be equal to ""T"""
^XWB(8994,3360,2,3,1,2,0)="FLAG=""T"" indicates that you wish transaction processing to occur.  That"
^XWB(8994,3360,2,3,1,3,0)="is, all of the fields must successfully be updated or none of them are"
^XWB(8994,3360,2,3,1,4,0)="updated.  Without this flag, Fileman will update those fields that he "
^XWB(8994,3360,2,3,1,5,0)="can."
^XWB(8994,3360,2,4,0)="INPUT^2^250^1^4"
^XWB(8994,3360,2,4,1,0)="^^30^30^3131106^"
^XWB(8994,3360,2,4,1,1,0)=" This list contains the fields to be updated in the file (or subfile)."
^XWB(8994,3360,2,4,1,2,0)=" The format of INPUT(x) = p1^p2^p3  where"
^XWB(8994,3360,2,4,1,3,0)=" "
^XWB(8994,3360,2,4,1,4,0)="    x - the subscript of INPUT can be anything, numeric, string"
^XWB(8994,3360,2,4,1,5,0)=" "
^XWB(8994,3360,2,4,1,6,0)="   p1 - required - this is the field number at the level in the file"
^XWB(8994,3360,2,4,1,7,0)=" "
^XWB(8994,3360,2,4,1,8,0)="   p2 - optional - default value is ""I"" - this flag indicates the type"
^XWB(8994,3360,2,4,1,9,0)="        value being passed in, internal format, external format, word"
^XWB(8994,3360,2,4,1,10,0)="        processing"
^XWB(8994,3360,2,4,1,11,0)="          p2 = I - value is in Fileman internal format"
^XWB(8994,3360,2,4,1,12,0)="          p2 = E - value is on external format"
^XWB(8994,3360,2,4,1,13,0)="          p2 = W or WA - this field is a word processing field"
^XWB(8994,3360,2,4,1,14,0)="               see notes below for additional details for this"
^XWB(8994,3360,2,4,1,15,0)=" "
^XWB(8994,3360,2,4,1,16,0)="   p3 - required - this is the value to be entered for this field#"
^XWB(8994,3360,2,4,1,17,0)=" "
^XWB(8994,3360,2,4,1,18,0)=" Notes on word process fields"
^XWB(8994,3360,2,4,1,19,0)=" ----------------------------"
^XWB(8994,3360,2,4,1,20,0)="   if INPUT(x) = field#^W^@ then delete any existing text for this record"
^XWB(8994,3360,2,4,1,21,0)="   if INPUT(x) = field#^W^text then this will first remove any existing"
^XWB(8994,3360,2,4,1,22,0)="                 text that may exist.  It will then add the new text"
^XWB(8994,3360,2,4,1,23,0)="   if INPUT(x) = field#^WA^text then this will not delete the existing"
^XWB(8994,3360,2,4,1,24,0)="                 text but will append the new text to the existing text if"
^XWB(8994,3360,2,4,1,25,0)="                 there is any"
^XWB(8994,3360,2,4,1,26,0)=" "
^XWB(8994,3360,2,4,1,27,0)="   For the same field# all lines of the array must have the same value for"
^XWB(8994,3360,2,4,1,28,0)="   the second piece.  That is, all must be W or WA.  You cannot have some"
^XWB(8994,3360,2,4,1,29,0)="   as W and some as WA.  Each field# can have its own type.  Field 1 could"
^XWB(8994,3360,2,4,1,30,0)="   be W and field 2 could be WA."
^XWB(8994,3360,2,"B","FILE",1)=""
^XWB(8994,3360,2,"B","FLAG",3)=""
^XWB(8994,3360,2,"B","IENS",2)=""
^XWB(8994,3360,2,"B","INPUT",4)=""
^XWB(8994,3360,2,"PARAMSEQ",1,1)=""
^XWB(8994,3360,2,"PARAMSEQ",2,2)=""
^XWB(8994,3360,2,"PARAMSEQ",3,3)=""
^XWB(8994,3360,2,"PARAMSEQ",4,4)=""
^XWB(8994,3360,3,0)="^^3^3^3131106^"
^XWB(8994,3360,3,1,0)=" If no problems are encountered filing data, then return LIST[1] := 1^"
^XWB(8994,3360,3,2,0)=" Else return LIST[1] := -1^general error message"
^XWB(8994,3360,3,3,0)="             LIST[2...n] := additional specific error messages"
^XWB(8994,3361,0)="DSIV LIMIT EIV^LIMITEIV^DSIVUTL^1^A^^^1"
^XWB(8994,3361,1,0)="^^4^4^3141112^"
^XWB(8994,3361,1,1,0)="This RPC returns the value of field #62.01 (LIMIT OF EIV FIELDS?) from "
^XWB(8994,3361,1,2,0)="file #350.9 (IB SITE PARAMETERS).  This is to allow the GUI to know how "
^XWB(8994,3361,1,3,0)="many characters are allowed to be entered for SUBSCRIBER ADDRESS LINE 1 "
^XWB(8994,3361,1,4,0)="and SUBSCRIBER ADDRESS LINE 2."
^XWB(8994,3361,3,0)="^^7^7^3141112^"
^XWB(8994,3361,3,1,0)="This RPC will return one of two results:"
^XWB(8994,3361,3,2,0)=" "
^XWB(8994,3361,3,3,0)="1^The EIV field is not limited"
^XWB(8994,3361,3,4,0)="0^The EIV field is limited"
^XWB(8994,3361,3,5,0)=" "
^XWB(8994,3361,3,6,0)="If 1 is returned, the GUI may use the new extended character limits"
^XWB(8994,3361,3,7,0)="Else, GUI should function as before with shorter character limits"
^XWB(8994,3362,0)="VPS GET CLINICAL REMINDERS^REMIND^VPSPTCR^2^P^0"
^XWB(8994,3362,1,0)="^8994.01^2^2^3140926^^^"
^XWB(8994,3362,1,1,0)="Called by the Vetlink Kiosk system. The RPC returns the DUE NOW Clinical "
^XWB(8994,3362,1,2,0)="Reminders for the patient."
^XWB(8994,3362,2,0)="^8994.02A^6^5"
^XWB(8994,3362,2,1,0)="DFN^1^12^1^1"
