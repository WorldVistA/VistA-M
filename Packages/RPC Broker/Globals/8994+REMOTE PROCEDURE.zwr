^XWB(8994,364,3,0)="^8994.03^7^7^3030317^^^^"
^XWB(8994,364,3,1,0)="If validation fails the following is returned to the client:"
^XWB(8994,364,3,2,0)=""
^XWB(8994,364,3,3,0)="  Results[0]   = '-1^Validation Falure'"
^XWB(8994,364,3,4,0)=""
^XWB(8994,364,3,5,0)="If validation is successful the following is returned to the client:"
^XWB(8994,364,3,6,0)=""
^XWB(8994,364,3,7,0)="  Results[0] = internal FM Date/Time^External FM Date/Time"
^XWB(8994,366,0)="PSB SCANMED^SCANMED^PSBRPC2^2^P^^^^2"
^XWB(8994,366,1,0)="^8994.01^3^3^3030317^^^^"
^XWB(8994,366,1,1,0)="Takes the scanned valued from the medication and does a lookup on file "
^XWB(8994,366,1,2,0)="50 for an exact match.  If more than one or less than one entry are "
^XWB(8994,366,1,3,0)="found for the lookup an error is returned to the client."
^XWB(8994,366,2,0)="^8994.02A^3^2"
^XWB(8994,366,2,1,0)="SCANVAL^1^30^1^1"
^XWB(8994,366,2,1,1,0)="^^1^1^2990216^"
^XWB(8994,366,2,1,1,1,0)="This is the data received from the client scanning the medication."
^XWB(8994,366,2,2,0)="PSBDIEN^1^^1^1"
^XWB(8994,366,2,2,1,0)="^8994.021^3^3^3030312^^"
^XWB(8994,366,2,2,1,1,0)="Takes the scanned valued from the medication and does a lookup on file"
^XWB(8994,366,2,2,1,2,0)="50 for an exact match.  If more than one or less than one entry are"
^XWB(8994,366,2,2,1,3,0)="found for the lookup an error is returned to the client."
^XWB(8994,366,2,3,0)="PSBTAB^1^20^1^2"
^XWB(8994,366,2,3,1,0)="^8994.021^1^1^3030317^^^^"
^XWB(8994,366,2,3,1,1,0)="This is the current tab the user is on."
^XWB(8994,366,2,"B","PSBDIEN",2)=""
^XWB(8994,366,2,"B","PSBTAB",3)=""
^XWB(8994,366,2,"B","SCANVAL",1)=""
^XWB(8994,366,2,"PARAMSEQ",1,1)=""
^XWB(8994,366,2,"PARAMSEQ",1,2)=""
^XWB(8994,366,2,"PARAMSEQ",2,3)=""
^XWB(8994,366,3,0)="^^10^10^3030317^"
^XWB(8994,366,3,1,0)="Return on error:"
^XWB(8994,366,3,2,0)=" "
^XWB(8994,366,3,3,0)="  Results[0] = '-1^Unable to determine exact medication'"
^XWB(8994,366,3,4,0)=" "
^XWB(8994,366,3,5,0)="Return on successful scan:"
^XWB(8994,366,3,6,0)=" "
^XWB(8994,366,3,7,0)="  Results[0] = number of items returned in the results array."
^XWB(8994,366,3,8,0)="  Results[1] = DD^IEN^Generic Name"
^XWB(8994,366,3,9,0)="               SOL^IEN^Generic Name"
^XWB(8994,366,3,10,0)="               ADD^IEN^Generic Name"
^XWB(8994,367,0)="PSB PARAMETER^RPC^PSBPAR^2^P^^^^2"
^XWB(8994,367,1,0)="^8994.01^1^1^3040127^^^^"
^XWB(8994,367,1,1,0)="Called by client to return or set parameters"
^XWB(8994,367,2,0)="^8994.02A^5^5"
^XWB(8994,367,2,1,0)="PSBCMD^1^6^1^1"
^XWB(8994,367,2,1,1,0)="^8994.021^6^6^3030728^^^^"
^XWB(8994,367,2,1,1,1,0)="Contains the command to perform against the system parameters."
^XWB(8994,367,2,1,1,2,0)=""
^XWB(8994,367,2,1,1,3,0)="GETPAR: Get a single instance of a parameter"
^XWB(8994,367,2,1,1,4,0)="GETLST: Get all instances of a multiple valued parameter"
^XWB(8994,367,2,1,1,5,0)="SETPAR: Set a single instance of a parameter"
^XWB(8994,367,2,1,1,6,0)="CLRLST: Clear all instances of parameters in a list"
^XWB(8994,367,2,2,0)="PSBENT^1^30^1^2"
^XWB(8994,367,2,2,1,0)="^8994.021^1^1^3030728^^^"
^XWB(8994,367,2,2,1,1,0)="Contains the entity to act upon.  Usually ""###;DIC(4,"" for division."
^XWB(8994,367,2,3,0)="PSBPAR^1^30^1^3"
^XWB(8994,367,2,3,1,0)="^8994.021^1^1^3030728^^^"
^XWB(8994,367,2,3,1,1,0)="The parameter as defined in file 8989.51."
^XWB(8994,367,2,4,0)="PSBINS^1^30^0^4"
^XWB(8994,367,2,4,1,0)="^8994.021^1^1^3030728^^^"
^XWB(8994,367,2,4,1,1,0)="The instance of the parameter that you want to return.  Defaults to 1."
^XWB(8994,367,2,5,0)="PSBVAL^1^80^0^5"
^XWB(8994,367,2,5,1,0)="^8994.021^2^2^3040127^^^^"
^XWB(8994,367,2,5,1,1,0)="If setting a parameter this contains the data value to place in the "
^XWB(8994,367,2,5,1,2,0)="parameter."
^XWB(8994,367,2,"B","PSBCMD",1)=""
^XWB(8994,367,2,"B","PSBENT",2)=""
^XWB(8994,367,2,"B","PSBINS",4)=""
^XWB(8994,367,2,"B","PSBPAR",3)=""
^XWB(8994,367,2,"B","PSBVAL",5)=""
^XWB(8994,367,2,"PARAMSEQ",1,1)=""
^XWB(8994,367,2,"PARAMSEQ",2,2)=""
^XWB(8994,367,2,"PARAMSEQ",3,3)=""
^XWB(8994,367,2,"PARAMSEQ",4,4)=""
^XWB(8994,367,2,"PARAMSEQ",5,5)=""
^XWB(8994,368,0)="PSB TRANSACTION^RPC^PSBML^2^P^^^^3"
^XWB(8994,368,1,0)="^8994.01^169^169^3160419^^"
^XWB(8994,368,1,1,0)="This is the filing RPC for all data returning from the client"
^XWB(8994,368,1,2,0)="regarding the medication log.  Filing is handled by business rules on"
^XWB(8994,368,1,3,0)="the server and this RPC will return either '1^Data Filed' or"
^XWB(8994,368,1,4,0)="'-1^reason for not filing data' to the client.  Results of the "
^XWB(8994,368,1,5,0)="processed transaction is communicated via the RESULTS array.  The "
^XWB(8994,368,1,6,0)="number of RESULTS subscripts used (n) will be presented in RESULTS[0].  "
^XWB(8994,368,1,7,0)="RESULTS [1..n] will contain the RESULTS message.  "
^XWB(8994,368,1,8,0)=" "
^XWB(8994,368,1,9,0)="Business rules are conducted via the [0] node data (Input parameter "
^XWB(8994,368,1,10,0)="sequence 1). If a '+1^MEDPASS' is encountered it is a complete new med "
^XWB(8994,368,1,11,0)="pass and is validated as such.  Transaction type MEDPASS is the only type "
^XWB(8994,368,1,12,0)="that requires a +1 in the first piece of the header, all other "
^XWB(8994,368,1,13,0)="transactions MUST supply a valid medication log entry in the IENS."
^XWB(8994,368,1,14,0)=" "
^XWB(8994,368,1,15,0)="The data for filing is passed in as a list in Param[1] as shown below."
^XWB(8994,368,1,16,0)=" "
^XWB(8994,368,1,17,0)="Example Delphi Call"
^XWB(8994,368,1,18,0)=" "
^XWB(8994,368,1,19,0)="  with RPCBroker1 do"
^XWB(8994,368,1,20,0)="    begin"
^XWB(8994,368,1,21,0)="    RemoteProcedure := 'PSB TRANSACTION';"
^XWB(8994,368,1,22,0)="    Param[0].Value := '88484^COMMENT';"
^XWB(8994,368,1,23,0)="    Param[0].PType := Literal;"
^XWB(8994,368,1,24,0)="    Param[1].Mult['0'] := 'Comment for the med pass';"
^XWB(8994,368,1,25,0)="    Param[1].Ptype := List;"
^XWB(8994,368,1,26,0)="    Call;"
^XWB(8994,368,1,27,0)="    end;"
^XWB(8994,368,1,28,0)=" "
^XWB(8994,368,1,29,0)="BUSINESS LOGIC controlled by Param[0]:"
^XWB(8994,368,1,30,0)=" "
^XWB(8994,368,1,31,0)="Param[0] = MEDLOG IEN ^ TRANSACTION ^ INSTRUCTOR DUZ ^ WITNESS DUZ"
^XWB(8994,368,1,32,0)="           ^ WITNESS COMMENT ^ WITNESS HR ORDER LEVEL CODE"
^XWB(8994,368,1,33,0)=" "
^XWB(8994,368,1,34,0)="-------------------------------------------------------------------------"
^XWB(8994,368,1,35,0)="TRANSACTION = MEDPASS  (this is the MEDLOG ADD a new transaction)"
^XWB(8994,368,1,36,0)="   Note: Entries 1-6 are required, 7,8,9 are required depending on "
^XWB(8994,368,1,37,0)="         item [2] order type..."
^XWB(8994,368,1,38,0)=" "
^XWB(8994,368,1,39,0)=" [0] = Patient IEN"
^XWB(8994,368,1,40,0)=" "
^XWB(8994,368,1,41,0)=" "
^XWB(8994,368,1,42,0)=" [1] = IV/Unit Dose Order Number ^ Clinic Name (if a clinic order)"
^XWB(8994,368,1,43,0)="   Note: will be passed in as I;#### for IV and U;#### for Unit Dose"
^XWB(8994,368,1,44,0)="         future release will allow P;#### for pending"
^XWB(8994,368,1,45,0)=" "
^XWB(8994,368,1,46,0)=" [2] = Schedule"
^XWB(8994,368,1,47,0)="   Note: C:Continuous P:PRN 1:One Time O:On Call"
^XWB(8994,368,1,48,0)=" "
^XWB(8994,368,1,49,0)=" [3] = Status"
^XWB(8994,368,1,50,0)="   Note: G:Given H:Held R:Refused"
^XWB(8994,368,1,51,0)=" "
^XWB(8994,368,1,52,0)=" [4] = Orderable Item"
^XWB(8994,368,1,53,0)="   Note: IEN to 'PHARMACY ORDERABLE ITEM' (#50.7)"
^XWB(8994,368,1,54,0)=" "
^XWB(8994,368,1,55,0)=" [5] = Scheduled Administration Date/Time"
^XWB(8994,368,1,56,0)="   Note: This is when the med is scheduled, med is entered as GIVEN NOW!"
^XWB(8994,368,1,57,0)=" "
^XWB(8994,368,1,58,0)=" [6] = Reason Given PRN^PRN Reason Flag"
^XWB(8994,368,1,59,0)="   Note: Required if given PRN must be null if not PRN"
^XWB(8994,368,1,60,0)=" "
^XWB(8994,368,1,61,0)=" [7] = Comment"
^XWB(8994,368,1,62,0)="   Note: 1-200 characters"
^XWB(8994,368,1,63,0)=" "
^XWB(8994,368,1,64,0)=" [8] = Injection Site"
^XWB(8994,368,1,65,0)=" [9] = Tab^Unique ID #"
^XWB(8994,368,1,66,0)="[10] = Schedule Removal Date/Time"
^XWB(8994,368,1,67,0)="       Note:This is when the med is scheduled to be removed and not the "
^XWB(8994,368,1,68,0)="            actual removal transaction date/time.  "
^XWB(8994,368,1,69,0)=" "
^XWB(8994,368,1,70,0)="[11..n] = RecordType^IEN^Units Ordered^Units Given^Units Type^^HR code^MRR"
^XWB(8994,368,1,71,0)="          code"
^XWB(8994,368,1,72,0)=" "
^XWB(8994,368,1,73,0)="          1) Record Type = DD:  Dispense Drug"
^XWB(8994,368,1,74,0)="                          SOL:  Solution"
^XWB(8994,368,1,75,0)="                          ADD:  Additive"
^XWB(8994,368,1,76,0)=" "
^XWB(8994,368,1,77,0)="          2) IEN = Internal Entry Number of the following"
^XWB(8994,368,1,78,0)="                   if Record Type = DD:  DRUG (FILE #50)  "
^XWB(8994,368,1,79,0)="                                SOL: IV SOLUTIONS (FILE #??)"
^XWB(8994,368,1,80,0)="                                ADD: IV ADDITIVES (FILE #??)"
^XWB(8994,368,1,81,0)=" "
^XWB(8994,368,1,82,0)="          3) Units Ordered = Number of units in the Inpt Meds Order"
^XWB(8994,368,1,83,0)=" "
^XWB(8994,368,1,84,0)="          4) Units Given = Number of units scanned/entered by the user"
^XWB(8994,368,1,85,0)=" "
^XWB(8994,368,1,86,0)="          5) Units Type = Type of administration unit (i.e. TAB, CAP,ML)"
^XWB(8994,368,1,87,0)=" "
^XWB(8994,368,1,88,0)="          6) n/a"
^XWB(8994,368,1,89,0)=" "
^XWB(8994,368,1,90,0)="          7) Orderable Item High Risk/High Alert code value"
^XWB(8994,368,1,91,0)="                (HR = 1, 2, or 3)"
^XWB(8994,368,1,92,0)="          8) Orderable Item Prompt For Removal In BCMA code value"
^XWB(8994,368,1,93,0)="                (MRR = 0, 1, or 3)"
^XWB(8994,368,1,94,0)=" "
^XWB(8994,368,1,95,0)="-------------------------------------------------------------------------"
^XWB(8994,368,1,96,0)="TRANSACTION = COMMENT"
^XWB(8994,368,1,97,0)=" "
^XWB(8994,368,1,98,0)=" [0] = Comment to append to the log entry"
^XWB(8994,368,1,99,0)="   Note: Will be appended to the log with user ien and NOW as a date"
^XWB(8994,368,1,100,0)=" "
^XWB(8994,368,1,101,0)="-------------------------------------------------------------------------"
^XWB(8994,368,1,102,0)="TRANSACTION = PRN EFFECTIVENESS"
^XWB(8994,368,1,103,0)=" "
^XWB(8994,368,1,104,0)=" [0] = Effective Comment"
^XWB(8994,368,1,105,0)="   Note: will be filed as entered now by current user"
^XWB(8994,368,1,106,0)=" "
^XWB(8994,368,1,107,0)=" -------------------------------------------------------------------------"
^XWB(8994,368,1,108,0)="TRANSACTION = STATUS UPDATE"
^XWB(8994,368,1,109,0)=" "
^XWB(8994,368,1,110,0)=" [0] = New Status"
^XWB(8994,368,1,111,0)="   Note: If status is Given, Date/Time administered D/T will be set to NOW"
^XWB(8994,368,1,112,0)="         If status is Held/Refused administered D/T will be set to null"
^XWB(8994,368,1,113,0)="         Status on med log must be <> null to execute."
^XWB(8994,368,1,114,0)="         New status must NOT match current status or G will overwrite "
^XWB(8994,368,1,115,0)="         administration DT."
^XWB(8994,368,1,116,0)=" "
^XWB(8994,368,1,117,0)=" [1] = Comment"
^XWB(8994,368,1,118,0)="   Note: Comment *IS* Required"
^XWB(8994,368,1,119,0)=" "
^XWB(8994,368,1,120,0)=" [2] = Injection Site"
^XWB(8994,368,1,121,0)=" "
^XWB(8994,368,1,122,0)=" [3] ="
^XWB(8994,368,1,123,0)=" "
^XWB(8994,368,1,124,0)=" [4] = RecordType^IEN^Units Ordered^Units Given^Units Type^^HR code^MRR"
^XWB(8994,368,1,125,0)="       code"
^XWB(8994,368,1,126,0)=" "
^XWB(8994,368,1,127,0)="          1) Record Type = DD:  Dispense Drug"
^XWB(8994,368,1,128,0)="                          SOL:  Solution"
^XWB(8994,368,1,129,0)="                          ADD:  Additive"
^XWB(8994,368,1,130,0)=" "
^XWB(8994,368,1,131,0)="          2) IEN = Internal Entry Number of the following"
^XWB(8994,368,1,132,0)="                   if Record Type = DD:  DRUG (FILE #50)"
^XWB(8994,368,1,133,0)="                                SOL: IV SOLUTIONS (FILE #??)"
^XWB(8994,368,1,134,0)="                                ADD: IV ADDITIVES (FILE #??)"
^XWB(8994,368,1,135,0)=" "
^XWB(8994,368,1,136,0)="          3) Units Ordered = Number of units in the Inpt Meds Order"
^XWB(8994,368,1,137,0)=" "
^XWB(8994,368,1,138,0)="          4) Units Given = Number of units scanned/entered by the user"
^XWB(8994,368,1,139,0)=" "
^XWB(8994,368,1,140,0)="          5) Units Type = Type of administration unit (i.e. TAB, CAP,ML)"
^XWB(8994,368,1,141,0)=" "
^XWB(8994,368,1,142,0)="          6) n/a"
^XWB(8994,368,1,143,0)=" "
^XWB(8994,368,1,144,0)="          7) Orderable Item High Risk/High Alert code value"
^XWB(8994,368,1,145,0)="                (HR = 1, 2, or 3)"
^XWB(8994,368,1,146,0)="          8) Orderable Item Prompt For Removal In BCMA code value"
^XWB(8994,368,1,147,0)="                (MRR = 0, 1, or 3)"
^XWB(8994,368,1,148,0)=" "
^XWB(8994,368,1,149,0)=" "
