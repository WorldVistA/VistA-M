^XWB(8994,4476,3,0)="^8994.03^4^4^3200609^^"
^XWB(8994,4476,3,1,0)="Header:  T01000URL"
^XWB(8994,4476,3,2,0)=" "
^XWB(8994,4476,3,3,0)="Data:  URL of VVC Web app if appointment is for a VVC clinic, null "
^XWB(8994,4476,3,4,0)="otherwise."
^XWB(8994,4477,0)="PSOERXI1 INCERX^INCERX^PSOERXI1^1^R^^^1^^^1"
^XWB(8994,4477,1,0)="^^3^3^3191016^"
^XWB(8994,4477,1,1,0)="This RPC receives incoming eRx messages that are in the 2017 script "
^XWB(8994,4477,1,2,0)="format. This RPC replaces PSOERXA1 INCERX, which was the RPC used for the "
^XWB(8994,4477,1,3,0)="10.6 script format."
^XWB(8994,4477,2,0)="^8994.02A^10^10"
^XWB(8994,4477,2,1,0)="XML^1^^1^1"
^XWB(8994,4477,2,1,1,0)="^^2^2^3191016^"
^XWB(8994,4477,2,1,1,1,0)="Part of the XML of the incoming eRx message. The XML can be large enough "
^XWB(8994,4477,2,1,1,2,0)="that it is split into multiple parts."
^XWB(8994,4477,2,2,0)="PRCHK^2^^0^2"
^XWB(8994,4477,2,2,1,0)="^^1^1^3191016^"
^XWB(8994,4477,2,2,1,1,0)="This is the provider check results from the eRx middleware."
