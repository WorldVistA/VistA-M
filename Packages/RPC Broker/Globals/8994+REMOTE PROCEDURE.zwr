^XWB(8994,3985,3,11,0)="RET(0)=-1^ITEM HAS OUTSTANDING ORDERS:"
^XWB(8994,3985,3,12,0)="RET(1..n)=IEN of outstanding order (file #445.3)"
^XWB(8994,3985,3,13,0)=" "
^XWB(8994,3985,3,14,0)="After this are two sections:"
^XWB(8994,3985,3,15,0)=" "
^XWB(8994,3985,3,16,0)="RET(n)=$$START CODE SHEET$$"
^XWB(8994,3985,3,17,0)="   below this are any error messages pertaining to sending code sheet"
^XWB(8994,3985,3,18,0)="   (warehouse inventory points only)"
^XWB(8994,3985,3,19,0)="   Nothing in here means success"
^XWB(8994,3985,3,20,0)=" "
^XWB(8994,3985,3,21,0)="RET(n)=$$START DISTRIBUTION POINTS$$"
^XWB(8994,3985,3,22,0)="If DELDIST=1, subsequent lines are:"
^XWB(8994,3985,3,23,0)="   RET(m)=DIST PT IEN^DIST PT NAME^ITEM DELETED"
^XWB(8994,3985,3,24,0)="   or"
^XWB(8994,3985,3,25,0)="   RET(m)=-DIST PT IEN^DIST PT NAME^Error Message"
^XWB(8994,3985,3,26,0)="Otherwise, subsequent lines are:"
^XWB(8994,3985,3,27,0)="   RET(m)=DIST PT IEN^DIST PT NAME"
