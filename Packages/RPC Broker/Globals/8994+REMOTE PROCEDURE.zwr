^XWB(8994,3492,2,2,1,2,0)=" ""R""=Reminder Letter"
^XWB(8994,3492,2,2,1,3,0)=" ""C"" or ""A""=Clinic Cancellation Letter"
^XWB(8994,3492,2,2,1,4,0)=" ""N""=No Show Letter"
^XWB(8994,3492,2,"B","SDECLT",2)=""
