^XWB(8994,2536,2,10,1,2,0)="GROUP INSURANCE PLAN file (#355.3).  1=TRUE (Create new entry)"
^XWB(8994,2536,2,10,1,3,0)="0=FALSE (Default - Do not create new entry)."
