^XWB(8994,2567,3,1,0)="Zero value of the first '^'-piece of the Results[0] indicates that an"
^XWB(8994,2567,3,2,0)="error occurred during the execution of the procedure. In this case, the"
^XWB(8994,2567,3,3,0)="errors are returned in the Results array as shown below:"
^XWB(8994,2567,3,4,0)="  "
^XWB(8994,2567,3,5,0)="  Results[0]            Result descriptor"
^XWB(8994,2567,3,6,0)="                          ^01: 0"
^XWB(8994,2567,3,7,0)="                          ^02: Message"
^XWB(8994,2567,3,8,0)="  "
^XWB(8994,2567,3,9,0)="  Results[i]            Error descriptor"
^XWB(8994,2567,3,10,0)="                          ^01: Error code"
^XWB(8994,2567,3,11,0)="                          ^02: Message"
^XWB(8994,2567,3,12,0)="                          ^03: Error location"
^XWB(8994,2567,3,13,0)="                          ^04: Message type"
^XWB(8994,2567,3,14,0)=" "
^XWB(8994,2567,3,15,0)="  Results[j]            Line of the additional info (optional)"
^XWB(8994,2567,3,16,0)="                          ^01: """" (empty)"
^XWB(8994,2567,3,17,0)="                          ^02: Text"
^XWB(8994,2567,3,18,0)="  "
^XWB(8994,2567,3,19,0)="Otherwise, '1^Ok' is returned in the Results[0] and subsequent nodes "
^XWB(8994,2567,3,20,0)="contain property values:"
^XWB(8994,2567,3,21,0)=" "
^XWB(8994,2567,3,22,0)="  Results[i]            Property value"
^XWB(8994,2567,3,23,0)="                          ^01: Property name"
^XWB(8994,2567,3,24,0)="                          ^02: """" (empty)"
^XWB(8994,2567,3,25,0)="                          ^03: Internal property value if the 'I' flag"
^XWB(8994,2567,3,26,0)="                               is provided. Otherwise - empty."
^XWB(8994,2567,3,27,0)="                          ^04: External property value if the 'E' flag"
^XWB(8994,2567,3,28,0)="                               is provided. Otherwise - empty."
^XWB(8994,2567,3,29,0)=" "
^XWB(8994,2567,3,30,0)="Word-processing values are returned as follows: "
^XWB(8994,2567,3,31,0)=" "
^XWB(8994,2567,3,32,0)="  Results[i]            Line of a word-processing property value"
^XWB(8994,2567,3,33,0)="                          ^01: Property name"
^XWB(8994,2567,3,34,0)="                          ^02: Sequential number"
^XWB(8994,2567,3,35,0)="                          ^03: Line of text"
^XWB(8994,2567,3,36,0)="                          ^02: Sequential number"
^XWB(8994,2567,3,37,0)="                          ^03: Line of text"
^XWB(8994,2568,0)="MAGG REASON GET PROPERTIES^GET^MAGGA01^2^R^^^1"
^XWB(8994,2568,1,0)="^8994.01^2^2^3090513^^^^"
^XWB(8994,2568,1,1,0)="This remote procedure returns the reason properties from the MAG REASON"
^XWB(8994,2568,1,2,0)="file (#2005.88)"
^XWB(8994,2568,2,0)="^8994.02A^2^2"
^XWB(8994,2568,2,1,0)="RSNID^1^^1^1"
^XWB(8994,2568,2,1,1,0)="^^2^2^3090513^"
^XWB(8994,2568,2,1,1,1,0)="Identifier of the reason: Internal Entry Number of the record in the MAG"
^XWB(8994,2568,2,1,1,2,0)="REASON file (#2005.88) or the reason code (see the FLAGS parameter)."
^XWB(8994,2568,2,2,0)="FLAGS^1^^^2"
^XWB(8994,2568,2,2,1,0)="^^8^8^3090513^"
^XWB(8994,2568,2,2,1,1,0)="Flags that control execution (can be combined):"
^XWB(8994,2568,2,2,1,2,0)=" "
^XWB(8994,2568,2,2,1,3,0)="  C  By default, value of the RSNID parameter is treated as"
^XWB(8994,2568,2,2,1,4,0)="     the reason IEN. If this flag is provided, then the reason"
^XWB(8994,2568,2,2,1,5,0)="     code should be passed as the value of the RSNID."
^XWB(8994,2568,2,2,1,6,0)=" "
^XWB(8994,2568,2,2,1,7,0)="  F  Include full details (description text). By default, only"
^XWB(8994,2568,2,2,1,8,0)="     the summary data is returned."
^XWB(8994,2568,2,"B","FLAGS",2)=""
^XWB(8994,2568,2,"B","IEN",1)=""
^XWB(8994,2568,2,"B","RSNID",1)=""
^XWB(8994,2568,2,"PARAMSEQ",1,1)=""
^XWB(8994,2568,2,"PARAMSEQ",2,2)=""
^XWB(8994,2568,3,0)="^8994.03^41^41^3090513^^^"
^XWB(8994,2568,3,1,0)="Zero value of the first '^'-piece of the Results[0] indicates that an"
^XWB(8994,2568,3,2,0)="error occurred during the execution of the procedure. In this case, the"
^XWB(8994,2568,3,3,0)="errors are returned in the Results array as shown below:"
^XWB(8994,2568,3,4,0)="  "
^XWB(8994,2568,3,5,0)="  Results[0]            Result descriptor"
^XWB(8994,2568,3,6,0)="                          ^01: 0"
^XWB(8994,2568,3,7,0)="                          ^02: Message"
^XWB(8994,2568,3,8,0)="  "
^XWB(8994,2568,3,9,0)="  Results[i]            Error descriptor"
^XWB(8994,2568,3,10,0)="                          ^01: Error code"
^XWB(8994,2568,3,11,0)="                          ^02: Message"
^XWB(8994,2568,3,12,0)="                          ^03: Error location"
^XWB(8994,2568,3,13,0)="                          ^04: Message type"
^XWB(8994,2568,3,14,0)=" "
^XWB(8994,2568,3,15,0)="  Results[j]            Line of the additional info (optional)"
^XWB(8994,2568,3,16,0)="                          ^01: """""
^XWB(8994,2568,3,17,0)="                          ^02: Text"
^XWB(8994,2568,3,18,0)=" "
^XWB(8994,2568,3,19,0)="Otherwise, the Results[0] contains '1^OK' and the reason summary and "
^XWB(8994,2568,3,20,0)="description are returned in the subsequent elements of the Results array"
^XWB(8994,2568,3,21,0)="as follows:"
^XWB(8994,2568,3,22,0)=" "
^XWB(8994,2568,3,23,0)="  Results[1]            Reason summary"
^XWB(8994,2568,3,24,0)="                          ^01: IEN of the reason (file #2005.88)"
^XWB(8994,2568,3,25,0)="                          ^02: Text of the reason"
^XWB(8994,2568,3,26,0)="                          ^03: Types of the reason (combination of ""C"","
^XWB(8994,2568,3,27,0)="                               ""D"", ""P"", and/or ""S"")"
^XWB(8994,2568,3,28,0)="                          ^04: Date of inactivation (FileMan). "
^XWB(8994,2568,3,29,0)="                          ^05: Unique code of the reason (only for"
^XWB(8994,2568,3,30,0)="                               standard reasons distributed nationally;"
^XWB(8994,2568,3,31,0)="                               reasons defined by the sites do not have"
^XWB(8994,2568,3,32,0)="                               codes)."
^XWB(8994,2568,3,33,0)="  "
^XWB(8994,2568,3,34,0)="  Results[1+i]          Line of the description of the reason (optional)"
^XWB(8994,2568,3,35,0)="                          ^01: ""D"""
^XWB(8994,2568,3,36,0)="                          ^02: Text line"
^XWB(8994,2568,3,37,0)=" "
^XWB(8994,2568,3,38,0)="                        The description text is returned only if the"
^XWB(8994,2568,3,39,0)="                        value of the FLAGS parameter contains ""F"" and "
^XWB(8994,2568,3,40,0)="                        the DESCRIPTION field (1) of the MAG REASON file"
^XWB(8994,2568,3,41,0)="                        (#2005.88) is not empty."
^XWB(8994,2569,0)="MAGG IMAGE STATISTICS^IMGQUERY^MAGGA03^4^R^^^1"
^XWB(8994,2569,1,0)="^8994.01^9^9^3090121^^^^"
^XWB(8994,2569,1,1,0)="The MAGG IMAGE STATISTICS remote procedure queries the image file(s) and "
^XWB(8994,2569,1,2,0)="returns various statistics/summary data. Currently, 2 queries are "
^XWB(8994,2569,1,3,0)="implemented:"
^XWB(8994,2569,1,4,0)=" "
^XWB(8994,2569,1,5,0)="  Counts of images captured in the provided date range "
^XWB(8994,2569,1,6,0)="  grouped by the image status codes."
^XWB(8994,2569,1,7,0)=" "
^XWB(8994,2569,1,8,0)="  Counts of images captured in the provided date range"
^XWB(8994,2569,1,9,0)="  grouped by users and image status codes."
^XWB(8994,2569,2,0)="^8994.02A^3^3"
^XWB(8994,2569,2,1,0)="FLAGS^1^^1^1"
^XWB(8994,2569,2,1,1,0)="^^26^26^3081215^"
^XWB(8994,2569,2,1,1,1,0)="Flags that control the execution (can be combined):"
^XWB(8994,2569,2,1,1,2,0)=" "
^XWB(8994,2569,2,1,1,3,0)="  C  Capture date range. If this flag is provided,"
^XWB(8994,2569,2,1,1,4,0)="     then the remote procedure uses values of the"
^XWB(8994,2569,2,1,1,5,0)="     FROMDATE and TODATE parameters to select images"
^XWB(8994,2569,2,1,1,6,0)="     that were captured in this date range (see the"
^XWB(8994,2569,2,1,1,7,0)="     DATE/TIME IMAGE SAVED field (7) and the ""AD"""
^XWB(8994,2569,2,1,1,8,0)="     cross-reference)."
^XWB(8994,2569,2,1,1,9,0)=" "
^XWB(8994,2569,2,1,1,10,0)="     Otherwise, values of those parameters are"
^XWB(8994,2569,2,1,1,11,0)="     treated as the date range when procedures were"
^XWB(8994,2569,2,1,1,12,0)="     performed (see the PROCEDURE/EXAM DATE/TIME"
^XWB(8994,2569,2,1,1,13,0)="     field (15) and cross-references ""APDTPX"" and"
^XWB(8994,2569,2,1,1,14,0)="     ""APDT"")."
^XWB(8994,2569,2,1,1,15,0)=" "
^XWB(8994,2569,2,1,1,16,0)="  D  Include only deleted images (file #2005.1)"
^XWB(8994,2569,2,1,1,17,0)="  E  Include only existing images (file #2005)"
^XWB(8994,2569,2,1,1,18,0)=" "
^XWB(8994,2569,2,1,1,19,0)="  S  Return image counts grouped by status"
^XWB(8994,2569,2,1,1,20,0)="  U  Return image counts grouped by users and status"
^XWB(8994,2569,2,1,1,21,0)=" "
^XWB(8994,2569,2,1,1,22,0)="If neither 'E' nor 'D' flag is provided, then an error code (-6) is"
^XWB(8994,2569,2,1,1,23,0)="returned."
^XWB(8994,2569,2,1,1,24,0)=" "
^XWB(8994,2569,2,1,1,25,0)="If neither 'S' nor 'U' flag is provided, then an error code (-6) is"
^XWB(8994,2569,2,1,1,26,0)="returned."
^XWB(8994,2569,2,2,0)="FROMDATE^1^^^2"
^XWB(8994,2569,2,2,1,0)="^^11^11^3081107^"
^XWB(8994,2569,2,2,1,1,0)="Beginning of the date range for image selection. Dates can be in internal"
^XWB(8994,2569,2,2,1,2,0)="or external FileMan format. If the parameter is not defined or empty, then"
^XWB(8994,2569,2,2,1,3,0)="the date range remains open on this side."
^XWB(8994,2569,2,2,1,4,0)=" "
^XWB(8994,2569,2,2,1,5,0)="Depending on the value of the FLAGS parameter, the date range filter is"
^XWB(8994,2569,2,2,1,6,0)="applied either to the exam/procedure dates (PROCEDURE/EXAM DATE/TIME field"
^XWB(8994,2569,2,2,1,7,0)="(15)) or image capture dates (DATE/TIME IMAGE SAVED field (7))."
^XWB(8994,2569,2,2,1,8,0)=" "
^XWB(8994,2569,2,2,1,9,0)="Time parts of date range parameters are ignored and both ends of the date"
^XWB(8994,2569,2,2,1,10,0)="range are included in the search. For example, in order to search images"
^XWB(8994,2569,2,2,1,11,0)="for May 21, 2008, the internal value of both parameters should be 3080521."
^XWB(8994,2569,2,3,0)="TODATE^1^^^3"
^XWB(8994,2569,2,3,1,0)="^8994.021^11^11^3090121^^^^"
^XWB(8994,2569,2,3,1,1,0)="End of the date range for image selection. Dates can be in internal or"
^XWB(8994,2569,2,3,1,2,0)="external FileMan format. If the parameter is not defined or empty, then"
^XWB(8994,2569,2,3,1,3,0)="the date range remains open on this side."
^XWB(8994,2569,2,3,1,4,0)=" "
^XWB(8994,2569,2,3,1,5,0)="Depending on the value of the FLAGS parameter, the date range filter is"
^XWB(8994,2569,2,3,1,6,0)="applied either to the exam/procedure dates (PROCEDURE/EXAM DATE/TIME field"
^XWB(8994,2569,2,3,1,7,0)="(15)) or image capture dates (DATE/TIME IMAGE SAVED field (7))."
^XWB(8994,2569,2,3,1,8,0)=" "
^XWB(8994,2569,2,3,1,9,0)="Time parts of date range parameters are ignored and both ends of the date"
^XWB(8994,2569,2,3,1,10,0)="range are included in the search. For example, in order to search images"
^XWB(8994,2569,2,3,1,11,0)="for May 21, 2008, the internal value of both parameters should be 3080521."
^XWB(8994,2569,2,"B","FLAGS",1)=""
^XWB(8994,2569,2,"B","FROMDATE",2)=""
^XWB(8994,2569,2,"B","TODATE",3)=""
^XWB(8994,2569,2,"PARAMSEQ",1,1)=""
^XWB(8994,2569,2,"PARAMSEQ",2,2)=""
^XWB(8994,2569,2,"PARAMSEQ",3,3)=""
^XWB(8994,2569,3,0)="^^75^75^3090121^"
^XWB(8994,2569,3,1,0)="Zero value of the first '^'-piece of the Results[0] indicates that an"
^XWB(8994,2569,3,2,0)="error occurred during the execution of the procedure. In this case, the"
^XWB(8994,2569,3,3,0)="errors are returned in the Results array as shown below:"
^XWB(8994,2569,3,4,0)="  "
^XWB(8994,2569,3,5,0)="  Results[0]            Result descriptor"
^XWB(8994,2569,3,6,0)="                          ^01: 0"
^XWB(8994,2569,3,7,0)="                          ^02: Message"
^XWB(8994,2569,3,8,0)="  "
^XWB(8994,2569,3,9,0)="  Results[i]            Error descriptor"
^XWB(8994,2569,3,10,0)="                          ^01: Error code"
^XWB(8994,2569,3,11,0)="                          ^02: Message"
^XWB(8994,2569,3,12,0)="                          ^03: Error location"
^XWB(8994,2569,3,13,0)="                          ^04: Message type"
^XWB(8994,2569,3,14,0)=" "
^XWB(8994,2569,3,15,0)="  Results[j]            Line of the additional info (optional)"
^XWB(8994,2569,3,16,0)="                          ^01: """""
^XWB(8994,2569,3,17,0)="                          ^02: Text  "
^XWB(8994,2569,3,18,0)=" "
^XWB(8994,2569,3,19,0)="Otherwise, '1^Ok' is returned in the Results[0] and subsequent nodes "
^XWB(8994,2569,3,20,0)="contain requested data:"
^XWB(8994,2569,3,21,0)=" "
^XWB(8994,2569,3,22,0)="  Results[i]            Header of the counts grouped by status"
^XWB(8994,2569,3,23,0)="                          ^01: ""S"""
^XWB(8994,2569,3,24,0)="                          ^02: empty"
^XWB(8994,2569,3,25,0)="                          ^03: Number of ""S""-items"
^XWB(8994,2569,3,26,0)="                          ^04: empty"
^XWB(8994,2569,3,27,0)="                          ^05: ""Totals"""
^XWB(8994,2569,3,28,0)="                          ^06: Number of image entries"
^XWB(8994,2569,3,29,0)="                          ^07: Number of images/pages"
^XWB(8994,2569,3,30,0)="         "
^XWB(8994,2569,3,31,0)="  Results[i+j]          Image status record"
^XWB(8994,2569,3,32,0)="                          ^01: ""S"""
^XWB(8994,2569,3,33,0)="                          ^02: Sequential number of the ""S""-item"
^XWB(8994,2569,3,34,0)="                          ^03: empty"
^XWB(8994,2569,3,35,0)="                          ^04: Internal value of the STATUS field (113)."
^XWB(8994,2569,3,36,0)="                               If this piece is empty or 0, then the"
^XWB(8994,2569,3,37,0)="                               record contains counts of images with "
^XWB(8994,2569,3,38,0)="                               empty STATUS field."
^XWB(8994,2569,3,39,0)="                          ^05: External value of the STATUS field (113)"
^XWB(8994,2569,3,40,0)="                          ^06: Number of image entries"
^XWB(8994,2569,3,41,0)="                          ^07: Number of images/pages"
^XWB(8994,2569,3,42,0)="        "
^XWB(8994,2569,3,43,0)="  Results[i]            Header of the counts grouped by users and status"
^XWB(8994,2569,3,44,0)="                          ^01: ""U"""
^XWB(8994,2569,3,45,0)="                          ^02: empty"
^XWB(8994,2569,3,46,0)="                          ^03: Number of ""U""-items"
^XWB(8994,2569,3,47,0)="                          ^04: empty"
^XWB(8994,2569,3,48,0)="                          ^05: ""Totals"""
^XWB(8994,2569,3,49,0)="                          ^06: Number of image entries"
^XWB(8994,2569,3,50,0)="                          ^07: Number of images/pages"
^XWB(8994,2569,3,51,0)="         "
^XWB(8994,2569,3,52,0)="  Results[i+j]          User record"
^XWB(8994,2569,3,53,0)="                          ^01: ""U"""
^XWB(8994,2569,3,54,0)="                          ^02: Sequential number of the ""U""-item"
^XWB(8994,2569,3,55,0)="                          ^03: Number of ""US""-items"
^XWB(8994,2569,3,56,0)="                          ^04: User IEN (DUZ)."
^XWB(8994,2569,3,57,0)="                               If this piece is empty or 0, then the"
^XWB(8994,2569,3,58,0)="                               record contains counts of images that "
^XWB(8994,2569,3,59,0)="                               are not associated with a user."
^XWB(8994,2569,3,60,0)="                          ^05: User name"
^XWB(8994,2569,3,61,0)="                          ^06: Number of image entries"
^XWB(8994,2569,3,62,0)="                          ^07: Number of images/pages"
^XWB(8994,2569,3,63,0)="                          ^08: Percentage of verified images"
^XWB(8994,2569,3,64,0)="         "
^XWB(8994,2569,3,65,0)="  Results[i+j+k]        User/status record"
^XWB(8994,2569,3,66,0)="                          ^01: ""US"""
^XWB(8994,2569,3,67,0)="                          ^02: Sequential number of the ""US""-item"
^XWB(8994,2569,3,68,0)="                          ^03: empty"
^XWB(8994,2569,3,69,0)="                          ^04: Internal value of the STATUS field (113)."
^XWB(8994,2569,3,70,0)="                               If this piece is empty or 0, then the"
^XWB(8994,2569,3,71,0)="                               record contains counts of images with "
^XWB(8994,2569,3,72,0)="                               empty STATUS field."
^XWB(8994,2569,3,73,0)="                          ^05: External value of the STATUS field (113)"
^XWB(8994,2569,3,74,0)="                          ^06: Number of image entries"
^XWB(8994,2569,3,75,0)="                          ^07: Number of images/pages"
^XWB(8994,2570,0)="MAGG IMAGE LOCK^LOCKIMG^MAGGA04^2^R^^^1"
^XWB(8994,2570,1,0)="^8994.01^2^2^3090217^^^^"
^XWB(8994,2570,1,1,0)="This remote procedure locks one or more images. If several images are "
^XWB(8994,2570,1,2,0)="passed, then either all or none of them are locked."
^XWB(8994,2570,2,0)="^8994.02A^2^2"
^XWB(8994,2570,2,1,0)="FLAGS^1^^^1"
^XWB(8994,2570,2,1,1,0)="^^1^1^3090217^"
^XWB(8994,2570,2,1,1,1,0)="reserved"
^XWB(8994,2570,2,2,0)="IMGLST^2^^1^2"
^XWB(8994,2570,2,2,1,0)="^^12^12^3090217^"
^XWB(8994,2570,2,2,1,1,0)="List of images that have to be locked. Images are referenced by their "
^XWB(8994,2570,2,2,1,2,0)="internal entry numbers (IENs) in the IMAGE (#2005) and IMAGE AUDIT"
^XWB(8994,2570,2,2,1,3,0)="(#2005.1) files."
^XWB(8994,2570,2,2,1,4,0)=" "
^XWB(8994,2570,2,2,1,5,0)="Example:"
^XWB(8994,2570,2,2,1,6,0)=" "
^XWB(8994,2570,2,2,1,7,0)="  with RPCBroker.Param[1] do"
^XWB(8994,2570,2,2,1,8,0)="    begin"
^XWB(8994,2570,2,2,1,9,0)="      PType := list;"
^XWB(8994,2570,2,2,1,10,0)="      Mult[1] := '234';"
^XWB(8994,2570,2,2,1,11,0)="      Mult[2] := '789';"
^XWB(8994,2570,2,2,1,12,0)="    end;"
^XWB(8994,2570,2,"B","FLAGS",1)=""
^XWB(8994,2570,2,"B","IMGLST",2)=""
^XWB(8994,2570,2,"PARAMSEQ",1,1)=""
^XWB(8994,2570,2,"PARAMSEQ",2,2)=""
^XWB(8994,2570,3,0)="^8994.03^31^31^3090217^^"
^XWB(8994,2570,3,1,0)="Zero value of the first '^'-piece of the Results[0] indicates that an"
^XWB(8994,2570,3,2,0)="error occurred during the execution of the procedure. In this case, the"
^XWB(8994,2570,3,3,0)="errors are returned in the Results array as shown below:"
^XWB(8994,2570,3,4,0)="  "
^XWB(8994,2570,3,5,0)="  Results[0]            Result descriptor"
^XWB(8994,2570,3,6,0)="                          ^01: 0"
^XWB(8994,2570,3,7,0)="                          ^02: Message"
^XWB(8994,2570,3,8,0)="  "
^XWB(8994,2570,3,9,0)="  Results[i]            Error descriptor"
^XWB(8994,2570,3,10,0)="                          ^01: Error code"
^XWB(8994,2570,3,11,0)="                          ^02: Message"
^XWB(8994,2570,3,12,0)="                          ^03: Error location"
^XWB(8994,2570,3,13,0)="                          ^04: Message type"
^XWB(8994,2570,3,14,0)=" "
^XWB(8994,2570,3,15,0)="  Results[j]            Line of the additional info (optional)"
^XWB(8994,2570,3,16,0)="                          ^01: """""
^XWB(8994,2570,3,17,0)="                          ^02: Text  "
^XWB(8994,2570,3,18,0)=" "
^XWB(8994,2570,3,19,0)="If the error descriptor in the Results[1] has the error code -21, this"
^XWB(8994,2570,3,20,0)="means that the RPC could not lock the image(s). A message that explains"
^XWB(8994,2570,3,21,0)="who/what locked the image(s) and when this happened is attached to this"
^XWB(8994,2570,3,22,0)="error as additional information. Example:"
^XWB(8994,2570,3,23,0)=" "
^XWB(8994,2570,3,24,0)="  Results[0]='0^The image is locked by other user/task. "
^XWB(8994,2570,3,25,0)="    Please try later.'"
^XWB(8994,2570,3,26,0)="  Results[1]='-21^The image is locked by other user/task. "
^XWB(8994,2570,3,27,0)="    Please try later.^LOCKFM+11~MAGGA04^W'"
^XWB(8994,2570,3,28,0)="  Results[2]='^Locked by IMAGEUSER,ONE about Feb 17, 2009@13:21:54; "
^XWB(8994,2570,3,29,0)="    Job #5728'"
^XWB(8994,2570,3,30,0)=" "
^XWB(8994,2570,3,31,0)="In case of a successful lock, '1^Ok' is returned in the Results[0]."
^XWB(8994,2571,0)="MAGG IMAGE UNLOCK^UNLOCKIM^MAGGA04^2^R^^^1"
^XWB(8994,2571,1,0)="^^1^1^3090217^"
^XWB(8994,2571,1,1,0)="This remote procedure unlocks one or more images."
^XWB(8994,2571,2,0)="^8994.02A^2^2"
^XWB(8994,2571,2,1,0)="FLAGS^1^^^1"
^XWB(8994,2571,2,1,1,0)="^^1^1^3090217^"
^XWB(8994,2571,2,1,1,1,0)="reserved"
^XWB(8994,2571,2,2,0)="IMGLST^2^^1^2"
^XWB(8994,2571,2,2,1,0)="^^12^12^3090217^"
^XWB(8994,2571,2,2,1,1,0)="List of images that have to be unlocked. Images are referenced by their "
^XWB(8994,2571,2,2,1,2,0)="internal entry numbers (IENs) in the IMAGE (#2005) and IMAGE AUDIT"
^XWB(8994,2571,2,2,1,3,0)="(#2005.1) files."
^XWB(8994,2571,2,2,1,4,0)=" "
^XWB(8994,2571,2,2,1,5,0)="Example:"
^XWB(8994,2571,2,2,1,6,0)=" "
^XWB(8994,2571,2,2,1,7,0)="  with RPCBroker.Param[1] do"
^XWB(8994,2571,2,2,1,8,0)="    begin"
^XWB(8994,2571,2,2,1,9,0)="      PType := list;"
^XWB(8994,2571,2,2,1,10,0)="      Mult[1] := '234';"
^XWB(8994,2571,2,2,1,11,0)="      Mult[2] := '789';"
^XWB(8994,2571,2,2,1,12,0)="    end;"
^XWB(8994,2571,2,"B","FLAGS",1)=""
^XWB(8994,2571,2,"B","IMGLST",2)=""
^XWB(8994,2571,2,"PARAMSEQ",1,1)=""
^XWB(8994,2571,2,"PARAMSEQ",2,2)=""
^XWB(8994,2571,3,0)="^^19^19^3090217^"
^XWB(8994,2571,3,1,0)="Zero value of the first '^'-piece of the Results[0] indicates that an"
^XWB(8994,2571,3,2,0)="error occurred during the execution of the procedure. In this case, the"
^XWB(8994,2571,3,3,0)="errors are returned in the Results array as shown below:"
^XWB(8994,2571,3,4,0)="  "
^XWB(8994,2571,3,5,0)="  Results[0]            Result descriptor"
^XWB(8994,2571,3,6,0)="                          ^01: 0"
^XWB(8994,2571,3,7,0)="                          ^02: Message"
^XWB(8994,2571,3,8,0)="  "
^XWB(8994,2571,3,9,0)="  Results[i]            Error descriptor"
^XWB(8994,2571,3,10,0)="                          ^01: Error code"
^XWB(8994,2571,3,11,0)="                          ^02: Message"
^XWB(8994,2571,3,12,0)="                          ^03: Error location"
^XWB(8994,2571,3,13,0)="                          ^04: Message type"
^XWB(8994,2571,3,14,0)=" "
^XWB(8994,2571,3,15,0)="  Results[j]            Line of the additional info (optional)"
^XWB(8994,2571,3,16,0)="                          ^01: """""
^XWB(8994,2571,3,17,0)="                          ^02: Text  "
^XWB(8994,2571,3,18,0)=" "
^XWB(8994,2571,3,19,0)="Otherwise, '1^Ok' is returned in the Results[0]."
^XWB(8994,2572,0)="MAGG CAPTURE USERS^USERS^MAGGA03U^4^R^^^1"
^XWB(8994,2572,1,0)="^8994.01^6^6^3091104^^"
^XWB(8994,2572,1,1,0)="This call will find users that have captured images in a date range."
^XWB(8994,2572,1,2,0)="The list of users can be filtered by the FLAGS parameter"
^XWB(8994,2572,1,3,0)="The Flags Parameter can contain"
^XWB(8994,2572,1,4,0)="'C' for images captured on the Capture Workstation"
^XWB(8994,2572,1,5,0)="  and/or"
^XWB(8994,2572,1,6,0)="'I' for images captured throught the Import API."
^XWB(8994,2572,2,0)="^8994.02A^3^3"
^XWB(8994,2572,2,1,0)="FLAGS^1^20^0^3"
^XWB(8994,2572,2,1,1,0)="^8994.021^6^6^3091104^^"
^XWB(8994,2572,2,1,1,1,0)="The Flags Parameter can contain"
^XWB(8994,2572,2,1,1,2,0)="'C' for images captured on the Capture Workstation"
^XWB(8994,2572,2,1,1,3,0)="and/or"
^XWB(8994,2572,2,1,1,4,0)="'I' for images captured throught the Import API."
^XWB(8994,2572,2,1,1,5,0)="  "
^XWB(8994,2572,2,1,1,6,0)="If the parameter is null it defaults to 'CI'."
^XWB(8994,2572,2,2,0)="FROMDATE^1^20^1^1"
^XWB(8994,2572,2,2,1,0)="^8994.021^1^1^3091104^^"
