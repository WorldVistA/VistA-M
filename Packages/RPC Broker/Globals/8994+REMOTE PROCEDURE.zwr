^XWB(8994,4479,3,2,0)="1 - apply screen, sensitive patient"
^XWB(8994,4479,3,3,0)="2 - apply screen, employee"
^XWB(8994,4480,0)="MAG DICOM PATIENT LOOKUP^PATLKUP^MAGDSTA3^2"
