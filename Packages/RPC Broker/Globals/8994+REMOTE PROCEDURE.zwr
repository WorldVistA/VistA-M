^XWB(8994,131,2,2,1,3,0)="Time is optional."
^XWB(8994,131,2,2,1,4,0)=""
^XWB(8994,131,2,"B","BEGIN DATE/TIME",1)=""
^XWB(8994,131,2,"B","END DATE/TIME",2)=""
