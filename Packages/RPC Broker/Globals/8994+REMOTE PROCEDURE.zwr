^XWB(8994,4791,2,0)="^8994.02A^3^3"
^XWB(8994,4791,2,1,0)="DFN^1^30^1^1"
^XWB(8994,4791,2,1,1,0)="^^1^1^3221104^"
^XWB(8994,4791,2,1,1,1,0)="This is the Patient IEN from the PATIENT (#2) file."
^XWB(8994,4791,2,2,0)="RESOURCE^1^30^1^2"
^XWB(8994,4791,2,2,1,0)="^^1^1^3221104^"
^XWB(8994,4791,2,2,1,1,0)="This is the RESOURCE from the SDEC RESOURCE (#409.831) file."
^XWB(8994,4791,2,3,0)="APPTDATETIME^1^30^1^3"
^XWB(8994,4791,2,3,1,0)="^8994.021^1^1^3250206^^"
^XWB(8994,4791,2,3,1,1,0)="This is the appointment date/time, in the following format NN/NN/NN@NNNN."
^XWB(8994,4791,2,"B","APPTDATETIME",3)=""
^XWB(8994,4791,2,"B","DFN",1)=""
^XWB(8994,4791,2,"B","RESOURCE",2)=""
^XWB(8994,4791,2,"PARAMSEQ",1,1)=""
^XWB(8994,4791,2,"PARAMSEQ",2,2)=""
^XWB(8994,4791,2,"PARAMSEQ",3,3)=""
^XWB(8994,4791,3,0)="^8994.03^1^1^3250206^^"
^XWB(8994,4791,3,1,0)="RETURN=0 or RETURN=1 if entry is deleted."
^XWB(8994,4792,0)="SDES GET VVS APPT^VVCAPPT^SDESVVC^2^R^^^^^^1"
^XWB(8994,4792,1,0)="^^9^9^3250207^"
^XWB(8994,4792,1,1,0)="If an appointment is for a VVC clinic, return the URL of the VVC Web app. "
^XWB(8994,4792,1,2,0)=" "
^XWB(8994,4792,1,3,0)=" The NATIONAL entry in the SDEC Settings file (#409.98) stores the stop "
^XWB(8994,4792,1,4,0)=" code that identifies a VVC clinic in field #5 (VVC Clinic Stop Code).  If "
^XWB(8994,4792,1,5,0)=" the stop code for the clinic associated with the resource scheduled for "
^XWB(8994,4792,1,6,0)=" the appointment equals this stop code, the RPC returns the value in field "
^XWB(8994,4792,1,7,0)=" #6 VVC APP URL of the NATIONAL entry in the SDEC Settings file."
^XWB(8994,4792,1,8,0)=" "
^XWB(8994,4792,1,9,0)="Can only be invoked by Acheron"
^XWB(8994,4792,2,0)="^8994.02A^1^1"
^XWB(8994,4792,2,1,0)="SDESAPPT^1^20^1^1"
^XWB(8994,4792,2,1,1,0)="^8994.021^1^1^3250207^^^^"
^XWB(8994,4792,2,1,1,1,0)="Appointment IEN (pointer to #409.84)."
^XWB(8994,4792,2,"B","SDESAPPT",1)=""
^XWB(8994,4792,2,"PARAMSEQ",1,1)=""
^XWB(8994,4792,3,0)="^8994.03^4^4^3250207^^^^"
^XWB(8994,4792,3,1,0)=" Header:  T01000URL"
^XWB(8994,4792,3,2,0)="  "
^XWB(8994,4792,3,3,0)=" Data:  URL of VVC Web app if appointment is for a VVC clinic."
^XWB(8994,4792,3,4,0)=" An error message will be returned otherwise."
^XWB(8994,4793,0)="SDES SAVE VVS ID^SAVEVVSID^SDESVVS^2^R^^^^^^1"
^XWB(8994,4793,1,0)="^^4^4^3250207^"
^XWB(8994,4793,1,1,0)="This RPC saves the VVS appointment ID in the VVS APPOINTMENT (#2) "
