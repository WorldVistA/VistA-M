^XWB(8994,3704,2,1,1,2,0)="application."
^XWB(8994,3704,2,2,0)="IPNAME^1^256^1^1"
^XWB(8994,3704,2,2,1,0)="^^1^1^3130424^"
^XWB(8994,3704,2,2,1,1,0)="Inventory point name to designate the cathlab in GIP."
^XWB(8994,3704,2,3,0)="ITEM^1^10^1^2"
^XWB(8994,3704,2,3,1,0)="^^1^1^3130424^"
^XWB(8994,3704,2,3,1,1,0)="Item master number from IFCAP and used by the inventory point in GIP."
^XWB(8994,3704,2,4,0)="QTY^1^6^1^3"
^XWB(8994,3704,2,4,1,0)="^8994.021^1^1^3130513^^"
^XWB(8994,3704,2,4,1,1,0)="Quantity on hand to be set by WaveMark in the cathlab inventory point."
^XWB(8994,3704,2,5,0)="QOHFLAG^1^1^1^4"
^XWB(8994,3704,2,5,1,0)="^8994.021^3^3^3130513^^^^"
^XWB(8994,3704,2,5,1,1,0)="A flag used by WaveMark to indicate a usage transaction (U), or a "
^XWB(8994,3704,2,5,1,2,0)="physical count (P) transaction. These are the only transactions allowed "
^XWB(8994,3704,2,5,1,3,0)="for WaveMark to change the inventory point quantity on-hand."
^XWB(8994,3704,2,"B","IPNAME",2)=""
^XWB(8994,3704,2,"B","ITEM",3)=""
^XWB(8994,3704,2,"B","QOHFLAG",5)=""
^XWB(8994,3704,2,"B","QTY",4)=""
^XWB(8994,3704,2,"B","RETSTA",1)=""
^XWB(8994,3704,2,"PARAMSEQ",1,2)=""
^XWB(8994,3704,2,"PARAMSEQ",2,3)=""
^XWB(8994,3704,2,"PARAMSEQ",3,4)=""
^XWB(8994,3704,2,"PARAMSEQ",4,5)=""
^XWB(8994,3704,3,0)="^8994.03^11^11^3140206^^^"
^XWB(8994,3704,3,1,0)="RETSTA is the return parameter that carries the reference for the result"
^XWB(8994,3704,3,2,0)="stored in ^XTMP. The call result can be an error condition or success."
^XWB(8994,3704,3,3,0)=" "
^XWB(8994,3704,3,4,0)="The format of the data returned is as follows:"
^XWB(8994,3704,3,5,0)=" "
^XWB(8994,3704,3,6,0)="1) when the call is completed without any errors, the result will be"
^XWB(8994,3704,3,7,0)="a message indicating completion of the update for quantity on-hand"
^XWB(8994,3704,3,8,0)="for the given item and the inventory point name."
^XWB(8994,3704,3,9,0)=" "
^XWB(8994,3704,3,10,0)="2) if an error occurred during execution of the call, a message will be"
^XWB(8994,3704,3,11,0)="passed to the calling application to indicate the reason."
^XWB(8994,3705,0)="VIAA GET PATIENT DATA^RTLSPT^VIAAPTR^4^R^^^1^^^1"
^XWB(8994,3705,1,0)="^^2^2^3130614^"
^XWB(8994,3705,1,1,0)="This RPC is used by WaveMark to extract patient data from VistA by "
^XWB(8994,3705,1,2,0)="sending either the SSN or the ICN."
^XWB(8994,3705,2,0)="^8994.02A^3^3"
^XWB(8994,3705,2,1,0)="REQDATA^1^255^1^1"
^XWB(8994,3705,2,1,1,0)="^8994.021^2^2^3130424^^^^"
^XWB(8994,3705,2,1,1,1,0)="""SSN"" if SSN to be passed in DATAID"
^XWB(8994,3705,2,1,1,2,0)="""ICN"" if ICN to be passed in DATAID"
^XWB(8994,3705,2,2,0)="RETSTA^2^32000^1"
^XWB(8994,3705,2,2,1,0)="^^1^1^3130424^"
^XWB(8994,3705,2,2,1,1,0)="Results array"
^XWB(8994,3705,2,3,0)="DATAID^1^255^1^2"
^XWB(8994,3705,2,3,1,0)="^8994.021^1^1^3130508^^^^"
^XWB(8994,3705,2,3,1,1,0)="SSN or ICN for patient data retrieval"
^XWB(8994,3705,2,"B","DATAID",3)=""
^XWB(8994,3705,2,"B","REQDATA",1)=""
^XWB(8994,3705,2,"B","RETSTA",2)=""
^XWB(8994,3705,2,"PARAMSEQ",1,1)=""
^XWB(8994,3705,2,"PARAMSEQ",2,3)=""
^XWB(8994,3705,3,0)="^^23^23^3131029^"
^XWB(8994,3705,3,1,0)="For a successful call execution, the output for the client will be placed"
^XWB(8994,3705,3,2,0)="in ^TMP(x,$J,0) Where x='VIAASSN' for a Social Security Number call or"
^XWB(8994,3705,3,3,0)="x='VIAAICN' for an Internal Control Number call. The value is returned via"
^XWB(8994,3705,3,4,0)="the variable RETSTA; it will consist of the following fields from the"
^XWB(8994,3705,3,5,0)="Patient File #2 using '^' as a delimiter:"
^XWB(8994,3705,3,6,0)=" "
^XWB(8994,3705,3,7,0)="IEN"
^XWB(8994,3705,3,8,0)="SOCIAL SECURITY NUMBER"
^XWB(8994,3705,3,9,0)="INTEGRATION CONTROL NUMBER"
^XWB(8994,3705,3,10,0)="NAME"
^XWB(8994,3705,3,11,0)="SEX"
^XWB(8994,3705,3,12,0)="DATE OF BIRTH"
^XWB(8994,3705,3,13,0)="ROOM-BED"
^XWB(8994,3705,3,14,0)="WARD LOCATION"
^XWB(8994,3705,3,15,0)=" "
^XWB(8994,3705,3,16,0)="If an error occurs during call execution, a message will be returned to"
^XWB(8994,3705,3,17,0)="the client using the following format in ^TMP:"
^XWB(8994,3705,3,18,0)=" "
^XWB(8994,3705,3,19,0)="^TMP(x,$J,0)='-###^reason_for_failure', where '###' is a 3-digit http"
^XWB(8994,3705,3,20,0)="status code. The piece 'reason_for_failure' explains what caused the error"
^XWB(8994,3705,3,21,0)="in VistA. "
^XWB(8994,3705,3,22,0)="Where x='VIAASSN' for a Social Security Number call or x='VIAAICN' for an"
^XWB(8994,3705,3,23,0)="Internal Control Number call."
^XWB(8994,3705,3,24,0)="   an Internal Control Number call."
^XWB(8994,3706,0)="VIAA GET EMPLOYEE DATA^RTLSNP^VIAANPR^2^R^^^1^^^1"
^XWB(8994,3706,1,0)="^8994.01^1^1^3130614^^^^"
^XWB(8994,3706,1,1,0)="Extract Employee (New Person) Data"
^XWB(8994,3706,2,0)="^8994.02A^3^3"
^XWB(8994,3706,2,1,0)="RETSTA^2^32000^1"
^XWB(8994,3706,2,2,0)="REQDATA^1^255^1^1"
^XWB(8994,3706,2,2,1,0)="^8994.021^2^2^3130429^^"
^XWB(8994,3706,2,2,1,1,0)="""SSN"" defines DATAID as a Social Security Number"
^XWB(8994,3706,2,2,1,2,0)="""NAME"" defines DATAID as a Name or Partial Name"
^XWB(8994,3706,2,3,0)="DATAID^1^255^1^2"
^XWB(8994,3706,2,3,1,0)="^8994.021^2^2^3130508^^^^"
^XWB(8994,3706,2,3,1,1,0)="SSN if REQDATA=""SSN"""
^XWB(8994,3706,2,3,1,2,0)="NAME/PARTIAL NAME if REQDATA=""NAME"""
^XWB(8994,3706,2,"B","DATAID",3)=""
^XWB(8994,3706,2,"B","REQDATA",2)=""
^XWB(8994,3706,2,"B","RETSTA",1)=""
^XWB(8994,3706,2,"PARAMSEQ",1,2)=""
^XWB(8994,3706,2,"PARAMSEQ",2,3)=""
^XWB(8994,3706,3,0)="^^23^23^3131029^"
^XWB(8994,3706,3,1,0)="For a successful call execution, the output for the client will be placed"
^XWB(8994,3706,3,2,0)="in ^TMP(x,$J,n) Where x='VIAAIEN' for an Internal Entry Number call or"
^XWB(8994,3706,3,3,0)="x='VIAANAME' for an Employee Name call. n=An incremental count of the"
^XWB(8994,3706,3,4,0)="records returned. The value is returned via the variable RETSTA; it will"
^XWB(8994,3706,3,5,0)="consist of the following fields from the New Person File #200 using '^' "
^XWB(8994,3706,3,6,0)="a delimiter:"
^XWB(8994,3706,3,7,0)=" "
^XWB(8994,3706,3,8,0)="IEN"
^XWB(8994,3706,3,9,0)="NAME"
^XWB(8994,3706,3,10,0)="DIVISION"
^XWB(8994,3706,3,11,0)="SEX"
^XWB(8994,3706,3,12,0)="DOB"
^XWB(8994,3706,3,13,0)="TITLE"
^XWB(8994,3706,3,14,0)="SERVICE/SECTION"
^XWB(8994,3706,3,15,0)=" "
^XWB(8994,3706,3,16,0)="If an error occurs during call  execution, a message will be returned to"
^XWB(8994,3706,3,17,0)="the client using the following format in ^TMP:"
^XWB(8994,3706,3,18,0)=" "
^XWB(8994,3706,3,19,0)="^TMP(x,$J,0)='-###^reason_for_failure', where '###' is a 3-digit http"
^XWB(8994,3706,3,20,0)="status code. The piece 'reason_for_failure' explains what caused the error"
^XWB(8994,3706,3,21,0)="in VistA. "
^XWB(8994,3706,3,22,0)="Where x='VIAAIEN' for an Internal Entry Number call or x='VIAANAME' for an"
^XWB(8994,3706,3,23,0)="Employee Name call."
^XWB(8994,3706,3,24,0)="   an Employee Name call."
^XWB(8994,3707,0)="VIAA GET CATHLAB PATCH STATUS^PINGRP^VIAAMB2^1^R^^^1^^^1"
^XWB(8994,3707,1,0)="^8994.01^3^3^3160425^^"
^XWB(8994,3707,1,1,0)="This RPC is used to verify that the Real Time Location Ssystem (RTLS) "
^XWB(8994,3707,1,2,0)="package has been installed in VistA and the patch to support the Cath Lab"
^XWB(8994,3707,1,3,0)="has been installed as well. No input parameter is required."
^XWB(8994,3707,3,0)="^8994.03^3^3^3160425^^"
^XWB(8994,3707,3,1,0)="The successful execution of the RPC returns one string with the version "
^XWB(8994,3707,3,2,0)="of RTLS and the Cath Lab patch number installed in VistA. No input "
^XWB(8994,3707,3,3,0)="parameter is required."
^XWB(8994,3708,0)="SDECDEM MARITAL^MARITAL^SDECDEM^4^R^0^^0"
^XWB(8994,3708,1,0)="^^1^1^3161104^"
^XWB(8994,3708,1,1,0)="GET Marital status entries from the MARITAL STATUS file (#11)."
^XWB(8994,3708,3,0)="^^10^10^3161104^"
^XWB(8994,3708,3,1,0)="  1. MIEN - Marital Status ID pointer to the MARITAL STATUS file (#11)"
^XWB(8994,3708,3,2,0)="  2. MNAME - Marital Status name "
^XWB(8994,3708,3,3,0)="  3. MABB - Marital Status Abbreviation "
^XWB(8994,3708,3,4,0)="  4. MCODE - Marital Status Code - valid values are: "
^XWB(8994,3708,3,5,0)="                D:DIVORCED "
^XWB(8994,3708,3,6,0)="                M:MARRIED "
^XWB(8994,3708,3,7,0)="                N:NEVER MARRIED "
^XWB(8994,3708,3,8,0)="                S:SEPARATED "
^XWB(8994,3708,3,9,0)="                W:WIDOWED "
^XWB(8994,3708,3,10,0)="                U:UNKNOWN"
^XWB(8994,3709,0)="SDECDEM RELIGION^RELIGION^SDECDEM^4^R^0^^0"
^XWB(8994,3709,1,0)="^^1^1^3161104^"
^XWB(8994,3709,1,1,0)="GET Religious preference entries from the RELITION file (#13)."
^XWB(8994,3709,3,0)="^^11^11^3161104^"
^XWB(8994,3709,3,1,0)="   1. RIEN   - Religion ID pointer to the RELIGION file (#13)"
^XWB(8994,3709,3,2,0)="   2. RNAME  - Religion name "
^XWB(8994,3709,3,3,0)="   3. RABB   - Religion Abbreviation "
^XWB(8994,3709,3,4,0)="   4. RCLASS - Religion Classification code "
^XWB(8994,3709,3,5,0)="                1=CATHOLIC "
^XWB(8994,3709,3,6,0)="                2=PROTESTANT "
^XWB(8994,3709,3,7,0)="                3=JEWISH "
^XWB(8994,3709,3,8,0)="                4=ORTHODOX "
^XWB(8994,3709,3,9,0)="                5=OTHER "
^XWB(8994,3709,3,10,0)="  5. RCLASSN - Religion Classification name "
^XWB(8994,3709,3,11,0)="  6. RCODE   - Religion Code - Numeric 1-99"
^XWB(8994,3710,0)="SDECDEM ZIPLINK^ZIPLINK^SDECDEM^4^R^0^^0"
^XWB(8994,3710,1,0)="^^1^1^3161104^"
^XWB(8994,3710,1,1,0)="GET linked cities/state/etc for given zip code."
^XWB(8994,3710,2,0)="^8994.02A^1^1"
^XWB(8994,3710,2,1,0)="ZIP^1^^^1"
^XWB(8994,3710,2,1,1,0)="^^1^1^3161104^"
^XWB(8994,3710,2,1,1,1,0)="5 OR 9 digit numeric zip code"
^XWB(8994,3710,2,"B","ZIP",1)=""
^XWB(8994,3710,2,"PARAMSEQ",1,1)=""
^XWB(8994,3710,3,0)="^^11^11^3161104^"
^XWB(8994,3710,3,1,0)="  1. CITYNAME   - City name "
^XWB(8994,3710,3,2,0)="  2. CITY_ABB   - City Abbreviation "
^XWB(8994,3710,3,3,0)="  3. CITY_KEY   - City Key "
^XWB(8994,3710,3,4,0)="  4. COUNTYNAME - County name "
^XWB(8994,3710,3,5,0)="  5. COUNTYIEN  - County Pointer "
^XWB(8994,3710,3,6,0)="  6. FIPS       - FIPS code "
^XWB(8994,3710,3,7,0)="  7. ZIP        - ZIP CODE "
^XWB(8994,3710,3,8,0)="  8. P_CITY_KEY - Preferred City Key "
^XWB(8994,3710,3,9,0)="  9. STATENAME  - State name "
^XWB(8994,3710,3,10,0)=" 10. STATE_IEN  - State ien "
^XWB(8994,3710,3,11,0)=" 11. UID        - Unique Key"
^XWB(8994,3711,0)="SDECAR3 AREDIT^AREDIT^SDECAR3^4^R^0^^0"
^XWB(8994,3711,1,0)="^8994.01^4^4^3161103^^"
^XWB(8994,3711,1,1,0)="SET the values for Appointment Type, Requested By, Provider, Comment, "
^XWB(8994,3711,1,2,0)="Fast/Non-Fasting, Length of Appt., Clinic, and Service Specialty to the "
^XWB(8994,3711,1,3,0)="appropriate file based on the request type.  Request types are "
^XWB(8994,3711,1,4,0)="Appointment Request, Electronic Wait List, and Recall Reminders."
^XWB(8994,3711,2,0)="^8994.02A^11^10"
^XWB(8994,3711,2,1,0)="ATYPE^1^^^3"
^XWB(8994,3711,2,1,1,0)="^^3^3^3161103^"
^XWB(8994,3711,2,1,1,1,0)="Appointment Type ID pointer to APPOINTMENT TYPE file (#409.1) for APPT "
^XWB(8994,3711,2,1,1,2,0)="and EWL request types or ID pointer to RECALL REMINDERS APPT TYPE file "
^XWB(8994,3711,2,1,1,3,0)="(#403.51) for RECALL reequest type."
^XWB(8994,3711,2,2,0)="COMMENT^1^^^6"
^XWB(8994,3711,2,2,1,0)="^^1^1^3161103^"
^XWB(8994,3711,2,2,1,1,0)="Comment must be 1 to 60 characters."
^XWB(8994,3711,2,3,0)="FAST^1^^^7"
^XWB(8994,3711,2,3,1,0)="^^1^1^3161103^"
^XWB(8994,3711,2,3,1,1,0)="(optional) FAST: f = Fasting, n = Non-Fasting"
^XWB(8994,3711,2,4,0)="IEN^1^^1^2"
^XWB(8994,3711,2,4,1,0)="^^2^2^3161103^"
^XWB(8994,3711,2,4,1,1,0)="(required) ID pointer to: A = SDEC APPT REQUEST file (#409.85), E = SD "
^XWB(8994,3711,2,4,1,2,0)="WAIT LIST file (#409.3), R = RECALL REMINDERS file (#403.5)."
^XWB(8994,3711,2,6,0)="LOA^1^^^8"
^XWB(8994,3711,2,6,1,0)="^8994.021^1^1^3161103^^^"
^XWB(8994,3711,2,6,1,1,0)="(optional) LENGTH OF APPT. that must be a number between 10 and 120"
^XWB(8994,3711,2,7,0)="PROV^1^^^5"
^XWB(8994,3711,2,7,1,0)="^^3^3^3161103^"
^XWB(8994,3711,2,7,1,1,0)="Provider ID pointer to NEW PERSON file (#200) for APPT and EWL request "
^XWB(8994,3711,2,7,1,2,0)="types or ID pointer to RECALL REMINDERS PROVIDERS file (#403.54) for "
^XWB(8994,3711,2,7,1,3,0)="Recall request type."
^XWB(8994,3711,2,8,0)="REQBY^1^^^4"
^XWB(8994,3711,2,8,1,0)="^^1^1^3161103^"
^XWB(8994,3711,2,8,1,1,0)="Request By: 1 = Provider, 2 = Patient"
^XWB(8994,3711,2,9,0)="SDCL^1^^^9"
^XWB(8994,3711,2,9,1,0)="^^1^1^3161103^"
^XWB(8994,3711,2,9,1,1,0)="(optional) Clinic Code - pointer to HOSPITAL LOCATION file"
^XWB(8994,3711,2,10,0)="SDSTOP^1^^^10"
^XWB(8994,3711,2,10,1,0)="^^3^3^3161103^"
^XWB(8994,3711,2,10,1,1,0)="(optional) CLINIC STOP or Service/Specialty name - NAME from the SD WL "
^XWB(8994,3711,2,10,1,2,0)="SERVICE/SPECIALTY file where it looks for 1st active OR Pointer to the "
^XWB(8994,3711,2,10,1,3,0)="CLINIC STOP file"
^XWB(8994,3711,2,11,0)="TYP^1^^1^1"
^XWB(8994,3711,2,11,1,0)="^^1^1^3161103^"
^XWB(8994,3711,2,11,1,1,0)="Request type to edit. A = APPT REQ, E = EWL, and R = Recall"
^XWB(8994,3711,2,"B","ATYPE",1)=""
^XWB(8994,3711,2,"B","COMMENT",2)=""
^XWB(8994,3711,2,"B","FAST",3)=""
^XWB(8994,3711,2,"B","IEN",4)=""
^XWB(8994,3711,2,"B","LOA",6)=""
^XWB(8994,3711,2,"B","PROV",7)=""
^XWB(8994,3711,2,"B","REQBY",8)=""
^XWB(8994,3711,2,"B","SDCL",9)=""
^XWB(8994,3711,2,"B","SDSTOP",10)=""
^XWB(8994,3711,2,"B","TYP",11)=""
^XWB(8994,3711,2,"PARAMSEQ",1,11)=""
^XWB(8994,3711,2,"PARAMSEQ",2,4)=""
