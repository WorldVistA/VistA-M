^XWB(8994,4909,2,2,1,47,0)="SDCLINIC(""REQUIRE X-RAY"")"
^XWB(8994,4909,2,2,1,48,0)="SDCLINIC(""SCHEDULE ON HOLIDAYS"")"
^XWB(8994,4909,2,2,1,49,0)=" SDCLINIC(""SPECIAL INSTRUCTIONS"",NUMBER)="
^XWB(8994,4909,2,2,1,50,0)="   ""(null value)|SPECIAL INSTRUCTION TEXT UP TO 80 CHARACTERS"""
^XWB(8994,4909,2,2,1,51,0)="      FOR ADDITION"
