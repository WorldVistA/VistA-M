^XWB(8994,4619,1,4,0)="the requested inventory point and that the logged-in user is an authorized"
^XWB(8994,4619,1,5,0)="user of the inventory point from the Record of Pros Appliance/Repair "
^XWB(8994,4619,1,6,0)="(#660)."
