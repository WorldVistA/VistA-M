^XWB(8994,5052,1,15,0)=" "
^XWB(8994,5052,1,16,0)=" This RPC updates the PATCH MAG*3.0*350 CLEANUP file for one image."
^XWB(8994,5052,2,0)="^8994.02A^4^4"
^XWB(8994,5052,2,1,0)="MAGIEN^1^30^1^1"
^XWB(8994,5052,2,1,1,0)="^^1^1^3221221^"
^XWB(8994,5052,2,1,1,1,0)="IEN for the image in the IMAGE file (#2005)"
^XWB(8994,5052,2,2,0)="NEW STATUS^1^30^1^2"
^XWB(8994,5052,2,2,1,0)="^8994.021^1^1^3230109^^"
^XWB(8994,5052,2,2,1,1,0)="This is the new status after the attempt to create the DICOM object."
^XWB(8994,5052,2,3,0)="ERROR MESSAGE^1^80^0^3"
^XWB(8994,5052,2,3,1,0)="^^1^1^3230109^"
^XWB(8994,5052,2,3,1,1,0)="If an error occurs, this is the reason for the error."
^XWB(8994,5052,2,4,0)="SOP INSTANCE UID^1^64^0^4"
^XWB(8994,5052,2,4,1,0)="^^1^1^3240424^"
^XWB(8994,5052,2,4,1,1,0)="New DICOM object's SOP Instance UID (0008,0018)."
^XWB(8994,5052,2,"B","ERROR MESSAGE",3)=""
^XWB(8994,5052,2,"B","MAGIEN",1)=""
^XWB(8994,5052,2,"B","NEW STATUS",2)=""
^XWB(8994,5052,2,"B","SOP INSTANCE UID",4)=""
^XWB(8994,5052,2,"PARAMSEQ",1,1)=""
^XWB(8994,5052,2,"PARAMSEQ",2,2)=""
^XWB(8994,5052,2,"PARAMSEQ",3,3)=""
^XWB(8994,5052,2,"PARAMSEQ",4,4)=""
^XWB(8994,5052,3,0)="^^1^1^3221221^"
^XWB(8994,5052,3,1,0)="STATUS"
^XWB(8994,5053,0)="MAG DICOM P350 FIX FAIL IMAGES^FIXFAIL^MAGD350I^1"
^XWB(8994,5053,1,0)="^^6^6^3240423^"
^XWB(8994,5053,1,1,0)="The CLEANUP OF JPEG IMAGES STORED AS DICOM IMAGES file (#2006.59935) is"
^XWB(8994,5053,1,2,0)="created by MAG*3.0*350.  Errors can occur in the processing of the images."
^XWB(8994,5053,1,3,0)="A Storage SCP is needed for processing and if one is not present, the"
^XWB(8994,5053,1,4,0)="images go into ""FAIL"" state."
^XWB(8994,5053,1,5,0)=" "
^XWB(8994,5053,1,6,0)="This RPC resets the image state to ""UNKNOWN"" so that they can be reprocessed."
^XWB(8994,5053,3,0)="^^1^1^3240423^"
^XWB(8994,5053,3,1,0)="Count of image entries fixed."
^XWB(8994,5054,0)="MAG DICOM P350 UPDATE FIELDS^UPDATE^MAGD350I^1"
^XWB(8994,5054,1,0)="^8994.01^7^7^3240425^^"
^XWB(8994,5054,1,1,0)="After the DICOM image is acquired and processed, this RPC is used to update"
^XWB(8994,5054,1,2,0)="field in the IMAGE file (#2005).  The following fields are updated"
^XWB(8994,5054,1,3,0)="6 ----- PROCEDURE - copied from original JPEG.DCM IMAGE entry"
^XWB(8994,5054,1,4,0)="40 ---- PACKAGE INDEX - copied from original JPEG.DCM IMAGE entry"
^XWB(8994,5054,1,5,0)="42 ---- TYPE INDEX - copied from original JPEG.DCM IMAGE entry - "
^XWB(8994,5054,1,6,0)="45 ---- ORIGIN - copied from original JPEG.DCM IMAGE entry"
^XWB(8994,5054,1,7,0)="113.3 - STATUS REASON - pointer to ^MAG(2005.8,19)"
^XWB(8994,5054,3,0)="^^6^6^3240425^"
^XWB(8994,5054,3,1,0)="Return has counts in five ""^"" fields"
^XWB(8994,5054,3,2,0)="1 - Number of file updated that have already been completed"
^XWB(8994,5054,3,3,0)="2 - Number of file updates that have been performed on this call"
^XWB(8994,5054,3,4,0)="3 - Number of images that have not yet been processed"
^XWB(8994,5054,3,5,0)="4 - Error #1 - ^MAG(2006.59935,D0,0) entry is missing"
^XWB(8994,5054,3,6,0)="5 - Error #2 - SOP Instance UID is missing in ^MAG(2006.59935,D0,0), piece-7"
^XWB(8994,5055,0)="MPI IFC VISTA ADD PATIENT^ADD^MPIPRSAD^1^^^^^1"
^XWB(8994,5055,1,0)="^^8^8^3230410^"
^XWB(8994,5055,1,1,0)="This RPC is called by VistA utility code to support IFC to create patient "
^XWB(8994,5055,1,2,0)="at VistA. If ICN is passed in and it it exist at MPI, it will call remote "
^XWB(8994,5055,1,3,0)="RPC to create new patient at VistA using Primary View data. If EDIPI is "
^XWB(8994,5055,1,4,0)="passed in and if it exist at MPI, it will use its associated ICN to "
^XWB(8994,5055,1,5,0)="create new patient at VistA using Primary View data. If EDIPI is passed "
^XWB(8994,5055,1,6,0)="in and if it does not exist at MPI, MPI will request PSIM for DoD "
^XWB(8994,5055,1,7,0)="orchestration and once 200DoD correlation is created, it will use its "
^XWB(8994,5055,1,8,0)="associated ICN Primary View data to create new patient at VistA."
^XWB(8994,5055,2,0)="^8994.02A^2^2"
^XWB(8994,5055,2,1,0)="SRCID^1^30^1^1"
^XWB(8994,5055,2,1,1,0)="^^3^3^3230410^"
^XWB(8994,5055,2,1,1,1,0)="Fully qualified ID: ID~Assigning Authority~ID Type~Station Number"
^XWB(8994,5055,2,1,1,2,0)="                 Ex: For ICN: FullICN~USVHA~NI~200M"
^XWB(8994,5055,2,1,1,3,0)="                     For EDIPI: EDIPI~USDOD~NI~200DOD"
^XWB(8994,5055,2,2,0)="SITE^1^^1^2"
^XWB(8994,5055,2,2,1,0)="^^1^1^3230410^"
^XWB(8994,5055,2,2,1,1,0)="VistA station number where new patient needs to be created."
^XWB(8994,5055,2,"B","SITE",2)=""
^XWB(8994,5055,2,"B","SRCID",1)=""
^XWB(8994,5055,2,"PARAMSEQ",1,1)=""
^XWB(8994,5055,2,"PARAMSEQ",2,2)=""
^XWB(8994,5055,3,0)="^^3^3^3230410^"
^XWB(8994,5055,3,1,0)=" 1^ICN^STATION NUMBER^DFN"
^XWB(8994,5055,3,2,0)=" Or"
^XWB(8994,5055,3,3,0)=" -1^Error message if failed"
