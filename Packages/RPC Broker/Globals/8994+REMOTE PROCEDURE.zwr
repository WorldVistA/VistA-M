^XWB(8994,4967,3,20,0)=" "
^XWB(8994,4967,3,21,0)="{"
^XWB(8994,4967,3,22,0)="  ""ClinicInactivate"":["
^XWB(8994,4967,3,23,0)="                      """""""""
^XWB(8994,4967,3,24,0)="                     ],"
^XWB(8994,4967,3,25,0)="  ""Error"":["
^XWB(8994,4967,3,26,0)="           ""Error: Incorrect value for 'DELETE INACTIVATION' parameter, "
^XWB(8994,4967,3,27,0)="                   must be 'Y' or not provided."""
^XWB(8994,4967,3,28,0)="          ]"
