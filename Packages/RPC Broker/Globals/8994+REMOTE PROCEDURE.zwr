^XWB(8994,4002,2,0)="^8994.02A^4^4"
^XWB(8994,4002,2,1,0)="FILE^1^15^1^1"
^XWB(8994,4002,2,1,1,0)="^^8^8^3200728^"
^XWB(8994,4002,2,1,1,1,0)="FILE"
^XWB(8994,4002,2,1,1,2,0)=" "
^XWB(8994,4002,2,1,1,3,0)="File # to the file from which to pull attachment data"
^XWB(8994,4002,2,1,1,4,0)=" "
^XWB(8994,4002,2,1,1,5,0)="19685.3:   Work Order file"
^XWB(8994,4002,2,1,1,6,0)="19685.31:  Equipment file"
^XWB(8994,4002,2,1,1,7,0)="19685.32:  Inventory Item Master file"
