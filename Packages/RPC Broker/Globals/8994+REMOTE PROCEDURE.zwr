^XWB(8994,3891,3,1,0)="RETURN PARAMETER"
^XWB(8994,3891,3,2,0)=" "
^XWB(8994,3891,3,3,0)="DSIYRET(1)=""-1"" If there are errors, errors will be further described in "
^XWB(8994,3891,3,4,0)="subsequent nodes with the format"
^XWB(8994,3891,3,5,0)="     DSIYRET(#)=FIELD# ^ Error Message ^ Type (CRITICAL or WARNING)"
^XWB(8994,3891,3,6,0)=" "
^XWB(8994,3891,3,7,0)="DSIYRET(1) = 1^Validation Message"
^XWB(8994,3891,3,8,0)=" "
^XWB(8994,3891,3,9,0)="If DSIYRET(1)=1 but the second piece has a Validation Message - the user "
