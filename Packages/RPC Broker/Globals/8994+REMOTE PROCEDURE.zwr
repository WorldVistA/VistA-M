^XWB(8994,4596,1,6,0)="  DSSOSTN - required - Station - Institution File (#4) IEN"
^XWB(8994,4596,1,7,0)="  DSSONUM - optional - Number of records to return - defaults to 2500"
^XWB(8994,4596,1,8,0)="  DSSOITM - optional - null or specific HCPCS Item "
^XWB(8994,4596,1,9,0)="Output:"
