^XWB(8994,4794,3,0)="^8994.03^1^1^3250207^^"
^XWB(8994,4794,3,1,0)="RETURN=0 or RETURN is field #2 from the SDEC APPOINTMENT (#409.84) file."
^XWB(8994,4795,0)="DVBAB CAPRI ALLOW CLINDOCS^EFOLDER^DVBCENQ^1^R^^^^1"
^XWB(8994,4795,1,0)="^8994.01^3^3^3221228^"
^XWB(8994,4795,1,1,0)="THIS CAPRI RPC WILL VALIDATE IF THE USER IS A PROVIDER, VBA USER, VHA "
^XWB(8994,4795,1,2,0)="USER WITH THE REQUIRED TITLE TO ALLOW FOR SENDING OF CLINICAL DOCUMENTS "
^XWB(8994,4795,1,3,0)="TO THE EFOLDER"
^XWB(8994,4795,2,0)="^8994.02A^1^1"
^XWB(8994,4795,2,1,0)="DFN^1^^1"
^XWB(8994,4795,2,1,1,0)="^^1^1^3221228^"
^XWB(8994,4795,2,1,1,1,0)="USERS DFN"
^XWB(8994,4795,2,"B","DFN",1)=""
^XWB(8994,4795,3,0)="^^2^2^3221228^"
^XWB(8994,4795,3,1,0)="RETURNS 0 IF NOT ALLOWED, 1 IF ALLOWED AND/OR -1^ERROR IF AN ERROR IS "
^XWB(8994,4795,3,2,0)="INCOUNTERED"
^XWB(8994,4796,0)="DVBAB CAPRI EFOLDER LOCATION^LOCATION^DVBCENQ^1^R^^^^1"
^XWB(8994,4796,1,0)="^^2^2^3221229^"
^XWB(8994,4796,1,1,0)="Returns the location to be used for Clinical Docs to be sent from CAPRI "
^XWB(8994,4796,1,2,0)="GUI"
^XWB(8994,4797,0)="DVBAB CAPRI PROVIDER^PROVIDER^DVBCENQ^1^R^^^^1"
^XWB(8994,4797,1,0)="^8994.01^1^1^3221229^"
^XWB(8994,4797,1,1,0)="CAPRI GUI verifies that the user is a Provider"
^XWB(8994,4797,2,0)="^8994.02A^1^1"
^XWB(8994,4797,2,1,0)="DFN^1^^1"
^XWB(8994,4797,2,"B","DFN",1)=""
^XWB(8994,4797,3,0)="^^1^1^3230109^"
^XWB(8994,4797,3,1,0)="RETURNS 0 IF NOT ALLOWED, 1 IF ALLOWED "
^XWB(8994,4800,0)="SDEC GET REQ BY TYPE VET JSON^GETREQBYTYPEVET^SDECAR4^2^R^0^^0^^^1"
^XWB(8994,4800,1,0)="^8994.01^2^2^3230111^^"
^XWB(8994,4800,1,1,0)="This RPC will return the first 200 appointment request records that have "
^XWB(8994,4800,1,2,0)="a TYPE of VETERAN."
^XWB(8994,4801,0)="SDES GET APPTREQ BY INST^GETREQSBYINTOPEN^SDESGETAREQINST^2^R^^^^^^1"
