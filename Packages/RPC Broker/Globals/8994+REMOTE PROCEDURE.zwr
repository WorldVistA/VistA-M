^XWB(8994,2916,0)="MAG DICOM GET PATIENT VITALS^GETPAT^MAGDHWR^2^R^0^^0^3"
^XWB(8994,2916,1,0)="^^6^6^3061023^"
^XWB(8994,2916,1,1,0)="This Remote Procedure returns some information about a patient."
^XWB(8994,2916,1,2,0)="At this time, the values returned are"
^XWB(8994,2916,1,3,0)="   VIP-code"
^XWB(8994,2916,1,4,0)="   Height"
^XWB(8994,2916,1,5,0)="   Weight"
^XWB(8994,2916,1,6,0)="This list may be extended in the future."
^XWB(8994,2916,2,0)="^8994.02A^1^1"
^XWB(8994,2916,2,1,0)="DFN^1^20^1^1"
^XWB(8994,2916,2,1,1,0)="^^2^2^3061023^"
^XWB(8994,2916,2,1,1,1,0)="The value of this parameter is the VA-defined DFN patient identifier."
^XWB(8994,2916,2,1,1,2,0)="This is the internal entry number for the patient at the local hospital."
^XWB(8994,2916,2,"B","DFN",1)=""
^XWB(8994,2916,2,"PARAMSEQ",1,1)=""
^XWB(8994,2916,3,0)="^^10^10^3061023^"
^XWB(8994,2916,3,1,0)="The return parameter for this procedure is an array."
^XWB(8994,2916,3,2,0)="If the procedure encounters an error, the value of"
^XWB(8994,2916,3,3,0)="   OUT(1) is:"
^XWB(8994,2916,3,4,0)="          a negative number, followed by an explanation"
^XWB(8994,2916,3,5,0)=" "
^XWB(8994,2916,3,6,0)="If the procedure completes successfully, the array contains values"
^XWB(8994,2916,3,7,0)="that provide values for some vital statistics of the patient, e.g.:"
^XWB(8994,2916,3,8,0)="   OUT(1)=""HEIGHT^190.50^cm^centimeter"""
^XWB(8994,2916,3,9,0)="   OUT(2)=""WEIGHT^104.55^kg^kilogram"""
^XWB(8994,2916,3,10,0)="   OUT(3)=""VIP^"""
^XWB(8994,2917,0)="VPR GET PATIENT DATA^GET^VPRD^4^S^^^1^1^^1"
^XWB(8994,2917,1,0)="^8994.01^2^2^3110606^^^^"
^XWB(8994,2917,1,1,0)="This RPC retrieves the requested data from VistA, and returns it in"
