^XWB(8994,4349,2,1,0)="DSSOUSR^1^30^1^1"
^XWB(8994,4349,2,1,1,0)="^^1^1^3150925^"
^XWB(8994,4349,2,1,1,1,0)="This is the current user you wish to get the list for."
