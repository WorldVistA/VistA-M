^XWB(8994,4284,1,20,0)="      Commodity Code (#4 - external format) ^ "
^XWB(8994,4284,1,21,0)="      Commodity Code (#4 - internal format)"
^XWB(8994,4284,1,22,0)=" "
^XWB(8994,4284,1,23,0)="    A check is made to ensure that only those FSC codes with an "
