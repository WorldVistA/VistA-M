^XWB(8994,3855,3,0)="^8994.03^7^7^3130725^^^"
^XWB(8994,3855,3,1,0)="DSIYRET"
^XWB(8994,3855,3,2,0)=" "
^XWB(8994,3855,3,3,0)="DSIYRET(1)=""-1^Error Message""   If Errors"
^XWB(8994,3855,3,4,0)="DSIYRET(1)=""0^Warning Message""  If Warnings"
^XWB(8994,3855,3,5,0)=" "
^XWB(8994,3855,3,6,0)="DSIYRET(#)=IEN^CMR^SERVICE^BRIEF DESCRIPTION^RESPONSIBLE OFFICIAL"
^XWB(8994,3855,3,7,0)="           ^STATION^ALTERNATE RESPONSIBLE OFFICIAL"
^XWB(8994,3856,0)="DSIYUTL3 POSCH PURCH ORD SCH^POSCH^DSIYUTL3^4^P^0^^1^1"
^XWB(8994,3856,1,0)="^8994.01^7^7^3150219^^^^"
^XWB(8994,3856,1,1,0)="DSIYUTL3 POSCH PURCH ORD SCH"
^XWB(8994,3856,1,2,0)=" "
^XWB(8994,3856,1,3,0)="RPC to return all PO's which are found based on the search criteria "
^XWB(8994,3856,1,4,0)="entered by the user. This is different than searches which create a "
^XWB(8994,3856,1,5,0)="dropdown based on the starting search."
^XWB(8994,3856,1,6,0)=" "
^XWB(8994,3856,1,7,0)="RPC calls VistA's internal FIND API to find PO's based on various XREF's."
^XWB(8994,3856,2,0)="^8994.02A^4^4"
^XWB(8994,3856,2,1,0)="MOVE^1^2^0^1"
^XWB(8994,3856,2,1,1,0)="^^3^3^3130115^"
^XWB(8994,3856,2,1,1,1,0)="MOVE"
^XWB(8994,3856,2,1,1,2,0)=" "
^XWB(8994,3856,2,1,1,3,0)="No longer used"
^XWB(8994,3856,2,2,0)="NOREC^1^4^0^2"
^XWB(8994,3856,2,2,1,0)="^^3^3^3130725^"
^XWB(8994,3856,2,2,1,1,0)="NOREC"
^XWB(8994,3856,2,2,1,2,0)=" "
^XWB(8994,3856,2,2,1,3,0)="Number of records to return - not required."
^XWB(8994,3856,2,2,1,4,0)="Allows null or 0-99"
^XWB(8994,3856,2,3,0)="SCHTERM^1^30^0^3"
^XWB(8994,3856,2,3,1,0)="^8994.021^4^4^3130214^^^"
^XWB(8994,3856,2,3,1,1,0)="SCHTERM"
^XWB(8994,3856,2,3,1,2,0)=" "
^XWB(8994,3856,2,3,1,3,0)="User will enter data which can look up the PO# based on all of the XREF's "
^XWB(8994,3856,2,3,1,4,0)="in the PO file."
^XWB(8994,3856,2,3,1,5,0)="Send either null or 1-11 numbers.."
^XWB(8994,3856,2,3,1,6,0)="Default format is 3 characters for the Site Parameter (^PRC(411)) - "
^XWB(8994,3856,2,3,1,7,0)="6 alpha numerics - but will allow room for growth."
^XWB(8994,3856,2,3,1,8,0)=" "
^XWB(8994,3856,2,3,1,9,0)="If Using SCHTYPE = ""C"""
^XWB(8994,3856,2,3,1,10,0)="Send just the second half of the PO# field - 6 alpha numerics"
^XWB(8994,3856,2,3,1,11,0)=" "
^XWB(8994,3856,2,3,1,12,0)="If using SCHTYPE = ""D"""
^XWB(8994,3856,2,3,1,13,0)="Send in the vendor number - usually straight numerics"
^XWB(8994,3856,2,4,0)="INDFLAG^1^1^0^4"
^XWB(8994,3856,2,4,1,0)="^^4^4^3150219^"
^XWB(8994,3856,2,4,1,1,0)="INDFLAG"
^XWB(8994,3856,2,4,1,2,0)=" "
^XWB(8994,3856,2,4,1,3,0)="GUI sends a '1' if only this PO# should be found - this is to check for a "
^XWB(8994,3856,2,4,1,4,0)="valid PO#"
^XWB(8994,3856,2,4,1,5,0)="  ""C"" = search by common numering system (last piece of PO# after ""-"")"
^XWB(8994,3856,2,4,1,6,0)="  ""D"" = search by vendor name"
^XWB(8994,3856,2,"B","INDFLAG",4)=""
^XWB(8994,3856,2,"B","MOVE",1)=""
^XWB(8994,3856,2,"B","NOREC",2)=""
^XWB(8994,3856,2,"B","SCHTERM",3)=""
^XWB(8994,3856,2,"B","SCHTYPE",4)=""
^XWB(8994,3856,2,"PARAMSEQ",1,1)=""
^XWB(8994,3856,2,"PARAMSEQ",2,2)=""
^XWB(8994,3856,2,"PARAMSEQ",3,3)=""
^XWB(8994,3856,2,"PARAMSEQ",4,4)=""
^XWB(8994,3856,3,0)="^8994.03^13^13^3150219^^^"
^XWB(8994,3856,3,1,0)="DSIYRET"
^XWB(8994,3856,3,2,0)="DSIYRET(#)= following pieces:"
^XWB(8994,3856,3,3,0)="  P1:  IEN to PO File"
^XWB(8994,3856,3,4,0)="  P2:  External PO #"
^XWB(8994,3856,3,5,0)="  P3:  PO Method"
^XWB(8994,3856,3,6,0)="  P4:  PO Date"
^XWB(8994,3856,3,7,0)="  P5:  Supply Status"
^XWB(8994,3856,3,8,0)="  P6:  Fund Control Point FCP"
^XWB(8994,3856,3,9,0)="  P7:  Vendor"
^XWB(8994,3856,3,10,0)="  P8:  Amount"
^XWB(8994,3856,3,11,0)=" "
^XWB(8994,3856,3,12,0)="DSIYRET(1)=""-1^Error Message""   If Errors"
^XWB(8994,3856,3,13,0)="DSIYRET(1)=""0^Warning Message""  If Warnings"
^XWB(8994,3857,0)="DSIYUTL4 FAPQUAL FAP QUAL^FAPQUAL^DSIYUTL4^2^P^0"
^XWB(8994,3857,1,0)="^^8^8^3130409^"
^XWB(8994,3857,1,1,0)="FAPQUAL"
^XWB(8994,3857,1,2,0)="RPC to check to see if the current piece of equipment from file ^ENG(6914)"
^XWB(8994,3857,1,3,0)="is qualified to have an FA document sent"
^XWB(8994,3857,1,4,0)="Qualification based on:"
^XWB(8994,3857,1,5,0)="  User must have security of ENFACS"
^XWB(8994,3857,1,6,0)="  The Equipment Type of Entry Field (0;4, field 6914,7) must be ""NX"""
^XWB(8994,3857,1,7,0)="  The Investment Category Field (8;2, field 6914,34) must be""1"" for"
^XWB(8994,3857,1,8,0)="     Capitalized/Accountable"
^XWB(8994,3857,1,9,0)=" "
^XWB(8994,3857,1,10,0)="RET=""Y"" if all criteria met, otherwise RET=""N"" or """""
^XWB(8994,3857,1,11,0)="RET(1)='1^error description"" if there is an error"
^XWB(8994,3857,2,0)="^8994.02A^1^1"
^XWB(8994,3857,2,1,0)="IEN^1^10^1^1"
^XWB(8994,3857,2,1,1,0)="^8994.021^2^2^3130409^^^"
^XWB(8994,3857,2,1,1,1,0)="IEN"
^XWB(8994,3857,2,1,1,2,0)="IEN number of piece of equipment from ^ENG(6914)"
^XWB(8994,3857,2,"B","IEN",1)=""
^XWB(8994,3857,2,"PARAMSEQ",1,1)=""
^XWB(8994,3857,3,0)="^^5^5^3130409^"
^XWB(8994,3857,3,1,0)="RET"
^XWB(8994,3857,3,2,0)="RET=1"" if all criteria met."
^XWB(8994,3857,3,3,0)="If RET'=""Y"" then do not continue asking questions about FA documents"
^XWB(8994,3857,3,4,0)="RET(1)=""-1^error description"" if there is an error"
^XWB(8994,3857,3,5,0)="RET(1)=""0^Warning Message"" if there are warnings"
^XWB(8994,3858,0)="DSIYUTL4 FAPVAL FAP VALIDATE^FAPVAL^DSIYUTL4^2^P^0"
^XWB(8994,3858,1,0)="^^4^4^3120619^"
^XWB(8994,3858,1,1,0)="FAPVAL"
^XWB(8994,3858,1,2,0)="RPC to return whether or not all fields pass validation in order to be"
^XWB(8994,3858,1,3,0)="allowed to send a piece of equipment to the FA Document file"
^XWB(8994,3858,1,4,0)="Calls ^ENFAACQ existing routine"
^XWB(8994,3858,2,0)="^8994.02A^1^1"
^XWB(8994,3858,2,1,0)="IEN^1^10^1^1"
^XWB(8994,3858,2,1,1,0)="^^3^3^3120619^"
^XWB(8994,3858,2,1,1,1,0)="IEN"
^XWB(8994,3858,2,1,1,2,0)="Required"
^XWB(8994,3858,2,1,1,3,0)="IEN of the piece of equipment being checked."
^XWB(8994,3858,2,"B","IEN",1)=""
^XWB(8994,3858,2,"PARAMSEQ",1,1)=""
^XWB(8994,3858,3,0)="^^7^7^3121010^"
^XWB(8994,3858,3,1,0)="RET"
^XWB(8994,3858,3,2,0)="RET(1)=""-1^Error description"" if there is an error.  Also, if there is an "
^XWB(8994,3858,3,3,0)="error, RET(X) will contain further description of the reasons the piece "
^XWB(8994,3858,3,4,0)="of equipment could not be transferred."
^XWB(8994,3858,3,5,0)=" "
^XWB(8994,3858,3,6,0)="RET(1)=1"" if all is good to go."
^XWB(8994,3858,3,7,0)="RET(1)=""0^Warning Message"" if there are warnings"
^XWB(8994,3859,0)="DSIYRPT2 ACTEQ ACTIVE EQUIP^ACTEQ^DSIYRPT2^4"
^XWB(8994,3859,1,0)="^^19^19^3130829^"
^XWB(8994,3859,1,1,0)="Schedules an AD-HOC report consisting of requested fields for all"
^XWB(8994,3859,1,2,0)="equipment in the EQUIPMENT INV. (#6914) file with a USE STATUS of IN USE."
^XWB(8994,3859,1,3,0)=" "
^XWB(8994,3859,1,4,0)="The data for this report can be retrieved via the DSIYRPTR GETRPT GET RPT "
^XWB(8994,3859,1,5,0)="DATA RPC. Data returned will consist of the fields requested in the order "
^XWB(8994,3859,1,6,0)="the fields were submitted. If the data exceeds string length limits, the "
^XWB(8994,3859,1,7,0)="data will be broken up over mulitple lines. Because of this, the first "
^XWB(8994,3859,1,8,0)="piece of each record will be ""$$REC""."
^XWB(8994,3859,1,9,0)="RET(0) is header column data"
^XWB(8994,3859,1,10,0)="RET(1-n) is record data, each record will begin with $$REC"
^XWB(8994,3859,1,11,0)="Example:"
^XWB(8994,3859,1,12,0)="RET(0)=Column1header^Column2header^Column3header^(etc)"
^XWB(8994,3859,1,13,0)="RET(1)=$$REC^Column1data^Column2data^Column3data^(etc)"
^XWB(8994,3859,1,14,0)="Example:"
^XWB(8994,3859,1,15,0)="RET(0)=SERIAL #(number)^TYPE OF ENTRY(text)^ENTERED "
^XWB(8994,3859,1,16,0)="BY(text)^DATE ENTERED(date)^ MFGR. EQUIPMENT NAME(text)^ENTRY "
^XWB(8994,3859,1,17,0)="NUMBER(number)"
^XWB(8994,3859,1,18,0)="RET(1)=$$REC^123456^NON-EXPENDABLE EQPT^TEST,USER^AUG 22, 2013^"
^XWB(8994,3859,1,19,0)="        DEFIBRILLATOR W/O MONITOR^1"
^XWB(8994,3859,2,0)="^8994.02A^2^2"
^XWB(8994,3859,2,1,0)="FIELDS^1^240^1^1"
^XWB(8994,3859,2,1,1,0)="^^2^2^3120720^"
^XWB(8994,3859,2,1,1,1,0)="A "";""-delimited string listing the field numbers in the EQIUPMENT INV. "
^XWB(8994,3859,2,1,1,2,0)="(#6914) file to return."
^XWB(8994,3859,2,2,0)="ESTART^1^30^0^2"
^XWB(8994,3859,2,2,1,0)="^8994.021^1^1^3130829^^^"
^XWB(8994,3859,2,2,1,1,0)="Earliest time to start scheduled report. Defaults to ""NOW""."
^XWB(8994,3859,2,"B","ESTART",2)=""
^XWB(8994,3859,2,"B","FIELDS",1)=""
^XWB(8994,3859,2,"PARAMSEQ",1,1)=""
^XWB(8994,3859,2,"PARAMSEQ",2,2)=""
^XWB(8994,3859,3,0)="^8994.03^7^7^3130829^^^^"
^XWB(8994,3859,3,1,0)="If successful, returns:"
^XWB(8994,3859,3,2,0)=" "
^XWB(8994,3859,3,3,0)="   [Task Number]^REPORT AFTER [time report is scheduled to run]"
^XWB(8994,3859,3,4,0)=" "
^XWB(8994,3859,3,5,0)="If error, returns:"
^XWB(8994,3859,3,6,0)=" "
^XWB(8994,3859,3,7,0)="   -1^[Error Message]"
^XWB(8994,3860,0)="DSIYUTL4 FAPUPDT FAP UPDT^FAPUPDT^DSIYUTL4^2^P^0^^1"
^XWB(8994,3860,1,0)="^^5^5^3120702^"
^XWB(8994,3860,1,1,0)="FAPUPDT"
^XWB(8994,3860,1,2,0)="This RPC allows the user to update the FA Documents replacing the"
^XWB(8994,3860,1,3,0)="questions asked as the end of a normal Equipment Inventory Session."
^XWB(8994,3860,1,4,0)="This will only be called if the Equipment qualifies (using RPC"
^XWB(8994,3860,1,5,0)="FAPVAL^DSIYUTL4)for having an FAP document."
^XWB(8994,3860,2,0)="^8994.02A^3^3"
^XWB(8994,3860,2,1,0)="IEN^1^10^1^1"
^XWB(8994,3860,2,1,1,0)="^^4^4^3120702^"
^XWB(8994,3860,2,1,1,1,0)="IEN"
^XWB(8994,3860,2,1,1,2,0)="Required"
^XWB(8994,3860,2,1,1,3,0)="IEN # of the Piece of Equipment from the Equipment Management File "
^XWB(8994,3860,2,1,1,4,0)="^ENG(6914)"
^XWB(8994,3860,2,2,0)="AVRSN^1^5^0^2"
^XWB(8994,3860,2,2,1,0)="^^3^3^3120702^"
^XWB(8994,3860,2,2,1,1,0)="AVRSN"
^XWB(8994,3860,2,2,1,2,0)="Internal value to point to AV REASON file ^ENG(6915.11)"
^XWB(8994,3860,2,2,1,3,0)="If user selects to not have an Adjustment Voucher, set this entry to null."
^XWB(8994,3860,2,3,0)="AVCOM^3^60^0^3"
^XWB(8994,3860,2,3,1,0)="^^5^5^3120702^"
^XWB(8994,3860,2,3,1,1,0)="AVCOM"
^XWB(8994,3860,2,3,1,2,0)="Word processing field"
^XWB(8994,3860,2,3,1,3,0)="Not Required"
^XWB(8994,3860,2,3,1,4,0)="If user selects to not have Adjustment Vouchers, set AVCOM(1) = null"
^XWB(8994,3860,2,3,1,5,0)="To delete current Word Processing data, set AVCOM(1) = ""@"""
^XWB(8994,3860,2,"B","AVCOM",3)=""
^XWB(8994,3860,2,"B","AVRSN",2)=""
^XWB(8994,3860,2,"B","IEN",1)=""
^XWB(8994,3860,2,"PARAMSEQ",1,1)=""
^XWB(8994,3860,2,"PARAMSEQ",2,2)=""
^XWB(8994,3860,2,"PARAMSEQ",3,3)=""
^XWB(8994,3860,3,0)="^^10^10^3121010^"
^XWB(8994,3860,3,1,0)="RET"
^XWB(8994,3860,3,2,0)=" "
^XWB(8994,3860,3,3,0)="RET(1)=""-1^Error Description"" if there is an error."
^XWB(8994,3860,3,4,0)="RET(1)=""0^Warning Message""  if there are warnings"
^XWB(8994,3860,3,5,0)=" "
^XWB(8994,3860,3,6,0)="RET(1)=""1Y^Message"" if completed successfully."
^XWB(8994,3860,3,7,0)=" "
^XWB(8994,3860,3,8,0)="NOTE:  If the user chooses not to have an Adjustment Voucher - OR - the "
^XWB(8994,3860,3,9,0)="Adjustment Voucher update does not work correctly, this is still "
^XWB(8994,3860,3,10,0)="considered a good outcome as the Adjustment Voucher area is not required."
^XWB(8994,3861,0)="DSIYUTL5 PMDISDEC DISPLAY DEC^PMDISDEC^DSIYUTL5^2^P^0"
^XWB(8994,3861,1,0)="^^4^4^3130313^"
^XWB(8994,3861,1,1,0)="PMDISDEC"
^XWB(8994,3861,1,2,0)="This RPC verifies whether a piece of equipment has Product Maintenance "
^XWB(8994,3861,1,3,0)="values set up in either the Equipment Management file, the Equipment "
^XWB(8994,3861,1,4,0)="Category File or none at all and returns:"
^XWB(8994,3861,1,5,0)=" "
^XWB(8994,3861,1,6,0)="RET(1)=""E"" If the Equipment Management File ^ENG(6914) has product "
^XWB(8994,3861,1,7,0)="maintenance already set up"
^XWB(8994,3861,1,8,0)=" "
^XWB(8994,3861,1,9,0)="RET(1)=""C"" If the Equipment Management File does not have product "
^XWB(8994,3861,1,10,0)="maintenance but the piece of equipment's category in ^ENG(6911) has "
^XWB(8994,3861,1,11,0)="product maintenance values (then a further RPC will ask the user if they "
^XWB(8994,3861,1,12,0)="want to use these values for this piece of equipment)"
^XWB(8994,3861,1,13,0)=" "
^XWB(8994,3861,1,14,0)="RET(1)=""N"" if neither"
^XWB(8994,3861,2,0)="^8994.02A^1^1"
^XWB(8994,3861,2,1,0)="IEN^1^11^1^1"
^XWB(8994,3861,2,1,1,0)="^8994.021^3^3^3130313^^^"
^XWB(8994,3861,2,1,1,1,0)="IEN"
^XWB(8994,3861,2,1,1,2,0)="Required"
^XWB(8994,3861,2,1,1,3,0)="IEN from Equipment Management File ^ENG(6914)"
^XWB(8994,3861,2,"B","IEN",1)=""
^XWB(8994,3861,2,"PARAMSEQ",1,1)=""
^XWB(8994,3861,3,0)="^8994.03^8^8^3130313^^"
^XWB(8994,3861,3,1,0)="RETURN PARAMETER"
^XWB(8994,3861,3,2,0)=" "
^XWB(8994,3861,3,3,0)="DSIYRET(1)=""0^Warning""     If there are warnings/nothing returned"
^XWB(8994,3861,3,4,0)="DSIYRET(1)=""-1^Error""      If there are errors"
^XWB(8994,3861,3,5,0)="DSIYRET(1)=TYPE"
^XWB(8994,3861,3,6,0)="   TYPE=""E"" If the equipment has PM setup"
^XWB(8994,3861,3,7,0)="   TYPE=""C"" If the Equipment Category has PM setup"
^XWB(8994,3861,3,8,0)="   TYPE=""N"" If neither have PM setup"
^XWB(8994,3862,0)="DSIYRPT2 STATUS STAT RPT^STATUS^DSIYRPT2^4"
^XWB(8994,3862,1,0)="^^8^8^3120718^"
^XWB(8994,3862,1,1,0)="Schedules a report consisting of requested fields for all equipment in "
^XWB(8994,3862,1,2,0)="the EQUIPMENT INV. (#6914) file with one of the requested USE STATUSes."
^XWB(8994,3862,1,3,0)=" "
^XWB(8994,3862,1,4,0)="The data for this report can be retrieved via the DSIYRPTR GETRPT GET RPT"
^XWB(8994,3862,1,5,0)="DATA RPC. Data returned will consist of the fields requested in the order"
^XWB(8994,3862,1,6,0)="the fields were submitted. If the data exceeds string length limits, the"
^XWB(8994,3862,1,7,0)="data will be broken up over multiple lines. Because of this, the first"
^XWB(8994,3862,1,8,0)="piece of each record will be ""$$REC"""
^XWB(8994,3862,2,0)="^8994.02A^3^3"
^XWB(8994,3862,2,1,0)="STATUSES^1^30^1^1"
^XWB(8994,3862,2,1,1,0)="^^1^1^3120706^"
^XWB(8994,3862,2,1,1,1,0)="^-delimited list of statuses in internal format to show"
^XWB(8994,3862,2,2,0)="FIELDS^1^240^1^2"
^XWB(8994,3862,2,2,1,0)="^8994.021^2^2^3120718^^"
^XWB(8994,3862,2,2,1,1,0)="A "";""-delimited string listing the field numbers in the EQUIPMENT INV. "
^XWB(8994,3862,2,2,1,2,0)="(#6914) file to return."
^XWB(8994,3862,2,3,0)="ESTART^1^30^0^3"
^XWB(8994,3862,2,3,1,0)="^8994.021^1^1^3120718^^"
^XWB(8994,3862,2,3,1,1,0)="Earliest time to start scheduled report. Defaults to ""NOW""."
^XWB(8994,3862,2,"B","ESTART",3)=""
