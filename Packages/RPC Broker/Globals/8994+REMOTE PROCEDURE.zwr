^XWB(8994,4358,3,1,0)="Output:"
^XWB(8994,4358,3,2,0)="  Error Messages:"
^XWB(8994,4358,3,3,0)="    DSSORET(0) = ""-1^""_xxxxxxxx"
^XWB(8994,4358,3,4,0)="      where xxxxxxxx = error message"
^XWB(8994,4358,3,5,0)=" "
^XWB(8994,4358,3,6,0)="  Successful Completion:"
^XWB(8994,4358,3,7,0)="    DSSORET(n) = lines from the word-processing VistA parameter"
^XWB(8994,4359,0)="DSSO DAT PREPOPULATOR^EN^DSSOPR1^4^^^^1"
^XWB(8994,4359,1,0)="^8994.01^6^6^3201216^^^^"
^XWB(8994,4359,1,1,0)="This RPC extracts all valid records from the Record of Pros "
^XWB(8994,4359,1,2,0)="Appliance/Repair (#660) file from the date in the DSSO DAT PREPOP START "
^XWB(8994,4359,1,3,0)="DATE forward.  The number of records processed per run is specified by "
^XWB(8994,4359,1,4,0)="parameter DSSO DAT PREPOP RCDS PER RUN.  This job will begin with the "
^XWB(8994,4359,1,5,0)="IEN specified in parameter DSSO DAT PREPOP LAST 660 IEN.  The job is "
^XWB(8994,4359,1,6,0)="controlled by VistA parameters.  No input parameters are needed."
^XWB(8994,4359,3,0)="^^60^60^3201216^"
^XWB(8994,4359,3,1,0)="The first line of the returned array will be in the following format:"
^XWB(8994,4359,3,2,0)=" List [0] = Purge Date ^ Create Date ^ descriptive information"
^XWB(8994,4359,3,3,0)="    Example:  3150323^31503123^DSS APAT Appliance Transaction Extract temp"
^XWB(8994,4359,3,4,0)=" "
^XWB(8994,4359,3,5,0)=" All fields from file 660 and a few fields from the Patient file (#3) are"
^XWB(8994,4359,3,6,0)=" returned in the following format:"
^XWB(8994,4359,3,7,0)="  List [n]=""$$APPLIANCE TRANSACTION$$"""
^XWB(8994,4359,3,8,0)="  List [n...]=file 660 ien^field number^""E"" or ""I""^data"
^XWB(8994,4359,3,9,0)="     (external values of all fields are returned followed by a limited"
^XWB(8994,4359,3,10,0)="      number of internal values)"
^XWB(8994,4359,3,11,0)=" "
^XWB(8994,4359,3,12,0)=" If field 28 Extended Description exists, this section will be"
^XWB(8994,4359,3,13,0)="  present:"
^XWB(8994,4359,3,14,0)="  List [n]=""$$EXTENDED DESCRIPTION (660 field 28)$$"""
^XWB(8994,4359,3,15,0)="  List [n]=xxxx^28^line number^data"
^XWB(8994,4359,3,16,0)="  List [n...]=xxxx^28^line number^data"
^XWB(8994,4359,3,17,0)="           where:"
^XWB(8994,4359,3,18,0)="            xxxx = file 660 IEN"
^XWB(8994,4359,3,19,0)="            field number 28 = Extended Description from file 660 "
^XWB(8994,4359,3,20,0)="            data = one line of data from the word-processing field"
^XWB(8994,4359,3,21,0)=" "
^XWB(8994,4359,3,22,0)=" If field 8.1 Suspense Date in file 660 is not null, this section"
^XWB(8994,4359,3,23,0)="  will be present:"
^XWB(8994,4359,3,24,0)="  List [n]=""$$DESCRIPTION OF ITEM/SERVICES$$"""
^XWB(8994,4359,3,25,0)="  List [n]=xxxx^4^line number^data"
^XWB(8994,4359,3,26,0)="  List [n...]=xxxx^4^line number^data"
^XWB(8994,4359,3,27,0)="           where:"
^XWB(8994,4359,3,28,0)="            xxxx = file 668 IEN"
^XWB(8994,4359,3,29,0)="            field number 4 = Description of Item/Services from file 668"
^XWB(8994,4359,3,30,0)="            data = one line of data from the word-processing field"
^XWB(8994,4359,3,31,0)=" "
^XWB(8994,4359,3,32,0)="  List [n]=""$$HCPCS SHORT NAME$$"""
^XWB(8994,4359,3,33,0)="  List [n]=xxxx^.02^E^data"
^XWB(8994,4359,3,34,0)="           where:"
^XWB(8994,4359,3,35,0)="            field number .02 = HCPCS Short Name from file 661.1"
^XWB(8994,4359,3,36,0)="            xxxx = 661.1 IEN if a HCPCS is present (in field 4.5 of file"
^XWB(8994,4359,3,37,0)="                   660) or just ""661.1"" if this is a SHIPPING entry"
^XWB(8994,4359,3,38,0)=" "
^XWB(8994,4359,3,39,0)="  List [n]=""$$PATIENT$$"""
^XWB(8994,4359,3,40,0)="  List [n]=file 2 ien^field number^""E"" or ""I""^data"
^XWB(8994,4359,3,41,0)="  List [n...]=Patient file (#2) information in the above format"
^XWB(8994,4359,3,42,0)="    for fields:"
^XWB(8994,4359,3,43,0)="       Date of Birth (#.03)"
^XWB(8994,4359,3,44,0)="       ICN (as returned from DSIC DPT GET ICN)"
^XWB(8994,4359,3,45,0)="       Patient ID (#.0905)"
^XWB(8994,4359,3,46,0)=" "
^XWB(8994,4359,3,47,0)="   The Last Record Processed will appear as:"
^XWB(8994,4359,3,48,0)="           List[9999999999999998] = ^-pc 1 Text ""$$LAST RCD$$"""
^XWB(8994,4359,3,49,0)="                                    ^-pc 2 IEN of last record processed"
^XWB(8994,4359,3,50,0)=" "
^XWB(8994,4359,3,51,0)="   The End of the dataset will appear as:"
^XWB(8994,4359,3,52,0)="           List [999999999999999] = Text ""$$END$$"""
^XWB(8994,4359,3,53,0)=" "
^XWB(8994,4359,3,54,0)="  Error Messages:"
^XWB(8994,4359,3,55,0)="    Any error message will occur along with the $$LAST RCD$$ or $$END$$"
^XWB(8994,4359,3,56,0)="    entries."
^XWB(8994,4359,3,57,0)=" "
^XWB(8994,4359,3,58,0)="    List [""E""] = Purge Date ^ Create Date./Time ^"
^XWB(8994,4359,3,59,0)="                 Error in 2319 Extract: -1^xxxxxxxx"
^XWB(8994,4359,3,60,0)="          where xxxxxxxx=text of error message"
^XWB(8994,4360,0)="DSSO DTLD CANCEL PC ORDER^CANPC^DSSODPC^1"
^XWB(8994,4360,1,0)="^^15^15^3220524^"
^XWB(8994,4360,1,1,0)="This RPC cancels an incomplete purchase card order in the Procurement & "
^XWB(8994,4360,1,2,0)="Accounting Transactions file (#442) and the Control Point Activity File "
^XWB(8994,4360,1,3,0)="(#410)."
^XWB(8994,4360,1,4,0)=" "
^XWB(8994,4360,1,5,0)="If this is a simplified purchase card order, then it is marked cancelled"
^XWB(8994,4360,1,6,0)="in the PROSTHETICS 1358 (#664) file."
^XWB(8994,4360,1,7,0)=" "
^XWB(8994,4360,1,8,0)="In order to cancel a purchase card order:"
^XWB(8994,4360,1,9,0)="  1)  SUPPLY STATUS ORDER (file 442 field .7) must be less than 9."
^XWB(8994,4360,1,10,0)="  2)  PA/PPM/AUTHORIZED BUYER (file 442 field 16) must match the"
^XWB(8994,4360,1,11,0)="      logged-on user."
^XWB(8994,4360,1,12,0)="  3)  METHOD OF PROCESSING (file 442 field .02) must be ""PURCHASE CARD"""
^XWB(8994,4360,1,13,0)="      (25)."
^XWB(8994,4360,1,14,0)="  4)  TYPE OF ORDER (file 442 field 48) must be ""P"" (detailed purchase"
^XWB(8994,4360,1,15,0)="      card order) or ""S"" (simplified purchase card order)."
^XWB(8994,4360,2,0)="^8994.02A^2^2"
^XWB(8994,4360,2,1,0)="DSSO442^1^30^1^1"
^XWB(8994,4360,2,1,1,0)="^^1^1^3170209^"
^XWB(8994,4360,2,1,1,1,0)="File 442 IEN"
^XWB(8994,4360,2,2,0)="DSSODUZ^1^30^1^2"
^XWB(8994,4360,2,2,1,0)="^8994.021^1^1^3220524^^^^"
^XWB(8994,4360,2,2,1,1,0)="DUZ of logged-on user"
^XWB(8994,4360,2,"B","DSSO442",1)=""
^XWB(8994,4360,2,"B","DSSODUZ",2)=""
^XWB(8994,4360,2,"PARAMSEQ",1,1)=""
^XWB(8994,4360,2,"PARAMSEQ",2,2)=""
^XWB(8994,4360,3,0)="^^8^8^3220609^"
^XWB(8994,4360,3,1,0)="Output:"
^XWB(8994,4360,3,2,0)="  Error Message:  ""-1^""_error message"
^XWB(8994,4360,3,3,0)="                  ""-2^""_error message"
^XWB(8994,4360,3,4,0)="  Warning Message:  ""0^""_warning message"
^XWB(8994,4360,3,5,0)=" "
^XWB(8994,4360,3,6,0)="  Successful Completion:  ""1^PO ""_xxx-xxxxx_""successfully "
^XWB(8994,4360,3,7,0)="                           cancelled."""
^XWB(8994,4360,3,8,0)="                         where xxx-xxxxxx = Purchase Card Order Number"
^XWB(8994,4360,3,9,0)="                   ""-1^Cancel PC Order Unsuccessful xxx-xxxxxx""_error text"
^XWB(8994,4360,3,10,0)="                   where xxx-xxxxxx = Purchase Card Order Number"
^XWB(8994,4360,3,11,0)=" "
^XWB(8994,4360,3,12,0)=" "
^XWB(8994,4360,3,13,0)="  Successful Completion:  ""1^Cancel Purchase Card Transaction xxx-xxxxxx"
^XWB(8994,4360,3,14,0)="                           successful."""
^XWB(8994,4360,3,15,0)="                           where xxx-xxxxxx = Purchase Card Order Number"
^XWB(8994,4361,0)="DSSO DPT GET ICN^ICN^DSSOPT^1^A^^^"
^XWB(8994,4361,1,0)="^8994.01^2^2^3180222^^^^"
^XWB(8994,4361,1,1,0)="This will return the patient's Integration Control Number (ICN) and a"
^XWB(8994,4361,1,2,0)=" flag indicating whether or not it is a local ICN."
^XWB(8994,4361,2,0)="^8994.02A^3^3"
^XWB(8994,4361,2,1,0)="DSSOPAT^1^30^1^1"
^XWB(8994,4361,2,1,1,0)="^8994.021^1^1^3180222^^^"
^XWB(8994,4361,2,1,1,1,0)="Patient lookup value which can be the DFN, name, or SSN."
^XWB(8994,4361,2,2,0)="DSSOSSN^1^1^0^2"
^XWB(8994,4361,2,2,1,0)="^^2^2^3180222^"
^XWB(8994,4361,2,2,1,1,0)="Boolean flag (0,1) indicates whether or not DSSOPAT (the patient lookup "
^XWB(8994,4361,2,2,1,2,0)="value) is an SSN."
^XWB(8994,4361,2,3,0)="DSSOFUN^1^1^0^3"
^XWB(8994,4361,2,3,1,0)="^8994.021^1^1^3180222^^^^"
^XWB(8994,4361,2,3,1,1,0)="Indicator telling whether this subroutine was called as a function"
^XWB(8994,4361,2,"B","DSSOFUN",3)=""
^XWB(8994,4361,2,"B","DSSOPAT",1)=""
^XWB(8994,4361,2,"B","DSSOSSN",2)=""
^XWB(8994,4361,2,"B","ISSSN",2)=""
^XWB(8994,4361,2,"B","PAT",1)=""
^XWB(8994,4361,2,"PARAMSEQ",1,1)=""
^XWB(8994,4361,2,"PARAMSEQ",2,2)=""
^XWB(8994,4361,2,"PARAMSEQ",3,3)=""
^XWB(8994,4361,3,0)="^8994.03^4^4^3180222^^^^"
^XWB(8994,4361,3,1,0)="On error, return -1^message"
^XWB(8994,4361,3,2,0)=" Else, return ICN ^ flag  where"
^XWB(8994,4361,3,3,0)="   ICN is either a national or local ICN with checksum"
^XWB(8994,4361,3,4,0)="  flag is N:national; L:local"
^XWB(8994,4362,0)="DSSO LIST IMF HCPCS SYNONYMS^HCPCSYN^DSSOUT3^2^^^^1"
^XWB(8994,4362,1,0)="^^6^6^3170906^"
^XWB(8994,4362,1,1,0)="This RPC returns Synonyms (#.08) for the requested Item Master item"
^XWB(8994,4362,1,2,0)="(#441) if a valid entry in the Prosthetic HCPCS file (#661.1).  If the "
^XWB(8994,4362,1,3,0)="HCPCS is inactive (STATUS (#3) external value equals ""INACTIVE""; internal"
^XWB(8994,4362,1,4,0)="value = 0), then a message ""** inactive HCPCS ** - use HCPCS:  xxxxx"" "
^XWB(8994,4362,1,5,0)="where xxxxx = NEW HCPC CODE (#1) will be displayed in the dropdown next to"
^XWB(8994,4362,1,6,0)="the inactive HCPCS."
^XWB(8994,4362,2,0)="^8994.02A^1^1"
^XWB(8994,4362,2,1,0)="DSSO441^1^30^1^1"
^XWB(8994,4362,2,1,1,0)="^8994.021^1^1^3170906^^^^"
^XWB(8994,4362,2,1,1,1,0)="Item Master (#441) IEN"
^XWB(8994,4362,2,"B","DSSO441",1)=""
^XWB(8994,4362,2,"PARAMSEQ",1,1)=""
^XWB(8994,4362,3,0)="^8994.03^23^23^3170906^^"
^XWB(8994,4362,3,1,0)="Output: "
^XWB(8994,4362,3,2,0)="  Error Message:  ""-1^Invalid Item Master"""
^XWB(8994,4362,3,3,0)="  Warning Message:  ""0^No Synonyms are valid Prosthetic HCPCS."""
^XWB(8994,4362,3,4,0)="  Successful Message:"
^XWB(8994,4362,3,5,0)="    DSSORET(n) - array containing the Synonyms associated to the input "
^XWB(8994,4362,3,6,0)="                  Item Master item that are valid entries in the"
^XWB(8994,4362,3,7,0)="                  Prosthetic HCPCS (#661.1) file with associated fields in"
^XWB(8994,4362,3,8,0)="                  external and internal formats:"
^XWB(8994,4362,3,9,0)="                    ^-pc 1 - File 661.1 IEN"
^XWB(8994,4362,3,10,0)="                    ^-pc 2 - HCPCS - external (#.01)"
^XWB(8994,4362,3,11,0)="                    ^-pc 3 - HCPCS - internal (#.01)"
^XWB(8994,4362,3,12,0)="                    ^-pc 4 - Short Name - external (#.02)"
^XWB(8994,4362,3,13,0)="                    ^-pc 5 - Short Name - internal (#.02)"
^XWB(8994,4362,3,14,0)="                    ^-pc 6 - CPT Modifier - external (#.03)"
^XWB(8994,4362,3,15,0)="                    ^-pc 7 - CPT Modifier - internal (#.03)"
^XWB(8994,4362,3,16,0)="                    ^-pc 8 - Inventory Flag - external (#10)"
^XWB(8994,4362,3,17,0)="                    ^-pc 9 - Inventory Flag - internal (#10)"
^XWB(8994,4362,3,18,0)="                    ^-pc 10 - Rental Flag - external (#30)"
^XWB(8994,4362,3,19,0)="                    ^-pc 11 - Rental Flag - internal (#30)"
^XWB(8994,4362,3,20,0)="                    ^-pc 12 - Status - external (#3)"
^XWB(8994,4362,3,21,0)="                    ^-pc 13 - Status - internal (#3)"
^XWB(8994,4362,3,22,0)="                    ^-pc 14 - New HCPC Code - external (#1)"
^XWB(8994,4362,3,23,0)="                    ^-pc 15 - New HCPC Code - internal (#1)"
^XWB(8994,4363,0)="DSSO CHECK SUSPENSE STATUS^CHKSTAT^DSSOSUG^1"
^XWB(8994,4363,1,0)="^8994.01^3^3^3171114^^^^"
^XWB(8994,4363,1,1,0)="For the specified PROSTHETIC SUSPENSE (#668) FILE IEN, this RPC returns "
^XWB(8994,4363,1,2,0)="a ""1"" if the STATUS (#14) is ""CLOSED"" or ""CANCELLED"" and a ""0"" if"
^XWB(8994,4363,1,3,0)="the STATUS (#14) is ""OPEN"" or ""PENDING""."
^XWB(8994,4363,2,0)="^8994.02A^1^1"
^XWB(8994,4363,2,1,0)="DSSO668^1^30^1^1"
^XWB(8994,4363,2,1,1,0)="^8994.021^1^1^3171114^^^^"
^XWB(8994,4363,2,1,1,1,0)="PROSTHETIC SUSPENSE (#668) IEN"
^XWB(8994,4363,2,"B","DSSO668",1)=""
^XWB(8994,4363,2,"PARAMSEQ",1,1)=""
^XWB(8994,4363,3,0)="^^8^8^3171114^"
^XWB(8994,4363,3,1,0)="Output:"
^XWB(8994,4363,3,2,0)="  Error Messages:  ""-1^""_error message"
^XWB(8994,4363,3,3,0)="                   ""-1^Invalid Suspense IEN"""
^XWB(8994,4363,3,4,0)="                   ""-1^No status available"""
^XWB(8994,4363,3,5,0)="                   Additional error messages may be send by"
^XWB(8994,4363,3,6,0)="                   FileMan APIs."
^XWB(8994,4363,3,7,0)="  Successful Completion: ""1"" if STATUS (#14) is CLOSED or CANCELLED"
^XWB(8994,4363,3,8,0)="                         ""0"" if STATUS (#14) is OPEN or PENDING."
^XWB(8994,4364,0)="DSSO GET BILLING ITEM DFLTS^ITMDFLTS^DSSOUT7^4^^^^1"
^XWB(8994,4364,1,0)="^8994.01^3^3^3171114^^"
^XWB(8994,4364,1,1,0)="This RPC returns ITEM MASTER (#441) FILE fields for the specified "
^XWB(8994,4364,1,2,0)="PROS ITEM MASTER (#661) FILE Item and Vendor for use in setting the "
^XWB(8994,4364,1,3,0)="Billing Item defaults on the Create PO tab."
^XWB(8994,4364,2,0)="^8994.02A^2^2"
^XWB(8994,4364,2,1,0)="DSSO661^1^30^1^1"
^XWB(8994,4364,2,1,1,0)="^^1^1^3171109^"
^XWB(8994,4364,2,1,1,1,0)="File 661 IEN"
^XWB(8994,4364,2,2,0)="DSSO440^1^30^1^2"
^XWB(8994,4364,2,2,1,0)="^8994.021^1^1^3171114^^"
^XWB(8994,4364,2,2,1,1,0)="File 440 IEN"
^XWB(8994,4364,2,"B","DSSO440",2)=""
^XWB(8994,4364,2,"B","DSSO661",1)=""
^XWB(8994,4364,2,"PARAMSEQ",1,1)=""
^XWB(8994,4364,2,"PARAMSEQ",2,2)=""
^XWB(8994,4364,3,0)="^^22^22^3171114^"
^XWB(8994,4364,3,1,0)="Output:"
^XWB(8994,4364,3,2,0)="  Error Messages:  DSSORET(0)=""-1^""_error message  OR"
^XWB(8994,4364,3,3,0)="                               ""0^""_warning message"
^XWB(8994,4364,3,4,0)="                   ""-1^Invalid Vendor"""
^XWB(8994,4364,3,5,0)="                   ""-1^Invalid Pros Item Master IEN"""
^XWB(8994,4364,3,6,0)="                   ""0^No Item Information found."""
^XWB(8994,4364,3,7,0)="                   Additional error messages may be sent by the"
^XWB(8994,4364,3,8,0)="                     FileMan APIs. "
^XWB(8994,4364,3,9,0)="  Successful Completion:  Returns external and internal formats of all"
^XWB(8994,4364,3,10,0)="    fields in the corresponding VENDOR multiple of the ITEM MASTER (#441)"
^XWB(8994,4364,3,11,0)="    file."
^XWB(8994,4364,3,12,0)=" "
^XWB(8994,4364,3,13,0)="    DSSORET(n)="
^XWB(8994,4364,3,14,0)="      ^pc 1 - subfile number - 441.01"
^XWB(8994,4364,3,15,0)="      ^pc 2 - subfile IENS "
^XWB(8994,4364,3,16,0)="      ^pc 3 - field number"
^XWB(8994,4364,3,17,0)="      ^pc 4 - format (""E"" - external; ""I"" - internal)"
^XWB(8994,4364,3,18,0)="      ^pc 5 - field value"
^XWB(8994,4364,3,19,0)=" "
^XWB(8994,4364,3,20,0)="   NOTE:  Vendor (field 2) may not have an external value.  Check for the "
^XWB(8994,4364,3,21,0)="          presence of an external value, and if it is null, then use the"
^XWB(8994,4364,3,22,0)="          internal value."
^XWB(8994,4365,0)="DSSO PROS PCO TRNS SEQ NO CHK^TRANSEQ^DSSOPNB^1"
^XWB(8994,4365,1,0)="^^2^2^3180514^"
^XWB(8994,4365,1,1,0)="This RPC checks for transaction sequence number availability and should "
^XWB(8994,4365,1,2,0)="be called before creating a Prosthetic (simplified) purchase card order."
^XWB(8994,4365,2,0)="^8994.02A^3^3"
^XWB(8994,4365,2,1,0)="DSSODT^1^7^0^1"
^XWB(8994,4365,2,1,1,0)="^8994.021^1^1^3180514^^"
^XWB(8994,4365,2,1,1,1,0)="Any date in Fileman format - defaults to the current date"
^XWB(8994,4365,2,2,0)="DSSOPRCSITE^1^15^1^2"
^XWB(8994,4365,2,2,1,0)="^^1^1^3180514^"
^XWB(8994,4365,2,2,1,1,0)="IFCAP site (pointer to the ADMIN. SITE PARAMETERS FILE (#411)"
^XWB(8994,4365,2,3,0)="DSSOFCP^1^30^1^3"
^XWB(8994,4365,2,3,1,0)="^8994.021^1^1^3180514^^^"
^XWB(8994,4365,2,3,1,1,0)="DSSOFCP - required - CONTROL POINT NAME (i.e. - ""910 PROSTHETICS"")"
^XWB(8994,4365,2,"B","DSSODT",1)=""
^XWB(8994,4365,2,"B","DSSOFCP",3)=""
^XWB(8994,4365,2,"B","DSSOPRCSITE",2)=""
^XWB(8994,4365,2,"PARAMSEQ",1,1)=""
