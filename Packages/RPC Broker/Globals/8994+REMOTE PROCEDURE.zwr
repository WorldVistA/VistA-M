^XWB(8994,4410,2,1,1,9,0)="                 OR   = CPRS (#100)"
^XWB(8994,4410,2,1,1,10,0)="                 OUT  = Outside of application"
^XWB(8994,4410,2,1,1,11,0)="                 ???  = Other packages to be determined"
^XWB(8994,4410,2,1,1,12,0)="        Piece 4: Capturing application (Free Text)"
^XWB(8994,4410,2,1,1,13,0)="      ORTXT(1..n,1..n)=""Copied text"""
