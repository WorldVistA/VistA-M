^XWB(8994,2549,2,3,1,0)="^^1^1^3041214^"
^XWB(8994,2549,2,3,1,1,0)="Status codes specifying results to be included or excluded."
^XWB(8994,2549,2,4,0)="FIELDS^1^80^0^4"
