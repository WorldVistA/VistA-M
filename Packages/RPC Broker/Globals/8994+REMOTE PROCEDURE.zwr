^XWB(8994,5137,0)="SDES2 GET CLINIC BY STOP CODE^GETCLIN^SDES2GETCLINST^2^R^^^^^^1"
^XWB(8994,5137,1,0)="^^5^5^3250610^"
^XWB(8994,5137,1,1,0)="RPC to return clinic details by Primary Stop Code and Credit Stop Code."
^XWB(8994,5137,1,2,0)="Also, a Boolean flag is included and if set to 1 then active and"
^XWB(8994,5137,1,3,0)="inactive clinics are returned."
^XWB(8994,5137,1,4,0)="  "
^XWB(8994,5137,1,5,0)="Can only be invoked by Acheron"
^XWB(8994,5137,2,0)="^8994.02A^2^2"
^XWB(8994,5137,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,5137,2,1,1,0)="^^11^11^3250605^"
^XWB(8994,5137,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"")"
^XWB(8994,5137,2,1,1,2,0)="   - Up to 40 Character unique ID number. "
^XWB(8994,5137,2,1,1,3,0)="   - Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5137,2,1,1,4,0)="SDCONTEXT(""USER DUZ"")"
^XWB(8994,5137,2,1,1,5,0)="   - The DUZ of the user taking action in the calling application."
^XWB(8994,5137,2,1,1,6,0)="SDCONTEXT(""USER SECID"")"
^XWB(8994,5137,2,1,1,7,0)="   - The SECID of the user taking action in the calling application."
^XWB(8994,5137,2,1,1,8,0)="SDCONTEXT(""PATIENT DFN"")"
^XWB(8994,5137,2,1,1,9,0)="   - The DFN/IEN of the target patient from the calling application."
^XWB(8994,5137,2,1,1,10,0)="SDCONTEXT(""PATIENT ICN"")"
^XWB(8994,5137,2,1,1,11,0)="   - The ICN of the target patient from the calling application."
^XWB(8994,5137,2,2,0)="SDINPUT^2^32000^1^2"
^XWB(8994,5137,2,2,1,0)="^^7^7^3260316^"
^XWB(8994,5137,2,2,1,1,0)="SDINPUT(""PRIMARY STOP CODE"",#)={Stop Code} (Opt)"
^XWB(8994,5137,2,2,1,2,0)="SDINPUT(""CREDIT STOP CODE"",#)={Credit Stop Code} (Opt)"
^XWB(8994,5137,2,2,1,3,0)="                              from the HOSPITAL LOCATION file (#44)"
^XWB(8994,5137,2,2,1,4,0)="SDINPUT(""RETURN INACTIVE"")=0|1 (Opt) Flag to include inactive clinics,"
^XWB(8994,5137,2,2,1,5,0)="                      default is 0 if not passed, "
^XWB(8994,5137,2,2,1,6,0)="                        0 - Only active clinics returned"
^XWB(8994,5137,2,2,1,7,0)="                        1 - Both active and inactive clinics returned"
^XWB(8994,5137,2,"B","SDCONTEXT",1)=""
