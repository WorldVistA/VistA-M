^XWB(8994,2488,2,"PARAMSEQ",3,4)=""
^XWB(8994,2488,2,"PARAMSEQ",4,3)=""
^XWB(8994,2488,3,0)="^8994.03^3^3^3090407^^^^"
^XWB(8994,2488,3,1,0)="A list of drugs based on the input of PART"
^XWB(8994,2488,3,2,0)="First item = number of drugs in the returned list"
^XWB(8994,2488,3,3,0)="Each drug item = first $P^ = IEN, second $P^ = NAME of drug"
^XWB(8994,2489,0)="ROR LIST INVESTIGATIONAL DRUGS^RORINV^RORRP017^4^R^^^1^1"
^XWB(8994,2489,1,0)="^8994.01^3^3^3090407^^^"
^XWB(8994,2489,1,1,0)="[ROR LIST INVESTIGATIONAL DRUGS] returns a list of drugs that are"
^XWB(8994,2489,1,2,0)="classified as investigational in file ^PS(50.605 and have a drug class"
^XWB(8994,2489,1,3,0)="of IN140 for HEPC or IN150 for HIV"
^XWB(8994,2489,2,0)="^8994.02A^4^4"
^XWB(8994,2489,2,1,0)="PART^1^^0^1"
^XWB(8994,2489,2,1,1,0)="^^2^2^3090403^"
^XWB(8994,2489,2,1,1,1,0)="A string that is passed in to filter the number of drugs returned."
^XWB(8994,2489,2,1,1,2,0)="If the string is ?? then the call will return all drugs that qualify."
^XWB(8994,2489,2,2,0)="FLAGS^1^^1^2"
^XWB(8994,2489,2,2,1,0)="^^2^2^3090403^"
^XWB(8994,2489,2,2,1,1,0)="If equal to 1 this will work with the HEPC Registry.  If equal to 2 will"
^XWB(8994,2489,2,2,1,2,0)="work with the HIV Registry"
^XWB(8994,2489,2,3,0)="NUMBER^1^^0^3"
^XWB(8994,2489,2,3,1,0)="^^1^1^3090403^"
^XWB(8994,2489,2,3,1,1,0)="DEPRECATED"
^XWB(8994,2489,2,4,0)="FROM^1^^0^4"
^XWB(8994,2489,2,4,1,0)="^8994.021^1^1^3090407^^^"
^XWB(8994,2489,2,4,1,1,0)="DEPRECATED"
