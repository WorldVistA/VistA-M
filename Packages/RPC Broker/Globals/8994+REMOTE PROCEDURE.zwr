^XWB(8994,3393,3,1,0)="Return Value"
^XWB(8994,3393,3,2,0)="   -1 ^ Internal Entry Number Undefined or Not Found!"
^XWB(8994,3393,3,3,0)="   IEN = Successful Update"
^XWB(8994,3394,0)="DVBA CAPRI GETCONTREMARKS^WPGET^DVBACREM^2^R^0^^1^192"
^XWB(8994,3394,1,0)="3^8994.01^3^3^3150804^^^^"
^XWB(8994,3394,1,1,0)="This gets the remarks sent to the contractor concerning the 2507 REQUEST "
^XWB(8994,3394,1,2,0)="in file 396.3. The remarks are stored in the word processing field #103 of"
^XWB(8994,3394,1,3,0)="the 2507 EXAM file 396.4."
^XWB(8994,3394,2,0)="^8994.02A^2^1"
^XWB(8994,3394,2,2,0)="DVBEIEN^1^^1^1"
^XWB(8994,3394,2,2,1,0)="^8994.021^1^1^3150629^^"
^XWB(8994,3394,2,2,1,1,0)="This is the Exam Ien to get the comments from"
^XWB(8994,3394,2,"B","DVBEIEN",2)=""
^XWB(8994,3394,2,"PARAMSEQ",1,2)=""
^XWB(8994,3394,3,0)="^8994.03^1^1^3150804^^^^"
^XWB(8994,3394,3,1,0)="Returns a 1 if remarks exist"
^XWB(8994,3395,0)="DVBA CAPRI SETCONTREMARKS^WPSET^DVBACREM^3^R^0^^1^192"
^XWB(8994,3395,1,0)="^8994.01^3^3^3150804^^^^"
^XWB(8994,3395,1,1,0)="The RPC sets remarks sent to the contractor into the new word processing"
^XWB(8994,3395,1,2,0)="field #103 of the 2507 EXAM file 396.4. The 2507 EXAMs are connected to"
^XWB(8994,3395,1,3,0)="the 2507 REQUEST file via a pointer."
^XWB(8994,3395,2,0)="^8994.02A^4^4"
^XWB(8994,3395,2,1,0)="RQID^1^255^1^3"
^XWB(8994,3395,2,1,1,0)="^8994.021^4^4^3150604^^^"
^XWB(8994,3395,2,1,1,1,0)="The is the 2507 REQUEST ID from the 2507 REQUEST file 396.3. The"
^XWB(8994,3395,2,1,1,2,0)="2507 EXAMs are connected to the 2507 REQUEST file via a pointer. The"
^XWB(8994,3395,2,1,1,3,0)="remarks sent to the contractor are stored in the new word processing field"
^XWB(8994,3395,2,1,1,4,0)="#103 of the 2507 EXAM file 396.4. "
^XWB(8994,3395,2,2,0)="TEXT^3^32000^1^4"
^XWB(8994,3395,2,2,1,0)="^^2^2^3150602^"
^XWB(8994,3395,2,2,1,1,0)="The is the text from the contractor remarks. They will be stored in the"
^XWB(8994,3395,2,2,1,2,0)="new word processing field #103 of the 2507 EXAM file 396.4"
^XWB(8994,3395,2,3,0)="RETURN^1^1^1^1"
^XWB(8994,3395,2,3,1,0)="^8994.021^2^2^3150602^^"
^XWB(8994,3395,2,3,1,1,0)="Returns a '1' if remarks are successfully set and a '0' if the remarks are"
^XWB(8994,3395,2,3,1,2,0)="not set."
^XWB(8994,3395,2,4,0)="EIEN^2^512^1^2"
^XWB(8994,3395,2,4,1,0)="^8994.021^4^4^3150604^^^^"
^XWB(8994,3395,2,4,1,1,0)="The is the 2507 EXAM ID from the 2507 EXAM file 396.4. The remarks"
^XWB(8994,3395,2,4,1,2,0)="sent to the contractor are stored in the new word processing field #103 of"
^XWB(8994,3395,2,4,1,3,0)="the 2507 EXAM file 396.4. The 2507 EXAMs are connected to the 2507 REQUEST"
^XWB(8994,3395,2,4,1,4,0)="file via a pointer."
