^XWB(8994,3675,0)="MPI VISTA HWS CONFIG^CHANGE^XUMVIWSC^2^R^0^^1^1^^1"
^XWB(8994,3675,1,0)="^^14^14^3210421^"
^XWB(8994,3675,1,1,0)="This Remote Procedure Call (RPC) will be used to update the following"
^XWB(8994,3675,1,2,0)="fields for the 'MPI_NEW_PSIM EXECUTE' entry in the WEB SERVER (#18.12)"
^XWB(8994,3675,1,3,0)="file in VistA:"
^XWB(8994,3675,1,4,0)="  "
^XWB(8994,3675,1,5,0)="     - USERNAME"
^XWB(8994,3675,1,6,0)="     - PASSWORD"
^XWB(8994,3675,1,7,0)="     - SERVER"
^XWB(8994,3675,1,8,0)="     - SSL PORT"
^XWB(8994,3675,1,9,0)="     - SSL CONFIGURATION"
^XWB(8994,3675,1,10,0)=" "
^XWB(8994,3675,1,11,0)="In addition, the HTTPS parameter can be updated in the STATUS (#.04) field"
^XWB(8994,3675,1,12,0)="for the 'TWO' entry in the MPI ICN BUILD MANAGEMENT (#984.8) file. All of"
^XWB(8994,3675,1,13,0)="this is in support of the Web Application Security Assessment (WASA)"
^XWB(8994,3675,1,14,0)="security scan findings to move the web server connection to HTTPS."
^XWB(8994,3675,2,0)="^8994.02A^6^6"
^XWB(8994,3675,2,1,0)="USER^1^50^0^2"
^XWB(8994,3675,2,1,1,0)="^^2^2^3160512^"
^XWB(8994,3675,2,1,1,1,0)="This is the USERNAME field to be set in the WEB SERVER file for the "
^XWB(8994,3675,2,1,1,2,0)="MPI_NEW_PSIM_EXECUTE entry."
^XWB(8994,3675,2,2,0)="PASS^1^50^0^3"
^XWB(8994,3675,2,2,1,0)="^^2^2^3160512^"
^XWB(8994,3675,2,2,1,1,0)="This is the PASSWORD field to be set in the WEB SERVER file for the "
^XWB(8994,3675,2,2,1,2,0)="MPI_NEW_PSIM_EXECUTE entry."
^XWB(8994,3675,2,3,0)="SWITCH^1^1^0^4"
^XWB(8994,3675,2,3,1,0)="^8994.021^2^2^3181114^^"
^XWB(8994,3675,2,3,1,1,0)="This is for setting the TWO entry in file 984.8 field 4 to note HTTPS (1) "
^XWB(8994,3675,2,3,1,2,0)="or HTTP (0)."
^XWB(8994,3675,2,4,0)="SERVER^1^60^0^5"
^XWB(8994,3675,2,4,1,0)="^^1^1^3181114^"
^XWB(8994,3675,2,4,1,1,0)="This is for the address to connect to with the web server"
^XWB(8994,3675,2,5,0)="SSL PORT^1^5^0^6"
^XWB(8994,3675,2,5,1,0)="^^1^1^3181114^"
^XWB(8994,3675,2,5,1,1,0)="SSL Port for the web server"
^XWB(8994,3675,2,6,0)="SSL CONFIGURATION^1^40^0^7"
^XWB(8994,3675,2,6,1,0)="^^2^2^3210421^"
^XWB(8994,3675,2,6,1,1,0)="This is the name of the Cache Secure Socket Layer (SSL) configuration "
^XWB(8994,3675,2,6,1,2,0)="that should be associated with the web server."
^XWB(8994,3675,2,"B","PASS",2)=""
^XWB(8994,3675,2,"B","SERVER",4)=""
^XWB(8994,3675,2,"B","SSL CONFIGURATION",6)=""
^XWB(8994,3675,2,"B","SSL PORT",5)=""
^XWB(8994,3675,2,"B","SWITCH",3)=""
^XWB(8994,3675,2,"B","USER",1)=""
^XWB(8994,3675,2,"PARAMSEQ",2,1)=""
^XWB(8994,3675,2,"PARAMSEQ",3,2)=""
^XWB(8994,3675,2,"PARAMSEQ",4,3)=""
^XWB(8994,3675,2,"PARAMSEQ",5,4)=""
^XWB(8994,3675,2,"PARAMSEQ",6,5)=""
^XWB(8994,3675,2,"PARAMSEQ",7,6)=""
^XWB(8994,3675,3,0)="^^12^12^3210421^"
^XWB(8994,3675,3,1,0)="RETURN(1) = 1^SUCCESS PASSWORD for success OR -1^error message for an "
^XWB(8994,3675,3,2,0)="issue updating password"
^XWB(8994,3675,3,3,0)="RETURN(2) = 1^SUCCESS USER for success OR -1^error message for an issue "
^XWB(8994,3675,3,4,0)="updating username"
^XWB(8994,3675,3,5,0)="RETURN(3) = 1^SUCCESS SWITCH for success or -1^error message for an "
^XWB(8994,3675,3,6,0)="issue updating HTTPS"
^XWB(8994,3675,3,7,0)="RETURN(4) = 1^SUCCESS SERVER for success or -1^error message for an issue "
^XWB(8994,3675,3,8,0)="updating the Server field"
^XWB(8994,3675,3,9,0)="RETURN(5) = 1^SUCCESS SSL PORT for success or -1^error message for an "
^XWB(8994,3675,3,10,0)="issue updating the SSL Port field"
^XWB(8994,3675,3,11,0)="RETURN(6) = 1^SUCCESS SSL CONFIGURATION for success or -1^error message "
^XWB(8994,3675,3,12,0)="for an issue updating the SSL Configuration field."
^XWB(8994,3676,0)="VAFC DOD ACCEPT SET/DISPLAY^EN^VAFCDODA^1^R^0^^1^1^^1"
^XWB(8994,3676,1,0)="^^3^3^3160627^"
^XWB(8994,3676,1,1,0)="Depending on the type of call, this RPC will SET the PROCESS MVI DOD "
^XWB(8994,3676,1,2,0)="UPDATE? (#1401) field in MAS Parameters (#43) or will DISPLAY the field "
^XWB(8994,3676,1,3,0)="via a remote call from the MPI."
^XWB(8994,3676,2,0)="^8994.02A^2^2"
^XWB(8994,3676,2,1,0)="TYPE^1^1^1^2"
^XWB(8994,3676,2,1,1,0)="^^6^6^3160627^"
^XWB(8994,3676,2,1,1,1,0)="If TYPE=""S"", this is a remote call from the MPI to SET the value of the "
^XWB(8994,3676,2,1,1,2,0)="PROCESS MVI DOD UPDATE? (#1401) field in MAS Parameters (#43) at a "
^XWB(8994,3676,2,1,1,3,0)="specific site."
^XWB(8994,3676,2,1,1,4,0)="If TYPE=""D"", this is a remote call from the MPI to return the current "
^XWB(8994,3676,2,1,1,5,0)="setting of the PROCESS MVI DOD UPDATE? (#1401) field in MAS Parameters "
^XWB(8994,3676,2,1,1,6,0)="(#43) at a specific site."
^XWB(8994,3676,2,2,0)="SET^1^1^0^3"
^XWB(8994,3676,2,2,1,0)="^^3^3^3160627^"
^XWB(8994,3676,2,2,1,1,0)="If TYPE=""S"", this is the toggle value to set the PROCESS MVI DOD UPDATE? "
^XWB(8994,3676,2,2,1,2,0)="(#1401) field in MAS Parameters (#43) at a specific site. ""1"" for ""YES"", "
^XWB(8994,3676,2,2,1,3,0)="""0"" for ""NO""."
^XWB(8994,3676,2,"B","SET",2)=""
^XWB(8994,3676,2,"B","TYPE",1)=""
^XWB(8994,3676,2,"PARAMSEQ",2,1)=""
^XWB(8994,3676,2,"PARAMSEQ",3,2)=""
^XWB(8994,3676,3,0)="^^3^3^3160627^"
^XWB(8994,3676,3,1,0)="If field is set to ""YES: RET(1)=""1-PROCESS MVI DOD UPDATE? set to 'YES'"""
^XWB(8994,3676,3,2,0)="If field is set to ""NO"" or is null:  RET(1)=""1-PROCESS MVI DOD UPDATE? "
^XWB(8994,3676,3,3,0)="set to 'NO' or null"""
^XWB(8994,3677,0)="MPIF DOD ACTIVITY CHECK^SITECK^MPIFDODC^1^P"
^XWB(8994,3677,1,0)="^8994.01^3^3^3160626^^^"
^XWB(8994,3677,1,1,0)="This RPC will be called by the MPI to look for activity of the given"
^XWB(8994,3677,1,2,0)="patient.  It will search multiple packages to verify there has been"
^XWB(8994,3677,1,3,0)="no activity since a reported date of death as a conformation."
^XWB(8994,3677,2,0)="^8994.02A^2^2"
^XWB(8994,3677,2,1,0)="DFN^1^30^1^1"
^XWB(8994,3677,2,1,1,0)="^^1^1^3160624^"
^XWB(8994,3677,2,1,1,1,0)="This is the patient's DFN at the local site."
^XWB(8994,3677,2,2,0)="MPIDOD^1^7^1^2"
^XWB(8994,3677,2,2,1,0)="^8994.021^3^3^3160626^^"
^XWB(8994,3677,2,2,1,1,0)="This is the reported date of death to compare for activity that may"
^XWB(8994,3677,2,2,1,2,0)="have been recorded since the date.  Input should be a 7 digit FM"
^XWB(8994,3677,2,2,1,3,0)="formatted date."
^XWB(8994,3677,2,"B","DFN",1)=""
^XWB(8994,3677,2,"B","MPIDOD",2)=""
^XWB(8994,3677,2,"PARAMSEQ",1,1)=""
^XWB(8994,3677,2,"PARAMSEQ",2,2)=""
^XWB(8994,3677,3,0)="^8994.03^3^3^3160626^^"
^XWB(8994,3677,3,1,0)="This is a string indicating if there was activity or not.  If no activity"
^XWB(8994,3677,3,2,0)="has been found it will return 0.  If there was activity it will return"
^XWB(8994,3677,3,3,0)="1^date^type."
^XWB(8994,3678,0)="HMP SUBSCRIPTION STATUS^SUBSTA^HMPTOOLS^2^S^^^1^1^^1"
^XWB(8994,3678,1,0)="^8994.01^2^2^3150708^^^^"
^XWB(8994,3678,1,1,0)="This RPC checks the subscription status for a single patient and returns."
^XWB(8994,3678,1,2,0)="the result as a JSON containing code and text values."
^XWB(8994,3678,2,0)="^8994.02A^1^1"
^XWB(8994,3678,2,1,0)="ARGS^1^^1^1"
^XWB(8994,3678,2,1,1,0)="^8994.021^3^3^3150708^^^^"
^XWB(8994,3678,2,1,1,1,0)="The input array should contain:"
^XWB(8994,3678,2,1,1,2,0)="   'localId' = Patient identifier (Patient IEN)"
^XWB(8994,3678,2,1,1,3,0)="   'server' = Server name (e.g. hmp-development-sever)"
^XWB(8994,3678,2,"B","ARGS",1)=""
^XWB(8994,3678,2,"PARAMSEQ",1,1)=""
^XWB(8994,3678,3,0)="^8994.03^13^13^3150708^^^^"
^XWB(8994,3678,3,1,0)="Text formatted as JSON including 'code' and 'text'"
^XWB(8994,3678,3,2,0)=" "
^XWB(8994,3678,3,3,0)="    0 = 'Subscription not found'"
^XWB(8994,3678,3,4,0)="    1 = 'Subscription received - staging not started'"
^XWB(8994,3678,3,5,0)="    2 = 'Subscription received - staging in progress'"
^XWB(8994,3678,3,6,0)="    3 = 'Subscription received - staging in progress - paused by throttle for XXX seconds'"
^XWB(8994,3678,3,7,0)="    4 = 'Subscription complete - staged data not completely sent'"
^XWB(8994,3678,3,8,0)="    5 = 'Subscription complete - staged data already sent'"
^XWB(8994,3678,3,9,0)=" "
^XWB(8994,3678,3,10,0)="    90 = 'Error: server not specified'"
^XWB(8994,3678,3,11,0)="    91 = 'Error: server '_HMPFRSP_"" not found"""
^XWB(8994,3678,3,12,0)="    92 = 'Error: patient ien not specified'"
^XWB(8994,3678,3,13,0)="    93 = 'Error: patient ien not present on this system'"
^XWB(8994,3679,0)="HMP MED ORDER CHECKS^ORCHECK^HMPWBM1^4^^^^1^1"
^XWB(8994,3679,1,0)="^8994.01^4^4^3150625^^"
^XWB(8994,3679,1,1,0)="This RPC wraps the broker calls for both ORWDXC ACCEPT and ORCHECK "
^XWB(8994,3679,1,2,0)="GETXTRA into a single call.  It will use the same inputs as the ORWDXC "
^XWB(8994,3679,1,3,0)="ACCEPT RPC; but will combine the outputs from both broker calls into a "
^XWB(8994,3679,1,4,0)="single return."
^XWB(8994,3679,2,0)="^8994.02A^7^7"
^XWB(8994,3679,2,1,0)="DFN^1^30^1^1"
^XWB(8994,3679,2,1,1,0)="^^1^1^3150625^"
^XWB(8994,3679,2,1,1,1,0)="Patient IEN found in the PATIENT FILE (#2)"
^XWB(8994,3679,2,2,0)="FID^1^20^1^2"
^XWB(8994,3679,2,2,1,0)="^^2^2^3150625^"
^XWB(8994,3679,2,2,1,1,0)="FILLER ID, aka namespace.  Acquired by passing the selected "
^XWB(8994,3679,2,2,1,2,0)="orderDialogIen from the ORWDX WRLST RPC output to the ORWDXC FILLID RPC."
^XWB(8994,3679,2,3,0)="STRT^1^30^^3"
^XWB(8994,3679,2,3,1,0)="^^2^2^3150625^"
^XWB(8994,3679,2,3,1,1,0)="Desired date in Mmm DD,YYYY@HH:SS format  (Does not apply to pharmacy "
^XWB(8994,3679,2,3,1,2,0)="orders)"
^XWB(8994,3679,2,4,0)="ORL^1^20^1^4"
^XWB(8994,3679,2,4,1,0)="^^1^1^3150625^"
^XWB(8994,3679,2,4,1,1,0)="Ordering Location (locationIen from the Visit)"
^XWB(8994,3679,2,5,0)="OIL^4^256^1^5"
^XWB(8994,3679,2,5,1,0)="^^4^4^3150625^"
^XWB(8994,3679,2,5,1,1,0)="An ordered list (array) of orderable items for Radiology, Lab, Pharmacy, "
^XWB(8994,3679,2,5,1,2,0)="etc.  Note:  Pharmacy orders contains orderable items + package "
^XWB(8994,3679,2,5,1,3,0)="information (inpatient, infusion, non-VA, and outpatient medication "
^XWB(8994,3679,2,5,1,4,0)="orders) as appropriate."
^XWB(8994,3679,2,6,0)="ORIFN^1^30^^6"
^XWB(8994,3679,2,6,1,0)="^^3^3^3150625^"
^XWB(8994,3679,2,6,1,1,0)="This is only available and required for existing orders that are being"
^XWB(8994,3679,2,6,1,2,0)="copied, changed, or renewed.  New orders do not have an orderIen until"
^XWB(8994,3679,2,6,1,3,0)="they are saved."
^XWB(8994,3679,2,7,0)="ORREN^1^1^^7"
^XWB(8994,3679,2,7,1,0)="^^2^2^3150625^"
^XWB(8994,3679,2,7,1,1,0)="Is the order being renewed.  Input is a boolean 1 or 0"
^XWB(8994,3679,2,7,1,2,0)="The ORIFN is required if ORREN is set to 1."
^XWB(8994,3679,2,"B","DFN",1)=""
^XWB(8994,3679,2,"B","FID",2)=""
^XWB(8994,3679,2,"B","OIL",5)=""
^XWB(8994,3679,2,"B","ORIFN",6)=""
^XWB(8994,3679,2,"B","ORL",4)=""
^XWB(8994,3679,2,"B","ORREN",7)=""
^XWB(8994,3679,2,"B","STRT",3)=""
^XWB(8994,3679,2,"PARAMSEQ",1,1)=""
^XWB(8994,3679,2,"PARAMSEQ",2,2)=""
^XWB(8994,3679,2,"PARAMSEQ",3,3)=""
^XWB(8994,3679,2,"PARAMSEQ",4,4)=""
^XWB(8994,3679,2,"PARAMSEQ",5,5)=""
^XWB(8994,3679,2,"PARAMSEQ",6,6)=""
^XWB(8994,3679,2,"PARAMSEQ",7,7)=""
^XWB(8994,3679,3,0)="^^14^14^3150625^"
^XWB(8994,3679,3,1,0)="orderIen^orderCheckIen^CDL^message"
^XWB(8994,3679,3,2,0)="    orderIen = NEW for new orders."
^XWB(8994,3679,3,3,0)="    CDL = Clinic Danger Level.  If CDL = 1, an override comment will be"
^XWB(8994,3679,3,4,0)="required during processing order checks during the signing process."
^XWB(8994,3679,3,5,0)=" "
^XWB(8994,3679,3,6,0)="Each order check returned will be evaluated for extra lines:"
^XWB(8994,3679,3,7,0)=" "
^XWB(8994,3679,3,8,0)="    Example:  NEW^25^2^||63679,54957,NEW&These checks could not be"
^XWB(8994,3679,3,9,0)="completed for this patient:"
^XWB(8994,3679,3,10,0)="      Note:  An order check that is returned with the double pipe (||) as "
^XWB(8994,3679,3,11,0)="noted above is the indication that this RPC needs to be run."
^XWB(8994,3679,3,12,0)=" "
^XWB(8994,3679,3,13,0)="Final output may contain a mix of order checks with and without extra "
^XWB(8994,3679,3,14,0)="lines."
^XWB(8994,3680,0)="HMP GET RELATED ORDERS^RELATED^HMPORRPC^2"
^XWB(8994,3680,1,0)="^^2^2^3151221^"
^XWB(8994,3680,1,1,0)="Returns the parent, children, and/or siblings (orders that share the same parent) of an order from the ORDER (#100)"
^XWB(8994,3680,1,2,0)="FILE in JSON format."
^XWB(8994,3680,2,0)="^8994.02A^1^1"
^XWB(8994,3680,2,1,0)="ORDER IEN^1^30^1^1"
^XWB(8994,3680,2,1,1,0)="^^1^1^3151221^"
^XWB(8994,3680,2,1,1,1,0)="IEN to the ORDER (#100) file, indicates which order from which to draw related orders."
^XWB(8994,3680,2,"B","ORDER IEN",1)=""
^XWB(8994,3680,2,"PARAMSEQ",1,1)=""
^XWB(8994,3680,3,0)="^^21^21^3151221^"
^XWB(8994,3680,3,1,0)="Returns a JSON message containing an IEN for ""parent,"" a list of IENS for ""children,"" and/or a list of IENs for ""siblings"","
^XWB(8994,3680,3,2,0)="depending on which fields are applicable to an order (i.e., an order with no parent will not have a ""parent"" value). If an error"
^XWB(8994,3680,3,3,0)="is returned, it will be in the ""error"" field."
^XWB(8994,3680,3,4,0)="{"
^XWB(8994,3680,3,5,0)="|TAB|""parent"": 7282.1,"
^XWB(8994,3680,3,6,0)="|TAB|""siblings"": [7283.1, 7284.1, 7285.1, 7286.1, 7287.1, 7288.1, 7289.1, 72"
^XWB(8994,3680,3,7,0)="|TAB||TAB|90.1, 7291.1, 7292.1, 7293.1, 7294.1, 7295.1, 7296.1, 7297.1, 7298.1, 7299.1, 7300.1, 7301."
^XWB(8994,3680,3,8,0)="|TAB||TAB|1, 7302.1, 7303.1, 7304.1, 7305.1, 7306.1, 7307.1"
^XWB(8994,3680,3,9,0)="|TAB|]"
^XWB(8994,3680,3,10,0)="}"
^XWB(8994,3680,3,11,0)="or"
^XWB(8994,3680,3,12,0)="{"
^XWB(8994,3680,3,13,0)="|TAB|""children"": ["
^XWB(8994,3680,3,14,0)="|TAB|  7283.1, 7284.1, 7285.1, 7286.1, 7287.1, 7288.1, 7289.1, 7290.1, 7291.1, 7292.1, 7293.1, 7294.1, 7295.1, 7296.1, 7297.1,"
^XWB(8994,3680,3,15,0)="|TAB|  7298.1, 7299.1, 7300.1, 7301.1, 7302.1, 7303.1, 7304.1, 7305.1, 7306.1, 7307.1"
^XWB(8994,3680,3,16,0)="|TAB|]"
^XWB(8994,3680,3,17,0)="}"
^XWB(8994,3680,3,18,0)="or"
^XWB(8994,3680,3,19,0)="{"
^XWB(8994,3680,3,20,0)="|TAB|""error"": ""order not found"""
^XWB(8994,3680,3,21,0)="}"
