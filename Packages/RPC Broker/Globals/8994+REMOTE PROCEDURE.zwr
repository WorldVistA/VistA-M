^XWB(8994,4862,2,"PARAMSEQ",2,2)=""
^XWB(8994,4862,3,0)="^^2^2^3191230^"
^XWB(8994,4862,3,1,0)="Returns an array containing the Field Description for the"
^XWB(8994,4862,3,2,0)="specified File/Field."
^XWB(8994,4863,0)="WEBG GMRV VERSRV^VERSRV^WEBGUTIL^2^A^0^1^^^^1"
^XWB(8994,4863,1,0)="^^1^1^3230505^"
^XWB(8994,4863,1,1,0)="Returns the active version(s) of the GMR Vitals DLL."
^XWB(8994,4863,3,0)="^^11^11^3230505^"
^XWB(8994,4863,3,1,0)="Return format:"
^XWB(8994,4863,3,2,0)=" "
^XWB(8994,4863,3,3,0)="RETDLL(0)     - Number of values in the array or Exception message"
^XWB(8994,4863,3,4,0)="RETDLL(1...n) - The version number of the active Vitals DLL"
^XWB(8994,4863,3,5,0)=" "
^XWB(8994,4863,3,6,0)="Examples:"
^XWB(8994,4863,3,7,0)=" "
^XWB(8994,4863,3,8,0)="RETDLL(0)=1"
^XWB(8994,4863,3,9,0)="RETDLL(1)=""5.0.43.2"""
^XWB(8994,4863,3,10,0)=" "
^XWB(8994,4863,3,11,0)="RETDLL(0)=""No active versions."""
