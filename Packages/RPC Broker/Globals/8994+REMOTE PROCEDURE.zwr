^XWB(8994,3863,0)="DSIYRPT2 MFGLST MFG LIST^MFGLST^DSIYRPT2^4"
^XWB(8994,3863,1,0)="^^10^10^3130829^"
^XWB(8994,3863,1,1,0)="Schedules a report consisting of all equipment in file #6914"
^XWB(8994,3863,1,2,0)="listed for requested manufacturers having a requested USE STATUS."
^XWB(8994,3863,1,3,0)="The data returned by the DSIYRPTR GETRPT GET RPT DATA is as follows:"
^XWB(8994,3863,1,4,0)="RET(0) is header column data"
^XWB(8994,3863,1,5,0)="RET(1-n) is record data, each record will begin with Serial# in piece 1"
^XWB(8994,3863,1,6,0)=" "
^XWB(8994,3863,1,7,0)="Example:"
^XWB(8994,3863,1,8,0)="RET(0)=Serial#(text)^Equipment Category(text)^Use Status(text)^VAPM "
^XWB(8994,3863,1,9,0)="Number(number)^Local Identifier(text)"
^XWB(8994,3863,1,10,0)="RET(1)=186^SEARS ROEBUCK^186ABC^DRILL-ELECTRIC^IN USE^VA186-0001^VA186ID"
^XWB(8994,3863,2,0)="^8994.02A^3^3"
^XWB(8994,3863,2,1,0)="MFGLST^1^30^1^1"
^XWB(8994,3863,2,1,1,0)="^^2^2^3120710^"
^XWB(8994,3863,2,1,1,1,0)="^-delimited list of IENs for manufacturers in the MANUFACTURER LIST FILE "
^XWB(8994,3863,2,1,1,2,0)="(#6912) to select from the EQUIPMENT INV. FILE (#6914)."
^XWB(8994,3863,2,2,0)="STATS^1^30^1^2"
^XWB(8994,3863,2,2,1,0)="^^2^2^3120710^"
^XWB(8994,3863,2,2,1,1,0)="^-delimited list of statuses for the USE STATUS field for filtering the "
^XWB(8994,3863,2,2,1,2,0)="equipment selected."
^XWB(8994,3863,2,3,0)="ESTART^1^30^0^3"
^XWB(8994,3863,2,3,1,0)="^8994.021^1^1^3130829^^"
^XWB(8994,3863,2,3,1,1,0)="Earliest time to start scheduled report. Defaults to ""NOW""."
^XWB(8994,3863,2,"B","ESTART",3)=""
^XWB(8994,3863,2,"B","MFGLST",1)=""
^XWB(8994,3863,2,"B","STATS",2)=""
