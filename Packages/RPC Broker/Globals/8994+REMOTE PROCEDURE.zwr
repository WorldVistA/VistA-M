^XWB(8994,4757,0)="ORWDPS33 CLZDS^CLZDS^ORWDPS33^1"
^XWB(8994,4757,1,0)="^^20^20^3220811^"
^XWB(8994,4757,1,1,0)="This RPC will validate the days supply for a Clozapine patient when "
^XWB(8994,4757,1,2,0)="accepting the order in CPRS."
^XWB(8994,4757,1,3,0)="It will return a 1 if the days supply passed is 7, 14 or 28 depending on"
^XWB(8994,4757,1,4,0)="patient's dispense frequency in the CLOZAPINE PATIENT LIST file (#603.01)."
^XWB(8994,4757,1,5,0)="  "
^XWB(8994,4757,1,6,0)="For any other days supply, it'll return a zero with one of the following "
^XWB(8994,4757,1,7,0)="messages:"
^XWB(8994,4757,1,8,0)="  "
^XWB(8994,4757,1,9,0)="For a WEEKLY dispense frequency:"
^XWB(8994,4757,1,10,0)="Patient eligibility for this medication will only allow a Days Supply of 7"
^XWB(8994,4757,1,11,0)="with 0 refills"
^XWB(8994,4757,1,12,0)="  "
^XWB(8994,4757,1,13,0)="For a BI-WEEKLY dispense frequency:"
^XWB(8994,4757,1,14,0)="Patient eligibility for this medication will only allow a Days Supply of "
^XWB(8994,4757,1,15,0)="14 days with 0 refills, or 7 days with up to 1 refill"
^XWB(8994,4757,1,16,0)="  "
^XWB(8994,4757,1,17,0)="For a MONTHLY dispense frequency:"
^XWB(8994,4757,1,18,0)="Patient eligibility for this medication will only allow a Days Supply of "
^XWB(8994,4757,1,19,0)="28 days with 0 refills, 14 days with up to 1 refill, or 7 days with up to "
^XWB(8994,4757,1,20,0)="3 refills"
^XWB(8994,4757,2,0)="^8994.02A^4^4"
