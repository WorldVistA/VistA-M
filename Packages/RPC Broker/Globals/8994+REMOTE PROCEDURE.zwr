^XWB(8994,348,1,1,0)="Return user's default patient list source."
^XWB(8994,349,0)="ORWPS DETAIL^DETAIL^ORWPS^4^^^^1^^^1"
^XWB(8994,349,1,0)="^^1^1^3000105^"
