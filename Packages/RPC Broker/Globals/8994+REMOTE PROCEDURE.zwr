^XWB(8994,4387,0)="ORWOTHER SHWOTHER^SHWOTHER^ORWOTHER^1"
^XWB(8994,4387,1,0)="^^2^2^3200402^"
^XWB(8994,4387,1,1,0)="This RPC returns the controls info for the other information panel in"
^XWB(8994,4387,1,2,0)="CPRS."
^XWB(8994,4387,2,0)="^8994.02A^1^1"
^XWB(8994,4387,2,1,0)="USER^1^^1^1"
^XWB(8994,4387,2,1,1,0)="^^1^1^3200402^"
^XWB(8994,4387,2,1,1,1,0)="This is the user DUZ"
^XWB(8994,4387,2,"B","USER",1)=""
^XWB(8994,4387,2,"PARAMSEQ",1,1)=""
^XWB(8994,4388,0)="ORWOTHER DETAIL^DETAIL^ORWOTHER^4^^^^1"
^XWB(8994,4388,1,0)="^8994.01^2^2^3200505^^^^"
^XWB(8994,4388,1,1,0)="This RPC returns a detail information for the patient other information "
^XWB(8994,4388,1,2,0)="panel."
^XWB(8994,4388,2,0)="^8994.02A^2^2"
^XWB(8994,4388,2,1,0)="DFN^1^^1^1"
^XWB(8994,4388,2,2,0)="TYPE^1^^1^2"
^XWB(8994,4388,2,"B","DFN",1)=""
^XWB(8994,4388,2,"B","TYPE",2)=""
^XWB(8994,4388,2,"PARAMSEQ",1,1)=""
^XWB(8994,4388,2,"PARAMSEQ",2,2)=""
^XWB(8994,4389,0)="VAFC GETRELATIONSHIPS^GET^VAFCREL^3^P^^^1^1"
^XWB(8994,4389,1,0)="^^6^6^3200304^"
^XWB(8994,4389,1,1,0)="Given a patient DFN this Remote Procedure Call returns a "
^XWB(8994,4389,1,2,0)=" list of IAM VA MPI Relationship records with relationship type, "
^XWB(8994,4389,1,3,0)="relationship status, relationship status change date and relationship "
^XWB(8994,4389,1,4,0)="type rolecode (which defines direction of the relationship [i.e. Son to "
^XWB(8994,4389,1,5,0)="Father vs Father to Son or Caregiver to Veteran receiving care vs Veteran "
^XWB(8994,4389,1,6,0)="receiving care to Caregiver]."
^XWB(8994,4389,2,0)="^8994.02A^1^1"
^XWB(8994,4389,2,1,0)="DFN^3^255^1^1"
^XWB(8994,4389,2,1,1,0)="^^1^1^3200304^"
^XWB(8994,4389,2,1,1,1,0)="The patient DFN from the PATIENT file (#2), aka IEN."
^XWB(8994,4389,2,"B","DFN",1)=""
^XWB(8994,4389,2,"PARAMSEQ",1,1)=""
^XWB(8994,4389,3,0)="^^50^50^3200304^"
^XWB(8994,4389,3,1,0)="The RETURN(0) array will always be returned."
^XWB(8994,4389,3,2,0)=" "
^XWB(8994,4389,3,3,0)="RETURN(0)   - If relationships found for a given DFN, it will contain 1 "
^XWB(8994,4389,3,4,0)="in the 1st piece and ""RELATIONSHIPS RETURNED"" text in 2nd piece"
^XWB(8994,4389,3,5,0)="              If no relationships not found for a given DFN, it will "
^XWB(8994,4389,3,6,0)="contain 0 in the 1st piece and ""NO RELATIONSHIPS RETURNED"" text in 2nd "
^XWB(8994,4389,3,7,0)="piece"
^XWB(8994,4389,3,8,0)="              If error condition, it will contain -1 in the 1st piece and "
^XWB(8994,4389,3,9,0)="error message text in 2nd piece "
^XWB(8994,4389,3,10,0)=" "
^XWB(8994,4389,3,11,0)="Examples:"
^XWB(8994,4389,3,12,0)="---------"
^XWB(8994,4389,3,13,0)=" "
^XWB(8994,4389,3,14,0)="RETURN(0)=""1^RELATIONSHIPS RETURNED"""
^XWB(8994,4389,3,15,0)=" "
^XWB(8994,4389,3,16,0)="RETURN(0)=""0^NO RELATIONSHIPS RETURNED"""
^XWB(8994,4389,3,17,0)=" "
^XWB(8994,4389,3,18,0)="RETURN(0)=""-1^ERROR:Timeout Limit Reached""  *** note: timeout limit is 10 "
^XWB(8994,4389,3,19,0)="seconds  Possible error conditions"
^XWB(8994,4389,3,20,0)="RETURN(0)=""-1^ERROR:Internal Error"""
^XWB(8994,4389,3,21,0)="RETURN(0)=""-1^ERROR:Unknown ID"""
^XWB(8994,4389,3,22,0)=" "
^XWB(8994,4389,3,23,0)=" "
^XWB(8994,4389,3,24,0)="RETURN(1-n) - If relationships found for a given DFN, it will contain the "
^XWB(8994,4389,3,25,0)="list of Relationships in the following format:"
^XWB(8994,4389,3,26,0)=" "
^XWB(8994,4389,3,27,0)="ICN^Relationship Type^Relationship Type Display^Relationship Role"
^XWB(8994,4389,3,28,0)="Code^Relationship Status^Relationship Status Display^Relationship"
^XWB(8994,4389,3,29,0)="Status Change Date^Assigned Name"
^XWB(8994,4389,3,30,0)=" "
^XWB(8994,4389,3,31,0)="Where there are standardized Relationship Types values defined by the HL7 "
^XWB(8994,4389,3,32,0)="standard they will be used and attached is the url to those standard "
^XWB(8994,4389,3,33,0)="values "
^XWB(8994,4389,3,34,0)="(https://www.hl7.org/fhir/valueset-relatedperson-relationshiptype.html)"
^XWB(8994,4389,3,35,0)=" "
^XWB(8994,4389,3,36,0)="Examples:"
^XWB(8994,4389,3,37,0)="---------"
^XWB(8994,4389,3,38,0)=" "
^XWB(8994,4389,3,39,0)="RETURN(1)=""1002345678V123456^CGP^CAREGIVER: "
^XWB(8994,4389,3,40,0)="PRIMARY^QUAL^ACTIVE^APPROVED^20200220^Jones, William M"""
^XWB(8994,4389,3,41,0)="RETURN(2)=""1901234590V098766^CGS^CAREGIVER: "
^XWB(8994,4389,3,42,0)="SECONDARY^QUAL^ACTIVE^APPROVED^20200220^Jones, Donna"""
^XWB(8994,4389,3,43,0)="RETURN(3)=""1002345678V123456^SONC^SON^QUAL^ACTIVE^ACTIVE^20200220^Jones, "
^XWB(8994,4389,3,44,0)="Mike"""
^XWB(8994,4389,3,45,0)="RETURN(4)=""1901234590V098766^CGP^CAREGIVER: "
^XWB(8994,4389,3,46,0)="PRIMARY^QUAL^TERMINATED^BENEFIT END DATE^20170220^Jones, Donna"""
^XWB(8994,4389,3,47,0)="RETURN(5)=""1007879802V000909^SPS^SPOUSE^QUAL^ACTIVE^^ACTIVE^20120301^Jones"
^XWB(8994,4389,3,48,0)=", Donna"""
^XWB(8994,4389,3,49,0)="RETURN(6)=""1089022222V123423^BRO^BROTHER^QUAL^ACTIVE^ACTIVE^20111202^Jones"
^XWB(8994,4389,3,50,0)=", Joseph"""
^XWB(8994,4390,0)="YTQ SAVE ADMIN^SAVEADM^YTQAPI5A^2^S^^^^^^1"
^XWB(8994,4390,1,0)="^^1^1^3171030^"
^XWB(8994,4390,1,1,0)="Create a new or update existing administration."
^XWB(8994,4390,2,0)="^8994.02A^1^1"
^XWB(8994,4390,2,1,0)="YS array^2^^1^1"
^XWB(8994,4390,2,1,1,0)="^^8^8^3171030^"
^XWB(8994,4390,2,1,1,1,0)="YS(""IEN"")= : the internal number of the record you want to edit."
^XWB(8994,4390,2,1,1,2,0)="  Leave blank if creating a new record. If creating a new record you must"
^XWB(8994,4390,2,1,1,3,0)="  send .01^NEW for those MH files using the New input transform."
^XWB(8994,4390,2,1,1,4,0)="YS(1)=FIELD #^Value^[3rd piece is 1 if you need to bypass"
^XWB(8994,4390,2,1,1,5,0)="      validation (use only if approved by developer)"
^XWB(8994,4390,2,1,1,6,0)=":"
^XWB(8994,4390,2,1,1,7,0)=":"
^XWB(8994,4390,2,1,1,8,0)="YS(x)=YS(1)=FIELD #^Value^[3rd piece]"
^XWB(8994,4390,2,"B","YS array",1)=""
^XWB(8994,4390,2,"PARAMSEQ",1,1)=""
^XWB(8994,4390,3,0)="^^1^1^3171030^"
^XWB(8994,4390,3,1,0)="YSDATA(1)=[DATA] or [ERROR]"
^XWB(8994,4391,0)="TIU LOAD RECORD TEXT^CPGT4EDT^TIUSRVR^4^S^^^1"
^XWB(8994,4391,1,0)="^^2^2^3160815^"
^XWB(8994,4391,1,1,0)="This RPC returns the text (body) of a TIU Note. It is based on the TIU"
^XWB(8994,4391,1,2,0)="LOAD RECORD FOR EDIT RPC."
^XWB(8994,4391,2,0)="^8994.02A^1^1"
^XWB(8994,4391,2,1,0)="TIUDA^1^^1"
^XWB(8994,4391,2,1,1,0)="^^2^2^3160815^"
^XWB(8994,4391,2,1,1,1,0)="This is the record number (IEN) in file 8925 for the document to retrieve"
^XWB(8994,4391,2,1,1,2,0)="the body text."
^XWB(8994,4391,2,"B","TIUDA",1)=""
^XWB(8994,4391,3,0)="^^5^5^3160815^"
^XWB(8994,4391,3,1,0)="The return will be in ^TMP(""TIUEDIT"",$J,""TEXT"",n) with the 0 entry being "
^XWB(8994,4391,3,2,0)="the header of ""$TXT"". Example return:"
^XWB(8994,4391,3,3,0)=" "
^XWB(8994,4391,3,4,0)="     ^TMP(""TIUEDIT"",12345,""TEXT"",0)=""$TXT"""
^XWB(8994,4391,3,5,0)="     ^TMP(""TIUEDIT"",12345,""TEXT"",1)=""This is the first line of the note!"""
^XWB(8994,4392,0)="TIU ANCILLARY PACKAGE MESSAGE^ANPKGMSG^TIUSRVP^2^S^0^^^^^0"
^XWB(8994,4392,1,0)="^^2^2^3170824^"
^XWB(8994,4392,1,1,0)="This remote procedure returns messages generated from other packages that "
^XWB(8994,4392,1,2,0)="contain data associated with a document."
^XWB(8994,4392,2,0)="^8994.02A^2^2"
^XWB(8994,4392,2,1,0)="TIUDA^1^^1^1"
^XWB(8994,4392,2,1,1,0)="^^2^2^3170824^"
^XWB(8994,4392,2,1,1,1,0)="The record number of the TIU document for which messages should be "
^XWB(8994,4392,2,1,1,2,0)="returned for."
^XWB(8994,4392,2,2,0)="TIUACT^1^^1^2"
^XWB(8994,4392,2,2,1,0)="^^2^2^3170824^"
^XWB(8994,4392,2,2,1,1,0)="The action that will be performed on the document. Acceptable values are "
^XWB(8994,4392,2,2,1,2,0)="""DELETE"" and ""REASSIGN""."
^XWB(8994,4392,2,"B","TIUACT",2)=""
^XWB(8994,4392,2,"B","TIUDA",1)=""
^XWB(8994,4392,2,"PARAMSEQ",1,1)=""
^XWB(8994,4392,2,"PARAMSEQ",2,2)=""
^XWB(8994,4392,3,0)="^^12^12^3170824^"
^XWB(8994,4392,3,1,0)="Returns an array of text to display to the user with the following "
^XWB(8994,4392,3,2,0)="structure:"
^XWB(8994,4392,3,3,0)="  RETURN(0)=~NPKG^PKG_NAME:"
^XWB(8994,4392,3,4,0)="    PKG_NAME: Name of the first package in a displayable format"
^XWB(8994,4392,3,5,0)="  RETURN(1)=FIRST LINE OF FIRST PACKAGE'S TEXT"
^XWB(8994,4392,3,6,0)="  ..."
^XWB(8994,4392,3,7,0)="  RETURN(N)=N LINE OF FIRST PACKAGE'S TEXT"
^XWB(8994,4392,3,8,0)="  RETURN(N+1)=~NPKG^PKG_NAME:"
^XWB(8994,4392,3,9,0)="    PKG_NAME: Name of the second package in a displayable format"
^XWB(8994,4392,3,10,0)="  RETURN(N+2)=FIRST LINE OF SECOND PACKAGE'S TEXT"
^XWB(8994,4392,3,11,0)="  ..."
^XWB(8994,4392,3,12,0)="  RETURN(N+O)=N+O LINE OF SECOND PACKAGE'S TEXT"
^XWB(8994,4393,0)="TIU LINK SECONDARY VISIT^LNKSVST^TIUPXAP3^1^S^0^^0^^^0"
^XWB(8994,4393,1,0)="^^4^4^3171211^"
^XWB(8994,4393,1,1,0)="This remote procedure will link a given visit with a service category of "
^XWB(8994,4393,1,2,0)="DAILY HOSPITALIZATION to a document's SECONDARY VISIT field. If the "
^XWB(8994,4393,1,3,0)="document has a parent, this remote procedure will link it to the same "
^XWB(8994,4393,1,4,0)="visit via its SECONDARY VISIT field."
^XWB(8994,4393,2,0)="^8994.02A^3^3"
^XWB(8994,4393,2,1,0)="TIUDFN^1^^1^1"
^XWB(8994,4393,2,1,1,0)="^^2^2^3171211^"
^XWB(8994,4393,2,1,1,1,0)="This is the patient's internal entry number (IEN) in the PATIENT file "
^XWB(8994,4393,2,1,1,2,0)="(#2)."
^XWB(8994,4393,2,2,0)="TIUDA^1^^1^2"
^XWB(8994,4393,2,2,1,0)="^^1^1^3171211^"
^XWB(8994,4393,2,2,1,1,0)="This is the document's IEN in the TIU DOCUMENT file (#8925)."
^XWB(8994,4393,2,3,0)="TIUVSTR^1^^1^3"
^XWB(8994,4393,2,3,1,0)="^^2^2^3171211^"
^XWB(8994,4393,2,3,1,1,0)="This is either the visit's IEN in the VISIT file (#9000010) or the visit "
^XWB(8994,4393,2,3,1,2,0)="string associated with the visit to link to."
^XWB(8994,4393,2,"B","TIUDA",2)=""
^XWB(8994,4393,2,"B","TIUDFN",1)=""
^XWB(8994,4393,2,"B","TIUVSTR",3)=""
^XWB(8994,4393,2,"PARAMSEQ",1,1)=""
^XWB(8994,4393,2,"PARAMSEQ",2,2)=""
^XWB(8994,4393,2,"PARAMSEQ",3,3)=""
^XWB(8994,4393,3,0)="^^5^5^3171211^"
^XWB(8994,4393,3,1,0)="Caret-delimited string with the following structure:"
^XWB(8994,4393,3,2,0)="  STATUS^MESSAGE"
^XWB(8994,4393,3,3,0)=" "
^XWB(8994,4393,3,4,0)="  STATUS: 1 for success, 0 for failure"
^XWB(8994,4393,3,5,0)="  MESSAGE: A user-friendly reason why the call failed"
^XWB(8994,4394,0)="WVRPCOR COVER^COVER^WVRPCOR^2^S^0^^^^^0"
^XWB(8994,4394,1,0)="^^1^1^3151105^"
^XWB(8994,4394,1,1,0)="Returns the content of the Women's Health panel on the cover sheet."
^XWB(8994,4394,2,0)="^8994.02A^2^2"
^XWB(8994,4394,2,1,0)="PATIENT ID^1^16^1^1"
^XWB(8994,4394,2,1,1,0)="^^1^1^3151105^"
^XWB(8994,4394,2,1,1,1,0)="The internal entry number (IEN) of the patient in the PATIENT file (#2)."
^XWB(8994,4394,2,2,0)="CLEAR CACHE^1^1^0^2"
^XWB(8994,4394,2,2,1,0)="^^5^5^3201019^"
^XWB(8994,4394,2,2,1,1,0)="This flag indicates if a rebuild of the data cache is requested. This is "
^XWB(8994,4394,2,2,1,2,0)="only set when the user clicks on the Refresh button in the Women's Health "
^XWB(8994,4394,2,2,1,3,0)="panel on the Computerized Patient Record System (CPRS) Cover Sheet tab. A "
^XWB(8994,4394,2,2,1,4,0)="value of 1 means rebuild the data cache and a value of 0 or no value "
^XWB(8994,4394,2,2,1,5,0)="means do not rebuild the data cache."
^XWB(8994,4394,2,"B","CLEAR CACHE",2)=""
^XWB(8994,4394,2,"B","PATIENT ID",1)=""
^XWB(8994,4394,2,"PARAMSEQ",1,1)=""
^XWB(8994,4394,2,"PARAMSEQ",2,2)=""
^XWB(8994,4394,3,0)="^^19^19^3190618^"
^XWB(8994,4394,3,1,0)="Array of lines to display in the panel, formatted as follows:"
^XWB(8994,4394,3,2,0)="  RETURN(0)=CARET-DELIMITED_STRING_1"
^XWB(8994,4394,3,3,0)="  RETURN(N)=CARET-DELIMITED_STRING_2"
^XWB(8994,4394,3,4,0)=" "
^XWB(8994,4394,3,5,0)="where"
^XWB(8994,4394,3,6,0)="  CARET-DELIMITED_STRING_1:"
^XWB(8994,4394,3,7,0)="  Piece  Value"
^XWB(8994,4394,3,8,0)="  ====================="
^XWB(8994,4394,3,9,0)="    1    Status: -1 to indicate an error"
^XWB(8994,4394,3,10,0)="                 0 to indicate not applicable"
^XWB(8994,4394,3,11,0)="                 1 to indicate applicable"
