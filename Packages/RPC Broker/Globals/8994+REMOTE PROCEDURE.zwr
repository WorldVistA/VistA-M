^XWB(8994,5049,0)="MAG DICOM P350 MAKE LIST^ENTRY^MAGD350I^2"
^XWB(8994,5049,1,0)="^^12^12^3221219^"
^XWB(8994,5049,1,1,0)="A problem was caused by patch MAG*3.0*226 (October 2019) which changed"
^XWB(8994,5049,1,2,0)="the way that Clinical Capture stored DICOM images."
^XWB(8994,5049,1,3,0)=" "
^XWB(8994,5049,1,4,0)="Instead of saving them as DICOM objects, they were stored as raw JPEG"
^XWB(8994,5049,1,5,0)="images with a *.DCM extension.  These images need to be converted to"
^XWB(8994,5049,1,6,0)="DICOM and stored as proper DICOM objects.  The previously stored JPEG"
^XWB(8994,5049,1,7,0)="images need to be renamed using the *.JPG extension."
^XWB(8994,5049,1,8,0)="  "
^XWB(8994,5049,1,9,0)="These changes must be performed on both Tier-1 and Tier-2 storage."
^XWB(8994,5049,1,10,0)=" "
^XWB(8994,5049,1,11,0)="This RPC scans the Image file (^MAG(2005)) for problem images and"
^XWB(8994,5049,1,12,0)="stores them in a list for later processing."
^XWB(8994,5049,2,0)="^8994.02A^2^2"
^XWB(8994,5049,2,1,0)="IMAGE IEN^1^15^0^2"
^XWB(8994,5049,2,1,1,0)="^8994.021^1^1^3221219^^"
^XWB(8994,5049,2,1,1,1,0)="The image IEN used to build the list (optional)."
^XWB(8994,5049,2,2,0)="MAX COUNT^1^5^0^1"
^XWB(8994,5049,2,2,1,0)="^^1^1^3221219^"
^XWB(8994,5049,2,2,1,1,0)="Maximum number of ^MAG(2005) records to be scanned in an RPC - default 1000."
^XWB(8994,5049,2,"B","IMAGE IEN",1)=""
^XWB(8994,5049,2,"B","MAX COUNT",2)=""
^XWB(8994,5049,2,"PARAMSEQ",1,2)=""
^XWB(8994,5049,2,"PARAMSEQ",2,1)=""
^XWB(8994,5049,3,0)="0^8994.03^3^3^3221219^^^^"
^XWB(8994,5049,3,1,0)="There are four valued returned."
^XWB(8994,5049,3,2,0)="OUT(""COUNT"") - count of Image entries scanned"
^XWB(8994,5049,3,3,0)="OUT(""LAST IEN"") - "
^XWB(8994,5050,0)="MAG DICOM P350 GET NEXT TO FIX^GETNEXT^MAGD350I^1"
^XWB(8994,5050,1,0)="^^1^1^3221220^"
^XWB(8994,5050,1,1,0)="This returns the next entry in ^MAG(2006.5993501) to be fixed."
^XWB(8994,5050,3,0)="^^1^1^3221220^"
^XWB(8994,5050,3,1,0)="Entry from ^MAG(2006.5993501)"
^XWB(8994,5051,0)="MAG DICOM P350 GET BASIC IMAGE^IMAGE^MAGD350J^2"
^XWB(8994,5051,1,0)="^^61^61^3221221^"
