^XWB(8994,3790,0)="DG FULL ICN SHOW/UPDATE^EN^DGFLICN^1^P"
^XWB(8994,3790,1,0)="^^5^5^3171124^"
^XWB(8994,3790,1,1,0)="This RPC is invoked by MPI option - MPI SHOW/UPDATE VISTA ICN. It will "
