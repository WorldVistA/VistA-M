^XWB(8994,4385,3,6,0)="       RET(0)=IEN of new PO in file #442 ^ New PO Number"
^XWB(8994,4386,0)="ORWPT2 COVID^COVID^ORWPT2^1^P^^^^^^1"
^XWB(8994,4386,2,0)="^8994.02A^1^1"
^XWB(8994,4386,2,1,0)="DFN^1^50^1^1"
^XWB(8994,4386,2,"B","DFN",1)=""
