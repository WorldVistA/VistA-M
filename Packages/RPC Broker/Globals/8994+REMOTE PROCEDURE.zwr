^XWB(8994,2725,3,0)="^8994.03^28^28^3061107^^"
^XWB(8994,2725,3,1,0)="This Remote Procedure returns an array with information."
^XWB(8994,2725,3,2,0)="If there is an error in the execution of the Remote Procedure,"
^XWB(8994,2725,3,3,0)="the first element of this array with start with a negative number,"
^XWB(8994,2725,3,4,0)="and the rest of the value in that array element will describe the error."
^XWB(8994,2725,3,5,0)=" "
^XWB(8994,2725,3,6,0)="Otherwise, the value of the first element is the number of valid further elements"
^XWB(8994,2725,3,7,0)="and each further element of the output array will follow the"
^XWB(8994,2725,3,8,0)="general format of a keyword, then a vertical bar, and then one or more"
^XWB(8994,2725,3,9,0)="values associated with that keyword."
^XWB(8994,2725,3,10,0)="For example:"
^XWB(8994,2725,3,11,0)="    OUT(1)=17"
^XWB(8994,2725,3,12,0)="    OUT(2)=""STUDY_UID|1.2.840.113754.1.4.660.1.108"""
^XWB(8994,2725,3,13,0)="    OUT(3)=""STUDY_PAT|35|9865827312V582731|IMAGPATIENT35,35"""
^XWB(8994,2725,3,14,0)="    OUT(4)=""SERIES_UID|"""
^XWB(8994,2725,3,15,0)="    OUT(5)=""SERIES_IEN|6196"""
^XWB(8994,2725,3,16,0)="    OUT(6)=""SERIES_NUMBER|1"""
^XWB(8994,2725,3,17,0)="    OUT(7)=""IMAGE_UID|1.2.840.113754.1.4.660.1.108.59498.43402.0"""
^XWB(8994,2725,3,18,0)="    OUT(8)=""IMAGE_IEN|6197"""
^XWB(8994,2725,3,19,0)="    OUT(9)=""IMAGE_NUMBER|1"""
^XWB(8994,2725,3,20,0)="   OUT(10)=""IMAGE_ABSTRACT|\\vhaiswclu4\User1$\EdD\Image_Gold\DM\00\61\DM006197.ABS"""
^XWB(8994,2725,3,21,0)="   OUT(11)=""IMAGE_FULL|\\vhaiswclu4\User1$\EdD\Image_Gold\DM\00\61\DM006197.DCM"""
^XWB(8994,2725,3,22,0)="   OUT(12)=""IMAGE_TEXT|\\vhaiswclu4\User1$\EdD\Image_Gold\DM\00\61\DM006197.TXT"""
^XWB(8994,2725,3,23,0)="   OUT(13)=""IMAGE_UID|1.2.840.113754.1.4.660.1.108.59498.43402.1"""
