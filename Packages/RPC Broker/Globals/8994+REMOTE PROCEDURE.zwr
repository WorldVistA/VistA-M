^XWB(8994,926,2,1,0)="ECARY^1"
^XWB(8994,926,2,1,1,0)="^^10^10^3180205^"
^XWB(8994,926,2,1,1,1,0)="Optional input variable ECARY containing the following ^ delimited pieces:"
^XWB(8994,926,2,1,1,2,0)=" "
