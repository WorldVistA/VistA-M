^XWB(8994,4947,0)="ISIJ DYNAMIC QUERY^QRYRPC^ISIJLS2^4^P^^^1"
^XWB(8994,4947,1,0)="^8994.01^1^1^3181009^^^^"
^XWB(8994,4947,1,1,0)="Provide functionality to create & validate dynamic queries (compiled by list #9820)."
