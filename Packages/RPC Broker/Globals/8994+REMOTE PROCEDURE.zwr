^XWB(8994,4003,2,1,1,4,0)="19685.3   Work Order file"
^XWB(8994,4003,2,1,1,5,0)="19685.31  Equipment file"
^XWB(8994,4003,2,1,1,6,0)="19685.32  Inventory Item Master file"
^XWB(8994,4003,2,1,1,7,0)="19685.38  Manufacturer-Model"
^XWB(8994,4003,2,2,0)="IEN^1^15^1^2"
^XWB(8994,4003,2,2,1,0)="^8994.021^10^10^3200730^^"
^XWB(8994,4003,2,2,1,1,0)="IEN"
^XWB(8994,4003,2,2,1,2,0)=" "
^XWB(8994,4003,2,2,1,3,0)="IEN to the file in which to update - this must be a valid IEN in the "
^XWB(8994,4003,2,2,1,4,0)="associated file."
^XWB(8994,4003,2,2,1,5,0)=" "
^XWB(8994,4003,2,2,1,6,0)="If updating Equipment, IEN must exist in ^ENG(6914)"
^XWB(8994,4003,2,2,1,7,0)="If updating Work Orders, IEN must exist in ^ENG(6920)"
^XWB(8994,4003,2,2,1,8,0)="If Inventory Master Item File, IEN must exist in ^PRC(441)"
^XWB(8994,4003,2,2,1,9,0)="If updating Manufacturer-Model, IEN must exist in Manufacturer "
^XWB(8994,4003,2,2,1,10,0)=" file ^ENG(""MFG"") and must have a Model."
^XWB(8994,4003,2,3,0)="SUBNODE^1^15^0^5"
^XWB(8994,4003,2,3,1,0)="^8994.021^8^8^3200730^^"
^XWB(8994,4003,2,3,1,1,0)="SUBNODE"
^XWB(8994,4003,2,3,1,2,0)=" "
^XWB(8994,4003,2,3,1,3,0)="Subnode which to update.  If editing, this must be a valid subnode (this "
^XWB(8994,4003,2,3,1,4,0)="can be obtained when using LISTATT and pulling piece #2 from the record "
^XWB(8994,4003,2,3,1,5,0)="selected)."
^XWB(8994,4003,2,3,1,6,0)=" "
^XWB(8994,4003,2,3,1,7,0)="If SUBNODE is left blank, it is assumed that this attachment is being "
^XWB(8994,4003,2,3,1,8,0)="ADDed to the file."
^XWB(8994,4003,2,4,0)="COMMENT^1^60^0^6"
^XWB(8994,4003,2,4,1,0)="^8994.021^3^3^3200730^^"
