^XWB(8994,4670,1,15,0)=" "
^XWB(8994,4670,1,16,0)=" "
^XWB(8994,4670,1,17,0)=" This RPC queries the VistA system for the details on a Consult"
^XWB(8994,4670,1,18,0)="or a Procedure given the Accession Number."
^XWB(8994,4670,2,0)="^8994.02A^1^1"
^XWB(8994,4670,2,1,0)="ACNUMB^1^30^1^1"
^XWB(8994,4670,2,1,1,0)="^^4^4^3211013^"
^XWB(8994,4670,2,1,1,1,0)="The value of this parameter is a string. This value identifies"
^XWB(8994,4670,2,1,1,2,0)="the Accession Number for the study .  The accession number may"
^XWB(8994,4670,2,1,1,3,0)="be in either GMRC-<gmrcien> or <station number>-GMR-<gmrcien>"
^XWB(8994,4670,2,1,1,4,0)="format."
^XWB(8994,4670,2,"B","ACNUMB",1)=""
^XWB(8994,4670,2,"PARAMSEQ",1,1)=""
^XWB(8994,4670,3,0)="^^21^21^3211013^"
^XWB(8994,4670,3,1,0)=" When an error occurs during the processing of this RPC,"
^XWB(8994,4670,3,2,0)=" the output array consists only one element:"
^XWB(8994,4670,3,3,0)="     OUT(1) = -1,No Accession Number Specified"
^XWB(8994,4670,3,4,0)="     OUT(1) = -2,Error in Accession Number Lookup"
^XWB(8994,4670,3,5,0)=" "
^XWB(8994,4670,3,6,0)=" Otherwise, the value of OUT(1) = 1, and there will"
^XWB(8994,4670,3,7,0)=" be 14 additional elements in the output array:"
^XWB(8994,4670,3,8,0)="     OUT(2) = DFN"
^XWB(8994,4670,3,9,0)="     OUT(3) = SERVICE (internal ^ external)"
^XWB(8994,4670,3,10,0)="     OUT(4) = PROCEDURE (internal ^ external, just ^ for Consults)"
^XWB(8994,4670,3,11,0)="     OUT(5) = Consult or Procedure code"
^XWB(8994,4670,3,12,0)="     OUT(6) = Consult or Procedure name"
^XWB(8994,4670,3,13,0)="     OUT(7) = Coding scheme (99CON for Consult, 99PROC for Procedure)"
^XWB(8994,4670,3,14,0)="     OUT(8) = CPT Code (if defined, or else OUT(5))"
^XWB(8994,4670,3,15,0)="     OUT(9) = CPT Name (if defined, or else OUT(6))"
^XWB(8994,4670,3,16,0)="     OUT(10) = CPT coding scheme (C4 or else OUT(7))"
^XWB(8994,4670,3,17,0)="     OUT(11) = Date/time of last activity (FM D/T format)"
^XWB(8994,4670,3,18,0)="     OUT(12) = CPRS Exam Status"
^XWB(8994,4670,3,19,0)="     OUT(13) = Station Number"
^XWB(8994,4670,3,20,0)="     OUT(14) = Accession number (proper format)"
^XWB(8994,4670,3,21,0)="     OUT(15) = GMRCIEN"
