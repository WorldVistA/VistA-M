^XWB(8994,4170,3,1,0)="Result is an array"
^XWB(8994,4170,3,2,0)="Array(0)=""1^Success""    or   ""0^error message"""
^XWB(8994,4171,0)="DVBA CAPRI GET EDIPI^EDIPIQ^DVBCENQ^1^R^0^^0^1"
^XWB(8994,4171,1,0)="^^1^1^3190203^"
^XWB(8994,4171,1,1,0)="CAPRI REMOTE PROCEDURE CALL RETURNS EDIPI TO BE SENT VIA DBQ'S TO DOD"
^XWB(8994,4171,2,0)="^8994.02A^1^1"
