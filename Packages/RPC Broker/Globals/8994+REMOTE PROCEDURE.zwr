^XWB(8994,3923,2,2,1,0)="^^1^1^3130109^"
^XWB(8994,3923,2,2,1,1,0)="Location Type: W=Warehouse, P=Primary, S=Secondary"
^XWB(8994,3923,2,3,0)="DSIYIEN^1^30^1^3"
^XWB(8994,3923,2,3,1,0)="^^1^1^3130109^"
