^XWB(8994,4406,3,1,0)="Array containing validation status."
^XWB(8994,4406,3,2,0)=" "
^XWB(8994,4406,3,3,0)="RETURN(0)=Validation status"
^XWB(8994,4406,3,4,0)="  Value"
^XWB(8994,4406,3,5,0)="============="
^XWB(8994,4406,3,6,0)=" 1 to denote the data is valid"
^XWB(8994,4406,3,7,0)=" -1 to denote the data is not valid"
^XWB(8994,4406,3,8,0)=" "
^XWB(8994,4406,3,9,0)="RETURN(N)=Validation message"
^XWB(8994,4406,3,10,0)="  N is a whole number starting at one and increments by one"
^XWB(8994,4406,3,11,0)="  ""Validation message"" is a line of text suitable for display to the user"
^XWB(8994,4406,3,12,0)="  This is only returned when RETURN(0)=-1"
^XWB(8994,4407,0)="ORWTIU EXCCOPY^EXCCOPY^ORWTIU^1"
^XWB(8994,4407,1,0)="^8994.01^2^2^3120419^"
^XWB(8994,4407,1,1,0)="Given a TIU note ien, calls EXC^TIUCOP to determine if the note should be"
^XWB(8994,4407,1,2,0)="excluded from copy/paste tracking."
