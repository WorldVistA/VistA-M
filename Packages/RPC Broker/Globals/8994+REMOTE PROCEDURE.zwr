^XWB(8994,5179,0)="ORNEWPERS NEWPERSON^NEWPERSON^ORNEWPERS^2^^^^^^^1"
^XWB(8994,5179,1,0)="^8994.01^2^2^3230109^^^^"
^XWB(8994,5179,1,1,0)=" "
^XWB(8994,5179,1,2,0)="Returns a list of users from NEW PERSON (File #200)."
^XWB(8994,5179,2,0)="^8994.02A^1^1"
^XWB(8994,5179,2,1,0)="PARAMS^2^^^1"
^XWB(8994,5179,2,1,1,0)="^8994.021^30^30^3230109^^"
^XWB(8994,5179,2,1,1,1,0)=" "
^XWB(8994,5179,2,1,1,2,0)="This is the list of parameters passed by reference.  All parameters are "
^XWB(8994,5179,2,1,1,3,0)="optional and default to null unless noted below."
^XWB(8994,5179,2,1,1,4,0)=" "
^XWB(8994,5179,2,1,1,5,0)="Example:     PARAM(""FROM"")=""PROVIDER,CPRS"""
^XWB(8994,5179,2,1,1,6,0)="             PARAM(""KEY"")=""ORES"""
^XWB(8994,5179,2,1,1,7,0)="             PARAM(""DATE"")=3230101"
^XWB(8994,5179,2,1,1,8,0)="       "
^XWB(8994,5179,2,1,1,9,0)="Parameter "
^XWB(8994,5179,2,1,1,10,0)="Name       Description"
^XWB(8994,5179,2,1,1,11,0)="======================"
^XWB(8994,5179,2,1,1,12,0)="FROM       Starting position of the index [IEN for similar provider]"
^XWB(8994,5179,2,1,1,13,0)="DIR        Direction to search index [default=1, -1=reverse]"
^XWB(8994,5179,2,1,1,14,0)="KEY        Name of SECURITY KEY that must be assigned to the user"
^XWB(8994,5179,2,1,1,15,0)="DATE       FileMan format, used when evaluating termination date, person "
^XWB(8994,5179,2,1,1,16,0)="           class, ASU user class, and co-signer evaluation"
^XWB(8994,5179,2,1,1,17,0)="RDV        Allow visitors, uses ""B"" index [boolean, default=0]"
^XWB(8994,5179,2,1,1,18,0)="ALL        Allow disabled & terminated users, uses ""B"" index [boolean, "
^XWB(8994,5179,2,1,1,19,0)="           default=0]"
^XWB(8994,5179,2,1,1,20,0)="PDMP       User must have PDMP authorization [boolean, default=0]"
^XWB(8994,5179,2,1,1,21,0)="SPN        Perform similar provider name lookup [boolean, default=0]"
^XWB(8994,5179,2,1,1,22,0)="EXC        Use OR CPRS USER CLASS EXCLUDE [boolean, default=0]"
^XWB(8994,5179,2,1,1,23,0)="NVAP       Include non-VA Providers [boolean, default=1]"
^XWB(8994,5179,2,1,1,24,0)="DFC        Perform default co-signer lookup [boolean, default=0]"
^XWB(8994,5179,2,1,1,25,0)="TIUDA      IEN of document File #8925, used for co-signer evaluation"
^XWB(8994,5179,2,1,1,26,0)="TYPE       IEN of document definition #8925.1, used for co-signer"
^XWB(8994,5179,2,1,1,27,0)="           evaluation"
^XWB(8994,5179,2,1,1,28,0)="HELP       Returns remote procedure help [boolean, default=1]"
^XWB(8994,5179,2,1,1,29,0)=" "
^XWB(8994,5179,2,1,1,30,0)="<end list of parameters>"
^XWB(8994,5179,2,"B","PARAMS",1)=""
^XWB(8994,5179,2,"PARAMSEQ",1,1)=""
^XWB(8994,5179,3,0)="^8994.03^4^4^3230109^^^"
^XWB(8994,5179,3,1,0)=" "
^XWB(8994,5179,3,2,0)="Returns formatted list of users:"
^XWB(8994,5179,3,3,0)=" "
^XWB(8994,5179,3,4,0)="IEN^LASTNAME,FIRST[^- <title>, <service/section>, <division> [NPI: #]]"
^XWB(8994,5180,0)="ORHEDITOR SAVE^SAVE^ORHEDITOR^4^A"
^XWB(8994,5180,1,0)="^^3^3^3250310^"
^XWB(8994,5180,1,1,0)="The inputs for this RPC can vary depending on which Information Panel "
^XWB(8994,5180,1,2,0)="Button action event triggers the call. Similarly, the output will also "
^XWB(8994,5180,1,3,0)="differ based on the specific Information Panel Button action event."
^XWB(8994,5180,2,0)="^8994.02A^1^1"
^XWB(8994,5180,2,1,0)="IJSON^2^^1^1"
^XWB(8994,5180,2,"B","IJSON",1)=""
^XWB(8994,5180,2,"PARAMSEQ",1,1)=""
^XWB(8994,5181,0)="ORWEB GETWEBCONTENT^GETWEBCONTENT^ORWEB^2^^^^0"
^XWB(8994,5182,0)="ORHRPC LOOKUP^LOOKUP^ORHRPC^2^A^^^0"
^XWB(8994,5182,1,0)="^^85^85^3251203^"
^XWB(8994,5182,1,1,0)="This RPC is used to retrieve data that is needed by a component in an "
^XWB(8994,5182,1,2,0)="HTML Dialog. For example, this RPC can be used to retrieve a list of "
^XWB(8994,5182,1,3,0)="active users who hold the provider key. The input to the RPC is a JSON "
^XWB(8994,5182,1,4,0)="document that contains information the received code will need to "
^XWB(8994,5182,1,5,0)="complete its process."
^XWB(8994,5182,1,6,0)=" "
^XWB(8994,5182,1,7,0)="{"
^XWB(8994,5182,1,8,0)="    ""lookupType"": ""nvaProviderLookup"","
^XWB(8994,5182,1,9,0)="    ""startFrom"": ""p"","
^XWB(8994,5182,1,10,0)="    ""startId"": """","
^XWB(8994,5182,1,11,0)="    ""direction"": """","
^XWB(8994,5182,1,12,0)="    ""parameters"": {"
^XWB(8994,5182,1,13,0)="        ""buttonClick"": false,"
^XWB(8994,5182,1,14,0)="        ""vistaRequiredValues"": {"
^XWB(8994,5182,1,15,0)="            ""dataEncounterProvider"": {"
^XWB(8994,5182,1,16,0)="                ""id"": 520824671,"
^XWB(8994,5182,1,17,0)="                ""name"": ""CPRS,PROVIDER"""
^XWB(8994,5182,1,18,0)="            },"
^XWB(8994,5182,1,19,0)="            ""dataUserInformation"": {"
^XWB(8994,5182,1,20,0)="                ""id"": 520824671,"
^XWB(8994,5182,1,21,0)="                ""name"": ""CPRS,PROVIDER"""
^XWB(8994,5182,1,22,0)="            },"
^XWB(8994,5182,1,23,0)="            ""dataVisitInformation"": {"
^XWB(8994,5182,1,24,0)="                ""id"": """","
^XWB(8994,5182,1,25,0)="                ""locId"": 240,"
^XWB(8994,5182,1,26,0)="                ""locName"": ""20 MINUTE"","
^XWB(8994,5182,1,27,0)="                ""visitDateTime"": 3251128.162123,"
^XWB(8994,5182,1,28,0)="                ""visitString"": ""240;3251128.162123;A"","
^XWB(8994,5182,1,29,0)="                ""visitType"": ""A"""
^XWB(8994,5182,1,30,0)="            }"
^XWB(8994,5182,1,31,0)="        },"
^XWB(8994,5182,1,32,0)="        ""vistaSourceData"": {"
^XWB(8994,5182,1,33,0)="            ""connectedUser"": 520824671,"
^XWB(8994,5182,1,34,0)="            ""editorId"": 17,"
^XWB(8994,5182,1,35,0)="            ""id"": ""2;1;1;6"","
^XWB(8994,5182,1,36,0)="            ""package"": ""ORDER ENTRY/RESULTS REPORTING"","
^XWB(8994,5182,1,37,0)="            ""patient"": 100007"
^XWB(8994,5182,1,38,0)="        }"
^XWB(8994,5182,1,39,0)="    }"
^XWB(8994,5182,1,40,0)="}"
^XWB(8994,5182,1,41,0)=" "
^XWB(8994,5182,1,42,0)="Property Definitions:"
^XWB(8994,5182,1,43,0)="lookupType: This property maps to a line tag in VistA that the RPC will "
^XWB(8994,5182,1,44,0)="            need to call to retrieve data."
^XWB(8994,5182,1,45,0)="startFrom:  On a lookup, the string to start looking from."
^XWB(8994,5182,1,46,0)="startId:    On a lookup, the IEN of the record to start the lookup from."
^XWB(8994,5182,1,47,0)="direction:  The direction to search from. Can be set to one of the "
^XWB(8994,5182,1,48,0)="            following values: """", ""down"", ""up"", 1, -1. A value of """","
^XWB(8994,5182,1,49,0)="            ""down"", or 1 will search down the list, while a value of -1 or"
^XWB(8994,5182,1,50,0)="            ""up"" will search up the list."
^XWB(8994,5182,1,51,0)=" "
^XWB(8994,5182,1,52,0)="Parameters Object:"
^XWB(8994,5182,1,53,0)="buttonClick: Set to true or false, this is used to determine if a special "
^XWB(8994,5182,1,54,0)="lookup button was clicked. Currently used for Non-VA Provider lookup. If "
^XWB(8994,5182,1,55,0)="set to true, the lookup will return Non-VA providers; if set to false, "
^XWB(8994,5182,1,56,0)="the lookup will not return Non-VA providers. This can be used with other "
^XWB(8994,5182,1,57,0)="lookups if needed."
^XWB(8994,5182,1,58,0)=" "
^XWB(8994,5182,1,59,0)="vistaSourceData Object: This object will be populated for all calls. "
^XWB(8994,5182,1,60,0)=" "
^XWB(8994,5182,1,61,0)="Property definitions:"
^XWB(8994,5182,1,62,0)=" connectedUser: The VistA system-connected user DUZ from file 200."
^XWB(8994,5182,1,63,0)=" editorId: The editor IEN from file 101.75."
^XWB(8994,5182,1,64,0)=" id:       The InfoPanel DAS string to get to the record that"
^XWB(8994,5182,1,65,0)="           contains the editor."
^XWB(8994,5182,1,66,0)=" package:  Which package from file 9.4 is requesting this data."
^XWB(8994,5182,1,67,0)=" patient:  The selected patient DFN from file 2."
^XWB(8994,5182,1,68,0)=" "
^XWB(8994,5182,1,69,0)=" "
^XWB(8994,5182,1,70,0)="Return array is a JSON output with the definition:"
^XWB(8994,5182,1,71,0)=" "
^XWB(8994,5182,1,72,0)=" "
^XWB(8994,5182,1,73,0)="{"
^XWB(8994,5182,1,74,0)="    ""data"": ["
^XWB(8994,5182,1,75,0)="        {"
^XWB(8994,5182,1,76,0)="            ""const"": ""IEN from the file the record is from"","
^XWB(8994,5182,1,77,0)="            ""display"": ""A display printout, not used for lookup"","
^XWB(8994,5182,1,78,0)="            ""title"": ""The .01 from record"""
^XWB(8994,5182,1,79,0)="        }"
^XWB(8994,5182,1,80,0)="    ],"
^XWB(8994,5182,1,81,0)="    ""hasMore"": ""Boolean value to let the calling application know if "
^XWB(8994,5182,1,82,0)="there are more records after the last record in the array."","
^XWB(8994,5182,1,83,0)="    ""hasPrevious"": ""Boolean value to let the calling application know if "
^XWB(8994,5182,1,84,0)="there are records before the first record in the return array."""
^XWB(8994,5182,1,85,0)="}"
