^XWB(8994,3985,0)="DSIYGNI1 DELETE ITEM^DELETE^DSIYGNI1^2"
^XWB(8994,3985,1,0)="^^3^3^3130327^"
^XWB(8994,3985,1,1,0)="Attempts to delete an item from the inventory point. Manager Key is "
^XWB(8994,3985,1,2,0)="required!!! First checks if item can be deleted, then deletes item, with "
^XWB(8994,3985,1,3,0)="option to also delete item from distribution points."
^XWB(8994,3985,2,0)="^8994.02A^6^6"
^XWB(8994,3985,2,1,0)="STN^1^3^1^1"
^XWB(8994,3985,2,1,1,0)="^^1^1^3130327^"
^XWB(8994,3985,2,1,1,1,0)="3 digit station #"
^XWB(8994,3985,2,2,0)="TYPE^1^1^1^2"
^XWB(8994,3985,2,2,1,0)="^^1^1^3130327^"
^XWB(8994,3985,2,2,1,1,0)="Type of Inventory Point: W=Warehouse, P=Primary, S=Secondary"
^XWB(8994,3985,2,3,0)="DSIYIEN^1^30^1^3"
^XWB(8994,3985,2,3,1,0)="^^1^1^3130327^"
^XWB(8994,3985,2,3,1,1,0)="The Inventory Point from which to delete the item."
^XWB(8994,3985,2,4,0)="DSIYTIEN^1^30^1^4"
^XWB(8994,3985,2,4,1,0)="^^1^1^3130327^"
^XWB(8994,3985,2,4,1,1,0)="IEN of the INVENTORY ITEM to delete."
^XWB(8994,3985,2,5,0)="DELDIST^1^1^0^5"
^XWB(8994,3985,2,5,1,0)="^^1^1^3130327^"
^XWB(8994,3985,2,5,1,1,0)="Pass 1 to delete item from all distribution points."
^XWB(8994,3985,2,5,1,2,0)=" "
^XWB(8994,3985,2,5,1,3,0)="""D"" - If item in Primary DP is deleted, delete item in Stocked Secondaries"
^XWB(8994,3985,2,5,1,4,0)="""W"" - Do not delete item. Only return Warnings or state if item is OK to "
^XWB(8994,3985,2,5,1,5,0)="      delete."
^XWB(8994,3985,2,5,1,6,0)="""O"" - Display Outstanding Orders"
^XWB(8994,3985,2,6,0)="WARNONLY^1^1^0^6"
^XWB(8994,3985,2,6,1,0)="^^6^6^3130411^"
^XWB(8994,3985,2,6,1,1,0)="Flag to run DELETE in ""warning only"" mode. This mode will check for all "
^XWB(8994,3985,2,6,1,2,0)="errors that may prevent deletion or warnings with which the user should "
^XWB(8994,3985,2,6,1,3,0)="be presented before deleting, but will not delete the item. In this mode, "
^XWB(8994,3985,2,6,1,4,0)=" errors or warnings will be indicated by a list of the standard "
^XWB(8994,3985,2,6,1,5,0)="""-1^error/warning message"", and, if the item is okay to delete, will "
^XWB(8994,3985,2,6,1,6,0)="return ""1^OKAY TO DELETE""."
^XWB(8994,3985,2,"B","DELDIST",5)=""
