^XWB(8994,4003,1,1,0)="ATTUPDT"
^XWB(8994,4003,1,2,0)=" "
^XWB(8994,4003,1,3,0)="Update attachments in the ^DSIY files"
^XWB(8994,4003,2,0)="^8994.02A^7^7"
^XWB(8994,4003,2,1,0)="FILE^1^15^1^1"
^XWB(8994,4003,2,1,1,0)="^8994.021^7^7^3200730^^"
^XWB(8994,4003,2,1,1,1,0)="FILE"
