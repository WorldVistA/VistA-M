^XWB(8994,4686,0)="SDES SEARCH PRIVILEGED USER^SEARCHPRIVUSER^SDES2^2^R^0^^^^^1"
^XWB(8994,4686,1,0)="^^7^7^3250207^"
^XWB(8994,4686,1,1,0)="This RPC that allows users to search a person's name either partially or "
^XWB(8994,4686,1,2,0)="fully. The RPC will perform a search that matches the search criteria "
^XWB(8994,4686,1,3,0)="(3-35 characters), and then, retrieves and returns a list of ACTIVE users "
^XWB(8994,4686,1,4,0)="from the NEW PERSON File #200 regardless if they are already a privileged "
^XWB(8994,4686,1,5,0)="user or not. Users that are DISUSER and TERMINATED will be skipped."
^XWB(8994,4686,1,6,0)=" "
^XWB(8994,4686,1,7,0)="Can only be invoked by Acheron"
^XWB(8994,4686,2,0)="^8994.02A^2^1"
^XWB(8994,4686,2,2,0)="USERNAMETOSEARCH^1^35^1^1"
^XWB(8994,4686,2,2,1,0)="^8994.021^4^4^3250207^^"
^XWB(8994,4686,2,2,1,1,0)="Search string to search on."
^XWB(8994,4686,2,2,1,2,0)="Search string must be between 3 and 35 characters."
^XWB(8994,4686,2,2,1,3,0)="Search string value cannot be null."
^XWB(8994,4686,2,2,1,4,0)="Search string should be in the following format: LAST,FIRST MI"
^XWB(8994,4686,2,"B","USERNAMETOSEARCH",2)=""
