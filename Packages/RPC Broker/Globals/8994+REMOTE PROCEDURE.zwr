^XWB(8994,2907,3,1,0)="No return parameter has been defined for this procedure call."
^XWB(8994,2908,0)="MAGQBP ALL SHARES^ALLSHR^MAGQBUT1^2^R"
^XWB(8994,2908,1,0)="^8994.01^4^4^3100812^^^^"
^XWB(8994,2908,1,1,0)="The output of this RPC is a list of all online magnetic shares"
^XWB(8994,2908,1,2,0)="(non-routing).  This list establishes a set of roots for the purge process"
^XWB(8994,2908,1,3,0)="to downwardly traverse and evaluate the age and VistA attributes of each"
^XWB(8994,2908,1,4,0)="image file for the purpose of purging archaic and archived files."
^XWB(8994,2908,2,0)="^8994.02A^2^1"
^XWB(8994,2908,2,2,0)="TYPE^1^8^0^1"
^XWB(8994,2908,2,2,1,0)="^8994.021^4^4^3100812^^^"
^XWB(8994,2908,2,2,1,1,0)="This value is used to determine if there is a screen intended for "
^XWB(8994,2908,2,2,1,2,0)="members of the Next RAID Group."
^XWB(8994,2908,2,2,1,3,0)="""ALL"" performs no screen."
^XWB(8994,2908,2,2,1,4,0)="""AUTO"" will screen for members of the Next RAID group."
^XWB(8994,2908,2,"B","TYPE",2)=""
