^XWB(8994,4400,3,21,0)="     2     IEN"
^XWB(8994,4400,3,22,0)="           Internal Entry Number (IEN) of the VA-WH TD"
^XWB(8994,4400,3,23,0)="           PREGNANCY STATUS YES LMPD reminder dialog entry"
^XWB(8994,4401,0)="WVRPCOR DETAIL^DETAIL^WVRPCOR^2^S^0^^^^^0"
^XWB(8994,4401,1,0)="^8994.01^2^2^3171026^^"
^XWB(8994,4401,1,1,0)="Returns the content of the pop-up details window when the user clicks on "
