^XWB(8994,3850,3,0)="^8994.03^2^2^3120605^^^^"
^XWB(8994,3850,3,1,0)="Parameters returned can vary.  See the call for submitting the report for "
^XWB(8994,3850,3,2,0)="a layout of the parameters returned."
^XWB(8994,3851,0)="DSIYRPTR KCHK REPORT KILL CHK^KCHK^DSIYRPTR^1"
^XWB(8994,3851,1,0)="^^3^3^3120605^"
^XWB(8994,3851,1,1,0)="This procedure is used to check to see if the report cleanup task needs to"
^XWB(8994,3851,1,2,0)="be run. If yes, the DSIYR REPORT KILL CHECK DATE parameter is updated and "
^XWB(8994,3851,1,3,0)="the cleanup task is queued."
^XWB(8994,3851,3,0)="^8994.03^3^3^3120605^^"
^XWB(8994,3851,3,1,0)="OUTPUT IS EITHER "
^XWB(8994,3851,3,2,0)="  0 (ZERO) WHICH INDICATES NO ACTION NEEDED"
^XWB(8994,3851,3,3,0)="  1 WHICH INDICATES THE REPORT CLEANUP TASK WAS SCHEDULED"
^XWB(8994,3852,0)="DSIYRPTR PROG GET RPT PROGRESS^PROG^DSIYRPTR^1"
^XWB(8994,3852,1,0)="^8994.01^1^1^3120605^^"
^XWB(8994,3852,1,1,0)="Returns progress of a specified report."
