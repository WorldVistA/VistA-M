^XWB(8994,1575,2,1,0)="GMVTYPE^1^55^1^1"
^XWB(8994,1575,2,1,1,0)="^8994.021^1^1^3051028^^^"
^XWB(8994,1575,2,1,1,1,0)="GMVTYPE = Name of Vital Type (from FILE 120.51) (e.g., WEIGHT)"
^XWB(8994,1575,2,"B","GMVTYPE",1)=""
