^XWB(8994,2536,2,13,0)="DSIVAUDT^1^10^0^13"
^XWB(8994,2536,2,13,1,0)="^8994.021^1^1^3070820^^^"
^XWB(8994,2536,2,13,1,1,0)="Internal entry number in File #19625.  Used when filing COMMENT fields."
^XWB(8994,2536,2,16,0)="IBDATA^1^100^1^3"
^XWB(8994,2536,2,16,1,0)="^^18^18^3170310^"
^XWB(8994,2536,2,16,1,1,0)="IBDATA array containts the following variables and data in an array"
^XWB(8994,2536,2,16,1,2,0)=" e.g. IBDATA(1)=""IBINSDA^1002"""
^XWB(8994,2536,2,16,1,3,0)="      IBDATA(2)=""INGRPDA^"""
^XWB(8994,2536,2,16,1,4,0)="      "
^XWB(8994,2536,2,16,1,5,0)="IBINSDA=File 36 IEN if not adding new entry"
^XWB(8994,2536,2,16,1,6,0)="IBGRPDA=File 355.3 IEN if not adding new entry"
^XWB(8994,2536,2,16,1,7,0)="IBPOLDA=File 2.312 IEN if not adding new entry"
^XWB(8994,2536,2,16,1,8,0)="IBMVINS=Type for INSURANCE 1=Merge, 2=Overwrite, 3=Replace, 4=(n/a)"
^XWB(8994,2536,2,16,1,9,0)="IBMVGRP=Type for GROUP     1=Merge, 2=Overwrite, 3=Replace, 4=(n/a)"
^XWB(8994,2536,2,16,1,10,0)="IBMVPOL=Type for POLICY    1=Merge, 2=Overwrite, 3=Replace, 4=(n/a)"
^XWB(8994,2536,2,16,1,11,0)="IBNEWINS=Add new INSURANCE COMPANY flag (non-zero means add)"
^XWB(8994,2536,2,16,1,12,0)="IBNEWGRP=Add new GROUP INSURANCE PLAN flag (non-zero means add)"
^XWB(8994,2536,2,16,1,13,0)="IBNEWPOL=Add new patient insurance policy (non-zero means add)"
^XWB(8994,2536,2,16,1,14,0)="IVMREPTR=File 301.91 IEN if applicable (IVM REASONS FOR NOT UPLOADING..)"
^XWB(8994,2536,2,16,1,15,0)="DSIVAUDT=File 19625 IEN if updating pt policy or group plan COMMENT"
^XWB(8994,2536,2,16,1,16,0)="IBELIG=to copy eIV report to pt elig/benefits 0=no,1=yes"
^XWB(8994,2536,2,16,1,17,0)="DSIV118=Flag to indicate new ICB GUI is being used and patient policy "
^XWB(8994,2536,2,16,1,18,0)="        comment is not to be utilized."
