^XWB(8994,2472,2,"PARAMSEQ",1,1)=""
^XWB(8994,2473,0)="PSB MAN SCAN FAILURE^SCANFAIL^PSBVDLU3^2^R^^^^3"
^XWB(8994,2473,1,0)="^^19^19^3060712^"
^XWB(8994,2473,1,1,0)="SCANFAIL(RESULTS,PSBPARAM)      ;  TEJ 05/12/2006  BCMA-Managing Scanning Failures (MSF)"
^XWB(8994,2473,1,2,0)="        ;       Process Scanning Failures"
^XWB(8994,2473,1,3,0)="        ;               Parameters:"
^XWB(8994,2473,1,4,0)="        ;               Input (via GUI):"
^XWB(8994,2473,1,5,0)="        ;        Per Wristband  (0)      -       Pat IEN ^ ^ Failure Reason ^ User's Comment ^ ""W"" ^-1 (keyed)"
^XWB(8994,2473,1,6,0)="        ;                                       "
^XWB(8994,2473,1,7,0)="        ;        Per Medication"
^XWB(8994,2473,1,8,0)="        ;                       (0)      -       Pat IEN ^ Order Number ^ Failure Reason ^ User's Comment ^ ""M"" ^-1 (keyed)"
^XWB(8994,2473,1,9,0)="        ;                       (1)      -       tag^ unique identifier"
^XWB(8994,2473,1,10,0)="        ;"
^XWB(8994,2473,1,11,0)="        ;          (example)    (1)      -       ADD^IEN of FAILED item"
^XWB(8994,2473,1,12,0)="        ;                       "
^XWB(8994,2473,1,13,0)="        ;               Output:"
^XWB(8994,2473,1,14,0)="        ;                 Entry into database ^PSB(53.89)"
^XWB(8994,2473,1,15,0)="        ;                 Electronic Mail - Message Data per Scan Failure"
^XWB(8994,2473,1,16,0)="        ;                 "
^XWB(8994,2473,1,17,0)="        ;                 RESULTS(0)=1"
^XWB(8994,2473,1,18,0)="        ;                 RESULTS(1)= 1 (Success) or -1 (Nonsuccess)"
^XWB(8994,2473,1,19,0)="        ;"
^XWB(8994,2473,2,0)="^8994.02A^2^1"
^XWB(8994,2473,2,2,0)="PSBPARAM^2^^1^1"
^XWB(8994,2473,2,2,1,0)="^^10^10^3060712^"
^XWB(8994,2473,2,2,1,1,0)="Data to initiate scanning failure process.  Input: Only"
^XWB(8994,2473,2,2,1,2,0)="""^""piece that must be populated is #5 - scan type "
^XWB(8994,2473,2,2,1,3,0)="(""Wristband""/""Medication"")"
^XWB(8994,2473,2,2,1,4,0)="   i.e. - MUAS WUAS MKEY WKEY MSCN WSCN MMME"
^XWB(8994,2473,2,2,1,5,0)=" "
^XWB(8994,2473,2,2,1,6,0)="Node (1) is to present "" tag ^ unique id "" if available for a medication "
^XWB(8994,2473,2,2,1,7,0)="""unable to scan""."
^XWB(8994,2473,2,2,1,8,0)=" "
^XWB(8994,2473,2,2,1,9,0)="Procedure will populate BCMA Unable To Scan Log "
^XWB(8994,2473,2,2,1,10,0)="(file#53.77) appropriately, and send off MailMan message if necessary."
^XWB(8994,2473,2,"B","PSBPARAM",2)=""
^XWB(8994,2473,2,"PARAMSEQ",1,2)=""
^XWB(8994,2473,3,0)="^^2^2^3080825^"
^XWB(8994,2473,3,1,0)="RESULTS(0)=1"
^XWB(8994,2473,3,2,0)="RESULTS(1)= 1 (SUCCESS) or -1 (NONSUCCESS)"
^XWB(8994,2474,0)="VBECS PATIENT LOOKUP^SEARCH^VBECLU^4^R^"
^XWB(8994,2474,1,0)="^8994.01^68^68^3050516^"
^XWB(8994,2474,1,1,0)="This RPC returns XML containing a list of patient demographic data for "
^XWB(8994,2474,1,2,0)="the purpose of inserting a new patient in the VBECS database for "
^XWB(8994,2474,1,3,0)="when receiving an autologous or directed unit on a patient that is not "
^XWB(8994,2474,1,4,0)="already defined in the VBECS Patient table."
^XWB(8994,2474,1,5,0)=" "
^XWB(8994,2474,1,6,0)="XML Mapping:"
^XWB(8994,2474,1,7,0)="count attribute =       Number of records found"
^XWB(8994,2474,1,8,0)="Number element =        Sequence number of records found"
^XWB(8994,2474,1,9,0)="VistaPatientId =        PATIENT file (#2) / NUMBER field (#.001)"
^XWB(8994,2474,1,10,0)="PatientLastName =       PATIENT file (#2) / first comma delimited piece "
^XWB(8994,2474,1,11,0)="                        of the NAME field (#.01)"
^XWB(8994,2474,1,12,0)="PatientFirstName =      PATIENT file (#2) / second comma delimited piece "
^XWB(8994,2474,1,13,0)="                        and first ""space"" delimited piece of the NAME"
^XWB(8994,2474,1,14,0)="                        field (#.01)"
^XWB(8994,2474,1,15,0)="PatientMiddleName =     PATIENT file (#2) / second comma delimited piece"
^XWB(8994,2474,1,16,0)="                        and second ""space"" delimited piece of the NAME"
^XWB(8994,2474,1,17,0)="                        field (#.01)"
^XWB(8994,2474,1,18,0)="Sensitive =             DG SECURITY LOG file (#38.1) / SECURITY LEVEL "
^XWB(8994,2474,1,19,0)="                        field (#2)"
^XWB(8994,2474,1,20,0)="PatientDOB =            PATIENT file (#2) / DATE OF BIRTH field (#.03) in "
^XWB(8994,2474,1,21,0)="                        HL7 format"
^XWB(8994,2474,1,22,0)="PatientDOBCode =        Code derived from a missing day or month value in "
^XWB(8994,2474,1,23,0)="                        PatientDOB."
^XWB(8994,2474,1,24,0)="                        B = Both Day and Month is unknown."
^XWB(8994,2474,1,25,0)="                        M = Month is unknown."
^XWB(8994,2474,1,26,0)="                        D = Day is unknown"
^XWB(8994,2474,1,27,0)="                        V = valid Day/Month/Year"
^XWB(8994,2474,1,28,0)="PatientSSN =            PATIENT file (#2) / SOCIAL SECURITY NUMBER field "
^XWB(8994,2474,1,29,0)="                        (#.09)"
^XWB(8994,2474,1,30,0)="PatientDeathDate =      PATIENT file (#2) / DATE OF DEATH field (#.351)"
^XWB(8994,2474,1,31,0)="Type =                  TYPE OF PATIENT file (#391) / NAME field (#.01)"
^XWB(8994,2474,1,32,0)="PrimaryEligibility =    MAS ELIGIBILITY CODE file (#8.1) / PRINT NAME "
^XWB(8994,2474,1,33,0)="                        field (#5)"
^XWB(8994,2474,1,34,0)="ServiceConnected =      PATIENT file (#2) / SERVICE CONNECTED? field "
^XWB(8994,2474,1,35,0)="                        (#.301)"
^XWB(8994,2474,1,36,0)="ScPercent =             PATIENT file (#2) / SERVICE CONNECTED PERCENTAGE "
^XWB(8994,2474,1,37,0)="                        field (#.302)"
^XWB(8994,2474,1,38,0)="PatientSexCode =        PATIENT file (#2) / SEX field (#.02)"
^XWB(8994,2474,1,39,0)="PatientICN =            PATIENT file (#2) / INTEGRATION CONTROL NUMBER "
^XWB(8994,2474,1,40,0)="                        field (#991.01)"
^XWB(8994,2474,1,41,0)="Veteran =               PATIENT file (#2) / VETERAN (Y/N)? field (#1901)"
^XWB(8994,2474,1,42,0)="PatientLocation =       PATIENT file (#2) / WARD LOCATION field (#.1)"
^XWB(8994,2474,1,43,0)="PatientRoomBed =        PATIENT file (#2) / ROOM-BED field (#.101)"
^XWB(8994,2474,1,44,0)=" "
^XWB(8994,2474,1,45,0)=" "
^XWB(8994,2474,1,46,0)="XML Example:"
^XWB(8994,2474,1,47,0)="<record count='1'>"
^XWB(8994,2474,1,48,0)="    <Patient>"
^XWB(8994,2474,1,49,0)="        <Number>1</Number>"
^XWB(8994,2474,1,50,0)="        <VistaPatientID>1000</VistaPatientID>"
^XWB(8994,2474,1,51,0)="        <PatientLastName>VBECSpatient</PatientLastName>"
^XWB(8994,2474,1,52,0)="        <PatientFirstName>One</PatientFirstName>"
^XWB(8994,2474,1,53,0)="        <PatientMiddleName>T</PatientMiddleName>"
^XWB(8994,2474,1,54,0)="        <Sensitive>false</Sensitive>"
^XWB(8994,2474,1,55,0)="        <PatientDOB>19291120</PatientDOB>"
^XWB(8994,2474,1,56,0)="        <PatientDOBCode>V</PatientDOBCode>"
^XWB(8994,2474,1,57,0)="        <PatientSSN>666000000</PatientSSN>"
^XWB(8994,2474,1,58,0)="        <Type>SC VETERAN</Type>"
^XWB(8994,2474,1,59,0)="        <PrimaryEligibility>SC, 50% TO 100%</PrimaryEligibility>"
^XWB(8994,2474,1,60,0)="        <ServiceConnected>true</ServiceConnected>"
^XWB(8994,2474,1,61,0)="        <ScPercent>50</ScPercent>"
^XWB(8994,2474,1,62,0)="        <PatientSexCode>M</PatientSexCode>"
^XWB(8994,2474,1,63,0)="        <PatientICN>1000000000V000000</PatientICN>"
^XWB(8994,2474,1,64,0)="        <Veteran>true</Veteran>"
^XWB(8994,2474,1,65,0)="        <PatientLocation></PatientLocation>"
^XWB(8994,2474,1,66,0)="        <PatientRoomBed></PatientRoomBed>"
^XWB(8994,2474,1,67,0)="    </Patient>"
^XWB(8994,2474,1,68,0)="</record>"
^XWB(8994,2474,2,0)="^8994.02A^1^1"
^XWB(8994,2474,2,1,0)="PARAM^1^999^0^1"
^XWB(8994,2474,2,1,1,0)="^8994.021^5^5^3031007^^"
^XWB(8994,2474,2,1,1,1,0)="Input PARAM(""SEARCH TYPE"") = type of search requested"
^XWB(8994,2474,2,1,1,2,0)="Input PARAM(""SEARCH VALUE"") = value to search on"
^XWB(8994,2474,2,1,1,3,0)="RETURN PARAMETER DESCRIPTION:"
^XWB(8994,2474,2,1,1,4,0)="XML document with list of patients found based on search type and"
^XWB(8994,2474,2,1,1,5,0)="search value."
^XWB(8994,2474,2,"B","PARAM",1)=""
^XWB(8994,2474,2,"PARAMSEQ",1,1)=""
^XWB(8994,2475,0)="VBECS HOSPITAL LOCATION LOOKUP^LOC^VBECRPCD^4^R"
^XWB(8994,2475,1,0)="^^27^27^3050510^"
^XWB(8994,2475,1,1,0)="This RPC returns XML containing a list of Hospital Locations from the "
^XWB(8994,2475,1,2,0)="HOSPITAL LOCATION file (#44) of either Ward or Clinic Type for use in "
^XWB(8994,2475,1,3,0)="VBECS when issuing units to a location other than the Blood Bank."
^XWB(8994,2475,1,4,0)=" "
^XWB(8994,2475,1,5,0)="XML Mapping:"
^XWB(8994,2475,1,6,0)="LocationName element = HOSPITAL LOCATION file (#44) / NAME field (#.01)"
^XWB(8994,2475,1,7,0)="LocationIEN element =  HOSPITAL LOCATION file (#44) / NUMBER field (#.001)"
^XWB(8994,2475,1,8,0)="LocationType element = HOSPITAL LOCATION file (#44) / TYPE field (#2)"
^XWB(8994,2475,1,9,0)=" "
^XWB(8994,2475,1,10,0)="XML Example:"
^XWB(8994,2475,1,11,0)="<HospitalLocations>"
^XWB(8994,2475,1,12,0)="    <Location>"
^XWB(8994,2475,1,13,0)="        <LocationName>6W REHAB-KC</LocationName>"
^XWB(8994,2475,1,14,0)="        <LocationIEN>503</LocationIEN>"
^XWB(8994,2475,1,15,0)="        <LocationType>W</LocationType>"
^XWB(8994,2475,1,16,0)="    </Location>"
^XWB(8994,2475,1,17,0)="    <Location>"
^XWB(8994,2475,1,18,0)="        <LocationName>7E PCUS-KC</LocationName>"
^XWB(8994,2475,1,19,0)="        <LocationIEN>504</LocationIEN>"
^XWB(8994,2475,1,20,0)="        <LocationType>W</LocationType>"
^XWB(8994,2475,1,21,0)="    </Location>"
^XWB(8994,2475,1,22,0)="    <Location>"
^XWB(8994,2475,1,23,0)="        <LocationName>KC-GI RESEARCH</LocationName>"
^XWB(8994,2475,1,24,0)="        <LocationIEN>511</LocationIEN>"
^XWB(8994,2475,1,25,0)="        <LocationType>C</LocationType>"
^XWB(8994,2475,1,26,0)="    </Location>"
^XWB(8994,2475,1,27,0)="</HospitalLocations>"
^XWB(8994,2475,2,0)="^8994.02A^1^1"
^XWB(8994,2475,2,1,0)="DIV^1^999^1^1"
^XWB(8994,2475,2,1,1,0)="^^1^1^3040226^"
^XWB(8994,2475,2,1,1,1,0)="Input DIV = DIVISION Name"
^XWB(8994,2475,2,"B","DIV",1)=""
^XWB(8994,2475,2,"PARAMSEQ",1,1)=""
^XWB(8994,2475,3,0)="^^1^1^3040226^"
^XWB(8994,2475,3,1,0)="XML document with a list of Hospital Location found based on input value"
^XWB(8994,2476,0)="VBECS PROVIDER LOOKUP^PROVIDER^VBECRPCE^4^R"
^XWB(8994,2476,1,0)="^8994.01^36^36^3050516^"
^XWB(8994,2476,1,1,0)="This RPC returns XML containing a list of physicians in the NEW PERSON "
^XWB(8994,2476,1,2,0)="file (#200) that hold the PROVIDER Security Key and do not have a "
^XWB(8994,2476,1,3,0)="TERMINATION DATE value prior to the current date, and has a matching "
^XWB(8994,2476,1,4,0)="division from the DIV input parameter whose last name starts with the "
^XWB(8994,2476,1,5,0)="DATA input parameter."
^XWB(8994,2476,1,6,0)=" "
^XWB(8994,2476,1,7,0)="XML Mapping:"
^XWB(8994,2476,1,8,0)="count attribute =       Number of records found"
^XWB(8994,2476,1,9,0)="ProviderIEN element =   NEW PERSON file (#200) / NUMBER field (#.001)"
^XWB(8994,2476,1,10,0)="ProviderName element =  NEW PERSON file (#200) / NAME field (#.01)"
^XWB(8994,2476,1,11,0)=" "
^XWB(8994,2476,1,12,0)="XML Example:"
^XWB(8994,2476,1,13,0)="<Providers>"
^XWB(8994,2476,1,14,0)="    <Record count='5'>"
^XWB(8994,2476,1,15,0)="        <Provider>"
^XWB(8994,2476,1,16,0)="            <ProviderIEN>7650</ProviderIEN>"
^XWB(8994,2476,1,17,0)="            <ProviderName>VBECSprovider,One</ProviderName>"
^XWB(8994,2476,1,18,0)="        </Provider>"
^XWB(8994,2476,1,19,0)="        <Provider>"
^XWB(8994,2476,1,20,0)="            <ProviderIEN>53304</ProviderIEN>"
^XWB(8994,2476,1,21,0)="            <ProviderName>VBECSprovider,Two</ProviderName>"
^XWB(8994,2476,1,22,0)="        </Provider>"
^XWB(8994,2476,1,23,0)="        <Provider>"
^XWB(8994,2476,1,24,0)="            <ProviderIEN>14909</ProviderIEN>"
^XWB(8994,2476,1,25,0)="            <ProviderName>VBECSprovider,Three</ProviderName>"
^XWB(8994,2476,1,26,0)="        </Provider>"
^XWB(8994,2476,1,27,0)="        <Provider>"
^XWB(8994,2476,1,28,0)="            <ProviderIEN>8190</ProviderIEN>"
^XWB(8994,2476,1,29,0)="            <ProviderName>VBECSprovider,Four</ProviderName>"
^XWB(8994,2476,1,30,0)="        </Provider>"
^XWB(8994,2476,1,31,0)="        <Provider>"
^XWB(8994,2476,1,32,0)="            <ProviderIEN>10574</ProviderIEN>"
^XWB(8994,2476,1,33,0)="            <ProviderName>VBECSprovider,Five</ProviderName>"
^XWB(8994,2476,1,34,0)="        </Provider>"
^XWB(8994,2476,1,35,0)="    </Record>"
^XWB(8994,2476,1,36,0)="</Providers>"
^XWB(8994,2476,2,0)="^8994.02A^2^2"
^XWB(8994,2476,2,1,0)="DIV^1^8^1^1"
^XWB(8994,2476,2,1,1,0)="^8994.021^1^1^3040316^^"
^XWB(8994,2476,2,1,1,1,0)="Input DIV = DIVISION (Station Number)"
^XWB(8994,2476,2,2,0)="DATA^1^99^0^2"
^XWB(8994,2476,2,2,1,0)="^^1^1^3040316^"
^XWB(8994,2476,2,2,1,1,0)="Input DATA = Name of provider used to perform search in file 200."
^XWB(8994,2476,2,"B","DATA",2)=""
^XWB(8994,2476,2,"B","DIV",1)=""
^XWB(8994,2476,2,"PARAMSEQ",1,1)=""
^XWB(8994,2476,2,"PARAMSEQ",2,2)=""
^XWB(8994,2476,3,0)="^8994.03^2^2^3040311^^"
^XWB(8994,2476,3,1,0)="XML document with a list of users from the New Person file #200 that hold"
^XWB(8994,2476,3,2,0)="the Security Key of PROVIDER."
^XWB(8994,2477,0)="VBECS LABORATORY TEST LOOKUP^LABTEST^VBECRPCA^4^R"
^XWB(8994,2477,1,0)="^^28^28^3050216^"
^XWB(8994,2477,1,1,0)="This RPC returns XML containing a list of Laboratory tests from the "
^XWB(8994,2477,1,2,0)="LABORATORY TEST file (#60)."
^XWB(8994,2477,1,3,0)=" "
^XWB(8994,2477,1,4,0)="XML Mapping:"
^XWB(8994,2477,1,5,0)="Name element =          LABORATORY TEST file (#60) / NAME field (#.01)"
^XWB(8994,2477,1,6,0)="IEN element =           LABORATORY TEST file (#60) / NUMBER field (#.001)"
^XWB(8994,2477,1,7,0)="Specimen element =      LABORATORY TEST file (#60) / SITE/SPECIMEN "
^XWB(8994,2477,1,8,0)="                        sub-file (#60.01) / SITE/SPECIMEN field (#.01)"
^XWB(8994,2477,1,9,0)="                        pointer to TOPOGRAPHY FIELD FILE (#61)"
^XWB(8994,2477,1,10,0)=" "
^XWB(8994,2477,1,11,0)="XML Example:"
^XWB(8994,2477,1,12,0)="<LabTests>"
^XWB(8994,2477,1,13,0)="    <LabTest>"
^XWB(8994,2477,1,14,0)="        <Name>HEMATOCRIT - BODY FLUID-KC</Name>"
^XWB(8994,2477,1,15,0)="        <IEN>1125</IEN>"
^XWB(8994,2477,1,16,0)="        <Specimen>BODY FLUID,NOS</Specimen>"
^XWB(8994,2477,1,17,0)="    </LabTest>"
^XWB(8994,2477,1,18,0)="    <LabTest>"
^XWB(8994,2477,1,19,0)="        <Name>HCT i-STAT</Name>"
^XWB(8994,2477,1,20,0)="        <IEN>5742</IEN>"
^XWB(8994,2477,1,21,0)="        <Specimen>BLOOD</Specimen>"
^XWB(8994,2477,1,22,0)="    </LabTest>"
^XWB(8994,2477,1,23,0)="    <LabTest>"
^XWB(8994,2477,1,24,0)="        <Name>HCT(BLOOD GAS)</Name>"
^XWB(8994,2477,1,25,0)="        <IEN>2244</IEN>"
^XWB(8994,2477,1,26,0)="        <Specimen>ARTERIAL BLOOD</Specimen>"
^XWB(8994,2477,1,27,0)="    </LabTest>"
^XWB(8994,2477,1,28,0)="</LabTests>"
^XWB(8994,2477,2,0)="^8994.02A^1^1"
^XWB(8994,2477,2,1,0)="DATA^1^999^0^1"
^XWB(8994,2477,2,1,1,0)="^8994.021^1^1^3040315^^"
^XWB(8994,2477,2,1,1,1,0)="The DATA input parameter represents a Lab Test name used to search for potential matches in file 60."
^XWB(8994,2477,2,"B","DATA",1)=""
^XWB(8994,2477,2,"PARAMSEQ",1,1)=""
^XWB(8994,2477,3,0)="^8994.03^1^1^3040315^^"
^XWB(8994,2477,3,1,0)="XML document with a list of Laboratory Tests and associated Lab test data based on the search input parameter."
^XWB(8994,2478,0)="VBECS DIVISION LOOKUP^DIV^VBECRPCM^4^R"
^XWB(8994,2478,1,0)="^8994.01^30^30^3070910^^^^"
^XWB(8994,2478,1,1,0)="This RPC returns XML containing a list of active VAMC divisions associated"
^XWB(8994,2478,1,2,0)="with a Medical Center."
^XWB(8994,2478,1,3,0)=" "
^XWB(8994,2478,1,4,0)="XML Mapping:"
^XWB(8994,2478,1,5,0)="DivisionId element =   INSTITUTION file (#4) / STATION NUMBER field (#99)"
^XWB(8994,2478,1,6,0)="DivisionName element = INSTITUTION file (#4) / NAME field (#.01)"
^XWB(8994,2478,1,7,0)=" "
^XWB(8994,2478,1,8,0)="XML Example:"
^XWB(8994,2478,1,9,0)="<Divisions>"
^XWB(8994,2478,1,10,0)="    <Division>"
^XWB(8994,2478,1,11,0)="        <DivisionId>589</DivisionId>"
^XWB(8994,2478,1,12,0)="        <DivisionName>VA HEARTLAND - WEST, VISN 15</DivisionName>"
^XWB(8994,2478,1,13,0)="    </Division>"
^XWB(8994,2478,1,14,0)="    <Division>"
^XWB(8994,2478,1,15,0)="        <DivisionId>589A4</DivisionId>"
^XWB(8994,2478,1,16,0)="        <DivisionName>COLUMBIA, MO VAMC</DivisionName>"
^XWB(8994,2478,1,17,0)="    </Division>"
^XWB(8994,2478,1,18,0)="    <Division>"
^XWB(8994,2478,1,19,0)="        <DivisionId>589A5</DivisionId>"
^XWB(8994,2478,1,20,0)="        <DivisionName>TOPEKA, KS VAMC</DivisionName>"
^XWB(8994,2478,1,21,0)="    </Division>"
^XWB(8994,2478,1,22,0)="    <Division>"
^XWB(8994,2478,1,23,0)="        <DivisionId>589A6</DivisionId>"
^XWB(8994,2478,1,24,0)="        <DivisionName>LEAVENWORTH VAMC</DivisionName>"
^XWB(8994,2478,1,25,0)="    </Division>"
^XWB(8994,2478,1,26,0)="    <Division>"
^XWB(8994,2478,1,27,0)="        <DivisionId>589A7</DivisionId>"
^XWB(8994,2478,1,28,0)="        <DivisionName>WICHITA VAMC</DivisionName>"
^XWB(8994,2478,1,29,0)="    </Division>"
^XWB(8994,2478,1,30,0)="</Divisions>"
^XWB(8994,2478,3,0)="^8994.03^2^2^3070910^^^^"
^XWB(8994,2478,3,1,0)="XML document with a list of active divisions from the Institution file #4 "
^XWB(8994,2478,3,2,0)="based on the Medical Center Division file #40.8."
^XWB(8994,2479,0)="VBECS BLOOD BANK USER LOOKUP^BBUSER^VBECRPCM^4^R"
^XWB(8994,2479,1,0)="^8994.01^26^26^3070522^^"
^XWB(8994,2479,1,1,0)="This RPC returns XML containing a list of users from the New Person file"
^XWB(8994,2479,1,2,0)="#200 that hold the Security Keys associated with Blood Bank."
^XWB(8994,2479,1,3,0)=" "
^XWB(8994,2479,1,4,0)="XML Mapping:"
^XWB(8994,2479,1,5,0)="count attribute =        Number of records found"
^XWB(8994,2479,1,6,0)="userName attribute =     NEW PERSON file (#200) / NAME field (#.01)"
^XWB(8994,2479,1,7,0)="userDuz attribute =      NEW PERSON file (#200) / IEN field (#.001)"
^XWB(8994,2479,1,8,0)="userInitials attribute = NEW PERSON file (#200) / INITIAL field (#1)"
^XWB(8994,2479,1,9,0)="divisionCode attribute = INSTITUTION file (#4) / STATION NUMBER field "
^XWB(8994,2479,1,10,0)="(#99)"
^XWB(8994,2479,1,11,0)=" "
^XWB(8994,2479,1,12,0)="XML Example:"
^XWB(8994,2479,1,13,0)="<BloodBankUsers>"
^XWB(8994,2479,1,14,0)="    <Record count=""1"">"
^XWB(8994,2479,1,15,0)="        <BloodBankUser userName=""BLOODBANK,USER"" userDUZ=""5000"" "
^XWB(8994,2479,1,16,0)="userInitials=""BBU"">"
^XWB(8994,2479,1,17,0)="            <Divisions>"
^XWB(8994,2479,1,18,0)="                <Division divisionCode=""589"" />"
^XWB(8994,2479,1,19,0)="                <Division divisionCode=""589A4"" />"
^XWB(8994,2479,1,20,0)="                <Division divisionCode=""589A5"" />"
^XWB(8994,2479,1,21,0)="                <Division divisionCode=""589A6"" />"
^XWB(8994,2479,1,22,0)="                <Division divisionCode=""589A7"" />"
^XWB(8994,2479,1,23,0)="            </Divisions>"
^XWB(8994,2479,1,24,0)="        </BloodBankUser>"
^XWB(8994,2479,1,25,0)="    </Record>"
^XWB(8994,2479,1,26,0)="</BloodBankUsers>"
^XWB(8994,2479,3,0)="^8994.03^2^2^3070522^^^"
^XWB(8994,2479,3,1,0)="XML document containing a list of users from the New Person file that "
^XWB(8994,2479,3,2,0)="hold either the LRBLSUPER or LRBLOODBANK Security keys."
^XWB(8994,2480,0)="VBECS WORKLOAD CODES LOOKUP^WKLD^VBECRPCW^4^R"
^XWB(8994,2480,1,0)="^8994.01^30^30^3050907^^"
^XWB(8994,2480,1,1,0)="This RPC returns XML containing a list of Workload Codes from the WKLD"
^XWB(8994,2480,1,2,0)="CODE file (#64) with a WORKLOAD CODE LAB SECTION of ""Blood Bank"" to VBECS."
^XWB(8994,2480,1,3,0)=" "
^XWB(8994,2480,1,4,0)="XML Mapping:"
^XWB(8994,2480,1,5,0)="LMIP element =             WKLD CODE file (#64) / WKLD CODE field (#1)"
^XWB(8994,2480,1,6,0)="Procedure element =        WKLD CODE file (#64) / PROCEDURE field (#.01)"
^XWB(8994,2480,1,7,0)="Cost element =             WKLD CODE file (#64) / COST field (#7)"
^XWB(8994,2480,1,8,0)="WeightMultiplier element = WKLD CODE file (#64) / WKLD UNIT WEIGHT field "
^XWB(8994,2480,1,9,0)="                           (#2)"
^XWB(8994,2480,1,10,0)="CPTCode element =          WKLD CODE file (#64) / CODE sub-file (#64.018) "
^XWB(8994,2480,1,11,0)="                           / CODE field (#.01)"
^XWB(8994,2480,1,12,0)=" "
^XWB(8994,2480,1,13,0)=" "
^XWB(8994,2480,1,14,0)="XML Example:"
^XWB(8994,2480,1,15,0)="<Workload>"
^XWB(8994,2480,1,16,0)="    <Code>"
^XWB(8994,2480,1,17,0)="        <LMIP>86272.0000</LMIP>"
^XWB(8994,2480,1,18,0)="        <Procedure>Cryoprecipitate Thawing</Procedure>"
^XWB(8994,2480,1,19,0)="        <Cost>2.50</Cost>"
^XWB(8994,2480,1,20,0)="        <WeightMultiplier>3</WeightMultiplier>"
^XWB(8994,2480,1,21,0)="        <CPTCode>88399</CPTCode>"
^XWB(8994,2480,1,22,0)="    </Code>"
^XWB(8994,2480,1,23,0)="    <Code>"
^XWB(8994,2480,1,24,0)="        <LMIP>86403.0000</LMIP>"
^XWB(8994,2480,1,25,0)="        <Procedure>Decontamination of Lymphocyte</Procedure>"
^XWB(8994,2480,1,26,0)="        <Cost></Cost>"
^XWB(8994,2480,1,27,0)="        <WeightMultiplier>2</WeightMultiplier>"
^XWB(8994,2480,1,28,0)="        <CPTCode>88399</CPTCode>"
^XWB(8994,2480,1,29,0)="    </Code>"
^XWB(8994,2480,1,30,0)="</Workload>"
^XWB(8994,2480,3,0)="^8994.03^3^3^3050907^^"
^XWB(8994,2480,3,1,0)="XML document containing a list of Blood Bank WORKLOAD CODE LAB SECTION "
^XWB(8994,2480,3,2,0)="entries from the WKLD CODE file.  The values returned are WKLD CODE, "
^XWB(8994,2480,3,3,0)="PROCEDURE, COST, WKLD UNIT WEIGHT, and CPT codes. "
^XWB(8994,2481,0)="VBECS HCPCS CODES LOOKUP^HCPCS^VBECRPCH^4^R"
^XWB(8994,2481,1,0)="^8994.01^23^23^3080505^^"
^XWB(8994,2481,1,1,0)="This RPC returns XML containing a list of active HCPCS codes from the CPT"
^XWB(8994,2481,1,2,0)="file with a CPT Category of Pathology and Laboratory Services for use in"
^XWB(8994,2481,1,3,0)="VBECS."
^XWB(8994,2481,1,4,0)=" "
^XWB(8994,2481,1,5,0)="XML Mapping:"
^XWB(8994,2481,1,6,0)="Code element = CPT file (#81) / CODE field (#.01)"
^XWB(8994,2481,1,7,0)="Name element = CPT file (#81) / SHORT NAME field (#2)"
^XWB(8994,2481,1,8,0)=" "
^XWB(8994,2481,1,9,0)="XML Example:"
^XWB(8994,2481,1,10,0)="<Root>"
^XWB(8994,2481,1,11,0)="    <HCPCS>"
^XWB(8994,2481,1,12,0)="        <Code>P2028</Code>"
^XWB(8994,2481,1,13,0)="        <Name>Cephalin floculation test</Name>"
^XWB(8994,2481,1,14,0)="    </HCPCS>"
^XWB(8994,2481,1,15,0)="    <HCPCS>"
^XWB(8994,2481,1,16,0)="        <Code>P2029</Code>"
^XWB(8994,2481,1,17,0)="        <Name>Congo red blood test</Name>"
^XWB(8994,2481,1,18,0)="    </HCPCS>"
^XWB(8994,2481,1,19,0)="    <HCPCS>"
^XWB(8994,2481,1,20,0)="        <Code>P2031</Code>"
^XWB(8994,2481,1,21,0)="        <Name>Hair analysis</Name>"
^XWB(8994,2481,1,22,0)="    </HCPCS>"
^XWB(8994,2481,1,23,0)="</Root>"
^XWB(8994,2481,3,0)="^8994.03^2^2^3080505^^^"
^XWB(8994,2481,3,1,0)="XML document containing a list of HCPCS codes for the Pathology and"
^XWB(8994,2481,3,2,0)="Laboratory Services CPT CATAGORY."
^XWB(8994,2482,0)="VBECS MED PROFILE LOOKUP^RX^VBECRPCP^4^R"
^XWB(8994,2482,1,0)="^^43^43^3050516^"
^XWB(8994,2482,1,1,0)="This RPC returns XML containing a list of medications for a patient from "
^XWB(8994,2482,1,2,0)="the Pharmacy package within a given date range."
^XWB(8994,2482,1,3,0)=" "
^XWB(8994,2482,1,4,0)="The patient demographic data is provided by the VistA API DEM^VADPT in "
^XWB(8994,2482,1,5,0)="the VADM array."
^XWB(8994,2482,1,6,0)=" "
^XWB(8994,2482,1,7,0)="The medication related data is provided by the Pharmacy API OCL^PSOORRL in"
^XWB(8994,2482,1,8,0)="the ^TMP(""PS"",$J global array in the following format."
^XWB(8994,2482,1,9,0)=" "
^XWB(8994,2482,1,10,0)="^TMP(""PS"",$J,D0,0)=ORDER #_File;PKG^DRUG^INFUSION RATE^STOP DATE^REFILLS"
^XWB(8994,2482,1,11,0)="REMAINING^TOTAL DOSE^UNITS PER DOSE^PLACER #^STATUS^LAST FILLDATE^DAYS"
^XWB(8994,2482,1,12,0)="SUPPLY^QUANTITY^NOT TO BE GIVEN^PENDING RENEWAL (1 or 0)^ISSUE"
^XWB(8994,2482,1,13,0)="DATE(Outpatient) or START DATE(Inpatient)^LAST RELEASE DATE/TIME^LAST FILL"
^XWB(8994,2482,1,14,0)="DAY SUPPLY"
^XWB(8994,2482,1,15,0)=" "
^XWB(8994,2482,1,16,0)="XML Mapping:"
^XWB(8994,2482,1,17,0)="PatientName element =          VADM(1)"
^XWB(8994,2482,1,18,0)="PatientSsn element =           VADM(2)"
^XWB(8994,2482,1,19,0)="PatientDob element =           VADM(3) in HL7 format"
^XWB(8994,2482,1,20,0)="BeginningSearchDate element =  SDATE input parameter in HL7 format"
^XWB(8994,2482,1,21,0)="EndingSearchDate element =     EDATE input parameter in HL7 format"
^XWB(8994,2482,1,22,0)="OrderNumber element =          ORDER #"
^XWB(8994,2482,1,23,0)="DrugName element =             DRUG"
^XWB(8994,2482,1,24,0)="IssueStartDate element =       ISSUE DATE(Outpatient) or START "
^XWB(8994,2482,1,25,0)="                               DATE(Inpatient)"
^XWB(8994,2482,1,26,0)="Status element =               STATUS"
^XWB(8994,2482,1,27,0)="InpatientOutpatientIndicator = PKG"
^XWB(8994,2482,1,28,0)=" "
^XWB(8994,2482,1,29,0)="XML Example:"
^XWB(8994,2482,1,30,0)="<MedicationProfile>"
^XWB(8994,2482,1,31,0)="    <PatientName>VBECSpatient,One</PatientName>"
^XWB(8994,2482,1,32,0)="    <PatientSsn>666-66-6666</PatientSsn>"
^XWB(8994,2482,1,33,0)="    <PatientDob>Jan 01, 1900</PatientDob>"
^XWB(8994,2482,1,34,0)="    <BeginningSearchDate>Oct 01, 2002</BeginningSearchDate>"
^XWB(8994,2482,1,35,0)="    <EndingSearchDate>Jul 31, 2003</EndingSearchDate>"
^XWB(8994,2482,1,36,0)="    <Order>"
^XWB(8994,2482,1,37,0)="        <OrderNumber>4863015</OrderNumber>"
^XWB(8994,2482,1,38,0)="        <DrugName>ACETAMINOPHEN 500MG TAB</DrugName>"
^XWB(8994,2482,1,39,0)="        <IssueStartDate>Apr 08, 2002</IssueStartDate>"
^XWB(8994,2482,1,40,0)="        <Status>EXPIRED</Status>"
^XWB(8994,2482,1,41,0)="        <InpatientOutpatientIndicator>O</InpatientOutpatientIndicator>"
^XWB(8994,2482,1,42,0)="    </Order>"
^XWB(8994,2482,1,43,0)="</MedicationProfile>"
^XWB(8994,2482,2,0)="^8994.02A^4^3"
^XWB(8994,2482,2,1,0)="SDATE^1^30^1^2"
^XWB(8994,2482,2,1,1,0)="^^1^1^3040524^"
^XWB(8994,2482,2,1,1,1,0)="The SDATE input parameters represents the start date required by the Pharmacy API OCL^PSOORRL."
^XWB(8994,2482,2,2,0)="EDATE^1^30^1^3"
^XWB(8994,2482,2,2,1,0)="^^1^1^3040524^"
^XWB(8994,2482,2,2,1,1,0)="The EDATE input parameter represents the end date required by the Pharmacy API OCL^PSOORRL."
^XWB(8994,2482,2,4,0)="DFN^1^15^1^1"
^XWB(8994,2482,2,4,1,0)="^8994.021^1^1^3040817^^"
^XWB(8994,2482,2,4,1,1,0)="The VistA Patient file (#2) Internal Entry Number."
^XWB(8994,2482,2,"B","DFN",4)=""
^XWB(8994,2482,2,"B","EDATE",2)=""
^XWB(8994,2482,2,"B","SDATE",1)=""
^XWB(8994,2482,2,"PARAMSEQ",1,4)=""
^XWB(8994,2482,2,"PARAMSEQ",2,1)=""
^XWB(8994,2482,2,"PARAMSEQ",3,2)=""
^XWB(8994,2482,3,0)="^8994.03^1^1^3040524^^"
^XWB(8994,2482,3,1,0)="XML document with a list of medications prescribed for the patient during the specified dates in the input parameters."
^XWB(8994,2483,0)="VBECS LAB ACCESSION UID LOOKUP^ORDNUM^VBECRPCB^4^R"
^XWB(8994,2483,1,0)="^8994.01^36^36^3070910^^"
^XWB(8994,2483,1,1,0)="This RPC returns XML containing a list of Laboratory tests and "
^XWB(8994,2483,1,2,0)="associated data based on a Lab Order number. The data is used in VBECS to "
^XWB(8994,2483,1,3,0)="validate an order and associated a specimen UID with the Blood Bank "
^XWB(8994,2483,1,4,0)="request."
^XWB(8994,2483,1,5,0)=" "
^XWB(8994,2483,1,6,0)="XML Mapping:"
^XWB(8994,2483,1,7,0)="PatientName element =     PATIENT file (#2) / NAME field (#.01)"
^XWB(8994,2483,1,8,0)="VistaPatientId element =  PATIENT file (#2) / NUMBER field (#.001)"
^XWB(8994,2483,1,9,0)="LabOrderNumber element =  LAB ORDER ENTRY file (#69) / SPECIMEN sub-file "
^XWB(8994,2483,1,10,0)="                          (#69.01) / ORDER# field (#9.5)"
^XWB(8994,2483,1,11,0)="LabTestId element =       LAB ORDER ENTRY file (#69) / SPECIMEN sub-file "
^XWB(8994,2483,1,12,0)="                          (#69.01) / TEST/PROCEDURE field (#.01)"
^XWB(8994,2483,1,13,0)="LabTestName element =     LABORATORY TEST file (#60) / NAME field (#.01)"
^XWB(8994,2483,1,14,0)="SpecimenAccessionNumber = ACCESSION file (#68) / ACCESSION NUMBER "
^XWB(8994,2483,1,15,0)="                          sub-file (#68.02) / ACCESSION field (#15)"
^XWB(8994,2483,1,16,0)="SpecimenUid =             LAB ORDER ENTRY file (#69) / SPECIMEN sub-file "
^XWB(8994,2483,1,17,0)="                          (#69.01) / TEST sub-file (#69.03) / UID field"
^XWB(8994,2483,1,18,0)="                          (#16)"
^XWB(8994,2483,1,19,0)="CollectionDateTime =      ACCESSION file (#68) / ACCESSION NUMBER "
^XWB(8994,2483,1,20,0)="                          sub-file (#68.02) / DRAW TIME field (#9)"
^XWB(8994,2483,1,21,0)=" "
^XWB(8994,2483,1,22,0)="XML Example:"
^XWB(8994,2483,1,23,0)="<UIDLookup>"
^XWB(8994,2483,1,24,0)="    <LabTests>"
^XWB(8994,2483,1,25,0)="        <LabTest>"
^XWB(8994,2483,1,26,0)="            <PatientName>VBECSpatient,One</PatientName>"
^XWB(8994,2483,1,27,0)="            <VistaPatientId>308</VistaPatientId>"
^XWB(8994,2483,1,28,0)="            <LabOrderNumber>11465</LabOrderNumber>"
^XWB(8994,2483,1,29,0)="            <LabTestID>6479</LabTestID>"
^XWB(8994,2483,1,30,0)="            <LabTestName>VBECS RED BLOOD CELLS</LabTestName>"
^XWB(8994,2483,1,31,0)="            <SpecimenAccessionNumber>2942360003</SpecimenAccessionNumber>"
^XWB(8994,2483,1,32,0)="            <SpecimenUID>2942360003</SpecimenUID>"
^XWB(8994,2483,1,33,0)="            <CollectionDateTime>20040823103630-0600</CollectionDateTime>"
^XWB(8994,2483,1,34,0)="        </LabTest>"
^XWB(8994,2483,1,35,0)="    </LabTests>"
^XWB(8994,2483,1,36,0)="</UIDLookup>"
^XWB(8994,2483,2,0)="^8994.02A^2^1"
^XWB(8994,2483,2,2,0)="VBLRO^1^20^1^1"
^XWB(8994,2483,2,2,1,0)="^^2^2^3040609^"
^XWB(8994,2483,2,2,1,1,0)="Input VBLRO = The Lab Order number received in Blood Bank with an order"
^XWB(8994,2483,2,2,1,2,0)="from CPRS. "
^XWB(8994,2483,2,"B","VBLRO",2)=""
^XWB(8994,2483,2,"PARAMSEQ",1,2)=""
^XWB(8994,2483,3,0)="^8994.03^3^3^3040609^^"
^XWB(8994,2483,3,1,0)="XML document containing the patient name, DFN, accession number, lab"
^XWB(8994,2483,3,2,0)="order number, specimen UID associated with the Lab Order number received"
^XWB(8994,2483,3,3,0)="from CPRS for a VBECS order."
^XWB(8994,2484,0)="VBECS LAB TEST RESULTS LOOKUP^TSTRSLT^VBECRPCA^4^R"
^XWB(8994,2484,1,0)="^^35^35^3050216^"
^XWB(8994,2484,1,1,0)="This RPC returns XML containing a list of Laboratory test results for a "
^XWB(8994,2484,1,2,0)="patient within a given date range."
^XWB(8994,2484,1,3,0)=" "
^XWB(8994,2484,1,4,0)="The data returned is provided by the Lab API RR^LR7OR1 in the "
^XWB(8994,2484,1,5,0)="^TMP(""LRRR"" global array in the following format."
^XWB(8994,2484,1,6,0)=" "
^XWB(8994,2484,1,7,0)="^TMP(""LRRR"",$J,DFN,SUB,inverse d/t,sequence #)  = Test^result^L/N flag^"
^XWB(8994,2484,1,8,0)="units^reference range^result status^^^Nat'l Code^Name^System^Verified b "
^XWB(8994,2484,1,9,0)="y^^Therapeutic flag^Print Name^Accession^Order#"
^XWB(8994,2484,1,10,0)=" "
^XWB(8994,2484,1,11,0)="XML Mapping:"
^XWB(8994,2484,1,12,0)="VistaPatientId element =  DFN"
^XWB(8994,2484,1,13,0)="LabTestId element =       Test"
^XWB(8994,2484,1,14,0)="TestPrintName element =   Print Name"
^XWB(8994,2484,1,15,0)="TestResult element =      result"
^XWB(8994,2484,1,16,0)="TestDate element =        inverse d/t (Converted to HL7 format)"
^XWB(8994,2484,1,17,0)=" "
^XWB(8994,2484,1,18,0)=" "
^XWB(8994,2484,1,19,0)="XML Example:"
^XWB(8994,2484,1,20,0)="<LabTests>"
^XWB(8994,2484,1,21,0)="    <LabTest>"
^XWB(8994,2484,1,22,0)="        <VistaPatientId>378793</VistaPatientId>"
^XWB(8994,2484,1,23,0)="        <LabTestId>3</LabTestId>"
^XWB(8994,2484,1,24,0)="        <TestPrintName>HGB</TestPrintName>"
^XWB(8994,2484,1,25,0)="        <TestResult>14.1</TestResult>"
^XWB(8994,2484,1,26,0)="        <TestDate>20010910122446-0600</TestDate>"
^XWB(8994,2484,1,27,0)="    </LabTest>"
^XWB(8994,2484,1,28,0)="    <LabTest>"
^XWB(8994,2484,1,29,0)="         <VistaPatientId>378793</VistaPatientId>"
^XWB(8994,2484,1,30,0)="         <LabTestId>3</LabTestId>"
^XWB(8994,2484,1,31,0)="         <TestPrintName>HGB</TestPrintName>"
^XWB(8994,2484,1,32,0)="         <TestResult>14.4</TestResult>"
^XWB(8994,2484,1,33,0)="         <TestDate>20010430115535-0600</TestDate>"
^XWB(8994,2484,1,34,0)="    </LabTest>"
^XWB(8994,2484,1,35,0)="</LabTests>"
^XWB(8994,2484,2,0)="^8994.02A^5^5"
^XWB(8994,2484,2,1,0)="SDATE^1^^0^1"
^XWB(8994,2484,2,1,1,0)="^^2^2^3040824^"
^XWB(8994,2484,2,1,1,1,0)="The SDATE input parameter represents the start date used to search for "
^XWB(8994,2484,2,1,1,2,0)="Laboratory test results in the Lab API RR^LR7OR1."
^XWB(8994,2484,2,2,0)="EDATE^1^30^0^2"
^XWB(8994,2484,2,2,1,0)="^^2^2^3040824^"
^XWB(8994,2484,2,2,1,1,0)="The EDATE input parameter represents the end date to search for "
^XWB(8994,2484,2,2,1,2,0)="Laboratory test results in the Lab API RR^LR7OR1."
^XWB(8994,2484,2,3,0)="DIV^1^12^0^3"
^XWB(8994,2484,2,3,1,0)="^^3^3^3040824^"
^XWB(8994,2484,2,3,1,1,0)="The DIV input parameter representd the Division (Station Number) where "
^XWB(8994,2484,2,3,1,2,0)="the results were obtained."
^XWB(8994,2484,2,3,1,3,0)="NOTE:  This parameter is for future use."
^XWB(8994,2484,2,4,0)="TESTS^1^999^0^4"
^XWB(8994,2484,2,4,1,0)="^^3^3^3040824^"
^XWB(8994,2484,2,4,1,1,0)="An array of Laboratory Test IENs used to search for results."
^XWB(8994,2484,2,4,1,2,0)="  TESTS(1)=""3536"""
^XWB(8994,2484,2,4,1,3,0)="  TESTS(2)=""4090"""
^XWB(8994,2484,2,5,0)="PATS^1^999^1^5"
^XWB(8994,2484,2,5,1,0)="^8994.021^3^3^3050215^^"
^XWB(8994,2484,2,5,1,1,0)="An array of Patient IENs used to search for Lab test results."
^XWB(8994,2484,2,5,1,2,0)="  PATS(1)=""495943"""
^XWB(8994,2484,2,5,1,3,0)="  PATS(2)=""39282"""
^XWB(8994,2484,2,"B","DIV",3)=""
^XWB(8994,2484,2,"B","EDATE",2)=""
^XWB(8994,2484,2,"B","PATS",5)=""
^XWB(8994,2484,2,"B","SDATE",1)=""
^XWB(8994,2484,2,"B","TESTS",4)=""
^XWB(8994,2484,2,"PARAMSEQ",1,1)=""
^XWB(8994,2484,2,"PARAMSEQ",2,2)=""
^XWB(8994,2484,2,"PARAMSEQ",3,3)=""
^XWB(8994,2484,2,"PARAMSEQ",4,4)=""
^XWB(8994,2484,2,"PARAMSEQ",5,5)=""
^XWB(8994,2484,3,0)="^8994.03^2^2^3050215^^"
^XWB(8994,2484,3,1,0)="XML document with a list of patient related laboratory test results "
^XWB(8994,2484,3,2,0)="returned from the Lab API RR^LR7OR1."
^XWB(8994,2485,0)="VBECS ACCESSION AREA LOOKUP^ACNAREA^VBECRPCM^4^R"
^XWB(8994,2485,1,0)="^8994.01^33^33^3050823^^"
^XWB(8994,2485,1,1,0)="This RPC returns XML containing a list of Lab Blood Bank Accession Areas"
^XWB(8994,2485,1,2,0)="from the ACCESSION file (#68) where the LR SUBSCRIPT field .02 is set to"
^XWB(8994,2485,1,3,0)="BLOOD BANK for use in the gov.va.med.vbecs rehosted Blood Bank"
^XWB(8994,2485,1,4,0)="application."
^XWB(8994,2485,1,5,0)=" "
^XWB(8994,2485,1,6,0)="XML Mapping:"
^XWB(8994,2485,1,7,0)="AccessionAreaName element = ACCESSION file (#68) / ACCESSION AREA field "
^XWB(8994,2485,1,8,0)="(#.01)"
^XWB(8994,2485,1,9,0)="AccessionAreaId element =   ACCESSION file (#68) / IEN field (#.001)"
^XWB(8994,2485,1,10,0)=" "
^XWB(8994,2485,1,11,0)="XML Example:"
^XWB(8994,2485,1,12,0)="<AccessionAreas>"
^XWB(8994,2485,1,13,0)="    <AccessionArea>"
^XWB(8994,2485,1,14,0)="        <AccessionAreaName>BLOOD BANK</AccessionAreaName>"
^XWB(8994,2485,1,15,0)="        <AccessionAreaId>29</AccessionAreaId>"
^XWB(8994,2485,1,16,0)="    </AccessionArea>"
^XWB(8994,2485,1,17,0)="    <AccessionArea>"
^XWB(8994,2485,1,18,0)="        <AccessionAreaName>COBLOOD BANK</AccessionAreaName>"
^XWB(8994,2485,1,19,0)="        <AccessionAreaId>60</AccessionAreaId>"
^XWB(8994,2485,1,20,0)="    </AccessionArea>"
^XWB(8994,2485,1,21,0)="    <AccessionArea>"
^XWB(8994,2485,1,22,0)="        <AccessionAreaName>LEBLOOD BANK</AccessionAreaName>"
^XWB(8994,2485,1,23,0)="        <AccessionAreaId>87</AccessionAreaId>"
^XWB(8994,2485,1,24,0)="    </AccessionArea>"
^XWB(8994,2485,1,25,0)="    <AccessionArea>"
^XWB(8994,2485,1,26,0)="        <AccessionAreaName>TOBLOOD BANK</AccessionAreaName>"
^XWB(8994,2485,1,27,0)="        <AccessionAreaId>91</AccessionAreaId>"
^XWB(8994,2485,1,28,0)="    </AccessionArea>"
^XWB(8994,2485,1,29,0)="    <AccessionArea>"
^XWB(8994,2485,1,30,0)="        <AccessionAreaName>WIBLOOD BANK</AccessionAreaName>"
^XWB(8994,2485,1,31,0)="        <AccessionAreaId>146</AccessionAreaId>"
^XWB(8994,2485,1,32,0)="    </AccessionArea>"
^XWB(8994,2485,1,33,0)="</AccessionAreas>"
^XWB(8994,2485,3,0)="^8994.03^2^2^3050823^^^"
^XWB(8994,2485,3,1,0)="XML document containing a list of Blood Bank Accession Areas from the "
^XWB(8994,2485,3,2,0)="ACCESSION file."
^XWB(8994,2486,0)="VBECS LAB ORDER LOOKUP BY UID^ORDER^VBECRPCB^4^R"
^XWB(8994,2486,1,0)="^8994.01^36^36^3050516^"
^XWB(8994,2486,1,1,0)=" "
^XWB(8994,2486,1,2,0)="This RPC returns XML containing a list of laboratory tests and associated "
^XWB(8994,2486,1,3,0)="data based on a Specimen UID. The data is used in VBECS to identify an "
^XWB(8994,2486,1,4,0)="existing VBECS order based on the Lab Order number provided by CPRS."
^XWB(8994,2486,1,5,0)=" "
^XWB(8994,2486,1,6,0)=" XML Mapping:"
^XWB(8994,2486,1,7,0)=" PatientName element =     PATIENT file (#2) / NAME field (#.01)"
^XWB(8994,2486,1,8,0)=" VistaPatientId element =  PATIENT file (#2) / NUMBER field (#.001)"
^XWB(8994,2486,1,9,0)=" LabOrderNumber element =  LAB ORDER ENTRY file (#69) / SPECIMEN sub-file"
^XWB(8994,2486,1,10,0)="                           (#69.01) / ORDER# field (#9.5)"
^XWB(8994,2486,1,11,0)=" LabTestId element =       LAB ORDER ENTRY file (#69) / SPECIMEN sub-file"
^XWB(8994,2486,1,12,0)="                           (#69.01) / TEST/PROCEDURE field (#.01)"
^XWB(8994,2486,1,13,0)=" LabTestName element =     LABORATORY TEST file (#60) / NAME field (#.01)"
^XWB(8994,2486,1,14,0)=" SpecimenAccessionNumber = ACCESSION file (#68) / ACCESSION NUMBER"
^XWB(8994,2486,1,15,0)="                           sub-file (#68.02) / ACCESSION field (#15)"
^XWB(8994,2486,1,16,0)=" SpecimenUid =             LAB ORDER ENTRY file (#69) / SPECIMEN sub-file"
^XWB(8994,2486,1,17,0)="                           (#69.01) / TEST sub-file (#69.03) / UID field"
^XWB(8994,2486,1,18,0)="                           (#16)"
^XWB(8994,2486,1,19,0)=" CollectionDateTime =      ACCESSION file (#68) / ACCESSION NUMBER"
^XWB(8994,2486,1,20,0)="                           sub-file (#68.02) / DRAW TIME field (#9)"
^XWB(8994,2486,1,21,0)=" "
^XWB(8994,2486,1,22,0)=" XML Example:"
^XWB(8994,2486,1,23,0)=" <UIDLookup>"
^XWB(8994,2486,1,24,0)="     <PatientName>VBECSpatient,One</PatientName>"
^XWB(8994,2486,1,25,0)="     <VistaPatientId>1000</VistaPatientId>"
^XWB(8994,2486,1,26,0)="     <SpecimenAccessionNumber>BB0401-01</SpecimenAccessionNumber>"
^XWB(8994,2486,1,27,0)="     <LabOrderNumber>25000</LabOrderNumber>"
^XWB(8994,2486,1,28,0)="     <SpecimenUID>29500000000</SpecimenUID>"
^XWB(8994,2486,1,29,0)="     <CollectionDateTime>304010800</CollectionDateTime>"
^XWB(8994,2486,1,30,0)="     <LabTests>"
^XWB(8994,2486,1,31,0)="         <LabTest>"
^XWB(8994,2486,1,32,0)="             <LabTestID>2400</LabTestID>"
^XWB(8994,2486,1,33,0)="             <LabTestName>VBECS ANTIBODY SCREEN</LabTestName>"
^XWB(8994,2486,1,34,0)="         </LabTest>"
^XWB(8994,2486,1,35,0)="     </LabTests>"
^XWB(8994,2486,1,36,0)=" </UIDLookup>"
^XWB(8994,2486,2,0)="^8994.02A^1^1"
^XWB(8994,2486,2,1,0)="VBUID^1^20^1^1"
^XWB(8994,2486,2,1,1,0)="^^2^2^3050225^"
^XWB(8994,2486,2,1,1,1,0)="Input VBUID = The specimen UID received in Blood Bank associated with a"
^XWB(8994,2486,2,1,1,2,0)="Lab Testaused to identify the Lab Order."
^XWB(8994,2486,2,"B","VBUID",1)=""
^XWB(8994,2486,2,"PARAMSEQ",1,1)=""
^XWB(8994,2486,3,0)="^^2^2^3050225^"
^XWB(8994,2486,3,1,0)="XML document containing the patient name, DFN, accession number, lab"
^XWB(8994,2486,3,2,0)="order number and lab tests associated with the specimen UID."
^XWB(8994,2487,0)="VBECS DSS EXTRACT^EN^VBECDSS^4^R"
^XWB(8994,2487,1,0)="^8994.01^4^4^3071029^^^^"
^XWB(8994,2487,1,1,0)="This RPC inserts or updates post transfusion related data in the VBECS DSS"
^XWB(8994,2487,1,2,0)="EXTRACT file (#6002.03). The data is passed into the VBECDSS routine "
^XWB(8994,2487,1,3,0)="through the input parameters and a success indicator is returned to the "
^XWB(8994,2487,1,4,0)="Blood Bank medical device."
^XWB(8994,2487,2,0)="^8994.02A^2^1"
^XWB(8994,2487,2,2,0)="PARAMS^1^999^1^1"
^XWB(8994,2487,2,2,1,0)="^^26^26^3071029^"
^XWB(8994,2487,2,2,1,1,0)="PARAMS(""TRANSACTION ID"") = Unique record identifier"
^XWB(8994,2487,2,2,1,2,0)="PARAMS(""DFN"") = Patient identifier"
^XWB(8994,2487,2,2,1,3,0)="PARAMS(""ORDERING LOCATION"") = Ordering Institution Identifier"
^XWB(8994,2487,2,2,1,4,0)="PARAMS(""TRANSFUSION LOCATION"") = Tranfusing Institution identifier"
^XWB(8994,2487,2,2,1,5,0)="PARAMS(""PHYSICIAN"") = Provider requesting blood product for transfusion"
^XWB(8994,2487,2,2,1,6,0)="PARAMS(""ORDERING PROVIDER"") = Provider who ordered Type and Crossmatch"
^XWB(8994,2487,2,2,1,7,0)="PARAMS(""PRODUCT NAME"") = Short blood product name"
^XWB(8994,2487,2,2,1,8,0)="PARAMS(""COMPONENT ABBREVIATION"") = Abbreviation of blood component"
^XWB(8994,2487,2,2,1,9,0)="PARAMS(""NUMBER OF UNITS"") = Number of pooled units transfused"
^XWB(8994,2487,2,2,1,10,0)="PARAMS(""TRANSFUSION DATE"") = Date/time of transfusion"
^XWB(8994,2487,2,2,1,11,0)="PARAMS(""VOLUME"") = Total volume of units transfused"
^XWB(8994,2487,2,2,1,12,0)="PARAMS(""REACTION TYPE"") = Type of reaction indicated"
^XWB(8994,2487,2,2,1,13,0)="PARAMS(""UNIT MODIFICATION"") = String of codes representing modifications "
^XWB(8994,2487,2,2,1,14,0)="   done on units transfused. String cannot exceed 6 character. "
^XWB(8994,2487,2,2,1,15,0)="   D = Deglycerolize"
^XWB(8994,2487,2,2,1,16,0)="   F = Freeze"
^XWB(8994,2487,2,2,1,17,0)="   I = Irradiate"
^XWB(8994,2487,2,2,1,18,0)="   L = Leukoreduce"
^XWB(8994,2487,2,2,1,19,0)="   P = Pool"
^XWB(8994,2487,2,2,1,20,0)="   R = Rejuvenate"
^XWB(8994,2487,2,2,1,21,0)="   S = Split/Divide"
^XWB(8994,2487,2,2,1,22,0)="   T = Thaw"
^XWB(8994,2487,2,2,1,23,0)="   U = Thaw/Pool Cryo"
^XWB(8994,2487,2,2,1,24,0)="   V = Volume Reduce"
^XWB(8994,2487,2,2,1,25,0)="   W = Wash"
^XWB(8994,2487,2,2,1,26,0)="PARAMS(""REACTION"") = Yes or No value if a reaction was indicated."
^XWB(8994,2487,2,"B","PARAMS",2)=""
^XWB(8994,2487,2,"PARAMSEQ",1,2)=""
^XWB(8994,2487,3,0)="^8994.03^9^9^3071029^^^^"
^XWB(8994,2487,3,1,0)="This RPC returns and XML document containing a SuccessIndicator element "
^XWB(8994,2487,3,2,0)="represented by either a 1 for a successful insert or update or a 0 for an "
^XWB(8994,2487,3,3,0)="unsuccessful insert or update in the VBECS DSS EXTRACT file (#6002.03)."
^XWB(8994,2487,3,4,0)=" "
^XWB(8994,2487,3,5,0)="Example of successful transaction:"
^XWB(8994,2487,3,6,0)="<ReturnValue><SuccessIndicator>1</SuccessIndicator></ReturnValue>"
^XWB(8994,2487,3,7,0)=" "
^XWB(8994,2487,3,8,0)="Example of unsuccessful transaction:"
^XWB(8994,2487,3,9,0)="<ReturnValue><SuccessIndicator>0</SuccessIndicator></ReturnValue>"
^XWB(8994,2488,0)="ROR LIST REGISTRY DRUGS^RORGEN^RORRP017^4^R^0^^1^1"
^XWB(8994,2488,1,0)="^8994.01^2^2^3090407^^^^"
^XWB(8994,2488,1,1,0)="The ROR LIST REGISTRY DRUGS RPC returns a list of drugs from file 799.5"
^XWB(8994,2488,1,2,0)="based on input of a beginning NAME value"
^XWB(8994,2488,2,0)="^8994.02A^4^4"
^XWB(8994,2488,2,1,0)="PART^1^30^1^1"
^XWB(8994,2488,2,1,1,0)="^8994.021^1^1^3090407^^"
^XWB(8994,2488,2,1,1,1,0)="The partial match restriction"
^XWB(8994,2488,2,2,0)="FLAGS^1^1^1^2"
^XWB(8994,2488,2,2,1,0)="^8994.021^1^1^3090407^^^"
^XWB(8994,2488,2,2,1,1,0)="1 equals HEPC Registry 2 equals HIV Registry"
^XWB(8994,2488,2,3,0)="NUMBER^1^10^0^4"
^XWB(8994,2488,2,3,1,0)="^8994.021^1^1^3090407^^"
^XWB(8994,2488,2,3,1,1,0)="DEPRECATED"
^XWB(8994,2488,2,4,0)="FROM^1^10^0^3"
^XWB(8994,2488,2,4,1,0)="^8994.021^1^1^3090407^^^^"
^XWB(8994,2488,2,4,1,1,0)="DEPRECATED"
