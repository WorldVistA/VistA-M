^XWB(8994,923,3,1,0)="Returns an array of patient eligibilities as follows:-"
^XWB(8994,923,3,2,0)="  1. Primary/secondary Elig flag (Flag 1-primary, 0-secondary)"
^XWB(8994,923,3,3,0)="  2. Eligibility ien"
^XWB(8994,923,3,4,0)="  3. Eligibility description"
^XWB(8994,924,0)="EC GETPATCLASTAT^PATCLAST^ECUERPC1^1^R^^^1^"
^XWB(8994,924,1,0)="^^5^5^3180305^"
^XWB(8994,924,1,1,0)="Returns a patient's in/out status and classifications. "
^XWB(8994,924,1,2,0)=" "
^XWB(8994,924,1,3,0)="Classifications are: Agent Orange, Ionizing Radiation, SC Condition,"
^XWB(8994,924,1,4,0)="Environmental Contaminants, Military Sexual Trauma, Head/Neck Cancer,"
^XWB(8994,924,1,5,0)="Combat Veteran, and Project 112/SHAD."
^XWB(8994,924,2,0)="^8994.02A^1^1"
^XWB(8994,924,2,1,0)="ECARY^1^^1"
^XWB(8994,924,2,1,1,0)="^8994.021^4^4^3180305^^"
^XWB(8994,924,2,1,1,1,0)="Input variable ECARY contains the following values separated by up-arrow."
^XWB(8994,924,2,1,1,2,0)="  1. ECDFN - Patient IEN (#2)"
^XWB(8994,924,2,1,1,3,0)="  2. ECD   - DSS Unit IEN (#724)"
^XWB(8994,924,2,1,1,4,0)="  3. ECDT  - Procedure date and time (fileman format)"
^XWB(8994,924,2,"B","ECARY",1)=""
^XWB(8994,924,3,0)="^^20^20^3180305^"
^XWB(8994,924,3,1,0)="Returns a single line with values for a patient's status and"
^XWB(8994,924,3,2,0)="classifications."
^XWB(8994,924,3,3,0)=" "
^XWB(8994,924,3,4,0)="Data is delimited by (^) and '~'. Values after the '~' refer to those "
^XWB(8994,924,3,5,0)="classifications that must be asked for when the answer to the service "
^XWB(8994,924,3,6,0)="connected classification is no."
^XWB(8994,924,3,7,0)=" "
^XWB(8994,924,3,8,0)="Pieces delimited by '^' are:"
^XWB(8994,924,3,9,0)=" "
^XWB(8994,924,3,10,0)="  1.   Patient Status: I for inpatient or O for outpatient"
^XWB(8994,924,3,11,0)="  2-9. Classification: 2- Agent Orange, 3- Ionizing Radiation"
^XWB(8994,924,3,12,0)="                       4- SC Condition, 5- Environmental Contaminants"
^XWB(8994,924,3,13,0)="                       6- Military Sexual Trauma"
^XWB(8994,924,3,14,0)="                       7- Head/Neck Cancer"
^XWB(8994,924,3,15,0)="                       8- Combat Veteran"
^XWB(8994,924,3,16,0)="                       9- Project 112/SHAD"
^XWB(8994,924,3,17,0)=" "
^XWB(8994,924,3,18,0)="Data delimited by '~' follows those of '^'. Pieces as follows:"
^XWB(8994,924,3,19,0)="  1.   Agent Orange    2. Ionizing Radiation"
^XWB(8994,924,3,20,0)="  3.   Environmental Contaminants"
^XWB(8994,925,0)="EC GETENCDXS^ENCDXS^ECUERPC1^4^R^^^1"
^XWB(8994,925,1,0)="^^2^2^3180305^"
