^XWB(8994,4456,3,36,0)=" "
^XWB(8994,4456,3,37,0)="6^PRESBYTERIAN"
^XWB(8994,4456,3,38,0)="2^MARRIED"
^XWB(8994,4456,3,39,0)=1
^XWB(8994,4456,3,40,0)="2^NOT HISPANIC OR LATINO"
