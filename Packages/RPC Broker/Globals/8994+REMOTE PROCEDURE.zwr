^XWB(8994,2287,0)="YTQ QUESTALL^QUESTALL^YTQAPI3^4^S^^^1^^^1"
^XWB(8994,2287,1,0)="^8994.01^26^26^3040114^"
^XWB(8994,2287,1,1,0)="Retuns Item text, Intro, Choicetypes and Display information for all "
