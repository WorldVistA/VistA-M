^XWB(8994,4345,3,13,0)="        file number ^ IEN ^ field number ^ ""I"" ^ data (internal format)"
^XWB(8994,4346,0)="DSSO TRANS W/CALC FLAG^CALCFLAG^DSSOTL^4^^^^1"
^XWB(8994,4346,1,0)="^8994.01^4^4^3150731^^^"
^XWB(8994,4346,1,1,0)="For an appliance transaction with Type of Transaction ""Initial"" and the "
^XWB(8994,4346,1,2,0)="Calculation Flag set on the HCPCS, this RPC will return the associated"
^XWB(8994,4346,1,3,0)="appliances that are included in the summary transaction that appears on "
^XWB(8994,4346,1,4,0)="the 2319 Appliance Transaction list."
^XWB(8994,4346,2,0)="^8994.02A^2^2"
^XWB(8994,4346,2,1,0)="DSSO660^1^15^1^1"
^XWB(8994,4346,2,1,1,0)="^^3^3^3150731^"
^XWB(8994,4346,2,1,1,1,0)="Record of Pros Appliance/Repair (file 660) IEN for a record with "
^XWB(8994,4346,2,1,1,2,0)="Type of Transaction = ""I"" (Initial) and with the Calculation Flag "
^XWB(8994,4346,2,1,1,3,0)="set for the associated HCPCS"
