^XWB(8994,3365,0)="VPS ENHANCED GET PATIENT DEMO^GETDATA3^VPSRPC1^2^P^0^^1^1^^1"
^XWB(8994,3365,1,0)="^8994.01^4^4^3151020^^^^"
^XWB(8994,3365,1,1,0)="This RPC is called  by the Vetlink Kiosk (point of service) system.  "
^XWB(8994,3365,1,2,0)="Given Patient SSN or DFN or ICN or VIC/CAC, this RPC returns the"
^XWB(8994,3365,1,3,0)="patient demographics,insurance,and up-coming appointments, etc"
^XWB(8994,3365,1,4,0)="for selected categories"
^XWB(8994,3365,2,0)="^8994.02A^3^3"
^XWB(8994,3365,2,1,0)="VPSNUM^1^25^1^1"
^XWB(8994,3365,2,1,1,0)="^^1^1^3140821^"
^XWB(8994,3365,2,1,1,1,0)="Patient ID such as the patient SSN OR DFN OR ICN OR VIC/CAC"
^XWB(8994,3365,2,2,0)="VPSTYP^1^7^1^2"
^XWB(8994,3365,2,2,1,0)="^^1^1^3140821^"
^XWB(8994,3365,2,2,1,1,0)="Patient ID TYPE such as SSN or DFN OR ICN OR VIC/CAC"
^XWB(8994,3365,2,3,0)="VPSCAT^2^20^1^3"
^XWB(8994,3365,2,3,1,0)="^^20^20^3151020^"
^XWB(8994,3365,2,3,1,1,0)="Input Format:  VPSCAT(SEQ#)=CATEGORY;FROMDATE:THROUGH DATE"
^XWB(8994,3365,2,3,1,2,0)="Example input parameter : "
^XWB(8994,3365,2,3,1,3,0)="   VPSCAT(1)=1;3140101:3141231 <- returns Appointments start from 1/1/2014 through 12/31/2014"
^XWB(8994,3365,2,3,1,4,0)="   VPSCAT(2)=2;3140601:3140630 <- returns Lab Orders start from 6/1/2014 through 6/30/2014"
^XWB(8994,3365,2,3,1,5,0)="   VPSCAT(3)=3                 <- returns all consults"
^XWB(8994,3365,2,3,1,6,0)="   VPSCAT(4)=6                 <- returns Patient Demographics"
^XWB(8994,3365,2,3,1,7,0)=" "
^XWB(8994,3365,2,3,1,8,0)="Valid Categories:"
^XWB(8994,3365,2,3,1,9,0)="   1 - Appointment (With Date Range option)"
^XWB(8994,3365,2,3,1,10,0)="   2 - Lab Orders (With Date Range option)"
^XWB(8994,3365,2,3,1,11,0)="   3 - Consults (With Date Range option)"
^XWB(8994,3365,2,3,1,12,0)="   4 - Radiology (With Date Range option)"
^XWB(8994,3365,2,3,1,13,0)="   5 - Problem"
^XWB(8994,3365,2,3,1,14,0)="   6 - Patient demographics"
^XWB(8994,3365,2,3,1,15,0)="     - Patient Current Inpatient Status"
^XWB(8994,3365,2,3,1,16,0)="     - Patient Ward Location"
^XWB(8994,3365,2,3,1,17,0)="     - Patient Bed Assignment"
^XWB(8994,3365,2,3,1,18,0)="     - Facility Directory Preference"
^XWB(8994,3365,2,3,1,19,0)="   7 - Patient Additional patient demographic data"
^XWB(8994,3365,2,3,1,20,0)="   8 - Patient Clinical (Health Factor)"
^XWB(8994,3365,2,"B","VPSCAT",3)=""
^XWB(8994,3365,2,"B","VPSNUM",1)=""
^XWB(8994,3365,2,"B","VPSTYP",2)=""
