^XWB(8994,4412,2,1,1,21,0)="        Piece 6: Capturing package (Package prefix (^DD(9.4,1))"
^XWB(8994,4412,2,1,1,22,0)="        Piece 7: Capturing application"
^XWB(8994,4412,2,1,1,23,0)="        Piece 8: Edited Note IEN (Only if contains previous pasted text."
^XWB(8994,4412,2,1,1,24,0)="                    Send -1 otherwise.)"
