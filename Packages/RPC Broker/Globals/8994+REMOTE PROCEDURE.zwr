^XWB(8994,1881,1,6,0)=" | Development Office of the Department of Veterans Affairs,     |"
^XWB(8994,1881,1,7,0)=" | telephone (301) 734-0100.                                     |"
^XWB(8994,1881,1,8,0)=" |                                                               |"
