^XWB(8994,3841,1,3,0)="Returns the NOREC number of records based on both the XREF ""B"" (name"
^XWB(8994,3841,1,4,0)="of manufacturer) and XREF ""C"" (synonym of manufacturer)"
^XWB(8994,3841,1,5,0)="Will search backwards or forwards depending on setting of MOVE"
^XWB(8994,3841,1,6,0)="variable."
^XWB(8994,3841,2,0)="^8994.02A^4^4"
^XWB(8994,3841,2,1,0)="MOVE^1^2^0^1"
^XWB(8994,3841,2,1,1,0)="^8994.021^4^4^3120604^^"
