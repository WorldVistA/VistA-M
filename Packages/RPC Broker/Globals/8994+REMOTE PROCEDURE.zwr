^XWB(8994,4932,3,24,0)="  },"
^XWB(8994,4932,3,25,0)=" ..."
^XWB(8994,4932,3,26,0)=" ]"
^XWB(8994,4932,3,27,0)="}"
^XWB(8994,4933,0)="DVBA CAPRI UPDATE DBQ TRANSTAT^STATUS^DVBCTXML^1^R^^^^^^1"
^XWB(8994,4933,1,0)="^^2^2^3251027^"
^XWB(8994,4933,1,1,0)="This rpc will update the individual DBQ transmission status in the CAPRI "
^XWB(8994,4933,1,2,0)="TEMPLATES FILE (396.17)"
^XWB(8994,4933,2,0)="^8994.02A^5^5"
^XWB(8994,4933,2,1,0)="DVBIEN^1^^1^1"
^XWB(8994,4933,2,1,1,0)="^^1^1^3251027^"
^XWB(8994,4933,2,1,1,1,0)="Worksheet IEN"
^XWB(8994,4933,2,2,0)="DVBCT^1^^1^2"
^XWB(8994,4933,2,2,1,0)="^^2^2^3251027^"
^XWB(8994,4933,2,2,1,1,0)="The XML IEN: the sequence number of saved XMLs or 'X' for initial "
^XWB(8994,4933,2,2,1,2,0)="Transmission"
^XWB(8994,4933,2,3,0)="DVBNAME^1^^0^3"
^XWB(8994,4933,2,3,1,0)="^^1^1^3251027^"
^XWB(8994,4933,2,3,1,1,0)="Name of DBQ, is required for initial Transmission"
