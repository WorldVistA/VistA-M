^XWB(8994,4629,2,"B","CLIN STOPCODE",1)=""
^XWB(8994,4629,2,"PARAMSEQ",1,1)=""
^XWB(8994,4629,3,0)="^8994.03^2^2^3250207^^^^"
^XWB(8994,4629,3,1,0)="RETURN CLINIC STOP CODE NAME, IEN, INACTIVE DATE, COST DISTRIBUTION "
^XWB(8994,4629,3,2,0)="CENTER, RESTRICTION TYPE AND RESTRICTION DATE FOR THE GIVEN STOP CODE"
^XWB(8994,4630,0)="SDES GET PATCH NUMBER^GETPATCHNUM^SDES^2^R^^^0^^^1"
^XWB(8994,4630,1,0)="^^4^4^3250207^"
^XWB(8994,4630,1,1,0)="Returns the last patch number that was installed on the system and the "
^XWB(8994,4630,1,2,0)="date it was installed."
^XWB(8994,4630,1,3,0)=" "
^XWB(8994,4630,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,4630,3,0)="^8994.03^2^2^3250207^^^^"
^XWB(8994,4630,3,1,0)="Return contains the latest Scheduling patch number installed on the "
^XWB(8994,4630,3,2,0)="system."
^XWB(8994,4631,0)="SDES GET USER PROFILE BY DUZ^GETUSRDTLDUZ^SDESGETUD^2^R^^^^^^1"
^XWB(8994,4631,1,0)="^^3^3^3250207^"
^XWB(8994,4631,1,1,0)="RPC to get User Profile by DUZ."
^XWB(8994,4631,1,2,0)=" "
^XWB(8994,4631,1,3,0)="Can only be invoked by Acheron"
^XWB(8994,4631,2,0)="^8994.02A^2^2"
^XWB(8994,4631,2,1,0)="USER IEN^1^30^1^1"
^XWB(8994,4631,2,1,1,0)="^^1^1^3240826^"
^XWB(8994,4631,2,1,1,1,0)="USER IEN FROM NEW PERSON FILE #200"
^XWB(8994,4631,2,2,0)="EASTRCKNGNMBR^1^30^0^2"
^XWB(8994,4631,2,2,1,0)="^8994.021^3^3^3250207^^^^"
^XWB(8994,4631,2,2,1,1,0)="The EAS number is the Enterprise Appointment Scheduling Tracking Number "
^XWB(8994,4631,2,2,1,2,0)="associated to an appointment. The EAS system will pass us the EAS number "
^XWB(8994,4631,2,2,1,3,0)="when they call our RPCs."
