^XWB(8994,4997,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,4997,2,1,1,0)="^^10^10^3240102^"
^XWB(8994,4997,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,4997,2,1,1,2,0)="             Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,4997,2,1,1,3,0)="  SDCONTEXT(""PATIENT DFN"") = The DFN/IEN of the target patient from the"
^XWB(8994,4997,2,1,1,4,0)="             calling application."
^XWB(8994,4997,2,1,1,5,0)="  SDCONTEXT(""PATIENT ICN"") = The ICN of the target patient from the"
^XWB(8994,4997,2,1,1,6,0)="             calling application."
^XWB(8994,4997,2,1,1,7,0)="  SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action in the"
^XWB(8994,4997,2,1,1,8,0)="             calling application."
^XWB(8994,4997,2,1,1,9,0)="  SDCONTEXT(""USER SECID"") = The SECID of the user taking action in"
^XWB(8994,4997,2,1,1,10,0)="             the calling application."
^XWB(8994,4997,2,2,0)="SDINPUT^2^32000^1^2"
^XWB(8994,4997,2,2,1,0)="^8994.021^11^11^3250214^^^"
^XWB(8994,4997,2,2,1,1,0)="SDINPUT(""STATUS"")         =STATUS(Required)"
^XWB(8994,4997,2,2,1,2,0)="    Status to be set in file #409.842 :"
