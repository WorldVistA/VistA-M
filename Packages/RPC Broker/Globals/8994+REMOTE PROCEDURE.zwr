^XWB(8994,5040,2,0)="^8994.02A^2^2"
^XWB(8994,5040,2,1,0)="SDCONTEXT^2^^1^1"
^XWB(8994,5040,2,1,1,0)="^^10^10^3240712^"
^XWB(8994,5040,2,1,1,1,0)="  SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,5040,2,1,1,2,0)="                            Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
