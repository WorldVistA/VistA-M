^XWB(8994,3595,2,5,0)="MGIENS^1^999^0^5"
^XWB(8994,3595,2,5,1,0)="^^7^7^3210408^"
^XWB(8994,3595,2,5,1,1,0)="List of IENs separated by pipe | to be sorted to the top of the return"
