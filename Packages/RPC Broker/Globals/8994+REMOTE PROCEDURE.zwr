^XWB(8994,4933,2,"PARAMSEQ",2,2)=""
^XWB(8994,4933,2,"PARAMSEQ",3,3)=""
^XWB(8994,4933,2,"PARAMSEQ",4,4)=""
^XWB(8994,4933,2,"PARAMSEQ",5,5)=""
^XWB(8994,4933,3,0)="^^4^4^3251027^"
^XWB(8994,4933,3,1,0)=" 1 for Success "
^XWB(8994,4933,3,2,0)=" 0 for failure to process "
^XWB(8994,4933,3,3,0)=" -1^Can not save transmission"
^XWB(8994,4933,3,4,0)=" -1^Can not save details"
^XWB(8994,4934,0)="DVBA CAPRI GET DBQ XML^FAILXML^DVBCTXML^4^R^^^1^1^^1"
^XWB(8994,4934,1,0)="^^2^2^3251027^"
^XWB(8994,4934,1,1,0)="This RPC is being used by CAPRI GUI to retrieve the XML document stored "
^XWB(8994,4934,1,2,0)="in CAPRI TEMPLATES FILE (396.17)"
^XWB(8994,4934,2,0)="^8994.02A^2^2"
^XWB(8994,4934,2,1,0)="DVBIEN^1^^1^1"
^XWB(8994,4934,2,1,1,0)="^^1^1^3251027^"
^XWB(8994,4934,2,1,1,1,0)="Worksheet IEN of the requested XML Document"
^XWB(8994,4934,2,2,0)="DVBCT^1^^1^2"
^XWB(8994,4934,2,2,1,0)="^^1^1^3251027^"
^XWB(8994,4934,2,2,1,1,0)="The XML IEN: the sequence number of saved XMLs"
^XWB(8994,4934,2,"B","DVBCT",2)=""
^XWB(8994,4934,2,"B","DVBIEN",1)=""
^XWB(8994,4934,2,"PARAMSEQ",1,1)=""
^XWB(8994,4934,2,"PARAMSEQ",2,2)=""
^XWB(8994,4934,3,0)="^8994.03^4^4^3251027^^"
^XWB(8994,4934,3,1,0)="Returns 1^XML data in a global array"
^XWB(8994,4934,3,2,0)="OR"
^XWB(8994,4934,3,3,0)="0^NO RECORD EXISTS"
^XWB(8994,4934,3,4,0)="-1^LOCKED RECORD"
^XWB(8994,4935,0)="DVBA CAPRI DBQ TRANS FAIL LIST^FAILIST^DVBCTXML^4^R^^^1^1^^1"
^XWB(8994,4935,1,0)="^8994.01^1^1^3251027^^^"
^XWB(8994,4935,1,1,0)="This RPC is returning a list of failed XML transmissions to the CAPRI GUI"
^XWB(8994,4935,2,0)="^8994.02A^1^1"
^XWB(8994,4935,2,1,0)="DVBDUZ^1^^0^1"
^XWB(8994,4935,2,1,1,0)="^8994.021^2^2^3251027^^"
^XWB(8994,4935,2,1,1,1,0)="This is the DUZ if that person is requesting only their own records to be "
^XWB(8994,4935,2,1,1,2,0)="returned in the list."
^XWB(8994,4935,2,"B","DVBDUZ",1)=""
^XWB(8994,4935,2,"PARAMSEQ",1,1)=""
^XWB(8994,4935,3,0)="^^5^5^3251027^"
^XWB(8994,4935,3,1,0)="Returns list of failed XMLS in a temp global with the following format "
^XWB(8994,4935,3,2,0)="Worksheet IEN^XML IEN^DBQ Name^Patient Name^XML Origination  "
^XWB(8994,4935,3,3,0)="Date^Flag^Worksheet Originator's Name   "
^XWB(8994,4935,3,4,0)="Flag is set to 1 when there has been 1 day or more between the Origination"
^XWB(8994,4935,3,5,0)="Date and Today"
^XWB(8994,4936,0)="DVBA CAPRI SAVE DBQ XML^SAVEXML^DVBCTXML^1^R^^^1^^^1"
^XWB(8994,4936,1,0)="^^2^2^3251027^"
^XWB(8994,4936,1,1,0)="This RPC will save the DBQ XML created during the signing process for "
^XWB(8994,4936,1,2,0)="transmission"
^XWB(8994,4936,2,0)="^8994.02A^7^7"
^XWB(8994,4936,2,1,0)="DVBNAME^1^^1^1"
^XWB(8994,4936,2,1,1,0)="^^1^1^3251027^"
^XWB(8994,4936,2,1,1,1,0)="DBQ Name"
^XWB(8994,4936,2,2,0)="DVBCT^1^^1^2"
^XWB(8994,4936,2,2,1,0)="^^1^1^3251027^"
^XWB(8994,4936,2,2,1,1,0)="EXAM IEN (DBQ Sequence Number within the Worksheet) "
^XWB(8994,4936,2,3,0)="DVBXML^2^^1^3"
^XWB(8994,4936,2,3,1,0)="^^1^1^3251027^"
^XWB(8994,4936,2,3,1,1,0)="XML DATA"
^XWB(8994,4936,2,4,0)="DVBSTAT^1^^0^4"
^XWB(8994,4936,2,4,1,0)="^^1^1^3251027^"
^XWB(8994,4936,2,4,1,1,0)="Transmission Status: 1=C 0=E"
^XWB(8994,4936,2,5,0)="DVBRESP^1^^0^5"
^XWB(8994,4936,2,5,1,0)="^^1^1^3251027^"
^XWB(8994,4936,2,5,1,1,0)="Transmission Response Code"
^XWB(8994,4936,2,6,0)="DVBIEN^1^^1^6"
^XWB(8994,4936,2,6,1,0)="^^1^1^3251027^"
^XWB(8994,4936,2,6,1,1,0)="Worksheet IEN"
^XWB(8994,4936,2,7,0)="DVBPM5^1^^0^7"
^XWB(8994,4936,2,7,1,0)="^^2^2^3251027^"
^XWB(8994,4936,2,7,1,1,0)="For backwards compatibility, adding the last parameter for GUI version "
^XWB(8994,4936,2,7,1,2,0)="250 and before. This shifts parameters 3-6 down one. "
^XWB(8994,4936,2,"B","DVBCT",2)=""
^XWB(8994,4936,2,"B","DVBIEN",6)=""
^XWB(8994,4936,2,"B","DVBNAME",1)=""
^XWB(8994,4936,2,"B","DVBPM5",7)=""
^XWB(8994,4936,2,"B","DVBRESP",5)=""
^XWB(8994,4936,2,"B","DVBSTAT",4)=""
^XWB(8994,4936,2,"B","DVBXML",3)=""
^XWB(8994,4936,2,"PARAMSEQ",1,1)=""
^XWB(8994,4936,2,"PARAMSEQ",2,2)=""
^XWB(8994,4936,2,"PARAMSEQ",3,3)=""
^XWB(8994,4936,2,"PARAMSEQ",4,4)=""
^XWB(8994,4936,2,"PARAMSEQ",5,5)=""
^XWB(8994,4936,2,"PARAMSEQ",6,6)=""
^XWB(8994,4936,2,"PARAMSEQ",7,7)=""
^XWB(8994,4936,3,0)="^^4^4^3251027^"
^XWB(8994,4936,3,1,0)=" Returns 1 for success "
^XWB(8994,4936,3,2,0)=" -1^Can not save transmission"
^XWB(8994,4936,3,3,0)=" -1^Can not save details"
^XWB(8994,4936,3,4,0)=" -1^XML did not save"
^XWB(8994,4937,0)="DVBA CAPRI NF DATA^NEWSFEED^DVBCTXM2^1^R^0^^1"
^XWB(8994,4937,1,0)="^8994.01^2^2^3230329^^"
^XWB(8994,4937,1,1,0)="The RPC is returning the News Feed Client, Tenant and Token IDs, also the "
^XWB(8994,4937,1,2,0)="Site ID, Drive ID and File Info URLs to the CAPRI GUI"
^XWB(8994,4937,3,0)="^^1^1^3230329^"
^XWB(8994,4937,3,1,0)="NF Client^NF Tenant^NF Token^ NF SiteID URL^NF Drive ID URL^FileInfo URL"
^XWB(8994,4938,0)="DVBA CAPRI GET EXAM REPORT^TRANSRPT^DVBCTPD2^4^R^^^1^1"
^XWB(8994,4938,1,0)="^8994.01^4^4^3251027^^"
^XWB(8994,4938,1,1,0)="Returns DBQ Transmission History based either on worksheet IEN or Date "
^XWB(8994,4938,1,2,0)="Range. The Date Range will pull all XMLs Transmissions from within that "
^XWB(8994,4938,1,3,0)="time frame. If no end date is sent with starting date, we default to "
^XWB(8994,4938,1,4,0)="today. "
^XWB(8994,4938,2,0)="^8994.02A^3^3"
^XWB(8994,4938,2,1,0)="DVBIEN^1^^0^1"
^XWB(8994,4938,2,1,1,0)="^8994.021^1^1^3251027^^"
^XWB(8994,4938,2,1,1,1,0)="Requested DBQ IEN"
^XWB(8994,4938,2,2,0)="DVBSDT^1^^0^2"
^XWB(8994,4938,2,2,1,0)="^^1^1^3230908^"
^XWB(8994,4938,2,2,1,1,0)="Start Date Range"
^XWB(8994,4938,2,3,0)="DVBEDT^1^^0^3"
^XWB(8994,4938,2,3,1,0)="^8994.021^1^1^3251027^^"
^XWB(8994,4938,2,3,1,1,0)="End Date Range"
^XWB(8994,4938,2,"B","DVBEDT",3)=""
^XWB(8994,4938,2,"B","DVBIEN",1)=""
^XWB(8994,4938,2,"B","DVBSDT",2)=""
^XWB(8994,4938,2,"PARAMSEQ",1,1)=""
^XWB(8994,4938,2,"PARAMSEQ",2,2)=""
^XWB(8994,4938,2,"PARAMSEQ",3,3)=""
^XWB(8994,4938,3,0)="^^4^4^3251027^"
^XWB(8994,4938,3,1,0)="Return will be blank if no information is found to match the request "
^XWB(8994,4938,3,2,0)="option. Details will be listed with DBQ Name^Patient Name^Document "
^XWB(8994,4938,3,3,0)="Manager Name^XML Transmission Date^DBQ Transmission Status^Response Code "
^XWB(8994,4938,3,4,0)="for each qualifying XML "
^XWB(8994,4939,0)="DVBA CAPRI FAIL CHECK^FAILCHK^DVBCTXML^1^R^^^^1"
^XWB(8994,4939,1,0)="^^1^1^3231025^"
^XWB(8994,4939,1,1,0)="RPC will check if there are any failed transmissions in File 396.17.  If there is at least 1 it will return a 1."
^XWB(8994,4939,2,0)="^8994.02A"
^XWB(8994,4939,3,0)="^^1^1^3231025^"
^XWB(8994,4939,3,1,0)="1 if there is at least one failed XML transmissions in File 396.17, 0 if theare none."
^XWB(8994,4940,0)="WEBG VERIFY CODE EXP DATE^VERCDEXP^WEBGUTIL^1^^0^1^^^^1"
^XWB(8994,4940,1,0)="^^2^2^3230710^"
^XWB(8994,4940,1,1,0)="Retrieves the date that the given user's Verify Code is due to expire and "
^XWB(8994,4940,1,2,0)="required to be changed."
^XWB(8994,4940,3,0)="^^3^3^3230710^"
^XWB(8994,4940,3,1,0)="Returns the Verify Code expiration date in standard date format:"
^XWB(8994,4940,3,2,0)=" "
^XWB(8994,4940,3,3,0)="   MM/DD/YYYY"
^XWB(8994,4941,0)="ISI GET RAD STANDARD REPORTS^GETSTD^ISIRAR01^2"
^XWB(8994,4941,1,0)="^^2^2^3160405^"
^XWB(8994,4941,1,1,0)="This RPC returns an array containing IEN^NAME of RAD 'Standard' reports "
^XWB(8994,4941,1,2,0)="(File #74.1)."
^XWB(8994,4942,0)="ISI GET RAD STANDARD TEXT^GETSTDTX^ISIRAR02^4^^^^1"
^XWB(8994,4942,1,0)="^8994.01^2^2^3160405^^"
^XWB(8994,4942,1,1,0)="Given RAD 'Standard' report IEN(s), this RPC returns the text of the "
^XWB(8994,4942,1,2,0)="Impression and Report Text sections."
^XWB(8994,4942,2,0)="^8994.02A^1^1"
^XWB(8994,4942,2,1,0)="ISIIENS^1^250^1^1"
^XWB(8994,4942,2,1,1,0)="^8994.021^4^4^3160405^^"
^XWB(8994,4942,2,1,1,1,0)="This input parameter contains multiple RAD 'Standard' Report IEN(s). "
^XWB(8994,4942,2,1,1,2,0)="Example: "
^XWB(8994,4942,2,1,1,3,0)="1   - for single standard report ien = 11"
^XWB(8994,4942,2,1,1,4,0)="1^2^3 - for multiple standard report iens = 1,2, and 3."
^XWB(8994,4942,2,"B","ISIIENS",1)=""
^XWB(8994,4942,2,"PARAMSEQ",1,1)=""
^XWB(8994,4942,3,0)="^8994.03^16^16^3160405^^"
^XWB(8994,4942,3,1,0)="   ISIOUT       = Global Array contains all of RAD 'Standard' reports"
^XWB(8994,4942,3,2,0)="   ISIOUT(1)    = Number of Records or 0^Error Message"
^XWB(8994,4942,3,3,0)="   ISIOUT(2..n) = Text Type (I = IMPRESSION, R = REPORT TEXT ^ Report "
^XWB(8994,4942,3,4,0)="IEN ^ Text"
^XWB(8994,4942,3,5,0)="                  Example: "
^XWB(8994,4942,3,6,0)="                  I^1^impression line 1 for standard 1"
^XWB(8994,4942,3,7,0)="                  I^1^impression line 2 for standard 1"
^XWB(8994,4942,3,8,0)="                  I^1"
^XWB(8994,4942,3,9,0)="                  I^2^impression line 1 for standard 2"
^XWB(8994,4942,3,10,0)="                  I^2"
