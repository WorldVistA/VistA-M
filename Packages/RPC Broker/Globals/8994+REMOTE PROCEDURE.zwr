^XWB(8994,2285,3,1,0)="TEST NAME = LAST EDIT DATE^OPERATIONAL^REQUIRES LISCENCE"
^XWB(8994,2285,3,2,0)="^LISCENCE CURRENT^IS LEGACY^IEN^R PRIVILEGE"
^XWB(8994,2285,3,3,0)="^IS NATIONAL^UNDER DEVELOPMENT^HAS BEEN OPERATIONAL"
^XWB(8994,2286,0)="YTQ TSLIST1^TSLIST1^YTQAPI^2^S^^^^^^1"
^XWB(8994,2286,1,0)="^8994.01^3^3^3021219^"
