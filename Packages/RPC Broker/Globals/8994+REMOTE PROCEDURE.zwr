^XWB(8994,5136,0)="SDES2 REMAP CLINIC/DIVISION^REMAP^SDES2REMAP^2^R^^^0^^^1"
^XWB(8994,5136,1,0)="^^3^3^3250528^"
^XWB(8994,5136,1,1,0)="This RPC allows remapping of clinics/divisions."
^XWB(8994,5136,1,2,0)=" "
^XWB(8994,5136,1,3,0)="Can only be invoked by Acheron."
^XWB(8994,5136,2,0)="^8994.02A^2^2"
^XWB(8994,5136,2,1,0)="SDCONTEXT^2^^1^1"
^XWB(8994,5136,2,1,1,0)="^^10^10^3250224^"
^XWB(8994,5136,2,1,1,1,0)=" SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,5136,2,1,1,2,0)="                           Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5136,2,1,1,3,0)=" SDCONTEXT(""USER DUZ"")   = The DUZ of the user taking action on the"
^XWB(8994,5136,2,1,1,4,0)="                           calling application. "
^XWB(8994,5136,2,1,1,5,0)=" SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,5136,2,1,1,6,0)="                           calling application."
^XWB(8994,5136,2,1,1,7,0)=" SDCONTEXT(""PATIENT DFN"")= The name of the patient taking action on the"
^XWB(8994,5136,2,1,1,8,0)="                           calling application."
^XWB(8994,5136,2,1,1,9,0)=" SDCONTEXT(""PATIENT ICN"")= The ICN of the patient taking action on the"
^XWB(8994,5136,2,1,1,10,0)="                           calling application."
^XWB(8994,5136,2,2,0)="SDINPUT^2^^1^2"
^XWB(8994,5136,2,2,1,0)="^^22^22^3250425^"
^XWB(8994,5136,2,2,1,1,0)=" "
^XWB(8994,5136,2,2,1,2,0)=" SDINPUT(""DIVISION"",""ALL"")  - Only used to re-map all divisions"
^XWB(8994,5136,2,2,1,3,0)="                            - This should only be passed if 'ALL' "
^XWB(8994,5136,2,2,1,4,0)="                              divisions are being re-mapped"
^XWB(8994,5136,2,2,1,5,0)=" "
^XWB(8994,5136,2,2,1,6,0)=" "
^XWB(8994,5136,2,2,1,7,0)="When re-mapping 'ALL' clinics, or a clinic list within"
^XWB(8994,5136,2,2,1,8,0)=" a specific DIVISION, pass in the following:"
^XWB(8994,5136,2,2,1,9,0)=" SDINPUT(""DIVISION"",DIVISION IEN,""CLINIC"",""ALL"")="""" "
^XWB(8994,5136,2,2,1,10,0)="       - re-maps all clinics within the division"
^XWB(8994,5136,2,2,1,11,0)=" "
^XWB(8994,5136,2,2,1,12,0)=" SDINPUT(""DIVISION"",DIVISION IEN,""CLINIC"",CLINICIEN)="""" "
^XWB(8994,5136,2,2,1,13,0)="       - list of clinics to remap"
^XWB(8994,5136,2,2,1,14,0)=" "
^XWB(8994,5136,2,2,1,15,0)=" When re-mapping a list of clinics that are not associated"
^XWB(8994,5136,2,2,1,16,0)=" with a single division, send in a list of just the clinics"
^XWB(8994,5136,2,2,1,17,0)=" being remapped:"
^XWB(8994,5136,2,2,1,18,0)=" SDINPUT(""CLINIC"",CLINIC IEN)=""""   - required, if division is not passed"
^XWB(8994,5136,2,2,1,19,0)=" SDINPUT(""START DATE"")=ISO START DATE (i.e. 2024-12-01)  - required, "
^XWB(8994,5136,2,2,1,20,0)="    re-map start date"
^XWB(8994,5136,2,2,1,21,0)=" SDINPUT(""END DATE"")=ISO END DATE     (i.e. 2024-12-30)  - required, "
^XWB(8994,5136,2,2,1,22,0)="    re-map end date"
^XWB(8994,5136,2,"B","SDCONTEXT",1)=""
^XWB(8994,5136,2,"B","SDINPUT",2)=""
