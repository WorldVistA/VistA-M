^XWB(8994,3935,3,1,0)="RET(n) = array of partials to receive to an inventory point"
^XWB(8994,3935,3,2,0)=" RET(0)=inv point name^PO (external)^status abbrev(field #.02)^status^"
^XWB(8994,3935,3,3,0)="         PO date(field #.1)"
^XWB(8994,3935,3,4,0)=" RET(1)=vendorname^vendorIEN(field #5)^FCP(field #1)^"
^XWB(8994,3935,3,5,0)="         Total Amount(field #91)"
^XWB(8994,3935,3,6,0)=" RET(2)=$$PARTIAL$$""_partialIEN^partialDate(field #.01)^"
^XWB(8994,3935,3,7,0)="         LineCount(field #13)^TotalAmt(field #11)"
^XWB(8994,3935,3,8,0)=" RET(2+n)=line#^ItemDesc(field #1.5)^ItemIEN^PO Qty(field# 2)^"
^XWB(8994,3935,3,9,0)="         conversion^Qty Recv^AvgCost^UnitCost^TotCost^POUI"
^XWB(8994,3935,3,10,0)=" RET(2+n)=error or warning information for a line#"
^XWB(8994,3935,3,11,0)=" "
^XWB(8994,3935,3,12,0)="Partials may repeat (lines 2-n), each partial date entry will start with"
^XWB(8994,3935,3,13,0)="$$PARTIAL$$.  Error and Warning lines begin with ERROR: or WARNING: and "
^XWB(8994,3935,3,14,0)="not the Line#. Warnings will be followed with a semi-colon separated list "
^XWB(8994,3935,3,15,0)="of Distribution Points to cost the items to if applicable.  For example:"
^XWB(8994,3935,3,16,0)=" RET(n)=""WARNING: Item not stored in Inventory Point, Cost to:18;19;20;21"""
^XWB(8994,3935,3,17,0)="The GUI will allow the user to select (by name, not IEN) the Distribution "
