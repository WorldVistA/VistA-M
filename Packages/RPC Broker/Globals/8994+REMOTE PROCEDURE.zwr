^XWB(8994,2906,1,0)="^8994.01^2^2^3090318^^"
^XWB(8994,2906,1,1,0)="This procedure is to either delete or re-queue a range of Vista Imaging"
^XWB(8994,2906,1,2,0)="Background Processor queues.  The process parameter determines the action."
^XWB(8994,2906,2,0)="^8994.02A^5^5"
^XWB(8994,2906,2,1,0)="QUEUE^1^15^1^1"
^XWB(8994,2906,2,1,1,0)="^^1^1^3071022^"
^XWB(8994,2906,2,1,1,1,0)="This determines the queue type that will be processed."
^XWB(8994,2906,2,2,0)="PROCESS^1^15^1^2"
^XWB(8994,2906,2,2,1,0)="^^3^3^3071022^"
^XWB(8994,2906,2,2,1,1,0)="This determines whether the queue will be requeued or deleted.  A"
^XWB(8994,2906,2,2,1,2,0)="value of ""DEL"" will designate a delete and a value of ""REQ"" will"
^XWB(8994,2906,2,2,1,3,0)="designate a requeue."
^XWB(8994,2906,2,3,0)="START^1^15^1^3"
^XWB(8994,2906,2,3,1,0)="^^2^2^3071022^"
^XWB(8994,2906,2,3,1,1,0)="This value will determine the start of the range of Queue file "
^XWB(8994,2906,2,3,1,2,0)="(#2006.03) entries that will be processed."
^XWB(8994,2906,2,4,0)="STOP^1^15^1^4"
^XWB(8994,2906,2,4,1,0)="^^1^1^3071022^"
^XWB(8994,2906,2,4,1,1,0)="This will determine the last Queue file entry that will be processed."
^XWB(8994,2906,2,5,0)="PLACE^1^15^1^5"
^XWB(8994,2906,2,5,1,0)="^8994.021^2^2^3090318^^"
^XWB(8994,2906,2,5,1,1,0)="This value designates the Imaging site parameter entry"
^XWB(8994,2906,2,5,1,2,0)="for which the queues to be processed are associated."
