^XWB(8994,4993,1,0)="^^3^3^3250213^"
^XWB(8994,4993,1,1,0)="This RPC allows the editing of an appointment request."
^XWB(8994,4993,1,2,0)=" "
^XWB(8994,4993,1,3,0)="Can only be invoked by Acheron"
^XWB(8994,4993,2,0)="^8994.02A^2^2"
^XWB(8994,4993,2,1,0)="SDCONTEXT^2^^1^1"
^XWB(8994,4993,2,1,1,0)="^^11^11^3231110^"
^XWB(8994,4993,2,1,1,1,0)="   SDCONTEXT(""ACHERON AUDIT ID"")"
^XWB(8994,4993,2,1,1,2,0)="    - Up to 40 Character unique ID number. "
^XWB(8994,4993,2,1,1,3,0)="    - Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,4993,2,1,1,4,0)="   SDCONTEXT(""USER DUZ"")"
^XWB(8994,4993,2,1,1,5,0)="    - The DUZ of the user taking action in the calling application."
^XWB(8994,4993,2,1,1,6,0)="   SDCONTEXT(""USER SECID"")"
^XWB(8994,4993,2,1,1,7,0)="    - The SECID of the user taking action in the calling application."
^XWB(8994,4993,2,1,1,8,0)="   SDCONTEXT(""PATIENT DFN"")"
^XWB(8994,4993,2,1,1,9,0)="    - The DFN/IEN of the target patient from the calling application."
^XWB(8994,4993,2,1,1,10,0)="   SDCONTEXT(""PATIENT ICN"")"
^XWB(8994,4993,2,1,1,11,0)="    - The ICN of the target patient from the calling application."
^XWB(8994,4993,2,2,0)="REQUEST^2^^1^2"
^XWB(8994,4993,2,2,1,0)="^8994.021^41^41^3250213^^"
^XWB(8994,4993,2,2,1,1,0)="Appointment request data that is being edited. Non-required data fields"
^XWB(8994,4993,2,2,1,2,0)="that are not changing should not be passed into this RPC. The intent of"
^XWB(8994,4993,2,2,1,3,0)="the edit is to only validate and store fields that are changing."
^XWB(8994,4993,2,2,1,4,0)=" "
^XWB(8994,4993,2,2,1,5,0)="S REQUEST(""REQUEST IEN"")=""""                               REQ"
