^XWB(8994,4307,2,18,1,5,0)="detailed purchase order tab.  If the Description is changed, it will be "
^XWB(8994,4307,2,18,1,6,0)="stored in both the Procurement & Accounting Transactions file (#442) Item "
^XWB(8994,4307,2,18,1,7,0)="multiple (#442.01) field #1 Description and the Item Master file (#441) "
^XWB(8994,4307,2,18,1,8,0)="Description field (#.1)."
^XWB(8994,4307,2,19,0)="DSSODAM^1^8^0^15"
^XWB(8994,4307,2,19,1,0)="^8994.021^3^3^3141208^^"
