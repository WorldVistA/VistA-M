^XWB(8994,3703,2,2,1,0)="^8994.021^1^1^3130429^^"
^XWB(8994,3703,2,2,1,1,0)="Inventory point name that identifies the Cathlab in GIP."
^XWB(8994,3703,2,3,0)="ITEM^1^10^1^2"
^XWB(8994,3703,2,3,1,0)="^8994.021^2^2^3130429^^"
^XWB(8994,3703,2,3,1,1,0)="Internal entry number for the item, from the Item Master Number file, "
