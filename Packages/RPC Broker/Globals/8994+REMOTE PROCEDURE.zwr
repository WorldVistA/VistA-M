^XWB(8994,5016,3,3,0)="    ""NewAppointmentIEN"": 299315"
^XWB(8994,5016,3,4,0)="  }"
^XWB(8994,5016,3,5,0)="}"
^XWB(8994,5016,3,6,0)="}"
^XWB(8994,5017,0)="SDES2 GET APPT REQ BY DFN^GETREQSBYDFN^SDES2GETAPPTREQ^2^R^^^0^^^1"
^XWB(8994,5017,1,0)="^8994.01^3^3^3250216^^^"
^XWB(8994,5017,1,1,0)="This RPC returns a list of appointment requests for a given patient."
^XWB(8994,5017,1,2,0)=" "
^XWB(8994,5017,1,3,0)="Can only be invoked by Acheron"
^XWB(8994,5017,2,0)="^8994.02A^2^2"
^XWB(8994,5017,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,5017,2,1,1,0)="^8994.021^11^11^3250216^^"
^XWB(8994,5017,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"")"
^XWB(8994,5017,2,1,1,2,0)=" - Up to 40 Character unique ID number. "
^XWB(8994,5017,2,1,1,3,0)=" - Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5017,2,1,1,4,0)="SDCONTEXT(""USER DUZ"")"
^XWB(8994,5017,2,1,1,5,0)=" - The DUZ of the user taking action in the calling application."
^XWB(8994,5017,2,1,1,6,0)="SDCONTEXT(""USER SECID"")"
^XWB(8994,5017,2,1,1,7,0)=" - The SECID of the user taking action in the calling application."
^XWB(8994,5017,2,1,1,8,0)="SDCONTEXT(""PATIENT DFN"")"
^XWB(8994,5017,2,1,1,9,0)=" - The DFN/IEN of the target patient from the calling application."
^XWB(8994,5017,2,1,1,10,0)="SDCONTEXT(""PATIENT ICN"")"
^XWB(8994,5017,2,1,1,11,0)=" - The ICN of the target patient from the calling application."
^XWB(8994,5017,2,2,0)="SDINPUT^2^^1^2"
^XWB(8994,5017,2,2,1,0)="^8994.021^3^3^3250216^^^"
^XWB(8994,5017,2,2,1,1,0)=" "
^XWB(8994,5017,2,2,1,2,0)=" "
^XWB(8994,5017,2,2,1,3,0)="SDINPUT(""PATIENT IEN"")=Patient DFN from the PATIENT file (#2)"
^XWB(8994,5017,2,"B","SDCONTEXT",1)=""
