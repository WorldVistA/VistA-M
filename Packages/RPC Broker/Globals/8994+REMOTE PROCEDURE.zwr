^XWB(8994,3092,2,"PARAMSEQ",2,5)=""
^XWB(8994,3092,2,"PARAMSEQ",3,6)=""
^XWB(8994,3092,2,"PARAMSEQ",4,7)=""
^XWB(8994,3092,2,"PARAMSEQ",5,3)=""
^XWB(8994,3092,3,0)="^8994.03^1^1^3120120^^^^"
^XWB(8994,3092,3,1,0)="The return parameter returns a ""0"" for success. n < 0 followed by an error message is returned if an error has occurred."
^XWB(8994,3093,0)="MAGV ATTACH IMAGE INSTANCE^ATFILE^MAGVRS21^2^R"
^XWB(8994,3093,1,0)="^8994.01^1^1^3100826^^^^"
^XWB(8994,3093,1,1,0)="This RPC allows an image instance file to be attached to a SOP."
^XWB(8994,3093,2,0)="^8994.02A^1^1"
^XWB(8994,3093,2,1,0)="FILEATTS^2"
^XWB(8994,3093,2,1,1,0)="^8994.021^9^9^3100826^^^^"
^XWB(8994,3093,2,1,1,1,0)="Input parameters are name-value pairs sent as successive integer"
^XWB(8994,3093,2,1,1,2,0)="subscripts in an array that should be passed in by reference as the second"
^XWB(8994,3093,2,1,1,3,0)="argument to entry point ATFILE^MAGVRS21.  The first argument will"
^XWB(8994,3093,2,1,1,4,0)="contain the returned value in an array that should also be passed by"
^XWB(8994,3093,2,1,1,5,0)="reference."
^XWB(8994,3093,2,1,1,6,0)=" "
^XWB(8994,3093,2,1,1,7,0)="The values passed in should be in the format <fname>`<value>, where"
^XWB(8994,3093,2,1,1,8,0)="<fname> is a field name in the IMAGE INSTANCE FILE (#2005.65) and <value>"
^XWB(8994,3093,2,1,1,9,0)="is the value to which that field should be set."
^XWB(8994,3093,2,"B","FILEATTS",1)=""
^XWB(8994,3093,3,0)="^8994.03^4^4^3100826^^^^"
^XWB(8994,3093,3,1,0)="The first and only element of the return array will be formatted as"
^XWB(8994,3093,3,2,0)="[ERRORCODE]`[TEXT]`[ASSIGNED IEN].  An ERRORCODE value of 0 indicates"
^XWB(8994,3093,3,3,0)="success; all others indicate failure, as described in TEXT, and no IEN"
^XWB(8994,3093,3,4,0)="will be assigned."
