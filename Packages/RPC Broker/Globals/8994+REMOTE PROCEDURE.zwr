^XWB(8994,4875,0)="PSO EPCS VERSION^GUICHK^PSOEPVR^1^R"
^XWB(8994,4875,1,0)="^8994.01^2^2^3210708^^^"
^XWB(8994,4875,1,1,0)="This RPC is used to check the version of the ePCS GUI that should be "
^XWB(8994,4875,1,2,0)="running."
