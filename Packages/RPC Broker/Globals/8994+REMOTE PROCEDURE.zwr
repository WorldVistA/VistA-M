^XWB(8994,4996,1,2,0)=" "
^XWB(8994,4996,1,3,0)="Can only be invoked by Acheron"
^XWB(8994,4996,2,0)="^8994.02A^2^2"
^XWB(8994,4996,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,4996,2,1,1,0)="^^10^10^3240102^"
^XWB(8994,4996,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,4996,2,1,1,2,0)="            Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,4996,2,1,1,3,0)=" SDCONTEXT(""PATIENT DFN"") = The DFN/IEN of the target patient from the"
^XWB(8994,4996,2,1,1,4,0)="            calling application."
^XWB(8994,4996,2,1,1,5,0)=" SDCONTEXT(""PATIENT ICN"") = The ICN of the target patient from the"
^XWB(8994,4996,2,1,1,6,0)="            calling application."
^XWB(8994,4996,2,1,1,7,0)=" SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action in the"
^XWB(8994,4996,2,1,1,8,0)="            calling application."
^XWB(8994,4996,2,1,1,9,0)=" SDCONTEXT(""USER SECID"") = The SECID of the user taking action in"
^XWB(8994,4996,2,1,1,10,0)="            the calling application."
^XWB(8994,4996,2,2,0)="SDINPUT^2^32000^1^2"
^XWB(8994,4996,2,2,1,0)="^8994.021^13^13^3250214^^"
^XWB(8994,4996,2,2,1,1,0)="1. SDINPUT(""APPOINTMENT IEN"")=SDIEN(Required)"
^XWB(8994,4996,2,2,1,2,0)="   Appointment IEN from the SDES Appointment File #409.84"
^XWB(8994,4996,2,2,1,3,0)="2. SDINPUT(""STATUS"")         =STATUS(Required)"
^XWB(8994,4996,2,2,1,4,0)="    Status to be set in file #409.842 for the given Appt IEN."
^XWB(8994,4996,2,2,1,5,0)="    Will update any status entered. Below are just few examples :"
^XWB(8994,4996,2,2,1,6,0)="    "
^XWB(8994,4996,2,2,1,7,0)="    CHECK-IN COMPLETE   "
^XWB(8994,4996,2,2,1,8,0)="    CHECK-IN STARTED   "
