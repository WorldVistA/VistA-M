^XWB(8994,190,2,"B","DFN",1)=""
^XWB(8994,190,2,"PARAMSEQ",1,1)=""
^XWB(8994,190,3,0)="^^19^19^3240206^"
^XWB(8994,190,3,1,0)="The return value is a single item, with multiple pieces of information. "
^XWB(8994,190,3,2,0)="They are:"
^XWB(8994,190,3,3,0)=" "
^XWB(8994,190,3,4,0)="SSN            - patient's social security number"
^XWB(8994,190,3,5,0)="DOB            - patient's date of birth"
^XWB(8994,190,3,6,0)="SEX            - patient birth sex"
^XWB(8994,190,3,7,0)="VETERAN        - status from eligibility (Veteran-Y or N)"
^XWB(8994,190,3,8,0)="SERVICE"
^XWB(8994,190,3,9,0)="CONNECTED %    - percent the patient is service connected"
^XWB(8994,190,3,10,0)="WARD LOCATION  - if admitted, patient's ward location"
^XWB(8994,190,3,11,0)="ROOM BED       - if admitted, patient's room and bed location"
^XWB(8994,190,3,12,0)="NAME           - patient's name from the PATIENT file (#2)"
^XWB(8994,190,3,13,0)="                 generally in the format last,first mi suffix"
^XWB(8994,190,3,14,0)="SIGI           - self identified gender"
^XWB(8994,190,3,15,0)="ATTENDING      - attending provider name"
^XWB(8994,190,3,16,0)=" "
^XWB(8994,190,3,17,0)="Sample return:"
^XWB(8994,190,3,18,0)="666330080^2350407^M^Y^10^BCMA^12-B^CPRSPATIENT,ONE^Man^CPRSPROVIDER,ATTEN"
^XWB(8994,190,3,19,0)="DING"
^XWB(8994,191,0)="ORWPT LIST ALL^LISTALL^ORWPT^2^^^^^^^1"
