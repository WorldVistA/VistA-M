^XWB(8994,9,0)="XWB GET VARIABLE VALUE^VARVAL^XWBLIB^1^S^0^^^1^^1"
^XWB(8994,9,1,0)="^8994.01^10^10^3151217^^^"
^XWB(8994,9,1,1,0)="This RPC accepts the name of a variable which will be evaluated and its"
^XWB(8994,9,1,2,0)="value returned to the server.  For example, this RPC may be called with"
^XWB(8994,9,1,3,0)="a parameter variable like DUZ which will be returned as 123456."
^XWB(8994,9,1,4,0)=" "
^XWB(8994,9,1,5,0)="It should NOT be used to return the value of anything other than a "
^XWB(8994,9,1,6,0)="variable. For example, the RPC should not attempt to return the value of "
^XWB(8994,9,1,7,0)="a global or function call, as these are unsupported uses of the RPC and "
^XWB(8994,9,1,8,0)="are not guaranteed to work consistently."
^XWB(8994,9,1,9,0)=" "
^XWB(8994,9,1,10,0)="Integration Agreement (IA) #1629"
^XWB(8994,9,2,0)="^8994.02A^1^1"
^XWB(8994,9,2,1,0)="VARIABLE^4^30^1^1"
^XWB(8994,9,2,1,1,0)="^^1^1^3150528^"
^XWB(8994,9,2,1,1,1,0)="Name of M environment variable whose value is to be returned."
