^XWB(8994,5107,1,1,0)="This RPC is returning data from the DVBAB CAPRI SECURITY TOGGLE "
^XWB(8994,5107,1,2,0)="parameter.  This value tells the CAPRI GUI which security field(s) must "
^XWB(8994,5107,1,3,0)="be validated to allow GUI access."
^XWB(8994,5107,3,0)="^^5^5^3240718^"
^XWB(8994,5107,3,1,0)="Value for toggle in the CAPRI GUI, "
^XWB(8994,5107,3,2,0)=" 1 = Additional SSN Check"
^XWB(8994,5107,3,3,0)=" 2 = Additional SecID Check"
^XWB(8994,5107,3,4,0)=" 3 = Additional SSN and SecID Check"
^XWB(8994,5107,3,5,0)=" 4 = No additional security checks"
^XWB(8994,5108,0)="DVBA CAPRI PDF SIG FIELD NAMES^PDFSIGNM^DVBUTIL^4^R^^^1"
^XWB(8994,5108,1,0)="^8994.01^1^1^3240730^^"
^XWB(8994,5108,1,1,0)="Returns a list of all DBQ PDF field names to enable CMT PDF signing."
^XWB(8994,5108,3,0)="^^8^8^3240730^"
^XWB(8994,5108,3,1,0)="RET=<total count>"
^XWB(8994,5108,3,2,0)="RET(n)=n^<signature field>"
^XWB(8994,5108,3,3,0)=" "
^XWB(8994,5108,3,4,0)="OR"
^XWB(8994,5108,3,5,0)="-1^No data available"
^XWB(8994,5108,3,6,0)=" "
^XWB(8994,5108,3,7,0)="OR"
^XWB(8994,5108,3,8,0)="-1^Unable to retrieve data"
^XWB(8994,5109,0)="DVBA CAPRI SAVE REVIEW DATA^REVIEWSAVE^DVBSIGN^1^R^^^0"
^XWB(8994,5109,1,0)="^^1^1^3240813^"
^XWB(8994,5109,1,1,0)="CAPRI GUI will call RPC to save details for each review action"
^XWB(8994,5109,2,0)="^8994.02A^3^3"
^XWB(8994,5109,2,1,0)="DVBIEN^1^^1^1"
^XWB(8994,5109,2,1,1,0)="^^1^1^3240813^"
^XWB(8994,5109,2,1,1,1,0)="Worksheet IEN "
^XWB(8994,5109,2,2,0)="DVBTYP^1^^1^2"
^XWB(8994,5109,2,2,1,0)="^8994.021^4^4^3240813^^"
^XWB(8994,5109,2,2,1,1,0)="T for Trainee Details saved for Signature fields"
^XWB(8994,5109,2,2,1,2,0)="P for review pending status"
^XWB(8994,5109,2,2,1,3,0)="S for Sent back status"
^XWB(8994,5109,2,2,1,4,0)="A for Awaiting Signature"
^XWB(8994,5109,2,3,0)="DVBREVCMT^2^250^0^3"
^XWB(8994,5109,2,3,1,0)="^^5^5^3240813^"
^XWB(8994,5109,2,3,1,1,0)="For Trainee Signature details the format will be ""TRAINEE^DUZ^DIV"" to "
^XWB(8994,5109,2,3,1,2,0)="store the DUZ and DIV of the Trainee"
^XWB(8994,5109,2,3,1,3,0)="For Awaiting Signature details we will need the DUZ of the signer"
^XWB(8994,5109,2,3,1,4,0)="For either review pending or sent back details would be notes written by "
^XWB(8994,5109,2,3,1,5,0)="user. "
^XWB(8994,5109,2,"B","DVBIEN",1)=""
^XWB(8994,5109,2,"B","DVBREVCMT",3)=""
^XWB(8994,5109,2,"B","DVBTYP",2)=""
^XWB(8994,5109,2,"PARAMSEQ",1,1)=""
^XWB(8994,5109,2,"PARAMSEQ",2,2)=""
^XWB(8994,5109,2,"PARAMSEQ",3,3)=""
^XWB(8994,5109,3,0)="^^13^13^3250423^"
^XWB(8994,5109,3,1,0)="One of the following messages will be sent back:"
^XWB(8994,5109,3,2,0)="-1^No Worksheet IEN sent"
^XWB(8994,5109,3,3,0)="-1^Invalid Worksheet IEN"
^XWB(8994,5109,3,4,0)="-1^Invalid Status"
^XWB(8994,5109,3,5,0)="-1^Missing Status"
^XWB(8994,5109,3,6,0)="-1^Invalid Trainee Comments"
^XWB(8994,5109,3,7,0)="-1^Invalid Trainee DUZ"
^XWB(8994,5109,3,8,0)="-1^Invalid Signer DUZ"
^XWB(8994,5109,3,9,0)="-1^New version not saved"
^XWB(8994,5109,3,10,0)="-1^Review Comments not Saved"
^XWB(8994,5109,3,11,0)="-1^Worksheet not updated"
^XWB(8994,5109,3,12,0)="1^Trainee DUZ and DIV Saved"
^XWB(8994,5109,3,13,0)="1^Review Details saved and Worksheet Updated"
^XWB(8994,5110,0)="DVBA CAPRI TRAINEE DOC MANAGER^DOCMAN^DVBSIGN^1^R^^^0"
^XWB(8994,5110,1,0)="^8994.01^2^2^3240819^^"
^XWB(8994,5110,1,1,0)="RPC Used only to update Document Manager Field to Trainee before "
^XWB(8994,5110,1,2,0)="Signature Validation"
^XWB(8994,5110,2,0)="^8994.02A^1^1"
^XWB(8994,5110,2,1,0)="DVBIEN^1^^1^1"
^XWB(8994,5110,2,1,1,0)="^8994.021^1^1^3240819^^"
^XWB(8994,5110,2,1,1,1,0)="Worksheet IEN"
^XWB(8994,5110,2,"B","DVBIEN",1)=""
^XWB(8994,5110,2,"PARAMSEQ",1,1)=""
^XWB(8994,5110,3,0)="^^4^4^3240829^"
^XWB(8994,5110,3,1,0)="Will return 1 if update processed or"
^XWB(8994,5110,3,2,0)="-1^No Worksheet IEN sent"
^XWB(8994,5110,3,3,0)="-1^Invalid Worksheet IEN"
^XWB(8994,5110,3,4,0)="-1^No Update"
^XWB(8994,5111,0)="DVBA CAPRI TRAINEE SIGNATURE^TRAINSIG^DVBSIGN^1^R^^^0"
^XWB(8994,5111,1,0)="^8994.01^1^1^3240819^^"
^XWB(8994,5111,1,1,0)="Returns the DUZ and DIV for the Trainee that filled out the Worksheet. "
^XWB(8994,5111,2,0)="^8994.02A^1^1"
^XWB(8994,5111,2,1,0)="DVBIEN^1^^1^1"
^XWB(8994,5111,2,1,1,0)="^8994.021^1^1^3240819^^"
^XWB(8994,5111,2,1,1,1,0)="Worksheet IEN"
^XWB(8994,5111,2,"B","DVBIEN",1)=""
^XWB(8994,5111,2,"PARAMSEQ",1,1)=""
^XWB(8994,5111,3,0)="^^4^4^3240829^"
^XWB(8994,5111,3,1,0)="Trainee DUZ^DIV or"
^XWB(8994,5111,3,2,0)="-1^No Worksheet IEN sent"
^XWB(8994,5111,3,3,0)="-1^Invalid Worksheet IEN"
^XWB(8994,5111,3,4,0)="-1^No details found"
^XWB(8994,5112,0)="DVBA CAPRI STATUS COUNT^STATCNT^DVBSIGN^1^R"
^XWB(8994,5112,1,0)="^^6^6^3240821^"
^XWB(8994,5112,1,1,0)="This RPC will return the count for worksheets with the following statuses:"
^XWB(8994,5112,1,2,0)="A=Awaiting signature"
^XWB(8994,5112,1,3,0)="D=Draft/Not ready"
^XWB(8994,5112,1,4,0)="O=Outdataed template"
^XWB(8994,5112,1,5,0)="P=Review pending"
^XWB(8994,5112,1,6,0)="S=Sent back"
^XWB(8994,5112,3,0)="^^2^2^3240821^"
^XWB(8994,5112,3,1,0)="Awaiting signature count^Draft/not ready count^Outdated template "
^XWB(8994,5112,3,2,0)="count^Review pending count^Sent back count"
^XWB(8994,5113,0)="DVBA CAPRI ALERTS DATA^ALRTDATA^DVBSIGN2^4^R^^^1"
^XWB(8994,5113,1,0)="^^7^7^3240911^"
^XWB(8994,5113,1,1,0)="Returns the data for the following worksheet review statuses:"
^XWB(8994,5113,1,2,0)="A=Awaiting Signature, D=Draft/Not ready, O=Outdated Template, P=Review "
^XWB(8994,5113,1,3,0)="Pending, S=Sent Back"
^XWB(8994,5113,1,4,0)=" "
^XWB(8994,5113,1,5,0)="The ""P"" status needs to be specifically requested (via the 2nd input "
^XWB(8994,5113,1,6,0)="parameter DVBST).  If this does not happen, then data is only returned "
^XWB(8994,5113,1,7,0)="for statuses: A,D,O and S."
^XWB(8994,5113,2,0)="^8994.02A^3^3"
^XWB(8994,5113,2,1,0)="DVBST^1^^0^2"
^XWB(8994,5113,2,1,1,0)="^8994.021^6^6^3240911^^"
^XWB(8994,5113,2,1,1,1,0)="This is an optional parameter indicating if there is a specific review "
^XWB(8994,5113,2,1,1,2,0)="status to be considered.  If this parameter is not provided then all the "
^XWB(8994,5113,2,1,1,3,0)="following statuses will be considered:"
^XWB(8994,5113,2,1,1,4,0)=" "
^XWB(8994,5113,2,1,1,5,0)="A=Awaiting Signature, D=Draft/Not ready, O=Outdated Template, P=Review "
^XWB(8994,5113,2,1,1,6,0)="Pending, S=Sent Back"
^XWB(8994,5113,2,2,0)="DVBDUZ^1^^0^1"
^XWB(8994,5113,2,2,1,0)="^^3^3^3240911^"
^XWB(8994,5113,2,2,1,1,0)="This is an optional parameter.  If the value is null or the parameter is "
^XWB(8994,5113,2,2,1,2,0)="not provided then only data regarding the current user is returned.  "
^XWB(8994,5113,2,2,1,3,0)="Otherwise data is returned for ALL users."
^XWB(8994,5113,2,3,0)="DVBUT^1^^0^3"
^XWB(8994,5113,2,3,1,0)="^^3^3^3240911^"
^XWB(8994,5113,2,3,1,1,0)="This is an optional parameter.  If a ""T"" is provided, data is returned if "
^XWB(8994,5113,2,3,1,2,0)="the user is the transcriber.  Otherwise, data is returned if the user is "
^XWB(8994,5113,2,3,1,3,0)="the document manager."
^XWB(8994,5113,2,"B","DVBDUZ",2)=""
^XWB(8994,5113,2,"B","DVBST",1)=""
^XWB(8994,5113,2,"B","DVBUT",3)=""
^XWB(8994,5113,2,"PARAMSEQ",1,2)=""
^XWB(8994,5113,2,"PARAMSEQ",2,1)=""
^XWB(8994,5113,2,"PARAMSEQ",3,3)=""
^XWB(8994,5113,3,0)="^8994.03^7^7^3240911^^"
^XWB(8994,5113,3,1,0)="Data will be returned in an array as follows:"
^XWB(8994,5113,3,2,0)="RET(<worksheet ien>)=Worksheet IEN^ID^Patient IEN^Patien name^Document "
^XWB(8994,5113,3,3,0)="manager IEN^Document manager name^Form title^Review status^Flag new^Flag "
^XWB(8994,5113,3,4,0)="green flag^Flag exclamation^<exam count>^<exam 1 name>,<exam 2 name>,..."
^XWB(8994,5113,3,5,0)=" "
^XWB(8994,5113,3,6,0)="OR"
^XWB(8994,5113,3,7,0)="-1^No data available"
^XWB(8994,5114,0)="DVBA CAPRI PDF LOGIC TOGGLE^DBQLOGIC^DVBUTIL^4^R^^^1"
^XWB(8994,5114,1,0)="^8994.01^2^2^3240925^^^"
^XWB(8994,5114,1,1,0)="RPC will return Parameter results that list ALL, None, or the the "
^XWB(8994,5114,1,2,0)="name(s) of the DBQs that need to skip the DBQ Conditional Logic."
^XWB(8994,5114,3,0)="^^7^7^3240925^"
^XWB(8994,5114,3,1,0)="Array will return at least one entry or the array of DBQ that need to "
^XWB(8994,5114,3,2,0)="skip the conditional logic. "
^XWB(8994,5114,3,3,0)="-1^Error Message"
^XWB(8994,5114,3,4,0)="RTN(1)=""ALL"""
^XWB(8994,5114,3,5,0)="RTN(1)=0"
^XWB(8994,5114,3,6,0)="RTN(1)=""Single DBQ_515"""
^XWB(8994,5114,3,7,0)="RTN(2)=""Additional DBQs_151"""
^XWB(8994,5115,0)="DVBA CAPRI WORKSHEET BY EXAM^WKSHBYEXAM^DVBUTIL^1^R^^^0"
^XWB(8994,5115,1,0)="^^1^1^3240912^"
^XWB(8994,5115,1,1,0)="RPC to provide Worksheet IEN based on 2507 Exam Reference Number"
^XWB(8994,5115,2,0)="^8994.02A^1^1"
^XWB(8994,5115,2,1,0)="DVBEXAM^1^^1^1"
^XWB(8994,5115,2,1,1,0)="^^1^1^3240912^"
^XWB(8994,5115,2,1,1,1,0)="Exam Reference Number Displayed to user"
^XWB(8994,5115,2,"B","DVBEXAM",1)=""
^XWB(8994,5115,2,"PARAMSEQ",1,1)=""
^XWB(8994,5115,3,0)="^^6^6^3240912^"
^XWB(8994,5115,3,1,0)="Return Worksheet IEN listed for 2507 Exam"
^XWB(8994,5115,3,2,0)="OR"
^XWB(8994,5115,3,3,0)="-1^Missing Exam Reference Number"
^XWB(8994,5115,3,4,0)="-1^Invalid Exam Reference Number"
^XWB(8994,5115,3,5,0)="-1^NO worksheet IEN found"
^XWB(8994,5115,3,6,0)="-1^Invalid Worksheet pointer saved"
^XWB(8994,5116,0)="DVBA CAPRI PN TOGGLE^PNTOG^DVBUTIL^1^R^^^1^1"
^XWB(8994,5116,1,0)="^8994.01^4^4^3240920^^"
^XWB(8994,5116,1,1,0)="This RPC will return the value of the DVBAB CAPRI PN Toggle of"
^XWB(8994,5116,1,2,0)="1 determines that TIU Notes text data should be populated in"
^XWB(8994,5116,1,3,0)="whole or 0 TIU Notes text data directing to review CAPRI for PDF text"
^XWB(8994,5116,1,4,0)="document."
^XWB(8994,5116,2,0)="^8994.02A"
^XWB(8994,5116,3,0)="^^2^2^3240920^"
^XWB(8994,5116,3,1,0)="1 sets TIU Note full value of the PDF, 0 sets TIU Note to "
^XWB(8994,5116,3,2,0)="abbreviated text to direct users to CAPRI to view PDF document."
^XWB(8994,5117,0)="SDES2 SEARCH CLINIC SLOTS^SEARCH^SDES2SEARCHSLOTS^2^R^0^^0^^^1"
^XWB(8994,5117,1,0)="^^4^4^3250214^"
^XWB(8994,5117,1,1,0)="This RPC will identify consecutive, recurring slots in a clinic based on "
^XWB(8994,5117,1,2,0)="search criteria."
^XWB(8994,5117,1,3,0)=" "
^XWB(8994,5117,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,5117,2,0)="^8994.02A^2^2"
^XWB(8994,5117,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,5117,2,1,1,0)="^^11^11^3241118^"
^XWB(8994,5117,2,1,1,1,0)=" SDCONTEXT(""ACHERON AUDIT ID"")"
^XWB(8994,5117,2,1,1,2,0)="  - Up to 40 Character unique ID number. "
^XWB(8994,5117,2,1,1,3,0)="  - Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5117,2,1,1,4,0)=" SDCONTEXT(""USER DUZ"")"
^XWB(8994,5117,2,1,1,5,0)="  - The DUZ of the user taking action in the calling application."
^XWB(8994,5117,2,1,1,6,0)=" SDCONTEXT(""USER SECID"")"
^XWB(8994,5117,2,1,1,7,0)="  - The SECID of the user taking action in the calling application."
^XWB(8994,5117,2,1,1,8,0)=" SDCONTEXT(""PATIENT DFN"")"
^XWB(8994,5117,2,1,1,9,0)="  - The DFN/IEN of the target patient from the calling application."
^XWB(8994,5117,2,1,1,10,0)=" SDCONTEXT(""PATIENT ICN"")"
^XWB(8994,5117,2,1,1,11,0)="  - The ICN of the target patient from the calling application."
^XWB(8994,5117,2,2,0)="SEARCH^2^32000^1^2"
^XWB(8994,5117,2,2,1,0)="^8994.021^32^32^3250214^^"
^XWB(8994,5117,2,2,1,1,0)="Daily:"
^XWB(8994,5117,2,2,1,2,0)="SEARCH(""START DATE"")=""2024-12-10"""
^XWB(8994,5117,2,2,1,3,0)="SEARCH(""CLINIC IEN"",1)=2164"
^XWB(8994,5117,2,2,1,4,0)="SEARCH(""LENGTH"")=90"
^XWB(8994,5117,2,2,1,5,0)="SEARCH(""AM OR PM"")=""PM"""
^XWB(8994,5117,2,2,1,6,0)="SEARCH(""NUMBER OF APPTS"")=2"
^XWB(8994,5117,2,2,1,7,0)="SEARCH(""RECURRING EVERY"")=2"
^XWB(8994,5117,2,2,1,8,0)="SEARCH(""FREQUENCY"")=""DAILY"""
^XWB(8994,5117,2,2,1,9,0)=" "
^XWB(8994,5117,2,2,1,10,0)="Weekly:"
^XWB(8994,5117,2,2,1,11,0)="SEARCH(""START DATE"")=""2024-12-09"""
^XWB(8994,5117,2,2,1,12,0)="SEARCH(""CLINIC IEN"",1)=5592"
^XWB(8994,5117,2,2,1,13,0)="SEARCH(""CLINIC IEN"",1)=4118"
^XWB(8994,5117,2,2,1,14,0)="SEARCH(""LENGTH"")=30"
^XWB(8994,5117,2,2,1,15,0)="SEARCH(""AM OR PM"")=""AM"""
^XWB(8994,5117,2,2,1,16,0)="SEARCH(""NUMBER OF APPTS"")=6"
^XWB(8994,5117,2,2,1,17,0)="SEARCH(""RECURRING EVERY"")=3"
^XWB(8994,5117,2,2,1,18,0)="SEARCH(""FREQUENCY"")=""WEEKS"""
^XWB(8994,5117,2,2,1,19,0)="SEARCH(""WEEKDAY"",1)=""THURSDAY"""
^XWB(8994,5117,2,2,1,20,0)="SEARCH(""WEEKDAY"",2)=""TUESDAY"""
^XWB(8994,5117,2,2,1,21,0)=" "
^XWB(8994,5117,2,2,1,22,0)="Monthly:"
^XWB(8994,5117,2,2,1,23,0)="SEARCH(""START DATE"")=""2024-12-09"""
^XWB(8994,5117,2,2,1,24,0)="SEARCH(""CLINIC IEN"",1)=5592"
^XWB(8994,5117,2,2,1,25,0)="SEARCH(""LENGTH"")=30"
^XWB(8994,5117,2,2,1,26,0)="SEARCH(""AM OR PM"")=""PM"""
^XWB(8994,5117,2,2,1,27,0)="SEARCH(""NUMBER OF APPTS"")=6"
^XWB(8994,5117,2,2,1,28,0)="SEARCH(""RECURRING EVERY"")=4"
^XWB(8994,5117,2,2,1,29,0)="SEARCH(""OCCURRING EVERY"")=2"
^XWB(8994,5117,2,2,1,30,0)="SEARCH(""FREQUENCY"")=""MONTHS"""
^XWB(8994,5117,2,2,1,31,0)="SEARCH(""WEEKDAY"",1)=""TUESDAY"""
^XWB(8994,5117,2,2,1,32,0)="SEARCH(""WEEKDAY"",2)=""THURSDAY"""
