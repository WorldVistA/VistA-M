^XWB(8994,4927,3,9,0)=" "
^XWB(8994,4927,3,10,0)="  -1^*error message*"
^XWB(8994,4928,0)="DSSO GET MESSAGES^GET^DSSOPPH^4^A^^^1"
^XWB(8994,4928,1,0)="^8994.01^1^1^3211018^^"
^XWB(8994,4928,1,1,0)="This RPC will retreive a number of errors/messages from the #23645.2 file."
^XWB(8994,4928,2,0)="^8994.02A^3^2"
^XWB(8994,4928,2,2,0)="DSSONUM^1^4^0^1"
^XWB(8994,4928,2,2,1,0)="^^3^3^3211102^"
^XWB(8994,4928,2,2,1,1,0)="This is the number of messages to be returned with each call to the RPC."
^XWB(8994,4928,2,2,1,2,0)=" "
^XWB(8994,4928,2,2,1,3,0)="Defaults to all records."
^XWB(8994,4928,2,3,0)="DSSOIEN^1^30^0^2"
^XWB(8994,4928,2,3,1,0)="^8994.021^3^3^3211202^^"
^XWB(8994,4928,2,3,1,1,0)="IEN of message from which to start."
^XWB(8994,4928,2,3,1,2,0)=" "
^XWB(8994,4928,2,3,1,3,0)="Defaults to end of record."
^XWB(8994,4928,2,"B","DSSOIEN",3)=""
^XWB(8994,4928,2,"B","DSSONUM",2)=""
^XWB(8994,4928,2,"PARAMSEQ",1,2)=""
^XWB(8994,4928,2,"PARAMSEQ",2,3)=""
^XWB(8994,4928,3,0)="^^21^21^3211108^"
^XWB(8994,4928,3,1,0)="The results of the RPC will be formatted as follows:"
^XWB(8994,4928,3,2,0)=" "
^XWB(8994,4928,3,3,0)="  RESULT(0) = p1^p2"
^XWB(8994,4928,3,4,0)="    p1 = An indicator of it the end of record has been reached"
^XWB(8994,4928,3,5,0)="           $$MORE$$ = End of record not reached"
^XWB(8994,4928,3,6,0)="            $$END$$ = The end of the record was reached"
^XWB(8994,4928,3,7,0)="    p2 = If the end of the record was not reached, this will contain the"
^XWB(8994,4928,3,8,0)="         last IEN to be returned and should be input into the next RPC"
^XWB(8994,4928,3,9,0)="         instance."
^XWB(8994,4928,3,10,0)=" "
^XWB(8994,4928,3,11,0)="  RESULT(1-n) = p1^p2^p3^p4^p5^p6^p7"
^XWB(8994,4928,3,12,0)="    p1 = Message IEN            p7 = Station IEN"
^XWB(8994,4928,3,13,0)="    p2 = Message ID             p8 = Message Text"
^XWB(8994,4928,3,14,0)="    p3 = Message Type           p9 = Patient Name"
^XWB(8994,4928,3,15,0)="    p4 = Status                p10 = Item (File #660, Field #4) "
^XWB(8994,4928,3,16,0)="    p5 = Date Processed        p11 = PSAS HCPCS"
^XWB(8994,4928,3,17,0)="    p6 = File #660 IEN"
^XWB(8994,4928,3,18,0)=" "
^XWB(8994,4928,3,19,0)="In the event of an error, the result will be formatted as follows:"
^XWB(8994,4928,3,20,0)=" "
^XWB(8994,4928,3,21,0)="  RESULT(0) = -1^*error message*"
