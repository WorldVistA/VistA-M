^XWB(8994,5178,0)="ORSPECAUTH UPDATEORDERSA^UPDATEORDERSA^ORSPECAUTH^2^^^^0"
^XWB(8994,5178,1,0)="^^3^3^3241203^"
^XWB(8994,5178,1,1,0)="This RPC will save the orders special authority values selected into the "
^XWB(8994,5178,1,2,0)="ORDERS file (#100) SPECIAL AUTHORITIES field (#112) in multiple"
^XWB(8994,5178,1,3,0)="file (#100.112)."
^XWB(8994,5178,2,0)="^8994.02A^3^2"
^XWB(8994,5178,2,2,0)="JSONIN^1^^1^1"
^XWB(8994,5178,2,2,1,0)="^^56^56^3241216^"
^XWB(8994,5178,2,2,1,1,0)="A JSON string passed to save order(s) and their SA answers."
^XWB(8994,5178,2,2,1,2,0)="  "
^XWB(8994,5178,2,2,1,3,0)=" JSON elements:"
^XWB(8994,5178,2,2,1,4,0)="   patientId       = patient unique numeric DFN"
^XWB(8994,5178,2,2,1,5,0)="   orders          = section for 1 to may orders signed at once."
^XWB(8994,5178,2,2,1,6,0)="    orderId         = unique order number in ORDERS file (#100)."
^XWB(8994,5178,2,2,1,7,0)="    specialAuthoriy = SA secftion for multiple SA indicators"
^XWB(8994,5178,2,2,1,8,0)="     id              = SA unique number in  SPECIAL AUTHORITIES file "
^XWB(8994,5178,2,2,1,9,0)="(#820)"
^XWB(8994,5178,2,2,1,10,0)="     value           = yes/no"
^XWB(8994,5178,2,2,1,11,0)="  "
^XWB(8994,5178,2,2,1,12,0)="  "
^XWB(8994,5178,2,2,1,13,0)=" Example JSON msg:"
^XWB(8994,5178,2,2,1,14,0)="  "
