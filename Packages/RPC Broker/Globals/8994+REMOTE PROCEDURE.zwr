^XWB(8994,3806,1,1,0)="This RPC will return entries from the MUSE FORMAT TABLE"
^XWB(8994,3806,2,0)="^8994.02A^1^1"
^XWB(8994,3806,2,1,0)="IEN^1^30^1^1"
^XWB(8994,3806,2,1,1,0)="^8994.021^8^8^3180113^^^^"
^XWB(8994,3806,2,1,1,1,0)="IEN=nnn, or IEN='SITE'  or IEN='ALL'"
^XWB(8994,3806,2,1,1,2,0)=" nnn is the IEN from NETWORK LOCATION File for the MUSE System."
^XWB(8994,3806,2,1,1,3,0)="  If IEN=nnn then all entries in the MUSE FORMAT TABLE for"
^XWB(8994,3806,2,1,1,4,0)="that MUSE System will be returned."
^XWB(8994,3806,2,1,1,5,0)="  If IEN='SITE', then all entries in the  MUSE FORMAT TABLE"
^XWB(8994,3806,2,1,1,6,0)=" File will be returned."
^XWB(8994,3806,2,1,1,7,0)="  If IEN='ALL' then all entries in the MUSE FORMAT TABLE"
^XWB(8994,3806,2,1,1,8,0)=" File will be returned. Including the Default Format IDs."
^XWB(8994,3806,2,"B","IEN",1)=""
^XWB(8994,3806,2,"PARAMSEQ",1,1)=""
^XWB(8994,3806,3,0)="^8994.03^7^7^3180113^^^^"
^XWB(8994,3806,3,1,0)="Array of entries in the MUSE FORMAT TABLE."
^XWB(8994,3806,3,2,0)="Format of each entry in the Array is : "
^XWB(8994,3806,3,3,0)="  Piece 1: NETWORK LOCATION Name"
^XWB(8994,3806,3,4,0)="  Piece 2: NETWORK LOCATION IEN"
^XWB(8994,3806,3,5,0)="  Piece 3: TEST TYPE"
^XWB(8994,3806,3,6,0)="  Piece 4: YES/NO if a Grid is displayed"
^XWB(8994,3806,3,7,0)="  Piece 5: Format ID Number"
^XWB(8994,3807,0)="MAG5 GET NETLOC INFO^NETLOC^MAGGTU4M^1^R"
^XWB(8994,3807,1,0)="^8994.01^3^3^3180105^^"
^XWB(8994,3807,1,1,0)="Returns a string of information from NETWORK LOCATION File."
^XWB(8994,3807,1,2,0)="Information includes:"
^XWB(8994,3807,1,3,0)="Description (.01), Physical Refernece (1), Operational Status (5)"
^XWB(8994,3807,2,0)="^8994.02A^1^1"
^XWB(8994,3807,2,1,0)="IEN^1^20^1^1"
^XWB(8994,3807,2,1,1,0)="^8994.021^1^1^3180105^^"
^XWB(8994,3807,2,1,1,1,0)="Internal Entry number for NETWORK LOCATION FILE."
^XWB(8994,3807,2,"B","IEN",1)=""
^XWB(8994,3807,2,"PARAMSEQ",1,1)=""
^XWB(8994,3807,3,0)="^8994.03^4^4^3180105^^"
^XWB(8994,3807,3,1,0)="String returned in format : "
^XWB(8994,3807,3,2,0)="Description ^ Physical Reference ^ Operational Status."
^XWB(8994,3807,3,3,0)=" example :"
^XWB(8994,3807,3,4,0)="  MUSE-9  ^    \\Server\Vol000\  ^         OnLine"
^XWB(8994,3808,0)="DENTVPCE PCE PRIMARY^PCE^DENTVPCE^1^A^^^1"
^XWB(8994,3808,1,0)="^8994.01^1^1^3150610^^"
^XWB(8994,3808,1,1,0)="This RPC returns the PCE primary diagnosis and PCE primary provider."
^XWB(8994,3808,2,0)="^8994.02A^1^1"
^XWB(8994,3808,2,1,0)="IEN^1^30^1^1"
^XWB(8994,3808,2,1,1,0)="^8994.021^2^2^3150610^^"
^XWB(8994,3808,2,1,1,1,0)="This is the VISIT IEN you wish to determine the Primary Diagnosis and "
^XWB(8994,3808,2,1,1,2,0)="Provider."
^XWB(8994,3808,2,"B","IEN",1)=""
^XWB(8994,3808,2,"PARAMSEQ",1,1)=""
^XWB(8994,3808,3,0)="^8994.03^10^10^3150610^^"
^XWB(8994,3808,3,1,0)="If successful, the return will be formatted as follows:"
^XWB(8994,3808,3,2,0)=" "
^XWB(8994,3808,3,3,0)="  List[1] = p1^p2^p3^p4"
^XWB(8994,3808,3,4,0)=" "
^XWB(8994,3808,3,5,0)="    p1 = Short Description"
^XWB(8994,3808,3,6,0)="    p2 = Diagnosis Code"
^XWB(8994,3808,3,7,0)="    p3 = Provider IEN"
^XWB(8994,3808,3,8,0)="    p4 = Provider Name"
^XWB(8994,3808,3,9,0)=" "
^XWB(8994,3808,3,10,0)="If an error occurs, the return will be: -1^error message"
^XWB(8994,3809,0)="DENTV GET COMPLICATIONS^GETCOMP^DENTVTP2^4^^^^1"
^XWB(8994,3809,1,0)="^8994.01^2^2^3170307^^"
^XWB(8994,3809,1,1,0)="This RPC uses a Patient IEN to retreive a list of complications for a"
^XWB(8994,3809,1,2,0)="given encounter."
^XWB(8994,3809,2,0)="^8994.02A^1^1"
^XWB(8994,3809,2,1,0)="DENTDFN^1^30^1^1"
^XWB(8994,3809,2,1,1,0)="^8994.021^1^1^3170307^^"
^XWB(8994,3809,2,1,1,1,0)="This is the IEN of the patient for which you wish to retrieve."
^XWB(8994,3809,2,"B","DENTDFN",1)=""
^XWB(8994,3809,2,"PARAMSEQ",1,1)=""
^XWB(8994,3809,3,0)="^^26^26^3170307^"
^XWB(8994,3809,3,1,0)="The return is formatted as follows:"
^XWB(8994,3809,3,2,0)=" "
^XWB(8994,3809,3,3,0)="    List[1] = p"
^XWB(8994,3809,3,4,0)="      p1 = Active Complication Flag"
^XWB(8994,3809,3,5,0)=" "
^XWB(8994,3809,3,6,0)="All subsequent date will be sorted into chunks formatted as follows:"
^XWB(8994,3809,3,7,0)=" "
^XWB(8994,3809,3,8,0)="    List[n] = $$START$$"
^XWB(8994,3809,3,9,0)=" "
^XWB(8994,3809,3,10,0)="  List[n+1] = p1^p2^p3"
^XWB(8994,3809,3,11,0)=" "
^XWB(8994,3809,3,12,0)="      p1 = Encounter IEN"
^XWB(8994,3809,3,13,0)="      p2 = Provider IEN;Provider Name"
^XWB(8994,3809,3,14,0)="      p3 = Visit IEN;Visit Date"
^XWB(8994,3809,3,15,0)=" "
^XWB(8994,3809,3,16,0)="  List[n+2] = p1^p2^p3^p4^p5"
^XWB(8994,3809,3,17,0)=" "
^XWB(8994,3809,3,18,0)="      p1 = Complication IEN"
^XWB(8994,3809,3,19,0)="      p2 = Complicaiton Type"
^XWB(8994,3809,3,20,0)="      p3 = Complication Status"
^XWB(8994,3809,3,21,0)="      p4 = Entry Date"
^XWB(8994,3809,3,22,0)="      p5 = Resolved Date"
^XWB(8994,3809,3,23,0)=" "
^XWB(8994,3809,3,24,0)="  List[n+m] = Description (Individual Word Processing Lines)"
^XWB(8994,3809,3,25,0)=" "
^XWB(8994,3809,3,26,0)="If an error occurs, the result will be -1^Error Message."
^XWB(8994,3810,0)="DENTV ADD/EDIT COMPLICATIONS^COMP^DENTVTP2^1^A^^^1"
^XWB(8994,3810,1,0)="^8994.01^2^2^3170307^^^^"
^XWB(8994,3810,1,1,0)="This RPC allows for adding, editing, and deleting complications from a "
^XWB(8994,3810,1,2,0)="dental encounter."
^XWB(8994,3810,2,0)="^8994.02A^2^2"
^XWB(8994,3810,2,1,0)="DENTENC^1^30^1^1"
^XWB(8994,3810,2,1,1,0)="^8994.021^2^2^3170307^^"
^XWB(8994,3810,2,1,1,1,0)="This is the dental encounter IEN for which to wish to make complication "
^XWB(8994,3810,2,1,1,2,0)="modifications."
^XWB(8994,3810,2,2,0)="DATA^2^240^1^2"
^XWB(8994,3810,2,2,1,0)="^8994.021^12^12^3170307^^"
^XWB(8994,3810,2,2,1,1,0)="This data array contains the data you wish to add, edit, or delete from "
^XWB(8994,3810,2,2,1,2,0)="the dental encounter.  The input array should be formatted in chunks as"
^XWB(8994,3810,2,2,1,3,0)="follows:"
^XWB(8994,3810,2,2,1,4,0)=" "
^XWB(8994,3810,2,2,1,5,0)="    List[n] = $$START$$"
^XWB(8994,3810,2,2,1,6,0)=" "
^XWB(8994,3810,2,2,1,7,0)="  List[n+1] = p1^p2^p3"
^XWB(8994,3810,2,2,1,8,0)="    p1 = Complication IEN (values denoted with a ""+"" are additions)"
^XWB(8994,3810,2,2,1,9,0)="    p2 = Complication Type"
^XWB(8994,3810,2,2,1,10,0)="    p3 = Complication Status"
^XWB(8994,3810,2,2,1,11,0)=" "
^XWB(8994,3810,2,2,1,12,0)="  List[n+m] = Description word processing lines"
^XWB(8994,3810,2,"B","DATA",2)=""
^XWB(8994,3810,2,"B","DENTENC",1)=""
^XWB(8994,3810,2,"PARAMSEQ",1,1)=""
^XWB(8994,3810,2,"PARAMSEQ",2,2)=""
^XWB(8994,3810,3,0)="^^12^12^3170307^"
^XWB(8994,3810,3,1,0)="If successful, the return will be formatted as:"
^XWB(8994,3810,3,2,0)="  "
^XWB(8994,3810,3,3,0)="  List[1] = 0^Records successfully added, edited, or deleted:"
^XWB(8994,3810,3,4,0)=" "
^XWB(8994,3810,3,5,0)="Which will be immediately followed by a list of complication numbers "
^XWB(8994,3810,3,6,0)="followed by one of the following flags to denote action taken:"
^XWB(8994,3810,3,7,0)=" "
^XWB(8994,3810,3,8,0)="  A = Add"
^XWB(8994,3810,3,9,0)="  E = Edit"
^XWB(8994,3810,3,10,0)="  D = Delete"
^XWB(8994,3810,3,11,0)=" "
^XWB(8994,3810,3,12,0)="If an error occurs, the return will be -1^error message."
^XWB(8994,3811,0)="DENTVTPC SET DEVICE^SETDEV^DENTVTPC^1^A^^^1"
^XWB(8994,3811,1,0)="^8994.01^1^1^3170307^^^"
^XWB(8994,3811,1,1,0)="This RPC takes in data for filing to the DENTAL IMPLANTS (#228.9) file."
^XWB(8994,3811,2,0)="^8994.02A^1^1"
^XWB(8994,3811,2,1,0)="DENTDATA^2^255^1^1"
^XWB(8994,3811,2,1,1,0)="^^21^21^3170307^"
^XWB(8994,3811,2,1,1,1,0)="This is the array containing data to be filed to DENTAL IMPLANTS (#228.9)."
^XWB(8994,3811,2,1,1,2,0)=" "
^XWB(8994,3811,2,1,1,3,0)="It should be formatted as follows:"
^XWB(8994,3811,2,1,1,4,0)=" "
^XWB(8994,3811,2,1,1,5,0)="  List[1] = p1^p2^p2^p4^p5^p6^p7^p8^p9^p10^p11^p12^p13^p14"
^XWB(8994,3811,2,1,1,6,0)="            ^p15^p16^p17^p18^p19^p20^p21^p22^p23^p24"
^XWB(8994,3811,2,1,1,7,0)=" "
^XWB(8994,3811,2,1,1,8,0)="     p1 = Implant ID              p13 = Serial #"
^XWB(8994,3811,2,1,1,9,0)="     p2 = Provider IEN            p14 = Lot #"
^XWB(8994,3811,2,1,1,10,0)="     p3 = Patient IEN             p15 = Status"
^XWB(8994,3811,2,1,1,11,0)="     p4 = Dental Transaction IEN  p16 = Entry Date"
^XWB(8994,3811,2,1,1,12,0)="     p5 = Date                    p17 = Removed Date"
^XWB(8994,3811,2,1,1,13,0)="     p6 = Description/Code        p18 = Last Edit Provider"
^XWB(8994,3811,2,1,1,14,0)="     p7 = Tooth                   p19 = Last Edit Date"
^XWB(8994,3811,2,1,1,15,0)="     p8 = UDI                     p20 = Issuing Agency"
^XWB(8994,3811,2,1,1,16,0)="     p9 = Type                    p21 = Manufacturer Date"
^XWB(8994,3811,2,1,1,17,0)="    p10 = Subtype                 p22 = Expiration Date"
^XWB(8994,3811,2,1,1,18,0)="    p11 = Manufacturer            p23 = Donation ID"
^XWB(8994,3811,2,1,1,19,0)="    p12 = Model #                 P24 = Visit Date"
^XWB(8994,3811,2,1,1,20,0)=" "
^XWB(8994,3811,2,1,1,21,0)="  List[Wm] = Word processing lines"
^XWB(8994,3811,2,"B","DENTDATA",1)=""
^XWB(8994,3811,2,"PARAMSEQ",1,1)=""
^XWB(8994,3811,3,0)="^8994.03^3^3^3170307^^^"
^XWB(8994,3811,3,1,0)="If successful, the results will be IEN^message."
^XWB(8994,3811,3,2,0)=" "
^XWB(8994,3811,3,3,0)="If unsuccessful, the results will be -1^error_message."
^XWB(8994,3812,0)="DENTVTPC GET DEVICE^GETDEV^DENTVTPC^4^A^^^1"
^XWB(8994,3812,1,0)="^^1^1^3170307^"
^XWB(8994,3812,1,1,0)="This RPC gets data for all dental implants for a given patient."
^XWB(8994,3812,2,0)="^8994.02A^1^1"
^XWB(8994,3812,2,1,0)="DENTDFN^1^30^1^1"
^XWB(8994,3812,2,1,1,0)="^8994.021^1^1^3170307^^^"
^XWB(8994,3812,2,1,1,1,0)="This is the patient's IEN."
^XWB(8994,3812,2,"B","DENTDFN",1)=""
^XWB(8994,3812,2,"PARAMSEQ",1,1)=""
^XWB(8994,3812,3,0)="^^24^24^3170307^"
^XWB(8994,3812,3,1,0)="If successful, the result will be formatted as follows:"
^XWB(8994,3812,3,2,0)=" "
^XWB(8994,3812,3,3,0)="  List[1] = $$DDT$$^p1^p2^p2^p4^p5^p6^p7^p8^p9^p10^p11^p12^p13"
^XWB(8994,3812,3,4,0)="            ^p14^p15^p16^p17^p18^p19^p20^p21^p22^p23^p24"
^XWB(8994,3812,3,5,0)=" "
^XWB(8994,3812,3,6,0)="     p1 = Implant ID              p13 = Serial #"
^XWB(8994,3812,3,7,0)="     p2 = Provider IEN            p14 = Lot #"
^XWB(8994,3812,3,8,0)="     p3 = Patient IEN             p15 = Status"
^XWB(8994,3812,3,9,0)="     p4 = Dental Transaction IEN  p16 = Entry Date"
^XWB(8994,3812,3,10,0)="     p5 = Date                    p17 = Removed Date"
^XWB(8994,3812,3,11,0)="     p6 = Description/Code        p18 = Last Edit Provider"
^XWB(8994,3812,3,12,0)="     p7 = Tooth                   p19 = Last Edit Date"
^XWB(8994,3812,3,13,0)="     p8 = UDI                     p20 = Issuing Agency"
^XWB(8994,3812,3,14,0)="     p9 = Type                    p21 = Manufacturer Date"
^XWB(8994,3812,3,15,0)="    p10 = Subtype                 p22 = Expiration Date"
^XWB(8994,3812,3,16,0)="    p11 = Manufacturer            p23 = Donation ID"
^XWB(8994,3812,3,17,0)="    p12 = Model #                 p24 = Visit Date"
^XWB(8994,3812,3,18,0)=" "
^XWB(8994,3812,3,19,0)="If the data is longer than 250 characters (including label), it will be "
^XWB(8994,3812,3,20,0)="continued in subsequent nodes."
^XWB(8994,3812,3,21,0)=" "
^XWB(8994,3812,3,22,0)="  List[n] = $$DDTWP$$^Word processing lines"
^XWB(8994,3812,3,23,0)=" "
^XWB(8994,3812,3,24,0)="If an error occurs, the result will be -1^error_message."
^XWB(8994,3813,0)="DENTVTPC DELETE DEVICE^DELDEV^DENTVTPC^1^A^^^1"
^XWB(8994,3813,1,0)="^8994.01^1^1^3170307^^^"
^XWB(8994,3813,1,1,0)="This is a RPC interface for the default device deleting trigger."
^XWB(8994,3813,2,0)="^8994.02A^1^1"
^XWB(8994,3813,2,1,0)="DENTXN^1^30^1^1"
^XWB(8994,3813,2,1,1,0)="^8994.021^2^2^3170307^^"
^XWB(8994,3813,2,1,1,1,0)="This is the dental transaction IEN (#228.2) for which you wish to delete "
^XWB(8994,3813,2,1,1,2,0)="all associated dental devices."
^XWB(8994,3813,2,"B","DENTXN",1)=""
^XWB(8994,3813,2,"PARAMSEQ",1,1)=""
^XWB(8994,3813,3,0)="^8994.03^3^3^3170307^^"
^XWB(8994,3813,3,1,0)="If the dental devices were successfully marked as deleted, the result "
^XWB(8994,3813,3,2,0)="will be ""1^Successfully deleted associated dental devices:"" followed by a "
^XWB(8994,3813,3,3,0)="list of device IENs."
^XWB(8994,3814,0)="DENTVAU LIST REPORTS^LIST^DENTVAU^4^A^^^1"
^XWB(8994,3814,1,0)="^^2^2^3160912^"
^XWB(8994,3814,1,1,0)="This RPC returns a list of reports, both queued, in progess, and "
^XWB(8994,3814,1,2,0)="completed."
^XWB(8994,3814,3,0)="^^10^10^3160912^"
^XWB(8994,3814,3,1,0)="The results of the RPC will be formatted as follows:"
^XWB(8994,3814,3,2,0)=" "
^XWB(8994,3814,3,3,0)="  DENTRET(n) = p1^p2^p3^p4^p5^p6^p7"
^XWB(8994,3814,3,4,0)=" "
^XWB(8994,3814,3,5,0)="    p1 = Report Owner          p5 = Date/Time Schedule"
^XWB(8994,3814,3,6,0)="    p2 = Report Type           p6 = Purge Date"
^XWB(8994,3814,3,7,0)="    p3 = Report Handle         p7 = Parameters"
^XWB(8994,3814,3,8,0)="    p4 = Percentage Complete"
^XWB(8994,3814,3,9,0)=" "
^XWB(8994,3814,3,10,0)="If an error occurs, the result will be -1^error_message."
^XWB(8994,3815,0)="DENTVAU CHUNK REPORTS^CHUNK^DENTVAU^4^A^^^1"
^XWB(8994,3815,1,0)="^8994.01^2^2^3170207^^^^"
^XWB(8994,3815,1,1,0)="This RPC allows the GUI to both queue and poll dental reports utilizing "
^XWB(8994,3815,1,2,0)="chunking of data returned."
^XWB(8994,3815,2,0)="^8994.02A^5^5"
^XWB(8994,3815,2,1,0)="DENTRPT^1^2^1^1"
^XWB(8994,3815,2,1,1,0)="^^7^7^3170207^"
^XWB(8994,3815,2,1,1,1,0)="This is the index of the report type you wish to run:"
^XWB(8994,3815,2,1,1,2,0)=" "
^XWB(8994,3815,2,1,1,3,0)="  D = Delete Indicated Report via Handle"
^XWB(8994,3815,2,1,1,4,0)="  1 = Dental Device Report"
^XWB(8994,3815,2,1,1,5,0)="  2 = Adverse Events Report"
^XWB(8994,3815,2,1,1,6,0)=" "
^XWB(8994,3815,2,1,1,7,0)="This parameter is not required when polling for report data."
^XWB(8994,3815,2,2,0)="DENTTIME^1^14^0^2"
^XWB(8994,3815,2,2,1,0)="^^4^4^3160913^"
^XWB(8994,3815,2,2,1,1,0)="This is the date/time at which you wish to schedule the report to run."
^XWB(8994,3815,2,2,1,2,0)=" "
^XWB(8994,3815,2,2,1,3,0)="This parameter is not required and if not passed will default to schedule "
^XWB(8994,3815,2,2,1,4,0)="the report to process as soon as possible."
^XWB(8994,3815,2,3,0)="DENTHNDL^1^50^0^3"
^XWB(8994,3815,2,3,1,0)="^^7^7^3160913^"
^XWB(8994,3815,2,3,1,1,0)="This is the handle by which a report can be identified."
^XWB(8994,3815,2,3,1,2,0)=" "
^XWB(8994,3815,2,3,1,3,0)="If not passed in, the handle will default to "
^XWB(8994,3815,2,3,1,4,0)="current_date/time~user_DUZ~report_type."
^XWB(8994,3815,2,3,1,5,0)=" "
^XWB(8994,3815,2,3,1,6,0)="If handle is passed in and a report with the given handle does not exist, "
^XWB(8994,3815,2,3,1,7,0)="a new report will be generated with the input handle."
^XWB(8994,3815,2,4,0)="DENTSTRT^1^30^0^4"
^XWB(8994,3815,2,4,1,0)="^^3^3^3170207^"
^XWB(8994,3815,2,4,1,1,0)="This is the last IEN returned in the previous data chunk.  If not passed "
^XWB(8994,3815,2,4,1,2,0)="in, the RPC assumes this is an initial call and will start returning data "
^XWB(8994,3815,2,4,1,3,0)="from the beginning."
^XWB(8994,3815,2,5,0)="DENTPAR^2^245^0^5"
^XWB(8994,3815,2,5,1,0)="^^13^13^3170222^"
^XWB(8994,3815,2,5,1,1,0)="This parameter can store multiple parameters which you want to pass into "
^XWB(8994,3815,2,5,1,2,0)="reports.  Below are the available parameters for each report:"
^XWB(8994,3815,2,5,1,3,0)=" "
^XWB(8994,3815,2,5,1,4,0)="  DEVICE TRACKING: n/a"
^XWB(8994,3815,2,5,1,5,0)="  ADVERSE EVENTS:"
^XWB(8994,3815,2,5,1,6,0)="    DENTPAR(""START"")  = Starting date"
^XWB(8994,3815,2,5,1,7,0)="    DENTPAR(""END"")    = Ending date"
^XWB(8994,3815,2,5,1,8,0)="    DENTPAR(""STATUS"") = The statuses you wish to have returned."
^XWB(8994,3815,2,5,1,9,0)="                        Each status is to be delimited by "";"""
^XWB(8994,3815,2,5,1,10,0)="                        (i.e. ""0;2"")."
^XWB(8994,3815,2,5,1,11,0)="                        0 = Active"
^XWB(8994,3815,2,5,1,12,0)="                        1 = Resolved"
^XWB(8994,3815,2,5,1,13,0)="                        2 = Deleted"
^XWB(8994,3815,2,"B","DENTHNDL",3)=""
^XWB(8994,3815,2,"B","DENTPAR",5)=""
^XWB(8994,3815,2,"B","DENTRPT",1)=""
^XWB(8994,3815,2,"B","DENTSTRT",4)=""
^XWB(8994,3815,2,"B","DENTTIME",2)=""
^XWB(8994,3815,2,"PARAMSEQ",1,1)=""
^XWB(8994,3815,2,"PARAMSEQ",2,2)=""
^XWB(8994,3815,2,"PARAMSEQ",3,3)=""
^XWB(8994,3815,2,"PARAMSEQ",4,4)=""
^XWB(8994,3815,2,"PARAMSEQ",5,5)=""
^XWB(8994,3815,3,0)="^8994.03^31^31^3170130^^^"
^XWB(8994,3815,3,1,0)="If queuing a new report, the results will be formatted as follows:"
^XWB(8994,3815,3,2,0)=" "
^XWB(8994,3815,3,3,0)="  List[1] = p1^p2"
^XWB(8994,3815,3,4,0)=" "
^XWB(8994,3815,3,5,0)="    p1 = Task #      p2 = Report Handle"
^XWB(8994,3815,3,6,0)=" "
^XWB(8994,3815,3,7,0)=" "
^XWB(8994,3815,3,8,0)="If polling for data, the results will be formatted as follows:"
^XWB(8994,3815,3,9,0)=" "
^XWB(8994,3815,3,10,0)="  List[n] = Report Data will be unique to each report type,"
^XWB(8994,3815,3,11,0)="             though some common elements include:"
^XWB(8994,3815,3,12,0)=" "
^XWB(8994,3815,3,13,0)="            $$APPEND$$ = Data returned for a single entry is"
^XWB(8994,3815,3,14,0)="                          greater than the RPC Broker can"
^XWB(8994,3815,3,15,0)="                          handle, therefore any node with this"
^XWB(8994,3815,3,16,0)="                          prefix is a continuation of the data"
^XWB(8994,3815,3,17,0)="                          from the previous node."
^XWB(8994,3815,3,18,0)="                $$WP$$ = This prefix indicates Word Processing"
^XWB(8994,3815,3,19,0)="                          data associated with the previous"
^XWB(8994,3815,3,20,0)="                          data entry."
^XWB(8994,3815,3,21,0)=" "
^XWB(8994,3815,3,22,0)=" "
^XWB(8994,3815,3,23,0)="If deleting a report, the results will be formatted as follows:"
^XWB(8994,3815,3,24,0)=" "
^XWB(8994,3815,3,25,0)="  List[1] = 1^*report handle* report deleted"
^XWB(8994,3815,3,26,0)=" "
^XWB(8994,3815,3,27,0)=" "
^XWB(8994,3815,3,28,0)="If an error occurs in any of these scenarios, the result will be"
^XWB(8994,3815,3,29,0)=" formatted as follows:"
^XWB(8994,3815,3,30,0)=" "
^XWB(8994,3815,3,31,0)="  List[1] = -1^error_message"
^XWB(8994,3816,0)="SDEC BOOKHLDY^BOOKHLDY^SDEC^1^P^0^^^1"
^XWB(8994,3816,1,0)="^^2^2^3171201^"
