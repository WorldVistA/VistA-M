^XWB(8994,4927,2,"PARAMSEQ",2,2)=""
^XWB(8994,4927,2,"PARAMSEQ",3,3)=""
^XWB(8994,4927,3,0)="^8994.03^10^10^3221214^^"
^XWB(8994,4927,3,1,0)="If the process completes successfully, the results will be returned in "
