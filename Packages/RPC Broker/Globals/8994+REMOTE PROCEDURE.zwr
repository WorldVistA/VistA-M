^XWB(8994,3491,2,"PARAMSEQ",3,3)=""
^XWB(8994,3491,2,"PARAMSEQ",4,4)=""
^XWB(8994,3491,3,0)="^^7^7^3150128^"
^XWB(8994,3491,3,1,0)="Returns a Global Array in which each array entry contains letter data for "
^XWB(8994,3491,3,2,0)="the passed in Resources separated by ^:"
^XWB(8994,3491,3,3,0)="  1. RESOURCEID"
^XWB(8994,3491,3,4,0)="  2. RESOURCE_NAME"
^XWB(8994,3491,3,5,0)="  3. LETTER_TEXT"
^XWB(8994,3491,3,6,0)="  4. NO_SHOW_LETTER"
^XWB(8994,3491,3,7,0)="  5. CLINIC_CANCELLATION_LETTER"
^XWB(8994,3492,0)="SDEC RESLETRF^RESLETRF^SDEC^4^R^0^^0"
^XWB(8994,3492,1,0)="^8994.01^3^3^3150128^^"
^XWB(8994,3492,1,1,0)="Return formatted text output of the Resource's Letter - either ""LETTER "
^XWB(8994,3492,1,2,0)="TEXT"" (also used as Reminder Letter), NO SHOW LETTER, or CLINIC "
^XWB(8994,3492,1,3,0)="CANCELLATION LETTER."
