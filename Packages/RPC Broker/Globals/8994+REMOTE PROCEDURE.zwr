^XWB(8994,4352,2,"PARAMSEQ",2,2)=""
^XWB(8994,4352,3,0)="^8994.03^23^23^3160516^^"
^XWB(8994,4352,3,1,0)="Output:"
^XWB(8994,4352,3,2,0)="  Error Messages:  ""-1^""_error message or ""0^""_warning message"
^XWB(8994,4352,3,3,0)="  Successful Completion:"
^XWB(8994,4352,3,4,0)="    DSSORET(n) = a global array containing all sites in the"
^XWB(8994,4352,3,5,0)="      Prosthetic Site Parameters file (#669.9) with IFCAP Site"
^XWB(8994,4352,3,6,0)="      equal to the requested station IFN.  "
^XWB(8994,4352,3,7,0)="        If the processing flag is null, all sites with IFCAP Site"
^XWB(8994,4352,3,8,0)="          equal to the requested station IFN will be returned."
^XWB(8994,4352,3,9,0)=" "
^XWB(8994,4352,3,10,0)="        If the processing flag equals 1, then only those sites with "
^XWB(8994,4352,3,11,0)="        IFCAP site equal to the requested station IFN and with the "
^XWB(8994,4352,3,12,0)="        Automated Inventory (GIP) field (file 669.9 field #2) set to ""YES"""
^XWB(8994,4352,3,13,0)="        will be returned."
^XWB(8994,4352,3,14,0)=" "
^XWB(8994,4352,3,15,0)="        Format:  p1 ^ p2 ^ p3 ^ p4 ^ p5 ^ p6"
^XWB(8994,4352,3,16,0)="         where:  p1 = Site Name - file 669.9 IEN (field .01 (internal))"
^XWB(8994,4352,3,17,0)="                 p2 = Site Name - file 669.9 IEN (field .01 (external))"
^XWB(8994,4352,3,18,0)="                 p3 = IFCAP Site - file 669.9 field 1.1 (internal)"
^XWB(8994,4352,3,19,0)="                 p4 = Institution Name - file 411 field .1 (external)"
^XWB(8994,4352,3,20,0)="                 p5 = Automated Inventory (GIP ) - file 669.9 field 2"
^XWB(8994,4352,3,21,0)="                      (internal)"
^XWB(8994,4352,3,22,0)="                 p6 = Automated Inventory (GIP) - file 669.9 field 2"
^XWB(8994,4352,3,23,0)="                      (external)"
