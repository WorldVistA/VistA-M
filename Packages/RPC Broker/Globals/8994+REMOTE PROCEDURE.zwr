^XWB(8994,3626,3,0)="^^3^3^3151222^"
^XWB(8994,3626,3,1,0)="an array of codes and messages:"
^XWB(8994,3626,3,2,0)="   code ^ message"
^XWB(8994,3626,3,3,0)="   code -   -1=error   -2=message to be displayed to the user"
^XWB(8994,3627,0)="SDECAPP GETYPE^GETYPE^SDECAPP^4^R^0^^0"
^XWB(8994,3627,1,0)="^^1^1^3160105^"
^XWB(8994,3627,1,1,0)="GET Appointment Type for the given SDEC APPOINTMENT."
^XWB(8994,3627,2,0)="^8994.02A^1^1"
