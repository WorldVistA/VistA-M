^XWB(8994,3489,2,"PARAMSEQ",1,1)=""
^XWB(8994,3489,2,"PARAMSEQ",2,2)=""
^XWB(8994,3489,2,"PARAMSEQ",3,3)=""
^XWB(8994,3489,2,"PARAMSEQ",4,4)=""
^XWB(8994,3489,2,"PARAMSEQ",5,5)=""
^XWB(8994,3489,2,"PARAMSEQ",6,6)=""
^XWB(8994,3489,2,"PARAMSEQ",7,7)=""
^XWB(8994,3489,3,0)="^8994.03^47^47^3220315^^"
^XWB(8994,3489,3,1,0)="Returns a global array in which each array entry contains data from"
^XWB(8994,3489,3,2,0)="    the SDEC RESOURCE file for each HOSPITAL LOCATION (clinic)."
^XWB(8994,3489,3,3,0)="    1. RESOURCEID - Pointer to the SDEC RESOURCE file"
^XWB(8994,3489,3,4,0)="    2. RESOURCE_NAME - NAME from SDEC RESOURCE file"
^XWB(8994,3489,3,5,0)="    3. INACTIVE   - inactive clinic - INACTIVE is now tied to the"
^XWB(8994,3489,3,6,0)="                    HOSPITAL LOCATION. i.e. Is this HOSPITAL LOCATION"
^XWB(8994,3489,3,7,0)="                    inactive for this Resource - Returned values will"
^XWB(8994,3489,3,8,0)="                    be NO YES"
^XWB(8994,3489,3,9,0)="    4. TIMESCALE - Valid Values:"
^XWB(8994,3489,3,10,0)="                     5, 10, 15, 20, 30, 60"
^XWB(8994,3489,3,11,0)=" "
^XWB(8994,3489,3,12,0)="    5. HOSPITAL_LOCATION_ID"
^XWB(8994,3489,3,13,0)="    6. <NOT USED> LETTER_TEXT"
^XWB(8994,3489,3,14,0)="    7. <NOT USED> NO_SHOW_LETTER"
^XWB(8994,3489,3,15,0)="    8. <NOT USED> CLINIC_CANCELLATION_LETTER"
^XWB(8994,3489,3,16,0)="    9. VIEW - User can VIEW 1=YES; 0=NO"
^XWB(8994,3489,3,17,0)="   10. OVERBOOK - User can OVERBOOK  1=YES; 0=NO"
^XWB(8994,3489,3,18,0)="   11. MODIFY_SCHEDULE - User can Modify Schedule  1=YES; 0=NO"
^XWB(8994,3489,3,19,0)="   12. MODIFY_APPOINTMENTS User can modify appointments  1=YES; 0=NO"
^XWB(8994,3489,3,20,0)="   13. RESOURCETYPE - 3 pipe pieces:"
^XWB(8994,3489,3,21,0)="           1. type H, P, or A"
^XWB(8994,3489,3,22,0)="           2. IEN - pointer to [H] HOSPITAL LOCATION, [P] NEW PERSON,"
^XWB(8994,3489,3,23,0)="                    or [A] SDEC ADDITIONAL RESOURCE file"
^XWB(8994,3489,3,24,0)="           3. Name - name from the appropriate type file"
^XWB(8994,3489,3,25,0)="   14. DATE      - Date/Time entered in external format"
^XWB(8994,3489,3,26,0)="   15. USERIEN   - Entered By User ID pointer to NEW PERSON file 200"
^XWB(8994,3489,3,27,0)="   16. USERNAME  - Entered By User name from NEW PERSON file"
^XWB(8994,3489,3,28,0)="   17. DATE1     - Inactive Date/Time in external format"
^XWB(8994,3489,3,29,0)="   18. USERIEN1  - Inactivating User ID pointer to NEW PERSON file"
^XWB(8994,3489,3,30,0)="   19. USERNAME1 - Inactivating User Name from NEW PERSON file"
^XWB(8994,3489,3,31,0)="   20. DATE2     - Reactivated Date/Time in external format"
^XWB(8994,3489,3,32,0)="   21. USERIEN2  - Reactivating User ID pointer to NEW PERSON file"
^XWB(8994,3489,3,33,0)="   22. USERNAME2 - Reactivating User Name from NEW PERSON file"
^XWB(8994,3489,3,34,0)="   23. CLINNAME  - Clinic Name from HOSPITAL LOCATION file 44"
^XWB(8994,3489,3,35,0)="   24. PROVCLIN  - Boolean indicating 'this' P type resource is a"
^XWB(8994,3489,3,36,0)="                   provider for a clinic"
^XWB(8994,3489,3,37,0)="                   0 = not a provider"
^XWB(8994,3489,3,38,0)="                   1 = is a provider"
^XWB(8994,3489,3,39,0)="   25. PRIVLOC   - Boolean indicating presence of privileged users for"
^XWB(8994,3489,3,40,0)="                   hospital location"
^XWB(8994,3489,3,41,0)="   26. PRHBLOC   - Boolean indicating if location is a Prohibit Access "
^XWB(8994,3489,3,42,0)="                   clinic"
^XWB(8994,3489,3,43,0)="   27. LASTSUB   - Last subscript in return data. Used in next call to"
^XWB(8994,3489,3,44,0)="                   SDEC RESOURCE to get additional record"
^XWB(8994,3489,3,45,0)="   28. ABBR      - Abbreviation"
^XWB(8994,3489,3,46,0)="   29. DEFAULTVIEW - Default view"
^XWB(8994,3489,3,47,0)="   30. TIMEZONE  - Time Zone "
^XWB(8994,3490,0)="SDEC RESUSER^RESUSER^SDEC^4^R^0^^0"
^XWB(8994,3490,1,0)="^^1^1^3150806^"
^XWB(8994,3490,1,1,0)="Returns entries from the SDEC RESOURCE USER file."
^XWB(8994,3490,3,0)="^8994.03^11^11^3150806^^^"
^XWB(8994,3490,3,1,0)="Returns a Global Array in which each array entry contains data from the "
^XWB(8994,3490,3,2,0)="SDEC RESOURCE USER file separated by ^:"
^XWB(8994,3490,3,3,0)="  1. SDEC_RESOURCE_USER_IEN"
^XWB(8994,3490,3,4,0)="  2. RESOURCE_NAME"
^XWB(8994,3490,3,5,0)="  3. RESOURCE_ID"
^XWB(8994,3490,3,6,0)="  4. OVERBOOK"
^XWB(8994,3490,3,7,0)="  5. MODIFY_SCHEDULE"
^XWB(8994,3490,3,8,0)="  6. MODIFY_APPTS"
^XWB(8994,3490,3,9,0)="  7. USERNAME"
^XWB(8994,3490,3,10,0)="  8. USER_ID"
^XWB(8994,3490,3,11,0)="  9. MASTEROVERBOOK"
^XWB(8994,3491,0)="SDEC RESLETRS^RESLETRS^SDEC^4^R^0^^0"
^XWB(8994,3491,1,0)="^8994.01^2^2^3150128^^"
^XWB(8994,3491,1,1,0)="Return recordset of RESOURCES and associated LETTERS."
^XWB(8994,3491,1,2,0)="Used in generating rebook letters for a clinic."
^XWB(8994,3491,2,0)="^8994.02A^4^4"
^XWB(8994,3491,2,1,0)="SDECLIST^1^^1^1"
^XWB(8994,3491,2,1,1,0)="^^1^1^3150128^"
^XWB(8994,3491,2,1,1,1,0)="Pipe | delimited list of SDEC RESOURCE ids."
^XWB(8994,3491,2,2,0)="SDLTR^1^^0^2"
^XWB(8994,3491,2,2,1,0)="^^2^2^3150128^"
^XWB(8994,3491,2,2,1,1,0)="Letter Text flag"
^XWB(8994,3491,2,2,1,2,0)="1=return LETTER TEXT"
^XWB(8994,3491,2,3,0)="SDNOS^1^^0^3"
^XWB(8994,3491,2,3,1,0)="^^2^2^3150128^"
^XWB(8994,3491,2,3,1,1,0)="No Show Letter flag"
^XWB(8994,3491,2,3,1,2,0)="1=return NO SHOW LETTER text"
^XWB(8994,3491,2,4,0)="SDCAN^1^^0^4"
^XWB(8994,3491,2,4,1,0)="^^2^2^3150128^"
^XWB(8994,3491,2,4,1,1,0)="Clinic Cancellation Letter flag"
^XWB(8994,3491,2,4,1,2,0)="1=return CLINIC CANCELLATION LETTER text"
^XWB(8994,3491,2,"B","SDCAN",4)=""
