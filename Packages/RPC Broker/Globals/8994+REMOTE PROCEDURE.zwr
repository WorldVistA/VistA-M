^XWB(8994,4249,3,4,0)="  List[n] = p1^p2^p3^p4^p5^p6^p7^p8^p9^p10^p11^p12"
^XWB(8994,4249,3,5,0)="            ^p13^p14^p15^p16^p17^p18^p19^p20^p21"
^XWB(8994,4249,3,6,0)=" "
^XWB(8994,4249,3,7,0)="    p1  = Entry Date                   p12 = ICD Description"
^XWB(8994,4249,3,8,0)="    p2  = Patient Name                 p13 = Billing Group"
^XWB(8994,4249,3,9,0)="    p3  = PSAS HCPCS                   p14 = Subscriber ID"
^XWB(8994,4249,3,10,0)="    p4  = Quantity                     p15 = Patient SSN"
^XWB(8994,4249,3,11,0)="    p5  = Insurance                    p16 = Appliance/Repair IEN (#660)"
^XWB(8994,4249,3,12,0)="    p6  = Effect Insurance Date        p17 = HCPCS Short Description"
^XWB(8994,4249,3,13,0)="    p7  = Total Cost                   p18 = ICD Code"
^XWB(8994,4249,3,14,0)="    p8  = Appliance/Repair Description p19 = Insurance Expiration Date"
^XWB(8994,4249,3,15,0)="    p9  = Coding Errors                p20 = Delivery Date"
^XWB(8994,4249,3,16,0)="    p10 = Holder                       p21 = HCPCS-ICD Code Flag"
^XWB(8994,4249,3,17,0)="    p11 = Station"
^XWB(8994,4249,3,18,0)=" "
^XWB(8994,4249,3,19,0)="If the final result of a call begins with ""$$MORE$$"", the end date was not"
^XWB(8994,4249,3,20,0)="reached.  It will be formatted as follows:"
^XWB(8994,4249,3,21,0)=" "
^XWB(8994,4249,3,22,0)="       p1 = $$MORE$$"
^XWB(8994,4249,3,23,0)="       p2 = Last date processed; to be used as DSSODT1 in next call"
^XWB(8994,4249,3,24,0)="       p3 = Last IEN processed; to be used as DSSOIEN in next call"
^XWB(8994,4249,3,25,0)=" "
^XWB(8994,4249,3,26,0)="If data is returned, but the end of the data was reached, the results "
^XWB(8994,4249,3,27,0)="will be formatted as follows:"
^XWB(8994,4249,3,28,0)=" "
^XWB(8994,4249,3,29,0)="       p1 = $$END$$"
^XWB(8994,4249,3,30,0)=" "
^XWB(8994,4249,3,31,0)="If nothing is found, the return will be List[n] = 0^NOTHING TO REPORT."
^XWB(8994,4249,3,32,0)=" "
^XWB(8994,4249,3,33,0)="If an error occurs, the return will be List[n] = -1^message."
