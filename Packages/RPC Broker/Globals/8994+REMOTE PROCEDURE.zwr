^XWB(8994,4851,1,5,0)=" Items below Reorder Point - no ODI"
^XWB(8994,4851,1,6,0)=" Items below Normal Stock Level - no ODI"
^XWB(8994,4851,1,7,0)=" Items above Normal Stock Level - with ODI"
^XWB(8994,4851,1,8,0)=" Items missing Stock Level Information - no ODI"
^XWB(8994,4851,1,9,0)=" Items missing additional information - no ODI"
^XWB(8994,4851,1,10,0)=" On-Demand items"
^XWB(8994,4851,1,11,0)=" Items below Emergency Level - with ODI"
^XWB(8994,4851,1,12,0)=" Items below Reorder Point - with ODI"
^XWB(8994,4851,2,0)="^8994.02A^2^2"
^XWB(8994,4851,2,1,0)="STATISTIC^1^1^1^1"
^XWB(8994,4851,2,1,1,0)="^^12^12^3190619^"
^XWB(8994,4851,2,1,1,1,0)="STATISTIC"
^XWB(8994,4851,2,1,1,2,0)=" "
^XWB(8994,4851,2,1,1,3,0)="Statistic for which to return details"
^XWB(8994,4851,2,1,1,4,0)="         1=Items below Emergency Levels - no ODI"
^XWB(8994,4851,2,1,1,5,0)="         2=Items below Reorder Point - no ODI"
^XWB(8994,4851,2,1,1,6,0)="         3=Items below Normal Stock Level - no ODI"
^XWB(8994,4851,2,1,1,7,0)="         4=Items above Normal Stock Level - with ODI"
^XWB(8994,4851,2,1,1,8,0)="         5=Items missing Stock Level Information - no ODI"
^XWB(8994,4851,2,1,1,9,0)="         6=Items missing additional information - no ODI"
^XWB(8994,4851,2,1,1,10,0)="         7=On-Demand items"
^XWB(8994,4851,2,1,1,11,0)="         8=Items below Emergency Level - with ODI"
^XWB(8994,4851,2,1,1,12,0)="         9=Items below Reorder Point - with ODI"
