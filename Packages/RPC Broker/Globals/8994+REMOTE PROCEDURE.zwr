^XWB(8994,4003,2,4,1,2,0)=" "
^XWB(8994,4003,2,4,1,3,0)="Separate field for comments - 1-60 characters"
^XWB(8994,4003,2,5,0)="DSIYDAT^2^220^1^7"
^XWB(8994,4003,2,5,1,0)="^8994.021^8^8^3200730^^^^"
^XWB(8994,4003,2,5,1,1,0)="DSIYDAT"
^XWB(8994,4003,2,5,1,2,0)=" "
