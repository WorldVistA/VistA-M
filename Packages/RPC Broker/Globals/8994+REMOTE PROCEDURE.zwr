^XWB(8994,4440,1,1,0)="This RPC returns the value from either the OR SD ADDITIONAL INFORMATION or"
^XWB(8994,4440,1,2,0)="the OR SD DIALOG PREREQ parameters by location, clinic stop, division, or "
^XWB(8994,4440,1,3,0)="system level."
^XWB(8994,4440,2,0)="^8994.02A^2^2"
^XWB(8994,4440,2,1,0)="HLOCIEN^1^^1^1"
^XWB(8994,4440,2,2,0)="WHAT^1^^1^2"
^XWB(8994,4440,2,2,1,0)="^8994.021^2^2^3180118^^"
^XWB(8994,4440,2,2,1,1,0)="This value determine what type of data to return to the calling "
^XWB(8994,4440,2,2,1,2,0)="application."
^XWB(8994,4440,2,"B","HLOCIEN",1)=""
^XWB(8994,4440,2,"B","WHAT",2)=""
^XWB(8994,4440,2,"PARAMSEQ",1,1)=""
^XWB(8994,4440,2,"PARAMSEQ",2,2)=""
^XWB(8994,4440,3,0)="^8994.03^1^1^3180118^^"
^XWB(8994,4440,3,1,0)="Output array"
^XWB(8994,4441,0)="ORQQPXRM REMINDER LINK SEQ^AFFSEQ^ORQQPXRM^2^S^0^^^^^0"
^XWB(8994,4441,1,0)="^^2^2^3180327^"
^XWB(8994,4441,1,1,0)="Returns the dialog sequence number(s) that are affected by a specific "
^XWB(8994,4441,1,2,0)="reminder dialog link type."
^XWB(8994,4441,2,0)="^8994.02A^1^1"
^XWB(8994,4441,2,1,0)="LINK^1^32000^1^1"
^XWB(8994,4441,2,1,1,0)="^^2^2^3180327^"
^XWB(8994,4441,2,1,1,1,0)="The Internal Entry Number (IEN) of the link item in the REMINDER DIALOG "
^XWB(8994,4441,2,1,1,2,0)="LINK TYPE file (#801.48)."
^XWB(8994,4441,2,"B","LINK",1)=""
^XWB(8994,4441,2,"PARAMSEQ",1,1)=""
^XWB(8994,4441,3,0)="^^10^10^3180327^"
^XWB(8994,4441,3,1,0)="Array of sequence number(s) of dialog elements and/or groups that are "
^XWB(8994,4441,3,2,0)="affected by the requested reminder dialog link. The array is formatted as "
^XWB(8994,4441,3,3,0)="follows:"
^XWB(8994,4441,3,4,0)=" "
^XWB(8994,4441,3,5,0)="  RESULT(0)=X"
^XWB(8994,4441,3,6,0)="  RESULT(Y,0)=Z"
^XWB(8994,4441,3,7,0)=" "
^XWB(8994,4441,3,8,0)="where X is the number of sequences returned, Y is an integer that begins "
^XWB(8994,4441,3,9,0)="at one and increments by one and Z is the sequence number. An example "
^XWB(8994,4441,3,10,0)="sequence number is ""5.10.25.10""."
^XWB(8994,4442,0)="OROTHCL GET^GET^OROTHCL^2^S"
^XWB(8994,4442,1,0)="^8994.01^52^52^3201215^^^"
^XWB(8994,4442,1,1,0)="The RPC serves several groups of patients"
^XWB(8994,4442,1,2,0)="1) Other Than Honorable (OTH) patients: "
^XWB(8994,4442,1,3,0)="  With EMERGENT MH OTH care type"
^XWB(8994,4442,1,4,0)="  With EXTENDED MH OTH care type"
^XWB(8994,4442,1,5,0)="For the EXTENDED MH OTH, the ""OTH-EXT"" label will be displayed in the "
^XWB(8994,4442,1,6,0)="CPRS button in the CPRS header."
^XWB(8994,4442,1,7,0)="For the EMERGENT MH OTH, the ""OTH"" label and OTH 90 days period "
^XWB(8994,4442,1,8,0)="information will be displayed in the OTH button in the CPRS header."
^XWB(8994,4442,1,9,0)=" "
^XWB(8994,4442,1,10,0)="In addition to that, the pop-up window with detailed OTH information will "
^XWB(8994,4442,1,11,0)="be displayed in CPRS when the user clicks on the button and when the "
^XWB(8994,4442,1,12,0)="system needs to warn users."
^XWB(8994,4442,1,13,0)=" "
^XWB(8994,4442,1,14,0)="2) Presumptive Psychosis (PP) patients: "
^XWB(8994,4442,1,15,0)="  Registered with PP 'Indicator' = Yes and a category selected "
^XWB(8994,4442,1,16,0)="  Registered by using the ""workaround"" process "
^XWB(8994,4442,1,17,0)="    a) that the VA started using prior to introduction of PP "
^XWB(8994,4442,1,18,0)="     indicator/categories to identify PP patients"
^XWB(8994,4442,1,19,0)="    b) and also prevents billing "
^XWB(8994,4442,1,20,0)="  Registered with both PP indicator/category selected and with the "
^XWB(8994,4442,1,21,0)="  ""workaround"" process/fields populated"
^XWB(8994,4442,1,22,0)=" "
^XWB(8994,4442,1,23,0)="For PP patients the ""PP"" label will be displayed in the "
^XWB(8994,4442,1,24,0)="button in the CPRS header in the first line. For PP patients with "
^XWB(8994,4442,1,25,0)="categories the 2nd line of the button will display the category."
^XWB(8994,4442,1,26,0)=" "
^XWB(8994,4442,1,27,0)="In addition to that, the pop-up window with detailed PP information will "
^XWB(8994,4442,1,28,0)="be displayed in CPRS when the user clicks on the button."
^XWB(8994,4442,1,29,0)=" "
^XWB(8994,4442,1,30,0)="3) Patients with inactive Patient Record Flags (PRF): "
^XWB(8994,4442,1,31,0)="  High Risk of Suicide flag"
^XWB(8994,4442,1,32,0)="  Missing patients flag "
^XWB(8994,4442,1,33,0)=" "
^XWB(8994,4442,1,34,0)="For patients with inactive PRF flags the ""Inactive PRF"" label will be "
^XWB(8994,4442,1,35,0)="displayed in the 1st line of the button in the CPRS header if the patient "
^XWB(8994,4442,1,36,0)="does not have PP or OTH settings in file. And it will be displayed in the "
^XWB(8994,4442,1,37,0)="2nd line of the button if patient has PP or OTH settings.  "
^XWB(8994,4442,1,38,0)=" "
^XWB(8994,4442,1,39,0)="The 'OTH' 90 days period information will not be shown on the second line "
^XWB(8994,4442,1,40,0)="of the button if the patient is both OTH (90) and has inactive HRfS or "
^XWB(8994,4442,1,41,0)="Missing Patient National Category I PRF(s). Instead 'Inact.PRF' will be "
^XWB(8994,4442,1,42,0)="the second line."
^XWB(8994,4442,1,43,0)="The PP 'category' will not be shown on the second line of the button if "
^XWB(8994,4442,1,44,0)="the patient is both PP and has inactive HRfS or Missing Patient National "
^XWB(8994,4442,1,45,0)="Category I PRF(s).Instead 'Inact.PRF' will be the second line."
^XWB(8994,4442,1,46,0)=" "
^XWB(8994,4442,1,47,0)="In addition to that, the pop-up window will display:"
^XWB(8994,4442,1,48,0)="  - the history of the PRF assignment actions"
^XWB(8994,4442,1,49,0)="  - and, optionally, either PP or OTH informational text as it is "
^XWB(8994,4442,1,50,0)="    pertinent to the patient and described in sections above. "
^XWB(8994,4442,1,51,0)="  Note: PP and OTH registrations are mutually exclusive, a patient"
^XWB(8994,4442,1,52,0)="  cannot be registered as both."
^XWB(8994,4442,2,0)="^8994.02A^2^2"
^XWB(8994,4442,2,1,0)="DFN^1^100^1^1"
^XWB(8994,4442,2,1,1,0)="^8994.021^1^1^3180227^^^^"
^XWB(8994,4442,2,1,1,1,0)="This is a pointer to the PATIENT file."
^XWB(8994,4442,2,2,0)="ORDATE^1^100^0^2"
^XWB(8994,4442,2,2,1,0)="^^2^2^3201215^"
^XWB(8994,4442,2,2,1,1,0)="(Optional) The date to calculate status in FileMan format."
^XWB(8994,4442,2,2,1,2,0)="Default = DT (today)."
^XWB(8994,4442,2,"B","DFN",1)=""
^XWB(8994,4442,2,"B","ORDATE",2)=""
^XWB(8994,4442,2,"PARAMSEQ",1,1)=""
^XWB(8994,4442,2,"PARAMSEQ",2,2)=""
^XWB(8994,4442,3,0)="^^134^134^3201215^"
^XWB(8994,4442,3,1,0)="The array that is returned by this RPC is as follows:"
^XWB(8994,4442,3,2,0)=" "
^XWB(8994,4442,3,3,0)="If RET(0)<0 : error code less than zero ^ error message - it is an error, "
^XWB(8994,4442,3,4,0)="and do not display anything"
^XWB(8994,4442,3,5,0)=" "
^XWB(8994,4442,3,6,0)="If RET(0)=0 : then do not display anything"
^XWB(8994,4442,3,7,0)=" "
^XWB(8994,4442,3,8,0)="If RET(0)>0 : see the description below:"
^XWB(8994,4442,3,9,0)=" "
^XWB(8994,4442,3,10,0)="RET(0) - number of lines to return"
^XWB(8994,4442,3,11,0)="RET(1) = text for the 1st line on the button ^Text to display when "
^XWB(8994,4442,3,12,0)="hover over the 1st line on the button "
^XWB(8994,4442,3,13,0)="RET(2) = text for the 2nd line on the button^Text to display when hover "
^XWB(8994,4442,3,14,0)="over the 2nd line on the button"
^XWB(8994,4442,3,15,0)="RET(3) = text for the 1st line of the button-click popup message ^ Text "
^XWB(8994,4442,3,16,0)="for the 1st line of the warning popup message (see the example for the "
^XWB(8994,4442,3,17,0)="OTH-90 below)"
^XWB(8994,4442,3,18,0)="RET(>3)= text lines for the rest of the text in the popup message when "
^XWB(8994,4442,3,19,0)="the user clicks on the button or for the warning popup message"
^XWB(8994,4442,3,20,0)="NOTE: empty or null values in array elements greater than 3 will not be "
^XWB(8994,4442,3,21,0)="displayed on the CPRS side. Enter at least a blank space in the piece to"
^XWB(8994,4442,3,22,0)="include a blank line in the displayed text."
^XWB(8994,4442,3,23,0)=" "
^XWB(8994,4442,3,24,0)="Example for OTH-EXT:"
^XWB(8994,4442,3,25,0)="RET(0)=6"
^XWB(8994,4442,3,26,0)="RET(1)=""OTH-EXT^Other than Honorable, click for details"""
^XWB(8994,4442,3,27,0)="RET(2)="" """
^XWB(8994,4442,3,28,0)="RET(3)=""Other than Honorable - Extended"""
^XWB(8994,4442,3,29,0)="RET(4)=""Eligible for Mental Health care only"""
^XWB(8994,4442,3,30,0)="RET(5)=""Not time limited - pending VBA adjudication"""
^XWB(8994,4442,3,31,0)="RET(6)=""Adjudication will determine eligibility for continuing care"""
^XWB(8994,4442,3,32,0)=" "
^XWB(8994,4442,3,33,0)="Example for OTH-90 with zero days remaining:"
^XWB(8994,4442,3,34,0)="RET(0)=10"
^XWB(8994,4442,3,35,0)="RET(1)=""OTH^Other than Honorable, click for details"""
^XWB(8994,4442,3,36,0)="RET(2)=""0D,P1^Zero days remaining in the most recent period"""
^XWB(8994,4442,3,37,0)="RET(3)=""Other Than Honorable Status"""
^XWB(8994,4442,3,38,0)="RET(4)=""   """
^XWB(8994,4442,3,39,0)="RET(5)=""Zero days remaining in the most recent period^WARNING:  EMERGENT "
^XWB(8994,4442,3,40,0)="MH OTH"""
^XWB(8994,4442,3,41,0)="RET(6)=""^Zero days remaining in the most recent period."""
^XWB(8994,4442,3,42,0)="RET(7)=""^Authorization from VISN Chief Medical Officer is required for an "
^XWB(8994,4442,3,43,0)="additional 90-Day period."""
^XWB(8994,4442,3,44,0)="RET(8)=""   """
^XWB(8994,4442,3,45,0)="RET(9)=""Call Registration team for details."""
^XWB(8994,4442,3,46,0)="RET(10)=""Clinician: Determine and document in 1st line of Progress Note "
^XWB(8994,4442,3,47,0)="if MH treatment related to service."""
^XWB(8994,4442,3,48,0)=" "
^XWB(8994,4442,3,49,0)="Example for OTH-90 with less than 7 days remaining:"
^XWB(8994,4442,3,50,0)="RET(0)=10"
^XWB(8994,4442,3,51,0)="RET(1)=""OTH^Other than Honorable, click for details"""
^XWB(8994,4442,3,52,0)="RET(2)=""5D,P1^5 day(s) remaining in the current period"""
^XWB(8994,4442,3,53,0)="RET(3)=""Other Than Honorable Status"""
^XWB(8994,4442,3,54,0)="RET(4)=""   """
^XWB(8994,4442,3,55,0)="RET(5)=""5 day(s) remaining in the current period^WARNING:  EMERGENT MH "
^XWB(8994,4442,3,56,0)="OTH"""
^XWB(8994,4442,3,57,0)="RET(6)=""^Less than 7 day(s) remaining in the current period."""
^XWB(8994,4442,3,58,0)="RET(7)=""^Authorization from VISN Chief Medical Officer is required for an "
^XWB(8994,4442,3,59,0)="additional 90-Day period."""
^XWB(8994,4442,3,60,0)="RET(8)=""   """
^XWB(8994,4442,3,61,0)="RET(9)=""Call Registration team for details."""
^XWB(8994,4442,3,62,0)="RET(10)=""Clinician: Determine and document in 1st line of Progress Note "
^XWB(8994,4442,3,63,0)="if MH treatment related to service."" "
^XWB(8994,4442,3,64,0)=" "
^XWB(8994,4442,3,65,0)="Example for OTH-90 with more than 7 days remaining:"
^XWB(8994,4442,3,66,0)="RET(0)=8"
^XWB(8994,4442,3,67,0)="RET(1)=""OTH^Other than Honorable, click for details"""
^XWB(8994,4442,3,68,0)="RET(2)=""80D,P1^80 day(s) remaining in the current period"""
^XWB(8994,4442,3,69,0)="RET(3)=""Other Than Honorable Status"""
^XWB(8994,4442,3,70,0)="RET(4)=""   """
^XWB(8994,4442,3,71,0)="RET(5)=""80 day(s) remaining in the current period"""
^XWB(8994,4442,3,72,0)="RET(6)=""   """
^XWB(8994,4442,3,73,0)="RET(7)=""Call Registration team for details."""
^XWB(8994,4442,3,74,0)="RET(8)=""Clinician: Determine and document in 1st line of Progress Note if "
^XWB(8994,4442,3,75,0)="MH treatment related to service."" "
^XWB(8994,4442,3,76,0)=" "
^XWB(8994,4442,3,77,0)="Example for PP workaround settings only:"
^XWB(8994,4442,3,78,0)="RET(0)=7"
^XWB(8994,4442,3,79,0)="RET(1)=""PP^Presumptive Psychosis Authority, click for details"""
^XWB(8994,4442,3,80,0)="RET(2)=""^"""
^XWB(8994,4442,3,81,0)="RET(3)=""Eligible for mental health care only under Presumptive Psychosis"""
^XWB(8994,4442,3,82,0)="RET(4)=""Authority."""
^XWB(8994,4442,3,83,0)="RET(5)=""PP Category: No value was selected as PP Indicator is not "
^XWB(8994,4442,3,84,0)="completed."""
^XWB(8994,4442,3,85,0)="RET(6)=""Patients who experienced MST are eligible for MST related mental"""
^XWB(8994,4442,3,86,0)="RET(7)=""health and medical care."""
^XWB(8994,4442,3,87,0)=" "
^XWB(8994,4442,3,88,0)="Example for PP workaround settings and PP category:"
^XWB(8994,4442,3,89,0)="RET(0)=7"
^XWB(8994,4442,3,90,0)="RET(1)=""PP^Presumptive Psychosis Authority, click for details"""
^XWB(8994,4442,3,91,0)="RET(2)=""Fsm^Former Service Member with prior OTH discharge; should now be "
^XWB(8994,4442,3,92,0)="post-adjudication."""
^XWB(8994,4442,3,93,0)="RET(3)=""Eligible for mental health care only under Presumptive Psychosis"""
^XWB(8994,4442,3,94,0)="RET(4)=""Authority: Former Service Member with prior OTH discharge;"""
^XWB(8994,4442,3,95,0)="RET(5)=""should now be post-adjudication."""
^XWB(8994,4442,3,96,0)="RET(6)=""Patients who experienced MST may be eligible for MST-related "
^XWB(8994,4442,3,97,0)="care;"""
^XWB(8994,4442,3,98,0)="RET(7)=""check with Eligibility for specifics."""
^XWB(8994,4442,3,99,0)=" "
^XWB(8994,4442,3,100,0)="Example for PP category without PP workaround settings (the mailman will "
^XWB(8994,4442,3,101,0)="be also sent to the DGEN ELIGIBILITY ALERT group in DGOTHBT2):"
^XWB(8994,4442,3,102,0)="RET(0)=6"
^XWB(8994,4442,3,103,0)="RET(1)=""PP^Presumptive Psychosis Authority, click for details"""
^XWB(8994,4442,3,104,0)="RET(2)=""Dec^VETERAN DECLINES ENROLLMENT"""
^XWB(8994,4442,3,105,0)="RET(3)=""Eligible for mental health care only under Presumptive Psychosis"""
^XWB(8994,4442,3,106,0)="RET(4)=""Authority: VETERAN DECLINES ENROLLMENT."""
^XWB(8994,4442,3,107,0)="RET(5)=""Patients who experienced MST are eligible for MST related mental"""
^XWB(8994,4442,3,108,0)="RET(6)=""health and medical care."" ^"
^XWB(8994,4442,3,109,0)=" "
^XWB(8994,4442,3,110,0)="Example for inactive PRFs:"
^XWB(8994,4442,3,111,0)="RET(0)=23"
^XWB(8994,4442,3,112,0)="RET(1)=""Inactive Flag^Patient has Inactive Flag(s), click to view"""
^XWB(8994,4442,3,113,0)="RET(2)="" """
^XWB(8994,4442,3,114,0)="RET(3)=""Flag name: HIGH RISK FOR SUICIDE   Status: INACTIVE"""
^XWB(8994,4442,3,115,0)="RET(4)=""  Initial Assigned Date: OCT 12, 2020@16:27:10"""
^XWB(8994,4442,3,116,0)="RET(5)=""  Originating Site: CAMP MASTER"""
^XWB(8994,4442,3,117,0)="RET(6)=""  Owner Site: CAMP MASTER"""
^XWB(8994,4442,3,118,0)="RET(7)=""  CAMP MASTER changes:"""
^XWB(8994,4442,3,119,0)="RET(8)=""    DATE/TIME: NOV 25, 2020@10:45:44    ACTION: INACTIVATE"""
^XWB(8994,4442,3,120,0)="RET(9)=""  BAY PINES VAMC changes:"""
^XWB(8994,4442,3,121,0)="RET(10)=""    DATE/TIME: NOV 25, 2020@10:19:17    ACTION: REACTIVATE"""
^XWB(8994,4442,3,122,0)="RET(11)=""  CAMP MASTER changes:"""
^XWB(8994,4442,3,123,0)="RET(12)=""    DATE/TIME: NOV 24, 2020@09:26:06    ACTION: INACTIVATE"""
^XWB(8994,4442,3,124,0)="RET(13)=""  NEW YORK HHS changes:"""
