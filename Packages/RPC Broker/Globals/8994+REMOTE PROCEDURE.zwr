^XWB(8994,956,2,2,1,5,0)="   ;image capture window)."
^XWB(8994,956,2,2,1,6,0)="   ;Will return a single value on filing success."
^XWB(8994,956,2,"B","DATA",2)=""
^XWB(8994,956,2,"B","IMIEN",1)=""
^XWB(8994,956,2,"PARAMSEQ",1,1)=""
^XWB(8994,956,2,"PARAMSEQ",2,2)=""
^XWB(8994,956,3,0)="^8994.03^1^1^3000516^^^^"
^XWB(8994,956,3,1,0)="Returns '1^success' or '0^error text'."
^XWB(8994,957,0)="MAGGRADIMAGE^IMAGE^MAGGTRAI^4^R^^^1"
^XWB(8994,957,1,0)="^8994.01^2^2^3090626^^^^"
^XWB(8994,957,1,1,0)="User selects a Radiology exam from the listing displayed, we return a list"
^XWB(8994,957,1,2,0)="of images associated with that exam."
^XWB(8994,957,2,0)="^8994.02A^1^1"
^XWB(8994,957,2,1,0)="DATA^1^245^1^1"
^XWB(8994,957,2,1,1,0)="^8994.021^7^7^3090626^^^^"
^XWB(8994,957,2,1,1,1,0)="DATA is the exam data that was output from the MAGGRADLIST RPC call."
^XWB(8994,957,2,1,1,2,0)="DATA is the Radiology values stored in ^TMP($J,""RAEX"",x)"
^XWB(8994,957,2,1,1,3,0)="  that the radiology procedure RAPTLU sets during the search"
^XWB(8994,957,2,1,1,4,0)="  for patient exams.  (see routine RAPTLU )"
^XWB(8994,957,2,1,1,5,0)="      ^TMP($J,""RAEX"",RACNT)="
^XWB(8994,957,2,1,1,6,0)="     RADFN_""^""_RADTI_""^""_RACNI_""^""_RANME_""^""_RASSN_""^"""
^XWB(8994,957,2,1,1,7,0)="    _RADATE_""^""_RADTE_""^""_RACN_""^""_RAPRC_""^""_RARPT_""^""_RAST"
^XWB(8994,957,2,"B","DATA",1)=""
^XWB(8994,957,2,"PARAMSEQ",1,1)=""
^XWB(8994,957,3,0)="^8994.03^3^3^3090626^^^^"
^XWB(8994,957,3,1,0)="Returns an array of images associated with the Radiology exam. Each array"
^XWB(8994,957,3,2,0)="entry has image data returned from the call BOTH^MAGFILEA which is the"
^XWB(8994,957,3,3,0)="same data returned by all calls that return image data."
^XWB(8994,958,0)="MAGGUPREFGET^GET^MAGGTUP^2^R"
^XWB(8994,958,1,0)="^8994.01^1^1^3000517^^^"
^XWB(8994,958,1,1,0)="Returns the user preferences for the Imaging Display windows."
^XWB(8994,958,3,0)="^8994.03^2^2^3000517^^^"
^XWB(8994,958,3,1,0)="Each entry of the return array has the window name as first piece, "
^XWB(8994,958,3,2,0)="followed by the window parameters. i.e. height, width, visible, etc."
^XWB(8994,959,0)="MAGGUPREFSAVE^SAVE^MAGGTUP^1^R"
^XWB(8994,959,1,0)="^8994.01^2^2^3000517^^^"
^XWB(8994,959,1,1,0)="Saves the Imaging user's window preferences to the Imaging User Preferences"
^XWB(8994,959,1,2,0)="file.  ^MAG(2006.18,"
^XWB(8994,959,2,0)="^8994.02A^1^1"
^XWB(8994,959,2,1,0)="DATA^2^^1^1"
^XWB(8994,959,2,1,1,0)="^8994.021^2^2^3000517^^"
^XWB(8994,959,2,1,1,1,0)="Each array node has window name as first piece followed by the window"
^XWB(8994,959,2,1,1,2,0)="parameters."
^XWB(8994,959,2,"B","DATA",1)=""
^XWB(8994,959,2,"PARAMSEQ",1,1)=""
^XWB(8994,959,3,0)="^8994.03^2^2^3000517^^"
^XWB(8994,959,3,1,0)="returns:   '1^User preferences saved'"
^XWB(8994,959,3,2,0)="  or       '0^error text'          (if error)"
^XWB(8994,960,0)="MAGGRADREPORT^RAD^MAGGTRP1^4^^^^1"
^XWB(8994,960,1,0)="^8994.01^1^1^3000517^^^^"
^XWB(8994,960,1,1,0)="Returns the Radiology report for the input value RARPT.  ^RARPT(RARPT)"
^XWB(8994,960,2,0)="^8994.02A^1^1"
^XWB(8994,960,2,1,0)="RARPT^1^30^1^1"
^XWB(8994,960,2,1,1,0)="^8994.021^1^1^3000517^^^"
^XWB(8994,960,2,1,1,1,0)="Internal entry number of ^RARPT(RARPT)."
^XWB(8994,960,2,"B","RARPT",1)=""
^XWB(8994,960,2,"PARAMSEQ",1,1)=""
^XWB(8994,960,3,0)="^8994.03^1^1^3000517^^^"
^XWB(8994,960,3,1,0)="Returns the report in an array."
^XWB(8994,961,0)="MAGGSUR GET^GET^MAGGTSR^2^R"
^XWB(8994,961,1,0)="^8994.01^1^1^3000517^^^^"
^XWB(8994,961,1,1,0)="Returns a list of Surgery Cases for the Patient."
^XWB(8994,961,2,0)="^8994.02A^1^1"
^XWB(8994,961,2,1,0)="MAGDFN^1^30^1^1"
^XWB(8994,961,2,1,1,0)="^8994.021^1^1^3000517^^^^"
^XWB(8994,961,2,1,1,1,0)="The DFN of patient."
^XWB(8994,961,2,"B","MAGDFN",1)=""
^XWB(8994,961,2,"PARAMSEQ",1,1)=""
^XWB(8994,961,3,0)="^8994.03^18^18^3000517^^^^"
^XWB(8994,961,3,1,0)="Returns an array of Surgery cases for the given DFN."
^XWB(8994,961,3,2,0)="Calls Surgery API GET^SROGTSR to get the list."
^XWB(8994,961,3,3,0)="We insert headers as first list entry, for easy display in Delphi Window."
^XWB(8994,961,3,4,0)=""
^XWB(8994,961,3,5,0)="MAGRY(0)    = count of cases ^ ""Cases found"""
^XWB(8994,961,3,6,0)="        second array entry is the column headers"
^XWB(8994,961,3,7,0)="MAGRY(1)    =""# ^ Date ^ Case description^ # Images"""
^XWB(8994,961,3,8,0)="        entries 2..n are the data and extra internal info : "
^XWB(8994,961,3,9,0)="        the surgery internal number SROP and Date in internal format."
^XWB(8994,961,3,10,0)=""
^XWB(8994,961,3,11,0)="MAGRY(2..N) = Sting of '^' delimited pieces."
^XWB(8994,961,3,12,0)="        ; for Imaging Versions < 2.5 the data is"
^XWB(8994,961,3,13,0)="        ; #     DATE             DESC      SRF(IEN   FM DATE"
^XWB(8994,961,3,14,0)="        ;CNT_U_(READABLE DATE)_U_SROPS(1)_U_SROP_U_SRSDATE"
^XWB(8994,961,3,15,0)="        ;"
^XWB(8994,961,3,16,0)="        ; for Imaging Versions > 2.4, the data is different"
^XWB(8994,961,3,17,0)="        ;CNT_U_(READABLE DATE)_U_SROPS(1)_U_IMAGECT_U_""|""_SROP_U_SRSDATE"
^XWB(8994,961,3,18,0)=""
^XWB(8994,962,0)="MAGGSUR FILE^FILE^MAGGTSR1^1^R"
^XWB(8994,962,1,0)="^8994.01^1^1^3000517^^^^"
^XWB(8994,962,1,1,0)="Files the pointers in the Surgery and Image packages."
^XWB(8994,962,2,0)="^8994.02A^2^2"
^XWB(8994,962,2,1,0)="MAGIEN^1^30^1^1"
^XWB(8994,962,2,1,1,0)="^8994.021^1^1^3000517^^^"
^XWB(8994,962,2,1,1,1,0)="Image file internal number.  ^MAG(2005,"
^XWB(8994,962,2,2,0)="DATA^1^245^1^2"
^XWB(8994,962,2,2,1,0)="^8994.021^9^9^3000517^^^^"
^XWB(8994,962,2,2,1,1,0)="Sting of '^' delimited pieces."
^XWB(8994,962,2,2,1,2,0)="it is the same data that is set into the list of"
^XWB(8994,962,2,2,1,3,0)="surgery cases when image application asks for list of patients cases."
^XWB(8994,962,2,2,1,4,0)="        ; for Imaging Versions < 2.5 the data is"
^XWB(8994,962,2,2,1,5,0)="        ; #     DATE             DESC      SRF(IEN   FM DATE"
^XWB(8994,962,2,2,1,6,0)="        ;CNT_U_(READABLE DATE)_U_SROPS(1)_U_SROP_U_SRSDATE"
^XWB(8994,962,2,2,1,7,0)="        ;"
^XWB(8994,962,2,2,1,8,0)="        ; for Imaging Versions > 2.4, the data is different"
^XWB(8994,962,2,2,1,9,0)="        ;CNT_U_(READABLE DATE)_U_SROPS(1)_U_IMAGECT_U_""|""_SROP_U_SRSDATE"
^XWB(8994,962,2,"B","DATA",2)=""
^XWB(8994,962,2,"B","MAGIEN",1)=""
^XWB(8994,962,2,"PARAMSEQ",1,1)=""
^XWB(8994,962,2,"PARAMSEQ",2,2)=""
^XWB(8994,962,3,0)="^8994.03^2^2^3000517^^^^"
^XWB(8994,962,3,1,0)="If success, returns ""1^success"""
^XWB(8994,962,3,2,0)="If error, returns ""0^error text"""
^XWB(8994,963,0)="MAGGACTION LOG^LOGACT^MAGGTU6^1^R"
^XWB(8994,963,1,0)="^8994.01^2^2^3080825^^^^"
^XWB(8994,963,1,1,0)="Call from Delphi to log an action performed on the image. "
^XWB(8994,963,1,2,0)="Actions are logged the IMAGE ACCESS LOG file  ^MAG(2006.95"
^XWB(8994,963,2,0)="^8994.02A^1^1"
^XWB(8994,963,2,1,0)="DATA^1^245^1^1"
^XWB(8994,963,2,1,1,0)="^8994.021^9^9^3080825^^^^"
^XWB(8994,963,2,1,1,1,0)="'^' delimited string contains the following:"
^XWB(8994,963,2,1,1,2,0)="'^' piece     description"
^XWB(8994,963,2,1,1,3,0)="   1   ACCESS TYPE -  A|B|C|D|E"
^XWB(8994,963,2,1,1,4,0)="   2   USER        -  DUZ"
^XWB(8994,963,2,1,1,5,0)="   3   IMAGE       -  MAGIEN"
^XWB(8994,963,2,1,1,6,0)="   4   USER INTERFACE SOFTWARE   - STRING"
^XWB(8994,963,2,1,1,7,0)="   5   PATIENT     -  DFN"
^XWB(8994,963,2,1,1,8,0)="   6   IMAGE COUNT"
^XWB(8994,963,2,1,1,9,0)="   7   ADDITIONAL DATA"
^XWB(8994,963,2,"B"," ZY",1)=""
^XWB(8994,963,2,"B","DATA",1)=""
^XWB(8994,963,2,"PARAMSEQ",1,1)=""
^XWB(8994,963,3,0)="^8994.03^2^2^3080825^^^^"
^XWB(8994,963,3,1,0)="Returns   ""1^"" if success."
^XWB(8994,963,3,2,0)="Returns   ""0^error text""  if failure."
^XWB(8994,964,0)="MAGG DTTM^DTTM^MAGGTU5^1^R"
^XWB(8994,964,1,0)="^8994.01^1^1^3041215^^^^"
^XWB(8994,964,1,1,0)="Does a FileMan conversion using %DT=""T"" D ^%DT,$$FMTE^XLFDT(Y,""8"")"
^XWB(8994,964,2,0)="^8994.02A^3^3"
^XWB(8994,964,2,1,0)="  X^1^30^1^1"
^XWB(8994,964,2,1,1,0)="^8994.021^1^1^3000515^^"
^XWB(8994,964,2,1,1,1,0)="User input to date/time field "
^XWB(8994,964,2,2,0)="INDT^1^30^1^1"
^XWB(8994,964,2,2,1,0)="^^1^1^3041215^"
^XWB(8994,964,2,2,1,1,0)="This is the Date to be converted in External or Internal Format."
^XWB(8994,964,2,3,0)="NOFDT^1^1^0^2"
^XWB(8994,964,2,3,1,0)="^^3^3^3041215^"
^XWB(8994,964,2,3,1,1,0)="This is a Flag to tell if Future Dates are allowed."
^XWB(8994,964,2,3,1,2,0)="The defaults is 0, so Future Dates Are Allowed."
^XWB(8994,964,2,3,1,3,0)="If 1, then NOFDT is true and NO Future Dates are Allowed."
^XWB(8994,964,2,"B","  X",1)=""
^XWB(8994,964,2,"B","INDT",2)=""
^XWB(8994,964,2,"B","NOFDT",3)=""
^XWB(8994,964,2,"PARAMSEQ",1,1)=""
^XWB(8994,964,2,"PARAMSEQ",1,2)=""
^XWB(8994,964,2,"PARAMSEQ",2,3)=""
^XWB(8994,964,3,0)="^8994.03^2^2^3041215^^^^"
^XWB(8994,964,3,1,0)="Returns date/time in format  Month DD, YYYY@HH:MM"
^XWB(8994,964,3,2,0)="i.e. Jan 04, 1999@11:55"
^XWB(8994,965,0)="MAGGUSER2^USERINF2^MAGGTU3^2^R"
^XWB(8994,965,1,0)="^8994.01^1^1^3000517^^"
^XWB(8994,965,1,1,0)="Returns Array of info about user, and site settings."
^XWB(8994,965,1,2,0)="the user's security keys for later applications."
^XWB(8994,965,2,0)="^8994.02A^1^1"
^XWB(8994,965,2,1,0)="MAGGWRKID^1^240^0^1"
^XWB(8994,965,2,1,1,0)="^8994.021^1^1^3000517^^^"
^XWB(8994,965,2,1,1,1,0)="Workstation ID and Location from MAG.INI file section [SYS_SiteParam]."
^XWB(8994,965,2,"B","MAGGWRKID",1)=""
^XWB(8994,965,2,"PARAMSEQ",1,1)=""
^XWB(8994,965,3,0)="^8994.03^13^13^3061024^^"
^XWB(8994,965,3,1,0)="        ; MAGRY(1) = DUZ ^ FULL NAME  ^ INITIALS"
^XWB(8994,965,3,2,0)="        ; MAGRY(2) = Network UserName ^ PassWord."
^XWB(8994,965,3,3,0)="        ; MAGRY(3) = MUSE Site number. ( default = 1)"
^XWB(8994,965,3,4,0)="        ; Node 4 is data from IMAGING SITE PARAMATERS File #2006.1 and INSTITUTION File #4"
^XWB(8994,965,3,5,0)="        ; MAGRY(4)= IEN  ^ SITE CODE ^ DUZ(2) ^ INSTITUTION NAME (.01) ^ $$CONSOLID ^ STATION NUMBER (99)"
^XWB(8994,965,3,6,0)="        ; MAGRY(5) = +<CP Version>|0 ^ Version of CP installed on Server"
^XWB(8994,965,3,7,0)="        ; MAGRY(6) = Warning message if we can't resolve which Site Parameter entry to use."
^XWB(8994,965,3,8,0)="        ; MAGRY(7) = Warning message  <reserved for future>"
^XWB(8994,965,3,9,0)="        ; MAGRY(8) = 1|0  1 = Production account    0 = Test Account (or couldn't determine)"
^XWB(8994,965,3,10,0)="        ; MAGRY(9) = Vista Site Service PHYSICAL REFERENCE from Network Location File."
^XWB(8994,965,3,11,0)="        ; MAGRY(10)=Domain Name"
^XWB(8994,966,0)="MAGGUSERKEYS^USERKEYS^MAGGTU3^2^R"
^XWB(8994,966,1,0)="^8994.01^1^1^3000517^^^"
^XWB(8994,966,1,1,0)="Return an array of Imaging Keys that this user holds."
^XWB(8994,966,3,0)="^8994.03^3^3^3000517^^^"
^XWB(8994,966,3,1,0)="Returns an array of IMAGING Security Keys"
^XWB(8994,966,3,2,0)="to use on the workstation to limit capture ability"
^XWB(8994,966,3,3,0)="and to limit functionality on Display application."
^XWB(8994,967,0)="MAGG VERIFY ESIG^ESIG^MAGQLOG^1^R"
^XWB(8994,967,1,0)="^8994.01^2^2^3000515^^^"
^XWB(8994,967,1,1,0)="Verifies the Electronic signature of the current user.  "
^XWB(8994,967,1,2,0)="Uses 'DUZ' defined in the partition."
^XWB(8994,967,2,0)="^8994.02A^1^1"
^XWB(8994,967,2,1,0)="ESIG^1^20^1^1"
^XWB(8994,967,2,1,1,0)="^8994.021^2^2^3000515^^"
^XWB(8994,967,2,1,1,1,0)="This is the encrypted electronic signature entered by the user on the"
^XWB(8994,967,2,1,1,2,0)="Imaging window."
^XWB(8994,967,2,"B","ESIG",1)=""
^XWB(8994,967,2,"PARAMSEQ",1,1)=""
^XWB(8994,967,3,0)="^8994.03^2^2^3000515^^^"
^XWB(8994,967,3,1,0)="Returns   ""1^message""   for success"
^XWB(8994,967,3,2,0)="          ""0^message""   for failure or error."
^XWB(8994,968,0)="MAGG WRKS UPDATES^UPD^MAGGTAU^1^R"
^XWB(8994,968,1,0)="^^2^2^3080513^"
^XWB(8994,968,1,1,0)="Using this remote procedure, the workstation updates its record in the"
^XWB(8994,968,1,2,0)="IMAGING WINDOWS WORKSTATION file (#2006.81) and starts a new session."
^XWB(8994,968,2,0)="^8994.02A^1^1"
^XWB(8994,968,2,1,0)="DATA^1^245^1^1"
^XWB(8994,968,2,1,1,0)="^^21^21^3080513^"
^XWB(8994,968,2,1,1,1,0)="Data that should be stored in the IMAGING WINDOWS WORKSTATION file"
^XWB(8994,968,2,1,1,2,0)="(#2006.81):"
^XWB(8994,968,2,1,1,3,0)=" "
^XWB(8994,968,2,1,1,4,0)="  ^01: Workstation name"
^XWB(8994,968,2,1,1,5,0)="  ^02: Date/Time of the Capture application (external)"
^XWB(8994,968,2,1,1,6,0)="  ^03: Date/Time of the Display application (external)"
^XWB(8994,968,2,1,1,7,0)="  ^04: Location of the workstation"
^XWB(8994,968,2,1,1,8,0)="  ^05: Date/Time of the MAGSETUP (external)"
^XWB(8994,968,2,1,1,9,0)="  ^06: Version of the Display application (Major.Minor.Patch.Bild)"
^XWB(8994,968,2,1,1,10,0)="  ^07: Version of the Capture application (Major.Minor.Patch.Bild)"
^XWB(8994,968,2,1,1,11,0)="  ^08: Startup mode: 1 = Normal startup,"
^XWB(8994,968,2,1,1,12,0)="       2 = Started by CPRS, 3 = Import API"
^XWB(8994,968,2,1,1,13,0)="  ^09: OS Version"
^XWB(8994,968,2,1,1,14,0)="  ^10: VistaRad version (Major.Minor.Patch.Bild)"
^XWB(8994,968,2,1,1,15,0)="  ^11: RPCBroker server"
^XWB(8994,968,2,1,1,16,0)="  ^12: RPCBroker port"
^XWB(8994,968,2,1,1,17,0)="  ^13: Clinical Utilities version (Major.Minor.Patch.Bild)"
^XWB(8994,968,2,1,1,18,0)="  ^14: TeleReader version (Major.Minor.Patch.Bild)"
^XWB(8994,968,2,1,1,19,0)="  ^15: Date/Time of the Clinical Utilities (external)"
^XWB(8994,968,2,1,1,20,0)="  ^16: Date/Time of the TeleReader (external)"
^XWB(8994,968,2,1,1,21,0)="  ^17: Date/Time of the VistaRad (external)"
^XWB(8994,968,2,"B","DATA",1)=""
^XWB(8994,968,2,"PARAMSEQ",1,1)=""
^XWB(8994,968,3,0)="^^14^14^3080513^"
^XWB(8994,968,3,1,0)="Zero value of the first '^'-piece of the Results[0] indicates that an "
^XWB(8994,968,3,2,0)="error occurred during the execution of the procedure. In this case, the "
^XWB(8994,968,3,3,0)="Results[0] is formatted as follows:"
^XWB(8994,968,3,4,0)=" "
^XWB(8994,968,3,5,0)="  Results[0]            Result descriptor"
^XWB(8994,968,3,6,0)="                          ^01: 0"
^XWB(8994,968,3,7,0)="                          ^02: Error message (optional)"
^XWB(8994,968,3,8,0)=" "
^XWB(8994,968,3,9,0)="Otherwise, first '^'-piece of the Results[0] contains the session number"
^XWB(8994,968,3,10,0)="(IEN in the IMAGING WINDOWS SESSIONS file (#2006.82)):"
^XWB(8994,968,3,11,0)=" "
^XWB(8994,968,3,12,0)="  Results[0]            Result descriptor"
^XWB(8994,968,3,13,0)="                          ^01: Session IEN (file #2006.82)"
^XWB(8994,968,3,14,0)="                          ^02: Message"
^XWB(8994,969,0)="MAGG LOGOFF^LOGOFF^MAGGTAU^1^R"
^XWB(8994,969,1,0)="^8994.01^2^2^3000515^^^^"
^XWB(8994,969,1,1,0)="Tracks the time of the Imaging session."
^XWB(8994,969,1,2,0)="Kills TMP globals, cleans up."
^XWB(8994,969,3,0)="^8994.03^1^1^3000515^^^^"
^XWB(8994,969,3,1,0)="always returns '1'.  Mainly for future use and Imaging statistics."
^XWB(8994,970,0)="MAGG SYS WRKS DISPLAY^WRKS^MAGGTSY^4^R^^^1"
^XWB(8994,970,1,0)="^8994.01^2^2^3000515^^^^"
^XWB(8994,970,1,1,0)="Utilites for Imaging system manager."
^XWB(8994,970,1,2,0)="RPC Call for MAGSYS utility. List of Workstation Information."
^XWB(8994,970,2,0)="^8994.02A^1^1"
^XWB(8994,970,2,1,0)="ZYx^1^60^0^1"
