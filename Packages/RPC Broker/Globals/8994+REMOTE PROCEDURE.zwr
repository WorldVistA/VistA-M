^XWB(8994,3977,3,4,0)="DSIYRET(1)=""-1^Error""      If there are errors"
^XWB(8994,3977,3,5,0)=" "
^XWB(8994,3977,3,6,0)="DSIYRET(IEN)="""" for each node found in the XREF"
