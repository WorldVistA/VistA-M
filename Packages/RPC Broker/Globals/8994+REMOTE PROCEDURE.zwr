^XWB(8994,4202,1,6,0)="  | Development Office of the Department of Veterans Affairs,     |"
^XWB(8994,4202,1,7,0)="  | telephone (301) 734-0100.                                     |"
^XWB(8994,4202,1,8,0)="  |                                                               |"
^XWB(8994,4202,1,9,0)="  | The Food and Drug Administration classifies this software as  |"
^XWB(8994,4202,1,10,0)="  | a medical device.  As such, it may not be changed in any way. |"
^XWB(8994,4202,1,11,0)="  | Modifications to this software may result in an adulterated   |"
