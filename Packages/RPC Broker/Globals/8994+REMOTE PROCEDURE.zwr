^XWB(8994,3464,1,1,0)="Give a patient DFN, ICN, or EDIPI, this Remote Procedure Call returns a list of Treating Facilities, including SOURCE ID, SITE HASH, and IDENTIFIER STATUS."
^XWB(8994,3464,2,0)="^8994.02A^1^1"
^XWB(8994,3464,2,1,0)="Patient Identifier^3^255^1^1"
^XWB(8994,3464,2,1,1,0)="^8994.021^7^7^3150219^^^^"
^XWB(8994,3464,2,1,1,1,0)="The patient identifier will either be the PATIENT (#2) IEN (aka DFN), Integration Control Number (aka ICN), or the DOD Identifier (aka EDIPI). Following this format:"
^XWB(8994,3464,2,1,1,2,0)="Id^IdType^AssigningAuthority^AssigningFacility"
^XWB(8994,3464,2,1,1,3,0)=" "
^XWB(8994,3464,2,1,1,4,0)="Examples:"
^XWB(8994,3464,2,1,1,5,0)=" ICN example:  1008520438V882204^NI^USVHA^200M"
^XWB(8994,3464,2,1,1,6,0)=" DFN example:  100000511^PI^USHVA^500"
^XWB(8994,3464,2,1,1,7,0)="EDIPI example: 852043888^NI^USDOD^200DOD"
^XWB(8994,3464,2,"B","Patient Identifier",1)=""
