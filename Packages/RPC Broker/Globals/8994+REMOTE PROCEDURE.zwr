^XWB(8994,4052,3,93,0)="FILE."
^XWB(8994,4053,0)="DSIYAD02 ADHCHDUP UPDT HEADER^ADHCHDUP^DSIYAD02^2"
^XWB(8994,4053,1,0)="^8994.01^4^4^3140604^^"
^XWB(8994,4053,1,1,0)="ADHCHDUP"
^XWB(8994,4053,1,2,0)=" "
^XWB(8994,4053,1,3,0)="This RPC Updates the Header information for an Ad-Hoc Report - the data "
^XWB(8994,4053,1,4,0)="is stored in ^DSIY(19685.61)"
^XWB(8994,4053,2,0)="^8994.02A^2^2"
^XWB(8994,4053,2,1,0)="IEN^1^20^0^1"
^XWB(8994,4053,2,1,1,0)="^8994.021^4^4^3140604^^"
^XWB(8994,4053,2,1,1,1,0)="IEN"
^XWB(8994,4053,2,1,1,2,0)=" "
^XWB(8994,4053,2,1,1,3,0)="IEN to the Ad-Hoc Report file.  If this is left blank, the RPC will "
^XWB(8994,4053,2,1,1,4,0)="assume this is a NEW report and set up a new record."
^XWB(8994,4053,2,2,0)="DSIYDAT^2^240^1^2"
^XWB(8994,4053,2,2,1,0)="^^24^24^3140604^"
^XWB(8994,4053,2,2,1,1,0)="DSIYDAT"
^XWB(8994,4053,2,2,1,2,0)=" "
^XWB(8994,4053,2,2,1,3,0)="Array which contains each field in the Header Record in INTERNAL^EXTERNAL "
^XWB(8994,4053,2,2,1,4,0)="format."
^XWB(8994,4053,2,2,1,5,0)=" "
^XWB(8994,4053,2,2,1,6,0)="DSIYDAT(.01) = Report Name"
^XWB(8994,4053,2,2,1,7,0)="DSIYDAT(.02) = Function (can be blank or a combination of functions)"
^XWB(8994,4053,2,2,1,8,0)="DSIYDAT(.03) = Created By - Automatically updated by RPC"
^XWB(8994,4053,2,2,1,9,0)="DSIYDAT(.04) = Date Created - Automatically updated by RPC"
^XWB(8994,4053,2,2,1,10,0)="DSIYDAT(.05) = Modified By - Automatically updated by RPC"
^XWB(8994,4053,2,2,1,11,0)="DSIYDAT(.06) = Date Modified - Automatically updated by RPC"
^XWB(8994,4053,2,2,1,12,0)="DSIYDAT(.07) = Visibility"
^XWB(8994,4053,2,2,1,13,0)="               Internal = P:Public, R:Role Specific, V:Private"
^XWB(8994,4053,2,2,1,14,0)="DSIYDAT(.08) = Visibility Role (Only send Role^Role if .07 = Role "
^XWB(8994,4053,2,2,1,15,0)="               Specific"
^XWB(8994,4053,2,2,1,16,0)="DSIYDAT(.09) = Allow Changes"
^XWB(8994,4053,2,2,1,17,0)="DSIYDAT(.1)  = Allow Deletions"
^XWB(8994,4053,2,2,1,18,0)="DSIYDAT(.11) = Allow Value Changes"
^XWB(8994,4053,2,2,1,19,0)="               For .09, .1 and .11 - Internal = 1:Yes, 0:No"
^XWB(8994,4053,2,2,1,20,0)="DSIYDAT(.12) = Number of File Used (Number^Number)"
^XWB(8994,4053,2,2,1,21,0)="DSIYDAT(1.01)= Report Description (only send External piece - ""^desc"")"
^XWB(8994,4053,2,2,1,22,0)="               Limit length to 200"
^XWB(8994,4053,2,2,1,23,0)="DSIYDAT(2.01)= Page Header (Only send external piece - ""^header"")"
^XWB(8994,4053,2,2,1,24,0)="DSIYDAT(2.01)= Page Footer (Only send external piece - ""^footer"")"
^XWB(8994,4053,2,"B","DSIYDAT",2)=""
^XWB(8994,4053,2,"B","IEN",1)=""
^XWB(8994,4053,2,"PARAMSEQ",1,1)=""
^XWB(8994,4053,2,"PARAMSEQ",2,2)=""
^XWB(8994,4053,3,0)="^8994.03^7^7^3140604^^"
^XWB(8994,4053,3,1,0)="RETURN PARAMETER"
^XWB(8994,4053,3,2,0)=" "
^XWB(8994,4053,3,3,0)="DSIYRET(1)=""0^<Warning Message>    If there are warnings/no data"
^XWB(8994,4053,3,4,0)="DSIYRET(1)=""-1^<Error Message>     If there are errors"
^XWB(8994,4053,3,5,0)=" "
^XWB(8994,4053,3,6,0)="If Successful"
^XWB(8994,4053,3,7,0)="DSIYRET(1) = 1^Report IEN"
^XWB(8994,4054,0)="DSIYAD02 ADHCFLUP UPDT FLDS^ADHCFLUP^DSIYAD02^2"
^XWB(8994,4054,1,0)="^^7^7^3140604^"
^XWB(8994,4054,1,1,0)="ADHCFLUP"
^XWB(8994,4054,1,2,0)=" "
^XWB(8994,4054,1,3,0)="This RPC updates the fields in the report file ^DSIY(19685.61)"
^XWB(8994,4054,1,4,0)=" "
^XWB(8994,4054,1,5,0)="ASSUMPTION:  If this report is being changed, ALL fields will be resent "
^XWB(8994,4054,1,6,0)="to the RPC - the RPC will delete the current fields and replace with "
^XWB(8994,4054,1,7,0)="what's sent by the GUI."
^XWB(8994,4054,2,0)="^8994.02A^2^2"
^XWB(8994,4054,2,1,0)="IEN^1^20^1^1"
^XWB(8994,4054,2,1,1,0)="^^3^3^3140604^"
^XWB(8994,4054,2,1,1,1,0)="IEN"
^XWB(8994,4054,2,1,1,2,0)=" "
^XWB(8994,4054,2,1,1,3,0)="IEN to the Report File"
^XWB(8994,4054,2,2,0)="DSIYDAT^2^240^1^2"
^XWB(8994,4054,2,2,1,0)="^^23^23^3140604^"
^XWB(8994,4054,2,2,1,1,0)="DSIYDAT"
^XWB(8994,4054,2,2,1,2,0)=" "
^XWB(8994,4054,2,2,1,3,0)="Array of field data for each field"
^XWB(8994,4054,2,2,1,4,0)=" "
^XWB(8994,4054,2,2,1,5,0)="DSIYDAT(#) = Following Pieces"
^XWB(8994,4054,2,2,1,6,0)="P1:  FILE:FIELD"
^XWB(8994,4054,2,2,1,7,0)="P2:  ORDER #"
^XWB(8994,4054,2,2,1,8,0)="P3:  CONDITION 1 **"
^XWB(8994,4054,2,2,1,9,0)="P4:  CONDITION 1 VALUE"
^XWB(8994,4054,2,2,1,10,0)="P5:  CONDITION 2 **"
^XWB(8994,4054,2,2,1,11,0)="P6:  CONDITION 2 VALUE"
^XWB(8994,4054,2,2,1,12,0)=" "
^XWB(8994,4054,2,2,1,13,0)="Valid values for CONDITION fields:"
^XWB(8994,4054,2,2,1,14,0)="EQ   Equal To"
^XWB(8994,4054,2,2,1,15,0)="GT   Greater Than"
^XWB(8994,4054,2,2,1,16,0)="GE   Greater Than or Equal To"
^XWB(8994,4054,2,2,1,17,0)="LT   Less Than"
^XWB(8994,4054,2,2,1,18,0)="LE   Less Than or Equal To"
^XWB(8994,4054,2,2,1,19,0)="NOT  Not Equal To"
^XWB(8994,4054,2,2,1,20,0)="CON  Contains"
^XWB(8994,4054,2,2,1,21,0)="FOL  Follows"
^XWB(8994,4054,2,2,1,22,0)="NULL Field is Null"
^XWB(8994,4054,2,2,1,23,0)="NN   Field is Not Null"
^XWB(8994,4054,2,"B","DSIYDAT",2)=""
^XWB(8994,4054,2,"B","IEN",1)=""
^XWB(8994,4054,2,"PARAMSEQ",1,1)=""
^XWB(8994,4054,2,"PARAMSEQ",2,2)=""
^XWB(8994,4054,3,0)="^^7^7^3140604^"
^XWB(8994,4054,3,1,0)="RETURN PARAMETER"
^XWB(8994,4054,3,2,0)=" "
^XWB(8994,4054,3,3,0)="DSIYRET(1)=""0^<Warning Message>    If there are warnings/no data"
^XWB(8994,4054,3,4,0)="DSIYRET(1)=""-1^<Error Message>     If there are errors"
^XWB(8994,4054,3,5,0)=" "
^XWB(8994,4054,3,6,0)="If Successful"
^XWB(8994,4054,3,7,0)="DSIYRET(1)=1"
^XWB(8994,4055,0)="DSIYAD03 ADHCHDIN HEAD INFO^ADHCHDIN^DSIYAD03^4^^^^1"
^XWB(8994,4055,1,0)="^8994.01^3^3^3140604^^^^"
^XWB(8994,4055,1,1,0)="ADHCHDIN"
^XWB(8994,4055,1,2,0)=" "
^XWB(8994,4055,1,3,0)="RPC to return information on the Header of a Report"
^XWB(8994,4055,2,0)="^8994.02A^1^1"
^XWB(8994,4055,2,1,0)="IEN^1^20^1^1"
^XWB(8994,4055,2,1,1,0)="^8994.021^3^3^3140604^^^^"
^XWB(8994,4055,2,1,1,1,0)="IEN"
^XWB(8994,4055,2,1,1,2,0)=" "
^XWB(8994,4055,2,1,1,3,0)="IEN to the Report File ^DSIY(19685.61)"
^XWB(8994,4055,2,"B","IEN",1)=""
^XWB(8994,4055,2,"PARAMSEQ",1,1)=""
^XWB(8994,4055,3,0)="^8994.03^10^10^3140604^^^^"
^XWB(8994,4055,3,1,0)="RETURN PARAMETER"
^XWB(8994,4055,3,2,0)=" "
^XWB(8994,4055,3,3,0)="Field in the Header Record will be returned in the format"
^XWB(8994,4055,3,4,0)=" "
^XWB(8994,4055,3,5,0)="DSIYRET(FLD) = Following Pieces"
^XWB(8994,4055,3,6,0)=" "
^XWB(8994,4055,3,7,0)="P1:  FIELD #"
^XWB(8994,4055,3,8,0)="P2:  TABLE NAME"
^XWB(8994,4055,3,9,0)="P3:  INTERNAL VALUE"
^XWB(8994,4055,3,10,0)="P4:  EXTERNAL VALUE  (note Field #1.01) will ONLY return external"
^XWB(8994,4056,0)="DSIYAD03 ADHCFLIN FIELD INFO^ADHCFLIN^DSIYAD03^4^^^^1"
^XWB(8994,4056,1,0)="^8994.01^3^3^3170727^^^^"
^XWB(8994,4056,1,1,0)="ADHCFLIN"
^XWB(8994,4056,1,2,0)=" "
^XWB(8994,4056,1,3,0)="RPC to return all of the fields set up for a report"
^XWB(8994,4056,2,0)="^8994.02A^1^1"
^XWB(8994,4056,2,1,0)="IEN^1^20^1^1"
^XWB(8994,4056,2,1,1,0)="^8994.021^3^3^3170727^^^^"
^XWB(8994,4056,2,1,1,1,0)="IEN"
^XWB(8994,4056,2,1,1,2,0)=" "
^XWB(8994,4056,2,1,1,3,0)="IEN to the report file ^DSIY(19685.61)"
^XWB(8994,4056,2,"B","IEN",1)=""
^XWB(8994,4056,2,"PARAMSEQ",1,1)=""
^XWB(8994,4056,3,0)="^^17^17^3170727^"
^XWB(8994,4056,3,1,0)="RETURN PARAMETER"
^XWB(8994,4056,3,2,0)=" "
^XWB(8994,4056,3,3,0)="DSIYRET(1)=""0^<Warning Message>    If there are warnings/no data"
^XWB(8994,4056,3,4,0)="DSIYRET(1)=""-1^<Error Message>     If there are errors"
^XWB(8994,4056,3,5,0)=" "
^XWB(8994,4056,3,6,0)="If Successful, "
^XWB(8994,4056,3,7,0)=" "
^XWB(8994,4056,3,8,0)="DSIYRET(FILE:FIELD) = the following pieces"
^XWB(8994,4056,3,9,0)=" "
^XWB(8994,4056,3,10,0)=" ;RETURNS    DSIYRET(FILE:FIELD) = "
^XWB(8994,4056,3,11,0)="FILE:FIELD ^ ORDER# ^ CONDITION 1 ^ CONDITION 1 INTERNAL VALUE~EXTERNAL"
^XWB(8994,4056,3,12,0)="VALUE ^ CONDITION 2 ^ CONDITION 2 INTERNAL VALUE~EXTERNAL VALUE"
^XWB(8994,4056,3,13,0)="^ POINTER FLAG ^ XREF ^ UNUSED ^ UNUSED"
^XWB(8994,4056,3,14,0)="^ (P11) FIELD ACCESS:"
^XWB(8994,4056,3,15,0)="          -1 indicates no READ ACCESS for this field "
^XWB(8994,4056,3,16,0)="          -2 indicates no READ ACCESS for the linked-to file on a pointer"
^XWB(8994,4056,3,17,0)="          null - complete access to the field"
^XWB(8994,4057,0)="DSIYAD04 ADHCRP01 REPORT^ADHCRP01^DSIYAD04^4^^^^1"
^XWB(8994,4057,1,0)="^8994.01^3^3^3140616^"
^XWB(8994,4057,1,1,0)="ADHCRP01"
^XWB(8994,4057,1,2,0)=" "
^XWB(8994,4057,1,3,0)="Calls taskman to build the Ad-Hoc Report Data."
^XWB(8994,4057,2,0)="^8994.02A^2^2"
^XWB(8994,4057,2,1,0)="IEN^1^20^1^1"
^XWB(8994,4057,2,1,1,0)="^8994.021^3^3^3140616^^"
^XWB(8994,4057,2,1,1,1,0)="IEN"
^XWB(8994,4057,2,1,1,2,0)=" "
^XWB(8994,4057,2,1,1,3,0)="IEN to the Ad-Hoc Report Setup file ^DSIY(19685.61)"
^XWB(8994,4057,2,2,0)="ESTART^1^20^0^2"
^XWB(8994,4057,2,2,1,0)="^8994.021^4^4^3140616^^"
^XWB(8994,4057,2,2,1,1,0)="ESTART"
^XWB(8994,4057,2,2,1,2,0)=" "
^XWB(8994,4057,2,2,1,3,0)="Report start time"
^XWB(8994,4057,2,2,1,4,0)="format VISTA Date.HHMMSS - i.e., 3140605.0930  for 9:30 AM on 6/5/2014"
^XWB(8994,4057,2,"B","ESTART",2)=""
^XWB(8994,4057,2,"B","IEN",1)=""
^XWB(8994,4057,2,"PARAMSEQ",1,1)=""
