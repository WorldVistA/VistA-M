^XWB(8994,5185,3,161,0)="                        ""Name"": ""CHY BZZZZZ CLINIC"""
^XWB(8994,5185,3,162,0)="                },"
^XWB(8994,5185,3,163,0)="                ""ResourceIEN"": 4105,"
^XWB(8994,5185,3,164,0)="                ""RoutingSlipPrintDate"": """","
^XWB(8994,5185,3,165,0)="                ""RoutingSlipPrinted"": """","
^XWB(8994,5185,3,166,0)="                ""SchedulerName"": """","
^XWB(8994,5185,3,167,0)="                ""SchedulingApplication"": """","
^XWB(8994,5185,3,168,0)="                ""SchedulingRequestType"": ""'NEXT AVAILABLE' APPT."","
^XWB(8994,5185,3,169,0)="                ""SpecialSurveyDisposition"": """","
^XWB(8994,5185,3,170,0)="                ""StartTimeFM"": 3260319.09,"
^XWB(8994,5185,3,171,0)="                ""Status"": ""FUTURE"","
^XWB(8994,5185,3,172,0)="                ""StatusCancelDateTime"": """","
^XWB(8994,5185,3,173,0)="                ""VVSApptID"": """","
^XWB(8994,5185,3,174,0)="                ""VeteranVideoCallURL"": """","
^XWB(8994,5185,3,175,0)="                ""Walkin"": ""NO"","
^XWB(8994,5185,3,176,0)="                ""WardLocation"": """","
^XWB(8994,5185,3,177,0)="                ""XRAY"": """","
^XWB(8994,5185,3,178,0)="                ""XrayDateTime"": """""
^XWB(8994,5185,3,179,0)="   }"
^XWB(8994,5185,3,180,0)="  ]"
^XWB(8994,5185,3,181,0)="}"
^XWB(8994,5186,0)="XUS IAM RA ADD OR REPLACE^ADDRA^XUREMAP^2^A^^^^1^^0"
^XWB(8994,5186,1,0)="^8994.01^3^3^3250422^^"
^XWB(8994,5186,1,1,0)="This restricted RPC is used exclusively by the Identity and Access "
^XWB(8994,5186,1,2,0)="Management (IAM) service to add or update (rip/replace) an entry in the"
^XWB(8994,5186,1,3,0)="REMOTE APPLICATION file (#8994.5)."
^XWB(8994,5186,2,0)="^8994.02A^1^1"
^XWB(8994,5186,2,1,0)="XUARR^2^^1^1"
^XWB(8994,5186,2,1,1,0)="^8994.021^20^20^3250422^^"
^XWB(8994,5186,2,1,1,1,0)="The internal values are used to add or update a remote application."
^XWB(8994,5186,2,1,1,2,0)="   "
^XWB(8994,5186,2,1,1,3,0)="XUARR(#) = FILE #;FIELD #^FIELD NAME^INTERNAL VALUE^EXTERNAL VALUE"
^XWB(8994,5186,2,1,1,4,0)="     XUARR(#)=""8994.5;.01^NAME^^"""
^XWB(8994,5186,2,1,1,5,0)="     XUARR(#)=""8994.5;.02^CONTEXTOPTION^^"" <-- must exist"
^XWB(8994,5186,2,1,1,6,0)="     XUARR(#)=""8994.5;.03^APPLICATIONCODE^^"""
^XWB(8994,5186,2,1,1,7,0)=" "
^XWB(8994,5186,2,1,1,8,0)="All fields below not marked optional are required."
^XWB(8994,5186,2,1,1,9,0)=" "
^XWB(8994,5186,2,1,1,10,0)="XUARR(#)=""8994.5;.01^NAME^<name of remote application>"""
^XWB(8994,5186,2,1,1,11,0)="XUARR(#)=""8994.5;.02^CONTEXTOPTION^<name of context option>"""
^XWB(8994,5186,2,1,1,12,0)="XUARR(#)=""8994.5;.03^APPLICATIONCODE^<unencrypted application code "
^XWB(8994,5186,2,1,1,13,0)="(security phrase)>"""
^XWB(8994,5186,2,1,1,14,0)="XUARR(#)=""8994.5;.04^CAN ADD USERS^<optional: default YES {YES, NO}>"""
^XWB(8994,5186,2,1,1,15,0)="XUARR(#)=""8994.5;.05^DISABLED^<optional: default NO {YES, NO}>"""
^XWB(8994,5186,2,1,1,16,0)="XUARR(#)=""8994.51;.01^CALLBACKTYPE^<callback type {RPC-BROKER, "
^XWB(8994,5186,2,1,1,17,0)="M2M-BROKER, HTTP, STATION-NUMBER>"""
^XWB(8994,5186,2,1,1,18,0)="XUARR(#)=""8994.51;.02^CALLBACKPORT^<optional: callback port>"""
^XWB(8994,5186,2,1,1,19,0)="XUARR(#)=""8994.51;.03^CALLBACKSERVER^<optional: callback server>"""
^XWB(8994,5186,2,1,1,20,0)="XUARR(#)=""8994.51;.04^URLSTRING^<optional: URL string>"""
^XWB(8994,5186,2,"B","XUARR",1)=""
^XWB(8994,5186,2,"PARAMSEQ",1,1)=""
^XWB(8994,5186,3,0)="^^13^13^3250317^"
^XWB(8994,5186,3,1,0)="This RPC returns success or failure."
^XWB(8994,5186,3,2,0)=" "
^XWB(8994,5186,3,3,0)="  Success (input provided to RPC updates or adds a REMOTE APPLICATION):"
^XWB(8994,5186,3,4,0)=" "
^XWB(8994,5186,3,5,0)="    RETURN(0) = 1^LOCAL REM APP IEN^STATION NUMBER"
^XWB(8994,5186,3,6,0)=" "
^XWB(8994,5186,3,7,0)="  Failure (no add or update occurred):"
^XWB(8994,5186,3,8,0)=" "
^XWB(8994,5186,3,9,0)="    RETURN(0) = ""-1^No data passed"""
^XWB(8994,5186,3,10,0)="    RETURN(0) = ""-1^Context Option does not exist"""
^XWB(8994,5186,3,11,0)="    RETURN(0) = ""-1^Input missing Application Code."""
^XWB(8994,5186,3,12,0)="    RETURN(0) = ""-1^Application Code already in use."""
^XWB(8994,5186,3,13,0)="    RETURN(0) = ""-1^ <FileMan UPDATER error> "" "
^XWB(8994,5187,0)="XUS IAM RA QUERY^RAQ2^XUREMAP^2^R^^^^^^0"
^XWB(8994,5187,1,0)="^8994.01^5^5^3250422^^"
^XWB(8994,5187,1,1,0)="This remote procedure provides IAM Service with a method to query VistA "
^XWB(8994,5187,1,2,0)="instances for the Remote Application file entry configuration.  IAM "
^XWB(8994,5187,1,3,0)="Service is the authoritative source for approved Remote Applications and "
^XWB(8994,5187,1,4,0)="it is incumbent upon IAM Service to monitor the status of this file at"
^XWB(8994,5187,1,5,0)="all VistA sites."
^XWB(8994,5187,2,0)="^8994.02A^2^2"
^XWB(8994,5187,2,1,0)="NAME^1^30^1^1"
^XWB(8994,5187,2,1,1,0)="^8994.021^2^2^3250422^^^"
^XWB(8994,5187,2,1,1,1,0)="Full name of the remote application entry to search for OR leading "
^XWB(8994,5187,2,1,1,2,0)="characters to return partial matches"
^XWB(8994,5187,2,2,0)="FLAGS^1^2^0^2"
^XWB(8994,5187,2,2,1,0)="^8994.021^5^5^3250422^^^^"
^XWB(8994,5187,2,2,1,1,0)="FLAGS must be:"
^XWB(8994,5187,2,2,1,2,0)="X = NAME input must match an entry exactly;  "
^XWB(8994,5187,2,2,1,3,0)="  AND/OR"
^XWB(8994,5187,2,2,1,4,0)="M = return context option (#19) data that is pointed to by .02 field "
^XWB(8994,5187,2,2,1,5,0)="(CONTEXT OPTION)."
^XWB(8994,5187,2,"B","FLAGS",2)=""
^XWB(8994,5187,2,"B","NAME",1)=""
^XWB(8994,5187,2,"PARAMSEQ",1,1)=""
^XWB(8994,5187,2,"PARAMSEQ",2,2)=""
^XWB(8994,5187,3,0)="^^39^39^3250410^"
^XWB(8994,5187,3,1,0)="If Failure:"
^XWB(8994,5187,3,2,0)="  XURET(0) = 0 ^ matching entries^station #"
^XWB(8994,5187,3,3,0)=" "
^XWB(8994,5187,3,4,0)="If Error:"
^XWB(8994,5187,3,5,0)="  XURET(0) = -1 ^ <error>"
^XWB(8994,5187,3,6,0)="  "
^XWB(8994,5187,3,7,0)="If Success:"
^XWB(8994,5187,3,8,0)="   XURET(#) = ""C ^ n matching (entry or entries)^station #"
^XWB(8994,5187,3,9,0)="     (where C is a response code of -1, 0, or 1 and"
^XWB(8994,5187,3,10,0)="     n is the number of matching entries)"
^XWB(8994,5187,3,11,0)="   XURET(#) = file;field no.^ field name^data"
^XWB(8994,5187,3,12,0)="   XURET(#) = file;field no.^ field name^data"
^XWB(8994,5187,3,13,0)="   "
^XWB(8994,5187,3,14,0)="   REPEATED AS:"
^XWB(8994,5187,3,15,0)="   {"
^XWB(8994,5187,3,16,0)="      XURET(#) = 8994.5;.01^NAME ^ ra name"
^XWB(8994,5187,3,17,0)="      XURET(#) = 8994.5;.02^CONTEXTOPTION ^ ra context option"
^XWB(8994,5187,3,18,0)="      XURET(#) = 8994.5;.03^APPLICATION CODE ^ ra app code (encrypted)"
^XWB(8994,5187,3,19,0)="      XURET(#) = 8994.5;.04^CAN ADD USERS ^ ra can add users (boolean "
^XWB(8994,5187,3,20,0)="YES/NO)"
^XWB(8994,5187,3,21,0)="      XURET(#) = 8994.5;.05^DISABLED ^ ra disabled (boolean YES/NO)"
^XWB(8994,5187,3,22,0)="      XURET(#) = 8994.51;.01^CALLBACKTYPE^ ra callback type"
^XWB(8994,5187,3,23,0)="      XURET(#) = 8994.51;.02^CALLBACKPORT^ ra callback port"
^XWB(8994,5187,3,24,0)="      XURET(#) = 8994.51;.03^CALLBACKSERVER^ ra callback server"
^XWB(8994,5187,3,25,0)="      XURET(#) = 8994.51;.04^URLSTRING^ ra url string"
^XWB(8994,5187,3,26,0)="   } for each matching entry"
^XWB(8994,5187,3,27,0)="  "
^XWB(8994,5187,3,28,0)="   AND, if the M flag is set for the context multiple, with each entry "
^XWB(8994,5187,3,29,0)=" above..."
^XWB(8994,5187,3,30,0)="   {"
^XWB(8994,5187,3,31,0)="      XURET(#) = 19;.01^NAME^context option name"
^XWB(8994,5187,3,32,0)="      XURET(#) = 19;1^MENU TEXT^context option menu text"
^XWB(8994,5187,3,33,0)="      XURET(#) = 19;1.1^UPPERCASE MENU TEXT^context option UC  menu text"
^XWB(8994,5187,3,34,0)="         { XURET(#) = 19;3.5^DESCRIPTION^context option wp ln }"
^XWB(8994,5187,3,35,0)="      XURET(#) = 19;3.6^CREATOR^context option creator"
^XWB(8994,5187,3,36,0)="      XURET(#) = 19;4^TYPE^ context option type"
^XWB(8994,5187,3,37,0)="      XURET(#) = 19;99.1^TIMESTAMP OF PRIMARY MENU^$h timestamp"
^XWB(8994,5187,3,38,0)="         { XURET(#) = 19.05;.01^RPC^context option attached RPC  }"
^XWB(8994,5187,3,39,0)="   }"
^XWB(8994,5188,0)="XUS IAM RA CONTEXT QUERY^CONTEXTQ^XUREMAP^2"
^XWB(8994,5188,1,0)="^^18^18^3250314^"
^XWB(8994,5188,1,1,0)="API restricted to IAM to Query Context Options and return entry data."
^XWB(8994,5188,1,2,0)=" "
^XWB(8994,5188,1,3,0)="Entry point is covered by an integration agreement"
^XWB(8994,5188,1,4,0)=" "
^XWB(8994,5188,1,5,0)="called from rpc: XUS IAM RA CONTEXT QUERY"
^XWB(8994,5188,1,6,0)=" "
^XWB(8994,5188,1,7,0)=" "
^XWB(8994,5188,1,8,0)=" INPUT:  NAME--full name of entry to search for an exact match."
^XWB(8994,5188,1,9,0)=" "
^XWB(8994,5188,1,10,0)="  SUCCESS:"
^XWB(8994,5188,1,11,0)="    XURET(0)=""LOCAL IEN^Option [name of matching entry]^SITE #"""
^XWB(8994,5188,1,12,0)="    XURET(1)=file;field no.^ field name^data"
^XWB(8994,5188,1,13,0)="    XURET(2)=file;field no.^ field name^data"
^XWB(8994,5188,1,14,0)="    ..."
^XWB(8994,5188,1,15,0)="    XURET(n)=file;field no.^ field name^data"
^XWB(8994,5188,1,16,0)=" "
^XWB(8994,5188,1,17,0)="  FAIL:"
^XWB(8994,5188,1,18,0)="    XURET(0)=""-1^Option [name of matching entry] not found.^SITE #"""
^XWB(8994,5188,2,0)="^8994.02A^1^1"
^XWB(8994,5188,2,1,0)="OPTION NAME^1^30^1^1"
^XWB(8994,5188,2,1,1,0)="^8994.021^1^1^3250317^^^"
^XWB(8994,5188,2,1,1,1,0)="The NAME (#.01) of the B-type entry in the Option (#19) file. "
^XWB(8994,5188,2,"B","OPTION NAME",1)=""
^XWB(8994,5188,2,"PARAMSEQ",1,1)=""
^XWB(8994,5188,3,0)="^^21^21^3250410^"
^XWB(8994,5188,3,1,0)="If SUCCESS:"
^XWB(8994,5188,3,2,0)=" "
^XWB(8994,5188,3,3,0)="XURET(#) = 1^Option <option name> found (IEN: <ien>)."
^XWB(8994,5188,3,4,0)="XURET(#) = 19;.01^NAME^<option name>"
^XWB(8994,5188,3,5,0)="XURET(#) = 19;1^MENU TEXT^<menu text>"
^XWB(8994,5188,3,6,0)="XURET(#) = 19;1.1^UPPERCASE MENU TEXT^<upper case menu text>"
^XWB(8994,5188,3,7,0)="0 to N of"
^XWB(8994,5188,3,8,0)="{"
^XWB(8994,5188,3,9,0)="  XURET(#) = 19;3.5^DESCRIPTION^<description line>"
^XWB(8994,5188,3,10,0)="}"
^XWB(8994,5188,3,11,0)="XURET(#) = 19;3.6^<creator last,first>"""
^XWB(8994,5188,3,12,0)="XURET(#) = 19;4^TYPE^<option type: AEIMPROQXSLCWZB>"
^XWB(8994,5188,3,13,0)="XURET(#) = 19;99.1^TIMESTAMP OF PRIMARY MENU^<$h timestamp>"
^XWB(8994,5188,3,14,0)="0 to N of"
^XWB(8994,5188,3,15,0)="{"
^XWB(8994,5188,3,16,0)="  XURET(#) = 19.05;.01^RPC^<attached rpc name>"
^XWB(8994,5188,3,17,0)="  XURET(#) = 19.05;1^RPCKEY^<key associated with rpc, if any>"
^XWB(8994,5188,3,18,0)="}"
^XWB(8994,5188,3,19,0)=" "
^XWB(8994,5188,3,20,0)="If FAILURE:"
^XWB(8994,5188,3,21,0)="XURET(0) = 0^Option <option name> not found."
^XWB(8994,5189,0)="XUS IAM RA CONTEXT ADD^ADDEP^XUREMAP^2^A^^^^^^0"
^XWB(8994,5189,1,0)="^^3^3^3250324^"
^XWB(8994,5189,1,1,0)="This RPC is restricted to IAM.  To support IAM authority over remote "
^XWB(8994,5189,1,2,0)="application updates, this RPC provides an interface to add or update"
^XWB(8994,5189,1,3,0)="Context Options (type-B) in the Option (#19) file."
^XWB(8994,5189,2,0)="^8994.02A^1^1"
^XWB(8994,5189,2,1,0)="OPTION DEFINITION^2^^1^1"
^XWB(8994,5189,2,1,1,0)="^^15^15^3250325^"
^XWB(8994,5189,2,1,1,1,0)="XUARR(#) = FILE #;FIELD #^FIELD NAME^INTERNAL VALUE^EXTERNAL VALUE"
^XWB(8994,5189,2,1,1,2,0)="  "
^XWB(8994,5189,2,1,1,3,0)="XUARR(#)=""19;.01^NAME^<name of option>^"""
^XWB(8994,5189,2,1,1,4,0)="XUARR(#)=""19;1^MENU TEXT^<menu text of option>^"""
^XWB(8994,5189,2,1,1,5,0)="XUARR(#)=""19;4^TYPE^B^"""
^XWB(8994,5189,2,1,1,6,0)=" "
^XWB(8994,5189,2,1,1,7,0)="0 to N of"
^XWB(8994,5189,2,1,1,8,0)="{"
^XWB(8994,5189,2,1,1,9,0)="  XUARR(#)=""19;3.5^DESCRIPTION^line n of option description."""
^XWB(8994,5189,2,1,1,10,0)="}"
^XWB(8994,5189,2,1,1,11,0)="0 to N of"
^XWB(8994,5189,2,1,1,12,0)="{ "
^XWB(8994,5189,2,1,1,13,0)="  XUARR(#)=""19.05;.01^NAME^<name of RPC>^"""
^XWB(8994,5189,2,1,1,14,0)="  XUARR(#)=""19.05;1^RPCKEY^<optional: RPC Key>^"""
^XWB(8994,5189,2,1,1,15,0)="}"
^XWB(8994,5189,2,"B","OPTION DEFINITION",1)=""
^XWB(8994,5189,2,"PARAMSEQ",1,1)=""
^XWB(8994,5189,3,0)="^8994.03^12^12^3250325^^^"
^XWB(8994,5189,3,1,0)="Success:"
^XWB(8994,5189,3,2,0)="  XURET(0) = 1^IEN of new or updated  record"
^XWB(8994,5189,3,3,0)=" "
^XWB(8994,5189,3,4,0)="Fail:"
^XWB(8994,5189,3,5,0)="  XURET(0) = -1^No data passed"
^XWB(8994,5189,3,6,0)="  XURET(0) = -1^<FileMan Filing error>"
^XWB(8994,5189,3,7,0)="  XURET(0) = -1^Nothing filed"
^XWB(8994,5189,3,8,0)="  XURET(0) = -1^Only B-type (BROKER) options are allowed."
^XWB(8994,5189,3,9,0)="  XURET(0) = -1^Invalid security key: Security key _____ does not exist."
^XWB(8994,5189,3,10,0)="  XURET(0) = -1^Invalid RPC: Remote procedure ___ does not exist."
^XWB(8994,5189,3,11,0)="  XURET(0) = -1^Invalid file number"
^XWB(8994,5189,3,12,0)="  XURET(0) = -1^ _____ entry locked for file: 19"
^XWB(8994,5190,0)="XUS IAM RA ENABLE^RAENABLE^XUREMAP^2^^0^^^^^0"
^XWB(8994,5190,1,0)="^8994.01^3^3^3250318^^^"
^XWB(8994,5190,1,1,0)="This restricted RPC is used exclusively by the Identity and Access "
^XWB(8994,5190,1,2,0)="Management (IAM) service to enable or disable an entry in the REMOTE"
^XWB(8994,5190,1,3,0)="APPLICATION file (#8994.5)."
^XWB(8994,5190,2,0)="^8994.02A^2^2"
^XWB(8994,5190,2,1,0)="XURANAME^1^30^1^1"
^XWB(8994,5190,2,1,1,0)="^^3^3^3250314^"
^XWB(8994,5190,2,1,1,1,0)="The value of the NAME (#.01) field of the entry in the REMOTE APPLICATION "
^XWB(8994,5190,2,1,1,2,0)="(#8994.5) file, for the REMOTE APPLICATION entry that is to be ENABLED or "
^XWB(8994,5190,2,1,1,3,0)="DISABLED according to the XUENABLE parameter."
^XWB(8994,5190,2,2,0)="XUENABLE^1^1^1^2"
^XWB(8994,5190,2,2,1,0)="^8994.021^1^1^3250318^^"
^XWB(8994,5190,2,2,1,1,0)="XUENABLE (REQUIRED)--boolean: 1 for enable, 0 for disable"
^XWB(8994,5190,2,"B","XUENABLE",2)=""
^XWB(8994,5190,2,"B","XURANAME",1)=""
^XWB(8994,5190,2,"PARAMSEQ",1,1)=""
^XWB(8994,5190,2,"PARAMSEQ",2,2)=""
^XWB(8994,5190,3,0)="^8994.03^6^6^3250318^^"
^XWB(8994,5190,3,1,0)="If SUCCESS:  "
^XWB(8994,5190,3,2,0)="XURET(0) = 1 ^ <name of enabled/disabled remote application> ^ <ENABLE / "
^XWB(8994,5190,3,3,0)="DISABLE> ^ SITE #"
^XWB(8994,5190,3,4,0)="  "
^XWB(8994,5190,3,5,0)="If Failure: "
^XWB(8994,5190,3,6,0)="XURET(0) = -1 ^ <name of remote application> ^ error text ^ SITE #"
^XWB(8994,5191,0)="XUS IAM RA CAN ADD^CANADD^XUREMAP^2^^0^^^^^0"
^XWB(8994,5191,1,0)="^8994.01^5^5^3250318^^"
^XWB(8994,5191,1,1,0)="RPC is used exclusively by the Identity and Access Management (IAM)"
^XWB(8994,5191,1,2,0)="service to mark an entry in the remote application file (#8994.5) as"
^XWB(8994,5191,1,3,0)="either "
^XWB(8994,5191,1,4,0)="CAN ADD USERS=YES OR "
^XWB(8994,5191,1,5,0)="CAN ADD USERS=NO"
^XWB(8994,5191,2,0)="^8994.02A^2^2"
^XWB(8994,5191,2,1,0)="XURANAME^1^30^1^1"
^XWB(8994,5191,2,1,1,0)="^^2^2^3250318^"
^XWB(8994,5191,2,1,1,1,0)="The value of the NAME (#.01) field of the entry in the REMOTE APPLICATION "
^XWB(8994,5191,2,1,1,2,0)="(#8994.5) file, for the REMOTE APPLICATION entry that is to be disabled."
^XWB(8994,5191,2,2,0)="XUCANADD^1^1^1^2"
