^XWB(8994,4004,1,0)="^^11^11^3130509^"
^XWB(8994,4004,1,1,0)="EQWOCHK"
^XWB(8994,4004,1,2,0)=" "
^XWB(8994,4004,1,3,0)="The GUI should check and only ask about an incoming inspection work order "
^XWB(8994,4004,1,4,0)="for single or multiple ADD entries (not on edit)."
^XWB(8994,4004,1,5,0)=" "
^XWB(8994,4004,1,6,0)="But there are also checks within VistA to see whether or not to ask and "
^XWB(8994,4004,1,7,0)="what the default response should be."
^XWB(8994,4004,1,8,0)=" "
^XWB(8994,4004,1,9,0)="The GUI can use this RPC when equipment is loaded as this setting is not "
^XWB(8994,4004,1,10,0)="depending upon the Equipment IEN or the user's DUZ - it is across the "
^XWB(8994,4004,1,11,0)="board for all equipment."
^XWB(8994,4004,3,0)="^^10^10^3130509^"
^XWB(8994,4004,3,1,0)="RETURN PARAMETER"
^XWB(8994,4004,3,2,0)=" "
^XWB(8994,4004,3,3,0)="DSIYRET(1)=following pieces"
^XWB(8994,4004,3,4,0)="  p1:  0 if you should NOT ask about an incoming inspection work order"
^XWB(8994,4004,3,5,0)="       1 if the GUI should ask to create an incoming inspection work order"
^XWB(8994,4004,3,6,0)=" "
^XWB(8994,4004,3,7,0)="  p2:  0 if the default answer for creating a work order is ""NO"""
^XWB(8994,4004,3,8,0)="       1 if the default answer for createing a work order is ""YES"""
^XWB(8994,4004,3,9,0)=" "
^XWB(8994,4004,3,10,0)="  p3:  Explanation"
