^XWB(8994,4216,1,1,0)="This RPC returns clinic enrollment information for a Prosthetic Suspense "
^XWB(8994,4216,1,2,0)="IEN."
^XWB(8994,4216,2,0)="^8994.02A^1^1"
^XWB(8994,4216,2,1,0)="DSSO668^1^30^1^1"
^XWB(8994,4216,2,1,1,0)="^8994.021^1^1^3171017^^"
