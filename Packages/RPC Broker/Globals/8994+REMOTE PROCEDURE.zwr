^XWB(8994,3977,0)="DSIYUTL3 XREFSCH SCH W/I XREF^XREFSCH^DSIYUTL3^4^^^^1"
^XWB(8994,3977,1,0)="^8994.01^9^9^3130419^^^"
^XWB(8994,3977,1,1,0)="XREFSCH"
^XWB(8994,3977,1,2,0)=" "
^XWB(8994,3977,1,3,0)="Returns all values within a node of an XREF.  For instance, if you want "
^XWB(8994,3977,1,4,0)="all records for a particular piece of Equipment in Work Orders, the FIND "
^XWB(8994,3977,1,5,0)="command in Vista will look through all XREF's.  This utility will only "
^XWB(8994,3977,1,6,0)="loop through ^ENG(6920,""G"",<equipment IEN>) and return those values"
^XWB(8994,3977,1,7,0)=" "
^XWB(8994,3977,1,8,0)="This provides a quick way to return items which are contained in a "
^XWB(8994,3977,1,9,0)="specific XREF."
^XWB(8994,3977,2,0)="^8994.02A^3^3"
^XWB(8994,3977,2,1,0)="FILE^1^15^1^1"
^XWB(8994,3977,2,1,1,0)="^^3^3^3130313^"
