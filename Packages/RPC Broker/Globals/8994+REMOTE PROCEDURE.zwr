^XWB(8994,2471,3,0)="^^1^1^3191220^"
^XWB(8994,2471,3,1,0)="Updates the Fee waiver data, returns an array"
^XWB(8994,2472,0)="WII ADT^EN^WIIADT1^4^^^^1"
^XWB(8994,2472,1,0)="^^5^5^3081022^"
^XWB(8994,2472,1,1,0)="This remote procedure is run ONLY at the central collection point."
^XWB(8994,2472,1,2,0)="It generates a list of all admissions and discharges that have been"
^XWB(8994,2472,1,3,0)="transferred to the main collection point.  The RPC allows the user to"
^XWB(8994,2472,1,4,0)="select all entries that have not been sent to DEFAS or regenerate the list"
^XWB(8994,2472,1,5,0)="by a date.  Data is extracted from the WII ADT ALL SITES FILE (#987.7)."
^XWB(8994,2472,2,0)="^8994.02A^1^1"
^XWB(8994,2472,2,1,0)="DATE^3^15^1^1"
