^XWB(8994,3768,0)="MAGN CPRS IMAGE LIST^IMAGEL^MAGNTRAI^4^R^^^1"
^XWB(8994,3768,1,0)="^8994.01^1^1^3250319^^^^"
^XWB(8994,3768,1,1,0)="List Images for Rad Exams or TIU Notes by CPRS context"
^XWB(8994,3768,2,0)="^8994.02A^3^3"
^XWB(8994,3768,2,1,0)="DATA^2^^1^1"
^XWB(8994,3768,2,1,1,0)="^8994.021^4^4^3250319^^^^"
^XWB(8994,3768,2,1,1,1,0)="Array holds Windows message received from CPRS in format"
^XWB(8994,3768,2,1,1,2,0)="       e.g. RPT^CPRS^29027^RA^i79029185.9998-1"
^XWB(8994,3768,2,1,1,3,0)="           or"
^XWB(8994,3768,2,1,1,4,0)="            RPT^CPRS^4658^TIU^2243408^^^^^^^^1"
^XWB(8994,3768,2,2,0)="IMGLESS^1^^0^2"
^XWB(8994,3768,2,2,1,0)="^^1^1^3250319^"
^XWB(8994,3768,2,2,1,1,0)="flag to speed up queries: if=1 (true), just get study-level data"
^XWB(8994,3768,2,3,0)="INCRT^1^^0^3"
^XWB(8994,3768,2,3,1,0)="^^2^2^3250319^"
^XWB(8994,3768,2,3,1,1,0)="Set to 1 to return the radiology report text along with the study "
^XWB(8994,3768,2,3,1,2,0)="information."
^XWB(8994,3768,2,"B","DATA",1)=""
^XWB(8994,3768,2,"B","IMGLESS",2)=""
^XWB(8994,3768,2,"B","INCRT",3)=""
^XWB(8994,3768,2,"PARAMSEQ",1,1)=""
^XWB(8994,3768,2,"PARAMSEQ",2,2)=""
^XWB(8994,3768,2,"PARAMSEQ",3,3)=""
^XWB(8994,3768,3,0)="^8994.03^5^5^3250319^^^^"
^XWB(8994,3768,3,1,0)="if error @MAGRY@(0) = 0 ^Error message"
^XWB(8994,3768,3,2,0)="if success @MAGRY@(0) = 1"
^XWB(8994,3768,3,3,0)="           @MAGRY@(1..n) = CONTEXTID | 0 | error message"
^XWB(8994,3768,3,4,0)="                           CONTEXTID | 1 | images in format defined in"
^XWB(8994,3768,3,5,0)="                             RPC [MAGG CPRS RAD EXAM] or [MAG3 CPRS TIU NOTE]"
^XWB(8994,3769,0)="EC GET DEFAULT PROVIDER^ECDEFPRV^ECUERPC2^1^R^^^1"
^XWB(8994,3769,1,0)="^8994.01^19^19^3161108^^"
^XWB(8994,3769,1,1,0)="This remote procedure will return the default provider based on the DSS "
^XWB(8994,3769,1,2,0)="Unit and the user entering data into Event Capture."
^XWB(8994,3769,1,3,0)=" "
^XWB(8994,3769,1,4,0)="If the user is an active provider then they will be the default "
^XWB(8994,3769,1,5,0)="regardless of the DSS unit's send to PCE setting."
^XWB(8994,3769,1,6,0)=" "
^XWB(8994,3769,1,7,0)="If the user is not an active provider then a check is made to see the "
^XWB(8994,3769,1,8,0)="last person they referenced in the NEW PERSON file (#200). If that person"
^XWB(8994,3769,1,9,0)="is an active provider then they will be the default."
^XWB(8994,3769,1,10,0)=" "
^XWB(8994,3769,1,11,0)="If the DSS unit's send to PCE setting is set to send no records then the "
^XWB(8994,3769,1,12,0)="user will be the default if they are found in the EVENT CAPTURE PROVIDER "
^XWB(8994,3769,1,13,0)="file (#722).  If the user is not identified as an event capture provider "
^XWB(8994,3769,1,14,0)="then a check is made to see the last person they referenced in the NEW "
^XWB(8994,3769,1,15,0)="PERSON file (#200).  If that person is in the EVENT CAPTURE PROVIDER file "
^XWB(8994,3769,1,16,0)="(#722) then they will be the default."
^XWB(8994,3769,1,17,0)=" "
^XWB(8994,3769,1,18,0)="If none of the checks produces a provider then there will be no default "
^XWB(8994,3769,1,19,0)="identified."
^XWB(8994,3769,2,0)="^8994.02A^1^1"
^XWB(8994,3769,2,1,0)="ECARY^1^^1"
^XWB(8994,3769,2,1,1,0)="^^3^3^3161108^"
^XWB(8994,3769,2,1,1,1,0)="The input variable ECARY contains the IEN of the DSS unit concatenated"
^XWB(8994,3769,2,1,1,2,0)="with the date/time of the procedure. If a date/time isn't sent, today's"
^XWB(8994,3769,2,1,1,3,0)="date will be assumed."
^XWB(8994,3769,2,"B","ECARY",1)=""
^XWB(8994,3769,3,0)="^^2^2^3161108^"
^XWB(8994,3769,3,1,0)="The RESULTS variable will contain either the IEN^User Name or -1"
^XWB(8994,3769,3,2,0)="if no default is found."
^XWB(8994,3770,0)="EC DELETE TEST PATIENT DATA^DTPD^ECUMRPC2^4^R^^^1"
^XWB(8994,3770,1,0)="^^19^19^3161221^"
^XWB(8994,3770,1,1,0)="This RPC is used to delete any test patient data from the EVENT CAPTURE "
^XWB(8994,3770,1,2,0)="PATIENT file (#721). "
^XWB(8994,3770,1,3,0)=" "
^XWB(8994,3770,1,4,0)="If the patient is identified as a test patient and the procedure"
^XWB(8994,3770,1,5,0)="associated with the test patient record is not in the range of CH103 to"
^XWB(8994,3770,1,6,0)="CH109 then the record will be deleted.  If the procedure is in this range "
^XWB(8994,3770,1,7,0)="for a test patient, the record will not be deleted.  Test patients, with "
^XWB(8994,3770,1,8,0)="procedures in this range, are allowed for recording Chaplain workload."
^XWB(8994,3770,1,9,0)=" "
^XWB(8994,3770,1,10,0)="This RPC can be invoked in two modes.  The first mode, ""I"" is for "
^XWB(8994,3770,1,11,0)="gathering information about the account, the date/time of the last "
^XWB(8994,3770,1,12,0)="deletion, the user who ran the deletion and the status of the deletion "
^XWB(8994,3770,1,13,0)="process. The second mode, ""D"", is for deleting patient records as defined"
^XWB(8994,3770,1,14,0)="above."
^XWB(8994,3770,1,15,0)=" "
^XWB(8994,3770,1,16,0)="Care should be used when running this RPC as the data cannot be restored "
^XWB(8994,3770,1,17,0)="once it's deleted. In addition, this process could take a while to "
^XWB(8994,3770,1,18,0)="complete.  The amount of time needed will vary based on the total number "
^XWB(8994,3770,1,19,0)="of records to be reviewed and the total number of records to be deleted."
^XWB(8994,3770,2,0)="^8994.02A^2^1"
^XWB(8994,3770,2,2,0)="ECARY^1^^1"
^XWB(8994,3770,2,2,1,0)="^8994.021^2^2^3161221^^^"
^XWB(8994,3770,2,2,1,1,0)="This will hold the mode in which you want to run the RPC.  The two"
^XWB(8994,3770,2,2,1,2,0)="possible modes are ""I""nformation or ""D""elete."
^XWB(8994,3770,2,"B","ECARY",2)=""
^XWB(8994,3770,3,0)="^^9^9^3161221^"
^XWB(8994,3770,3,1,0)="Depending on the mode, the return results will vary.  "
^XWB(8994,3770,3,2,0)=" "
^XWB(8994,3770,3,3,0)="For the ""I""nformational mode, the return value will be account type (test"
^XWB(8994,3770,3,4,0)="or production)^network name^date/time deletion last completed^user who"
^XWB(8994,3770,3,5,0)="last ran the deletion^status of the deletion (0 not running/1 running)."
^XWB(8994,3770,3,6,0)=" "
^XWB(8994,3770,3,7,0)="For the ""D""eletion mode, the return value will be 0 if the task couldn't "
^XWB(8994,3770,3,8,0)="be queued to run in the background or 1 to indicate that it was "
^XWB(8994,3770,3,9,0)="successfully tasked to the background."
^XWB(8994,3771,0)="DSIV OK EDIT^OKEDIT^DSIVUTL^1^A^^^1"
^XWB(8994,3771,1,0)="^^3^3^3170306^"
^XWB(8994,3771,1,1,0)="This RPC is a wrapper for the OK2EDIT subroutine of IBCNCH.  It allows "
^XWB(8994,3771,1,2,0)="for using IB functionality to determine if it is okay to edit a patient"
^XWB(8994,3771,1,3,0)="policy comment."
^XWB(8994,3771,2,0)="^8994.02A^4^4"
^XWB(8994,3771,2,1,0)="DFN^1^30^1^1"
^XWB(8994,3771,2,1,1,0)="^^2^2^3170306^"
^XWB(8994,3771,2,1,1,1,0)="This is the patient DFN for which you wish to edit a patient policy "
^XWB(8994,3771,2,1,1,2,0)="comment."
^XWB(8994,3771,2,2,0)="IBIIEN^1^30^1^2"
^XWB(8994,3771,2,2,1,0)="^^1^1^3170306^"
^XWB(8994,3771,2,2,1,1,0)="This is the multiple IEN of the selected patient policy."
^XWB(8994,3771,2,3,0)="COMIEN^1^30^0^3"
^XWB(8994,3771,2,3,1,0)="^8994.021^1^1^3170307^^"
^XWB(8994,3771,2,3,1,1,0)="IEN of the selected Patient Policy comment."
^XWB(8994,3771,2,4,0)="WHICH^1^6^1^4"
^XWB(8994,3771,2,4,1,0)="^^2^2^3170307^"
^XWB(8994,3771,2,4,1,1,0)="This is the type of action you want to check for.  Acceptable actions are "
^XWB(8994,3771,2,4,1,2,0)="""Delete"", ""Edit"", and ""Add""."
^XWB(8994,3771,2,"B","COMIEN",3)=""
^XWB(8994,3771,2,"B","DFN",1)=""
^XWB(8994,3771,2,"B","IBIIEN",2)=""
^XWB(8994,3771,2,"B","WHICH",4)=""
^XWB(8994,3771,2,"PARAMSEQ",1,1)=""
^XWB(8994,3771,2,"PARAMSEQ",2,2)=""
^XWB(8994,3771,2,"PARAMSEQ",3,3)=""
^XWB(8994,3771,2,"PARAMSEQ",4,4)=""
^XWB(8994,3771,3,0)="^^1^1^3170306^"
^XWB(8994,3771,3,1,0)="This is the direct results of the call to OK2EDIT^IBCNCH."
^XWB(8994,3772,0)="DG DEATH SOURCE/DOC UPDATE^BRDATA^DGDTHBR^2^P"
^XWB(8994,3772,1,0)="^8994.01^3^3^3170726^^^"
^XWB(8994,3772,1,1,0)="This RPC will receive data from the MPI for updates to selectable Source"
^XWB(8994,3772,1,2,0)="of Notifications and Supporting Documents and their associated Business"
^XWB(8994,3772,1,3,0)="Rules."
^XWB(8994,3772,2,0)="^8994.02A^1^1"
^XWB(8994,3772,2,1,0)="DGDATA^2^80^1^1"
^XWB(8994,3772,2,1,1,0)="^8994.021^4^4^3170726^^^^"
^XWB(8994,3772,2,1,1,1,0)="A list of updates in the following format: "
^XWB(8994,3772,2,1,1,2,0)=" "
^XWB(8994,3772,2,1,1,3,0)="IEN of Source of Notification^Active^Supporting Document Type "
^XWB(8994,3772,2,1,1,4,0)="(Code)^Active"
^XWB(8994,3772,2,"B","DGDATA",1)=""
^XWB(8994,3772,2,"PARAMSEQ",1,1)=""
^XWB(8994,3772,3,0)="^8994.03^2^2^3170726^^^^"
^XWB(8994,3772,3,1,0)="Return of 1^SUCCESS if update occurred at the site"
^XWB(8994,3772,3,2,0)="Or 0^Error Message if update was not successful"
^XWB(8994,3773,0)="ORWCIRN JLV LABEL^JLV^ORWCIRN^1"
^XWB(8994,3773,1,0)="^^5^5^3161019^"
^XWB(8994,3773,1,1,0)="This RPC gets the Label/Caption for the JLV/VistaWeb external"
^XWB(8994,3773,1,2,0)="remote data button. The label has historically had a value of "
^XWB(8994,3773,1,3,0)="VistaWeb.  With the addition of this RPC and a new parameter, "
^XWB(8994,3773,1,4,0)="ORWRP LEGACY VIEWER LABEL, the caption of this button can be"
^XWB(8994,3773,1,5,0)="changed to JLV (Joint Legacy Viewer) when JLV becomes available."
