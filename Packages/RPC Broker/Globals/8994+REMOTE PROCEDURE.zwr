^XWB(8994,4042,1,1,0)="ITSCH"
^XWB(8994,4042,1,2,0)=" "
^XWB(8994,4042,1,3,0)="Item search for Inventory which allows search for an item within a "
^XWB(8994,4042,1,4,0)="distribution point by various fields and allows a ""contains"" search for "
^XWB(8994,4042,1,5,0)="some of the search types"
^XWB(8994,4042,1,6,0)=" "
^XWB(8994,4042,1,7,0)="NOTE:  When this search is used to ADD items to a Primary Distribution "
^XWB(8994,4042,1,8,0)="Point (items are searched in the ITEM MASTER) or to a Secondary "
^XWB(8994,4042,1,9,0)="Distribution Point (items are searched in the Primary Distribution Point) "
^XWB(8994,4042,1,10,0)="- only items which DO NOT EXIST in the target Distribution Point will be "
^XWB(8994,4042,1,11,0)="shown."
^XWB(8994,4042,2,0)="^8994.02A^7^7"
^XWB(8994,4042,2,1,0)="TERM^1^20^0^1"
^XWB(8994,4042,2,1,1,0)="^^3^3^3131205^"
^XWB(8994,4042,2,1,1,1,0)="TERM"
^XWB(8994,4042,2,1,1,2,0)=" "
^XWB(8994,4042,2,1,1,3,0)="Search term (20 character max)"
^XWB(8994,4042,2,2,0)="SCHBY^1^2^1^2"
^XWB(8994,4042,2,2,1,0)="^^20^20^3170727^"
^XWB(8994,4042,2,2,1,1,0)="SCHBY"
^XWB(8994,4042,2,2,1,2,0)=" "
^XWB(8994,4042,2,2,1,3,0)="Type of search - allowable values are:"
^XWB(8994,4042,2,2,1,4,0)=" "
^XWB(8994,4042,2,2,1,5,0)="I:   Item IEN"
^XWB(8994,4042,2,2,1,6,0)="NM   Item or Synonym name (Contains allowed)"
^XWB(8994,4042,2,2,1,7,0)="NS   NSN # (can use first part or last 7 digits)"
^XWB(8994,4042,2,2,1,8,0)="G    Group Category code (Contains allowed)"
^XWB(8994,4042,2,2,1,9,0)="ST   Main storage location (Contains allowed)"
^XWB(8994,4042,2,2,1,10,0)="MV   Mandatory Vendor (Contains allowed)"
^XWB(8994,4042,2,2,1,11,0)="MS   Mandatory Source (Contains allowed)"
^XWB(8994,4042,2,2,1,12,0)="UI   Unit of Issue (Contains allowed)"
^XWB(8994,4042,2,2,1,13,0)="NF   NIF Number (Contains allowed)"
^XWB(8994,4042,2,2,1,14,0)="VS   Vendor Stock # (Contains allowed)"
^XWB(8994,4042,2,2,1,15,0)="FS   FSC # (Contains allowed)"
^XWB(8994,4042,2,2,1,16,0)="IN   INC (Contains allowed)"
^XWB(8994,4042,2,2,1,17,0)="AL   Search by all"
^XWB(8994,4042,2,2,1,18,0)=" "
^XWB(8994,4042,2,2,1,19,0)="If a search shows ""contains allowed"", the user can search within the data "
^XWB(8994,4042,2,2,1,20,0)="for the TERM entered - this search will be slower."
^XWB(8994,4042,2,3,0)="DPIEN^1^20^1^3"
^XWB(8994,4042,2,3,1,0)="^^15^15^3131231^"
^XWB(8994,4042,2,3,1,1,0)="DPIEN"
^XWB(8994,4042,2,3,1,2,0)=" "
^XWB(8994,4042,2,3,1,3,0)="Depending on the type of search, this shows the distribution points:"
^XWB(8994,4042,2,3,1,4,0)=" "
^XWB(8994,4042,2,3,1,5,0)="When Searching for an item that EXISTS in a Primary Distribution Point:"
^XWB(8994,4042,2,3,1,6,0)="   DPIEN = ""P:PRIMARY IEN"""
^XWB(8994,4042,2,3,1,7,0)=" "
^XWB(8994,4042,2,3,1,8,0)="When Searching for an item that EXISTS in a Secondary Distribution Point:"
^XWB(8994,4042,2,3,1,9,0)="   DPIEN = ""S:SECONDARY IEN"""
^XWB(8994,4042,2,3,1,10,0)=" "
^XWB(8994,4042,2,3,1,11,0)="When searching the ITEM MASTER file to ADD an item to a Primary DP:"
^XWB(8994,4042,2,3,1,12,0)="   DPIEN = ""IM:PRIMARY IEN"""
^XWB(8994,4042,2,3,1,13,0)=" "
^XWB(8994,4042,2,3,1,14,0)="When searching the Primary DP to ADD an item to a Secondary DP:"
^XWB(8994,4042,2,3,1,15,0)="   DPIEN = ""P:PRIMARY IEN:S:SECONDARY IEN"""
^XWB(8994,4042,2,3,1,16,0)=" "
^XWB(8994,4042,2,3,1,17,0)="When searching for an item that EXISTS in the ITEM MASTER file:"
^XWB(8994,4042,2,3,1,18,0)="   DPIEN = ""IMSCH"""
^XWB(8994,4042,2,4,0)="NOREC^1^4^0^4"
^XWB(8994,4042,2,4,1,0)="^^3^3^3131205^"
^XWB(8994,4042,2,4,1,1,0)="NOREC"
^XWB(8994,4042,2,4,1,2,0)=" "
^XWB(8994,4042,2,4,1,3,0)="Number of records to return, if nothing sent will default to 1000"
^XWB(8994,4042,2,5,0)="SCHTXT^1^1^0^5"
^XWB(8994,4042,2,5,1,0)="^^8^8^3131205^"
^XWB(8994,4042,2,5,1,1,0)="SCHTXT"
^XWB(8994,4042,2,5,1,2,0)=" "
^XWB(8994,4042,2,5,1,3,0)="If set to ""1"" look for the TERM within any strings - not just at the "
^XWB(8994,4042,2,5,1,4,0)="beginning of strings."
^XWB(8994,4042,2,5,1,5,0)=" "
^XWB(8994,4042,2,5,1,6,0)="This is not allowed for all search types."
^XWB(8994,4042,2,5,1,7,0)=" "
^XWB(8994,4042,2,5,1,8,0)="This search will be slower"
^XWB(8994,4042,2,6,0)="ACT^1^1^0^6"
^XWB(8994,4042,2,6,1,0)="^8994.021^4^4^3140307^^^"
^XWB(8994,4042,2,6,1,1,0)="ACT"
^XWB(8994,4042,2,6,1,2,0)=" "
^XWB(8994,4042,2,6,1,3,0)="Leave blank or set to 1 if only active inventory items to be returned.  "
^XWB(8994,4042,2,6,1,4,0)="Entering ""N"" for this returns all items whether active or not."
^XWB(8994,4042,2,7,0)="STRTREC^1^^0^7"
^XWB(8994,4042,2,7,1,0)="^^3^3^3170830^"
^XWB(8994,4042,2,7,1,1,0)="The IEN of the record that was returned in the prior search. The next "
^XWB(8994,4042,2,7,1,2,0)="proceding record will be the first returned that matches the search "
^XWB(8994,4042,2,7,1,3,0)="criteria."
