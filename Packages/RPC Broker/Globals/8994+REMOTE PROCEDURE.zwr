^XWB(8994,3509,3,54,0)=" 74 RET(""KSTATE"") - Primary Next of Kin State (.217) "
^XWB(8994,3509,3,55,0)=" 75 RET(""KZIP"") - Primary Next of Kin Zip (.218) "
^XWB(8994,3509,3,56,0)=" 76 RET(""NOK2"") - Secondary Next of Kin (.2191) "
^XWB(8994,3509,3,57,0)=" 77 RET(""K2NAME"") - Secondary Next of Kin name (.2191) "
^XWB(8994,3509,3,58,0)=" 78 RET(""K2REL"") - Secondary Next of Kin Relationship to Patient (.2192) "
^XWB(8994,3509,3,59,0)=" 79 RET(""K2PHONE"") - Secondary Next of Kin Phone (.2199) "
^XWB(8994,3509,3,60,0)=" 80 RET(""K2STREET"") - Secondary Next of Kin Street Address [Line 1] "
^XWB(8994,3509,3,61,0)="(.2193)"
^XWB(8994,3509,3,62,0)=" 81 RET(""K2STREET2"") - Secondary Next of Kin Street Address [Line 2] "
^XWB(8994,3509,3,63,0)="(.2194)"
^XWB(8994,3509,3,64,0)=" 82 RET(""K2STREET3"") - Secondary Next of Kin Street Address [Line 3] "
^XWB(8994,3509,3,65,0)="(.2195)"
^XWB(8994,3509,3,66,0)=" 83 RET(""K2CITY"") - Secondary Next of Kin City (.2196) "
^XWB(8994,3509,3,67,0)=" 84 RET(""K2STATE"") - Secondary Next of Kin State (.2197) "
^XWB(8994,3509,3,68,0)=" 85 RET(""K2ZIP"") - Secondary Next of Kin Zip (.2198) "
^XWB(8994,3509,3,69,0)=" 86 RET(""PCOUNTY"") - Patient County (.117) "
^XWB(8994,3509,3,70,0)=" 87 RET(""PETH"") - List of Patient Ethnicities/Names Eth|Name^...  "
^XWB(8994,3509,3,71,0)="                  Use ETH^SDECU2 "
^XWB(8994,3509,3,72,0)=" 88 RET(""PRACE"") - List of Patient Races/Names RACE|NAME^... "
^XWB(8994,3509,3,73,0)="                   Use RACELST^SDECU2 "
^XWB(8994,3509,3,74,0)=" 89 RET(""PMARITAL"") - Patient Marital Status "
^XWB(8994,3509,3,75,0)=" 90 RET(""PRELIGION"") - Patient Religious Preference "
^XWB(8994,3509,3,76,0)=" 91 RET(""PTACTIVE"") - Patient Temporary Address Active? (.12105) "
^XWB(8994,3509,3,77,0)=" 92 RET(""PTADDRESS1"") - Patient Temporary Address Line 1 (.1211) "
^XWB(8994,3509,3,78,0)=" 93 RET(""PTADDRESS2"") - Patient Temporary Address Line 2 (.1212) "
^XWB(8994,3509,3,79,0)=" 94 RET(""PTADDRESS3"") - Patient Temporary Address Line 3 (.1213) "
^XWB(8994,3509,3,80,0)=" 95 RET(""PTCITY"") - Patient Temporary City (.1214) "
^XWB(8994,3509,3,81,0)=" 96 RET(""PTSTATE"") - Patient Temporary State (.1215) "
^XWB(8994,3509,3,82,0)=" 97 RET(""PTZIP"") - Patient Temporary Zip (.1216) "
