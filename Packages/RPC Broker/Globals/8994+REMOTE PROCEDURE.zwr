^XWB(8994,3556,3,0)="^^1^1^3150127^"
^XWB(8994,3556,3,1,0)="IEN of added/edited entry or 0 if error"
^XWB(8994,3557,0)="SDEC ADDRES^ADDRES^SDEC^4^R^0^^0"
^XWB(8994,3557,1,0)="^8994.01^1^1^3150127^^"
^XWB(8994,3557,1,1,0)="ADD/EDIT RESOURCE"
^XWB(8994,3557,2,0)="^8994.02A^1^1"
^XWB(8994,3557,2,1,0)="SDECVAL^1^^1^1"
^XWB(8994,3557,2,1,1,0)="^^43^43^3150127^"
^XWB(8994,3557,2,1,1,1,0)="SDECVAL - ResourceID|ResourceName|<NOT USED>|HospLocID|TIME_SCALE"
^XWB(8994,3557,2,1,1,2,0)="            |LETTER_TEXT|NO_SHOW_LETTER|CANCELLATION_LETTER"
^XWB(8994,3557,2,1,1,3,0)="            | INACTIVATEDDT | INACTIVATEDUSR | REACTIVATEDDT"
^XWB(8994,3557,2,1,1,4,0)="            | REACTIVATEDUSR | RESOURCETYPE | RESOURCETYPEIEN"
^XWB(8994,3557,2,1,1,5,0)="  1. ResourceID - (optional) Pointer to the SDEC RESOURCE file"
^XWB(8994,3557,2,1,1,6,0)="                         a new entry is added if IEN is 0"
^XWB(8994,3557,2,1,1,7,0)="  2. ResourceName - (required) Value put into the RESOURCE field"
^XWB(8994,3557,2,1,1,8,0)="                               of the SDEC RESOURCE file"
^XWB(8994,3557,2,1,1,9,0)="  3. NOT USED  INACTIVE This is 'computed' based on inactivation"
^XWB(8994,3557,2,1,1,10,0)="                        and reactivation fields"
^XWB(8994,3557,2,1,1,11,0)="  4. HospLocID - (required) Hospital Location ID - pointer to the"
^XWB(8994,3557,2,1,1,12,0)="                        HOSPITAL LOCATION file 44"
^XWB(8994,3557,2,1,1,13,0)="  5. TIME_SCALE - (optional) Value put into the TIME SCALE field"
^XWB(8994,3557,2,1,1,14,0)="                             of the SDEC RESOURCE file"
^XWB(8994,3557,2,1,1,15,0)="                         Allowed values: 5 10 15 20 30 60"
^XWB(8994,3557,2,1,1,16,0)="  6. LETTER_TEXT - (optional) Value converted to Word Processor and"
^XWB(8994,3557,2,1,1,17,0)="                            put into the LETTER TEXT field of the"
^XWB(8994,3557,2,1,1,18,0)="                            SDEC RESOURCE file"
^XWB(8994,3557,2,1,1,19,0)="  7. NO_SHOW_LETTER - (optional) Value converted to Word Processor"
^XWB(8994,3557,2,1,1,20,0)="                            and put into the NO SHOW LETTER field of"
^XWB(8994,3557,2,1,1,21,0)="                            the SDEC RESOURCE file"
^XWB(8994,3557,2,1,1,22,0)="  8. CANCELLATION_LETTER - (optional) Value converted to"
^XWB(8994,3557,2,1,1,23,0)="                            Word Processor and put into the CLINIC"
^XWB(8994,3557,2,1,1,24,0)="                                    CANCELLATION LETTER field"
^XWB(8994,3557,2,1,1,25,0)="                                    of the SDEC RESOURCE file"
^XWB(8994,3557,2,1,1,26,0)="  9. DATE/TIME     - (optional) DATE/TIME entered in external format"
^XWB(8994,3557,2,1,1,27,0)="                                Defaults to NOW."
^XWB(8994,3557,2,1,1,28,0)=" 10. ENTEREDBY     - (optional) Entered by User pointer to NEW PERSON"
^XWB(8994,3557,2,1,1,29,0)="                                Defaults to current user"
^XWB(8994,3557,2,1,1,30,0)=" 11. INACTIVATEDDT - (optional) inactivated Date/Time external format"
^XWB(8994,3557,2,1,1,31,0)=" 12. INACTIVATEDUSR- (optional) inactivating user pointer to"
^XWB(8994,3557,2,1,1,32,0)="                                NEW PERSON file"
^XWB(8994,3557,2,1,1,33,0)=" 13. REACTIVATEDDT - (optional) reactivated Date/Time external format"
^XWB(8994,3557,2,1,1,34,0)=" 14. REACTIVATEDUSR- (optional) reactivating user pointer to"
^XWB(8994,3557,2,1,1,35,0)="                                NEW PERSON file"
^XWB(8994,3557,2,1,1,36,0)=" 15. RESOURCETYPE - (required) valid values are:"
^XWB(8994,3557,2,1,1,37,0)="                                H for HOSPITAL LOCATION (or clinic)"
^XWB(8994,3557,2,1,1,38,0)="                                P for NEW PERSON (Provider)"
^XWB(8994,3557,2,1,1,39,0)="                                A for ADDITIONAL RESOURCE"
^XWB(8994,3557,2,1,1,40,0)=" 16. RESOURCETYPEIEN - (required) pointer to 1 of the following:"
^XWB(8994,3557,2,1,1,41,0)="                                HOSPITAL LOCATION file"
^XWB(8994,3557,2,1,1,42,0)="                                NEW PERSON file"
^XWB(8994,3557,2,1,1,43,0)="                                ADDITIONAL RESOURCE file"
