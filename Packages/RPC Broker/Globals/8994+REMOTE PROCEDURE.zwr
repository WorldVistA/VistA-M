^XWB(8994,3777,2,"PARAMSEQ",4,5)=""
^XWB(8994,3777,3,0)="^8994.03^11^11^3140206^^^^"
^XWB(8994,3777,3,1,0)="For a successful execution of the call the output sent to the client will"
^XWB(8994,3777,3,2,0)="be placed in the variable RETSTA(0) using the following format:"
^XWB(8994,3777,3,3,0)=" "
^XWB(8994,3777,3,4,0)="RETSTA(0)=""1^Update of EQUIPMENT INV. file, #6914, successful"""
^XWB(8994,3777,3,5,0)=" "
^XWB(8994,3777,3,6,0)="If an error occurs during call execution, a message will be "
^XWB(8994,3777,3,7,0)="returned to the client using the following format in RETSTA(0):"
^XWB(8994,3777,3,8,0)=" "
^XWB(8994,3777,3,9,0)="RETSTA(0)=""-###^reason_for_failure"" will be returned, where '###' is a"
^XWB(8994,3777,3,10,0)="3-digit http status code. The piece 'reason_for_failure' explains what"
^XWB(8994,3777,3,11,0)="caused the error in VistA."
^XWB(8994,3778,0)="VIAA ENG GET LOCATION^GETLOC^VIAAEUT^4^R^^^1^^^1"
^XWB(8994,3778,1,0)="^8994.01^2^2^3140206^^^^"
^XWB(8994,3778,1,1,0)="This RCP requires two input parameters and returns 8 fields from the"
^XWB(8994,3778,1,2,0)="Engineering SPACE file, #6928."
^XWB(8994,3778,2,0)="^8994.02A^2^1"
^XWB(8994,3778,2,1,0)="RETSTA^2^32000^1^"
^XWB(8994,3778,2,1,1,0)="^8994.021^1^1^3130104^^^^"
^XWB(8994,3778,2,1,1,1,0)="This the return array for the calling application."
^XWB(8994,3778,2,2,0)="REQDATA^1^255^1^1"
^XWB(8994,3778,2,2,1,0)="^8994.021^2^2^3131023^^^^"
^XWB(8994,3778,2,2,1,1,0)="The key word ""LOCATION"" to indicate the return of all locations in the"
^XWB(8994,3778,2,2,1,2,0)="SPACE file, #6928."
^XWB(8994,3778,2,"B","REQDATA",2)=""
^XWB(8994,3778,2,"B","RETSTA",1)=""
^XWB(8994,3778,2,"PARAMSEQ",1,1)=""
^XWB(8994,3778,2,"PARAMSEQ",1,2)=""
^XWB(8994,3778,2,"PARAMSEQ",2,2)=""
^XWB(8994,3778,3,0)="^8994.03^14^14^3140206^^"
^XWB(8994,3778,3,1,0)="For a successful call execution, the output for the client will be placed"
^XWB(8994,3778,3,2,0)="in ^TMP(""VIAALOCATION"",$J,count,0) and returned via the variable"
^XWB(8994,3778,3,3,0)="RETSTA; it will consist of the following fields from file #6928 using '^'"
^XWB(8994,3778,3,4,0)="as a delimiter:"
^XWB(8994,3778,3,5,0)=" "
^XWB(8994,3778,3,6,0)="IEN, ROOM NUMBER, BUILDING NUMBER, BUILDING FILE POINTER, DIVISION, WING,"
^XWB(8994,3778,3,7,0)="SERVICE, and INVERSE LOCATION. "
^XWB(8994,3778,3,8,0)=" "
^XWB(8994,3778,3,9,0)="If an error occurs during call execution, a message will be returned to"
^XWB(8994,3778,3,10,0)="the client using the following format in ^TMP:"
^XWB(8994,3778,3,11,0)=" "
^XWB(8994,3778,3,12,0)="^TMP(""VIAALOCATION"",$J,0)=""-###^reason_for_failure"", where '###' is a"
^XWB(8994,3778,3,13,0)="3-digit http status code. The piece 'reason_for_failure' explains what"
^XWB(8994,3778,3,14,0)="caused the error in VistA."
^XWB(8994,3779,0)="VIAA ENG GET CATEGORY^GETCAT^VIAAEUT^4^R^^^1^^^1"
^XWB(8994,3779,1,0)="^8994.01^2^2^3140206^^^^"
^XWB(8994,3779,1,1,0)="This RPC requires three input parameters and returns all the entries"
^XWB(8994,3779,1,2,0)="in the Engineering file Equipment Category, #6911."
^XWB(8994,3779,2,0)="^8994.02A^3^2"
^XWB(8994,3779,2,1,0)="RETSTA^2^32000^1^"
^XWB(8994,3779,2,1,1,0)="^8994.021^1^1^3130104^^^^"
^XWB(8994,3779,2,1,1,1,0)="This is the array for the return data from the call."
^XWB(8994,3779,2,2,0)="REQDATA^1^255^1^1"
^XWB(8994,3779,2,2,1,0)="^8994.021^2^2^3130104^^^^"
^XWB(8994,3779,2,2,1,1,0)="This is the keyword ""CATEGORY"" to indicate the return of all the entries"
^XWB(8994,3779,2,2,1,2,0)="in the Equipment Category file, #6911."
^XWB(8994,3779,2,3,0)="DATAID^1^255^1^2"
^XWB(8994,3779,2,3,1,0)="^8994.021^1^1^3131023^^^^"
^XWB(8994,3779,2,3,1,1,0)="Defines the scope of the data requested: 'ALL' for all the data on file."
^XWB(8994,3779,2,"B","DATAID",3)=""
^XWB(8994,3779,2,"B","REQDATA",2)=""
^XWB(8994,3779,2,"B","RETSTA",1)=""
^XWB(8994,3779,2,"PARAMSEQ",1,1)=""
^XWB(8994,3779,2,"PARAMSEQ",1,2)=""
^XWB(8994,3779,2,"PARAMSEQ",2,2)=""
^XWB(8994,3779,2,"PARAMSEQ",2,3)=""
^XWB(8994,3779,2,"PARAMSEQ",3,3)=""
^XWB(8994,3779,3,0)="^8994.03^14^14^3140206^^^"
^XWB(8994,3779,3,1,0)="For a successful call execution, the output for the client will be placed"
^XWB(8994,3779,3,2,0)="in ^TMP(""VIAACATEGORY"",$J,count,0) and returned via the variable RETSTA; "
^XWB(8994,3779,3,3,0)="it will consist of the following fields from file #6911 using '^' as a"
^XWB(8994,3779,3,4,0)="delimiter:"
^XWB(8994,3779,3,5,0)=" "
^XWB(8994,3779,3,6,0)="^TMP(""VIAACATEGORY"",$J,count,0)=categoryIEN^categoryDescription"
^XWB(8994,3779,3,7,0)=". . ."
^XWB(8994,3779,3,8,0)=" "
^XWB(8994,3779,3,9,0)="If an error occurs during call execution, a message will be returned to"
^XWB(8994,3779,3,10,0)="the client using the following format in ^TMP:"
^XWB(8994,3779,3,11,0)=" "
^XWB(8994,3779,3,12,0)="^TMP(""VIAACATEGORY"",$J,0)=""-###^reason_for_failure"", where '###'"
^XWB(8994,3779,3,13,0)="is a 3-digit http status code. The piece 'reason_for_failure' explains"
^XWB(8994,3779,3,14,0)="what caused the error in VistA."
^XWB(8994,3780,0)="VIAA ENG GET EQUIPMENT^LASTEE^VIAAEUT^4^R^^^1^^^1"
^XWB(8994,3780,1,0)="^8994.01^2^2^3140523^^^^"
^XWB(8994,3780,1,1,0)="This RPC requires two input parameters and returns all the new entries"
^XWB(8994,3780,1,2,0)="(IENs) from the Engineering file #6914 following a given entry number."
^XWB(8994,3780,2,0)="^8994.02A^2^1"
^XWB(8994,3780,2,1,0)="RETSTA^2^32000^1^"
^XWB(8994,3780,2,1,1,0)="^8994.021^1^1^3130104^^^^"
^XWB(8994,3780,2,1,1,1,0)="This is the return array for the call."
^XWB(8994,3780,2,2,0)="REQDATA^1^255^1^1"
^XWB(8994,3780,2,2,1,0)="^8994.021^3^3^3140523^^^^"
^XWB(8994,3780,2,2,1,1,0)="This is the last IEN that was stored in Weblogic and InSites."
^XWB(8994,3780,2,2,1,2,0)="Once the RPC gets it, it can check if new entries have been added"
^XWB(8994,3780,2,2,1,3,0)="and report them in a list."
^XWB(8994,3780,2,"B","REQDATA",2)=""
^XWB(8994,3780,2,"B","RETSTA",1)=""
^XWB(8994,3780,2,"PARAMSEQ",1,1)=""
^XWB(8994,3780,2,"PARAMSEQ",1,2)=""
^XWB(8994,3780,2,"PARAMSEQ",2,2)=""
^XWB(8994,3780,3,0)="^8994.03^17^17^3140523^^"
^XWB(8994,3780,3,1,0)="For a successful call execution, the output for the client will be placed"
^XWB(8994,3780,3,2,0)="in ^TMP(""VIAALASTEE"",$J,count,0) and returned via the variable RETSTA; it"
^XWB(8994,3780,3,3,0)="will consist of the following fields from file #6914:"
^XWB(8994,3780,3,4,0)=" "
^XWB(8994,3780,3,5,0)="^TMP(""VIAALASTEE"",$J,count,0)=IEN"
^XWB(8994,3780,3,6,0)="^TMP(""VIAALASTEE"",$J,count+1,0)=next_IEN"
^XWB(8994,3780,3,7,0)=". . ."
^XWB(8994,3780,3,8,0)=" "
^XWB(8994,3780,3,9,0)="The output will consist of a list of EE numbers found in file #6914 which"
^XWB(8994,3780,3,10,0)="follow the EE number sent from Insites."
^XWB(8994,3780,3,11,0)=" "
^XWB(8994,3780,3,12,0)="If an error occurs during call execution, a message will be returned to "
^XWB(8994,3780,3,13,0)="the client using the following format in ^TMP:"
^XWB(8994,3780,3,14,0)=" "
^XWB(8994,3780,3,15,0)="^TMP(""VIAALASTEE"",$J,0)=""-###^reason_for_failure"", where '###' is a"
^XWB(8994,3780,3,16,0)="3-digit http status code. The piece 'reason_for_failure' explains what"
^XWB(8994,3780,3,17,0)="caused the error in VistA."
^XWB(8994,3781,0)="VIAA ENG GET DATA^RTLSDTEX^VIAAEAD^4^R^^^1^^^1"
^XWB(8994,3781,1,0)="^8994.01^2^2^3140206^^^^"
^XWB(8994,3781,1,1,0)="This RPC returns to RTLS equipment data for a given entry number in file "
^XWB(8994,3781,1,2,0)="#6914."
^XWB(8994,3781,2,0)="^8994.02A^3^2"
^XWB(8994,3781,2,1,0)="RETSTA^2^32000^1"
^XWB(8994,3781,2,2,0)="REQDATA^1^255^1^1"
^XWB(8994,3781,2,2,1,0)="^8994.021^4^4^3130422^^"
^XWB(8994,3781,2,2,1,1,0)="Type of data required"
^XWB(8994,3781,2,2,1,2,0)="""EQUIPMENT"" for equipment"
^XWB(8994,3781,2,2,1,3,0)="""CATEGORY"" for categories"
^XWB(8994,3781,2,2,1,4,0)="""LOCATION"" for locations"
^XWB(8994,3781,2,3,0)="DATAID^1^255^1^2"
^XWB(8994,3781,2,3,1,0)="^8994.021^2^2^3131023^^^"
^XWB(8994,3781,2,3,1,1,0)="""ALL"" to get all data available,"
^XWB(8994,3781,2,3,1,2,0)="ID to get data for a single item (equipment, category, location)"
^XWB(8994,3781,2,"B","DATAID",3)=""
^XWB(8994,3781,2,"B","REQDATA",2)=""
^XWB(8994,3781,2,"B","RETSTA",1)=""
^XWB(8994,3781,2,"PARAMSEQ",1,2)=""
^XWB(8994,3781,2,"PARAMSEQ",2,3)=""
^XWB(8994,3781,3,0)="^8994.03^35^35^3140206^^"
^XWB(8994,3781,3,1,0)="For a successful call execution, the output for the client will be placed "
^XWB(8994,3781,3,2,0)="in ^TMP(""VIAAEQUIPMENT"",$J,count,0) and returned via the variable "
^XWB(8994,3781,3,3,0)="RETSTA; it will consist of the following fields from file #6914 using '^'"
^XWB(8994,3781,3,4,0)="as a delimiter:"
^XWB(8994,3781,3,5,0)=" "
^XWB(8994,3781,3,6,0)="ENTRY NUMBER"
^XWB(8994,3781,3,7,0)="LOCATION"
^XWB(8994,3781,3,8,0)="MODEL"
^XWB(8994,3781,3,9,0)="MANUFACTURER"
^XWB(8994,3781,3,10,0)="EQUIPMENT CATEGORY "
^XWB(8994,3781,3,11,0)="SYNONYM"
^XWB(8994,3781,3,12,0)="USE STATUS"
^XWB(8994,3781,3,13,0)="SERIAL #"
^XWB(8994,3781,3,14,0)="TOTAL ASSET VALUE"
^XWB(8994,3781,3,15,0)="DATE ENTERED"
^XWB(8994,3781,3,16,0)="PHYSICAL INVENTORY DATE"
^XWB(8994,3781,3,17,0)="MFGR. EQUIPMENT NAME"
^XWB(8994,3781,3,18,0)="CMR"
^XWB(8994,3781,3,19,0)="SERVICE POINTER"
^XWB(8994,3781,3,20,0)="CATEGORY STOCK NUMBER"
^XWB(8994,3781,3,21,0)="BRIEF DESCRIPTION"
^XWB(8994,3781,3,22,0)="PARENT SYSTEM"
^XWB(8994,3781,3,23,0)="TYPE OF ENTRY"
^XWB(8994,3781,3,24,0)="PURCHASE ORDER #"
^XWB(8994,3781,3,25,0)="ACQUISITION DATE"
^XWB(8994,3781,3,26,0)="RESPONSIBLE SHOP"
^XWB(8994,3781,3,27,0)="STATION NUMBER"
^XWB(8994,3781,3,28,0)="DISPOSITION DATE"
^XWB(8994,3781,3,29,0)=" "
^XWB(8994,3781,3,30,0)="If an error occurs during call execution, a message will be returned to "
^XWB(8994,3781,3,31,0)="the client using the following format in ^TMP:"
^XWB(8994,3781,3,32,0)=" "
^XWB(8994,3781,3,33,0)="^TMP(""VIAAEQUIPMENT"",$J,0)=""-###^reason_for_failure"", where '###' is a"
^XWB(8994,3781,3,34,0)="3-digit http status code. The piece 'reason_for_failure' explains what"
^XWB(8994,3781,3,35,0)="caused the error in VistA."
^XWB(8994,3782,0)="VIAA ENG GET PRIMARY STATION^PINGRP^VIAAMB1^1^R^^^1^^^1"
^XWB(8994,3782,1,0)="^^3^3^3140314^"
^XWB(8994,3782,1,1,0)="This RPC is used to verify that VistA is up and the KIDS build for the"
^XWB(8994,3782,1,2,0)="VIAA package has been installed by the site. No input parameter is "
^XWB(8994,3782,1,3,0)="required by this RPC."
^XWB(8994,3782,3,0)="^8994.03^3^3^3140314^^"
^XWB(8994,3782,3,1,0)="The successful execution of the RPC returns the primary station number to"
^XWB(8994,3782,3,2,0)="the calling application via the variable RETSTA. The primary station"
^XWB(8994,3782,3,3,0)="number comes from the Engineering Init Parameters file, #6910."
^XWB(8994,3783,0)="PSOERXA0 DRGMTCH^DRGMTCH^PSOERXA0^1^^^^1^^^1"
^XWB(8994,3783,1,0)="^^14^14^3160818^"
^XWB(8994,3783,1,1,0)="This RPC is used to match incoming eRx drugs/supply items to the VistA "
^XWB(8994,3783,1,2,0)="equivalent drug/supply items."
^XWB(8994,3783,1,3,0)=" "
^XWB(8994,3783,1,4,0)="Input:"
^XWB(8994,3783,1,5,0)=" "
^XWB(8994,3783,1,6,0)="  Both parameters are 'optional', but to receive any legitimate "
^XWB(8994,3783,1,7,0)="  results, at least one of the two must be passed in."
^XWB(8994,3783,1,8,0)=" "
^XWB(8994,3783,1,9,0)="  NDCUPN - NDC or UPN value to be match to the NDC/UPN file (#50.67)."
^XWB(8994,3783,1,10,0)="           If NDC, pass ""N^ndc value"""
^XWB(8994,3783,1,11,0)="           If UPN, pass ""U^upn value"""
^XWB(8994,3783,1,12,0)=" "
^XWB(8994,3783,1,13,0)="  DGDESC - Textual drug description. Pass in the drug description or "
^XWB(8994,3783,1,14,0)="           'drug name'. (ex. ACETAMINOPHEN 400 MG TABLET)."
