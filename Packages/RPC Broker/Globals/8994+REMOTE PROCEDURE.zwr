^XWB(8994,3954,2,2,1,0)="^^1^1^3130205^"
^XWB(8994,3954,2,2,1,1,0)="The name of the parameter to save data for."
^XWB(8994,3954,2,3,0)="USER^1^30^0^3"
^XWB(8994,3954,2,3,1,0)="^^2^2^3130205^"
^XWB(8994,3954,2,3,1,1,0)="If ENTITY=""USR"", this parameter can be used to specify which user's "
^XWB(8994,3954,2,3,1,2,0)="parameter data should be updated (default is current user)."
^XWB(8994,3954,2,4,0)="VALUES^2^245^1^4"
^XWB(8994,3954,2,4,1,0)="^^6^6^3130205^"
^XWB(8994,3954,2,4,1,1,0)="List of instances and values to save in the parameter, in format:"
