^XWB(8994,3272,2,1,1,0)="^^1^1^3130618^"
^XWB(8994,3272,2,1,1,1,0)="2507 Exam IEN"
^XWB(8994,3272,2,2,0)="DAS^1^250^1^2"
^XWB(8994,3272,2,2,1,0)="^^1^1^3130618^"
^XWB(8994,3272,2,2,1,1,0)="DAS is the XML DAS Conformation message"
