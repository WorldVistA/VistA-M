^XWB(8994,885,2,1,1,1,0)="Internal entry number of entry in the Patient file."
^XWB(8994,885,2,2,0)="REPORT ID^1^20^1"
^XWB(8994,885,2,2,1,0)="^^1^1^2961016^"
^XWB(8994,885,2,2,1,1,0)="Identification number of the desired report."
^XWB(8994,885,2,3,0)="HEALTH SUMMARY TYPE^1^20^0"
^XWB(8994,885,2,3,1,0)="^^4^4^2961016^"
^XWB(8994,885,2,3,1,1,0)="Internal entry number of entry in the HEALTH SUMMARY TYPE file."
^XWB(8994,885,2,3,1,2,0)=""
^XWB(8994,885,2,3,1,3,0)="This parameter is only required for Health Summary reports."
^XWB(8994,885,2,3,1,4,0)=""
^XWB(8994,885,2,4,0)="DATE RANGE^1^5^0"
^XWB(8994,885,2,4,1,0)="^^4^4^2961016^"
^XWB(8994,885,2,4,1,1,0)="This parameter indicates the number of days from TODAY"
^XWB(8994,885,2,4,1,2,0)="that the report should search for information."
^XWB(8994,885,2,4,1,3,0)=""
^XWB(8994,885,2,4,1,4,0)="This parameter is required for vital reports."
^XWB(8994,885,2,5,0)="REPORT SECTION^1^2^1"
^XWB(8994,885,2,5,1,0)="^8994.021^7^7^3010621^^^^"
^XWB(8994,885,2,5,1,1,0)="This parameter specifics which portion of the report should be"
^XWB(8994,885,2,5,1,2,0)="retrieved."
^XWB(8994,885,2,5,1,3,0)=""
^XWB(8994,885,2,5,1,4,0)="If REPORT SECTION equals 0 then the entire report is re-compiled and the"
^XWB(8994,885,2,5,1,5,0)="first section is passed back. If the report is large then it is"
^XWB(8994,885,2,5,1,6,0)="necessary to divide it into sections. Currently, each section can"
^XWB(8994,885,2,5,1,7,0)="not be more than be more than 20,000 characters"
^XWB(8994,885,2,"B","DATE RANGE",4)=""
^XWB(8994,885,2,"B","DFN",1)=""
^XWB(8994,885,2,"B","HEALTH SUMMARY TYPE",3)=""
^XWB(8994,885,2,"B","REPORT ID",2)=""
^XWB(8994,885,2,"B","REPORT SECTION",5)=""
^XWB(8994,885,3,0)="^8994.03^4^4^3010621^^^^"
^XWB(8994,885,3,1,0)="Text array for report section is returned."
^XWB(8994,885,3,2,0)=""
^XWB(8994,885,3,3,0)="Also, the first line of the text contains the following information:"
^XWB(8994,885,3,4,0)="     <number of current section being passed> ^ <last section number>"
^XWB(8994,886,0)="DVBAB 2507 PENDING REPORT^STRT^DVBAB6^4^S^^^0"
^XWB(8994,886,1,0)="^^1^1^3010621^"
^XWB(8994,886,1,1,0)="Generates a report based on the status of 2507 requests."
^XWB(8994,886,2,0)="^8994.02A^6^6"
^XWB(8994,886,2,1,0)="DVBCSORT^1^1^1"
^XWB(8994,886,2,1,1,0)="^^2^2^3000506^"
^XWB(8994,886,2,1,1,1,0)="This is  the status.  Valid choices are: A (age), S (status), V (veteran"
^XWB(8994,886,2,1,1,2,0)="name), or R (routing location)."
^XWB(8994,886,2,2,0)="RSTAT^1^1^1"
^XWB(8994,886,2,2,1,0)="^^2^2^3000506^"
^XWB(8994,886,2,2,1,1,0)="This is the Request Status.  Valid choices are: A (all), P (pending), N"
^XWB(8994,886,2,2,1,2,0)="(new), or T (transcribed).  If DVBCSORT=A,S, or V - RSTAT cannot be null."
^XWB(8994,886,2,3,0)="ERDAYS^1^3^1"
^XWB(8994,886,2,3,1,0)="^^3^3^3000506^"
^XWB(8994,886,2,3,1,1,0)="If DVBCSORT = A (age) this must be the earliest age to start with (ie. 30"
^XWB(8994,886,2,3,1,2,0)="days old).  This goes with the next variable OLDAYS which is the oldest"
^XWB(8994,886,2,3,1,3,0)="age (ie. 1 day old and cannot be 0).  ERDAYS must be < OLDAYS"
^XWB(8994,886,2,4,0)="OLDAYS^1^3^1"
^XWB(8994,886,2,4,1,0)="^^2^2^3000506^"
^XWB(8994,886,2,4,1,1,0)="This is the Oldest age (ie 1 day) if DVBCSORT=A (age).  This goes with"
^XWB(8994,886,2,4,1,2,0)="ERDAYS (earliest age - ie 30 days).  ERDAYS must be < OLDAYS"
^XWB(8994,886,2,5,0)="ADIVNUM^1^3^1"
^XWB(8994,886,2,5,1,0)="^^2^2^3000506^"
^XWB(8994,886,2,5,1,1,0)="This is the regional office number - this is required only if DVBCSORT=R,"
^XWB(8994,886,2,5,1,2,0)="otherwise send as null."
^XWB(8994,886,2,6,0)="ELTYP^1^1^1"
^XWB(8994,886,2,6,1,0)="^8994.021^2^2^3010621^^^^"
^XWB(8994,886,2,6,1,1,0)="This is the elapsed time.  Values are C (calendar days - default) or W"
^XWB(8994,886,2,6,1,2,0)="(workdays).  If DVBCSORT=A,S, or V - this must not be null."
^XWB(8994,886,2,"B","ADIVNUM",5)=""
^XWB(8994,886,2,"B","DVBCSORT",1)=""
^XWB(8994,886,2,"B","ELTYP",6)=""
^XWB(8994,886,2,"B","ERDAYS",3)=""
^XWB(8994,886,2,"B","OLDAYS",4)=""
^XWB(8994,886,2,"B","RSTAT",2)=""
^XWB(8994,886,3,0)="^8994.03^1^1^3010621^^^"
^XWB(8994,886,3,1,0)="MSG is returned."
^XWB(8994,887,0)="DVBAB INST LIST^INSTLIST^DVBAB1^4^S"
^XWB(8994,887,1,0)="^^1^1^3010621^"
^XWB(8994,887,1,1,0)="Returns a list of Institutions."
^XWB(8994,888,0)="DVBAB DATETIME^DTTM^DVBAB1^1^S"
^XWB(8994,888,1,0)="^^1^1^3010621^"
^XWB(8994,888,1,1,0)="Returns the current date/time from VistA"
^XWB(8994,889,0)="DVBAB AMIS REPORT^STRT^DVBAB3^2^R^0^^0"
^XWB(8994,889,1,0)="^8994.01^1^1^3121217^^^^"
^XWB(8994,889,1,1,0)="Returns an AMIS report for specified search criteria."
^XWB(8994,889,2,0)="^8994.02A^6^6"
^XWB(8994,889,2,1,0)="BDATE^1^^1^1"
^XWB(8994,889,2,1,1,0)="^^2^2^3101019^"
^XWB(8994,889,2,1,1,1,0)="Beginning date in a date range to use for retrieving results for the "
^XWB(8994,889,2,1,1,2,0)="report."
^XWB(8994,889,2,2,0)="EDATE^1^^1^2"
^XWB(8994,889,2,2,1,0)="^^1^1^3101019^"
^XWB(8994,889,2,2,1,1,0)="Ending date in a date range to use for retrieving results for the report."
^XWB(8994,889,2,3,0)="RONUM^1^^0^3"
^XWB(8994,889,2,3,1,0)="^^12^12^3101019^"
^XWB(8994,889,2,3,1,1,0)="This is an optional parameter that has 2 optional pieces: "
^XWB(8994,889,2,3,1,2,0)="     REGIONAL OFFICE^DIVISION"
^XWB(8994,889,2,3,1,3,0)="If this parameter is defined, then the report logic will filter the "
^XWB(8994,889,2,3,1,4,0)="results by the Regional Office number passed and/or Division."
^XWB(8994,889,2,3,1,5,0)=" "
^XWB(8994,889,2,3,1,6,0)="Regional Office should always be included in the 1st '^' delimited piece "
^XWB(8994,889,2,3,1,7,0)="and the Division should always be included in the 2nd '^' delimited piece "
^XWB(8994,889,2,3,1,8,0)="if values are to be passed."
^XWB(8994,889,2,3,1,9,0)=" "
^XWB(8994,889,2,3,1,10,0)="If the 1st '^' delimited piece is undefined, null or 0 then results for "
^XWB(8994,889,2,3,1,11,0)="all Regional Offices (RO) will be returned. If Division is undefined, "
^XWB(8994,889,2,3,1,12,0)="null or 0, then results for all Divisions will be returned."
^XWB(8994,889,2,4,0)="SBULL^1^^1^4"
^XWB(8994,889,2,4,1,0)="^^2^2^3101019^"
^XWB(8994,889,2,4,1,1,0)="A Y/N value which indicates whether a bulletin should be generated when "
^XWB(8994,889,2,4,1,2,0)="the processing has completed."
^XWB(8994,889,2,5,0)="DUZ^1^^1^5"
^XWB(8994,889,2,5,1,0)="^^2^2^3101019^"
^XWB(8994,889,2,5,1,1,0)="Identifies the individual in the NEW PERSON File (#200) who should "
^XWB(8994,889,2,5,1,2,0)="recieve the bulletin generated."
^XWB(8994,889,2,6,0)="DVBAPRTY^1^4^1^6"
^XWB(8994,889,2,6,1,0)="^^5^5^3121217^"
^XWB(8994,889,2,6,1,1,0)="Priority of Exam code which inidicates which priorities to filter on."
^XWB(8994,889,2,6,1,2,0)="   AO   : Agent Orange"
^XWB(8994,889,2,6,1,3,0)="   BDD  : Benefits Delivery at Discharge and Quick Start"
^XWB(8994,889,2,6,1,4,0)="   IDES : Integrated Disability Evaluation System"
^XWB(8994,889,2,6,1,5,0)="   ALL  : All Others (Original Report with all codes except those above)"
