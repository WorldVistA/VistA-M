^XWB(8994,3409,0)="SCMC FTEE READALL^READALL^SCMCFTEE^2^R^^^^1^^1"
^XWB(8994,3409,1,0)="^^2^2^3150108^"
^XWB(8994,3409,1,1,0)="This RPC will read all FTEE history records from the Position Assignment"
^XWB(8994,3409,1,2,0)="History File (404.52)."
^XWB(8994,3409,2,0)="^8994.02A^1^1"
^XWB(8994,3409,2,1,0)="SCPHIEN^1^20^1^1"
^XWB(8994,3409,2,1,1,0)="^^1^1^3150108^"
^XWB(8994,3409,2,1,1,1,0)="Position Assignment History Record IEN"
^XWB(8994,3409,2,"B","SCPHIEN",1)=""
