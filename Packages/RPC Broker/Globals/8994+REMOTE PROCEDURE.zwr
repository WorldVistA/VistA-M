^XWB(8994,4644,2,1,1,24,0)=" ;(APPTARRAY(24)=           XRAY DATE/TIME - ISO FORMAT"
^XWB(8994,4644,2,1,1,25,0)=" ;(APPTARRAY(25)=           EKG DATE/TIME - ISO FORMAT"
^XWB(8994,4644,2,1,1,26,0)=" ;(APPTARRAY(26)=           PURPOSE (REQUIRED)- '1' FOR C&P; '2' FOR "
^XWB(8994,4644,2,1,1,27,0)="10-10; '3' FOR SCHEDULED VISIT; '4' FOR UNSCHED. VISIT; "
^XWB(8994,4644,2,1,1,28,0)=" ;(APPTARRAY(27)=           COLLATERAL - 1 FOR YES"
^XWB(8994,4644,2,1,1,29,0)=" ;(APPTARRAY(28)=           SCHEDULE REQUEST TYPE (REQUIRED) -"
^XWB(8994,4644,2,1,1,30,0)=" ;                          'N' FOR 'NEXT AVAILABLE' APPT.;"
^XWB(8994,4644,2,1,1,31,0)=" ;                          'C' FOR OTHER THAN 'NEXT AVA.' (CLINICIAN "
