^XWB(8994,2545,2,"PARAMSEQ",4,4)=""
^XWB(8994,2545,2,"PARAMSEQ",5,5)=""
^XWB(8994,2545,3,0)="^8994.03^9^9^3101202^^"
^XWB(8994,2545,3,1,0)="Returns INSURANCE BUFFER file entries for specified date range. Each"
^XWB(8994,2545,3,2,0)="return value has the form:"
^XWB(8994,2545,3,3,0)="  BUFFER IEN^DFN^ << requested fields >> ^SSN^FLAGS^SYMBOL^DIV^IMAGES^ERR"
^XWB(8994,2545,3,4,0)="  where SSN is the full patient SSN,"
^XWB(8994,2545,3,5,0)="  FLAGS are the ""iIEYH"" flags,"
^XWB(8994,2545,3,6,0)="  SYMBOL is the IIV status (where the record is in electronic processing),"
^XWB(8994,2545,3,7,0)="  DIV is the users default division, and"
^XWB(8994,2545,3,8,0)="  IMAGES is field #2 IMAGES SCANNED from the DSIV AUDIT file (#19625)"
^XWB(8994,2545,3,9,0)="  ERR is the one-line eIV error message (if applicable)"
^XWB(8994,2546,0)="DSIV NO INSURANCE^NOI^DSIVIC2^2^A"
^XWB(8994,2546,1,0)="^^2^2^3060329^"
^XWB(8994,2546,1,1,0)="Allows ICB to set the NO COVERAGE VERIFICATION DATE in the Billing"
^XWB(8994,2546,1,2,0)=" Patient (#354) file."
^XWB(8994,2546,2,0)="^8994.02A^2^2"
^XWB(8994,2546,2,1,0)="DFN^1^30^1^1"
^XWB(8994,2546,2,1,1,0)="^^1^1^3060329^"
^XWB(8994,2546,2,1,1,1,0)="Contains the patient ien."
^XWB(8994,2546,2,2,0)="DATA^2^80^1^2"
^XWB(8994,2546,2,2,1,0)="^^2^2^3060329^"
^XWB(8994,2546,2,2,1,1,0)="Contains the field and value to update for ICB file 354.  The format is"
^XWB(8994,2546,2,2,1,2,0)=" DATA(field)=value.  Example is DATA(60)=3060328."
