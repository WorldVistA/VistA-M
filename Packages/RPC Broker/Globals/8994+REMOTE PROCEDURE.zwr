^XWB(8994,2707,3,2,0)=" "
^XWB(8994,2707,3,3,0)="RESULT(1)=""SLC - Anticoagulation^384;SC("""
^XWB(8994,2707,3,4,0)="RESULT(2)=""POC - Anticoagulation^386;SC("""
^XWB(8994,2707,3,5,0)="RESULT(3)=""Ely - Anticoagulation^388;SC("""
^XWB(8994,2707,3,6,0)=" "
^XWB(8994,2707,3,7,0)="where ^-piece 1 = Clinic Name, and"
^XWB(8994,2707,3,8,0)="      ^-piece 2 = Variable pointer to file 44 (Hospital Location)"
^XWB(8994,2708,0)="ORAM ORDER^ORDER^ORAM^1^S^^^0"
