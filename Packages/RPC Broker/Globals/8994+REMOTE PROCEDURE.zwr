^XWB(8994,3919,0)="DSIYTI01 TIEDIT EDIT TI^TIEDIT^DSIYTI01^2"
^XWB(8994,3919,1,0)="^8994.01^3^3^3130313^^^^"
^XWB(8994,3919,1,1,0)="TIEDIT"
^XWB(8994,3919,1,2,0)="RPC to return information about each Turn-In Request so that"
^XWB(8994,3919,1,3,0)="the GUI knows where the user should be allowed to edit (if at all)"
^XWB(8994,3919,2,0)="^8994.02A^1^1"
^XWB(8994,3919,2,1,0)="TIIEN^1^11^1^1"
^XWB(8994,3919,2,1,1,0)="^8994.021^4^4^3130313^^^"
^XWB(8994,3919,2,1,1,1,0)="TIIEN"
^XWB(8994,3919,2,1,1,2,0)=" "
^XWB(8994,3919,2,1,1,3,0)="IEN to the Turn-In Request File - Required"
^XWB(8994,3919,2,1,1,4,0)="^PRCN(413.1)"
