^XWB(8994,4164,2,"PARAMSEQ",2,2)=""
^XWB(8994,4164,2,"PARAMSEQ",3,3)=""
^XWB(8994,4164,2,"PARAMSEQ",4,4)=""
^XWB(8994,4164,3,0)="^8994.03^12^12^3170720^^"
^XWB(8994,4164,3,1,0)="RETURN PARAMETER"
^XWB(8994,4164,3,2,0)=" "
^XWB(8994,4164,3,3,0)="DSIYRET(1)= 0^MESSAGE        IF NOTHING RETURNED"
^XWB(8994,4164,3,4,0)="DSIYRET(1)=-1^MESSAGE        IF THERE ARE ERRORS"
^XWB(8994,4164,3,5,0)=" "
^XWB(8994,4164,3,6,0)="DSIYRET(#) = "
^XWB(8994,4164,3,7,0)=" "
^XWB(8994,4164,3,8,0)="P1:  FILE#"
^XWB(8994,4164,3,9,0)="P2:  FILE NAME"
^XWB(8994,4164,3,10,0)="P3:  SYNONYM  (FUTURE USE)"
^XWB(8994,4164,3,11,0)="P4:  FILEMAN VRPK CODE"
^XWB(8994,4164,3,12,0)="P5:  ADHOC GROUP NAME"
^XWB(8994,4165,0)="YTQ GET RESULTS^LDSCORES^YTSCORE^4^S^^^1"
^XWB(8994,4165,1,0)="^8994.01^5^5^3171011^^^"
^XWB(8994,4165,1,1,0)="Returns saved results in the MH RESULTS File (#601.92) by Scale for a specific Administration. "
^XWB(8994,4165,1,2,0)=" "
^XWB(8994,4165,1,3,0)="Input:  AD as ien for MH ADMINISTRATIONS"
^XWB(8994,4165,1,4,0)=" "
^XWB(8994,4165,1,5,0)="Output: Scale name=Scale score"
^XWB(8994,4165,2,0)="^8994.02A"
^XWB(8994,4166,0)="YTQ GET SCRATCH SCORES^GETTSC^YTQPXRM8^4^^^^1"
^XWB(8994,4166,1,0)="^8994.01^1^1^3180905^^^"
^XWB(8994,4166,1,1,0)="Returns Scales score built from the Scratch global for CPRS (601.94)"
^XWB(8994,4166,2,0)="^8994.02A^3^3"
^XWB(8994,4166,2,1,0)="DFN^1^^1"
^XWB(8994,4166,2,1,1,0)="^^1^1^3180226^"
^XWB(8994,4166,2,1,1,1,0)="Patient IEN"
^XWB(8994,4166,2,2,0)="CODE^1^^1"
^XWB(8994,4166,2,2,1,0)="^^1^1^3180226^"
^XWB(8994,4166,2,2,1,1,0)="Instrument Name from file 601.71"
^XWB(8994,4166,2,3,0)="HANDLE^1^^1"
^XWB(8994,4166,2,3,1,0)="^^1^1^3180905^"
^XWB(8994,4166,2,3,1,1,0)="Unique identifier of the GUI session"
^XWB(8994,4166,2,"B","CODE",2)=""
^XWB(8994,4166,2,"B","DFN",1)=""
^XWB(8994,4166,2,"B","HANDLE",3)=""
^XWB(8994,4167,0)="MPIF UPDATE NAME COMP FLAG^UPDFLAG^MPIFNAMC^1^P^^^^1^^0"
^XWB(8994,4167,1,0)="^^24^24^3181121^"
^XWB(8994,4167,1,1,0)="This Remote Procedure updates or retrieves the Name Components flag in"
^XWB(8994,4167,1,2,0)="VistA, which controls how names passed in HL7 ADT-A31 messages to VistA"
^XWB(8994,4167,1,3,0)="are processed."
^XWB(8994,4167,1,4,0)=" "
^XWB(8994,4167,1,5,0)="If the flag is set to 0 or null, then the component parts of the name that"
^XWB(8994,4167,1,6,0)="are passed in the HL7 message are used to build a name, possibly shortened"
^XWB(8994,4167,1,7,0)="to 30 characters, and then filed into the PATIENT file (#2) NAME field "
^XWB(8994,4167,1,8,0)="(#.01) The same is true for aliases. The components parts of any aliases"
^XWB(8994,4167,1,9,0)="are used to build a possibly shortened alias, and filed into the ALIAS "
^XWB(8994,4167,1,10,0)="multiple (#1) NAME field (#.01) of the PATIENT file. MUMPS cross"
^XWB(8994,4167,1,11,0)="references on the PATIENT file (#2) NAME field (#.01) and the ALIAS"
^XWB(8994,4167,1,12,0)="multiple (#1) NAME field (#.01) will update the corresponding NAME"
^XWB(8994,4167,1,13,0)="COMPONENTS file (#20) entry with the name components passed in the ADT-A31"
^XWB(8994,4167,1,14,0)="message."
^XWB(8994,4167,1,15,0)=" "
^XWB(8994,4167,1,16,0)="If the Name Components flag is set to 1, then the component parts of the "
^XWB(8994,4167,1,17,0)="name or alias are filed directly into the NAME COMPONENTS file. A MUMPS"
^XWB(8994,4167,1,18,0)="cross reference on the fields in the NAME COMPONENTS file will update the"
^XWB(8994,4167,1,19,0)="source field -- the Patient Name field (#.01) or the Alias multiple (#2)"
^XWB(8994,4167,1,20,0)="Name field (#.01) -- with a formatted name."
^XWB(8994,4167,1,21,0)=" "
^XWB(8994,4167,1,22,0)="The flag will be stored in the MPI ICN BUILD MANAGEMENT file (#984.8), "
^XWB(8994,4167,1,23,0)="LAST PATIENT BUILT field (#3) of entry number 3, that has the NAME of "
^XWB(8994,4167,1,24,0)="""THREE""."
^XWB(8994,4167,2,0)="^8994.02A^2^2"
^XWB(8994,4167,2,1,0)="FLAG^1^^^1"
^XWB(8994,4167,2,1,1,0)="^^4^4^3181121^"
^XWB(8994,4167,2,1,1,1,0)="This parameter contains a flag to control how the Remote Procedure works. "
^XWB(8994,4167,2,1,1,2,0)="If it contains a ""G"", the Remote Procedure operates in ""GET"" mode, "
^XWB(8994,4167,2,1,1,3,0)="and simply returns the value of the flag; otherwise, the flag is set "
^XWB(8994,4167,2,1,1,4,0)="to the value passed in the VALUE parameter."
^XWB(8994,4167,2,2,0)="VALUE^1^^^2"
^XWB(8994,4167,2,2,1,0)="^8994.021^5^5^3181121^^"
^XWB(8994,4167,2,2,1,1,0)="This is the value to set the flag to. A value of 0 indicates that the "
^XWB(8994,4167,2,2,1,2,0)="Name and Aliases passed in an ADT-A31 should be filed into the NAME "
^XWB(8994,4167,2,2,1,3,0)="field (#.01) or ALIAS multiple (#1) NAME field (#.01) of the PATIENT file "
^XWB(8994,4167,2,2,1,4,0)="(#2). A value of 1 indicates that the Name and Aliases should be filed"
^XWB(8994,4167,2,2,1,5,0)="into the NAME COMPONENTS file (#20)."
^XWB(8994,4167,2,"B","FLAG",1)=""
^XWB(8994,4167,2,"B","VALUE",2)=""
^XWB(8994,4167,2,"PARAMSEQ",1,1)=""
^XWB(8994,4167,2,"PARAMSEQ",2,2)=""
^XWB(8994,4167,3,0)="^^13^13^3181121^"
^XWB(8994,4167,3,1,0)="If the FLAG parameter contains a ""G"": "
^XWB(8994,4167,3,2,0)=" "
^XWB(8994,4167,3,3,0)="        1^<value of parameter, 0 or 1>"
^XWB(8994,4167,3,4,0)="                    "
^XWB(8994,4167,3,5,0)="If the FLAG parameter does not contain a ""G"" one of three strings will be "
^XWB(8994,4167,3,6,0)="returned:"
^XWB(8994,4167,3,7,0)=" "
^XWB(8994,4167,3,8,0)="        1^Successfully added entry THREE and updated flag to <value> in"
^XWB(8994,4167,3,9,0)="          File #984.8"
^XWB(8994,4167,3,10,0)=" "
^XWB(8994,4167,3,11,0)="        1^Successfully update flag to <value> in File #984.8"
^XWB(8994,4167,3,12,0)=" "
^XWB(8994,4167,3,13,0)="        -1^<error message>"
^XWB(8994,4168,0)="DG UPDATE NAME COMPONENTS^UPDNC^DGNAME^2^P^^^^1^^0"
^XWB(8994,4168,1,0)="^8994.01^2^2^3181214^^"
^XWB(8994,4168,1,1,0)="This Remote Procedure updates or retrieves values in a NAME COMPONENTS "
^XWB(8994,4168,1,2,0)="file (#20) entry."
^XWB(8994,4168,2,0)="^8994.02A^3^3"
^XWB(8994,4168,2,1,0)="FLAG^1^^^1"
^XWB(8994,4168,2,1,1,0)="^8994.021^13^13^3181214^^"
^XWB(8994,4168,2,1,1,1,0)="This parameter acts as a flag to control how the Remote Procedure "
^XWB(8994,4168,2,1,1,2,0)="functions. If it contains a ""G"", the Remote Procedure operates in ""GET"" "
^XWB(8994,4168,2,1,1,3,0)="mode and returns the values of the following fields in the NAME "
^XWB(8994,4168,2,1,1,4,0)="COMPONENTS file (#20):"
^XWB(8994,4168,2,1,1,5,0)=" "
^XWB(8994,4168,2,1,1,6,0)="  FAMILY (LAST) NAME (#1)"
^XWB(8994,4168,2,1,1,7,0)="  GIVEN (FIRST) NAME (#2)"
^XWB(8994,4168,2,1,1,8,0)="  MIDDLE NAME (#3)"
^XWB(8994,4168,2,1,1,9,0)="  SUFFIX (#5)"
^XWB(8994,4168,2,1,1,10,0)=" "
^XWB(8994,4168,2,1,1,11,0)="If the parameter does not contain a ""G"", the Remote Procedure operates in "
^XWB(8994,4168,2,1,1,12,0)="""UPDATE"" mode and is used to set the values of the above fields to the "
^XWB(8994,4168,2,1,1,13,0)="values passed in the NAME COMPONENTS parameter."
^XWB(8994,4168,2,2,0)="IEN^1^^1^2"
^XWB(8994,4168,2,2,1,0)="^8994.021^10^10^3181214^^"
^XWB(8994,4168,2,2,1,1,0)="This parameter contain is the IEN of either an entry in the PATIENT file "
^XWB(8994,4168,2,2,1,2,0)="(#2), or an entry in the NAME COMPONENTS file (#20), depending on whether "
^XWB(8994,4168,2,2,1,3,0)="this remote procedure is being called in GET or UPDATE mode."
^XWB(8994,4168,2,2,1,4,0)=" "
^XWB(8994,4168,2,2,1,5,0)="If the FLAG parameter contains a ""G"" (GET mode), IEN is the DFN of the "
^XWB(8994,4168,2,2,1,6,0)="PATIENT file entry for which the NAME and ALIAS name components should be "
^XWB(8994,4168,2,2,1,7,0)="returned."
^XWB(8994,4168,2,2,1,8,0)=" "
^XWB(8994,4168,2,2,1,9,0)="If the FLAG parameter does not contain a ""G"" (UPDATE mode), IEN is the "
^XWB(8994,4168,2,2,1,10,0)="IEN of the NAME COMPONENTS file entry to update."
^XWB(8994,4168,2,3,0)="NAME COMPONENTS^2^^^3"
^XWB(8994,4168,2,3,1,0)="^^16^16^3181121^"
^XWB(8994,4168,2,3,1,1,0)="If this Remote Procedure is being called in UPDATE mode (i.e., the FLAG "
^XWB(8994,4168,2,3,1,2,0)="parameter does not contain a ""G""), then this parameter contain the values"
^XWB(8994,4168,2,3,1,3,0)="to file in the NAME COMPONENTS file (#20) entry with the IEN passed. It is"
^XWB(8994,4168,2,3,1,4,0)="an array with the following format:"
^XWB(8994,4168,2,3,1,5,0)=" "
^XWB(8994,4168,2,3,1,6,0)="  ARRAY(""FAMILY"") = The Family (Last) Name"
^XWB(8994,4168,2,3,1,7,0)="  ARRAY(""GIVEN"") = The Given (First) Name"
^XWB(8994,4168,2,3,1,8,0)="  ARRAY(""MIDDLE"") = The Middle Name"
^XWB(8994,4168,2,3,1,9,0)="  ARRAY(""SUFFIX"") = The Suffix"
^XWB(8994,4168,2,3,1,10,0)=" "
^XWB(8994,4168,2,3,1,11,0)="To delete the value of a Name Component field, the array element can be"
^XWB(8994,4168,2,3,1,12,0)="set to """" or ""@"". To keep the value of a specific name component"
^XWB(8994,4168,2,3,1,13,0)="unchanged, don't pass that array element."
^XWB(8994,4168,2,3,1,14,0)=" "
^XWB(8994,4168,2,3,1,15,0)="If this Remote Procedure is being called in GET mode (i.e., the FLAG "
^XWB(8994,4168,2,3,1,16,0)="parameter contains a ""G""), then this parameter is ignored."
^XWB(8994,4168,2,"B","FLAG",1)=""
^XWB(8994,4168,2,"B","IEN",2)=""
^XWB(8994,4168,2,"B","NAME COMPONENTS",3)=""
^XWB(8994,4168,2,"PARAMSEQ",1,1)=""
^XWB(8994,4168,2,"PARAMSEQ",2,2)=""
^XWB(8994,4168,2,"PARAMSEQ",3,3)=""
^XWB(8994,4168,3,0)="^8994.03^24^24^3181214^^"
^XWB(8994,4168,3,1,0)="If the FLAG parameter contains a ""G"" (GET mode), the following array will"
^XWB(8994,4168,3,2,0)="be returned:"
^XWB(8994,4168,3,3,0)=" "
^XWB(8994,4168,3,4,0)="        RETURN(0) = <name components IEN for patient>^<last name>"
^XWB(8994,4168,3,5,0)="                      ^<first name>^<middle name>^<suffix>"
^XWB(8994,4168,3,6,0)="        RETURN(1) = <name components IEN for first alias>^<last name>"
^XWB(8994,4168,3,7,0)="                      ^<first name>^<middle name>^<suffix>"
^XWB(8994,4168,3,8,0)="        RETURN(2) = <name components IEN for second alias>^<last name>"
^XWB(8994,4168,3,9,0)="                      ^<first name>^<middle name>^<suffix>"
^XWB(8994,4168,3,10,0)="        ..."
^XWB(8994,4168,3,11,0)=" "
^XWB(8994,4168,3,12,0)="or, if there are errors, the returned array has the following format:"
^XWB(8994,4168,3,13,0)=" "
^XWB(8994,4168,3,14,0)="        RETURN(0) = -1^Patient with DFN <dfn> cannot be found."
^XWB(8994,4168,3,15,0)="        RETURN(0) = -1^<error message returned by GETS^DIQ call>"
^XWB(8994,4168,3,16,0)=" "
^XWB(8994,4168,3,17,0)="If the FLAG parameter does not contain a ""G"" (UPDATE mode), the following "
^XWB(8994,4168,3,18,0)="array node is returned:"
^XWB(8994,4168,3,19,0)=" "
^XWB(8994,4168,3,20,0)="        RETURN(0) = 1^<IEN of NAME COMPONENTS entry updated>"
^XWB(8994,4168,3,21,0)=" "
^XWB(8994,4168,3,22,0)="or if there is an error, the following is returned:"
^XWB(8994,4168,3,23,0)=" "
^XWB(8994,4168,3,24,0)="        RETURN(0) = -1^<error message returned from FILE^DIE call>"
^XWB(8994,4169,0)="MAGQBP GETVAL^GETVAL^MAGBVAL^2^R"
^XWB(8994,4169,1,0)="^8994.01^1^1^3180816^"
^XWB(8994,4169,1,1,0)="Returns values for Fields in a FM File."
^XWB(8994,4169,2,0)="^8994.02A^3^3"
^XWB(8994,4169,2,1,0)="MFILE^1^30^1^1"
^XWB(8994,4169,2,1,1,0)="^^1^1^3180816^"
^XWB(8994,4169,2,1,1,1,0)="This is the FM File #"
^XWB(8994,4169,2,2,0)="MIEN^1^30^1^2"
^XWB(8994,4169,2,2,1,0)="^^2^2^3180816^"
^XWB(8994,4169,2,2,1,1,0)="This is the internal entry number for the entry in "
^XWB(8994,4169,2,2,1,2,0)="the FM File."
^XWB(8994,4169,2,3,0)="MFLDS^1^60^1^3"
^XWB(8994,4169,2,3,1,0)="^^1^1^3180816^"
^XWB(8994,4169,2,3,1,1,0)="This is a ';' delimited string of field numbers."
^XWB(8994,4169,2,"B","MFILE",1)=""
^XWB(8994,4169,2,"B","MFLDS",3)=""
^XWB(8994,4169,2,"B","MIEN",2)=""
^XWB(8994,4169,2,"PARAMSEQ",1,1)=""
^XWB(8994,4169,2,"PARAMSEQ",2,2)=""
^XWB(8994,4169,2,"PARAMSEQ",3,3)=""
^XWB(8994,4169,3,0)="^^4^4^3180816^"
^XWB(8994,4169,3,1,0)="The result is an Array."
^XWB(8994,4169,3,2,0)="Array(0) = ""1^Success"" or ""0^Error message"""
^XWB(8994,4169,3,3,0)="Array(1..n) =  string of "
^XWB(8994,4169,3,4,0)="     Field Number ^ Internal Value ^ External Value"
^XWB(8994,4170,0)="MAGQBP SETVAL^SETVAL^MAGBVAL^2^R"
^XWB(8994,4170,1,0)="^8994.01^1^1^3180816^"
^XWB(8994,4170,1,1,0)="This RPC will modify a value in a FM File."
^XWB(8994,4170,2,0)="^8994.02A^2^2"
^XWB(8994,4170,2,1,0)="MAGFILE^1^30^1^1"
^XWB(8994,4170,2,1,1,0)="^^1^1^3180816^"
^XWB(8994,4170,2,1,1,1,0)="MAGFILE is a 2 '^' piece string of File # ^ File IEN"
^XWB(8994,4170,2,2,0)="MAGDATA^1^30^1^2"
^XWB(8994,4170,2,2,1,0)="^^1^1^3180816^"
^XWB(8994,4170,2,2,1,1,0)="MAGDATA is a 2 '^' piece string of Field # ^ Field Value"
^XWB(8994,4170,2,"B","MAGDATA",2)=""
^XWB(8994,4170,2,"B","MAGFILE",1)=""
^XWB(8994,4170,2,"PARAMSEQ",1,1)=""
