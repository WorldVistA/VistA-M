^XWB(8994,2549,3,0)="^8994.03^2^2^3050421^^^"
^XWB(8994,2549,3,1,0)="Array of insurance information: Insurer sequence <comma> field <up-arrow> "
^XWB(8994,2549,3,2,0)="data."
^XWB(8994,2550,0)="DSIV POLL REPORT^POLL^DSIVICR1^4^^^^1"
^XWB(8994,2550,1,0)="^8994.01^2^2^3140613^^^^"
^XWB(8994,2550,1,1,0)="Used to check the status of the background job kicked off by the DSIV "
^XWB(8994,2550,1,2,0)="EXCEPTION REPORT2 rpc, and to get the report data."
^XWB(8994,2550,2,0)="^8994.02A^3^3"
^XWB(8994,2550,2,1,0)="DSIVHNDL^1^50^1^1"
^XWB(8994,2550,2,1,1,0)="^^3^3^3070820^"
^XWB(8994,2550,2,1,1,1,0)="Contains the Handle returned by the kick-off rpc call DSIV EXCEPTION "
^XWB(8994,2550,2,1,1,2,0)="REPORT2.  This is the ^XTMP global node where the report status and data "
^XWB(8994,2550,2,1,1,3,0)="reside."
^XWB(8994,2550,2,2,0)="CNT^1^10^0^2"
^XWB(8994,2550,2,2,1,0)="^^1^1^3060717^"
^XWB(8994,2550,2,2,1,1,0)="Contains the count (#) of records to return for each call to the rpc."
^XWB(8994,2550,2,3,0)="MORE^1^1^0^3"
^XWB(8994,2550,2,3,1,0)="^^5^5^3140613^"
^XWB(8994,2550,2,3,1,1,0)="Contains a flag (MORE=1) when there were more records than parameter 2 "
^XWB(8994,2550,2,3,1,2,0)="(CNT) to supress the header for the subsequent calls to get data."
^XWB(8994,2550,2,3,1,3,0)="The first call to the rpc should NOT include the MORE=1 parameter.  Send "
^XWB(8994,2550,2,3,1,4,0)="MORE=9 to kill the report data in ^XTMP global if the user no longer "
^XWB(8994,2550,2,3,1,5,0)="wants to get it."
