^XWB(8994,2493,2,3,0)="HANDLE^1^^1"
^XWB(8994,2493,2,3,1,0)="^8994.021^1^1^3081029^^^"
^XWB(8994,2493,2,3,1,1,0)="Unique identifer of GIU session"
