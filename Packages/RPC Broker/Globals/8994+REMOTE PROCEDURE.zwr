^XWB(8994,2727,1,9,0)=" | The Food and Drug Administration classifies this software as  |"
^XWB(8994,2727,1,10,0)=" | a medical device.  As such, it may not be changed in any way. |"
^XWB(8994,2727,1,11,0)=" | Modifications to this software may result in an adulterated   |"
^XWB(8994,2727,1,12,0)=" | medical device under 21CFR820, the use of which is considered |"
^XWB(8994,2727,1,13,0)=" | to be a violation of US Federal Statutes.                     |"
^XWB(8994,2727,1,14,0)=" +---------------------------------------------------------------+"
^XWB(8994,2727,1,15,0)=" "
^XWB(8994,2727,1,16,0)="This Remote Procedure updates the information about an image."
^XWB(8994,2727,1,17,0)="Specifically, the fields for SERIES UID, SERIES NUMBER and"
^XWB(8994,2727,1,18,0)="IMAGE NUMBER (sequence within series) may be updated."
^XWB(8994,2727,2,0)="^8994.02A^6^6"
^XWB(8994,2727,2,1,0)="IMAGE^1^20^1^1"
^XWB(8994,2727,2,1,1,0)="^8994.021^3^3^3100621^^"
^XWB(8994,2727,2,1,1,1,0)="The value of this parameter is a pointer to the IMAGE file (#2005)."
^XWB(8994,2727,2,1,1,2,0)="This pointer identifies the image for which information is to be"
^XWB(8994,2727,2,1,1,3,0)="updated."
^XWB(8994,2727,2,2,0)="SERIES^1^64^0^2"
^XWB(8994,2727,2,2,1,0)="^^5^5^3061127^"
^XWB(8994,2727,2,2,1,1,0)="The value of this parameter is a string. This string, if non-empty,"
^XWB(8994,2727,2,2,1,2,0)="is the SERIES UID for the image specified."
^XWB(8994,2727,2,2,1,3,0)=" "
^XWB(8994,2727,2,2,1,4,0)="The format and meaning of a SERIES UID is specified in the DICOM"
^XWB(8994,2727,2,2,1,5,0)="standard."
^XWB(8994,2727,2,3,0)="SNUM^1^10^0^3"
^XWB(8994,2727,2,3,1,0)="^^2^2^3061127^"
^XWB(8994,2727,2,3,1,1,0)="The value of this parameter is either 0 (zero) or a positive integer number."
^XWB(8994,2727,2,3,1,2,0)="This number identifies the sequence of a series within a study."
^XWB(8994,2727,2,4,0)="INUM^1^10^0^4"
^XWB(8994,2727,2,4,1,0)="^8994.021^2^2^3070410^^"
^XWB(8994,2727,2,4,1,1,0)="The value of this parameter is either 0 (zero) or a positive integer number."
^XWB(8994,2727,2,4,1,2,0)="This number identifies the sequence of the image within its series."
^XWB(8994,2727,2,5,0)="IMGUID^1^64^0^5"
^XWB(8994,2727,2,5,1,0)="^^4^4^3070410^"
^XWB(8994,2727,2,5,1,1,0)="The value of this parameter is a string. This string meets the"
^XWB(8994,2727,2,5,1,2,0)="constraints of a DICOM Unique Identifier."
^XWB(8994,2727,2,5,1,3,0)=" "
^XWB(8994,2727,2,5,1,4,0)="This identifier uniquely identifies an image."
^XWB(8994,2727,2,6,0)="STUID^1^64^0^6"
^XWB(8994,2727,2,6,1,0)="^8994.021^4^4^3100621^^"
^XWB(8994,2727,2,6,1,1,0)="The value of this parameter is a string. This string meets the"
^XWB(8994,2727,2,6,1,2,0)="constraints of a DICOM Unique Identifier."
^XWB(8994,2727,2,6,1,3,0)=" "
^XWB(8994,2727,2,6,1,4,0)="This identifier uniquely identifies a study."
^XWB(8994,2727,2,"B","IMAGE",1)=""
^XWB(8994,2727,2,"B","IMGUID",5)=""
^XWB(8994,2727,2,"B","INUM",4)=""
^XWB(8994,2727,2,"B","SERIES",2)=""
^XWB(8994,2727,2,"B","SNUM",3)=""
^XWB(8994,2727,2,"B","STUID",6)=""
^XWB(8994,2727,2,"PARAMSEQ",1,1)=""
^XWB(8994,2727,2,"PARAMSEQ",2,2)=""
^XWB(8994,2727,2,"PARAMSEQ",3,3)=""
^XWB(8994,2727,2,"PARAMSEQ",4,4)=""
^XWB(8994,2727,2,"PARAMSEQ",5,5)=""
^XWB(8994,2727,2,"PARAMSEQ",6,6)=""
^XWB(8994,2727,3,0)="^8994.03^8^8^3100621^^^^"
^XWB(8994,2727,3,1,0)="The value of the return parameter is a string."
^XWB(8994,2727,3,2,0)=" "
^XWB(8994,2727,3,3,0)="When the specified values can be applied to the database, the value"
^XWB(8994,2727,3,4,0)="will be ""0,OK""."
^XWB(8994,2727,3,5,0)=" "
^XWB(8994,2727,3,6,0)="When the specified values cannot be applied to the database, the"
^XWB(8994,2727,3,7,0)="value will be a negative number, followed by a comma, followed by"
^XWB(8994,2727,3,8,0)="an error message."
^XWB(8994,2729,0)="VAFC LOCAL GETCORRESPONDINGIDS^TFL^VAFCTFU2^3^P^^^1^1"
^XWB(8994,2729,1,0)="^8994.01^10^10^3210316^^"
^XWB(8994,2729,1,1,0)="Given a patient DFN, ICN, or EDIPI, this Remote Procedure Call returns a "
^XWB(8994,2729,1,2,0)="list of Treating Facilities (including the SOURCE ID, STATION NUMBER and "
^XWB(8994,2729,1,3,0)="IDENTIFIER STATUS) from the Treating Facility (#391.91) file."
^XWB(8994,2729,1,4,0)=" "
^XWB(8994,2729,1,5,0)="The Remote Procedure call has been extended to now return a list of "
^XWB(8994,2729,1,6,0)="Treating Facilities (along with the SOURCE ID, STATION NUMBER and "
^XWB(8994,2729,1,7,0)="IDENTIFIER STATUS) from the New Person Treating Facility List (#391.92)"
^XWB(8994,2729,1,8,0)="file if the Identifiers passed aren't known to the Patient File (#2) "
^XWB(8994,2729,1,9,0)="meaning that the identifiers passed are for someone only known to the New "
^XWB(8994,2729,1,10,0)="Person (#200) file."
^XWB(8994,2729,2,0)="^8994.02A^2^1"
^XWB(8994,2729,2,2,0)="Patient Identifier^3^255^1^1"
^XWB(8994,2729,2,2,1,0)="^^19^19^3210316^"
^XWB(8994,2729,2,2,1,1,0)="The patient identifier will either be the PATIENT file (#2) IEN (aka "
^XWB(8994,2729,2,2,1,2,0)="DFN), Integration Control Number (aka ICN) or the DOD Identifier (aka "
^XWB(8994,2729,2,2,1,3,0)="EDIPI).  Following this format:"
^XWB(8994,2729,2,2,1,4,0)=" "
^XWB(8994,2729,2,2,1,5,0)="Id^IdType^AssigningAuthority^AssigningFacility"
^XWB(8994,2729,2,2,1,6,0)=" "
^XWB(8994,2729,2,2,1,7,0)="Examples:"
^XWB(8994,2729,2,2,1,8,0)=" "
^XWB(8994,2729,2,2,1,9,0)="ICN example:   1008520438V882204^NI^USVHA^200M"
^XWB(8994,2729,2,2,1,10,0)="DFN example:   100000511^PI^USVHA^500"
^XWB(8994,2729,2,2,1,11,0)="EDIPI example: 852043888^NI^USDOD^200DOD"
^XWB(8994,2729,2,2,1,12,0)=" "
^XWB(8994,2729,2,2,1,13,0)=" "
^XWB(8994,2729,2,2,1,14,0)="The identifier can now also be for someone only known to the NEW PERSON "
^XWB(8994,2729,2,2,1,15,0)="(#200) file, an IEN (aka DUZ) or Integration Conrol Number (aka ICN).  "
^XWB(8994,2729,2,2,1,16,0)="Following this format:"
^XWB(8994,2729,2,2,1,17,0)=" "
^XWB(8994,2729,2,2,1,18,0)="ICN example:   1008882211V840482^NI^USVHA^200M"
^XWB(8994,2729,2,2,1,19,0)="DUZ example:   12891^PN^USDVA^500"
^XWB(8994,2729,2,"B","Patient Identifier",2)=""
^XWB(8994,2729,2,"PARAMSEQ",1,2)=""
^XWB(8994,2729,3,0)="^^11^11^3100107^"
^XWB(8994,2729,3,1,0)="This will return a list of treating facilities in the following format:"
^XWB(8994,2729,3,2,0)=" "
^XWB(8994,2729,3,3,0)="ID^IDTYPE^AssigningAuthority^AssigningFacility^IDStatus"
^XWB(8994,2729,3,4,0)=" "
^XWB(8994,2729,3,5,0)="Examples:"
^XWB(8994,2729,3,6,0)=" "
^XWB(8994,2729,3,7,0)="RETURN(1)=""27^PI^USVHA^500^H"""
^XWB(8994,2729,3,8,0)="RETURN(2)=""7169806^PI^USVHA^500^A"""
^XWB(8994,2729,3,9,0)="RETURN(3)=""^PI^USVHA^200PS"""
^XWB(8994,2729,3,10,0)="RETURN(4)=""1^NI^USDOD^200DOD^A"""
^XWB(8994,2729,3,11,0)="RETURN(5)=""2^NI^USDOD^200DOD^H"""
^XWB(8994,2730,0)="VAFC NEW NC TREATING FACILITY^NEWTF^VAFCTFU2^2^P^0^^^1"
^XWB(8994,2730,1,0)="^^7^7^3100414^"
^XWB(8994,2730,1,1,0)="This Remote Procedure Call will be used by the North Chicago Common "
^XWB(8994,2730,1,2,0)="Registration User Interface (UI).  Given a patient DFN and DOD EDIPI, the "
^XWB(8994,2730,1,3,0)="RPC adds an active Department of Defense correlation to the VistA "
^XWB(8994,2730,1,4,0)="TREATING FACILITY LIST (#391.91) file if it does not exist.  It returns a "
^XWB(8994,2730,1,5,0)="list of Treating Facilities, including Source Identifier, Identifier "
^XWB(8994,2730,1,6,0)="Type, Assigning Authority, Assigning Facility, Identifier Status, and an "
^XWB(8994,2730,1,7,0)="indicator if the entry was entered into File 391.91."
^XWB(8994,2730,2,0)="^8994.02A^2^2"
^XWB(8994,2730,2,1,0)="Vista Patient Identifier^1^255^1^1"
^XWB(8994,2730,2,1,1,0)="^^3^3^3100415^"
^XWB(8994,2730,2,1,1,1,0)="Vista Patient Identifier will be the PATIENT (#2) file IEN (aka DFN)."
^XWB(8994,2730,2,1,1,2,0)=" "
^XWB(8994,2730,2,1,1,3,0)="Example: DFN=""7168937"""
^XWB(8994,2730,2,2,0)="DOD Identifier^1^255^1^2"
^XWB(8994,2730,2,2,1,0)="^^5^5^3100415^"
^XWB(8994,2730,2,2,1,1,0)="The DOD Identifier will be EDIPI data with the following format:"
^XWB(8994,2730,2,2,1,2,0)=" "
^XWB(8994,2730,2,2,1,3,0)=" Id^IdType^AssigningAuthority^AssigningFacility"
^XWB(8994,2730,2,2,1,4,0)=" "
^XWB(8994,2730,2,2,1,5,0)=" Example: EDIPI=""852043888^NI^USDOD^200DOD"""
^XWB(8994,2730,2,"B","DOD Identifier",2)=""
^XWB(8994,2730,2,"B","Vista Patient Identifier",1)=""
^XWB(8994,2730,2,"PARAMSEQ",1,1)=""
^XWB(8994,2730,2,"PARAMSEQ",2,2)=""
^XWB(8994,2730,3,0)="^^12^12^3100415^"
^XWB(8994,2730,3,1,0)="This will return a list of treating facilities in the following format:"
^XWB(8994,2730,3,2,0)="  "
^XWB(8994,2730,3,3,0)=" Id^IdType^AssigningAuthority^AssigningFacility^IdStatus[^NEW]"
^XWB(8994,2730,3,4,0)="  "
^XWB(8994,2730,3,5,0)=" Examples:"
^XWB(8994,2730,3,6,0)="  "
^XWB(8994,2730,3,7,0)=" RESULT(1)=""7168937^PI^USVHA^500^A"""
^XWB(8994,2730,3,8,0)=" RESULT(2)=""1^NI^USDOD^200DOD^A^NEW"""
^XWB(8994,2730,3,9,0)=" "
^XWB(8994,2730,3,10,0)=" Note: If there is data in the 6th piece of the RESULT(<number>), with"
^XWB(8994,2730,3,11,0)="       data value as ""NEW"", then it means that the entry was newly created"
^XWB(8994,2730,3,12,0)="       in the TREATING FACILITY LIST (#391.91) file by this RPC call."
^XWB(8994,2731,0)="MAG4 INDEX GET ORIGIN^IGO^MAGSIXGT^2^A^0"
^XWB(8994,2731,1,0)="^8994.01^1^1^3100125^^^"
^XWB(8994,2731,1,1,0)="This call will return an array of INDEX ORIGIN"
^XWB(8994,2731,3,0)="^8994.03^7^7^3100125^^^"
^XWB(8994,2731,3,1,0)="The result array includes all ORIGINs"
^XWB(8994,2731,3,2,0)=" "
^XWB(8994,2731,3,3,0)="The format of the result Array:"
^XWB(8994,2731,3,4,0)=" "
^XWB(8994,2731,3,5,0)="MAGRY(0) = 1^OK: ""Number of records"""
^XWB(8994,2731,3,6,0)="MAGRY(1) = ""Image Origin^Abbr"""
^XWB(8994,2731,3,7,0)="MAGRY(2..n) = ORIGIN INDEX^ORING ABBRIVIATION"
^XWB(8994,2732,0)="MAGN PATIENT HAS PHOTO^RPHASPHT^MAGNVIC^1^A^0"
^XWB(8994,2732,1,0)="^8994.01^1^1^3100305^^^^"
^XWB(8994,2732,1,1,0)="Checks if photo image exists for a patient"
^XWB(8994,2732,2,0)="^8994.02A^1^1"
^XWB(8994,2732,2,1,0)="MAGDFN^1^^1^1"
^XWB(8994,2732,2,1,1,0)="^8994.021^1^1^3100305^^^^"
^XWB(8994,2732,2,1,1,1,0)="Patient DFN"
^XWB(8994,2732,2,"B","MAGDFN",1)=""
^XWB(8994,2732,2,"PARAMSEQ",1,1)=""
^XWB(8994,2732,3,0)="^8994.03^2^2^3100305^^^^"
^XWB(8994,2732,3,1,0)="MAGRY = 0 Photo doesn't exist"
^XWB(8994,2732,3,2,0)="        Date.Timestamp - Photo on file (date timestamp of most recent photo in FileMan format, example 3101231.1701)"
^XWB(8994,2733,0)="MAG BROKER GET VISITOR^BSEXP^MAGS2BSE^1^R^0^^0^^^0"
^XWB(8994,2733,1,0)="^8994.01^1^1^3100325^^"
^XWB(8994,2733,1,1,0)="Wraps code underlying RPC: XUS GET VISITOR to check for expired authentication token."
^XWB(8994,2733,2,0)="^8994.02A^1^1"
^XWB(8994,2733,2,1,0)="MAGTKN^1^256^0"
^XWB(8994,2733,2,1,1,0)="^^1^1^3100325^"
^XWB(8994,2733,2,1,1,1,0)="The Broker Security Enhancement (BSE) token to validate."
^XWB(8994,2733,2,"B","MAGTKN",1)=""
^XWB(8994,2733,3,0)="^^2^2^3100325^"
^XWB(8994,2733,3,1,0)="Returns '0' if input invalid or token expired. Otherwise returns"
^XWB(8994,2733,3,2,0)="caret-delimited string of the token holder's demographic data."
^XWB(8994,2734,0)="MAGJ GET TREATING LIST^FACLIST^MAGJLST1^2^R^^^1"
^XWB(8994,2734,1,0)="^8994.01^2^2^3091021^^"
^XWB(8994,2734,1,1,0)="Get Treating Facility List for a patient.  This RPC merely calls"
^XWB(8994,2734,1,2,0)="the subroutine used for the VAFCTFU GET TREATING LIST rpc."
^XWB(8994,2734,2,0)="^8994.02A^1^1"
^XWB(8994,2734,2,1,0)="DFN^1^30^1^1"
^XWB(8994,2734,2,1,1,0)="^8994.021^1^1^3091021^^"
^XWB(8994,2734,2,1,1,1,0)="Patient DFN"
^XWB(8994,2734,2,"B","DFN",1)=""
^XWB(8994,2734,2,"PARAMSEQ",1,1)=""
^XWB(8994,2734,3,0)="^8994.03^9^9^3091021^^"
^XWB(8994,2734,3,1,0)="Array; first entry contains result header with # lines to follow"
^XWB(8994,2734,3,2,0)="and reply message description."
^XWB(8994,2734,3,3,0)="Entries 2:N (if any exist) contain data for each Treating facility,"
^XWB(8994,2734,3,4,0)="up-caret delimited : A ^ B ^ C ^ D ^ E"
^XWB(8994,2734,3,5,0)="   A: Institution IEN of the Facility"
^XWB(8994,2734,3,6,0)="   B: Institution Name"
^XWB(8994,2734,3,7,0)="   C: Current date on record for that institution"
^XWB(8994,2734,3,8,0)="   D: ADT/HL7 event reason "
^XWB(8994,2734,3,9,0)="   E: FACILITY TYPE"
^XWB(8994,2735,0)="MAGJ VIX LOG REMOTE IMG ACCESS^LOGRIA^MAGJVAPI^1^R^0^^1^.1^^0"
^XWB(8994,2735,1,0)="^8994.01^1^1^3101104^^^^"
^XWB(8994,2735,1,1,0)="Log ViX-enabled Remote Image Access Events."
^XWB(8994,2735,2,0)="^8994.02A^1^1"
^XWB(8994,2735,2,1,0)="DATA^1^256^1^1"
^XWB(8994,2735,2,1,1,0)="^8994.021^9^9^3101104^^^^"
^XWB(8994,2735,2,1,1,1,0)="CARET DELIMITED AS FOLLOWS:"
^XWB(8994,2735,2,1,1,2,0)="  ^01: ACTION ... ""VR-RV""_ subset member from ACTION+1^MAGGTAU"
^XWB(8994,2735,2,1,1,3,0)="  ^02: RADFN .... IEN of PATIENT file (#2)"
^XWB(8994,2735,2,1,1,4,0)="  ^03: MAGIEN ... IEN of IMAGE file (#2005)"
^XWB(8994,2735,2,1,1,5,0)="  ^04: NIMGS .... VRad Image Count"
^XWB(8994,2735,2,1,1,6,0)="  ^05: REMOTE ... VRad Remote Read Flag"
^XWB(8994,2735,2,1,1,7,0)="  ^06: MAGJVRV .. VRad Version"
^XWB(8994,2735,2,1,1,8,0)="  ^07: USERCLS .. VRad User Class"
^XWB(8994,2735,2,1,1,9,0)="  ^08: VIXTXID .. VRad VIX Transaction ID"
^XWB(8994,2735,2,"B","DATA",1)=""
^XWB(8994,2735,2,"PARAMSEQ",1,1)=""
^XWB(8994,2735,3,0)="^8994.03^5^5^3100401^^^^"
^XWB(8994,2735,3,1,0)="CARET-DELIMITED (IF NECESSARY):"
^XWB(8994,2735,3,2,0)=" "
^XWB(8994,2735,3,3,0)="       __EXPECTED__  ______ON_ERROR______"
^XWB(8994,2735,3,4,0)="  ^01: 1             0"
^XWB(8994,2735,3,5,0)="  ^02:               Error msg. (optional)"
^XWB(8994,2736,0)="RAMAG EXAM ORDER^ORDER^RAMAGRP1^2^A^^^1"
^XWB(8994,2736,1,0)="^8994.01^3^3^3080404^^^"
^XWB(8994,2736,1,1,0)="The RAMAG EXAM ORDER remote procedure requests a Radiology exam for the"
^XWB(8994,2736,1,2,0)="patient and returns the IEN of the new order in the RAD/NUC MED ORDERS"
^XWB(8994,2736,1,3,0)="file (#75.1). It also sends all required notifications.."
^XWB(8994,2736,2,0)="^8994.02A^9^9"
^XWB(8994,2736,2,1,0)="RADFN^1^^1^1"
^XWB(8994,2736,2,1,1,0)="^8994.021^1^1^3070621^^"
^XWB(8994,2736,2,1,1,1,0)="Patient IEN (DFN)."
^XWB(8994,2736,2,2,0)="RAMLC^1^^1^2"
^XWB(8994,2736,2,2,1,0)="^8994.021^1^1^3070621^^"
^XWB(8994,2736,2,2,1,1,0)="IEN of the imaging location in the IMAGING LOCATIONS file (#79.1)."
^XWB(8994,2736,2,3,0)="RAPROC^1^^1^3"
^XWB(8994,2736,2,3,1,0)="^8994.021^5^5^3070621^^"
^XWB(8994,2736,2,3,1,1,0)="Radiology procedure and optional modifiers"
^XWB(8994,2736,2,3,1,2,0)="  ^01: Procedure IEN in the RAD/NUC MED PROCEDURES file (#71)"
^XWB(8994,2736,2,3,1,3,0)="  ^02: Optional procedure modifiers (IENs in"
^XWB(8994,2736,2,3,1,4,0)="  ...  the PROCEDURE MODIFIERS file (#71.2))"
^XWB(8994,2736,2,3,1,5,0)="  ^nn:"
^XWB(8994,2736,2,4,0)="REQDTE^1^^1^4"
^XWB(8994,2736,2,4,1,0)="^^2^2^3080116^"
^XWB(8994,2736,2,4,1,1,0)="Desired date for the exam in HL7 format (TS): YYYYMMDD. If time is "
^XWB(8994,2736,2,4,1,2,0)="provided, it is ignored. The date must be exact."
^XWB(8994,2736,2,5,0)="RACAT^1^^1^5"
^XWB(8994,2736,2,5,1,0)="^^2^2^3080222^"
^XWB(8994,2736,2,5,1,1,0)="Exam category: internal value of the CATEGORY OF EXAM field (4) of the "
^XWB(8994,2736,2,5,1,2,0)="RAD/NUC MED ORDERS file (#75.1)."
^XWB(8994,2736,2,6,0)="REQLOC^1^^1^6"
^XWB(8994,2736,2,6,1,0)="^^1^1^3070515^"
^XWB(8994,2736,2,6,1,1,0)="IEN of the requesting location in the HOSPITAL LOCATION file (#44)."
^XWB(8994,2736,2,7,0)="REQPHYS^1^^1^7"
^XWB(8994,2736,2,7,1,0)="^^1^1^3070515^"
^XWB(8994,2736,2,7,1,1,0)="IEN of the requesting physician in the NEW PERSON file (#200)."
^XWB(8994,2736,2,8,0)="REASON^1^^1^8"
^XWB(8994,2736,2,8,1,0)="^8994.021^2^2^3070621^^"
^XWB(8994,2736,2,8,1,1,0)="Reason for study. See the REASON FOR STUDY field (1.1) of the RAD/NUC MED "
^XWB(8994,2736,2,8,1,2,0)="ORDERS file (#75.1) for details."
^XWB(8994,2736,2,9,0)="RAMSC^2^^^9"
^XWB(8994,2736,2,9,1,0)="^^54^54^3080404^"
^XWB(8994,2736,2,9,1,1,0)="Items of this list define miscellaneous/optional order parameters. Each"
^XWB(8994,2736,2,9,1,2,0)="record has 3 or more pieces separated by '^':"
^XWB(8994,2736,2,9,1,3,0)=" "
^XWB(8994,2736,2,9,1,4,0)="  ^01: Parameter name"
^XWB(8994,2736,2,9,1,5,0)="  ^02: Index (for multiples and word-processing values)"
^XWB(8994,2736,2,9,1,6,0)="  ^03: Value1"
^XWB(8994,2736,2,9,1,7,0)="  ^04: Value2"
^XWB(8994,2736,2,9,1,8,0)="  ..."
^XWB(8994,2736,2,9,1,9,0)=" "
^XWB(8994,2736,2,9,1,10,0)="The following parameters are supported by this remote procedure:"
^XWB(8994,2736,2,9,1,11,0)="  "
^XWB(8994,2736,2,9,1,12,0)="  CLINHIST^{Seq#}^{Line of clinical history}"
^XWB(8994,2736,2,9,1,13,0)="    Text for the CLINICAL HISTORY FOR EXAM field (400)"
^XWB(8994,2736,2,9,1,14,0)="    of the file #75.1"
^XWB(8994,2736,2,9,1,15,0)=" "
^XWB(8994,2736,2,9,1,16,0)="  ISOLPROC^^{n|y}"
^XWB(8994,2736,2,9,1,17,0)="    Value for the ISOLATION PROCEDURES field (24)"
^XWB(8994,2736,2,9,1,18,0)="    of the file #75.1"
^XWB(8994,2736,2,9,1,19,0)=" "
^XWB(8994,2736,2,9,1,20,0)="  PREGNANT^^{n|u|y}"
^XWB(8994,2736,2,9,1,21,0)="    Value for the PREGNANT field (13) of the file #75.1"
^XWB(8994,2736,2,9,1,22,0)=" "
^XWB(8994,2736,2,9,1,23,0)="  PREOPDT^^{Internal date value}"
^XWB(8994,2736,2,9,1,24,0)="    Date and time for the PRE-OP SCHEDULED DATE/TIME"
^XWB(8994,2736,2,9,1,25,0)="    field (12) of the file #75.1 in HL7 format (TS):"
^XWB(8994,2736,2,9,1,26,0)="    YYYYMMDD[HHMM[+/-ZZZZ]]. If seconds are provided,"
^XWB(8994,2736,2,9,1,27,0)="    they are ignored. The date must be exact."
^XWB(8994,2736,2,9,1,28,0)=" "
^XWB(8994,2736,2,9,1,29,0)="  REQNATURE^^{e|i|p|s|v|w}"
^XWB(8994,2736,2,9,1,30,0)="    Value for the NATURE OF (NEW) ORDER ACTIVITY field (26)"
^XWB(8994,2736,2,9,1,31,0)="    of the file #75.1"
^XWB(8994,2736,2,9,1,32,0)=" "
^XWB(8994,2736,2,9,1,33,0)="  REQURG^^{1|2|9}"
^XWB(8994,2736,2,9,1,34,0)="    Value for the REQUEST URGENCY field (6)"
^XWB(8994,2736,2,9,1,35,0)="    of the file #75.1"
^XWB(8994,2736,2,9,1,36,0)=" "
^XWB(8994,2736,2,9,1,37,0)="  TRANSPMODE^^{a|p|s|w}"
^XWB(8994,2736,2,9,1,38,0)="    Value for the MODE OF TRANSPORT field (19)"
^XWB(8994,2736,2,9,1,39,0)="    of the file #75.1"
^XWB(8994,2736,2,9,1,40,0)=" "
^XWB(8994,2736,2,9,1,41,0)="Records can be added to the list in any order. See the comments preceding"
^XWB(8994,2736,2,9,1,42,0)="the $$ORDER^RAMAG02 for more details."
^XWB(8994,2736,2,9,1,43,0)=" "
^XWB(8994,2736,2,9,1,44,0)="Example:"
^XWB(8994,2736,2,9,1,45,0)=" "
^XWB(8994,2736,2,9,1,46,0)="  with RPCBroker.Param[8] do"
^XWB(8994,2736,2,9,1,47,0)="    begin"
^XWB(8994,2736,2,9,1,48,0)="      PType := list;"
^XWB(8994,2736,2,9,1,49,0)="      Mult[1] := 'PREGNANT^^y';"
^XWB(8994,2736,2,9,1,50,0)="      Mult[2] := 'PREOPDT^^200001041400';"
^XWB(8994,2736,2,9,1,51,0)="      Mult[3] := 'CLINHIST^1^Clinical history line #1';"
^XWB(8994,2736,2,9,1,52,0)="      Mult[4] := 'CLINHIST^2^Clinical history line #2';"
^XWB(8994,2736,2,9,1,53,0)="      Mult[5] := 'CLINHIST^3^Clinical history line #3';"
^XWB(8994,2736,2,9,1,54,0)="    end;"
^XWB(8994,2736,2,"B","RACAT",5)=""
^XWB(8994,2736,2,"B","RADFN",1)=""
^XWB(8994,2736,2,"B","RAMLC",2)=""
^XWB(8994,2736,2,"B","RAMSC",9)=""
^XWB(8994,2736,2,"B","RAPROC",3)=""
^XWB(8994,2736,2,"B","REASON",8)=""
^XWB(8994,2736,2,"B","REQDTE",4)=""
^XWB(8994,2736,2,"B","REQLOC",6)=""
^XWB(8994,2736,2,"B","REQPHYS",7)=""
^XWB(8994,2736,2,"PARAMSEQ",1,1)=""
^XWB(8994,2736,2,"PARAMSEQ",2,2)=""
^XWB(8994,2736,2,"PARAMSEQ",3,3)=""
^XWB(8994,2736,2,"PARAMSEQ",4,4)=""
^XWB(8994,2736,2,"PARAMSEQ",5,5)=""
^XWB(8994,2736,2,"PARAMSEQ",6,6)=""
^XWB(8994,2736,2,"PARAMSEQ",7,7)=""
^XWB(8994,2736,2,"PARAMSEQ",8,8)=""
^XWB(8994,2736,2,"PARAMSEQ",9,9)=""
^XWB(8994,2736,3,0)="^8994.03^24^24^3080222^^"
^XWB(8994,2736,3,1,0)="A negative value of the first '^'-piece of the Results[0] indicates that"
^XWB(8994,2736,3,2,0)="an error occurred during the execution of the remote procedure. In this"
^XWB(8994,2736,3,3,0)="case, the second piece of the Results[0] will contain number of the error"
^XWB(8994,2736,3,4,0)="descriptors returned in the subsequent nodes of the Results array."
^XWB(8994,2736,3,5,0)=" "
^XWB(8994,2736,3,6,0)="  Results[0]            Result descriptor"
^XWB(8994,2736,3,7,0)="                          ^01: The last error code"
^XWB(8994,2736,3,8,0)="                          ^02: Number of error descriptors"
^XWB(8994,2736,3,9,0)="  "
^XWB(8994,2736,3,10,0)="  Results[i]            Error descriptor"
^XWB(8994,2736,3,11,0)="                          ^01: Error code"
^XWB(8994,2736,3,12,0)="                          ^02: Message"
^XWB(8994,2736,3,13,0)="                          ^03: Error location"
^XWB(8994,2736,3,14,0)="                          ^04: Error type"
^XWB(8994,2736,3,15,0)="  "
^XWB(8994,2736,3,16,0)="  Results[j]            Line of the additional info"
^XWB(8994,2736,3,17,0)="                          ^01: """" (empty)"
^XWB(8994,2736,3,18,0)="                          ^02: Text"
^XWB(8994,2736,3,19,0)=" "
^XWB(8994,2736,3,20,0)="Error descriptors are returned in reverse chronological order (most recent"
^XWB(8994,2736,3,21,0)="first)."
^XWB(8994,2736,3,22,0)=" "
^XWB(8994,2736,3,23,0)="Otherwise, the Results[0] contains IEN of the new order in the RAD/NUC MED"
^XWB(8994,2736,3,24,0)="ORDERS file (#75.1)."
^XWB(8994,2737,0)="RAMAG EXAM REGISTER^REGISTER^RAMAGRP1^2^A^^^1"
^XWB(8994,2737,1,0)="^8994.01^3^3^3090224^^^^"
^XWB(8994,2737,1,1,0)="The RAMAG EXAM REGISTER remote procedure registers the exam and returns"
^XWB(8994,2737,1,2,0)="identifiers of the new case(s) in the RAD/NUC MED PATIENT file (#70). It"
^XWB(8994,2737,1,3,0)="also sends all required notifications."
^XWB(8994,2737,2,0)="^8994.02A^3^3"
^XWB(8994,2737,2,1,0)="RAOIFN^1^^1^1"
^XWB(8994,2737,2,1,1,0)="^8994.021^1^1^3070621^^"
^XWB(8994,2737,2,1,1,1,0)="IEN of the order in the RAD/NUC MED ORDERS file (#75.1)."
^XWB(8994,2737,2,2,0)="EXMDTE^1^^1^2"
^XWB(8994,2737,2,2,1,0)="^^3^3^3090224^"
^XWB(8994,2737,2,2,1,1,0)="Date and time of the exam in HL7 format (TS): YYYYMMDDHHMM[+/-ZZZZ]. If "
^XWB(8994,2737,2,2,1,2,0)="seconds are provided, they are ignored. The date must be exact and the "
^XWB(8994,2737,2,2,1,3,0)="time is required."
^XWB(8994,2737,2,3,0)="RAMSC^2^^^3"
^XWB(8994,2737,2,3,1,0)="^8994.021^83^83^3080606^^^"
^XWB(8994,2737,2,3,1,1,0)="Items of this list define miscellaneous/optional exam parameters. Each"
^XWB(8994,2737,2,3,1,2,0)="record has 3 or more pieces separated by '^':"
^XWB(8994,2737,2,3,1,3,0)=" "
^XWB(8994,2737,2,3,1,4,0)="  ^01: Parameter name"
^XWB(8994,2737,2,3,1,5,0)="  ^02: Index (for multiples and word-processing values)"
^XWB(8994,2737,2,3,1,6,0)="  ^03: Value1"
^XWB(8994,2737,2,3,1,7,0)="  ^04: Value2"
^XWB(8994,2737,2,3,1,8,0)="  ..."
^XWB(8994,2737,2,3,1,9,0)=" "
^XWB(8994,2737,2,3,1,10,0)="The following parameters are supported by this remote procedure:"
^XWB(8994,2737,2,3,1,11,0)=" "
^XWB(8994,2737,2,3,1,12,0)="  BEDSECT^^{IEN #42.4}"
^XWB(8994,2737,2,3,1,13,0)="    Internal value for the BEDSECTION field (19) of"
^XWB(8994,2737,2,3,1,14,0)="    the EXAMINATIONS multiple (sub-file #70.03)."
^XWB(8994,2737,2,3,1,15,0)=" "
^XWB(8994,2737,2,3,1,16,0)="  EXAMCAT^^{C|E|I|O|R|S}"
^XWB(8994,2737,2,3,1,17,0)="    Value for the CATEGORY OF EXAM field (4) of the"
^XWB(8994,2737,2,3,1,18,0)="    EXAMINATIONS multiple (sub-file #70.03)."
^XWB(8994,2737,2,3,1,19,0)=" "
^XWB(8994,2737,2,3,1,20,0)="  FLAGS^^{flags}"
^XWB(8994,2737,2,3,1,21,0)="    Flags that control the execution (can be combined):"
^XWB(8994,2737,2,3,1,22,0)=" "
^XWB(8994,2737,2,3,1,23,0)="    A  If this flag is provided, then the registration "
^XWB(8994,2737,2,3,1,24,0)="       entry point adds the new case to the existing"
^XWB(8994,2737,2,3,1,25,0)="       ones with the same date/time instead of "
^XWB(8994,2737,2,3,1,26,0)="       returning the error code -28."
^XWB(8994,2737,2,3,1,27,0)=" "
^XWB(8994,2737,2,3,1,28,0)="       If the existing date/time record stores an exam "
^XWB(8994,2737,2,3,1,29,0)="       set and the ""D"" flag is not provided, then the"
^XWB(8994,2737,2,3,1,30,0)="       error code -54 is returned."
^XWB(8994,2737,2,3,1,31,0)=" "
^XWB(8994,2737,2,3,1,32,0)="    D  If there is an existing case with the same "
^XWB(8994,2737,2,3,1,33,0)="       date/time, then the time of the new case is"
^XWB(8994,2737,2,3,1,34,0)="       incremented by 1 minute until an unused date/time"
^XWB(8994,2737,2,3,1,35,0)="       is found."
^XWB(8994,2737,2,3,1,36,0)=" "
^XWB(8994,2737,2,3,1,37,0)="       If the ""A"" flag is also provided, then time "
^XWB(8994,2737,2,3,1,38,0)="       increments also stop when a non-examset"
^XWB(8994,2737,2,3,1,39,0)="       date/time record is found."
^XWB(8994,2737,2,3,1,40,0)=" "
^XWB(8994,2737,2,3,1,41,0)="       If the date is also changed during the time "
^XWB(8994,2737,2,3,1,42,0)="       modification, then the case is not registered and"
^XWB(8994,2737,2,3,1,43,0)="       the error code -29 is returned."
^XWB(8994,2737,2,3,1,44,0)=" "
^XWB(8994,2737,2,3,1,45,0)="  PRINCLIN^^{IEN #44}"
^XWB(8994,2737,2,3,1,46,0)="    Internal value for the PRINCIPAL CLINIC field (8) of"
^XWB(8994,2737,2,3,1,47,0)="    the EXAMINATIONS multiple (sub-file #70.03)."
^XWB(8994,2737,2,3,1,48,0)=" "
^XWB(8994,2737,2,3,1,49,0)="  RAPROC^{Seq#}^{IEN #71}^{IEN #71.2}^{IEN #71.2}^..."
^XWB(8994,2737,2,3,1,50,0)="    Radiology procedure and optional modifiers."
^XWB(8994,2737,2,3,1,51,0)=" "
^XWB(8994,2737,2,3,1,52,0)="  SERVICE^^{IEN #49}"
^XWB(8994,2737,2,3,1,53,0)="    Internal value for the SERVICE field (7) of"
^XWB(8994,2737,2,3,1,54,0)="    the EXAMINATIONS multiple (sub-file #70.03)."
^XWB(8994,2737,2,3,1,55,0)=" "
^XWB(8994,2737,2,3,1,56,0)="  SINGLERPT^^{0|1}"
^XWB(8994,2737,2,3,1,57,0)="    If this parameter is defined and not 0, then all"
^XWB(8994,2737,2,3,1,58,0)="    cases should be associated with the same order"
^XWB(8994,2737,2,3,1,59,0)="    and they will share the same report. See the"
^XWB(8994,2737,2,3,1,60,0)="    MEMBER OF SET (25) and IMAGING ORDER (11) fields"
^XWB(8994,2737,2,3,1,61,0)="    of the sub-file #70.03 for more details."
^XWB(8994,2737,2,3,1,62,0)=" "
^XWB(8994,2737,2,3,1,63,0)="  TECHCOMM^^{text}"
^XWB(8994,2737,2,3,1,64,0)="    Value for the TECHNOLOGIST COMMENT field (4) of the"
^XWB(8994,2737,2,3,1,65,0)="    ACTIVITY LOG multiple (sub-file #70.07). "
^XWB(8994,2737,2,3,1,66,0)=" "
^XWB(8994,2737,2,3,1,67,0)="  WARD^^{IEN #42}"
^XWB(8994,2737,2,3,1,68,0)="    Internal value for the WARD field (6) of"
^XWB(8994,2737,2,3,1,69,0)="    the EXAMINATIONS multiple (sub-file #70.03)."
^XWB(8994,2737,2,3,1,70,0)=" "
^XWB(8994,2737,2,3,1,71,0)="Records can be added to the list in any order. See the comments preceding"
^XWB(8994,2737,2,3,1,72,0)="the $$REGISTER^RAMAG03 for more details."
^XWB(8994,2737,2,3,1,73,0)=" "
^XWB(8994,2737,2,3,1,74,0)="Example:"
^XWB(8994,2737,2,3,1,75,0)=" "
^XWB(8994,2737,2,3,1,76,0)="  with RPCBroker.Param[2] do"
^XWB(8994,2737,2,3,1,77,0)="    begin"
^XWB(8994,2737,2,3,1,78,0)="      PType := list;"
^XWB(8994,2737,2,3,1,79,0)="      Mult[1] := 'BEDSECT^^12';"
^XWB(8994,2737,2,3,1,80,0)="      Mult[2] := 'SERVICE^^43';"
^XWB(8994,2737,2,3,1,81,0)="      Mult[3] := 'WARD^^456';"
^XWB(8994,2737,2,3,1,82,0)="      Mult[4] := 'EXAMCAT^^I';"
^XWB(8994,2737,2,3,1,83,0)="    end;"
^XWB(8994,2737,2,"B","EXMDTE",2)=""
^XWB(8994,2737,2,"B","RAMSC",3)=""
^XWB(8994,2737,2,"B","RAOIFN",1)=""
^XWB(8994,2737,2,"PARAMSEQ",1,1)=""
^XWB(8994,2737,2,"PARAMSEQ",2,2)=""
^XWB(8994,2737,2,"PARAMSEQ",3,3)=""
^XWB(8994,2737,3,0)="^8994.03^39^39^3090224^^"
^XWB(8994,2737,3,1,0)="A negative value of the first '^'-piece of the Results[0] indicates that"
^XWB(8994,2737,3,2,0)="an error occurred during the execution of the remote procedure. In this"
^XWB(8994,2737,3,3,0)="case, the second piece of the Results[0] will contain number of the error"
^XWB(8994,2737,3,4,0)="descriptors returned in the subsequent nodes of the Results array."
^XWB(8994,2737,3,5,0)=" "
^XWB(8994,2737,3,6,0)="  Results[0]            Result descriptor"
^XWB(8994,2737,3,7,0)="                          ^01: The last error code"
^XWB(8994,2737,3,8,0)="                          ^02: Number of error descriptors"
^XWB(8994,2737,3,9,0)="  "
^XWB(8994,2737,3,10,0)="  Results[i]            Error descriptor"
^XWB(8994,2737,3,11,0)="                          ^01: Error code"
^XWB(8994,2737,3,12,0)="                          ^02: Message"
^XWB(8994,2737,3,13,0)="                          ^03: Error location"
^XWB(8994,2737,3,14,0)="                          ^04: Error type"
^XWB(8994,2737,3,15,0)="  "
^XWB(8994,2737,3,16,0)="  Results[j]            Line of the additional info"
^XWB(8994,2737,3,17,0)="                          ^01: """" (empty)"
^XWB(8994,2737,3,18,0)="                          ^02: Text"
^XWB(8994,2737,3,19,0)=" "
^XWB(8994,2737,3,20,0)="Error descriptors are returned in reverse chronological order (most recent"
^XWB(8994,2737,3,21,0)="first)."
^XWB(8994,2737,3,22,0)=" "
^XWB(8994,2737,3,23,0)="Otherwise, number of registered examinations is returned in the Results[0]"
^XWB(8994,2737,3,24,0)="and identifiers of the examinations are returned in the subsequent"
^XWB(8994,2737,3,25,0)="elements of the array. "
^XWB(8994,2737,3,26,0)=" "
^XWB(8994,2737,3,27,0)="  Results[0]            Number of registered examinations "
^XWB(8994,2737,3,28,0)=" "
^XWB(8994,2737,3,29,0)="  Results[i]            Exam/case identifiers"
^XWB(8994,2737,3,30,0)="                          ^01: IEN of the patient in the file #70"
^XWB(8994,2737,3,31,0)="                          ^02: IEN in the REGISTERED EXAMS multiple"
^XWB(8994,2737,3,32,0)="                          ^03: IEN in the EXAMINATIONS multiple"
^XWB(8994,2737,3,33,0)="                          ^04: Case number"
^XWB(8994,2737,3,34,0)="                          ^05: Accession number"
^XWB(8994,2737,3,35,0)="                                SSS-MMDDYY-NNNNN  if RA*5*47 is installed;"
^XWB(8994,2737,3,36,0)="                                    MMDDYY-NNNNN  otherwise."
^XWB(8994,2737,3,37,0)="                          ^06: Actual date and time of the case (value of"
^XWB(8994,2737,3,38,0)="                               the EXAM DATE field) in HL7 format (TS):"
^XWB(8994,2737,3,39,0)="                               YYYYMMDD[HHMM[+/-ZZZZ]]"
^XWB(8994,2738,0)="RAMAG ORDER CANCEL^ORDCANC^RAMAGRP1^2^A^^^1"
^XWB(8994,2738,1,0)="^8994.01^6^6^3080404^^^^"
^XWB(8994,2738,1,1,0)="The RAMAG ORDER CANCEL remote procedure cancels/holds the Radiology order"
^XWB(8994,2738,1,2,0)="and sends all required notifications."
^XWB(8994,2738,1,3,0)=" "
^XWB(8994,2738,1,4,0)="NOTE: If there are active cases in the RAD/NUC MED PATIENT file (#70)"
^XWB(8994,2738,1,5,0)="      associated with an order, this remote procedure neither cancels"
^XWB(8994,2738,1,6,0)="      nor holds the order and returns the error code -42."
^XWB(8994,2738,2,0)="^8994.02A^3^3"
^XWB(8994,2738,2,1,0)="RAOIFN^1^^1^1"
^XWB(8994,2738,2,1,1,0)="^^1^1^3070516^"
^XWB(8994,2738,2,1,1,1,0)="IEN of the order in the RAD/NUC MED ORDERS file (#75.1)."
^XWB(8994,2738,2,2,0)="RAREASON^1^^1^2"
^XWB(8994,2738,2,2,1,0)="^^19^19^3070621^"
^XWB(8994,2738,2,2,1,1,0)="Cancel/hold reason: either IEN of a record of the RAD/NUC MED REASON file"
^XWB(8994,2738,2,2,1,2,0)="(#75.2) or a valid synonym (see SYNONYM field (3) of that file)."
^XWB(8994,2738,2,2,1,3,0)=" "
^XWB(8994,2738,2,2,1,4,0)="The referenced record must have the appropriate type (see TYPE OF REASON"
^XWB(8994,2738,2,2,1,5,0)="field (2) of the file #75.2):"
^XWB(8994,2738,2,2,1,6,0)=" "
^XWB(8994,2738,2,2,1,7,0)=" * If the reason record has the CANCEL REQUEST (1) type,"
^XWB(8994,2738,2,2,1,8,0)="   then the 'HOLDESC' (see the RAMSC parameter) is ignored"
^XWB(8994,2738,2,2,1,9,0)="   and the order is canceled."
^XWB(8994,2738,2,2,1,10,0)=" "
^XWB(8994,2738,2,2,1,11,0)=" * If the reason record is of the HOLD REQUEST (3) type,"
^XWB(8994,2738,2,2,1,12,0)="   then the order is put on hold. If the 'HOLDESC' parameter"
^XWB(8994,2738,2,2,1,13,0)="   is defined, the text is stored into the HOLD DESCRIPTION"
^XWB(8994,2738,2,2,1,14,0)="   field."
^XWB(8994,2738,2,2,1,15,0)=" "
^XWB(8994,2738,2,2,1,16,0)=" * If the record is of the GENERAL REQUEST  type (9), then"
^XWB(8994,2738,2,2,1,17,0)="   the new order status is determined by the 'HOLDESC'"
^XWB(8994,2738,2,2,1,18,0)="   parameter. If it is defined, then the order is put on"
^XWB(8994,2738,2,2,1,19,0)="   hold; otherwise, the order is canceled."
^XWB(8994,2738,2,3,0)="RAMSC^2^^^3"
^XWB(8994,2738,2,3,1,0)="^^26^26^3080404^"
^XWB(8994,2738,2,3,1,1,0)="Items of this list define miscellaneous/optional parameters. Each record"
^XWB(8994,2738,2,3,1,2,0)="has 3 or more pieces separated by '^':"
^XWB(8994,2738,2,3,1,3,0)=" "
^XWB(8994,2738,2,3,1,4,0)="  ^01: Parameter name"
^XWB(8994,2738,2,3,1,5,0)="  ^02: Index (for multiples and word-processing values)"
^XWB(8994,2738,2,3,1,6,0)="  ^03: Value1"
^XWB(8994,2738,2,3,1,7,0)="  ^04: Value2"
^XWB(8994,2738,2,3,1,8,0)="  ..."
^XWB(8994,2738,2,3,1,9,0)=" "
^XWB(8994,2738,2,3,1,10,0)="The following parameters are supported by this remote procedure:"
^XWB(8994,2738,2,3,1,11,0)="  "
^XWB(8994,2738,2,3,1,12,0)="  HOLDESC^{Seq#}^{Line of hold description}"
^XWB(8994,2738,2,3,1,13,0)="    Text for the HOLD DESCRIPTION field (25)"
^XWB(8994,2738,2,3,1,14,0)="    of the file #75.1."
^XWB(8994,2738,2,3,1,15,0)=" "
^XWB(8994,2738,2,3,1,16,0)="Records can be added to the list in any order. See the comments preceding"
^XWB(8994,2738,2,3,1,17,0)="the $$ORDCANC^RAMAG04 for more details."
^XWB(8994,2738,2,3,1,18,0)=" "
^XWB(8994,2738,2,3,1,19,0)="Examples:"
^XWB(8994,2738,2,3,1,20,0)=" "
^XWB(8994,2738,2,3,1,21,0)="  with RPCBroker.Param[2] do"
^XWB(8994,2738,2,3,1,22,0)="    begin"
^XWB(8994,2738,2,3,1,23,0)="      PType := list;"
^XWB(8994,2738,2,3,1,24,0)="      Mult[1] := 'HOLDESC^1^Hold description line #1';"
^XWB(8994,2738,2,3,1,25,0)="      Mult[2] := 'HOLDESC^2^Hold description line #2';"
^XWB(8994,2738,2,3,1,26,0)="    end;"
^XWB(8994,2738,2,"B","RAMSC",3)=""
^XWB(8994,2738,2,"B","RAOIFN",1)=""
^XWB(8994,2738,2,"B","RAREASON",2)=""
^XWB(8994,2738,2,"PARAMSEQ",1,1)=""
^XWB(8994,2738,2,"PARAMSEQ",2,2)=""
^XWB(8994,2738,2,"PARAMSEQ",3,3)=""
^XWB(8994,2738,3,0)="^8994.03^23^23^3080404^^"
^XWB(8994,2738,3,1,0)="A negative value of the first '^'-piece of the Results[0] indicates that"
^XWB(8994,2738,3,2,0)="an error occurred during the execution of the remote procedure. In this"
^XWB(8994,2738,3,3,0)="case, the second piece of the Results[0] will contain number of the error"
^XWB(8994,2738,3,4,0)="descriptors returned in the subsequent nodes of the Results array."
^XWB(8994,2738,3,5,0)=" "
^XWB(8994,2738,3,6,0)="  Results[0]            Result descriptor"
^XWB(8994,2738,3,7,0)="                          ^01: The last error code"
^XWB(8994,2738,3,8,0)="                          ^02: Number of error descriptors"
^XWB(8994,2738,3,9,0)="  "
^XWB(8994,2738,3,10,0)="  Results[i]            Error descriptor"
^XWB(8994,2738,3,11,0)="                          ^01: Error code"
^XWB(8994,2738,3,12,0)="                          ^02: Message"
^XWB(8994,2738,3,13,0)="                          ^03: Error location"
^XWB(8994,2738,3,14,0)="                          ^04: Error type"
^XWB(8994,2738,3,15,0)="  "
^XWB(8994,2738,3,16,0)="  Results[j]            Line of the additional info"
^XWB(8994,2738,3,17,0)="                          ^01: """" (empty)"
^XWB(8994,2738,3,18,0)="                          ^02: Text"
^XWB(8994,2738,3,19,0)=" "
^XWB(8994,2738,3,20,0)="Error descriptors are returned in reverse chronological order (most recent"
^XWB(8994,2738,3,21,0)="first)."
^XWB(8994,2738,3,22,0)=" "
^XWB(8994,2738,3,23,0)="Otherwise, 0 is returned in the Results[0]."
^XWB(8994,2739,0)="RAMAG EXAM CANCEL^EXAMCANC^RAMAGRP1^2^A^^^1"
^XWB(8994,2739,1,0)="^8994.01^6^6^3080404^^^^"
^XWB(8994,2739,1,1,0)="The RAMAG EXAM CANCEL remote procedure cancels the Radiology exam(s) and"
^XWB(8994,2739,1,2,0)="sends all required notifications."
^XWB(8994,2739,1,3,0)=" "
^XWB(8994,2739,1,4,0)="If all exams that reference the same order/request are canceled, this  "
^XWB(8994,2739,1,5,0)="function can also cancel/hold the order (if the appropriate parameters are"
^XWB(8994,2739,1,6,0)="provided)."
^XWB(8994,2739,2,0)="^8994.02A^4^4"
^XWB(8994,2739,2,1,0)="RAEXAM^1^^1^1"
^XWB(8994,2739,2,1,1,0)="^^4^4^3070621^"
^XWB(8994,2739,2,1,1,1,0)="String of exam/case identifiers separated by '^':"
^XWB(8994,2739,2,1,1,2,0)="  ^01: IEN of the patient in the RAD/NUC MED PATIENT file (#70)"
^XWB(8994,2739,2,1,1,3,0)="  ^02: IEN in the REGISTERED EXAMS multiple (sub-file #70.02)"
^XWB(8994,2739,2,1,1,4,0)="  ^03: IEN in the EXAMINATIONS multiple (sub-file #70.03)"
^XWB(8994,2739,2,2,0)="RAREASON^1^^1^2"
^XWB(8994,2739,2,2,1,0)="^8994.021^4^4^3070621^^^"
^XWB(8994,2739,2,2,1,1,0)="Reason for cancelation: either IEN of a record of the RAD/NUC MED REASON"
^XWB(8994,2739,2,2,1,2,0)="file (#75.2) or a valid synonym (see SYNONYM field (3) of the file #75.2)."
^XWB(8994,2739,2,2,1,3,0)="The referenced record must have the 'CANCEL REQUEST' or 'GENERAL REQUEST'"
^XWB(8994,2739,2,2,1,4,0)="type (see TYPE OF REASON field (2) of the file #75.2)."
^XWB(8994,2739,2,3,0)="RAMSC^2^^^4"
^XWB(8994,2739,2,3,1,0)="^^55^55^3080404^"
^XWB(8994,2739,2,3,1,1,0)="Items of this list define miscellaneous/optional parameters. Each record"
^XWB(8994,2739,2,3,1,2,0)="has 3 or more pieces separated by '^':"
^XWB(8994,2739,2,3,1,3,0)=" "
^XWB(8994,2739,2,3,1,4,0)="  ^01: Parameter name"
^XWB(8994,2739,2,3,1,5,0)="  ^02: Index (for multiples and word-processing values)"
^XWB(8994,2739,2,3,1,6,0)="  ^03: Value1"
^XWB(8994,2739,2,3,1,7,0)="  ^04: Value2"
^XWB(8994,2739,2,3,1,8,0)="  ..."
^XWB(8994,2739,2,3,1,9,0)=" "
^XWB(8994,2739,2,3,1,10,0)="The following parameters are supported by this remote procedure:"
^XWB(8994,2739,2,3,1,11,0)="  "
^XWB(8994,2739,2,3,1,12,0)="  HOLDESC^{Seq#}^{Line of hold description}"
^XWB(8994,2739,2,3,1,13,0)="    Text for the HOLD DESCRIPTION field (25)"
^XWB(8994,2739,2,3,1,14,0)="    of the file #75.1."
^XWB(8994,2739,2,3,1,15,0)=" "
^XWB(8994,2739,2,3,1,16,0)="  ORDRSN^^{Cancel/hold reason for related order}"
^XWB(8994,2739,2,3,1,17,0)="    Either IEN of a record of the RAD/NUC MED"
^XWB(8994,2739,2,3,1,18,0)="    REASON file (#75.2) or a valid synonym "
^XWB(8994,2739,2,3,1,19,0)="    (see SYNONYM field (3) of that file)."
^XWB(8994,2739,2,3,1,20,0)=" "
^XWB(8994,2739,2,3,1,21,0)="    If this parameter is not defined or empty,"
^XWB(8994,2739,2,3,1,22,0)="    the value of the RAREASON parameter is"
^XWB(8994,2739,2,3,1,23,0)="    assumed."
^XWB(8994,2739,2,3,1,24,0)=" "
^XWB(8994,2739,2,3,1,25,0)="Records can be added to the list in any order. See the comments preceding"
^XWB(8994,2739,2,3,1,26,0)="the $$EXAMCANC^RAMAG05 for more details."
^XWB(8994,2739,2,3,1,27,0)=" "
^XWB(8994,2739,2,3,1,28,0)="If the RAFLAGS parameter contains the 'O' flag, the 'ORDRSN' and 'HOLDESC'"
^XWB(8994,2739,2,3,1,29,0)="parameters determine whether the related order is canceled or put on hold."
^XWB(8994,2739,2,3,1,30,0)="Otherwise, they are ignored."
^XWB(8994,2739,2,3,1,31,0)=" "
^XWB(8994,2739,2,3,1,32,0)=" * If the reason record referenced by the 'ORDRSN'"
^XWB(8994,2739,2,3,1,33,0)="   has the CANCEL REQUEST (1) type, then the 'HOLDESC'"
^XWB(8994,2739,2,3,1,34,0)="   is ignored and the order is canceled."
^XWB(8994,2739,2,3,1,35,0)=" "
^XWB(8994,2739,2,3,1,36,0)=" * If the record referenced by the 'ORDRSN' is of"
^XWB(8994,2739,2,3,1,37,0)="   the HOLD REQUEST (3) type, then the order is put"
^XWB(8994,2739,2,3,1,38,0)="   on hold. If the 'HOLDESC' is defined, the text is"
^XWB(8994,2739,2,3,1,39,0)="   stored into the HOLD DESCRIPTION field."
^XWB(8994,2739,2,3,1,40,0)=" "
^XWB(8994,2739,2,3,1,41,0)=" * If the record referenced by the 'ORDRSN' is of"
^XWB(8994,2739,2,3,1,42,0)="   the GENERAL REQUEST type (9), then the action"
^XWB(8994,2739,2,3,1,43,0)="   performed on the order is determined by the"
^XWB(8994,2739,2,3,1,44,0)="   'HOLDESC'. If it is defined, then the order is"
^XWB(8994,2739,2,3,1,45,0)="   put hold; otherwise, the order is canceled."
^XWB(8994,2739,2,3,1,46,0)=" "
^XWB(8994,2739,2,3,1,47,0)="Examples:"
^XWB(8994,2739,2,3,1,48,0)=" "
^XWB(8994,2739,2,3,1,49,0)="  with RPCBroker.Param[2] do"
^XWB(8994,2739,2,3,1,50,0)="    begin"
^XWB(8994,2739,2,3,1,51,0)="      PType := list;"
^XWB(8994,2739,2,3,1,52,0)="      Mult[1] := 'ORDRSN^^OHR';"
^XWB(8994,2739,2,3,1,53,0)="      Mult[2] := 'HOLDESC^1^Hold description line #1';"
^XWB(8994,2739,2,3,1,54,0)="      Mult[3] := 'HOLDESC^2^Hold description line #2';"
^XWB(8994,2739,2,3,1,55,0)="    end;"
^XWB(8994,2739,2,4,0)="RAFLAGS^1^^^3"
^XWB(8994,2739,2,4,1,0)="^8994.021^15^15^3080404^^^"
^XWB(8994,2739,2,4,1,1,0)="Flags that control execution (can be combined):"
^XWB(8994,2739,2,4,1,2,0)=" "
^XWB(8994,2739,2,4,1,3,0)="  A  Cancel all related exams/cases (those that"
^XWB(8994,2739,2,4,1,4,0)="     reference the same order)."
^XWB(8994,2739,2,4,1,5,0)=" "
^XWB(8994,2739,2,4,1,6,0)="  O  Cancel/hold the related order after successful"
^XWB(8994,2739,2,4,1,7,0)="     exam cancelation."
^XWB(8994,2739,2,4,1,8,0)=" "
^XWB(8994,2739,2,4,1,9,0)="     The order will be canceled or put on hold only"
^XWB(8994,2739,2,4,1,10,0)="     if there are no more active cases associated"
^XWB(8994,2739,2,4,1,11,0)="     with it."
^XWB(8994,2739,2,4,1,12,0)=" "
^XWB(8994,2739,2,4,1,13,0)="     Otherwise, the error code -42 will be returned."
^XWB(8994,2739,2,4,1,14,0)="     Use the ""A"" flag to cancel all related exams"
^XWB(8994,2739,2,4,1,15,0)="     and guarantee the order cancelation."
^XWB(8994,2739,2,"B","RAEXAM",1)=""
^XWB(8994,2739,2,"B","RAFLAGS",4)=""
^XWB(8994,2739,2,"B","RAMSC",3)=""
^XWB(8994,2739,2,"B","RAREASON",2)=""
^XWB(8994,2739,2,"PARAMSEQ",1,1)=""
^XWB(8994,2739,2,"PARAMSEQ",2,2)=""
^XWB(8994,2739,2,"PARAMSEQ",3,4)=""
^XWB(8994,2739,2,"PARAMSEQ",4,3)=""
^XWB(8994,2739,3,0)="^^23^23^3080221^"
^XWB(8994,2739,3,1,0)="A negative value of the first '^'-piece of the Results[0] indicates that"
^XWB(8994,2739,3,2,0)="an error occurred during the execution of the remote procedure. In this"
^XWB(8994,2739,3,3,0)="case, the second piece of the Results[0] will contain number of the error"
^XWB(8994,2739,3,4,0)="descriptors returned in the subsequent nodes of the Results array."
^XWB(8994,2739,3,5,0)=" "
^XWB(8994,2739,3,6,0)="  Results[0]            Result descriptor"
^XWB(8994,2739,3,7,0)="                          ^01: The last error code"
^XWB(8994,2739,3,8,0)="                          ^02: Number of error descriptors"
^XWB(8994,2739,3,9,0)="  "
^XWB(8994,2739,3,10,0)="  Results[i]            Error descriptor"
^XWB(8994,2739,3,11,0)="                          ^01: Error code"
^XWB(8994,2739,3,12,0)="                          ^02: Message"
^XWB(8994,2739,3,13,0)="                          ^03: Error location"
^XWB(8994,2739,3,14,0)="                          ^04: Error type"
^XWB(8994,2739,3,15,0)="  "
^XWB(8994,2739,3,16,0)="  Results[j]            Line of the additional info"
^XWB(8994,2739,3,17,0)="                          ^01: """" (empty)"
^XWB(8994,2739,3,18,0)="                          ^02: Text"
^XWB(8994,2739,3,19,0)=" "
^XWB(8994,2739,3,20,0)="Error descriptors are returned in reverse chronological order (most recent"
^XWB(8994,2739,3,21,0)="first)."
^XWB(8994,2739,3,22,0)=" "
^XWB(8994,2739,3,23,0)="Otherwise, 0 is returned in the Results[0]."
^XWB(8994,2740,0)="RAMAG EXAM COMPLETE^COMPLETE^RAMAGRP1^2^A^^^1"
^XWB(8994,2740,1,0)="^8994.01^3^3^3130619^^^"
^XWB(8994,2740,1,1,0)="The RAMAG EXAM COMPLETE remote procedure completes the exam. It also sends"
^XWB(8994,2740,1,2,0)="required HL7 messages, sends changed order control ""XX"" to CPRS, but does"
^XWB(8994,2740,1,3,0)="not send VistA alerts regarding the exam status change."
^XWB(8994,2740,2,0)="^8994.02A^5^2"
^XWB(8994,2740,2,1,0)="RAEXAM^1^^1^1"
^XWB(8994,2740,2,1,1,0)="^8994.021^4^4^3080116^^^^"
^XWB(8994,2740,2,1,1,1,0)="String of exam/case identifiers separated by '^':"
^XWB(8994,2740,2,1,1,2,0)="  ^01: IEN of the patient in the RAD/NUC MED PATIENT file (#70)"
^XWB(8994,2740,2,1,1,3,0)="  ^02: IEN in the REGISTERED EXAMS multiple (sub-file #70.02)"
^XWB(8994,2740,2,1,1,4,0)="  ^03: IEN in the EXAMINATIONS multiple (sub-file #70.03)"
^XWB(8994,2740,2,5,0)="RAMSC^2^^^2"
^XWB(8994,2740,2,5,1,0)="^^92^92^3130619^"
^XWB(8994,2740,2,5,1,1,0)="Items of this list define miscellaneous/optional exam and/or report"
^XWB(8994,2740,2,5,1,2,0)="parameters. Each record has 3 or more pieces separated by '^':"
^XWB(8994,2740,2,5,1,3,0)=" "
^XWB(8994,2740,2,5,1,4,0)="  ^01: Parameter name"
^XWB(8994,2740,2,5,1,5,0)="  ^02: Index (for multiples and word-processing values)"
^XWB(8994,2740,2,5,1,6,0)="  ^03: Value1"
^XWB(8994,2740,2,5,1,7,0)="  ^04: Value2"
^XWB(8994,2740,2,5,1,8,0)="  ..."
^XWB(8994,2740,2,5,1,9,0)=" "
^XWB(8994,2740,2,5,1,10,0)="The following parameters are supported by this remote procedure:"
^XWB(8994,2740,2,5,1,11,0)=" "
^XWB(8994,2740,2,5,1,12,0)="  ACLHIST^{Seq#}^{Line of clinical history}"
^XWB(8994,2740,2,5,1,13,0)="    Text for the ADDITIONAL CLINICAL HISTORY field"
^XWB(8994,2740,2,5,1,14,0)="    (400) of the RAD/NUC MED REPORTS file (#74)."
^XWB(8994,2740,2,5,1,15,0)=" "
^XWB(8994,2740,2,5,1,16,0)="  FLAGS^^{flags}"
^XWB(8994,2740,2,5,1,17,0)="    Flags that control the execution (can be combined):"
^XWB(8994,2740,2,5,1,18,0)=" "
^XWB(8994,2740,2,5,1,19,0)="    F  Try to enforce the new status even if some "
^XWB(8994,2740,2,5,1,20,0)="       required fields are not populated."
^XWB(8994,2740,2,5,1,21,0)=" "
^XWB(8994,2740,2,5,1,22,0)="    S  Do not send HL7 message to speech recognition"
^XWB(8994,2740,2,5,1,23,0)="       (dictation) systems"
^XWB(8994,2740,2,5,1,24,0)=" "
^XWB(8994,2740,2,5,1,25,0)="  IMPRESSION^{Seq#}^{Line of impression text}"
^XWB(8994,2740,2,5,1,26,0)="    Text for the IMPRESSION TEXT field (300)"
^XWB(8994,2740,2,5,1,27,0)="    of the file #74."
^XWB(8994,2740,2,5,1,28,0)=" "
^XWB(8994,2740,2,5,1,29,0)="  PROBSTAT^^{text}"
^XWB(8994,2740,2,5,1,30,0)="    Value for the PROBLEM STATEMENT field (25)"
^XWB(8994,2740,2,5,1,31,0)="    of the file #74."
^XWB(8994,2740,2,5,1,32,0)=" "
^XWB(8994,2740,2,5,1,33,0)="  REPORT^{Seq#}^{Line of report text}"
^XWB(8994,2740,2,5,1,34,0)="    Text for the REPORT TEXT field (200)"
^XWB(8994,2740,2,5,1,35,0)="    of the file #74."
^XWB(8994,2740,2,5,1,36,0)=" "
^XWB(8994,2740,2,5,1,37,0)="  RPTDTE^^{date}"
^XWB(8994,2740,2,5,1,38,0)="    Date in HL7 format (TS) for the REPORTED DATE"
^XWB(8994,2740,2,5,1,39,0)="    field (8) of the file #74: YYYYMMDD. The date"
^XWB(8994,2740,2,5,1,40,0)="    must be exact. If a time part is provided, it"
^XWB(8994,2740,2,5,1,41,0)="    is ignored."
^XWB(8994,2740,2,5,1,42,0)=" "
^XWB(8994,2740,2,5,1,43,0)="  RPTSTATUS^^{status}"
^XWB(8994,2740,2,5,1,44,0)="    Internal value for the REPORT STATUS field (5)"
^XWB(8994,2740,2,5,1,45,0)="    of the file #74. Currently, only ""V"" (Verified)"
^XWB(8994,2740,2,5,1,46,0)="    and ""EF"" (Electronically Filed) codes are "
^XWB(8994,2740,2,5,1,47,0)="    supported."
^XWB(8994,2740,2,5,1,48,0)=" "
^XWB(8994,2740,2,5,1,49,0)="  TRANSCRST^^{IEN #200}"
^XWB(8994,2740,2,5,1,50,0)="    Internal value for the TRANSCRIPTIONIST"
^XWB(8994,2740,2,5,1,51,0)="    field (11) of the file #74: IEN in the NEW"
^XWB(8994,2740,2,5,1,52,0)="    PERSON file (#200)."
^XWB(8994,2740,2,5,1,53,0)=" "
^XWB(8994,2740,2,5,1,54,0)="  VERDTE^^{date}"
^XWB(8994,2740,2,5,1,55,0)="    Date/time in HL7 format (TS) for the"
^XWB(8994,2740,2,5,1,56,0)="    VERIFIED DATE field (7) of the file #74:"
^XWB(8994,2740,2,5,1,57,0)="    YYYYMMDD[HHMM[+/-ZZZZ]]. The date must be"
^XWB(8994,2740,2,5,1,58,0)="    exact."
^XWB(8994,2740,2,5,1,59,0)=" "
^XWB(8994,2740,2,5,1,60,0)="  VERPHYS^^{IEN #200}"
^XWB(8994,2740,2,5,1,61,0)="    Internal value for the VERIFYING PHYSICIAN"
^XWB(8994,2740,2,5,1,62,0)="    field (9) of the file #74: IEN in the NEW"
^XWB(8994,2740,2,5,1,63,0)="    PERSON file (#200)."
^XWB(8994,2740,2,5,1,64,0)=" "
^XWB(8994,2740,2,5,1,65,0)="The following optional parameters are also supported: BEDSECT, CMUSED, "
^XWB(8994,2740,2,5,1,66,0)="COMPLICAT, CONTMEDIA, CPTMODS, EXAMCAT, FILMSIZE, PRIMCAM, PRIMDXCODE,"
^XWB(8994,2740,2,5,1,67,0)="PRIMINTRES, PRIMINTSTF, PRINCLIN, RDPHARMS, RDPH-*, SECDXCODE,"
^XWB(8994,2740,2,5,1,68,0)="SERVICE, TECH, TECHCOMM, and WARD. If any of them are defined, their"
^XWB(8994,2740,2,5,1,69,0)="values replace the existing ones assigned by the RAMAG EXAM REGISTER and"
^XWB(8994,2740,2,5,1,70,0)="RAMAG EXAMINED."
^XWB(8994,2740,2,5,1,71,0)=" "
^XWB(8994,2740,2,5,1,72,0)="Records can be added to the list in any order. See the comments preceding"
^XWB(8994,2740,2,5,1,73,0)="the $$COMPLETE^RAMAG06 for more details."
^XWB(8994,2740,2,5,1,74,0)=" "
^XWB(8994,2740,2,5,1,75,0)="If you want to clear a multiple that already has a value, assign ""@"" or"
^XWB(8994,2740,2,5,1,76,0)="empty string to the parameter itself and do not set any subscripts. For"
^XWB(8994,2740,2,5,1,77,0)="example, the following construction will clear the CONTRAST MEDIA "
^XWB(8994,2740,2,5,1,78,0)="multiple: Mult[i] := 'CONTMEDIA^^@'."
^XWB(8994,2740,2,5,1,79,0)=" "
^XWB(8994,2740,2,5,1,80,0)="Example:"
^XWB(8994,2740,2,5,1,81,0)=" "
^XWB(8994,2740,2,5,1,82,0)="  with RPCBroker.Param[4] do"
^XWB(8994,2740,2,5,1,83,0)="    begin"
^XWB(8994,2740,2,5,1,84,0)="      PType := list;"
^XWB(8994,2740,2,5,1,85,0)="      Mult[1] := 'PRIMDXCODE^^1';"
^XWB(8994,2740,2,5,1,86,0)="      Mult[2] := 'CONTMEDIA^^N';"
^XWB(8994,2740,2,5,1,87,0)="      Mult[3] := 'REPORT^1^Report line #1';"
^XWB(8994,2740,2,5,1,88,0)="      Mult[4] := 'REPORT^2^Report line #2';"
^XWB(8994,2740,2,5,1,89,0)="      Mult[5] := 'IMPRESSION^1^Impression line #1';"
^XWB(8994,2740,2,5,1,90,0)="      Mult[6] := 'FLAGS^^FS';"
^XWB(8994,2740,2,5,1,91,0)="      Mult[7] := 'RPTDTE^^20071215';"
^XWB(8994,2740,2,5,1,92,0)="    end;"
^XWB(8994,2740,2,"B","RAEXAM",1)=""
^XWB(8994,2740,2,"B","RAMSC",5)=""
^XWB(8994,2740,2,"PARAMSEQ",1,1)=""
^XWB(8994,2740,2,"PARAMSEQ",2,5)=""
^XWB(8994,2740,3,0)="^8994.03^23^23^3130619^^^^"
^XWB(8994,2740,3,1,0)="A negative value of the first '^'-piece of the Results[0] indicates that"
^XWB(8994,2740,3,2,0)="an error occurred during the execution of the remote procedure. In this"
^XWB(8994,2740,3,3,0)="case, the second piece of the Results[0] will contain number of the error"
^XWB(8994,2740,3,4,0)="descriptors returned in the subsequent nodes of the Results array."
^XWB(8994,2740,3,5,0)=" "
^XWB(8994,2740,3,6,0)="  Results[0]            Result descriptor"
^XWB(8994,2740,3,7,0)="                          ^01: The last error code"
^XWB(8994,2740,3,8,0)="                          ^02: Number of error descriptors"
^XWB(8994,2740,3,9,0)="  "
^XWB(8994,2740,3,10,0)="  Results[i]            Error descriptor"
^XWB(8994,2740,3,11,0)="                          ^01: Error code"
^XWB(8994,2740,3,12,0)="                          ^02: Message"
^XWB(8994,2740,3,13,0)="                          ^03: Error location"
^XWB(8994,2740,3,14,0)="                          ^04: Error type"
^XWB(8994,2740,3,15,0)="  "
^XWB(8994,2740,3,16,0)="  Results[j]            Line of the additional info"
^XWB(8994,2740,3,17,0)="                          ^01: """" (empty)"
^XWB(8994,2740,3,18,0)="                          ^02: Text"
^XWB(8994,2740,3,19,0)=" "
^XWB(8994,2740,3,20,0)="Error descriptors are returned in reverse chronological order (most recent"
^XWB(8994,2740,3,21,0)="first)."
^XWB(8994,2740,3,22,0)=" "
^XWB(8994,2740,3,23,0)="Otherwise, 0 is returned in the Results[0]."
^XWB(8994,2741,0)="RAMAG EXAMINED^EXAMINED^RAMAGRP2^2^A^^^1"
^XWB(8994,2741,1,0)="^^4^4^3090224^"
^XWB(8994,2741,1,1,0)="The RAMAG EXAMINED remote procedure updates the status of the case (the"
^XWB(8994,2741,1,2,0)="procedure has been performed) and creates the stub report. It also sends"
^XWB(8994,2741,1,3,0)="required HL7 messages, sends changed order control ""XX"" to CPRS, but does"
^XWB(8994,2741,1,4,0)="not send VistA alerts regarding the exam status change."
^XWB(8994,2741,2,0)="^8994.02A^3^2"
^XWB(8994,2741,2,1,0)="RAEXAM^1^^1^1"
^XWB(8994,2741,2,1,1,0)="^8994.021^4^4^3080102^^"
^XWB(8994,2741,2,1,1,1,0)="String of exam/case identifiers separated by '^':"
^XWB(8994,2741,2,1,1,2,0)="  ^01: IEN of the patient in the RAD/NUC MED PATIENT file (#70)"
^XWB(8994,2741,2,1,1,3,0)="  ^02: IEN in the REGISTERED EXAMS multiple (sub-file #70.02)"
^XWB(8994,2741,2,1,1,4,0)="  ^03: IEN in the EXAMINATIONS multiple (sub-file #70.03)"
^XWB(8994,2741,2,3,0)="RAMSC^2^^^2"
^XWB(8994,2741,2,3,1,0)="^^161^161^3080404^"
^XWB(8994,2741,2,3,1,1,0)="Items of this list define miscellaneous/optional exam parameters. Each"
^XWB(8994,2741,2,3,1,2,0)="record has 3 or more pieces separated by '^':"
^XWB(8994,2741,2,3,1,3,0)=" "
^XWB(8994,2741,2,3,1,4,0)="  ^01: Parameter name"
^XWB(8994,2741,2,3,1,5,0)="  ^02: Index (for multiples and word-processing values)"
^XWB(8994,2741,2,3,1,6,0)="  ^03: Value1"
^XWB(8994,2741,2,3,1,7,0)="  ^04: Value2"
^XWB(8994,2741,2,3,1,8,0)="  ..."
^XWB(8994,2741,2,3,1,9,0)=" "
^XWB(8994,2741,2,3,1,10,0)="The following parameters are supported by this remote procedure:"
^XWB(8994,2741,2,3,1,11,0)=" "
^XWB(8994,2741,2,3,1,12,0)="  CMUSED^^{Y|N}"
^XWB(8994,2741,2,3,1,13,0)="    Internal value for the CONTRAST MEDIA USED"
^XWB(8994,2741,2,3,1,14,0)="    field (10) of the sub-file #70.03."
^XWB(8994,2741,2,3,1,15,0)=" "
^XWB(8994,2741,2,3,1,16,0)="  COMPLICAT^^{IEN #78.1}^{text}"
^XWB(8994,2741,2,3,1,17,0)="    Internal values for the COMPLICATION (16)"
^XWB(8994,2741,2,3,1,18,0)="    and COMPLICATION TEXT (16.5) fields of the"
^XWB(8994,2741,2,3,1,19,0)="    sub-file #70.03."
^XWB(8994,2741,2,3,1,20,0)=" "
^XWB(8994,2741,2,3,1,21,0)="  CONTMEDIA^{Seq#}^{I|N|L|C|G|B|M}"
^XWB(8994,2741,2,3,1,22,0)="    Internal value for the CONTRAST MEDIA field (.01)"
^XWB(8994,2741,2,3,1,23,0)="    of the sub-file #70.3225."
^XWB(8994,2741,2,3,1,24,0)=" "
^XWB(8994,2741,2,3,1,25,0)="  CPTMODS^{Seq#}^{IEN #81.3}"
^XWB(8994,2741,2,3,1,26,0)="    Internal value for the CPT MODIFIERS field (.01)"
^XWB(8994,2741,2,3,1,27,0)="    of the sub-file #70.3135: IEN in the CPT MODIFIER"
^XWB(8994,2741,2,3,1,28,0)="    file (#81.3)."
^XWB(8994,2741,2,3,1,29,0)=" "
^XWB(8994,2741,2,3,1,30,0)="  FILMSIZE^{Seq#}^{IEN #78.4}^{amount}"
^XWB(8994,2741,2,3,1,31,0)="    Internal values for the record of the FILM SIZE"
^XWB(8994,2741,2,3,1,32,0)="    multiple (70) of the sub-file #70.03."
^XWB(8994,2741,2,3,1,33,0)=" "
^XWB(8994,2741,2,3,1,34,0)="  FLAGS^^{flags}"
^XWB(8994,2741,2,3,1,35,0)="    Flags that control the execution (can be combined):"
^XWB(8994,2741,2,3,1,36,0)=" "
^XWB(8994,2741,2,3,1,37,0)="    F  Try to enforce the new status even if some "
^XWB(8994,2741,2,3,1,38,0)="       required fields are not populated."
^XWB(8994,2741,2,3,1,39,0)=" "
^XWB(8994,2741,2,3,1,40,0)="    S  Do not send HL7 message to speech recognition"
^XWB(8994,2741,2,3,1,41,0)="       (dictation) systems"
^XWB(8994,2741,2,3,1,42,0)=" "
^XWB(8994,2741,2,3,1,43,0)="  PRIMCAM^^{IEN #78.6}"
^XWB(8994,2741,2,3,1,44,0)="    Internal value for the PRIMARY CAMERA/EQUIP/RM"
^XWB(8994,2741,2,3,1,45,0)="    field (18) of the sub-file #70.03: IEN in the"
^XWB(8994,2741,2,3,1,46,0)="    CAMERA/EQUIP/RM file (#78.6)."
^XWB(8994,2741,2,3,1,47,0)=" "
^XWB(8994,2741,2,3,1,48,0)="  PRIMDXCODE^^{IEN #78.3}"
^XWB(8994,2741,2,3,1,49,0)="    Internal value for the PRIMARY DIAGNOSTIC"
^XWB(8994,2741,2,3,1,50,0)="    CODE field (13) of the sub-file #70.03:"
^XWB(8994,2741,2,3,1,51,0)="    IEN in the DIAGNOSTIC CODES file (#78.3)."
^XWB(8994,2741,2,3,1,52,0)=" "
^XWB(8994,2741,2,3,1,53,0)="  PRIMINTRES^^{IEN #200}"
^XWB(8994,2741,2,3,1,54,0)="    Internal value for the PRIMARY INTERPRETING"
^XWB(8994,2741,2,3,1,55,0)="    RESIDENT field (12) of the sub-file #70.03:"
^XWB(8994,2741,2,3,1,56,0)="    IEN in the NEW PERSON file (#200)."
^XWB(8994,2741,2,3,1,57,0)=" "
^XWB(8994,2741,2,3,1,58,0)="  PRIMINTSTF^^{IEN #200}"
^XWB(8994,2741,2,3,1,59,0)="    Internal value for the PRIMARY INTERPRETING"
^XWB(8994,2741,2,3,1,60,0)="    STAFF field (15) of the sub-file #70.03:"
^XWB(8994,2741,2,3,1,61,0)="    IEN in the NEW PERSON file (#200)."
^XWB(8994,2741,2,3,1,62,0)=" "
^XWB(8994,2741,2,3,1,63,0)="  RAPROC^1^{IEN #71}^{IEN #71.2}^{IEN #71.2}^..."
^XWB(8994,2741,2,3,1,64,0)="    Radiology procedure and optional modifiers."
^XWB(8994,2741,2,3,1,65,0)=" "
^XWB(8994,2741,2,3,1,66,0)="  RDPHARMS^{Seq#}"
^XWB(8994,2741,2,3,1,67,0)="    Opening/closing tag of the record of internal"
^XWB(8994,2741,2,3,1,68,0)="    values for the 'RADIOPHARMACEUTICALS' multiple"
^XWB(8994,2741,2,3,1,69,0)="    (100) of the 'NUC MED EXAM DATA' file (#70.2)."
^XWB(8994,2741,2,3,1,70,0)=" "
^XWB(8994,2741,2,3,1,71,0)="    RDPH-ACDR^^{value}"
^XWB(8994,2741,2,3,1,72,0)="      Internal value for the ACTIVITY DRAWN "
^XWB(8994,2741,2,3,1,73,0)="      field (4)."
^XWB(8994,2741,2,3,1,74,0)=" "
^XWB(8994,2741,2,3,1,75,0)="    RDPH-DOSE^^{value}"
^XWB(8994,2741,2,3,1,76,0)="      Internal value for the DOSE ADMINISTERED "
^XWB(8994,2741,2,3,1,77,0)="      field (7)."
^XWB(8994,2741,2,3,1,78,0)=" "
^XWB(8994,2741,2,3,1,79,0)="    RDPH-DRUG^^{IEN #50}"
^XWB(8994,2741,2,3,1,80,0)="      Internal value for the RADIOPHARMACEUTICAL "
^XWB(8994,2741,2,3,1,81,0)="      field (.01)."
^XWB(8994,2741,2,3,1,82,0)=" "
^XWB(8994,2741,2,3,1,83,0)="    RDPH-DTADM^^{date/time}"
^XWB(8994,2741,2,3,1,84,0)="      Internal value for the DATE/TIME DOSE"
^XWB(8994,2741,2,3,1,85,0)="      ADMINISTERED field (8)."
^XWB(8994,2741,2,3,1,86,0)=" "
^XWB(8994,2741,2,3,1,87,0)="    RDPH-DTDRW^^{date/time}"
^XWB(8994,2741,2,3,1,88,0)="      Internal value for the DATE/TIME DRAWN"
^XWB(8994,2741,2,3,1,89,0)="      field (5)."
^XWB(8994,2741,2,3,1,90,0)=" "
^XWB(8994,2741,2,3,1,91,0)="    RDPH-FORM^^{A|G|L|P|S}"
^XWB(8994,2741,2,3,1,92,0)="      Internal value for the FORM field (15)."
^XWB(8994,2741,2,3,1,93,0)=" "
^XWB(8994,2741,2,3,1,94,0)="    RDPH-LOTN^^{IEN #71.9}"
^XWB(8994,2741,2,3,1,95,0)="      Internal value for the LOT NO field (13)."
^XWB(8994,2741,2,3,1,96,0)=" "
^XWB(8994,2741,2,3,1,97,0)="    RDPH-PWADM^^{IEN #200}"
^XWB(8994,2741,2,3,1,98,0)="      Internal value for the PERSON WHO ADMINISTERED "
^XWB(8994,2741,2,3,1,99,0)="      DOSE field (9)."
^XWB(8994,2741,2,3,1,100,0)=" "
^XWB(8994,2741,2,3,1,101,0)="    RDPH-PWMSD^^{IEN #200}"
^XWB(8994,2741,2,3,1,102,0)="      Internal value for the PERSON WHO MEASURED DOSE"
^XWB(8994,2741,2,3,1,103,0)="      field (6)."
^XWB(8994,2741,2,3,1,104,0)=" "
^XWB(8994,2741,2,3,1,105,0)="    RDPH-ROUTE^^{IEN #71.6}"
^XWB(8994,2741,2,3,1,106,0)="      Internal value for the ROUTE OF ADMINISTRATION"
^XWB(8994,2741,2,3,1,107,0)="      field (11)."
^XWB(8994,2741,2,3,1,108,0)=" "
^XWB(8994,2741,2,3,1,109,0)="    RDPH-SITE^^{IEN #71.7}"
^XWB(8994,2741,2,3,1,110,0)="      Internal value for the SITE OF ADMINISTRATION"
^XWB(8994,2741,2,3,1,111,0)="      field (12)."
^XWB(8994,2741,2,3,1,112,0)=" "
^XWB(8994,2741,2,3,1,113,0)="    RDPH-VOL^^{value}"
^XWB(8994,2741,2,3,1,114,0)="      Internal value for the VOLUME field (14)."
^XWB(8994,2741,2,3,1,115,0)=" "
^XWB(8994,2741,2,3,1,116,0)="  TECH^{Seq#}^{IEN #200}"
^XWB(8994,2741,2,3,1,117,0)="    Internal value for the TECHNOLOGIST field (.01)"
^XWB(8994,2741,2,3,1,118,0)="    of the subfile #70.12: IEN in the NEW PERSON"
^XWB(8994,2741,2,3,1,119,0)="    file (#200)."
^XWB(8994,2741,2,3,1,120,0)=" "
^XWB(8994,2741,2,3,1,121,0)="  TECHCOMM^^{text}"
^XWB(8994,2741,2,3,1,122,0)="    Value for the TECHNOLOGIST COMMENT field (4) of the"
^XWB(8994,2741,2,3,1,123,0)="    ACTIVITY LOG multiple (sub-file #70.07). "
^XWB(8994,2741,2,3,1,124,0)=" "
^XWB(8994,2741,2,3,1,125,0)="The following optional parameters are also supported: BEDSECT, EXAMCAT, "
^XWB(8994,2741,2,3,1,126,0)="PRINCLIN, SERVICE, and WARD. If any of them are defined, their values "
^XWB(8994,2741,2,3,1,127,0)="replace the existing ones assigned by the RAMAG EXAM REGISTER."
^XWB(8994,2741,2,3,1,128,0)=" "
^XWB(8994,2741,2,3,1,129,0)="Records can be added to the list in any order. See the comments preceding"
^XWB(8994,2741,2,3,1,130,0)="the $$EXAMINED^RAMAG07 for more details."
^XWB(8994,2741,2,3,1,131,0)=" "
^XWB(8994,2741,2,3,1,132,0)="If you want to clear a multiple that already has a value, assign ""@"" or"
^XWB(8994,2741,2,3,1,133,0)="empty string to the parameter itself and do not set any subscripts. For"
^XWB(8994,2741,2,3,1,134,0)="example, the following construction will clear the CONTRAST MEDIA "
^XWB(8994,2741,2,3,1,135,0)="multiple: Mult[i] := 'CONTMEDIA^^@'."
^XWB(8994,2741,2,3,1,136,0)=" "
^XWB(8994,2741,2,3,1,137,0)="Example:"
^XWB(8994,2741,2,3,1,138,0)=" "
^XWB(8994,2741,2,3,1,139,0)="  with RPCBroker.Param[1] do"
^XWB(8994,2741,2,3,1,140,0)="    begin"
^XWB(8994,2741,2,3,1,141,0)="      PType := list;"
^XWB(8994,2741,2,3,1,142,0)="      Mult[1]  := 'CMUSED^^N';"
^XWB(8994,2741,2,3,1,143,0)="      Mult[2]  := 'FILMSIZE^1^7^2';"
^XWB(8994,2741,2,3,1,144,0)="      Mult[3]  := 'FILMSIZE^2^3^1';"
^XWB(8994,2741,2,3,1,145,0)="      Mult[4]  := 'PRIMCAM^^3';"
^XWB(8994,2741,2,3,1,146,0)="      Mult[5]  := 'TECH^1^2344';"
^XWB(8994,2741,2,3,1,147,0)="      Mult[6]  := 'FLAGS^^F';"
^XWB(8994,2741,2,3,1,148,0)=" "
^XWB(8994,2741,2,3,1,149,0)="      Mult[7]  := 'RDPHARMS^1';"
^XWB(8994,2741,2,3,1,150,0)="      Mult[8]  := 'RDPH-DRUG^^23';"
^XWB(8994,2741,2,3,1,151,0)="      Mult[9]  := 'RDPH-DOSE^^.002';"
^XWB(8994,2741,2,3,1,152,0)="      Mult[10] := 'RDPH-FORM^^A';"
^XWB(8994,2741,2,3,1,153,0)=" "
^XWB(8994,2741,2,3,1,154,0)="      Mult[11] := 'RDPHARMS^2';"
^XWB(8994,2741,2,3,1,155,0)="      Mult[12] := 'RDPH-DRUG^^23';"
^XWB(8994,2741,2,3,1,156,0)="      Mult[13] := 'RDPH-DOSE^^.002';"
^XWB(8994,2741,2,3,1,157,0)="      Mult[14] := 'RDPHARMS^2';    // Record closing tag is required"
^XWB(8994,2741,2,3,1,158,0)="                                   // if something else than another"
^XWB(8994,2741,2,3,1,159,0)="                                   // record of the same kind follows."
^XWB(8994,2741,2,3,1,160,0)="      Mult[15] := 'COMPLICAT^^13';"
^XWB(8994,2741,2,3,1,161,0)="    end;"
^XWB(8994,2741,2,"B","RAEXAM",1)=""
^XWB(8994,2741,2,"B","RAMSC",3)=""
^XWB(8994,2741,2,"PARAMSEQ",1,1)=""
^XWB(8994,2741,2,"PARAMSEQ",2,3)=""
^XWB(8994,2741,3,0)="^8994.03^23^23^3080227^^^^"
^XWB(8994,2741,3,1,0)="A negative value of the first '^'-piece of the Results[0] indicates that"
^XWB(8994,2741,3,2,0)="an error occurred during the execution of the remote procedure. In this"
^XWB(8994,2741,3,3,0)="case, the second piece of the Results[0] will contain number of the error"
^XWB(8994,2741,3,4,0)="descriptors returned in the subsequent nodes of the Results array."
^XWB(8994,2741,3,5,0)=" "
^XWB(8994,2741,3,6,0)="  Results[0]            Result descriptor"
^XWB(8994,2741,3,7,0)="                          ^01: The last error code"
^XWB(8994,2741,3,8,0)="                          ^02: Number of error descriptors"
^XWB(8994,2741,3,9,0)="  "
^XWB(8994,2741,3,10,0)="  Results[i]            Error descriptor"
^XWB(8994,2741,3,11,0)="                          ^01: Error code"
^XWB(8994,2741,3,12,0)="                          ^02: Message"
^XWB(8994,2741,3,13,0)="                          ^03: Error location"
^XWB(8994,2741,3,14,0)="                          ^04: Error type"
^XWB(8994,2741,3,15,0)="  "
^XWB(8994,2741,3,16,0)="  Results[j]            Line of the additional info"
^XWB(8994,2741,3,17,0)="                          ^01: """" (empty)"
^XWB(8994,2741,3,18,0)="                          ^02: Text"
^XWB(8994,2741,3,19,0)=" "
^XWB(8994,2741,3,20,0)="Error descriptors are returned in reverse chronological order (most recent"
^XWB(8994,2741,3,21,0)="first)."
^XWB(8994,2741,3,22,0)=" "
^XWB(8994,2741,3,23,0)="Otherwise, 0 is returned in the Results[0]."
^XWB(8994,2742,0)="RAMAG EXAM STATUS REQUIREMENTS^EXMSTREQ^RAMAGRP2^2^A^^^1"
^XWB(8994,2742,1,0)="^8994.01^7^7^3080227^^^^"
^XWB(8994,2742,1,1,0)="The RAMAG EXAM STATUS REQUIREMENTS remote procedure returns a descriptor"
^XWB(8994,2742,1,2,0)="that indicates conditions that should be met in order to successfully "
^XWB(8994,2742,1,3,0)="perform an action on an exam/case record."
^XWB(8994,2742,1,4,0)=" "
^XWB(8994,2742,1,5,0)="These conditions are defined by the sites and stored in the EXAMINATION"
^XWB(8994,2742,1,6,0)="STATUS file (#72). See the .1 and .5 nodes of the data dictionary of the"
^XWB(8994,2742,1,7,0)="file #74 for more details."
^XWB(8994,2742,2,0)="^8994.02A^4^3"
^XWB(8994,2742,2,2,0)="RACTION^1^1^1^1"
^XWB(8994,2742,2,2,1,0)="^^7^7^3080107^"
^XWB(8994,2742,2,2,1,1,0)="The RACTION parameter defines the action that is going to be performed on "
^XWB(8994,2742,2,2,1,2,0)="an exam/case record:"
^XWB(8994,2742,2,2,1,3,0)=" "
^XWB(8994,2742,2,2,1,4,0)="  E  Examined (procedure has been performed,"
^XWB(8994,2742,2,2,1,5,0)="     images have been acquired)"
^XWB(8994,2742,2,2,1,6,0)=" "
^XWB(8994,2742,2,2,1,7,0)="  C  Complete"
^XWB(8994,2742,2,3,0)="RAIMGTYI^1^^1^2"
^XWB(8994,2742,2,3,1,0)="^8994.021^1^1^3080219^^^"
^XWB(8994,2742,2,3,1,1,0)="IEN of the imaging type in the IMAGING TYPE file (#79.2)."
^XWB(8994,2742,2,4,0)="RAPROC^1^^^3"
^XWB(8994,2742,2,4,1,0)="^8994.021^8^8^3080227^^"
^XWB(8994,2742,2,4,1,1,0)="Radiology procedure IEN (file #71). This parameter is required to"
^XWB(8994,2742,2,4,1,2,0)="determine exact nuclear medicine requirements (pieces of the Results[0]"
^XWB(8994,2742,2,4,1,3,0)="from 17 to 25)."
^XWB(8994,2742,2,4,1,4,0)=" "
^XWB(8994,2742,2,4,1,5,0)="By default (+$G(RAPROC)=0), this remote procedure cannot examine the"
^XWB(8994,2742,2,4,1,6,0)="SUPPRESS RADIOPHARM PROMPT field (2) of the RAD/NUC MED PROCEDURES file"
^XWB(8994,2742,2,4,1,7,0)="(#71) and might indicate that some nuclear medicine data is required even"
^XWB(8994,2742,2,4,1,8,0)="if it is not."
^XWB(8994,2742,2,"B","RACTION",2)=""
^XWB(8994,2742,2,"B","RAIMGTYI",3)=""
^XWB(8994,2742,2,"B","RAPROC",4)=""
^XWB(8994,2742,2,"PARAMSEQ",1,2)=""
^XWB(8994,2742,2,"PARAMSEQ",2,3)=""
^XWB(8994,2742,2,"PARAMSEQ",3,4)=""
^XWB(8994,2742,3,0)="^^183^183^3080227^"
^XWB(8994,2742,3,1,0)="A negative value of the first '^'-piece of the Results[0] indicates that"
^XWB(8994,2742,3,2,0)="an error occurred during the execution of the remote procedure. In this"
^XWB(8994,2742,3,3,0)="case, the second piece of the Results[0] will contain number of the error"
^XWB(8994,2742,3,4,0)="descriptors returned in the subsequent nodes of the Results array."
^XWB(8994,2742,3,5,0)=" "
^XWB(8994,2742,3,6,0)="  Results[0]            Result descriptor"
^XWB(8994,2742,3,7,0)="                          ^01: The last error code"
^XWB(8994,2742,3,8,0)="                          ^02: Number of error descriptors"
^XWB(8994,2742,3,9,0)="  "
^XWB(8994,2742,3,10,0)="  Results[i]            Error descriptor"
^XWB(8994,2742,3,11,0)="                          ^01: Error code"
^XWB(8994,2742,3,12,0)="                          ^02: Message"
^XWB(8994,2742,3,13,0)="                          ^03: Error location"
^XWB(8994,2742,3,14,0)="                          ^04: Error type"
^XWB(8994,2742,3,15,0)="  "
^XWB(8994,2742,3,16,0)="  Results[j]            Line of the additional info"
^XWB(8994,2742,3,17,0)="                          ^01: """" (empty)"
^XWB(8994,2742,3,18,0)="                          ^02: Text"
^XWB(8994,2742,3,19,0)=" "
^XWB(8994,2742,3,20,0)="Error descriptors are returned in reverse chronological order (most recent"
^XWB(8994,2742,3,21,0)="first)."
^XWB(8994,2742,3,22,0)=" "
^XWB(8994,2742,3,23,0)="Otherwise, exam status requirements are returned in the Results[0]."
^XWB(8994,2742,3,24,0)="Descriptor of the exam status is returned in the Results[1]. See comments "
^XWB(8994,2742,3,25,0)="in the RAMAGU06 routine for details."
^XWB(8994,2742,3,26,0)=" "
^XWB(8994,2742,3,27,0)="  Results[0]            Exam status requirements"
^XWB(8994,2742,3,28,0)="                          ^01: TECHNOLOGIST REQUIRED?         {0|1}"
^XWB(8994,2742,3,29,0)="                          ^02: RESIDENT OR STAFF REQUIRED?    {0|1}"
^XWB(8994,2742,3,30,0)="                          ^03: DETAILED PROCEDURE REQUIRED?   {0|1}"
^XWB(8994,2742,3,31,0)="                          ^04: FILM ENTRY REQUIRED?           {0|1}"
^XWB(8994,2742,3,32,0)="                          ^05: DIAGNOSTIC CODE REQUIRED?      {0|1}"
^XWB(8994,2742,3,33,0)="                          ^06: CAMERA/EQUIP/RM REQUIRED?      {0|1}"
^XWB(8994,2742,3,34,0)="                          ^07: reserved"
^XWB(8994,2742,3,35,0)="                          ^08: reserved"
^XWB(8994,2742,3,36,0)="                          ^09: reserved"
^XWB(8994,2742,3,37,0)="                          ^10: reserved"
^XWB(8994,2742,3,38,0)="                          ^11: REPORT ENTERED REQUIRED?       {0|1}"
^XWB(8994,2742,3,39,0)="                          ^12: VERIFIED REPORT REQUIRED?      {0|1}"
^XWB(8994,2742,3,40,0)="                          ^13: PROCEDURE MODIFIERS REQUIRED?  {0|1}"
^XWB(8994,2742,3,41,0)="                          ^14: CPT MODIFIERS REQUIRED?        {0|1}"
^XWB(8994,2742,3,42,0)="                          ^15: reserved"
^XWB(8994,2742,3,43,0)="                          ^16: IMPRESSION REQUIRED?           {0|1}"
^XWB(8994,2742,3,44,0)="                          ^17: RADIOPHARMS/DOSAGES REQUIRED?  {0|1}                "
^XWB(8994,2742,3,45,0)="                          ^18: reserved                                            "
^XWB(8994,2742,3,46,0)="                          ^19: ACTIVITY DRAWN REQUIRED?       {0|1}                "
^XWB(8994,2742,3,47,0)="                          ^20: DRAWN DT/TIME/PERSON REQUIRED? {0|1}                "
^XWB(8994,2742,3,48,0)="                          ^21: ADM DT/TIME/PERSON REQUIRED?   {0|1}                "
^XWB(8994,2742,3,49,0)="                          ^22: reserved                                            "
^XWB(8994,2742,3,50,0)="                          ^23: ROUTE/SITE REQUIRED?           {0|1}                "
^XWB(8994,2742,3,51,0)="                          ^24: LOT NO. REQUIRED?              {0|1}                "
^XWB(8994,2742,3,52,0)="                          ^25: VOLUME/FORM REQUIRED?          {0|1}                "
^XWB(8994,2742,3,53,0)=" "
^XWB(8994,2742,3,54,0)="  Results[1]            Exam status descriptor"
^XWB(8994,2742,3,55,0)="                          ^01: Status IEN"
^XWB(8994,2742,3,56,0)="                          ^02: Status name"
^XWB(8994,2742,3,57,0)="                          ^03: Status code (order)"
^XWB(8994,2742,3,58,0)="                          ^04: VistARAD category"
^XWB(8994,2742,3,59,0)="                          ^05: Generic exam status characteristics"
^XWB(8994,2742,3,60,0)=" "
^XWB(8994,2742,3,61,0)="Explanations for the Requirements"
^XWB(8994,2742,3,62,0)="================================="
^XWB(8994,2742,3,63,0)=" "
^XWB(8994,2742,3,64,0)="01: TECHNOLOGIST REQUIRED?"
^XWB(8994,2742,3,65,0)="        "
^XWB(8994,2742,3,66,0)="    At least one value of the ""TECH"" parameter should be provided or"
^XWB(8994,2742,3,67,0)="    the TECHNOLOGIST multiple (175) of the RAD/NUC MED PATIENT file"
^XWB(8994,2742,3,68,0)="    (#70) should have at least one record already."
^XWB(8994,2742,3,69,0)=" "
^XWB(8994,2742,3,70,0)="02: RESIDENT OR STAFF REQUIRED?"
^XWB(8994,2742,3,71,0)=" "
^XWB(8994,2742,3,72,0)="    The ""PRIMINTRES"" or ""PRIMINTSTF"" parameter should be defined or"
^XWB(8994,2742,3,73,0)="    at least one of the following fields of the RAD/NUC MED PATIENT"
^XWB(8994,2742,3,74,0)="    file (#70) should have a value already: PRIMARY INTERPRETING"
^XWB(8994,2742,3,75,0)="    RESIDENT (13) or PRIMARY INTERPRETING STAFF (15)."
^XWB(8994,2742,3,76,0)=" "
^XWB(8994,2742,3,77,0)="03: DETAILED PROCEDURE REQUIRED?"
^XWB(8994,2742,3,78,0)=" "
^XWB(8994,2742,3,79,0)="    If the ordered and/or registered procedure was a 'broad' one, "
^XWB(8994,2742,3,80,0)="    then the ""RAPROC"" should reference a valid 'detailed' or"
^XWB(8994,2742,3,81,0)="    'series' procedure. Otherwise, the parameter is not required."
^XWB(8994,2742,3,82,0)=" "
^XWB(8994,2742,3,83,0)="    See the TYPE OF PROCEDURE field (6) of the RAD/NUC MED"
^XWB(8994,2742,3,84,0)="    PROCEDURES file (#71) for more details."
^XWB(8994,2742,3,85,0)=" "
^XWB(8994,2742,3,86,0)="04: FILM ENTRY REQUIRED?"
^XWB(8994,2742,3,87,0)=" "
^XWB(8994,2742,3,88,0)="    At least one value of the ""FILMSIZE"" parameter should be"
^XWB(8994,2742,3,89,0)="    provided or the FILM SIZE multiple (50) of the RAD/NUC MED "
^XWB(8994,2742,3,90,0)="    PATIENT file (#70) should have at least one record already."
^XWB(8994,2742,3,91,0)=" "
^XWB(8994,2742,3,92,0)="05: DIAGNOSTIC CODE REQUIRED?"
^XWB(8994,2742,3,93,0)=" "
^XWB(8994,2742,3,94,0)="    A non-empty value of the ""PRIMDXCODE"" parameter should be"
^XWB(8994,2742,3,95,0)="    provided or the PRIMARY DIAGNOSTIC CODE field (13) of the"
^XWB(8994,2742,3,96,0)="    RAD/NUC MED PATIENT file (#70) should have a value already."
^XWB(8994,2742,3,97,0)=" "
^XWB(8994,2742,3,98,0)="06: CAMERA/EQUIP/RM REQUIRED?"
^XWB(8994,2742,3,99,0)=" "
^XWB(8994,2742,3,100,0)="    A non-empty value of the ""PRIMCAM"" parameter should be provided"
^XWB(8994,2742,3,101,0)="    or the PRIMARY CAMERA/EQUIP/RM field (18) of the RAD/NUC MED"
^XWB(8994,2742,3,102,0)="    PATIENT file (#70) should have a value already."
^XWB(8994,2742,3,103,0)=" "
^XWB(8994,2742,3,104,0)="11: REPORT ENTERED REQUIRED?"
^XWB(8994,2742,3,105,0)=" "
^XWB(8994,2742,3,106,0)="    A non-empty value of the ""REPORT"" parameter should be provided"
^XWB(8994,2742,3,107,0)="    or the REPORT TEXT field (200) of the RAD/NUC MED REPORTS file"
^XWB(8994,2742,3,108,0)="    (#74) should have a non-empty value already."
^XWB(8994,2742,3,109,0)=" "
^XWB(8994,2742,3,110,0)="12: VERIFIED REPORT REQUIRED?"
^XWB(8994,2742,3,111,0)=" "
^XWB(8994,2742,3,112,0)="    The ""V"" value of the ""RPTSTATUS"" parameter should be provided"
^XWB(8994,2742,3,113,0)="    (default)."
^XWB(8994,2742,3,114,0)=" "
^XWB(8994,2742,3,115,0)="13: PROCEDURE MODIFIERS REQUIRED?"
^XWB(8994,2742,3,116,0)=" "
^XWB(8994,2742,3,117,0)="    At least one procedure modifier should be provided in the "
^XWB(8994,2742,3,118,0)="    ""RAPROC"" parameter or the PROCEDURE MODIFIERS multiple (125) of"
^XWB(8994,2742,3,119,0)="    the RAD/NUC MED PATIENT file (#70) should have at least one"
^XWB(8994,2742,3,120,0)="    record already."
^XWB(8994,2742,3,121,0)=" "
^XWB(8994,2742,3,122,0)="14: CPT MODIFIERS REQUIRED?"
^XWB(8994,2742,3,123,0)=" "
^XWB(8994,2742,3,124,0)="    At least one value of the ""CPTMODS"" parameter should be provided"
^XWB(8994,2742,3,125,0)="    or the CPT MODIFIERS multiple (135) of the RAD/NUC MED PATIENT"
^XWB(8994,2742,3,126,0)="    file (#70) should have at least one record already."
^XWB(8994,2742,3,127,0)=" "
^XWB(8994,2742,3,128,0)="16: IMPRESSION REQUIRED?"
^XWB(8994,2742,3,129,0)=" "
^XWB(8994,2742,3,130,0)="    A non-empty value of the ""IMPRESSION"" parameter should be"
^XWB(8994,2742,3,131,0)="    provided or the IMPRESSION TEXT field (300) of the RAD/NUC MED"
^XWB(8994,2742,3,132,0)="    REPORTS file (#74) should have a non-empty value already."
^XWB(8994,2742,3,133,0)=" "
^XWB(8994,2742,3,134,0)="17: RADIOPHARMS/DOSAGES REQUIRED?"
^XWB(8994,2742,3,135,0)=" "
^XWB(8994,2742,3,136,0)="    At least one record of the ""RDPHARMS"" parameter should be"
^XWB(8994,2742,3,137,0)="    provided (at least, the ""RDPH-DRUG"" and ""RDPH-DOSE"" record"
^XWB(8994,2742,3,138,0)="    parameters should be defined) or the RADIOPHARMACEUTICALS"
^XWB(8994,2742,3,139,0)="    multiple (100) of the NUC MED EXAM DATA file (#70.2) should"
^XWB(8994,2742,3,140,0)="    have at least one record already (at least, the "
^XWB(8994,2742,3,141,0)="    RADIOPHARMACEUTICAL (.01) and DOSE ADMINISTERED (7) fields "
^XWB(8994,2742,3,142,0)="    should be populated)."
^XWB(8994,2742,3,143,0)=" "
^XWB(8994,2742,3,144,0)="19: ACTIVITY DRAWN REQUIRED?"
^XWB(8994,2742,3,145,0)=" "
^XWB(8994,2742,3,146,0)="    A non-empty value of the ""RDPH-ACDR"" parameter should be"
^XWB(8994,2742,3,147,0)="    provided or the ACTIVITY DRAWN field (4) of the NUC MED EXAM"
^XWB(8994,2742,3,148,0)="    DATA file (#70.2) should have a non-empty value already."
^XWB(8994,2742,3,149,0)=" "
^XWB(8994,2742,3,150,0)="20: DRAWN DT/TIME/PERSON REQUIRED?"
^XWB(8994,2742,3,151,0)=" "
^XWB(8994,2742,3,152,0)="    Non-empty values of the ""RDPH-DTDRW"" and ""RDPH-PWMSD"" parameters"
^XWB(8994,2742,3,153,0)="    should be provided or the DATE/TIME DRAWN (5) and PERSON WHO"
^XWB(8994,2742,3,154,0)="    MEASURED DOSE (6) fields of the NUC MED EXAM DATA file (#70.2)"
^XWB(8994,2742,3,155,0)="    should have non-empty values already."
^XWB(8994,2742,3,156,0)=" "
^XWB(8994,2742,3,157,0)="21: ADM DT/TIME/PERSON REQUIRED?"
^XWB(8994,2742,3,158,0)=" "
^XWB(8994,2742,3,159,0)="    Non-empty values of the ""RDPH-DTADM"" and ""RDPH-PWADM"" parameters"
^XWB(8994,2742,3,160,0)="    should be provided or the DATE/TIME DOSE ADMINISTERED (8) and"
^XWB(8994,2742,3,161,0)="    PERSON WHO ADMINISTERED DOSE (9) fields of the NUC MED EXAM DATA"
^XWB(8994,2742,3,162,0)="    file (#70.2) should have non-empty values already."
^XWB(8994,2742,3,163,0)=" "
^XWB(8994,2742,3,164,0)="23: ROUTE/SITE REQUIRED?"
^XWB(8994,2742,3,165,0)=" "
^XWB(8994,2742,3,166,0)="    Non-empty values of the ""RDPH-ROUTE"" and ""RDPH-SITE"" parameters"
^XWB(8994,2742,3,167,0)="    should be provided or the ROUTE OF ADMINISTRATION (11) and SITE"
^XWB(8994,2742,3,168,0)="    OF ADMINISTRATION (12) fields of the NUC MED EXAM DATA file"
^XWB(8994,2742,3,169,0)="    (#70.2) should have non-empty values already."
^XWB(8994,2742,3,170,0)=" "
^XWB(8994,2742,3,171,0)="24: LOT NO. REQUIRED?"
^XWB(8994,2742,3,172,0)=" "
^XWB(8994,2742,3,173,0)="    A non-empty value of the ""RDPH-LOTN"" parameter should be"
^XWB(8994,2742,3,174,0)="    provided or the LOT NO field (13) of the NUC MED EXAM DATA file"
^XWB(8994,2742,3,175,0)="    (#70.2) should have a non-empty value already. 25: VOLUME/FORM"
^XWB(8994,2742,3,176,0)="    REQUIRED?"
^XWB(8994,2742,3,177,0)="    "
^XWB(8994,2742,3,178,0)="25: VOLUME/FORM REQUIRED?          "
^XWB(8994,2742,3,179,0)="    "
^XWB(8994,2742,3,180,0)="    Non-empty values of the ""RDPH-FORM"" and ""RDPH-VOL"" parameters"
^XWB(8994,2742,3,181,0)="    should be provided or the FORM (15) and VOLUME (14) fields of"
^XWB(8994,2742,3,182,0)="    the NUC MED EXAM DATA file (#70.2) should have non-empty values"
^XWB(8994,2742,3,183,0)="    already."
^XWB(8994,2743,0)="MAG DICOM ADD CAMERA EQUIP RM^ADDROOM^MAGDRPCB^2"
^XWB(8994,2743,1,0)="^8994.01^2^2^3100121^^^^"
^XWB(8994,2743,1,1,0)="Check the OUTSIDE STUDY Camera Equipment Room for the IMAGING LOCATION."
