^XWB(8994,2879,3,0)="^^1^1^3191220^"
^XWB(8994,2879,3,1,0)="Returns the status codes in an Array."
^XWB(8994,2880,0)="DSIR GET PATIENT DISC HIST^DISHISTR^DSIROIR^4^^^^1"
^XWB(8994,2880,1,0)="^8994.01^14^14^3100902^"
^XWB(8994,2880,1,1,0)="This routine returns the data nescessary for the patient disclosure "
^XWB(8994,2880,1,2,0)="history report."
^XWB(8994,2880,1,3,0)=" "
^XWB(8994,2880,1,4,0)="  Required fields for this report:"
^XWB(8994,2880,1,5,0)=" "
^XWB(8994,2880,1,6,0)="  From 19620      FIELD   From 19620.1    FIELD"
^XWB(8994,2880,1,7,0)="  ---------------------   ---------------------"
^XWB(8994,2880,1,8,0)="  RequestIEN        .01   DocumentCaption   .05"
^XWB(8994,2880,1,9,0)="  DateReceived    10.06   DocumentDate      .07"
^XWB(8994,2880,1,10,0)="  Requestor         .11"
^XWB(8994,2880,1,11,0)="  Reason          10.02"
^XWB(8994,2880,1,12,0)="  RequestorType   10.04"
^XWB(8994,2880,1,13,0)="  Status          10.08"
^XWB(8994,2880,1,14,0)="  Comment           .31"
^XWB(8994,2880,2,0)="^8994.02A^3^3"
^XWB(8994,2880,2,1,0)="PAT^1^20^1^1"
^XWB(8994,2880,2,1,1,0)="^8994.021^4^4^3100902^^"
^XWB(8994,2880,2,1,1,1,0)="PAT = fully qualified patient pointer "
^XWB(8994,2880,2,1,1,2,0)=" "
^XWB(8994,2880,2,1,1,3,0)="  Examples:   ""125325;DPT("""
^XWB(8994,2880,2,1,1,4,0)="              ""152;DSIR(19620.96,"","
^XWB(8994,2880,2,2,0)="FRDT^1^7^1^2"
^XWB(8994,2880,2,2,1,0)="^^3^3^3100820^"
^XWB(8994,2880,2,2,1,1,0)="FRDT is the starting date which will be reported on. "
^XWB(8994,2880,2,2,1,2,0)=" "
^XWB(8994,2880,2,2,1,3,0)="FILEMAN date format - 3101225 = Dec 25,2010"
^XWB(8994,2880,2,3,0)="TODT^1^20^0^3"
^XWB(8994,2880,2,3,1,0)="^8994.021^5^5^3100902^^^^"
^XWB(8994,2880,2,3,1,1,0)="TODT is the ending date which will be reported on."
^XWB(8994,2880,2,3,1,2,0)="This is an optional field and if not provided, the current date will be "
^XWB(8994,2880,2,3,1,3,0)="used."
^XWB(8994,2880,2,3,1,4,0)=" "
^XWB(8994,2880,2,3,1,5,0)="FILEMAN date format - 3101225 = Dec 25,2010"
^XWB(8994,2880,2,"B","FRDT",2)=""
^XWB(8994,2880,2,"B","PAT",1)=""
^XWB(8994,2880,2,"B","TODT",3)=""
^XWB(8994,2880,2,"PARAMSEQ",1,1)=""
^XWB(8994,2880,2,"PARAMSEQ",2,2)=""
^XWB(8994,2880,2,"PARAMSEQ",3,3)=""
^XWB(8994,2880,3,0)="^^11^11^3100902^"
^XWB(8994,2880,3,1,0)="Return Array"
^XWB(8994,2880,3,2,0)="               -1^Missing Start Date!"
^XWB(8994,2880,3,3,0)="               -2^No Records Found!"
^XWB(8994,2880,3,4,0)="  The return array will contain strings formatted in groups (one per"
^XWB(8994,2880,3,5,0)="  request) as follows:"
^XWB(8994,2880,3,6,0)="       $$REQUEST$$^IEN^DateRecieved^Requestor^Reason^RequestorType^Status"
^XWB(8994,2880,3,7,0)="       $$COMMENT1$$^Comment line 1 text"
^XWB(8994,2880,3,8,0)="       $$COMMENT2$$^Comment line 2 text"
^XWB(8994,2880,3,9,0)="       $$COMMENT3$$^Comment line 3 text"
^XWB(8994,2880,3,10,0)="       $$DOCUMENT$$^Document Caption^Document Date (one line per document)"
^XWB(8994,2880,3,11,0)="       $$ENDOFDOCS$$"
^XWB(8994,2881,0)="DSIR GET AOD^ACCOFDIS^DSIROIR^4^P^^^1"
^XWB(8994,2881,1,0)="^8994.01^14^14^3110105^^^^"
^XWB(8994,2881,1,1,0)="This routine returns the data nescessary for the patient disclosure"
^XWB(8994,2881,1,2,0)="history report."
^XWB(8994,2881,1,3,0)=" "
^XWB(8994,2881,1,4,0)="  Required fields for this report:"
^XWB(8994,2881,1,5,0)=" "
^XWB(8994,2881,1,6,0)="  From 19620      FIELD   From 19620.1    FIELD"
^XWB(8994,2881,1,7,0)="  ---------------------   ---------------------"
^XWB(8994,2881,1,8,0)="  Requestor Address .81   DocumentCaption   .05"
^XWB(8994,2881,1,9,0)="  Patient Address   .82   DocumentDate      .07"
^XWB(8994,2881,1,10,0)="  Current Status  10.05"
^XWB(8994,2881,1,11,0)="  Date Received   10.06"
^XWB(8994,2881,1,12,0)="  Date Closed     10.07"
^XWB(8994,2881,1,13,0)="  Clerk Assigned    .03"
^XWB(8994,2881,1,14,0)="  Comment           .31"
^XWB(8994,2881,2,0)="^8994.02A^1^1"
^XWB(8994,2881,2,1,0)="AODIEN^1^20^1^1"
^XWB(8994,2881,2,1,1,0)="^8994.021^1^1^3110105^^^^"
^XWB(8994,2881,2,1,1,1,0)="AODIEN = The request IEN for which you want an Accounting of Disclosure."
