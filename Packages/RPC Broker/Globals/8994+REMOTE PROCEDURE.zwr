^XWB(8994,4638,0)="SDES PRINT PATIENT APPTS^PRINTPATAPPTS^SDES^2^R^^^^^^1"
^XWB(8994,4638,1,0)="^^5^5^3250207^"
^XWB(8994,4638,1,1,0)="Print All of a given patients appointments for the a given time range, if "
^XWB(8994,4638,1,2,0)="time range not provided, will default to begin date of today (now) and "
^XWB(8994,4638,1,3,0)="then 90 days from begin date."
^XWB(8994,4638,1,4,0)=" "
^XWB(8994,4638,1,5,0)="Can only be invoked by Acheron"
^XWB(8994,4638,2,0)="^8994.02A^4^4"
^XWB(8994,4638,2,1,0)="DFN^1^32000^1^1"
^XWB(8994,4638,2,1,1,0)="^8994.021^1^1^3220328^^^^"
^XWB(8994,4638,2,1,1,1,0)="Patient Data File Number (DFN)"
^XWB(8994,4638,2,2,0)="BEGIN DATE^1^25^0^2"
^XWB(8994,4638,2,2,1,0)="^^3^3^3220328^"
^XWB(8994,4638,2,2,1,1,0)="DATE/TIME TO START SELECTION WITH.  IF NO TIME IS GIVEN, THEN WILL "
^XWB(8994,4638,2,2,1,2,0)="DEFAULT TO TODAY (NOW)."
^XWB(8994,4638,2,2,1,3,0)="DATE FORMAT: ISO 8601"
^XWB(8994,4638,2,3,0)="END DATE^1^25^0^3"
^XWB(8994,4638,2,3,1,0)="^^3^3^3220328^"
^XWB(8994,4638,2,3,1,1,0)="DATE/TIME TO END SELECTION WITH.  IF NO TIME IS GIVEN, THEN WILL "
^XWB(8994,4638,2,3,1,2,0)="DEFAULT TO 90 DAYS FROM BEGIN DATE."
^XWB(8994,4638,2,3,1,3,0)="DATE FORMAT: ISO 8601"
^XWB(8994,4638,2,4,0)="EASTRCKNGNMBR^1^40^0^4"
^XWB(8994,4638,2,4,1,0)="^8994.021^2^2^3250207^^"
^XWB(8994,4638,2,4,1,1,0)="                                G"
^XWB(8994,4638,2,4,1,2,0)="APPOINTMENT."
^XWB(8994,4638,2,"B","BEGIN DATE",2)=""
^XWB(8994,4638,2,"B","DFN",1)=""
^XWB(8994,4638,2,"B","EASTRCKNGNMBR",4)=""
^XWB(8994,4638,2,"B","END DATE",3)=""
^XWB(8994,4638,2,"PARAMSEQ",1,1)=""
^XWB(8994,4638,2,"PARAMSEQ",2,2)=""
^XWB(8994,4638,2,"PARAMSEQ",3,3)=""
^XWB(8994,4638,2,"PARAMSEQ",4,4)=""
^XWB(8994,4638,3,0)="^8994.03^13^13^3250207^^"
^XWB(8994,4638,3,1,0)="Returns a JSON array back of all patients appointments for a given "
^XWB(8994,4638,3,2,0)="date range.  Default is today through today +90 days that are active and"
^XWB(8994,4638,3,3,0)="where clinic allows display to patient."
^XWB(8994,4638,3,4,0)="EXAMPLE:"
^XWB(8994,4638,3,5,0)="{"
^XWB(8994,4638,3,6,0)=" ""PatientAppointments"": ["
^XWB(8994,4638,3,7,0)="   {"
^XWB(8994,4638,3,8,0)="    ""AppointDateTime"": ""2022-04-05T08:00-0400"","
^XWB(8994,4638,3,9,0)="    ""Clinic"": ""CHY CARDIOLOGY"","
^XWB(8994,4638,3,10,0)="    ""TimeZone"": ""EASTERN"""
^XWB(8994,4638,3,11,0)="   }"
^XWB(8994,4638,3,12,0)=" ]"
^XWB(8994,4638,3,13,0)="}"
