^XWB(8994,5051,1,2,0)="  | Property of the US Government.                                |"
^XWB(8994,5051,1,3,0)="  | No permission to copy or redistribute this software is given. |"
^XWB(8994,5051,1,4,0)="  | Use of unreleased versions of this software requires the user |"
^XWB(8994,5051,1,5,0)="  | to execute a written test agreement with the VistA Imaging    |"
^XWB(8994,5051,1,6,0)="  | Development Office of the Department of Veterans Affairs,     |"
^XWB(8994,5051,1,7,0)="  | telephone (301) 734-0100.                                     |"
^XWB(8994,5051,1,8,0)="  |                                                               |"
^XWB(8994,5051,1,9,0)="  | The Food and Drug Administration classifies this software as  |"
^XWB(8994,5051,1,10,0)="  | a medical device.  As such, it may not be changed in any way. |"
^XWB(8994,5051,1,11,0)="  | Modifications to this software may result in an adulterated   |"
^XWB(8994,5051,1,12,0)="  | medical device under 21CFR820, the use of which is considered |"
^XWB(8994,5051,1,13,0)="  | to be a violation of US Federal Statutes.                     |"
^XWB(8994,5051,1,14,0)="  +---------------------------------------------------------------+"
^XWB(8994,5051,1,15,0)=" "
^XWB(8994,5051,1,16,0)=" This RPC returns information about an image."
^XWB(8994,5051,1,17,0)=" The information that is returned consists of any of"
^XWB(8994,5051,1,18,0)=" the fields listed below. Fields that do not have"
^XWB(8994,5051,1,19,0)=" a value (or that have an ""empty"" value) are not"
^XWB(8994,5051,1,20,0)=" returned."
^XWB(8994,5051,1,21,0)=" "
