^XWB(8994,4559,1,1,0)="This rpc deletes a specific piece of equipment from a turn-in request."
^XWB(8994,4559,1,2,0)="The rpc checks for error conditions:"
^XWB(8994,4559,1,3,0)="1) Lock error"
^XWB(8994,4559,1,4,0)="2) Item has an open auto-generated WO."
^XWB(8994,4559,1,5,0)="3) Item was removed from the turn-in by another user - scren not refreshed"
^XWB(8994,4559,1,6,0)="4) Item is the only one in the turn-in"
^XWB(8994,4559,1,7,0)=" "
^XWB(8994,4559,1,8,0)="When the equipment is deleted from turn-in, the TURN-IN DATE is set back "
^XWB(8994,4559,1,9,0)="to null in file 6914."
^XWB(8994,4559,2,0)="^8994.02A^2^2"
