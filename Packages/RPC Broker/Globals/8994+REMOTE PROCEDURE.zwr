^XWB(8994,5171,3,209,0)="            ""default"": ""Unanswered"","
^XWB(8994,5171,3,210,0)="            ""description"": ""Military Sexual Trauma (MST):\r\nVeterans who "
^XWB(8994,5171,3,211,0)="experienced sexual trauma while serving on active duty in the\r\nmilitary "
^XWB(8994,5171,3,212,0)="are eligible to receive treatment and counseling services for "
^XWB(8994,5171,3,213,0)="the\r\nsexual trauma without incurring copayment charges or claims "
^XWB(8994,5171,3,214,0)="against their\r\ninsurance.  See 'Help' for additional information.\r\n"","
^XWB(8994,5171,3,215,0)="            ""disabled"": false,"
