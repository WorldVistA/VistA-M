^XWB(8994,5040,2,1,1,4,0)="                            calling application. "
^XWB(8994,5040,2,1,1,5,0)="  SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,5040,2,1,1,6,0)="                            calling application."
^XWB(8994,5040,2,1,1,7,0)="  SDCONTEXT(""PATIENT DFN"")= The name of the patient taking action on the"
^XWB(8994,5040,2,1,1,8,0)="                            calling application."
^XWB(8994,5040,2,1,1,9,0)="  SDCONTEXT(""PATIENT ICN"")= The ICN of the patient taking action on the"
^XWB(8994,5040,2,1,1,10,0)="                            calling application."
