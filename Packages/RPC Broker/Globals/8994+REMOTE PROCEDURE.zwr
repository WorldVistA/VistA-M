^XWB(8994,2553,3,1,0)="0=success or ""-1^<error message>"" for failure."
^XWB(8994,2554,0)="DSIV REPORT QUEUE^PRPT^DSIVICR^1^A"
^XWB(8994,2554,1,0)="^^1^1^3070821^"
^XWB(8994,2554,1,1,0)="Queues up the report data from file 19625 for billing reports.  "
^XWB(8994,2554,2,0)="^8994.02A^3^3"
^XWB(8994,2554,2,1,0)="DSIVHNDL^1^50^0^1"
^XWB(8994,2554,2,1,1,0)="^8994.021^2^2^3070820^^^"
^XWB(8994,2554,2,1,1,1,0)="Contains the handle to ""find"" the report in the ^XTMP global after it has "
^XWB(8994,2554,2,1,1,2,0)="been queued and run by Taskman."
^XWB(8994,2554,2,2,0)="DSIVRPT^1^30^1^2"
^XWB(8994,2554,2,2,1,0)="^8994.021^1^1^3070820^^"
^XWB(8994,2554,2,2,1,1,0)="Contains the ICB report the user has requested."
^XWB(8994,2554,2,3,0)="DATA^2^250^1^3"
^XWB(8994,2554,2,3,1,0)="^8994.021^10^10^3070821^^^"
^XWB(8994,2554,2,3,1,1,0)="Contains the parameters to search for data:"
^XWB(8994,2554,2,3,1,2,0)="   DATA(""SDT"")=fileman start dt"
^XWB(8994,2554,2,3,1,3,0)="   DATA(""EDT"")=fileman end dt"
^XWB(8994,2554,2,3,1,4,0)="   DATA(""INDEX"")=index to use   ""C"" or ""D"" or ""E"" or ""F"" or ""H"""
^XWB(8994,2554,2,3,1,5,0)="   DATA(""FIELDS"")=fields to return  "".01;.02;.03;.03I"""
^XWB(8994,2554,2,3,1,6,0)=" Note that ""NUMS"" and ""MORE"" are not used.  ""NUMS"" will be used when"
^XWB(8994,2554,2,3,1,7,0)=" polling and retrieving results."
^XWB(8994,2554,2,3,1,8,0)=" FIELDS are DD fields separated by semi-colons only (no colon ""ranged"""
^XWB(8994,2554,2,3,1,9,0)="  fields), FIELDS may be suffixed with ""I"" for internal data vs default of"
^XWB(8994,2554,2,3,1,10,0)="  external data format.  Data is returned in FIELDS order."
^XWB(8994,2554,2,"B","DATA",3)=""
^XWB(8994,2554,2,"B","DSIVHNDL",1)=""
^XWB(8994,2554,2,"B","DSIVRPT",2)=""
^XWB(8994,2554,2,"PARAMSEQ",1,1)=""
^XWB(8994,2554,2,"PARAMSEQ",2,2)=""
^XWB(8994,2554,2,"PARAMSEQ",3,3)=""
^XWB(8994,2554,3,0)="^8994.03^2^2^3070821^^^^"
^XWB(8994,2554,3,1,0)="Returns Taskman task#^Handle"
^XWB(8994,2554,3,2,0)="or -1^error"
^XWB(8994,2555,0)="DSIV UPDATE SUBFILE MULT^ADDUPD^DSIVIC2^2^A"
^XWB(8994,2555,1,0)="^8994.01^1^1^3060324^"
^XWB(8994,2555,1,1,0)="Allows editing of multiple entries in a FileMan multiple at one time."
^XWB(8994,2555,2,0)="^8994.02A^4^4"
^XWB(8994,2555,2,1,0)="FILE^1^20^1^1"
^XWB(8994,2555,2,1,1,0)="^^1^1^3060324^"
^XWB(8994,2555,2,1,1,1,0)="Contains the file# to add/edit data."
^XWB(8994,2555,2,2,0)="IEN^1^30^1^2"
^XWB(8994,2555,2,2,1,0)="^^1^1^3060324^"
^XWB(8994,2555,2,2,1,1,0)="Contains the IEN of the entry to add/edit."
^XWB(8994,2555,2,3,0)="DATA^2^50^1^3"
^XWB(8994,2555,2,3,1,0)="^^10^10^3060324^"
^XWB(8994,2555,2,3,1,1,0)="Array holding entries for adding:"
^XWB(8994,2555,2,3,1,2,0)="   DATA(n)=$START"
^XWB(8994,2555,2,3,1,3,0)="   DATA(n)=field^value"
^XWB(8994,2555,2,3,1,4,0)="   DATA(n)=field^value"
^XWB(8994,2555,2,3,1,5,0)="   DATA(n)=$END "
^XWB(8994,2555,2,3,1,6,0)=" for updating:"
^XWB(8994,2555,2,3,1,7,0)="    DATA(n)=$START"
^XWB(8994,2555,2,3,1,8,0)="    DATA(n)=SubfieldIEN^field^value"
^XWB(8994,2555,2,3,1,9,0)="    DATA(n)=SubfieldIEN^field^value"
^XWB(8994,2555,2,3,1,10,0)="    DATA(n)=$END "
^XWB(8994,2555,2,4,0)="FLAG^1^1^1^4"
^XWB(8994,2555,2,4,1,0)="^^2^2^3060324^"
^XWB(8994,2555,2,4,1,1,0)="FLAG=0 to add entries to a multiple,"
^XWB(8994,2555,2,4,1,2,0)="FLAG=1 to update entries in a multiple."
^XWB(8994,2555,2,"B","DATA",3)=""
^XWB(8994,2555,2,"B","FILE",1)=""
^XWB(8994,2555,2,"B","FLAG",4)=""
^XWB(8994,2555,2,"B","IEN",2)=""
^XWB(8994,2555,2,"PARAMSEQ",1,1)=""
^XWB(8994,2555,2,"PARAMSEQ",2,2)=""
^XWB(8994,2555,2,"PARAMSEQ",3,3)=""
^XWB(8994,2555,2,"PARAMSEQ",4,4)=""
^XWB(8994,2555,3,0)="^^2^2^3060324^"
^XWB(8994,2555,3,1,0)="Return array contains added/editing entries in RET(n)"
^XWB(8994,2555,3,2,0)="or RET(0)=""-1^error"""
^XWB(8994,2556,0)="DSIV EXCEPTION REPORT^RRPT^DSIVICR2^4^^^^1"
^XWB(8994,2556,1,0)="^8994.01^3^3^3100222^^^^"
^XWB(8994,2556,1,1,0)="Retrieves ICB Exception data from 19625.1.  A nightly job queued from "
^XWB(8994,2556,1,2,0)="option DSIV NIGHTLY REPORT processes the report - this rpc now just "
^XWB(8994,2556,1,3,0)="returns the data."
^XWB(8994,2556,2,0)="^8994.02A^4^4"
^XWB(8994,2556,2,1,0)="SDT^1^30^1^1"
^XWB(8994,2556,2,1,1,0)="^^3^3^3071105^"
^XWB(8994,2556,2,1,1,1,0)="Contains the start date for the report.  This is the report date in file "
^XWB(8994,2556,2,1,1,2,0)="19625.1.  Since reports are run each night, it is the same as the "
^XWB(8994,2556,2,1,1,3,0)="appointment date."
^XWB(8994,2556,2,2,0)="EDT^1^30^0^2"
^XWB(8994,2556,2,2,1,0)="^8994.021^2^2^3100217^^"
^XWB(8994,2556,2,2,1,1,0)="Contains the end date for the report.  Defaults to current date if not "
^XWB(8994,2556,2,2,1,2,0)="sent."
^XWB(8994,2556,2,3,0)="MORE^1^3^0^3"
^XWB(8994,2556,2,3,1,0)="^8994.021^7^7^3100222^^^^"
^XWB(8994,2556,2,3,1,1,0)="Contains a flag to denote recursive calls to get the Exception Report "
^XWB(8994,2556,2,3,1,2,0)="data.  MORE=0 is the starting condition (start at the start date in "
^XWB(8994,2556,2,3,1,3,0)="parameter 1), MORE=1 is to continue getting the records until the value "
^XWB(8994,2556,2,3,1,4,0)="~END~ is received.  The number of records returned for each call is based "
^XWB(8994,2556,2,3,1,5,0)="on the DSIV MAX NUM ENTRIES parameter.  The MORE parameter and recursive "
^XWB(8994,2556,2,3,1,6,0)="calling to the rpc prevents network timeouts when a lot of data is being "
^XWB(8994,2556,2,3,1,7,0)="returned (e.g. one month of Exception data)."
^XWB(8994,2556,2,4,0)="LOCS^2^50^0^4"
^XWB(8994,2556,2,4,1,0)="^^4^4^3100222^"
^XWB(8994,2556,2,4,1,1,0)="Contains an array of clinics to include or exclude from the report.  The "
^XWB(8994,2556,2,4,1,2,0)="array is in the format:"
^XWB(8994,2556,2,4,1,3,0)=" LOCS(1)=""INCLUDE""   (or ""EXCLUDE"" to exclude the clinics)"
^XWB(8994,2556,2,4,1,4,0)=" LOCS(n)=228  (clinic IEN from file 44)"
^XWB(8994,2556,2,"B","EDT",2)=""
^XWB(8994,2556,2,"B","LOCS",4)=""
^XWB(8994,2556,2,"B","MORE",3)=""
^XWB(8994,2556,2,"B","SDT",1)=""
^XWB(8994,2556,2,"PARAMSEQ",1,1)=""
^XWB(8994,2556,2,"PARAMSEQ",2,2)=""
^XWB(8994,2556,2,"PARAMSEQ",3,3)=""
^XWB(8994,2556,2,"PARAMSEQ",4,4)=""
^XWB(8994,2556,3,0)="^^5^5^3100222^"
^XWB(8994,2556,3,1,0)="Returns the following global array data:"
^XWB(8994,2556,3,2,0)=" Ret(n)=clinic^appt dt/tm^patient^check-in user^check-out user^FM appt dt"
^XWB(8994,2556,3,3,0)=" ~END~ is sent to denote the end of the report.  "
^XWB(8994,2556,3,4,0)=" -1^error denotes error."
^XWB(8994,2556,3,5,0)=" The FM (Fileman) appt date at the end helps the GUI re-sort the data."
^XWB(8994,2557,0)="DSIV GET EIV REPORT^IIV^DSIVIC3^4^A^^^1"
^XWB(8994,2557,1,0)="^8994.01^1^1^3101202^^"
^XWB(8994,2557,1,1,0)="Returns data from the IIV RESPONSE file (365) based on a buffer ien."
^XWB(8994,2557,2,0)="^8994.02A^1^1"
^XWB(8994,2557,2,1,0)="BUFFER^1^30^1^1"
^XWB(8994,2557,2,1,1,0)="^8994.021^1^1^3101202^^"
^XWB(8994,2557,2,1,1,1,0)="Insurance Buffer IEN (file 355.33)."
^XWB(8994,2557,2,"B","BUFFER",1)=""
^XWB(8994,2557,2,"PARAMSEQ",1,1)=""
^XWB(8994,2557,3,0)="^^5^5^3101202^"
^XWB(8994,2557,3,1,0)="Returns -1^error message if no buffer ien, or if buffer ien is not in the "
^XWB(8994,2557,3,2,0)="IIV Response file.  Or array(n)=File# (or subfile#)^field#^data for all "
^XWB(8994,2557,3,3,0)="fields in file 365.  If an eIV error exists, the full IIV RESPONSE "
^XWB(8994,2557,3,4,0)="(#365.15) file error data is returned following an error indicator line: "
^XWB(8994,2557,3,5,0)="$$ERROR$$. "
^XWB(8994,2558,0)="DSIV REPORT DATA^RPT^DSIVICR^4^A^^^1"
^XWB(8994,2558,1,0)="^^1^1^3071129^"
^XWB(8994,2558,1,1,0)="Retrieves data from the audit file 19625 for billing report."
^XWB(8994,2558,2,0)="^8994.02A^1^1"
^XWB(8994,2558,2,1,0)="PARAM^2^30^1^1"
^XWB(8994,2558,2,1,1,0)="^^11^11^3071129^"
^XWB(8994,2558,2,1,1,1,0)="Contains the parameters to search for data:"
^XWB(8994,2558,2,1,1,2,0)="  DATA(""SDT"")=fileman start dt"
^XWB(8994,2558,2,1,1,3,0)="  DATA(""EDT"")=fileman end dt"
^XWB(8994,2558,2,1,1,4,0)="  DATA(""INDEX"")=index to use   ""C"" or ""D"" or ""E"" or ""F"" or ""H"""
^XWB(8994,2558,2,1,1,5,0)="  DATA(""FIELDS"")=fields to return  "".01;.02;.03;.03I"""
^XWB(8994,2558,2,1,1,6,0)="  DATA(""NUMS"")=number of records to return (default=99999), not required"
^XWB(8994,2558,2,1,1,7,0)="  DATA(""MORE"")=1 to return addtl records, 0 to return first set"
^XWB(8994,2558,2,1,1,8,0)="               keep sending MORE=1 until $END$ is reached."
^XWB(8994,2558,2,1,1,9,0)=" FIELDS are DD fields separated by semi-colons only (no colon ""ranged"""
^XWB(8994,2558,2,1,1,10,0)=" fields), FIELDS may be suffixed with ""I"" for internal data vs default of"
^XWB(8994,2558,2,1,1,11,0)=" external data format.  Data is returned in FIELDS order."
^XWB(8994,2558,2,"B","PARAM",1)=""
^XWB(8994,2558,2,"PARAMSEQ",1,1)=""
^XWB(8994,2558,3,0)="^^4^4^3071129^"
^XWB(8994,2558,3,1,0)=" Returns -1^error message or"
^XWB(8994,2558,3,2,0)="  RET(n) p1^p2^p3^p4..."
^XWB(8994,2558,3,3,0)="  RET(n)=$END$ at end of list"
^XWB(8994,2558,3,4,0)="  where p1 = ien of record and p2-pn are requested fields"
^XWB(8994,2559,0)="DSIV LIST ENTERED STATUS^ENST^DSIVIC4^4^^^^1"
^XWB(8994,2559,1,0)="^^2^2^3081205^"
^XWB(8994,2559,1,1,0)="This RPC returns a list of IEN's and Date Entered in internal and "
^XWB(8994,2559,1,2,0)="external format for entries in file 355.33 with a status of Entered."
^XWB(8994,2559,3,0)="^^2^2^3081205^"
^XWB(8994,2559,3,1,0)="IEN (File 355.33) ^ Date Entered (I;E)"
^XWB(8994,2559,3,2,0)="-1 ^ No Entries Found!"
^XWB(8994,2560,0)="ORVW FACLIST^FACLIST^ORVW^2^R^0^^^1^^1"
^XWB(8994,2560,1,0)="^8994.01^2^2^3090908^^"
^XWB(8994,2560,1,1,0)="Wrapper for the TFL^VAFCTFU1 routine, which returns all the treating"
^XWB(8994,2560,1,2,0)="facilities for a given patient DFN."
^XWB(8994,2560,2,0)="^8994.02A^1^1"
^XWB(8994,2560,2,1,0)="DFN^1^^1^1"
^XWB(8994,2560,2,1,1,0)="^^1^1^3090908^"
^XWB(8994,2560,2,1,1,1,0)="Patient DFN"
^XWB(8994,2560,2,"B","DFN",1)=""
^XWB(8994,2560,2,"PARAMSEQ",1,1)=""
^XWB(8994,2561,0)="ECOB FACTORY^FACTORY^ECOBUF^2^P^0"
^XWB(8994,2561,1,0)="^^1^1^3090803^"
^XWB(8994,2561,1,1,0)="An RPC to construct(get a handle to) or destroy VistA objects."
^XWB(8994,2561,2,0)="^8994.02A^1^1"
^XWB(8994,2561,2,1,0)="ARGUMENT^1^32000^1^1"
^XWB(8994,2561,2,1,1,0)="^^2^2^3090803^"
^XWB(8994,2561,2,1,1,1,0)="Constructor Argument = Constructor.[class name].[namespace]"
^XWB(8994,2561,2,1,1,2,0)="Destructor Argument = Destructor.[handle].[class name]"
^XWB(8994,2561,2,"B","ARGUMENT",1)=""
^XWB(8994,2561,2,"PARAMSEQ",1,1)=""
^XWB(8994,2561,3,0)="^^2^2^3090803^"
^XWB(8994,2561,3,1,0)="For a constructor argument, will return a handle."
^XWB(8994,2561,3,2,0)="For a destructor argument, will return a 1."
^XWB(8994,2562,0)="ECOB METHOD^METHOD^ECOBUF^2^P^0"
^XWB(8994,2562,1,0)="^^1^1^3090803^"
^XWB(8994,2562,1,1,0)="An RPC to manipulate VistA objects."
^XWB(8994,2562,2,0)="^8994.02A^1^1"
^XWB(8994,2562,2,1,0)="ARGUMENT^1^32000^1^1"
^XWB(8994,2562,2,1,1,0)="^^1^1^3090803^"
^XWB(8994,2562,2,1,1,1,0)="Argument = [handle].[method].[parameters]"
^XWB(8994,2562,2,"B","ARGUMENT",1)=""
^XWB(8994,2562,2,"PARAMSEQ",1,1)=""
^XWB(8994,2562,3,0)="^^1^1^3090803^"
^XWB(8994,2562,3,1,0)="Returns the result of the method call in the array."
^XWB(8994,2563,0)="MAGJ MAGDATADUMP^DATADUMP^MAGJUTL4^4^R^0^^1^1^^0"
^XWB(8994,2563,1,0)="^8994.01^15^15^3090420^^^^"
^XWB(8994,2563,1,1,0)="  +---------------------------------------------------------------+"
