^XWB(8994,3603,3,88,0)="                       (PRF ASSIGNMENT/PRF Local FLAG) separated by | "
^XWB(8994,3603,3,89,0)="         Each | piece contains the following ;; pieces: "
^XWB(8994,3603,3,90,0)="         1. PRFAID - PRF Assignment ID pointer to PRF ASSIGNMENT file "
^XWB(8994,3603,3,91,0)="(#26.13) "
^XWB(8994,3603,3,92,0)="         2. PRFSTAT - PRF Assignment Status 0=INACTIVE 1=ACTIVE "
