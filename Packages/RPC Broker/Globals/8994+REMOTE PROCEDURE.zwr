^XWB(8994,3507,3,5,0)=" 3. LASTSUB"
^XWB(8994,3508,0)="SDEC WLSET^WLSET^SDEC^1^R^0^^0"
^XWB(8994,3508,1,0)="^8994.01^1^1^3150128^^^"
^XWB(8994,3508,1,1,0)="Waitlist Set"
^XWB(8994,3508,2,0)="^8994.02A^1^1"
^XWB(8994,3508,2,1,0)="INP^1^^1^1"
^XWB(8994,3508,2,1,1,0)="^^61^61^3150128^"
^XWB(8994,3508,2,1,1,1,0)="INP(1) = (integer) Wait List IEN point to"
^XWB(8994,3508,2,1,1,2,0)="                     SD WAIT LIST file 409.3."
^XWB(8994,3508,2,1,1,3,0)="                     If null, a new entry will be added"
^XWB(8994,3508,2,1,1,4,0)="  INP(2) = (text) Patient NAME - name field from the PATIENT file 2"
^XWB(8994,3508,2,1,1,5,0)="  INP(3) = (date) Originating Date and Time in external date form"
^XWB(8994,3508,2,1,1,6,0)="  INP(4) = (text) Institution name NAME field from the"
^XWB(8994,3508,2,1,1,7,0)="                  INSTITUTION file"
^XWB(8994,3508,2,1,1,8,0)="  INP(5) = (text) Wait List Type"
^XWB(8994,3508,2,1,1,9,0)="                   PCMM TEAM ASSIGNMENT"
^XWB(8994,3508,2,1,1,10,0)="                   PCMM POSITION ASSIGNMENT"
^XWB(8994,3508,2,1,1,11,0)="                   SERVICE/SPECIALITY"
^XWB(8994,3508,2,1,1,12,0)="                   SPECIFIC CLINIC"
^XWB(8994,3508,2,1,1,13,0)="  INP(6) = (text) WL Specific Team name - NAME field in the"
^XWB(8994,3508,2,1,1,14,0)="                  TEAM file 404.51"
^XWB(8994,3508,2,1,1,15,0)="  INP(7) = (text) WL Specific Position name - NAME field in"
^XWB(8994,3508,2,1,1,16,0)="                  The TEAM POSITION file 404.57."
^XWB(8994,3508,2,1,1,17,0)="  INP(8) = (text) WL Service/Specialty name - NAME field in"
^XWB(8994,3508,2,1,1,18,0)="                  SD WL SERVICE/SPECIALTY file 409.31."
^XWB(8994,3508,2,1,1,19,0)="  INP(9) = (text) WL Specific Clinic name - NAME field in"
^XWB(8994,3508,2,1,1,20,0)="                  SD WL CLINIC LOCATION file 409.32."
^XWB(8994,3508,2,1,1,21,0)="  INP(10) = (text) Originating User name - NAME field in"
^XWB(8994,3508,2,1,1,22,0)="                   NEW PERSON file 200"
^XWB(8994,3508,2,1,1,23,0)="  INP(11) = (text) <NOT USED> Priority - 'ASAP' or 'FUTURE'"
^XWB(8994,3508,2,1,1,24,0)="                   Priority is set based on 14 Desired Date of Appt."
^XWB(8994,3508,2,1,1,25,0)="  INP(12) = (text) Request By - 'PROVIDER' or 'PATIENT'"
^XWB(8994,3508,2,1,1,26,0)="  INP(13) = (text) Provider name - NAME field in NEW PERSON file 200"
^XWB(8994,3508,2,1,1,27,0)="  INP(14) = (date) Desired Date of appointment in external format."
^XWB(8994,3508,2,1,1,28,0)="  INP(15) = (text) comment must be 1-60 characters"
^XWB(8994,3508,2,1,1,29,0)="  INP(16) = (text) EWL Enrollee Status"
^XWB(8994,3508,2,1,1,30,0)="                    NEW"
^XWB(8994,3508,2,1,1,31,0)="                    ESTABLISHED"
^XWB(8994,3508,2,1,1,32,0)="                    PRIOR"
^XWB(8994,3508,2,1,1,33,0)="                    UNDETERMINED"
^XWB(8994,3508,2,1,1,34,0)="  INP(17) = (text) NOT USED - PATIENT TELEPHONE 4-20 characters"
^XWB(8994,3508,2,1,1,35,0)="  INP(18) = (text) ENROLLMENT PRIORITY - Valid Values are:"
^XWB(8994,3508,2,1,1,36,0)="                                         GROUP 1"
^XWB(8994,3508,2,1,1,37,0)="                                         GROUP "
^XWB(8994,3508,2,1,1,38,0)="2                                                                         "
^XWB(8994,3508,2,1,1,39,0)="                                 GROUP 3"
^XWB(8994,3508,2,1,1,40,0)="                                         GROUP 4"
^XWB(8994,3508,2,1,1,41,0)="                                         GROUP 5"
^XWB(8994,3508,2,1,1,42,0)="                                         GROUP 6"
^XWB(8994,3508,2,1,1,43,0)="                                         GROUP 7"
^XWB(8994,3508,2,1,1,44,0)="                                         GROUP 8"
^XWB(8994,3508,2,1,1,45,0)="  INP(19) = (text) NOT USED - APPT SCHEDULED"
^XWB(8994,3508,2,1,1,46,0)="  INP(20) = (text) MULTIPLE APPOINTMENT RTC NO; YES"
^XWB(8994,3508,2,1,1,47,0)="  INP(21) = (integer) MULT APPT RTC INTERVAL integer between 1-365"
^XWB(8994,3508,2,1,1,48,0)="  INP(22) = (integer) MULT APPT NUMBER integer between 1-100"
^XWB(8994,3508,2,1,1,49,0)="  INP(23) = Patient Contacts separated by ::"
^XWB(8994,3508,2,1,1,50,0)="     Each :: piece has the following ~~ pieces:"
^XWB(8994,3508,2,1,1,51,0)="      1) = (date) DATE ENTERED external date/time"
^XWB(8994,3508,2,1,1,52,0)="      2) = (text) PC ENTERED BY USER ID or NAME - Pointer to"
^XWB(8994,3508,2,1,1,53,0)="                  NEW PERSON file or NAME"
^XWB(8994,3508,2,1,1,54,0)="      4) = (text) ACTION - 'Called' or 'Message Left'"
^XWB(8994,3508,2,1,1,55,0)="      5) = (optional) PATIENT PHONE Free-Text 4-20 characters"
^XWB(8994,3508,2,1,1,56,0)="  INP(24) = (optional) SERVICE CONNECTED PRIORITY valid values are"
^XWB(8994,3508,2,1,1,57,0)="                        NO YES"
^XWB(8994,3508,2,1,1,58,0)="  INP(25) = (optional) SERVICE CONNECTED PERCENTAGE = numeric 0-100"
^XWB(8994,3508,2,1,1,59,0)="  INP(26) = (optional) MRTC calculated preferred dates separated"
^XWB(8994,3508,2,1,1,60,0)="                       by pipe |"
^XWB(8994,3508,2,1,1,61,0)="                    Each date can be in external format with no time."
^XWB(8994,3508,2,"B","INP",1)=""
^XWB(8994,3508,2,"PARAMSEQ",1,1)=""
^XWB(8994,3508,3,0)="^^2^2^3150128^"
^XWB(8994,3508,3,1,0)="Return a single entry in the Global Array with the fields ERRORID and "
^XWB(8994,3508,3,2,0)="ERRORTEXT"
^XWB(8994,3509,0)="SDEC WLGET^WLGET^SDEC^4^R^0^^0"
^XWB(8994,3509,1,0)="^8994.01^1^1^3200513^^^^"
^XWB(8994,3509,1,1,0)="Waitlist GET"
^XWB(8994,3509,2,0)="^8994.02A^7^7"
^XWB(8994,3509,2,1,0)="WLIEN1^1^^0^1"
^XWB(8994,3509,2,1,1,0)="^8994.021^1^1^3150806^^"
^XWB(8994,3509,2,1,1,1,0)="Wait List ID pointer to the SD WAIT LIST file 409.3"
^XWB(8994,3509,2,2,0)="MAXREC^1^^0^2"
^XWB(8994,3509,2,2,1,0)="^8994.021^1^1^3150806^^"
^XWB(8994,3509,2,2,1,1,0)="Max records returned"
^XWB(8994,3509,2,3,0)="SDBEG^1^^0^3"
^XWB(8994,3509,2,3,1,0)="^8994.021^2^2^3150806^^"
^XWB(8994,3509,2,3,1,1,0)="Begin date in external format"
^XWB(8994,3509,2,3,1,2,0)="defaults to Jan 1, 1800"
^XWB(8994,3509,2,4,0)="SDEND^1^^0^4"
^XWB(8994,3509,2,4,1,0)="^8994.021^2^2^3150806^^"
^XWB(8994,3509,2,4,1,1,0)="End date in external format."
^XWB(8994,3509,2,4,1,2,0)="Defaults to 90 days before TODAY"
^XWB(8994,3509,2,5,0)="DFN^1^^0^5"
^XWB(8994,3509,2,5,1,0)="^^1^1^3150806^"
^XWB(8994,3509,2,5,1,1,0)="Patient ID pointer to PATIENT file 2 "
^XWB(8994,3509,2,6,0)="LASTSUB^1^^0^6"
^XWB(8994,3509,2,6,1,0)="^^2^2^3150806^"
^XWB(8994,3509,2,6,1,1,0)="only used if DFN="""""
^XWB(8994,3509,2,6,1,2,0)="Last subscripts from previous call"
^XWB(8994,3509,2,7,0)="SDTOP^1^^0^7"
^XWB(8994,3509,2,7,1,0)="^8994.021^1^1^3200513^^^"
^XWB(8994,3509,2,7,1,1,0)="runs through the xrefs in reverse using -1 in $O  0=forward; 1=reverse"
