^XWB(8994,3864,2,7,1,11,0)="  p3=Material Cost - Number 0-20000, 0 decimals"
^XWB(8994,3864,2,7,1,12,0)="  p4=level - Free text 1-12, can have more than one (i.e., 6,5)"
^XWB(8994,3864,2,7,1,13,0)="  p5=procedure - internal reference to ^ENG(6914.2)"
^XWB(8994,3864,2,7,1,14,0)="  p6=starting year - 4 digits 1900-2100"
^XWB(8994,3864,2,7,1,15,0)=" "
^XWB(8994,3864,2,7,1,16,0)="Send ""@"" for the Hours piece if deleting this secondary multiple from the "
