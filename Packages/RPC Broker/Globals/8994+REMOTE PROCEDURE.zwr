^XWB(8994,3703,2,"B","PAR5",8)=""
^XWB(8994,3703,2,"B","RETSTA",1)=""
^XWB(8994,3703,2,"PARAMSEQ",1,2)=""
^XWB(8994,3703,2,"PARAMSEQ",2,3)=""
