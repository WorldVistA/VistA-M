^XWB(8994,4909,0)="SDES2 CREATE CLINIC^CREATECLINIC^SDES2CREATECLIN^2^R^^^^^^1"
^XWB(8994,4909,1,0)="^^4^4^3250213^"
^XWB(8994,4909,1,1,0)="This RPC will add and define a new clinic in the HOSPITAL LOCATION"
^XWB(8994,4909,1,2,0)="file (#44)."
^XWB(8994,4909,1,3,0)=" "
^XWB(8994,4909,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,4909,2,0)="^8994.02A^2^2"
^XWB(8994,4909,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,4909,2,1,1,0)="^^13^13^3240617^"
^XWB(8994,4909,2,1,1,1,0)="This array contains the needed audit information as defined by the "
^XWB(8994,4909,2,1,1,2,0)="Acheron system."
^XWB(8994,4909,2,1,1,3,0)=" "
^XWB(8994,4909,2,1,1,4,0)="SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,4909,2,1,1,5,0)="                          Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,4909,2,1,1,6,0)="SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action on the"
^XWB(8994,4909,2,1,1,7,0)="                        calling application. "
^XWB(8994,4909,2,1,1,8,0)="SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,4909,2,1,1,9,0)="                        calling application."
^XWB(8994,4909,2,1,1,10,0)="SDCONTEXT(""PATIENT DFN"") = The name of the patient taking action on the"
^XWB(8994,4909,2,1,1,11,0)="                           calling application."
^XWB(8994,4909,2,1,1,12,0)="SDCONTEXT(""PATIENT ICN"") = The ICN of the patient taking action on the"
^XWB(8994,4909,2,1,1,13,0)="                           calling application."
^XWB(8994,4909,2,2,0)="SDCLINIC^2^32000^1^2"
^XWB(8994,4909,2,2,1,0)="^8994.021^61^61^3250213^^"
^XWB(8994,4909,2,2,1,1,0)="The SDCLINIC array contains all the input parameters needed to add and "
^XWB(8994,4909,2,2,1,2,0)="configure a clinic in the HOSPITAL LOCATION (#44) file."
^XWB(8994,4909,2,2,1,3,0)=" "
^XWB(8994,4909,2,2,1,4,0)="Required Variables:"
^XWB(8994,4909,2,2,1,5,0)="==================="
^XWB(8994,4909,2,2,1,6,0)="SDCLINIC(""ALLOWABLE CONSECUTIVE NO-SHOWS"")"
^XWB(8994,4909,2,2,1,7,0)="SDCLINIC(""DIRECT PATIENT SCHEDULING"")"
^XWB(8994,4909,2,2,1,8,0)="SDCLINIC(""DISPLAY APPOINTMENTS"")"
^XWB(8994,4909,2,2,1,9,0)="SDCLINIC(""DISPLAY INCREMENTS PER HOUR"")"
^XWB(8994,4909,2,2,1,10,0)="SDCLINIC(""DIVISION"")"
^XWB(8994,4909,2,2,1,11,0)="SDCLINIC(""E-CHECKIN ALLOWED"")"
^XWB(8994,4909,2,2,1,12,0)="SDCLINIC(""LENGTH OF APPOINTMENT"")"
^XWB(8994,4909,2,2,1,13,0)="SDCLINIC(""MAX DAYS FUTURE BOOKING"")"
^XWB(8994,4909,2,2,1,14,0)="SDCLINIC(""MEETS AT FACILITY"")"
^XWB(8994,4909,2,2,1,15,0)="SDCLINIC(""NAME"")"
^XWB(8994,4909,2,2,1,16,0)="SDCLINIC(""NON-COUNT"")"
^XWB(8994,4909,2,2,1,17,0)="SDCLINIC(""OVERBOOKS/DAY MAX"")"
^XWB(8994,4909,2,2,1,18,0)="SDCLINIC(""PRE-CHECKIN ALLOWED"")"
^XWB(8994,4909,2,2,1,19,0)="SDCLINIC(""PRIMARY AMIS"")"
^XWB(8994,4909,2,2,1,20,0)="SDCLINIC(""REQUIRE ACTION PROFILES"")"
^XWB(8994,4909,2,2,1,21,0)="SDCLINIC(""SERVICE"")"
^XWB(8994,4909,2,2,1,22,0)="SDCLINIC(""VETERAN SELF-CANCEL"")"
^XWB(8994,4909,2,2,1,23,0)=" "
^XWB(8994,4909,2,2,1,24,0)="Optional Variables:"
^XWB(8994,4909,2,2,1,25,0)="==================="
