^XWB(8994,2908,3,3,0)="."
^XWB(8994,2908,3,4,0)="."
^XWB(8994,2909,0)="MAGQBP FREF^FILEREF^MAGQBPRG^1^R"
^XWB(8994,2909,1,0)="^8994.01^4^4^3090916^^^"
^XWB(8994,2909,1,1,0)="VALIDATES THAT THE FILEPATH IS CONSISTENT WITH VISTA MAGFILE REFERENCE"
^XWB(8994,2909,1,2,0)="SET THE SECOND PIECE TO ""PACS"" IF IT REPRESENTS DICOM"
^XWB(8994,2909,1,3,0)="VALIDATES THAT A JUKEBOX POINTER EXISTS"
^XWB(8994,2909,1,4,0)="RESULT VALUES"
^XWB(8994,2909,2,0)="^8994.02A^4^4"
^XWB(8994,2909,2,1,0)="FILEPATH^1^^1^1"
