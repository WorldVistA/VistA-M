^XWB(8994,2917,2,0)="^8994.02A^7^7"
^XWB(8994,2917,2,1,0)="DFN^1^20^1^1"
^XWB(8994,2917,2,1,1,0)="^8994.021^2^2^3100203^^"
^XWB(8994,2917,2,1,1,1,0)="Internal entry number from Patient file #2"
^XWB(8994,2917,2,1,1,2,0)="[optionally DFN;ICN for remote calls]"
^XWB(8994,2917,2,2,0)="TYPE^1^100^0^2"
^XWB(8994,2917,2,2,1,0)="^8994.021^4^4^3110606^^^"
^XWB(8994,2917,2,2,1,1,0)="The kind(s) of data to return, which may include:"
^XWB(8994,2917,2,2,1,2,0)="  demographics;reactions;problems;vitals;labs;meds;"
^XWB(8994,2917,2,2,1,3,0)="  immunizations;visits;appointments;documents;"
^XWB(8994,2917,2,2,1,4,0)="  procedures;consults"
