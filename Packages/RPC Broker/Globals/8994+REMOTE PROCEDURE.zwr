^XWB(8994,5004,1,7,0)="Can only be invoked by Acheron"
^XWB(8994,5004,2,0)="^8994.02A^2^2"
^XWB(8994,5004,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,5004,2,1,1,0)="^^10^10^3240718^"
^XWB(8994,5004,2,1,1,1,0)="   SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,5004,2,1,1,2,0)="                             Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5004,2,1,1,3,0)="   SDCONTEXT(""USER DUZ"")   = The DUZ of the user taking action on the"
^XWB(8994,5004,2,1,1,4,0)="                             calling application. "
^XWB(8994,5004,2,1,1,5,0)="   SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
