^XWB(8994,587,3,4,0)="If called by CPRS"
^XWB(8994,587,3,5,0)="Format:"
^XWB(8994,587,3,6,0)="Site Name PACT: Primary Care Team/PCP/AP^^Attending^^MH Treatment"
^XWB(8994,587,3,7,0)="Coordinator/MH Team^Inpatient Provider"
^XWB(8994,587,3,8,0)=" "
^XWB(8994,587,3,9,0)="NOTE: Pieces 2 and 4 are no longer returned as separate data elements.  "
^XWB(8994,587,3,10,0)="They have been combined into piece 1. Piece 1 is calculated by PCMM Web "
^XWB(8994,587,3,11,0)="and written to Outpatient Profile/CPRS Header Text (404.41/.06), where it "
^XWB(8994,587,3,12,0)="is read by the RPC code.  There may also be labels indicating Pending or "
^XWB(8994,587,3,13,0)="Remote assignments.  If no value is found, piece 1 will contain ""No PACT"
^XWB(8994,587,3,14,0)="assigned at any VA location"""
^XWB(8994,587,3,15,0)=" "
^XWB(8994,587,3,16,0)="If called by other than CPRS, returns original format:"
^XWB(8994,587,3,17,0)="Primary Care Team^PCP^Attending^Associate Provider^MH Treatment"
^XWB(8994,587,3,18,0)="Coordinator/MH Team^Inpatient Provider"
^XWB(8994,588,0)="ORWPT1 PCDETAIL^PCDETAIL^ORWPT1^2^^^^^^^1"
^XWB(8994,588,1,0)="^^5^5^3140904^"
