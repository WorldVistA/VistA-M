^XWB(8994,3509,3,0)="^^198^198^3200513^"
^XWB(8994,3509,3,1,0)="Return Wait List data in Dataset format with these"
^XWB(8994,3509,3,2,0)="          columns:"
^XWB(8994,3509,3,3,0)="   DFN [1] ^ PATIENT NAME [2] ^ <not used> [3] ^ DOB [4] ^ SSN [5]"
^XWB(8994,3509,3,4,0)="   ^ GENDER [6] ^ WAIT LIST IEN [7] "
^XWB(8994,3509,3,5,0)="   ^ ORIGINATING DATE [8] ^ INSTITUTION IEN [9] ^ INSTITUTION NAME [10]"
^XWB(8994,3509,3,6,0)="   ^ WAIT LIST TYPE [11] ^ WL SPECIFIC TEAM [12] "
^XWB(8994,3509,3,7,0)="   ^ WL SPECIFIC POSITION [13] ^ WL SERVICE/SPECIALTY IEN [14] "
^XWB(8994,3509,3,8,0)="   ^ WL SERVICE/SPECIALTY NAME [15] "
^XWB(8994,3509,3,9,0)="   ^ WL SPECIFIC CLINIC IEN [16] ^ WLSPECIFIC CLINIC NAME [17] "
^XWB(8994,3509,3,10,0)="   ^ ORIGINATING USER IEN [18] ^ ORIGINATING USER NAME [19} ^ PRIORITY "
^XWB(8994,3509,3,11,0)="[20]"
^XWB(8994,3509,3,12,0)="   ^ REQUEST BY [21] ^ PROVIDER IEN [22] "
^XWB(8994,3509,3,13,0)="   ^ PROVIDER NAME [23] ^ DESIRED DATE OF APPOINTMENT [24] ^ COMMENTS "
^XWB(8994,3509,3,14,0)="[25] "
^XWB(8994,3509,3,15,0)="   ^ EWL ENROLLEE STATUS [26] "
^XWB(8994,3509,3,16,0)="   ^ PTPHONE [27] phone number (residence) from patient demographics "
^XWB(8994,3509,3,17,0)="   ^ ENROLLMENT PRIORITY [28] - Valid Values are: "
^XWB(8994,3509,3,18,0)="                                GROUP 1 "
^XWB(8994,3509,3,19,0)="                                GROUP 2 "
^XWB(8994,3509,3,20,0)="                                GROUP 3 "
^XWB(8994,3509,3,21,0)="                                GROUP 4 "
^XWB(8994,3509,3,22,0)="                                GROUP 5 "
^XWB(8994,3509,3,23,0)="                                GROUP 6 "
^XWB(8994,3509,3,24,0)="                                GROUP 7 "
^XWB(8994,3509,3,25,0)="                                GROUP 8 "
^XWB(8994,3509,3,26,0)="   ^ APPT SCHEDULED DATE [29] "
^XWB(8994,3509,3,27,0)="   ^ MULTIPLE APPOINTMENT RTC 0=NO; 1=YES [30] "
^XWB(8994,3509,3,28,0)="   ^ MULT APPT RTC INTERVAL-Integer between 1-365 [31] "
^XWB(8994,3509,3,29,0)="   ^ MULT APPT NUMBER-Integer between 1-100 [32] "
^XWB(8994,3509,3,30,0)="   ^ PRIGRP [33] ^ ELIGIEN [34] ELIGNAME [35] ^ SVCCONN [36] ^ "
^XWB(8994,3509,3,31,0)="SVCCONNP[37]"
^XWB(8994,3509,3,32,0)="   ^ TYPEIEN [38] ^ TYPENAME [39] ^ PCONTACT [40] ^ WLDISPD [41] "
^XWB(8994,3509,3,33,0)="   ^ WLDISPU [42] ^ WLDISPUN [43] ^ WLSVCCON [44] ^ PADDRES1 [45] "
^XWB(8994,3509,3,34,0)="   ^ PADDRES2 [46] ^ PADDRES3 [47] ^ CITY [48] ^ PSTATE [49] ^ COUNTRY "
^XWB(8994,3509,3,35,0)="[50]"
^XWB(8994,3509,3,36,0)="   ^ ZIP4 [51] ^ GAF [52]  ^ DATE/TIME ENTERED [53] ^ MTRCDATES [54] "
^XWB(8994,3509,3,37,0)="   ^ SENSITIVE [55] ^ LASTSUB [56] ^ PRACE [57] ^ PRACEN [58] "
^XWB(8994,3509,3,38,0)="   ^ PETH [59] ^ PETHN [60] ^ APPTYPE [61] ^ PRHBLOC[62] "
^XWB(8994,3509,3,39,0)=" 63 RET(""HRN"") = health record number "
^XWB(8994,3509,3,40,0)=" 64 RET(""BADADD"") = BAD ADDRESS INDICATOR (.121) "
^XWB(8994,3509,3,41,0)="                    1=UNDELIVERABLE "
