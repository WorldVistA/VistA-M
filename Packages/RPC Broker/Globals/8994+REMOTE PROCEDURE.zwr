^XWB(8994,3464,3,0)="^8994.03^8^8^3150219^^^"
^XWB(8994,3464,3,1,0)="This will return a list of treating facilities in the following format:"
^XWB(8994,3464,3,2,0)=" "
^XWB(8994,3464,3,3,0)=" ID^IDTYPE^SiteHash^AssigningAuthority^IDSTatus"
^XWB(8994,3464,3,4,0)=" "
^XWB(8994,3464,3,5,0)="Examples:"
^XWB(8994,3464,3,6,0)=" RETURN(1)=27^PI^D17^USVHA^H"""
^XWB(8994,3464,3,7,0)=" RETURN(2)=7169806^PI^D17^USHVA^A"""
^XWB(8994,3464,3,8,0)=" RETURN(3)=1^NI^200DOD^USDOD^A"""
