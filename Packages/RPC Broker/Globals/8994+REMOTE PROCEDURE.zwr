^XWB(8994,3841,2,1,1,2,0)="Not Required - defaults to ""1"""
^XWB(8994,3841,2,1,1,3,0)="Valid values are ""1"" or ""-1"""
^XWB(8994,3841,2,1,1,4,0)="Tells the RPC whether to move forward of backward by the NOREC"
^XWB(8994,3841,2,2,0)="NOREC^1^4^0^2"
^XWB(8994,3841,2,2,1,0)="^8994.021^2^2^3130725^^"
^XWB(8994,3841,2,2,1,1,0)="NOREC"
