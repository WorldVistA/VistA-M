^XWB(8994,3509,3,186,0)="              | <diagnosis by name>"
^XWB(8994,3509,3,187,0)=" "
^XWB(8994,3509,3,188,0)="--[40] PCONTACT Patient Contact"
^XWB(8994,3509,3,189,0)=" PATIENT CONTACT pieced by :: where each :: piece contains the"
^XWB(8994,3509,3,190,0)="                 following ~~ pieces:"
^XWB(8994,3509,3,191,0)="   1. DATE ENTERED external date/time"
^XWB(8994,3509,3,192,0)="   2. PC ENTERED BY USER IEN Pointer to NEW PERSON file"
^XWB(8994,3509,3,193,0)="   3. PC ENTERED BY USER NAME NAME from NEW PERSION file"
^XWB(8994,3509,3,194,0)="   4. ACTION C=Called; M=Message Left"
^XWB(8994,3509,3,195,0)="   5. PATIENT PHONE Free-Text 4-20 characters "
^XWB(8994,3509,3,196,0)=" "
^XWB(8994,3509,3,197,0)=" --[29] APPT SCHEDULED DATE"
^XWB(8994,3509,3,198,0)="NO LONGER USED"
^XWB(8994,3510,0)="SDEC WLCLOSE^WLCLOSE^SDEC^1^R^0^^0"
^XWB(8994,3510,1,0)="^8994.01^2^2^3150806^^^"
^XWB(8994,3510,1,1,0)=" Remove a Patient from the Wait List by setting the STATUS to CLOSED"
^XWB(8994,3510,1,2,0)=" and updating the DISPOSITION fields."
^XWB(8994,3510,2,0)="^8994.02A^1^1"
^XWB(8994,3510,2,1,0)="INP^1^^1^1"
^XWB(8994,3510,2,1,1,0)="^8994.021^5^5^3150806^^"
^XWB(8994,3510,2,1,1,1,0)="INP - Input parameters array"
^XWB(8994,3510,2,1,1,2,0)="      INP(1) - Waitlist ID - Pointer to SD WAIT LIST file"
^XWB(8994,3510,2,1,1,3,0)="      INP(2) - Disposition"
^XWB(8994,3510,2,1,1,4,0)="      INP(3) - User Id - Pointer to NEW PERSON file"
^XWB(8994,3510,2,1,1,5,0)="      INP(4) - Date Dispositioned in external form"
^XWB(8994,3510,2,"B","INP",1)=""
^XWB(8994,3510,2,"PARAMSEQ",1,1)=""
^XWB(8994,3510,3,0)="^8994.03^2^2^3150806^^^"
^XWB(8994,3510,3,1,0)=" This RPC returns the IEN of the closed entry if successful;"
^XWB(8994,3510,3,2,0)=" otherwise, it returns -1^<error message>."
^XWB(8994,3511,0)="SDEC SVSPALL^SVSPALL^SDEC^4^R^0^^0"
^XWB(8994,3511,1,0)="^8994.01^2^2^3150128^^^"
^XWB(8994,3511,1,1,0)=" Return the IEN and NAME for all entries in the SD WL SERVICE/SPECIALTY "
^XWB(8994,3511,1,2,0)="file"
^XWB(8994,3511,3,0)="^^2^2^3150128^"
^XWB(8994,3511,3,1,0)="dataset format"
^XWB(8994,3511,3,2,0)=" SERVICESPECIALTY_IEN ^ SERVICESPECIALTY_NAME"
^XWB(8994,3512,0)="SDEC PROVALL^PROVALL^SDEC^4^R^0^^0"
^XWB(8994,3512,1,0)="^8994.01^1^1^3150806^^"
^XWB(8994,3512,1,1,0)="Return all providers for a given clinic from the HOSPITAL LOCATION file 44"
^XWB(8994,3512,2,0)="^8994.02A^1^1"
^XWB(8994,3512,2,1,0)="SDECCL^1^^1^1"
^XWB(8994,3512,2,1,1,0)="^8994.021^1^1^3150806^^^"
^XWB(8994,3512,2,1,1,1,0)="Clinic ID pointer to HOSPITAL LOCATION file 44"
^XWB(8994,3512,2,"B","SDECCL",1)=""
^XWB(8994,3512,2,"PARAMSEQ",1,1)=""
^XWB(8994,3512,3,0)="^8994.03^4^4^3150806^^^"
^XWB(8994,3512,3,1,0)="Global Array in which each array entry contains provider data separated "
^XWB(8994,3512,3,2,0)="by ^:"
^XWB(8994,3512,3,3,0)=" 1. PROVIDER_IEN"
^XWB(8994,3512,3,4,0)=" 2. PROVIDER_NAME"
^XWB(8994,3513,0)="SDEC CLINALL^CLINALL^SDEC^4^R^0^^0"
^XWB(8994,3513,1,0)="^8994.01^1^1^3150128^^"
^XWB(8994,3513,1,1,0)="Return the IEN and NAME for all entries in the SD WL CLINIC LOCATION file"
^XWB(8994,3513,3,0)="^^5^5^3150128^"
^XWB(8994,3513,3,1,0)="Global Array in which each entry contains the following data from "
^XWB(8994,3513,3,2,0)="the SD WL CLINIC LOCATION file separated by ^:"
^XWB(8994,3513,3,3,0)=" 1. CLINIC_IEN - pointer to SD WL CLINIC LOCATION file"
^XWB(8994,3513,3,4,0)=" 2. CLINIC_NAME -NAME from SD WL CLINIC LOCATION file"
^XWB(8994,3513,3,5,0)=" 3. HOSPITAL_LOCATION_ID - pointer to HOSPITAL LOCATION file 44"
^XWB(8994,3514,0)="SDEC IMHERE^IMHERE^SDEC^1^R^0^^0"
^XWB(8994,3514,1,0)="^8994.01^2^2^3150128^^"
^XWB(8994,3514,1,1,0)=" Returns a simple value to client.  Used to establish continued existence"
^XWB(8994,3514,1,2,0)=" of the client to the server; resets the server READ timeout."
^XWB(8994,3514,3,0)="^^2^2^3150128^"
^XWB(8994,3514,3,1,0)=" Returns a simple value to client.  Used to establish continued existence"
^XWB(8994,3514,3,2,0)=" of the client to the server; resets the server READ timeout."
^XWB(8994,3515,0)="SDEC PWH^PWH^SDEC^4^R^0^^0"
^XWB(8994,3515,1,0)="^8994.01^1^1^3150128^^"
^XWB(8994,3515,1,1,0)=" Return a list of entries from the HEALTH SUMMARY PWH TYPES file."
^XWB(8994,3515,3,0)="^^1^1^3150128^"
^XWB(8994,3515,3,1,0)="returned pointer to list of active Health Summary PWH Types"
^XWB(8994,3516,0)="SDEC HOSPLOC^HOSPLOC^SDEC^4^R^0^^0"
^XWB(8994,3516,1,0)="^^1^1^3150128^"
^XWB(8994,3516,1,1,0)="Get HOSPITAL LOCATIONS"
^XWB(8994,3516,3,0)="^^8^8^3150128^"
^XWB(8994,3516,3,1,0)="Global Array in which each array entry"
^XWB(8994,3516,3,2,0)="contains HOSPITAL LOCATION data separated by ^:"
^XWB(8994,3516,3,3,0)="  1. HOSPITAL_LOCATION_ID"
^XWB(8994,3516,3,4,0)="  2. HOSPITAL_LOCATION"
^XWB(8994,3516,3,5,0)="  3. DEFAULT_PROVIDER"
^XWB(8994,3516,3,6,0)="  4. STOP_CODE_NUMBER"
^XWB(8994,3516,3,7,0)="  5. INACTIVATE_DATE"
^XWB(8994,3516,3,8,0)="  6. REACTIVATE_DATE"
^XWB(8994,3517,0)="SDEC HOLIDAY^HOLIDAY^SDEC^4^R^0^^0"
^XWB(8994,3517,1,0)="^8994.01^1^1^3150128^^"
^XWB(8994,3517,1,1,0)="Remote Procedure to return data for the HOLIDAY file."
^XWB(8994,3517,2,0)="^8994.02A^1^1"
^XWB(8994,3517,2,1,0)="SDECBD^1^^0^1"
^XWB(8994,3517,2,1,1,0)="^^1^1^3150128^"
^XWB(8994,3517,2,1,1,1,0)="Begin date in external format."
^XWB(8994,3517,2,"B","SDECBD",1)=""
^XWB(8994,3517,2,"PARAMSEQ",1,1)=""
^XWB(8994,3517,3,0)="^^4^4^3150128^"
^XWB(8994,3517,3,1,0)="Global Array in which each array entry contains the following Holiday "
^XWB(8994,3517,3,2,0)="data separated by ^:"
^XWB(8994,3517,3,3,0)="  1. SDEC_HOLIDAY_DATE"
^XWB(8994,3517,3,4,0)="  2. HOLIDAY_NAME"
^XWB(8994,3518,0)="SDEC HLTHSUMM^HLTHSUMM^SDEC^4^R^0^^0"
^XWB(8994,3518,1,0)="^^1^1^3150128^"
^XWB(8994,3518,1,1,0)=" Returns the text for a Health Summary report."
^XWB(8994,3518,2,0)="^8994.02A^1^1"
^XWB(8994,3518,2,1,0)="DFN^1^^1^1"
^XWB(8994,3518,2,1,1,0)="^^1^1^3150128^"
^XWB(8994,3518,2,1,1,1,0)="Patient ID pointer to PATIENT file 2."
^XWB(8994,3518,2,"B","DFN",1)=""
^XWB(8994,3518,2,"PARAMSEQ",1,1)=""
^XWB(8994,3518,3,0)="^^1^1^3150128^"
^XWB(8994,3518,3,1,0)="Return a single entry in the recordset - ERRORID."
^XWB(8994,3519,0)="SDEC RESGPUSR^RESGPUSR^SDEC^4^R^0^^0"
^XWB(8994,3519,1,0)="^^6^6^3150505^"
^XWB(8994,3519,1,1,0)="Returns ADO Recordset with all ACTIVE GROUP/RESOURCE combinations"
^XWB(8994,3519,1,2,0)="to which user has access based on entries in SDEC RESOURCE USER file"
^XWB(8994,3519,1,3,0)="If SDECDUZ=0 then returns all ACTIVE GROUP/RESOURCE combinations for "
^XWB(8994,3519,1,4,0)="current DUZ"
^XWB(8994,3519,1,5,0)="If user SDECDUZ possesses the key SDECZMGR"
^XWB(8994,3519,1,6,0)="then ALL ACTIVE resource group names are returned"
^XWB(8994,3519,2,0)="^8994.02A^1^1"
^XWB(8994,3519,2,1,0)="SDECDUZ^1^^1^1"
^XWB(8994,3519,2,1,1,0)="^^1^1^3150128^"
^XWB(8994,3519,2,1,1,1,0)="User ID pointer to NEW PERSON file 200"
^XWB(8994,3519,2,"B","SDECDUZ",1)=""
^XWB(8994,3519,2,"PARAMSEQ",1,1)=""
^XWB(8994,3519,3,0)="^^7^7^3150128^"
^XWB(8994,3519,3,1,0)="Returns a Global Array in which each array entry contains active "
^XWB(8994,3519,3,2,0)="Group/Resource combinations separated by ^:"
^XWB(8994,3519,3,3,0)="  1. RESOURCE_GROUPID"
^XWB(8994,3519,3,4,0)="  2. RESOURCE_GROUP"
^XWB(8994,3519,3,5,0)="  3. RESOURCE_GROUP_ITEMID"
^XWB(8994,3519,3,6,0)="  4. RESOURCE_NAME"
^XWB(8994,3519,3,7,0)="  5. RESOURCEID"
^XWB(8994,3520,0)="SDEC GETFAC^GETFAC^SDEC^4^R^0^^0"
^XWB(8994,3520,1,0)="^^2^2^3150128^"
^XWB(8994,3520,1,1,0)="Remote procedure to return the currently assigned facilities/divisions "
^XWB(8994,3520,1,2,0)="for a given user."
^XWB(8994,3520,2,0)="^8994.02A^1^1"
^XWB(8994,3520,2,1,0)="SDECDUZ^1^^1^1"
^XWB(8994,3520,2,1,1,0)="^^1^1^3150128^"
^XWB(8994,3520,2,1,1,1,0)="User IEN pointer to NEW PERSON file 200"
^XWB(8994,3520,2,"B","SDECDUZ",1)=""
^XWB(8994,3520,2,"PARAMSEQ",1,1)=""
^XWB(8994,3520,3,0)="^^11^11^3150128^"
^XWB(8994,3520,3,1,0)="Global Array in which each array entry"
^XWB(8994,3520,3,2,0)=" contains the following ^ pieces:"
^XWB(8994,3520,3,3,0)="     DIV_IEN  = institution Id pointer to the INSTITUTION file 4"
^XWB(8994,3520,3,4,0)="                NOTE field in file 200 uses the term DIVISION but the"
^XWB(8994,3520,3,5,0)="                field points to the INSTITUTION file."
^XWB(8994,3520,3,6,0)="     DIV_NAME = institution NAME from the INSTITUTION file"
^XWB(8994,3520,3,7,0)="     DEFAULT  = Is default division/facility?"
^XWB(8994,3520,3,8,0)="                Value can be 'YES' or 'NO'"
^XWB(8994,3520,3,9,0)="     TZ_CODE  = CODE from the MAILMAN TIME ZONE file 4.4"
^XWB(8994,3520,3,10,0)="     TZ_NAME  = TIME ZONE NAME from the MAILMAN TIME ZONE file"
^XWB(8994,3520,3,11,0)="     TZ_DIFF  = DIFFERENTIAL from the MAILMAN TIME ZONE file"
^XWB(8994,3521,0)="SDEC GETREGA^GETREGA^SDEC^4^R^0^^0"
^XWB(8994,3521,1,0)="^8994.01^1^1^3211105^^^"
^XWB(8994,3521,1,1,0)="return basic reg info/demographics for given patient"
^XWB(8994,3521,2,0)="^8994.02A^1^1"
^XWB(8994,3521,2,1,0)="DFN^1^^1^1"
^XWB(8994,3521,2,1,1,0)="^8994.021^1^1^3211105^^"
^XWB(8994,3521,2,1,1,1,0)="Patient ID pointer to PATIENT file 2"
^XWB(8994,3521,2,"B","DFN",1)=""
^XWB(8994,3521,2,"PARAMSEQ",1,1)=""
^XWB(8994,3521,3,0)="^^132^132^3220728^"
^XWB(8994,3521,3,1,0)="   a single entry in the global array. "
^XWB(8994,3521,3,2,0)="     1. IEN "
^XWB(8994,3521,3,3,0)="     2. STREET address 1 "
^XWB(8994,3521,3,4,0)="     3. CITY/STATE "
^XWB(8994,3521,3,5,0)="     4. WARD: "
^XWB(8994,3521,3,6,0)="     5. ZIP "
^XWB(8994,3521,3,7,0)="     6. NAME "
^XWB(8994,3521,3,8,0)="     7. DOB "
^XWB(8994,3521,3,9,0)="     8. SSN (LAST 4 DIGITS) "
^XWB(8994,3521,3,10,0)="     9. HRN "
^XWB(8994,3521,3,11,0)="     10. HOMEPHONE - Phone Number (Residence) .131 "
^XWB(8994,3521,3,12,0)="     11. OFCPHONE  - Phone Number (work) .132 "
^XWB(8994,3521,3,13,0)="     12. MSGPHONE  - Temporary Phone Number (.1219) "
^XWB(8994,3521,3,14,0)="                     Sometimes referred to as Phone #2 "
^XWB(8994,3521,3,15,0)="     13. NOK NAME  - Primary NOK "
^XWB(8994,3521,3,16,0)="     14. NOK RELATIONSHIP "
^XWB(8994,3521,3,17,0)="     15. NOK PHONE "
^XWB(8994,3521,3,18,0)="     16. NOK STREET "
^XWB(8994,3521,3,19,0)="     17. NOK CITY "
^XWB(8994,3521,3,20,0)="     18. NOK STATE "
^XWB(8994,3521,3,21,0)="     19. NOK_ZIP "
^XWB(8994,3521,3,22,0)="     20. DATAREVIEWED - <not used?> "
^XWB(8994,3521,3,23,0)="     21. Medicare# "
^XWB(8994,3521,3,24,0)="     22. Suffix "
^XWB(8994,3521,3,25,0)="     23. RegistrationComments  "
^XWB(8994,3521,3,26,0)="     24. GAF - <text> | <GAF score> | <GAF date> | <diagnosis by IEN> "
^XWB(8994,3521,3,27,0)="           | <diagnosis by name> "
^XWB(8994,3521,3,28,0)="     25. PRACE - Patient Race pointer to RACE file 10 "
^XWB(8994,3521,3,29,0)="     26. PRACEN - Patient Race name from RACE file "
^XWB(8994,3521,3,30,0)="     27. PETH - Patient Ethnicity list separated by pipe | "
^XWB(8994,3521,3,31,0)="            Pointer to ETHNICITY file 10.2 "
^XWB(8994,3521,3,32,0)="     28. PETHN - Patient Ethnicity names spearated by pipe | "
^XWB(8994,3521,3,33,0)="     29. PCOUNTRY - Country pointer to COUNTRY CODE file "
^XWB(8994,3521,3,34,0)="     30. GENDER - Patient Gender - valid values are MALE FEMALE "
^XWB(8994,3521,3,35,0)="     31. SENSITIVE [31]- Sensitive Record Access data separated by pipe "
^XWB(8994,3521,3,36,0)="|: "
^XWB(8994,3521,3,37,0)="        1. return code: "
^XWB(8994,3521,3,38,0)="           -1-RPC/API failed "
^XWB(8994,3521,3,39,0)="              Required variable not defined "
^XWB(8994,3521,3,40,0)="            0-No display/action required "
^XWB(8994,3521,3,41,0)="              Not accessing own, employee, or sensitive record "
^XWB(8994,3521,3,42,0)="            1-Display warning message "
^XWB(8994,3521,3,43,0)="              Sensitive and DG SENSITIVITY key holder "
^XWB(8994,3521,3,44,0)="              or Employee and DG SECURITY OFFICER key holder "
^XWB(8994,3521,3,45,0)="            2-Display warning message/require OK to continue "
^XWB(8994,3521,3,46,0)="              Sensitive and not a DG SENSITIVITY key holder "
^XWB(8994,3521,3,47,0)="              Employee and not a DG SECURITY OFFICER key holder "
^XWB(8994,3521,3,48,0)="            3-Access to record denied "
^XWB(8994,3521,3,49,0)="              Accessing own record "
^XWB(8994,3521,3,50,0)="            4-Access to Patient (#2) file records denied "
^XWB(8994,3521,3,51,0)="              SSN not defined "
^XWB(8994,3521,3,52,0)="        2. display text/message "
^XWB(8994,3521,3,53,0)="        3. display text/message "
^XWB(8994,3521,3,54,0)="        4. display text/message "
^XWB(8994,3521,3,55,0)="     32. SVCCONN  - Patient's Service Connected status "
^XWB(8994,3521,3,56,0)="              YES NO "
^XWB(8994,3521,3,57,0)="     33. SVCCONNP - Patient's Service Connected Percentage "
^XWB(8994,3521,3,58,0)="              Numeric 0-100 "
^XWB(8994,3521,3,59,0)="     34. BADADD   - BAD ADDRESS INDICATOR "
^XWB(8994,3521,3,60,0)="               1=UNDELIVERABLE "
^XWB(8994,3521,3,61,0)="               2=HOMELESS "
^XWB(8994,3521,3,62,0)="               3=OTHER "
^XWB(8994,3521,3,63,0)="               4=ADDRESS NOT FOUND "
^XWB(8994,3521,3,64,0)="  35. PADDRES2 - Patient Street Address line 2 "
^XWB(8994,3521,3,65,0)="  36. PADDRES3 - Patient Street Address line 3 "
^XWB(8994,3521,3,66,0)="  37. PCOUNTY - Patient's County "
^XWB(8994,3521,3,67,0)="  38. PCELL - Patient's Cell Phone "
^XWB(8994,3521,3,68,0)="  39. PEMAIL - Patient's Email address "
^XWB(8994,3521,3,69,0)="  40. PMARITAL - Patient Marital Status "
^XWB(8994,3521,3,70,0)="  41. PRELIGION - Patient Religious Preference "
^XWB(8994,3521,3,71,0)="  42. PTADDRESS1 - Patient Temporary Address Line 1 (.1211) "
^XWB(8994,3521,3,72,0)="  43. PTADDRESS2 - Patient Temporary Address Line 2 (.1212) "
^XWB(8994,3521,3,73,0)="  44. PTADDRESS3 - Patient Temporary Address Line 3 (.1213) "
^XWB(8994,3521,3,74,0)="  45. PTCITY - Patient Temporary City (.1214) "
^XWB(8994,3521,3,75,0)="  46. PTSTATE - Patient Temporary State (.1215) "
^XWB(8994,3521,3,76,0)="  47. PTZIP - Patient Temporary Zip (.1216) "
^XWB(8994,3521,3,77,0)="  48. PTZIP+4 - Patient Temporary Zip+4 (.12112) "
^XWB(8994,3521,3,78,0)="  49. PTCOUNTRY - Patient Temporary Country (.1223) "
^XWB(8994,3521,3,79,0)="  50. PTCOUNTY - Patient Temporary County (.12111) "
^XWB(8994,3521,3,80,0)="  51. PTSTART - Patient Temporary Address Start Date (.1217) "
^XWB(8994,3521,3,81,0)="  52. PTEND - Patient Temporary Address End Date (.1218) "
^XWB(8994,3521,3,82,0)="  53. KSTREET2 - Primary Next of Kin Street Address [Line 2] (.214) "
^XWB(8994,3521,3,83,0)="  54. KSTREET3 - Primary Next of Kin Street Address [Line 3] (.215) "
^XWB(8994,3521,3,84,0)="  55. NOK2 - Secondary Next of Kin (.2191) "
^XWB(8994,3521,3,85,0)="  56. K2NAME - Secondary Next of Kin name (.2191) "
^XWB(8994,3521,3,86,0)="  57. K2REL - Secondary Next of Kin Relationship to Patient (.2192) "
^XWB(8994,3521,3,87,0)="  58. K2PHONE - Secondary Next of Kin Phone (.2199) "
^XWB(8994,3521,3,88,0)="  59. K2STREET - Secondary Next of Kin Street Address [Line 1] (.2193) "
^XWB(8994,3521,3,89,0)="  60. K2STREET2 - Secondary Next of Kin Street Address [Line 2] "
^XWB(8994,3521,3,90,0)="                  (.2194) "
^XWB(8994,3521,3,91,0)="  61. K2STREET3 - Secondary Next of Kin Street Address [Line 3] "
^XWB(8994,3521,3,92,0)="                  (.2195) "
^XWB(8994,3521,3,93,0)="  62. K2CITY - Secondary Next of Kin City (.2196) "
^XWB(8994,3521,3,94,0)="  63. K2STATE - Secondary Next of Kin State (.2197) "
^XWB(8994,3521,3,95,0)="  64. K2ZIP - Secondary Next of Kin Zip (.2198) "
^XWB(8994,3521,3,96,0)="  65. PF_FFF - Patient FUGITIVE FELON FLAG 1=YES "
^XWB(8994,3521,3,97,0)="  66. PF_VCD - Patient VETERAN CATASTROPHICALLY DISABLED? Y=YES N=NO "
^XWB(8994,3521,3,98,0)="  67. PFNATIONAL - Patient national Flags "
^XWB(8994,3521,3,99,0)="          (PRF ASSIGNMENT/PRF NATIONAL FLAG) separated by ^ "
^XWB(8994,3521,3,100,0)="    Each ^ piece contains the following | pipe pieces: "
^XWB(8994,3521,3,101,0)="    1. PRFAID - PRF Assignment ID pointer to PRF ASSIGNMENT file "
^XWB(8994,3521,3,102,0)="                (#26.13) "
^XWB(8994,3521,3,103,0)="    2. PRFSTAT - PRF Assignment Status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3521,3,104,0)="    3. PRFNID - PRF National Flag ID pointer to PRF NATIONAL FLAG file "
^XWB(8994,3521,3,105,0)="                (#26.15) "
^XWB(8994,3521,3,106,0)="    4. PRFNNAME - PRF National Flag name "
^XWB(8994,3521,3,107,0)="    5. PRFNSTAT - PRF National Flag status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3521,3,108,0)="  68. PFLOCAL - Patient Local Flags"
^XWB(8994,3521,3,109,0)="                (PRF ASSIGNMENT/PRF Local FLAG) separated by ^ "
^XWB(8994,3521,3,110,0)="   Each ^ piece contains the following | pipe pieces: "
^XWB(8994,3521,3,111,0)="    1. PRFAID - PRF Assignment ID pointer to PRF ASSIGNMENT file "
^XWB(8994,3521,3,112,0)="                (#26.13) "
^XWB(8994,3521,3,113,0)="    2. PRFSTAT - PRF Assignment Status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3521,3,114,0)="    3. PRFLID - PRF Local Flag ID pointer to PRF LOCAL FLAG file "
^XWB(8994,3521,3,115,0)="                (#26.11) "
^XWB(8994,3521,3,116,0)="    4. PRFLNAME - PRF Local Flag name "
^XWB(8994,3521,3,117,0)="    5. PRFLSTAT - PRF Local Flag status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3521,3,118,0)="69. SUBGRP - value from the ENROLLMENT SUBGROUP field of the"
^XWB(8994,3521,3,119,0)="             PATIENT ENROLLMENT file (#27.11) "
^XWB(8994,3521,3,120,0)="              Valid values are a b c d e g "
^XWB(8994,3521,3,121,0)="70. CAT8G  - Category 8g flag - True if PriGRP ='Group 8' AND SUBGRP-'g'"
^XWB(8994,3521,3,122,0)="71. SIMILAR = Similar Patients "
^XWB(8994,3521,3,123,0)="      MESSSAGE | Patients "
^XWB(8994,3521,3,124,0)="       Patients separated by ;; "
^XWB(8994,3521,3,125,0)="        Each ;; piece contains the following ~ pieces "
^XWB(8994,3521,3,126,0)="        DFN ~ NAME ~ DOB ~ SSN (last 4)"
^XWB(8994,3521,3,127,0)="72. PRIGRP - Patient Priority Group"
^XWB(8994,3521,3,128,0)="73. PCP"
^XWB(8994,3521,3,129,0)="74. MHP"
^XWB(8994,3521,3,130,0)="75. PREFGEN  - Patient Self Identified Gender"
^XWB(8994,3521,3,131,0)="76. PREGTIME - Preregistration time stamp"
^XWB(8994,3521,3,132,0)="77. PREFNAME - Preferred Name"
