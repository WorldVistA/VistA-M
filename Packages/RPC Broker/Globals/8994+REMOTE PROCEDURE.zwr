^XWB(8994,3214,1,0)="^^2^2^3130416^"
^XWB(8994,3214,1,1,0)="This API rebuilds the menu trees and display nodes for a single user "
^XWB(8994,3214,1,2,0)="(DUZ). It returns 0 if unsuccessful, 1 if successful."
^XWB(8994,3215,0)="DG VIC PATIENT LOOKUP^RPCVIC^DPTLK^1^P"
^XWB(8994,3215,1,0)="^^4^4^3121024^"
^XWB(8994,3215,1,1,0)="This RPC will allow lookup of a patient with the input from a VIC card or"
^XWB(8994,3215,1,2,0)="DOD CAC card. The VIC card can be an old VIC card or the newer VIC 4.0"
^XWB(8994,3215,1,3,0)="card.  The entire card's input should be provided.  If the patient is"
^XWB(8994,3215,1,4,0)="known locally the patient's DFN will be returned."
^XWB(8994,3215,2,0)="^8994.02A^1^1"
^XWB(8994,3215,2,1,0)="DPTX^1^255^1^1"
^XWB(8994,3215,2,1,1,0)="^8994.021^2^2^3121024^^"
^XWB(8994,3215,2,1,1,1,0)="This should be the entire input from either the Magnetic Strip or the"
^XWB(8994,3215,2,1,1,2,0)="Barcode."
^XWB(8994,3215,2,"B","DPTX",1)=""
^XWB(8994,3215,2,"PARAMSEQ",1,1)=""
^XWB(8994,3215,3,0)="^8994.03^2^2^3121024^^"
^XWB(8994,3215,3,1,0)="If the patient is known locally the patient's DFN is returned.  If not "
^XWB(8994,3215,3,2,0)="then a -1 is returned."
^XWB(8994,3239,0)="DVBAD CONTRACTED EXAM REPORTS^CERPTS^DVBACER1^4^R^0^^1"
^XWB(8994,3239,1,0)="^8994.01^2^2^3111017^^"
^XWB(8994,3239,1,1,0)="Allows demTRAN (GUI) to execute the Detailed, Summary and Timeliness "
^XWB(8994,3239,1,2,0)="contracted exam reports."
^XWB(8994,3239,2,0)="^8994.02A^2^2"
^XWB(8994,3239,2,1,0)="DVBARTYP^1^1^1^1"
^XWB(8994,3239,2,1,1,0)="^^2^2^3111017^"
^XWB(8994,3239,2,1,1,1,0)="The type of contracted exam report to execute: D: Detailed, S: Summary, "
^XWB(8994,3239,2,1,1,2,0)="or T: Timeliness."
^XWB(8994,3239,2,2,0)="DVBAFLTRS^2^^0^2"
^XWB(8994,3239,2,2,1,0)="^^4^4^3111017^"
^XWB(8994,3239,2,2,1,1,0)="Optional parameter that allows filtering the contracted exam results. The "
^XWB(8994,3239,2,2,1,2,0)="filters include DATE, a date range, CONTRACTOR, IEN of specific "
^XWB(8994,3239,2,2,1,3,0)="contractor, PENDING, referred exams only and SORT for grouping results by "
^XWB(8994,3239,2,2,1,4,0)="contractor or request date/time (Used for Detailed Reports Only)."
^XWB(8994,3239,2,"B","DVBAFLTRS",2)=""
^XWB(8994,3239,2,"B","DVBARTYP",1)=""
^XWB(8994,3239,2,"PARAMSEQ",1,1)=""
^XWB(8994,3239,2,"PARAMSEQ",2,2)=""
^XWB(8994,3240,0)="DVBAD CONTRACTED EXAM CRYPTO^EN^DVBACEM1^1^R^0"
^XWB(8994,3240,1,0)="^^2^2^3120724^"
^XWB(8994,3240,1,1,0)="Allows the demTRAN (GUI) application to Encrypt/Decrypt information for "
^XWB(8994,3240,1,2,0)="storage to or retrieval from the VistA environment."
^XWB(8994,3240,2,0)="^8994.02A^2^2"
^XWB(8994,3240,2,1,0)="DVBAETYP^1^1^1^1"
^XWB(8994,3240,2,1,1,0)="^8994.021^2^2^3120724^^"
^XWB(8994,3240,2,1,1,1,0)="The type of cryptography action to execute: 1: Encryption or 2: "
^XWB(8994,3240,2,1,1,2,0)="Decryption."
^XWB(8994,3240,2,2,0)="DVBAIVAL^1^999^1^2"
^XWB(8994,3240,2,2,1,0)="^^2^2^3120724^"
^XWB(8994,3240,2,2,1,1,0)="The single or '^' delimited string value(s) to perform the cryptography "
^XWB(8994,3240,2,2,1,2,0)="action on."
^XWB(8994,3240,2,"B","DVBAETYP",1)=""
^XWB(8994,3240,2,"B","DVBAIVAL",2)=""
^XWB(8994,3240,2,"PARAMSEQ",1,1)=""
^XWB(8994,3240,2,"PARAMSEQ",2,2)=""
^XWB(8994,3240,3,0)="^^4^4^3120724^"
^XWB(8994,3240,3,1,0)="Encrypted or Decrypted result(s) based on the cryptography action "
^XWB(8994,3240,3,2,0)="performed. If multiple values passed ('^' delimitted) then the results "
^XWB(8994,3240,3,3,0)="will be returned in the same position as the original value that was "
^XWB(8994,3240,3,4,0)="acted upon."
^XWB(8994,3241,0)="DVBAB SEND MSG TWO^MSG2^DVBAB1A^1^S"
^XWB(8994,3241,1,0)="^8994.01^2^2^3130624^^^^"
^XWB(8994,3241,1,1,0)="THIS RPC IS THE SECOND FOR THE CAPRI MSG 2507 EXAM"
^XWB(8994,3241,1,2,0)="THIS ONE PRODUCES A MESSAGE FOR EACH EXAM THAT IS COMPLETED"
^XWB(8994,3241,2,0)="^8994.02A^5^3"
^XWB(8994,3241,2,3,0)="DUZ^1^^^1"
^XWB(8994,3241,2,3,1,0)="^8994.021^1^1^3130521^^^^"
^XWB(8994,3241,2,3,1,1,0)="PERSON FILE DFN"
^XWB(8994,3241,2,4,0)="RIEN^1^^^2"
^XWB(8994,3241,2,4,1,0)="^8994.021^1^1^3130521^^^"
^XWB(8994,3241,2,4,1,1,0)="2507 REQUEST IEN #396.3"
^XWB(8994,3241,2,5,0)="ELIST^2^^^3"
^XWB(8994,3241,2,5,1,0)="^8994.021^1^1^3130624^^^^"
^XWB(8994,3241,2,5,1,1,0)="2507 EXAM LIST #396.4"
^XWB(8994,3241,2,"B","DUZ",3)=""
^XWB(8994,3241,2,"B","ELIST",5)=""
^XWB(8994,3241,2,"B","RIEN",4)=""
^XWB(8994,3241,2,"PARAMSEQ",1,3)=""
^XWB(8994,3241,2,"PARAMSEQ",2,4)=""
^XWB(8994,3241,2,"PARAMSEQ",3,5)=""
^XWB(8994,3241,3,0)="^8994.03^1^1^3130624^^^^"
^XWB(8994,3241,3,1,0)="ERR   RETURNS THE ERROR MESSAGE OR THE 'MESSAGE SENT'"
^XWB(8994,3242,0)="MAGQ LOGV^ELOGRV^MAGQBPG1^2^R"
^XWB(8994,3242,1,0)="^^4^4^3130321^"
^XWB(8994,3242,1,1,0)="This provides a method of capturing errors logged during the BP Verifier"
^XWB(8994,3242,1,2,0)="process.  This function provides a list which can be examined at a later"
^XWB(8994,3242,1,3,0)="date and will be rolled into verifier log file on the BP Server or network"
^XWB(8994,3242,1,4,0)="log file share."
^XWB(8994,3242,2,0)="^8994.02A^2^2"
^XWB(8994,3242,2,1,0)="NULL^^^0"
^XWB(8994,3242,2,1,1,0)="^^1^1^3130321^"
^XWB(8994,3242,2,1,1,1,0)="No input parameter is defined."
^XWB(8994,3242,2,2,0)="LIMIT^1^5^1^1"
^XWB(8994,3242,2,2,1,0)="^8994.021^1^1^3130325^^"
^XWB(8994,3242,2,2,1,1,0)="This value is used to control the array size."
^XWB(8994,3242,2,"B","LIMIT",2)=""
^XWB(8994,3242,2,"B","NULL",1)=""
^XWB(8994,3242,2,"PARAMSEQ",1,2)=""
^XWB(8994,3242,3,0)="^^3^3^3130321^"
^XWB(8994,3242,3,1,0)="This is a list of the corrupt nodes being killed by the BP Verifier"
^XWB(8994,3242,3,2,0)="application.  It may be also be used for other means of reporting"
^XWB(8994,3242,3,3,0)="host side information."
^XWB(8994,3243,0)="VPR GET PATIENT DATA JSON^GET^VPRDJ^4^S^^^0^1^^1"
^XWB(8994,3243,1,0)="^8994.01^2^2^3121003^^^^"
^XWB(8994,3243,1,1,0)="This RPC retrieves the requested data from VistA, and returns it in"
^XWB(8994,3243,1,2,0)="^TMP(""VPR"",$J,n) as JSON."
^XWB(8994,3243,2,0)="^8994.02A^1^1"
^XWB(8994,3243,2,1,0)="FILTER^2^^0^1"
^XWB(8994,3243,2,1,1,0)="^8994.021^1^1^3120629^^^^"
^XWB(8994,3243,2,1,1,1,0)="List of name-value pairs defining the search."
^XWB(8994,3243,2,"B","FILTER",1)=""
^XWB(8994,3243,2,"PARAMSEQ",1,1)=""
^XWB(8994,3243,3,0)="^8994.03^1^1^3120629^^^^"
^XWB(8994,3243,3,1,0)="Text array formatted as JSON"
^XWB(8994,3244,0)="VPR GET CHECKSUM^CHECK^VPRDCRC^4^S^^^0^1^^1"
^XWB(8994,3244,1,0)="^8994.01^1^1^3130418^^^^"
^XWB(8994,3244,1,1,0)="This RPC retrieves the requested data from VistA and returns its checksum."
^XWB(8994,3244,2,0)="^8994.02A^1^1"
^XWB(8994,3244,2,1,0)="FILTER^2^^0^1"
^XWB(8994,3244,2,1,1,0)="^8994.021^1^1^3130418^^^^"
^XWB(8994,3244,2,1,1,1,0)="List of name-value pairs defining the search."
^XWB(8994,3244,2,"B","FILTER",1)=""
^XWB(8994,3244,2,"PARAMSEQ",1,1)=""
^XWB(8994,3244,3,0)="^8994.03^1^1^3130418^^^^"
^XWB(8994,3244,3,1,0)="The CRC32 checksum value of the data."
^XWB(8994,3245,0)="PSB WITNESS^WITNESS^PSBRPC1^2^P"
^XWB(8994,3245,1,0)="^8994.01^6^6^3130426^^"
^XWB(8994,3245,1,1,0)="Used by frmWintess to validate if a Witness at the client is authorized "
^XWB(8994,3245,1,2,0)="to be a witness for a BCMA action, i.e. High Risk Drug administration."
^XWB(8994,3245,1,3,0)=" "
^XWB(8994,3245,1,4,0)="Validation is achieved via not allowing the logged in person to witness "
^XWB(8994,3245,1,5,0)="for themselves, also persons that hold certain keys can't be a valid "
^XWB(8994,3245,1,6,0)="witness."
^XWB(8994,3245,2,0)="^8994.02A^2^2"
^XWB(8994,3245,2,1,0)="PSBACC^1^^1^1"
^XWB(8994,3245,2,1,1,0)="^^1^1^3120508^"
^XWB(8994,3245,2,1,1,1,0)="Access Code"
^XWB(8994,3245,2,2,0)="PSBVER^1^^1^2"
^XWB(8994,3245,2,2,1,0)="^8994.021^1^1^3130426^^"
^XWB(8994,3245,2,2,1,1,0)="Verify Code."
^XWB(8994,3245,2,"B","PSBACC",1)=""
^XWB(8994,3245,2,"B","PSBVER",2)=""
^XWB(8994,3245,2,"PARAMSEQ",1,1)=""
^XWB(8994,3245,2,"PARAMSEQ",2,2)=""
^XWB(8994,3245,3,0)="^^23^23^3130426^"
^XWB(8994,3245,3,1,0)="Results array is returned in the following forms:"
^XWB(8994,3245,3,2,0)="  "
^XWB(8994,3245,3,3,0)="  Valid authorization of Witness."
^XWB(8994,3245,3,4,0)="   "
^XWB(8994,3245,3,5,0)="      Results[0] = 'Witness DUZ^Witness Name'"
^XWB(8994,3245,3,6,0)="  "
^XWB(8994,3245,3,7,0)="  Invalid authorization of Witness."
^XWB(8994,3245,3,8,0)="   "
^XWB(8994,3245,3,9,0)="      Results[0] = '-1^Invalid Witness sign-on'"
^XWB(8994,3245,3,10,0)="            Or     '-1^Cannot Witness for yourself'"
^XWB(8994,3245,3,11,0)="            Or     '-1^A student does not have authority to witness a "
^XWB(8994,3245,3,12,0)="                       High Risk/High Alert administration.'"
^XWB(8994,3245,3,13,0)="            Or     '-1^You do not have authority to witness a "
^XWB(8994,3245,3,14,0)="                       High Risk/High Alert administration.'"
^XWB(8994,3245,3,15,0)="            Or     '-1^Read-Only users do not have authority to witness a "
^XWB(8994,3245,3,16,0)="                       High Risk/High Alert administration.'"
^XWB(8994,3245,3,17,0)="            Or     '-1^Invalid VistA user - No Primary menu setup for "
^XWB(8994,3245,3,18,0)="                       this user in the NEW PERSON file.'"
^XWB(8994,3245,3,19,0)="            Or     '-1^A non-BCMA user does not have authority to witness "
^XWB(8994,3245,3,20,0)="                       a High Risk/High Alert administration.'"
^XWB(8994,3245,3,21,0)=" "
^XWB(8994,3245,3,22,0)=" Success of the call is validated by the first up-arrow piece of data "
^XWB(8994,3245,3,23,0)=" being greater than 0."
^XWB(8994,3246,0)="PSB CLINICLIST^GETLIST^PSBRPC^4^P^^^1^3"
^XWB(8994,3246,1,0)="^^1^1^3120619^"
^XWB(8994,3246,1,1,0)="Returns Active Clinic names based on Search criteria."
^XWB(8994,3246,2,0)="^8994.02A^2^2"
^XWB(8994,3246,2,1,0)="PREFIX^1^30^0^1"
^XWB(8994,3246,2,1,1,0)="^8994.021^2^2^3120601^^"
^XWB(8994,3246,2,1,1,1,0)="First search criteria, which is used to find clinic names that begin with "
^XWB(8994,3246,2,1,1,2,0)="these characters to create a subset list."
^XWB(8994,3246,2,2,0)="CONTAINS^1^30^0^2"
^XWB(8994,3246,2,2,1,0)="^^4^4^3120531^"
^XWB(8994,3246,2,2,1,1,0)="Second search criteria, if populated, then this search text is used to "
^XWB(8994,3246,2,2,1,2,0)="search the previously created Subset list, for if Contains this text."
^XWB(8994,3246,2,2,1,3,0)=" "
^XWB(8994,3246,2,2,1,4,0)="Then this final list is sent back to the BCMA GUI Client."
^XWB(8994,3246,2,"B","CONTAINS",2)=""
^XWB(8994,3246,2,"B","PREFIX",1)=""
^XWB(8994,3246,2,"PARAMSEQ",1,1)=""
^XWB(8994,3246,2,"PARAMSEQ",2,2)=""
^XWB(8994,3246,3,0)="^8994.03^6^6^3120626^^"
^XWB(8994,3246,3,1,0)="Return a list of active clinics by name, per search request, in the "
^XWB(8994,3246,3,2,0)="Results array."
^XWB(8994,3246,3,3,0)=" "
^XWB(8994,3246,3,4,0)="   Results[0] =  ^1      The number of lines returned(count)"
^XWB(8994,3246,3,5,0)="  "
^XWB(8994,3246,3,6,0)="   Results[n] =  ^1      Clinic Name"
^XWB(8994,3247,0)="PSB MEDS ON PATIENT^MEDSONPT^PSBRPC1^2^S^^^^3"
^XWB(8994,3247,1,0)="^8994.01^4^4^3120929^"
^XWB(8994,3247,1,1,0)="This RPC returns indicators if medications are still on a patient.  The "
^XWB(8994,3247,1,2,0)="patient's DFN will be passed in and a RESULTS array returned with three "
^XWB(8994,3247,1,3,0)="flags set.  Flags set to 1 for meds are on patient or 0 none per this"
^XWB(8994,3247,1,4,0)="category."
^XWB(8994,3247,2,0)="^8994.02A^1^1"
^XWB(8994,3247,2,1,0)="DFN^1^^1^1"
^XWB(8994,3247,2,1,1,0)="^^1^1^3120929^"
^XWB(8994,3247,2,1,1,1,0)="Patient DFN"
^XWB(8994,3247,2,"B","DFN",1)=""
^XWB(8994,3247,2,"PARAMSEQ",1,1)=""
^XWB(8994,3247,3,0)="^^7^7^3120929^"
^XWB(8994,3247,3,1,0)="A string with 3 pieces that indicate if Medications are on a patient per a"
^XWB(8994,3247,3,2,0)="specific category.  "
^XWB(8994,3247,3,3,0)=" "
^XWB(8994,3247,3,4,0)="   Results[0] =  ^1      The number of lines returned(count)"
^XWB(8994,3247,3,5,0)="   Results[1] =  ^1      IV Meds are Infusing (1=exist, 0=do not exist)"
^XWB(8994,3247,3,6,0)="                 ^2      IV Meds are Stopped (1=exist, 0=do not exist)"
^XWB(8994,3247,3,7,0)="                 ^3      Patch on (1=exist, 0=do not exist)"
^XWB(8994,3248,0)="VPS PATIENT CHECK-IN^CHK^VPSRPC4^2^P^0^^^1^^1"
^XWB(8994,3248,1,0)="^^4^4^3120709^"
^XWB(8994,3248,1,1,0)="Called by Vetlink Kiosk system.  The RPC will accept a single value as"
^XWB(8994,3248,1,2,0)="input representing the string of pending appointments that the patient is"
^XWB(8994,3248,1,3,0)="to be checked-in.; and the output produced will be an array that returns"
^XWB(8994,3248,1,4,0)="the results of each attempted check-in."
^XWB(8994,3248,2,0)="^8994.02A^2^1"
^XWB(8994,3248,2,2,0)="VPSAPPTS^1^225^1^1"
^XWB(8994,3248,2,2,1,0)="^8994.021^11^11^3120709^^^^"
^XWB(8994,3248,2,2,1,1,0)="Input: string that represents the appt(s) to be checked in.  Since more "
^XWB(8994,3248,2,2,1,2,0)="than one appt can be checked-in, each appt consists of the DFN, CLINIC "
^XWB(8994,3248,2,2,1,3,0)="ien, and appt date/timestamp.  Each appt is delimited by "";"" and the 3 "
^XWB(8994,3248,2,2,1,4,0)="pieces of data are separated by ""-"".   All 3 data elements in the appt "
^XWB(8994,3248,2,2,1,5,0)="representation are required input."
^XWB(8994,3248,2,2,1,6,0)="Syntax: "
^XWB(8994,3248,2,2,1,7,0)="          input=DFN_""-""_clinic IEN_""-""_date/timestamp of scheduled "
^XWB(8994,3248,2,2,1,8,0)="appt_"";"""
^XWB(8994,3248,2,2,1,9,0)=" "
^XWB(8994,3248,2,2,1,10,0)="example of data string (represents 2 appts):"
^XWB(8994,3248,2,2,1,11,0)="          ""308165-1218-3120420.1215;308165-4569-3120420.1030"""
^XWB(8994,3248,2,"B","VPSAPPTS",2)=""
^XWB(8994,3248,2,"PARAMSEQ",1,2)=""
^XWB(8994,3248,3,0)="^8994.03^9^9^3120709^^^^"
^XWB(8994,3248,3,1,0)="single-dimensional array that represents the result of attempted check-in"
^XWB(8994,3248,3,2,0)="for each appt: "
^XWB(8994,3248,3,3,0)="       1 if check-in successful or '99' if there was a problem."
^XWB(8994,3248,3,4,0)="Syntax:"
^XWB(8994,3248,3,5,0)="RESULT(n)= DFN_""-""_clinicIEN_""-""_date/time of appt_""-""_return value"
^XWB(8994,3248,3,6,0)="example of data output:"
^XWB(8994,3248,3,7,0)="                   RESULT(1)=""308165-1218-3120420.1215-1"""
^XWB(8994,3248,3,8,0)="                   RESULT(2)=""308165-4569-3120420.1030-99"""
^XWB(8994,3248,3,9,0)="                   RESULT(3)=""308165-2312-3120420.1430-1"""
^XWB(8994,3249,0)="VPS PATIENT PRE-REGISTRATION^PREREG^VPSRPC3^1^P^0^^^1^^1"
^XWB(8994,3249,1,0)="^^29^29^3121011^"
^XWB(8994,3249,1,1,0)="There are  2 input parameters for the RPC call  sent by the Vetlink kiosk "
^XWB(8994,3249,1,2,0)="Pre-registration event."
^XWB(8994,3249,1,3,0)="Inputs:  DFN and Status Code."
^XWB(8994,3249,1,4,0)="Patient DFN -1st input parameter of the RPC call, required. "
^XWB(8994,3249,1,5,0)="Status Code - code that represents the outcome of the pre-registration "
^XWB(8994,3249,1,6,0)="interview with the patient, required.  List of possible codes that could "
^XWB(8994,3249,1,7,0)="be sent:"
^XWB(8994,3249,1,8,0)="B = BUSY"
^XWB(8994,3249,1,9,0)="C = CONNECTED"
^XWB(8994,3249,1,10,0)="D = DEATH"
^XWB(8994,3249,1,11,0)="K = CALL BACK"
^XWB(8994,3249,1,12,0)="M =LEFT CALLBACK MESSAGE"
^XWB(8994,3249,1,13,0)="N = NO ANSWER"
^XWB(8994,3249,1,14,0)="P = NO PHONE"
^XWB(8994,3249,1,15,0)="T = DON'T CALL"
^XWB(8994,3249,1,16,0)="U = UNCOOPERATIVE"
^XWB(8994,3249,1,17,0)="V = PREVIOUSLY UPDATED"
^XWB(8994,3249,1,18,0)="W =WRONG NUMBER"
^XWB(8994,3249,1,19,0)="X = CHANGE INFORMATION"
^XWB(8994,3249,1,20,0)=" "
^XWB(8994,3249,1,21,0)="Output:  string consisting of a single digit to denote success or failure "
^XWB(8994,3249,1,22,0)="of the pre-registration, followed by a short message:     1 if "
^XWB(8994,3249,1,23,0)="pre-registration was successful or 0 if there was a problem."
^XWB(8994,3249,1,24,0)="Syntax to indicate success:"
^XWB(8994,3249,1,25,0)=" VPSRES=""1,Pre-Registration completed."""
^XWB(8994,3249,1,26,0)="Syntax to indicate a failure:"
^XWB(8994,3249,1,27,0)=" VPSRES=""0,Patient nof found."""
^XWB(8994,3249,1,28,0)=" VPSRES=""0,Invalid SSN for this patient."""
^XWB(8994,3249,1,29,0)=" VPSRES=""0,Unable to add Pre-Registration."""
^XWB(8994,3249,2,0)="^8994.02A^2^2"
^XWB(8994,3249,2,1,0)="DFN^1^30^1^1"
^XWB(8994,3249,2,1,1,0)="^8994.021^2^2^3120705^^^^"
^XWB(8994,3249,2,1,1,1,0)="Input: the patient's internal entry number (IEN) from file #2. Only one "
^XWB(8994,3249,2,1,1,2,0)="DFN is allowed to be passed in, required."
^XWB(8994,3249,2,2,0)="VPSCST^1^1^1^2"
^XWB(8994,3249,2,2,1,0)="^^2^2^3121011^"
^XWB(8994,3249,2,2,1,1,0)="Input: the call status code, either 'C' (Connected) or 'X' (Change "
^XWB(8994,3249,2,2,1,2,0)="Information), required."
^XWB(8994,3249,2,"B","DFN",1)=""
^XWB(8994,3249,2,"B","VPSCST",2)=""
^XWB(8994,3249,2,"PARAMSEQ",1,1)=""
^XWB(8994,3249,2,"PARAMSEQ",2,2)=""
^XWB(8994,3249,3,0)="^8994.03^11^11^3121011^^^^"
^XWB(8994,3249,3,1,0)="Output: string consisting of a single digit to denote success or failure "
^XWB(8994,3249,3,2,0)="of the pre-registration, followed by a short message:"
^XWB(8994,3249,3,3,0)=" 1 if pre-registration was successful or 0 if there was a problem."
^XWB(8994,3249,3,4,0)=" "
^XWB(8994,3249,3,5,0)="Syntax to indicate success:"
^XWB(8994,3249,3,6,0)="VPSRES=""1, Pre-Registration completed."""
^XWB(8994,3249,3,7,0)=" "
^XWB(8994,3249,3,8,0)="Syntax to indicate a failure:"
^XWB(8994,3249,3,9,0)="VPSRES=""0, Patient not found."""
^XWB(8994,3249,3,10,0)="VPSRES=""0, Invalid SSN for this patient."""
^XWB(8994,3249,3,11,0)="VPSRES=""0, Unable to add Pre-Registration."""
^XWB(8994,3250,0)="VPS EDIT PATIENT DEMOGRAPHIC^EDIT^VPSRPC2^2^P^0^1^1^1^^1"
^XWB(8994,3250,1,0)="^8994.01^8^8^3130306^^"
^XWB(8994,3250,1,1,0)="Called by the Vetlink Kiosk system. The VAMC staff will make changes to"
^XWB(8994,3250,1,2,0)="the patient demographic record via the Vecna Kiosk and submit the changes"
^XWB(8994,3250,1,3,0)="to VistA.  The RPC will accept 3 parameters.  The first parameter"
^XWB(8994,3250,1,4,0)="represents the return value as required by RPC Broker, the 2nd parameter"
^XWB(8994,3250,1,5,0)="is an input value which is the patient DFN, and the 3rd parameter is an"
^XWB(8994,3250,1,6,0)="input value which is the list of data changes that will update one to many"
^XWB(8994,3250,1,7,0)="fields in the PATIENT file (#2).  Integration Agreement 5799 identifies"
^XWB(8994,3250,1,8,0)="the fields that could potentially be edited."
^XWB(8994,3250,2,0)="^8994.02A^2^2"
^XWB(8994,3250,2,1,0)="VPSDFN^1^30^1^1"
^XWB(8994,3250,2,1,1,0)="^8994.021^2^2^3120705^^^"
^XWB(8994,3250,2,1,1,1,0)="The patient DFN which is to be used in processing the changes and updating"
^XWB(8994,3250,2,1,1,2,0)="the associated patient record in the PATIENT file (#2)."
^XWB(8994,3250,2,2,0)="VPSLST^2^^1^2"
^XWB(8994,3250,2,2,1,0)="^8994.021^6^6^3130306^^^^"
^XWB(8994,3250,2,2,1,1,0)="Local array where each field that is to be updated in the PATIENT file "
^XWB(8994,3250,2,2,1,2,0)="(#2) is assigned as a string to the data element in the array along with "
^XWB(8994,3250,2,2,1,3,0)="the field value."
^XWB(8994,3250,2,2,1,4,0)="input structure: "
^XWB(8994,3250,2,2,1,5,0)=" LocalArray(n)=field label^data  "
^XWB(8994,3250,2,2,1,6,0)="where n is an incremental number and field label^data  are literal values"
^XWB(8994,3250,2,"B","VPSDFN",1)=""
^XWB(8994,3250,2,"B","VPSLST",2)=""
^XWB(8994,3250,2,"PARAMSEQ",1,1)=""
^XWB(8994,3250,2,"PARAMSEQ",2,2)=""
^XWB(8994,3250,3,0)="^8994.03^9^9^3130306^^^^"
^XWB(8994,3250,3,1,0)="Local ARRAY that returns the outcome of the EDIT operation."
^XWB(8994,3250,3,2,0)="output structure:"
^XWB(8994,3250,3,3,0)="LocalArray(n)=""field label^data^1""  "
^XWB(8994,3250,3,4,0)="where 1 equals successful update to the database of the specific field "
^XWB(8994,3250,3,5,0)="declared at field label.  "
^XWB(8994,3250,3,6,0)=" "
^XWB(8994,3250,3,7,0)="LocalArray(n)=""99^field label^data ^exception message""  "
^XWB(8994,3250,3,8,0)="where 99 means an exception and no update was made to the database for "
^XWB(8994,3250,3,9,0)="that specific field and exception message describes the error."
^XWB(8994,3251,0)="VPS GET SITES^GETSITES^VPSRPC5^2^P^0^^^1^^1"
^XWB(8994,3251,1,0)="^^3^3^3120709^"
^XWB(8994,3251,1,1,0)="Called by the Vetlink Kiosk system.  Patient SSN is the input value.  "
^XWB(8994,3251,1,2,0)="Return value is a list of treating facilities associated with the patient "
^XWB(8994,3251,1,3,0)="given the SSN."
^XWB(8994,3251,2,0)="^8994.02A^2^1"
^XWB(8994,3251,2,2,0)="VPSSN^1^12^1^1"
^XWB(8994,3251,2,2,1,0)="^8994.021^1^1^3120709^^^"
^XWB(8994,3251,2,2,1,1,0)="Patient SSN"
^XWB(8994,3251,2,"B","VPSSN",2)=""
^XWB(8994,3251,2,"PARAMSEQ",1,2)=""
^XWB(8994,3251,3,0)="^8994.03^11^11^3120709^^"
^XWB(8994,3251,3,1,0)="Local ARRAY that returns the list of treating facilities by a given "
^XWB(8994,3251,3,2,0)="patient."
^XWB(8994,3251,3,3,0)="output structure:"
^XWB(8994,3251,3,4,0)=" LocalArray(n)=""1^SITE ID"""
^XWB(8994,3251,3,5,0)=" "
^XWB(8994,3251,3,6,0)="where 1 equals successful return of facility's site id at which the "
^XWB(8994,3251,3,7,0)="patient has been treated(e.g.,500 for Albany VAMC)."
^XWB(8994,3251,3,8,0)=" "
^XWB(8994,3251,3,9,0)="LocalArray(n)=""99^text""  "
^XWB(8994,3251,3,10,0)="where 99 means an exception has occurred and text is a description of the"
^XWB(8994,3251,3,11,0)="exception."
^XWB(8994,3252,0)="VPS GET DFN^GETDFN^VPSRPC5^1^P^0^^^^^1"
^XWB(8994,3252,1,0)="^8994.01^2^2^3130501^^^"
^XWB(8994,3252,1,1,0)="Called by the Vetlink Kiosk system.  Patient SSN is the input value.  "
^XWB(8994,3252,1,2,0)="Returns patient DFN associated with SSN on record."
^XWB(8994,3252,2,0)="^8994.02A^1^1"
^XWB(8994,3252,2,1,0)="VPSSN^1^12^1^2"
^XWB(8994,3252,2,"B","VPSSN",1)=""
^XWB(8994,3252,2,"PARAMSEQ",2,1)=""
^XWB(8994,3252,3,0)="^8994.03^8^8^3130501^^"
^XWB(8994,3252,3,1,0)="Patient DFN will be returned.  Otherwise if no record found using the "
^XWB(8994,3252,3,2,0)="passed in SSN value then exception value is returned."
^XWB(8994,3252,3,3,0)=" "
^XWB(8994,3252,3,4,0)="Success:"
^XWB(8994,3252,3,5,0)="=""1^""_DFN"
^XWB(8994,3252,3,6,0)=" "
^XWB(8994,3252,3,7,0)="Exception:"
^XWB(8994,3252,3,8,0)="=""99^""_exception text"
^XWB(8994,3253,0)="VPS FULLSSN^FULLSSN^VPSRPC5^2^R^0"
^XWB(8994,3253,1,0)="^8994.01^1^1^3120915^^^"
^XWB(8994,3253,1,1,0)="Returns a list of patients with SSNs that match the value stored in ID."
^XWB(8994,3253,2,0)="^8994.02A^1^1"
^XWB(8994,3253,2,1,0)="SSN^1^10^1^1"
^XWB(8994,3253,2,1,1,0)="^8994.021^1^1^3120915^^"
^XWB(8994,3253,2,1,1,1,0)="Patient's 9-digit SSN value."
^XWB(8994,3253,2,"B","SSN",1)=""
^XWB(8994,3253,2,"PARAMSEQ",1,1)=""
^XWB(8994,3253,3,0)="^8994.03^4^4^3120915^^^"
^XWB(8994,3253,3,1,0)="LST is an array passed by reference and will contain a list of patients"
^XWB(8994,3253,3,2,0)=" that have an SSN matching the value in SSN.  The results will have"
^XWB(8994,3253,3,3,0)=" for each matching patient the patient's IEN in file #2, full name,"
^XWB(8994,3253,3,4,0)=" date of birth, and SSN."
^XWB(8994,3254,0)="VPS LAST5^LAST5^VPSRPC5^2^R^0^^^1"
^XWB(8994,3254,1,0)="^^2^2^3120915^"
^XWB(8994,3254,1,1,0)=" Returns a list of patients matching LastNameInitial_Last4SSN based on"
^XWB(8994,3254,1,2,0)="Restricted Patient List."
^XWB(8994,3254,2,0)="^8994.02A^1^1"
^XWB(8994,3254,2,1,0)="VPSID^1^30^1^1"
^XWB(8994,3254,2,1,1,0)="^8994.021^2^2^3120915^^"
^XWB(8994,3254,2,1,1,1,0)="String literal containing patient's last name initial and last 4-digits of"
^XWB(8994,3254,2,1,1,2,0)="the SSN i.e., ""T9999""."
^XWB(8994,3254,2,"B","VPSID",1)=""
^XWB(8994,3254,2,"PARAMSEQ",1,1)=""
^XWB(8994,3254,3,0)="^^3^3^3120915^"
^XWB(8994,3254,3,1,0)="LIST is an array, passed by reference, containing patients with last name"
^XWB(8994,3254,3,2,0)="initial and last 4-digits that match the input parameter, ID, value. Each"
^XWB(8994,3254,3,3,0)="element of list will contain the IEN^FULLNAME^DOB^SSN."
^XWB(8994,3255,0)="VPS LIST ALL^LISTALL^VPSRPC5^2^R^0^^^1"
^XWB(8994,3255,1,0)="^8994.01^19^19^3121213^^"
^XWB(8994,3255,1,1,0)="Returns a list of patients with names start with (** NOT PREFIXED BY **) "
^XWB(8994,3255,1,2,0)="the input value. Only 44 records will be returned to the caller."
^XWB(8994,3255,1,3,0)=" "
^XWB(8994,3255,1,4,0)="e.q: "
^XWB(8994,3255,1,5,0)="If Patient File contains patient names 'AA', 'AB', 'BB', 'BC, 'CC', 'CD'"
^XWB(8994,3255,1,6,0)="in this order and caller passes in 'A', all of those patients will be"
^XWB(8994,3255,1,7,0)="included in the list."
^XWB(8994,3255,1,8,0)="If 'GG', 'KK', 'LL' are the 44th, 45th, and 46th patients in the "
^XWB(8994,3255,1,9,0)="patient name order, 'KK' and 'LL' will not be included."
^XWB(8994,3255,1,10,0)=" "
^XWB(8994,3255,1,11,0)="To get the next patients, caller must request the next batch of 44 "
^XWB(8994,3255,1,12,0)="records. For this reason, this RPC accepts two different format of"
^XWB(8994,3255,1,13,0)="'LIST FROM' text:"
^XWB(8994,3255,1,14,0)=" "
^XWB(8994,3255,1,15,0)="1. FROM = PATIENT NAME. This format will return records start with "
^XWB(8994,3255,1,16,0)="(** NOT PREFIXED BY **) FROM (PATIENT NAME)"
^XWB(8994,3255,1,17,0)=" "
^XWB(8994,3255,1,18,0)="2. FROM = LAST IEN^LAST PATIENT NAME. This format with return the "
^XWB(8994,3255,1,19,0)="next batch of 44 records after the LAST PATIENT NAME."
^XWB(8994,3255,2,0)="^8994.02A^7^2"
^XWB(8994,3255,2,1,0)="FROM^1^30^1^1"
^XWB(8994,3255,2,1,1,0)="^^3^3^3120915^"
^XWB(8994,3255,2,1,1,1,0)="Contains the patient's name or contains the patient's file #2 IEN and"
^XWB(8994,3255,2,1,1,2,0)="name. Name part of the input may be a partial or full name.  Examples:  "
^XWB(8994,3255,2,1,1,3,0)="""DOE,J""  OR ""99999^DOE,J""."
^XWB(8994,3255,2,2,0)="DIR^1^2^1^2"
^XWB(8994,3255,2,2,1,0)="^8994.021^2^2^3120915^^"
^XWB(8994,3255,2,2,1,1,0)="The value of DIR can be 1 or -1.  This parameter determines the $ORDER "
^XWB(8994,3255,2,2,1,2,0)="search direction, 1 is ascending and -1 is descending."
^XWB(8994,3255,2,6,0)="FROM^1^30^1^1"
^XWB(8994,3255,2,6,1,0)="^8994.021^14^14^3121213^^"
^XWB(8994,3255,2,6,1,1,0)="FORM is the 'Start With' or 'List From' input parametr. This is "
^XWB(8994,3255,2,6,1,2,0)="**NOT** a 'Prefixed by' input parameter."
^XWB(8994,3255,2,6,1,3,0)="This is a required field and can have two different formats."
^XWB(8994,3255,2,6,1,4,0)=" "
^XWB(8994,3255,2,6,1,5,0)="1. FORM  = PATIENT NAME. This format will return a batch of 44 "
^XWB(8994,3255,2,6,1,6,0)="patient records in patient name order start with PATIENT NAME. This is "
^XWB(8994,3255,2,6,1,7,0)="*NOT* a 'Prefixed by' input parameter. Any records in that batch "
^XWB(8994,3255,2,6,1,8,0)="including patient names *not* prefixed by the FORM will be included."
^XWB(8994,3255,2,6,1,9,0)=" "
^XWB(8994,3255,2,6,1,10,0)="2. FORM = LAST IEN^LAST PATIENT NAME. This format is to provide a "
^XWB(8994,3255,2,6,1,11,0)="caller to get the next batch of 44 records. The list returned will "
^XWB(8994,3255,2,6,1,12,0)="NOT include the LAST PATIENT NAME. Commonly, RPC caller will set LAST "
^XWB(8994,3255,2,6,1,13,0)="IEN^LAST PATIENT NAME with the last record returned in the previous RPC "
^XWB(8994,3255,2,6,1,14,0)="call."
^XWB(8994,3255,2,7,0)="DIR^1^2^1^2"
^XWB(8994,3255,2,7,1,0)="^8994.021^3^3^3121213^^"
^XWB(8994,3255,2,7,1,1,0)="Input parameter DIR determines the order of the output array returned. The"
^XWB(8994,3255,2,7,1,2,0)="value is either 1 (ascending order = default value) or -1 ("
^XWB(8994,3255,2,7,1,3,0)="descending order)."
^XWB(8994,3255,2,"B","DIR",2)=""
^XWB(8994,3255,2,"B","DIR",7)=""
^XWB(8994,3255,2,"B","FROM",1)=""
^XWB(8994,3255,2,"B","FROM",6)=""
^XWB(8994,3255,2,"PARAMSEQ",1,1)=""
^XWB(8994,3255,2,"PARAMSEQ",1,6)=""
^XWB(8994,3255,2,"PARAMSEQ",2,2)=""
^XWB(8994,3255,2,"PARAMSEQ",2,7)=""
^XWB(8994,3255,3,0)="^8994.03^2^2^3121213^^^^"
^XWB(8994,3255,3,1,0)="The parameter Y is an array passed by reference and will contain a list of"
^XWB(8994,3255,3,2,0)="patients whose NAME or IEN^NAME match the input value stored in FROM."
^XWB(8994,3256,0)="VPS GET2 PATIENT DEMOGRAPHIC^GETDATA2^VPSRPC1^2^P^0^^1^1"
^XWB(8994,3256,1,0)="^^4^4^3151020^"
^XWB(8994,3256,1,1,0)="Called by the Vetlink Kiosk system. The RPC will accept two input parameters "
^XWB(8994,3256,1,2,0)="which are the patient SSN or DFN and the patient type. The RPC returns the "
^XWB(8994,3256,1,3,0)="patient demographics,insurance, and appointments (Starting from T-60 and "
^XWB(8994,3256,1,4,0)="including future appointments)."
^XWB(8994,3256,2,0)="^8994.02A^2^2"
^XWB(8994,3256,2,1,0)="VPSNUM^1^12^1^1"
^XWB(8994,3256,2,1,1,0)="^^1^1^3130306^"
^XWB(8994,3256,2,1,1,1,0)="Patient Social Security Number or Patient IEN."
^XWB(8994,3256,2,2,0)="VPSTYP^1^10^1^2"
^XWB(8994,3256,2,2,1,0)="^8994.021^1^1^3151020^^"
^XWB(8994,3256,2,2,1,1,0)="SSN or DFN"
^XWB(8994,3256,2,"B","VPSNUM",1)=""
^XWB(8994,3256,2,"B","VPSTYP",2)=""
^XWB(8994,3256,2,"PARAMSEQ",1,1)=""
^XWB(8994,3256,2,"PARAMSEQ",2,2)=""
^XWB(8994,3257,0)="DSIRPARM EN ENTER/EDIT^EN^DSIRPARM^1^R"
^XWB(8994,3257,1,0)="^8994.01^2^2^3130610^^"
^XWB(8994,3257,1,1,0)="This RPC will enter/edit the entries in the DSIR FACILITY PARAMETERS File "
^XWB(8994,3257,1,2,0)="(#10620.701)."
^XWB(8994,3257,2,0)="^8994.02A^2^2"
^XWB(8994,3257,2,1,0)="INST^1^99^1^1"
^XWB(8994,3257,2,1,1,0)="^^1^1^3130123^"
^XWB(8994,3257,2,1,1,1,0)="This is the pointer to the INSTITUTION File (#4)."
^XWB(8994,3257,2,2,0)="DATA^2^99^0^2"
^XWB(8994,3257,2,2,1,0)="^8994.021^10^10^3130610^^"
^XWB(8994,3257,2,2,1,1,0)="This is an array containing the data to be stored in the DSIR FACILITY "
^XWB(8994,3257,2,2,1,2,0)="PARAMTERS File (#19620.701) in the below format."
^XWB(8994,3257,2,2,1,3,0)="        Field Number ^ Internal Data Value"
^XWB(8994,3257,2,2,1,4,0)="       "
^XWB(8994,3257,2,2,1,5,0)=" "
^XWB(8994,3257,2,2,1,6,0)="*NOTE: Since this file is DINUM the data array does NOT need the .01 field"
^XWB(8994,3257,2,2,1,7,0)="passed, it is the INST parameter."
^XWB(8994,3257,2,2,1,8,0)=" "
^XWB(8994,3257,2,2,1,9,0)="This parameter is optional, but if nothing is passed nothing will be "
^XWB(8994,3257,2,2,1,10,0)="updated and the return will be an unsuccessful result."
^XWB(8994,3257,2,"B","DATA",2)=""
^XWB(8994,3257,2,"B","INST",1)=""
^XWB(8994,3257,2,"PARAMSEQ",1,1)=""
^XWB(8994,3257,2,"PARAMSEQ",2,2)=""
^XWB(8994,3257,3,0)="^8994.03^3^3^3130610^^"
^XWB(8994,3257,3,1,0)="Return Values"
^XWB(8994,3257,3,2,0)="      -1 = Update Unsuccessful."
^XWB(8994,3257,3,3,0)="      INST = Update Successful, this is the IEN passed in INST parameter."
^XWB(8994,3258,0)="DSIRPARM RTRV GET PARAMS^RTRV^DSIRPARM^4^R^^^1"
^XWB(8994,3258,1,0)="^^2^2^3130123^"
^XWB(8994,3258,1,1,0)="This is the RPC that will retrieve the ROI parameters from file "
^XWB(8994,3258,1,2,0)="#19620.701 DSIR FACILITY PARAMETERS File."
^XWB(8994,3258,2,0)="^8994.02A^1^1"
^XWB(8994,3258,2,1,0)="INST^1^99^1^1"
^XWB(8994,3258,2,1,1,0)="^^2^2^3130123^"
^XWB(8994,3258,2,1,1,1,0)="Pointer to the DSIR FACILITY PARAMETERS File (#19620.701) same as "
^XWB(8994,3258,2,1,1,2,0)="INSTITUTION File (#4)."
^XWB(8994,3258,2,"B","INST",1)=""
^XWB(8994,3258,2,"PARAMSEQ",1,1)=""
^XWB(8994,3258,3,0)="^^14^14^3130621^"
^XWB(8994,3258,3,1,0)="Return Array"
^XWB(8994,3258,3,2,0)="        (0) = 0 ^ Unknown/Undefined Facility"
^XWB(8994,3258,3,3,0)="        (0) = -1 ^ Invalid Parameter Value!!"
^XWB(8994,3258,3,4,0)="        (0) = INST - This is the IEN passed in INST above."
^XWB(8994,3258,3,5,0)="        (1...n) = FLD # ^ Internal ^ External (When it's different from"
^XWB(8994,3258,3,6,0)="internal) ^ (Abbreviation for STATE field)"
^XWB(8994,3258,3,7,0)=" "
^XWB(8994,3258,3,8,0)="        Examples:"
^XWB(8994,3258,3,9,0)="           .01^3^ATLANTA"
^XWB(8994,3258,3,10,0)="           .02^1234 STREET DRIVE"
^XWB(8994,3258,3,11,0)="           .05^2^GEORGIA^GA"
^XWB(8994,3258,3,12,0)="           .06^123459876^12345-9876"
^XWB(8994,3258,3,13,0)="           .08^7701231234^(770) 123-1234"
^XWB(8994,3258,3,14,0)="           1.01^ROI SUPERVISOR"
^XWB(8994,3259,0)="DSIRPARM ENPO UPDATE PR ORD^ENPO^DSIRPARM^1^R"
^XWB(8994,3259,1,0)="^8994.01^4^4^3130612^^^"
^XWB(8994,3259,1,1,0)="This RPC is used to enter/edit the default Print Order of documents "
^XWB(8994,3259,1,2,0)="released by each facility specified in the DSIR FACILITY PARAMETERS File "
^XWB(8994,3259,1,3,0)="(#19620.701).  This data is stored in the DSIR ROI PRINT ORDER File "
^XWB(8994,3259,1,4,0)="(#19620.702)."
^XWB(8994,3259,2,0)="^8994.02A^4^4"
^XWB(8994,3259,2,1,0)="INST^1^99^1^1"
