^XWB(8994,3628,1,0)="^^2^2^3160105^"
^XWB(8994,3628,1,1,0)="SET MULT APPTS MADE multiple in SDEC APPT REQUEST file."
^XWB(8994,3628,1,2,0)="All entries are removed and replaced by the values in MULT."
^XWB(8994,3628,2,0)="^8994.02A^2^2"
^XWB(8994,3628,2,1,0)="ARIEN^1^^1^1"
^XWB(8994,3628,2,1,1,0)="^^1^1^3160105^"
^XWB(8994,3628,2,1,1,1,0)="Pointer to SDEC APPT REQUEST file 409.85."
^XWB(8994,3628,2,2,0)="MULT^1^^0^2"
^XWB(8994,3628,2,2,1,0)="^^5^5^3160105^"
^XWB(8994,3628,2,2,1,1,0)="List of child pointers to SDEC APPOINTMENT and/or SDEC APPT REQUEST files "
^XWB(8994,3628,2,2,1,2,0)="separated by pipe."
^XWB(8994,3628,2,2,1,3,0)="Each pipe piece contains the following ~ pieces:"
^XWB(8994,3628,2,2,1,4,0)="  1. (optional) Appointment ID pointer to SDEC APPOINTMENT file 409.84"
^XWB(8994,3628,2,2,1,5,0)="  2. (optional) Request ID pointer to SDEC APPT REQUEST file 409.85."
^XWB(8994,3628,2,"B","ARIEN",1)=""
^XWB(8994,3628,2,"B","MULT",2)=""
^XWB(8994,3628,2,"PARAMSEQ",1,1)=""
^XWB(8994,3628,2,"PARAMSEQ",2,2)=""
^XWB(8994,3628,3,0)="^^1^1^3160105^"
^XWB(8994,3628,3,1,0)="ERRORCODE ^ MESSAGE"
^XWB(8994,3629,0)="SDEC NETLOC^NETLOC^SDEC^4^R^0^^0"
^XWB(8994,3629,1,0)="^^1^1^3160126^"
^XWB(8994,3629,1,1,0)="GET data from the NETWORK LOCATION file 2005.2."
^XWB(8994,3629,2,0)="^8994.02A^1^1"
^XWB(8994,3629,2,1,0)="LOCATION^1^^0^1"
^XWB(8994,3629,2,1,1,0)="^^2^2^3160126^"
^XWB(8994,3629,2,1,1,1,0)="Name or ID from the NETWORK LOCATION file 2005.2"
^XWB(8994,3629,2,1,1,2,0)="null will return all entries"
^XWB(8994,3629,2,"B","LOCATION",1)=""
^XWB(8994,3629,2,"PARAMSEQ",1,1)=""
^XWB(8994,3629,3,0)="^^3^3^3160126^"
^XWB(8994,3629,3,1,0)="1. LOCATION_IEN  - pointer to NETWORK LOCATION file 2005.2"
^XWB(8994,3629,3,2,0)="2. LOCATION_NAME - name from NETWORK LOCATION file"
^XWB(8994,3629,3,3,0)="3. PHYSICAL_REF  - PHYSICAL REFERENCE field (free-text) usually URL"
^XWB(8994,3630,0)="MPIF GET VHIC/CAC CARD DATA^GETCARD^MPIFRPC^4^^^^1"
^XWB(8994,3630,1,0)="^8994.01^2^2^3151002^^^"
^XWB(8994,3630,1,1,0)="RPC to look up all VHIC/CAC swipe/scan activity at the site for all"
^XWB(8994,3630,1,2,0)="days prior to today."
^XWB(8994,3630,3,0)="^8994.03^2^2^3151002^^^"
^XWB(8994,3630,3,1,0)="Return will be 1 line for each of the activity that occured in the format:"
^XWB(8994,3630,3,2,0)="(n)=FM Date/Time^Card ID (fully qualified)^Type of Event (SWIPE/SCAN)^Option"
^XWB(8994,3631,0)="MPIF PURGE VHIC/CAC CARD DATA^PURGCARD^MPIFRPC^1"
^XWB(8994,3631,1,0)="^8994.01^2^2^3151007^^^"
^XWB(8994,3631,1,1,0)="This RPC will purge data used to track VHIC/CAC card usage for all prior"
^XWB(8994,3631,1,2,0)="dates."
^XWB(8994,3631,2,0)="^8994.02A^^0"
^XWB(8994,3631,3,0)="^8994.03^1^1^3151007^^^"
^XWB(8994,3631,3,1,0)="Will return 1^PURGE SUCCESSFUL"
^XWB(8994,3632,0)="RMPR SUSPENSE LOCK^SUSL^RMPRGULK^2^S^0^^0"
^XWB(8994,3632,2,0)="^8994.02A^1^1"
^XWB(8994,3632,2,1,0)="IEN^1^50^1^1"
^XWB(8994,3632,2,"B","IEN",1)=""
^XWB(8994,3632,2,"PARAMSEQ",1,1)=""
^XWB(8994,3633,0)="RMPR SUSPENSE UNLOCK^SUSU^RMPRGULK^2^S^0^^0"
^XWB(8994,3633,2,0)="^8994.02A^1^1"
^XWB(8994,3633,2,1,0)="IEN^1^50^1^1"
^XWB(8994,3633,2,"B","IEN",1)=""
^XWB(8994,3633,2,"PARAMSEQ",1,1)=""
^XWB(8994,3634,0)="DSIV DDR GETS EXTENDED DATA^GET2^DSIVDDR0^4^A^^^1^^^1"
^XWB(8994,3634,1,0)="^^4^4^3160308^"
^XWB(8994,3634,1,1,0)="This calls GETS^DIQ to get a list of field values for a record."
^XWB(8994,3634,1,2,0)=" "
^XWB(8994,3634,1,3,0)="This variant returns data in chunks if greater than 255 characters rather "
^XWB(8994,3634,1,4,0)="than cutting the data off."
^XWB(8994,3634,2,0)="^8994.02A^4^4"
^XWB(8994,3634,2,1,0)="FILE^1^20^1^1"
^XWB(8994,3634,2,1,1,0)="^^1^1^3131106^"
^XWB(8994,3634,2,1,1,1,0)="This is the number of the file in which you wish to search."
^XWB(8994,3634,2,2,0)="IENS^1^20^1^2"
^XWB(8994,3634,2,2,1,0)="^^2^2^3131106^"
^XWB(8994,3634,2,2,1,1,0)="This is the IENS for the search. See the instructions on constructing an "
^XWB(8994,3634,2,2,1,2,0)="IENS in the FileMan Programmer's Manual"
^XWB(8994,3634,2,3,0)="FIELD^1^250^1^3"
^XWB(8994,3634,2,3,1,0)="^^2^2^3131106^"
^XWB(8994,3634,2,3,1,1,0)="This is an ^ (or "";"") delimited list of field numbers to return from the "
^XWB(8994,3634,2,3,1,2,0)="entry identified in IENS"
^XWB(8994,3634,2,4,0)="FLAGS^1^20^1^4"
^XWB(8994,3634,2,4,1,0)="^^17^17^3160308^"
^XWB(8994,3634,2,4,1,1,0)=" This is a string containing up to 3 characters that will modify how"
^XWB(8994,3634,2,4,1,2,0)=" FileMan presents the results of this operation:"
^XWB(8994,3634,2,4,1,3,0)=" "
^XWB(8994,3634,2,4,1,4,0)="        E: Return data in external format"
^XWB(8994,3634,2,4,1,5,0)="        I: Return data in internal format"
^XWB(8994,3634,2,4,1,6,0)=" "
^XWB(8994,3634,2,4,1,7,0)="        N: Do NOT return null values - not to be used by DSS GUI"
^XWB(8994,3634,2,4,1,8,0)="        R: Resolves field numbers to field names"
^XWB(8994,3634,2,4,1,9,0)="        W: Input field is a word processing field"
^XWB(8994,3634,2,4,1,10,0)=" "
^XWB(8994,3634,2,4,1,11,0)=" If the W flag is passed, then this call expects that the Field parameter"
^XWB(8994,3634,2,4,1,12,0)=" will have a single field number only.  The W flag must be sent by"
^XWB(8994,3634,2,4,1,13,0)=" itself.  It cannot be combined with other flags.  W introduced 12/9/2003."
^XWB(8994,3634,2,4,1,14,0)=" "
^XWB(8994,3634,2,4,1,15,0)=" If the result for a particular field is greater than 255 characters, it "
^XWB(8994,3634,2,4,1,16,0)=" will be broken into two nodes with the continuing data being denoted by "
^XWB(8994,3634,2,4,1,17,0)=" $$CONT$$."
^XWB(8994,3634,2,"B","FIELD",3)=""
^XWB(8994,3634,2,"B","FILE",1)=""
^XWB(8994,3634,2,"B","FLAGS",4)=""
^XWB(8994,3634,2,"B","IENS",2)=""
^XWB(8994,3634,2,"PARAMSEQ",1,1)=""
^XWB(8994,3634,2,"PARAMSEQ",2,2)=""
^XWB(8994,3634,2,"PARAMSEQ",3,3)=""
^XWB(8994,3634,2,"PARAMSEQ",4,4)=""
^XWB(8994,3634,3,0)="^^10^10^3131106^"
^XWB(8994,3634,3,1,0)=" Returns an array with the following format:"
^XWB(8994,3634,3,2,0)=" "
^XWB(8994,3634,3,3,0)=" For non-word processing fields, List[n] := p1^p2^p3^p4^p5   n=1,2,3,..."
^XWB(8994,3634,3,4,0)="   p1 = file number (or subfile#)"
^XWB(8994,3634,3,5,0)="   p2 = iens"
^XWB(8994,3634,3,6,0)="   p3 = field number or field name"
^XWB(8994,3634,3,7,0)="   p4 = value for that field"
^XWB(8994,3634,3,8,0)="   p5 = I if value in internal format, else E if in external format"
^XWB(8994,3634,3,9,0)=" "
^XWB(8994,3634,3,10,0)=" For a word processing field, return List[n] := text   n=1,2,3,..."
^XWB(8994,3635,0)="DSIV XPAR GET PARAM LIST^LIST^DSIVXPR^2^A^^^1"
^XWB(8994,3635,1,0)="^^5^5^3050107^"
^XWB(8994,3635,1,1,0)="This will return a detailed list of one or more Kernel Parameter"
^XWB(8994,3635,1,2,0)="Definitions.  It does not return every Param Definition field."
^XWB(8994,3635,1,3,0)=" "
^XWB(8994,3635,1,4,0)="Either the NAME input parameter or the PREFIX input parameter is "
^XWB(8994,3635,1,5,0)="required.  If you pass a NAME then PREFIX is ignored."
^XWB(8994,3635,2,0)="^8994.02A^2^2"
^XWB(8994,3635,2,1,0)="NAME^1^30^0^1"
^XWB(8994,3635,2,1,1,0)="^^3^3^3050107^"
^XWB(8994,3635,2,1,1,1,0)="This is the name or the IFN for a Parameter Definition.  Pass this value "
^XWB(8994,3635,2,1,1,2,0)="only if you wish to retrieve the data for one specific Parameter "
^XWB(8994,3635,2,1,1,3,0)="Definition."
^XWB(8994,3635,2,2,0)="PREFIX^1^20^0^2"
^XWB(8994,3635,2,2,1,0)="^^3^3^3050107^"
^XWB(8994,3635,2,2,1,1,0)="This is the namespace or the leading characters for the Parameter "
^XWB(8994,3635,2,2,1,2,0)="Definitions you wished to be returned.  For example, PREFIX=""DSIC"" will "
^XWB(8994,3635,2,2,1,3,0)="return all DSIC Kernel Parameter Definitions."
^XWB(8994,3635,2,"B","NAME",1)=""
^XWB(8994,3635,2,"B","PREFIX",2)=""
^XWB(8994,3635,2,"PARAMSEQ",1,1)=""
^XWB(8994,3635,2,"PARAMSEQ",2,2)=""
^XWB(8994,3635,3,0)="^^24^24^3050107^"
^XWB(8994,3635,3,1,0)="Returns List[n] = value  for n=0,1,2,3,..."
^XWB(8994,3635,3,2,0)=" "
^XWB(8994,3635,3,3,0)="If problems encounter, the first row returned will be"
^XWB(8994,3635,3,4,0)="  List[0] := -1^message"
^XWB(8994,3635,3,5,0)="  List[i] := message  for i=1,2,3,4,..."
^XWB(8994,3635,3,6,0)=" "
^XWB(8994,3635,3,7,0)="Return list is a multi-lined return for each entry found.  For each "
^XWB(8994,3635,3,8,0)="Parameter definition return:"
^XWB(8994,3635,3,9,0)="   List[j] := p1^p2^p3^p4  where"
^XWB(8994,3635,3,10,0)="              p1 = $START    p2 = Param Def ifn    p3 = Param Def name"
^XWB(8994,3635,3,11,0)="              p4 = Multivalued Param [Boolean 1/0/null)"
^XWB(8994,3635,3,12,0)=" List[j+1] := p1^p2^p3^p4  for Param Def Instance"
^XWB(8994,3635,3,13,0)="              p1 = term    p2 = data type code   p3 = data type"
^XWB(8994,3635,3,14,0)="              p4 = domain"
^XWB(8994,3635,3,15,0)=" List[j+2] := p1^p2^p3^p4  for Param Def Value"
^XWB(8994,3635,3,16,0)="              p1 = term    p2 = data type code   p3 = data type"
^XWB(8994,3635,3,17,0)="              p4 = domain"
^XWB(8994,3635,3,18,0)=" List[j+3] := s1;s2;s3^s1;s2;s3^s1;s2;s3^...  list of entities"
^XWB(8994,3635,3,19,0)="              s1 = precedence order number"
^XWB(8994,3635,3,20,0)="              s2 = entity name      s3 = entity abbreviation"
^XWB(8994,3635,3,21,0)=" List[j+k] := text  where k=4,5,6,...  Parameter description"
^XWB(8994,3635,3,22,0)="              these lines will not be returned if there is no "
^XWB(8994,3635,3,23,0)="              description for the Parameter Definition"
^XWB(8994,3635,3,24,0)=" List[j+k+1] := $END"
^XWB(8994,3636,0)="XUS IAM TERMINATE USER^IAMTU^XUESSO3^2^R^^^^1^^0"
^XWB(8994,3636,1,0)="^8994.01^3^3^3150722^^"
^XWB(8994,3636,1,1,0)="This restricted RPC is used exclusively by the Identity and Access "
^XWB(8994,3636,1,2,0)="Management (IAM) Provisioning application to terminate an existing user "
^XWB(8994,3636,1,3,0)="in the VistA NEW PERSON file (#200)."
^XWB(8994,3636,2,0)="^8994.02A^4^4"
^XWB(8994,3636,2,1,0)="SECID^1^30^1^1"
^XWB(8994,3636,2,1,1,0)="^^2^2^3150707^"
^XWB(8994,3636,2,1,1,1,0)="SECID field (#205.1) in the NEW PERSON file (#200) to match the SecID in "
^XWB(8994,3636,2,1,1,2,0)="the user's SAML Token."
^XWB(8994,3636,2,2,0)="TERMDATE^1^20^1^2"
^XWB(8994,3636,2,2,1,0)="^^1^1^3150707^"
^XWB(8994,3636,2,2,1,1,0)="TERMINATION DATE field (#9.2) in the NEW PERSON file (#200)."
^XWB(8994,3636,2,3,0)="TERMRESN^1^45^1^3"
^XWB(8994,3636,2,3,1,0)="^8994.021^1^1^3150707^^"
^XWB(8994,3636,2,3,1,1,0)="Termination Reason field (#9.4) in the NEW PERSON file (#200)."
^XWB(8994,3636,2,4,0)="AUTHCODE^1^80^1^4"
^XWB(8994,3636,2,4,1,0)="^8994.021^1^1^3150722^^"
^XWB(8994,3636,2,4,1,1,0)="Security Phrase for IAM Provisioning Application."
^XWB(8994,3636,2,"B","AUTHCODE",4)=""
^XWB(8994,3636,2,"B","SECID",1)=""
^XWB(8994,3636,2,"B","TERMDATE",2)=""
^XWB(8994,3636,2,"B","TERMRESN",3)=""
^XWB(8994,3636,2,"PARAMSEQ",1,1)=""
^XWB(8994,3636,2,"PARAMSEQ",2,2)=""
^XWB(8994,3636,2,"PARAMSEQ",3,3)=""
^XWB(8994,3636,2,"PARAMSEQ",4,4)=""
^XWB(8994,3636,3,0)="^^3^3^3150722^"
^XWB(8994,3636,3,1,0)="Fail    R(0) = ""-1^Number of Errors"""
^XWB(8994,3636,3,2,0)="        R(1) through RES(n)=""Error Message"""
^XWB(8994,3636,3,3,0)="Success R(0) = 1"
^XWB(8994,3637,0)="XUS IAM REACTIVATE USER^IAMRU^XUESSO3^2^S^^^^1^^0"
^XWB(8994,3637,1,0)="^^4^4^3151209^"
^XWB(8994,3637,1,1,0)="RPC ICR #6293 - API ICR #none"
^XWB(8994,3637,1,2,0)="This restricted RPC is used exclusively by the Identity and Access "
^XWB(8994,3637,1,3,0)="Management (IAM) Provisioning application to reactivate an existing user "
^XWB(8994,3637,1,4,0)="in the VistA NEW PERSON file (#200)."
^XWB(8994,3637,2,0)="^8994.02A^2^2"
^XWB(8994,3637,2,1,0)="SECID^1^30^1^1"
^XWB(8994,3637,2,1,1,0)="^^2^2^3150707^"
^XWB(8994,3637,2,1,1,1,0)="SECID field (#205.1) in the NEW PERSON file (#200) to match the SecID in "
^XWB(8994,3637,2,1,1,2,0)="the user's SAML Token."
^XWB(8994,3637,2,2,0)="AUTHCODE^1^80^1^2"
^XWB(8994,3637,2,2,1,0)="^8994.021^1^1^3150722^^"
^XWB(8994,3637,2,2,1,1,0)="Security Phrase for IAM Provisioning Application."
^XWB(8994,3637,2,"B","AUTHCODE",2)=""
^XWB(8994,3637,2,"B","SECID",1)=""
^XWB(8994,3637,2,"PARAMSEQ",1,1)=""
^XWB(8994,3637,2,"PARAMSEQ",2,2)=""
^XWB(8994,3637,3,0)="^^3^3^3150722^"
^XWB(8994,3637,3,1,0)="Fail    R(0) = ""-1^Number of Errors"""
^XWB(8994,3637,3,2,0)="        R(1) through RES(n) = ""Error Message"""
^XWB(8994,3637,3,3,0)="Success R(0) = 1"
^XWB(8994,3638,0)="XUS BSE TOKEN^BSETOKEN^XUSBSE1^1^S^^^^1^^0"
^XWB(8994,3638,1,0)="^^13^13^3170124^"
^XWB(8994,3638,1,1,0)=" "
^XWB(8994,3638,1,2,0)="RPC ICR #6695 - API ICR #none"
^XWB(8994,3638,1,3,0)=" "
^XWB(8994,3638,1,4,0)="This API/RPC returns a string from the current user authentication that "
^XWB(8994,3638,1,5,0)="can be used to authenticate the user on a visited system. The application"
^XWB(8994,3638,1,6,0)="is identified by a security phrase that, when hashed, matches the stored"
^XWB(8994,3638,1,7,0)="hash of an authorized application in the REMOTE APPLICATION file "
^XWB(8994,3638,1,8,0)="(#8994.5)."
^XWB(8994,3638,1,9,0)=" "
^XWB(8994,3638,1,10,0)="It is used exclusively for the Station-number callback type, and will not "
^XWB(8994,3638,1,11,0)="work with Delphi RPC Broker clients compiled with the Broker Development"
^XWB(8994,3638,1,12,0)="Kit (BDK). It is intended for non-Delphi clients connecting with the XUS "
^XWB(8994,3638,1,13,0)="SIGNON SETUP RPC."
^XWB(8994,3638,2,0)="^8994.02A^1^1"
^XWB(8994,3638,2,1,0)="XPHRASE^1^90^1^1"
^XWB(8994,3638,2,1,1,0)="^^2^2^3160105^"
^XWB(8994,3638,2,1,1,1,0)="Input:   XPHRASE = Security phrase to be used to authenticate and identify"
^XWB(8994,3638,2,1,1,2,0)="the application."
^XWB(8994,3638,2,"B","XPHRASE",1)=""
^XWB(8994,3638,2,"PARAMSEQ",1,1)=""
^XWB(8994,3638,3,0)="^8994.03^3^3^3170124^^^"
^XWB(8994,3638,3,1,0)="RET = Complete BSE login string (no processing required by middleware or "
^XWB(8994,3638,3,2,0)="client) to be passed to the XWBUSRNM input parameter of the XUS SIGNON "
^XWB(8994,3638,3,3,0)="SETUP remote procedure."
^XWB(8994,3639,0)="HMP PATIENT SELECT^SELECT^HMPPTRPC^2"
^XWB(8994,3639,1,0)="^^2^2^3151123^"
^XWB(8994,3639,1,1,0)="Selects patients by search criteria and returns basic patient and demographic information for patients"
^XWB(8994,3639,1,2,0)="found in search."
^XWB(8994,3639,2,0)="^8994.02A^2^2"
^XWB(8994,3639,2,1,0)="CRITERIA^1^10^1^1"
^XWB(8994,3639,2,1,1,0)="^^5^5^3151123^"
^XWB(8994,3639,2,1,1,1,0)="The type of search to perform. May be one of the following values:"
^XWB(8994,3639,2,1,1,2,0)="   LAST5 - ""last5"" format of ssn (i.e., patient's last intial + last4 of ssn)"
^XWB(8994,3639,2,1,1,3,0)="   NAME - search by patient name, can be partial name"
^XWB(8994,3639,2,1,1,4,0)="   ICN - select patient by ICN"
^XWB(8994,3639,2,1,1,5,0)="   PID - select patient by PID"
^XWB(8994,3639,2,2,0)="SEARCH TERM^1^60^1^2"
^XWB(8994,3639,2,2,1,0)="^8994.021^1^1^3151123^^"
^XWB(8994,3639,2,2,1,1,0)="Term to search for when looking up patient. Should match type specified in CRITERIA."
^XWB(8994,3639,2,"B","CRITERIA",1)=""
^XWB(8994,3639,2,"B","SEARCH TERM",2)=""
^XWB(8994,3639,2,"PARAMSEQ",1,1)=""
^XWB(8994,3639,2,"PARAMSEQ",2,2)=""
^XWB(8994,3639,3,0)="^^4^4^3151123^"
^XWB(8994,3639,3,1,0)="Returns a list of patient data, one line per patient, in format:"
^XWB(8994,3639,3,2,0)="   Full Name^Family Name^Given Name(s)^Display Name^Gender Code^Gender Name^SSN^Last4^Last5^Date of birth^Sensitive^LocalId^PID^ICN^Summary"
^XWB(8994,3639,3,3,0)="Or returns -1^Error message if error"
^XWB(8994,3639,3,4,0)="If no patients found, returns empy list"
^XWB(8994,3640,0)="VIAB GETSURR^GETSURR^VIABRPC^1^R^^^^^^1"
^XWB(8994,3640,1,0)="^8994.01^2^2^3160405^^"
^XWB(8994,3640,1,1,0)="This RPC returns information about a user's surrogate, including start and"
^XWB(8994,3640,1,2,0)="end date/times if they are specified."
^XWB(8994,3640,2,0)="^8994.02A^1^1"
^XWB(8994,3640,2,1,0)="USER^1^^1^1"
^XWB(8994,3640,2,1,1,0)="^8994.021^1^1^3160405^^"
^XWB(8994,3640,2,1,1,1,0)="This is the user internal entry number (IEN) in the NEW PERSON file."
^XWB(8994,3640,2,"B","USER",1)=""
^XWB(8994,3640,2,"PARAMSEQ",1,1)=""
^XWB(8994,3640,3,0)="^^15^15^3160405^"
^XWB(8994,3640,3,1,0)="The value returned is of the form"
^XWB(8994,3640,3,2,0)="                  RESULT=ien^NAME^FM_STARTDATE^FM_ENDDATE "
^XWB(8994,3640,3,3,0)="      "
^XWB(8994,3640,3,4,0)="     where ien is the internal entry number of the SURROGATE in "
^XWB(8994,3640,3,5,0)="     the NEW PERSON file, NAME is the contents of the .01 field for"
^XWB(8994,3640,3,6,0)="     the SURROGATE, FM_STARTDATE is the starting date/time for the"
^XWB(8994,3640,3,7,0)="     SURROGATE in internal Filemanager format, and FM_ENDDATE is"
^XWB(8994,3640,3,8,0)="     the ending date/time for the SURROGATE in internal Filemanager"
^XWB(8994,3640,3,9,0)="     format.  "
^XWB(8994,3640,3,10,0)="                  S USER=124"
^XWB(8994,3640,3,11,0)="                  D GETSURR^VIABRPC(.RESULT,USER) "
^XWB(8994,3640,3,12,0)="                "
^XWB(8994,3640,3,13,0)="               might yield a value of RESULT containing "
^XWB(8994,3640,3,14,0)="                "
^XWB(8994,3640,3,15,0)="                 2327^DOE,JOHN^3160229.1630^3181006.0800 "
^XWB(8994,3641,0)="VIAB SITENAME^SNAME^VIABRPC^1^R^^^^^^1"
^XWB(8994,3641,1,0)="^^2^2^3160422^"
^XWB(8994,3641,1,1,0)="This RPC will provide the Site Name to the calling application, given the "
^XWB(8994,3641,1,2,0)="site ID or station number is passed in."
^XWB(8994,3641,2,0)="^8994.02A^1^1"
^XWB(8994,3641,2,1,0)="SID^1^^1^1"
^XWB(8994,3641,2,1,1,0)="^^1^1^3160422^"
^XWB(8994,3641,2,1,1,1,0)="Site or station number."
^XWB(8994,3641,2,"B","SID",1)=""
^XWB(8994,3641,2,"PARAMSEQ",1,1)=""
^XWB(8994,3641,3,0)="^^1^1^3160422^"
^XWB(8994,3641,3,1,0)="Returns the site name for the provided site number or station number."
^XWB(8994,3642,0)="VIAB GET USER DIVISIONS^USERDIV^VIABRPC^2^R^^^^^^1"
^XWB(8994,3642,1,0)="^^2^2^3160712^"
^XWB(8994,3642,1,1,0)="This RPC provides divisional information on the DUZ that is passed in as"
^XWB(8994,3642,1,2,0)="the input parameter."
^XWB(8994,3642,2,0)="^8994.02A^1^1"
^XWB(8994,3642,2,1,0)="VIADUZ^1^^1^1"
^XWB(8994,3642,2,1,1,0)="^8994.021^1^1^3160712^^^^"
^XWB(8994,3642,2,1,1,1,0)="User DUZ - IEN from File #200."
^XWB(8994,3642,2,"B","VIADUZ",1)=""
^XWB(8994,3642,2,"PARAMSEQ",1,1)=""
^XWB(8994,3642,3,0)="^8994.03^10^10^3160712^^"
^XWB(8994,3642,3,1,0)="Returns divisional information for the user in the following format:"
^XWB(8994,3642,3,2,0)="  station IEN^station number^station name^default division"
^XWB(8994,3642,3,3,0)=" "
^XWB(8994,3642,3,4,0)="Example:"
^XWB(8994,3642,3,5,0)="     D USERDIV^VIABRPC(.RESULT,DUZ)"
^XWB(8994,3642,3,6,0)=" "
^XWB(8994,3642,3,7,0)="     ZW RESULT"
^XWB(8994,3642,3,8,0)="     RESULT(1)=""7647^674BY^AUSTIN^1"""
^XWB(8994,3642,3,9,0)="     RESULT(2)=""6568^528A8^ALBANY, NY VAMC^0"""
^XWB(8994,3642,3,10,0)="     RESULT(3)=""7982^200PS^AUSTIN PSIM^0"""
^XWB(8994,3643,0)="MBAA APPOINTMENT LIST BY NAME^LSTAPPT^MBAAMRP2^2^S^^^^1^^1"
^XWB(8994,3643,1,0)="^8994.01^2^2^3180514^^^^"
^XWB(8994,3643,1,1,0)="Returns a list of appointment types based on the input parameters from "
^XWB(8994,3643,1,2,0)="the Appointment Types file (#409.1)."
^XWB(8994,3643,2,0)="^8994.02A^3^3"
^XWB(8994,3643,2,1,0)="SEARCH^1^200^0^1"
^XWB(8994,3643,2,1,1,0)="^8994.021^2^2^3140522^^"
^XWB(8994,3643,2,1,1,1,0)="The partial match restrictions used for the search. This parameter limits "
^XWB(8994,3643,2,1,1,2,0)="the search to those entries that match the partial match restrictions. "
^XWB(8994,3643,2,2,0)="START^1^200^0^2"
^XWB(8994,3643,2,2,1,0)="^8994.021^2^2^3140522^^"
^XWB(8994,3643,2,2,1,1,0)="The index entry(s) from which to begin the list. For example, a value of "
^XWB(8994,3643,2,2,1,2,0)="""XQ"" would result in a list that starts with the first entry after ""XQ""."
^XWB(8994,3643,2,3,0)="NUMBER^1^200^0^3"
^XWB(8994,3643,2,3,1,0)="^8994.021^1^1^3180514^^^^"
^XWB(8994,3643,2,3,1,1,0)="This is the number of entries to return."
^XWB(8994,3643,2,"B","NUMBER",3)=""
^XWB(8994,3643,2,"B","SEARCH",1)=""
^XWB(8994,3643,2,"B","START",2)=""
^XWB(8994,3643,2,"PARAMSEQ",1,1)=""
^XWB(8994,3643,2,"PARAMSEQ",2,2)=""
^XWB(8994,3643,2,"PARAMSEQ",3,3)=""
^XWB(8994,3643,3,0)="^8994.03^10^10^3180514^^^^"
^XWB(8994,3643,3,1,0)="Returns an array with the subscripts below:"
^XWB(8994,3643,3,2,0)="ARRAY(0)=The number of entries found^the number of entries requested^any "
^XWB(8994,3643,3,3,0)="more flag?^results flags (any more flag? is zero if there aren't any more "
^XWB(8994,3643,3,4,0)="entries, if there are more entries than returned, this is set to one.)"
^XWB(8994,3643,3,5,0)="ARRAY(RECORD NUMBER)="""" - This is a separator between records, this node "
^XWB(8994,3643,3,6,0)="is always null."
^XWB(8994,3643,3,7,0)="ARRAY(RECORD NUMBER,""ID"")=IEN of the entry on the ""NAME"" node below."
^XWB(8994,3643,3,8,0)="ARRAY(RECORD NUMBER,""NAME"")=Text Name of the entry."
^XWB(8994,3643,3,9,0)=" "
^XWB(8994,3643,3,10,0)="RECORD NUMBER increments by one for each additional record."
^XWB(8994,3644,0)="MBAA GET CLINIC AVAILABILITY^SLOTS^MBAAMRP1^2^S^^^^1^^1"
^XWB(8994,3644,1,0)="^^1^1^3140325^"
^XWB(8994,3644,1,1,0)="Returns the available slots for a clinic."
^XWB(8994,3644,2,0)="^8994.02A^1^1"
^XWB(8994,3644,2,1,0)="CLINIC^1^200^1^1"
^XWB(8994,3644,2,1,1,0)="^^1^1^3140325^"
^XWB(8994,3644,2,1,1,1,0)="The Clinic ID/IEN from the Hospital Location file (#44) for the Clinic."
^XWB(8994,3644,2,"B","CLINIC",1)=""
^XWB(8994,3644,2,"PARAMSEQ",1,1)=""
^XWB(8994,3644,3,0)="^^1^1^3140325^"
^XWB(8994,3644,3,1,0)="Returns an array with the Clinics Appointment Schedule."
^XWB(8994,3645,0)="MBAA VERIFY CLINIC ACCESS^CLNRGHT^MBAAMRP1^2^S^^^^1^^1"
^XWB(8994,3645,1,0)="^8994.01^1^1^3140325^^"
^XWB(8994,3645,1,1,0)="Checks to see if the logon user has access to a clinic."
^XWB(8994,3645,2,0)="^8994.02A^1^1"
^XWB(8994,3645,2,1,0)="CLN^1^200^1^1"
^XWB(8994,3645,2,1,1,0)="^8994.021^1^1^3140325^^^"
^XWB(8994,3645,2,1,1,1,0)="CLINIC IFN"
^XWB(8994,3645,2,"B","CLN",1)=""
^XWB(8994,3645,2,"PARAMSEQ",1,1)=""
^XWB(8994,3645,3,0)="^^2^2^3140325^"
^XWB(8994,3645,3,1,0)="Returns NULL if the user has access, otherwise returns 1 if the user "
^XWB(8994,3645,3,2,0)="doesn't have access to the clinic."
^XWB(8994,3646,0)="MBAA LIST CANCELLATION REASONS^LSTCRSNS^MBAAMRP1^2^S^^^^1^^1"
^XWB(8994,3646,1,0)="^8994.01^2^2^3140623^^"
^XWB(8994,3646,1,1,0)="Returns the list of cancellation reasons from the CANCELLATION REASONS "
^XWB(8994,3646,1,2,0)="file ($409.2)."
^XWB(8994,3646,2,0)="^8994.02A^3^3"
^XWB(8994,3646,2,1,0)="SEARCH^1^200^0^1"
^XWB(8994,3646,2,1,1,0)="^^8^8^3140623^"
^XWB(8994,3646,2,1,1,1,0)="Partial match restriction. For example, a Search value of ""AB"" would "
^XWB(8994,3646,2,1,1,2,0)="restrict the list to just those entries that start with the letters ""AB""."
^XWB(8994,3646,2,1,1,3,0)=" "
^XWB(8994,3646,2,1,1,4,0)="This parameter is required UNLESS the NUMBER parameter is provided. If "
^XWB(8994,3646,2,1,1,5,0)="the NUMBER parameter is > 0, this parameter is not required. "
^XWB(8994,3646,2,1,1,6,0)=" "
^XWB(8994,3646,2,1,1,7,0)="If the user wants to list all Cancellation Reasons, let the Search "
^XWB(8994,3646,2,1,1,8,0)="parameter null and set the Number parameter to high value."
^XWB(8994,3646,2,2,0)="START^1^200^0^2"
^XWB(8994,3646,2,2,1,0)="^^2^2^3140623^"
^XWB(8994,3646,2,2,1,1,0)="The entry point to start searching from. If this value is set to ""M"", the "
^XWB(8994,3646,2,2,1,2,0)="search would start with any entries starting with the letter ""M""."
^XWB(8994,3646,2,3,0)="NUMBER^1^200^1^3"
^XWB(8994,3646,2,3,1,0)="^8994.021^2^2^3140623^^"
^XWB(8994,3646,2,3,1,1,0)="The maximum number of records to return. If this parameter is null, then "
^XWB(8994,3646,2,3,1,2,0)="the SEARCH parameter must be defined. "
^XWB(8994,3646,2,"B","NUMBER",3)=""
^XWB(8994,3646,2,"B","SEARCH",1)=""
^XWB(8994,3646,2,"B","START",2)=""
^XWB(8994,3646,2,"PARAMSEQ",1,1)=""
^XWB(8994,3646,2,"PARAMSEQ",2,2)=""
^XWB(8994,3646,2,"PARAMSEQ",3,3)=""
^XWB(8994,3646,3,0)="^8994.03^8^8^3140623^^^^"
^XWB(8994,3646,3,1,0)="Returns an array where each node of the array has the IEN of the "
^XWB(8994,3646,3,2,0)="cancellation reason in CANCELLATION REASON file (#409.2) and the free "
^XWB(8994,3646,3,3,0)="text name for the cancellation reason separated by the carat ""^""."
^XWB(8994,3646,3,4,0)=" "
^XWB(8994,3646,3,5,0)="Example:"
^XWB(8994,3646,3,6,0)="ARRAY(1)=1^WEATHER"
^XWB(8994,3646,3,7,0)="ARRAY(2)=2^INPATIENT STATUS"
^XWB(8994,3646,3,8,0)="ARRAY(3)=3^PATIENT DEATH"
^XWB(8994,3647,0)="MBAA APPOINTMENT MAKE^MAKE^MBAAMRP2^2^S^^^^1^^1"
^XWB(8994,3647,2,0)="^8994.02A^16^16"
^XWB(8994,3647,2,1,0)="DFN^1^200^1^1"
^XWB(8994,3647,2,2,0)="CLINIC^1^200^1^2"
^XWB(8994,3647,2,2,1,0)="^^1^1^3120718^"
^XWB(8994,3647,2,2,1,1,0)="CLINIC IEN"
^XWB(8994,3647,2,3,0)="APPDATE^1^200^1^3"
^XWB(8994,3647,2,3,1,0)="^^1^1^3120718^"
^XWB(8994,3647,2,3,1,1,0)="Appointment Date"
^XWB(8994,3647,2,4,0)="TYPE^1^200^1^4"
^XWB(8994,3647,2,4,1,0)="^8994.021^1^1^3150217^^"
^XWB(8994,3647,2,4,1,1,0)="PURPOSE OF VISIT"
^XWB(8994,3647,2,5,0)="LEN^1^200^1^5"
^XWB(8994,3647,2,5,1,0)="^^1^1^3120718^"
^XWB(8994,3647,2,5,1,1,0)="APPOINTMENT LENGTH"
^XWB(8994,3647,2,6,0)="LVL^1^10^0^15"
^XWB(8994,3647,2,6,1,0)="^^4^4^3150217^"
^XWB(8994,3647,2,6,1,1,0)="Flag that determines if an appointment can be made for a patient that "
^XWB(8994,3647,2,6,1,2,0)="already has an appointment scheduled for the same day as the current "
^XWB(8994,3647,2,6,1,3,0)="appointment request. Setting this parameter to 1 allows multiple "
^XWB(8994,3647,2,6,1,4,0)="appointments for the patient on the same day."
^XWB(8994,3647,2,7,0)="DESDT^1^200^0^16"
^XWB(8994,3647,2,7,1,0)="^8994.021^1^1^3150217^^^"
^XWB(8994,3647,2,7,1,1,0)="This is the patient's desired date/time for an appointment."
^XWB(8994,3647,2,8,0)="STYP^1^999^0^5"
^XWB(8994,3647,2,8,1,0)="^^2^2^3150217^"
^XWB(8994,3647,2,8,1,1,0)="This is the appointment type sub-category. It is a pointer to the Sharing "
^XWB(8994,3647,2,8,1,2,0)="Agreement Sub-Category file (#35.2)."
^XWB(8994,3647,2,9,0)="SRT^1^999^0^7"
^XWB(8994,3647,2,9,1,0)="^^8^8^3150217^"
^XWB(8994,3647,2,9,1,1,0)="This is the Scheduling Request Type. This is a set of codes:"
^XWB(8994,3647,2,9,1,2,0)="N = Next Available Appt"
^XWB(8994,3647,2,9,1,3,0)="C = Other than Next Available (Clinician Requested)"
^XWB(8994,3647,2,9,1,4,0)="P = Other than Next Available (Patient Requested)"
^XWB(8994,3647,2,9,1,5,0)="W = Walkin Appointment"
^XWB(8994,3647,2,9,1,6,0)="M = Multiple Appointment Booking"
^XWB(8994,3647,2,9,1,7,0)="A = Auto Rebook"
^XWB(8994,3647,2,9,1,8,0)="O = Other than Next Available Appointment"
^XWB(8994,3647,2,10,0)="OTHR^1^150^0^8"
^XWB(8994,3647,2,10,1,0)="^8994.021^2^2^3150217^^"
^XWB(8994,3647,2,10,1,1,0)="This is a free text field with a maximum of 150 characters. This is also "
^XWB(8994,3647,2,10,1,2,0)="known as the Booking Notes on the expanded view of the appointment."
^XWB(8994,3647,2,11,0)="CIO^1^200^0^9"
^XWB(8994,3647,2,11,1,0)="^^1^1^3150217^"
^XWB(8994,3647,2,11,1,1,0)="Code for Check In. Value can be null or CI."
^XWB(8994,3647,2,12,0)="LAB^1^200^0^10"
^XWB(8994,3647,2,12,1,0)="^^2^2^3150217^"
^XWB(8994,3647,2,12,1,1,0)="If the patient needs to have labs before the appointment, this field is "
^XWB(8994,3647,2,12,1,2,0)="set to the labl appointment date/time."
^XWB(8994,3647,2,13,0)="XRAY^1^200^0^11"
^XWB(8994,3647,2,13,1,0)="^^2^2^3150217^"
^XWB(8994,3647,2,13,1,1,0)="If the patient needs X-Rays before the appointment, this will be the "
^XWB(8994,3647,2,13,1,2,0)="date/time for the X-Ray appointment."
^XWB(8994,3647,2,14,0)="EKG^1^200^0^12"
^XWB(8994,3647,2,14,1,0)="^^2^2^3150217^"
^XWB(8994,3647,2,14,1,1,0)="If the patient needs to have an EKG before  the appointment, this will be "
^XWB(8994,3647,2,14,1,2,0)="the appointment date/time for the EKG."
^XWB(8994,3647,2,15,0)="RQXRAY^1^200^0^13"
^XWB(8994,3647,2,15,1,0)="^^3^3^3150217^"
^XWB(8994,3647,2,15,1,1,0)="If the provider is requesting prior X-Rays be sent to the clinic prior to "
^XWB(8994,3647,2,15,1,2,0)="the appointment, this will be set to Y for Yes. Otherwise, it will be "
^XWB(8994,3647,2,15,1,3,0)="null."
^XWB(8994,3647,2,16,0)="CON^1^200^0^14"
^XWB(8994,3647,2,16,1,0)="^8994.021^2^2^3180515^^"
^XWB(8994,3647,2,16,1,1,0)="If the appointment is being made in response to a consult request, this "
^XWB(8994,3647,2,16,1,2,0)="parameter is set to the internal entry number for the consult request."
^XWB(8994,3647,2,"B","APPDATE",3)=""
^XWB(8994,3647,2,"B","CIO",11)=""
^XWB(8994,3647,2,"B","CLINIC",2)=""
^XWB(8994,3647,2,"B","CON",16)=""
^XWB(8994,3647,2,"B","DESDT",7)=""
^XWB(8994,3647,2,"B","DESIRED DATE OF APPT",7)=""
