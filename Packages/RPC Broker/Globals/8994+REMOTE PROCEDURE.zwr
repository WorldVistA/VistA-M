^XWB(8994,3864,0)="DSIYUTL5 PMUPDT UPDATE PM DATA^PMUPDT^DSIYUTL5^2^P^0"
^XWB(8994,3864,1,0)="^8994.01^14^14^3130731^^^^"
^XWB(8994,3864,1,1,0)="PMUPDT"
^XWB(8994,3864,1,2,0)="RPC which allows update of the two multiples within the Equipment "
^XWB(8994,3864,1,3,0)="Management file for Responsible Shop & Frequencies."
^XWB(8994,3864,1,4,0)=" "
^XWB(8994,3864,1,5,0)="GUI must send all data for the Responsible shop or current data will be "
^XWB(8994,3864,1,6,0)="replaced with nulls."
^XWB(8994,3864,1,7,0)=" "
^XWB(8994,3864,1,8,0)="If the responsible shop exists in ^ENG(6914,IEN) it will be replaced with "
^XWB(8994,3864,1,9,0)="new data.  If the Frequency code exists with in the frequency multiple "
^XWB(8994,3864,1,10,0)="within the responsible shop, it will be replaced with new data.   Else, "
^XWB(8994,3864,1,11,0)="new nodes will be added for each."
^XWB(8994,3864,1,12,0)=" "
^XWB(8994,3864,1,13,0)="RET(1) = IEN for Responsible Shop multiple ^ Comment showing frequency "
^XWB(8994,3864,1,14,0)="added successfully"
