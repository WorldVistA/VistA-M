^XWB(8994,4443,0)="ORWDRA32 RADLONG^RADLONG^ORWDRA32^1"
^XWB(8994,4444,0)="ORDEA AUINTENT^AUINTENT^ORDEA^1"
^XWB(8994,4444,1,0)="^^1^1^3190606^"
^XWB(8994,4444,1,1,0)="This audits 'intention to sign' for Controlled Substance orders."
^XWB(8994,4444,2,0)="^8994.02A^2^2"
^XWB(8994,4444,2,1,0)="ORIFN^1^^1^1"
^XWB(8994,4444,2,2,0)="STATE^1^^1^2"
^XWB(8994,4444,2,"B","ORIFN",1)=""
^XWB(8994,4444,2,"B","STATE",2)=""
^XWB(8994,4444,2,"PARAMSEQ",1,1)=""
^XWB(8994,4444,2,"PARAMSEQ",2,2)=""
^XWB(8994,4445,0)="ORWU SYSPARAM^JSYSPARM^ORWU^4^^^^0"
^XWB(8994,4445,2,0)="^8994.02A^1^1"
^XWB(8994,4445,2,1,0)="USER^1^^1^1"
^XWB(8994,4445,2,"B","USER",1)=""
^XWB(8994,4445,2,"PARAMSEQ",1,1)=""
^XWB(8994,4446,0)="SDECSTNG HELPLINK^HELPLINK^SDECSTNG^4^R^0^^0"
^XWB(8994,4446,1,0)="^8994.01^3^3^3180516^^^"
^XWB(8994,4446,1,1,0)="Returns list of Help Link display names and associated URLs from the SDEC "
^XWB(8994,4446,1,2,0)="Settings file (#409.98).  Entry 1 in the file contains national settings "
^XWB(8994,4446,1,3,0)="for VS GUI.  Entry 2 contains local settings."
^XWB(8994,4446,3,0)="^8994.03^6^6^3180516^^^"
^XWB(8994,4446,3,1,0)="The Global Array returned is a recordset consisting of the "
^XWB(8994,4446,3,2,0)="following fields:"
^XWB(8994,4446,3,3,0)=" "
^XWB(8994,4446,3,4,0)="1.  ID (sequential counter)"
^XWB(8994,4446,3,5,0)="2.  TEXT (display name in the hyperlink)"
^XWB(8994,4446,3,6,0)="3.  URL"
^XWB(8994,4447,0)="DVBAB PRF POPUP^TRIGRPOP^DVBCPRF^1^S^^^0^1"
^XWB(8994,4447,1,0)="^8994.01^2^2^3200512^^"
^XWB(8994,4447,1,1,0)="This RPC will return 1 if the patient has any active flags for Category I "
^XWB(8994,4447,1,2,0)="or Category II, a return of 0 if no active flags exist."
^XWB(8994,4447,2,0)="^8994.02A^1^1"
^XWB(8994,4447,2,1,0)="PTDFN^1^^1"
^XWB(8994,4447,2,1,1,0)="^^1^1^3200512^"
^XWB(8994,4447,2,1,1,1,0)="IEN in Patient File of given patient"
^XWB(8994,4447,2,"B","PTDFN",1)=""
^XWB(8994,4447,3,0)="^^2^2^3200512^"
^XWB(8994,4447,3,1,0)="Return 1 if the patient has any active flags for Category I "
^XWB(8994,4447,3,2,0)="or Category II, a return of 0 if no active flags exist."
^XWB(8994,4448,0)="DVBAB HASFLG^HASFLG^DVBCPRF^2^S^^^0^1"
^XWB(8994,4448,1,0)="^8994.01^1^1^3200512^^^"
^XWB(8994,4448,1,1,0)="This RPC will return an array of active assigned flags for a patient"
^XWB(8994,4448,2,0)="^8994.02A^1^1"
^XWB(8994,4448,2,1,0)="PTDFN^1^^1"
^XWB(8994,4448,2,1,1,0)="^8994.021^1^1^3200512^^"
^XWB(8994,4448,2,1,1,1,0)="Patient IEN from the Patient File"
^XWB(8994,4448,2,"B","PTDFN",1)=""
^XWB(8994,4448,3,0)="^^4^4^3200512^"
^XWB(8994,4448,3,1,0)="Returns array DVBY listing active assigned flags array DVBY has form:"
^XWB(8994,4448,3,2,0)="DVBY(flagID) = flagID^flagname,CAT where CAT1 is 1 if flag is cat 1, 0 if"
^XWB(8994,4448,3,3,0)="cat 2"
^XWB(8994,4448,3,4,0)="DVBY = Num of items returned in array ORY = num of flags"
^XWB(8994,4449,0)="DVBAB GETFLAG^GETFLG^DVBCPRF^2^S^^^0^1"
^XWB(8994,4449,1,0)="^8994.01^1^1^3200512^^^^"
^XWB(8994,4449,1,1,0)="RPC returns detailed flag information for flag selected"
^XWB(8994,4449,2,0)="^8994.02A^2^2"
^XWB(8994,4449,2,1,0)="PTDFN^1^^1"
^XWB(8994,4449,2,1,1,0)="^^1^1^3200512^"
^XWB(8994,4449,2,1,1,1,0)="Patient IEN from the Patient File"
^XWB(8994,4449,2,2,0)="FLAGID^1^^1"
^XWB(8994,4449,2,2,1,0)="^8994.021^1^1^3200512^^^^"
^XWB(8994,4449,2,2,1,1,0)="FLAGID of flag selected for detail information"
^XWB(8994,4449,2,"B","FLAGID",2)=""
^XWB(8994,4449,2,"B","PTDFN",1)=""
^XWB(8994,4449,3,0)="^8994.03^1^1^3200512^^^^"
^XWB(8994,4449,3,1,0)="An array is returned with detailed information of flag"
^XWB(8994,4450,0)="DVBAB CLRFLG^CLEAR^DVBCPRF^1^S^^^0^1"
^XWB(8994,4450,1,0)="^^1^1^3200512^"
^XWB(8994,4450,1,1,0)="Clears the ^TMP file created for Patient Record Flag data"
^XWB(8994,4451,0)="DVBAB SELF REFERRAL^SELFREF^DVBCENQ^2^R^0^^0^1^^0"
^XWB(8994,4451,1,0)="^8994.01^3^3^3200602^"
^XWB(8994,4451,1,1,0)="This RPC will return an array of Date/Time Locked(Field 5) and Form "
^XWB(8994,4451,1,2,0)="Title(Field 9) of File 396.17 if the VHA Internal DBQ Referral (Field 25) "
^XWB(8994,4451,1,3,0)="is Yes."
^XWB(8994,4451,2,0)="^8994.02A^1^1"
^XWB(8994,4451,2,1,0)="Patient IEN^1^^1"
^XWB(8994,4451,2,1,1,0)="^^1^1^3200602^"
^XWB(8994,4451,2,1,1,1,0)="PATIENT IEN number is from the PATIENT File #2"
^XWB(8994,4451,2,"B","Patient IEN",1)=""
^XWB(8994,4451,3,0)="^^4^4^3200602^"
^XWB(8994,4451,3,1,0)="An Array will be returned listing data most current to last:"
^XWB(8994,4451,3,2,0)="Example:"
^XWB(8994,4451,3,3,0)="RTN(1)=""6/1/2020 TEST DBQ PSYCH MENTAL DISORDERS"""
^XWB(8994,4451,3,4,0)="RTN(2)=""5/31/2020 DBQ ENDO THYROID & PARATHYROID XML"""
^XWB(8994,4452,0)="WEBG XPAR ADD^ADDPARAM^WEBGRPCS^1^R^^^^1"
^XWB(8994,4453,0)="WEBG XPAR UPDATE^UPDPARAM^WEBGRPCS^1^R^^^^1"
^XWB(8994,4454,0)="WEBG XPAR DELETE^DELPARAM^WEBGRPCS^1^R^^^^1"
^XWB(8994,4455,0)="WEBG XPAR GET^GETPARAM^WEBGRPCS^1^R^^^^1"
^XWB(8994,4456,0)="VIAB GETDEM^GETDEM^VIABRPC3^4^P^^^1^^^1"
^XWB(8994,4456,1,0)="^^4^4^3200618^"
^XWB(8994,4456,1,1,0)="CALLS VADPT WITH DFN AND RETURNS AN ARRAY WITH PATIENT DEMOGRAPHIC DATA :"
^XWB(8994,4456,1,2,0)=" "
^XWB(8994,4456,1,3,0)="Using GLOBAL ARRAY with $NA returning the ^TMP global reference. See PIMS "
^XWB(8994,4456,1,4,0)="manual for details of the ^VADPT API call."
^XWB(8994,4456,2,0)="^8994.02A^1^1"
^XWB(8994,4456,2,1,0)="DFN^1^12^1^1"
^XWB(8994,4456,2,1,1,0)="^^1^1^3200529^"
^XWB(8994,4456,2,1,1,1,0)="DFN = PATIENT FILE 2 IEN"
^XWB(8994,4456,2,"B","DFN",1)=""
^XWB(8994,4456,2,"PARAMSEQ",1,1)=""
^XWB(8994,4456,3,0)="^8994.03^48^48^3200618^^"
^XWB(8994,4456,3,1,0)="Arrayfrom VADPT that looks as such:"
^XWB(8994,4456,3,2,0)="^TMP(""VIABDEM"",6379,1)=""PATIENT,GETDEM"""
^XWB(8994,4456,3,3,0)="^TMP(""VIABDEM"",6379,2)=""SOCIALSECURITYNUMBER^SSN-NO-FOUR"""
^XWB(8994,4456,3,4,0)="^TMP(""VIABDEM"",6379,3)=""2440923^SEP 23,1944"""
^XWB(8994,4456,3,5,0)="^TMP(""VIABDEM"",6379,4)=75"
^XWB(8994,4456,3,6,0)="^TMP(""VIABDEM"",6379,5)=""M^MALE"""
^XWB(8994,4456,3,7,0)="^TMP(""VIABDEM"",6379,6)="""""
^XWB(8994,4456,3,8,0)="^TMP(""VIABDEM"",6379,7)="""""
^XWB(8994,4456,3,9,0)="^TMP(""VIABDEM"",6379,8)="""""
^XWB(8994,4456,3,10,0)="^TMP(""VIABDEM"",6379,9)=""6^PRESBYTERIAN"""
^XWB(8994,4456,3,11,0)="^TMP(""VIABDEM"",6379,10)=""2^MARRIED"""
^XWB(8994,4456,3,12,0)="^TMP(""VIABDEM"",6379,11)=1"
^XWB(8994,4456,3,13,0)="^TMP(""VIABDEM"",6379,11,1)=""2^NOT HISPANIC OR LATINO"""
^XWB(8994,4456,3,14,0)="^TMP(""VIABDEM"",6379,11,1,1)=""1^SELF IDENTIFICATION"""
^XWB(8994,4456,3,15,0)="^TMP(""VIABDEM"",6379,12)=3"
^XWB(8994,4456,3,16,0)="^TMP(""VIABDEM"",6379,12,1)=""5^ASIAN"""
^XWB(8994,4456,3,17,0)="^TMP(""VIABDEM"",6379,12,1,1)=""2^PROXY"""
^XWB(8994,4456,3,18,0)="^TMP(""VIABDEM"",6379,12,2)=""11^NATIVE HAWAIIAN OR OTHER PACIFIC ISLANDER"""
^XWB(8994,4456,3,19,0)="^TMP(""VIABDEM"",6379,12,2,1)=""4^UNKNOWN"""
^XWB(8994,4456,3,20,0)="^TMP(""VIABDEM"",6379,12,3)=""13^WHITE"""
^XWB(8994,4456,3,21,0)="^TMP(""VIABDEM"",6379,12,3,1)=""1^SELF IDENTIFICATION"""
^XWB(8994,4456,3,22,0)="^TMP(""VIABDEM"",6379,13)="""""
^XWB(8994,4456,3,23,0)="^TMP(""VIABDEM"",6379,13,1)="""""
^XWB(8994,4456,3,24,0)="^TMP(""VIABDEM"",6379,""BID"")=FOUR"
^XWB(8994,4456,3,25,0)="^TMP(""VIABDEM"",6379,""PID"")=""SSN-NO-FOUR"""
^XWB(8994,4456,3,26,0)=" "
^XWB(8994,4456,3,27,0)="Will appear to web service as such:"
^XWB(8994,4456,3,28,0)=" "
^XWB(8994,4456,3,29,0)="PATIENT,GETDEM"
^XWB(8994,4456,3,30,0)="SOCIALSECURITYNUMBER^SSN-NO-FOUR"
^XWB(8994,4456,3,31,0)="2440923^SEP 23,1944"
^XWB(8994,4456,3,32,0)=75
^XWB(8994,4456,3,33,0)="M^MALE"
^XWB(8994,4456,3,34,0)=" "
