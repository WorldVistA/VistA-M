^XWB(8994,4411,3,0)="^8994.03^18^18^3140401^^^"
^XWB(8994,4411,3,1,0)="Output"
^XWB(8994,4411,3,2,0)="  ORY - Total number of unique entries"
^XWB(8994,4411,3,3,0)="  0RY(1..n,0) - "
^XWB(8994,4411,3,4,0)="     Piece 1: Date/Time of the paste"
^XWB(8994,4411,3,5,0)="     Piece 2: User who pasted text"
^XWB(8994,4411,3,6,0)="     Piece 3: Copy from location (ien;package)"
^XWB(8994,4411,3,7,0)="     Piece 4: Copy from document title"
^XWB(8994,4411,3,8,0)="     Piece 5: Copy from document author (duz;name(last,first m))"
^XWB(8994,4411,3,9,0)="     Piece 6: Copy from Patient (dfn;name(last,first m))"
^XWB(8994,4411,3,10,0)="     Piece 7: Percent match between copied text and pasted text"
^XWB(8994,4411,3,11,0)="     Piece 8: Number of lines of pasted text"
^XWB(8994,4411,3,12,0)="     Piece 9: Capturing Application"
^XWB(8994,4411,3,13,0)="     Piece 10: Date/Time of the copy from document"
