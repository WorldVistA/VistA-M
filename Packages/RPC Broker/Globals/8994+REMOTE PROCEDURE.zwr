^XWB(8994,3595,2,"PARAMSEQ",6,6)=""
^XWB(8994,3595,3,0)="^8994.03^34^34^3210422^^^"
^XWB(8994,3595,3,1,0)="^TMP(""SDECRMG"",7628,0)=""T00030TYPE^T00030IEN^T00030KEY""_$c(30)"
^XWB(8994,3595,3,2,0)=" ^TMP(""SDECRMG"",7628,1)=""E^119^0|0|3141102|3140919|119""_$c(30)"
^XWB(8994,3595,3,3,0)=" ^TMP(""SDECRMG"",7628,2)=""E^69^0|1|3140924|3140905|69""_$c(30)"
^XWB(8994,3595,3,4,0)=" FILTER(4)=DESIREDDATE^02/20/2015~03/01/2015"
^XWB(8994,3595,3,5,0)=" FILTER(5)=ORIGINATIONDATE^11/23/2014~11/24/2014~11/25/2014"
^XWB(8994,3595,3,6,0)=" FILTER(6)=CLINICS^CARDIOLOGY CLINIC~FAMILY PRACTICE"
^XWB(8994,3595,3,7,0)=" FILTER(7)=PATIENTNAME^15~23~100"
^XWB(8994,3595,3,8,0)=" FILTER(8)=SCVISIT^False"
^XWB(8994,3595,3,9,0)=" "
^XWB(8994,3595,3,10,0)=" Waittime is a set of codes: <30,30-60,60-90,>=90,all"
^XWB(8994,3595,3,11,0)=" Priority group is a set of codes NULL, GROUP 1 - GROUP 7"
^XWB(8994,3595,3,12,0)=" Request type is a set of codes E(wait list),A(Appt request),R(recall"
^XWB(8994,3595,3,13,0)=" list),C(consult)"
^XWB(8994,3595,3,14,0)=" SCVisit is true/false"
^XWB(8994,3595,3,15,0)="^TMP(""SDECRMG"",7628,3)=""E^148^0|1|3141003|3140929|148""_$c(30)"
^XWB(8994,3595,3,16,0)=" ^TMP(""SDECRMG"",7628,4)=""E^187^0|1|3141008|3141008|187""_$c(30)"
^XWB(8994,3595,3,17,0)=" ^TMP(""SDECRMG"",7628,5)=""E^143^0|1|3141009|3140925|143""_$c(30)"
^XWB(8994,3595,3,18,0)=" ^TMP(""SDECRMG"",7628,6)=""E^181^0|1|3141009|3141008|181""_$c(30)"
^XWB(8994,3595,3,19,0)=" ^TMP(""SDECRMG"",7628,7)=""R^78^0|1|3141016|3141014|78""_$c(30)"
^XWB(8994,3595,3,20,0)=" ^TMP(""SDECRMG"",7628,8)=""E^205^0|1|3141017|3141014|205""_$c(30)"
^XWB(8994,3595,3,21,0)=" ^TMP(""SDECRMG"",7628,9)=""E^207^0|1|3141017|3141014|207""_$c(30)"
^XWB(8994,3595,3,22,0)=" ^TMP(""SDECRMG"",7628,10)=""E^192^0|1|3141023|3141010|192""_$c(30)"
^XWB(8994,3595,3,23,0)=" ^TMP(""SDECRMG"",7628,11)=""R^47^0|1|3141023|3141010|47""_$c(30)"
^XWB(8994,3595,3,24,0)=" ^TMP(""SDECRMG"",7628,12)=""E^199^0|1|3141023|3141013|199""_$c(30)"
^XWB(8994,3595,3,25,0)=" ^TMP(""SDECRMG"",7628,13)=""R^67^0|1|3141023|3141014|67""_$c(30)"
^XWB(8994,3595,3,26,0)=" ^TMP(""SDECRMG"",7628,14)=""R^64^0|1|3141024|3141014|64""_$c(30)"
^XWB(8994,3595,3,27,0)=" ^TMP(""SDECRMG"",7628,15)=""R^114^0|1|3141028|114""_$c(30)"
^XWB(8994,3595,3,28,0)=" ^TMP(""SDECRMG"",7628,16)=""R^60^0|1|3141029|3141014|60""_$c(30)"
^XWB(8994,3595,3,29,0)=" ^TMP(""SDECRMG"",7628,17)=""R^94^0|1|3141029|3141020|94""_$c(30)"
^XWB(8994,3595,3,30,0)=" ^TMP(""SDECRMG"",7628,18)=""E^159^0|1|3141030|3141002|159""_$c(30)"
^XWB(8994,3595,3,31,0)=" "
^XWB(8994,3595,3,32,0)=" The first piece is the request type (E,R,A,C)"
^XWB(8994,3595,3,33,0)=" The second piece is the IEN of the request type"
^XWB(8994,3595,3,34,0)=" The 3rd piece is the KEY to retrieving further data"
^XWB(8994,3596,0)="SDECRMG RECCNT^RECCNT^SDECRMG1^1^R^0^^0"
^XWB(8994,3596,1,0)="^^2^2^3150629^"
^XWB(8994,3596,1,1,0)="Returns the number of entries in the filter call in "
^XWB(8994,3596,1,2,0)="^TMP(""SDECIDX"",$J,""COUNT"") node."
^XWB(8994,3597,0)="SDECIDX RECCNT^RECCNT^SDECIDX^1^R^0^^0"
^XWB(8994,3597,1,0)="^^1^1^3150420^"
^XWB(8994,3597,1,1,0)="Returns the number of entries in the ^XTMP(""SDEC"",""IDX"",""COUNT"") node."
^XWB(8994,3598,0)="SDECIDX GETREC^GETREC^SDECIDX^4^R^0^^0"
^XWB(8994,3598,1,0)="^^6^6^3150420^"
^XWB(8994,3598,1,1,0)="This RPC returns content from the ^XTMP(""SDEC"",""IDX"" global and serves as "
^XWB(8994,3598,1,2,0)="the default start up list.  The records are sorted by:"
^XWB(8994,3598,1,3,0)="Priority Group"
^XWB(8994,3598,1,4,0)="  SVC %"
^XWB(8994,3598,1,5,0)="    Desired Date"
^XWB(8994,3598,1,6,0)="      Origination Date"
^XWB(8994,3598,2,0)="^8994.02A^3^3"
^XWB(8994,3598,2,1,0)="LASTREC^1^^0^1"
^XWB(8994,3598,2,1,1,0)="^^2^2^3150420^"
^XWB(8994,3598,2,1,1,1,0)="Holds the ""KEY"" of the last returned record and indicates where to start "
^XWB(8994,3598,2,1,1,2,0)="with the next bolus of records."
^XWB(8994,3598,2,2,0)="MAXREC^1^^0^2"
^XWB(8994,3598,2,2,1,0)="^^1^1^3150420^"
^XWB(8994,3598,2,2,1,1,0)="Indicates the number of records to return. Defaults to 25."
^XWB(8994,3598,2,3,0)="STYLE^1^1^0^3"
^XWB(8994,3598,2,3,1,0)="^8994.021^1^1^3150420^^"
^XWB(8994,3598,2,3,1,1,0)="Available values are ""R"" and ""D"". Indicates format of return data."
^XWB(8994,3598,2,"B","LASTREC",1)=""
^XWB(8994,3598,2,"B","MAXREC",2)=""
^XWB(8994,3598,2,"B","STYLE",3)=""
^XWB(8994,3598,2,"PARAMSEQ",1,1)=""
^XWB(8994,3598,2,"PARAMSEQ",2,2)=""
^XWB(8994,3598,2,"PARAMSEQ",3,3)=""
^XWB(8994,3598,3,0)="^^5^5^3150420^"
^XWB(8994,3598,3,1,0)="Style ""D"" returns two nodes the first containing the Header format and "
^XWB(8994,3598,3,2,0)="the second the data."
^XWB(8994,3598,3,3,0)=" "
^XWB(8994,3598,3,4,0)="Style ""R"" returns a Header node and then one or mode nodes containing the "
^XWB(8994,3598,3,5,0)="type of record, the record IEN and the record key."
^XWB(8994,3599,0)="SDEC WLHIDE^WLHIDE^SDEC^4^R^0^^0"
^XWB(8994,3599,1,0)="^^2^2^3150420^"
^XWB(8994,3599,1,1,0)="GET wait list entries in which the associated clinic's 'HIDE FROM DISPLAY "
^XWB(8994,3599,1,2,0)="IN VSE GUI? field is 'YES'."
^XWB(8994,3599,3,0)="^^12^12^3150420^"
^XWB(8994,3599,3,1,0)="RETURN:"
^XWB(8994,3599,3,2,0)=" DFN"
^XWB(8994,3599,3,3,0)=" ORIGDT   = ORIGINATING DATE"
^XWB(8994,3599,3,4,0)=" TYPE     = Wait List Type"
^XWB(8994,3599,3,5,0)=" CLINIEN  = Clinic IEN pointer to HOSPITAL LOCATION file 44"
^XWB(8994,3599,3,6,0)=" WLCLNAME = WL SPECIFIC CLINIC"
^XWB(8994,3599,3,7,0)=" USERIEN  = Originating User"
^XWB(8994,3599,3,8,0)=" USERNAME = Originating User name"
^XWB(8994,3599,3,9,0)=" DATE1    = Date/Time Entered"
^XWB(8994,3599,3,10,0)=" DAPTDT   = Desired Date of appointment"
^XWB(8994,3599,3,11,0)=" STATUS   = Current Status"
^XWB(8994,3599,3,12,0)="            OPEN   CLOSED"
^XWB(8994,3600,0)="SDEC ARSET^ARSET^SDEC^1^R^0^^0"
^XWB(8994,3600,1,0)="^8994.01^1^1^3190117^^^^"
^XWB(8994,3600,1,1,0)="Appointment Request Set"
^XWB(8994,3600,2,0)="^8994.02A^1^1"
^XWB(8994,3600,2,1,0)="INP^2^^1^1"
^XWB(8994,3600,2,1,1,0)="^^69^69^3190117^"
^XWB(8994,3600,2,1,1,1,0)="  ;  INP(1)  = (integer)  Wait List IEN point to"
^XWB(8994,3600,2,1,1,2,0)="  ;                       SDEC APPT REQUEST file 409.85."
^XWB(8994,3600,2,1,1,3,0)="  ;                       If null, a new entry will be added"
^XWB(8994,3600,2,1,1,4,0)="  ;  INP(2)  = (text)     DFN Pointer to the PATIENT file 2"
^XWB(8994,3600,2,1,1,5,0)="  ;  INP(3)  = (date)     Originating Date/time in external date form"
^XWB(8994,3600,2,1,1,6,0)="  ;  INP(4)  = (text)     Institution name NAME field from the "
^XWB(8994,3600,2,1,1,7,0)="INSTITUTION file"
^XWB(8994,3600,2,1,1,8,0)="  ;  INP(5)  = (text)     Request Type"
^XWB(8994,3600,2,1,1,9,0)="  ;  INP(6)  = (text)     REQ Specific Clinic name - NAME field in file 44"
^XWB(8994,3600,2,1,1,10,0)="  ;  INP(7)  = (text)     Originating User name  - NAME field in NEW "
^XWB(8994,3600,2,1,1,11,0)="PERSON file 200"
^XWB(8994,3600,2,1,1,12,0)="  ;  INP(8)  = (text)     Priority - 'ASAP' or 'FUTURE'"
^XWB(8994,3600,2,1,1,13,0)="  ;  INP(9)  = (text)     Request By - 'PROVIDER' or 'PATIENT'"
^XWB(8994,3600,2,1,1,14,0)="  ;  INP(10) = (text)     Provider name  - NAME field in NEW PERSON file "
^XWB(8994,3600,2,1,1,15,0)=200
^XWB(8994,3600,2,1,1,16,0)="  ;  INP(11) = (date)     Desired Date of appointment in external format."
^XWB(8994,3600,2,1,1,17,0)="  ;  INP(12) = (text)     comment - maximum of 24K characters.  Note: "
^XWB(8994,3600,2,1,1,18,0)="lines are to separated by carriage return (ASCII 13)."
^XWB(8994,3600,2,1,1,19,0)="  ;  INP(13) = (text)     ENROLLMENT PRIORITY - Valid Values are:"
^XWB(8994,3600,2,1,1,20,0)="  ;                                             GROUP 1"
^XWB(8994,3600,2,1,1,21,0)="  ;                                             GROUP 2"
^XWB(8994,3600,2,1,1,22,0)="  ;                                             GROUP 3"
^XWB(8994,3600,2,1,1,23,0)="  ;                                             GROUP 4"
^XWB(8994,3600,2,1,1,24,0)="  ;                                             GROUP 5"
^XWB(8994,3600,2,1,1,25,0)="  ;                                             GROUP 6"
^XWB(8994,3600,2,1,1,26,0)="  ;                                             GROUP 7"
^XWB(8994,3600,2,1,1,27,0)="  ;                                             GROUP 8"
^XWB(8994,3600,2,1,1,28,0)="  ;  INP(14) = (text)     MULTIPLE APPOINTMENT RTC      NO; YES"
^XWB(8994,3600,2,1,1,29,0)="  ;  INP(15) = (integer)  MULT APPT RTC INTERVAL integer between 1-365"
^XWB(8994,3600,2,1,1,30,0)="  ;  INP(16) = (integer)  MULT APPT NUMBER integer between 1-100"
^XWB(8994,3600,2,1,1,31,0)="  ;  INP(17) = Patient Contacts separated by ::"
^XWB(8994,3600,2,1,1,32,0)="  ;            Each :: piece has the following ~~ pieces:"
^XWB(8994,3600,2,1,1,33,0)="  ;            1) = (date)    DATE ENTERED external date/time"
^XWB(8994,3600,2,1,1,34,0)="  ;            2) = (text)    PC ENTERED BY USER ID or NAME - Pointer to "
^XWB(8994,3600,2,1,1,35,0)="  ;                           NEW PERSON file or NAME"
^XWB(8994,3600,2,1,1,36,0)="  ;            4) = (text)    ACTION - 'Called' or 'Message Left'"
^XWB(8994,3600,2,1,1,37,0)="  ;            5) = (optional) PATIENT PHONE Free-Text 4-20 characters"
^XWB(8994,3600,2,1,1,38,0)="  ;  INP(18) = (optional) SERVICE CONNECTED PRIORITY valid values are NO  "
^XWB(8994,3600,2,1,1,39,0)="YES"
^XWB(8994,3600,2,1,1,40,0)="  ;  INP(19) = (optional) SERVICE CONNECTED PERCENTAGE = numeric 0-100"
^XWB(8994,3600,2,1,1,41,0)="  ;  INP(20) = (optional) MRTC calculated preferred dates separated by "
^XWB(8994,3600,2,1,1,42,0)="pipe |:"
^XWB(8994,3600,2,1,1,43,0)="  ;                       Each date can be in external format with no "
^XWB(8994,3600,2,1,1,44,0)="time."
^XWB(8994,3600,2,1,1,45,0)=" ;  INP(21) = (optional) CLINIC STOP pointer to CLINIC STOP file 40.7"
^XWB(8994,3600,2,1,1,46,0)=" ;                       used to populate the REQ SERVICE/SPECIALTY field "
^XWB(8994,3600,2,1,1,47,0)="in 409.85"
^XWB(8994,3600,2,1,1,48,0)=" ;  INP(22) = (optional) Appointment Type ID pointer to APPOINTMENT TYPE "
^XWB(8994,3600,2,1,1,49,0)="file 409.1"
^XWB(8994,3600,2,1,1,50,0)=" ;  INP(23) = (optional) Patient Status"
^XWB(8994,3600,2,1,1,51,0)=" ;                          N = NEW"
^XWB(8994,3600,2,1,1,52,0)=" ;                          E = ESTABLISHED"
^XWB(8994,3600,2,1,1,53,0)=" ;  INP(24) = (optional) MULT APPTS MADE"
^XWB(8994,3600,2,1,1,54,0)=" ;                    list of child pointers to SDEC APPOINTMENT and/or "
^XWB(8994,3600,2,1,1,55,0)="SDEC APPT REQUEST files separated by pipe"
^XWB(8994,3600,2,1,1,56,0)=" ;                    each pipe piece contains the following ~ pieces:"
^XWB(8994,3600,2,1,1,57,0)=" ;                1. Appointment Id pointer to SDEC APPOINTMENT file "
^XWB(8994,3600,2,1,1,58,0)=409.84
^XWB(8994,3600,2,1,1,59,0)=" ;                2. Request Id pointer to SDEC APPT REQUEST file 409.85"
^XWB(8994,3600,2,1,1,60,0)=" ;  INP(25) = (optional) PARENT REQUEST pointer to SDEC APPT REQUEST file "
^XWB(8994,3600,2,1,1,61,0)=409.85
^XWB(8994,3600,2,1,1,62,0)=" ;  INP(26) = (optional) NLT (No later than) [CPRS RTC REQUIREMENT]"
^XWB(8994,3600,2,1,1,63,0)=" ;  INP(27) = (optional) PREREQ (Prerequisites) [CPRS RTC REQUIREMENT]"
^XWB(8994,3600,2,1,1,64,0)=" ;  INP(28) = (optional) ORDER IEN [CPRS RTC REQUIREMENT]"
^XWB(8994,3600,2,1,1,65,0)=" ;  INP(29) = (optional) VAOS GUID  <== wtc patch 686 3/21/18 added for "
^XWB(8994,3600,2,1,1,66,0)="VAOS requests"
^XWB(8994,3600,2,1,1,67,0)=" ;  INP(30) = (optional) source of the call.  See Scheduling Events "
^XWB(8994,3600,2,1,1,68,0)="(#409.94), field 1 for list of values.  Default is ""GUI""."
^XWB(8994,3600,2,1,1,69,0)=" ; "
^XWB(8994,3600,2,"B","INP",1)=""
^XWB(8994,3600,2,"PARAMSEQ",1,1)=""
^XWB(8994,3600,3,0)="^8994.03^2^2^3190117^^^^"
^XWB(8994,3600,3,1,0)="Return a single entry in the Global Array with the fields ERRORID and "
^XWB(8994,3600,3,2,0)="ERRORTEXT."
^XWB(8994,3601,0)="SDEC ARCLOSE^ARCLOSE^SDEC^1^R^0^^0"
^XWB(8994,3601,1,0)="^8994.01^2^2^3230119^^^"
^XWB(8994,3601,1,1,0)="Remove a Patient from the Appointment Requested by setting the STATUS to "
^XWB(8994,3601,1,2,0)="CLOSED and updating the DISPOSITION fields."
^XWB(8994,3601,2,0)="^8994.02A^6^5"
^XWB(8994,3601,2,2,0)="REQIEN^1^^1^1"
^XWB(8994,3601,2,2,1,0)="^^1^1^3230119^"
^XWB(8994,3601,2,2,1,1,0)="Appointment Request IEN - Pointer to SDEC APPT REQUEST (#409.85) File."
^XWB(8994,3601,2,3,0)="DISPOSITION^1^^1^2"
^XWB(8994,3601,2,3,1,0)="^^1^1^3230119^"
^XWB(8994,3601,2,3,1,1,0)="Disposition - Pointer to SDEC DISPOSITION REASON (#409.853) File."
^XWB(8994,3601,2,4,0)="USER^1^^0^3"
^XWB(8994,3601,2,4,1,0)="^^1^1^3230119^"
^XWB(8994,3601,2,4,1,1,0)="User DUZ - Pointer to NEW PERSON (#200) File."
^XWB(8994,3601,2,5,0)="DISPOSITIONDT^1^^0^4"
^XWB(8994,3601,2,5,1,0)="^^2^2^3230119^"
^XWB(8994,3601,2,5,1,1,0)="Date Dispositioned in external format. Defaults to current date if not "
^XWB(8994,3601,2,5,1,2,0)="sent."
^XWB(8994,3601,2,6,0)="PID^1^^0^5"
^XWB(8994,3601,2,6,1,0)="^^1^1^3230119^"
^XWB(8994,3601,2,6,1,1,0)="CID/Preferred Date of Appointment in extrenal .NET format."
^XWB(8994,3601,2,"B","DISPOSITION",3)=""
