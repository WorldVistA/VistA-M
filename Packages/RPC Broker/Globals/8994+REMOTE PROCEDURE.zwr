^XWB(8994,5135,2,2,1,2,0)="                               Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5135,2,2,1,3,0)="     SDCONTEXT(""USER DUZ"")   = The DUZ of the user taking action on the"
^XWB(8994,5135,2,2,1,4,0)="                               calling application. "
^XWB(8994,5135,2,2,1,5,0)="     SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,5135,2,2,1,6,0)="                               calling application."
^XWB(8994,5135,2,2,1,7,0)="     SDCONTEXT(""PATIENT DFN"")= The name of the patient taking action on "
^XWB(8994,5135,2,2,1,8,0)="                               the calling application."
^XWB(8994,5135,2,2,1,9,0)="     SDCONTEXT(""PATIENT ICN"")= The ICN of the patient taking action on the"
^XWB(8994,5135,2,2,1,10,0)="                               calling application."
^XWB(8994,5135,2,3,0)="SDINPUT^2^32000^1^2"
^XWB(8994,5135,2,3,1,0)="^^14^14^3250516^"
^XWB(8994,5135,2,3,1,1,0)="SDINPUT(""LOOKUPSTRING"") = The lookup value used to match devices by name."
^XWB(8994,5135,2,3,1,2,0)=" "
^XWB(8994,5135,2,3,1,3,0)="This value cannot contain the * wildcard character."
^XWB(8994,5135,2,3,1,4,0)="This value cannot exceed 15 characters in length."
^XWB(8994,5135,2,3,1,5,0)=" "
^XWB(8994,5135,2,3,1,6,0)=" "
^XWB(8994,5135,2,3,1,7,0)="Example:"
^XWB(8994,5135,2,3,1,8,0)=" ""PR"""
^XWB(8994,5135,2,3,1,9,0)=" "
^XWB(8994,5135,2,3,1,10,0)="Would return devices containing ""PR""."
^XWB(8994,5135,2,3,1,11,0)=" "
^XWB(8994,5135,2,3,1,12,0)=" ""PRINTER1"""
^XWB(8994,5135,2,3,1,13,0)=" ""PRT-AREA1"""
^XWB(8994,5135,2,3,1,14,0)=" ""ICU-PRT3"""
