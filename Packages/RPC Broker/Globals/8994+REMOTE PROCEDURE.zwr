^XWB(8994,2531,0)="DSIV DM GET STATUS^STATUS^DSIVDM^4^A^^^1"
^XWB(8994,2531,1,0)="^^2^2^3050921^"
^XWB(8994,2531,1,1,0)="This RPC has been archived as of June 20, 2005.  No applications should "
^XWB(8994,2531,1,2,0)="use this RPC after this date.  Please use the new RPC: DSIV DM GET STATUS1"
^XWB(8994,2531,2,0)="^8994.02A^^0"
^XWB(8994,2531,2,1,0)="TRANID^1^50^0^1"
^XWB(8994,2531,2,1,1,0)="^^2^2^3030606^"
^XWB(8994,2531,2,1,1,1,0)="This is the transaction ID that was passed to the VistA Imaging Import "
^XWB(8994,2531,2,1,1,2,0)="Queue.  It must be in the format DSS;xxxxxx."
^XWB(8994,2531,2,2,0)="WHICH^1^4^0^2"
^XWB(8994,2531,2,2,1,0)="^8994.021^9^9^3030606^^^"
^XWB(8994,2531,2,2,1,1,0)="This is a string of codes to determine which transaction statuses to "
^XWB(8994,2531,2,2,1,2,0)="return.  The parameter WHICH and TRANID are mutually excluded.  That is "
^XWB(8994,2531,2,2,1,3,0)="if TRANID is passed, the parameter WHICH will not even be evaluated or "
^XWB(8994,2531,2,2,1,4,0)="acted upon."
^XWB(8994,2531,2,2,1,5,0)=" "
^XWB(8994,2531,2,2,1,6,0)="If WHICH contains A, then retrieve all transactions for all statuses"
^XWB(8994,2531,2,2,1,7,0)="If WHICH contains E, then retrieve all ERROR transactions"
^XWB(8994,2531,2,2,1,8,0)="If WHICH contains S, then retrieve all SUCCESSFUL transactions"
^XWB(8994,2531,2,2,1,9,0)="If WHICH contains P, then retrieve all PENDING transactions"
^XWB(8994,2531,2,3,0)="DEL^1^1^0^3"
^XWB(8994,2531,2,3,1,0)="^^6^6^3030606^"
^XWB(8994,2531,2,3,1,1,0)="This flag (0 or 1) will control whether or not the transaction record "
^XWB(8994,2531,2,3,1,2,0)="should be deleted from file 19621.   Default value is 0, do not delete"
^XWB(8994,2531,2,3,1,3,0)=" "
^XWB(8994,2531,2,3,1,4,0)="If DEL=1 then delete all SUCCESSFUL transactions returned in the RPC"
^XWB(8994,2531,2,3,1,5,0)="call.  So this will not delete import requests in an error state or"
^XWB(8994,2531,2,3,1,6,0)="pending."
^XWB(8994,2531,2,4,0)="APP^1^7^1^4"
^XWB(8994,2531,2,4,1,0)="^^1^1^3040712^^"
^XWB(8994,2531,2,4,1,1,0)="This is the application code assigned to a DSS application.  "
^XWB(8994,2531,2,"B","APP",4)=""
^XWB(8994,2531,2,"B","DEL",3)=""
^XWB(8994,2531,2,"B","TRANID",1)=""
^XWB(8994,2531,2,"B","WHICH",2)=""
^XWB(8994,2531,2,"PARAMSEQ",1,1)=""
^XWB(8994,2531,2,"PARAMSEQ",2,2)=""
^XWB(8994,2531,2,"PARAMSEQ",3,3)=""
^XWB(8994,2531,2,"PARAMSEQ",4,4)=""
^XWB(8994,2531,3,0)="^^15^15^3041027^"
^XWB(8994,2531,3,1,0)="On error, return a single message:"
^XWB(8994,2531,3,2,0)="  List[0] := -1^message"
^XWB(8994,2531,3,3,0)=" "
^XWB(8994,2531,3,4,0)="Otherwise, return a multi-line list for each record whether only one "
^XWB(8994,2531,3,5,0)="record is returned or multiple records are returned.  The format for each "
^XWB(8994,2531,3,6,0)="returned record is:"
^XWB(8994,2531,3,7,0)="  List[n]     := transaction ID ^ status [- additional msg]"
^XWB(8994,2531,3,8,0)="  List[n+m]   := optional text for errors or successful imports"
^XWB(8994,2531,3,9,0)="  List[n+m+1] := $END"
^XWB(8994,2531,3,10,0)=" "
^XWB(8994,2531,3,11,0)="Every record will have at least two lines, the TranID line and the $END "
^XWB(8994,2531,3,12,0)="line.  A record may or may not have optional text."
^XWB(8994,2531,3,13,0)=" "
^XWB(8994,2531,3,14,0)="Status will be one of three: Error, Successfully Imported, Pending"
^XWB(8994,2531,3,15,0)="Status may or may not have additional text following the status name."
^XWB(8994,2532,0)="DSIV DM ADD/DELETE QUEUE^UPD^DSIVDM^1^A"
^XWB(8994,2532,1,0)="^8994.01^9^9^3090217^^^"
^XWB(8994,2532,1,1,0)="This will allow you to add or delete an entry to file 19621.  When you "
^XWB(8994,2532,1,2,0)="use the VistA Imaging import an image API, you are returned a queue "
^XWB(8994,2532,1,3,0)="number.  This number means that VistA Imaging background processor "
^XWB(8994,2532,1,4,0)="accepted your request and place it in a queue and will process it in due "
^XWB(8994,2532,1,5,0)="time.  After you get this successful queue message you should immediately "
^XWB(8994,2532,1,6,0)="file that data through this RPC."
^XWB(8994,2532,1,7,0)=" "
^XWB(8994,2532,1,8,0)="This file is to allow communication between the VistA Imaging background "
^XWB(8994,2532,1,9,0)="processor and the DSS Document Management system."
^XWB(8994,2532,2,0)="^8994.02A^5^5"
^XWB(8994,2532,2,1,0)="ACT^1^1^0^1"
^XWB(8994,2532,2,1,1,0)="^^4^4^3040712^^"
^XWB(8994,2532,2,1,1,1,0)="This is the action that should be taken.  The default value if not passed "
^XWB(8994,2532,2,1,1,2,0)="is A."
^XWB(8994,2532,2,1,1,3,0)="  ACT = A then add a record to file 19621 - TRANID and QUEUE required"
^XWB(8994,2532,2,1,1,4,0)="  ACT = D then delete a record in file 19621 - TRANID is only required"
^XWB(8994,2532,2,2,0)="TRANID^1^50^0^2"
^XWB(8994,2532,2,2,1,0)="^8994.021^5^5^3030606^^"
^XWB(8994,2532,2,2,1,1,0)="This is the transaction ID you passed to the VistA Imaging import API.  "
^XWB(8994,2532,2,2,1,2,0)="It must be in the format DSS;xxxxxx"
^XWB(8994,2532,2,2,1,3,0)=" "
^XWB(8994,2532,2,2,1,4,0)="This is optional.  If it is not passed, then a transaction ID will be "
^XWB(8994,2532,2,2,1,5,0)="built from the APP parameter."
^XWB(8994,2532,2,3,0)="QUEUE^1^20^0^3"
^XWB(8994,2532,2,3,1,0)="^8994.021^3^3^3030606^^^"
^XWB(8994,2532,2,3,1,1,0)="This is only required if you have successfully queued an import request "
^XWB(8994,2532,2,3,1,2,0)="to VistA Imaging.  VistA Imaging import API will return you a QUEUE "
^XWB(8994,2532,2,3,1,3,0)="number.  This is only required if you are adding a record to file 19606."
^XWB(8994,2532,2,4,0)="APP^1^7^0^4"
^XWB(8994,2532,2,4,1,0)="^8994.021^22^22^3090217^^^^"
^XWB(8994,2532,2,4,1,1,0)="This is optional only for DocManager.  For all othr DSS applications, "
^XWB(8994,2532,2,4,1,2,0)="this is required."
^XWB(8994,2532,2,4,1,3,0)=" "
^XWB(8994,2532,2,4,1,4,0)="DSS Product Prefixes for VistA Imaging:"
^XWB(8994,2532,2,4,1,5,0)="  Product Name                            Product Prefix"
^XWB(8994,2532,2,4,1,6,0)="  DocManager                              DM"
^XWB(8994,2532,2,4,1,7,0)="  CNT                                     CNT"
^XWB(8994,2532,2,4,1,8,0)="  Total Notes                             TNT"
^XWB(8994,2532,2,4,1,9,0)="  PFCS                                    PFCS"
^XWB(8994,2532,2,4,1,10,0)="  PTF                                     PTF"
^XWB(8994,2532,2,4,1,11,0)="  VRM                                     VRM"
^XWB(8994,2532,2,4,1,12,0)="  DRM                                     DRM"
^XWB(8994,2532,2,4,1,13,0)="  Dental Treatment Planner                DTP"
^XWB(8994,2532,2,4,1,14,0)="  TRM                                     TRM"
^XWB(8994,2532,2,4,1,15,0)="  PSS                                     PSS"
^XWB(8994,2532,2,4,1,16,0)="  ROI                                     ROI"
^XWB(8994,2532,2,4,1,17,0)="  MHTP                                    MHTP"
^XWB(8994,2532,2,4,1,18,0)="  Draeger                                 DRG"
^XWB(8994,2532,2,4,1,19,0)="  VistA Gateway/ProVation                 VGPRO"
^XWB(8994,2532,2,4,1,20,0)="  VistA Gateway/QuadraMed                 VGQM"
^XWB(8994,2532,2,4,1,21,0)="  VistA Gateway/Intisiq                   VGINQ"
^XWB(8994,2532,2,4,1,22,0)="  VistA Gateway/TheraDoc                  VGTHD"
^XWB(8994,2532,2,5,0)="TIU^1^12^0^5"
^XWB(8994,2532,2,5,1,0)="^^2^2^3090217^"
^XWB(8994,2532,2,5,1,1,0)="This field contains the pointer to the TIU DOCUMENT (#8925) file if the "
^XWB(8994,2532,2,5,1,2,0)="image has an associated note."
^XWB(8994,2532,2,"B","ACT",1)=""
^XWB(8994,2532,2,"B","APP",4)=""
^XWB(8994,2532,2,"B","QUEUE",3)=""
^XWB(8994,2532,2,"B","TIU",5)=""
^XWB(8994,2532,2,"B","TRANID",2)=""
^XWB(8994,2532,2,"PARAMSEQ",1,1)=""
^XWB(8994,2532,2,"PARAMSEQ",2,2)=""
^XWB(8994,2532,2,"PARAMSEQ",3,3)=""
^XWB(8994,2532,2,"PARAMSEQ",4,4)=""
^XWB(8994,2532,2,"PARAMSEQ",5,5)=""
^XWB(8994,2532,3,0)="^8994.03^4^4^3090217^^^"
^XWB(8994,2532,3,1,0)="Returns a string:"
^XWB(8994,2532,3,2,0)="  If successfully added return 1^message^TRANID"
^XWB(8994,2532,3,3,0)="  If successfully deleted return 1^message"
^XWB(8994,2532,3,4,0)="  If unsuccessful or problems return -1^error message"
^XWB(8994,2533,0)="DSIV DM CHECK^IMPCK^DSIVDM^1^A"
^XWB(8994,2533,1,0)="^8994.01^2^2^3070820^^^"
^XWB(8994,2533,1,1,0)="This will check whether or not the current VistA system supports VistA "
^XWB(8994,2533,1,2,0)="Imaging's import API."
^XWB(8994,2533,2,0)="^8994.02A^^"
^XWB(8994,2533,3,0)="^8994.03^2^2^3070820^^"
^XWB(8994,2533,3,1,0)="If VistA Imaging supports their import API, then return 1"
^XWB(8994,2533,3,2,0)="Else return -1^error message"
^XWB(8994,2534,0)="DSIV DM GET STATUS1^STAT^DSIVDM^4^A^^^1"
^XWB(8994,2534,1,0)="^^3^3^3050921^"
^XWB(8994,2534,1,1,0)="This will retrieve the statuses of the VistA Imaging import requests on a "
^XWB(8994,2534,1,2,0)="per DSS application basis.  There are various input filters you can pass "
^XWB(8994,2534,1,3,0)="to limit what will be returned."
^XWB(8994,2534,2,0)="^8994.02A^1^1"
^XWB(8994,2534,2,1,0)="DSIVDAT^2^245^1^1"
^XWB(8994,2534,2,1,1,0)="^^33^33^3050621^"
^XWB(8994,2534,2,1,1,1,0)="Note: TX equals transaction ID (19621 .01 field value)"
^XWB(8994,2534,2,1,1,2,0)=" "
^XWB(8994,2534,2,1,1,3,0)=" DSIVDAT(sub) - subscript value of DSIVDAT() is arbitrary"
^XWB(8994,2534,2,1,1,4,0)=" DSIVDAT(sub) = label^value  where"
^XWB(8994,2534,2,1,1,5,0)="   Label   Req  Value"
^XWB(8994,2534,2,1,1,6,0)="   ------  ---  --------------------------------------------------------- "
^XWB(8994,2534,2,1,1,7,0)="   DEL          Boolean - default 0 - if 1 then delete records which were "
^XWB(8994,2534,2,1,1,8,0)="                successfully imported and retrieved by this call"
^XWB(8994,2534,2,1,1,9,0)=" "
^XWB(8994,2534,2,1,1,10,0)="   APP      x   Only return TXs for this APP CODE"
^XWB(8994,2534,2,1,1,11,0)=" "
^XWB(8994,2534,2,1,1,12,0)="   SDT          get TXs >= this date, can be FM or external date format "
^XWB(8994,2534,2,1,1,13,0)=" "
^XWB(8994,2534,2,1,1,14,0)="   EDT          get TXs <= this date, can be FM or external date format"
^XWB(8994,2534,2,1,1,15,0)=" "
^XWB(8994,2534,2,1,1,16,0)="   MAX          Maximum number of transactions to retrieve"
^XWB(8994,2534,2,1,1,17,0)=" "
^XWB(8994,2534,2,1,1,18,0)="   TRANID       TX"
^XWB(8994,2534,2,1,1,19,0)=" "
^XWB(8994,2534,2,1,1,20,0)="   OVERRIDE     This RPC is hardcoded to get as many statuses as possible "
^XWB(8994,2534,2,1,1,21,0)="                meeting the input filters in one minute.  This timer"
^XWB(8994,2534,2,1,1,22,0)="                function can be overridden by this Boolean input param"
^XWB(8994,2534,2,1,1,23,0)="                   I $G(OVERRIDE) then do not honor timer"
^XWB(8994,2534,2,1,1,24,0)=" "
^XWB(8994,2534,2,1,1,25,0)="   WHICH        flag indicating which transactions to retrieve"
^XWB(8994,2534,2,1,1,26,0)="                If TRANID is passed, ignore value of WHICH"
^XWB(8994,2534,2,1,1,27,0)="                If WHICH[A - get all TX statuses - default"
^XWB(8994,2534,2,1,1,28,0)="                         E - get all TX in error state"
^XWB(8994,2534,2,1,1,29,0)="                         S - get all successfully imported TX"
^XWB(8994,2534,2,1,1,30,0)="                         P - get all TXs still pending import"
^XWB(8994,2534,2,1,1,31,0)="                         * - get TXs whether or not the TX was previously "
^XWB(8994,2534,2,1,1,32,0)="                             retrieved. Default is get only those TXs not"
^XWB(8994,2534,2,1,1,33,0)="                             previously retrieved"
^XWB(8994,2534,2,"B","DSIVDAT",1)=""
^XWB(8994,2534,2,"PARAMSEQ",1,1)=""
^XWB(8994,2534,3,0)="^^9^9^3050621^"
^XWB(8994,2534,3,1,0)="If problems or errors, return -1^error message"
^XWB(8994,2534,3,2,0)="Else return each transaction id in a multiline format:"
^XWB(8994,2534,3,3,0)="     List[n] := transaction id^status"
^XWB(8994,2534,3,4,0)="   List[n+m] := any messages from the VI Background Processor"
^XWB(8994,2534,3,5,0)="                { this may be 0,1,2,3,or more lines }"
^XWB(8994,2534,3,6,0)=" List[n+m+1] := $END"
^XWB(8994,2534,3,7,0)=" "
^XWB(8994,2534,3,8,0)="Each record will consist of 2 or more lines.  The first line and the "
^XWB(8994,2534,3,9,0)="$END line will be in each record."
^XWB(8994,2535,0)="DSIV DM DEL QUEUE ENTRIES^DEL^DSIVDM^1^A"
^XWB(8994,2535,1,0)="^^1^1^3050630^"
^XWB(8994,2535,1,1,0)="This will allow for the deletion of one or more records from file 19621."
^XWB(8994,2535,2,0)="^8994.02A^1^1"
^XWB(8994,2535,2,1,0)="DSIVL^2^80^1^1"
^XWB(8994,2535,2,1,1,0)="^^3^3^3050630^"
^XWB(8994,2535,2,1,1,1,0)="This is a list of records to be deleted from file 19621.  The value of "
^XWB(8994,2535,2,1,1,2,0)="each array element can be either the Transaction ID name or the IEN."
^XWB(8994,2535,2,1,1,3,0)="    DSIVL(sub) = value"
^XWB(8994,2535,2,"B","DSIVL",1)=""
^XWB(8994,2535,2,"PARAMSEQ",1,1)=""
^XWB(8994,2535,3,0)="^^2^2^3050630^"
^XWB(8994,2535,3,1,0)="If there are problems, return -1^message"
^XWB(8994,2535,3,2,0)="Else return 1^message"
^XWB(8994,2536,0)="DSIV ACCEPT BUFFER ENTRY^ACCEPT^DSIVICA^2"
^XWB(8994,2536,1,0)="^8994.01^4^4^3100622^^^^"
^XWB(8994,2536,1,1,0)="Processes INSURANCE BUFFER file entry to insurance files"
^XWB(8994,2536,1,2,0)="and patient insurance type multiple.  Marks buffer entry"
^XWB(8994,2536,1,3,0)="STATUS=ACCEPTED.  This RPC should perform the same actions"
^XWB(8994,2536,1,4,0)="as the List Manager ""Accept"" action."
^XWB(8994,2536,2,0)="^8994.02A^^-19"
^XWB(8994,2536,2,1,0)="IBBUFDA^1^16^1^1"
^XWB(8994,2536,2,1,1,0)="^^1^1^3041224^"
^XWB(8994,2536,2,1,1,1,0)="INSURANCE BUFFER file IEN to be processed."
^XWB(8994,2536,2,2,0)="DFN^1^16^1^2"
^XWB(8994,2536,2,2,1,0)="^^1^1^3041224^"
^XWB(8994,2536,2,2,1,1,0)="PATIENT file IEN."
^XWB(8994,2536,2,3,0)="IBINSDA^1^16^0^3"
^XWB(8994,2536,2,3,1,0)="^^4^4^3041224^"
^XWB(8994,2536,2,3,1,1,0)="INSURANCE COMPANY file IEN if not adding a new entry."
^XWB(8994,2536,2,3,1,2,0)="This parameter is optional but must be present if the"
^XWB(8994,2536,2,3,1,3,0)="IBNEWINS parameter value is false (not adding a new"
^XWB(8994,2536,2,3,1,4,0)="INSURANCE COMPANY entry)."
^XWB(8994,2536,2,4,0)="IBGRPDA^1^36^0^4"
^XWB(8994,2536,2,4,1,0)="^^4^4^3041224^"
^XWB(8994,2536,2,4,1,1,0)="GROUP INSURANCE PLAN file IEN if not adding a new entry."
^XWB(8994,2536,2,4,1,2,0)="This parameter is optional but must be present if the"
^XWB(8994,2536,2,4,1,3,0)="IBNEWGRP parameter value is false (not adding a new"
^XWB(8994,2536,2,4,1,4,0)="GROUP INSURANCE PLAN entry)."
^XWB(8994,2536,2,5,0)="IBPOLDA^1^16^0^5"
^XWB(8994,2536,2,5,1,0)="^^4^4^3041224^"
^XWB(8994,2536,2,5,1,1,0)="IEN of INSURANCE TYPE sub-file (#2.312) of PATIENT file"
^XWB(8994,2536,2,5,1,2,0)="if not adding a new entry.  This parameter must be present"
^XWB(8994,2536,2,5,1,3,0)="if the INSURANCE BUFFER data will update an existing entry"
^XWB(8994,2536,2,5,1,4,0)="in the INSURANCE TYPE multiple."
^XWB(8994,2536,2,6,0)="IBMVINS^1^1^0^6"
^XWB(8994,2536,2,6,1,0)="^^12^12^3090728^"
^XWB(8994,2536,2,6,1,1,0)="Flag indicating whether buffer data will 1=Merge, 2=Overwrite, 3=Replace"
^XWB(8994,2536,2,6,1,2,0)="data in file #36.  Default is 2=Overwrite. In the List Manager interface"
^XWB(8994,2536,2,6,1,3,0)="flag value 4 means ""individually accept.""  This value is not valid in the"
^XWB(8994,2536,2,6,1,4,0)="Remote Procedure Call. The terms ""merge,"" ""overwrite,"" and ""replace"" are"
^XWB(8994,2536,2,6,1,5,0)="defined as follows:"
^XWB(8994,2536,2,6,1,6,0)=" "
^XWB(8994,2536,2,6,1,7,0)=" TYPE    - 1 = Merge     (only buffer data moved to blank fields"
^XWB(8994,2536,2,6,1,8,0)="                          in ins file, no replace)"
^XWB(8994,2536,2,6,1,9,0)="           2 = Overwrite (all buffer data moved to ins file,"
^XWB(8994,2536,2,6,1,10,0)="                          replace existing data)"
^XWB(8994,2536,2,6,1,11,0)="           3 = Replace   (all buffer data including null move to"
^XWB(8994,2536,2,6,1,12,0)="                          ins file)"
^XWB(8994,2536,2,6,1,13,0)="                         ins file)"
^XWB(8994,2536,2,7,0)="IBMVGRP^1^1^0^7"
^XWB(8994,2536,2,7,1,0)="^^12^12^3090728^"
^XWB(8994,2536,2,7,1,1,0)="Flag indicating whether buffer data will 1=Merge, 2=Overwrite, 3=Replace"
^XWB(8994,2536,2,7,1,2,0)="data in file #355.3.  Default is 2=Overwrite. In the List Manager"
^XWB(8994,2536,2,7,1,3,0)="interface flag value 4 means ""individually accept.""  This value is not"
^XWB(8994,2536,2,7,1,4,0)="valid in the Remote Procedure Call. The terms ""merge,"" ""overwrite,"" and"
^XWB(8994,2536,2,7,1,5,0)="""replace"" are defined as follows:"
^XWB(8994,2536,2,7,1,6,0)=" "
^XWB(8994,2536,2,7,1,7,0)=" TYPE    - 1 = Merge     (only buffer data moved to blank fields"
^XWB(8994,2536,2,7,1,8,0)="                          in ins file, no replace)"
^XWB(8994,2536,2,7,1,9,0)="           2 = Overwrite (all buffer data moved to ins file,"
^XWB(8994,2536,2,7,1,10,0)="                          replace existing data)"
^XWB(8994,2536,2,7,1,11,0)="           3 = Replace   (all buffer data including null move to"
^XWB(8994,2536,2,7,1,12,0)="                          ins file)"
^XWB(8994,2536,2,7,1,13,0)="                         ins file)"
^XWB(8994,2536,2,8,0)="IBMVPOL^1^1^0^8"
^XWB(8994,2536,2,8,1,0)="^^12^12^3090728^"
^XWB(8994,2536,2,8,1,1,0)="Flag indicating whether buffer data will 1=Merge, 2=Overwrite, 3=Replace"
^XWB(8994,2536,2,8,1,2,0)="data in subfile #2.312.  Default is 2=Overwrite. In the List Manager"
^XWB(8994,2536,2,8,1,3,0)="interface flag value 4 means ""individually accept.""  This value is not"
^XWB(8994,2536,2,8,1,4,0)="valid in the Remote Procedure Call. The terms ""merge,"" ""overwrite,"" and"
^XWB(8994,2536,2,8,1,5,0)="""replace"" are defined as follows:"
^XWB(8994,2536,2,8,1,6,0)=" "
^XWB(8994,2536,2,8,1,7,0)="TYPE    - 1 = Merge     (only buffer data moved to blank fields"
^XWB(8994,2536,2,8,1,8,0)="                         in ins file, no replace)"
^XWB(8994,2536,2,8,1,9,0)="          2 = Overwrite (all buffer data moved to ins file,"
^XWB(8994,2536,2,8,1,10,0)="                         replace existing data)"
^XWB(8994,2536,2,8,1,11,0)="          3 = Replace   (all buffer data including null move to"
^XWB(8994,2536,2,8,1,12,0)="                         ins file)"
^XWB(8994,2536,2,8,1,13,0)="                         ins file)"
^XWB(8994,2536,2,9,0)="IBNEWINS^1^1^0^9"
