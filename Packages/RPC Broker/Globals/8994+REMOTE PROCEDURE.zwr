^XWB(8994,4770,1,3,0)="signed by date range) to the calling application."
^XWB(8994,4770,1,4,0)=" "
^XWB(8994,4770,1,5,0)="Can only be invoked by Acheron"
^XWB(8994,4770,2,0)="^8994.02A^13^13"
^XWB(8994,4770,2,1,0)="CLASS^1^^1^1"
^XWB(8994,4770,2,1,1,0)="^8994.021^1^1^3221011^^"
^XWB(8994,4770,2,1,1,1,0)="This is the IEN or pointer to TIU DOCUMENT DEFINITION File #8925.1"
