^XWB(8994,5172,1,1,0)="Returns and array of JSON specifications for a patient. Optionally can "
^XWB(8994,5172,1,2,0)="also return all Special Authorities (SA) business rules."
^XWB(8994,5172,2,0)="^8994.02A^2^1"
^XWB(8994,5172,2,2,0)="JSONIN^1^^1^1"
^XWB(8994,5172,2,2,1,0)="^8994.021^10^10^3241218^^^"
^XWB(8994,5172,2,2,1,1,0)="JSON input elements string with the following elements:"
^XWB(8994,5172,2,2,1,2,0)=" "
^XWB(8994,5172,2,2,1,3,0)="Example:"
^XWB(8994,5172,2,2,1,4,0)="{"
