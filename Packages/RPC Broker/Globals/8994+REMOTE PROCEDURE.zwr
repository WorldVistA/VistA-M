^XWB(8994,4995,3,13,0)="  {"
^XWB(8994,4995,3,14,0)="     ""Error"":["
^XWB(8994,4995,3,15,0)="        ""{error message.}"""
^XWB(8994,4995,3,16,0)="     ],"
^XWB(8994,4995,3,17,0)="     ""Appointment"":["
^XWB(8994,4995,3,18,0)="        """""
^XWB(8994,4995,3,19,0)="     ]"
^XWB(8994,4995,3,20,0)="  }"
^XWB(8994,4996,0)="SDES2 SET APPT CHECKIN^SETAPPTCKNSTEP^SDES2APPTCKNSTEP^2^R^^^^^^1"
^XWB(8994,4996,1,0)="^^3^3^3250214^"
