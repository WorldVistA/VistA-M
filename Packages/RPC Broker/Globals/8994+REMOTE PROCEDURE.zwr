^XWB(8994,2976,2,6,1,0)="^^7^7^3191016^"
^XWB(8994,2976,2,6,1,1,0)="Enter  ""NCRP"" - DSIR NON-COMPUTERIZED RECORDS PATIENTS  (checks un "
^XWB(8994,2976,2,6,1,2,0)="                registered patients from the ""DSIR(19620.96"""
^XWB(8994,2976,2,6,1,3,0)="        ""P""   - Checks the Patient file under ""DPT("" in our file."
^XWB(8994,2976,2,6,1,4,0)=" "
^XWB(8994,2976,2,6,1,5,0)=" *Note: these are used as a substring index identifier under the "
^XWB(8994,2976,2,6,1,6,0)="Cross-Reference: ^DSIR(19620,""APTDT"",""PATIENT;DPT("",DATE,IEN)"
^XWB(8994,2976,2,6,1,7,0)="                 ^DSIR(19620,""APTDT"",""PATIENT;DSIR(19620.96"",DATE,IEN)"
