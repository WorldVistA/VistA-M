^XWB(8994,4830,0)="DSIYCMR GETCMR^GETCMR^DSIYCMR^2"
^XWB(8994,4830,1,0)="^8994.01^28^28^3190130^^^"
^XWB(8994,4830,1,1,0)="DSIYCMR GETCMR - returns the data fields for a specified entry in file"
^XWB(8994,4830,1,2,0)="CMR (#6914.1)."
^XWB(8994,4830,1,3,0)="Format ARRAY(1-n)= field name ^ value"
^XWB(8994,4830,1,4,0)=" "
^XWB(8994,4830,1,5,0)="Fields include;"
^XWB(8994,4830,1,6,0)="ARRAY(1)=""ALTERNATE RESPONSIBLE OFFICIAL^"
^XWB(8994,4830,1,7,0)="ARRAY(2)=""ALTERNATE RESPONSIBLE OFFICIAL EXT^"
^XWB(8994,4830,1,8,0)="ARRAY(3)=""BRIEF DESCRIPTION^"
^XWB(8994,4830,1,9,0)="ARRAY(4)=""COST CENTER^"
^XWB(8994,4830,1,10,0)="ARRAY(5)=""COST CENTER EXT^"
^XWB(8994,4830,1,11,0)="ARRAY(6)=""DAYS BETWEEN RETURNS^"
^XWB(8994,4830,1,12,0)="ARRAY(7)=""DAYS BETWEEN RETURNS EXT^"
^XWB(8994,4830,1,13,0)="ARRAY(8)=""IT TRACKING^"
^XWB(8994,4830,1,14,0)="ARRAY(9)=""IT TRACKING EXT^"
^XWB(8994,4830,1,15,0)="ARRAY(10)=""LAST RECONCILED^"
^XWB(8994,4830,1,16,0)="ARRAY(11)=""LAST RECONCILED EXT^"
^XWB(8994,4830,1,17,0)="ARRAY(12)=""LOAN FORM PHONE^"
^XWB(8994,4830,1,18,0)="ARRAY(13)=""NAME^"
^XWB(8994,4830,1,19,0)="ARRAY(14)=""PHONE (RESP OFFICIAL)^"
^XWB(8994,4830,1,20,0)="ARRAY(15)=""RESEARCH?^"
^XWB(8994,4830,1,21,0)="ARRAY(16)=""RESEARCH? EXT^"
^XWB(8994,4830,1,22,0)="ARRAY(17)=""RESPONSIBLE OFFICIAL^"
^XWB(8994,4830,1,23,0)="ARRAY(18)=""RESPONSIBLE OFFICIAL EXT^"
^XWB(8994,4830,1,24,0)="ARRAY(19)=""SERVICE^1040"""
^XWB(8994,4830,1,25,0)="ARRAY(20)=""SERVICE EXT^"
^XWB(8994,4830,1,26,0)="ARRAY(21)=""STATION NUMBER^"
^XWB(8994,4830,1,27,0)="ARRAY(22)=""FR SEND^ 1=User can Send FR Documents, 0=User cannot Send"
^XWB(8994,4830,1,28,0)="ARRAY(23)=""LINKED FAPS^ # of FAPs impacted by a Station change"
^XWB(8994,4830,2,0)="^8994.02A^1^1"
^XWB(8994,4830,2,1,0)="DSIYCMR^1^10^1^1"
^XWB(8994,4830,2,1,1,0)="^8994.021^1^1^3190130^^^"
^XWB(8994,4830,2,1,1,1,0)="Pass CMR IEN for file CMR (6914.1)"
^XWB(8994,4830,2,"B","DSIYCMR",1)=""
^XWB(8994,4830,2,"PARAMSEQ",1,1)=""
^XWB(8994,4830,3,0)="^^6^6^3190130^"
^XWB(8994,4830,3,1,0)=" DSIYCMR GETCMR returns the field array for the CMR fiel 6914.1"
^XWB(8994,4830,3,2,0)=" "
^XWB(8994,4830,3,3,0)=" ARRAY(1-N)=FIELD NAME ^ FIELD VALUE"
^XWB(8994,4830,3,4,0)=" "
^XWB(8994,4830,3,5,0)="Note if the external value is present (Field Name EXT) then the SET will "
^XWB(8994,4830,3,6,0)="expect this field value to hold the updated value to file."
^XWB(8994,4831,0)="DSIYCMR SETCMR^SETCMR^DSIYCMR^2"
^XWB(8994,4831,1,0)="^8994.01^24^24^3221004^^^"
^XWB(8994,4831,1,1,0)="DSIYCMR SETCMR - Return the CMR Data array with the new/updated values."
^XWB(8994,4831,1,2,0)="The following field array is used to update the CMR;"
^XWB(8994,4831,1,3,0)="  Note: These fields should be returned either with there original value"
^XWB(8994,4831,1,4,0)="  or the updated value. Fields that have not changed will not be refiled."
^XWB(8994,4831,1,5,0)=" "
^XWB(8994,4831,1,6,0)="  If deleting the CMR entry then pass '@' for the value of field NAME."
^XWB(8994,4831,1,7,0)=" "
^XWB(8994,4831,1,8,0)="  array(n)= Field # ^Field name^ internal value^ external value"
^XWB(8994,4831,1,9,0)=" "
^XWB(8994,4831,1,10,0)="Example"
^XWB(8994,4831,1,11,0)="  (0)="".01^NAME^43B^43B"""
^XWB(8994,4831,1,12,0)="  (1)="".5^SERVICE EXT^1040^SUPPLY"""
^XWB(8994,4831,1,13,0)="  (2)="".6^BRIEF DESCRIPTION^^"""
^XWB(8994,4831,1,14,0)="  (3)=""1^RESPONSIBLE OFFICIAL EXT^9999999999^APAR,TEST"""
^XWB(8994,4831,1,15,0)="  (4)=""2^PHONE (RESP OFFICIAL)^^"""
^XWB(8994,4831,1,16,0)="  (5)=""3^LAST RECONCILED EXT^3150831^AUG 31, 2015"""
^XWB(8994,4831,1,17,0)="  (6)=""4^RESEARCH? EXT^^"""
^XWB(8994,4831,1,18,0)="  (7)=""5^STATION NUMBER^500^500"""
^XWB(8994,4831,1,19,0)="  (8)=""6^IT TRACKING EXT^^"""
^XWB(8994,4831,1,20,0)="  (9)=""10^COST CENTER EXT^820200^820200"""
^XWB(8994,4831,1,21,0)="  (10)=""20^ALTERNATE RESPONSIBLE OFFICIAL EXT^^"""
^XWB(8994,4831,1,22,0)="  (11)=""30^DAYS BETWEEN RETURNS EXT^^"""
^XWB(8994,4831,1,23,0)="  (12)=""31^LOAN FORM PHONE^^"""
^XWB(8994,4831,1,24,0)="  (13)=""IEN^IEN^37^37"""
^XWB(8994,4831,2,0)="^8994.02A^1^1"
^XWB(8994,4831,2,1,0)="DSIYD^2^^^1"
^XWB(8994,4831,2,1,1,0)="^8994.021^1^1^3221004^^^^"
^XWB(8994,4831,2,1,1,1,0)="Data array for the CMR data fields."
^XWB(8994,4831,2,"B","DSIYD",1)=""
^XWB(8994,4831,2,"PARAMSEQ",1,1)=""
^XWB(8994,4831,3,0)="^8994.03^32^32^3221004^^^"
^XWB(8994,4831,3,1,0)="ARRAY(1) = -1 ^ Message if there's an issue."
^XWB(8994,4831,3,2,0)="ARRAY(2-n) = message regarding the reason CMR could not be updated"
^XWB(8994,4831,3,3,0)=" "
^XWB(8994,4831,3,4,0)="The process returns the lines described below. Beside the return array "
^XWB(8994,4831,3,5,0)="the process can also generate two reports to the Above PAR report queue."
^XWB(8994,4831,3,6,0)="'EIL (EIL#) FAP Impact Report' - lists the FAPs that require attention"
^XWB(8994,4831,3,7,0)="'EIL (EIL#) failed to update Equipment's Station - lists the Equipment "
^XWB(8994,4831,3,8,0)="and the reason the update failed."
^XWB(8994,4831,3,9,0)="The Equipment Audit report will include the Equipment station "
^XWB(8994,4831,3,10,0)="successful updates."
^XWB(8994,4831,3,11,0)=" "
^XWB(8994,4831,3,12,0)="Returns"
^XWB(8994,4831,3,13,0)=" DSIYRET(1) = 1 SUCCESS, -1 FAILED if FAILED DSIYRET(2-N)=""ER^""_TEXT"
^XWB(8994,4831,3,14,0)=" DSIYRET(2-N)= ""FR^FR^FR Documents Sent: ""_number"
^XWB(8994,4831,3,15,0)=" DSIYRET(3-N)= ""FRE^""_FR MESSAGES REGARDING FAILED TO SEND"
^XWB(8994,4831,3,16,0)=" DSIYRET(4-N)= ""EQ0^""_TEXT REGARDING EQ"
^XWB(8994,4831,3,17,0)=" DSIYRET(5-N)= ""FAP0^""_TEXT REGARDING FAP"
^XWB(8994,4831,3,18,0)=" "
^XWB(8994,4831,3,19,0)="example"
^XWB(8994,4831,3,20,0)="Result 0 = 1^1"
^XWB(8994,4831,3,21,0)="Result 1 = FR^FR Documents Sent: 4"
^XWB(8994,4831,3,22,0)="Result 2 = EQ0^Equipment Records examined: 3443"
^XWB(8994,4831,3,23,0)="Result 3 = EQ0^Equipment Records updated: 3443"
^XWB(8994,4831,3,24,0)="If the update failed on one or more then this line appears below #updated"
^XWB(8994,4831,3,25,0)="Result 4 = EQ0^Equipment Records requiring no update: 0"
^XWB(8994,4831,3,26,0)=" "
^XWB(8994,4831,3,27,0)="Result 5 = EQ0^Refer to 'ABOVE PAR AUDIT REPORT (EQUIPMENT) for"
^XWB(8994,4831,3,28,0)="Result 6 = EQ0^the list of equipment updated."
^XWB(8994,4831,3,29,0)=" "
^XWB(8994,4831,3,30,0)="Result 7 = FAP0^FAP requiring updates:4"
^XWB(8994,4831,3,31,0)="Result 8 = FAP0^Review the 'EIL 1 FAP Impact Report' for the list"
^XWB(8994,4831,3,32,0)="Result 9 = FAP0^of FAPs requiring update due to the EIL update."
^XWB(8994,4832,0)="DSIYTI04 TIASSGN TI ASSIGNMENT^TIASSGN^DSIYTI04^2"
^XWB(8994,4832,1,0)="^8994.01^24^24^3190130^^"
^XWB(8994,4832,1,1,0)="RPC: DSIYTI04 TIASSGN TI ASSIGNMENT"
^XWB(8994,4832,1,2,0)="Provides the ability to assign Turn In entries to a Warehouse Official "
^XWB(8994,4832,1,3,0)="(#16), provided the Turn In status is appropriate.  The user that is "
^XWB(8994,4832,1,4,0)="being assigned must have the appropriate keys permitting Turn In updates."
^XWB(8994,4832,1,5,0)=" "
^XWB(8994,4832,1,6,0)=" note use existing RPC DSIYTI02 TISCH TURN IN SEARCH with search type WH "
^XWB(8994,4832,1,7,0)="to get a list of Turn-In entries don't have a Warehouse Official."
^XWB(8994,4832,1,8,0)="been assigned."
^XWB(8994,4832,1,9,0)=" "
^XWB(8994,4832,1,10,0)=" RPC: DSIYTI04 TIASSGN TI ASSIGNMENT"
^XWB(8994,4832,1,11,0)=" "
^XWB(8994,4832,1,12,0)="INPUT DSIYN16 User to be assigned"
^XWB(8994,4832,1,13,0)="           DSIYTIL(SEQ) Array of Turn-in requests for ASSIGNMENT "
^XWB(8994,4832,1,14,0)=" "
^XWB(8994,4832,1,15,0)="RETURNS DSIYRET(1) = -1^error message - if there's a problem"
^XWB(8994,4832,1,16,0)="                                      1^ - if success"
^XWB(8994,4832,1,17,0)="                                      0^NOTHING FILED - if all Turn In "
^XWB(8994,4832,1,18,0)="failed to file"
^XWB(8994,4832,1,19,0)=" "
^XWB(8994,4832,1,20,0)="(2-n) text lines indicating what occurred for the Turn In entries "
^XWB(8994,4832,1,21,0)="submitted."
^XWB(8994,4832,1,22,0)="    DSIYRET(2-n) = ""TI^1^IEN - successfully assigned"
^XWB(8994,4832,1,23,0)="    DSIYRET(3-n) = ""TIFE^-1^IEN^Error text - failed FM Save"
^XWB(8994,4832,1,24,0)="    DSIYRET(4-n) = ""TIER^-1^IEN^Error text - failed Turn In Check"
^XWB(8994,4832,2,0)="^8994.02A^2^2"
^XWB(8994,4832,2,1,0)="DSIYN16^1^16^1^1"
^XWB(8994,4832,2,1,1,0)="^^1^1^3190111^"
^XWB(8994,4832,2,1,1,1,0)="Pass the User ID (#200) that is to be assigned to the Turn In."
^XWB(8994,4832,2,2,0)="DSIYTIL^2^16^1^2"
^XWB(8994,4832,2,2,1,0)="^8994.021^2^2^3190130^^"
^XWB(8994,4832,2,2,1,1,0)="Pass an array of Turn In entries selected for Warehouse Official "
^XWB(8994,4832,2,2,1,2,0)="assignment.  Array(seq)=Turn In IEN"
^XWB(8994,4832,2,"B","DSIYN16",1)=""
^XWB(8994,4832,2,"B","DSIYTIL",2)=""
^XWB(8994,4832,2,"PARAMSEQ",1,1)=""
^XWB(8994,4832,2,"PARAMSEQ",2,2)=""
^XWB(8994,4832,3,0)="^^11^11^3190130^"
^XWB(8994,4832,3,1,0)="DSIYTI04 TIASSGN TI ASSIGNMENT will return array"
^XWB(8994,4832,3,2,0)=" DSIYRET(1) = -1^error message - if there's a problem"
^XWB(8994,4832,3,3,0)="               1^ - if success"
^XWB(8994,4832,3,4,0)="               0^NOTHING FILED - if all failed to file"
^XWB(8994,4832,3,5,0)=" "
^XWB(8994,4832,3,6,0)=" DSIYRET(2-n) = text lines indicating what occurred for the Turn In"
^XWB(8994,4832,3,7,0)="                entries submitted."
^XWB(8994,4832,3,8,0)="   "
^XWB(8994,4832,3,9,0)="  DSIYRET(2-n) = """"TI^1^IEN - successfully assigned"
^XWB(8994,4832,3,10,0)="  DSIYRET(3-n) = """"TIFE^-1^IEN^Error text - failed FM Save"
^XWB(8994,4832,3,11,0)="  DSIYRET(4-n) = """"TIER^-1^IEN^Error text - failed Turn In Check"
^XWB(8994,4833,0)="DSIYCMR FAPRPT^FAPRPT^DSIYCMR^1"
^XWB(8994,4833,1,0)="^8994.01^18^18^3190222^^^^"
^XWB(8994,4833,1,1,0)="DSIYCMR FAPLST (DEV X Report) produces a list of FAPs associated with the "
^XWB(8994,4833,1,2,0)="specified CMR."
^XWB(8994,4833,1,3,0)=" "
^XWB(8994,4833,1,4,0)="given a CMR - check the impact of a Station Number change"
^XWB(8994,4833,1,5,0)="              and if the entry has related FAP documents"
^XWB(8994,4833,1,6,0)="Input CMR IEN"
^XWB(8994,4833,1,7,0)=" "
^XWB(8994,4833,1,8,0)="Return"
^XWB(8994,4833,1,9,0)="  DSIYRET = -1^MESSAGE IF PROBLEM"
^XWB(8994,4833,1,10,0)="  DSIYRET = DEV X IEN"
^XWB(8994,4833,1,11,0)=" "
^XWB(8994,4833,1,12,0)="DEV X report returns FAP records"
^XWB(8994,4833,1,13,0)="  Record"
^XWB(8994,4833,1,14,0)="     P1= 6915.2 FAP IEN              P2= 6914.1 CMR IEN"
^XWB(8994,4833,1,15,0)="     P3= 6914 IEN                    P4= 6915.2,1 DATE/TIME CREATED"
^XWB(8994,4833,1,16,0)="     P5= 6915.2,23  TRANS NUMBER     P6= 6914,5  SERIAL #"
^XWB(8994,4833,1,17,0)="     P7= 6914,6  EQUIPMENT CATEGORY  P8= 6914,20 USE STATUS"
^XWB(8994,4833,1,18,0)="     P9= 6914,25 VA PM NUMBER"
^XWB(8994,4833,2,0)="^8994.02A^1^1"
^XWB(8994,4833,2,1,0)="DSIYCMR^1^16^1^1"
^XWB(8994,4833,2,1,1,0)="^8994.021^1^1^3190222^^^^"
^XWB(8994,4833,2,1,1,1,0)="Pass CMR IEN (#6914.1)"
^XWB(8994,4833,2,"B","DSIYCMR",1)=""
^XWB(8994,4833,2,"PARAMSEQ",1,1)=""
^XWB(8994,4833,3,0)="^8994.03^12^12^3190222^^^"
^XWB(8994,4833,3,1,0)="DSIYCMR FAPRPT submits a DEV X report to the report queue. "
^XWB(8994,4833,3,2,0)="The PRC returns string "
^XWB(8994,4833,3,3,0)="     -1^messgae if a problem was encountered"
^XWB(8994,4833,3,4,0)="      or the DEV-X IEN if the report was submitted."
^XWB(8994,4833,3,5,0)=" "
^XWB(8994,4833,3,6,0)="DEV X report returns FAP records"
^XWB(8994,4833,3,7,0)="  Record"
^XWB(8994,4833,3,8,0)="     P1= 6915.2 FAP IEN              P2= 6914.1 CMR IEN"
^XWB(8994,4833,3,9,0)="     P3= 6914 IEN                    P4= 6915.2,1 DATE/TIME CREATED"
^XWB(8994,4833,3,10,0)="     P5= 6915.2,23  TRANS NUMBER     P6= 6914,5  SERIAL #"
^XWB(8994,4833,3,11,0)="     P7= 6914,6  EQUIPMENT CATEGORY  P8= 6914,20 USE STATUS"
^XWB(8994,4833,3,12,0)="     P9= 6914,25 VA PM NUMBER"
^XWB(8994,4834,0)="DSIYCMR1 CMR LIST^CMRLST^DSIYCMR1^4^^^^1"
^XWB(8994,4834,1,0)="^8994.01^10^10^3190228^^"
^XWB(8994,4834,1,1,0)="DSIYCMR1 CMR LIST - returns list of the CMRs in fiel 6914.1"
^XWB(8994,4834,1,2,0)=" "
^XWB(8994,4834,1,3,0)="Record layout"
^XWB(8994,4834,1,4,0)=" DSIYRET(#)= "
^XWB(8994,4834,1,5,0)="           IEN"
^XWB(8994,4834,1,6,0)="           6914.1,.01 NAME"
^XWB(8994,4834,1,7,0)="           6914.1,1   RESPONSIBLE OFFICIAL"
^XWB(8994,4834,1,8,0)="           6914.1,3   LAST RECONCILED"
^XWB(8994,4834,1,9,0)="           6914.1,.5  SERVICE EXT"
^XWB(8994,4834,1,10,0)="           6914.1,.6  BRIEF DESCRIPTION"
^XWB(8994,4834,3,0)="^8994.03^10^10^3190228^^"
^XWB(8994,4834,3,1,0)="DSIYCMR1 CMR LIST - returns list of the CMRs in fiel 6914.1"
^XWB(8994,4834,3,2,0)=" "
^XWB(8994,4834,3,3,0)="Record layout"
^XWB(8994,4834,3,4,0)=" DSIYRET(#)="
^XWB(8994,4834,3,5,0)="           IEN"
^XWB(8994,4834,3,6,0)="           6914.1,.01 NAME"
^XWB(8994,4834,3,7,0)="           6914.1,1   RESPONSIBLE OFFICIAL"
^XWB(8994,4834,3,8,0)="           6914.1,3   LAST RECONCILED"
^XWB(8994,4834,3,9,0)="           6914.1,.5  SERVICE EXT"
^XWB(8994,4834,3,10,0)="           6914.1,.6  BRIEF DESCRIPTION"
^XWB(8994,4835,0)="DSIYEPM1 GEN PMI WRKSHTS^EQPM^DSIYEPM1^1^^^^1"
^XWB(8994,4835,1,0)="^8994.01^25^25^3190319^^"
^XWB(8994,4835,1,1,0)="DSIYEPM1 GEN PMI WRKSHTS - Submit report to the report queue."
^XWB(8994,4835,1,2,0)=" "
^XWB(8994,4835,1,3,0)="Clone of ENEQPMS1 - Generate PMI Worklists"
^XWB(8994,4835,1,4,0)=" "
^XWB(8994,4835,1,5,0)=" INPUT:"
^XWB(8994,4835,1,6,0)="  DSIYPARR() - ARRAY OF DATA PARAMETERS"
^XWB(8994,4835,1,7,0)=" "
^XWB(8994,4835,1,8,0)="  Input Parameters"
^XWB(8994,4835,1,9,0)="  DSIYSSL  - Sub-Sort by Location (valid for I,C,S) ENSRT(""LOC"")=1= Yes"
^XWB(8994,4835,1,10,0)="  DSIYSSLL - Sub-Sort by Location if ALL ENSRT(""LOC"",""ALL"")"
^XWB(8994,4835,1,11,0)="                                  if ALL ENSRT(""BY"")=""DBWR"""
^XWB(8994,4835,1,12,0)="  DSIYSSLD - if not Sub-Sort by Location then ENSRT(""DIV"")"
^XWB(8994,4835,1,13,0)="             if ENSRT(""LOC"",""ALL"")=0 then if you want to screen your"
^XWB(8994,4835,1,14,0)="             worklist by DIVISION, BUILDING, WING, and/or ROOM."
^XWB(8994,4835,1,15,0)="  DSIYSALL - Sort ALL (Y or N)"
^XWB(8994,4835,1,16,0)="  DSIYSFR  - if not ALL - Sort From based on Sort method ENSRT(""FR"")"
^XWB(8994,4835,1,17,0)="  DSIYSTO  - if not ALL - Sort To   based on Sort method ENSRT(""TO"")"
^XWB(8994,4835,1,18,0)="  DSIYTECH - ALL TECH's or one TECH         ENTECH=+Y,ENTECH(""ALL"")"
^XWB(8994,4835,1,19,0)="             worklist be sorted by RESPONSIBLE TECHNICIAN"
^XWB(8994,4835,1,20,0)="  DSIYCRITY- Levels of CRITICALITY: (1-10, B:E, ALL) ENCRIT,"
^XWB(8994,4835,1,21,0)="              ENCRIT(""FR""), ENCRIT(""TO""), ENCRIT(""NULL"")"
^XWB(8994,4835,1,22,0)="  DSIYOOS  - Include 'OUT OF SERVICE' equipment      ENSRT(""OOS"") 1=yes"
^XWB(8994,4835,1,23,0)="  DSIYSHPS - Shops (select one or 'ALL')             ENSHKEY"
^XWB(8994,4835,1,24,0)=" "
^XWB(8994,4835,1,25,0)=" Return: report ien or -1^message"
^XWB(8994,4835,2,0)="^8994.02A^1^1"
^XWB(8994,4835,2,1,0)="DSIYPARR^2^60^1^1"
^XWB(8994,4835,2,1,1,0)="^^26^26^3190319^"
^XWB(8994,4835,2,1,1,1,0)=" Input Parameters"
^XWB(8994,4835,2,1,1,2,0)=" array(n) = field_name ^ field_value"
^XWB(8994,4835,2,1,1,3,0)=" 1.  DSIYPM      W:week or M:month  (W or M)"
^XWB(8994,4835,2,1,1,4,0)=" 2.  DSIYPMM     Month  (YYMM) "
^XWB(8994,4835,2,1,1,5,0)=" 3.  DSIYWK      '1-5' or NULL if Monthly"
^XWB(8994,4835,2,1,1,6,0)=" 4.  DSIYSRT     Sort by: E,P,I,L,C,S"
^XWB(8994,4835,2,1,1,7,0)="                 'E' for Equipment Entry #"
^XWB(8994,4835,2,1,1,8,0)="                 'P' for PM #"
^XWB(8994,4835,2,1,1,9,0)="                 'I' for Local Identifier"
^XWB(8994,4835,2,1,1,10,0)="                 'L' for Location"
^XWB(8994,4835,2,1,1,11,0)="                 'C' for Equipment Category"
^XWB(8994,4835,2,1,1,12,0)="                 'S' for Owning Service"
^XWB(8994,4835,2,1,1,13,0)=" 5.  DSIYSALL    'ALL' or 'N' or 'N1:N2'"
^XWB(8994,4835,2,1,1,14,0)="                  Not all - SORT TYPE 'P' must be ALL"
^XWB(8994,4835,2,1,1,15,0)="                  SORT TYPE 'E,I,L,C,S' - can be 'N' or 'N1:N2'"
^XWB(8994,4835,2,1,1,16,0)=" 6.  DSIYLOC     Within ""_SORT_"", shall worklist be sorted by LOCATION?"
^XWB(8994,4835,2,1,1,17,0)="                 0 OR 1 - Blank if SORT TYPE sort is E,P,L"
^XWB(8994,4835,2,1,1,18,0)=" 7.  DSIYLALL    SubSort by Location, Shall all LOCATIONS be included "
^XWB(8994,4835,2,1,1,19,0)="                 '0' or '1'"
^XWB(8994,4835,2,1,1,20,0)=" 8.  DSIYDBWR    Sort levels DBWR\DWBR\DBR\BWR\WBR\BR\WR\R"
^XWB(8994,4835,2,1,1,21,0)=" 9.  DSIYTECH    'ALL' or 'N'"
^XWB(8994,4835,2,1,1,22,0)="10.  DSIYSOOS    '1' or '0' OUT OF SERVICE"
^XWB(8994,4835,2,1,1,23,0)="11.  DSIYCRIT    'ALL' or N,N,N OR N:N"
^XWB(8994,4835,2,1,1,24,0)="12.  DSIYCNUL    Include Null CRITITCAL  '1' or '0' (Include equipment "
^XWB(8994,4835,2,1,1,25,0)="                 if no CRITICALITY has been recorded)"
^XWB(8994,4835,2,1,1,26,0)="13.  DSIYSHKY    Blank or N shopien"
^XWB(8994,4835,2,"B","DSIYPARR",1)=""
^XWB(8994,4835,2,"PARAMSEQ",1,1)=""
^XWB(8994,4835,3,0)="^8994.03^1^1^3190319^^^"
^XWB(8994,4835,3,1,0)="Return: report ien or -1^message"
^XWB(8994,4836,0)="DSIYGOP1 AUTOGEN PRIM TO PRIM^AUTOGEN^DSIYGOP1^4^^^^1"
^XWB(8994,4836,1,0)="^^7^7^3190430^"
^XWB(8994,4836,1,1,0)="AUTOGENP"
^XWB(8994,4836,1,2,0)=" "
^XWB(8994,4836,1,3,0)="Runs AutoGen for Primary to Primary Distribution Orders."
^XWB(8994,4836,1,4,0)=" "
^XWB(8994,4836,1,5,0)="The first time through, the user might be warned that there are existig "
^XWB(8994,4836,1,6,0)="orders outstanding for this Primary. The GUI can allow the user to "
^XWB(8994,4836,1,7,0)="""FORCE"" the run the second time through."
^XWB(8994,4836,2,0)="^8994.02A^3^3"
^XWB(8994,4836,2,1,0)="PRI1^1^15^0^1"
^XWB(8994,4836,2,1,1,0)="^8994.021^7^7^3190430^^"
^XWB(8994,4836,2,1,1,1,0)="PRI1"
^XWB(8994,4836,2,1,1,2,0)=" "
^XWB(8994,4836,2,1,1,3,0)="Primary Distribution Point to stock from. If blank assume ALL primary "
^XWB(8994,4836,2,1,1,4,0)="distribution points can be used."
^XWB(8994,4836,2,1,1,5,0)=" "
^XWB(8994,4836,2,1,1,6,0)="ASSUMPTION: All user validation for this primar distribution point has "
^XWB(8994,4836,2,1,1,7,0)="been done (no checking is done in this rpc)."
^XWB(8994,4836,2,2,0)="PRI2^1^15^1^2"
^XWB(8994,4836,2,2,1,0)="^^6^6^3190430^"
^XWB(8994,4836,2,2,1,1,0)="PRI2"
^XWB(8994,4836,2,2,1,2,0)=" "
^XWB(8994,4836,2,2,1,3,0)="IEN for the Primary Distribution Point which is being stocked - Required."
^XWB(8994,4836,2,2,1,4,0)=" "
^XWB(8994,4836,2,2,1,5,0)="ASSUMPTION: All validation as to whether the user has access to this "
