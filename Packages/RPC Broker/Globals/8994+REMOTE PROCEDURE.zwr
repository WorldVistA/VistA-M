^XWB(8994,4088,2,3,1,1,0)="TERM"
^XWB(8994,4088,2,3,1,2,0)=" "
^XWB(8994,4088,2,3,1,3,0)=" - TERM:  Term to search for - this is the IEN of the value depending on "
^XWB(8994,4088,2,3,1,4,0)="how the user is looking for equipment (see documentation attached to this "
^XWB(8994,4088,2,3,1,5,0)="story)"
^XWB(8994,4088,2,3,1,6,0)="                If the user is searching by ""EC"" Equipment Category, send "
^XWB(8994,4088,2,3,1,7,0)="the IEN of the Equipment Category they choose"
^XWB(8994,4088,2,3,1,8,0)="                If the user is searching by ""AD"" CMR/EIL, send the IEN of "
^XWB(8994,4088,2,3,1,9,0)="the CMR/EIL they choose"
^XWB(8994,4088,2,3,1,10,0)="                If the user is searching by ""RO"" RESPONSIBLE OFFICIAL - "
^XWB(8994,4088,2,3,1,11,0)="send the name of the RESPONSIBLE OFFICIAL they choose"
^XWB(8994,4088,2,3,1,12,0)="                If the user is searching by ""EE"" EE# - send the EE# they "
^XWB(8994,4088,2,3,1,13,0)="choose"
^XWB(8994,4088,2,3,1,14,0)="                If the user is searching by ""RC"" REPAIR COST - nothing to "
^XWB(8994,4088,2,3,1,15,0)="be sent in this parameter"
