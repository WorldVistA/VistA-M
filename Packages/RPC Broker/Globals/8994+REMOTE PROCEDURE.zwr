^XWB(8994,4018,3,3,0)=" ;RETURNS:  DSIYRET(#)=p1:  Description"
^XWB(8994,4018,3,4,0)=" ;                     p2:  $$$ Total for DP"
^XWB(8994,4018,3,5,0)=" ;                     p3:  # of Items for DP"
^XWB(8994,4018,3,6,0)=" ;                     p4:  % of Total (if needed) fo DP"
^XWB(8994,4018,3,7,0)=" ;ASSUMPTION:  The station # is not required, but it is assumed that the"
^XWB(8994,4018,3,8,0)="dropdown from which a user picks a distribution point will be limited by"
^XWB(8994,4018,3,9,0)="both the current station selection and the user's rights ta distribution"
^XWB(8994,4018,3,10,0)="point"
