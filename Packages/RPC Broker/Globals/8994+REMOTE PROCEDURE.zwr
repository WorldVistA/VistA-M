^XWB(8994,4308,2,5,0)="PRCHPO^1^15^1^1"
^XWB(8994,4308,2,5,1,0)="^8994.021^2^2^3141208^^"
^XWB(8994,4308,2,5,1,1,0)="IEN of new detailed purchase card order (Procurement & Accounting "
^XWB(8994,4308,2,5,1,2,0)="Transactions file (#442) IEN)"
^XWB(8994,4308,2,16,0)="DSSOSRT^1^30^0^4"
^XWB(8994,4308,2,16,1,0)="^8994.021^9^9^3150901^^"
^XWB(8994,4308,2,16,1,1,0)="SORT GROUP - sort group for the IFCAP 410.7 SORT GROUP file or work"
^XWB(8994,4308,2,16,1,2,0)="  order from the Engineering 6920 WORK ORDER file.  This field is a"
^XWB(8994,4308,2,16,1,3,0)="  variable pointer."
^XWB(8994,4308,2,16,1,4,0)="  "
^XWB(8994,4308,2,16,1,5,0)="    Format:  XXX_text"
^XWB(8994,4308,2,16,1,6,0)="             where XXX = IEN of file 410.7 or file 6920"
^XWB(8994,4308,2,16,1,7,0)="                   text= identifies the file the IEN is located in - "
^XWB(8994,4308,2,16,1,8,0)="                         specifically "";PRCS(410.7,"" or "";ENG(6920,"""
^XWB(8994,4308,2,16,1,9,0)="                           (i.e. - ""22;PRCS(410.7,"" or ""213;ENG(6920,"")"
^XWB(8994,4308,2,17,0)="DSSOSC^2^50^0^6"
^XWB(8994,4308,2,17,1,0)="^8994.021^7^7^3150901^^^^"
^XWB(8994,4308,2,17,1,1,0)="Sub-control Point Array - "
^XWB(8994,4308,2,17,1,2,0)="  Format:"
^XWB(8994,4308,2,17,1,3,0)="    List[n...] = DSSOSCP ^ DSSOSCA"
^XWB(8994,4308,2,17,1,4,0)="      where DSSOSCP = sub-control point - file 410.4 IEN"
^XWB(8994,4308,2,17,1,5,0)="            DSSOSCA = sub-control point amount- a number between"
^XWB(8994,4308,2,17,1,6,0)="              -9999999 and 9999999 - the dollar amount committed by"
^XWB(8994,4308,2,17,1,7,0)="              each sub-control point"
^XWB(8994,4308,2,18,0)="DSSOINV^1^15^1^5"
^XWB(8994,4308,2,18,1,0)="^8994.021^2^2^3150901^^^^"
