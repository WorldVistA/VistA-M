^XWB(8994,4370,3,1,0)="Output:"
^XWB(8994,4370,3,2,0)="  Error Message:    DSSORET = ""-1^""_error message"
^XWB(8994,4370,3,3,0)="  Success Message:  DSSORET = XXXXXXXX^PROSTHETIC SUSPENSE IEN found."""
^XWB(8994,4370,3,4,0)="                    where XXXXXXXX = PROSTHETIC SUSPENSE (#668) IEN"
^XWB(8994,4371,0)="DSSO CHECK PCARD USER AUTH^CKPCRD^DSSOPPC^1"
^XWB(8994,4371,1,0)="^8994.01^2^2^3180709^^"
^XWB(8994,4371,1,1,0)="This RPC determines whether the logged-in user is authorized to see the full purchase card number.  Indication of whether the user holds the ""RMPR FCP MANAGER"" key is returned.  Also returned are 1) the masked or full purchase card number, "
^XWB(8994,4371,1,2,0)="2) whether the user is  the initiator of the purchase card order, 3) whether the user is the card holder of the purchase card, and 4) whether the user is a surrogate user of the purchase card."
^XWB(8994,4371,2,0)="^8994.02A^4^4"
^XWB(8994,4371,2,1,0)="DSSOPCRD^1^16^1^1"
^XWB(8994,4371,2,1,1,0)="^^1^1^3180709^"
^XWB(8994,4371,2,1,1,1,0)="Encrypted purchase card number (#25)  from the PROSTHETICS 1358 file (#664) - REQUIRED"
^XWB(8994,4371,2,2,0)="DSSODUZ^1^15^1^2"
^XWB(8994,4371,2,2,1,0)="^^1^1^3180709^"
^XWB(8994,4371,2,2,1,1,0)="Logged-on User"
^XWB(8994,4371,2,3,0)="DSSOINIT^1^15^1^3"
^XWB(8994,4371,2,3,1,0)="^^1^1^3180709^"
^XWB(8994,4371,2,3,1,1,0)="Creator of the purchase card order (file 664 field #10) - required"
^XWB(8994,4371,2,4,0)="DSSO664^1^15^1^4"
^XWB(8994,4371,2,4,1,0)="^^1^1^3180709^"
^XWB(8994,4371,2,4,1,1,0)="PROSTHETICS 1358 (#664) IEN"
^XWB(8994,4371,2,"B","DSSO664",4)=""
^XWB(8994,4371,2,"B","DSSODUZ",2)=""
^XWB(8994,4371,2,"B","DSSOINIT",3)=""
^XWB(8994,4371,2,"B","DSSOPCRD",1)=""
^XWB(8994,4371,2,"PARAMSEQ",1,1)=""
^XWB(8994,4371,2,"PARAMSEQ",2,2)=""
^XWB(8994,4371,2,"PARAMSEQ",3,3)=""
^XWB(8994,4371,2,"PARAMSEQ",4,4)=""
^XWB(8994,4371,3,0)="^^13^13^3180709^"
^XWB(8994,4371,3,1,0)="DSSORT1=""-1^""_error message"
^XWB(8994,4371,3,2,0)="Successful Completion:"
^XWB(8994,4371,3,3,0)="       DSSORT1=a string where:"
^XWB(8994,4371,3,4,0)="               ^-pc 1 = ""1"" - to indicate success"
^XWB(8994,4371,3,5,0)="               ^-pc 2 = full or masked decrypted purchase card number"
^XWB(8994,4371,3,6,0)="               ^-pc 3 = 1 -> holds ""RMPR FCP MANAGER"" key"
^XWB(8994,4371,3,7,0)="                       -1 -> does not hold ""RMPR FCP MANAGER"" key"
^XWB(8994,4371,3,8,0)="               ^-pc 4 = 1 -> Initiator of purchase card order"
^XWB(8994,4371,3,9,0)="                        0 -> did not initiate purchase card order"
^XWB(8994,4371,3,10,0)="               ^-pc 5 = 1 -> Card Holder"
^XWB(8994,4371,3,11,0)="                        0 -> not Card Holder"
^XWB(8994,4371,3,12,0)="               ^-pc 6 = 1 -> Surrogate User"
^XWB(8994,4371,3,13,0)="                        0 -> not Surrogate User"
^XWB(8994,4372,0)="DSSO DTLD CRT 442-AMTS^AMOUNT^DSSODP7^1"
^XWB(8994,4372,1,0)="^8994.01^10^10^3180813^^"
^XWB(8994,4372,1,1,0)=" This RPC creates the Amount multiple (#442.1) in the Procurement"
^XWB(8994,4372,1,2,0)=" & Accounting Transactions file (#442).  If there is a contract number in"
^XWB(8994,4372,1,3,0)=" the line item, an Amount multiple will be created for each Contract"
^XWB(8994,4372,1,4,0)=" number with the amount accumulating for each line item under the"
^XWB(8994,4372,1,5,0)=" specified contract. For line items with no associated contract number,"
^XWB(8994,4372,1,6,0)=" an Amount entry multiple is also created with the contract number being"
^XWB(8994,4372,1,7,0)=" set to blank - not null.  This RPC follows RPC DSSO DTLD CRT 442"
^XWB(8994,4372,1,8,0)=" 4-410-AMTS and, if FPDS processing is necessary, is followed by DSSO DTLD"
^XWB(8994,4372,1,9,0)=" CRT 442-AMTS FPDS.  If FPDS processing is not needed, proceed to DSSO"
^XWB(8994,4372,1,10,0)=" DTLD CRT 442 7-COMPLETE."
^XWB(8994,4372,2,0)="^8994.02A^2^2"
^XWB(8994,4372,2,1,0)="DSSO442^1^15^1^1"
^XWB(8994,4372,2,1,1,0)="^8994.021^2^2^3180813^^"
^XWB(8994,4372,2,1,1,1,0)="IEN of the PROCUREMENT & ACCOUNTING TRANSACTIONS file (#442) for which "
^XWB(8994,4372,2,1,1,2,0)="the AMOUNT multiple is being created"
^XWB(8994,4372,2,2,0)="DSSOAMT^2^65^1^2"
^XWB(8994,4372,2,2,1,0)="^^15^15^3180813^"
^XWB(8994,4372,2,2,1,1,0)="DSSOAMT - If there is a contract number in the line item, an Amount"
^XWB(8994,4372,2,2,1,2,0)=" multiple will be created for each Contract number with the amount"
^XWB(8994,4372,2,2,1,3,0)=" accumulating for each line item under the specified contract. For line"
^XWB(8994,4372,2,2,1,4,0)=" items with no associated contract number, an Amount entry multiple is"
^XWB(8994,4372,2,2,1,5,0)=" also created with the contract number being set to blank - not null."
^XWB(8994,4372,2,2,1,6,0)=" "
^XWB(8994,4372,2,2,1,7,0)="   The array entry contains the following:"
^XWB(8994,4372,2,2,1,8,0)="    pc 1 - not used in this RPC"
^XWB(8994,4372,2,2,1,9,0)="    pc 2 - not used in this RPC"
^XWB(8994,4372,2,2,1,10,0)="    pc 3 - not used in this RPC"
^XWB(8994,4372,2,2,1,11,0)="    pc 4 - Contract/BOA Number - externally-formatted Contract/BOA Number"
^XWB(8994,4372,2,2,1,12,0)="           from the Vendor file (#440) subfile Contract/BOA Number"
^XWB(8994,4372,2,2,1,13,0)="           (#440.03)."
^XWB(8994,4372,2,2,1,14,0)="             If no contract number is specified for this Line Item, then"
^XWB(8994,4372,2,2,1,15,0)="             set this field to blank (non-null)."
