^XWB(8994,3032,1,14,0)="+---------------------------------------------------------------+"
^XWB(8994,3032,1,15,0)="RETURNS THE LIST OF IMAGE ANNOTATIONS"
^XWB(8994,3032,1,16,0)=" .MAGOUT       Reference to a local variable where the results"
^XWB(8994,3032,1,17,0)=" .MAGIEN       Internal Entry Number of IMAGE file being annotated"
^XWB(8994,3032,1,18,0)=" Return Values"
^XWB(8994,3032,1,19,0)=" If MAGOUT(0) is defined and its 1st '^'-piece is 0, then an error"
^XWB(8994,3032,1,20,0)="    occurred during execution of the procedure. 0^0^ ERROR explanation"
^XWB(8994,3032,1,21,0)=" MAGOUT(0) = 1 ^ COUNTER ^ MESSAGE/1childIENOK + the counter of saved annotations"
^XWB(8994,3032,1,22,0)=" MAGOUT(n) = LAYER ID ^ ANNOTATOR ^ SAVED DATE/TIME ^ ANNOTATION VERSION"
^XWB(8994,3032,1,23,0)="             ^ SOURCE ^ DELETION ^ TIU COMPLETION "
^XWB(8994,3032,1,24,0)="             ^ SERVICE/SECTION  ^ SITE# ^ DUZ"
^XWB(8994,3032,1,25,0)=" Definition of each piece of MAGOUT(n)"
^XWB(8994,3032,1,26,0)="[1] = layer ID (unique to the image, not globally unique)"
^XWB(8994,3032,1,27,0)="[2] = name of user who saved layer"
^XWB(8994,3032,1,28,0)="[3] = date layer stored"
^XWB(8994,3032,1,29,0)="[4] = annotation version"
^XWB(8994,3032,1,30,0)="[5] = application that created layer"
^XWB(8994,3032,1,31,0)="[6] = 0/1 to indicate if layer deleted"
^XWB(8994,3032,1,32,0)="[7] = indicates if the layer was saved after the TIU Note COMPLETE (if there is a note)"
^XWB(8994,3032,1,33,0)="[8] = Service Section of user who saved layer"
^XWB(8994,3032,1,34,0)="[9] = user site name"
^XWB(8994,3032,1,35,0)="[10] = DUZ of user who saved layer"
