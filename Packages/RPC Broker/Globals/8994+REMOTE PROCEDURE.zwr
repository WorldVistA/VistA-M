^XWB(8994,3509,3,43,0)="                    3=OTHER "
^XWB(8994,3509,3,44,0)="                    4=ADDRESS NOT FOUND "
^XWB(8994,3509,3,45,0)=" 65 RET(""OPHONE"") = Office phone (.132) "
^XWB(8994,3509,3,46,0)=" 66 RET(""NOK"") - Primary Next of Kin (.211) "
^XWB(8994,3509,3,47,0)=" 67 RET(""KNAME"") - Primary Next of Kin name "
^XWB(8994,3509,3,48,0)=" 68 RET(""KREL"") - Primary Next of Kin Relationship to Patient (.212) "
