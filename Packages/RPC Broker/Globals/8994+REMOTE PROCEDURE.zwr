^XWB(8994,2424,0)="MAGG IS DOC CLASS^ISDOCCL^MAGGNTI^1^R"
^XWB(8994,2424,1,0)="^8994.01^1^1^3061108^^^"
^XWB(8994,2424,1,1,0)="Checks to see if IEN of TIU Files 8925 or 8925.1 is of a certain Doc Class"
^XWB(8994,2424,2,0)="^8994.02A^3^3"
^XWB(8994,2424,2,1,0)="IEN^1^30^1^1"
^XWB(8994,2424,2,1,1,0)="^^1^1^3061101^"
^XWB(8994,2424,2,1,1,1,0)="Internal Entry Number in the TIUFILE"
