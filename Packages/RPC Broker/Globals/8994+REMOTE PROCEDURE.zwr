^XWB(8994,2090,2,4,1,0)="^8994.021^5^5^3120313^^^"
^XWB(8994,2090,2,4,1,1,0)=" This parameter is a true/false flag (1/0).  If true use the new SI/OP Wp"
^XWB(8994,2090,2,4,1,2,0)=" fields and return data in the Results array to the GUI Client."
^XWB(8994,2090,2,4,1,3,0)="  "
^XWB(8994,2090,2,4,1,4,0)=" The field is not required, so a null will convert into a 0, for false,"
^XWB(8994,2090,2,4,1,5,0)=" making this backwards compatible."
^XWB(8994,2090,2,5,0)="PSBCLINORD^1^1^0^4"
^XWB(8994,2090,2,5,1,0)="^8994.021^6^6^3180815^^^^"
^XWB(8994,2090,2,5,1,1,0)="This parameter is a True/False flag (1/0).  If true, then return only"
^XWB(8994,2090,2,5,1,2,0)="Clinic Orders and not Inpatient Medication orders to BCMA, else if false,"
^XWB(8994,2090,2,5,1,3,0)="return only Inpatient Medication orders to BCMA."
^XWB(8994,2090,2,5,1,4,0)=" "
^XWB(8994,2090,2,5,1,5,0)="The field is not required, so a null will convert into a 0, for a default"
^XWB(8994,2090,2,5,1,6,0)="false value, making this backwards compatible."
