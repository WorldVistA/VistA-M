^XWB(8994,4331,2,8,1,0)="^8994.021^1^1^3150421^^"
^XWB(8994,4331,2,8,1,1,0)="PSAS Item - Prosthetic Item Master file (#661) IEN"
^XWB(8994,4331,2,9,0)="DSSOHCP^1^15^1^9"
