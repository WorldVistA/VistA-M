^XWB(8994,2565,2,"PARAMSEQ",5,5)=""
^XWB(8994,2565,3,0)="^8994.03^49^49^3240221^^^"
^XWB(8994,2565,3,1,0)="Zero value of the first '^'-piece of the Results[0] indicates that an"
^XWB(8994,2565,3,2,0)="error occurred during the execution of the procedure. In this case, the"
^XWB(8994,2565,3,3,0)="errors are returned in the Results array as shown below:"
^XWB(8994,2565,3,4,0)="  "
^XWB(8994,2565,3,5,0)="  Results[0]            Result descriptor"
^XWB(8994,2565,3,6,0)="                          ^01: 0"
^XWB(8994,2565,3,7,0)="                          ^02: Message"
^XWB(8994,2565,3,8,0)="  "
^XWB(8994,2565,3,9,0)="  Results[i]            Error descriptor"
^XWB(8994,2565,3,10,0)="                          ^01: Error code"
^XWB(8994,2565,3,11,0)="                          ^02: Message"
^XWB(8994,2565,3,12,0)="                          ^03: Error location"
^XWB(8994,2565,3,13,0)="                          ^04: Message type"
^XWB(8994,2565,3,14,0)=" "
^XWB(8994,2565,3,15,0)="  Results[j]            Line of the additional info (optional)"
^XWB(8994,2565,3,16,0)="                          ^01: """""
^XWB(8994,2565,3,17,0)="                          ^02: Text  "
^XWB(8994,2565,3,18,0)=" "
^XWB(8994,2565,3,19,0)="Otherwise, the Results array is formatted as follows:"
^XWB(8994,2565,3,20,0)=" "
^XWB(8994,2565,3,21,0)="  Results[0]            Result descriptor"
^XWB(8994,2565,3,22,0)="                          ^01: 1"
^XWB(8994,2565,3,23,0)="                          ^02: Description of the image selection"
^XWB(8994,2565,3,24,0)="                               criteria (filter)."
^XWB(8994,2565,3,25,0)="                          ^03: Non-zero if there are more records"
^XWB(8994,2565,3,26,0)="                               available. This piece is populated"
^XWB(8994,2565,3,27,0)="                               only if the MAXNUM parameter is "
^XWB(8994,2565,3,28,0)="                               defined and greater than 0."
^XWB(8994,2565,3,29,0)=" "
^XWB(8994,2565,3,30,0)="                               If the S flag is included in the"
^XWB(8994,2565,3,31,0)="                               value of the FLAGS parameter, then"
^XWB(8994,2565,3,32,0)="                               a non-zero value of this piece"
^XWB(8994,2565,3,33,0)="                               indicates that not all ""priority"""
^XWB(8994,2565,3,34,0)="                               entries are returned. See the "
^XWB(8994,2565,3,35,0)="                               description of the FLAGS parameter"
^XWB(8994,2565,3,36,0)="                               for more details."
^XWB(8994,2565,3,37,0)=" "
^XWB(8994,2565,3,38,0)="  Results[1]            '^'-delimited list of column headers used"
^XWB(8994,2565,3,39,0)="                        in the cMagListView (see the BLDHDR1^MAGSIXG2"
^XWB(8994,2565,3,40,0)="                        for details)."
^XWB(8994,2565,3,41,0)="  "
^XWB(8994,2565,3,42,0)="  Results[i]            Image descriptor"
^XWB(8994,2565,3,43,0)="                          |01: Values to be displayed in the columns "
^XWB(8994,2565,3,44,0)="                               separated by '^'. (see the"
^XWB(8994,2565,3,45,0)="                               BLDHDR1^MAGSIXG2 for details)."
^XWB(8994,2565,3,46,0)="                         "
^XWB(8994,2565,3,47,0)="                          |02: Data that is used internally by the"
^XWB(8994,2565,3,48,0)="                               application (see the $$INFO^MAGGAII"
^XWB(8994,2565,3,49,0)="                               for details)."
^XWB(8994,2566,0)="MAGG IMAGE SET PROPERTIES^SETPROPS^MAGGA02^2^R^^^1"
^XWB(8994,2566,1,0)="^^9^9^3090304^"
^XWB(8994,2566,1,1,0)="This remote procedure updates one or more image properties (fields of the"
^XWB(8994,2566,1,2,0)="record of the IMAGE file (#2005))."
^XWB(8994,2566,1,3,0)=" "
^XWB(8994,2566,1,4,0)="If one of the following fields is updated in the parent or the child of a"
^XWB(8994,2566,1,5,0)="group that has only one image, then the changes are replicated to the"
^XWB(8994,2566,1,6,0)="child or parent respectively: SHORT DESCRIPTION (10), TYPE INDEX (42),"
^XWB(8994,2566,1,7,0)="PROC/EVENT INDEX (43), SPEC/SUBSPEC INDEX (44), ORIGIN INDEX (45),"
^XWB(8994,2566,1,8,0)="CREATION DATE (110), CONTROLLED IMAGE (112), STATUS (113), and STATUS"
^XWB(8994,2566,1,9,0)="REASON (113.3)."
^XWB(8994,2566,2,0)="^8994.02A^3^3"
^XWB(8994,2566,2,1,0)="IMGIEN^1^^1^1"
^XWB(8994,2566,2,1,1,0)="^8994.021^1^1^3080331^^"
^XWB(8994,2566,2,1,1,1,0)="IEN of the image record in the IMAGE file (#2005)."
^XWB(8994,2566,2,2,0)="FLAGS^1^^^2"
^XWB(8994,2566,2,2,1,0)="^8994.021^1^1^3080331^^"
^XWB(8994,2566,2,2,1,1,0)="Reserved for future use."
^XWB(8994,2566,2,3,0)="PROPVALS^2^^^3"
^XWB(8994,2566,2,3,1,0)="^^92^92^3090126^"
^XWB(8994,2566,2,3,1,1,0)="Items of this list define new values of image properties. Each item has"
^XWB(8994,2566,2,3,1,2,0)="3 pieces separated by '^':"
^XWB(8994,2566,2,3,1,3,0)=" "
^XWB(8994,2566,2,3,1,4,0)="  ^01: Parameter name"
^XWB(8994,2566,2,3,1,5,0)="  ^02: """" (empty)"
^XWB(8994,2566,2,3,1,6,0)="  ^03: Value"
^XWB(8994,2566,2,3,1,7,0)=" "
^XWB(8994,2566,2,3,1,8,0)="The following parameters are supported by this remote procedure:"
^XWB(8994,2566,2,3,1,9,0)=" "
^XWB(8994,2566,2,3,1,10,0)="  CRTNDT^^{Date/time}"
^XWB(8994,2566,2,3,1,11,0)="    Internal or external value for the CREATION DATE field (110)"
^XWB(8994,2566,2,3,1,12,0)="    of the IMAGE file #2005."
^XWB(8994,2566,2,3,1,13,0)=" "
^XWB(8994,2566,2,3,1,14,0)="  GDESC^^{Text}"
^XWB(8994,2566,2,3,1,15,0)="    Text for the SHORT DESCRIPTION field (10) of the file #2005."
^XWB(8994,2566,2,3,1,16,0)=" "
^XWB(8994,2566,2,3,1,17,0)="  ISTAT^^{Name or Code}"
^XWB(8994,2566,2,3,1,18,0)="    Internal or external value for the STATUS field (113)"
^XWB(8994,2566,2,3,1,19,0)="    of the file #2005."
^XWB(8994,2566,2,3,1,20,0)=" "
^XWB(8994,2566,2,3,1,21,0)="  ISTATRSN^^{Name or IEN}"
^XWB(8994,2566,2,3,1,22,0)="    Name or IEN of a reason for image status change"
^XWB(8994,2566,2,3,1,23,0)="    (see the STATUS REASON field (113.3) of the file #2005"
^XWB(8994,2566,2,3,1,24,0)="    for details)."
^XWB(8994,2566,2,3,1,25,0)=" "
^XWB(8994,2566,2,3,1,26,0)="  IXORIGIN^^{Name or Code}"
^XWB(8994,2566,2,3,1,27,0)="    Internal or external value for the ORIGIN INDEX field (45)"
^XWB(8994,2566,2,3,1,28,0)="    of the file #2005."
^XWB(8994,2566,2,3,1,29,0)=" "
^XWB(8994,2566,2,3,1,30,0)="  IXPKG^^{Name or Code}"
^XWB(8994,2566,2,3,1,31,0)="    Internal or external value for the PACKAGE INDEX field (40)"
^XWB(8994,2566,2,3,1,32,0)="    of the file #2005."
^XWB(8994,2566,2,3,1,33,0)=" "
^XWB(8994,2566,2,3,1,34,0)="  IXPROC^^{Name or IEN}"
^XWB(8994,2566,2,3,1,35,0)="    Procedure/Event name or IEN (see the PROC/EVENT INDEX"
^XWB(8994,2566,2,3,1,36,0)="    field (43) of the file #2005 for details)."
^XWB(8994,2566,2,3,1,37,0)=" "
^XWB(8994,2566,2,3,1,38,0)="  IXSPEC^^{Name or IEN}"
^XWB(8994,2566,2,3,1,39,0)="    Specialty/SubSpecialty name or IEN (see the SPEC/SUBSPEC"
^XWB(8994,2566,2,3,1,40,0)="    INDEX field (44) of the file #2005 for details)."
^XWB(8994,2566,2,3,1,41,0)=" "
^XWB(8994,2566,2,3,1,42,0)="  IXTYPE^^{Name or IEN}"
^XWB(8994,2566,2,3,1,43,0)="    Image type name or IEN (see the TYPE INDEX field (42) of"
^XWB(8994,2566,2,3,1,44,0)="    the file #2005 for details)."
^XWB(8994,2566,2,3,1,45,0)=" "
^XWB(8994,2566,2,3,1,46,0)="  PARDF^^{File Number}"
^XWB(8994,2566,2,3,1,47,0)="    Value for the PARENT DATA FILE# field (16) of"
^XWB(8994,2566,2,3,1,48,0)="    the file #2005."
^XWB(8994,2566,2,3,1,49,0)=" "
^XWB(8994,2566,2,3,1,50,0)="  PARGRD0^^{IEN}"
^XWB(8994,2566,2,3,1,51,0)="    Value for the PARENT GLOBAL ROOT D0 field (17) of"
^XWB(8994,2566,2,3,1,52,0)="    the file #2005."
^XWB(8994,2566,2,3,1,53,0)=" "
^XWB(8994,2566,2,3,1,54,0)="  PARGRD1^^{IEN}"
^XWB(8994,2566,2,3,1,55,0)="    Value for the PARENT GLOBAL ROOT D1 field (63) of"
^XWB(8994,2566,2,3,1,56,0)="    the file #2005."
^XWB(8994,2566,2,3,1,57,0)=" "
^XWB(8994,2566,2,3,1,58,0)="  PARIPTR^^{IEN}"
^XWB(8994,2566,2,3,1,59,0)="    Value for the PARENT DATA FILE IMAGE POINTER field (18)"
^XWB(8994,2566,2,3,1,60,0)="    of the file #2005."
^XWB(8994,2566,2,3,1,61,0)=" "
^XWB(8994,2566,2,3,1,62,0)="  PROC^^{Name}"
^XWB(8994,2566,2,3,1,63,0)="    Name of the procedure (see the PROCEDURE field (6) "
^XWB(8994,2566,2,3,1,64,0)="    of the file #2005 for details)."
^XWB(8994,2566,2,3,1,65,0)=" "
^XWB(8994,2566,2,3,1,66,0)="  PROCDT^^{Date/time}"
^XWB(8994,2566,2,3,1,67,0)="    Internal or external value for the PROCEDURE/EXAM "
^XWB(8994,2566,2,3,1,68,0)="    DATE/TIME field (15) of the IMAGE file #2005."
^XWB(8994,2566,2,3,1,69,0)=" "
^XWB(8994,2566,2,3,1,70,0)="  SENSIMG^^{Name or Code}"
^XWB(8994,2566,2,3,1,71,0)="    Internal or external value for the CONTROLLED IMAGE field "
^XWB(8994,2566,2,3,1,72,0)="    (112) of the file #2005."
^XWB(8994,2566,2,3,1,73,0)=" "
^XWB(8994,2566,2,3,1,74,0)="For pointer type parameters, pure numeric values are always treated as"
^XWB(8994,2566,2,3,1,75,0)="internal entry numbers (IEN)."
^XWB(8994,2566,2,3,1,76,0)=" "
^XWB(8994,2566,2,3,1,77,0)="For sets of codes, the API checks for internal values first. So, if there"
^XWB(8994,2566,2,3,1,78,0)="is an ambiguity between internal and external values, the parameter value"
^XWB(8994,2566,2,3,1,79,0)="will be treated as the internal one."
^XWB(8994,2566,2,3,1,80,0)=" "
^XWB(8994,2566,2,3,1,81,0)="Parameters can be added to the list in any order. See comments preceding"
^XWB(8994,2566,2,3,1,82,0)="the SETPROPS^MAGGA02 for more details."
^XWB(8994,2566,2,3,1,83,0)=" "
^XWB(8994,2566,2,3,1,84,0)="Example:"
^XWB(8994,2566,2,3,1,85,0)=" "
^XWB(8994,2566,2,3,1,86,0)="  with RPCBroker.Param[2] do"
^XWB(8994,2566,2,3,1,87,0)="    begin"
^XWB(8994,2566,2,3,1,88,0)="      PType := list;"
^XWB(8994,2566,2,3,1,89,0)="      Mult[1] := 'IXPKG^^RAD';"
^XWB(8994,2566,2,3,1,90,0)="      Mult[2] := 'IXSPEC^^1';"
^XWB(8994,2566,2,3,1,91,0)="      Mult[3] := 'IXORIGIN^^NON-VA';"
^XWB(8994,2566,2,3,1,92,0)="    end;"
^XWB(8994,2566,2,"B","FLAGS",2)=""
^XWB(8994,2566,2,"B","IMGIEN",1)=""
^XWB(8994,2566,2,"B","PROPVALS",3)=""
