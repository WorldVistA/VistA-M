^XWB(8994,3556,2,1,1,1,0)="SDECVAL - IEN | NAME"
^XWB(8994,3556,2,1,1,2,0)="     IEN  = (required if edit) Resource Group ID - Pointer to the SDEC"
^XWB(8994,3556,2,1,1,3,0)="                               RESOURCE GROUP file"
