^XWB(8994,1938,2,"B","TODATE",7)=""
^XWB(8994,1938,2,"B","TYPE",3)=""
^XWB(8994,1938,2,"PARAMSEQ",1,1)=""
^XWB(8994,1938,2,"PARAMSEQ",2,2)=""
^XWB(8994,1938,2,"PARAMSEQ",2,11)=""
^XWB(8994,1938,2,"PARAMSEQ",3,2)=""
^XWB(8994,1938,2,"PARAMSEQ",3,3)=""
^XWB(8994,1938,2,"PARAMSEQ",4,3)=""
^XWB(8994,1938,2,"PARAMSEQ",4,4)=""
^XWB(8994,1938,2,"PARAMSEQ",5,4)=""
^XWB(8994,1938,2,"PARAMSEQ",5,5)=""
