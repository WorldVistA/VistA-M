^XWB(8994,2720,0)="TIU MED PATIENT MANAGEMENT^PATMAN^TIUMED1^1^R^0"
^XWB(8994,2720,1,0)="^^1^1^3090610^"
^XWB(8994,2720,1,1,0)="Returns the user's level of patient importing via manual entry."
^XWB(8994,2720,3,0)="^^5^5^3090610^"
^XWB(8994,2720,3,1,0)="Evaluates USER DUZ and returns:"
^XWB(8994,2720,3,2,0)=" "
^XWB(8994,2720,3,3,0)="0 = None"
^XWB(8994,2720,3,4,0)="1 = Exact Match Only"
^XWB(8994,2720,3,5,0)="2 = SSN Only"
^XWB(8994,2721,0)="TIU MED GET PATIENT LISTS^PLISTS^TIUMED1^2^R^0"
^XWB(8994,2721,1,0)="^^1^1^3090610^"
^XWB(8994,2721,1,1,0)="Returns a list of personal patient lists for the current user."
^XWB(8994,2721,3,0)="^^1^1^3090610^"
^XWB(8994,2721,3,1,0)="Returns a list of personal patient lists for the current user."
^XWB(8994,2722,0)="TIU MED GET LIST DATA^PLISTMEM^TIUMED1^2^R^0"
^XWB(8994,2722,1,0)="^^1^1^3090610^"
^XWB(8994,2722,1,1,0)="Returns a list of patients from a personal list."
^XWB(8994,2722,2,0)="^8994.02A^1^1"
^XWB(8994,2722,2,1,0)="TIULIST^1^^1^1"
^XWB(8994,2722,2,1,1,0)="^^1^1^3090610^"
^XWB(8994,2722,2,1,1,1,0)="This is the IEN of the personal list."
