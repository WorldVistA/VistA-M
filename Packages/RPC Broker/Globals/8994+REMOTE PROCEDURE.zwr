^XWB(8994,3130,2,1,0)="PATREFIEN^1^10^0^1"
^XWB(8994,3130,2,1,1,0)="^^3^3^3100805^"
^XWB(8994,3130,2,1,1,1,0)="This is the internal entry number on the IMAGING PATIENT REFERENCE File"
