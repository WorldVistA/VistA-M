^XWB(8994,4479,2,1,0)="DFN^1^^1^1"
^XWB(8994,4479,2,1,1,0)="^^1^1^3191105^"
^XWB(8994,4479,2,1,1,1,0)="This is the IEN of the patient in the PATIENT file (#2)."
