^XWB(8994,4618,3,6,0)="      pc 2 = Inventory Point (file 445 field .01 - external)"
^XWB(8994,4619,0)="DSSO R/C CHECK 2319 ITEM^CHK660^DSSOPP2^1"
^XWB(8994,4619,1,0)="^8994.01^6^6^3190723^^^^"
^XWB(8994,4619,1,1,0)="This RPC is to be used when flagging an item returned/condemned "
^XWB(8994,4619,1,2,0)="after selecting the inventory point using DSSO R/C INV PTS - USER/ITEM."
