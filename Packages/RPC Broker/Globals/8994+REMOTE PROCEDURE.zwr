^XWB(8994,4307,2,13,1,2,0)="multiple (#441.01) of the Item Master file (#441), field Unit Conversion "
^XWB(8994,4307,2,13,1,3,0)="Factor (#10), then it is required - numeric - 1-999999"
^XWB(8994,4307,2,15,0)="DSSOCON^1^19^0^12"
^XWB(8994,4307,2,15,1,0)="^8994.021^6^6^3141208^^"
^XWB(8994,4307,2,15,1,1,0)="Contract/BOA # - not required - if field Contract/BOA # is present in the"
^XWB(8994,4307,2,15,1,2,0)="Vendor subfile (#441.01) of the Item Master (#441), then this value is "
^XWB(8994,4307,2,15,1,3,0)="stored in the Item multiple (#442.01) of the Procurement & Accounting "
^XWB(8994,4307,2,15,1,4,0)="Transactions file (#442) - IEN of file 440 subfile 440.03 Contract/BOA"
^XWB(8994,4307,2,15,1,5,0)="Number multiple containing the selected Contract Number - the contract "
