^XWB(8994,3570,2,3,1,0)="^8994.021^1^1^3140908^^"
^XWB(8994,3570,2,3,1,1,0)="End of date range to serch for appointments in external format."
^XWB(8994,3570,2,4,0)="SDANC^1^^0^4"
^XWB(8994,3570,2,4,1,0)="^8994.021^1^1^3200806^^"
^XWB(8994,3570,2,4,1,1,0)="ancillary flag  0=all appointments; 1=only ancillary appointments"
^XWB(8994,3570,2,"B","DFN",1)=""
^XWB(8994,3570,2,"B","SDANC",4)=""
^XWB(8994,3570,2,"B","SDBEG",2)=""
^XWB(8994,3570,2,"B","SDEND",3)=""
^XWB(8994,3570,2,"PARAMSEQ",1,1)=""
^XWB(8994,3570,2,"PARAMSEQ",2,2)=""
^XWB(8994,3570,2,"PARAMSEQ",3,3)=""
^XWB(8994,3570,2,"PARAMSEQ",4,4)=""
^XWB(8994,3570,3,0)="^^32^32^3220315^"
^XWB(8994,3570,3,1,0)="Successful Return:"
^XWB(8994,3570,3,2,0)="  Global Array in which each array entry contains Appointment Data from "
^XWB(8994,3570,3,3,0)="the"
^XWB(8994,3570,3,4,0)="  PATIENT file"
^XWB(8994,3570,3,5,0)="  "
^XWB(8994,3570,3,6,0)="  Data is separated by ^:"
^XWB(8994,3570,3,7,0)="    1. DFN"
^XWB(8994,3570,3,8,0)="    2. Clinic IEN"
^XWB(8994,3570,3,9,0)="    3. Clinic Name"
^XWB(8994,3570,3,10,0)="    4. Appointment Date in external format"
^XWB(8994,3570,3,11,0)="    5. Status text"
^XWB(8994,3570,3,12,0)="    6. Ancillary Text"
^XWB(8994,3570,3,13,0)="    7. APPT REQUEST TYPE Field (#22) from the"
^XWB(8994,3570,3,14,0)="       SDEC APPOINTMENT File (#409.84)"
^XWB(8994,3570,3,15,0)="    8. Appointment request IEN"
^XWB(8994,3570,3,16,0)="    9. Appointment type IEN"
^XWB(8994,3570,3,17,0)="    10. Appointment type Name"
^XWB(8994,3570,3,18,0)="    11. Cancel/noshow date "
^XWB(8994,3570,3,19,0)="    12. Pre-registration Date"
^XWB(8994,3570,3,20,0)=" "
^XWB(8994,3570,3,21,0)="""T00020DFN^T00020CLINIC_IEN^T00030CLINIC_NAME^T00020APPT_DATE^T00020STATUS"
^XWB(8994,3570,3,22,0)="^T00100ANCTXT^^T00030PRECKNCOMPLETE^T00030TIMEZONE"""
^XWB(8994,3570,3,23,0)="^T00030CANDATE"""
^XWB(8994,3570,3,24,0)=" "
^XWB(8994,3570,3,25,0)="Caught Exception Return:"
^XWB(8994,3570,3,26,0)="  A single entry in the Global Array in the format ""-1^<error text>"""
^XWB(8994,3570,3,27,0)="  ""T00020RETURNCODE^T00100TEXT"""
^XWB(8994,3570,3,28,0)="Unexpected Exception Return:"
^XWB(8994,3570,3,29,0)="    Handled by the RPC Broker."
^XWB(8994,3570,3,30,0)="    M errors are trapped by the use of M and Kernel error handling."
^XWB(8994,3570,3,31,0)="    The RPC execution stops and the RPC Broker sends the error generated"
^XWB(8994,3570,3,32,0)="    text back to the client."
^XWB(8994,3571,0)="SDEC REQGET^REQGET^SDEC^4^R^0^^0"
^XWB(8994,3571,1,0)="^8994.01^2^2^3200513^^^"
^XWB(8994,3571,1,1,0)="GET entries with an ACTIVITY of RECEIVED, but do have have an ACTIVITY of "
^XWB(8994,3571,1,2,0)="SCHEDULED from the REQUEST/CONSULTATING file 123"
^XWB(8994,3571,2,0)="^8994.02A^4^4"
^XWB(8994,3571,2,1,0)="SDBEG^1^^0^1"
^XWB(8994,3571,2,1,1,0)="^^2^2^3150128^"
^XWB(8994,3571,2,1,1,1,0)="Begin date in external format"
^XWB(8994,3571,2,1,1,2,0)="Default to all dates"
^XWB(8994,3571,2,2,0)="SDECEND^1^^0^2"
^XWB(8994,3571,2,2,1,0)="^^2^2^3150128^"
^XWB(8994,3571,2,2,1,1,0)="End date in external format."
^XWB(8994,3571,2,2,1,2,0)="default to all dates"
^XWB(8994,3571,2,3,0)="MAXREC^1^^0^3"
^XWB(8994,3571,2,3,1,0)="^^1^1^3150128^"
^XWB(8994,3571,2,3,1,1,0)="Maximum number of records to return"
^XWB(8994,3571,2,4,0)="LASTSUB^1^^0^4"
^XWB(8994,3571,2,4,1,0)="^8994.021^2^2^3200513^^"
^XWB(8994,3571,2,4,1,1,0)="Last subscripts from previous call;"
^XWB(8994,3571,2,4,1,2,0)="Used to collect the data in multiple background calls."
^XWB(8994,3571,2,"B","LASTSUB",4)=""
^XWB(8994,3571,2,"B","MAXREC",3)=""
^XWB(8994,3571,2,"B","SDBEG",1)=""
^XWB(8994,3571,2,"B","SDECEND",2)=""
^XWB(8994,3571,2,"PARAMSEQ",1,1)=""
^XWB(8994,3571,2,"PARAMSEQ",2,2)=""
^XWB(8994,3571,2,"PARAMSEQ",3,3)=""
^XWB(8994,3571,2,"PARAMSEQ",4,4)=""
^XWB(8994,3571,3,0)="^^195^195^3220728^"
^XWB(8994,3571,3,1,0)="Global Array in which each array entry contains"
^XWB(8994,3571,3,2,0)="   REQUEST/CONSULTATION data from the REQUEST/CONSULTATION file 123"
^XWB(8994,3571,3,3,0)="   Data is separated by ^:"
^XWB(8994,3571,3,4,0)="   1. IEN - Pointer to REQUEST/CONSULTATION file 123 "
^XWB(8994,3571,3,5,0)="   2. File entry Date external form "
^XWB(8994,3571,3,6,0)="   3. Patient IEN - Pointer to PATIENT file "
^XWB(8994,3571,3,7,0)="   4. Patient Name NAME from PATIENT file "
^XWB(8994,3571,3,8,0)="   5. To Service - SERVICE NAME text from REQUEST SERVICES file 123.5"
^XWB(8994,3571,3,9,0)="   6. CLINIEN - pointer to HOSPITAL LOCATION file "
^XWB(8994,3571,3,10,0)="   7. CLINNAME - NAME from HOSPITAL LOCATION file "
^XWB(8994,3571,3,11,0)="   8. DATE OF REQUEST external format "
^XWB(8994,3571,3,12,0)="   9. PRIO - URGENCY NAME from PROTOCOL file OR 'Earliest Date' "
^XWB(8994,3571,3,13,0)="             in external format "
^XWB(8994,3571,3,14,0)="  10. USERIEN - ATTENTION - Pointer to NEW PERSON file "
^XWB(8994,3571,3,15,0)="  11. USERNAME - ATTENTION - NAME from NEW PERSON file "
^XWB(8994,3571,3,16,0)="  12. PROVIEN - SENDING PROVIDER IEN - Pointer to NEW PERSON file "
^XWB(8994,3571,3,17,0)="  13. PROVNAME - SENDING PROVIDER NAME - NAME from NEW PERSON file "
^XWB(8994,3571,3,18,0)="  14. REQUEST TYPE - valid values are: "
^XWB(8994,3571,3,19,0)="                     CONSULT "
^XWB(8994,3571,3,20,0)="                     PROCEDURE "
^XWB(8994,3571,3,21,0)="  15. SERVICE RENDERED AS IN OR OUT - valid values are: "
^XWB(8994,3571,3,22,0)="             inpatient "
^XWB(8994,3571,3,23,0)="             outpatient "
^XWB(8994,3571,3,24,0)="  16. COMM - [NOT USED] REASON FOR REQUEST - text converted from WP and "
^XWB(8994,3571,3,25,0)="may"
^XWB(8994,3571,3,26,0)="                        contain $C(13,10) carriage return/line feed"
^XWB(8994,3571,3,27,0)="  17. REQUEST PROCESSING ACTIVITY SEPARATED BY PIPE | "
^XWB(8994,3571,3,28,0)="      Each pipe piece contains the following "";;"" pieces: "
^XWB(8994,3571,3,29,0)="       1. REQUEST PROCESSING ACTIVITY pointer to multiple entry "
^XWB(8994,3571,3,30,0)="       2. DATE/TIME OF ACTION ENTRY - external format "
^XWB(8994,3571,3,31,0)="       3. ACTIVITY - text "
^XWB(8994,3571,3,32,0)="  18. HRN "
^XWB(8994,3571,3,33,0)="  19. DOB "
^XWB(8994,3571,3,34,0)="  20. SSN (last 4)"
^XWB(8994,3571,3,35,0)="  21. GENDER "
^XWB(8994,3571,3,36,0)="  22. INSTIEN "
^XWB(8994,3571,3,37,0)="  23. INSTNAME "
^XWB(8994,3571,3,38,0)="  24. PRIGRP - ENROLLMENT PRIORITY text from PATIENT ENROLLMENT file "
^XWB(8994,3571,3,39,0)="               Valid Values: "
^XWB(8994,3571,3,40,0)="                  GROUP 1 "
^XWB(8994,3571,3,41,0)="                  GROUP 2 "
^XWB(8994,3571,3,42,0)="                  GROUP 3 "
^XWB(8994,3571,3,43,0)="                  GROUP 4 "
^XWB(8994,3571,3,44,0)="                  GROUP 5 "
^XWB(8994,3571,3,45,0)="                  GROUP 6 "
^XWB(8994,3571,3,46,0)="                  GROUP 7 "
^XWB(8994,3571,3,47,0)="                  GROUP 8 "
^XWB(8994,3571,3,48,0)="  25. ELIGIEN - Pointer to MAS ELIGIBILITY CODE file 8.1 "
^XWB(8994,3571,3,49,0)="  26. ELIGNAME - NAME from MAS ELIGIBILITY CODE file "
^XWB(8994,3571,3,50,0)="  27. SVCCONN - SERVICE CONNECTED field from PATIENT ENROLLMENT file "
^XWB(8994,3571,3,51,0)="                Valid values: "
^XWB(8994,3571,3,52,0)="                 YES "
^XWB(8994,3571,3,53,0)="                 NO "
^XWB(8994,3571,3,54,0)="  28. SVCCONNP - SERVICE CONNECTED PERCENTAGE field from "
^XWB(8994,3571,3,55,0)="                 PATIENT ENROLLMENT file "
^XWB(8994,3571,3,56,0)="                 Numeric between 0-100 "
^XWB(8994,3571,3,57,0)="  29. TYPEIEN - Pointer to TYPE OF PATIENT file 391 "
^XWB(8994,3571,3,58,0)="  30. TYPENAME - NAME from TYPE OF PATIENT file 391 "
^XWB(8994,3571,3,59,0)="  31. PADDRES1 - Patient Address line 1 "
^XWB(8994,3571,3,60,0)="  32. PADDRES2 - Patient Address line 2 "
^XWB(8994,3571,3,61,0)="  33. PADDRES3 - Patient Address line 3 "
^XWB(8994,3571,3,62,0)="  34. PCITY - Patient City "
^XWB(8994,3571,3,63,0)="  35. PSTATE - Patient state name "
^XWB(8994,3571,3,64,0)="  36. PCOUNTRY - Patient country pointer to COUNTRY CODE file "
^XWB(8994,3571,3,65,0)="  37. PZIP4 - Patient Zip+4 "
^XWB(8994,3571,3,66,0)="  38. GAF - <text> | <GAF score> | <GAF date> | <diagnosis by IEN> "
^XWB(8994,3571,3,67,0)="           | <diagnosis by name> "
^XWB(8994,3571,3,68,0)="  39. SENSITIVE - Sensitive Record Access data "
^XWB(8994,3571,3,69,0)="                 separated by pipe |: "
^XWB(8994,3571,3,70,0)="   1. return code: "
^XWB(8994,3571,3,71,0)="        -1 -RPC/API failed "
^XWB(8994,3571,3,72,0)="            Required variable not defined "
^XWB(8994,3571,3,73,0)="         0 -No display/action required "
^XWB(8994,3571,3,74,0)="            Not accessing own, employee, or sensitive record "
^XWB(8994,3571,3,75,0)="         1 -Display warning message "
^XWB(8994,3571,3,76,0)="            Sensitive and DG SENSITIVITY key holder "
^XWB(8994,3571,3,77,0)="            or Employee and DG SECURITY OFFICER key holder "
^XWB(8994,3571,3,78,0)="        2 -Display warning message/require OK to continue "
^XWB(8994,3571,3,79,0)="            Sensitive and not a DG SENSITIVITY key holder "
^XWB(8994,3571,3,80,0)="            Employee and not a DG SECURITY OFFICER key holder "
^XWB(8994,3571,3,81,0)="         3 -Access to record denied "
^XWB(8994,3571,3,82,0)="            Accessing own record "
^XWB(8994,3571,3,83,0)="         4 -Access to Patient (#2) file records denied "
^XWB(8994,3571,3,84,0)="            SSN not defined "
^XWB(8994,3571,3,85,0)="    2. display text/message "
^XWB(8994,3571,3,86,0)="    3. display text/message "
^XWB(8994,3571,3,87,0)="   4. display text/message "
^XWB(8994,3571,3,88,0)="  40. LASTSUB - last subscripts of data in the return. "
^XWB(8994,3571,3,89,0)="                Will only be in the last record of the return. "
^XWB(8994,3571,3,90,0)="                Pass this as LASTSUB in the next call to continue "
^XWB(8994,3571,3,91,0)="                collecting data. "
^XWB(8994,3571,3,92,0)="  41. STOP    - list of pointers by pipe to CLINIC STOP file 40.7 "
^XWB(8994,3571,3,93,0)="  42. PTPHONE - Patient Phone number - Free-text 4-20 characters "
^XWB(8994,3571,3,94,0)="  43. URGENCY - pointer to PROTOCOL file 101 "
^XWB(8994,3571,3,95,0)="          ID from the URGENCY field 5 in REQUEST/CONSULTATION file 123 "
^XWB(8994,3571,3,96,0)="  44. PRACE - Patient Race pointer to RACE file 10 | separates entries "
^XWB(8994,3571,3,97,0)="  45. PRACEN - Patient Race name from RACE file | separates entries "
^XWB(8994,3571,3,98,0)="  46. PETH - Patient Ethnicity list separated by pipe | "
^XWB(8994,3571,3,99,0)="             Pointer to ETHNICITY file 10.2 "
^XWB(8994,3571,3,100,0)="  47. PETHN - Patient Ethnicity names separated by pipe | "
^XWB(8994,3571,3,101,0)="  48. PRHBLOC - Boolean indicating if location is a "
^XWB(8994,3571,3,102,0)="      Prohibit Access clinic "
^XWB(8994,3571,3,103,0)="  49. EARLIEST - EARLIEST DATE in Fileman format "
^XWB(8994,3571,3,104,0)="  50. BADADD = BAD ADDRESS INDICATOR (.121) "
^XWB(8994,3571,3,105,0)="     1=UNDELIVERABLE "
^XWB(8994,3571,3,106,0)="     2=HOMELESS "
^XWB(8994,3571,3,107,0)="     3=OTHER "
^XWB(8994,3571,3,108,0)="     4=ADDRESS NOT FOUND "
^XWB(8994,3571,3,109,0)="  51. OPHONE = Office phone (.132) "
^XWB(8994,3571,3,110,0)="  52. NOK - Primary Next of Kin (.211) "
^XWB(8994,3571,3,111,0)="  53. KNAME - Primary Next of Kin name "
^XWB(8994,3571,3,112,0)="  54. KREL - Primary Next of Kin Relationship to Patient (.212) "
^XWB(8994,3571,3,113,0)="  55. KPHONE - Primary Next of Kin Phone (.219) "
^XWB(8994,3571,3,114,0)="  56. KSTREET - Primary Next of Kin Street Address [Line 1] "
^XWB(8994,3571,3,115,0)="                       (.213) "
^XWB(8994,3571,3,116,0)="  57. KSTREET2 - Primary Next of Kin Street Address [Line 2] "
^XWB(8994,3571,3,117,0)="                        (.214) "
^XWB(8994,3571,3,118,0)="  58. KSTREET3 - Primary Next of Kin Street Address [Line 3] "
^XWB(8994,3571,3,119,0)="                        (.215) "
^XWB(8994,3571,3,120,0)="  59. KCITY - Primary Next of Kin City (.216) "
^XWB(8994,3571,3,121,0)="  60. KSTATE - Primary Next of Kin State (.217) "
^XWB(8994,3571,3,122,0)="  61. KZIP - Primary Next of Kin Zip (.218) "
^XWB(8994,3571,3,123,0)="  62. NOK2 - Secondary Next of Kin (.2191) "
^XWB(8994,3571,3,124,0)="  63. K2NAME - Secondary Next of Kin name (.2191) "
^XWB(8994,3571,3,125,0)="  64. K2REL - Secondary Next of Kin Relationship to Patient "
^XWB(8994,3571,3,126,0)="                     (.2192) "
^XWB(8994,3571,3,127,0)="  65. K2PHONE - Secondary Next of Kin Phone (.2199) "
^XWB(8994,3571,3,128,0)="  66. K2STREET - Secondary Next of Kin Street Address [Line 1] "
^XWB(8994,3571,3,129,0)="                        (.2193) "
^XWB(8994,3571,3,130,0)="  67. K2STREET2 - Secondary Next of Kin Street Address [Line 2] "
^XWB(8994,3571,3,131,0)="                         (.2194) "
^XWB(8994,3571,3,132,0)="  68. K2STREET3 - Secondary Next of Kin Street Address [Line 3] "
^XWB(8994,3571,3,133,0)="                         (.2195) "
^XWB(8994,3571,3,134,0)="  69. K2CITY - Secondary Next of Kin City (.2196) "
^XWB(8994,3571,3,135,0)="  70. K2STATE - Secondary Next of Kin State (.2197) "
^XWB(8994,3571,3,136,0)="  71. K2ZIP - Secondary Next of Kin Zip (.2198) "
^XWB(8994,3571,3,137,0)="  72. PCOUNTY - Patient County (.117) "
^XWB(8994,3571,3,138,0)="  73. PMARITAL - Patient Marital Status "
^XWB(8994,3571,3,139,0)="  74. PRELIGION - Patient Religious Preference "
^XWB(8994,3571,3,140,0)="  75. PTACTIVE - Patient Temporary Address Active? (.12105) "
^XWB(8994,3571,3,141,0)="  76. PTADDRESS1 - Patient Temporary Address Line 1 (.1211) "
^XWB(8994,3571,3,142,0)="  77. PTADDRESS2 - Patient Temporary Address Line 2 (.1212) "
^XWB(8994,3571,3,143,0)="  78. PTADDRESS3 - Patient Temporary Address Line 3 (.1213) "
^XWB(8994,3571,3,144,0)="  79. PTCITY - Patient Temporary City (.1214) "
^XWB(8994,3571,3,145,0)="  80. PTSTATE - Patient Temporary State (.1215) "
^XWB(8994,3571,3,146,0)="  81. PTZIP - Patient Temporary Zip (.1216) "
^XWB(8994,3571,3,147,0)="  82. PTZIP+4 - Patient Temporary Zip+4 (.12112) "
^XWB(8994,3571,3,148,0)="  83. PTCOUNTRY - Patient Temporary Country (.1223) "
^XWB(8994,3571,3,149,0)="  84. PTCOUNTY - Patient Temporary County (.12111) "
^XWB(8994,3571,3,150,0)="  85. PTPHONE - Patient Temporary Phone (.1219) "
^XWB(8994,3571,3,151,0)="  86. PTSTART - Patient Temporary Address Start Date (.1217) "
^XWB(8994,3571,3,152,0)="  87. PTEND - Patient Temporary Address End Date (.1218) "
^XWB(8994,3571,3,153,0)="  88. PCELL - Patient Cell Phone (.134) "
^XWB(8994,3571,3,154,0)="  89. PPAGER - Patient Pager Number (.135) "
^XWB(8994,3571,3,155,0)="  90. PEMAIL - Patient Email Address (.133) "
^XWB(8994,3571,3,156,0)="  91. PF_FFF - Patient FUGITIVE FELON FLAG 1=YES "
^XWB(8994,3571,3,157,0)="  92. PF_VCD - Patient VETERAN CATASTROPHICALLY DISABLED? "
^XWB(8994,3571,3,158,0)="                       Y=YES N=NO "
^XWB(8994,3571,3,159,0)="  93. PFNATIONAL - Patient national Flags "
^XWB(8994,3571,3,160,0)="                         (PRF ASSIGNMENT/PRF NATIONAL FLAG) separated by "
^XWB(8994,3571,3,161,0)="| "
^XWB(8994,3571,3,162,0)="        Each | piece contains the following ;; pieces: "
^XWB(8994,3571,3,163,0)="        1. PRFAID - PRF Assignment ID pointer to PRF ASSIGNMENT file "
^XWB(8994,3571,3,164,0)="(#26.13)"
^XWB(8994,3571,3,165,0)="        2. PRFSTAT - PRF Assignment Status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3571,3,166,0)="        3. PRFNID - PRF National Flag ID pointer to PRF NATIONAL FLAG "
^XWB(8994,3571,3,167,0)="file "
^XWB(8994,3571,3,168,0)="                    (#26.15) "
^XWB(8994,3571,3,169,0)="        4. PRFNNAME - PRF National Flag name "
^XWB(8994,3571,3,170,0)="        5. PRFNSTAT - PRF National Flag status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3571,3,171,0)=" 94. PFLOCAL - Patient Local Flags "
^XWB(8994,3571,3,172,0)="                      (PRF ASSIGNMENT/PRF Local FLAG) separated by | "
^XWB(8994,3571,3,173,0)="        Each | piece contains the following ;; pieces: "
^XWB(8994,3571,3,174,0)="        1. PRFAID - PRF Assignment ID pointer to PRF ASSIGNMENT file "
^XWB(8994,3571,3,175,0)="(#26.13)"
^XWB(8994,3571,3,176,0)="        2. PRFSTAT - PRF Assignment Status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3571,3,177,0)="        3. PRFLID - PRF Local Flag ID pointer to PRF LOCAL FLAG file "
^XWB(8994,3571,3,178,0)="(#26.11)"
^XWB(8994,3571,3,179,0)="        4. PRFLNAME - PRF Local Flag name "
^XWB(8994,3571,3,180,0)="        5. PRFLSTAT - PRF Local Flag status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3571,3,181,0)=" 95. SUBGRP - value from the ENROLLMENT SUBGROUP field of the"
^XWB(8994,3571,3,182,0)="              PATIENT ENROLLMENT file (#27.11) "
^XWB(8994,3571,3,183,0)="              Valid values are a b c d e g "
^XWB(8994,3571,3,184,0)=" 96. CAT8G  - Category 8g flag - True if PriGRP ='Group 8' AND SUBGRP-'g'"
^XWB(8994,3571,3,185,0)=" 97. SIMILAR = Similar Patients "
^XWB(8994,3571,3,186,0)="      MESSSAGE | Patients "
^XWB(8994,3571,3,187,0)="       Patients separated by ;; "
^XWB(8994,3571,3,188,0)="        Each ;; piece contains the following ~ pieces "
^XWB(8994,3571,3,189,0)="        DFN ~ NAME ~ DOB ~ SSN"
^XWB(8994,3571,3,190,0)=" 98. PHONE CALL ATTEMPTS MADE"
^XWB(8994,3571,3,191,0)=" 99. DATE OF LAST LETTER ATTEMPT SENT"
^XWB(8994,3571,3,192,0)="100. COVID 19 PRIORITY "
^XWB(8994,3571,3,193,0)="101. EMAIL CONTACT ATTEMPTS MADE"
^XWB(8994,3571,3,194,0)="102. TEXT CONTACT ATTEMPT MADE"
^XWB(8994,3571,3,195,0)="103. SECURE MESSAGES CONTACT ATTEMPTS MADE"
^XWB(8994,3572,0)="SDEC RECGET^RECGET^SDEC^4^R^0^^0"
^XWB(8994,3572,1,0)="^8994.01^2^2^3210413^^^^"
^XWB(8994,3572,1,1,0)="GET entries from the RECALL REMINDERS file 403.5 for a given Patient "
^XWB(8994,3572,1,2,0)="and Recall Date range."
^XWB(8994,3572,2,0)="^8994.02A^5^5"
^XWB(8994,3572,2,1,0)="DFN^1^^1^1"
^XWB(8994,3572,2,1,1,0)="^^1^1^3140905^"
^XWB(8994,3572,2,1,1,1,0)="Pointer to PATIENT file 2."
^XWB(8994,3572,2,2,0)="SDBEG^1^^0^2"
^XWB(8994,3572,2,2,1,0)="^^1^1^3140905^"
^XWB(8994,3572,2,2,1,1,0)="Begin Date range in external format to search RECALL DATE range. (no time)"
^XWB(8994,3572,2,3,0)="SDEND^1^^0^3"
^XWB(8994,3572,2,3,1,0)="^8994.021^1^1^3141210^^"
^XWB(8994,3572,2,3,1,1,0)="End Date range in external format to search RECALL DATE range. (no time)"
^XWB(8994,3572,2,4,0)="MAXREC^1^^0^4"
^XWB(8994,3572,2,4,1,0)="^^1^1^3150128^"
^XWB(8994,3572,2,4,1,1,0)="maximum number of records to return"
^XWB(8994,3572,2,5,0)="LASTSUB^1^^0^5"
^XWB(8994,3572,2,5,1,0)="^8994.021^2^2^3210413^^^^"
^XWB(8994,3572,2,5,1,1,0)="Last subscripts from previous call;"
^XWB(8994,3572,2,5,1,2,0)="Used to collect the data in multiple background calls"
^XWB(8994,3572,2,"B","DFN",1)=""
^XWB(8994,3572,2,"B","LASTSUB",5)=""
^XWB(8994,3572,2,"B","MAXREC",4)=""
^XWB(8994,3572,2,"B","SDBEG",2)=""
^XWB(8994,3572,2,"B","SDEND",3)=""
^XWB(8994,3572,2,"PARAMSEQ",1,1)=""
^XWB(8994,3572,2,"PARAMSEQ",2,2)=""
^XWB(8994,3572,2,"PARAMSEQ",3,3)=""
^XWB(8994,3572,2,"PARAMSEQ",4,4)=""
^XWB(8994,3572,2,"PARAMSEQ",5,5)=""
^XWB(8994,3572,3,0)="^^180^180^3220728^"
^XWB(8994,3572,3,1,0)="Global Array in which each array entry contains data from the"
^XWB(8994,3572,3,2,0)="    RECALL REMINDERS file 403.5."
^XWB(8994,3572,3,3,0)="     1. IEN - pointer to RECALL REMINDERS "
^XWB(8994,3572,3,4,0)="     2. DFN - Pointer to PATIENT file "
^XWB(8994,3572,3,5,0)="     3. NAME - Patient NAME from PATIENT file "
^XWB(8994,3572,3,6,0)="     4. HRN "
^XWB(8994,3572,3,7,0)="     5. DOB - Date of Birth in external format "
^XWB(8994,3572,3,8,0)="     6. SSN - Social Security Number (last 4)"
^XWB(8994,3572,3,9,0)="     7. GENDER "
^XWB(8994,3572,3,10,0)="     8 INSTIEN - INSTITUTION ien "
^XWB(8994,3572,3,11,0)="     9 INSTNAME - INSTITUTION NAME "
^XWB(8994,3572,3,12,0)="    10. ACCESION - Accession # (free-text 1-25 characters) "
^XWB(8994,3572,3,13,0)="    11. COMM - COMMENT (free-text 1-80 characters) "
^XWB(8994,3572,3,14,0)="    12. FASTING - FAST/NON-FASTING valid values: "
^XWB(8994,3572,3,15,0)="                  FASTING "
^XWB(8994,3572,3,16,0)="                  NON-FASTING "
^XWB(8994,3572,3,17,0)="    13. RRAPPTYP - Test/App pointer to RECALL REMINDERS APPT TYPE "
^XWB(8994,3572,3,18,0)="                   file 403.51 "
^XWB(8994,3572,3,19,0)="    14. RRPROVIEN - Provider - Pointer to RECALL REMINDERS "
^XWB(8994,3572,3,20,0)="                    PROVIDERS file 403.54 "
^XWB(8994,3572,3,21,0)="    15. PROVNAME - Provider NAME of Provider in RECALL REMINDERS "
^XWB(8994,3572,3,22,0)="                   PROVIDERS file "
^XWB(8994,3572,3,23,0)="    16. CLINIEN - Clinic pointer to HOSPITAL LOCATION file "
^XWB(8994,3572,3,24,0)="    17. CLINNAME - Clinic NAME from HOSPITAL LOCATION file "
^XWB(8994,3572,3,25,0)="    18. APPTLEN - Length of Appointment numeric between 10 and 120 "
^XWB(8994,3572,3,26,0)="    19. DATE - Recall Date in external format (no time) "
^XWB(8994,3572,3,27,0)="    20. DATE1 - Recall Date (Per patient) in external format "
^XWB(8994,3572,3,28,0)="                (no time) "
^XWB(8994,3572,3,29,0)="    21. DAPTDT - Date Reminder Sent in external format (no time) "
^XWB(8994,3572,3,30,0)="    22. USERIEN - User Who Entered Recall pointer to NEW PERSON "
^XWB(8994,3572,3,31,0)="                  file "
^XWB(8994,3572,3,32,0)="    23. USERNAME - User Who Entered Recall NAME from NEW PERSON "
^XWB(8994,3572,3,33,0)="                   file "
^XWB(8994,3572,3,34,0)="  24. DATE2 - Second Print Date in external format (no time) "
^XWB(8994,3572,3,35,0)="  25. PRIGRP - ENROLLMENT PRIORITY text from PATIENT ENROLLMENT "
^XWB(8994,3572,3,36,0)="               file.  Valid Values: "
^XWB(8994,3572,3,37,0)="                       GROUP 1 "
^XWB(8994,3572,3,38,0)="                       GROUP 2 "
^XWB(8994,3572,3,39,0)="                       GROUP 3 "
^XWB(8994,3572,3,40,0)="                       GROUP 4 "
^XWB(8994,3572,3,41,0)="                       GROUP 5 "
^XWB(8994,3572,3,42,0)="                       GROUP 6 "
^XWB(8994,3572,3,43,0)="                       GROUP 7 "
^XWB(8994,3572,3,44,0)="                       GROUP 8 "
^XWB(8994,3572,3,45,0)="  26. ELIGIEN - Pointer to MAS ELIGIBILITY CODE file 8.1 "
^XWB(8994,3572,3,46,0)="  27. ELIGNAME - NAME from MAS ELIGIBILITY CODE file "
^XWB(8994,3572,3,47,0)="  28. SVCCONN - SERVICE CONNECTED field from PATIENT ENROLLMENT "
^XWB(8994,3572,3,48,0)="                file. Valid values: "
^XWB(8994,3572,3,49,0)="                  YES "
^XWB(8994,3572,3,50,0)="                  NO "
^XWB(8994,3572,3,51,0)="  29. SVCCONNP - SERVICE CONNECTED PERCENTAGE field from PATIENT "
^XWB(8994,3572,3,52,0)="                 ENROLLMENT file "
^XWB(8994,3572,3,53,0)="                 Numeric between 0-100 "
^XWB(8994,3572,3,54,0)=" 30. TYPEIEN - Pointer to TYPE OF PATIENT file 391 "
^XWB(8994,3572,3,55,0)=" 31. TYPENAME - NAME from TYPE OF PATIENT file 391 "
^XWB(8994,3572,3,56,0)=" 32. DATE3    - DATE/TIME RECALL ADDED from RECALL REMINDERS "
^XWB(8994,3572,3,57,0)="                file 403.5 "
^XWB(8994,3572,3,58,0)=" 33. PADDRES1 - Patient Address line 1 "
^XWB(8994,3572,3,59,0)=" 34. PADDRES2 - Patient Address line 2 "
^XWB(8994,3572,3,60,0)=" 35. PADDRES3 - Patient Address line 3 "
^XWB(8994,3572,3,61,0)=" 36. PCITY - Patient City "
^XWB(8994,3572,3,62,0)=" 37. PSTATE - Patient state name "
^XWB(8994,3572,3,63,0)=" 38. PCOUNTRY - Patient country pointer to COUNTRY CODE file "
^XWB(8994,3572,3,64,0)=" 39. PZIP4 - Patient Zip+4 "
^XWB(8994,3572,3,65,0)=" 40. GAF - <text> | <GAF score> | <GAF date> "
^XWB(8994,3572,3,66,0)="           | <diagnosis by IEN> | <diagnosis by name> "
^XWB(8994,3572,3,67,0)=" 41. SENSITIVE - Sensitive Record Access data "
^XWB(8994,3572,3,68,0)="                 separated by pipe |: "
^XWB(8994,3572,3,69,0)="   1. return code: "
^XWB(8994,3572,3,70,0)="       -1 -RPC/API failed "
^XWB(8994,3572,3,71,0)="           Required variable not defined "
^XWB(8994,3572,3,72,0)="        0 -No display/action required "
^XWB(8994,3572,3,73,0)="           Not accessing own, employee, or sensitive record "
^XWB(8994,3572,3,74,0)="        1 -Display warning message "
^XWB(8994,3572,3,75,0)="           Sensitive and DG SENSITIVITY key holder "
^XWB(8994,3572,3,76,0)="           or Employee and DG SECURITY OFFICER key holder "
^XWB(8994,3572,3,77,0)="        2 -Display warning message/require OK to continue "
^XWB(8994,3572,3,78,0)="           Sensitive and not a DG SENSITIVITY key holder "
^XWB(8994,3572,3,79,0)="           Employee and not a DG SECURITY OFFICER key holder "
^XWB(8994,3572,3,80,0)="        3 -Access to record denied "
^XWB(8994,3572,3,81,0)="           Accessing own record "
^XWB(8994,3572,3,82,0)="        4 -Access to Patient (#2) file records denied "
^XWB(8994,3572,3,83,0)="           SSN not defined "
^XWB(8994,3572,3,84,0)="   2. display text/message "
^XWB(8994,3572,3,85,0)="   3. display text/message "
^XWB(8994,3572,3,86,0)="   4. display text/message "
^XWB(8994,3572,3,87,0)=" 42. LASTSUB - last subscripts of data in the return. "
^XWB(8994,3572,3,88,0)="                Will only be in the last record of the return. "
^XWB(8994,3572,3,89,0)="                Pass this as LASTSUB in the next call to continue "
^XWB(8994,3572,3,90,0)="                collecting data. "
^XWB(8994,3572,3,91,0)=" 43. PTPHONE - Patient Phone number - Free-text 4-20 characters "
^XWB(8994,3572,3,92,0)=" 44. PRACE - Patient Race pointer to RACE file 10 | separates entries"
^XWB(8994,3572,3,93,0)=" 45. PRACEN - Patient Race name from RACE file | separates entries "
^XWB(8994,3572,3,94,0)=" 46. PETH - Patient Ethnicity list separated by pipe | "
^XWB(8994,3572,3,95,0)="            Pointer to ETHNICITY file 10.2 "
^XWB(8994,3572,3,96,0)=" 47. PETHN - Patient Ethnicity names separated by pipe | "
^XWB(8994,3572,3,97,0)=" 48. PRHBLOC - Boolean indicating if location is a "
^XWB(8994,3572,3,98,0)="               Prohibit Access clinic "
^XWB(8994,3572,3,99,0)=" 49. BADADD = BAD ADDRESS INDICATOR (.121) "
^XWB(8994,3572,3,100,0)="                     1=UNDELIVERABLE "
^XWB(8994,3572,3,101,0)="                     2=HOMELESS "
^XWB(8994,3572,3,102,0)="                     3=OTHER "
^XWB(8994,3572,3,103,0)="                     4=ADDRESS NOT FOUND "
^XWB(8994,3572,3,104,0)=" 50. OPHONE = Office phone (.132) "
^XWB(8994,3572,3,105,0)=" 51. NOK - Primary Next of Kin (.211) "
^XWB(8994,3572,3,106,0)=" 52. KNAME - Primary Next of Kin name "
^XWB(8994,3572,3,107,0)=" 53. KREL - Primary Next of Kin Relationship to Patient (.212) "
^XWB(8994,3572,3,108,0)=" 54. KPHONE - Primary Next of Kin Phone (.219) "
^XWB(8994,3572,3,109,0)=" 55. KSTREET - Primary Next of Kin Street Address [Line 1] (.213) "
^XWB(8994,3572,3,110,0)=" 56. KSTREET2 - Primary Next of Kin Street Address [Line 2] (.214) "
^XWB(8994,3572,3,111,0)=" 57. KSTREET3 - Primary Next of Kin Street Address [Line 3] (.215) "
^XWB(8994,3572,3,112,0)=" 58. KCITY - Primary Next of Kin City (.216) "
^XWB(8994,3572,3,113,0)=" 59. KSTATE - Primary Next of Kin State (.217) "
^XWB(8994,3572,3,114,0)=" 60. KZIP - Primary Next of Kin Zip (.218) "
^XWB(8994,3572,3,115,0)=" 61. NOK2 - Secondary Next of Kin (.2191) "
^XWB(8994,3572,3,116,0)=" 62. K2NAME - Secondary Next of Kin name (.2191) "
^XWB(8994,3572,3,117,0)=" 63. K2REL - Secondary Next of Kin Relationship to Patient (.2192) "
^XWB(8994,3572,3,118,0)=" 64. K2PHONE - Secondary Next of Kin Phone (.2199) "
^XWB(8994,3572,3,119,0)=" 65. K2STREET - Secondary Next of Kin Street Address Line 1 (.2193) "
^XWB(8994,3572,3,120,0)=" 66. K2STREET2 - Secondary Next of Kin Street Address Line 2 (.2194) "
^XWB(8994,3572,3,121,0)=" 67. K2STREET3 - Secondary Next of Kin Street Address Line 3 (.2195) "
^XWB(8994,3572,3,122,0)=" 68. K2CITY - Secondary Next of Kin City (.2196) "
^XWB(8994,3572,3,123,0)=" 69. K2STATE - Secondary Next of Kin State (.2197) "
^XWB(8994,3572,3,124,0)=" 70. K2ZIP - Secondary Next of Kin Zip (.2198) "
^XWB(8994,3572,3,125,0)=" 71. PCOUNTY - Patient County (.117) "
^XWB(8994,3572,3,126,0)=" 72. PMARITAL - Patient Marital Status "
^XWB(8994,3572,3,127,0)=" 73. PRELIGION - Patient Religious Preference "
^XWB(8994,3572,3,128,0)=" 74. PTACTIVE - Patient Temporary Address Active? (.12105) "
^XWB(8994,3572,3,129,0)=" 75. PTADDRESS1 - Patient Temporary Address Line 1 (.1211) "
^XWB(8994,3572,3,130,0)=" 76. PTADDRESS2 - Patient Temporary Address Line 2 (.1212) "
^XWB(8994,3572,3,131,0)=" 77. PTADDRESS3 - Patient Temporary Address Line 3 (.1213) "
^XWB(8994,3572,3,132,0)=" 78. PTCITY - Patient Temporary City (.1214) "
^XWB(8994,3572,3,133,0)=" 79. PTSTATE - Patient Temporary State (.1215) "
^XWB(8994,3572,3,134,0)=" 80. PTZIP - Patient Temporary Zip (.1216) "
^XWB(8994,3572,3,135,0)=" 81. PTZIP4 - Patient Temporary Zip+4 (.12112) "
^XWB(8994,3572,3,136,0)=" 82. PTCOUNTRY - Patient Temporary Country (.1223) "
^XWB(8994,3572,3,137,0)=" 83. PTCOUNTY - Patient Temporary County (.12111) "
^XWB(8994,3572,3,138,0)=" 84. PTPHONE - Patient Temporary Phone (.1219) "
^XWB(8994,3572,3,139,0)=" 85. PTSTART - Patient Temporary Address Start Date (.1217) "
^XWB(8994,3572,3,140,0)=" 86. PTEND - Patient Temporary Address End Date (.1218) "
^XWB(8994,3572,3,141,0)=" 87. PCELL - Patient Cell Phone (.134) "
^XWB(8994,3572,3,142,0)=" 88. PPAGER - Patient Pager Number (.135) "
^XWB(8994,3572,3,143,0)=" 89. PEMAIL - Patient Email Address (.133) "
^XWB(8994,3572,3,144,0)=" 90. PF_FFF - Patient FUGITIVE FELON FLAG 1=YES "
^XWB(8994,3572,3,145,0)=" 91. PF_VCD - Patient VETERAN CATASTROPHICALLY DISABLED? Y=YES N=NO "
^XWB(8994,3572,3,146,0)=" 92. PFNATIONAL - Patient national Flags "
^XWB(8994,3572,3,147,0)="                         (PRF ASSIGNMENT/PRF NATIONAL FLAG) separated by |"
^XWB(8994,3572,3,148,0)="        Each | piece contains the following ;; pieces: "
^XWB(8994,3572,3,149,0)="        1. PRFAID - PRF Assignment ID pointer to PRF ASSIGNMENT file "
^XWB(8994,3572,3,150,0)="(#26.13)"
^XWB(8994,3572,3,151,0)="        2. PRFSTAT - PRF Assignment Status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3572,3,152,0)="        3. PRFNID - PRF National Flag ID pointer to"
^XWB(8994,3572,3,153,0)="                    PRF NATIONAL FLAG file (#26.15) "
^XWB(8994,3572,3,154,0)="        4. PRFNNAME - PRF National Flag name "
^XWB(8994,3572,3,155,0)="        5. PRFNSTAT - PRF National Flag status 0=INACTIVE 1=ACTIVE"
^XWB(8994,3572,3,156,0)=" 93. PFLOCAL - Patient Local Flags "
^XWB(8994,3572,3,157,0)="                      (PRF ASSIGNMENT/PRF Local FLAG) separated by | "
^XWB(8994,3572,3,158,0)="        Each | piece contains the following ;; pieces: "
^XWB(8994,3572,3,159,0)="        1. PRFAID - PRF Assignment ID pointer to PRF ASSIGNMENT file "
^XWB(8994,3572,3,160,0)="(#26.13)"
^XWB(8994,3572,3,161,0)="        2. PRFSTAT - PRF Assignment Status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3572,3,162,0)="        3. PRFLID - PRF Local Flag ID pointer to PRF LOCAL FLAG file "
^XWB(8994,3572,3,163,0)="(#26.11)"
^XWB(8994,3572,3,164,0)="        4. PRFLNAME - PRF Local Flag name "
^XWB(8994,3572,3,165,0)="        5. PRFLSTAT - PRF Local Flag status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3572,3,166,0)=" 94. SUBGRP - value from the ENROLLMENT SUBGROUP field of the"
^XWB(8994,3572,3,167,0)="              PATIENT ENROLLMENT file (#27.11) "
^XWB(8994,3572,3,168,0)="              Valid values are a b c d e g "
^XWB(8994,3572,3,169,0)=" 95. CAT8G  - Category 8g flag - True if Priority ='Group 8' AND "
^XWB(8994,3572,3,170,0)="SUBGRP-'g'"
^XWB(8994,3572,3,171,0)=" 96. SIMILAR = Similar Patients "
^XWB(8994,3572,3,172,0)="      MESSSAGE | Patients "
^XWB(8994,3572,3,173,0)="       Patients separated by ;; "
^XWB(8994,3572,3,174,0)="        Each ;; piece contains the following ~ pieces "
^XWB(8994,3572,3,175,0)="        DFN ~ NAME ~ DOB ~ SSN"
^XWB(8994,3572,3,176,0)="  97. PHONE CALL ATTEMPTS MADE"
^XWB(8994,3572,3,177,0)="  98. DATE OF LAST LETTER ATTEMPT SENT"
^XWB(8994,3572,3,178,0)="  99. EMAIL CONTACT ATTEMPTS MADE"
^XWB(8994,3572,3,179,0)=" 100. TEXT CONTACT ATTEMPT MADE"
^XWB(8994,3572,3,180,0)=" 101. SECURE MESSAGES CONTACT ATTEMPTS MADE"
^XWB(8994,3572,4)=0
^XWB(8994,3573,0)="SDEC RECSET^RECSET^SDEC^1^R^0^^0"
^XWB(8994,3573,1,0)="^8994.01^1^1^3211005^^^^"
^XWB(8994,3573,1,1,0)="SET/EDIT an entry to the RECALL REMINDERS file 403.5"
^XWB(8994,3573,2,0)="^8994.02A^1^1"
^XWB(8994,3573,2,1,0)="INP^4^^1^1"
^XWB(8994,3573,2,1,1,0)="^^28^28^3211005^"
^XWB(8994,3573,2,1,1,1,0)="INP - Input array"
^XWB(8994,3573,2,1,1,2,0)="      INP(0) - (optional) IEN pointer to RECALL REMINDERS"
^XWB(8994,3573,2,1,1,3,0)="                          a new entry will be added if null"
^XWB(8994,3573,2,1,1,4,0)="      INP(1) - (required) DFN Pointer to PATIENT file"
^XWB(8994,3573,2,1,1,5,0)="      INP(2) - (optional) Accession # (free-text 1-25 characters)"
^XWB(8994,3573,2,1,1,6,0)="      INP(3) - (optional) COMMENT (free-text 1-80 characters)"
^XWB(8994,3573,2,1,1,7,0)="      INP(4) - (optional) FAST/NON-FASTING valid values:"
^XWB(8994,3573,2,1,1,8,0)="                            FASTING"
^XWB(8994,3573,2,1,1,9,0)="                            NON-FASTING"
^XWB(8994,3573,2,1,1,10,0)="      INP(5) - (required) Test/App pointer to RECALL REMINDERS APPT"
^XWB(8994,3573,2,1,1,11,0)="                          TYPE file 403.51"
^XWB(8994,3573,2,1,1,12,0)="      INP(6) - (required) Provider - Pointer to RECALL REMINDERS"
^XWB(8994,3573,2,1,1,13,0)="                          PROVIDERS file 403.54"
^XWB(8994,3573,2,1,1,14,0)="      INP(7) - (required) Clinic pointer to HOSPITAL LOCATION file"
^XWB(8994,3573,2,1,1,15,0)="      INP(8) - (optional) Length of Appointment numeric"
^XWB(8994,3573,2,1,1,16,0)="                          between 10 and 120"
^XWB(8994,3573,2,1,1,17,0)="      INP(9) - (required) Recall Date in external format (no time)"
^XWB(8994,3573,2,1,1,18,0)="      INP(10)- (optional) Recall Date (Per patient) in external format"
^XWB(8994,3573,2,1,1,19,0)="                          (no time)"
^XWB(8994,3573,2,1,1,20,0)="      INP(11)- (optional) Date Reminder Sent in external format"
^XWB(8994,3573,2,1,1,21,0)="                          (no time)"
^XWB(8994,3573,2,1,1,22,0)="      INP(12)- (optional) User Who Entered Recall pointer to"
^XWB(8994,3573,2,1,1,23,0)="                          NEW PERSON file; default to current user"
