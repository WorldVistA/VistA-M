^XWB(8994,373,2,2,1,5,0)="documented for that patient."
^XWB(8994,373,2,3,0)="PSBSIOPI^1^1^0^3"
^XWB(8994,373,2,3,1,0)="^^5^5^3120110^"
^XWB(8994,373,2,3,1,1,0)="This parameter is a true/false flag (1/0).  If true use the new SI/OP Wp"
^XWB(8994,373,2,3,1,2,0)="fields and return data in the Results array to the GUI Client."
^XWB(8994,373,2,3,1,3,0)=" "
