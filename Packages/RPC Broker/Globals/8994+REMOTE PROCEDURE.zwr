^XWB(8994,2537,2,"PARAMSEQ",4,4)=""
^XWB(8994,2537,3,0)="^8994.03^3^3^3070820^^"
^XWB(8994,2537,3,1,0)="Single value, negative code means RPC error, 0-code means filing"
^XWB(8994,2537,3,2,0)="error and positive 1 means success.  Note that only one buffer"
^XWB(8994,2537,3,3,0)="file entry can be created at a time using this RPC."
^XWB(8994,2538,0)="DSIV ADD VIEWING AUDIT^AAUDIT^DSIVIC2^1^A^^^1"
^XWB(8994,2538,1,0)="^^9^9^3221214^"
^XWB(8994,2538,1,1,0)="Add ""viewing"" audit entry to 19625, with minimum data. This rpc verifies "
^XWB(8994,2538,1,2,0)="that the user checked to see whether a buffer entry was needed for an "
^XWB(8994,2538,1,3,0)="appt.  Buffer IEN will be set to 0."
^XWB(8994,2538,1,4,0)=" "
^XWB(8994,2538,1,5,0)="input is  DATA(""DFN"") - required, pointer to the patient file"
^XWB(8994,2538,1,6,0)="          DATA(""LOC"") - required, free text clinic location"
^XWB(8994,2538,1,7,0)="       DATA(""LOCIEN"") - required, pointer to the clinic location file"
^XWB(8994,2538,1,8,0)="         DATA(""APDT"") - required, appt date"
^XWB(8994,2538,1,9,0)=" return -1^error message  or ien of entry"
^XWB(8994,2538,2,0)="^8994.02A^1^1"
^XWB(8994,2538,2,1,0)="OPE^2^^1^1"
^XWB(8994,2538,2,1,1,0)="^8994.021^1^1^3221214^^"
^XWB(8994,2538,2,1,1,1,0)="DATA(""DFN""), DATA(""LOC""), DATA(""LOCIEN""), and DATA(""APDT"") are required."
^XWB(8994,2538,2,"B","OPE",1)=""
^XWB(8994,2538,2,"PARAMSEQ",1,1)=""
^XWB(8994,2538,3,0)="^8994.03^1^1^3221214^^^^"
^XWB(8994,2538,3,1,0)="Returns ien of audit file entry, or -1^error message."
^XWB(8994,2539,0)="DSIV EXCEPTION REPORT2^RPTP^DSIVICR1^1^A"
^XWB(8994,2539,1,0)="^8994.01^2^2^3070820^^^^"
^XWB(8994,2539,1,1,0)="Kicks off a background job to run the ICB Exception report (users who did "
^XWB(8994,2539,1,2,0)="not enter buffer entries in a timely manner)."
^XWB(8994,2539,2,0)="^8994.02A^4^4"
^XWB(8994,2539,2,1,0)="SDT^1^30^1^1"
^XWB(8994,2539,2,1,1,0)="^^1^1^3060605^"
^XWB(8994,2539,2,1,1,1,0)="Contains the start date for the report."
^XWB(8994,2539,2,2,0)="EDT^1^30^0^2"
^XWB(8994,2539,2,2,1,0)="^^1^1^3060605^"
^XWB(8994,2539,2,2,1,1,0)="Contains the end date of the report."
^XWB(8994,2539,2,3,0)="DSIVHNDL^1^50^0^3"
^XWB(8994,2539,2,3,1,0)="^8994.021^2^2^3070124^^"
^XWB(8994,2539,2,3,1,1,0)="Contains the handle for the background job.  This is the ^XTMP global "
^XWB(8994,2539,2,3,1,2,0)="node where the report status and data will reside."
^XWB(8994,2539,2,4,0)="DSIVLOCS^2^30^0^4"
^XWB(8994,2539,2,4,1,0)="^8994.021^3^3^3070820^^^^"
^XWB(8994,2539,2,4,1,1,0)="Contains a list of clinics to return for the report.  The exception "
^XWB(8994,2539,2,4,1,2,0)="report will still gather appointments for all locations (except inactive, "
^XWB(8994,2539,2,4,1,3,0)="and ""ZZ"" locations), but will only return the selected ones."
^XWB(8994,2539,2,"B","DSIVHNDL",3)=""
^XWB(8994,2539,2,"B","DSIVLOCS",4)=""
^XWB(8994,2539,2,"B","EDT",2)=""
^XWB(8994,2539,2,"B","SDT",1)=""
^XWB(8994,2539,2,"PARAMSEQ",1,1)=""
^XWB(8994,2539,2,"PARAMSEQ",2,2)=""
^XWB(8994,2539,2,"PARAMSEQ",3,3)=""
^XWB(8994,2539,2,"PARAMSEQ",4,4)=""
^XWB(8994,2539,3,0)="^^4^4^3070820^"
^XWB(8994,2539,3,1,0)="Returns -1^error if there was a problem starting the background job, or "
^XWB(8994,2539,3,2,0)="returns Taskman Task# ^ Handle.  The Handle is used to poll VistA using "
^XWB(8994,2539,3,3,0)="the DSIV POLL REPORT rpc to see whether the report has finished "
^XWB(8994,2539,3,4,0)="processing and to get the data."
^XWB(8994,2540,0)="DSIV FIND ENTRIES^FIND^DSIVIC^4^^^^1"
^XWB(8994,2540,1,0)="^8994.01^1^1^3101202^^"
^XWB(8994,2540,1,1,0)="Returns unprocessed INSURANCE BUFFER file entries for a given patient."
