^XWB(8994,2494,0)="OR GET COMBAT VET^CV^ORMARKER^2^R^0^^^1"
^XWB(8994,2495,0)="ORWDX UNLKOTH^UNLKOTH^ORWDX^1"
^XWB(8994,2496,0)="GMV CLOSEST READING^CLOSEST^GMVGETD^1^R^0"
^XWB(8994,2496,1,0)="^^3^3^3090225^"
^XWB(8994,2496,1,1,0)="This remote procedure call returns the observation date/time and reading "
^XWB(8994,2496,1,2,0)="of the record closest to the date/time specified for the patient and vital"
^XWB(8994,2496,1,3,0)="type."
^XWB(8994,2496,2,0)="^8994.02A^4^4"
^XWB(8994,2496,2,1,0)="GMVDFN^1^12^1^1"
^XWB(8994,2496,2,1,1,0)="^^1^1^3090225^"
^XWB(8994,2496,2,1,1,1,0)="A pointer to the Patient (#2) file (i.e., DFN)."
^XWB(8994,2496,2,2,0)="GMVDT^1^14^0^2"
^XWB(8994,2496,2,2,1,0)="^8994.021^1^1^3090225^^^"
^XWB(8994,2496,2,2,1,1,0)="The date/time to search from. The default is NOW."
^XWB(8994,2496,2,3,0)="GMVT^1^5^1^3"
^XWB(8994,2496,2,3,1,0)="^8994.021^2^2^3090225^^^"
^XWB(8994,2496,2,3,1,1,0)="The vital type abbreviation as it appears in FILE 120.51, Field 1 (e.g., "
^XWB(8994,2496,2,3,1,2,0)="WT)."
^XWB(8994,2496,2,4,0)="GMVFLAG^1^1^0^4"
^XWB(8994,2496,2,4,1,0)="^8994.021^3^3^3090225^^"
^XWB(8994,2496,2,4,1,1,0)="A flag to indicate if the search should look before or after the date/time"
^XWB(8994,2496,2,4,1,2,0)="specified in the GMVDT value where 1 indicates before, 2 indicates after"
^XWB(8994,2496,2,4,1,3,0)="and 0 indicates either direction."
^XWB(8994,2496,2,"B","GMVDFN",1)=""
^XWB(8994,2496,2,"B","GMVDT",2)=""
^XWB(8994,2496,2,"B","GMVFLAG",4)=""
^XWB(8994,2496,2,"B","GMVT",3)=""
^XWB(8994,2496,2,"PARAMSEQ",1,1)=""
^XWB(8994,2496,2,"PARAMSEQ",2,2)=""
^XWB(8994,2496,2,"PARAMSEQ",3,3)=""
^XWB(8994,2496,2,"PARAMSEQ",4,4)=""
^XWB(8994,2496,3,0)="^8994.03^11^11^3090225^^^"
^XWB(8994,2496,3,1,0)="Returns a string composed of two pieces. The first piece contains the "
^XWB(8994,2496,3,2,0)="observation date/time (FILE 120.5, Field .01) of the record that was "
^XWB(8994,2496,3,3,0)="found. The second piece contains the rate (FILE 120.5, Field 1.2) of the "
^XWB(8994,2496,3,4,0)="record. If there is an error, the first piece will be -1 and the second "
^XWB(8994,2496,3,5,0)="piece will be the error text."
^XWB(8994,2496,3,6,0)=" "
^XWB(8994,2496,3,7,0)=" Example:"
^XWB(8994,2496,3,8,0)=" "
^XWB(8994,2496,3,9,0)=" > S GMVDFN=134,GMVDT=3090225.08,GMVT=""WT"",GMVFLAG=0"
^XWB(8994,2496,3,10,0)=" > D CLOSEST(.TEST,GMVDFN,GMVDT,GMVT,GMVFLAG) ZW TEST"
^XWB(8994,2496,3,11,0)=" > TEST=""3081106.142926^135"""
^XWB(8994,2497,0)="DVBAB DOD REPORT^SENDRPT^DVBABDOD^4^R^^^1"
^XWB(8994,2497,1,0)="^^11^11^3090408^"
^XWB(8994,2497,1,1,0)="This remote procedure call returns a DOD report from the FHIE framework.  "
^XWB(8994,2497,1,2,0)="The RPC is designed specifically for the FHIE VistA server not the local "
^XWB(8994,2497,1,3,0)="VAMC facilities.  It is distributed nationally with the CAPRI application "
^XWB(8994,2497,1,4,0)="to keep the remote procedures and the DVBA CAPRI GUI option consistent on "
^XWB(8994,2497,1,5,0)="all systems using CAPRI.  Please do not use."
^XWB(8994,2497,1,6,0)=" "
^XWB(8994,2497,1,7,0)="Input:  IEN       = Patient's DFN"
^XWB(8994,2497,1,8,0)="        DATATYPE  = Type of data being requested"
^XWB(8994,2497,1,9,0)="        BEGDATE   = Beginning search date"
^XWB(8994,2497,1,10,0)="        ENDDATE   = Ending search date"
^XWB(8994,2497,1,11,0)="        ORMAX     = Max number of entries for report "
^XWB(8994,2497,2,0)="^8994.02A^5^5"
^XWB(8994,2497,2,1,0)="IEN^1"
^XWB(8994,2497,2,2,0)="DATATYPE^1"
^XWB(8994,2497,2,3,0)="BEGDATE^1"
^XWB(8994,2497,2,4,0)="ENDDATE^1"
^XWB(8994,2497,2,5,0)="ORMAX^1"
^XWB(8994,2497,2,"B","BEGDATE",3)=""
^XWB(8994,2497,2,"B","DATATYPE",2)=""
^XWB(8994,2497,2,"B","ENDDATE",4)=""
^XWB(8994,2497,2,"B","IEN",1)=""
^XWB(8994,2497,2,"B","ORMAX",5)=""
^XWB(8994,2498,0)="DVBAB DOD INFO^INFOMSG^DVBABDOD^1^R"
^XWB(8994,2498,1,0)="^^5^5^3090408^"
^XWB(8994,2498,1,1,0)="This remote procedure call returns a message to be displayed in CAPRI.  "
^XWB(8994,2498,1,2,0)="The RPC is designed specifically for the FHIE VistA server not the local "
^XWB(8994,2498,1,3,0)="VAMC facilities.  It is distributed nationally with the CAPRI application "
^XWB(8994,2498,1,4,0)="to keep the remote procedures and the DVBA CAPRI GUI option consistent on "
^XWB(8994,2498,1,5,0)="all systems using CAPRI.  Please do not use."
^XWB(8994,2499,0)="DVBAB FIND DFN BY ICN^ICN^DVBABDOD^4^P^0"
^XWB(8994,2499,1,0)="^^6^6^3090408^"
^XWB(8994,2499,1,1,0)="This remote procedure call returns the patient's DFN associated with the "
^XWB(8994,2499,1,2,0)="ICN passed to the RPC.  The DFN is the internal entry number in the "
^XWB(8994,2499,1,3,0)="Patient (#2) file.  The RPC is designed specifically for the FHIE VistA "
^XWB(8994,2499,1,4,0)="server not the local VAMC facilities.  It is distributed nationally with "
^XWB(8994,2499,1,5,0)="the CAPRI application to keep the remote procedures and the DVBA CAPRI "
^XWB(8994,2499,1,6,0)="GUI option consistent on all systems using CAPRI.  Please do not use."
^XWB(8994,2499,2,0)="^8994.02A^1^1"
^XWB(8994,2499,2,1,0)="ICN^1^^1^1"
^XWB(8994,2499,2,1,1,0)="^^1^1^3020802^"
^XWB(8994,2499,2,1,1,1,0)="INTEGRATION CONTROL NUMBER"
^XWB(8994,2499,2,"B","ICN",1)=""
^XWB(8994,2499,2,"PARAMSEQ",1,1)=""
^XWB(8994,2500,0)="DVBAB DOD REPORT TYPES^RPTTYPS^DVBABDOD^2^R"
^XWB(8994,2500,1,0)="^^5^5^3090408^"
^XWB(8994,2500,1,1,0)="This remote procedure call returns a list of available report types.  The "
^XWB(8994,2500,1,2,0)="RPC is designed specifically for the FHIE VistA server not the local VAMC "
^XWB(8994,2500,1,3,0)="facilities.  It is distributed nationally with the CAPRI application to "
^XWB(8994,2500,1,4,0)="keep the remote procedures and the DVBA CAPRI GUI option consistent on "
^XWB(8994,2500,1,5,0)="all systems using CAPRI.  Please do not use."
^XWB(8994,2501,0)="DVBAB CCOW^CCOW^DVBABFRM^1^S"
^XWB(8994,2501,1,0)="^^6^6^3090512^"
^XWB(8994,2501,1,1,0)="This remote procedure encapsulates the supported calls $$SITE^VASITE"
^XWB(8994,2501,1,2,0)="and $$PROD^XUPROD."
^XWB(8994,2501,1,3,0)=" "
^XWB(8994,2501,1,4,0)="Paramater TYPE"
^XWB(8994,2501,1,5,0)="     1 = Pass back local station number ($$SITE^VASITE)"
^XWB(8994,2501,1,6,0)="     2 = Pass back whether production account or not ($$PROD^XUPROD)"
^XWB(8994,2501,2,0)="^8994.02A^2^2"
^XWB(8994,2501,2,1,0)="INFOTYPE^1^^1"
^XWB(8994,2501,2,2,0)="TYPE"
^XWB(8994,2501,2,"B","INFOTYPE",1)=""
^XWB(8994,2501,2,"B","TYPE",2)=""
^XWB(8994,2502,0)="DVBAB RESTRICTED LIST PATIENTS^RSTLIST^DVBABFRM^4"
^XWB(8994,2502,1,0)="^^1^1^3090109^"
^XWB(8994,2502,1,1,0)="Returns a list of restricted patients for CAPRI when in remote mode."
^XWB(8994,2502,2,0)="^8994.02A^1^1"
^XWB(8994,2502,2,1,0)="DUZ^1"
^XWB(8994,2502,2,"B","DUZ",1)=""
^XWB(8994,2503,0)="DENTV MONITOR QUEUE^QUE^DENTVM1^1^A"
^XWB(8994,2503,1,0)="^^1^1^3090223^"
^XWB(8994,2503,1,1,0)="Queues a TaskMan job to run patient dental (e.g.) Fluoride, Monitor(s)."
^XWB(8994,2503,2,0)="^8994.02A^1^1"
^XWB(8994,2503,2,1,0)="DFN^1^20^1^1"
^XWB(8994,2503,2,1,1,0)="^^1^1^3090223^"
^XWB(8994,2503,2,1,1,1,0)="Contains the patient pointer (DFN)."
^XWB(8994,2503,2,"B","DFN",1)=""
^XWB(8994,2503,2,"PARAMSEQ",1,1)=""
^XWB(8994,2503,3,0)="^^8^8^3090223^"
^XWB(8994,2503,3,1,0)="Returns -1^error message or Fluoride monitor value^other monitor (if we"
^XWB(8994,2503,3,2,0)="add this).  The Fluoride Monitor value will be this:"
^XWB(8994,2503,3,3,0)="  fluoride monitor = 0 (in process), "
^XWB(8994,2503,3,4,0)="                   = 1 (no flag) "
^XWB(8994,2503,3,5,0)="                   = 2 (flag)"
^XWB(8994,2503,3,6,0)="  If the monitor=2 then must call DENTV MONITOR POLL to get the details."
^XWB(8994,2503,3,7,0)="The monitor is only valid or dental class I, IIC and IV.  All others (or "
^XWB(8994,2503,3,8,0)="null class) will return an error: -1^invalid or unknown patient class."
^XWB(8994,2504,0)="DENTV MONITOR POLL^POLL^DENTVM1^2^A"
^XWB(8994,2504,1,0)="^^2^2^3090223^"
^XWB(8994,2504,1,1,0)="See if the monitor background job has finished and if so, get the"
^XWB(8994,2504,1,2,0)="results from the DENTAL PATIENT (#220) file."
^XWB(8994,2504,2,0)="^8994.02A^1^1"
^XWB(8994,2504,2,1,0)="DFN^1^20^1^1"
^XWB(8994,2504,2,1,1,0)="^^1^1^3090223^"
^XWB(8994,2504,2,1,1,1,0)="Contains the patient pointer (DFN)."
^XWB(8994,2504,2,"B","DFN",1)=""
^XWB(8994,2504,2,"PARAMSEQ",1,1)=""
^XWB(8994,2504,3,0)="^^5^5^3090223^"
^XWB(8994,2504,3,1,0)="Returns -1^error message or array with Fluoride Monitor in the following "
^XWB(8994,2504,3,2,0)="format:"
^XWB(8994,2504,3,3,0)="  results(1)=fluoride monitor value^other monitor (future enhancement)"
^XWB(8994,2504,3,4,0)="  results(2)=F$1st ien^first code^date^2nd ien^second code^date"
^XWB(8994,2504,3,5,0)="  results(n)=other monitor data (future)"
^XWB(8994,2505,0)="MAG DICOM CHECK AE TITLE^AETITLE^MAGVRS52^2^R^0^^0^4"
^XWB(8994,2505,1,0)="^^17^17^3120208"
^XWB(8994,2505,1,1,0)=" +---------------------------------------------------------------+"
^XWB(8994,2505,1,2,0)=" | Property of the US Government.                                |"
^XWB(8994,2505,1,3,0)=" | No permission to copy or redistribute this software is given. |"
^XWB(8994,2505,1,4,0)=" | Use of unreleased versions of this software requires the user |"
^XWB(8994,2505,1,5,0)=" | to execute a written test agreement with the VistA Imaging    |"
^XWB(8994,2505,1,6,0)=" | Development Office of the Department of Veterans Affairs,     |"
^XWB(8994,2505,1,7,0)=" | telephone (301) 734-0100.                                     |"
^XWB(8994,2505,1,8,0)=" |                                                               |"
^XWB(8994,2505,1,9,0)=" | The Food and Drug Administration classifies this software as  |"
^XWB(8994,2505,1,10,0)=" | a medical device.  As such, it may not be changed in any way. |"
^XWB(8994,2505,1,11,0)=" | Modifications to this software may result in an adulterated   |"
^XWB(8994,2505,1,12,0)=" | medical device under 21CFR820, the use of which is considered |"
^XWB(8994,2505,1,13,0)=" | to be a violation of US Federal Statutes.                     |"
^XWB(8994,2505,1,14,0)=" +---------------------------------------------------------------+"
^XWB(8994,2505,1,15,0)=" "
^XWB(8994,2505,1,16,0)="This Remote Procedure checks whether an Application Entity"
^XWB(8994,2505,1,17,0)="is specified on a DICOM Gateway that has the specified name."
^XWB(8994,2505,2,0)="^8994.02A^^-2"
^XWB(8994,2505,2,1,0)="TITLE^1^16^1^1"
^XWB(8994,2505,2,1,1,0)="^8994.021^4^4^3111010^^^^"
^XWB(8994,2505,2,1,1,1,0)="The value of this parameter is a string. This string is"
^XWB(8994,2505,2,1,1,2,0)="constrained by the definition in the DICOM Standard"
^XWB(8994,2505,2,1,1,3,0)="for the ""title"" of an Application Entity, that is: non-empty"
^XWB(8994,2505,2,1,1,4,0)="and at most 16 characters in length."
^XWB(8994,2505,2,2,0)="SERVICE^1^20^1^2"
^XWB(8994,2505,2,2,1,0)="^8994.021^5^5^3080327^^^^"
^XWB(8994,2505,2,2,1,1,0)="The value of this parameter is a string. This string"
^XWB(8994,2505,2,2,1,2,0)="identifies a DICOM DIMSE Service."
^XWB(8994,2505,2,2,1,3,0)="The procedure will validate that the specified Application"
^XWB(8994,2505,2,2,1,4,0)="Entity is permitted to perform the service specified in"
^XWB(8994,2505,2,2,1,5,0)="this parameter."
^XWB(8994,2505,2,3,0)="ROLE^1^3^1^3"
^XWB(8994,2505,2,3,1,0)="^8994.021^5^5^3080327^^^^"
^XWB(8994,2505,2,3,1,1,0)="The value of this parameter is a string. This string should"
^XWB(8994,2505,2,3,1,2,0)="be equal to either ""SCU"" (Service Class User) or"
^XWB(8994,2505,2,3,1,3,0)="""SCP"" (Service Class Provider)."
^XWB(8994,2505,2,3,1,4,0)="The procedure will validate that the specified Application"
^XWB(8994,2505,2,3,1,5,0)="Entity is permitted to operate in the specified role."
^XWB(8994,2505,2,4,0)="LOCATION^1^6^1^2"
^XWB(8994,2505,2,4,1,0)="^8994.021^3^3^3120203^^^^"
^XWB(8994,2505,2,4,1,1,0)="The value of this parameter is a string."
^XWB(8994,2505,2,4,1,2,0)="  This string should be equal to a value from the INSTITUTION File (#4)."
^XWB(8994,2505,2,4,1,3,0)="  This is needed to return the appropriate AETitle."
^XWB(8994,2505,2,"B","LOCATION",4)=""
^XWB(8994,2505,2,"B","ROLE",3)=""
^XWB(8994,2505,2,"B","SERVICE",2)=""
^XWB(8994,2505,2,"B","TITLE",1)=""
^XWB(8994,2505,2,"PARAMSEQ",1,1)=""
^XWB(8994,2505,2,"PARAMSEQ",2,2)=""
^XWB(8994,2505,2,"PARAMSEQ",2,4)=""
^XWB(8994,2505,2,"PARAMSEQ",3,3)=""
^XWB(8994,2505,2,"PARAMSEQ",4,4)=""
^XWB(8994,2505,3,0)="^8994.03^6^6^3120203^^^^"
^XWB(8994,2505,3,1,0)="The return parameter is an array. When the supplied title is"
^XWB(8994,2505,3,2,0)="valid, the first element of the return array will be a ""0"" followed by"
^XWB(8994,2505,3,3,0)="the AE NAME, REMOTE AE TITLE, LOCAL AE TITLE, LOCATION, IP ADDRESS, PORT NUMBER, a list of the associated DICOM SERVICES and DICOM ROLES."
^XWB(8994,2505,3,4,0)=" "
^XWB(8994,2505,3,5,0)="When the supplied title is not found or the inputs are invalid,"
^XWB(8994,2505,3,6,0)="a negative integer error code and an error message will be returned in the first element of the array."
^XWB(8994,2505,3,7,0)="only one element, which can have the values:"
^XWB(8994,2505,3,8,0)="   -1,No AE Title specified"
^XWB(8994,2505,3,9,0)="   -2,No entry for AE Title ""xxx""."
^XWB(8994,2506,0)="MAG DICOM GET GATEWAY INFO^GETINFO^MAGDQR05^2^R^0^^0^3"
^XWB(8994,2506,1,0)="^^2^2^3060215^"
^XWB(8994,2506,1,1,0)="This Remote Procedure returns information about a"
^XWB(8994,2506,1,2,0)="DICOM Gateway."
^XWB(8994,2506,2,0)="^8994.02A^1^1"
^XWB(8994,2506,2,1,0)="HOSTNAME^1^30^1^1"
^XWB(8994,2506,2,1,1,0)="^^4^4^3060215^"
^XWB(8994,2506,2,1,1,1,0)="The value of this parameter is a string."
^XWB(8994,2506,2,1,1,2,0)="This string must be the ""hostname"" of the computer that is"
^XWB(8994,2506,2,1,1,3,0)="being used to operate the DICOM Gateway for which information"
^XWB(8994,2506,2,1,1,4,0)="is to be returned."
^XWB(8994,2506,2,"B","HOSTNAME",1)=""
^XWB(8994,2506,2,"PARAMSEQ",1,1)=""
^XWB(8994,2506,3,0)="^^13^13^3060215^"
^XWB(8994,2506,3,1,0)="The return information for this Remote Procedure is returned"
^XWB(8994,2506,3,2,0)="as an array."
^XWB(8994,2506,3,3,0)=" "
^XWB(8994,2506,3,4,0)="When there is an error in the operation of this procedure,"
^XWB(8994,2506,3,5,0)="the array will contain only one entry that describes the error,"
^XWB(8994,2506,3,6,0)="e.g.:"
^XWB(8994,2506,3,7,0)="   -1,No HostName provided."
^XWB(8994,2506,3,8,0)="   -2,Cannot find info for ""xxx""."
^XWB(8994,2506,3,9,0)=" "
^XWB(8994,2506,3,10,0)="When there is information to be returned, the first array element"
^XWB(8994,2506,3,11,0)="will indicate the number of valid entries in the result-array,"
^XWB(8994,2506,3,12,0)="and the further elements will contain data in the form of"
^XWB(8994,2506,3,13,0)="   keyword=value"
^XWB(8994,2507,0)="MAG DICOM GET MACHINE ID^GETID^MAGDRPC1^1^R^0^^0^3"
^XWB(8994,2507,1,0)="^8994.01^18^18^3060711^"
^XWB(8994,2507,1,1,0)=" +---------------------------------------------------------------+"
^XWB(8994,2507,1,2,0)=" | Property of the US Government.                                |"
^XWB(8994,2507,1,3,0)=" | No permission to copy or redistribute this software is given. |"
^XWB(8994,2507,1,4,0)=" | Use of unreleased versions of this software requires the user |"
^XWB(8994,2507,1,5,0)=" | to execute a written test agreement with the VistA Imaging    |"
^XWB(8994,2507,1,6,0)=" | Development Office of the Department of Veterans Affairs,     |"
^XWB(8994,2507,1,7,0)=" | telephone (301) 734-0100.                                     |"
^XWB(8994,2507,1,8,0)=" |                                                               |"
^XWB(8994,2507,1,9,0)=" | The Food and Drug Administration classifies this software as  |"
^XWB(8994,2507,1,10,0)=" | a medical device.  As such, it may not be changed in any way. |"
^XWB(8994,2507,1,11,0)=" | Modifications to this software may result in an adulterated   |"
^XWB(8994,2507,1,12,0)=" | medical device under 21CFR820, the use of which is considered |"
^XWB(8994,2507,1,13,0)=" | to be a violation of US Federal Statutes.                     |"
^XWB(8994,2507,1,14,0)=" +---------------------------------------------------------------+"
^XWB(8994,2507,1,15,0)=" "
^XWB(8994,2507,1,16,0)="This Remote Procedure returns the internal entry number of"
^XWB(8994,2507,1,17,0)="the entry for the specified computer in the table of registered"
^XWB(8994,2507,1,18,0)="DICOM Gateways."
^XWB(8994,2507,2,0)="^8994.02A^1^1"
^XWB(8994,2507,2,1,0)="HOSTNAME^1^30^1^1"
^XWB(8994,2507,2,1,1,0)="^^5^5^3060711^"
^XWB(8994,2507,2,1,1,1,0)="The value of this parameter is a string. This string is the"
^XWB(8994,2507,2,1,1,2,0)="""host name"" of a computer. Many sites follow the standard"
^XWB(8994,2507,2,1,1,3,0)="to use names like VHAxxxabcde, where xxx is a three-letter"
^XWB(8994,2507,2,1,1,4,0)="abbreviation for the name of the site, and abcde is the"
^XWB(8994,2507,2,1,1,5,0)="actual name of the computer."
^XWB(8994,2507,2,"B","HOSTNAME",1)=""
^XWB(8994,2507,2,"PARAMSEQ",1,1)=""
^XWB(8994,2507,3,0)="^^11^11^3060711^"
^XWB(8994,2507,3,1,0)="The value of the return parameter is a string."
^XWB(8994,2507,3,2,0)="When the numeric interpretation of this string is a negative"
^XWB(8994,2507,3,3,0)="number, the value indicates an error condition, e.g.:"
^XWB(8994,2507,3,4,0)="   -1,No Hostname Specified"
^XWB(8994,2507,3,5,0)=" "
^XWB(8994,2507,3,6,0)="When the value of the return parameter is a positive number,"
^XWB(8994,2507,3,7,0)="this number is the internal entry number for the entry"
^XWB(8994,2507,3,8,0)="in the table of registered DICOM Gateways (#2006.5641)."
^XWB(8994,2507,3,9,0)=" "
^XWB(8994,2507,3,10,0)="When no entry exists for the specified computer, this RPC"
^XWB(8994,2507,3,11,0)="will create a new entry."
^XWB(8994,2508,0)="MAG DICOM GET UID ROOT^UIDROOT^MAGDRPC9^1^R^0^^0^3"
^XWB(8994,2508,1,0)="^8994.01^20^20^3061115^^"
^XWB(8994,2508,1,1,0)=" +---------------------------------------------------------------+"
^XWB(8994,2508,1,2,0)=" | Property of the US Government.                                |"
^XWB(8994,2508,1,3,0)=" | No permission to copy or redistribute this software is given. |"
^XWB(8994,2508,1,4,0)=" | Use of unreleased versions of this software requires the user |"
^XWB(8994,2508,1,5,0)=" | to execute a written test agreement with the VistA Imaging    |"
^XWB(8994,2508,1,6,0)=" | Development Office of the Department of Veterans Affairs,     |"
^XWB(8994,2508,1,7,0)=" | telephone (301) 734-0100.                                     |"
^XWB(8994,2508,1,8,0)=" |                                                               |"
^XWB(8994,2508,1,9,0)=" | The Food and Drug Administration classifies this software as  |"
^XWB(8994,2508,1,10,0)=" | a medical device.  As such, it may not be changed in any way. |"
^XWB(8994,2508,1,11,0)=" | Modifications to this software may result in an adulterated   |"
^XWB(8994,2508,1,12,0)=" | medical device under 21CFR820, the use of which is considered |"
^XWB(8994,2508,1,13,0)=" | to be a violation of US Federal Statutes.                     |"
^XWB(8994,2508,1,14,0)=" +---------------------------------------------------------------+"
^XWB(8994,2508,1,15,0)=" "
^XWB(8994,2508,1,16,0)="This Remote Procedure returns the value of the DICOM root UID"
^XWB(8994,2508,1,17,0)="that is to be prefixed to all UIDs that are generated on this system"
^XWB(8994,2508,1,18,0)="and its client systems."
^XWB(8994,2508,1,19,0)=" "
^XWB(8994,2508,1,20,0)="The format and meaning of a DICOM UID is specified in the DICOM Standard."
^XWB(8994,2508,3,0)="^^3^3^3061115^"
^XWB(8994,2508,3,1,0)="The return value of this Remote Procedure is a string."
^XWB(8994,2508,3,2,0)="This string is a series of digits and periods that meets the definition"
^XWB(8994,2508,3,3,0)="of an UID as specified in the DICOM standard."
^XWB(8994,2509,0)="MAG DICOM GET UID TABLE^SERVER^MAGDUID3^2^R^^^^3"
^XWB(8994,2509,1,0)="^8994.01^17^17^3071003^^"
^XWB(8994,2509,1,1,0)=" +---------------------------------------------------------------+"
^XWB(8994,2509,1,2,0)=" | Property of the US Government.                                |"
^XWB(8994,2509,1,3,0)=" | No permission to copy or redistribute this software is given. |"
^XWB(8994,2509,1,4,0)=" | Use of unreleased versions of this software requires the user |"
^XWB(8994,2509,1,5,0)=" | to execute a written test agreement with the VistA Imaging    |"
^XWB(8994,2509,1,6,0)=" | Development Office of the Department of Veterans Affairs,     |"
^XWB(8994,2509,1,7,0)=" | telephone (301) 734-0100.                                     |"
^XWB(8994,2509,1,8,0)=" |                                                               |"
^XWB(8994,2509,1,9,0)=" | The Food and Drug Administration classifies this software as  |"
^XWB(8994,2509,1,10,0)=" | a medical device.  As such, it may not be changed in any way. |"
^XWB(8994,2509,1,11,0)=" | Modifications to this software may result in an adulterated   |"
^XWB(8994,2509,1,12,0)=" | medical device under 21CFR820, the use of which is considered |"
^XWB(8994,2509,1,13,0)=" | to be a violation of US Federal Statutes.                     |"
^XWB(8994,2509,1,14,0)=" +---------------------------------------------------------------+"
^XWB(8994,2509,1,15,0)=" "
^XWB(8994,2509,1,16,0)="This Remote Procedure transmits the current content of the"
^XWB(8994,2509,1,17,0)="UID table from VistA to the DICOM Gateways."
^XWB(8994,2509,2,0)="^8994.02A^2^2"
^XWB(8994,2509,2,1,0)="OFFSET^1^100^1^2"
^XWB(8994,2509,2,1,1,0)="^^9^9^3071001^"
^XWB(8994,2509,2,1,1,1,0)="The value of this parameter is a string."
^XWB(8994,2509,2,1,1,2,0)=" "
^XWB(8994,2509,2,1,1,3,0)="The first time this Remote Procedure is called for a certain"
^XWB(8994,2509,2,1,1,4,0)="""master file"", the value of this parameter must be empty."
^XWB(8994,2509,2,1,1,5,0)=" "
^XWB(8994,2509,2,1,1,6,0)="Each next time this Remote Procedure is called for the same"
^XWB(8994,2509,2,1,1,7,0)="""master file"", the value of this parameter must be copied from"
^XWB(8994,2509,2,1,1,8,0)="the return array, so that the Remote Procedure will continue"
^XWB(8994,2509,2,1,1,9,0)="where it left off in the previous call."
^XWB(8994,2509,2,2,0)="MAX^1^15^1^3"
^XWB(8994,2509,2,2,1,0)="^8994.021^3^3^3071003^^"
^XWB(8994,2509,2,2,1,1,0)="The value of this parameter is a positive integer number."
^XWB(8994,2509,2,2,1,2,0)="This value indicates the maximum number of values that may be"
^XWB(8994,2509,2,2,1,3,0)="returned in each call to this Remote Procedure."
^XWB(8994,2509,2,"B","MAX",2)=""
^XWB(8994,2509,2,"B","OFFSET",1)=""
^XWB(8994,2509,2,"PARAMSEQ",1,1)=""
^XWB(8994,2509,2,"PARAMSEQ",2,1)=""
^XWB(8994,2509,2,"PARAMSEQ",2,2)=""
^XWB(8994,2509,2,"PARAMSEQ",3,2)=""
^XWB(8994,2509,3,0)="^8994.03^10^10^3071003^^"
^XWB(8994,2509,3,1,0)="The return parameter for this Remote Procedure is an array."
^XWB(8994,2509,3,2,0)=" "
^XWB(8994,2509,3,3,0)="The first element of this array is either a positive"
^XWB(8994,2509,3,4,0)="integer number that indicates the number of elements that follow,"
^XWB(8994,2509,3,5,0)="or a negative number that indicates an error condition."
^XWB(8994,2509,3,6,0)=" "
^XWB(8994,2509,3,7,0)="The subsequent elements of this array are organized in pairs."
^XWB(8994,2509,3,8,0)="The first element of each pair is a reference to a global variable."
^XWB(8994,2509,3,9,0)="The second element of each pair is the value that is to be stored"
^XWB(8994,2509,3,10,0)="in that global variable."
^XWB(8994,2510,0)="MAG DICOM STORE GATEWAY INFO^GWINFO^MAGDQR05^1^R^0^^0^4"
^XWB(8994,2510,1,0)="^8994.01^2^2^3060216^^"
^XWB(8994,2510,1,1,0)="This Remote Procedure stores information about a DICOM Gateway"
^XWB(8994,2510,1,2,0)="in the VistA system."
^XWB(8994,2510,2,0)="^8994.02A^5^4"
^XWB(8994,2510,2,1,0)="HOSTNAME^1^30^1^1"
^XWB(8994,2510,2,1,1,0)="^8994.021^4^4^3080327^^"
^XWB(8994,2510,2,1,1,1,0)="The value of this parameter is a string."
^XWB(8994,2510,2,1,1,2,0)="This value must be the ""hostname"" of a computer that is being"
^XWB(8994,2510,2,1,1,3,0)="used to operate the DICOM Gateway for which the information"
^XWB(8994,2510,2,1,1,4,0)="is being stored."
^XWB(8994,2510,2,3,0)="LOCATION^1^10^1^2"
^XWB(8994,2510,2,3,1,0)="^8994.021^3^3^3080327^^^"
^XWB(8994,2510,2,3,1,1,0)="The value of this parameter is a pointer to the Institution file (#4)."
^XWB(8994,2510,2,3,1,2,0)="The location being pointed to is the one for which the DICOM Gateway"
^XWB(8994,2510,2,3,1,3,0)="operates."
^XWB(8994,2510,2,4,0)="FILES^2^32000^1^3"
^XWB(8994,2510,2,4,1,0)="^8994.021^5^5^3080327^^^"
^XWB(8994,2510,2,4,1,1,0)="This parameter is an array."
^XWB(8994,2510,2,4,1,2,0)="The entries in this array contain information about files"
^XWB(8994,2510,2,4,1,3,0)="on the DICOM Gateway."
^XWB(8994,2510,2,4,1,4,0)="For each file, a timestamp (most recent modification) and"
^XWB(8994,2510,2,4,1,5,0)="the full path+file name is included."
^XWB(8994,2510,2,5,0)="VERSION^2^32000^1^4"
^XWB(8994,2510,2,5,1,0)="^8994.021^6^6^3080327^^^^"
^XWB(8994,2510,2,5,1,1,0)="This parameter is an array."
^XWB(8994,2510,2,5,1,2,0)="The entries in this array contain information about the"
^XWB(8994,2510,2,5,1,3,0)="version stamps of the various executables in the DICOM"
^XWB(8994,2510,2,5,1,4,0)="Gateway application."
^XWB(8994,2510,2,5,1,5,0)="For each component, a timestamp (most recent modification)"
^XWB(8994,2510,2,5,1,6,0)="and the full path+file name is included."
^XWB(8994,2510,2,"B","FILES",4)=""
^XWB(8994,2510,2,"B","HOSTNAME",1)=""
^XWB(8994,2510,2,"B","LOCATION",3)=""
^XWB(8994,2510,2,"B","VERSION",5)=""
^XWB(8994,2510,2,"PARAMSEQ",1,1)=""
^XWB(8994,2510,2,"PARAMSEQ",2,3)=""
^XWB(8994,2510,2,"PARAMSEQ",3,4)=""
^XWB(8994,2510,2,"PARAMSEQ",4,5)=""
^XWB(8994,2510,3,0)="^8994.03^6^6^3060216^^"
^XWB(8994,2510,3,1,0)="The return value for this procedure is a single value."
^XWB(8994,2510,3,2,0)="This value is either 0 (successful completion) or a negative"
^XWB(8994,2510,3,3,0)="number indication an error, such as:"
^XWB(8994,2510,3,4,0)="   -1,No HostName provided."
^XWB(8994,2510,3,5,0)="   -2,No Machine ID provided."
^XWB(8994,2510,3,6,0)="   -3,No location provided."
^XWB(8994,2511,0)="MAG DICOM VISTA AE TITLE^VATITLE^MAGVRS52^1^R^0^^0^3"
^XWB(8994,2511,1,0)="^8994.01^3^3^3111102^^"
^XWB(8994,2511,1,1,0)="This Remote Procedure returns a string that can be used"
^XWB(8994,2511,1,2,0)="as a DICOM Application Entity title for the purpose"
^XWB(8994,2511,1,3,0)="established by the parameters to this procedure."
^XWB(8994,2511,2,0)="^8994.02A^3^3"
^XWB(8994,2511,2,1,0)="SERVICE^1^20^1^1"
^XWB(8994,2511,2,1,1,0)="^^5^5^3051115^"
^XWB(8994,2511,2,1,1,1,0)="The value of this parameter is a string. This string"
^XWB(8994,2511,2,1,1,2,0)="identifies a DICOM DIMSE Service."
^XWB(8994,2511,2,1,1,3,0)="The procedure will validate that the specified Application"
^XWB(8994,2511,2,1,1,4,0)="Entity is permitted to perform the service specified in"
^XWB(8994,2511,2,1,1,5,0)="this parameter."
^XWB(8994,2511,2,2,0)="ROLE^1^3^1^2"
^XWB(8994,2511,2,2,1,0)="^8994.021^5^5^3080327^^^"
^XWB(8994,2511,2,2,1,1,0)="The value of this parameter is a string. This string should"
^XWB(8994,2511,2,2,1,2,0)="be equal to either ""SCU"" (Service Class User) or"
^XWB(8994,2511,2,2,1,3,0)="""SCP"" (Service Class Provider)."
^XWB(8994,2511,2,2,1,4,0)="The procedure will validate that the specified Application"
^XWB(8994,2511,2,2,1,5,0)="Entity is permitted to operate in the specified role."
^XWB(8994,2511,2,3,0)="LOCATION^1^6^1^3"
^XWB(8994,2511,2,3,1,0)="^8994.021^4^4^3111102^^"
^XWB(8994,2511,2,3,1,1,0)="The value of this parameter is a string.  This string is compared to"
^XWB(8994,2511,2,3,1,2,0)="the appropriate value in the INSTITUTION File (#4)."
^XWB(8994,2511,2,3,1,3,0)="This is needed to return the appropriate AETitle that represents a"
^XWB(8994,2511,2,3,1,4,0)="specific division."
^XWB(8994,2511,2,"B","LOCATION",3)=""
^XWB(8994,2511,2,"B","ROLE",2)=""
^XWB(8994,2511,2,"B","SERVICE",1)=""
