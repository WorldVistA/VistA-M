^XWB(8994,3002,3,17,0)="  16 ""ADDRESS STATE"""
^XWB(8994,3002,3,18,0)="  17 ""ADDRESS ZIP"""
^XWB(8994,3002,3,19,0)="  18 ""ADDRESS COUNTY"""
