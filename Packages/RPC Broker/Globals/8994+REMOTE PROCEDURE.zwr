^XWB(8994,4071,0)="DSIYUT01 XREFBREC SCH UP DOWN^XREFBREC^DSIYUT01^4^^^^1"
^XWB(8994,4071,1,0)="^^8^8^3140904^"
^XWB(8994,4071,1,1,0)="XREFBREC"
^XWB(8994,4071,1,2,0)=" "
^XWB(8994,4071,1,3,0)="Generic search to search through XREF B of the global specified."
^XWB(8994,4071,1,4,0)=" "
^XWB(8994,4071,1,5,0)="This search works with the component which supplies a ""~"" on the first "
^XWB(8994,4071,1,6,0)="search and no ""~"" on subsequent searches.  "
^XWB(8994,4071,1,7,0)=" "
^XWB(8994,4071,1,8,0)="This search accommodates rolling up/down through the data"
^XWB(8994,4071,2,0)="^8994.02A^5^5"
^XWB(8994,4071,2,1,0)="MOVE^1^2^0^1"
^XWB(8994,4071,2,1,1,0)="^^4^4^3140904^"
^XWB(8994,4071,2,1,1,1,0)="MOVE"
^XWB(8994,4071,2,1,1,2,0)=" "
^XWB(8994,4071,2,1,1,3,0)="1 or Blank:  Move forward through file"
^XWB(8994,4071,2,1,1,4,0)="-1           Move backward through file"
^XWB(8994,4071,2,2,0)="NOREC^1^4^0^2"
^XWB(8994,4071,2,2,1,0)="^^3^3^3140904^"
^XWB(8994,4071,2,2,1,1,0)="NOREC"
^XWB(8994,4071,2,2,1,2,0)=" "
^XWB(8994,4071,2,2,1,3,0)="Number of records to return for each call, default is 1000"
^XWB(8994,4071,2,3,0)="SCHTERM^1^30^0^3"
^XWB(8994,4071,2,3,1,0)="^^12^12^3140904^"
^XWB(8994,4071,2,3,1,1,0)="SCHTERM"
^XWB(8994,4071,2,3,1,2,0)=" "
^XWB(8994,4071,2,3,1,3,0)="Starting search term."
^XWB(8994,4071,2,3,1,4,0)=" "
^XWB(8994,4071,2,3,1,5,0)="For first search, it is assumed the component will provide the seed of "
^XWB(8994,4071,2,3,1,6,0)="the search (i.e., if searching for ABC, the component supplies ""AB~"")"
^XWB(8994,4071,2,3,1,7,0)=" "
^XWB(8994,4071,2,3,1,8,0)="For subsequent searches, it is assumed that:"
^XWB(8994,4071,2,3,1,9,0)=" - For a forward search, the GUI supplies the last record (second piece "
^XWB(8994,4071,2,3,1,10,0)="of the return)"
^XWB(8994,4071,2,3,1,11,0)=" - For a backward search, the GUI supplies the first record (second piece "
^XWB(8994,4071,2,3,1,12,0)="of the return)"
