^XWB(8994,5173,0)="ORIRPC GETPANELS^GETPANELS^ORIRPC^4^A^^^0"
^XWB(8994,5173,1,0)="^^5^5^3260115^"
^XWB(8994,5173,1,1,0)="This RPC is called when a patient is selected. It will evaluate the "
^XWB(8994,5173,1,2,0)="patient against the Information Panel definition and return the final "
^XWB(8994,5173,1,3,0)="evaluation results. The response will include information on where and "
^XWB(8994,5173,1,4,0)="how the Information Panel should be displayed, as well as which InfoPanel "
^XWB(8994,5173,1,5,0)="buttons are shown for the patient."
^XWB(8994,5173,2,0)="^8994.02A^1^1"
^XWB(8994,5173,2,1,0)="IJSON^1^^1^1"
^XWB(8994,5173,2,1,1,0)="^^9^9^3260115^"
^XWB(8994,5173,2,1,1,1,0)="The RPC accepts a JSON packet as input:"
^XWB(8994,5173,2,1,1,2,0)=" {"
^XWB(8994,5173,2,1,1,3,0)="    ""patientId"": ""100281"","
^XWB(8994,5173,2,1,1,4,0)="    ""package"": ""ORDER ENTRY/RESULTS REPORTING"""
^XWB(8994,5173,2,1,1,5,0)=" }"
^XWB(8994,5173,2,1,1,6,0)="  "
^XWB(8994,5173,2,1,1,7,0)="patientId: is the patient DFN from file 2.  "
^XWB(8994,5173,2,1,1,8,0)="package: is the name of the package calling the RPC. This is the .01 from "
^XWB(8994,5173,2,1,1,9,0)="file #9.4."
^XWB(8994,5173,2,"B","IJSON",1)=""
^XWB(8994,5173,2,"PARAMSEQ",1,1)=""
^XWB(8994,5173,3,0)="^8994.03^58^58^3250324^^^^"
^XWB(8994,5173,3,1,0)="The return value is in a JSON format describing the different action, "
^XWB(8994,5173,3,2,0)="display values, for each panel on a pane."
^XWB(8994,5173,3,3,0)=" "
^XWB(8994,5173,3,4,0)="{"
^XWB(8994,5173,3,5,0)="    ""infoPanel"": ["
^XWB(8994,5173,3,6,0)="        {"
^XWB(8994,5173,3,7,0)="            ""abbreviation"": ""COVID"","
^XWB(8994,5173,3,8,0)="            ""action"": ""actShowDetail"","
^XWB(8994,5173,3,9,0)="            ""color"": ""clYellow"","
^XWB(8994,5173,3,10,0)="            ""disabled"": false,"
^XWB(8994,5173,3,11,0)="            ""displayText"": ""COVID STATUS UNKNOWN"","
^XWB(8994,5173,3,12,0)="            ""id"": 1,"
^XWB(8994,5173,3,13,0)="            ""name"": ""COVID PANEL"","
^XWB(8994,5173,3,14,0)="            ""popOut"": false,"
^XWB(8994,5173,3,15,0)="            ""requiredData"": ["
^XWB(8994,5173,3,16,0)="                {"
^XWB(8994,5173,3,17,0)="                    ""dataName"": ""dataEncounterProvider"","
^XWB(8994,5173,3,18,0)="                    ""required"": true,"
^XWB(8994,5173,3,19,0)="                    ""returnData"": ["
^XWB(8994,5173,3,20,0)="                        {"
^XWB(8994,5173,3,21,0)="                            ""dataName"": ""id"","
^XWB(8994,5173,3,22,0)="                            ""required"": ""optional"""
^XWB(8994,5173,3,23,0)="                        },"
^XWB(8994,5173,3,24,0)="                        {"
^XWB(8994,5173,3,25,0)="                            ""dataName"": ""name"","
^XWB(8994,5173,3,26,0)="                            ""required"": ""optional"""
^XWB(8994,5173,3,27,0)="                        }"
^XWB(8994,5173,3,28,0)="                    ]"
^XWB(8994,5173,3,29,0)="                },"
^XWB(8994,5173,3,30,0)="                {"
^XWB(8994,5173,3,31,0)="                    ""dataName"": ""dataUserInformation"","
^XWB(8994,5173,3,32,0)="                    ""required"": false,"
^XWB(8994,5173,3,33,0)="                    ""returnData"": ["
