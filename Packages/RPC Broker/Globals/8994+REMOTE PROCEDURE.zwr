^XWB(8994,3975,3,4,0)="DSIYRET(1)=""-1^Error message""      for errors"
^XWB(8994,3975,3,5,0)="DSIYRET(#) = following pieces"
^XWB(8994,3975,3,6,0)="p1:  Data Type  (TX to print Text, BC to print in bar-code font)"
^XWB(8994,3975,3,7,0)="p2:  Data to Print"
^XWB(8994,3976,0)="DSIYTI02 TIEQFAP CHK FAP^TIEQFAP^DSIYTI02^2"
^XWB(8994,3976,1,0)="^8994.01^5^5^3131008^^"
^XWB(8994,3976,1,1,0)="TIEQFAP"
^XWB(8994,3976,1,2,0)=" "
^XWB(8994,3976,1,3,0)="Returns whether a new piece of equipment can be added to a Turn-In "
^XWB(8994,3976,1,4,0)="Request - all equipment within the request has to either be Fixed Asset "
^XWB(8994,3976,1,5,0)="or not, they cannot be mixed."
