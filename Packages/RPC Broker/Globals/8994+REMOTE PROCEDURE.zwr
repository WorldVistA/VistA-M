^XWB(8994,4331,2,17,1,0)="^8994.021^2^2^3150421^^"
^XWB(8994,4331,2,17,1,1,0)="LOT Number - defaults to file 660 field 21 LOT Number; can be deleted; "
^XWB(8994,4331,2,17,1,2,0)="   1-20 characters; cannot contain ""^"""
^XWB(8994,4331,2,18,0)="DSSORMK^1^61^0^18"
^XWB(8994,4331,2,18,1,0)="^8994.021^2^2^3150421^^"
^XWB(8994,4331,2,18,1,1,0)="Remarks - defaults to file 660 field 16 Remarks; can be deleted;"
^XWB(8994,4331,2,18,1,2,0)="  1-20 characters"
^XWB(8994,4331,2,19,0)="DSSOGRP^1^15^0^19"
^XWB(8994,4331,2,19,1,0)="^8994.021^4^4^3150421^^^^"
^XWB(8994,4331,2,19,1,1,0)="AMIS Grouper - value that groups associated stock issues together in file "
^XWB(8994,4331,2,19,1,2,0)="  660;  this value is null for the first item, but for subsequent "
^XWB(8994,4331,2,19,1,3,0)="  associated stock issues, use the value returned in the second ^-piece"
^XWB(8994,4331,2,19,1,4,0)="  of the successful completion message from this RPC."
^XWB(8994,4331,2,20,0)="DSSOCTR^1^30^^20"
^XWB(8994,4331,2,20,1,0)="^8994.021^1^1^3230104^^"
^XWB(8994,4331,2,20,1,1,0)="This is the contract # for the associated Stock Issue."
^XWB(8994,4331,2,21,0)="DSSOMFR^1^80^1^21"
^XWB(8994,4331,2,21,1,0)="^^4^4^3230104^"
^XWB(8994,4331,2,21,1,1,0)="Manufacturer - required - 1-80 characters "
^XWB(8994,4331,2,21,1,2,0)="  The data for this field comes from the ITEM MASTER (#441) field"
^XWB(8994,4331,2,21,1,3,0)="  MANUFACTURER (#25).  If the MANUFACTURER field is not populated, the"
^XWB(8994,4331,2,21,1,4,0)="  user must enter the MANUFACTURER."
^XWB(8994,4331,2,22,0)="DSSOPRT^1^55^1^22"
^XWB(8994,4331,2,22,1,0)="^8994.021^4^4^3230104^^^"
^XWB(8994,4331,2,22,1,1,0)="MFG PART NO. - required - 1-55 characters"
^XWB(8994,4331,2,22,1,2,0)="  The data for this field comes from the ITEM MASTER (#441) field"
^XWB(8994,4331,2,22,1,3,0)="  MFG PART NO. (#19).  If the MFG PART NO. field is not populated, the "
^XWB(8994,4331,2,22,1,4,0)="  user must enter the MFG PART NO.  "
^XWB(8994,4331,2,"B","DSSOCAT",6)=""
^XWB(8994,4331,2,"B","DSSOCPT",10)=""
