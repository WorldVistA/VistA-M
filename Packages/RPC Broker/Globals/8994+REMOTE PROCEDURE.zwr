^XWB(8994,4384,0)="DSSO SUSPENSE AGE CHECK^CHKSUAGE^DSSOSUC^1"
^XWB(8994,4384,1,0)="^^3^3^3180817^"
^XWB(8994,4384,1,1,0)="For the requested PROSTHETIC SUSPENSE (#668) item, this RPC returns an"
^XWB(8994,4384,1,2,0)="indication of the age as well as the number of days since this suspense"
^XWB(8994,4384,1,3,0)="item was created."
^XWB(8994,4384,2,0)="^8994.02A^1^1"
^XWB(8994,4384,2,1,0)="DSSO668^1^15^1^1"
^XWB(8994,4384,2,1,1,0)="^^1^1^3180817^"
