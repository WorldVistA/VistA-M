^XWB(8994,4654,1,14,0)="  +---------------------------------------------------------------+"
^XWB(8994,4654,1,15,0)=" "
^XWB(8994,4654,1,16,0)="This RPC looks up a study in the new SOP Class database using the"
^XWB(8994,4654,1,17,0)="procedure index as the key.  It returns all the information about"
^XWB(8994,4654,1,18,0)="the study, series, SOP instance(s) and image instance(s)."
^XWB(8994,4654,2,0)="^8994.02A^1^1"
^XWB(8994,4654,2,1,0)="PROCIX^1^30^1^1"
^XWB(8994,4654,2,1,1,0)="^^1^1^3210405^"
^XWB(8994,4654,2,1,1,1,0)="This is the IEN of the entry in the IMAGING PROCEDURE REFERENCE file (#2005.61)."
^XWB(8994,4654,2,"B","PROCIX",1)=""
^XWB(8994,4654,2,"PARAMSEQ",1,1)=""
^XWB(8994,4654,3,0)="^^3^3^3210405^"
^XWB(8994,4654,3,1,0)="The output array is a list of all the IMAGE STUDY file (#2005.62), IMAGE SERIES"
^XWB(8994,4654,3,2,0)="file (#2005.63), IMAGE SOP INSTANCE file (#2005.64), IMAGE INSTANCE FILE (#2005.65), ARTIFACT file (#2006.916), and ARTIFACT INSTANCE file (#2006.918)"
^XWB(8994,4654,3,3,0)="entries that are associated with the study."
^XWB(8994,4655,0)="MAG DICOM GET CON SERVICES^SERVICES^MAGDRPCE^2"
^XWB(8994,4655,1,0)="^^2^2^3210419^"
^XWB(8994,4655,1,1,0)="The list of consult services in the CLINICAL SPECIALTY DICOM &"
^XWB(8994,4655,1,2,0)="HL7 file (2006.5831) is returned."
^XWB(8994,4655,3,0)="^^3^3^3220207^"
^XWB(8994,4655,3,1,0)="The return parameter is an array of DICOM-enabled consult services."
^XWB(8994,4655,3,2,0)="Each entry consists of two pieces: Service Name ^ Service Number"
^XWB(8994,4655,3,3,0)="The Service Number is a pointer into the REQUEST SERVICES file (#123.5)."
^XWB(8994,4656,0)="MAG DICOM GET CON BY GMRCIEN^GMRCIEN^MAGDRPCE^1^R"
^XWB(8994,4656,1,0)="^8994.01^16^16^3210709^^^^"
