^XWB(8994,4644,2,1,1,5,0)=" ;(APPTARRAY(5)=            WALKIN - (Y/N)"
^XWB(8994,4644,2,1,1,6,0)=" ;(APPTARRAY(6)=            DESIRED DATE/TIME - ISO FORMAT"
^XWB(8994,4644,2,1,1,7,0)=" ;(APPTARRAY(7)=            EXTERNAL ID - (FREE TEXT 1-50)"
