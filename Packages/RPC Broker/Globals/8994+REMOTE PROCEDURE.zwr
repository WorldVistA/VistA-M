^XWB(8994,4157,2,2,0)="SCHTERM^1^30^0^3"
^XWB(8994,4157,2,2,1,0)="^^1^1^3170516^"
^XWB(8994,4157,2,2,1,1,0)="Starting point for the search, default="""""
^XWB(8994,4157,2,3,0)="EXCLUDE^1^7^0^4"
^XWB(8994,4157,2,3,1,0)="^8994.021^1^1^3170531^^"
^XWB(8994,4157,2,3,1,1,0)="The vendor IEN of the record currently being edited."
