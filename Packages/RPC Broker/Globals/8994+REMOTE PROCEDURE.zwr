^XWB(8994,4933,2,5,1,0)="^^1^1^3251027^"
^XWB(8994,4933,2,5,1,1,0)="Transmission Response Code"
^XWB(8994,4933,2,"B","DVBCT",2)=""
^XWB(8994,4933,2,"B","DVBIEN",1)=""
^XWB(8994,4933,2,"B","DVBNAME",3)=""
^XWB(8994,4933,2,"B","DVBRESP",5)=""
^XWB(8994,4933,2,"B","DVBSTAT",4)=""
