^XWB(8994,4931,3,22,0)="   ""LeftMessage"": ""YES"","
^XWB(8994,4931,3,23,0)="   ""Sequence"": 1,"
^XWB(8994,4931,3,24,0)="   ""Type"": ""CALL"""
^XWB(8994,4931,3,25,0)="  },"
^XWB(8994,4931,3,26,0)=" ..."
^XWB(8994,4931,3,27,0)=" ]"
^XWB(8994,4931,3,28,0)="}"
^XWB(8994,4932,0)="SDES2 ADD CONTACT ATTEMPT^ADDCONTACT^SDES2CONTACTS^2^R^^^^^^1"
^XWB(8994,4932,1,0)="^^11^11^3250212^"
^XWB(8994,4932,1,1,0)=" This RPC serves two functions."
^XWB(8994,4932,1,2,0)=" 1.) If no record exists for the given appointment request, it will create"
^XWB(8994,4932,1,3,0)="     a NEW record in the SDEC CONTACT file (#409.86), and add the first "
^XWB(8994,4932,1,4,0)="     contact attempt to the Date/Time of Contact subfile (#409.863)"
^XWB(8994,4932,1,5,0)=" 2.) If there is already a contact in the SDEC CONTACT file for this "
^XWB(8994,4932,1,6,0)="     appointment request, a new entry will be added to the Date/Time of "
^XWB(8994,4932,1,7,0)="     Contact subfile (#409.863), but will not change any values for the "
^XWB(8994,4932,1,8,0)="     SDEC CONTACT entry (#409.86). The parent record is not editable, only"
^XWB(8994,4932,1,9,0)="     new contact attempts may be added."
^XWB(8994,4932,1,10,0)=" "
^XWB(8994,4932,1,11,0)="Can only be invoked by Acheron"
^XWB(8994,4932,2,0)="^8994.02A^2^2"
^XWB(8994,4932,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,4932,2,1,1,0)="^^10^10^3240618^"
^XWB(8994,4932,2,1,1,1,0)=" SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,4932,2,1,1,2,0)="                           Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,4932,2,1,1,3,0)=" SDCONTEXT(""USER DUZ"")   = The DUZ of the user taking action on the"
^XWB(8994,4932,2,1,1,4,0)="                           calling application. "
^XWB(8994,4932,2,1,1,5,0)=" SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,4932,2,1,1,6,0)="                           calling application."
^XWB(8994,4932,2,1,1,7,0)=" SDCONTEXT(""PATIENT DFN"")= The name of the patient taking action on the"
^XWB(8994,4932,2,1,1,8,0)="                           calling application."
^XWB(8994,4932,2,1,1,9,0)=" SDCONTEXT(""PATIENT ICN"")= The ICN of the patient taking action on the"
^XWB(8994,4932,2,1,1,10,0)="                           calling application."
^XWB(8994,4932,2,2,0)="CONTACT^2^32000^1^2"
^XWB(8994,4932,2,2,1,0)="^8994.021^8^8^3250212^^^^"
^XWB(8994,4932,2,2,1,1,0)="CONTACT(""COMMENTS"") - comments"
^XWB(8994,4932,2,2,1,2,0)="CONTACT(""CONTACTTYPE"") - Contact Type (C - Call, L - Letter, E - Email, T "
^XWB(8994,4932,2,2,1,3,0)="                                         - Text, S - Secure messaging)"
^XWB(8994,4932,2,2,1,4,0)="CONTACT(""DTTMENTERED"") - date/time entered - ISO Format"
^XWB(8994,4932,2,2,1,5,0)="CONTACT(""DTTMOFCONTACT"") - date/time of contact - ISO Format"
^XWB(8994,4932,2,2,1,6,0)="CONTACT(""LEFTMESSAGE"") - left message flag (0 for no, 1 for yes)"
^XWB(8994,4932,2,2,1,7,0)="CONTACT(""REQTYPE"") - Request Type (A,RTC,V,C,P,R)"
^XWB(8994,4932,2,2,1,8,0)="CONTACT(""REQUESTIEN"") - Request IEN"
^XWB(8994,4932,2,"B","CONTACT",2)=""
^XWB(8994,4932,2,"B","SDCONTEXT",1)=""
^XWB(8994,4932,2,"PARAMSEQ",1,1)=""
^XWB(8994,4932,2,"PARAMSEQ",2,2)=""
^XWB(8994,4932,3,0)="^8994.03^27^27^3250212^^^^"
