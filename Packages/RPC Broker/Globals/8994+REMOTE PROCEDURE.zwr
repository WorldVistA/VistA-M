^XWB(8994,3703,2,"PARAMSEQ",7,8)=""
^XWB(8994,3703,3,0)="^8994.03^11^11^3140206^^^"
^XWB(8994,3703,3,1,0)="RETSTA is the return parameter that carries the reference for the result"
^XWB(8994,3703,3,2,0)="stored in ^XTMP. The call result can be an error condition or success."
^XWB(8994,3703,3,3,0)=" "
^XWB(8994,3703,3,4,0)="The format of the data returned is as follows:"
^XWB(8994,3703,3,5,0)=" "
^XWB(8994,3703,3,6,0)="1) when the call is completed without any errors, the result will be"
^XWB(8994,3703,3,7,0)="a message indicating completion of the par level set up for the given "
^XWB(8994,3703,3,8,0)="item and the inventory point name."
^XWB(8994,3703,3,9,0)=" "
^XWB(8994,3703,3,10,0)="2) for an error condition, a message will be sent back to the calling "
^XWB(8994,3703,3,11,0)="application with details of the error."
^XWB(8994,3704,0)="VIAA SET QUANTITY ON HAND^QOH^VIAASQH^4^R^^^1^1^^1"
^XWB(8994,3704,1,0)="^8994.01^3^3^3140206^^^"
^XWB(8994,3704,1,1,0)="This RPC is part of the Real Time Location System (RTLS) and is used by"
^XWB(8994,3704,1,2,0)="WaveMark to set the quantity on-hand for the Cath lab inventory point in "
^XWB(8994,3704,1,3,0)="GIP, a module of IFCAP."
