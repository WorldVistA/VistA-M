^XWB(8994,3089,1,11,0)=" | Modifications to this software may result in an adulterated   |"
^XWB(8994,3089,1,12,0)=" | medical device under 21CFR820, the use of which is considered |"
^XWB(8994,3089,1,13,0)=" | to be a violation of US Federal Statutes.                     |"
^XWB(8994,3089,1,14,0)=" +---------------------------------------------------------------+"
^XWB(8994,3089,1,15,0)=" "
^XWB(8994,3089,1,16,0)="This RPC audits background events such as DICOM Queries.  When auditing "
^XWB(8994,3089,1,17,0)="events executed by other APIs, it may be invoked as a MUMPS API without "
^XWB(8994,3089,1,18,0)="making another call to the RPC Broker."
^XWB(8994,3089,2,0)="^8994.02A^6^4"
^XWB(8994,3089,2,1,0)="EVENT^1^30^1^1"
^XWB(8994,3089,2,1,1,0)="^8994.021^2^2^3110119^^"
^XWB(8994,3089,2,1,1,1,0)="This is the event being audited.  It must be a valid entry on the IMAGING "
^XWB(8994,3089,2,1,1,2,0)="EVENT ACTION File (#2006.931)."
^XWB(8994,3089,2,3,0)="HOSTNAME^1^64^^2"
^XWB(8994,3089,2,3,1,0)="^8994.021^1^1^3120203^^^"
^XWB(8994,3089,2,3,1,1,0)="This is the host name of the host machine whose event is being audited."
^XWB(8994,3089,2,4,0)="APPNAME^1^64^^3"
^XWB(8994,3089,2,4,1,0)="^8994.021^1^1^3120203^^^"
^XWB(8994,3089,2,4,1,1,0)="This is the application name of the application whose event is being audited."
^XWB(8994,3089,2,5,0)="MESSAGE^1^250^^4"
^XWB(8994,3089,2,5,1,0)="^8994.021^1^1^3120203^^^"
^XWB(8994,3089,2,5,1,1,0)="This is the message associated with the audit event."
^XWB(8994,3089,2,6,0)="DATA^2^129^^5"
^XWB(8994,3089,2,6,1,0)="^8994.021^2^2^3120203^^^^"
^XWB(8994,3089,2,6,1,1,0)="This is a list of data attribute names and associated values to be included"
^XWB(8994,3089,2,6,1,2,0)="in the audit event log."
^XWB(8994,3089,2,"B","APPNAME",4)=""
^XWB(8994,3089,2,"B","DATA",6)=""
^XWB(8994,3089,2,"B","EVENT",1)=""
^XWB(8994,3089,2,"B","HOSTNAME",3)=""
^XWB(8994,3089,2,"B","MESSAGE",5)=""
^XWB(8994,3089,2,"PARAMSEQ",1,1)=""
^XWB(8994,3089,2,"PARAMSEQ",2,3)=""
^XWB(8994,3089,2,"PARAMSEQ",3,4)=""
^XWB(8994,3089,2,"PARAMSEQ",4,5)=""
^XWB(8994,3089,2,"PARAMSEQ",5,6)=""
^XWB(8994,3089,3,0)="^8994.03^3^3^3120203^^^^"
^XWB(8994,3089,3,1,0)="This RPC returns an array.  If processing is successful, the array's "
^XWB(8994,3089,3,2,0)="single entry is 0 (false).  Otherwise, an exception has occurred and the "
^XWB(8994,3089,3,3,0)="array will contain an error code and description of the exception."
^XWB(8994,3090,0)="MAG FILEMAN FIELD ATTS^FIELDATT^MAGUFFLA^2^P^0"
^XWB(8994,3090,1,0)="^^2^2^3110924^"
^XWB(8994,3090,1,1,0)="This remote procedure returns a list of attributes and attribute values "
^XWB(8994,3090,1,2,0)="for a field in a FileMan file."
^XWB(8994,3090,2,0)="^8994.02A^2^2"
^XWB(8994,3090,2,1,0)="FILENO^1^20^1^1"
^XWB(8994,3090,2,1,1,0)="^^1^1^3110924^"
^XWB(8994,3090,2,1,1,1,0)="This is the number of a FileMan file or subfile."
^XWB(8994,3090,2,2,0)="FIELDNO^1^20^1^2"
^XWB(8994,3090,2,2,1,0)="^^2^2^3110924^"
^XWB(8994,3090,2,2,1,1,0)="This is the field within the specified FileMan file or subfile for which "
^XWB(8994,3090,2,2,1,2,0)="attributes are being requested."
^XWB(8994,3090,2,"B","FIELDNO",2)=""
^XWB(8994,3090,2,"B","FILENO",1)=""
^XWB(8994,3090,2,"PARAMSEQ",1,1)=""
^XWB(8994,3090,2,"PARAMSEQ",2,2)=""
^XWB(8994,3090,3,0)="^^8^8^3110924^"
^XWB(8994,3090,3,1,0)="This RPC returns an array of values formatted as follows:"
^XWB(8994,3090,3,2,0)=" "
^XWB(8994,3090,3,3,0)="   If no input or processing error:"
^XWB(8994,3090,3,4,0)="          OUT(1) = 0``n where n = number of entries on the OUT() array"
^XWB(8994,3090,3,5,0)="          OUT(m) where 1 < m <= n"
^XWB(8994,3090,3,6,0)="                 = attribute`value"
^XWB(8994,3090,3,7,0)="   If an input or processing error:"
^XWB(8994,3090,3,8,0)="          OUT(1) = n`error_message"
^XWB(8994,3091,0)="MAG FILEMAN FIELD LIST^FIELDLST^MAGUFFLL^2^P^0"
^XWB(8994,3091,1,0)="^8994.01^2^2^3110924^^"
^XWB(8994,3091,1,1,0)="This remote procedure returns a list of fields from a FileMan file or "
^XWB(8994,3091,1,2,0)="subfile in either alpha or numeric order."
^XWB(8994,3091,2,0)="^8994.02A^2^2"
^XWB(8994,3091,2,1,0)="FILENO^1^20^1^1"
^XWB(8994,3091,2,1,1,0)="^^1^1^3110924^"
^XWB(8994,3091,2,1,1,1,0)="This is the number of a FileMan file or subfile."
^XWB(8994,3091,2,2,0)="ORDER^1^1^0^2"
^XWB(8994,3091,2,2,1,0)="^8994.021^2^2^3110924^^^"
^XWB(8994,3091,2,2,1,1,0)="This is the desired return order for the field list:  either A for alpha "
^XWB(8994,3091,2,2,1,2,0)="or N for numeric."
^XWB(8994,3091,2,"B","FILENO",1)=""
^XWB(8994,3091,2,"B","ORDER",2)=""
^XWB(8994,3091,2,"PARAMSEQ",1,1)=""
^XWB(8994,3091,2,"PARAMSEQ",2,2)=""
^XWB(8994,3091,3,0)="^8994.03^7^7^3110924^^"
^XWB(8994,3091,3,1,0)="This RPC returns an array of values formatted as follows:"
^XWB(8994,3091,3,2,0)="   If no input or processing error:"
^XWB(8994,3091,3,3,0)="          OUT(1) = 0``n where n = number of entries on the OUT() array"
^XWB(8994,3091,3,4,0)="          OUT(m) where 1 < m <= n"
^XWB(8994,3091,3,5,0)="                 = field_number`field_name"
^XWB(8994,3091,3,6,0)="   If an input or processing error:"
^XWB(8994,3091,3,7,0)="          OUT(1) = n`error_message"
^XWB(8994,3092,0)="MAGV ADD WORK ITEM TAGS^ADDTAG^MAGVIM01^1^R"
^XWB(8994,3092,1,0)="^8994.01^3^3^3120120^^^^"
^XWB(8994,3092,1,1,0)="This RPC allows tags to be added to work items in the MAG WORK ITEM file (#2006.941)."
^XWB(8994,3092,1,2,0)=" Tags consist of a tag name and a tag value.  Tags and values"
^XWB(8994,3092,1,3,0)="may be used to look up entries in the MAG WORK ITEM file (#2006.941)."
^XWB(8994,3092,2,0)="^8994.02A^7^5"
^XWB(8994,3092,2,3,0)="TAG^2^^^5"
^XWB(8994,3092,2,3,1,0)="^8994.021^2^2^3120120^^^^"
^XWB(8994,3092,2,3,1,1,0)="This is the parameter containing the tag name and the tag value for the"
^XWB(8994,3092,2,3,1,2,0)="work item."
^XWB(8994,3092,2,4,0)="ITEM ID^1^^^1"
^XWB(8994,3092,2,4,1,0)="^8994.021^2^2^3111103^^^^"
^XWB(8994,3092,2,4,1,1,0)="This is the item ID of the entry in the MAG WORK ITEM file (#2006.941) that"
^XWB(8994,3092,2,4,1,2,0)="tags will be added to."
^XWB(8994,3092,2,5,0)="STATUS^1^^^2"
^XWB(8994,3092,2,5,1,0)="^8994.021^3^3^3110524^^^"
^XWB(8994,3092,2,5,1,1,0)="This is a list of expected statuses that the work item may have.  If"
^XWB(8994,3092,2,5,1,2,0)="the work item does not have a status that matches one of the statuses"
^XWB(8994,3092,2,5,1,3,0)="supplied the tag will not be added."
^XWB(8994,3092,2,6,0)="UPDUSR^1^^^3"
^XWB(8994,3092,2,6,1,0)="^^1^1^3120120^"
^XWB(8994,3092,2,6,1,1,0)="This is the user that updated the work item."
^XWB(8994,3092,2,7,0)="UPDAPP^1^^^4"
^XWB(8994,3092,2,7,1,0)="^^1^1^3120120^"
^XWB(8994,3092,2,7,1,1,0)="This is the application that updated the work item."
^XWB(8994,3092,2,"B","ITEM ID",4)=""
^XWB(8994,3092,2,"B","STATUS",5)=""
^XWB(8994,3092,2,"B","TAG",3)=""
^XWB(8994,3092,2,"B","UPDAPP",7)=""
^XWB(8994,3092,2,"B","UPDUSR",6)=""
