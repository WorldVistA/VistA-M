^XWB(8994,4982,1,0)="^^6^6^3250213^"
^XWB(8994,4982,1,1,0)="DISPOSITION and DELETE an entry from the RECALL REMINDERS file (403.5). "
^XWB(8994,4982,1,2,0)="During the deletion of the entry, the new-style xref in 403.5 will "
