^XWB(8994,5129,2,"PARAMSEQ",1,1)=""
^XWB(8994,5129,3,0)="^^2^2^3241015^"
^XWB(8994,5129,3,1,0)="If successful: 1 - Temporary Address Deleted"
^XWB(8994,5129,3,2,0)="or -1 and an error message for failure"
^XWB(8994,5130,0)="DENTV GET TIU PARAMETERS^TIUPAR^DENTVUT1^1^A^^^1"
^XWB(8994,5130,1,0)="^^1^1^3240522^"
^XWB(8994,5130,1,1,0)="This RPC is intended to pull CPRS template preferences for TIU notes."
^XWB(8994,5130,2,0)="^8994.02A^1^1"
^XWB(8994,5130,2,1,0)="DENTPROV^1^35^1^1"
^XWB(8994,5130,2,1,1,0)="^^2^2^3240522^"
^XWB(8994,5130,2,1,1,1,0)="This is the Provider DUZ for which you wish to retrieve TIU note "
^XWB(8994,5130,2,1,1,2,0)="preferences."
^XWB(8994,5130,2,"B","DENTPROV",1)=""
^XWB(8994,5130,2,"PARAMSEQ",1,1)=""
^XWB(8994,5130,3,0)="^^16^16^3240522^"
^XWB(8994,5130,3,1,0)="If successful, the results will be formatted as follows:"
^XWB(8994,5130,3,2,0)=" "
^XWB(8994,5130,3,3,0)="  Result = p1^p2^p3^p4"
^XWB(8994,5130,3,4,0)=" "
^XWB(8994,5130,3,5,0)="    p1 = File #8926 IEN"
^XWB(8994,5130,3,6,0)="    p2 = Highlight (#.21)"
^XWB(8994,5130,3,7,0)="    p3 = Color (#.22)"
^XWB(8994,5130,3,8,0)="    P4 = Location (#.23)"
^XWB(8994,5130,3,9,0)=" "
^XWB(8994,5130,3,10,0)="If the provider does not have an entry in #8926:"
^XWB(8994,5130,3,11,0)=" "
^XWB(8994,5130,3,12,0)="  Result = 0^No preferences were found for provider"
^XWB(8994,5130,3,13,0)=" "
^XWB(8994,5130,3,14,0)="If an error occurred:"
^XWB(8994,5130,3,15,0)=" "
^XWB(8994,5130,3,16,0)="  Result = -1^*error message*"
^XWB(8994,5131,0)="SDES2 REACTIVATE CLINIC 2^REACTIVATECLIN^SDES2REACTTCLIN2^2^R^0^1^^^^1"
^XWB(8994,5131,1,0)="^^5^5^3250320^"
^XWB(8994,5131,1,1,0)="This RPC reactivates a clinic from the HOSPITAL LOCATION (#44) file for "
^XWB(8994,5131,1,2,0)="the IEN passed in. It will remove the leading 'ZZ' from the clinic name if"
^XWB(8994,5131,1,3,0)="it doesn't create a name conflict."
^XWB(8994,5131,1,4,0)=" "
^XWB(8994,5131,1,5,0)="Can only be invoked by Acheron"
^XWB(8994,5131,2,0)="^8994.02A^2^2"
^XWB(8994,5131,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,5131,2,1,1,0)="^8994.021^10^10^3250313^^"
^XWB(8994,5131,2,1,1,1,0)=" SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,5131,2,1,1,2,0)="                           Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5131,2,1,1,3,0)=" SDCONTEXT(""USER DUZ"")   = The DUZ of the user taking action on the"
^XWB(8994,5131,2,1,1,4,0)="                           calling application. "
^XWB(8994,5131,2,1,1,5,0)=" SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,5131,2,1,1,6,0)="                           calling application."
^XWB(8994,5131,2,1,1,7,0)=" SDCONTEXT(""PATIENT DFN"")= The name of the patient taking action on the"
^XWB(8994,5131,2,1,1,8,0)="                           calling application."
^XWB(8994,5131,2,1,1,9,0)=" SDCONTEXT(""PATIENT ICN"")= The ICN of the patient taking action on the"
^XWB(8994,5131,2,1,1,10,0)="                           calling application."
^XWB(8994,5131,2,2,0)="SDPARAM^2^32000^1^2"
^XWB(8994,5131,2,2,1,0)="^8994.021^7^7^3250313^^"
^XWB(8994,5131,2,2,1,1,0)=" SDPARAM(""CLINIC IEN"")=       Clinic IEN in HOSPITAL LOCATION file (#44)"
^XWB(8994,5131,2,2,1,2,0)="                              (required)"
^XWB(8994,5131,2,2,1,3,0)=" SDPARAM(""REACTIVATION DATE"") ISO DATE to reactivate the clinic (required)"
^XWB(8994,5131,2,2,1,4,0)=" SDPARAM(""PROVIDER"",x,""PROVIDER DUZ)= DUZ from NEW PERSON (#200) file "
^XWB(8994,5131,2,2,1,5,0)="                   (required, if no providers are currently set)"
^XWB(8994,5131,2,2,1,6,0)=" SDPARAM(""PROVIDER"",x,""DEFAULT PROVIDER"")=1 for YES, 0 for NO (There can "
^XWB(8994,5131,2,2,1,7,0)="                   only one default provider in provider list)"
