^XWB(8994,4943,3,0)="^8994.03^1^1^3181219^^^^"
^XWB(8994,4943,3,1,0)=" 0 ^ nil"
^XWB(8994,4943,3,2,0)="Lines 2:N -- list of users that this user may assign to:"
^XWB(8994,4943,3,3,0)="  DUZ ^ User Name ^ Initials ^ User type"
^XWB(8994,4943,3,4,0)="Enable code: Code [ ~ Code [ ~Code ] ]  -- indicates which functions"
^XWB(8994,4943,3,5,0)=" to enable for the current user:"
