^XWB(8994,3894,0)="DSIYWO6 WODEL1 CHECK DEL^WODEL1^DSIYWO6^2^P^0"
^XWB(8994,3894,1,0)="^8994.01^4^4^3120925^^"
^XWB(8994,3894,1,1,0)="WODEL1"
^XWB(8994,3894,1,2,0)=" "
^XWB(8994,3894,1,3,0)="Confirms if a user has the rights to delete a Work Order and also "
^XWB(8994,3894,1,4,0)="confirms if the WO can be deleted"
^XWB(8994,3894,2,0)="^8994.02A^1^1"
^XWB(8994,3894,2,1,0)="IEN^1^11^1^1"
^XWB(8994,3894,2,1,1,0)="^8994.021^4^4^3120925^^"
^XWB(8994,3894,2,1,1,1,0)="IEN"
^XWB(8994,3894,2,1,1,2,0)=" "
^XWB(8994,3894,2,1,1,3,0)="IEN to Work Order File ^ENG(6920)"
^XWB(8994,3894,2,1,1,4,0)="Required"
^XWB(8994,3894,2,"B","IEN",1)=""
^XWB(8994,3894,2,"PARAMSEQ",1,1)=""
^XWB(8994,3894,3,0)="^8994.03^6^6^3120925^^"
^XWB(8994,3894,3,1,0)="RETURN PARAMETER"
^XWB(8994,3894,3,2,0)=" "
^XWB(8994,3894,3,3,0)="Returns:"
^XWB(8994,3894,3,4,0)=" "
^XWB(8994,3894,3,5,0)="DSIYRET(1)=""-1^Error message"" if there are problems with the deletion"
^XWB(8994,3894,3,6,0)="DSIYRET(1)=""1^DELETION APPROVED"" if it is OK to delete this work order"
^XWB(8994,3895,0)="DSIYWO6 WODEL2 DEL WO^WODEL2^DSIYWO6^2^P"
^XWB(8994,3895,1,0)="^^8^8^3120925^"
^XWB(8994,3895,1,1,0)="WODEL2"
^XWB(8994,3895,1,2,0)=" "
^XWB(8994,3895,1,3,0)="Deletes an existing WO"
^XWB(8994,3895,1,4,0)="RPC DSIYWO6 WODEL1 must be called first to verify that the delete is "
^XWB(8994,3895,1,5,0)="approved."
^XWB(8994,3895,1,6,0)=" "
^XWB(8994,3895,1,7,0)="The GUI must also ask the user to CONFIRM the delete before calling this "
^XWB(8994,3895,1,8,0)="RPC"
^XWB(8994,3895,2,0)="^8994.02A^1^1"
^XWB(8994,3895,2,1,0)="IEN^1^11^1^1"
^XWB(8994,3895,2,1,1,0)="^^4^4^3120925^"
^XWB(8994,3895,2,1,1,1,0)="IEN"
^XWB(8994,3895,2,1,1,2,0)=" "
^XWB(8994,3895,2,1,1,3,0)="IEN to the Work Order file ^ENG(6920)"
^XWB(8994,3895,2,1,1,4,0)="Required"
^XWB(8994,3895,2,"B","IEN",1)=""
^XWB(8994,3895,2,"PARAMSEQ",1,1)=""
^XWB(8994,3895,3,0)="^^4^4^3120925^"
^XWB(8994,3895,3,1,0)="RETURN PARAMETER"
^XWB(8994,3895,3,2,0)=" "
^XWB(8994,3895,3,3,0)="DSIYRET(1)=""-1^Error message"" If there are problems with the delete"
^XWB(8994,3895,3,4,0)="DSIYRET(1)=""1^DELETION COMPLETE"" If the deletion was finished"
^XWB(8994,3896,0)="DSIYWO2 WOTCHNEW NEW TECH^WOTCHNEW^DSIYWO2^2^P^0"
^XWB(8994,3896,1,0)="^8994.01^6^6^3121204^^"
^XWB(8994,3896,1,1,0)="WOTCHNEW"
^XWB(8994,3896,1,2,0)=" "
^XWB(8994,3896,1,3,0)="RPC to be used when a user is ADDING a new work order.  Once they enter "
^XWB(8994,3896,1,4,0)="the primary technician information, this RPC should be called to add that "
^XWB(8994,3896,1,5,0)="primary tech to the technician multi and redisplay the technician multi "
^XWB(8994,3896,1,6,0)="with this information."
^XWB(8994,3896,2,0)="^8994.02A^1^1"
^XWB(8994,3896,2,1,0)="TECHIEN^1^11^1^1"
^XWB(8994,3896,2,1,1,0)="^8994.021^4^4^3121204^^^"
^XWB(8994,3896,2,1,1,1,0)="TECHIEN"
^XWB(8994,3896,2,1,1,2,0)=" "
^XWB(8994,3896,2,1,1,3,0)="IEN to the Technician File ^ENG(""EMP"") which will come from the entry of "
^XWB(8994,3896,2,1,1,4,0)="the Primary Technician Field"
^XWB(8994,3896,2,"B","TECHIEN",1)=""
^XWB(8994,3896,2,"PARAMSEQ",1,1)=""
^XWB(8994,3896,3,0)="^8994.03^9^9^3121204^^"
^XWB(8994,3896,3,1,0)="RETURN PARAMETER"
^XWB(8994,3896,3,2,0)=" "
^XWB(8994,3896,3,3,0)="DSIYRET(1)=""-1^Error Message"" If errors are found"
^XWB(8994,3896,3,4,0)="DSIYRET(1)=""0^Warning Message"" If there are warnings"
^XWB(8994,3896,3,5,0)="DSIYRET(1)=Assigned Technician Internal^Assigned Technician "
^XWB(8994,3896,3,6,0)="External^0^0^Shop Default Internal^Shop Default External"
^XWB(8994,3896,3,7,0)=" "
^XWB(8994,3896,3,8,0)="(This RPC returns data exactly as the WOTECH RPC returns data for "
^XWB(8994,3896,3,9,0)="consistency - the hours will always be 0 at this point)"
^XWB(8994,3897,0)="DSIYWO2 WOTCHSHP FIND SHOP^WOTCHSHP^DSIYWO2^2^P^0"
^XWB(8994,3897,1,0)="^^19^19^3121012^"
^XWB(8994,3897,1,1,0)="WOTCHSHP"
^XWB(8994,3897,1,2,0)=" "
^XWB(8994,3897,1,3,0)="This RPC is used to find the default shop for a technician.  This should "
^XWB(8994,3897,1,4,0)="be used whenever a technician value is entered or changed."
^XWB(8994,3897,1,5,0)=" "
^XWB(8994,3897,1,6,0)="Primary Technician:"
^XWB(8994,3897,1,7,0)="Call this RPC after a NEW Primary Technician is added - then display the "
^XWB(8994,3897,1,8,0)="shop in the SHOP field on the main part of the screen."
^XWB(8994,3897,1,9,0)=" "
^XWB(8994,3897,1,10,0)="Call this RPC after a Primary Technician is changed ONLY if the current "
^XWB(8994,3897,1,11,0)="SHOP value (field #9) is empty."
^XWB(8994,3897,1,12,0)=" "
^XWB(8994,3897,1,13,0)="Technician Multi:"
^XWB(8994,3897,1,14,0)="When entering a NEW line for the Technician Multi, call this RPC after "
^XWB(8994,3897,1,15,0)="they enter the technician info and display the SHOP as a default."
^XWB(8994,3897,1,16,0)=" "
^XWB(8994,3897,1,17,0)="When changing an existing line for a Technician Multi, call this RPC only "
^XWB(8994,3897,1,18,0)="if the shop value for that technician's line on the multi is currently "
^XWB(8994,3897,1,19,0)="empty - if so then default to this new SHOP."
^XWB(8994,3897,2,0)="^8994.02A^1^1"
^XWB(8994,3897,2,1,0)="TECHIEN^1^11^1^1"
^XWB(8994,3897,2,1,1,0)="^^5^5^3121012^"
^XWB(8994,3897,2,1,1,1,0)="TECHIEN"
^XWB(8994,3897,2,1,1,2,0)=" "
^XWB(8994,3897,2,1,1,3,0)="IEN to the Technician File ^ENG(""EMP"") when a user enters or changes "
^XWB(8994,3897,2,1,1,4,0)="either a Primary Technician (Field #16) or enters/changes a technician in "
^XWB(8994,3897,2,1,1,5,0)="the Technician Multi."
^XWB(8994,3897,2,"B","TECHIEN",1)=""
^XWB(8994,3897,2,"PARAMSEQ",1,1)=""
^XWB(8994,3897,3,0)="^^5^5^3121012^"
^XWB(8994,3897,3,1,0)="RETURN PARAMETER"
^XWB(8994,3897,3,2,0)=" "
^XWB(8994,3897,3,3,0)="DSIYRET(1)=     ""-1^Error Message""    If Errors"
^XWB(8994,3897,3,4,0)="DSIYRET(1)=     ""0^Warning Message""   If Warnings"
^XWB(8994,3897,3,5,0)="DSIYRET(1)=     Shop Internal ^ Shop External"
^XWB(8994,3898,0)="DSIYWO2 WOTCHTRG TRIG FLDS^WOTCHTRG^DSIYWO2^2^P^0"
^XWB(8994,3898,1,0)="^8994.01^14^14^3121204^^^^"
^XWB(8994,3898,1,1,0)="WOTCHTRG"
^XWB(8994,3898,1,2,0)=" "
^XWB(8994,3898,1,3,0)="This RPC triggers changes to the fields:"
^XWB(8994,3898,1,4,0)="   TOTAL HOURS"
^XWB(8994,3898,1,5,0)="   TOTAL LABOR COST"
^XWB(8994,3898,1,6,0)=" "
^XWB(8994,3898,1,7,0)="This RPC should be called whenever a Technician Multi value is changed or "
^XWB(8994,3898,1,8,0)="added.  After the user clicks OK on the Technician Multi, this RPC needs "
^XWB(8994,3898,1,9,0)="to be called to recompute the above fields."
^XWB(8994,3898,1,10,0)=" "
