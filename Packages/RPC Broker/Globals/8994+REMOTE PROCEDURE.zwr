^XWB(8994,4021,3,4,0)="DSIYRET(1)=""-1^<Error Message>     if there are errors"
^XWB(8994,4021,3,5,0)=" "
^XWB(8994,4021,3,6,0)="Two part return if successful"
^XWB(8994,4021,3,7,0)=" "
^XWB(8994,4021,3,8,0)="If there are existing Repetitive Items for this STN/Fiscal "
^XWB(8994,4021,3,9,0)="Year/Qtr/Control Point:"
^XWB(8994,4021,3,10,0)="   DSIYRET(#) = Order IEN ^ Order# ^ Create Date ^ Number of Items"
^XWB(8994,4021,3,11,0)=" "
