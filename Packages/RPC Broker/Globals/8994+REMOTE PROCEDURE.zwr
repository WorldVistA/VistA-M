^XWB(8994,4852,0)="DSIYCMR1 GETSTA STATION LIST^GETSTA^DSIYCMR1^2"
^XWB(8994,4852,1,0)="^^19^19^3190625^"
^XWB(8994,4852,1,1,0)="DSIYCMR1 GETSTA STATION LIST returns the site's Primary Station and any "
^XWB(8994,4852,1,2,0)="Alternative Station numbers defined in the local ENG INIT PARAMETERS "
^XWB(8994,4852,1,3,0)="(#6910) file."
^XWB(8994,4852,1,4,0)=" "
^XWB(8994,4852,1,5,0)="array(seq) = P ^ Station# ^ Station Name"
^XWB(8994,4852,1,6,0)="array(seq) = A ^ Alternative Station# ^ Station Name"
^XWB(8994,4852,1,7,0)=" "
^XWB(8994,4852,1,8,0)="Note: typically only a Primary record."
^XWB(8994,4852,1,9,0)=" "
^XWB(8994,4852,1,10,0)="Alternative Stations are defined for sites that must cope with more than"
^XWB(8994,4852,1,11,0)="one STATION NUMBER, perhaps as a result of consolidation or transition"
^XWB(8994,4852,1,12,0)="from one type of facility to another.  Entry of the old STATION NUMBER as"
^XWB(8994,4852,1,13,0)="an ALTERNATE STATION NUMBER will enable the Equipment Inventory and"
^XWB(8994,4852,1,14,0)="Preventive Maintenance software to recognize bar coded equipment labels"
^XWB(8994,4852,1,15,0)="that bear the old station number."
^XWB(8994,4852,1,16,0)=" "
^XWB(8994,4852,1,17,0)="This field should also be populated at sites that support other VA"
^XWB(8994,4852,1,18,0)="facilities (cemeteries, regional offices,etc.), especially if they choose"
^XWB(8994,4852,1,19,0)="to populate the OWNING STATION field in their Equipment File."
^XWB(8994,4852,3,0)="^^4^4^3190625^"
^XWB(8994,4852,3,1,0)=" "
^XWB(8994,4852,3,2,0)="Returns array containing the local station numbers. "
^XWB(8994,4852,3,3,0)="array(seq) = P ^ Station# ^ Station Name"
^XWB(8994,4852,3,4,0)="array(seq) = A ^ Alternative Station# ^ Station Name"
^XWB(8994,4853,0)="DSIYGR07 INVSL STOCK LVL RPT^INVSL^DSIYGR07^4^^^^1"
^XWB(8994,4853,1,0)="^8994.01^3^3^3200930^^"
^XWB(8994,4853,1,1,0)="Produces a report of the usage/stock level for a single item, a set of "
^XWB(8994,4853,1,2,0)="selected items, or of all items stored in the inventory point within the "
^XWB(8994,4853,1,3,0)="prior 3 months."
^XWB(8994,4853,2,0)="^8994.02A^4^4"
^XWB(8994,4853,2,1,0)="RPTARR^2^^1^2"
^XWB(8994,4853,2,1,1,0)="^^4^4^3190809^"
^XWB(8994,4853,2,1,1,1,0)="RPTARR(#) - The following pieces define the report:"
^XWB(8994,4853,2,1,1,2,0)="             DATA^Station^Distribution Point^ODI Flag"
^XWB(8994,4853,2,1,1,3,0)="             INV^Inventory Item"
^XWB(8994,4853,2,1,1,4,0)="             GC^Group Category"
^XWB(8994,4853,2,2,0)="ESTART^1^^0^1"
^XWB(8994,4853,2,2,1,0)="^8994.021^1^1^3190819^^"
^XWB(8994,4853,2,2,1,1,0)="Report start time.  If nothing sent, default to ""NOW"""
^XWB(8994,4853,2,3,0)="DSIYCYCL^1^20^0^3"
^XWB(8994,4853,2,3,1,0)="^^12^12^3200930^"
^XWB(8994,4853,2,3,1,1,0)="         DSIYCYCL - Cycle Period (increment#_cycle code)"
^XWB(8994,4853,2,3,1,2,0)="         Specifies the report's run cycle - Daily, Weekly, Monthly, or "
^XWB(8994,4853,2,3,1,3,0)="EOM."
^XWB(8994,4853,2,3,1,4,0)="         Report will not cycle if not specified."
^XWB(8994,4853,2,3,1,5,0)=" "
^XWB(8994,4853,2,3,1,6,0)="         Enter T+ or T- followed by the number and the cycle type"
^XWB(8994,4853,2,3,1,7,0)="         1D to 30D - Daily, run every X day(s)."
^XWB(8994,4853,2,3,1,8,0)="         1W to 52W - Weekly, run every X week(s)."
^XWB(8994,4853,2,3,1,9,0)="         1M to 12M - Monthly, run same day every X month(s)."
^XWB(8994,4853,2,3,1,10,0)="         1E to 12E - EOM, run last day every X month(s)."
^XWB(8994,4853,2,3,1,11,0)=" "
^XWB(8994,4853,2,3,1,12,0)="  EX.  T+1D,  T+1W,  T+3M"
^XWB(8994,4853,2,4,0)="DSIYEDT^1^10^0^4"
^XWB(8994,4853,2,4,1,0)="^^2^2^3200930^"
^XWB(8994,4853,2,4,1,1,0)="         DSIYEDT - End Date for Cycling"
^XWB(8994,4853,2,4,1,2,0)="         Cycling will stop when the end date has been reached."
^XWB(8994,4853,2,"B","DSIYCYCL",3)=""
^XWB(8994,4853,2,"B","DSIYEDT",4)=""
^XWB(8994,4853,2,"B","ESTART",2)=""
^XWB(8994,4853,2,"B","RPTARR",1)=""
^XWB(8994,4853,2,"PARAMSEQ",1,2)=""
^XWB(8994,4853,2,"PARAMSEQ",2,1)=""
^XWB(8994,4853,2,"PARAMSEQ",3,3)=""
^XWB(8994,4853,2,"PARAMSEQ",4,4)=""
^XWB(8994,4853,3,0)="^8994.03^3^3^3200930^^^"
^XWB(8994,4853,3,1,0)="RETURNS"
^XWB(8994,4853,3,2,0)=" "
^XWB(8994,4853,3,3,0)="DSIYRET(1)=IEN of Report^Taskman Job Number^Start Date.Time"
^XWB(8994,4854,0)="DSIYTIWP TILI LINE ITEM UPDATE^TILI^DSIYTIWP^2"
^XWB(8994,4854,1,0)="^^30^30^3191023^"
^XWB(8994,4854,1,1,0)="RPC DSIYTIWP TILI LINE ITEM UPDATE"
^XWB(8994,4854,1,2,0)="Updates Turn-In Line Items in preparation for updating the Turn-In status "
^XWB(8994,4854,1,3,0)="to 'WP' TURN INS WAITING FOR WAREHOUSE PICKUP."
^XWB(8994,4854,1,4,0)=" "
^XWB(8994,4854,1,5,0)="Requires that user has Warehouse key PRCNWHSE."
^XWB(8994,4854,1,6,0)=" "
^XWB(8994,4854,1,7,0)="Process will update the following files and fields;"
^XWB(8994,4854,1,8,0)="  (1) TURN-IN LINE ITEM (#413.11) field DISPOSAL CONDITION CODE(#1)."
^XWB(8994,4854,1,9,0)="  (2) DSIY EQUIPMENT DATA FILE (#19685.31) fields CORRECT TURN IN"
^XWB(8994,4854,1,10,0)="      ITEM(#3) and HOUSEKEEPING WEEK(#1)."
^XWB(8994,4854,1,11,0)="  (3) EQUIPMENT INV (#6914) fields CMR(#19) and LOCATION(#24)."
^XWB(8994,4854,1,12,0)=" "
^XWB(8994,4854,1,13,0)="Input:"
^XWB(8994,4854,1,14,0)=" Field array (file#:field#)=internal value^external value. "
^XWB(8994,4854,1,15,0)=" and (""EE:""_line item internal entry number)= Equipment INV IEN."
^XWB(8994,4854,1,16,0)=" "
^XWB(8994,4854,1,17,0)=" In addition to the fields to be updated the (file#:field#) array will "
^XWB(8994,4854,1,18,0)=" include (413.1:.01) Line Item IEN^Transaction Code."
^XWB(8994,4854,1,19,0)=" "
^XWB(8994,4854,1,20,0)="Returns:"
^XWB(8994,4854,1,21,0)="    Array(1)= ""-1^error message"" if there is a problem with input."
^XWB(8994,4854,1,22,0)="    or if successful"
^XWB(8994,4854,1,23,0)="    Array(1)= ""1^ Turn In IEN ^ Turn In Transaction Code"""
^XWB(8994,4854,1,24,0)=" "
^XWB(8994,4854,1,25,0)="    If there are issues filing a file:field the FM message will be"
^XWB(8994,4854,1,26,0)="    returned Array(2..x)=FIELD^ERROR MESSAGE^TYPE"
^XWB(8994,4854,1,27,0)="      Type = WARNING or CRITICAL"
^XWB(8994,4854,1,28,0)=" "
^XWB(8994,4854,1,29,0)="    These messages can be present with successful updates given the "
^XWB(8994,4854,1,30,0)="    batch nature of the RPC."
^XWB(8994,4854,2,0)="^8994.02A^1^1"
^XWB(8994,4854,2,1,0)="DSIYD^2^80^1^1"
^XWB(8994,4854,2,1,1,0)="^8994.021^12^12^3191023^^^^"
^XWB(8994,4854,2,1,1,1,0)="Input array:"
^XWB(8994,4854,2,1,1,2,0)=" Field array (file#:field#)=internal value^external value."
^XWB(8994,4854,2,1,1,3,0)="  TURN-IN REQUEST (#413.1) field TRANSACTION CODE(#.01)  "
^XWB(8994,4854,2,1,1,4,0)=" "
^XWB(8994,4854,2,1,1,5,0)="  TURN-IN LINE ITEM (#413.11) field DISPOSAL CONDITION CODE(#1)."
^XWB(8994,4854,2,1,1,6,0)="  "
^XWB(8994,4854,2,1,1,7,0)="  DSIY EQUIPMENT DATA FILE (#19685.31) fields CORRECT TURN IN"
^XWB(8994,4854,2,1,1,8,0)="  ITEM(#3) and HOUSEKEEPING WEEK(#1)."
^XWB(8994,4854,2,1,1,9,0)="  "
^XWB(8994,4854,2,1,1,10,0)="  EQUIPMENT INV (#6914) fields CMR(#19) and LOCATION(#24)."
^XWB(8994,4854,2,1,1,11,0)=" "
^XWB(8994,4854,2,1,1,12,0)="  and array(""EE:""_line item internal entry number)= Equipment INV IEN."
^XWB(8994,4854,2,"B","DSIYD",1)=""
^XWB(8994,4854,2,"PARAMSEQ",1,1)=""
^XWB(8994,4854,3,0)="^^12^12^3191023^"
^XWB(8994,4854,3,1,0)=" "
^XWB(8994,4854,3,2,0)="    Array(1)= ""-1^error message"" if there is a problem with input."
^XWB(8994,4854,3,3,0)=" "
^XWB(8994,4854,3,4,0)="    or if successful"
^XWB(8994,4854,3,5,0)="    Array(1)=""1^ Turn In IEN ^ Turn In Transaction Code"""
^XWB(8994,4854,3,6,0)=" "
^XWB(8994,4854,3,7,0)="    If there are issues filing a file:field the FM message will be"
^XWB(8994,4854,3,8,0)="    returned Array(2..x)=FIELD^ERROR MESSAGE^TYPE"
^XWB(8994,4854,3,9,0)="      Type = WARNING or CRITICAL"
^XWB(8994,4854,3,10,0)=" "
^XWB(8994,4854,3,11,0)="    These messages can be present with successful updates given the"
^XWB(8994,4854,3,12,0)="    batch nature of the RPC."
^XWB(8994,4855,0)="DSIYRPT9 EQ METRPT METRICS RPT^METRPT^DSIYRPT9^4^^^^1"
^XWB(8994,4855,1,0)="^^21^21^3191118^"
^XWB(8994,4855,1,1,0)=" Generates a report of all of the items that are missing at least one of "
^XWB(8994,4855,1,2,0)="the following required fields:"
^XWB(8994,4855,1,3,0)=" "
^XWB(8994,4855,1,4,0)=" EQUIPMENT CATEGORY"
^XWB(8994,4855,1,5,0)=" MODEL"
^XWB(8994,4855,1,6,0)=" SERIAL #"
^XWB(8994,4855,1,7,0)=" MANUFACTURER"
^XWB(8994,4855,1,8,0)=" PURCHASE ORDER #"
^XWB(8994,4855,1,9,0)=" ACQUISITION DATE"
^XWB(8994,4855,1,10,0)=" LIFE EXPECTANCY"
^XWB(8994,4855,1,11,0)=" CATEGORY STOCK NUMBER"
^XWB(8994,4855,1,12,0)=" CMR"
^XWB(8994,4855,1,13,0)=" PHYSICAL INVENTORY DATE"
^XWB(8994,4855,1,14,0)=" LEASE COST"
^XWB(8994,4855,1,15,0)=" USE STATUS"
^XWB(8994,4855,1,16,0)=" SERVICE POINTER"
^XWB(8994,4855,1,17,0)=" ACQUISITION METHOD"
^XWB(8994,4855,1,18,0)=" LOCATION"
^XWB(8994,4855,1,19,0)=" MFGR. EQUIPMENT NAME"
^XWB(8994,4855,1,20,0)=" TYPE OF ENTRY"
^XWB(8994,4855,1,21,0)=" INVESTMENT CATEGORY"
^XWB(8994,4855,2,0)="^8994.02A^1^1"
^XWB(8994,4855,2,1,0)="NUMBER OF ITEMS^1^^0^1"
^XWB(8994,4855,2,1,1,0)="^^4^4^3191118^"
^XWB(8994,4855,2,1,1,1,0)="Enter the number of items missing required fields. This parameter will be "
^XWB(8994,4855,2,1,1,2,0)="used by the report progress tracking bar."
^XWB(8994,4855,2,1,1,3,0)=" "
^XWB(8994,4855,2,1,1,4,0)="Defaults to 2000 items."
^XWB(8994,4855,2,"B","NUMBER OF ITEMS",1)=""
^XWB(8994,4855,2,"PARAMSEQ",1,1)=""
^XWB(8994,4855,3,0)="^^6^6^3191118^"
^XWB(8994,4855,3,1,0)=" RETURNS:   "
^XWB(8994,4855,3,2,0)=" "
^XWB(8994,4855,3,3,0)=" If successful, returns:"
^XWB(8994,4855,3,4,0)="    [Task Number]^REPORT AFTER [time report is scheduled to run]"
^XWB(8994,4855,3,5,0)=" Otherwise, returns:"
^XWB(8994,4855,3,6,0)="    -1^[Error Message]"
^XWB(8994,4856,0)="DSIYEPMR1 CREPMWO CREATE PMWO^CREPMWO^DSIYEPMR1^2^^^^1"
^XWB(8994,4856,1,0)="^8994.01^25^25^3200214^^^^"
^XWB(8994,4856,1,1,0)="Based on Fileman option - ENPMR3"
^XWB(8994,4856,1,2,0)="May be used to record a PMI on any specified device, regardless of "
^XWB(8994,4856,1,3,0)="whether or not it is on an active PMI list. One use envisioned for this "
^XWB(8994,4856,1,4,0)="is recording the results of 'area sweeps'. If the specified device is in "
^XWB(8994,4856,1,5,0)="the scheduled PMI program and it appears that a PMI recorded via this "
^XWB(8994,4856,1,6,0)="option may make it desirable to change the scheduled FREQUENCY or the "
^XWB(8994,4856,1,7,0)="STARTING MONTH, the user will be afforded an opportunity to do so."
^XWB(8994,4856,1,8,0)=" "
^XWB(8994,4856,1,9,0)="This RPC will create a new PM Work Order based on the specified Shop, "
^XWB(8994,4856,1,10,0)="Equipment #, and period."
^XWB(8994,4856,1,11,0)=" "
^XWB(8994,4856,1,12,0)="User will pass the required fields (SHOP, EEIN, M/W, MonYear, Week#) to "
^XWB(8994,4856,1,13,0)="identify the new PM WO. "
^XWB(8994,4856,1,14,0)=" "
^XWB(8994,4856,1,15,0)="  INPUT:"
^XWB(8994,4856,1,16,0)="   1. DSIYSHP - SHOP IEN  6922 ENGINEERING SECTION"
^XWB(8994,4856,1,17,0)="   2. DSIYEE - EQUIPMENT INV #"
^XWB(8994,4856,1,18,0)="   3. DSIYPM - W:week or M:month  (W or M)"
^XWB(8994,4856,1,19,0)="   4. DSIYPMM - Month  (YYMM) "
^XWB(8994,4856,1,20,0)="   5. DSIYWK - '1-5' or NULL if Monthly"
^XWB(8994,4856,1,21,0)=" "
^XWB(8994,4856,1,22,0)=" "
^XWB(8994,4856,1,23,0)="If successful the process will return the data array for the new PM "
^XWB(8994,4856,1,24,0)="Work Order. If the PM Work Order already exists then the process will "
^XWB(8994,4856,1,25,0)="return an error message."
^XWB(8994,4856,2,0)="^8994.02A^5^5"
^XWB(8994,4856,2,1,0)="DSIYSHP^1^16^1^1"
^XWB(8994,4856,2,1,1,0)="^^1^1^3191209^"
^XWB(8994,4856,2,1,1,1,0)="Pass the Shop IEN file ENGINEERING SECTION (6922)."
^XWB(8994,4856,2,2,0)="DSIYEE^1^16^1^2"
^XWB(8994,4856,2,2,1,0)="^^1^1^3191209^"
^XWB(8994,4856,2,2,1,1,0)="Pass the Equipment Number file EQUIPMENT INV.(#6914)"
^XWB(8994,4856,2,3,0)="DSIYPM^1^1^0^3"
^XWB(8994,4856,2,3,1,0)="^^2^2^3191209^"
^XWB(8994,4856,2,3,1,1,0)="Pass W for a Weekly PM WO or M for a Monthly PM WO."
^XWB(8994,4856,2,3,1,2,0)="If no value then process will default to M."
^XWB(8994,4856,2,4,0)="DSIYPMM^1^4^1^4"
^XWB(8994,4856,2,4,1,0)="^^1^1^3191209^"
^XWB(8994,4856,2,4,1,1,0)="Pass the YYMM associated with the PM WO."
^XWB(8994,4856,2,5,0)="DSIYWK^1^1^0^5"
^XWB(8994,4856,2,5,1,0)="^8994.021^2^2^3200214^^^^"
^XWB(8994,4856,2,5,1,1,0)="If the PM WO is to be weekly then pass the week # 1-5."
^XWB(8994,4856,2,5,1,2,0)="If the PM WO is monthly then no vlaue is required."
^XWB(8994,4856,2,"B","DSIYEE",2)=""
^XWB(8994,4856,2,"B","DSIYPM",3)=""
^XWB(8994,4856,2,"B","DSIYPMM",4)=""
^XWB(8994,4856,2,"B","DSIYSHP",1)=""
^XWB(8994,4856,2,"B","DSIYWK",5)=""
^XWB(8994,4856,2,"PARAMSEQ",1,1)=""
^XWB(8994,4856,2,"PARAMSEQ",2,2)=""
^XWB(8994,4856,2,"PARAMSEQ",3,3)=""
^XWB(8994,4856,2,"PARAMSEQ",4,4)=""
^XWB(8994,4856,2,"PARAMSEQ",5,5)=""
^XWB(8994,4856,3,0)="^8994.03^9^9^3200214^^^"
^XWB(8994,4856,3,1,0)="RETURN PARAMETER"
^XWB(8994,4856,3,2,0)=" "
^XWB(8994,4856,3,3,0)="Returns data for Work Order created by this RPC."
^XWB(8994,4856,3,4,0)="Includes the field data in the Work Order File ^ENG(6920), does not"
^XWB(8994,4856,3,5,0)="return data for Word Processing Fields or Multiple Fields"
^XWB(8994,4856,3,6,0)="  "
^XWB(8994,4856,3,7,0)="(#)=Field #^ Table Name/Description^ Internal Value^ External Value"
^XWB(8994,4856,3,8,0)=" "
^XWB(8994,4856,3,9,0)="DSIYRET(0)=-1^error message if errors are found"
^XWB(8994,4857,0)="DSIYEPMR1 OWO GET OPEN PMWO^OWO^DSIYEPMR1^4^^^^1"
^XWB(8994,4857,1,0)="^8994.01^7^7^3200214^^^"
^XWB(8994,4857,1,1,0)="DSIYEPMR1 OWO GET OPEN PMWO"
^XWB(8994,4857,1,2,0)="Search through WO File for open Work Orders for specified Shop and "
^XWB(8994,4857,1,3,0)="Equipment#."
^XWB(8994,4857,1,4,0)=" "
^XWB(8994,4857,1,5,0)="Returns PM Work Orders in standard WO record format (DSIYWO1A)."
^XWB(8994,4857,1,6,0)=" "
^XWB(8994,4857,1,7,0)="or message indicating no Open PM Work Orders exist."
^XWB(8994,4857,2,0)="^8994.02A^2^2"
^XWB(8994,4857,2,1,0)="DSIYSHP^1^4^1^1"
^XWB(8994,4857,2,1,1,0)="^^1^1^3200214^"
^XWB(8994,4857,2,1,1,1,0)="DSIYSHP - pass the internal Shop # from file ENGINEERING SECTION (#6922)."
^XWB(8994,4857,2,2,0)="DSIYEE^1^16^1^2"
^XWB(8994,4857,2,2,1,0)="^8994.021^1^1^3200214^^^"
^XWB(8994,4857,2,2,1,1,0)="DSIYEE - pass the Equipment # from file EQUIPMENT INV # (#6914)."
^XWB(8994,4857,2,"B","DSIYEE",2)=""
^XWB(8994,4857,2,"B","DSIYSHP",1)=""
^XWB(8994,4857,2,"PARAMSEQ",1,1)=""
^XWB(8994,4857,2,"PARAMSEQ",2,2)=""
^XWB(8994,4857,3,0)="^8994.03^3^3^3200214^^^"
^XWB(8994,4857,3,1,0)="Returns PM Work Orders in standard WO record format (DSIYWO1A)."
^XWB(8994,4857,3,2,0)=" "
^XWB(8994,4857,3,3,0)="or message indicating no Open PM Work Orders exist."
^XWB(8994,4858,0)="DSIYGR08 INV AVAILABILITY LIST^INV^DSIYGR08^4^^^^1"
^XWB(8994,4858,1,0)="^8994.01^4^4^3200930^^"
^XWB(8994,4858,1,1,0)="Produces a report of the item master number, description, nsn, unit per "
^XWB(8994,4858,1,2,0)="issue, group category, quantity on-hand, quantity, due-in, quantity "
^XWB(8994,4858,1,3,0)="due-out, reorder point, issue multiple, average unit cost, total value, "
^XWB(8994,4858,1,4,0)="and if the item is set to 'kill when zero."
^XWB(8994,4858,2,0)="^8994.02A^4^4"
^XWB(8994,4858,2,1,0)="ESTART^1^^0^1"
^XWB(8994,4858,2,1,1,0)="^^1^1^3200413^"
^XWB(8994,4858,2,1,1,1,0)="Report start time.  If nothing sent, default to ""NOW""."
^XWB(8994,4858,2,2,0)="DATA ARRAY^2^^1^2"
^XWB(8994,4858,2,2,1,0)="^^3^3^3200413^"
^XWB(8994,4858,2,2,1,1,0)="DSIYRPTARR(#) - The following pieces define the report"
^XWB(8994,4858,2,2,1,2,0)="                  DATA^Station^Distribution Point"
^XWB(8994,4858,2,2,1,3,0)="                  GC^Group Category"
^XWB(8994,4858,2,3,0)="DSIYCYCL^1^20^0^3"
^XWB(8994,4858,2,3,1,0)="^^11^11^3200930^"
^XWB(8994,4858,2,3,1,1,0)="  DSIYCYCL - Cycle Period (increment#_cycle code)"
^XWB(8994,4858,2,3,1,2,0)="  Specifies the report's run cycle - Daily, Weekly, Monthly, or EOM."
^XWB(8994,4858,2,3,1,3,0)="  Report will not cycle if not specified."
^XWB(8994,4858,2,3,1,4,0)=" "
^XWB(8994,4858,2,3,1,5,0)="   Enter T+ or T- followed by the number and the cycle type"
^XWB(8994,4858,2,3,1,6,0)="        1D to 30D - Daily, run every X day(s)."
^XWB(8994,4858,2,3,1,7,0)="        1W to 52W - Weekly, run every X week(s)."
^XWB(8994,4858,2,3,1,8,0)="        1M to 12M - Monthly, run same day every X month(s)."
^XWB(8994,4858,2,3,1,9,0)="        1E to 12E - EOM, run last day every X month(s)."
^XWB(8994,4858,2,3,1,10,0)=" "
^XWB(8994,4858,2,3,1,11,0)="   EX.  T+1D,  T+1W,  T+3M"
^XWB(8994,4858,2,4,0)="DSIYEDT^1^10^0^4"
^XWB(8994,4858,2,4,1,0)="^^2^2^3200930^"
^XWB(8994,4858,2,4,1,1,0)="          DSIYEDT - End Date for Cycling"
^XWB(8994,4858,2,4,1,2,0)="          Cycling will stop when the end date has been reached."
^XWB(8994,4858,2,"B","DATA ARRAY",2)=""
^XWB(8994,4858,2,"B","DSIYCYCL",3)=""
^XWB(8994,4858,2,"B","DSIYEDT",4)=""
^XWB(8994,4858,2,"B","ESTART",1)=""
^XWB(8994,4858,2,"PARAMSEQ",1,1)=""
^XWB(8994,4858,2,"PARAMSEQ",2,2)=""
^XWB(8994,4858,2,"PARAMSEQ",3,3)=""
^XWB(8994,4858,2,"PARAMSEQ",4,4)=""
^XWB(8994,4858,3,0)="^8994.03^1^1^3200930^^"
^XWB(8994,4858,3,1,0)="DSIYRET(1)=IEN of Report^TaskMan Job Number^Start Date.Time"
^XWB(8994,4859,0)="DSIYGR09 INV COMPREHENSIVE RPT^INV^DSIYGR09^4^^^^1"
^XWB(8994,4859,1,0)="^8994.01^1^1^3200930^^^"
^XWB(8994,4859,1,1,0)="Produces a comprehensive listing of items within the inventory point."
^XWB(8994,4859,2,0)="^8994.02A^4^4"
^XWB(8994,4859,2,1,0)="ESTART^1^^0^1"
^XWB(8994,4859,2,1,1,0)="^^1^1^3200420^"
^XWB(8994,4859,2,1,1,1,0)="Report start time.  If nothing sent, default to ""NOW""."
^XWB(8994,4859,2,2,0)="DATA ARRAY^2^^1^2"
^XWB(8994,4859,2,2,1,0)="^8994.021^3^3^3200420^^"
^XWB(8994,4859,2,2,1,1,0)=" DSIYRPTARR(#) - The following pieces define the report"
^XWB(8994,4859,2,2,1,2,0)="                   DATA^Station^Distribution Point"
^XWB(8994,4859,2,2,1,3,0)="                   GC^Group Category"
^XWB(8994,4859,2,3,0)="DSIYCYCL^1^20^0^3"
^XWB(8994,4859,2,3,1,0)="^8994.021^11^11^3200930^^"
^XWB(8994,4859,2,3,1,1,0)="   DSIYCYCL - Cycle Period (increment#_cycle code)"
^XWB(8994,4859,2,3,1,2,0)="   Specifies the report's run cycle - Daily, Weekly, Monthly, or EOM."
^XWB(8994,4859,2,3,1,3,0)="   Report will not cycle if not specified."
^XWB(8994,4859,2,3,1,4,0)=" "
^XWB(8994,4859,2,3,1,5,0)="    Enter T+ or T- followed by the number and the cycle type"
^XWB(8994,4859,2,3,1,6,0)="         1D to 30D - Daily, run every X day(s)."
^XWB(8994,4859,2,3,1,7,0)="         1W to 52W - Weekly, run every X week(s)."
^XWB(8994,4859,2,3,1,8,0)="         1M to 12M - Monthly, run same day every X month(s)."
^XWB(8994,4859,2,3,1,9,0)="         1E to 12E - EOM, run last day every X month(s)."
^XWB(8994,4859,2,3,1,10,0)=" "
^XWB(8994,4859,2,3,1,11,0)="    EX.  T+1D,  T+1W,  T+3M"
^XWB(8994,4859,2,4,0)="DSIYEDT^1^10^0^4"
^XWB(8994,4859,2,4,1,0)="^^2^2^3200930^"
^XWB(8994,4859,2,4,1,1,0)="           DSIYEDT - End Date for Cycling"
^XWB(8994,4859,2,4,1,2,0)="           Cycling will stop when the end date has been reached."
^XWB(8994,4859,2,"B","DATA ARRAY",2)=""
^XWB(8994,4859,2,"B","DSIYCYCL",3)=""
^XWB(8994,4859,2,"B","DSIYEDT",4)=""
^XWB(8994,4859,2,"B","ESTART",1)=""
