^XWB(8994,4478,0)="MAG DICOM Q/R CLIENT^ENTRY^MAGDSTV2^2^R^^^1^3"
^XWB(8994,4478,1,0)="^8994.01^5^5^3190708^^^^"
^XWB(8994,4478,1,1,0)="The DICOM Gateway functions as a surrogate Q/R"
^XWB(8994,4478,1,2,0)="user (SCU) for the Q/R client operation on VistA."
^XWB(8994,4478,1,3,0)=" "
^XWB(8994,4478,1,4,0)="The Q/R client on VistA is a front-end facade.  The"
^XWB(8994,4478,1,5,0)="actual Q/R user (SCU) is on the DICOM Gateway."
^XWB(8994,4478,2,0)="^8994.02A^1^1"
^XWB(8994,4478,2,1,0)="REQUEST^2^32000^1^1"
^XWB(8994,4478,2,1,1,0)="^^2^2^3190312^"
^XWB(8994,4478,2,1,1,1,0)="These are either a request for another set of query keys"
^XWB(8994,4478,2,1,1,2,0)="or results of a query to be passed to the front-end."
^XWB(8994,4478,2,"B","REQUEST",1)=""
