^XWB(8994,4350,2,1,1,0)="^^1^1^3150925^"
^XWB(8994,4350,2,1,1,1,0)="This is the user who is currently requesting statements."
^XWB(8994,4350,2,2,0)="DSSOSRT^1^7^1^2"
^XWB(8994,4350,2,2,1,0)="^^1^1^3150925^"
^XWB(8994,4350,2,2,1,1,0)="This is the starting date of the statements report."
