^XWB(8994,4288,3,1,0)="Output:"
^XWB(8994,4288,3,2,0)="  Error Messages:  DSSORET(0)=""-1^""_error message or ""0^""_error message"
^XWB(8994,4288,3,3,0)="  Successful Completion: Returns either all items, a list of items"
^XWB(8994,4288,3,4,0)="    beginning with the requested starting value, or the specified item"
^XWB(8994,4288,3,5,0)="    with the associated identifying information in the format:"
^XWB(8994,4288,3,6,0)="    441 IEN ^ Number (#.01 external) ^ Short Description (#.05 external)"
^XWB(8994,4288,3,7,0)="    ^ Inactivated Item? (#16 external) ^ Date Inactivated (#17 external) ^"
^XWB(8994,4288,3,8,0)="    Replacement Item (#16.5 external^internal)"
^XWB(8994,4289,0)="DSSO DTLD GET ITEM MASTER^GTITMSTR^DSSODU3^4^^^^1"
^XWB(8994,4289,1,0)="^^6^6^3140627^"
^XWB(8994,4289,1,1,0)="This RPC returns all Item Master data for the requested Item Master (file "
^XWB(8994,4289,1,2,0)="#441) IEN based on the value of the Fields flag. If the Fields scription"
^XWB(8994,4289,1,3,0)="flag is set to 1, only the Description (#.1) field is returned from the"
^XWB(8994,4289,1,4,0)="Item Master file (#441).  If the Fields flag is set to ""V"", only fields"
^XWB(8994,4289,1,5,0)="from the VEndor multiple are returned.  For all other values of the Fields"
^XWB(8994,4289,1,6,0)="flag, all fields are returned."
^XWB(8994,4289,2,0)="^8994.02A^2^2"
^XWB(8994,4289,2,1,0)="DSSOIEN^1^30^1^1"
^XWB(8994,4289,2,1,1,0)="^8994.021^1^1^3140507^^^^"
^XWB(8994,4289,2,1,1,1,0)="IEN of Item Master file (#441)"
^XWB(8994,4289,2,2,0)="DSSOFLD^1^1^0^2"
^XWB(8994,4289,2,2,1,0)="^^4^4^3140627^"
^XWB(8994,4289,2,2,1,1,0)="The Fields flag - if equal to 1, only field #.1 - Description - is"
^XWB(8994,4289,2,2,1,2,0)="returned from the Item Master file (#441); if equal to ""V"", all fields "
^XWB(8994,4289,2,2,1,3,0)="from the Vendor multiple are returned; for any other value, all"
^XWB(8994,4289,2,2,1,4,0)="fields are returned."
