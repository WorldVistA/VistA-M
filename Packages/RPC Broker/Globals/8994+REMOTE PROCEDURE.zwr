^XWB(8994,898,2,"B","DVBADLMTR",3)=""
^XWB(8994,898,2,"B","SELDIV",1)=""
^XWB(8994,899,0)="DVBAB REPORT CPDETAILS^STRT^DVBAB70^2^R"
^XWB(8994,899,1,0)="^^1^1^3010621^"
^XWB(8994,899,1,1,0)="Returns a detailed summary of a specific C&P request."
^XWB(8994,899,2,0)="^8994.02A^2^2"
^XWB(8994,899,2,1,0)="DFN^1"
^XWB(8994,899,2,2,0)="ZREQDA^1"
^XWB(8994,899,2,"B","DFN",1)=""
^XWB(8994,899,2,"B","ZREQDA",2)=""
^XWB(8994,900,0)="DVBAB REPORT 7131INQ^STRT^DVBAB71^4^R"
^XWB(8994,900,1,0)="^^1^1^3010621^"
^XWB(8994,900,1,1,0)="Returns a 7131 inquiry report."
^XWB(8994,900,2,0)="^8994.02A^2^2"
^XWB(8994,900,2,1,0)="ZDFN^1^^1^1"
^XWB(8994,900,2,2,0)="RECIEN^1^^1"
^XWB(8994,900,2,"B","RECIEN",2)=""
^XWB(8994,900,2,"B","ZDFN",1)=""
^XWB(8994,900,2,"PARAMSEQ",1,1)=""
^XWB(8994,901,0)="DVBAB LABLIST^LABLIST^DVBAB1^4^R"
^XWB(8994,901,1,0)="^^1^1^3010621^"
^XWB(8994,901,1,1,0)="Returns a list of the site's laboratory test names."
^XWB(8994,902,0)="DVBAB VERSION^VERSION^DVBAB1^1^R"
^XWB(8994,902,1,0)="^8994.01^6^6^3220411^^"
^XWB(8994,902,1,1,0)="This RPC returns the MINIMUM version parameter and also checks if the"
^XWB(8994,902,1,2,0)="GUI matches the MINIMUM version build or the PREVIOUS version build."
^XWB(8994,902,1,3,0)="If the GUI is the PREVIOUS version and falls outside of the grace period"
^XWB(8994,902,1,4,0)="or the GUI is not the MINIMUM or PREVIOUS build this RPC will return "
^XWB(8994,902,1,5,0)="the grace period date of January 1, 1980 enforcing GUI version control "
^XWB(8994,902,1,6,0)="to recognize this version is no longer allowed sign on."
^XWB(8994,902,2,0)="^8994.02A^1^1"
^XWB(8994,902,2,1,0)="DVBGUIV^1^^0"
^XWB(8994,902,2,1,1,0)="^8994.021^4^4^3220411^^"
^XWB(8994,902,2,1,1,1,0)="Version # of CAPRI GUI.  Sets a variable DVBABVRx so that the error trap "
^XWB(8994,902,2,1,1,2,0)="will display what version of the client software the user was utilizing. "
^XWB(8994,902,2,1,1,3,0)="DVBGUIV is also used to determine if the GUI attempting sign on should"
^XWB(8994,902,2,1,1,4,0)="be allowed."
^XWB(8994,902,2,"B","DVBGUIV",1)=""
^XWB(8994,903,0)="DVBAB DIVISION^DIVISION^DVBAB1^1^S"
^XWB(8994,904,0)="EC GETDSSUNITUSRS^ECUSR^ECUMRPC^4^A^^^1"
^XWB(8994,904,1,0)="^8994.01^2^2^3010503^^^^"
^XWB(8994,904,1,1,0)="Returns an array of users with access to a particular DSS unit.  User access "
^XWB(8994,904,1,2,0)="to a DSS unit is determined from file #200."
^XWB(8994,904,2,0)="^8994.02A^1^1"
^XWB(8994,904,2,1,0)="ECARY^1^30^1^"
^XWB(8994,904,2,1,1,0)="^8994.021^1^1^3010503^^^^"
^XWB(8994,904,2,1,1,1,0)="DSS unit IEN must be passed in as input parameter."
^XWB(8994,904,2,"B","ECARY",1)=""
^XWB(8994,904,3,0)="^8994.03^1^1^3010503^^^^"
^XWB(8994,904,3,1,0)="Returns an array list with user name and ien from file #200."
^XWB(8994,905,0)="EC GETECSCREEN^ECSCN^ECUMRPC^4^A^^^1"
^XWB(8994,905,1,0)="^8994.01^2^2^3180305^^^^"
^XWB(8994,905,1,1,0)="Returns a list active, inactive or both of Event Code Screens from EC EVENT "
^XWB(8994,905,1,2,0)="CODE SCREENS FILE #720.3."
^XWB(8994,905,2,0)="^8994.02A^1^1"
^XWB(8994,905,2,1,0)="ECARY^1"
^XWB(8994,905,2,1,1,0)="^^16^16^3180305^"
^XWB(8994,905,2,1,1,1,0)="Input variable ECARY can contains the following elements separated by "
^XWB(8994,905,2,1,1,2,0)="up-arrow."
^XWB(8994,905,2,1,1,3,0)=" "
^XWB(8994,905,2,1,1,4,0)="  STAT   - Active and/or inactive Event Code Screens"
^XWB(8994,905,2,1,1,5,0)="           A-ctive (default), I-nactive, B-oth"
^XWB(8994,905,2,1,1,6,0)="  LOCIEN - Location IEN (optional)"
^XWB(8994,905,2,1,1,7,0)="  DSSIEN - DSS IEN (optional)"
^XWB(8994,905,2,1,1,8,0)=" "
^XWB(8994,905,2,1,1,9,0)="If no parameters are passed, a status of active is assumed as well as all"
^XWB(8994,905,2,1,1,10,0)="locations. "
^XWB(8994,905,2,1,1,11,0)=" "
^XWB(8994,905,2,1,1,12,0)="If a LOCIEN is passed then only the event codes screens associated with"
^XWB(8994,905,2,1,1,13,0)="that location are returned. "
^XWB(8994,905,2,1,1,14,0)=" "
^XWB(8994,905,2,1,1,15,0)="If a DSSIEN is passed then only the event code screens associated with"
^XWB(8994,905,2,1,1,16,0)="that DSS Unit are returned."
^XWB(8994,905,2,"B","ECARY",1)=""
^XWB(8994,905,3,0)="^8994.03^6^6^3010503^^^"
^XWB(8994,905,3,1,0)="The result array contains the following data separated by up-arrow."
^XWB(8994,905,3,2,0)="   1. 720.3 ien"
^XWB(8994,905,3,3,0)="   2. Location description"
^XWB(8994,905,3,4,0)="   3. DSS Unit description"
^XWB(8994,905,3,5,0)="   4. Category Description"
^XWB(8994,905,3,6,0)="   5. Procedure 5 digit code and description"
^XWB(8994,906,0)="EC GETPXREASON^ECPXRS^ECUMRPC^4^A^^^1"
^XWB(8994,906,1,0)="^8994.01^1^1^3010503^^^^"
^XWB(8994,906,1,1,0)="Return array entries with Procedure reasons linked to an Event Code screen."
^XWB(8994,906,2,0)="^8994.02A^1^1"
^XWB(8994,906,2,1,0)="ECARY^1^^1"
^XWB(8994,906,2,1,1,0)="^8994.021^1^1^3010503^^^"
^XWB(8994,906,2,1,1,1,0)="The Event Code screen IEN from file #720.3."
^XWB(8994,906,2,"B","ECARY",1)=""
^XWB(8994,906,3,0)="^8994.03^4^4^3010503^^^"
^XWB(8994,906,3,1,0)="Returns an array with data containing "
^XWB(8994,906,3,2,0)="    1. Procedure reason"
^XWB(8994,906,3,3,0)="    2. Procedure reason ien from #720.4"
^XWB(8994,906,3,4,0)="    3. Event Code screens/procedure reason link ien #720.5"
^XWB(8994,907,0)="EC GETECSDETAIL^ECSDTLS^ECUMRPC^1^A^^^1"
^XWB(8994,907,1,0)="^8994.01^2^2^3180209^^"
^XWB(8994,907,1,1,0)="Returns details on a specific Event Code Screen from the EC EVENT CODE "
^XWB(8994,907,1,2,0)="SCREENS FILE #720.3."
^XWB(8994,907,2,0)="^8994.02A^1^1"
^XWB(8994,907,2,1,0)="ECARY^1^^1"
^XWB(8994,907,2,1,1,0)="^8994.021^1^1^3180209^^^^"
^XWB(8994,907,2,1,1,1,0)="The input parameter ECARY contains the Event code screen IEN."
^XWB(8994,907,2,"B","ECARY",1)=""
^XWB(8994,907,3,0)="^^9^9^3180209^"
^XWB(8994,907,3,1,0)="The return variable contains the following data separated by up-arrows."
^XWB(8994,907,3,2,0)="  1. 720.3 ien"
^XWB(8994,907,3,3,0)="  2. event code screen name"
^XWB(8994,907,3,4,0)="  3. synonym"
^XWB(8994,907,3,5,0)="  4. volume"
^XWB(8994,907,3,6,0)="  5. associated clinic"
^XWB(8994,907,3,7,0)="  6. Procedure reason indicator"
^XWB(8994,907,3,8,0)="  7. Status"
^XWB(8994,907,3,9,0)="  8. Send to PCE status - 1 if sent, 0 if not"
^XWB(8994,908,0)="EC GETPATPROCS^PATPROC^ECUERPC^4^R^^^1"
^XWB(8994,908,1,0)="^8994.01^2^2^3030306^^^^"
^XWB(8994,908,1,1,0)="Returns an array of patient entries from EVENT CAPTURE PATIENT FILE #721 that "
^XWB(8994,908,1,2,0)="matches a location, DSS unit, patient DFN, start date and end date."
^XWB(8994,908,2,0)="^8994.02A^1^1"
^XWB(8994,908,2,1,0)="ECARY^1^^1"
^XWB(8994,908,2,1,1,0)="^8994.021^6^6^3030306^^^^"
^XWB(8994,908,2,1,1,1,0)="Input variable ECARY contains the following values separated by up-arrows:-"
^XWB(8994,908,2,1,1,2,0)="  1.  ECLOC  - Location ien"
^XWB(8994,908,2,1,1,3,0)="  2.  ECPAT  - Patient DFN ien"
^XWB(8994,908,2,1,1,4,0)="  3.  ECUNT  - DSS unit ien"
^XWB(8994,908,2,1,1,5,0)="  4.  ECSD   - Start Date"
^XWB(8994,908,2,1,1,6,0)="  5.  ECED   - End Date"
^XWB(8994,908,2,"B","ECARY",1)=""
^XWB(8994,908,3,0)="^8994.03^6^6^3030306^^^^"
^XWB(8994,908,3,1,0)="Returns an array with Event Capture Patient entries with the following data:-"
^XWB(8994,908,3,2,0)="  1. 721 IEN                              6. Provider"
^XWB(8994,908,3,3,0)="  2. Procedure date and time              7. Ordering Section"
^XWB(8994,908,3,4,0)="  3. Category                             8. Associated Clinic"
^XWB(8994,908,3,5,0)="  4. Procedure                            9. Primary Diagnoses"
^XWB(8994,908,3,6,0)="  5. Volume                              10. Provider IEN"
^XWB(8994,909,0)="EC GETSCNHELP^ECHELP^ECUURPC^4^P^^^1"
^XWB(8994,909,1,0)="^^1^1^3180306^"
^XWB(8994,909,1,1,0)="Returns the text from the HELP FRAME file (#9.2) based on a help frame."
^XWB(8994,909,2,0)="^8994.02A^1^1"
^XWB(8994,909,2,1,0)="ECARY^1^^1"
^XWB(8994,909,2,1,1,0)="^^1^1^3180306^"
^XWB(8994,909,2,1,1,1,0)="Input variable ECARY contains the name of the help frame."
^XWB(8994,909,2,"B","ECARY",1)=""
^XWB(8994,909,3,0)="^^1^1^3180306^"
^XWB(8994,909,3,1,0)="Returns an array with help text from the HELP FRAME File (#9.2)."
^XWB(8994,910,0)="EC GETECLOC^ECLOC^ECUMRPC^4^A^^^1"
^XWB(8994,910,1,0)="^8994.01^1^1^3010503^^^^"
^XWB(8994,910,1,1,0)="Returns an array with all active Event Capture locations from file #4."
^XWB(8994,910,3,0)="^8994.03^1^1^3010503^^^^"
^XWB(8994,910,3,1,0)="Returns array with value set to location and location IEN respectively."
^XWB(8994,911,0)="EC GETUSRDSSUNIT^USRUNT^ECUERPC^4^R^^^1"
^XWB(8994,911,1,0)="^8994.01^1^1^3180305^^^^"
^XWB(8994,911,1,1,0)="Returns an array of DSS units for which the user has access."
^XWB(8994,911,2,0)="^8994.02A^1^1"
^XWB(8994,911,2,1,0)="ECARY^1^^1"
^XWB(8994,911,2,1,1,0)="^^13^13^3180305^"
^XWB(8994,911,2,1,1,1,0)="The input variable ECARY contain the following '^' delimited values."
^XWB(8994,911,2,1,1,2,0)=" "
^XWB(8994,911,2,1,1,3,0)="  1. ECL      - Location IEN, #4 (if defined gives User's DSS units for a"
^XWB(8994,911,2,1,1,4,0)="location)"
^XWB(8994,911,2,1,1,5,0)=" "
^XWB(8994,911,2,1,1,6,0)="  2. ECDUZ    - New Person IEN, #200 (if defined gives list of DSS"
^XWB(8994,911,2,1,1,7,0)="Units available to user)"
^XWB(8994,911,2,1,1,8,0)="  "
^XWB(8994,911,2,1,1,9,0)="  3. ECSUMUSR - Set if getting DSS units for the print category and "
^XWB(8994,911,2,1,1,10,0)="procedure summary report (optional)"
^XWB(8994,911,2,1,1,11,0)=" "
^XWB(8994,911,2,1,1,12,0)="  4. ECDUST   - DSS unit status (Active/Inactive/Both) if getting units "
^XWB(8994,911,2,1,1,13,0)="for the print category and procedure summary report (optional)"
^XWB(8994,911,2,"B","ECARY",1)=""
^XWB(8994,911,3,0)="^8994.03^7^7^3180305^^^"
^XWB(8994,911,3,1,0)="Returns an array of DSS Units. Data pieces separated by an up-arrow as "
^XWB(8994,911,3,2,0)="follows:-"
^XWB(8994,911,3,3,0)=" "
^XWB(8994,911,3,4,0)="   1. IEN of file 724"
^XWB(8994,911,3,5,0)="   2. Name of DSS Unit"
^XWB(8994,911,3,6,0)="   3. Send to PCE Flag"
^XWB(8994,911,3,7,0)="   4. Data entry date/time default"
^XWB(8994,912,0)="EC GETCPTLST^CPTFND^ECUMRPC2^4^S^^^1"
^XWB(8994,912,1,0)="^8994.01^2^2^3010503^^^^"
^XWB(8994,912,1,1,0)="Performs a search on a CPT string and returns an array list of matches from "
^XWB(8994,912,1,2,0)="file #81."
^XWB(8994,912,2,0)="^8994.02A^1^1"
^XWB(8994,912,2,1,0)="ECARY^1^^1"
^XWB(8994,912,2,1,1,0)="^8994.021^1^1^3010502^^^^"
^XWB(8994,912,2,1,1,1,0)="CPT search string."
^XWB(8994,912,2,"B","ECARY",1)=""
^XWB(8994,912,3,0)="^8994.03^1^1^3010502^^^^"
^XWB(8994,912,3,1,0)="Returns a global array with CPT IEN, code and name respectively."
^XWB(8994,913,0)="EC GETECSPROCS^PROC^ECUERPC^4^R^^^1"
^XWB(8994,913,1,0)="^8994.01^2^2^3010503^^^^"
^XWB(8994,913,1,1,0)="Returns an array of procedures for an Event Code screen (file #720.3). Event"
^XWB(8994,913,1,2,0)="code screens are based on location, DSS unit and Category."
^XWB(8994,913,2,0)="^8994.02A^1^1"
^XWB(8994,913,2,1,0)="ECARY^1^^1"
^XWB(8994,913,2,1,1,0)="^8994.021^4^4^3010503^^^^"
^XWB(8994,913,2,1,1,1,0)="Input variable ECARY contains the following values separated by up-arrow."
^XWB(8994,913,2,1,1,2,0)="  1.  ECL  - Location IEN"
^XWB(8994,913,2,1,1,3,0)="  2.  ECD  - DSS Unit IEN"
^XWB(8994,913,2,1,1,4,0)="  3.  ECC  - Category IEN"
^XWB(8994,913,2,"B","ECARY",1)=""
^XWB(8994,913,3,0)="^8994.03^6^6^3010503^^^^"
^XWB(8994,913,3,1,0)="Returns an array of procedures. Data pieces as follows:-"
^XWB(8994,913,3,2,0)="   1.  EC National Number SPACE Procedure Name SPACE [Synonym]"
^XWB(8994,913,3,3,0)="   2.  Procedure Code"
^XWB(8994,913,3,4,0)="   3.  CPT Code"
^XWB(8994,913,3,5,0)="   4.  Default volume"
^XWB(8994,913,3,6,0)="   5.  Event code screen IEN"
^XWB(8994,914,0)="EC GETECSCATS^CAT^ECUERPC^4^A^^^1"
^XWB(8994,914,1,0)="^8994.01^2^2^3180305^^^^"
^XWB(8994,914,1,1,0)="Returns an array of categories for an Event Code screen based on a specific"
^XWB(8994,914,1,2,0)="location and DSS unit."
^XWB(8994,914,2,0)="^8994.02A^1^1"
^XWB(8994,914,2,1,0)="ECARY^1^^1"
^XWB(8994,914,2,1,1,0)="^^4^4^3180305^"
^XWB(8994,914,2,1,1,1,0)="Input variable ECARY contains the following values separated by up-arrow."
^XWB(8994,914,2,1,1,2,0)="  1. ECL    - Location IEN"
^XWB(8994,914,2,1,1,3,0)="  2. ECD    - DSS Unit IEN"
^XWB(8994,914,2,1,1,4,0)="  3. ECCSTA - Category status, A-ctive (default), I-nactive, B-oth"
^XWB(8994,914,2,"B","ECARY",1)=""
^XWB(8994,914,3,0)="^8994.03^3^3^3010503^^^"
^XWB(8994,914,3,1,0)="Returns an array of categories with data pieces as follows:-"
^XWB(8994,914,3,2,0)="  1.  Category IEN"
^XWB(8994,914,3,3,0)="  2.  Category description"
^XWB(8994,915,0)="EC GETBATPROCS^PROCBAT^ECUERPC1^4^R^^^1"
^XWB(8994,915,1,0)="^8994.01^2^2^3011029^^^^"
^XWB(8994,915,1,1,0)="Returns an array with entries from EVENT CAPTURE PATIENT FILE #721 for "
^XWB(8994,915,1,2,0)="patients for a specific procedure."
^XWB(8994,915,2,0)="^8994.02A^1^1"
^XWB(8994,915,2,1,0)="ECARY^1^^1"
^XWB(8994,915,2,1,1,0)="^8994.021^7^7^3011029^^^^"
^XWB(8994,915,2,1,1,1,0)="Input variable ECARY contains the following values separated by up-arrows:-"
^XWB(8994,915,2,1,1,2,0)="  1. ECLOC - Location ien"
^XWB(8994,915,2,1,1,3,0)="  2. ECUNT - DSS unit ien"
^XWB(8994,915,2,1,1,4,0)="  3. ECC   - Category ien"
^XWB(8994,915,2,1,1,5,0)="  4. ECP   - Procedure ien"
^XWB(8994,915,2,1,1,6,0)="  5. ECSD  - Start Date"
^XWB(8994,915,2,1,1,7,0)="  6. ECED  - End Date"
^XWB(8994,915,2,"B","ECARY",1)=""
^XWB(8994,915,3,0)="^8994.03^4^4^3011029^^^^"
^XWB(8994,915,3,1,0)="Returns an array of Event Capture Patients with the following data:-"
^XWB(8994,915,3,2,0)="  1. 721 IEN                    4. Primary Diagnosis"
^XWB(8994,915,3,3,0)="  2. Patient name               5. Ordering Section"
^XWB(8994,915,3,4,0)="  3. Procedure Date and Time    6. Associated Clinic"
^XWB(8994,916,0)="EC REPORTS^RPTEN^ECRRPC^4^R^^^1"
^XWB(8994,916,1,0)="^8994.01^2^2^3010503^^^^"
^XWB(8994,916,1,1,0)="This call is used by all Event Capture GUI reports.  Produces report based on"
^XWB(8994,916,1,2,0)="option selected from the Delphi application."
^XWB(8994,916,2,0)="^8994.02A^1^1"
^XWB(8994,916,2,1,0)="ECARY^2^^1"
^XWB(8994,916,2,1,1,0)="^8994.021^10^10^3010503^^^^"
^XWB(8994,916,2,1,1,1,0)="The input array ECARY will be defined based on the report to be generated. The"
^XWB(8994,916,2,1,1,2,0)="report handle or type must be defined.  It is also necessary to specify whether "
^XWB(8994,916,2,1,1,3,0)="the report will be printed to a device or displayed. The following is an example"
^XWB(8994,916,2,1,1,4,0)="of the variables defined for 'Patient Summary Report'."
^XWB(8994,916,2,1,1,5,0)="      ECARY(""ECDFN"")=170"
^XWB(8994,916,2,1,1,6,0)="      ECARY(""ECED"")=3010430"
^XWB(8994,916,2,1,1,7,0)="      ECARY(""ECHNDL"")=""ECPAT"""
^XWB(8994,916,2,1,1,8,0)="      ECARY(""ECPTYP"")=""D"""
^XWB(8994,916,2,1,1,9,0)="      ECARY(""ECRY"")=Y"
^XWB(8994,916,2,1,1,10,0)="      ECARY(""ECSD"")=3010401"
^XWB(8994,916,2,"B","ECARY",1)=""
^XWB(8994,916,3,0)="^8994.03^1^1^3010503^^^^"
^XWB(8994,916,3,1,0)="Returns the report or the task number if queued."
^XWB(8994,917,0)="EC GETIEN^FNDIEN^ECUURPC^1^A"
^XWB(8994,917,1,0)="^8994.01^1^1^3010503^^^^"
^XWB(8994,917,1,1,0)="Returns the IEN from a file."
^XWB(8994,917,2,0)="^8994.02A^2^2"
^XWB(8994,917,2,1,0)="ecary"
^XWB(8994,917,2,2,0)="ECARY^1^^1"
^XWB(8994,917,2,2,1,0)="^8994.021^3^3^3010503^^^^"
^XWB(8994,917,2,2,1,1,0)="Input variable ECARY contains the following elements"
^XWB(8994,917,2,2,1,2,0)="     1.  FIL  - File number"
^XWB(8994,917,2,2,1,3,0)="     2.  TXT  - .01 description"
^XWB(8994,917,2,"B","ECARY",2)=""
^XWB(8994,917,2,"B","ecary",1)=""
^XWB(8994,917,3,0)="^8994.03^1^1^3010503^^^^"
^XWB(8994,917,3,1,0)="Returns a file IEN."
^XWB(8994,918,0)="EC GETPATINFO^PATINF^ECUERPC1^4^R^^^1"
^XWB(8994,918,1,0)="^8994.01^2^2^3010503^^"
^XWB(8994,918,1,1,0)="This is a general purpose call that provides segments of the patient data "
^XWB(8994,918,1,2,0)="from the Event Capture Patient File #721."
^XWB(8994,918,2,0)="^8994.02A^1^1"
^XWB(8994,918,2,1,0)="ECARY^1^^1"
^XWB(8994,918,2,1,1,0)="^8994.021^8^8^3010503^^"
^XWB(8994,918,2,1,1,1,0)="The input variable ECARY contains the following values:-"
^XWB(8994,918,2,1,1,2,0)="    ECIEN - Event Capture Patient ien (#2)"
^XWB(8994,918,2,1,1,3,0)="    ECTYP - Data type to return"
^XWB(8994,918,2,1,1,4,0)="            Types are:-"
^XWB(8994,918,2,1,1,5,0)="            DXS - primary and secondary diagnosis codes"
^XWB(8994,918,2,1,1,6,0)="            MOD - modifiers"
^XWB(8994,918,2,1,1,7,0)="            CLASS - classification data"
^XWB(8994,918,2,1,1,8,0)="            OTH - other type data."
^XWB(8994,918,2,"B","ECARY",1)=""
^XWB(8994,918,3,0)="^8994.03^5^5^3010503^^"
^XWB(8994,918,3,1,0)="Base on the type data requested, returns either of the following."
^XWB(8994,918,3,2,0)="   DXS - primary and secondary diagnosis codes"
^XWB(8994,918,3,3,0)="   MOD - modifiers"
^XWB(8994,918,3,4,0)="   CLASS - classification data"
^XWB(8994,918,3,5,0)="   OTH - other type data."
^XWB(8994,919,0)="EC GETPXMODIFIER^ECPXMOD^ECUERPC^4^A^^^1"
^XWB(8994,919,1,0)="^8994.01^1^1^3010503^^^^"
