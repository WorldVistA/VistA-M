^XWB(8994,4375,3,10,0)=" For warning messages, the return will be List[n] = 0^message."
^XWB(8994,4376,0)="DSSO NPPD LIST^LIST^DSSOLN^4^^^^1"
^XWB(8994,4376,1,0)="^^4^4^3200225^"
^XWB(8994,4376,1,1,0)="This RPC takes in a date range and optional flex fields and returns the "
^XWB(8994,4376,1,2,0)="appropriate NPPD list.  The data is chunked, so multiple calls may need "
^XWB(8994,4376,1,3,0)="to be made utilizing a new date as well as an IEN returned by the "
^XWB(8994,4376,1,4,0)="preceding call."
^XWB(8994,4376,2,0)="^8994.02A^6^6"
^XWB(8994,4376,2,1,0)="DSSODATE1^1^7^1^1"
^XWB(8994,4376,2,1,1,0)="^^4^4^3200225^"
^XWB(8994,4376,2,1,1,1,0)="Start Date"
^XWB(8994,4376,2,1,1,2,0)=" "
^XWB(8994,4376,2,1,1,3,0)="NOTE: This date should be set to the value returned by the preceding call "
^XWB(8994,4376,2,1,1,4,0)="in the event that chunking is necessary."
^XWB(8994,4376,2,2,0)="DSSODATE2^1^7^1^2"
^XWB(8994,4376,2,2,1,0)="^^1^1^3180813^"
^XWB(8994,4376,2,2,1,1,0)="End Date"
