^XWB(8994,2707,0)="ORAMSET GETCLINS^GETCLINS^ORAMSET^2^S^^^0"
^XWB(8994,2707,1,0)="^^2^2^3090306^"
^XWB(8994,2707,1,1,0)="This RPC fetches the list of Clinic Names from the configuration of the "
