^XWB(8994,4051,2,3,1,0)="^^4^4^3140904^"
^XWB(8994,4051,2,3,1,1,0)="START"
^XWB(8994,4051,2,3,1,2,0)=" "
^XWB(8994,4051,2,3,1,3,0)="The seed to start the search (usually the last file # from the last run "
