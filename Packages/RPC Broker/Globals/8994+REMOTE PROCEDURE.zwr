^XWB(8994,2762,1,14,0)="+---------------------------------------------------------------+"
^XWB(8994,2762,1,15,0)=" "
^XWB(8994,2762,1,16,0)="UPDATES TELEREADER ACQUISITION SERVICE file (#2006.5841)"
^XWB(8994,2762,2,0)="^8994.02A^1^1"
^XWB(8994,2762,2,1,0)="MAGPARAM^2^^1^1"
^XWB(8994,2762,2,1,1,0)="^8994.021^12^12^3120418^^"
^XWB(8994,2762,2,1,1,1,0)="Delete action:"
^XWB(8994,2762,2,1,1,2,0)=" MAGPARAM(""ACTION"")           = ""DELETE"""
^XWB(8994,2762,2,1,1,3,0)=" MAGPARAM(""IEN"")              = IEN of the record that will be deleted"
^XWB(8994,2762,2,1,1,4,0)="Add or Update action:"
^XWB(8994,2762,2,1,1,5,0)=" MAGPARAM(""ACTION"")           = ""ADD"" or ""UPDATE"""
^XWB(8994,2762,2,1,1,6,0)=" MAGPARAM(""NAME"")             = A pointer to REQUEST SERVICES file (#123.5)"
^XWB(8994,2762,2,1,1,7,0)=" MAGPARAM(""PROCEDURE"")        = A pointer to GMRC PROCEDURE file (#123.3)"
^XWB(8994,2762,2,1,1,8,0)=" MAGPARAM(""SPECIALTY INDEX"")  = A pointer to the SPECIALTY file (#2005.84)"
^XWB(8994,2762,2,1,1,9,0)=" MAGPARAM(""PROCEDURE INDEX"")  = A pointer to the PROCEDURE/EVENT file (#2005.85)"
^XWB(8994,2762,2,1,1,10,0)=" MAGPARAM(""ACQUISITION SITE"") = A pointer to the INSTITUTION file (#4) "
^XWB(8994,2762,2,1,1,11,0)=" MAGPARAM(""UNREAD LIST CREATION TRIGGER"") = I/O/F"
^XWB(8994,2762,2,1,1,12,0)=" MAGPARAM(""TIU NOTE FILE"")    = A pointer to TIU DOCUMENT file (#8925.1)"
^XWB(8994,2762,2,"B","MAGPARAM",1)=""
^XWB(8994,2762,2,"PARAMSEQ",1,1)=""
^XWB(8994,2762,3,0)="^8994.03^3^3^3120418^^"
^XWB(8994,2762,3,1,0)="if error MAGRY = ""0^Error"""
^XWB(8994,2762,3,2,0)="if success MAGRY = ""1^IEN"" - IEN of the record that is updated"
^XWB(8994,2762,3,3,0)="                              or IEN of the added record"
^XWB(8994,2763,0)="MAG3 TELEREADER DHPS LIST^LDHSP^MAGNTLR2^2^R^0"
^XWB(8994,2763,1,0)="^8994.01^16^16^3120522^^"
^XWB(8994,2763,1,1,0)="Per VHA Directive 2004-038, this RPC should not be modified."
^XWB(8994,2763,1,2,0)="+---------------------------------------------------------------+"
^XWB(8994,2763,1,3,0)="| Property of the US Government.                                |"
^XWB(8994,2763,1,4,0)="| No permission to copy or redistribute this software is given. |"
^XWB(8994,2763,1,5,0)="| Use of unreleased versions of this software requires the user |"
^XWB(8994,2763,1,6,0)="| to execute a written test agreement with the VistA Imaging    |"
^XWB(8994,2763,1,7,0)="| Development Office of the Department of Veterans Affairs,     |"
^XWB(8994,2763,1,8,0)="| telephone (301) 734-0100.                                     |"
^XWB(8994,2763,1,9,0)="| The Food and Drug Administration classifies this software as  |"
^XWB(8994,2763,1,10,0)="| a medical device.  As such, it may not be changed in any way. |"
^XWB(8994,2763,1,11,0)="| Modifications to this software may result in an adulterated   |"
^XWB(8994,2763,1,12,0)="| medical device under 21CFR820, the use of which is considered |"
^XWB(8994,2763,1,13,0)="| to be a violation of US Federal Statutes.                     |"
^XWB(8994,2763,1,14,0)="+---------------------------------------------------------------+"
^XWB(8994,2763,1,15,0)=" "
^XWB(8994,2763,1,16,0)=" Return all records in CLINICAL SPECIALTY DICOM & HL7 file (#2006.5831)"
^XWB(8994,2763,3,0)="^8994.03^10^10^3120522^^"
^XWB(8994,2763,3,1,0)="if error found during execution"
^XWB(8994,2763,3,2,0)="  MAGRY(0) = ""0^Error"""
^XWB(8994,2763,3,3,0)="if success"
^XWB(8994,2763,3,4,0)="   MAGRY(0)    = ""1^#CNT"" - where #CNT is a number of records returned"
^XWB(8994,2763,3,5,0)="   MAGRY(1)    = ""IEN^Requested Service ID^Requested Service^Procedure ID^Procedure^"
^XWB(8994,2763,3,6,0)="                   Specialty Index ID^Specialty Index^Procedure Index ID^Procedure Index"
^XWB(8994,2763,3,7,0)=" CPT CODE ID^CPT CODE^HL7 SUBSCRIBER ID^HL7 SUBSCRIBER^Clinic"""
^XWB(8994,2763,3,8,0)="   MAGRY(2..n) = ""^"" delimited string with values of fields listed in MAGRY(1)"
^XWB(8994,2763,3,9,0)=" "
^XWB(8994,2763,3,10,0)="   Clinic column is tilda (~) delimited - Clinic ID~Clinic;.... "
^XWB(8994,2764,0)="MAG3 TELEREADER PDR SRVC SETUP^UPSRVC^MAGNTLRS^1^R"
^XWB(8994,2764,1,0)="^^1^1^3090807^"
^XWB(8994,2764,1,1,0)="Add/Update/Delete a service in DICOM HEALTHCARE PROVIDER SERVICE file (#2006.5831)"
^XWB(8994,2764,2,0)="^8994.02A^1^1"
^XWB(8994,2764,2,1,0)="MAGPARAM^2^^1"
^XWB(8994,2764,2,"B","MAGPARAM",1)=""
^XWB(8994,2765,0)="MAG3 TELEREADER READER LIST^LREADER^MAGNTLR2^2^R"
^XWB(8994,2765,1,0)="^8994.01^1^1^3090731^"
^XWB(8994,2765,1,1,0)="Return all records in TELEREADER READER file (#2006.5843)"
^XWB(8994,2766,0)="MAG3 TELEREADER READER SETUP^UREADER^MAGNTLRS^1^R"
^XWB(8994,2766,1,0)="^^1^1^3090804^"
^XWB(8994,2766,1,1,0)="Add/Update/Delete TELEREADER READER file (#2006.5843)"
^XWB(8994,2766,2,0)="^8994.02A^1^1"
^XWB(8994,2766,2,1,0)="MAGPARAM^2^^1^1"
^XWB(8994,2766,2,"B","MAGPARAM",1)=""
^XWB(8994,2766,2,"PARAMSEQ",1,1)=""
^XWB(8994,2767,0)="MAG3 TELEREADER SITE SETUP^USITE^MAGNTLRS^1^R"
^XWB(8994,2767,1,0)="^^1^1^3090730^"
^XWB(8994,2767,1,1,0)=" Add/Update/Delete a site in TELEREADER ACQUISITION SITE file (#2006.5842)"
^XWB(8994,2767,2,0)="^8994.02A^1^1"
^XWB(8994,2767,2,1,0)="MAGPARAM^2^^1^1"
^XWB(8994,2767,2,"B","MAGPARAM",1)=""
^XWB(8994,2767,2,"PARAMSEQ",1,1)=""
^XWB(8994,2768,0)="MAGDDR GETS ENTRY DATA^GETSC^MAGDDR^2^R"
^XWB(8994,2768,1,0)="^^1^1^3090918^"
^XWB(8994,2768,1,1,0)="Calls database server at GETS^DIQ"
^XWB(8994,2768,2,0)="^8994.02A^1^1"
^XWB(8994,2768,2,1,0)="MAGDDR^2^^1^1"
^XWB(8994,2768,2,1,1,0)="^^1^1^3090918^"
^XWB(8994,2768,2,1,1,1,0)="GETS ATTRIBUTES"
^XWB(8994,2768,2,"B","MAGDDR",1)=""
^XWB(8994,2768,2,"PARAMSEQ",1,1)=""
^XWB(8994,2769,0)="MAGDDR LISTER^LISTC^MAGDDR^4^R^^^1"
^XWB(8994,2769,2,0)="^8994.02A^1^1"
^XWB(8994,2769,2,1,0)="LIST ATTRIBUTES^2^512^1"
^XWB(8994,2769,2,"B","LIST ATTRIBUTES",1)=""
^XWB(8994,2836,0)="DSIV GET EIV PATIENT REPORT^PIIV^DSIVIC3^4^^^^1"
^XWB(8994,2836,1,0)="^^2^2^3100622^"
^XWB(8994,2836,1,1,0)="Returns one to many patient eIV reports from the Insurance Type multiple "
^XWB(8994,2836,1,2,0)="in the patient file."
^XWB(8994,2836,2,0)="^8994.02A^2^2"
^XWB(8994,2836,2,1,0)="DFN^1^30^1^1"
^XWB(8994,2836,2,1,1,0)="^^1^1^3100622^"
^XWB(8994,2836,2,1,1,1,0)="Patient DFN (ien)."
^XWB(8994,2836,2,2,0)="DSIVPATP^1^10^0^2"
^XWB(8994,2836,2,2,1,0)="^^4^4^3100622^"
^XWB(8994,2836,2,2,1,1,0)="Contains the pointer to the patient policy IEN from the Insurance Type "
^XWB(8994,2836,2,2,1,2,0)="multiple of the PATIENT file.  If sent, then the single eIV report for "
^XWB(8994,2836,2,2,1,3,0)="that policy will be returned, if not sent then all policy entries will be "
^XWB(8994,2836,2,2,1,4,0)="returned with any eIV report they might contain."
^XWB(8994,2836,2,"B","DFN",1)=""
^XWB(8994,2836,2,"B","DSIVPATP",2)=""
^XWB(8994,2836,2,"PARAMSEQ",1,1)=""
^XWB(8994,2836,2,"PARAMSEQ",2,2)=""
^XWB(8994,2836,3,0)="^^8^8^3100622^"
^XWB(8994,2836,3,1,0)="Returns the following patient policy eIV report data in a global array:"
^XWB(8994,2836,3,2,0)=" array(1)=""$$PTPOL$$1""  (1=pt policy ien in this example)"
^XWB(8994,2836,3,3,0)=" array(2)=""$$INS$$27^BLUE CROSS BLUE SHIELD"" (policy ins co ien^name)"
^XWB(8994,2836,3,4,0)=" array(3)=""$$GRP$$15^PENN WORKERS"" (group ien^name)"
^XWB(8994,2836,3,5,0)=" array(4+)= 2.322^.02^Active Coverage^ELIGIBILITY/BENEFIT INFO "
^XWB(8994,2836,3,6,0)="            (file#^field#^data^fieldname)"
^XWB(8994,2836,3,7,0)=" or       = 2.3226^1^.03^555-9090^COMMUNICATION NUMBER "
^XWB(8994,2836,3,8,0)="            (file#^subfile entry#^field#^data^fieldname)"
^XWB(8994,2837,0)="NHIN GET VISTA DATA^GET^NHINV^4^S^^^1^^^1"
^XWB(8994,2837,1,0)="^8994.01^2^2^3100329^^^"
^XWB(8994,2837,1,1,0)="This RPC retrieves the requested data from VistA, and returns it in"
^XWB(8994,2837,1,2,0)="^TMP($J,""NHINV"",n) as XML."
^XWB(8994,2837,2,0)="^8994.02A^6^6"
^XWB(8994,2837,2,1,0)="DFN^1^20^1^1"
^XWB(8994,2837,2,1,1,0)="^8994.021^2^2^3100203^^"
^XWB(8994,2837,2,1,1,1,0)="Internal entry number from Patient file #2"
^XWB(8994,2837,2,1,1,2,0)="[optionally DFN;ICN for remote calls]"
^XWB(8994,2837,2,2,0)="TYPE^1^100^0^2"
^XWB(8994,2837,2,2,1,0)="^8994.021^3^3^3100203^^"
^XWB(8994,2837,2,2,1,1,0)="The kind(s) of data to return, which may include:"
^XWB(8994,2837,2,2,1,2,0)="  patient;allergy;problem;vital;lab;med;xray;"
^XWB(8994,2837,2,2,1,3,0)="  consult;procedure;surgery;document;encounter"
^XWB(8994,2837,2,3,0)="START^1^20^0^3"
^XWB(8994,2837,2,3,1,0)="^8994.021^1^1^3100203^^"
^XWB(8994,2837,2,3,1,1,0)="The date/time from which to begin searching for data [optional]."
^XWB(8994,2837,2,4,0)="STOP^1^20^0^4"
^XWB(8994,2837,2,4,1,0)="^8994.021^1^1^3100203^^"
^XWB(8994,2837,2,4,1,1,0)="The date/time at which to end searching for data [optional]."
^XWB(8994,2837,2,5,0)="MAX^1^7^0^5"
^XWB(8994,2837,2,5,1,0)="^8994.021^1^1^3100203^^"
^XWB(8994,2837,2,5,1,1,0)="The maximum number of items to return per data type [optional]."
^XWB(8994,2837,2,6,0)="ITEM^1^30^0^6"
^XWB(8994,2837,2,6,1,0)="^8994.021^2^2^3100329^^^"
^XWB(8994,2837,2,6,1,1,0)="The identifier of a single item to return [optional, but TYPE must"
^XWB(8994,2837,2,6,1,2,0)="also be defined when used]."
^XWB(8994,2837,2,"B","DFN",1)=""
^XWB(8994,2837,2,"B","ITEM",6)=""
^XWB(8994,2837,2,"B","MAX",5)=""
^XWB(8994,2837,2,"B","START",3)=""
^XWB(8994,2837,2,"B","STOP",4)=""
^XWB(8994,2837,2,"B","TYPE",2)=""
^XWB(8994,2837,2,"PARAMSEQ",1,1)=""
^XWB(8994,2837,2,"PARAMSEQ",2,2)=""
^XWB(8994,2837,2,"PARAMSEQ",3,3)=""
^XWB(8994,2837,2,"PARAMSEQ",4,4)=""
^XWB(8994,2837,2,"PARAMSEQ",5,5)=""
^XWB(8994,2837,2,"PARAMSEQ",6,6)=""
^XWB(8994,2837,3,0)="^8994.03^1^1^3100329^^^^"
^XWB(8994,2837,3,1,0)="Text array formatted as XML"
^XWB(8994,2838,0)="EDPCTRL RPC^RPC^EDPCTRL^2^R^^^^1^^0"
^XWB(8994,2838,1,0)="^8994.01^5^5^3090506^^"
^XWB(8994,2838,1,1,0)="This RPC acts as the ""front controller"" for the EDIS Tracking Application."
^XWB(8994,2838,1,2,0)="It accepts requests that are initially passed into a web server.  The RPC"
^XWB(8994,2838,1,3,0)="uses the parameters that are passed in to determine which command to "
^XWB(8994,2838,1,4,0)="execute.  The returned data is formatted as XML.  The XML structure varies"
^XWB(8994,2838,1,5,0)="based a what data were requested."
^XWB(8994,2838,2,0)="^8994.02A^1^1"
^XWB(8994,2838,2,1,0)="PARAMS^2^^1^1"
^XWB(8994,2838,2,1,1,0)="^8994.021^2^2^3090506^^"
^XWB(8994,2838,2,1,1,1,0)="This is a list of parameters that were passed to the Java middle tier via "
^XWB(8994,2838,2,1,1,2,0)="an HTTP Post message."
^XWB(8994,2838,2,"B","PARAMS",1)=""
^XWB(8994,2838,2,"B","REQ",1)=""
^XWB(8994,2838,2,"PARAMSEQ",1,1)=""
^XWB(8994,2838,3,0)="^8994.03^1^1^3090506^^"
^XWB(8994,2838,3,1,0)="The return results are formatted as an XML document."
^XWB(8994,2839,0)="EDPCBRD RPC^RPC^EDPCBRD^2^R^^^^^^1"
^XWB(8994,2839,1,0)="^^8^8^3080307^"
^XWB(8994,2839,1,1,0)="This RPC acts as the ""front controller"" for the EDIS Display Board.  It "
^XWB(8994,2839,1,2,0)="accepts requests that are initially passed into a web server.  The RPC "
^XWB(8994,2839,1,3,0)="uses the parameters that are passed in to determine which command to "
^XWB(8994,2839,1,4,0)="execute.  The returned data is formatted as XML.  The XML structure "
^XWB(8994,2839,1,5,0)="varies based a what data were requested."
^XWB(8994,2839,1,6,0)=" "
^XWB(8994,2839,1,7,0)="Since the Display Board runs in a ""kiosk"" mode, this RPC allows proxy "
^XWB(8994,2839,1,8,0)="user access."
^XWB(8994,2839,2,0)="^8994.02A^2^2"
^XWB(8994,2839,2,1,0)="SESS^1^^1^1"
^XWB(8994,2839,2,1,1,0)="^^3^3^3080307^"
^XWB(8994,2839,2,1,1,1,0)="This identifies the user and site that are passed in from the Java middle "
^XWB(8994,2839,2,1,1,2,0)="tier.  In cases when the display board is running with a proxy user (in "
^XWB(8994,2839,2,1,1,3,0)="kiosk mode), the SSL configuration will determine the user and site."
^XWB(8994,2839,2,2,0)="PARAMS^2^^^2"
^XWB(8994,2839,2,2,1,0)="^^2^2^3080307^"
^XWB(8994,2839,2,2,1,1,0)="This is a list of parameters that were passed to the Java middle tier via "
^XWB(8994,2839,2,2,1,2,0)="an HTTP Post message."
^XWB(8994,2839,2,"B","PARAMS",2)=""
^XWB(8994,2839,2,"B","SESS",1)=""
^XWB(8994,2839,2,"PARAMSEQ",1,1)=""
^XWB(8994,2839,2,"PARAMSEQ",2,2)=""
^XWB(8994,2839,3,0)="^^1^1^3080307^"
^XWB(8994,2839,3,1,0)="The return results are formatted as an XML document."
^XWB(8994,2850,0)="ROR GET M VERSION^VERSRV^RORUTL11^1^R"
^XWB(8994,2850,1,0)="^^3^3^3101220^"
^XWB(8994,2850,1,1,0)="Used by CCR to return an agreed-upon version number to the GUI "
^XWB(8994,2850,1,2,0)="application.  The GUI will analyze the version number and display a "
^XWB(8994,2850,1,3,0)="message if the client and server are out of sync."
^XWB(8994,2851,0)="VAFC AA UPDATE^AAUPD^VAFCRPC^1^P^0^^^1"
^XWB(8994,2851,1,0)="^^2^2^3100811^"
^XWB(8994,2851,1,1,0)="This remote procedure call will update assigning authority passed in by "
^XWB(8994,2851,1,2,0)="MPI to VAFC ASSIGNING AUTHORITY file #391.92."
^XWB(8994,2851,2,0)="^8994.02A^2^1"
^XWB(8994,2851,2,2,0)="ARRAA^2^2000^1^1"
^XWB(8994,2851,2,2,1,0)="^^6^6^3100811^"
^XWB(8994,2851,2,2,1,1,0)="ARRAA may contain the following values:"
^XWB(8994,2851,2,2,1,2,0)="The values are passed into this RPC from the Master Patient Index (MPI)."
^XWB(8994,2851,2,2,1,3,0)=" "
^XWB(8994,2851,2,2,1,4,0)="     ARRAA(""HL7V2_4"")= value for HL7V2_4 (#.02) field AND/OR"
^XWB(8994,2851,2,2,1,5,0)="     ARRAA(""HL7V3_0"")= value for HL7V3_0 (#.03) field"
^XWB(8994,2851,2,2,1,6,0)="     ARRAA(""SOURCEID"")= value for DEFAULT SOURCE ID TYPE (#.04) field"
^XWB(8994,2851,2,"B","ARRAA",2)=""
^XWB(8994,2851,2,"PARAMSEQ",1,2)=""
^XWB(8994,2852,0)="MPI EVENT LIST^LINKDATA^MPIRPC^2^R^0^^1^1^^1"
^XWB(8994,2852,1,0)="^8994.01^5^5^3100730^^"
^XWB(8994,2852,1,1,0)="This RPC is used to return the list of all LINK and DO NOT LINK records "
^XWB(8994,2852,1,2,0)="associated with the ICN list passed as input.  The DO NOT LINK list will "
^XWB(8994,2852,1,3,0)="be derived from the records in the MPI DO NOT LINK file (#985.28) and "
^XWB(8994,2852,1,4,0)="pulled using the GET^MPIDNL API. The LINK list will be built from PRIMARY"
^XWB(8994,2852,1,5,0)="ICN values associated with any of the ICNs in the input list."
^XWB(8994,2852,2,0)="^8994.02A^1^1"
^XWB(8994,2852,2,1,0)="SOURCEID^1^200^1^1"
^XWB(8994,2852,2,1,1,0)="^8994.021^13^13^3100730^^"
^XWB(8994,2852,2,1,1,1,0)="This parameter is a list of ICN/VPID's that IMDQ Toolkit will provide to"
^XWB(8994,2852,2,1,1,2,0)="get a listing of all of the related LINK and DO NOT LINK events.  The"
^XWB(8994,2852,2,1,1,3,0)="format of this parameter is as follows:"
^XWB(8994,2852,2,1,1,4,0)=" "
^XWB(8994,2852,2,1,1,5,0)="ICNLIST - LIST OF ICN'S"
^XWB(8994,2852,2,1,1,6,0)=" "
^XWB(8994,2852,2,1,1,7,0)=" Format:"
^XWB(8994,2852,2,1,1,8,0)="A comma delimited list of Source IDs, each Source ID in the format: "
^XWB(8994,2852,2,1,1,9,0)="ICN/VPID|SourceSytemID|SourceAssigningAuthority|IDType"
^XWB(8994,2852,2,1,1,10,0)=" "
^XWB(8994,2852,2,1,1,11,0)=" Example: "
^XWB(8994,2852,2,1,1,12,0)="1001170718V338193|200M|USVHA|NI,101178194V591076|200M|USVHA|NI,1008521877V"
^XWB(8994,2852,2,1,1,13,0)="768382|200M|USVHA|NI,1008522314V828468|200M|USVHA|NI"
^XWB(8994,2852,2,"B","SOURCEID",1)=""
^XWB(8994,2852,2,"PARAMSEQ",1,1)=""
^XWB(8994,2852,3,0)="^^27^27^3100730^"
^XWB(8994,2852,3,1,0)="The return value is a list of records that the given record should not be"
^XWB(8994,2852,3,2,0)="linked too as well as a list of ICN's that the given ICN has in it's LINK "
^XWB(8994,2852,3,3,0)="history."
^XWB(8994,2852,3,4,0)=" "
^XWB(8994,2852,3,5,0)="Format:"
^XWB(8994,2852,3,6,0)=" "
^XWB(8994,2852,3,7,0)="  requested ICN/VPID|SourceSystemID|SourceAssigningAuthority|IDType|IDState"
^XWB(8994,2852,3,8,0)="    ^LINK^linked Record|SourceSystemID|SourceAssigningAuthority|IDType|IDState"
^XWB(8994,2852,3,9,0)=" "
^XWB(8994,2852,3,10,0)="and/or"
^XWB(8994,2852,3,11,0)=" "
^XWB(8994,2852,3,12,0)="  requested ICN/VPID|SourceSystemID|SourceAssigningAuthority|IDType"
^XWB(8994,2852,3,13,0)="    ^DO NOT LINK^record ID^SourceSystemID^SourceAssigningAuthority^IDType"
^XWB(8994,2852,3,14,0)=" "
^XWB(8994,2852,3,15,0)="Example: "
^XWB(8994,2852,3,16,0)=" "
^XWB(8994,2852,3,17,0)=" RETURN(1)=123456789V123456|200M|USVHA|NI|T"
^XWB(8994,2852,3,18,0)="             ^LINK^1111111111V111111|200M|USVHA|NI|D"
^XWB(8994,2852,3,19,0)=" RETURN(2)=123456789V123456|200M|USVHA|NI|T"
^XWB(8994,2852,3,20,0)="             ^LINK^2222222222V222222|200M|USVHA|NI|D"
^XWB(8994,2852,3,21,0)=" RETURN(3)=123456789V123456|200M|USVHA|NI|T"
^XWB(8994,2852,3,22,0)="             ^LINK^3333333333V333333|200M|USVHA|NI|D"
^XWB(8994,2852,3,23,0)=" RETURN(4)=123456789V123456|200M|USVHA|NI"
^XWB(8994,2852,3,24,0)="             ^DO NOT LINK^5555555555V555555^200M^USVHA^NI"
^XWB(8994,2852,3,25,0)=" RETURN(5)=234567890V234567|200M|USVHA|NI"
^XWB(8994,2852,3,26,0)="             ^DO NOT LINK^1234546^500^USVHA^PI"
^XWB(8994,2852,3,27,0)=" RETURN(n)=456789012V456789^..."
^XWB(8994,2853,0)="MAG FIND IMAGE TEXT FILE^FINDFIL^MAGDOD01^1^R^0^^0^.1"
^XWB(8994,2853,1,0)="^8994.01^18^18^3080429^^"
^XWB(8994,2853,1,1,0)="  +---------------------------------------------------------------+"
^XWB(8994,2853,1,2,0)="  | Property of the US Government.                                |"
^XWB(8994,2853,1,3,0)="  | No permission to copy or redistribute this software is given. |"
^XWB(8994,2853,1,4,0)="  | Use of unreleased versions of this software requires the user |"
^XWB(8994,2853,1,5,0)="  | to execute a written test agreement with the VistA Imaging    |"
^XWB(8994,2853,1,6,0)="  | Development Office of the Department of Veterans Affairs,     |"
^XWB(8994,2853,1,7,0)="  | telephone (301) 734-0100.                                     |"
^XWB(8994,2853,1,8,0)="  |                                                               |"
^XWB(8994,2853,1,9,0)="  | The Food and Drug Administration classifies this software as  |"
^XWB(8994,2853,1,10,0)="  | a medical device.  As such, it may not be changed in any way. |"
^XWB(8994,2853,1,11,0)="  | Modifications to this software may result in an adulterated   |"
^XWB(8994,2853,1,12,0)="  | medical device under 21CFR820, the use of which is considered |"
^XWB(8994,2853,1,13,0)="  | to be a violation of US Federal Statutes.                     |"
^XWB(8994,2853,1,14,0)="  +---------------------------------------------------------------+"
^XWB(8994,2853,1,15,0)=" "
^XWB(8994,2853,1,16,0)="This Remote Procedure allows the invoking client to use a filename "
^XWB(8994,2853,1,17,0)="(without extension) to find the path and nearest location of an image "
^XWB(8994,2853,1,18,0)="file."
^XWB(8994,2853,2,0)="^8994.02A^1^1"
^XWB(8994,2853,2,1,0)="FILENAME^1^199^1^1"
^XWB(8994,2853,2,1,1,0)="^8994.021^2^2^3080429^^"
^XWB(8994,2853,2,1,1,1,0)="The value of this parameter is the name of an image file, without path or "
^XWB(8994,2853,2,1,1,2,0)="extension."
^XWB(8994,2853,2,"B","FILENAME",1)=""
^XWB(8994,2853,2,"PARAMSEQ",1,1)=""
^XWB(8994,2853,3,0)="^^32^32^3080429^"
^XWB(8994,2853,3,1,0)="The return value of this remote procedure is a string."
^XWB(8994,2853,3,2,0)=" "
^XWB(8994,2853,3,3,0)="If the client is not authorized to call this remote procedure,"
^XWB(8994,2853,3,4,0)="input parameter value is not valid, or the image file is not found,"
^XWB(8994,2853,3,5,0)="the appropriate string will be returned from the following list in the "
^XWB(8994,2853,3,6,0)="second pipe-separated piece of the return value."
^XWB(8994,2853,3,7,0)=" "
^XWB(8994,2853,3,8,0)="   -12,No permission to call this Remote Procedure"
^XWB(8994,2853,3,9,0)="   -13,Image has been deleted"
^XWB(8994,2853,3,10,0)="   -21,Image file name must be specified"
^XWB(8994,2853,3,11,0)="   -22,Invalid filename format (no control characters allowed)"
^XWB(8994,2853,3,12,0)="   -23,Image filename not found on VistA"
^XWB(8994,2853,3,13,0)=" "
^XWB(8994,2853,3,14,0)="Otherwise, the first pipe-separated piece of the return value will be the"
^XWB(8994,2853,3,15,0)="internal entry number of the image found."
^XWB(8994,2853,3,16,0)="The second pipe-separated piece will either be the name of the text file"
^XWB(8994,2853,3,17,0)="for that image, including full path specification, or a negative number."
^XWB(8994,2853,3,18,0)="The third pipe-separated piece will be one of the following values,"
^XWB(8994,2853,3,19,0)="indicating the proximity of the nearest version of the file:"
^XWB(8994,2853,3,20,0)="   M:  magnetic"
^XWB(8994,2853,3,21,0)="   W:  WORM (jukebox)"
^XWB(8994,2853,3,22,0)="   A:  archive"
^XWB(8994,2853,3,23,0)="   O:  offline"
^XWB(8994,2853,3,24,0)="   I:  invalid/undeterminable"
^XWB(8994,2853,3,25,0)="The fourth pipe-separated piece will contain the value D if and only if "
^XWB(8994,2853,3,26,0)="there is a possible duplicate file with the same name."
^XWB(8994,2853,3,27,0)="The fifth pipe-separated piece will contain the value IQ if and only if "
^XWB(8994,2853,3,28,0)="there is a possible integrity problem with the file."
^XWB(8994,2853,3,29,0)="The sixth pipe-separated piece will contain 1 if there are any updatable "
^XWB(8994,2853,3,30,0)="fields on this image record, 0 otherwise.  Updatable fields include "
^XWB(8994,2853,3,31,0)="Series Instance UID, Image Instance UID, Document Date, DICOM Series, "
^XWB(8994,2853,3,32,0)="DICOM image number."
^XWB(8994,2854,0)="MAG STORAGE FETCH^FETCH^MAGSFTCH^2"
^XWB(8994,2854,1,0)="^8994.01^1^1^3100622^^^^"
^XWB(8994,2854,1,1,0)="This Remote Procedure allows the invoking client to copy or move image files"
^XWB(8994,2854,2,0)="^8994.02A^3^3"
^XWB(8994,2854,2,1,0)="MAGIEN^1^30^1"
^XWB(8994,2854,2,1,1,0)="^8994.021^1^1^3100622^^^"
^XWB(8994,2854,2,1,1,1,0)="<start IMAGE ien> | <stop IMAGE ien>"
^XWB(8994,2854,2,2,0)="DATE^1^10^1"
^XWB(8994,2854,2,2,1,0)="^8994.021^1^1^3100622^^^^"
^XWB(8994,2854,2,2,1,1,0)="<Start image saved date> | <Stop image saved date>"
^XWB(8994,2854,2,3,0)="NETLOC^1^30^0"
^XWB(8994,2854,2,3,1,0)="^^6^6^3100622^"
^XWB(8994,2854,2,3,1,1,0)="FROM - network location | TO - network location | REMOVE source file "
^XWB(8994,2854,2,3,1,2,0)="the first pipe-separated piece of the input value will be the"
^XWB(8994,2854,2,3,1,3,0)="internal entry number of source NETWORK LOCATION file (#2005.2)"
^XWB(8994,2854,2,3,1,4,0)="The second pipe-separated piece will be the internal entry number of destination"
^XWB(8994,2854,2,3,1,5,0)=" NETWORK LOCATION file (#2005.2)"
^XWB(8994,2854,2,3,1,6,0)="The third pipe-separated piece of input value will be the option for removing source image files (=1)"
^XWB(8994,2854,2,"B","DATE",2)=""
^XWB(8994,2854,2,"B","MAGIEN",1)=""
^XWB(8994,2854,2,"B","NETLOC",3)=""
^XWB(8994,2854,3,0)="^8994.03^8^8^3100622^^^^"
^XWB(8994,2854,3,1,0)="OUT is an array "
^XWB(8994,2854,3,2,0)=" "
^XWB(8994,2854,3,3,0)="OUT(1)= ""Ien1: Ien2, copy command line"" or ""0,Done"" or ""-1,Error"""
^XWB(8994,2854,3,4,0)="OUT(2) = DOS command to fetch the image file"
^XWB(8994,2854,3,5,0)="OUT(n) = DOS command to fetch the image file"
^XWB(8994,2854,3,6,0)=" "
^XWB(8994,2854,3,7,0)="The return value can be in <CODE>,<message>  or <IEN1:IEN2>,<DOS command> format."
^XWB(8994,2854,3,8,0)="The invoking client will check the <CODE> then execute <DOS command> "
^XWB(8994,2855,0)="MAG STORAGE FETCH SET^SETLOC^MAGSFTCH^2"
^XWB(8994,2855,1,0)="^8994.01^3^3^3100622^^^^"
^XWB(8994,2855,1,1,0)="Sets the network location pieces 3 and 4 of the IMAGE file (#2005) 0 node"
^XWB(8994,2855,1,2,0)="or update the WORM network location reference piece 5 in 0 node,"
^XWB(8994,2855,1,3,0)="or update the BIG file reference in ""FBIG"" node."
^XWB(8994,2855,2,0)="^8994.02A^2^2"
^XWB(8994,2855,2,1,0)="MAGIEN^1^10^1"
^XWB(8994,2855,2,1,1,0)="^^1^1^3041004^"
^XWB(8994,2855,2,1,1,1,0)="Image IEN"
^XWB(8994,2855,2,2,0)="NTLOC^1^5^1"
^XWB(8994,2855,2,2,1,0)="^8994.021^1^1^3100622^^^^"
^XWB(8994,2855,2,2,1,1,0)="IEN of NETWORK LOCATION file (#2005.2) to be set in IMAGE file (#2005)."
^XWB(8994,2855,2,"B","MAGIEN",1)=""
^XWB(8994,2855,2,"B","NTLOC",2)=""
^XWB(8994,2855,3,0)="^8994.03^4^4^3100622^^^^"
^XWB(8994,2855,3,1,0)="Array - "
^XWB(8994,2855,3,2,0)="   OUT(1) = 1 success"
^XWB(8994,2855,3,3,0)="            0 no action"
^XWB(8994,2855,3,4,0)="           -1 error"
^XWB(8994,2856,0)="MAG UTIL BKONLJB^BKONL^MAGSDOFL^2^R"
^XWB(8994,2856,1,0)="^8994.01^1^1^3100622^^^"
^XWB(8994,2856,1,1,0)="MAG UTIL BKONLJB - This Remote Procedure is used to track Offline Images. When insert Jukebox Platter, put images back Online stage."
^XWB(8994,2856,2,0)="^8994.02A^1^1"
^XWB(8994,2856,2,1,0)="MAGPLAT^1^15^1"
^XWB(8994,2856,2,1,1,0)="^8994.021^1^1^3100622^^^"
^XWB(8994,2856,2,1,1,1,0)="JB PLATTER LABEL(NAME) - UNDER OFFLINE IMAGES FILE (#2006.033)"
^XWB(8994,2856,2,"B","MAGPLAT",1)=""
^XWB(8994,2856,3,0)="^8994.03^1^1^3100622^^^"
^XWB(8994,2856,3,1,0)="0, Done (Total number of file entries set back online)"
^XWB(8994,2857,0)="MAG UTIL CLNLOC^NETLOC^MAGSDEL5^2^R"
^XWB(8994,2857,1,0)="^8994.01^13^13^3100622^^^^"
^XWB(8994,2857,1,1,0)="MAG UTILITY - Delete a Network Location that has no references to images."
^XWB(8994,2857,1,2,0)=" Input Parameters"
^XWB(8994,2857,1,3,0)="   IN : Network Location IEN"
^XWB(8994,2857,1,4,0)="   PLACE : User SITE PARAMETER IEN   "
^XWB(8994,2857,1,5,0)="   STEP : IEN range to run - format = <startIEN>#<endIEN>"
^XWB(8994,2857,1,6,0)=" "
^XWB(8994,2857,1,7,0)=" Output Parameter:"
^XWB(8994,2857,1,8,0)="   OUT : Array of results"
^XWB(8994,2857,1,9,0)=" "
^XWB(8994,2857,1,10,0)="RPC to delete a network location. "
^XWB(8994,2857,1,11,0)="If no image files are linked to the "
^XWB(8994,2857,1,12,0)="network location, the selected entry will be removed."
^XWB(8994,2857,1,13,0)=" "
^XWB(8994,2857,2,0)="^8994.02A^3^3"
^XWB(8994,2857,2,1,0)="IEN^1^6^1"
^XWB(8994,2857,2,1,1,0)="^8994.021^1^1^3081024^^"
^XWB(8994,2857,2,1,1,1,0)="NETWORK LOCATION IEN"
^XWB(8994,2857,2,2,0)="PLACE^1^2^1"
^XWB(8994,2857,2,2,1,0)="^^1^1^3081024^"
^XWB(8994,2857,2,2,1,1,0)="PLACE OF IMAGE SITE PARAMETERS"
^XWB(8994,2857,2,3,0)="STEP^1^^1"
^XWB(8994,2857,2,3,1,0)="^8994.021^2^2^3100622^^^^"
^XWB(8994,2857,2,3,1,1,0)="Used to create chunks of data(iens) for processing.  "
^XWB(8994,2857,2,3,1,2,0)="This is used to eliminate Broker timeouts during processing."
^XWB(8994,2857,2,"B","IEN",1)=""
^XWB(8994,2857,2,"B","PLACE",2)=""
^XWB(8994,2857,2,"B","STEP",3)=""
^XWB(8994,2857,3,0)="^8994.03^5^5^3100622^^^^"
^XWB(8994,2857,3,1,0)="<return code>,<informational message>"
^XWB(8994,2857,3,2,0)="    OUT(1) := '0,Done'"
^XWB(8994,2857,3,3,0)="              '-1,Network location cleanup with #2005 IMAGE file reference issue'"
^XWB(8994,2857,3,4,0)="              ' 1,Next# ien'  (to be continued)"
^XWB(8994,2857,3,5,0)="    OUT(n) := '-1,Found IMAGE 2005 IEN # which has a reference to NETWORK LOCATION #'"
^XWB(8994,2858,0)="MAG UTIL DT2IEN^DTRANGE^MAGSHEC^2^"
^XWB(8994,2858,1,0)="^8994.01^1^1^3100622^^^^"
^XWB(8994,2858,1,1,0)="This Remote Procedure uses a date range to find an IEN in the IMAGE File (#2005)"
