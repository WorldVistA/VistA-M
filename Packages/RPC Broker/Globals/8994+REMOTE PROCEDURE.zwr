^XWB(8994,2529,3,0)="^^11^11^3081006^"
^XWB(8994,2529,3,1,0)="This RPC will return a positive (1) or negative response (-1) in "
^XWB(8994,2529,3,2,0)="RETURN(1), in the following format: result^text result"
^XWB(8994,2529,3,3,0)=" "
^XWB(8994,2529,3,4,0)="Example output:"
^XWB(8994,2529,3,5,0)="   -1^Missing SourceID passed, missing ID"""
^XWB(8994,2529,3,6,0)="   -1^Missing SourceID passed, missing Assigning Location"
^XWB(8994,2529,3,7,0)="   -1^Missing SourceID passed, missing Assigning Authority"
^XWB(8994,2529,3,8,0)="   -1^Missing SourceID passed, missing Id Type"
^XWB(8994,2529,3,9,0)="   -1^error text"
^XWB(8994,2529,3,10,0)="      or"
^XWB(8994,2529,3,11,0)="    1^SUCCESSFUL"
^XWB(8994,2530,0)="MPIF EDAT REMOTE^MPIEDAT^MPIRPC^2^P^^^^1"
^XWB(8994,2530,1,0)="^^2^2^3080620^"
^XWB(8994,2530,1,1,0)="MPI Extended Patient data inquiry for Display Only Query. ICN needs to be "
^XWB(8994,2530,1,2,0)="passed in."
^XWB(8994,2530,2,0)="^8994.02A^1^1"
^XWB(8994,2530,2,1,0)="ICN^1^16^1^1"
^XWB(8994,2530,2,1,1,0)="^^1^1^3080620^"
