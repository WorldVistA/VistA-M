^XWB(8994,5015,0)="SDES2 GET INFO FOR VIDEO VISIT^GETVVSMAKEINFO^SDES2VVSJSON^2^R^^^^^^1"
^XWB(8994,5015,1,0)="^^4^4^3250214^"
^XWB(8994,5015,1,1,0)="Get patient info, default provider info, and system info needed to make a "
^XWB(8994,5015,1,2,0)=" Video Visit Service (VVS) appointment in JSON format."
^XWB(8994,5015,1,3,0)=" "
^XWB(8994,5015,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,5015,2,0)="^8994.02A^2^2"
^XWB(8994,5015,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,5015,2,1,1,0)="^^10^10^3240202^"
^XWB(8994,5015,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,5015,2,1,1,2,0)="              Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5015,2,1,1,3,0)="   SDCONTEXT(""PATIENT DFN"") = The DFN/IEN of the target patient from the"
^XWB(8994,5015,2,1,1,4,0)="              calling application."
^XWB(8994,5015,2,1,1,5,0)="   SDCONTEXT(""PATIENT ICN"") = The ICN of the target patient from the"
^XWB(8994,5015,2,1,1,6,0)="              calling application."
^XWB(8994,5015,2,1,1,7,0)="   SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action in the"
^XWB(8994,5015,2,1,1,8,0)="              calling application."
^XWB(8994,5015,2,1,1,9,0)="   SDCONTEXT(""USER SECID"") = The SECID of the user taking action in"
^XWB(8994,5015,2,1,1,10,0)="              the calling application."
^XWB(8994,5015,2,2,0)="SDINPUT^2^32000^1^2"
^XWB(8994,5015,2,2,1,0)="^8994.021^8^8^3250214^^"
^XWB(8994,5015,2,2,1,1,0)="SDINPUT (PATIENT IEN) = Required. This is the Patient IEN from the "
^XWB(8994,5015,2,2,1,2,0)="PATIENT (#2) file."
^XWB(8994,5015,2,2,1,3,0)=" "
^XWB(8994,5015,2,2,1,4,0)="SDINPUT (CLINIC IEN) = Required. This is the IEN of the clinic from the "
^XWB(8994,5015,2,2,1,5,0)="HOSPITAL LOCATION (#44) file."
^XWB(8994,5015,2,2,1,6,0)=" "
^XWB(8994,5015,2,2,1,7,0)="SDINPUT (APPT DATE TIME) = Required. Appointment Date and Time "
^XWB(8994,5015,2,2,1,8,0)="in ISO format."
^XWB(8994,5015,2,"B","SDCONTEXT",1)=""
^XWB(8994,5015,2,"B","SDINPUT",2)=""
^XWB(8994,5015,2,"PARAMSEQ",1,1)=""
^XWB(8994,5015,2,"PARAMSEQ",2,2)=""
^XWB(8994,5015,3,0)="^8994.03^34^34^3250214^^"
^XWB(8994,5015,3,1,0)="Will return the following JSON output."
^XWB(8994,5015,3,2,0)=" "
^XWB(8994,5015,3,3,0)="Appointment date/time in ISO 8601 format"
^XWB(8994,5015,3,4,0)="  Patient data"
^XWB(8994,5015,3,5,0)="  Provider data"
^XWB(8994,5015,3,6,0)="  System (misc) data"
^XWB(8994,5015,3,7,0)=" "
