^XWB(8994,2973,1,3,0)=" "
^XWB(8994,2973,1,4,0)="Input: YSDATA=Array name to return success/error response"
^XWB(8994,2973,1,5,0)="       YS(""FILE"")=File number (e.g., 627.8)"
^XWB(8994,2973,1,6,0)="       YS(""IEN"")=record internal entry number (e.g., 100123)  "
^XWB(8994,2973,1,7,0)="Output: YSDATA(1)=""[DATA]"""
^XWB(8994,2973,1,8,0)="        or"
^XWB(8994,2973,1,9,0)="        YSDATA(1)=""[ERROR]"""
^XWB(8994,2973,1,10,0)="        YSDATA(2)=""error message"""
^XWB(8994,2973,1,11,0)=" "
^XWB(8994,2973,1,12,0)="Example:"
^XWB(8994,2973,1,13,0)=" > S YSDATA=""TEST"",YS(""FILE"")=627.8,YS(""IEN"")=100123"
^XWB(8994,2973,1,14,0)=" > D DELENTRY^YTQAPI6(.YSDATA,.YS)"
