^XWB(8994,3648,0)="MBAA PATIENT PENDING APPT^GETPEND^MBAARPC1^2^S^^^^^^1"
^XWB(8994,3648,1,0)="^8994.01^1^1^3180618^^"
^XWB(8994,3648,1,1,0)="this RPC will return data about pending appointments for a patient."
^XWB(8994,3648,2,0)="^8994.02A^2^2"
^XWB(8994,3648,2,1,0)="DFN^1^^1^1"
^XWB(8994,3648,2,1,1,0)="^^1^1^3130828^"
^XWB(8994,3648,2,1,1,1,0)="The patient DFN."
^XWB(8994,3648,2,2,0)="DATE^1^^1^2"
^XWB(8994,3648,2,2,1,0)="^8994.021^1^1^3180618^^"
^XWB(8994,3648,2,2,1,1,0)="The starting date in FileMan format to begin the search for appointments."
