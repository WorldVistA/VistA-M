^XWB(8994,3366,0)="VPS GET PRINTERS^DEVICE^VPSPRINT^2"
^XWB(8994,3366,1,0)="^^1^1^3141015^"
^XWB(8994,3366,1,1,0)="This RPC returns up to 20 entries from the device file based on Input Criteria."
^XWB(8994,3366,2,0)="^8994.02A^2^2"
^XWB(8994,3366,2,1,0)="FROM^1^50^0^1"
^XWB(8994,3366,2,1,1,0)="^^3^3^3141015^"
^XWB(8994,3366,2,1,1,1,0)="This input parameter is used to filter the output by returning result start with or start from (up to 20 printers). "
^XWB(8994,3366,2,1,1,2,0)="Example: Input Parameter ""B"" will return all printers (up to 20) start *with* ""B"""
^XWB(8994,3366,2,1,1,3,0)="Example: Input Parameter ""B*"" will return all printers (up to 20) start *from* ""B"""
^XWB(8994,3366,2,2,0)="DIR^1^2^0^2"
^XWB(8994,3366,2,2,1,0)="^^3^3^3141015^"
^XWB(8994,3366,2,2,1,1,0)="This input parameter causes output result to be sorted in printer name ascending or descending order."
^XWB(8994,3366,2,2,1,2,0)="Input Parameter: 1 (return printer names in ascending order)"
^XWB(8994,3366,2,2,1,3,0)="Input Parameter: -1 (return printer names in descending order)"
^XWB(8994,3366,2,"B","DIR",2)=""
^XWB(8994,3366,2,"B","FROM",1)=""
