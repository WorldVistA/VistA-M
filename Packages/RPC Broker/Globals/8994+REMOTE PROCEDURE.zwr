^XWB(8994,4402,0)="PXRMRPCG GENFUPD^GENFUPD^PXRMRPCG^2^A"
^XWB(8994,4402,1,0)="^8994.01^1^1^3150305^^"
^XWB(8994,4402,1,1,0)="Process general findings selected in a reminder dialog."
^XWB(8994,4402,2,0)="^8994.02A^1^1"
^XWB(8994,4402,2,1,0)="DATA^2^^1^1"
^XWB(8994,4402,2,1,1,0)="^^57^57^3171121^"
^XWB(8994,4402,2,1,1,1,0)="Array of general findings and patient identifiers."
^XWB(8994,4402,2,1,1,2,0)=" "
^XWB(8994,4402,2,1,1,3,0)="DATA(0)=Caret-delimited string"
^XWB(8994,4402,2,1,1,4,0)="        Patient identifiers"
^XWB(8994,4402,2,1,1,5,0)=" Piece  Value"
^XWB(8994,4402,2,1,1,6,0)="================"
^XWB(8994,4402,2,1,1,7,0)=" 1      Internal entry number (IEN) in the PATIENT file (#2)"
^XWB(8994,4402,2,1,1,8,0)=" 2      CPRS visit string (semi-colon-delimited)"
^XWB(8994,4402,2,1,1,9,0)="         Piece  Value"
^XWB(8994,4402,2,1,1,10,0)="        ================"
^XWB(8994,4402,2,1,1,11,0)="         1      IEN in the HOSPITAL LOCATION file (#44)"
^XWB(8994,4402,2,1,1,12,0)="         2      Encounter date/time in internal FileMan format"
^XWB(8994,4402,2,1,1,13,0)="         3      Service category (refer to integration agreement #1889 "
^XWB(8994,4402,2,1,1,14,0)="                ADD/EDIT/DELETE PCE DATA SILENTLY for valid values)"
^XWB(8994,4402,2,1,1,15,0)=" 3      IEN in the TIU DOCUMENT file (#8925)"
^XWB(8994,4402,2,1,1,16,0)=" "
^XWB(8994,4402,2,1,1,17,0)="DATA(XIEN,GROUP_ID,N)=Caret-delimited string"
^XWB(8994,4402,2,1,1,18,0)="                      General finding data"
^XWB(8994,4402,2,1,1,19,0)="    XIEN - 'R' followed by the IEN in the REMINDER DEFINITION file "
^XWB(8994,4402,2,1,1,20,0)="           (#811.9) of the reminder associated with the top-level dialog"
^XWB(8994,4402,2,1,1,21,0)="           that contains this general finding or the IEN in the REMINDER"
^XWB(8994,4402,2,1,1,22,0)="           DIALOG file (#801.41) of the top-level dialog that contains"
^XWB(8994,4402,2,1,1,23,0)="           this general finding"
^XWB(8994,4402,2,1,1,24,0)="    GROUP_ID - Value from the DATA GROUP field (#150) in the REMINDER"
^XWB(8994,4402,2,1,1,25,0)="               DIALOG file (#801.41) or '0' if that field is null"
^XWB(8994,4402,2,1,1,26,0)="    N - the general finding number; starts at one and increments by one"
^XWB(8994,4402,2,1,1,27,0)=" Piece  Value"
^XWB(8994,4402,2,1,1,28,0)="================"
^XWB(8994,4402,2,1,1,29,0)=" 2      IEN in the REMINDER GENERAL FINDINGS file (#801.46)"
^XWB(8994,4402,2,1,1,30,0)=" X      The data value of this general finding"
^XWB(8994,4402,2,1,1,31,0)="        Not all general findings have a data piece."
^XWB(8994,4402,2,1,1,32,0)="        To determine X, the remote procedure uses the following algorithm:"
^XWB(8994,4402,2,1,1,33,0)="          1. Obtain the REMINDER GUI PROCESS file (#801.42) IEN from the "
^XWB(8994,4402,2,1,1,34,0)="             PROMPT TYPE field (#6) in the REMINDER GENERAL FINDINGS file"
^XWB(8994,4402,2,1,1,35,0)="             (#801.46)"
^XWB(8994,4402,2,1,1,36,0)="          2. Obtain the NAME field (#.01) value from the REMINDER GENERAL "
^XWB(8994,4402,2,1,1,37,0)="             FINDINGS file (#801.46)"
^XWB(8994,4402,2,1,1,38,0)="          3. Obtain the value of X from the array returned by the "
^XWB(8994,4402,2,1,1,39,0)="             BLDPARR^PXRMRPCG line tag using the value from step #2 as the"
^XWB(8994,4402,2,1,1,40,0)="             subscript of interest"
^XWB(8994,4402,2,1,1,41,0)=" All other pieces are ignored."
^XWB(8994,4402,2,1,1,42,0)="  "
^XWB(8994,4402,2,1,1,43,0)="DATA(DIEN,GROUP_ID,""ID"",N)=Caret-delimited string"
^XWB(8994,4402,2,1,1,44,0)="                           General findings that contain record IDs"
^XWB(8994,4402,2,1,1,45,0)="    XIEN - 'R' followed by the IEN in the REMINDER DEFINITION file "
^XWB(8994,4402,2,1,1,46,0)="           (#811.9) of the reminder associated with the top-level dialog"
^XWB(8994,4402,2,1,1,47,0)="           that contains this general finding or the IEN in the REMINDER"
^XWB(8994,4402,2,1,1,48,0)="           DIALOG file (#801.41) of the top-level dialog that contains"
^XWB(8994,4402,2,1,1,49,0)="           this general finding"
^XWB(8994,4402,2,1,1,50,0)="    GROUP_ID - Value from the DATA GROUP field (#150) or '0' if that"
^XWB(8994,4402,2,1,1,51,0)="               field is null"
^XWB(8994,4402,2,1,1,52,0)="    N - the general finding number; starts at one and increments by one"
^XWB(8994,4402,2,1,1,53,0)=" Piece  Value"
^XWB(8994,4402,2,1,1,54,0)="================"
^XWB(8994,4402,2,1,1,55,0)=" 1      IEN of the general finding in the REMINDER GENERAL FINDINGS"
^XWB(8994,4402,2,1,1,56,0)="        file (#801.46)"
^XWB(8994,4402,2,1,1,57,0)=" 2      Record ID"
^XWB(8994,4402,2,"B","DATA",1)=""
^XWB(8994,4402,2,"PARAMSEQ",1,1)=""
^XWB(8994,4402,3,0)="^8994.03^9^9^3150305^^"
