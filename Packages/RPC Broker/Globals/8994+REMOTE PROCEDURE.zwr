^XWB(8994,3409,3,7,0)="retval(1)=""1^3100608.1123^.05^452"""
^XWB(8994,3409,3,8,0)="retval(2)=""2^3100608.1123^.2^452"""
^XWB(8994,3409,3,9,0)="retval(3)=""3^3110113.1422^.0^452"""
^XWB(8994,3409,3,10,0)=" "
^XWB(8994,3409,3,11,0)="Errors:"
^XWB(8994,3409,3,12,0)="retval(0)=""0^Missing record IEN"""
^XWB(8994,3418,0)="TIU CAN PRINT WORK/CHART COPY^WORKCHRT^TIUSRVA^1^S"
^XWB(8994,3418,1,0)="^8994.01^7^7^3121025^^"
^XWB(8994,3418,1,1,0)="This RPC evaluates whether a user can print a Document, and if so, "
^XWB(8994,3418,1,2,0)="whether the user can print only a Work Copy or may print EITHER a Work "
^XWB(8994,3418,1,3,0)="Copy or a Chart Copy."
^XWB(8994,3418,1,4,0)="Authorization to print is determined by ASU Business Rules, and what type "
^XWB(8994,3418,1,5,0)="of copy by TIU Document Parameter ALLOW CHART PRINT OUTSIDE MAS. A user is"
^XWB(8994,3418,1,6,0)="""in MAS"" if they are a member of ASU User Class MEDICAL INFORMATION"
^XWB(8994,3418,1,7,0)="SECTION."
^XWB(8994,3418,2,0)="^8994.02A^1^1"
^XWB(8994,3418,2,1,0)="TIUDA^1^^1"
^XWB(8994,3418,2,1,1,0)="^^1^1^3121025^"
^XWB(8994,3418,2,1,1,1,0)="This is the record number (IEN) of the document in file 8925."
^XWB(8994,3418,2,"B","TIUDA",1)=""
^XWB(8994,3418,3,0)="^8994.03^3^3^3121025^^"
^XWB(8994,3418,3,1,0)="TIUY = 0^Can't Message:  User can't print EITHER copy. (Fails Bus Rules)"
^XWB(8994,3418,3,2,0)="TIUY = 1: User may print a Work Copy only."
^XWB(8994,3418,3,3,0)="TIUY = 2: User may print either a Work Copy or a Chart Copy."
^XWB(8994,3419,0)="ORWRP1A RADIO^RADIO^ORWRP1A^1^^^^^1"
^XWB(8994,3419,1,0)="^8994.01^2^2^3110614^^^"
^XWB(8994,3419,1,1,0)="Check to determine the method of selecting Date Ranges on the Reports"
^XWB(8994,3419,1,2,0)="and Labs Tabs in CPRS."
^XWB(8994,3420,0)="ORDEBUG SAVERPCS^SAVERPCS^ORDEBUG^1"
^XWB(8994,3420,1,0)="^^1^1^3130419^"
^XWB(8994,3420,1,1,0)="Saves RPC log from CPRS to be used for other purposes/debugging problems"
^XWB(8994,3420,2,0)="^8994.02A^2^2"
^XWB(8994,3420,2,1,0)="ORKEY^1^^1^1"
^XWB(8994,3420,2,1,1,0)="^^2^2^3130419^"
^XWB(8994,3420,2,1,1,1,0)="ORKEY - should be a unique string using user id and date/time to "
^XWB(8994,3420,2,1,1,2,0)="differentiate different rpc log data"
^XWB(8994,3420,2,2,0)="ORDATA^2^^1^2"
^XWB(8994,3420,2,2,1,0)="^^1^1^3130419^"
^XWB(8994,3420,2,2,1,1,0)="ORDATA - Array containing the RPC data to be stored for debugging"
^XWB(8994,3420,2,"B","ORDATA",2)=""
^XWB(8994,3420,2,"B","ORKEY",1)=""
^XWB(8994,3420,2,"PARAMSEQ",1,1)=""
^XWB(8994,3420,2,"PARAMSEQ",2,2)=""
^XWB(8994,3420,3,0)="^^1^1^3130419^"
^XWB(8994,3420,3,1,0)="Will always be 1"
^XWB(8994,3421,0)="ORDEBUG SAVEDESC^SAVEDESC^ORDEBUG^1"
^XWB(8994,3421,1,0)="^^2^2^3130419^"
^XWB(8994,3421,1,1,0)="Saves a user supplied description of why they are saving the RPC log from "
^XWB(8994,3421,1,2,0)="CRPS"
^XWB(8994,3421,2,0)="^8994.02A^2^2"
^XWB(8994,3421,2,1,0)="ORKEY^1^^1^1"
^XWB(8994,3421,2,1,1,0)="^^2^2^3130419^"
^XWB(8994,3421,2,1,1,1,0)="ORKEY - should be a unique string using user id and date/time to "
^XWB(8994,3421,2,1,1,2,0)="differentiate different rpc log data"
^XWB(8994,3421,2,2,0)="ORDATA^2^^1^2"
^XWB(8994,3421,2,2,1,0)="^^1^1^3130419^"
^XWB(8994,3421,2,2,1,1,0)="ORDATA - The user supplied description"
^XWB(8994,3421,2,"B","ORDATA",2)=""
^XWB(8994,3421,2,"B","ORKEY",1)=""
^XWB(8994,3421,2,"PARAMSEQ",1,1)=""
^XWB(8994,3421,2,"PARAMSEQ",2,2)=""
^XWB(8994,3421,3,0)="^^1^1^3130419^"
^XWB(8994,3421,3,1,0)="Will always be 1"
^XWB(8994,3422,0)="ORQQCN GET USER AUTH^VALID^ORQQCN2^1"
^XWB(8994,3422,1,0)="^8994.01^1^1^3131121^^^"
^XWB(8994,3422,1,1,0)="This RPC returns the update authority of a user for a specific Consult."
^XWB(8994,3422,2,0)="^8994.02A^3^3"
^XWB(8994,3422,2,1,0)="GMRCIEN^1^^1^1"
^XWB(8994,3422,2,1,1,0)="^8994.021^1^1^3131121^^"
^XWB(8994,3422,2,1,1,1,0)="This is the Consult Service IEN in file 123.5."
^XWB(8994,3422,2,2,0)="ORDUZ^1^^^2"
^XWB(8994,3422,2,2,1,0)="^8994.021^1^1^3131121^^"
^XWB(8994,3422,2,2,1,1,0)="This is the user dfn in file 200."
^XWB(8994,3422,2,3,0)="ORIFC^1^1^^3"
^XWB(8994,3422,2,3,1,0)="^8994.021^2^2^3131121^^^"
^XWB(8994,3422,2,3,1,1,0)="This is a binary (0 or 1) value indicating if IFC Coordinator is to be"
^XWB(8994,3422,2,3,1,2,0)="included as a potential result."
^XWB(8994,3422,2,"B","GMRCIEN",1)=""
^XWB(8994,3422,2,"B","ORDUZ",2)=""
^XWB(8994,3422,2,"B","ORIFC",3)=""
^XWB(8994,3422,2,"PARAMSEQ",1,1)=""
^XWB(8994,3422,2,"PARAMSEQ",2,2)=""
^XWB(8994,3422,2,"PARAMSEQ",3,3)=""
^XWB(8994,3422,3,0)="^8994.03^8^8^3131121^^^"
^XWB(8994,3422,3,1,0)=" The value returned is the equivalent of this set of codes: "
^XWB(8994,3422,3,2,0)="      0 = not an update user "
^XWB(8994,3422,3,3,0)="      1 = unrestricted access user"
^XWB(8994,3422,3,4,0)="      2 = update user "
^XWB(8994,3422,3,5,0)="      3 = administrative update user "
^XWB(8994,3422,3,6,0)="      4 = admin AND update user"
^XWB(8994,3422,3,7,0)="      5 = IFC coordinator"
^XWB(8994,3422,3,8,0)="     -1 = Error occurred (-1^Error Msg)"
^XWB(8994,3423,0)="ORUTL ISCLORD^ISCLORD^ORUTL^1"
^XWB(8994,3423,1,0)="^^1^1^3140630^"
^XWB(8994,3423,1,1,0)="returns 1 if the ORIFN passed in is a clinic order, 0 otherwise"
^XWB(8994,3423,2,0)="^8994.02A^1^1"
^XWB(8994,3423,2,1,0)="orifn^1^^1"
^XWB(8994,3423,2,"B","orifn",1)=""
^XWB(8994,3424,0)="ORBCMA5 LOCK^LOCK^ORBCMA5^1"
^XWB(8994,3424,1,0)="^8994.01^7^7^3140723^^"
^XWB(8994,3424,1,1,0)="Due to issues with LOCKing between the CPRS GUI chart and the "
^XWB(8994,3424,1,2,0)="BCMAOrderCom dll, some changes are necessary to how locks are handled "
^XWB(8994,3424,1,3,0)="when locking the patient chart."
^XWB(8994,3424,1,4,0)=" "
^XWB(8994,3424,1,5,0)="Using the $J value for the CPRS GUI session, the CPRS GUI will call the "
^XWB(8994,3424,1,6,0)="BCMAOrderCom dll and pass in the $J value and this value is used for "
^XWB(8994,3424,1,7,0)="locking the patient's chart."
^XWB(8994,3424,2,0)="^8994.02A^3^3"
^XWB(8994,3424,2,1,0)="DFN^1^30^1^1"
^XWB(8994,3424,2,1,1,0)="^^1^1^3140722^"
^XWB(8994,3424,2,1,1,1,0)="The internal entry number (IEN) of the patient from the PATIENT file (#2)."
^XWB(8994,3424,2,2,0)="ORJOB^1^20^1^2"
^XWB(8994,3424,2,2,1,0)="^8994.021^1^1^3140723^^"
^XWB(8994,3424,2,2,1,1,0)="The job number ($J) from the CPRS session on the M server."
^XWB(8994,3424,2,3,0)="ORY^1^4^1^1"
^XWB(8994,3424,2,"B","DFN",1)=""
^XWB(8994,3424,2,"B","ORJOB",2)=""
^XWB(8994,3424,2,"B","ORY",3)=""
^XWB(8994,3424,2,"PARAMSEQ",1,1)=""
^XWB(8994,3424,2,"PARAMSEQ",1,3)=""
^XWB(8994,3424,2,"PARAMSEQ",2,2)=""
^XWB(8994,3424,3,0)="^8994.03^4^4^3140723^^"
^XWB(8994,3424,3,1,0)="If the lock is successful, a return value of 1 is sent."
^XWB(8994,3424,3,2,0)=" "
^XWB(8994,3424,3,3,0)="If the lock fails, the return value is a 0^ followed by text indicating "
^XWB(8994,3424,3,4,0)="why the lock failed."
^XWB(8994,3425,0)="ORBCMA5 UNLOCK^UNLOCK^ORBCMA5^1"
^XWB(8994,3426,0)="ORBCMA5 JOB^JOB^ORBCMA5^1"
^XWB(8994,3426,1,0)="^8994.01^8^8^3140723^^"
^XWB(8994,3426,1,1,0)="Due to issues with LOCKing between the CPRS GUI chart and the "
^XWB(8994,3426,1,2,0)="BCMAOrderCom dll, some changes are necessary to how locks are handled "
^XWB(8994,3426,1,3,0)="when locking the patient chart."
^XWB(8994,3426,1,4,0)=" "
^XWB(8994,3426,1,5,0)="In order to facility those changes, the CPRS GUI chart needs to know the "
^XWB(8994,3426,1,6,0)="$J value for the running process for the open connection on the M server."
^XWB(8994,3426,1,7,0)=" "
^XWB(8994,3426,1,8,0)="The purpose of this RPC is to return that $J value."
^XWB(8994,3426,2,0)="^8994.02A"
^XWB(8994,3426,3,0)="^8994.03^1^1^3140723^^^"
^XWB(8994,3426,3,1,0)="Returns the $J value."
^XWB(8994,3427,0)="ORWU OVERDL^OVERDL^ORWU^1"
^XWB(8994,3428,0)="ORUTL4 DLL^DLL^ORUTL4^1^R^0"
^XWB(8994,3428,1,0)="^^2^2^3150408^"
^XWB(8994,3428,1,1,0)="This RPC will check the version of the user's DLL against the current "
^XWB(8994,3428,1,2,0)="version defined on the server for compatibility."
^XWB(8994,3428,2,0)="^8994.02A^2^2"
^XWB(8994,3428,2,1,0)="DLLNAME^1^^1"
^XWB(8994,3428,2,1,1,0)="^^1^1^3150408^"
^XWB(8994,3428,2,1,1,1,0)="This is the name of the DLL file to perform a compatability check on."
^XWB(8994,3428,2,2,0)="DLLVERSION^1^^1"
^XWB(8994,3428,2,2,1,0)="^^1^1^3150408^"
^XWB(8994,3428,2,2,1,1,0)="This is the version of the DLL on the user's machine."
^XWB(8994,3428,2,"B","DLLNAME",1)=""
^XWB(8994,3428,2,"B","DLLVERSION",2)=""
^XWB(8994,3428,3,0)="^^4^4^3150408^"
^XWB(8994,3428,3,1,0)="If the version of the DLL on the user's machine is compatible with the "
^XWB(8994,3428,3,2,0)="version defined on the server, this RPC will return a 1. Otherwise the "
^XWB(8994,3428,3,3,0)="following string format is returned depending on the DLL: "
^XWB(8994,3428,3,4,0)="-1^<message string> or -1^<required server version>^<message string>."
^XWB(8994,3429,0)="ORWU MOBAPP^MOBAPP^ORWU^1"
^XWB(8994,3430,0)="HMP PATIENT ACTIVITY^ACT^HMPACT^2^S"
^XWB(8994,3430,1,0)="^8994.01^2^2^3140903^^^"
^XWB(8994,3430,1,1,0)="This remote procedure returns all JSON messages for entries that exist in"
^XWB(8994,3430,1,2,0)=" the cross reference ^HMP(800001.5,""PTAPPT,""HMP"""
^XWB(8994,3431,0)="HMP APPOINTMENTS^OUT^HMPPATS^4^S^^^1^^^1"
^XWB(8994,3431,1,0)="^8994.01^2^2^3141016^^^^"
^XWB(8994,3431,1,1,0)="This RPC finds a list of patients that have scheduled appointments during"
^XWB(8994,3431,1,2,0)="the requested timeframe, as XML in ^TMP($J,""HMP"",n)."
^XWB(8994,3431,2,0)="^8994.02A^2^2"
^XWB(8994,3431,2,1,0)="START^1^20^0^1"
^XWB(8994,3431,2,1,1,0)="^8994.021^2^2^3101129^^^"
^XWB(8994,3431,2,1,1,1,0)="The date/time from which to begin searching for appointments; optional,"
^XWB(8994,3431,2,1,1,2,0)="will default to tomorrow if not defined."
^XWB(8994,3431,2,2,0)="STOP^1^20^0^2"
^XWB(8994,3431,2,2,1,0)="^8994.021^2^2^3141016^^^"
^XWB(8994,3431,2,2,1,1,0)="The date/time at which to end searching for appointments; optional,"
^XWB(8994,3431,2,2,1,2,0)="will default to tomorrow if not defined."
^XWB(8994,3431,2,"B","START",1)=""
^XWB(8994,3431,2,"B","STOP",2)=""
^XWB(8994,3431,2,"PARAMSEQ",1,1)=""
^XWB(8994,3431,2,"PARAMSEQ",2,2)=""
^XWB(8994,3431,3,0)="^8994.03^1^1^3141016^^^"
^XWB(8994,3431,3,1,0)="Text array formatted XML"
^XWB(8994,3432,0)="HMP DATA VERSION^VERSION^HMPD^1^S^^^^^^1"
^XWB(8994,3432,1,0)="^^2^2^3110613^"
^XWB(8994,3432,1,1,0)="This RPC returns the current version of the XML returned by the RPC"
^XWB(8994,3432,1,2,0)="'HMP GET PATIENT DATA.'"
^XWB(8994,3432,3,0)="^^2^2^3110613^"
^XWB(8994,3432,3,1,0)="A string identifying the version of the HMP data extracts and the"
^XWB(8994,3432,3,2,0)="resulting XML."
^XWB(8994,3433,0)="HMP DELETE OBJECT^DEL^HMPDJ2^1^S^^^1^1^^1"
^XWB(8994,3433,1,0)="^8994.01^2^2^3130103^^^^"
^XWB(8994,3433,1,1,0)="This RPC receives a Uid from the client and deletes the object from the"
