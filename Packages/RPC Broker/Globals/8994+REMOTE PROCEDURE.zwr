^XWB(8994,3926,2,1,1,6,0)="C2:  All Turn-Ins waiting for ANY CMR"
^XWB(8994,3926,2,1,1,7,0)="P1:  Waiting for PPM Approval"
^XWB(8994,3926,2,1,1,8,0)="P2:  Waiting for PPM Final Disposition"
^XWB(8994,3926,2,1,1,9,0)="WO:  Waiting for Work Order completion"
^XWB(8994,3926,2,1,1,10,0)="WH:  Waiting for Warehouse assignment/pickup"
^XWB(8994,3926,2,1,1,11,0)="AL:  All Open Turn-In Requests"
^XWB(8994,3926,2,1,1,12,0)="TR:  Turn In by Transaction #  (only search which will use the SCHTERM)"
^XWB(8994,3926,2,1,1,13,0)="RQ:  Turn In by Current User (or supplied DUZ value)"
