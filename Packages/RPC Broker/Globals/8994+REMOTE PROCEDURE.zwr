^XWB(8994,4331,2,12,1,0)="^8994.021^2^2^3150421^^"
^XWB(8994,4331,2,12,1,1,0)="Inventory Point (GIP) - required if GIP Stock Issue - Generic Inventory "
^XWB(8994,4331,2,12,1,2,0)="file (#445) IEN"
^XWB(8994,4331,2,13,0)="DSSOVEN^1^15^1^13"
^XWB(8994,4331,2,13,1,0)="^8994.021^3^3^3150421^^"
^XWB(8994,4331,2,13,1,1,0)="Vendor - Vendor file (#440) IEN - defaults to Mandatory or Requested"
^XWB(8994,4331,2,13,1,2,0)="Source (#.4) in the Inventory Item sub-file (#445.01) in the Generic"
^XWB(8994,4331,2,13,1,3,0)="Inventory file (#445)"
^XWB(8994,4331,2,14,0)="DSSOQTY^1^4^1^14"
^XWB(8994,4331,2,14,1,0)="^8994.021^1^1^3150421^^^"
^XWB(8994,4331,2,14,1,1,0)="Quantity - 0-9999, no decimals"
^XWB(8994,4331,2,15,0)="DSSOUCS^1^9^0^15"
^XWB(8994,4331,2,15,1,0)="^^15^15^3150421^"
^XWB(8994,4331,2,15,1,1,0)="Unit Cost:"
^XWB(8994,4331,2,15,1,2,0)="  0-999999, two decimals"
^XWB(8994,4331,2,15,1,3,0)="  0.00 is valid"
^XWB(8994,4331,2,15,1,4,0)="  If this is a GIP stock issue and Source is Commercial, defaults to Last "
^XWB(8994,4331,2,15,1,5,0)="    Cost (Unit of Issue) (#4.7) from the Generic Inventory file (#445)."
^XWB(8994,4331,2,15,1,6,0)="  If this is a non-GIP stock issue, then for the selected vendor in file"
^XWB(8994,4331,2,15,1,7,0)="    the Item Master (file 441) sub-file 441.01 Vendor, Unit Cost (#1) / "
^XWB(8994,4331,2,15,1,8,0)="    Unit Conversion Factor (#10) if it exists; otherwise, divided by 1"
^XWB(8994,4331,2,15,1,9,0)="    and formatted as 9 digits including 2 decimals - use DSSO DTLD GET "
^XWB(8994,4331,2,15,1,10,0)="    ITEM MASTER with DSSOFLD=V and search for the selected vendor."
^XWB(8994,4331,2,15,1,11,0)="  If this is a PIP stock issue and an entry exists, then get the"
^XWB(8994,4331,2,15,1,12,0)="    default Unit Cost from the Average Cost field (#30) of the HCPCS"
^XWB(8994,4331,2,15,1,13,0)="    multiple (#661.31) / Item multiple (#661.312) from the Pros Item"
^XWB(8994,4331,2,15,1,14,0)="    Location file (#661.3)."
^XWB(8994,4331,2,15,1,15,0)="  If no Unit Cost exists, then prompt for Unit Cost."
^XWB(8994,4331,2,16,0)="DSSOSER^1^20^0^16"
^XWB(8994,4331,2,16,1,0)="^8994.021^2^2^3150421^^"
^XWB(8994,4331,2,16,1,1,0)="Serial Number - defaults to file 660 field 9 Serial Nbr; can be deleted;"
^XWB(8994,4331,2,16,1,2,0)="  1-20 characters; cannot contain ""^"""
