^XWB(8994,3673,3,0)="^^7^7^3160621^"
^XWB(8994,3673,3,1,0)="0^error message - If we could not save the disclosure information (either "
^XWB(8994,3673,3,2,0)="                  the RPC was called incorrectly, or the V Immunization"
^XWB(8994,3673,3,3,0)="                  IEN did not exist)."
^XWB(8994,3673,3,4,0)="1               - Successfully saved the disclosure information."
^XWB(8994,3673,3,5,0)="2^error message - We attempted to save the disclosure information, but"
^XWB(8994,3673,3,6,0)="                  encountered an error when filing the data to the"
^XWB(8994,3673,3,7,0)="                  database."
^XWB(8994,3674,0)="PSB GETSETWP^MDRPC^PSBPAR^4^R^0^^1^1"
^XWB(8994,3674,1,0)="^^3^3^3151214^"
^XWB(8994,3674,1,1,0)="This RPC allows the GUI to add and update body site locations graphically "
^XWB(8994,3674,1,2,0)="by sending the coordinates of the loction on the body and storing these"
^XWB(8994,3674,1,3,0)="using word processing free form text type field."
