^XWB(8994,2566,3,0)="^8994.03^19^19^3080813^^^^"
^XWB(8994,2566,3,1,0)="Zero value of the first '^'-piece of the Results[0] indicates that an"
^XWB(8994,2566,3,2,0)="error occurred during the execution of the procedure. In this case, the"
^XWB(8994,2566,3,3,0)="errors are returned in the Results array as shown below:"
^XWB(8994,2566,3,4,0)="  "
^XWB(8994,2566,3,5,0)="  Results[0]            Result descriptor"
^XWB(8994,2566,3,6,0)="                          ^01: 0"
^XWB(8994,2566,3,7,0)="                          ^02: Message"
^XWB(8994,2566,3,8,0)="  "
