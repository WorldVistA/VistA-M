^XWB(8994,3922,3,7,0)=" "
^XWB(8994,3922,3,8,0)="External : Internal"
^XWB(8994,3922,3,9,0)=" "
^XWB(8994,3922,3,10,0)="OR, if an error has occurred,"
^XWB(8994,3922,3,11,0)=" "
^XWB(8994,3922,3,12,0)="-1^Error Messange"
^XWB(8994,3923,0)="DSIYINI MANSRC MANDATORY SRC^MANSRC^DSIYGNI4^1"
