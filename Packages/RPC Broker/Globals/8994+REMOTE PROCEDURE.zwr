^XWB(8994,1803,3,111,0)="                          ^11: SR W HEMOPHILIA/COAG DISORDER  {0|1|9}"
^XWB(8994,1803,3,112,0)="                          ^12: SR W TRANS RECIPIENT WITH AIDS {0|1|9}"
^XWB(8994,1803,3,113,0)="                          ^13: TRANSPLANT RECIP-DOCUMNTD HIV  {0|1|9}"
