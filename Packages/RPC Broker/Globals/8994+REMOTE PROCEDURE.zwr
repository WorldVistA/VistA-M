^XWB(8994,3130,3,0)="^^13^13^3100805^"
^XWB(8994,3130,3,1,0)="This RPC returns an array containing report text and related information "
^XWB(8994,3130,3,2,0)="associated with the VA procedure that is referenced by the requested entry"
^XWB(8994,3130,3,3,0)="on the IMAGING PROCEDURE REFERENCE File (#2005.61).  The entries of the"
^XWB(8994,3130,3,4,0)="array are formatted as <fname>`<value>."
^XWB(8994,3130,3,5,0)=" "
^XWB(8994,3130,3,6,0)="If the entry does not point to a VA procedure, an appropriate exception is"
^XWB(8994,3130,3,7,0)="returned."
^XWB(8994,3130,3,8,0)=" "
^XWB(8994,3130,3,9,0)="Otherwise, the following attributes are valued:"
