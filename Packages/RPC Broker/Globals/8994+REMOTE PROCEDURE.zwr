^XWB(8994,2719,2,1,1,0)="^8994.021^1^1^3090610^^"
^XWB(8994,2719,2,1,1,1,0)="Value to begin patient list."
^XWB(8994,2719,2,2,0)="TIUDIR^1^^0^2"
^XWB(8994,2719,2,2,1,0)="^^1^1^3090610^"
^XWB(8994,2719,2,2,1,1,0)="Boolean value for list direction."
