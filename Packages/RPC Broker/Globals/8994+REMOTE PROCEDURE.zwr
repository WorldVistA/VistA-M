^XWB(8994,3648,2,"B","DFN",1)=""
^XWB(8994,3648,2,"PARAMSEQ",1,1)=""
^XWB(8994,3648,2,"PARAMSEQ",2,2)=""
^XWB(8994,3648,3,0)="^8994.03^13^13^3180618^^"
^XWB(8994,3648,3,1,0)="Returns an array with the following subscripts:"
^XWB(8994,3648,3,2,0)=" "
^XWB(8994,3648,3,3,0)="RETURN(CNT,""COLLATERAL VISIT"")"
^XWB(8994,3648,3,4,0)="RETURN(CNT,""APPOINTMENT TYPE"")"
^XWB(8994,3648,3,5,0)="RETURN(CNT,""LAB"")"
^XWB(8994,3648,3,6,0)="RETURN(CNT,""XRAY"")"
^XWB(8994,3648,3,7,0)="RETURN(CNT,""EKG"")"
^XWB(8994,3648,3,8,0)="RETURN(CNT,""CLINIC"")"
^XWB(8994,3648,3,9,0)="RETURN(CNT,""LENGTH OF APP'T"")"
^XWB(8994,3648,3,10,0)="RETURN(CNT,""CONSULT LINK"")"
^XWB(8994,3648,3,11,0)="RETURN(CNT,""OTHER"")"
^XWB(8994,3648,3,12,0)=" "
^XWB(8994,3648,3,13,0)="CNT is the date/time of the appointment. "
^XWB(8994,3649,0)="MBAA CANCEL APPOINTMENT^CANCEL^MBAARPC2^1^S^^^^^^1"
^XWB(8994,3649,1,0)="^8994.01^1^1^3130924^"
^XWB(8994,3649,1,1,0)="Allows cancel of an appointment"
^XWB(8994,3649,2,0)="^8994.02A^6^6"
^XWB(8994,3649,2,1,0)="DFN^1^200^1^1"
^XWB(8994,3649,2,1,1,0)="^^1^1^3130924^"
^XWB(8994,3649,2,1,1,1,0)="Patient DFN"
^XWB(8994,3649,2,2,0)="CLINC^1^200^1^2"
^XWB(8994,3649,2,2,1,0)="^^1^1^3130924^"
^XWB(8994,3649,2,2,1,1,0)="IEN for the clinic in the Hospital Location (#44) file."
^XWB(8994,3649,2,3,0)="DATE^1^200^1^3"
^XWB(8994,3649,2,3,1,0)="^^1^1^3130924^"
^XWB(8994,3649,2,3,1,1,0)="The date and time of the appointment to be canceled. "
^XWB(8994,3649,2,4,0)="TYPE^1^200^1^4"
^XWB(8994,3649,2,5,0)="REASON^1^200^1^5"
^XWB(8994,3649,2,5,1,0)="^^1^1^3130924^"
^XWB(8994,3649,2,5,1,1,0)="The cancel reason from the Cancel Reason file."
^XWB(8994,3649,2,6,0)="REMARKS^1^200^0^6"
^XWB(8994,3649,2,6,1,0)="^^1^1^3130924^"
^XWB(8994,3649,2,6,1,1,0)="And free text comments or remarks."
^XWB(8994,3649,2,"B","CLINC",2)=""
^XWB(8994,3649,2,"B","DATE",3)=""
^XWB(8994,3649,2,"B","DFN",1)=""
^XWB(8994,3649,2,"B","REASON",5)=""
^XWB(8994,3649,2,"B","REMARKS",6)=""
^XWB(8994,3649,2,"B","TYPE",4)=""
^XWB(8994,3649,2,"PARAMSEQ",1,1)=""
^XWB(8994,3649,2,"PARAMSEQ",2,2)=""
^XWB(8994,3649,2,"PARAMSEQ",3,3)=""
^XWB(8994,3649,2,"PARAMSEQ",4,4)=""
^XWB(8994,3649,2,"PARAMSEQ",5,5)=""
^XWB(8994,3649,2,"PARAMSEQ",6,6)=""
^XWB(8994,3649,3,0)="^^4^4^3130924^"
^XWB(8994,3649,3,1,0)="Returns an array where "
^XWB(8994,3649,3,2,0)=" "
^XWB(8994,3649,3,3,0)="RETURN(0)=""0^Failure Reason"""
^XWB(8994,3649,3,4,0)="RETURN(0)=1 for success."
^XWB(8994,3650,0)="MBAA PROVIDERS BY CLINIC^GETPROV^MBAARPC3^2^S^^^^^^1"
^XWB(8994,3650,1,0)="^^4^4^3140820^"
^XWB(8994,3650,1,1,0)="This RPC takes input of the clinic id, IEN from the Hospital Location "
^XWB(8994,3650,1,2,0)="file (#44), and returns the list of providers assigned to that clinic. "
^XWB(8994,3650,1,3,0)="The return data is the provider name and IEN for the provider from the "
^XWB(8994,3650,1,4,0)="New Person file (#200)."
^XWB(8994,3650,2,0)="^8994.02A^1^1"
^XWB(8994,3650,2,1,0)="CLINIC ID^1^200^1^1"
^XWB(8994,3650,2,1,1,0)="^^1^1^3140820^"
^XWB(8994,3650,2,1,1,1,0)="The IEN for the Clinic in the Hospital Location File (#44)."
^XWB(8994,3650,2,"B","CLINIC ID",1)=""
^XWB(8994,3650,2,"PARAMSEQ",1,1)=""
^XWB(8994,3650,3,0)="^^3^3^3140820^"
^XWB(8994,3650,3,1,0)="Returns an array where each node has the provider IEN from the New Person "
^XWB(8994,3650,3,2,0)="file (#200) and the provider name. Data elements are separated by the "
^XWB(8994,3650,3,3,0)="carat (^) character."
^XWB(8994,3651,0)="MBAA GET CLINIC DETAILS^GETCLN^MBAAMRP1^2^S^^^^1^^1"
^XWB(8994,3651,1,0)="^8994.01^2^2^3180618^^"
^XWB(8994,3651,1,1,0)="This RPC returns clinic details needed for scheduling appointments into a "
^XWB(8994,3651,1,2,0)="clinic."
^XWB(8994,3651,2,0)="^8994.02A^1^1"
^XWB(8994,3651,2,1,0)="CLINIC^1^200^1^1"
^XWB(8994,3651,2,1,1,0)="^8994.021^1^1^3180618^^"
^XWB(8994,3651,2,1,1,1,0)="This the IEN for the Clinic in the Hospital Location File (#44)."
^XWB(8994,3651,2,"B","CLINIC",1)=""
^XWB(8994,3651,2,"PARAMSEQ",1,1)=""
^XWB(8994,3651,3,0)="^8994.03^32^32^3180618^^"
^XWB(8994,3651,3,1,0)="Returns and array in the format below:"
^XWB(8994,3651,3,2,0)=" "
^XWB(8994,3651,3,3,0)=" LST(1)=""RESULT(44,""""23,"""",.01,""""E"""")=GENERAL MEDICINE"""
^XWB(8994,3651,3,4,0)=" LST(2)=""RESULT(44,""""23,"""",.01,""""I"""")=GENERAL MEDICINE"""
^XWB(8994,3651,3,5,0)=" LST(3)=""RESULT(44,""""23,"""",1,""""E"""")=GM"""
^XWB(8994,3651,3,6,0)=" LST(4)=""RESULT(44,""""23,"""",1,""""I"""")=GM"""
^XWB(8994,3651,3,7,0)=" LST(5)=""RESULT(44,""""23,"""",2,""""E"""")=CLINIC"""
^XWB(8994,3651,3,8,0)=" LST(6)=""RESULT(44,""""23,"""",2,""""I"""")=C"""
^XWB(8994,3651,3,9,0)=" LST(7)=""RESULT(44,""""23,"""",7,""""E"""")="""
^XWB(8994,3651,3,10,0)=" LST(8)=""RESULT(44,""""23,"""",7,""""I"""")="""
^XWB(8994,3651,3,11,0)=" LST(9)=""RESULT(44,""""23,"""",8,""""E"""")=GENERAL INTERNAL MEDICINE"""
^XWB(8994,3651,3,12,0)=" LST(10)=""RESULT(44,""""23,"""",8,""""I"""")=141"""
^XWB(8994,3651,3,13,0)=" LST(11)=""RESULT(44,""""23,"""",9,""""E"""")=MEDICINE"""
^XWB(8994,3651,3,14,0)=" LST(12)=""RESULT(44,""""23,"""",9,""""I"""")=M"""
^XWB(8994,3651,3,15,0)=" LST(13)=""RESULT(44,""""23,"""",9.5,""""E"""")=GENERAL MEDICINE"""
^XWB(8994,3651,3,16,0)=" LST(14)=""RESULT(44,""""23,"""",9.5,""""I"""")=9"""
^XWB(8994,3651,3,17,0)=" LST(15)=""RESULT(44,""""23,"""",10,""""E"""")="""
^XWB(8994,3651,3,18,0)=" LST(16)=""RESULT(44,""""23,"""",10,""""I"""")="""
^XWB(8994,3651,3,19,0)=" LST(17)=""RESULT(44,""""23,"""",24,""""E"""")="""
^XWB(8994,3651,3,20,0)=" LST(18)=""RESULT(44,""""23,"""",24,""""I"""")="""
^XWB(8994,3651,3,21,0)=" LST(19)=""RESULT(44,""""23,"""",1912,""""E"""")=15"""
^XWB(8994,3651,3,22,0)=" LST(20)=""RESULT(44,""""23,"""",1912,""""I"""")=15"""
^XWB(8994,3651,3,23,0)=" LST(21)=""RESULT(44,""""23,"""",1914,""""E"""")=8"""
^XWB(8994,3651,3,24,0)=" LST(22)=""RESULT(44,""""23,"""",1914,""""I"""")=8"""
^XWB(8994,3651,3,25,0)=" LST(23)=""RESULT(44,""""23,"""",1917,""""E"""")=15-MIN """
^XWB(8994,3651,3,26,0)=" LST(24)=""RESULT(44,""""23,"""",1917,""""I"""")=4"""
^XWB(8994,3651,3,27,0)=" LST(25)=""RESULT(44,""""23,"""",1918,""""E"""")=0"""
^XWB(8994,3651,3,28,0)=" LST(26)=""RESULT(44,""""23,"""",1918,""""I"""")=0"""
^XWB(8994,3651,3,29,0)=" LST(27)=""RESULT(44,""""23,"""",2500,""""E"""")="""
^XWB(8994,3651,3,30,0)=" LST(28)=""RESULT(44,""""23,"""",2500,""""I"""")="""
^XWB(8994,3651,3,31,0)=" LST(29)=""RESULT(44,""""23,"""",2503,""""E"""")=FAMILY PRACTICE"""
^XWB(8994,3651,3,32,0)=" LST(30)=""RESULT(44,""""23,"""",2503,""""I"""")=532"""
^XWB(8994,3652,0)="MBAA WAIT LIST BY DFN^EWL^MBAARPCL^2^S^^^^^^1"
^XWB(8994,3652,1,0)="^8994.01^1^1^3180618^^^"
^XWB(8994,3652,1,1,0)="Returns the EWL for a patient."
^XWB(8994,3652,2,0)="^8994.02A^1^1"
^XWB(8994,3652,2,1,0)="DFN^1^32000^1^1"
^XWB(8994,3652,2,1,1,0)="^8994.021^1^1^3180618^^^"
^XWB(8994,3652,2,1,1,1,0)="Patient's DFN"
^XWB(8994,3652,2,"B","DFN",1)=""
^XWB(8994,3652,2,"PARAMSEQ",1,1)=""
^XWB(8994,3652,3,0)="^8994.03^1^1^3180618^^^"
^XWB(8994,3652,3,1,0)="Array of EWL data for the patient"
^XWB(8994,3653,0)="MBAA FACILITY WAIT LIST^FACEWL^MBAARPCL^2^S^^^^^^1"
^XWB(8994,3653,1,0)="^8994.01^3^3^3180618^^^"
^XWB(8994,3653,1,1,0)="This RPC will return the full Facility Electronic Wait List."
^XWB(8994,3653,1,2,0)=" "
^XWB(8994,3653,1,3,0)="No input parameters are needed. "
^XWB(8994,3653,3,0)="^8994.03^8^8^3180618^^^"
^XWB(8994,3653,3,1,0)=" Outputs if successful - patient is on the EWL:"
^XWB(8994,3653,3,2,0)=" Results(0)=DFN^DSS STOP CODE^LAST UPDATED^PATIENT LAST NAME^PATIENT "
^XWB(8994,3653,3,3,0)="SSN^CLINIC NAME^ORIGINATING DATE^DESIRED DATE OF APPOINTMENT^DAYS ON "
^XWB(8994,3653,3,4,0)="EWL^DATE REMOVED FROM EWL^PATIENT ZIP CODE^SERVICE CONNECTED "
^XWB(8994,3653,3,5,0)="PERCENT^ENROLLEE STATUS^PRIORITY"
^XWB(8994,3653,3,6,0)=" "
^XWB(8994,3653,3,7,0)="If no patients are not on the EWL, returns"
^XWB(8994,3653,3,8,0)="RESULTS(0)=""1^EWL is empty."""
^XWB(8994,3654,0)="MBAA REMOVE FROM EWL^UPDTEWL^MBAARPC1^2^S^^^^^^1"
^XWB(8994,3654,1,0)="^8994.01^1^1^3131009^^^^"
^XWB(8994,3654,1,1,0)="This RPC removes a patient from the EWL."
^XWB(8994,3654,2,0)="^8994.02A^4^4"
^XWB(8994,3654,2,1,0)="DFN^1^200^1^1"
^XWB(8994,3654,2,1,1,0)="^^1^1^3131008^"
^XWB(8994,3654,2,1,1,1,0)="Patient DFN."
^XWB(8994,3654,2,2,0)="SDWLIEN^1^200^1^2"
^XWB(8994,3654,2,2,1,0)="^8994.021^1^1^3131008^^^"
^XWB(8994,3654,2,2,1,1,0)="The IEN for the record in SD WAIT LIST File (#409.3)."
^XWB(8994,3654,2,3,0)="SDWLDATA^2^240^0^4"
^XWB(8994,3654,2,3,1,0)="^^18^18^3131009^"
^XWB(8994,3654,2,3,1,1,0)="List of data elements:"
^XWB(8994,3654,2,3,1,2,0)=" SDWLDATA(1)=SCHEDULED DATE OF APPT"
^XWB(8994,3654,2,3,1,3,0)=" SDWLDATA(2)=PTR TO APPT CLINIC (CLINIC WHERE APPT MADE)"
^XWB(8994,3654,2,3,1,4,0)=" SDWLDATA(15)=APPOINTMENT INSTITUTION (PTR to Institution File.)"
^XWB(8994,3654,2,3,1,5,0)=" SDWLDATA(13)=APPT STOP CODE (PTR to file 40.7)"
^XWB(8994,3654,2,3,1,6,0)=" SDWLDATA(14)=APPT CREDIT STOP CODE (PTR to file 40.7)"
^XWB(8994,3654,2,3,1,7,0)=" SDWLDATA(16)=APPT STATION NUMBER (Free Text) MUST BE AN IEN FROM DIC(4"
^XWB(8994,3654,2,3,1,8,0)="    but is not a ptr field)"
^XWB(8994,3654,2,3,1,9,0)=" SDWLDATA(3)=APPT STATUS (Set of codes: "
^XWB(8994,3654,2,3,1,10,0)="     'R' FOR Scheduled/Kept "
^XWB(8994,3654,2,3,1,11,0)="     'I' FOR Inpatient"
^XWB(8994,3654,2,3,1,12,0)="     'NS' FOR No-Show"
^XWB(8994,3654,2,3,1,13,0)="     'NSR' FOR No_Show, Rescheduled "
^XWB(8994,3654,2,3,1,14,0)="     'CP' FOR Canceled by Patient "
^XWB(8994,3654,2,3,1,15,0)="     'CPR' FOR Canceled by Patient, Rescheduled"
^XWB(8994,3654,2,3,1,16,0)="     'CC' FOR Canceled by Clinic; "
^XWB(8994,3654,2,3,1,17,0)="     'CCR' FOR Canceled by Clinic, Rescheduled"
^XWB(8994,3654,2,3,1,18,0)="     'NT' FOR No Action Taken )"
^XWB(8994,3654,2,4,0)="SDWLDISP^1^200^1^3"
^XWB(8994,3654,2,4,1,0)="^^9^9^3131009^"
^XWB(8994,3654,2,4,1,1,0)="The disposition of the entry."
^XWB(8994,3654,2,4,1,2,0)=" "
^XWB(8994,3654,2,4,1,3,0)="D:DEATH"
^XWB(8994,3654,2,4,1,4,0)="NC:REMOVED/NON-VA CARE"
^XWB(8994,3654,2,4,1,5,0)="SA:REMOVED/SCHEDULED-ASSIGNED"
^XWB(8994,3654,2,4,1,6,0)="CC:REMOVED/VA CONTRACT CARE "
^XWB(8994,3654,2,4,1,7,0)="NN:REMOVED/NO LONGER NECESSARY"
^XWB(8994,3654,2,4,1,8,0)="ER:ENTERED IN ERROR"
^XWB(8994,3654,2,4,1,9,0)="CL:CLINIC CHANGE"
^XWB(8994,3654,2,"B","DFN",1)=""
^XWB(8994,3654,2,"B","SDWLDATA",3)=""
^XWB(8994,3654,2,"B","SDWLDISP",4)=""
^XWB(8994,3654,2,"B","SDWLIEN",2)=""
^XWB(8994,3654,2,"PARAMSEQ",1,1)=""
^XWB(8994,3654,2,"PARAMSEQ",2,2)=""
^XWB(8994,3654,2,"PARAMSEQ",3,4)=""
^XWB(8994,3654,2,"PARAMSEQ",4,3)=""
^XWB(8994,3654,3,0)="^^7^7^3131009^"
^XWB(8994,3654,3,1,0)="Returns:"
^XWB(8994,3654,3,2,0)=" "
^XWB(8994,3654,3,3,0)="RESULTS(0)=1 - Successful"
^XWB(8994,3654,3,4,0)="RESULTS(0)=""0^DFN is required"""
^XWB(8994,3654,3,5,0)="RESULTS(0)=""0^SDWLIEN is required"""
^XWB(8994,3654,3,6,0)="RESULTS(0)=""0^Patient not on EWL"""
^XWB(8994,3654,3,7,0)="RESULTS(0)=""0^Dispostion is missing."""
^XWB(8994,3656,0)="PXVIMM INFO SOURCE^IMMSRC^PXVRPC2^2"
^XWB(8994,3656,1,0)="^8994.01^1^1^3160216^^^^"
^XWB(8994,3656,1,1,0)="Returns entries from the IMMUNIZATION INFO SOURCE file (920.1)."
^XWB(8994,3656,2,0)="^8994.02A^1^1"
^XWB(8994,3656,2,1,0)="FILTER^1^^0^1"
^XWB(8994,3656,2,1,1,0)="^8994.021^11^11^3160216^^"
^XWB(8994,3656,2,1,1,1,0)="Filter. Possible values are:"
^XWB(8994,3656,2,1,1,2,0)="   R:XXX - Return entry with IEN XXX."
^XWB(8994,3656,2,1,1,3,0)="   H:XXX - Return entry with HL7 Code XXX."
^XWB(8994,3656,2,1,1,4,0)="   N:XXX - Return entry with #.01 field equal to XXX"
^XWB(8994,3656,2,1,1,5,0)="   S:X   - Return all entries with a status of X."
^XWB(8994,3656,2,1,1,6,0)="           Possible values of X:"
^XWB(8994,3656,2,1,1,7,0)="              A - Active Entries"
^XWB(8994,3656,2,1,1,8,0)="              I - Inactive Entries"
^XWB(8994,3656,2,1,1,9,0)="              B - Both active and inactive entries"
^XWB(8994,3656,2,1,1,10,0)=" "
^XWB(8994,3656,2,1,1,11,0)="Defaults to ""S:B""."
^XWB(8994,3656,2,"B","FILTER",1)=""
^XWB(8994,3656,2,"PARAMSEQ",1,1)=""
^XWB(8994,3656,3,0)="^8994.03^14^14^3151005^^"
^XWB(8994,3656,3,1,0)="Returns:"
^XWB(8994,3656,3,2,0)="   PXVRSLT(0)=Count of elements returned (0 if nothing found)"
^XWB(8994,3656,3,3,0)="   PXVRSLT(n)=IEN^Name^HL7 Code^Status (1:Active, 0:Inactive)"
^XWB(8994,3656,3,4,0)="  "
^XWB(8994,3656,3,5,0)="When filtering based off IEN, HL7 Code, or #.01 field, only one entry will"
^XWB(8994,3656,3,6,0)="be returned in PXVRSLT(1)."
^XWB(8994,3656,3,7,0)=" "
^XWB(8994,3656,3,8,0)="When filtering based off status, multiple entries can be returned. The"
^XWB(8994,3656,3,9,0)="first entry will be returned in subscript 1, and subscripts will be"
^XWB(8994,3656,3,10,0)="incremented by 1 for further entries. Entries will be sorted"
^XWB(8994,3656,3,11,0)="alphabetically."
^XWB(8994,3656,3,12,0)=" "
^XWB(8994,3656,3,13,0)="If no entries are found based off the filtering criteria, PXVRSLT(0) will"
^XWB(8994,3656,3,14,0)="equal 0, and there will be no data returned in the subsequent subscripts."
^XWB(8994,3657,0)="PXVIMM ADMIN ROUTE^IMMROUTE^PXVRPC2^2"
^XWB(8994,3657,1,0)="^8994.01^1^1^3160328^^^^"
^XWB(8994,3657,1,1,0)="Returns entries from the IMM ADMINISTRATION ROUTE file (920.2)."
^XWB(8994,3657,2,0)="^8994.02A^3^2"
^XWB(8994,3657,2,1,0)="FILTER^1^^0^1"
^XWB(8994,3657,2,1,1,0)="^8994.021^11^11^3160328^^"
^XWB(8994,3657,2,1,1,1,0)="Filter. Possible values are:"
^XWB(8994,3657,2,1,1,2,0)="   R:XXX - Return entry with IEN XXX."
^XWB(8994,3657,2,1,1,3,0)="   H:XXX - Return entry with HL7 Code XXX."
^XWB(8994,3657,2,1,1,4,0)="   N:XXX - Return entry with #.01 field equal to XXX"
^XWB(8994,3657,2,1,1,5,0)="   S:X   - Return all entries with a status of X."
^XWB(8994,3657,2,1,1,6,0)="           Possible values of X:"
^XWB(8994,3657,2,1,1,7,0)="              A - Active Entries"
^XWB(8994,3657,2,1,1,8,0)="              I - Inactive Entries"
^XWB(8994,3657,2,1,1,9,0)="              B - Both active and inactive entries"
^XWB(8994,3657,2,1,1,10,0)=" "
^XWB(8994,3657,2,1,1,11,0)="Defaults to ""S:B""."
^XWB(8994,3657,2,3,0)="PXVSITES^1^^0^2"
^XWB(8994,3657,2,3,1,0)="^8994.021^1^1^3160216^^^"
^XWB(8994,3657,2,3,1,1,0)="Controls if the available sites for a give route are returned."
^XWB(8994,3657,2,"B","FILTER",1)=""
^XWB(8994,3657,2,"B","PXVSITES",3)=""
^XWB(8994,3657,2,"PARAMSEQ",1,1)=""
^XWB(8994,3657,2,"PARAMSEQ",2,3)=""
^XWB(8994,3657,3,0)="^8994.03^13^13^3160328^^^"
^XWB(8994,3657,3,1,0)="PXVRSLT(0)=Count of elements returned (0 if nothing found)"
^XWB(8994,3657,3,2,0)="PXVRSLT(n)=IEN^Name^HL7 Code^Status (1:Active, 0:Inactive)"
^XWB(8994,3657,3,3,0)=" "
^XWB(8994,3657,3,4,0)="If PXVSITES=1, the sites for a given route will also be returned."
^XWB(8994,3657,3,5,0)="   o If only a subset of sites are selectable for a route, that list will"
^XWB(8994,3657,3,6,0)="     be returned in:"
^XWB(8994,3657,3,7,0)="       PXVRSLT(n+1)=SITE^Site IEN 1"
^XWB(8994,3657,3,8,0)="       PXVRSLT(n+2)=SITE^Site IEN 2"
^XWB(8994,3657,3,9,0)="       PXVRSLT(n+x)=SITE^Site IEN x"
^XWB(8994,3657,3,10,0)="   o If all sites are selectable for a route, the RPC will return:"
^XWB(8994,3657,3,11,0)="       PXVRSLT(n+1)=SITE^ALL"
^XWB(8994,3657,3,12,0)="   o If no sites are selectable for a route, the RPC will return:"
^XWB(8994,3657,3,13,0)="       PXVRSLT(n+1)=SITE^NONE"
^XWB(8994,3657,3,14,0)="equal 0, and there will be no data returned in the subsequent subscripts."
^XWB(8994,3658,0)="PXVIMM ADMIN SITE^IMMSITE^PXVRPC2^2"
^XWB(8994,3658,1,0)="^8994.01^1^1^3160216^^"
^XWB(8994,3658,1,1,0)="Returns entries from the IMM ADMINISTRATION SITE (BODY) file (920.3)."
^XWB(8994,3658,2,0)="^8994.02A^1^1"
^XWB(8994,3658,2,1,0)="FILTER^1^^0^1"
^XWB(8994,3658,2,1,1,0)="^^11^11^3151001^"
^XWB(8994,3658,2,1,1,1,0)="Filter. Possible values are:"
^XWB(8994,3658,2,1,1,2,0)="   R:XXX - Return entry with IEN XXX."
^XWB(8994,3658,2,1,1,3,0)="   H:XXX - Return entry with HL7 Code XXX."
^XWB(8994,3658,2,1,1,4,0)="   N:XXX - Return entry with #.01 field equal to XXX"
^XWB(8994,3658,2,1,1,5,0)="   S:X   - Return all entries with a status of X."
^XWB(8994,3658,2,1,1,6,0)="           Possible values of X:"
^XWB(8994,3658,2,1,1,7,0)="              A - Active Entries"
^XWB(8994,3658,2,1,1,8,0)="              I - Inactive Entries"
^XWB(8994,3658,2,1,1,9,0)="              B - Both active and inactive entries"
^XWB(8994,3658,2,1,1,10,0)=" "
^XWB(8994,3658,2,1,1,11,0)="Defaults to ""S:B""."
^XWB(8994,3658,2,"B","FILTER",1)=""
^XWB(8994,3658,2,"PARAMSEQ",1,1)=""
^XWB(8994,3658,3,0)="^8994.03^14^14^3151001^^"
^XWB(8994,3658,3,1,0)="Returns:"
^XWB(8994,3658,3,2,0)="   PXVRSLT(0)=Count of elements returned (0 if nothing found)"
^XWB(8994,3658,3,3,0)="   PXVRSLT(n)=IEN^Name^HL7 Code^Status (1:Active, 0:Inactive)"
^XWB(8994,3658,3,4,0)="  "
^XWB(8994,3658,3,5,0)="When filtering based off IEN, HL7 Code, or #.01 field, only one entry will"
^XWB(8994,3658,3,6,0)="be returned in PXVRSLT(1)."
^XWB(8994,3658,3,7,0)=" "
^XWB(8994,3658,3,8,0)="When filtering based off status, multiple entries can be returned. The"
^XWB(8994,3658,3,9,0)="first entry will be returned in subscript 1, and subscripts will be"
^XWB(8994,3658,3,10,0)="incremented by 1 for further entries. Entries will be sorted"
^XWB(8994,3658,3,11,0)="alphabetically."
^XWB(8994,3658,3,12,0)=" "
^XWB(8994,3658,3,13,0)="If no entries are found based off the filtering criteria, PXVRSLT(0) will"
^XWB(8994,3658,3,14,0)="equal 0, and there will be no data returned in the subsequent subscripts."
^XWB(8994,3659,0)="PXVIMM IMM LOT^ILOT^PXVRPC1^4^^^^1"
^XWB(8994,3659,1,0)="^8994.01^2^2^3160816^^^^"
^XWB(8994,3659,1,1,0)="This RPC returns information from the IMMUNIZATION LOT file "
^XWB(8994,3659,1,2,0)="(#9999999.41)."
^XWB(8994,3659,2,0)="^8994.02A^3^3"
^XWB(8994,3659,2,1,0)="FILTER^1^30^0^1"
^XWB(8994,3659,2,1,1,0)="^8994.021^9^9^3160816^^^^"
^XWB(8994,3659,2,1,1,1,0)="This input parameter is used to specify the IMMUNIZATION LOT file "
^XWB(8994,3659,2,1,1,2,0)="records to be returned. Possible values:"
^XWB(8994,3659,2,1,1,3,0)="   R:XXX - return entry with ien XXX"
^XWB(8994,3659,2,1,1,4,0)="   N:XXX - return entry with lot number XXX"
^XWB(8994,3659,2,1,1,5,0)="   S:A   - return list of all active lot numbers"
^XWB(8994,3659,2,1,1,6,0)="   S:I   - return list of all inactive lot num"
^XWB(8994,3659,2,1,1,7,0)="   S:B   - return list of all lot numbers, active and inactive"
^XWB(8994,3659,2,1,1,8,0)=" "
^XWB(8994,3659,2,1,1,9,0)="If this parameter is null, it defaults to ""S:B""."
^XWB(8994,3659,2,2,0)="PXVI^1^1^0^2"
^XWB(8994,3659,2,2,1,0)="^8994.021^4^4^3160816^^^^"
^XWB(8994,3659,2,2,1,1,0)="This optional input parameter is used to return an alternate array with "
^XWB(8994,3659,2,2,1,2,0)="record data in a caret delimited string. If this parameter is null or 0, "
^XWB(8994,3659,2,2,1,3,0)="the return defaults to the other array."
^XWB(8994,3659,2,2,1,4,0)="   1 - return alternate array with internal values in delimited string"
^XWB(8994,3659,2,3,0)="PXLOC^1^30^0^3"
^XWB(8994,3659,2,3,1,0)="^8994.021^9^9^3160816^^"
^XWB(8994,3659,2,3,1,1,0)="This optional input parameter is used to specify the institution"
^XWB(8994,3659,2,3,1,2,0)="(division) for which records should be returned at multidivisional"
^XWB(8994,3659,2,3,1,3,0)="facilities that may have immunization inventory specific to divisions."
^XWB(8994,3659,2,3,1,4,0)="Possible values are:"
^XWB(8994,3659,2,3,1,5,0)="  ""I:X"": Institution (#4) IEN #X"
^XWB(8994,3659,2,3,1,6,0)="  ""V:X"": Visit (#9000010) IEN #X"
^XWB(8994,3659,2,3,1,7,0)="  ""L:X"": Hopital Location (#44) IEN #X"
^XWB(8994,3659,2,3,1,8,0)="If determination cannot be made based off input, then default to DUZ(2),"
^XWB(8994,3659,2,3,1,9,0)="and if DUZ(2) is not defined, default to Default Institution."
^XWB(8994,3659,2,"B","FILTER",1)=""
^XWB(8994,3659,2,"B","PXLOC",3)=""
^XWB(8994,3659,2,"B","PXVI",2)=""
^XWB(8994,3659,2,"PARAMSEQ",1,1)=""
^XWB(8994,3659,2,"PARAMSEQ",2,2)=""
^XWB(8994,3659,2,"PARAMSEQ",3,3)=""
^XWB(8994,3659,3,0)="^8994.03^67^67^3160816^^^^"
^XWB(8994,3659,3,1,0)="Returns with PXVI not equal to 1:"
^XWB(8994,3659,3,2,0)="   PXVRETRN  - returned information is stored in ^TMP(""PXVLST"",$J))"
^XWB(8994,3659,3,3,0)="             - return info format: Data Element Name^Data Element Value"
^XWB(8994,3659,3,4,0)="             -       error format: -1^error message"
^XWB(8994,3659,3,5,0)="  "
^XWB(8994,3659,3,6,0)="For each record returned in the global array, the top value returned will"
^XWB(8994,3659,3,7,0)="indicate the record number in the array and the total number of records "
^XWB(8994,3659,3,8,0)="returned, e.g., ""RECORD^1 OF 3""."
^XWB(8994,3659,3,9,0)="  "
^XWB(8994,3659,3,10,0)="This RPC returns the internal entry number (IEN) of the record and data in"
^XWB(8994,3659,3,11,0)="external format from the following data fields in the IMMUNIZATION LOT"
^XWB(8994,3659,3,12,0)="file:"
^XWB(8994,3659,3,13,0)="   - LOT NUMBER (#.01)"
^XWB(8994,3659,3,14,0)="   - MANUFACTURER (#.02)"
^XWB(8994,3659,3,15,0)="   - STATUS (#.03)"
^XWB(8994,3659,3,16,0)="   - VACCINE (#.04)"
^XWB(8994,3659,3,17,0)="   - EXPIRATION DATE (#.09)"
^XWB(8994,3659,3,18,0)="   - ASSOCIATED VA FACILITY (#.1)"
^XWB(8994,3659,3,19,0)="   - DOSES UNUSED (#.12)"
^XWB(8994,3659,3,20,0)="   - LOW SUPPLY ALERT (#.15)"
^XWB(8994,3659,3,21,0)="   - NDC CODE (VA) (#.18)"
^XWB(8994,3659,3,22,0)="  "
^XWB(8994,3659,3,23,0)="  Example Global Array Returned:"
^XWB(8994,3659,3,24,0)="   ^TMP(""PXVLST"",$J,""P92A8769LN 1"",0)=""RECORD^1 OF 1"""
^XWB(8994,3659,3,25,0)="                                .001)=""IEN^6"""
^XWB(8994,3659,3,26,0)="                                 .01)=""LOT NUMBER^P92A8769LN"""
^XWB(8994,3659,3,27,0)="                                 .02)=""MANUFACTURER^SCLAVO, INC."""
^XWB(8994,3659,3,28,0)="                                 .03)=""STATUS^ACTIVE"""
^XWB(8994,3659,3,29,0)="                                 .04)=""VACCINE^ANTHRAX"""
^XWB(8994,3659,3,30,0)="                                 .09)=""EXPIRATION DATE^DEC 31, 2016"""
^XWB(8994,3659,3,31,0)="                                  .1)=""ASSOCIATED VA FACILITY^ALBANY"""
^XWB(8994,3659,3,32,0)="                                 .12)=""DOSES UNUSED^94"""
^XWB(8994,3659,3,33,0)="                                 .15)=""LOW SUPPLY ALERT^10"""
^XWB(8994,3659,3,34,0)="                                 .18)=""NDC CODE (VA)^"""
^XWB(8994,3659,3,35,0)="     "
^XWB(8994,3659,3,36,0)="  Example Global Array Returned if No Records Found:"
^XWB(8994,3659,3,37,0)="   ^TMP(""PXVLST"",$J,0)=""0 RECORDS"""
^XWB(8994,3659,3,38,0)="  "
^XWB(8994,3659,3,39,0)="  Example error messages:"
^XWB(8994,3659,3,40,0)="   ^TMP(""PXVLST"",$J,0)=""-1^Invalid input value"""
^XWB(8994,3659,3,41,0)="   ^TMP(""PXVLST"",$J,0)=""-1^Invalid input for immunization lot IEN"""
^XWB(8994,3659,3,42,0)="   ^TMP(""PXVLST"",$J,0)=""-1^Invalid input for lot number"""
^XWB(8994,3659,3,43,0)=" "
^XWB(8994,3659,3,44,0)="Returns with PXVI equal to 1:"
^XWB(8994,3659,3,45,0)="   PXVRETRN  - returned information is stored in ^TMP(""PXVLST"",$J))"
^XWB(8994,3659,3,46,0)=" "
^XWB(8994,3659,3,47,0)="   Each record is a caret-delimited list of values. Within the "
^XWB(8994,3659,3,48,0)="   caret-delimited list, for fields with different internal and external"
^XWB(8994,3659,3,49,0)="   values, both the internal and external values are included, delimited"
^XWB(8994,3659,3,50,0)="   by a tilde (~) as indicated below:"
^XWB(8994,3659,3,51,0)="    Piece# Field# Field Name"
^XWB(8994,3659,3,52,0)="    ------ ------ ----------"
^XWB(8994,3659,3,53,0)="    1             IEN             "
^XWB(8994,3659,3,54,0)="    2      .01    LOT NUMBER"
^XWB(8994,3659,3,55,0)="    3      .02    MANUFACTURER  (Internal~External)"
^XWB(8994,3659,3,56,0)="    4      .03    STATUS (Internal~External)"
^XWB(8994,3659,3,57,0)="    5      .04    VACCINE (Internal~External)"
^XWB(8994,3659,3,58,0)="    6      .09    EXPIRATION DATE (Internal~External)"
^XWB(8994,3659,3,59,0)="    7      .12    DOSES UNUSED"
^XWB(8994,3659,3,60,0)="    8      .15    LOW SUPPLY ALERT"
^XWB(8994,3659,3,61,0)="    9      .18    NDC CODE (VA) (Internal~External)"
^XWB(8994,3659,3,62,0)="   10      .1     ASSOCIATED VA FACILITY (Internal~External)"
^XWB(8994,3659,3,63,0)="  "
^XWB(8994,3659,3,64,0)="  Example Alternate Global Array:"
^XWB(8994,3659,3,65,0)="   ^TMP(""PXVLST"",$J,0)=1 RECORD "
^XWB(8994,3659,3,66,0)="                     6)=""6^P92A8769LN^49~SCLAVO, INC.^0~ACTIVE^41~ANTHRAX^"
^XWB(8994,3659,3,67,0)="                          3161231~DEC 31, 2016^93^10^~^500~ALBANY"""
^XWB(8994,3660,0)="PXVIMM IMM MAN^IMAN^PXVRPC1^4^^^^1"
^XWB(8994,3660,1,0)="^8994.01^2^2^3160201^^^^"
^XWB(8994,3660,1,1,0)="This RPC returns information from the IMM MANUFACTURER file "
^XWB(8994,3660,1,2,0)="(#9999999.04)."
^XWB(8994,3660,2,0)="^8994.02A^3^3"
^XWB(8994,3660,2,1,0)="FILTER^1^80^0^1"
^XWB(8994,3660,2,1,1,0)="^8994.021^10^10^3151006^^"
^XWB(8994,3660,2,1,1,1,0)="This input parameter is used to specify the IMMUNIZATION LOT file "
^XWB(8994,3660,2,1,1,2,0)="records to be returned. Possible values:"
^XWB(8994,3660,2,1,1,3,0)="   R:XXX - return entry with ien XXX"
^XWB(8994,3660,2,1,1,4,0)="   M:XXX - return entry with MVX code XXX"
^XWB(8994,3660,2,1,1,5,0)="   N:XXX - return entry with imm manufacturer name XXX   "
^XWB(8994,3660,2,1,1,6,0)="   S:A   - return list of all active manufacturers"
^XWB(8994,3660,2,1,1,7,0)="   S:I   - return list of all inactive manufacturers"
^XWB(8994,3660,2,1,1,8,0)="   S:B   - return list of all manufacturers, active and inactive"
^XWB(8994,3660,2,1,1,9,0)="  "
^XWB(8994,3660,2,1,1,10,0)="If this parameter is null, it defaults to ""S:B""."
^XWB(8994,3660,2,2,0)="PXVDATE^1^7^0^2"
^XWB(8994,3660,2,2,1,0)="^8994.021^3^3^3160201^^^"
^XWB(8994,3660,2,2,1,1,0)="This optional input parameter is used in determining status. Input "
^XWB(8994,3660,2,2,1,2,0)="should be in VA FileMan date format. The default value is the current "
^XWB(8994,3660,2,2,1,3,0)="date."
^XWB(8994,3660,2,3,0)="PXVI^1^1^0^3"
^XWB(8994,3660,2,3,1,0)="^^4^4^3160201^"
^XWB(8994,3660,2,3,1,1,0)="This optional input parameter is used to return an alternate array with "
^XWB(8994,3660,2,3,1,2,0)="record data in a caret delimited string. If this parameter is null or 0, "
^XWB(8994,3660,2,3,1,3,0)="the return defaults to the other array."
^XWB(8994,3660,2,3,1,4,0)="   1 - return alternate array with internal values in delimited string"
^XWB(8994,3660,2,"B","FILTER",1)=""
^XWB(8994,3660,2,"B","PXVDATE",2)=""
^XWB(8994,3660,2,"B","PXVI",3)=""
^XWB(8994,3660,2,"PARAMSEQ",1,1)=""
^XWB(8994,3660,2,"PARAMSEQ",2,2)=""
^XWB(8994,3660,2,"PARAMSEQ",3,3)=""
^XWB(8994,3660,3,0)="^^52^52^3160201^"
^XWB(8994,3660,3,1,0)="Returns with PXVI not equal to 1:"
^XWB(8994,3660,3,2,0)="   PXVRETRN  - returned information is stored in ^TMP(""PXVLST"",$J))"
^XWB(8994,3660,3,3,0)="             - return info format: Data Element Name^Data Element Value"
^XWB(8994,3660,3,4,0)="             -       error format: -1^error message"
^XWB(8994,3660,3,5,0)=" "
^XWB(8994,3660,3,6,0)="For each record returned in the global array, the top value returned will"
^XWB(8994,3660,3,7,0)="indicate the record number in the array and the total number of records "
^XWB(8994,3660,3,8,0)="returned, e.g., ""RECORD^1 OF 3""."
^XWB(8994,3660,3,9,0)=" "
^XWB(8994,3660,3,10,0)="This RPC returns the internal entry number (IEN) of the record and data"
^XWB(8994,3660,3,11,0)="in external format from the following data fields in the IMM"
^XWB(8994,3660,3,12,0)="MANUFACTURER file:"
^XWB(8994,3660,3,13,0)="  - NAME (#.01)"
^XWB(8994,3660,3,14,0)="  - MVX (#.02)"
^XWB(8994,3660,3,15,0)="  - INACTIVE FLAG (#.03)"
^XWB(8994,3660,3,16,0)="  - CDC NOTES (#201)"
^XWB(8994,3660,3,17,0)="  - STATUS (computed by Data Standardization utility)"
^XWB(8994,3660,3,18,0)=" "
^XWB(8994,3660,3,19,0)="  Example Global Array Returned:"
^XWB(8994,3660,3,20,0)="  ^TMP(""PXVLST"",$J,""WYETH-AYERST 1"",0)=""RECORD^1 OF 1"""
^XWB(8994,3660,3,21,0)="                                 .001)=""IEN^55"""
^XWB(8994,3660,3,22,0)="                                  .01)=""NAME^WYETH-AYERST"""
^XWB(8994,3660,3,23,0)="                                  .02)=""MVX CODE^WA"""
^XWB(8994,3660,3,24,0)="                                  .03)=""INACTIVE FLAG^INACTIVE"""
^XWB(8994,3660,3,25,0)="                                  201)=""CDC NOTES^became WAL, now owned by"
^XWB(8994,3660,3,26,0)="                                        Pfizer"""
^XWB(8994,3660,3,27,0)="                             ""STATUS"")=""STATUS^INACTIVE"""
^XWB(8994,3660,3,28,0)=" "
^XWB(8994,3660,3,29,0)="  Example Global Array Returned if No Records Found:"
^XWB(8994,3660,3,30,0)="  ^TMP(""PXVLST"",$J,0)=""0 RECORDS"""
^XWB(8994,3660,3,31,0)=" "
^XWB(8994,3660,3,32,0)="  Example error messages:"
^XWB(8994,3660,3,33,0)="  ^TMP(""PXVLST"",$J,0)=""-1^Invalid input value"""
^XWB(8994,3660,3,34,0)="  ^TMP(""PXVLST"",$J,0)=""-1^Invalid input for manufacturer IEN"""
^XWB(8994,3660,3,35,0)="  ^TMP(""PXVLST"",$J,0)=""-1^Invalid input for MVX code"""
^XWB(8994,3660,3,36,0)="  ^TMP(""PXVLST"",$J,0)=""-1^Invalid input for manufacturer name"""
^XWB(8994,3660,3,37,0)=" "
^XWB(8994,3660,3,38,0)="Returns with PXVI equal to 1:"
^XWB(8994,3660,3,39,0)="   PXVRETRN  - returned information is stored in ^TMP(""PXVLST"",$J))"
^XWB(8994,3660,3,40,0)=" "
^XWB(8994,3660,3,41,0)="   Each record is a caret-delimited list of values. Within the "
^XWB(8994,3660,3,42,0)="   caret-delimited list, for fields with different internal and external"
^XWB(8994,3660,3,43,0)="   values, both the internal and external values are included, delimited"
^XWB(8994,3660,3,44,0)="   by a tilde (~) as indicated below:"
^XWB(8994,3660,3,45,0)="    Piece# Field# Field Name"
^XWB(8994,3660,3,46,0)="    ------ ------ ----------"
^XWB(8994,3660,3,47,0)="    1             IEN             "
^XWB(8994,3660,3,48,0)="    2      .01    NAME"
^XWB(8994,3660,3,49,0)="    3      .02    MVX CODE"
^XWB(8994,3660,3,50,0)="    4      .03    INACTIVE FLAG (Internal~External)"
^XWB(8994,3660,3,51,0)="    5      201    CDC NOTES"
^XWB(8994,3660,3,52,0)="    6             STATUS (computed by Data Standardization utility)"
^XWB(8994,3661,0)="PXVIMM VIS^IVIS^PXVRPC1^4^^^^1"
^XWB(8994,3661,1,0)="^8994.01^2^2^3151102^^^^"
^XWB(8994,3661,1,1,0)="This RPC returns information from the VACCINE INFORMATION STATEMENT file "
^XWB(8994,3661,1,2,0)="(#920)."
^XWB(8994,3661,2,0)="^8994.02A^2^2"
^XWB(8994,3661,2,1,0)="FILTER^1^55^0^1"
^XWB(8994,3661,2,1,1,0)="^^9^9^3151006^"
^XWB(8994,3661,2,1,1,1,0)="This input parameter is used to specify the VACCINE INFORMATION "
^XWB(8994,3661,2,1,1,2,0)="STATEMENT file records to be returned."
^XWB(8994,3661,2,1,1,3,0)="   R:XXX - return entry with ien XXX"
^XWB(8994,3661,2,1,1,4,0)="   N:XXX - return entry with VIS name XXX   "
^XWB(8994,3661,2,1,1,5,0)="   S:A   - return list of all active VISs"
^XWB(8994,3661,2,1,1,6,0)="   S:I   - return list of all inactive VISs"
^XWB(8994,3661,2,1,1,7,0)="   S:B   - return list of all VISs, active and inactive"
^XWB(8994,3661,2,1,1,8,0)=" "
^XWB(8994,3661,2,1,1,9,0)="If this parameter is null, it defaults to ""S:B""."
^XWB(8994,3661,2,2,0)="PXVDATE^1^7^0^2"
^XWB(8994,3661,2,2,1,0)="^8994.021^3^3^3151008^^"
^XWB(8994,3661,2,2,1,1,0)="This optional input parameter is used in determining status. Input "
^XWB(8994,3661,2,2,1,2,0)="should be in VA FileMan date format. The default value is the current "
^XWB(8994,3661,2,2,1,3,0)="date."
^XWB(8994,3661,2,"B","FILTER",1)=""
^XWB(8994,3661,2,"B","PXVDATE",2)=""
^XWB(8994,3661,2,"PARAMSEQ",1,1)=""
^XWB(8994,3661,2,"PARAMSEQ",2,2)=""
^XWB(8994,3661,3,0)="^^52^52^3151102^"
^XWB(8994,3661,3,1,0)="Returns:"
^XWB(8994,3661,3,2,0)="  PXVRETRN  - returned information is stored in ^TMP(""PXVLST"",$J))"
^XWB(8994,3661,3,3,0)="            - return info format: Data Element Name^Data Element Value"
^XWB(8994,3661,3,4,0)="            -       error format: -1^error message"
^XWB(8994,3661,3,5,0)=" "
^XWB(8994,3661,3,6,0)="For each record returned in the global array, the top value returned will "
^XWB(8994,3661,3,7,0)="indicate the record number in the array and the total number of records "
^XWB(8994,3661,3,8,0)="returned, e.g., ""RECORD^1 OF 3""."
^XWB(8994,3661,3,9,0)=" "
^XWB(8994,3661,3,10,0)="This RPC returns the internal entry number (IEN) of the record and data"
^XWB(8994,3661,3,11,0)="in external format from the following data fields in the VACCINE"
^XWB(8994,3661,3,12,0)="INFORMATION STATEMENT file:"
^XWB(8994,3661,3,13,0)="  - NAME (#.01)"
^XWB(8994,3661,3,14,0)="  - EDITION DATE (#.02)"
^XWB(8994,3661,3,15,0)="  - EDITION STATUS (#.03)"
^XWB(8994,3661,3,16,0)="  - LANGUAGE (#.04)"
^XWB(8994,3661,3,17,0)="  - VIS TEXT (#2) (word-processing)"
^XWB(8994,3661,3,18,0)="  - 2D BAR CODE (#100)"
^XWB(8994,3661,3,19,0)="  - VIS URL (#101)"
^XWB(8994,3661,3,20,0)="  - STATUS (computed by Data Standardization utility)"
^XWB(8994,3661,3,21,0)=" "
^XWB(8994,3661,3,22,0)="Example Global Array Returned:"
^XWB(8994,3661,3,23,0)="(Stored in ^TMP(""PXVLST"",$J,""SHINGLES VIS 1"",)"
^XWB(8994,3661,3,24,0)="   0)=""RECORD^1 OF 1"""
^XWB(8994,3661,3,25,0)=" .001)=""IEN^27"""
^XWB(8994,3661,3,26,0)=" .01)=""NAME^SHINGLES VIS"""
^XWB(8994,3661,3,27,0)=" .02)=""EDITION DATE^OCT 06, 2009"""
^XWB(8994,3661,3,28,0)=" .03)=""EDITION STATUS^CURRENT"""
^XWB(8994,3661,3,29,0)=" .04)=""LANGUAGE^ENGLISH"""
^XWB(8994,3661,3,30,0)=" 2,1)=""VIS TEXT 1^Shingles  Vaccine: What you need to know """
^XWB(8994,3661,3,31,0)="   2)=""VIS TEXT 2^ """
^XWB(8994,3661,3,32,0)="   3)=""VIS TEXT 3^1. What is shingles?"""
^XWB(8994,3661,3,33,0)="   4)=""VIS TEXT 4^ """
^XWB(8994,3661,3,34,0)="   5)=""VIS TEXT 5^Shingles is a painful skin rash, often with blisters. It"
^XWB(8994,3661,3,35,0)="       is also called """
^XWB(8994,3661,3,36,0)="   ."
^XWB(8994,3661,3,37,0)="   ."
^XWB(8994,3661,3,38,0)="   ."
^XWB(8994,3661,3,39,0)="   117)=""VIS TEXT 117^ """
^XWB(8994,3661,3,40,0)="   118)=""VIS TEXT 118^Department of Health and Human Services"""
^XWB(8994,3661,3,41,0)="   119)=""VIS TEXT 119^Centers for Disease Control and Prevention"""
^XWB(8994,3661,3,42,0)=" 100)=""2D BAR CODE^253088698300020211091006"""
^XWB(8994,3661,3,43,0)=" 101)=""VIS URL^http://www.immunize.org/vis/shingles.pdf"""
^XWB(8994,3661,3,44,0)=" ""STATUS"")=""STATUS^ACTIVE"""
^XWB(8994,3661,3,45,0)=" "
^XWB(8994,3661,3,46,0)="Example Global Array Returned if No Records Found:"
^XWB(8994,3661,3,47,0)=" ^TMP(""PXVLST"",$J,0)=""0 RECORDS"""
^XWB(8994,3661,3,48,0)=" "
^XWB(8994,3661,3,49,0)="Example error messages:"
^XWB(8994,3661,3,50,0)=" ^TMP(""PXVLST"",$J,0)=""-1^Invalid input value"""
^XWB(8994,3661,3,51,0)=" ^TMP(""PXVLST"",$J,0)=""-1^Invalid input for VIS IEN"""
^XWB(8994,3661,3,52,0)=" ^TMP(""PXVLST"",$J,0)=""-1^Invalid input for VIS name"""
^XWB(8994,3662,0)="PXVIMM IMMDATA^IMMDATA^PXVRPC3^4^^^^1"
^XWB(8994,3662,1,0)="^8994.01^1^1^3151120^^^"
^XWB(8994,3662,1,1,0)="Returns entries from the IMMUNIZATION file (9999999.14)."
^XWB(8994,3662,2,0)="^8994.02A^2^2"
^XWB(8994,3662,2,1,0)="FILTER^1^^0^1"
^XWB(8994,3662,2,1,1,0)="^^8^8^3151021^"
^XWB(8994,3662,2,1,1,1,0)="This parameter is used to specify the IMMUNIZATION file records to be "
^XWB(8994,3662,2,1,1,2,0)="returned. Possible values:"
^XWB(8994,3662,2,1,1,3,0)="   R:XXX - return entry with ien XXX"
^XWB(8994,3662,2,1,1,4,0)="   S:A   - return list of active immunizations"
^XWB(8994,3662,2,1,1,5,0)="   S:H   - return list of [selectable for] historic immunizations"
^XWB(8994,3662,2,1,1,6,0)="   S:*   - return all records regardless of their status"
^XWB(8994,3662,2,1,1,7,0)=" "
^XWB(8994,3662,2,1,1,8,0)="If this parameter is null, it defaults to ""S:A""."
^XWB(8994,3662,2,2,0)="SUBFILES^1^1^0^2"
^XWB(8994,3662,2,2,1,0)="^8994.021^1^1^3151120^^"
^XWB(8994,3662,2,2,1,1,0)="A value of 1 or Y indicates that all subfile multiples should be included."
^XWB(8994,3662,2,"B","FILTER",1)=""
^XWB(8994,3662,2,"B","SUBFILES",2)=""
^XWB(8994,3662,2,"PARAMSEQ",1,1)=""
^XWB(8994,3662,2,"PARAMSEQ",2,2)=""
^XWB(8994,3662,3,0)="^8994.03^28^28^3151120^^"
^XWB(8994,3662,3,1,0)="The first record of the returned array contains the count of records "
^XWB(8994,3662,3,2,0)="being returned."
^XWB(8994,3662,3,3,0)="Each record is a caret-delimited list of values."
^XWB(8994,3662,3,4,0)="Piece# Field# Field Name"
^XWB(8994,3662,3,5,0)="------ ------ ----------"
^XWB(8994,3662,3,6,0)="1             IEN"
^XWB(8994,3662,3,7,0)="2      .01    NAME"
^XWB(8994,3662,3,8,0)="3      .02    SHORT NAME"
^XWB(8994,3662,3,9,0)="4      .03    CVX CODE"
^XWB(8994,3662,3,10,0)="5      .05    MAX # IN SERIES"
^XWB(8994,3662,3,11,0)="6      .07    INACTIVE FLAG"
^XWB(8994,3662,3,12,0)="7      8801   MNEMONIC"
^XWB(8994,3662,3,13,0)="8      8802   ACRONYM"
^XWB(8994,3662,3,14,0)="9      8803   SELECTABLE FOR HISTORIC"
^XWB(8994,3662,3,15,0)="(These subfiles are included when the SUBFILES parameter is set to 1)"
^XWB(8994,3662,3,16,0)="(Each multiple is separated by the pipe (|) character)"
^XWB(8994,3662,3,17,0)="10     2      CDC FULL VACCINE NAME"
^XWB(8994,3662,3,18,0)="11     3      CODING SYSTEM"
^XWB(8994,3662,3,19,0)="              (For each CODING SYSTEM, there are multiple CODE values.)"
^XWB(8994,3662,3,20,0)="              (CODING SYSTEM1~CODE1;;CODE2|CODING SYSTEM2~CODE3;;CODE4)"
^XWB(8994,3662,3,21,0)="12     4      VACCINE INFORMATION STATEMENT"
^XWB(8994,3662,3,22,0)="              (VIS1-IEN~VIS1-NAME|VIS2-IEN~VIS2-NAME)"
^XWB(8994,3662,3,23,0)="13     5      CDC PRODUCT NAME"
^XWB(8994,3662,3,24,0)="14     7      VACCINE GROUP NAME"
^XWB(8994,3662,3,25,0)="15     10     SYNONYM"
^XWB(8994,3662,3,26,0)="16     99.991 EFFECTIVE DATE/TIME"
^XWB(8994,3662,3,27,0)="              (There are date/time and status fields in each multiple.) "
^XWB(8994,3662,3,28,0)="              (EFFECTIVE DATE/TIME1~STATUS1|EFFECTIVE DATE/TIME2~STATUS2)"
^XWB(8994,3663,0)="PXVIMM ICR LIST^GETICR^PXVRPC5^2"
^XWB(8994,3663,1,0)="^8994.01^2^2^3211014^^^"
^XWB(8994,3663,1,1,0)="Returns entries from the IMM CONTRAINDICATION REASONS (#920.4) and IMM"
^XWB(8994,3663,1,2,0)="REFUSAL REASONS (#920.5) files."
^XWB(8994,3663,2,0)="^8994.02A^4^4"
^XWB(8994,3663,2,1,0)="PXFILE^1^^0^1"
^XWB(8994,3663,2,1,1,0)="^^6^6^3160129^"
^XWB(8994,3663,2,1,1,1,0)="Which file to pull from."
^XWB(8994,3663,2,1,1,2,0)="(Optional; Leave this null to pull entries from both files)"
^XWB(8994,3663,2,1,1,3,0)="Possible values are: "
^XWB(8994,3663,2,1,1,4,0)="   ""920.4"" - Only return entries from IMM CONTRAINDICATION REASONS"
^XWB(8994,3663,2,1,1,5,0)="             (#920.4)"
^XWB(8994,3663,2,1,1,6,0)="   ""920.5"" - Only return entries from IMM REFUSAL REASONS (#920.5)"
^XWB(8994,3663,2,2,0)="FILTER^1^^0^2"
^XWB(8994,3663,2,2,1,0)="^^13^13^3160129^"
^XWB(8994,3663,2,2,1,1,0)="Filter (Optional; Defaults to ""S:A"")"
^XWB(8994,3663,2,2,1,2,0)="Possible values are:"
^XWB(8994,3663,2,2,1,3,0)="   R:X   - Return entry with IEN X (PXFILE must be passed in with this "
^XWB(8994,3663,2,2,1,4,0)="           option)."
^XWB(8994,3663,2,2,1,5,0)="   C:X^Y - Return entry with Concept Code^Coding System X^Y (used only for"
^XWB(8994,3663,2,2,1,6,0)="           #920.4)."
^XWB(8994,3663,2,2,1,7,0)="   H:X   - Return entry with HL7 Code X (used only for #920.5)."
^XWB(8994,3663,2,2,1,8,0)="   N:X   - Return entry with #.01 field equal to X"
^XWB(8994,3663,2,2,1,9,0)="   I:X   - Return all active entries that are selectable for Immunization "
^XWB(8994,3663,2,2,1,10,0)="           IEN X."
^XWB(8994,3663,2,2,1,11,0)="   S:A   - Return all active entries."
^XWB(8994,3663,2,2,1,12,0)="   S:I   - Return all inactive entries."
^XWB(8994,3663,2,2,1,13,0)="   S:B   - Return all entries (both active and inactive)."
^XWB(8994,3663,2,3,0)="INST^1^^^3"
^XWB(8994,3663,2,3,1,0)="^^1^1^3211014^"
^XWB(8994,3663,2,3,1,1,0)="Institution IEN"
^XWB(8994,3663,2,4,0)="LOC^1^^^4"
^XWB(8994,3663,2,4,1,0)="^^2^2^3211014^"
^XWB(8994,3663,2,4,1,1,0)="Location IEN (If Institution IEN is not passed in, the loc will be used "
^XWB(8994,3663,2,4,1,2,0)="to get the institution)."
^XWB(8994,3663,2,"B","FILTER",2)=""
^XWB(8994,3663,2,"B","INST",3)=""
^XWB(8994,3663,2,"B","LOC",4)=""
^XWB(8994,3663,2,"B","PXFILE",1)=""
^XWB(8994,3663,2,"B","PXFLTR",2)=""
^XWB(8994,3663,2,"PARAMSEQ",1,1)=""
^XWB(8994,3663,2,"PARAMSEQ",2,2)=""
^XWB(8994,3663,2,"PARAMSEQ",3,3)=""
^XWB(8994,3663,2,"PARAMSEQ",4,4)=""
^XWB(8994,3663,3,0)="^^10^10^3211014^"
^XWB(8994,3663,3,1,0)="PXRSLT(0)=Count of elements returned (0 if nothing found)"
^XWB(8994,3663,3,2,0)="For 920.4 Entry:"
^XWB(8994,3663,3,3,0)="   PXRSLT(n)=IEN;PXV(920.4,^Name^Status (1:Active, 0:Inactive)^Code|Coding"
^XWB(8994,3663,3,4,0)="             System^NIP004^Contraindication/Precaution^Allergy-Related "
^XWB(8994,3663,3,5,0)="             (1:Yes, 0:No)^Default Warn Until Date (""Forever"" means it "
^XWB(8994,3663,3,6,0)="             should be forever)"
^XWB(8994,3663,3,7,0)="For 920.5 Entry:"
^XWB(8994,3663,3,8,0)="   PXRSLT(n)=IEN;PXV(920.5,^Name^Status (1:Active, 0:Inactive)^HL7 "
^XWB(8994,3663,3,9,0)="             Code^Default Warn Until Date (""Forever"" means it should be"
^XWB(8994,3663,3,10,0)="             forever)"
^XWB(8994,3664,0)="PXVIMM VICR EVENTS^GETVICR^PXVRPC5^2"
^XWB(8994,3664,1,0)="^^4^4^3211014^"
^XWB(8994,3664,1,1,0)="Returns ""active"" entries from the V IMM CONTRA/REFUSAL EVENTS file "
^XWB(8994,3664,1,2,0)="(#9000010.707) that are related to the given patient and immunization."
^XWB(8994,3664,1,3,0)="""Active"" is defined as entries where the Event Date and Time is <= "
^XWB(8994,3664,1,4,0)="PXDATE@24 and the Warn Until Date is null or>= PXDATE."
^XWB(8994,3664,2,0)="^8994.02A^4^4"
^XWB(8994,3664,2,1,0)="DFN^1^^1^1"
^XWB(8994,3664,2,1,1,0)="^^1^1^3160129^"
^XWB(8994,3664,2,1,1,1,0)="Pointer to file #2."
^XWB(8994,3664,2,2,0)="PXVIMM^1^^1^2"
^XWB(8994,3664,2,2,1,0)="^^1^1^3160129^"
^XWB(8994,3664,2,2,1,1,0)="Pointer to #9999999.14."
^XWB(8994,3664,2,3,0)="PXDATE^1^^0^3"
^XWB(8994,3664,2,3,1,0)="^^1^1^3160308^"
^XWB(8994,3664,2,3,1,1,0)="Used to determine if entry is ""active"" (Optional; Defaults to TODAY)"
^XWB(8994,3664,2,3,1,2,0)="Possible values are:"
^XWB(8994,3664,2,3,1,3,0)="   ""L"": Return a caret-delimited list of entries."
^XWB(8994,3664,2,3,1,4,0)="   ""W"": Returns a warning message."
^XWB(8994,3664,2,4,0)="PXFORMAT^1^^0^4"
^XWB(8994,3664,2,4,1,0)="^8994.021^4^4^3160405^^"
^XWB(8994,3664,2,4,1,1,0)="Format that return array should be returned (Optional; Defaults to ""L"")"
^XWB(8994,3664,2,4,1,2,0)="Possible values are: "
^XWB(8994,3664,2,4,1,3,0)="   ""L"": Return a caret-delimited list of entries."
^XWB(8994,3664,2,4,1,4,0)="   ""W"": Returns a warning message."
^XWB(8994,3664,2,"B","DFN",1)=""
^XWB(8994,3664,2,"B","PXDATE",3)=""
^XWB(8994,3664,2,"B","PXDATE",4)=""
^XWB(8994,3664,2,"B","PXFORMAT",3)=""
^XWB(8994,3664,2,"B","PXFORMAT",4)=""
^XWB(8994,3664,2,"B","PXVIMM",2)=""
^XWB(8994,3664,2,"PARAMSEQ",1,1)=""
^XWB(8994,3664,2,"PARAMSEQ",2,2)=""
^XWB(8994,3664,2,"PARAMSEQ",3,3)=""
^XWB(8994,3664,2,"PARAMSEQ",3,4)=""
^XWB(8994,3664,2,"PARAMSEQ",4,3)=""
^XWB(8994,3664,2,"PARAMSEQ",4,4)=""
^XWB(8994,3664,3,0)="^^9^9^3160405^"
^XWB(8994,3664,3,1,0)="PXRSLT(0)=Count of elements returned (0 if nothing found)"
^XWB(8994,3664,3,2,0)="If PXFORMAT=""L"":"
^XWB(8994,3664,3,3,0)="   PXRSLT(n)=""VICR"" ^ V IMM Contra/Refusal Events IEN ^ Visit IEN ^"
^XWB(8994,3664,3,4,0)="             Contra/Refusal variable pointer | Contra/Refusal Name ^"
^XWB(8994,3664,3,5,0)="             Immunization IEN | Name ^ Warn Until Date ^ D/T Recorded ^"
^XWB(8994,3664,3,6,0)="             Event D/T ^ Encounter Provider IEN | Name"
^XWB(8994,3664,3,7,0)="   PXRSLT(n)=""COM"" ^ Comments"
^XWB(8994,3664,3,8,0)="If PXFORMAT[""W"":"
^XWB(8994,3664,3,9,0)="   PXRSLT(n)=Warning text"
^XWB(8994,3665,0)="PXVIMM IMM SHORT LIST^IMMSHORT^PXVRPC4^2"
^XWB(8994,3665,1,0)="^8994.01^1^1^3211014^^^^"
^XWB(8994,3665,1,1,0)="Returns a short list of immunizations."
^XWB(8994,3665,2,0)="^8994.02A^4^4"
^XWB(8994,3665,2,1,0)="FILTER^1^^0^1"
^XWB(8994,3665,2,1,1,0)="^8994.021^6^6^3160129^^"
^XWB(8994,3665,2,1,1,1,0)="Filter (Optional; Defaults to ""B"")"
^XWB(8994,3665,2,1,1,2,0)="Possible values are: ;               "
^XWB(8994,3665,2,1,1,3,0)="   ""A"": Only return active entries"
^XWB(8994,3665,2,1,1,4,0)="   ""H"": Only return entries marked as Selectable for Historic"
^XWB(8994,3665,2,1,1,5,0)="   ""B"": Return both active entries and those marked as Selectable for"
^XWB(8994,3665,2,1,1,6,0)="        Historic"
^XWB(8994,3665,2,2,0)="PXDATE^1^^0^2"
^XWB(8994,3665,2,2,1,0)="^^3^3^3160129^"
^XWB(8994,3665,2,2,1,1,0)="Date (optional; defaults to TODAY)"
^XWB(8994,3665,2,2,1,2,0)="Used for determining immunization status (both for filtering and for"
^XWB(8994,3665,2,2,1,3,0)="return value)"
^XWB(8994,3665,2,3,0)="OREXCLUDE^1^^0^3"
^XWB(8994,3665,2,3,1,0)="^^1^1^3180327^"
^XWB(8994,3665,2,3,1,1,0)="Should entries defined in ORWPCE EXCLUDE IMMUNIZATIONS be excluded?"
^XWB(8994,3665,2,4,0)="LOCATION^1^^0^4"
^XWB(8994,3665,2,4,1,0)="^8994.021^3^3^3211014^^^"
^XWB(8994,3665,2,4,1,1,0)="Used when excluding entried listed in ORWPCE EXCLUDE IMMUNIZATIONS. This"
^XWB(8994,3665,2,4,1,2,0)="is the location used when getting the paramater value at the Location"
^XWB(8994,3665,2,4,1,3,0)="level."
^XWB(8994,3665,2,"B","FILTER",1)=""
^XWB(8994,3665,2,"B","LOCATION",4)=""
^XWB(8994,3665,2,"B","OREXCLUDE",3)=""
^XWB(8994,3665,2,"B","PXDATE",2)=""
^XWB(8994,3665,2,"B","PXFILTER",1)=""
^XWB(8994,3665,2,"PARAMSEQ",1,1)=""
^XWB(8994,3665,2,"PARAMSEQ",2,2)=""
^XWB(8994,3665,2,"PARAMSEQ",3,3)=""
^XWB(8994,3665,2,"PARAMSEQ",4,4)=""
^XWB(8994,3665,3,0)="^^24^24^3211014^"
^XWB(8994,3665,3,1,0)="PXRTRN(x)"
^XWB(8994,3665,3,2,0)="   Note: Status (in the 5th piece) is determined as follows:"
^XWB(8994,3665,3,3,0)="     - If PXDATE is today, the status is based off the Inactive Flag"
^XWB(8994,3665,3,4,0)="       (#.07)"
^XWB(8994,3665,3,5,0)="     - If PXDATE is different than today, we will look when an update was"
^XWB(8994,3665,3,6,0)="       last made to the Immunization file (based off the Audits). If there"
^XWB(8994,3665,3,7,0)="       have not been any changes since PXDATE, we will get the status"
^XWB(8994,3665,3,8,0)="       based off the Inactive Flag, otherwise, we will get the status for"
^XWB(8994,3665,3,9,0)="       that date by calling GETSTAT^XTID."
^XWB(8994,3665,3,10,0)="   1: ""IMM"""
^XWB(8994,3665,3,11,0)="   2: #9999999.14 IEN"
^XWB(8994,3665,3,12,0)="   3: Name (#.01)"
^XWB(8994,3665,3,13,0)="   4: CVX Code (#.03)"
^XWB(8994,3665,3,14,0)="   5: Status (1: Active; 0: Inactive)"
^XWB(8994,3665,3,15,0)="   6: Selectable for Historic (#8803)"
^XWB(8994,3665,3,16,0)="   7: Mnemonic (#8801)"
^XWB(8994,3665,3,17,0)="   8: Acronym (#8802)"
^XWB(8994,3665,3,18,0)="   9: Active Lot linked to this Immunization? (1:Yes; 0:No)"
^XWB(8994,3665,3,19,0)="PXRTRN(x)"
^XWB(8994,3665,3,20,0)="   1: ""CDC"""
^XWB(8994,3665,3,21,0)="   2: CDC Product Name (#9999999.145, #.01)"
^XWB(8994,3665,3,22,0)="PXRTRN(x)"
^XWB(8994,3665,3,23,0)="   1: ""GROUP"""
^XWB(8994,3665,3,24,0)="   2: Vaccine Group Name  (#9999999.147, #.01)"
^XWB(8994,3666,0)="PXVIMM IMM DETAILED^IMMRPC^PXVRPC4^4^^^^1"
^XWB(8994,3666,1,0)="^8994.01^1^1^3211014^^^^"
^XWB(8994,3666,1,1,0)="Returns a detailed Immunization record"
^XWB(8994,3666,2,0)="^8994.02A^3^3"
^XWB(8994,3666,2,1,0)="PXIMM^1^^1^1"
^XWB(8994,3666,2,1,1,0)="^8994.021^1^1^3160812^^"
^XWB(8994,3666,2,1,1,1,0)="Pointer to #9999999.14 (Required)"
^XWB(8994,3666,2,2,0)="PXDATE^1^^0^2"
^XWB(8994,3666,2,2,1,0)="^8994.021^2^2^3160620^^^^"
^XWB(8994,3666,2,2,1,1,0)="Immunization status and Codes will be based off this date"
^XWB(8994,3666,2,2,1,2,0)="(Optional; Defaults to NOW)"
^XWB(8994,3666,2,3,0)="PXLOC^1^^0^3"
^XWB(8994,3666,2,3,1,0)="^8994.021^9^9^3211014^^"
^XWB(8994,3666,2,3,1,1,0)="Used to determine Institution, when filtering Lot and Defaults (Optional)."
^XWB(8994,3666,2,3,1,2,0)="Possible values are:"
^XWB(8994,3666,2,3,1,3,0)="   ""I:X"": Institution (#4) IEN #X"
^XWB(8994,3666,2,3,1,4,0)="   ""V:X"": Visit (#9000010) IEN #X"
^XWB(8994,3666,2,3,1,5,0)="   ""L:X"": Hopital Location (#44) IEN #X"
^XWB(8994,3666,2,3,1,6,0)="        "
^XWB(8994,3666,2,3,1,7,0)="If PXLOC is not passed in OR could not make determination based off input,"
^XWB(8994,3666,2,3,1,8,0)="then default to DUZ(2), and if DUZ(2) is not defined, default to Default"
^XWB(8994,3666,2,3,1,9,0)="Institution."
^XWB(8994,3666,2,"B","PXDATE",2)=""
^XWB(8994,3666,2,"B","PXIMM",1)=""
^XWB(8994,3666,2,"B","PXLOC",3)=""
^XWB(8994,3666,2,"PARAMSEQ",1,1)=""
^XWB(8994,3666,2,"PARAMSEQ",2,2)=""
^XWB(8994,3666,2,"PARAMSEQ",3,3)=""
^XWB(8994,3666,3,0)="^^83^83^3211014^"
^XWB(8994,3666,3,1,0)="^TMP(""PXVIMMRPC"",$J,0)"
^XWB(8994,3666,3,2,0)="   1:  1 - Immunization was found. The ""1"" node will be returned, but the"
^XWB(8994,3666,3,3,0)="           other nodes are optional."
^XWB(8994,3666,3,4,0)="      -1 - Immunization was not found; no other nodes will be returned"
^XWB(8994,3666,3,5,0)="^TMP(""PXVIMMRPC"",$J,1)"
^XWB(8994,3666,3,6,0)="   Note: Status (in the 5th piece) is determined as follows:"
^XWB(8994,3666,3,7,0)="     - If PXDATE is today, the status is based off the Inactive Flag"
^XWB(8994,3666,3,8,0)="       (#.07)"
^XWB(8994,3666,3,9,0)="     - If PXDATE is different than today, we will look when an update was"
^XWB(8994,3666,3,10,0)="       last made to the Immunization file (based off the Audits). If there"
^XWB(8994,3666,3,11,0)="       have not been any changes since PXDATE, we will get the status"
^XWB(8994,3666,3,12,0)="       based off the Inactive Flag, otherwise, we will get the status for"
^XWB(8994,3666,3,13,0)="       that date by calling GETSTAT^XTID."
^XWB(8994,3666,3,14,0)="   1: ""IMM"""
^XWB(8994,3666,3,15,0)="   2: #9999999.14 IEN"
^XWB(8994,3666,3,16,0)="   3: Name (#.01)"
^XWB(8994,3666,3,17,0)="   4: CVX Code (#.03)"
^XWB(8994,3666,3,18,0)="   5: Status (1: Active; 0: Inactive)"
^XWB(8994,3666,3,19,0)="   6: Selectable for Historic (#8803)"
^XWB(8994,3666,3,20,0)="   7: Mnemonic (#8801)"
^XWB(8994,3666,3,21,0)="   8: Acronym (#8802)"
^XWB(8994,3666,3,22,0)="   9: Max # In Series (#.05)"
^XWB(8994,3666,3,23,0)="  10: Combination Immunization (Y/N) (#.2)"
^XWB(8994,3666,3,24,0)="  11: Reading Required (#.51)"
^XWB(8994,3666,3,25,0)="  12: Series Required (calculated)"
^XWB(8994,3666,3,26,0)="^TMP(""PXVIMMRPC"",$J,x)"
^XWB(8994,3666,3,27,0)="   1: ""VIS"""
^XWB(8994,3666,3,28,0)="   2: #920 IEN"
^XWB(8994,3666,3,29,0)="   3: Name (#920,#.01)"
^XWB(8994,3666,3,30,0)="   4: Edition Date (#920,#.02)"
^XWB(8994,3666,3,31,0)="   5: Edition Status (#920,#.03)"
^XWB(8994,3666,3,32,0)="   6: Language (#920, #.04)"
^XWB(8994,3666,3,33,0)="   7: 2D Bar Code (#100)"
^XWB(8994,3666,3,34,0)="   8: VIS URL (#101)"
^XWB(8994,3666,3,35,0)="^TMP(""PXVIMMRPC"",$J,x)"
^XWB(8994,3666,3,36,0)="   1: ""CDC"""
^XWB(8994,3666,3,37,0)="   2: CDC Product Name (#9999999.145, #.01)"
^XWB(8994,3666,3,38,0)="^TMP(""PXVIMMRPC"",$J,x)"
^XWB(8994,3666,3,39,0)="   1: ""GROUP"""
^XWB(8994,3666,3,40,0)="   2: Vaccine Group Name (#9999999.147, #.01)"
^XWB(8994,3666,3,41,0)="^TMP(""PXVIMMRPC"",$J,x)"
^XWB(8994,3666,3,42,0)="   1: ""SYNONYM"""
^XWB(8994,3666,3,43,0)="   2: Synonym (#9999999.141, #.01)"
^XWB(8994,3666,3,44,0)="^TMP(""PXVIMMRPC"",$J,x)"
^XWB(8994,3666,3,45,0)="   Note: Only active codes (based off PXDATE) are returned."
^XWB(8994,3666,3,46,0)="   1: ""CS"""
^XWB(8994,3666,3,47,0)="   2: Coding System (#9999999.143, #.01)"
^XWB(8994,3666,3,48,0)="   3: Code (#9999999.1431,#.01)"
^XWB(8994,3666,3,49,0)="   4: Variable pointer. e.g., IEN;ICPT("
^XWB(8994,3666,3,50,0)="   5: Short Description"
^XWB(8994,3666,3,51,0)="^TMP(""PXVIMMRPC"",$J,x)"
^XWB(8994,3666,3,52,0)="   Note: Only active lots for the given division are returned."
^XWB(8994,3666,3,53,0)="         Also, the Expiration date must be >= PXDATE"
^XWB(8994,3666,3,54,0)="   1: ""LOT"""
^XWB(8994,3666,3,55,0)="   2: #9999999.41 IEN"
^XWB(8994,3666,3,56,0)="   3: Lot Number (#9999999.41, #.01)"
^XWB(8994,3666,3,57,0)="   4: Manufacturer (#9999999.04, #.01)"
^XWB(8994,3666,3,58,0)="   5: Expiration Date (#9999999.41, #.09)"
^XWB(8994,3666,3,59,0)="   6: Doses Unused (#9999999.41, #.12)"
^XWB(8994,3666,3,60,0)="   7: Low Supply Alert (#9999999.41, #.15)"
^XWB(8994,3666,3,61,0)="   8: NDC Code (#9999999.41, #.18)"
^XWB(8994,3666,3,62,0)="^TMP(""PXVIMMRPC"",$J,x)"
^XWB(8994,3666,3,63,0)="   Note: Only active contraindications are returned"
^XWB(8994,3666,3,64,0)="   1: ""CONTRA"""
^XWB(8994,3666,3,65,0)="   2: #920.4 variable pointer: IEN;PXV(920.4,"
^XWB(8994,3666,3,66,0)="   3: Name (#920.4, #.01)"
^XWB(8994,3666,3,67,0)="   4: Status (1:Active, 0:Inactive)"
^XWB(8994,3666,3,68,0)="   5: Code|Coding System (#920.4, #.02 and .05)"
^XWB(8994,3666,3,69,0)="   6: NIP004 (#920.4, #.04)"
^XWB(8994,3666,3,70,0)="   7: Contraindication/Precaution (#920.4, #.06)"
^XWB(8994,3666,3,71,0)="   8: Allergy-Related (1:Yes, 0:No)"
^XWB(8994,3666,3,72,0)="   9: Default Warn Until Date (""Forever"" means it should be forever)"
^XWB(8994,3666,3,73,0)="^TMP(""PXVIMMRPC"",$J,x)"
^XWB(8994,3666,3,74,0)="   1: ""DEF"""
^XWB(8994,3666,3,75,0)="   2: Default Route (#920.051, #1302)"
^XWB(8994,3666,3,76,0)="   3: Default Site (#920.051, #1303)"
^XWB(8994,3666,3,77,0)="   4: Default Dose (#920.051, #1312)"
^XWB(8994,3666,3,78,0)="   5: Default Dose Units (#920.051, #1313)"
^XWB(8994,3666,3,79,0)="   6: Default Dose Units (external format) (#920.051, #1313)"
^XWB(8994,3666,3,80,0)="   7: Default Non-Standard Dose Units (#920.051, #1314)"
^XWB(8994,3666,3,81,0)="^TMP(""PXVIMMRPC"",$J,x)"
^XWB(8994,3666,3,82,0)="   1: ""DEFC"""
^XWB(8994,3666,3,83,0)="   2: Default Comments (#920.051, #81101)"
^XWB(8994,3667,0)="PXVIMM ADMIN CODES^IMMADMCODES^PXVRPC4^2"
^XWB(8994,3667,1,0)="^8994.01^1^1^3211013^^"
^XWB(8994,3667,1,1,0)="Returns immunization administration CPT codes."
^XWB(8994,3667,2,0)="^8994.02A^3^3"
^XWB(8994,3667,2,1,0)="VISIT^1^^^1"
^XWB(8994,3667,2,2,0)="PCELIST^2^^1^2"
^XWB(8994,3667,2,3,0)="RETCPTDEL^1^^^3"
^XWB(8994,3667,2,"B","PCELIST",2)=""
^XWB(8994,3667,2,"B","RETCPTDEL",3)=""
^XWB(8994,3667,2,"B","VISIT",1)=""
^XWB(8994,3667,2,"PARAMSEQ",1,1)=""
^XWB(8994,3667,2,"PARAMSEQ",2,2)=""
^XWB(8994,3667,2,"PARAMSEQ",3,3)=""
^XWB(8994,3667,3,0)="^^2^2^3211013^"
^XWB(8994,3667,3,1,0)="PXRSLT(n) = Array of CPT codes to add/delete from Visit in format passed "
^XWB(8994,3667,3,2,0)="to PX SAVE DATA rpc."
^XWB(8994,3667,3,3,0)="   Note: Only active codes (based off PXDATE) are returned."
^XWB(8994,3667,3,4,0)="   1: ""CPT-ADM"" or ""CPT-ADD"""
^XWB(8994,3667,3,5,0)="   2: Code"
^XWB(8994,3667,3,6,0)="   3: Variable pointer. e.g., IEN;ICPT("
^XWB(8994,3667,3,7,0)="   4: Short Description"
^XWB(8994,3668,0)="PXVIMM IMM FORMAT^GETTEXT^PXVRPC6^2"
^XWB(8994,3668,1,0)="^8994.01^2^2^3160408^^^"
^XWB(8994,3668,1,1,0)="This RPC takes an input array of immunization properties set from the GUI."
^XWB(8994,3668,1,2,0)="It returns a formatted text of an immunization for use in documentation."
^XWB(8994,3668,2,0)="^8994.02A^1^1"
^XWB(8994,3668,2,1,0)="INPUT^2^^1^1"
^XWB(8994,3668,2,1,1,0)="^8994.021^12^12^3160408^^"
^XWB(8994,3668,2,1,1,1,0)="INPUT(n)=IMM ^ Imm IEN ^  ^ Date Administered (for immunizations) / Date "
^XWB(8994,3668,2,1,1,2,0)="         Contra-Refusal Event Documented (for contra/refusals) ^ Warn"
^XWB(8994,3668,2,1,1,3,0)="         Until Date (for contra/refusals) ^ Series ^ Refusal reason ^"
^XWB(8994,3668,2,1,1,4,0)="         Contraindication Reason ^ Ordered By ^ Administered By (for VA "
^XWB(8994,3668,2,1,1,5,0)="         administered) / Documented By (for historical) ^ Document Type"
^XWB(8994,3668,2,1,1,6,0)="         (""Historical""/""Administered"") ^ Information Source"
^XWB(8994,3668,2,1,1,7,0)="     (n)=LOC ^ File #44 IEN ^  ^  ^ Outside Location (for historicals)"
^XWB(8994,3668,2,1,1,8,0)="     (n)=ROUTE ^ Route ^ Site ^ Dosage"
^XWB(8994,3668,2,1,1,9,0)="     (n)=VIS ^ VIS Name ^ Edition Date ^ Language"
^XWB(8994,3668,2,1,1,10,0)="     (n)=LOT ^ Lot # ^ Manufacturer ^ Exp Date"
^XWB(8994,3668,2,1,1,11,0)="     (n)=COM ^ Comment"
^XWB(8994,3668,2,1,1,12,0)="     (n)=OVER ^ Override Reason"
^XWB(8994,3668,2,"B","INPUT",1)=""
^XWB(8994,3668,2,"PARAMSEQ",1,1)=""
^XWB(8994,3668,3,0)="^8994.03^1^1^3160408^^^"
^XWB(8994,3668,3,1,0)="Formatted text of an immunization for use in documentation."
^XWB(8994,3669,0)="PXVIMM VIMM DATA^RPC^PXVRPC7^4^S^^^0"
^XWB(8994,3669,1,0)="^^40^40^3160718^"
^XWB(8994,3669,1,1,0)="Returns immunization records from the V Immunization and V Immunization "
^XWB(8994,3669,1,2,0)="Deleted file. There are two methods for defining the criteria to determine"
^XWB(8994,3669,1,3,0)="which records to return."
^XWB(8994,3669,1,4,0)=" "
^XWB(8994,3669,1,5,0)="  1. A specific list of record IDs can be passed in, and only those"
^XWB(8994,3669,1,6,0)="     records will be returned (if they exist on the system). When called"
^XWB(8994,3669,1,7,0)="     in this way, the list of records should be passed in LIST, and FILTER"
^XWB(8994,3669,1,8,0)="     should not be defined (if both LIST and FILTER are defined, only the"
^XWB(8994,3669,1,9,0)="     records listed in LIST will be returned, and the search criteria in"
^XWB(8994,3669,1,10,0)="     FILTER will be ignored)."
^XWB(8994,3669,1,11,0)=" "
^XWB(8994,3669,1,12,0)="     If an invalid IEN was passed in, the following error will be"
^XWB(8994,3669,1,13,0)="     returned: ""Record with IEN #xxx does not exist."""
^XWB(8994,3669,1,14,0)="            "
^XWB(8994,3669,1,15,0)="     If the record could not be returned for some other reason, the"
^XWB(8994,3669,1,16,0)="     following error will be returned: ""Unable to return record with IEN"
^XWB(8994,3669,1,17,0)="     #xxx."""
^XWB(8994,3669,1,18,0)=" "
^XWB(8994,3669,1,19,0)="  2. A time range (and other filter criteria) can be passed in FILTER, and"
^XWB(8994,3669,1,20,0)="     a list of records that meet that criteria will be returned. Any"
^XWB(8994,3669,1,21,0)="     record last modified or deleted (if FILTER(""INC DELETE"")=1) within"
^XWB(8994,3669,1,22,0)="     that time range will be returned."
^XWB(8994,3669,1,23,0)=" "
^XWB(8994,3669,1,24,0)="     To limit the number of records returned, FILTER(""MAX"") can be set to"
^XWB(8994,3669,1,25,0)="     the maximum number of records to be returned. The RPC will return a"
^XWB(8994,3669,1,26,0)="     value called ""BOOKMARK"". That value can be used to call the RPC"
^XWB(8994,3669,1,27,0)="     again, this time passing in the ""BOOKMARK"" value in"
^XWB(8994,3669,1,28,0)="     FILTER(""BOOKMARK"") (all other parameters should be defined exactly as"
^XWB(8994,3669,1,29,0)="     when previously called), and the RPC will return the next n number of"
^XWB(8994,3669,1,30,0)="     records that meet the search criteria, and starting where the"
^XWB(8994,3669,1,31,0)="     previous call left off. So for example, if there are 1,000 records"
^XWB(8994,3669,1,32,0)="     that meet the search criteria, and FILTER(""MAX"") is set to return a"
^XWB(8994,3669,1,33,0)="     maximum of 100 records, the RPC will need to be called 10 times in"
^XWB(8994,3669,1,34,0)="     order to return all 1,000 records. Each subsequent time the RPC is"
^XWB(8994,3669,1,35,0)="     called, the caller would set FILTER(""BOOKMARK"") to the bookmark value"
^XWB(8994,3669,1,36,0)="     returned in the previous call. The caller would know when they reach"
^XWB(8994,3669,1,37,0)="     the end and that there are no more records to be returned, when the"
^XWB(8994,3669,1,38,0)="     RPC returns TOTAL ITEMS=0."
^XWB(8994,3669,1,39,0)=" "
^XWB(8994,3669,1,40,0)="Note: All date/time references are to be in FileMan format."
^XWB(8994,3669,2,0)="^8994.02A^4^4"
^XWB(8994,3669,2,1,0)="FILTER^2^^0^1"
^XWB(8994,3669,2,1,1,0)="^^20^20^3160602^"
^XWB(8994,3669,2,1,1,1,0)="Search criteria (Optional)."
^XWB(8994,3669,2,1,1,2,0)="        (""START"") - Start date/time to begin search from (Defaults to T-1)"
^XWB(8994,3669,2,1,1,3,0)="         (""STOP"") - Stop date/time to end search (if time is not"
^XWB(8994,3669,2,1,1,4,0)="                    specified, midnight is assumed). (Defaults to T-1)"
^XWB(8994,3669,2,1,1,5,0)=" (""DATA SRC EXC"") - A semi-colon delimited list of Data Source names (in"
^XWB(8994,3669,2,1,1,6,0)="                    external format) (e.g., SRC1;SRC2;SRCn). (Optional)"
^XWB(8994,3669,2,1,1,7,0)="                    Any immunization record whose DATA SOURCE matches one"
^XWB(8994,3669,2,1,1,8,0)="                    of the data names in this list will be filtered out,"
^XWB(8994,3669,2,1,1,9,0)="                    and will not be returned."
^XWB(8994,3669,2,1,1,10,0)="          (""MAX"") - The maximum number of records to return (defaults to"
^XWB(8994,3669,2,1,1,11,0)="                    99)"
^XWB(8994,3669,2,1,1,12,0)="     (""BOOKMARK"") - If wanting to get the next n number of records, the"
^XWB(8994,3669,2,1,1,13,0)="                    bookmark value returned in the previous call should be"
^XWB(8994,3669,2,1,1,14,0)="                    passed here. (Optional)"
^XWB(8994,3669,2,1,1,15,0)="   (""INC DELETE"") - Flag to control if records should also be returned"
^XWB(8994,3669,2,1,1,16,0)="                    from the V IMMUNIZATION DELETED file. (defaults to"
^XWB(8994,3669,2,1,1,17,0)="                    ""1"")."
^XWB(8994,3669,2,1,1,18,0)="                    1 - Include records from both the V IMMUNIZATION and V"
^XWB(8994,3669,2,1,1,19,0)="                        IMMUNIZATION DELETED files "
^XWB(8994,3669,2,1,1,20,0)="                    0 - Only include records from the V IMMUNIZATION file."
^XWB(8994,3669,2,2,0)="LIST^2^^0^2"
^XWB(8994,3669,2,2,1,0)="^^4^4^3160523^"
^XWB(8994,3669,2,2,1,1,0)="A list of record numbers (IENs) to return. (Optional)"
^XWB(8994,3669,2,2,1,2,0)="To specify an IEN from the V IMMUNIZATION file, set LIST(IEN)=""""."
^XWB(8994,3669,2,2,1,3,0)="To specify an IEN from the V IMMUNIZATION DELETED file, set"
^XWB(8994,3669,2,2,1,4,0)="LIST(IEN_""D"")=""""  (e.g., PXLIST(""123D"")="""")."
^XWB(8994,3669,2,3,0)="DATE^1^^0^3"
^XWB(8994,3669,2,3,1,0)="^^22^22^3160531^"
^XWB(8994,3669,2,3,1,1,0)="A date in FileMan format. (Optional)"
^XWB(8994,3669,2,3,1,2,0)="It is used when the caller wants to see how the records being returned"
^XWB(8994,3669,2,3,1,3,0)="changed since that date. When populated, it is used in a number of ways:"
^XWB(8994,3669,2,3,1,4,0)="  1. Additions: If a record was added after that date, and later edited,"
^XWB(8994,3669,2,3,1,5,0)="     we will return the record as if it's a new record (i.e., TYPE=""ADD"")"
^XWB(8994,3669,2,3,1,6,0)="     (even though it's truly an edited record), as from that date's"
^XWB(8994,3669,2,3,1,7,0)="     perspective this is a new record."
^XWB(8994,3669,2,3,1,8,0)="  2. Edits: a) We will return two versions of an edited record. One, will"
^XWB(8994,3669,2,3,1,9,0)="     be the way the record existed on that date (i.e.,"
^XWB(8994,3669,2,3,1,10,0)="     TYPE=""UPDATE-BEFORE""). Two, will be the current state of the record"
^XWB(8994,3669,2,3,1,11,0)="     (i.e., TYPE=""UPDATE-AFTER""). b) if no significant changes have been"
^XWB(8994,3669,2,3,1,12,0)="     made to this record since that date (i.e., the record was edited"
^XWB(8994,3669,2,3,1,13,0)="     after that date, but none of the fields that are returned in this"
^XWB(8994,3669,2,3,1,14,0)="     call were modified with that edit), then we will not return this"
^XWB(8994,3669,2,3,1,15,0)="     record, as nothing significant changed since that date."
^XWB(8994,3669,2,3,1,16,0)="  3. Deletes: a) If a record was added after that date and later deleted,"
^XWB(8994,3669,2,3,1,17,0)="     we won't return the record, as on that date the record did not exist,"
^XWB(8994,3669,2,3,1,18,0)="     and the current record is deleted, so nothing really changed since"
^XWB(8994,3669,2,3,1,19,0)="     that date. b) If a record was edited after that date and then"
^XWB(8994,3669,2,3,1,20,0)="     deleted, the deleted record will be returned the way it existed on"
^XWB(8994,3669,2,3,1,21,0)="     that date, as from that date's perspective that is what the deleted"
^XWB(8994,3669,2,3,1,22,0)="     record looked like."
^XWB(8994,3669,2,4,0)="DEMOGRAPHICS^1^^0^4"
^XWB(8994,3669,2,4,1,0)="^8994.021^1^1^3160602^^"
^XWB(8994,3669,2,4,1,1,0)="Return patient demographics? (1=Yes/0=No). (Defaults to ""1"")."
^XWB(8994,3669,2,"B","DATE",3)=""
^XWB(8994,3669,2,"B","DEMOGRAPHICS",4)=""
^XWB(8994,3669,2,"B","FILTER",1)=""
^XWB(8994,3669,2,"B","LIST",2)=""
^XWB(8994,3669,2,"PARAMSEQ",1,1)=""
^XWB(8994,3669,2,"PARAMSEQ",2,2)=""
^XWB(8994,3669,2,"PARAMSEQ",3,3)=""
^XWB(8994,3669,2,"PARAMSEQ",4,4)=""
^XWB(8994,3669,3,0)="^8994.03^19^19^3160602^^"
^XWB(8994,3669,3,1,0)="A list of records that meet the search criteria."
^XWB(8994,3669,3,2,0)=" "
^XWB(8994,3669,3,3,0)="Each item returned will contain an immunization object, and if "
^XWB(8994,3669,3,4,0)="demographics are requested, a patient object."
^XWB(8994,3669,3,5,0)="        "
^XWB(8994,3669,3,6,0)="The immunization object can be called: IMM-ADD, IMM-DELETE, IMM-UPDATE,"
^XWB(8994,3669,3,7,0)="IMM-UPDATE-BEFORE, or IMM-UPDATE-AFTER."
^XWB(8994,3669,3,8,0)="  o IMM-ADD - Used when the immunization record is a ""new"" record."
^XWB(8994,3669,3,9,0)="  o IMM-DELETE - Used when the immunizatin record is a deleted record."
^XWB(8994,3669,3,10,0)="  o IMM-UPDATE - Used wehn the immunizatin record was edited (and the"
^XWB(8994,3669,3,11,0)="    caller did not pass in DATE)."
^XWB(8994,3669,3,12,0)="  o IMM-UPDATE-BEFORE/IMM-UPDATE-AFTER - Used when the immunizatin record"
^XWB(8994,3669,3,13,0)="    was edited and the called passed in DATE. Two objects will be"
^XWB(8994,3669,3,14,0)="    returned. The IMM-UPDATE-BEFORE object will be the way the record"
^XWB(8994,3669,3,15,0)="    existed before that date, and the IMM-UPDATE-AFTER will be the current"
^XWB(8994,3669,3,16,0)="    state of the record."
^XWB(8994,3669,3,17,0)="        "
^XWB(8994,3669,3,18,0)="For more details on the fields and attributes of the immunization and"
^XWB(8994,3669,3,19,0)="patient objects, please see the documentation."
^XWB(8994,3670,0)="PXVSK SKIN SHORT LIST^SKSHORT^PXVRPC8^2^S^^^"
^XWB(8994,3670,1,0)="^8994.01^1^1^3180327^^^"
^XWB(8994,3670,1,1,0)="Returns one or more entries from the Skin Test file."
^XWB(8994,3670,2,0)="^8994.02A^4^4"
^XWB(8994,3670,2,1,0)="DATE^1^^0^1"
^XWB(8994,3670,2,1,1,0)="^^1^1^3160603^"
^XWB(8994,3670,2,1,1,1,0)="Used for determining skin test status. (Defaults to TODAY)."
^XWB(8994,3670,2,2,0)="FILTER^1^^0^2"
^XWB(8994,3670,2,2,1,0)="^^8^8^3180322^"
^XWB(8994,3670,2,2,1,1,0)="Used to filter entries. (Optional; Defaults to ""S:A"")."
^XWB(8994,3670,2,2,1,2,0)=" "
^XWB(8994,3670,2,2,1,3,0)="Possible values are:"
^XWB(8994,3670,2,2,1,4,0)="   R:X - Return entry with IEN X."
^XWB(8994,3670,2,2,1,5,0)="   N:X - Return entry with #.01 field equal to X"
^XWB(8994,3670,2,2,1,6,0)="   S:A - Return all active entries."
^XWB(8994,3670,2,2,1,7,0)="   S:I - Return all inactive entries."
^XWB(8994,3670,2,2,1,8,0)="   S:B - Return all entries (both active and inactive). "
^XWB(8994,3670,2,3,0)="OREXCLUDE^1^^0^3"
^XWB(8994,3670,2,3,1,0)="^^2^2^3180327^"
^XWB(8994,3670,2,3,1,1,0)="Should entries defined in ORWPCE EXCLUDE SKIN TESTS be excluded? (Used"
^XWB(8994,3670,2,3,1,2,0)="when PXFLTR is set to S:x)."
^XWB(8994,3670,2,4,0)="LOCATION^1^^0^4"
^XWB(8994,3670,2,4,1,0)="^^3^3^3180327^"
^XWB(8994,3670,2,4,1,1,0)="Used when excluding entried listed in ORWPCE EXCLUDE SKIN TESTS. This"
^XWB(8994,3670,2,4,1,2,0)="is the location used when getting the paramater value at the Location"
^XWB(8994,3670,2,4,1,3,0)="level."
