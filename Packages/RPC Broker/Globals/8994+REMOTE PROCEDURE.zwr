^XWB(8994,4770,2,10,0)="INCLUDEUND^1^^0^10"
^XWB(8994,4770,2,10,1,0)="^^2^2^3221020^"
^XWB(8994,4770,2,10,1,1,0)="Boolean: Include Undictated and Untranscribed documents along with "
^XWB(8994,4770,2,10,1,2,0)="Unsigned documents, when the CONTEXT is 2."
^XWB(8994,4770,2,11,0)="SHOWMORE^1^^0^11"
^XWB(8994,4770,2,11,1,0)="^^3^3^3221013^"
^XWB(8994,4770,2,11,1,1,0)="Boolean: Return ""0^SHOW MORE"" in return array when additional notes"
^XWB(8994,4770,2,11,1,2,0)="available for context of 1 or 5 when occurrence limit prevents all notes "
