^XWB(8994,3313,3,3,0)="       ^01: 1/0 -- Success/Fail flag for version check."
^XWB(8994,3313,3,4,0)="       ^02:"
^XWB(8994,3313,3,5,0)="           ~01: code ... 4=fail."
^XWB(8994,3313,3,6,0)="           ~02: Msg .... Message to display if fail."
^XWB(8994,3313,3,7,0)="     |02"
