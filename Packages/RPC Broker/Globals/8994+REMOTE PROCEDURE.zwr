^XWB(8994,2980,2,3,1,3,0)="""C""  : ""          "" closed  (-D,-G,-P)"
^XWB(8994,2980,2,3,1,4,0)="""P""  : ""          "" pending"
^XWB(8994,2980,2,3,1,5,0)="""N""  : ""          ""other nondisclosured (-NR,-RF,-ND,-NV,-RC)"
^XWB(8994,2980,2,3,1,6,0)="""E""  : ""          "" entered in error"
^XWB(8994,2980,2,3,1,7,0)="""X""  : ""          "" cancelled"
^XWB(8994,2980,2,3,1,8,0)="""ALL"": Gets all statuses"
