^XWB(8994,4888,0)="SDES DISPLAY CONTACT^DISPLAY^SDESCONTACTS^2^R^^^0^^^1"
^XWB(8994,4888,1,0)="^^4^4^3250206^"
^XWB(8994,4888,1,1,0)="This RPC returns the SDEC CONTACT (#409.86) record, along with all of the "
^XWB(8994,4888,1,2,0)="contact attempts in the Date/Time of Contact subfile (#409.863)."
^XWB(8994,4888,1,3,0)=" "
^XWB(8994,4888,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,4888,2,0)="^8994.02A^2^2"
^XWB(8994,4888,2,1,0)="REQTYPE^1^3^1^1"
^XWB(8994,4888,2,1,1,0)="^^7^7^3221229^"
^XWB(8994,4888,2,1,1,1,0)="This is the request type:"
^XWB(8994,4888,2,1,1,2,0)=" - A - APPT"
^XWB(8994,4888,2,1,1,3,0)=" - R - RECALL"
^XWB(8994,4888,2,1,1,4,0)=" - C - CONSULT"
^XWB(8994,4888,2,1,1,5,0)=" - V - VETERAN"
^XWB(8994,4888,2,1,1,6,0)=" - RTC - RETURN TO CLINIC"
^XWB(8994,4888,2,1,1,7,0)=" - P - PROCEDURE"
^XWB(8994,4888,2,2,0)="REQIEN^1^30^1^2"
^XWB(8994,4888,2,2,1,0)="^8994.021^7^7^3250206^^"
^XWB(8994,4888,2,2,1,1,0)="The request IEN (variable-pointer) to one of the appointment request "
