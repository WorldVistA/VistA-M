^XWB(8994,5129,0)="PSO DEL TEMPORARY ADDRESS^PSOVDELAD^PSOVCC0^1^P^^^^^^1"
^XWB(8994,5129,1,0)="^^2^2^3241015^"
^XWB(8994,5129,1,1,0)="This RPC deletes the patient's temporary address from"
^XWB(8994,5129,1,2,0)="the patient file"
^XWB(8994,5129,2,0)="^8994.02A^1^1"
^XWB(8994,5129,2,1,0)="PSOVICN^1^30^1^1"
^XWB(8994,5129,2,1,1,0)="^^1^1^3241015^"
