^XWB(8994,4307,2,18,1,0)="^8994.021^8^8^3141208^^^^"
^XWB(8994,4307,2,18,1,1,0)="Description - word-processing field"
^XWB(8994,4307,2,18,1,2,0)=" "
^XWB(8994,4307,2,18,1,3,0)="If there is a Description (#.1) for the selected Item Master (#441) item, "
