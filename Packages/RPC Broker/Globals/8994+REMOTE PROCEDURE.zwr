^XWB(8994,3567,2,"B","INAC",2)=""
^XWB(8994,3567,2,"B","PREF",3)=""
^XWB(8994,3567,2,"PARAMSEQ",1,1)=""
^XWB(8994,3567,2,"PARAMSEQ",2,2)=""
^XWB(8994,3567,3,0)="^8994.03^36^36^3241101^^^"
^XWB(8994,3567,3,1,0)="Successful Return:"
^XWB(8994,3567,3,2,0)=" Global array containing a list of preferences in which each array "
^XWB(8994,3567,3,3,0)=" entry contains preference data separated by ^:"
^XWB(8994,3567,3,4,0)=" "
^XWB(8994,3567,3,5,0)=" The ^ pieces are as follows:"
^XWB(8994,3567,3,6,0)=" "
^XWB(8994,3567,3,7,0)="   1. (integer)       Patient ID - pointer to PATIENT file"
^XWB(8994,3567,3,8,0)="   2. (text)          Preference text"
^XWB(8994,3567,3,9,0)="   3. (date/time)     Date/Time preference added in external "
^XWB(8994,3567,3,10,0)="                      format - defaults to NOW"
^XWB(8994,3567,3,11,0)="   4. (integer)       Added by User - Pointer to NEW PERSON "
^XWB(8994,3567,3,12,0)="                      file - defaults to Current User"
^XWB(8994,3567,3,13,0)="   5. (text)          Added by User Name"
^XWB(8994,3567,3,14,0)="   6. deprecated      No longer used"
^XWB(8994,3567,3,15,0)="   7. deprecated      No longer used"
^XWB(8994,3567,3,16,0)="   8. deprecated      No longer used"
^XWB(8994,3567,3,17,0)="   9. (text)          Remarks are returned as a single string of "
^XWB(8994,3567,3,18,0)="                      text that may be delimited by carriage return/line"
^XWB(8994,3567,3,19,0)="                      feed $c(13,10)."
^XWB(8994,3567,3,20,0)="       1         2               3                4        "
^XWB(8994,3567,3,21,0)="  ""T00020DFN^T00030PREF_TEXT^T00020DATE_ADDED^T00030ADDED_BY_USER_IEN^"""
^XWB(8994,3567,3,22,0)="       5                        6                      7       "
^XWB(8994,3567,3,23,0)="  ""T00030ADDED_BY_USER_NAME^T00020DATE_INACTIVATED^"""
^XWB(8994,3567,3,24,0)="             7                         8        "
^XWB(8994,3567,3,25,0)="  ""T00030INACTIVATED_BY_USER_IEN^T00030INACTIVATED_BY_USER_NAME^"""
^XWB(8994,3567,3,26,0)="        9"
^XWB(8994,3567,3,27,0)="  ""T00100REMARKS""_$C(30)"
^XWB(8994,3567,3,28,0)="  "
^XWB(8994,3567,3,29,0)="  Caught Exception Return:"
^XWB(8994,3567,3,30,0)="        A single entry in the Global Array in the format ""-1^<error text>"""
^XWB(8994,3567,3,31,0)="    ""T00020RETURNCODE^T00100TEXT"""
^XWB(8994,3567,3,32,0)="  Unexpected Exception Return:"
^XWB(8994,3567,3,33,0)="   Handled by the RPC Broker."
^XWB(8994,3567,3,34,0)="   M errors are trapped by the use of M and Kernel error handling."
^XWB(8994,3567,3,35,0)="   The RPC execution stops and the RPC Broker sends the error generated"
^XWB(8994,3567,3,36,0)="   text back to the client."
^XWB(8994,3568,0)="SDEC PREFGETV^PREFGETV^SDEC^4^R^0^^0"
^XWB(8994,3568,1,0)="^8994.01^2^2^3150128^^"
^XWB(8994,3568,1,1,0)="Get all valid Preference text from SDEC PREFERENCES AND SPECIAL NEEDS "
^XWB(8994,3568,1,2,0)="file."
^XWB(8994,3568,3,0)="^8994.03^12^12^3150128^^"
^XWB(8994,3568,3,1,0)=" ; Successful Return:"
^XWB(8994,3568,3,2,0)=" ;  Global array containing a list of the valid Preferences in which each "
^XWB(8994,3568,3,3,0)="array entry contains the preference text."
^XWB(8994,3568,3,4,0)=" ; Caught Exception Return:"
^XWB(8994,3568,3,5,0)=" ;   A single entry in the Global Array in the format ""-1^<error text>"""
^XWB(8994,3568,3,6,0)=" ;   ""T00020RETURNCODE^T00100TEXT"""
^XWB(8994,3568,3,7,0)=" ; Unexpected Exception Return:"
^XWB(8994,3568,3,8,0)=" ;     Handled by the RPC Broker."
^XWB(8994,3568,3,9,0)=" ;     M errors are trapped by the use of M and Kernel error handling."
^XWB(8994,3568,3,10,0)=" ;     The RPC execution stops and the RPC Broker sends the error "
^XWB(8994,3568,3,11,0)="generated"
^XWB(8994,3568,3,12,0)=" ;     text back to the client."
^XWB(8994,3569,0)="SDEC PREFSET^PREFSET^SDEC^4^R^0^^0"
^XWB(8994,3569,1,0)="^8994.01^1^1^3241101^^^"
^XWB(8994,3569,1,1,0)="Set values to SDEC PREFERENCES AND SPECIAL NEEDS file."
^XWB(8994,3569,2,0)="^8994.02A^2^2"
^XWB(8994,3569,2,1,0)="DFN^1^^1^1"
^XWB(8994,3569,2,1,1,0)="^^2^2^3140829^"
^XWB(8994,3569,2,1,1,1,0)="(integer) Patient ID - Pointer to the PATIENT file 2  (lookup by name is "
^XWB(8994,3569,2,1,1,2,0)="not accurate if duplicates)"
^XWB(8994,3569,2,2,0)="PREF^1^^0^2"
^XWB(8994,3569,2,2,1,0)="^^19^19^3241101^"
^XWB(8994,3569,2,2,1,1,0)="  PREF = List of preference data separated by ^"
^XWB(8994,3569,2,2,1,2,0)="         Each ^ piece contains the following Pipe pieces |:"
^XWB(8994,3569,2,2,1,3,0)="         1. (text)      Preference text; precede text with @ to delete"
^XWB(8994,3569,2,2,1,4,0)="                        Valid values are:"
^XWB(8994,3569,2,2,1,5,0)="                            GENDER SPECIFIC PROVIDER"
^XWB(8994,3569,2,2,1,6,0)="                            HEARING IMPAIRED"
^XWB(8994,3569,2,2,1,7,0)="                            LANGUAGE PREFERENCE"
^XWB(8994,3569,2,2,1,8,0)="                            NEEDS ESCORT"
^XWB(8994,3569,2,2,1,9,0)="                            ON STRETCHER"
^XWB(8994,3569,2,2,1,10,0)="                            SPECIAL MODE OF TRANSPORTATION"
^XWB(8994,3569,2,2,1,11,0)="         2. (date/time)   Date/Time preference added in external"
^XWB(8994,3569,2,2,1,12,0)="                                  format, defaults to NOW"
^XWB(8994,3569,2,2,1,13,0)="         3. (integer)     Added by User - Pointer to NEW PERSON file,"
^XWB(8994,3569,2,2,1,14,0)="                                  defaults to Current User"
^XWB(8994,3569,2,2,1,15,0)="         4. deprecated - do not use, leave blank."
^XWB(8994,3569,2,2,1,16,0)="         5. deprecated - do not use, leave blank."
^XWB(8994,3569,2,2,1,17,0)="         6. (free text)   Remarks single string of text will be"
^XWB(8994,3569,2,2,1,18,0)="                          converted to word processor format."
^XWB(8994,3569,2,2,1,19,0)="                          @ deletes previous Remark"
^XWB(8994,3569,2,"B","DFN",1)=""
^XWB(8994,3569,2,"B","PREF",2)=""
