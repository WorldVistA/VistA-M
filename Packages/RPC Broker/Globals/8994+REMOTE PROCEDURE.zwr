^XWB(8994,4195,0)="IBTAS HEALTH^HEALTH^IBTASHLT^2^P^0^^^1^^1"
^XWB(8994,4195,1,0)="^8994.01^7^7^3190610^^^^"
^XWB(8994,4195,1,1,0)="Developer tool only"
^XWB(8994,4195,1,2,0)="No paramters required."
^XWB(8994,4195,1,3,0)="Return example:"
^XWB(8994,4195,1,4,0)="{""STATION"": ""CHEYENNE VAMC"",                "
^XWB(8994,4195,1,5,0)="""HEALTH"": ""OK"","
^XWB(8994,4195,1,6,0)="""STATION NUMBER"": ""442""            "
^XWB(8994,4195,1,7,0)="}"
^XWB(8994,4196,0)="YTQREST QENTRY^QENTRY^YTQREST0^2^R^^^0^1^^1"
^XWB(8994,4196,1,0)="^8994.01^2^2^3190607^^"
^XWB(8994,4196,1,1,0)="Front controller for patient entered mental health instruments."
^XWB(8994,4196,1,2,0)="Limited REST calls, as this is intended for use with an application proxy."
^XWB(8994,4197,0)="YTQRRPC SELECT^SELECT^YTQRRPC^2^R"
^XWB(8994,4197,1,0)="^^1^1^3181106^"
^XWB(8994,4197,1,1,0)="Calls for Instrument Selection (Delphi Version)"
^XWB(8994,4198,0)="YTQREST QSTAFF^QSTAFF^YTQREST0^2^R^^^0^1^^0"
^XWB(8994,4198,1,0)="^8994.01^3^3^3190621^^"
^XWB(8994,4198,1,1,0)="Front controller for creating instrument assignments."
^XWB(8994,4198,1,2,0)="This RPC is used by Delphi-based MHA and is a predecessor to full "
^XWB(8994,4198,1,3,0)="web-based MHA."
^XWB(8994,4199,0)="SDEC SUMMGET2^SUMMGET2^SDEC^4^R^0^^0"
^XWB(8994,4199,1,0)="^^1^1^3180228^"
^XWB(8994,4199,1,1,0)="Get Audit Summary for a given data range."
^XWB(8994,4199,2,0)="^8994.02A^3^3"
^XWB(8994,4199,2,1,0)="SDBEG^1^^0^1"
^XWB(8994,4199,2,1,1,0)="^^1^1^3180228^"
^XWB(8994,4199,2,1,1,1,0)="Begin Date in external form; default to all dates"
^XWB(8994,4199,2,2,0)="SDEND^1^^0^2"
^XWB(8994,4199,2,2,1,0)="^^1^1^3180228^"
^XWB(8994,4199,2,2,1,1,0)="End Date in external form; default to all dates"
^XWB(8994,4199,2,3,0)="USER^1^^0^3"
^XWB(8994,4199,2,3,1,0)="^^2^2^3180228^"
^XWB(8994,4199,2,3,1,1,0)="User ID pointer to NEW PERSON file (#200)"
^XWB(8994,4199,2,3,1,2,0)="Used to filter by user"
^XWB(8994,4199,2,"B","SDBEG",1)=""
^XWB(8994,4199,2,"B","SDEND",2)=""
^XWB(8994,4199,2,"B","USER",3)=""
^XWB(8994,4199,2,"PARAMSEQ",1,1)=""
^XWB(8994,4199,2,"PARAMSEQ",2,2)=""
^XWB(8994,4199,2,"PARAMSEQ",3,3)=""
^XWB(8994,4199,3,0)="^^18^18^3180228^"
^XWB(8994,4199,3,1,0)="Global Array in which each array entry contains summary data delimited by "
^XWB(8994,4199,3,2,0)="caret (^):"
^XWB(8994,4199,3,3,0)="     1. USERIEN  - Pointer to NEW PERSON file (#200)"
^XWB(8994,4199,3,4,0)="     2. USERNAME - NAME from NEW PERSON file"
^XWB(8994,4199,3,5,0)="     3. CONTACTS - Number of patient contacts in date range"
^XWB(8994,4199,3,6,0)="     4. APPTOPEN - Number of APPT requests opened"
^XWB(8994,4199,3,7,0)="     5. APPTMADE - Number of appointments made from APPT requests"
^XWB(8994,4199,3,8,0)="     6. APPTCLSD - Number of APPT requests closed"
^XWB(8994,4199,3,9,0)="     7. MRTCOPEN - Number of MRTC requests opened"
^XWB(8994,4199,3,10,0)="     8. MRTCCLSD - Number of MRTC requests closed"
^XWB(8994,4199,3,11,0)="     9. EWLOPEN  - Number of EWL requests opened"
^XWB(8994,4199,3,12,0)="    10. EWLMADE  - Number of appointments made from EWL requests"
^XWB(8994,4199,3,13,0)="    11. EWLCLSD  - Number of EWL requests closed"
^XWB(8994,4199,3,14,0)="    12. PTCSOPEN - Number of PtCSch requests opened"
^XWB(8994,4199,3,15,0)="    13. PTCSMADE - Number of appointments made from PtCSch requests"
^XWB(8994,4199,3,16,0)="    14. CNSLTMD  - Number of appointments made from consults"
^XWB(8994,4199,3,17,0)="    15. APPTCXLD - Number of appointments canceled"
^XWB(8994,4199,3,18,0)="    16. ACTIONS  - Total number of user actions in date range"
^XWB(8994,4200,0)="SDEC RESCE^RESOURCE^SDEC01C^4^S^0^^0^1"
^XWB(8994,4200,1,0)="^8994.01^1^1^3220912^^^^"
^XWB(8994,4200,1,1,0)="Returns all active Clinics"
^XWB(8994,4200,2,0)="^8994.02A^7^7"
^XWB(8994,4200,2,1,0)="DUZ^1^^0^1"
^XWB(8994,4200,2,1,1,0)="^^2^2^3180301^"
^XWB(8994,4200,2,1,1,1,0)="Checks that THIS user has the proper SECURITY KEY"
^XWB(8994,4200,2,1,1,2,0)="Defaults to current user."
^XWB(8994,4200,2,2,0)="SDACT^1^^0^2"
^XWB(8994,4200,2,2,1,0)="^^1^1^3180301^"
^XWB(8994,4200,2,2,1,1,0)="Set to Yes - returns only active clinics"
^XWB(8994,4200,2,3,0)="SDTYPE^1^^0^3"
^XWB(8994,4200,2,3,1,0)="^^1^1^3180301^"
^XWB(8994,4200,2,3,1,1,0)="Set to H - only returns Clinics"
^XWB(8994,4200,2,4,0)="MAXREC^1^^0^4"
^XWB(8994,4200,2,4,1,0)="^8994.021^1^1^3190618^^^"
^XWB(8994,4200,2,4,1,1,0)="Max nuber of records returned"
^XWB(8994,4200,2,5,0)="LASTSUBI^1^30^0^5"
^XWB(8994,4200,2,5,1,0)="^^1^1^3220912^"
^XWB(8994,4200,2,5,1,1,0)="Last subscript from previous call."
^XWB(8994,4200,2,6,0)="SDIEN^1^30^0^6"
^XWB(8994,4200,2,6,1,0)="^^1^1^3220912^"
^XWB(8994,4200,2,6,1,1,0)="Pointer to SDEC RESOURCE file, only 1 record will be returned if SDIEN is present."
^XWB(8994,4200,2,7,0)="SDECP^1^30^0^7"
^XWB(8994,4200,2,7,1,0)="^^1^1^3220912^"
^XWB(8994,4200,2,7,1,1,0)="Partial name text."
^XWB(8994,4200,2,"B","DUZ",1)=""
^XWB(8994,4200,2,"B","LASTSUBI",5)=""
^XWB(8994,4200,2,"B","MAXREC",4)=""
^XWB(8994,4200,2,"B","SDACT",2)=""
^XWB(8994,4200,2,"B","SDECP",7)=""
^XWB(8994,4200,2,"B","SDIEN",6)=""
^XWB(8994,4200,2,"B","SDTYPE",3)=""
^XWB(8994,4200,2,"PARAMSEQ",1,1)=""
^XWB(8994,4200,2,"PARAMSEQ",2,2)=""
^XWB(8994,4200,2,"PARAMSEQ",3,3)=""
^XWB(8994,4200,2,"PARAMSEQ",4,4)=""
^XWB(8994,4200,2,"PARAMSEQ",5,5)=""
^XWB(8994,4200,2,"PARAMSEQ",6,6)=""
^XWB(8994,4200,2,"PARAMSEQ",7,7)=""
^XWB(8994,4200,3,0)="^8994.03^10^10^3220912^^^"
^XWB(8994,4200,3,1,0)="Returns a global array in which each array entry contains data from"
^XWB(8994,4200,3,2,0)="the  HOSPITAL LOCATION (clinic)."
^XWB(8994,4200,3,3,0)="1. RESOURCEID - Pointer to the SDEC RESOURCE file"
^XWB(8994,4200,3,4,0)="2. HOSPITAL_LOCATION_ID"
^XWB(8994,4200,3,5,0)="3. CLINNAME  - Clinic Name from HOSPITAL LOCATION file 44"
^XWB(8994,4200,3,6,0)="4. ABBR  - Abbreviation"
^XWB(8994,4200,3,7,0)="5. RESOURCE_NAME  - NAME from SDEC RESOURCE file"
^XWB(8994,4200,3,8,0)="6. E-CHECKIN_ALLOWED"
^XWB(8994,4200,3,9,0)="7. PRE-CHECKIN_ALLOWED"
^XWB(8994,4200,3,10,0)="8. TIME_ZONE"
^XWB(8994,4201,0)="SDECAR1 ARGUID^ARGUID^SDECAR1^4^P"
^XWB(8994,4201,1,0)="^^2^2^3180419^"
^XWB(8994,4201,1,1,0)="Returns Appointment Request data (same as SDEC ARGET) for a VAOS "
^XWB(8994,4201,1,2,0)="request.  Lookup is done on the GUID value."
^XWB(8994,4201,2,0)="^8994.02A^1^1"
^XWB(8994,4201,2,1,0)="GUID^1^32^1^1"
^XWB(8994,4201,2,1,1,0)="^^1^1^3180419^"
^XWB(8994,4201,2,1,1,1,0)="GUID is the database pointer in the VAOS database."
^XWB(8994,4201,2,"B","GUID",1)=""
^XWB(8994,4201,2,"PARAMSEQ",1,1)=""
^XWB(8994,4201,3,0)="^^1^1^3180419^"
^XWB(8994,4201,3,1,0)="Return data is the same as for SDEC ARGET RPC."
^XWB(8994,4202,0)="MAG GET DICOM FMT PATIENT NAME^DCMNAME^MAGDRPC1^1^P^0"
^XWB(8994,4202,1,0)="^8994.01^15^15^3190325^^^^"
^XWB(8994,4202,1,1,0)="  +---------------------------------------------------------------+"
