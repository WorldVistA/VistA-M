^XWB(8994,3904,3,7,0)="       DSIYRET(""TITLE"")=$$$^Title for dataset"
^XWB(8994,3905,0)="DSIYD1 CURDATA GET DATASET^CURDATA^DSIYD1^4^^^^1"
^XWB(8994,3905,1,0)="^8994.01^1^1^3130411^^^^"
^XWB(8994,3905,1,1,0)="Returns the current data for a nightly dashboard run."
^XWB(8994,3905,2,0)="^8994.02A^2^2"
^XWB(8994,3905,2,1,0)="SEC^1^30^1^1"
^XWB(8994,3905,2,1,1,0)="^8994.021^1^1^3121207^^"
^XWB(8994,3905,2,1,1,1,0)="Section of AbovePAR we're getting data for (WO, GIP, EN, PO)"
^XWB(8994,3905,2,2,0)="DATASET^1^30^1^2"
^XWB(8994,3905,2,2,1,0)="^8994.021^2^2^3130411^^"
^XWB(8994,3905,2,2,1,1,0)="IEN to the dataset (in the DSIY DASHBOARD DATASET (#19685.6) file) we "
^XWB(8994,3905,2,2,1,2,0)="want the latest data for."
^XWB(8994,3905,2,"B","DATASET",2)=""
^XWB(8994,3905,2,"B","SEC",1)=""
^XWB(8994,3905,2,"PARAMSEQ",1,1)=""
^XWB(8994,3905,2,"PARAMSEQ",2,2)=""
^XWB(8994,3905,3,0)="^^2^2^3130411^"
^XWB(8994,3905,3,1,0)="Format of return will be defined in the DSIY DASHBOARD DATASET (#19685.6) "
^XWB(8994,3905,3,2,0)="file."
^XWB(8994,3906,0)="DSIYPO1 PPOL PC ORDER LIST^PPOL^DSIYPO1^4^^^^1"
^XWB(8994,3906,1,0)="^8994.01^4^4^3121207^^^^"
^XWB(8994,3906,1,1,0)="This RPC retrieves a list of simplified and detailed purchase card order "
^XWB(8994,3906,1,2,0)="numbers from the Procurement & Accounting Transactions file (file"
^XWB(8994,3906,1,3,0)="442) beginning with the input value (at least one character is "
^XWB(8994,3906,1,4,0)="required).  "
^XWB(8994,3906,2,0)="^8994.02A^1^1"
^XWB(8994,3906,2,1,0)="DSIYPON^1^30^1^1"
^XWB(8994,3906,2,1,1,0)="^8994.021^6^6^3121207^^^"
^XWB(8994,3906,2,1,1,1,0)="This field can contain the long (XXX-XXXXXX) or short (XXXXXX) format of "
^XWB(8994,3906,2,1,1,2,0)="the purchase order number."
^XWB(8994,3906,2,1,1,3,0)=" "
^XWB(8994,3906,2,1,1,4,0)="At least one character must be input as this data is the beginning of the"
^XWB(8994,3906,2,1,1,5,0)="lookup value for purchase order numbers in the Procurement & Accounting"
^XWB(8994,3906,2,1,1,6,0)="Transactions file (field #.01 Purchase Order Number, file 442)."
^XWB(8994,3906,2,"B","DSIYPON",1)=""
^XWB(8994,3906,2,"PARAMSEQ",1,1)=""
^XWB(8994,3906,3,0)="^8994.03^15^15^3121207^^"
^XWB(8994,3906,3,1,0)="Returns -1^error message if no purchase order number starting value is"
^XWB(8994,3906,3,2,0)="provided and if no purchase orders begin with the starting value"
^XWB(8994,3906,3,3,0)="Returns array for populating the PO lookup list in the following format:"
^XWB(8994,3906,3,4,0)="array(n)=""$$442-PO DATA$$"""
^XWB(8994,3906,3,5,0)="array(n)=file 442 ien^.01^E^data   (purchase order number)"
^XWB(8994,3906,3,6,0)="array(n)=file 442 ien^.01^I^data"
^XWB(8994,3906,3,7,0)="array(n)=file 442 ien^5^E^data     (vendor)"
^XWB(8994,3906,3,8,0)="array(n)=file 442 ien^5^I^data"
^XWB(8994,3906,3,9,0)="array(n)=file 442 ien^48^E^data    (type of order)"
^XWB(8994,3906,3,10,0)="array(n)=file 442 ien^48^I^data"
^XWB(8994,3906,3,11,0)="array(n)=file 442 ien^65^E^data    (interface package prefix) "
^XWB(8994,3906,3,12,0)="array(n)=file 442 ien^65^I^data"
^XWB(8994,3906,3,13,0)="array(n...) array lines are repeated for each purchase order number"
^XWB(8994,3906,3,14,0)="starting with the input value"
^XWB(8994,3906,3,15,0)="array(n)=""$$END$$"""
^XWB(8994,3907,0)="DSIYPO1 PPRC PRINT PC ORDER^PPRC^DSIYPO1^4^A^^^1"
^XWB(8994,3907,1,0)="^^6^6^3121207^"
^XWB(8994,3907,1,1,0)="This RPC gets the contents of a Procurement & Accounting Transactions"
^XWB(8994,3907,1,2,0)="(file 442) entry, Control Point Activity (file 410) entry, selected"
^XWB(8994,3907,1,3,0)="station data from the Admin. Activity Site Parameters (file 411) "
^XWB(8994,3907,1,4,0)="entry, Vendor (file 440) entry, and selected User (file 200) data for"
^XWB(8994,3907,1,5,0)="printing/faxing simplified and detailed purchase card orders for the "
^XWB(8994,3907,1,6,0)="input purchase order number or IEN."
^XWB(8994,3907,2,0)="^8994.02A^2^2"
^XWB(8994,3907,2,1,0)="DSIYPRC^1^30^0^1"
^XWB(8994,3907,2,1,1,0)="^8994.021^2^2^3121207^^^"
^XWB(8994,3907,2,1,1,1,0)="This is the pointer to the Procurement & Accounting Transactions File "
^XWB(8994,3907,2,1,1,2,0)="(file 442) for the requested purchase order number."
^XWB(8994,3907,2,2,0)="DSIYPON^1^30^0^2"
^XWB(8994,3907,2,2,1,0)="^8994.021^2^2^3121207^^^^"
^XWB(8994,3907,2,2,1,1,0)="This field may contain the long (XXX-XXXXXX) or short (XXXXXX) versions "
^XWB(8994,3907,2,2,1,2,0)="of the Purchase Order Number (field #.01 in file 442)."
^XWB(8994,3907,2,"B","DSIYPON",2)=""
^XWB(8994,3907,2,"B","DSIYPRC",1)=""
^XWB(8994,3907,2,"PARAMSEQ",1,1)=""
^XWB(8994,3907,2,"PARAMSEQ",2,2)=""
^XWB(8994,3907,3,0)="^8994.03^32^32^3121207^^^"
^XWB(8994,3907,3,1,0)="Returns -1^error message if:"
^XWB(8994,3907,3,2,0)=" 1) neither parameter 1 or 2 are sent"
^XWB(8994,3907,3,3,0)=" 2) there is no entry found in file 442 - Procurement & Accounting"
^XWB(8994,3907,3,4,0)=" Transactions file"
^XWB(8994,3907,3,5,0)=" 3) the user is not found in file 200 - New Person file"
^XWB(8994,3907,3,6,0)=" 4) site parameters have not been established in file 411 - Admin."
^XWB(8994,3907,3,7,0)=" Activity Site Parameters file"
^XWB(8994,3907,3,8,0)=" 5) no entry is found in file 411 - Admin. Activity Site Parameters file"
^XWB(8994,3907,3,9,0)=" 6) no vendor is present for this purchase order number in file 442 -"
^XWB(8994,3907,3,10,0)=" Procurement & Accounting Transactions file"
^XWB(8994,3907,3,11,0)=" 7) no authorized buyer exists for this purchase order in file 442 -"
^XWB(8994,3907,3,12,0)=" Procurement & Accounting Transactions file"
^XWB(8994,3907,3,13,0)=" "
^XWB(8994,3907,3,14,0)=" Returns array for printing/faxing a simplified or detailed purchase card "
^XWB(8994,3907,3,15,0)=" order in the following format:"
^XWB(8994,3907,3,16,0)=" "
^XWB(8994,3907,3,17,0)=" array(n)=""$$442-PO DATA$$"""
^XWB(8994,3907,3,18,0)=" array(n)=file or subfile #^file 442 ien or subfile ien^field^E or I^data"
^XWB(8994,3907,3,19,0)=" array(n...)=all 442 data fields in the above format"
^XWB(8994,3907,3,20,0)=" array(n)=""$$410-2237 DATA$$"" (file 410 entries are optional)"
^XWB(8994,3907,3,21,0)=" array(n)=file or subfile #^file 410 ien or subfile ien^field^E or I^data"
^XWB(8994,3907,3,22,0)=" array(n...)=all 410 data fields in the above format"
^XWB(8994,3907,3,23,0)=" array(n)=""$$STATION$$"""
^XWB(8994,3907,3,24,0)=" array(n)=file 411 ien^field^E or I^data"
^XWB(8994,3907,3,25,0)=" array(n...)=selected file 411 data fields in the above format"
^XWB(8994,3907,3,26,0)=" array(n)=""$$VENDOR$$"""
^XWB(8994,3907,3,27,0)=" array(n)=file 440 ien or subfile ien^field^E or I^data"
^XWB(8994,3907,3,28,0)=" array(n...)=all 440 data fields in the above format"
^XWB(8994,3907,3,29,0)=" array(n)=""$$USER$$"""
^XWB(8994,3907,3,30,0)=" array(n...)=file 200 electronic signature and title of PA/PPM/AUTHORIZED"
^XWB(8994,3907,3,31,0)=" BUYER in format file 200 ien^field^E or I^data"
^XWB(8994,3907,3,32,0)=" array(n)=""$$END$$"""
