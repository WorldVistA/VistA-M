^XWB(8994,3002,3,9,0)="   8 ""DOD"""
^XWB(8994,3002,3,10,0)="   9 ""WORK PHONE"""
^XWB(8994,3002,3,11,0)="  10 ""SSN"""
^XWB(8994,3002,3,12,0)="  11 ""ADDRESS TYPE"""
^XWB(8994,3002,3,13,0)="  12 ""ADDRESS STREET 1"""
^XWB(8994,3002,3,14,0)="  13 ""ADDRESS STREET 2"""
^XWB(8994,3002,3,15,0)="  14 ""ADDRESS STREET 3"""
