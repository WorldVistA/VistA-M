^XWB(8994,4607,2,12,1,1,0)="LOT Number - 1-20 characters; cannot contain ""^"""
^XWB(8994,4607,2,13,0)="DSSORMK^1^61^0^11"
^XWB(8994,4607,2,13,1,0)="^8994.021^1^1^3150624^^^^"
^XWB(8994,4607,2,13,1,1,0)="Remarks - 1-61 characters"
^XWB(8994,4607,2,14,0)="DSSOGRP^1^15^0^14"
^XWB(8994,4607,2,14,1,0)="^8994.021^4^4^3150624^^^^"
^XWB(8994,4607,2,14,1,1,0)="AMIS Grouper - value that groups associated stock issue items together in "
^XWB(8994,4607,2,14,1,2,0)="file 660;  this value is null for the first item, but for subsequent "
^XWB(8994,4607,2,14,1,3,0)="associated stock issue items, use the value returned in the second "
^XWB(8994,4607,2,14,1,4,0)="^-piece of the successful completion message from this RPC."
^XWB(8994,4607,2,21,0)="DSSODTE^1^7^1^13"
^XWB(8994,4607,2,21,1,0)="^8994.021^1^1^3150624^^^^"
^XWB(8994,4607,2,21,1,1,0)="Date of Service - defaults to TODAY"
^XWB(8994,4607,2,22,0)="DSSOBCD^1^20^1^12"
^XWB(8994,4607,2,22,1,0)="^8994.021^3^3^3230106^^^^"
^XWB(8994,4607,2,22,1,1,0)="Bar Code in format HHHHH_""-""_yyymmddhhmmss"
^XWB(8994,4607,2,22,1,2,0)="  where HHHHH=HCPCS Code"
^XWB(8994,4607,2,22,1,3,0)="        yyymmddhhmmss = date/time stamp"
^XWB(8994,4607,2,23,0)="DSSOMFR^1^80^1^15"
^XWB(8994,4607,2,23,1,0)="^8994.021^4^4^3230110^^"
^XWB(8994,4607,2,23,1,1,0)="Manufacturer - required - 1-80 characters"
^XWB(8994,4607,2,23,1,2,0)="   The data for this field comes from the ITEM MASTER (#441) field"
^XWB(8994,4607,2,23,1,3,0)="   MANUFACTURER (#25).  If the MANUFACTURER field is not populated, the"
^XWB(8994,4607,2,23,1,4,0)="   user must enter the MANUFACTURER."
^XWB(8994,4607,2,24,0)="DSSOPRT^1^55^1^16"
^XWB(8994,4607,2,24,1,0)="^8994.021^4^4^3230110^^^"
^XWB(8994,4607,2,24,1,1,0)="MFG PART NO. - required - 1-55 characters"
^XWB(8994,4607,2,24,1,2,0)="   The data for this field comes from the ITEM MASTER (#441) field"
^XWB(8994,4607,2,24,1,3,0)="   MFG PART NO. (#19).  If the MFG PART NO. field is not populated, the"
^XWB(8994,4607,2,24,1,4,0)="   user must enter the MFG PART NO."
^XWB(8994,4607,2,"B","DSSOBCD",22)=""
^XWB(8994,4607,2,"B","DSSOCAT",5)=""
