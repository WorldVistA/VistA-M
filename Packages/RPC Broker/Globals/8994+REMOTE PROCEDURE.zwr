^XWB(8994,4876,0)="PSO EPCS DETOX CHECK^DTXCHK^PSOEPU1^1^R"
^XWB(8994,4876,1,0)="^^4^4^3210803^"
^XWB(8994,4876,1,1,0)="This RPC will accept a DEA number in text format, and a DETOX number in "
^XWB(8994,4876,1,2,0)="text format.  It will perform checking to see if the DETOX number is a "
^XWB(8994,4876,1,3,0)="valid format, and will checking if the DETOX number is being used by "
^XWB(8994,4876,1,4,0)="another DEA number."
^XWB(8994,4876,2,0)="^8994.02A^2^2"
^XWB(8994,4876,2,1,0)="DEA NUMBER^1^^1^1"
^XWB(8994,4876,2,1,1,0)="^^1^1^3210802^"
^XWB(8994,4876,2,1,1,1,0)="This is the provider's DEA number in text format."
^XWB(8994,4876,2,2,0)="DETOX NUMBER^1^^1^2"
^XWB(8994,4876,2,2,1,0)="^^1^1^3210802^"
^XWB(8994,4876,2,2,1,1,0)="This is the provider's DETOX number in text format."
^XWB(8994,4876,2,"B","DEA NUMBER",1)=""
^XWB(8994,4876,2,"B","DETOX NUMBER",2)=""
^XWB(8994,4876,2,"PARAMSEQ",1,1)=""
^XWB(8994,4876,2,"PARAMSEQ",2,2)=""
^XWB(8994,4876,3,0)="^8994.03^12^12^3210803^^"
^XWB(8994,4876,3,1,0)="The return value will be:"
^XWB(8994,4876,3,2,0)="  1 - For a DETOX number that is valid and has no duplicates."
^XWB(8994,4876,3,3,0)="  0^Error Number^Duplicate information if the DETOX number is not valid "
^XWB(8994,4876,3,4,0)="or has duplicates."
^XWB(8994,4876,3,5,0)=" "
^XWB(8994,4876,3,6,0)="Error numbers:"
^XWB(8994,4876,3,7,0)="  1-DETOX length error"
^XWB(8994,4876,3,8,0)="  2-DETOX first character error"
^XWB(8994,4876,3,9,0)="  3-DETOX second character error"
^XWB(8994,4876,3,10,0)="  4-DETOX number error"
^XWB(8994,4876,3,11,0)="  5-Duplicate DETOX number with DEA number"
^XWB(8994,4876,3,12,0)="  6-Provider's profile already has a DETOX number for DEA number (DEA#)"
^XWB(8994,4877,0)="PSO EPCS VA# DUP CHECK^VANUMCHK^PSOEPU1^1^R"
^XWB(8994,4877,1,0)="^^3^3^3210813^"
^XWB(8994,4877,1,1,0)="This RPC will accept a VA# in text format, and a provider's NEW"
^XWB(8994,4877,1,2,0)="PERSON File #200 IEN (Internal Entry number).  It will perform checking "
^XWB(8994,4877,1,3,0)="to determine if the VA# is being used by another provider."
^XWB(8994,4877,2,0)="^8994.02A^2^2"
^XWB(8994,4877,2,1,0)="VANUM^1^10^1^1"
^XWB(8994,4877,2,1,1,0)="^8994.021^1^1^3210813^^"
^XWB(8994,4877,2,1,1,1,0)="This is the provider's VA# in text format."
^XWB(8994,4877,2,2,0)="NPIEN^1^15^1^2"
^XWB(8994,4877,2,2,1,0)="^^1^1^3210813^"
^XWB(8994,4877,2,2,1,1,0)="This is the provider's NEW PERSON file #200 IEN, Internal Entry Number."
^XWB(8994,4877,2,"B","NPIEN",2)=""
^XWB(8994,4877,2,"B","VANUM",1)=""
^XWB(8994,4877,2,"PARAMSEQ",1,1)=""
^XWB(8994,4877,2,"PARAMSEQ",2,2)=""
^XWB(8994,4877,3,0)="^^4^4^3210813^"
^XWB(8994,4877,3,1,0)="The return value will be:"
^XWB(8994,4877,3,2,0)="  1^Success - for a VA# that is not being used by any provider other than"
^XWB(8994,4877,3,3,0)="              the provider being checked."
^XWB(8994,4877,3,4,0)="  0^Duplicate information if the VA# is being used by another provider."
^XWB(8994,4878,0)="PSO EPCS FILER^FILEFMA^PSOEPU1^1^R"
^XWB(8994,4878,1,0)="^8994.01^3^3^3210816^"
^XWB(8994,4878,1,1,0)="This RPC will accept a Field Number in the New Person, File #200, a single"
^XWB(8994,4878,1,2,0)="data item in text format, and Provider Internal Entry Number (IEN) in "
^XWB(8994,4878,1,3,0)="File #200."
^XWB(8994,4878,2,0)="^8994.02A^3^3"
^XWB(8994,4878,2,1,0)="FIELD^1^10^1^1"
^XWB(8994,4878,2,1,1,0)="^8994.021^1^1^3210816^^"
^XWB(8994,4878,2,1,1,1,0)="This is the Field Number being edited in the New Person file #200."
^XWB(8994,4878,2,2,0)="DATA^1^30^1^2"
^XWB(8994,4878,2,2,1,0)="^^1^1^3210816^"
^XWB(8994,4878,2,2,1,1,0)="This is the data value being edited in the New Person file #200."
^XWB(8994,4878,2,3,0)="NPIEN^1^20^1^3"
^XWB(8994,4878,2,3,1,0)="^8994.021^2^2^3210816^^"
^XWB(8994,4878,2,3,1,1,0)="This is the Provider's Internal Entry Number (IEN) in the New Person file "
^XWB(8994,4878,2,3,1,2,0)="#200."
^XWB(8994,4878,2,"B","DATA",2)=""
^XWB(8994,4878,2,"B","FIELD",1)=""
^XWB(8994,4878,2,"B","NPIEN",3)=""
^XWB(8994,4878,2,"PARAMSEQ",1,1)=""
^XWB(8994,4878,2,"PARAMSEQ",2,2)=""
^XWB(8994,4878,2,"PARAMSEQ",3,3)=""
^XWB(8994,4878,3,0)="^^3^3^3210816^"
^XWB(8994,4878,3,1,0)=" The return value will be:"
^XWB(8994,4878,3,2,0)="   1^Success - For data that did file successfully"
^XWB(8994,4878,3,3,0)="   0^Data did not file successfully "
^XWB(8994,4879,0)="PSO EPCS REPORTS^RPTEN^PSOEPREP^4^R^^^1"
^XWB(8994,4879,1,0)="^^3^3^3210830^"
^XWB(8994,4879,1,1,0)="This call is used by all ePrescribing Controlled Substances (ePCS) GUI "
^XWB(8994,4879,1,2,0)="reports. It produces a report based on the criteria selected through the "
^XWB(8994,4879,1,3,0)="ePCS GUI application."
^XWB(8994,4879,2,0)="^8994.02A^1^1"
^XWB(8994,4879,2,1,0)="EPCSARY^2^^1"
^XWB(8994,4879,2,1,1,0)="^^11^11^3210830^"
^XWB(8994,4879,2,1,1,1,0)="The input array EPCSARY will be defined based on the report to be "
^XWB(8994,4879,2,1,1,2,0)="generated. The report handle or type must be defined. It is also "
^XWB(8994,4879,2,1,1,3,0)="necessary to specify whether the report will be printed to a device or "
^XWB(8994,4879,2,1,1,4,0)="displayed. The following is an example of the variables defined for the "
^XWB(8994,4879,2,1,1,5,0)="'DEA Expiration Date Report'."
^XWB(8994,4879,2,1,1,6,0)="       EPCSARY(""EPCSDFN"")=170"
^XWB(8994,4879,2,1,1,7,0)="       EPCSARY(""EPCSED"")=3010430"
^XWB(8994,4879,2,1,1,8,0)="       EPCSARY(""EPCSHNDL"")=""EPCSEXP"""
^XWB(8994,4879,2,1,1,9,0)="       EPCSARY(""EPCSPTYP"")=""D"""
^XWB(8994,4879,2,1,1,10,0)="       EPCSARY(""EPCSRY"")=Y"
^XWB(8994,4879,2,1,1,11,0)="       ECSARY(""EPCSSD"")=3010401"
^XWB(8994,4879,2,"B","EPCSARY",1)=""
^XWB(8994,4879,3,0)="^^1^1^3210830^"
^XWB(8994,4879,3,1,0)="Returns the report or the task number if queued."
^XWB(8994,4880,0)="PSO EPCS SYSTEM DATE TIME^EPCSDATE^PSOEPUT2^1^S"
^XWB(8994,4880,1,0)="^^2^2^3211012^"
^XWB(8994,4880,1,1,0)="Broker call returns the server date as a FileMan internal and external "
^XWB(8994,4880,1,2,0)="date format."
^XWB(8994,4880,2,0)="^8994.02A^1^1"
^XWB(8994,4880,2,1,0)="EPCSARY^1^1"
^XWB(8994,4880,2,1,1,0)="^8994.021^2^2^3211012^^"
^XWB(8994,4880,2,1,1,1,0)="Client entered date and date flag passed in variable EPCSARY"
^XWB(8994,4880,2,1,1,2,0)="        DATESTR - Date String, eg N, T@800, 4/15@1205"
^XWB(8994,4880,2,"B","EPCSARY",1)=""
^XWB(8994,4880,3,0)="^^2^2^3211012^"
^XWB(8994,4880,3,1,0)="Returns in variable RETURN:- Fileman internal date^External date format."
^XWB(8994,4880,3,2,0)="If date is invalid, returns 0^Invalid Date/Time."
^XWB(8994,4881,0)="PSO EPCS FIELD HELP^EPCSHELP^PSOEPUT2^1^S"
^XWB(8994,4881,1,0)="^^1^1^3211012^"
^XWB(8994,4881,1,1,0)="Get the field help from the data dictionary based on the field number."
^XWB(8994,4881,2,0)="^8994.02A^1^1"
^XWB(8994,4881,2,1,0)="EPCSARY^1^4"
^XWB(8994,4881,2,"B","EPCSARY",1)=""
^XWB(8994,4882,0)="PSO EPCS GET LIST^SRCLST^PSOEPUT2^4^R^^^1"
^XWB(8994,4882,1,0)="^8994.01^1^1^3211013^^"
^XWB(8994,4882,1,1,0)="This call is used to perform a search on a file based on a search string."
^XWB(8994,4882,2,0)="^8994.02A^1^1"
^XWB(8994,4882,2,1,0)="EPCSARY^1^^1"
^XWB(8994,4882,2,1,1,0)="^^6^6^3211013^"
^XWB(8994,4882,2,1,1,1,0)="The input string ECARY contains five pieces separated by ""^"""
^XWB(8994,4882,2,1,1,2,0)="     EPCSARY  - Contains the following subscripted elements"
^XWB(8994,4882,2,1,1,3,0)="     EPCSFILE - File to search"
^XWB(8994,4882,2,1,1,4,0)="     EPCSSTR  - Search string"
^XWB(8994,4882,2,1,1,5,0)="     EPCSDIR  - Search order"
^XWB(8994,4882,2,1,1,6,0)="     EPCSNUM  - (Optional) # records to return [default=44]"
^XWB(8994,4882,2,"B","EPCSARY",1)=""
^XWB(8994,4882,3,0)="^8994.03^1^1^3211013^^"
^XWB(8994,4882,3,1,0)="Returns a list of values based on the search criteria."
^XWB(8994,4883,0)="PSO EPCS LIST NP SCHED^NPSCHDL^PSOEPU1^1^A"
^XWB(8994,4883,1,0)="^^2^2^3211102^"
^XWB(8994,4883,1,1,0)="Functionality to list the New Person file #200 Schedules for a provider."
^XWB(8994,4883,1,2,0)="Schedule fields are 55.1,55.2,55.3,55.4,55.5,55.6"
^XWB(8994,4883,2,0)="^8994.02A^1^1"
^XWB(8994,4883,2,1,0)="NPIEN^1^^1^1"
^XWB(8994,4883,2,1,1,0)="^^1^1^3211102^"
^XWB(8994,4883,2,1,1,1,0)="New Person file #200 provider Internal Entry Number (IEN)."
^XWB(8994,4883,2,"B","NPIEN",1)=""
^XWB(8994,4883,2,"PARAMSEQ",1,1)=""
^XWB(8994,4883,3,0)="^^7^7^3211102^"
^XWB(8994,4883,3,1,0)="Returns Null or a string of schedule information delimited by ""^""."
^XWB(8994,4883,3,2,0)="     1 - Schedule II Narcotic"
^XWB(8994,4883,3,3,0)="     2 - Schedule II Non-Narcotic"
^XWB(8994,4883,3,4,0)="     3 - Schedule III Narcotic"
^XWB(8994,4883,3,5,0)="     4 - Schedule III Non-Narcotic"
^XWB(8994,4883,3,6,0)="     5 - Schedule IV"
^XWB(8994,4883,3,7,0)="     6 - Schedule V"
^XWB(8994,4884,0)="PSO EPCS FILE NP SCHED^NPSCHDF^PSOEPU1^1^R"
^XWB(8994,4884,1,0)="^^2^2^3211102^"
^XWB(8994,4884,1,1,0)="Functionality to file the New Person file #200 Schedules for a provider."
^XWB(8994,4884,1,2,0)="Schedule fields are 55.1,55.2,55.3,55.4,55.5,55.6"
^XWB(8994,4884,2,0)="^8994.02A^2^2"
^XWB(8994,4884,2,1,0)="NPIEN^1^^1^1"
^XWB(8994,4884,2,1,1,0)="^8994.021^1^1^3211102^^"
^XWB(8994,4884,2,1,1,1,0)="New Person file #200 provider Internal Entry Number (IEN)."
^XWB(8994,4884,2,2,0)="DATA^1^^1^2"
^XWB(8994,4884,2,2,1,0)="^^7^7^3211102^"
^XWB(8994,4884,2,2,1,1,0)="A string of schedule information delimited by ""^""."
^XWB(8994,4884,2,2,1,2,0)="      1 - Schedule II Narcotic"
^XWB(8994,4884,2,2,1,3,0)="      2 - Schedule II Non-Narcotic"
^XWB(8994,4884,2,2,1,4,0)="      3 - Schedule III Narcotic"
^XWB(8994,4884,2,2,1,5,0)="      4 - Schedule III Non-Narcotic"
^XWB(8994,4884,2,2,1,6,0)="      5 - Schedule IV"
^XWB(8994,4884,2,2,1,7,0)="      6 - Schedule V"
^XWB(8994,4884,2,"B","DATA",2)=""
^XWB(8994,4884,2,"B","NPIEN",1)=""
^XWB(8994,4884,2,"PARAMSEQ",1,1)=""
^XWB(8994,4884,2,"PARAMSEQ",2,2)=""
^XWB(8994,4884,3,0)="^8994.03^1^1^3211102^^"
^XWB(8994,4884,3,1,0)="0 or 1 ^Success or Failure"
^XWB(8994,4885,0)="PSO EPCS LIST OPTN DESC^OPTNDESC^PSOEPU1^2^R"
^XWB(8994,4885,1,0)="^^1^1^3211102^"
^XWB(8994,4885,1,1,0)="RPC to return Option file #19 description word processing text."
^XWB(8994,4885,2,0)="^8994.02A^1^1"
^XWB(8994,4885,2,1,0)="OPTNM^1^^1^1"
^XWB(8994,4885,2,1,1,0)="^^1^1^3211102^"
^XWB(8994,4885,2,1,1,1,0)="The Option file #19 Name, field .01"
^XWB(8994,4885,2,"B","OPTNM",1)=""
^XWB(8994,4885,2,"PARAMSEQ",1,1)=""
^XWB(8994,4885,3,0)="^^1^1^3211102^"
^XWB(8994,4885,3,1,0)="The Option file #19 Description field 3.5 word processing text."
^XWB(8994,4886,0)="PSO EPCS TOPIC HELP^EPCSHELP^PSOEPUT2^4^P^^^1"
^XWB(8994,4886,1,0)="^^1^1^3211104^"
^XWB(8994,4886,1,1,0)="Returns the text from the HELP FRAME file (#9.2) based on a help frame."
^XWB(8994,4886,2,0)="^8994.02A^1^1"
^XWB(8994,4886,2,1,0)="EPCSARY^1"
^XWB(8994,4886,2,1,1,0)="^^1^1^3211104^"
^XWB(8994,4886,2,1,1,1,0)="Input variable EPCSARY contains the name of the help frame."
^XWB(8994,4886,2,"B","EPCSARY",1)=""
^XWB(8994,4886,3,0)="^^1^1^3211104^"
^XWB(8994,4886,3,1,0)="Returns an array with help text from the HELP FRAME File (#9.2)."
^XWB(8994,4887,0)="SDES ADD/UPDATE CONTACT^ADDUPD^SDESCONTACTS^2^R^^^0^^^1"
^XWB(8994,4887,1,0)="^^11^11^3250206^"
^XWB(8994,4887,1,1,0)="This RPC serves two functions."
^XWB(8994,4887,1,2,0)="1.) If no record exists for the given appointment request, it will create"
^XWB(8994,4887,1,3,0)="    a NEW record in the SDEC CONTACT file (#409.86), and add the first "
^XWB(8994,4887,1,4,0)="    contact attempt to the Date/Time of Contact subfile (#409.863)"
^XWB(8994,4887,1,5,0)="2.) If there is already a contact in the SDEC CONTACT file for this "
^XWB(8994,4887,1,6,0)="    appointment request, a new entry will be added to the Date/Time of "
^XWB(8994,4887,1,7,0)="    Contact subfile (#409.863), but will not change any values for the "
^XWB(8994,4887,1,8,0)="    SDEC CONTACT entry (#409.86). The parent record is not editable, only"
^XWB(8994,4887,1,9,0)="    new contact attempts may be added."
^XWB(8994,4887,1,10,0)=" "
^XWB(8994,4887,1,11,0)="Can only be invoked by Acheron"
^XWB(8994,4887,2,0)="^8994.02A^1^1"
^XWB(8994,4887,2,1,0)="CONTACT^2^^1^1"
^XWB(8994,4887,2,1,1,0)="^8994.021^55^55^3250206^^"
^XWB(8994,4887,2,1,1,1,0)="This is the contact details in an array/list format."
^XWB(8994,4887,2,1,1,2,0)=" "
^XWB(8994,4887,2,1,1,3,0)="CONTACT(""CLINIC"")=CLINIC IEN"
^XWB(8994,4887,2,1,1,4,0)=" - Clinic IEN from the HOSPITAL LOCATION FILE (#44"
^XWB(8994,4887,2,1,1,5,0)=" "
^XWB(8994,4887,2,1,1,6,0)="CONTACT(""COMMENTS"")=COMMENTS"
^XWB(8994,4887,2,1,1,7,0)=" - Free text comments (1-80 characters)"
^XWB(8994,4887,2,1,1,8,0)=" "
^XWB(8994,4887,2,1,1,9,0)="CONTACT(""CONTACTIEN"")=CONTACT IEN"
^XWB(8994,4887,2,1,1,10,0)=" - IEN of the main contact entry in the SDEC CONTACT file (#409.86)"
^XWB(8994,4887,2,1,1,11,0)=" "
^XWB(8994,4887,2,1,1,12,0)="CONTACT(""CONTACTTYPE"")=CONTACT TYPE"
^XWB(8994,4887,2,1,1,13,0)=" - Contact Type (C - Call, L - Letter, E - Email, T - Text, S - Secure "
^XWB(8994,4887,2,1,1,14,0)="messaging)"
^XWB(8994,4887,2,1,1,15,0)=" "
^XWB(8994,4887,2,1,1,16,0)="CONTACT(""DFN"")=PATIENT DFN"
^XWB(8994,4887,2,1,1,17,0)=" - Pointer to the PATIENT file (#2)"
^XWB(8994,4887,2,1,1,18,0)=" "
^XWB(8994,4887,2,1,1,19,0)="CONTACT(""DTTMENTERED"")=DATE/TIME ENTERED (ISO FORMAT)"
^XWB(8994,4887,2,1,1,20,0)=" - ISO Date/Time"
^XWB(8994,4887,2,1,1,21,0)=" "
^XWB(8994,4887,2,1,1,22,0)="CONTACT(""DTTMOFCONTACT"")=DATE/TIME OF CONTACT (ISO FORMAT)"
^XWB(8994,4887,2,1,1,23,0)=" - ISO Date/Time"
^XWB(8994,4887,2,1,1,24,0)=" "
^XWB(8994,4887,2,1,1,25,0)="CONTACT(""LEFTMESSAGE"")=0 for no, 1 for yes"
^XWB(8994,4887,2,1,1,26,0)=" "
^XWB(8994,4887,2,1,1,27,0)="CONTACT(""REQTYPE"")=REQUEST TYPE"
^XWB(8994,4887,2,1,1,28,0)=" - Request Type"
^XWB(8994,4887,2,1,1,29,0)=" - A - APPT"
^XWB(8994,4887,2,1,1,30,0)=" - R - RECALL"
^XWB(8994,4887,2,1,1,31,0)=" - C - CONSULT"
^XWB(8994,4887,2,1,1,32,0)=" - V - VETERAN"
^XWB(8994,4887,2,1,1,33,0)=" - RTC - RETURN TO CLINIC"
^XWB(8994,4887,2,1,1,34,0)=" - P - PROCEDURE"
^XWB(8994,4887,2,1,1,35,0)=" "
^XWB(8994,4887,2,1,1,36,0)="CONTACT(""REQUESTIEN"")=REQUEST IEN"
^XWB(8994,4887,2,1,1,37,0)=" - Request IEN (Variable pointer) based on the request type"
^XWB(8994,4887,2,1,1,38,0)="   A,RTC or V - point to SDEC APPT REQUEST (#409.85)"
^XWB(8994,4887,2,1,1,39,0)="   C or P - point to REQUEST/CONSULTATION file (#123)"
^XWB(8994,4887,2,1,1,40,0)="   R - point to RECALL REQUEST file (#403.5)"
^XWB(8994,4887,2,1,1,41,0)=" "
^XWB(8994,4887,2,1,1,42,0)=" "
^XWB(8994,4887,2,1,1,43,0)="Example:"
^XWB(8994,4887,2,1,1,44,0)="---------"
^XWB(8994,4887,2,1,1,45,0)="CONTACT(""CLINIC"")=5263"
^XWB(8994,4887,2,1,1,46,0)="CONTACT(""COMMENTS"")=""sdes contact new testing"""
^XWB(8994,4887,2,1,1,47,0)="CONTACT(""CONTACTTYPE"")=""C"""
^XWB(8994,4887,2,1,1,48,0)="CONTACT(""DFN"")=7172311"
^XWB(8994,4887,2,1,1,49,0)="CONTACT(""DTTMENTERED"")=""2022-12-27T12:30:36-0500"""
^XWB(8994,4887,2,1,1,50,0)="CONTACT(""DTTMOFCONTACT"")=""2022-12-27T12:30:36-0500"""
^XWB(8994,4887,2,1,1,51,0)="CONTACT(""LEFTMESSAGE"")=0"
^XWB(8994,4887,2,1,1,52,0)="CONTACT(""PREFDATE"")=""2022-12-09"""
^XWB(8994,4887,2,1,1,53,0)="CONTACT(""PREFDATE"")=""2022-12-09"""
^XWB(8994,4887,2,1,1,54,0)="CONTACT(""REQTYPE"")=""A"""
^XWB(8994,4887,2,1,1,55,0)="CONTACT(""REQUESTIEN"")=258328"
^XWB(8994,4887,2,"B","CONTACT",1)=""
^XWB(8994,4887,2,"PARAMSEQ",1,1)=""
