^XWB(8994,5036,3,25,0)="                         ],"
^XWB(8994,5036,3,26,0)="                         ""VoicePager"": """""
^XWB(8994,5036,3,27,0)="                 }"
^XWB(8994,5036,3,28,0)="         ]"
^XWB(8994,5036,3,29,0)=" }"
^XWB(8994,5036,3,30,0)=" "
^XWB(8994,5036,3,31,0)="If no providers match the search string this is the returned"
^XWB(8994,5036,3,32,0)="JSON output:"
^XWB(8994,5036,3,33,0)=" "
^XWB(8994,5036,3,34,0)="{"
^XWB(8994,5036,3,35,0)="        ""Provider"":"
^XWB(8994,5036,3,36,0)="          [""""]"
^XWB(8994,5036,3,37,0)="}"
^XWB(8994,5037,0)="SDES2 GET APPTS BY CLINIC LIST^BYCLINICLIST^SDES2GETAPPTRPCS^2^R^^^^^^1"
^XWB(8994,5037,1,0)="^^4^4^3250213^"
^XWB(8994,5037,1,1,0)="This RPC returns back all the appointments for the clinics passed in for "
^XWB(8994,5037,1,2,0)="today."
^XWB(8994,5037,1,3,0)=" "
^XWB(8994,5037,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,5037,2,0)="^8994.02A^2^2"
^XWB(8994,5037,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,5037,2,1,1,0)="^^10^10^3240612^"
^XWB(8994,5037,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,5037,2,1,1,2,0)="                          Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5037,2,1,1,3,0)="SDCONTEXT(""USER DUZ"")   = The DUZ of the user taking action on the"
^XWB(8994,5037,2,1,1,4,0)="                          calling application. "
^XWB(8994,5037,2,1,1,5,0)="SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,5037,2,1,1,6,0)="                          calling application."
^XWB(8994,5037,2,1,1,7,0)="SDCONTEXT(""PATIENT DFN"")= The name of the patient taking action on the"
^XWB(8994,5037,2,1,1,8,0)="                          calling application."
^XWB(8994,5037,2,1,1,9,0)="SDCONTEXT(""PATIENT ICN"")= The ICN of the patient taking action on the"
^XWB(8994,5037,2,1,1,10,0)="                          calling application."
^XWB(8994,5037,2,2,0)="SDINPUT^2^32000^1^2"
^XWB(8994,5037,2,2,1,0)="^8994.021^1^1^3250213^^^^"
^XWB(8994,5037,2,2,1,1,0)="SDINPUT(""ClinicIEN"",clinic ien)="""" ; where clinic ien is a numeric value"
^XWB(8994,5037,2,"B","SDCONTEXT",1)=""
^XWB(8994,5037,2,"B","SDINPUT",2)=""
