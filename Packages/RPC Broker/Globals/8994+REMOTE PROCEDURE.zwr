^XWB(8994,2941,2,"PARAMSEQ",3,4)=""
^XWB(8994,2941,3,0)="^^1^1^3090929^"
^XWB(8994,2941,3,1,0)="Returns a 1 when done."
^XWB(8994,2942,0)="NUPA RUN OBJECT (>1 LINE)^RUNMANY^NUPABCL1^4^^^^1"
^XWB(8994,2942,1,0)="^^2^2^3090708^"
^XWB(8994,2942,1,1,0)="Gathers data from a program that is similar to a TIU object.  This RPC "
^XWB(8994,2942,1,2,0)="calls an M program that places more than one node data into ^TMP($J)."
^XWB(8994,2942,2,0)="^8994.02A^2^2"
^XWB(8994,2942,2,1,0)="DFN^1^^1^1"
^XWB(8994,2942,2,1,1,0)="^^1^1^3090902^"
^XWB(8994,2942,2,1,1,1,0)="The patient's DFN."
^XWB(8994,2942,2,2,0)="CODE^1^^1^2"
^XWB(8994,2942,2,2,1,0)="^^1^1^3090902^"
^XWB(8994,2942,2,2,1,1,0)="The code to xecute to obtain the data, such as S X=$$OBJECT^ROUTINE()."
^XWB(8994,2942,2,"B","CODE",2)=""
^XWB(8994,2942,2,"B","DFN",1)=""
^XWB(8994,2942,2,"PARAMSEQ",1,1)=""
^XWB(8994,2942,2,"PARAMSEQ",2,2)=""
^XWB(8994,2942,3,0)="^^1^1^3090929^"
^XWB(8994,2942,3,1,0)="Returns the text that the object created in ^TMP($J)."
^XWB(8994,2943,0)="NUPA USER CLASS^UC^NUPABCL1^1^^^^1"
^XWB(8994,2943,1,0)="^^2^2^3101104^"
^XWB(8994,2943,1,1,0)="Checks if a user is in a certain TIU User Class.  Useful to determine if "
^XWB(8994,2943,1,2,0)="the nurse doing the assessment is a student."
^XWB(8994,2943,2,0)="^8994.02A^1^1"
^XWB(8994,2943,2,1,0)="CLASS^1^^1^1"
^XWB(8994,2943,2,1,1,0)="^^1^1^3090902^"
^XWB(8994,2943,2,1,1,1,0)="Class to check if the user is in, such as STUDENT."
^XWB(8994,2943,2,"B","CLASS",1)=""
^XWB(8994,2943,2,"PARAMSEQ",1,1)=""
^XWB(8994,2943,3,0)="^^1^1^3090929^"
^XWB(8994,2943,3,1,0)="Returns a 1 if the user is in a certain user class, or a 0 otherwise."
^XWB(8994,2944,0)="NUPA SCREEN^SCREEN^NUPABCL^1"
^XWB(8994,2944,1,0)="^^1^1^3090708^"
^XWB(8994,2944,1,1,0)="Allows M code to be executed from inside a Delphi program."
^XWB(8994,2944,2,0)="^8994.02A^1^1"
^XWB(8994,2944,2,1,0)="CODE^1^^1^1"
^XWB(8994,2944,2,1,1,0)="^^8^8^3090902^"
^XWB(8994,2944,2,1,1,1,0)="Code to execute.  If you set variable NUPa to a result, it will be pulled "
^XWB(8994,2944,2,1,1,2,0)="back into the assessment GUI."
^XWB(8994,2944,2,1,1,3,0)=" "
^XWB(8994,2944,2,1,1,4,0)="Code can be:"
^XWB(8994,2944,2,1,1,5,0)=" "
^XWB(8994,2944,2,1,1,6,0)="S NUPA=$$D(^DPT(DFN))"
^XWB(8994,2944,2,1,1,7,0)=" "
^XWB(8994,2944,2,1,1,8,0)="D TAG^ROUTINE"
^XWB(8994,2944,2,"B","CODE",1)=""
^XWB(8994,2944,2,"PARAMSEQ",1,1)=""
^XWB(8994,2944,3,0)="^^1^1^3090929^"
^XWB(8994,2944,3,1,0)="Varies depending on the code xecuted."
^XWB(8994,2945,0)="NUPA DLOOK^DLOOK^NUPABCL^4^^^^1"
^XWB(8994,2945,1,0)="^8994.01^2^2^3090708^^"
