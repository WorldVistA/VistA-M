^XWB(8994,4791,0)="SDES DELETE VVS ID^DELETEVVSID^SDESVVS^2^R^^^^1^^1"
^XWB(8994,4791,1,0)="^^3^3^3250206^"
^XWB(8994,4791,1,1,0)="This RPC deletes the Video Visit ID from the SDEC APPOINTMENT (#409.84) file."
^XWB(8994,4791,1,2,0)=" "
