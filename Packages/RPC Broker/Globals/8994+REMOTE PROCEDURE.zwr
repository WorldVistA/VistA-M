^XWB(8994,4352,0)="DSSO PROS SITE FROM IFCAP STE^PROSSTE^DSSOUTS^4^^^^1"
^XWB(8994,4352,1,0)="^8994.01^6^6^3160516^^^"
^XWB(8994,4352,1,1,0)="Using the requested station IFN, this RPC provides a list of Prosthetic "
^XWB(8994,4352,1,2,0)="sites from the Prosthetic Site Parameters file (#669.9) for which the "
^XWB(8994,4352,1,3,0)="IFCAP Site (#1.1) matches the station IFN."
^XWB(8994,4352,1,4,0)=" "
^XWB(8994,4352,1,5,0)="If the processing flag is set to ""1"", then only sites who have Automated "
^XWB(8994,4352,1,6,0)="Inventory (GIP) (file 669.9 field 2) set to ""YES"" will be returned."
^XWB(8994,4352,2,0)="^8994.02A^2^2"
^XWB(8994,4352,2,1,0)="DSSOIFN^1^3^1^1"
^XWB(8994,4352,2,1,1,0)="^^1^1^3160506^"
^XWB(8994,4352,2,1,1,1,0)="3-number Station IFN"
^XWB(8994,4352,2,2,0)="DSSOFLG^1^2^0^2"
^XWB(8994,4352,2,2,1,0)="^8994.021^4^4^3160516^^^"
^XWB(8994,4352,2,2,1,1,0)="DSSOFLG - processing flag"
^XWB(8994,4352,2,2,1,2,0)="   If DSSOFLG=1, then only those prosthetic sites associated to IFCAP"
^XWB(8994,4352,2,2,1,3,0)="   sites and with the Automated Inventory (GIP) (file 669.9 field 2)"
^XWB(8994,4352,2,2,1,4,0)="   field set to ""YES"" will be returned."
^XWB(8994,4352,2,"B","DSSOFLG",2)=""
^XWB(8994,4352,2,"B","DSSOIFN",1)=""
