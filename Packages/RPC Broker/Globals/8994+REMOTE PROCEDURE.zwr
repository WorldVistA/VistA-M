^XWB(8994,1844,2,1,1,1,0)="The value of this parameter is a pointer to ^MAG(2005)."
^XWB(8994,1844,2,1,1,2,0)="This pointer identifies the image for which information"
^XWB(8994,1844,2,1,1,3,0)="is being requested."
