^XWB(8994,4967,0)="SDES2 INACTIVATE CLINIC^SDINACTCLN^SDES2INACTCLIN^2^R^^^^1^^1"
^XWB(8994,4967,1,0)="^8994.01^7^7^3250410^^"
^XWB(8994,4967,1,1,0)="This RPC inactivates a clinic from HOSPITAL LOCATION File #44 IEN. It will"
^XWB(8994,4967,1,2,0)="mark an associated SDEC RESOURCE File 409.831 entry as inactive if there is"
^XWB(8994,4967,1,3,0)="a link to the resource."
^XWB(8994,4967,1,4,0)=" "
^XWB(8994,4967,1,5,0)="Please note that the clinic must not have any future appointments."
^XWB(8994,4967,1,6,0)=" "
^XWB(8994,4967,1,7,0)="Can only be invoked by Acheron"
^XWB(8994,4967,2,0)="^8994.02A^2^2"
^XWB(8994,4967,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,4967,2,1,1,0)="^^10^10^3240617^"
^XWB(8994,4967,2,1,1,1,0)=" SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,4967,2,1,1,2,0)="                           Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,4967,2,1,1,3,0)=" SDCONTEXT(""USER DUZ"")   = The DUZ of the user taking action on the"
^XWB(8994,4967,2,1,1,4,0)="                           calling application. "
^XWB(8994,4967,2,1,1,5,0)=" SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,4967,2,1,1,6,0)="                           calling application."
^XWB(8994,4967,2,1,1,7,0)=" SDCONTEXT(""PATIENT DFN"")= The name of the patient taking action on the"
^XWB(8994,4967,2,1,1,8,0)="                           calling application."
^XWB(8994,4967,2,1,1,9,0)=" SDCONTEXT(""PATIENT ICN"")= The ICN of the patient taking action on the"
^XWB(8994,4967,2,1,1,10,0)="                           calling application."
^XWB(8994,4967,2,2,0)="SDPARAM^2^32000^1^2"
^XWB(8994,4967,2,2,1,0)="^^14^14^3250410^"
^XWB(8994,4967,2,2,1,1,0)="SDPARAM(""CLINIC IEN"")=       IEN of the clinic in file 44 Hospital location"
^XWB(8994,4967,2,2,1,2,0)="                              (required)"
^XWB(8994,4967,2,2,1,3,0)="SDPARAM(""INACTIVATION DATE"")= ISO DATE to inactivate the clinic, the date"
^XWB(8994,4967,2,2,1,4,0)="                              should be today or in the future. "
^XWB(8994,4967,2,2,1,5,0)="                              If the value is not provided then"
^XWB(8994,4967,2,2,1,6,0)="                              the default value of today will be"
^XWB(8994,4967,2,2,1,7,0)="                              used as the inactivation date."
^XWB(8994,4967,2,2,1,8,0)="                              Inactivation date is limited to 180 days"
^XWB(8994,4967,2,2,1,9,0)="                              in the future."
^XWB(8994,4967,2,2,1,10,0)="SDPARAM(""DELETE INACTIVATION"")= Only passed if the inactivation date is"
^XWB(8994,4967,2,2,1,11,0)="                              being deleted. It must be ""Y"" if deleting a"
^XWB(8994,4967,2,2,1,12,0)="                              previous inactivation. If it is passed in"
^XWB(8994,4967,2,2,1,13,0)="                              with any other value including the empty"
^XWB(8994,4967,2,2,1,14,0)="                              string it will cause an error."
^XWB(8994,4967,2,"B","SDCONTEXT",1)=""
^XWB(8994,4967,2,"B","SDPARAM",2)=""
^XWB(8994,4967,2,"PARAMSEQ",1,1)=""
^XWB(8994,4967,2,"PARAMSEQ",2,2)=""
^XWB(8994,4967,3,0)="^^28^28^3250415^"
^XWB(8994,4967,3,1,0)="Successful Return:"
^XWB(8994,4967,3,2,0)=" "
^XWB(8994,4967,3,3,0)="{"
^XWB(8994,4967,3,4,0)="   ""ClinicInactivate"":["
^XWB(8994,4967,3,5,0)="                       ""Clinic is successfully inactivated."""
^XWB(8994,4967,3,6,0)="                      ]"
^XWB(8994,4967,3,7,0)="}   "
^XWB(8994,4967,3,8,0)=" "
^XWB(8994,4967,3,9,0)="Success message for successful delete inactivation date"
^XWB(8994,4967,3,10,0)="{"
^XWB(8994,4967,3,11,0)="  ""ClinicInactivate"":["
^XWB(8994,4967,3,12,0)="                 {"
^XWB(8994,4967,3,13,0)="                  ""DeleteInactivate"":""Inactivate Date successfully "
^XWB(8994,4967,3,14,0)="                   removed from clinic: 5924."""
^XWB(8994,4967,3,15,0)="                 }"
^XWB(8994,4967,3,16,0)="                      ]"
^XWB(8994,4967,3,17,0)="}"
^XWB(8994,4967,3,18,0)=" "
