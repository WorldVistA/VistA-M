^XWB(8994,4412,2,1,1,0)="^8994.021^26^26^3150623^^^^"
^XWB(8994,4412,2,1,1,1,0)="ORTXT - Array containing data to be saved into the copy/paste tracking"
^XWB(8994,4412,2,1,1,2,0)="        paste file"
^XWB(8994,4412,2,1,1,3,0)="    Components of ORTXT:"
^XWB(8994,4412,2,1,1,4,0)="      ORTXT(1..n,0)=""dfn^dt^ien;pkg^capturepkg^Copied text"""
^XWB(8994,4412,2,1,1,5,0)="        Piece 1: Input User DUZ"
