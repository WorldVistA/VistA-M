^XWB(8994,3798,2,5,1,1,0)="Beginning of the date range for image selection. Date can be in internal"
^XWB(8994,3798,2,5,1,2,0)="or external FileMan format. If the parameter is not defined or empty, then"
^XWB(8994,3798,2,5,1,3,0)="the date range remains open on this side."
^XWB(8994,3798,2,5,1,4,0)=" "
^XWB(8994,3798,2,5,1,5,0)="Depending on the value of the FLAGS parameter, the date range filter is"
^XWB(8994,3798,2,5,1,6,0)="applied either to the exam/procedure dates (PROCEDURE/EXAM DATE/TIME field"
^XWB(8994,3798,2,5,1,7,0)="(15)) or image capture dates (DATE/TIME IMAGE SAVED field (7))."
^XWB(8994,3798,2,5,1,8,0)=" "
^XWB(8994,3798,2,5,1,9,0)="Time parts of date range parameters are ignored and both ends of the date"
^XWB(8994,3798,2,5,1,10,0)="range are included in the search. For example, in order to search images"
^XWB(8994,3798,2,5,1,11,0)="for May 21, 2008, the internal value of both parameters should be 3080521."
^XWB(8994,3798,2,6,0)="TODATE^1^^^6"
^XWB(8994,3798,2,6,1,0)="^^11^11^3081107^"
^XWB(8994,3798,2,6,1,1,0)="End of the date range for image selection. Dates can be in internal or"
^XWB(8994,3798,2,6,1,2,0)="external FileMan format. If the parameter is not defined or empty, then"
^XWB(8994,3798,2,6,1,3,0)="the date range remains open on this side."
^XWB(8994,3798,2,6,1,4,0)=" "
^XWB(8994,3798,2,6,1,5,0)="Depending on the value of the FLAGS parameter, the date range filter is"
^XWB(8994,3798,2,6,1,6,0)="applied either to the exam/procedure dates (PROCEDURE/EXAM DATE/TIME field"
^XWB(8994,3798,2,6,1,7,0)="(15)) or image capture dates (DATE/TIME IMAGE SAVED field (7))."
^XWB(8994,3798,2,6,1,8,0)=" "
^XWB(8994,3798,2,6,1,9,0)="Time parts of date range parameters are ignored and both ends of the date"
^XWB(8994,3798,2,6,1,10,0)="range are included in the search. For example, in order to search images"
^XWB(8994,3798,2,6,1,11,0)="for May 21, 2008, the internal value of both parameters should be 3080521."
^XWB(8994,3798,2,7,0)="MISCPRMS^2^^^7"
^XWB(8994,3798,2,7,1,0)="^^78^78^3090126^"
^XWB(8994,3798,2,7,1,1,0)="Items of this list define various filter parameters. Each item has 3 or"
^XWB(8994,3798,2,7,1,2,0)="more pieces separated by '^':"
^XWB(8994,3798,2,7,1,3,0)=" "
^XWB(8994,3798,2,7,1,4,0)="  ^01: Parameter name"
^XWB(8994,3798,2,7,1,5,0)="  ^02: Index (for multiples and word-processing values)"
^XWB(8994,3798,2,7,1,6,0)="  ^03: Value1"
^XWB(8994,3798,2,7,1,7,0)="  ^04: Value2"
^XWB(8994,3798,2,7,1,8,0)="  ..."
^XWB(8994,3798,2,7,1,9,0)=" "
^XWB(8994,3798,2,7,1,10,0)="The following filter parameters are supported by this remote procedure:"
^XWB(8994,3798,2,7,1,11,0)=" "
^XWB(8994,3798,2,7,1,12,0)="  CAPTAPP^^{Name or Code}^{Name or Code}^..."
^XWB(8994,3798,2,7,1,13,0)="    Internal or external values of the CAPTURE APPLICATION"
^XWB(8994,3798,2,7,1,14,0)="    field (8.1) of the file #2005."
^XWB(8994,3798,2,7,1,15,0)=" "
^XWB(8994,3798,2,7,1,16,0)="  GDESC^^{Text}"
^XWB(8994,3798,2,7,1,17,0)="    Text that should be present in the SHORT DESCRIPTION"
^XWB(8994,3798,2,7,1,18,0)="    field (10) of the IMAGE file (#2005). The comparison"
^XWB(8994,3798,2,7,1,19,0)="    is case-insensitive."
^XWB(8994,3798,2,7,1,20,0)=" "
^XWB(8994,3798,2,7,1,21,0)="  IDFN^^{DFN}"
^XWB(8994,3798,2,7,1,22,0)="    Patient IEN (DFN). If this parameter is not defined, all"
^XWB(8994,3798,2,7,1,23,0)="    patients' images are considered."
^XWB(8994,3798,2,7,1,24,0)=" "
^XWB(8994,3798,2,7,1,25,0)="  ISTAT^^{Name or Code}^{Name or Code}^..."
^XWB(8994,3798,2,7,1,26,0)="    Internal or external values of the STATUS field (113)"
^XWB(8994,3798,2,7,1,27,0)="    of the file #2005. 0 (zero) code selects image records"
^XWB(8994,3798,2,7,1,28,0)="    with empty STATUS field."
^XWB(8994,3798,2,7,1,29,0)=" "
^XWB(8994,3798,2,7,1,30,0)="  IXCLASS^^{Name or IEN}^{Name or IEN}^..."
^XWB(8994,3798,2,7,1,31,0)="    Image class names or IENs (see the CLASS INDEX field (41)"
^XWB(8994,3798,2,7,1,32,0)="    of the file #2005 for details)."
^XWB(8994,3798,2,7,1,33,0)=" "
^XWB(8994,3798,2,7,1,34,0)="  IXORIGIN^^{Name or Code}^{Name or Code}^..."
^XWB(8994,3798,2,7,1,35,0)="    Internal or external values of the ORIGIN INDEX field (45)"
^XWB(8994,3798,2,7,1,36,0)="    of the file #2005."
^XWB(8994,3798,2,7,1,37,0)=" "
^XWB(8994,3798,2,7,1,38,0)="  IXPKG^^{Name or Code}^{Name or Code}^..."
^XWB(8994,3798,2,7,1,39,0)="    Internal or external values of the PACKAGE INDEX field (40)"
^XWB(8994,3798,2,7,1,40,0)="    of the file #2005."
^XWB(8994,3798,2,7,1,41,0)=" "
^XWB(8994,3798,2,7,1,42,0)="  IXPROC^^{Name or IEN}^{Name or IEN}^..."
^XWB(8994,3798,2,7,1,43,0)="    Procedure/Event names or IENs (see the PROC/EVENT INDEX"
^XWB(8994,3798,2,7,1,44,0)="    field (43) of the file #2005 for details)."
^XWB(8994,3798,2,7,1,45,0)=" "
^XWB(8994,3798,2,7,1,46,0)="  IXSPEC^^{Name or IEN}^{Name or IEN}^..."
^XWB(8994,3798,2,7,1,47,0)="    Specialty/SubSpecialty names or IENs (see the SPEC/SUBSPEC"
^XWB(8994,3798,2,7,1,48,0)="    INDEX field (44) of the file #2005 for details)."
^XWB(8994,3798,2,7,1,49,0)=" "
^XWB(8994,3798,2,7,1,50,0)="  IXTYPE^^{Name or IEN}^{Name or IEN}^..."
^XWB(8994,3798,2,7,1,51,0)="    Image type names or IENs (see the TYPE INDEX field (42) of"
^XWB(8994,3798,2,7,1,52,0)="    the file #2005 for details)."
^XWB(8994,3798,2,7,1,53,0)=" "
^XWB(8994,3798,2,7,1,54,0)="  SAVEDBY^^{DUZ}"
^XWB(8994,3798,2,7,1,55,0)="    If this parameter is defined, then only those images that were"
^XWB(8994,3798,2,7,1,56,0)="    captured by this user (see the IMAGE SAVE BY field (8) of the"
^XWB(8994,3798,2,7,1,57,0)="    file #2005 for details) are considered."
^XWB(8994,3798,2,7,1,58,0)=" "
^XWB(8994,3798,2,7,1,59,0)="  SENSIMG^^{Name or Code}^{Name or Code}^..."
^XWB(8994,3798,2,7,1,60,0)="    Internal or external values of the CONTROLLED IMAGE field (112)"
^XWB(8994,3798,2,7,1,61,0)="    of the file #2005."
^XWB(8994,3798,2,7,1,62,0)=" "
^XWB(8994,3798,2,7,1,63,0)="For pointer type parameters, pure numeric values are always treated as"
^XWB(8994,3798,2,7,1,64,0)="internal entry numbers (IEN)."
^XWB(8994,3798,2,7,1,65,0)=" "
^XWB(8994,3798,2,7,1,66,0)="Parameters can be added to the list in any order. See comments preceding"
^XWB(8994,3798,2,7,1,67,0)="the GETIMGS^MAGSIXG1 for more details."
^XWB(8994,3798,2,7,1,68,0)=" "
^XWB(8994,3798,2,7,1,69,0)="Example:"
^XWB(8994,3798,2,7,1,70,0)=" "
^XWB(8994,3798,2,7,1,71,0)="  with RPCBroker.Param[4] do"
^XWB(8994,3798,2,7,1,72,0)="    begin"
^XWB(8994,3798,2,7,1,73,0)="      PType := list;"
^XWB(8994,3798,2,7,1,74,0)="      Mult[1] := 'IXPKG^^RAD^LAB';"
^XWB(8994,3798,2,7,1,75,0)="      Mult[2] := 'IXCLASS^^1^ADMIN';"
^XWB(8994,3798,2,7,1,76,0)="      Mult[3] := 'IXORIGIN^^NON-VA^F';"
^XWB(8994,3798,2,7,1,77,0)="      Mult[4] := 'IDFN^^2341'; "
^XWB(8994,3798,2,7,1,78,0)="    end;"
