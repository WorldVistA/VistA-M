^XWB(8994,3990,2,1,1,3,0)="For Above PAR - enter DSIY APAR"
^XWB(8994,3990,2,1,1,4,0)=" "
^XWB(8994,3990,2,1,1,5,0)="This assumes this package will always be named DSIY APAR - this will have "
^XWB(8994,3990,2,1,1,6,0)="to change if the package is renamed."
^XWB(8994,3990,2,"B","INSTNM",1)=""
^XWB(8994,3990,2,"PARAMSEQ",1,1)=""
^XWB(8994,3990,3,0)="^^6^6^3130411^"
^XWB(8994,3990,3,1,0)="RETURN PARAMETER"
^XWB(8994,3990,3,2,0)=" "
^XWB(8994,3990,3,3,0)="DSIYRET(1)=""0^<Warning Message>    If there are warnings/no data"
^XWB(8994,3990,3,4,0)="DSIYRET(1)=""-1^<Error Message>     if there are errors"
^XWB(8994,3990,3,5,0)=" "
^XWB(8994,3990,3,6,0)="DSIYRET(1)=Version # ^ Build Info ^ Build date"
^XWB(8994,3991,0)="DSIYD2 METDATA METRIC DATA^METDATA^DSIYD2^4^^^^1"
^XWB(8994,3991,1,0)="^8994.01^4^4^3130412^"
^XWB(8994,3991,1,1,0)="METDATA"
^XWB(8994,3991,1,2,0)=" "
^XWB(8994,3991,1,3,0)="Returns generic metric data from the ^DSIY(19685.6) datasets with a title "
^XWB(8994,3991,1,4,0)="for the GUI to use."
^XWB(8994,3991,2,0)="^8994.02A^2^2"
^XWB(8994,3991,2,1,0)="SEC^1^1^1^1"
^XWB(8994,3991,2,1,1,0)="^^6^6^3130412^"
^XWB(8994,3991,2,1,1,1,0)="SEC"
^XWB(8994,3991,2,1,1,2,0)=" "
^XWB(8994,3991,2,1,1,3,0)="Defines the section:  ""W"", ""E"" or ""G"""
^XWB(8994,3991,2,1,1,4,0)="W = Work Orders"
^XWB(8994,3991,2,1,1,5,0)="E = Equipment"
^XWB(8994,3991,2,1,1,6,0)="G = GIP Inventory"
^XWB(8994,3991,2,2,0)="DATASET^1^15^1^2"
^XWB(8994,3991,2,2,1,0)="^^3^3^3130412^"
^XWB(8994,3991,2,2,1,1,0)="DATASET"
^XWB(8994,3991,2,2,1,2,0)=" "
^XWB(8994,3991,2,2,1,3,0)="IEN to the dataset to pull."
^XWB(8994,3991,2,"B","DATASET",2)=""
^XWB(8994,3991,2,"B","SEC",1)=""
^XWB(8994,3991,2,"PARAMSEQ",1,1)=""
^XWB(8994,3991,2,"PARAMSEQ",2,2)=""
^XWB(8994,3991,3,0)="^^7^7^3130412^"
^XWB(8994,3991,3,1,0)="RETURN PARAMETER"
^XWB(8994,3991,3,2,0)=" "
^XWB(8994,3991,3,3,0)="DSIYRET(1)=""0^<Warning Message>    If there are warnings/no data"
^XWB(8994,3991,3,4,0)="DSIYRET(1)=""-1^<Error Message>     if there are errors"
^XWB(8994,3991,3,5,0)="DSIYRET(#) = Data for each statistic - can be different depending on the "
^XWB(8994,3991,3,6,0)="statistic being pulled"
^XWB(8994,3991,3,7,0)="DSIYRET(""TITLE"")=$$$^Title to the dataset"
^XWB(8994,3992,0)="DSIYWO8 EQFLDS EQUIP FIELDS^EQFLDS^DSIYWO8^2"
^XWB(8994,3992,1,0)="^^3^3^3130416^"
^XWB(8994,3992,1,1,0)="WOFLDS"
^XWB(8994,3992,1,2,0)=" "
^XWB(8994,3992,1,3,0)="Returns description of all equipment fields used in work orders"
^XWB(8994,3992,3,0)="^^5^5^3130416^"
^XWB(8994,3992,3,1,0)="RETURN PARAMETER"
^XWB(8994,3992,3,2,0)=" "
^XWB(8994,3992,3,3,0)="DSIYRET(1)=""0^<Warning Message>    If there are warnings/no data"
^XWB(8994,3992,3,4,0)="DSIYRET(1)=""-1^<Error Message>     if there are errors"
^XWB(8994,3992,3,5,0)="DSIYRET(FIELD#)=FIELD#^DESCRIPTION"
^XWB(8994,3993,0)="DSIYGNI2 IPGRPCK CK IP ASSG^IPGRPCK^DSIYGNI2^2"
^XWB(8994,3993,1,0)="^8994.01^4^4^3130423^^"
^XWB(8994,3993,1,1,0)="IPGRPCK"
^XWB(8994,3993,1,2,0)=" "
^XWB(8994,3993,1,3,0)="Returns information about Primary Inventory Point mapping so the GUI can "
^XWB(8994,3993,1,4,0)="know if this Primary has already been mapped."
^XWB(8994,3993,2,0)="^8994.02A^1^1"
^XWB(8994,3993,2,1,0)="INVPT^1^15^1^1"
^XWB(8994,3993,2,1,1,0)="^8994.021^3^3^3130423^^"
^XWB(8994,3993,2,1,1,1,0)="INVPT"
^XWB(8994,3993,2,1,1,2,0)=" "
^XWB(8994,3993,2,1,1,3,0)="Inventory point to check (IEN to the Inventory file ^PRCP(445))"
^XWB(8994,3993,2,"B","INVPT",1)=""
^XWB(8994,3993,2,"PARAMSEQ",1,1)=""
^XWB(8994,3993,3,0)="^^5^5^3130423^"
^XWB(8994,3993,3,1,0)="RETURN PARAMETER"
^XWB(8994,3993,3,2,0)=" "
^XWB(8994,3993,3,3,0)="DSIYRET(1)=""-1^Error message describing problem"""
^XWB(8994,3993,3,4,0)="DSIYRET(1)=1  if all is OK"
^XWB(8994,3993,3,5,0)="DSIYRET(""GROUP"")= GROUP IEN ^ GROUP NAME  (used for internal calls)"
^XWB(8994,3994,0)="DSIYGNI2 GETGRGL GET GRP GOAL^GETGRGL^DSIYGNI2^2"
^XWB(8994,3994,1,0)="^8994.01^3^3^3130422^"
^XWB(8994,3994,1,1,0)="GETGRGL"
^XWB(8994,3994,1,2,0)=" "
^XWB(8994,3994,1,3,0)="Returns goals for a Inventory Point GROUP"
^XWB(8994,3994,2,0)="^8994.02A^1^1"
^XWB(8994,3994,2,1,0)="GRIEN^1^15^1^1"
^XWB(8994,3994,2,1,1,0)="^^3^3^3130422^"
^XWB(8994,3994,2,1,1,1,0)="GRIEN"
^XWB(8994,3994,2,1,1,2,0)=" "
^XWB(8994,3994,2,1,1,3,0)="IEN to the Inventory Poing GROUP in ^DSIY(19685.41)"
^XWB(8994,3994,2,"B","GRIEN",1)=""
^XWB(8994,3994,2,"PARAMSEQ",1,1)=""
^XWB(8994,3994,3,0)="^^12^12^3130422^"
^XWB(8994,3994,3,1,0)="RETURN PARAMETER"
^XWB(8994,3994,3,2,0)=" "
^XWB(8994,3994,3,3,0)="DSIYRET(1)=""0^<Warning Message>    If there are warnings/no data"
^XWB(8994,3994,3,4,0)="DSIYRET(1)=""-1^<Error Message>     if there are errors"
^XWB(8994,3994,3,5,0)=" "
^XWB(8994,3994,3,6,0)="DSIYRET(1)=following pieces:"
^XWB(8994,3994,3,7,0)="   p1:  Group IEN"
^XWB(8994,3994,3,8,0)="   p2:  Group Name"
^XWB(8994,3994,3,9,0)="   p3:  Turn Rate Goal"
^XWB(8994,3994,3,10,0)="   p4:  Turn Rate Comparison"
^XWB(8994,3994,3,11,0)="   p5:  Inactive Percent Goal"
^XWB(8994,3994,3,12,0)="   p6:  Inactive Percent Comparison"
^XWB(8994,3995,0)="DSIYGNI2 GETIPGL GET IP GOALS^GETIPGL^DSIYGNI2^2"
^XWB(8994,3995,1,0)="^8994.01^3^3^3130507^^"
^XWB(8994,3995,1,1,0)="GETIPGL"
^XWB(8994,3995,1,2,0)=" "
^XWB(8994,3995,1,3,0)="Returns Inventory Point goals for all Inventory Points within a group"
^XWB(8994,3995,2,0)="^8994.02A^1^1"
^XWB(8994,3995,2,1,0)="GRIEN^1^15^1^1"
^XWB(8994,3995,2,1,1,0)="^8994.021^3^3^3130507^^"
^XWB(8994,3995,2,1,1,1,0)="GRIEN"
^XWB(8994,3995,2,1,1,2,0)=" "
^XWB(8994,3995,2,1,1,3,0)="IEN to the Inventory Point GROUP from ^DSIY(19685.41)"
^XWB(8994,3995,2,"B","GRIEN",1)=""
^XWB(8994,3995,2,"PARAMSEQ",1,1)=""
^XWB(8994,3995,3,0)="^^14^14^3130507^"
^XWB(8994,3995,3,1,0)="RETURN PARAMETER"
^XWB(8994,3995,3,2,0)=" "
^XWB(8994,3995,3,3,0)="DSIYRET(1)=""0^<Warning Message>    If there are warnings/no data"
^XWB(8994,3995,3,4,0)="DSIYRET(1)=""-1^<Error Message>     if there are errors"
^XWB(8994,3995,3,5,0)=" "
^XWB(8994,3995,3,6,0)="DSIYRET(#)= following pieces"
^XWB(8994,3995,3,7,0)="  p1:  Inventory Point IEN"
^XWB(8994,3995,3,8,0)="  p2:  Inventory Point Name"
^XWB(8994,3995,3,9,0)="  p3:  Adjustment Percent Goal"
^XWB(8994,3995,3,10,0)="  p4:  Adjustment Percent Comparison"
^XWB(8994,3995,3,11,0)="  p5:  DSOH Lower Goal"
^XWB(8994,3995,3,12,0)="  p6:  DSOH Lower Comparison"
^XWB(8994,3995,3,13,0)="  p7:  DSOH Upper Goal"
^XWB(8994,3995,3,14,0)="  p8:  DSOH Upper Comparison"
^XWB(8994,3996,0)="DSIYGNI2 GOALUPGR UPDT GOALS^GOALUPGR^DSIYGNI2^2"
^XWB(8994,3996,1,0)="^8994.01^4^4^3130528^^^^"
^XWB(8994,3996,1,1,0)="GOALUPGR"
^XWB(8994,3996,1,2,0)=" "
^XWB(8994,3996,1,3,0)="Adds Inventory Points to Groups and adds goals to both inventory points "
^XWB(8994,3996,1,4,0)="and inventory point groups"
^XWB(8994,3996,2,0)="^8994.02A^1^1"
^XWB(8994,3996,2,1,0)="DSIYDAT^2^60^1^1"
^XWB(8994,3996,2,1,1,0)="^^29^29^3130528^"
^XWB(8994,3996,2,1,1,1,0)="DSIYDAT"
^XWB(8994,3996,2,1,1,2,0)=" "
^XWB(8994,3996,2,1,1,3,0)="Required"
^XWB(8994,3996,2,1,1,4,0)=" "
^XWB(8994,3996,2,1,1,5,0)="DSIYDAT(#)=$$$^GROUP IEN^TURN RATE GOAL^TURN RATE EQUATION*"
^XWB(8994,3996,2,1,1,6,0)="           ^INACTIVE PERCENT GOAL^INACTIVE PERCENT EQUATION*"
^XWB(8994,3996,2,1,1,7,0)="DSIYDAT(#)=INVENTORY POINT IEN^INVENTORY POINT NAME"
^XWB(8994,3996,2,1,1,8,0)="           ^ADJUSTMENT PERCENT GOAL^ADJUSTMENT PERCENT EQUATION*"
^XWB(8994,3996,2,1,1,9,0)="           ^DSOH LOWER GOAL^EQUATION^DSOH UPPER GOAL^EQUATION"
^XWB(8994,3996,2,1,1,10,0)="DSIYDAT(#)=INVENTORY PINT IEN^@   if Inventory Point to be deleted from "
^XWB(8994,3996,2,1,1,11,0)="this group"
^XWB(8994,3996,2,1,1,12,0)=" "
^XWB(8994,3996,2,1,1,13,0)="ASSUMPTION:   Only one GROUP record per update call"
^XWB(8994,3996,2,1,1,14,0)="              Groups can be updated without Inventory points"
^XWB(8994,3996,2,1,1,15,0)="              Inventory point updates must have group updates"
^XWB(8994,3996,2,1,1,16,0)="              If an inventory point is sent in with a group to which"
^XWB(8994,3996,2,1,1,17,0)="                 it does not currently below - the assumption is that"
^XWB(8994,3996,2,1,1,18,0)="                 the GUI has already verified with the user that this"
^XWB(8994,3996,2,1,1,19,0)="                 inventory point is to be moved from one group to another"
^XWB(8994,3996,2,1,1,20,0)="                 the RPC will delete it from the old group and add it"
^XWB(8994,3996,2,1,1,21,0)="                 to the new group"
^XWB(8994,3996,2,1,1,22,0)=" "
^XWB(8994,3996,2,1,1,23,0)="*EQUATIONS:   Equations are send in the coded format:"
^XWB(8994,3996,2,1,1,24,0)="              -1 = ""N/A"""
^XWB(8994,3996,2,1,1,25,0)="              0  = ""="""
^XWB(8994,3996,2,1,1,26,0)="              1  = "">="""
^XWB(8994,3996,2,1,1,27,0)="              2  = ""<="""
^XWB(8994,3996,2,1,1,28,0)="              3 = "">"""
^XWB(8994,3996,2,1,1,29,0)="              4 = ""<"""
^XWB(8994,3996,2,"B","DSIYDAT",1)=""
^XWB(8994,3996,2,"PARAMSEQ",1,1)=""
^XWB(8994,3996,3,0)="^8994.03^8^8^3130528^^^^"
^XWB(8994,3996,3,1,0)="RETURN PARAMETER"
^XWB(8994,3996,3,2,0)=" "
^XWB(8994,3996,3,3,0)="DSIYRET(1)=""0^<Warning Message>    If there are warnings/no data"
^XWB(8994,3996,3,4,0)="DSIYRET(1)=""-1^<Error Message>     if there are errors"
^XWB(8994,3996,3,5,0)=" "
^XWB(8994,3996,3,6,0)="NOTE:  The GROUP record and some inventory point records may be accepted "
^XWB(8994,3996,3,7,0)="where others are not.  In this case, additional DSIYRET(#) lines may be "
^XWB(8994,3996,3,8,0)="generated for any inventory point records which are not accepted"
^XWB(8994,3997,0)="DSIYGNI2 GETINVPT GET INV PTS^GETINVPT^DSIYGNI2^4^^^^1"
^XWB(8994,3997,1,0)="^8994.01^3^3^3130528^^^"
^XWB(8994,3997,1,1,0)="GETINVPT"
^XWB(8994,3997,1,2,0)=" "
^XWB(8994,3997,1,3,0)="Generic return of inventory points by various XREF's"
^XWB(8994,3997,2,0)="^8994.02A^3^3"
^XWB(8994,3997,2,1,0)="XREF^1^15^1^1"
^XWB(8994,3997,2,1,1,0)="^8994.021^10^10^3130528^^"
^XWB(8994,3997,2,1,1,1,0)="XREF"
^XWB(8994,3997,2,1,1,2,0)=" "
^XWB(8994,3997,2,1,1,3,0)="The XREF to use to return the data"
^XWB(8994,3997,2,1,1,4,0)=" "
^XWB(8994,3997,2,1,1,5,0)="XREF values are:"
^XWB(8994,3997,2,1,1,6,0)="  B:    for full name"
^XWB(8994,3997,2,1,1,7,0)="  C:    for shorter name (after the station #)"
^XWB(8994,3997,2,1,1,8,0)="  AC    for Type (Primary, Secondary, Warehouse) = Must have VALUE with"
^XWB(8994,3997,2,1,1,9,0)="            ""P"", ""S"" or ""W"""
^XWB(8994,3997,2,1,1,10,0)="  AD:   for Inventory Point user - Must have VALUE with DUZ of user "
^XWB(8994,3997,2,2,0)="VALUE^1^25^0^2"
^XWB(8994,3997,2,2,1,0)="^8994.021^13^13^3130528^^"
^XWB(8994,3997,2,2,1,1,0)="VALUE"
^XWB(8994,3997,2,2,1,2,0)=" "
^XWB(8994,3997,2,2,1,3,0)="Not required for all XREF's  This is the value by which to refine the "
^XWB(8994,3997,2,2,1,4,0)="search"
^XWB(8994,3997,2,2,1,5,0)=" "
^XWB(8994,3997,2,2,1,6,0)="If using XREF "
^XWB(8994,3997,2,2,1,7,0)="  ""AC"" for inventory point type"
^XWB(8994,3997,2,2,1,8,0)="  ""AD"" for inventory point user"
^XWB(8994,3997,2,2,1,9,0)=" "
^XWB(8994,3997,2,2,1,10,0)="The VALUE must be specified"
^XWB(8994,3997,2,2,1,11,0)=" "
^XWB(8994,3997,2,2,1,12,0)="Special VALUE:  Use ""NG"" as the value to get all inventory points not"
^XWB(8994,3997,2,2,1,13,0)="currently assigned to a group."
^XWB(8994,3997,2,3,0)="INVPT^1^15^0^3"
^XWB(8994,3997,2,3,1,0)="^8994.021^10^10^3130528^^"
^XWB(8994,3997,2,3,1,1,0)="INVTP"
^XWB(8994,3997,2,3,1,2,0)=" "
^XWB(8994,3997,2,3,1,3,0)="Data to further refine the search.  "
^XWB(8994,3997,2,3,1,4,0)=" "
^XWB(8994,3997,2,3,1,5,0)="INVPT can be ""P"" for primary, ""S"" for secondary or ""W"" for warehouse"
^XWB(8994,3997,2,3,1,6,0)=" "
^XWB(8994,3997,2,3,1,7,0)="(NOTE:  This is redundant when using XREF ""AC"" plus a value but won't "
^XWB(8994,3997,2,3,1,8,0)="hurt anything)"
^XWB(8994,3997,2,3,1,9,0)=" "
^XWB(8994,3997,2,3,1,10,0)="This will further refine the results by inventory point type."
^XWB(8994,3997,2,"B","INVPT",3)=""
^XWB(8994,3997,2,"B","VALUE",2)=""
^XWB(8994,3997,2,"B","XREF",1)=""
^XWB(8994,3997,2,"PARAMSEQ",1,1)=""
^XWB(8994,3997,2,"PARAMSEQ",2,2)=""
^XWB(8994,3997,2,"PARAMSEQ",3,3)=""
^XWB(8994,3997,3,0)="^8994.03^5^5^3130528^^^"
^XWB(8994,3997,3,1,0)="RETURN PARAMETER"
^XWB(8994,3997,3,2,0)=" "
^XWB(8994,3997,3,3,0)="DSIYRET(1)=""0^<Warning Message>    If there are warnings/no data"
^XWB(8994,3997,3,4,0)="DSIYRET(1)=""-1^<Error Message>     if there are errors"
^XWB(8994,3997,3,5,0)="DSIYRET(INV POINT NAME)=IP IEN ^ NAME ^ IP TYPE"
^XWB(8994,3998,0)="DSIYUTL1 EQUPDT UPDATE EQUIP^EQUPDT^DSIYUTL1^2"
^XWB(8994,3998,1,0)="^8994.01^15^15^3130214^^"
^XWB(8994,3998,1,1,0)="DSIYUTL1"
^XWB(8994,3998,1,2,0)=" "
^XWB(8994,3998,1,3,0)="RPC to validate entries and update the Equipment Management file "
^XWB(8994,3998,1,4,0)="^ENG(6914)"
^XWB(8994,3998,1,5,0)=" "
^XWB(8994,3998,1,6,0)="ASSUMPTIONS:"
^XWB(8994,3998,1,7,0)="  - GUI will grab all current data on an edit and return all fields for"
^XWB(8994,3998,1,8,0)="EDIT"
^XWB(8994,3998,1,9,0)="  - GUI will only send fields with new data for an ADD"
^XWB(8994,3998,1,10,0)="  - Some information sent as internal/some as external"
^XWB(8994,3998,1,11,0)="  - DSIYDAT(field#)=Internal Value ^ External Value"
^XWB(8994,3998,1,12,0)=" "
^XWB(8994,3998,1,13,0)="  - Considered ""all or nothing"" if there are errors, update does not "
^XWB(8994,3998,1,14,0)="happen"
^XWB(8994,3998,1,15,0)="  - If this is a NEW entry and problems, node will be deleted if created"
^XWB(8994,3998,2,0)="^8994.02A^2^2"
^XWB(8994,3998,2,1,0)="FORCE^1^1^0^1"
^XWB(8994,3998,2,1,1,0)="^^5^5^3130115^"
^XWB(8994,3998,2,1,1,1,0)="FORCE"
^XWB(8994,3998,2,1,1,2,0)=" "
^XWB(8994,3998,2,1,1,3,0)="If sent as ""S"" forces the system to allow the user to enter a duplicate "
^XWB(8994,3998,2,1,1,4,0)="serial number."
^XWB(8994,3998,2,1,1,5,0)="Not Required - defaults to """" if nothing sent and does nothing."
^XWB(8994,3998,2,2,0)="DSIYDAT^2^60^1^2"
^XWB(8994,3998,2,2,1,0)="^8994.021^7^7^3130214^^^"
^XWB(8994,3998,2,2,1,1,0)="DSIYDAT"
^XWB(8994,3998,2,2,1,2,0)=" "
^XWB(8994,3998,2,2,1,3,0)="Array which contains all of the fields to be updated"
^XWB(8994,3998,2,2,1,4,0)=" "
^XWB(8994,3998,2,2,1,5,0)="DSIYDAT(FIELD#) = INTERNAL^EXTERNAL values for that field."
^XWB(8994,3998,2,2,1,6,0)="DSIYDAT(.01) must be the IEN if editing, if blank, it is assumed"
^XWB(8994,3998,2,2,1,7,0)="             to be a new piece of equipment"
^XWB(8994,3998,2,"B","DSIYDAT",2)=""
^XWB(8994,3998,2,"B","FORCE",1)=""
^XWB(8994,3998,2,"PARAMSEQ",1,1)=""
^XWB(8994,3998,2,"PARAMSEQ",2,2)=""
^XWB(8994,3998,3,0)="^8994.03^13^13^3130214^^^"
^XWB(8994,3998,3,1,0)="RETURN PARAMETER"
^XWB(8994,3998,3,2,0)=" "
^XWB(8994,3998,3,3,0)="DSIYRET(1)=""1^IEN for successful return"""
^XWB(8994,3998,3,4,0)="DSIYRET(1)=""-1^Error description"" for unsuccessful return"
^XWB(8994,3998,3,5,0)="DSIYRET(1)=""0^Warning Message"" for warnings"
^XWB(8994,3998,3,6,0)=" "
^XWB(8994,3998,3,7,0)="CRITICAL ERRORS"
^XWB(8994,3998,3,8,0)="      DSIYRET(2..X)=FIELD^ERROR MESSAGE^CRITICAL"
^XWB(8994,3998,3,9,0)=" "
^XWB(8994,3998,3,10,0)="WARNING MESSAGES (Note $P(DSIYRET(1),U,1)=1) if all errors are warnings"
^XWB(8994,3998,3,11,0)="      DSIYRET(2..X)= ^WARNING MESSAGE^WARNING"
^XWB(8994,3998,3,12,0)=" "
^XWB(8994,3998,3,13,0)="There can be a mix of CRITICAL and WARNING messages within a return"
^XWB(8994,3999,0)="DSIYX WHOAMI USER INFO^WHOAMI^DSIYX^2"
^XWB(8994,3999,1,0)="^8994.01^12^12^3130409^^^^"
^XWB(8994,3999,1,1,0)="WHOAMI2"
^XWB(8994,3999,1,2,0)=" "
^XWB(8994,3999,1,3,0)="Returns information about the use supplied by the GUI with the DUZ value."
^XWB(8994,3999,1,4,0)=" "
^XWB(8994,3999,1,5,0)="This RPC returns information about:"
^XWB(8994,3999,1,6,0)=" "
^XWB(8994,3999,1,7,0)=" - The user's starting tab (Equipment, Work Order or GIP)"
^XWB(8994,3999,1,8,0)=" - The user's security level"
^XWB(8994,3999,1,9,0)=" - The user's starting screen within each functionality (Metric, Today or "
^XWB(8994,3999,1,10,0)="Item)"
^XWB(8994,3999,1,11,0)=" - The user's default inventory location (if GIP)"
^XWB(8994,3999,1,12,0)=" - Whether or not the user is a Super Administrator"
^XWB(8994,3999,2,0)="^8994.02A^1^1"
^XWB(8994,3999,2,1,0)="USER^1^25^1^1"
^XWB(8994,3999,2,1,1,0)="^8994.021^4^4^3130409^^^^"
^XWB(8994,3999,2,1,1,1,0)="USER"
^XWB(8994,3999,2,1,1,2,0)=" "
^XWB(8994,3999,2,1,1,3,0)="The user's DUZ value for the user in which the GUI needs information.  "
^XWB(8994,3999,2,1,1,4,0)="Does not have to be the current user."
^XWB(8994,3999,2,"B","USER",1)=""
^XWB(8994,3999,2,"PARAMSEQ",1,1)=""
^XWB(8994,3999,3,0)="^8994.03^20^20^3160615^^"
^XWB(8994,3999,3,1,0)="RETURN PARAMETER"
^XWB(8994,3999,3,2,0)=" "
^XWB(8994,3999,3,3,0)=" "
^XWB(8994,3999,3,4,0)="DSIYRET(1) = USER DUZ ^ STARTING TAB (EQ, PO, WO, or GIP) ^ Super Admin "
^XWB(8994,3999,3,5,0)="                Y/N"
^XWB(8994,3999,3,6,0)=" "
^XWB(8994,3999,3,7,0)="DSIYRET(21) = Information on Equipment functionality for user"
^XWB(8994,3999,3,8,0)="DSIYRET(3) = Information on Work Order functinoality for user"
^XWB(8994,3999,3,9,0)="DSIYRET(4) = Information on Inventory functionality for user"
^XWB(8994,3999,3,10,0)=" "
^XWB(8994,3999,3,11,0)="Pieces returned for 2,3,4 above:"
^XWB(8994,3999,3,12,0)=" - p1:  Function (EQ, PO, WO, GIP, PO, or VENDOR)"
^XWB(8994,3999,3,13,0)=" - p2:  User Type definition (parameter to set if this is parameterized)"
^XWB(8994,3999,3,14,0)=" - p3:  Description of this user type"
^XWB(8994,3999,3,15,0)=" - p4:  Starting screen (Metric, Today, or Item)"
^XWB(8994,3999,3,16,0)=" - p5:  If GIP user - starting location"
^XWB(8994,3999,3,17,0)=" - p6:  Free text to describe how this user's data was obtained"
^XWB(8994,3999,3,18,0)=" "
^XWB(8994,3999,3,19,0)="NOTE:  Some user types are set based on keys rather than a parameter "
^XWB(8994,3999,3,20,0)="setting, this is indicated in piece 6 of the return value"
^XWB(8994,4000,0)="DSIYGNP1 WINLST WINDOW LIST^WINLST^DSIYGNP1^4^^^^1"
^XWB(8994,4000,1,0)="^^3^3^3180918^"
^XWB(8994,4000,1,1,0)="Returns a list of inventory points for a user. This list is a ""shifting "
^XWB(8994,4000,1,2,0)="window"", the part of the full list returned being dependent on the "
^XWB(8994,4000,1,3,0)="provided parameters; term, direction, count and Active Only."
^XWB(8994,4000,2,0)="^8994.02A^5^5"
^XWB(8994,4000,2,1,0)="DIR^1^2^1^1"
^XWB(8994,4000,2,1,1,0)="^^2^2^3130417^"
^XWB(8994,4000,2,1,1,1,0)="The direction in which to go. 1 proceeds normally through a list while -1 "
^XWB(8994,4000,2,1,1,2,0)="goes backwards."
^XWB(8994,4000,2,2,0)="COUNT^1^30^1^2"
^XWB(8994,4000,2,2,1,0)="^^1^1^3130417^"
^XWB(8994,4000,2,2,1,1,0)="The number of entries to return."
^XWB(8994,4000,2,3,0)="TERM^1^30^0^3"
^XWB(8994,4000,2,3,1,0)="^8994.021^1^1^3151022^^"
^XWB(8994,4000,2,3,1,1,0)="The name of the entry to begin with."
^XWB(8994,4000,2,4,0)="TYPE^1^3^0^4"
^XWB(8994,4000,2,4,1,0)="^8994.021^2^2^3180918^^^"
^XWB(8994,4000,2,4,1,1,0)="The type of Distribution Point to return (P=Primary, S=Secondary, "
^XWB(8994,4000,2,4,1,2,0)="W=Warehouse). Defaults to ""P"".)."
^XWB(8994,4000,2,5,0)="ACTIVE ONLY^1^1^0^5"
^XWB(8994,4000,2,5,1,0)="^8994.021^3^3^3180918^^"
^XWB(8994,4000,2,5,1,1,0)="Active Only"
^XWB(8994,4000,2,5,1,2,0)="Pass '1' if the search wants to retrieve only active entries.  By default "
^XWB(8994,4000,2,5,1,3,0)="both active and inactive Inventory Distribution Points."
^XWB(8994,4000,2,"B","ACTIVE ONLY",5)=""
^XWB(8994,4000,2,"B","COUNT",2)=""
^XWB(8994,4000,2,"B","DIR",1)=""
^XWB(8994,4000,2,"B","TERM",3)=""
^XWB(8994,4000,2,"B","TYPE",4)=""
^XWB(8994,4000,2,"PARAMSEQ",1,1)=""
^XWB(8994,4000,2,"PARAMSEQ",2,2)=""
^XWB(8994,4000,2,"PARAMSEQ",3,3)=""
^XWB(8994,4000,2,"PARAMSEQ",4,4)=""
^XWB(8994,4000,2,"PARAMSEQ",5,5)=""
^XWB(8994,4000,3,0)="^^7^7^3180918^"
^XWB(8994,4000,3,1,0)="List in the format:"
^XWB(8994,4000,3,2,0)=" "
^XWB(8994,4000,3,3,0)="ret(n)=IEN ^ InvPt Name ^ InvPt Type "
^XWB(8994,4000,3,4,0)=" "
^XWB(8994,4000,3,5,0)="or "
^XWB(8994,4000,3,6,0)=" "
^XWB(8994,4000,3,7,0)="ret(1)=-1^Error Message"
^XWB(8994,4001,0)="DSIYAT01 LISTATT LIST ATT^LISTATT^DSIYAT01^4^^^^1"
^XWB(8994,4001,1,0)="^8994.01^8^8^3200729^^^^"
^XWB(8994,4001,1,1,0)="LISTATT"
^XWB(8994,4001,1,2,0)=" "
^XWB(8994,4001,1,3,0)="List basic image information about attachments."
^XWB(8994,4001,1,4,0)=" "
^XWB(8994,4001,1,5,0)=" "
^XWB(8994,4001,1,6,0)="For Equipment, include images found in the DSIY EQUIPMENT DATA "
^XWB(8994,4001,1,7,0)="FILE (#19685.31) and any images linked to the equipment's Manufacture-"
^XWB(8994,4001,1,8,0)="Model in file MANUFACTURER-MODEL IMAGES (#19685.38)."
^XWB(8994,4001,2,0)="^8994.02A^3^3"
^XWB(8994,4001,2,1,0)="FILE^1^15^1^1"
^XWB(8994,4001,2,1,1,0)="^^19^19^3200728^"
^XWB(8994,4001,2,1,1,1,0)="FILE"
^XWB(8994,4001,2,1,1,2,0)=" "
^XWB(8994,4001,2,1,1,3,0)="File # from which to list attachments.  Currently attachments are defined "
^XWB(8994,4001,2,1,1,4,0)="for"
^XWB(8994,4001,2,1,1,5,0)=" "
^XWB(8994,4001,2,1,1,6,0)="19685.3 - Work Order File"
^XWB(8994,4001,2,1,1,7,0)="19685.31 - Equipment File"
^XWB(8994,4001,2,1,1,8,0)="19685.32 - Inventory Item Master File"
^XWB(8994,4001,2,1,1,9,0)="19685.38 - Manufacturer-Model"
^XWB(8994,4001,2,1,1,10,0)=" "
^XWB(8994,4001,2,1,1,11,0)="Assumption is that attachments are always stored in a multiple under "
^XWB(8994,4001,2,1,1,12,0)="field 4 in the following fields:"
^XWB(8994,4001,2,1,1,13,0)=" "
^XWB(8994,4001,2,1,1,14,0)=".01:  Attachment Description"
^XWB(8994,4001,2,1,1,15,0)="1:    File Name (no path, just file name)"
^XWB(8994,4001,2,1,1,16,0)="2:    File Type (EXE, JPG, PDF, etc.)"
^XWB(8994,4001,2,1,1,17,0)="3:    Added by (no edit, updated when file created)"
^XWB(8994,4001,2,1,1,18,0)="4:    Date added (no edit, updated when file created)"
^XWB(8994,4001,2,1,1,19,0)="5:    Comments"
^XWB(8994,4001,2,2,0)="IEN^1^15^1^2"
^XWB(8994,4001,2,2,1,0)="^8994.021^3^3^3200506^^^^"
^XWB(8994,4001,2,2,1,1,0)="IEN"
^XWB(8994,4001,2,2,1,2,0)=" "
^XWB(8994,4001,2,2,1,3,0)="IEN to the file in which to pull attachment information"
^XWB(8994,4001,2,3,0)="THUMBNAIL FLAG^1^1^0^3"
^XWB(8994,4001,2,3,1,0)="^8994.021^1^1^3200729^^^"
^XWB(8994,4001,2,3,1,1,0)="Set flag to only return thumbnail attachments."
^XWB(8994,4001,2,"B","FILE",1)=""
^XWB(8994,4001,2,"B","IEN",2)=""
^XWB(8994,4001,2,"B","THUMBNAIL FLAG",3)=""
^XWB(8994,4001,2,"PARAMSEQ",1,1)=""
^XWB(8994,4001,2,"PARAMSEQ",2,2)=""
^XWB(8994,4001,2,"PARAMSEQ",3,3)=""
^XWB(8994,4001,3,0)="^^15^15^3200729^"
^XWB(8994,4001,3,1,0)="RETURN PARAMETER"
^XWB(8994,4001,3,2,0)=" "
^XWB(8994,4001,3,3,0)="DSIYRET(1)=""0^<Warning Message>    If there are warnings/no data"
^XWB(8994,4001,3,4,0)="DSIYRET(1)=""-1^<Error Message>     if there are errors"
^XWB(8994,4001,3,5,0)=" "
^XWB(8994,4001,3,6,0)="DSIYRET(#)= FILE#"
^XWB(8994,4001,3,7,0)="          ^IEN TO FILE"
^XWB(8994,4001,3,8,0)="          ^MULTIPLE NODE (NEEDED TO PULL DETAIL INFO)"
^XWB(8994,4001,3,9,0)="          ^FILENAME (NO PATH, JUST FILENAME)"
^XWB(8994,4001,3,10,0)="          ^ATTACHMENT DESCRIPTION"
^XWB(8994,4001,3,11,0)="          ^DATE ADDED"
^XWB(8994,4001,3,12,0)="          ^SUB PATH"
^XWB(8994,4001,3,13,0)="          ^THUMBNAIL"
^XWB(8994,4001,3,14,0)="          ^SIZE (kilobytes)"
^XWB(8994,4001,3,15,0)="          ^MODEL IEN (19685.381) only if file is 19685.38"
^XWB(8994,4002,0)="DSIYAT01 DETATT DETAIL ATT^DETATT^DSIYAT01^2"
^XWB(8994,4002,1,0)="^8994.01^3^3^3200730^^^^"
