^XWB(8994,1213,3,2,0)=" "
^XWB(8994,1213,3,3,0)="Either the CLINICAL PROCEDURES TIU Document file (#8925.1) IEN or 0."
^XWB(8994,1214,0)="TIU LONG LIST CLINPROC TITLES^LNGCP^TIUCP^2^S"
^XWB(8994,1214,1,0)="^8994.01^2^2^3010227^^^^"
