^XWB(8994,4163,2,1,0)="USER^1^^1^1"
^XWB(8994,4163,2,1,1,0)="^^1^1^3170626^"
^XWB(8994,4163,2,1,1,1,0)="DUZ of user from NEW PERSON file (#200)."
