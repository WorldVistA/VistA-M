^XWB(8994,3388,2,"PARAMSEQ",1,1)=""
^XWB(8994,3388,2,"PARAMSEQ",2,2)=""
^XWB(8994,3388,3,0)="^^36^36^3150722^"
^XWB(8994,3388,3,1,0)="Fail"
^XWB(8994,3388,3,2,0)="  R(0) =""-1^Error Message"""
^XWB(8994,3388,3,3,0)="Success"
^XWB(8994,3388,3,4,0)="  R(0) = 1"
^XWB(8994,3388,3,5,0)="  R(""NAME"") = NAME"
^XWB(8994,3388,3,6,0)="  R(""LASTNAME"") = Family Name"
^XWB(8994,3388,3,7,0)="  R(""FIRSTNAME"") = Given Name"
^XWB(8994,3388,3,8,0)="  R(""MIDDLENAME"") = Middle Name"
^XWB(8994,3388,3,9,0)="  R(""SUFFIX"") = Suffix(es)"
^XWB(8994,3388,3,10,0)="  R(""INITIAL"") = INITIAL"
^XWB(8994,3388,3,11,0)="  R(""TITLE"") = TITLE"
^XWB(8994,3388,3,12,0)="  R(""NICK_NAME"") = NICK NAME"
^XWB(8994,3388,3,13,0)="  R(""SSN"") = SSN (<Hidden> if caller does not hold XUSHOWSSN key)"
^XWB(8994,3388,3,14,0)="  R(""DOB"") = DOB (<Hidden> if caller does not hold XUSHOWSSN key)"
^XWB(8994,3388,3,15,0)="  R(""DEGREE"") = DEGREE"
^XWB(8994,3388,3,16,0)="  R(""MAIL_CODE"") = MAIL CODE"
^XWB(8994,3388,3,17,0)="  R(""STATUS"") = $$ACTIVE^XUSER(DISPDUZ)"
^XWB(8994,3388,3,18,0)="  R(""DISUSER"") = DISUSER"
^XWB(8994,3388,3,19,0)="  R(""TERMINATION_DATE"") = TERMINATION DATE"
^XWB(8994,3388,3,20,0)="  R(""TERMINATION_REASON"") = TERMINATION REASON"
^XWB(8994,3388,3,21,0)="  R(""PRIMARY_MENU_OPTION"") = PRIMARY MENU OPTION"
^XWB(8994,3388,3,22,0)="  R(""SECONDARY_MENU_OPTION"",0) = SECONDARY MENU OPTION (# of entries)"
^XWB(8994,3388,3,23,0)="  R(""SECONDARY_MENU_OPTION"",1) to R(""SECONDARY_MENU_OPTION"",n) = entries"
^XWB(8994,3388,3,24,0)="  R(""FILE_MANAGER_ACCESS_CODE"") = FILE MANAGER ACCESS CODE"
^XWB(8994,3388,3,25,0)="  R(""DIVISION"",0) = DIVISION (number of entries)"
^XWB(8994,3388,3,26,0)="  R(""DIVISION"",1) to R(""DIVISION"",n) = DIVISION entries"
^XWB(8994,3388,3,27,0)="  R(""SERVICE_SECTION"") = SERVICE/SECTION"
^XWB(8994,3388,3,28,0)="  R(""SUBJECT_ALTERNATIVE_NAME"") = SUBJECT ALTERNATIVE NAME"
^XWB(8994,3388,3,29,0)="  R(""SECID"") = SECID"
^XWB(8994,3388,3,30,0)="  R(""ORGANIZATION_NAME"") = SUBJECT ORGANIZATION"
^XWB(8994,3388,3,31,0)="  R(""ORGANIZATION_ID"") = SUBJECT ORGANIZATION ID"
^XWB(8994,3388,3,32,0)="  R(""UNIQUE_USER_ID"") = UNIQUE USER ID"
^XWB(8994,3388,3,33,0)="  R(""NETWORK_USER_NAME"") = NETWORK USERNAME"
^XWB(8994,3388,3,34,0)="  R(""ADUPN"") = AD UPN"
^XWB(8994,3388,3,35,0)="  R(""EMAIL"") = EMAIL ADDRESS"
^XWB(8994,3388,3,36,0)="  R(""GENDER"") = SEX (M/F)"
^XWB(8994,3389,0)="XUS ESSO VALIDATE^ESSO^XUESSO4^2^R^^^^1^^0"
^XWB(8994,3389,1,0)="^^3^3^3151209^"
^XWB(8994,3389,1,1,0)="RPC ICR #6295 - API ICR #none"
^XWB(8994,3389,1,2,0)="This API/RPC uses the VA Identity and Access Management (IAM) SAML token"
^XWB(8994,3389,1,3,0)="definition version 1.2 attributes from a SAML token for user sign-on."
^XWB(8994,3389,2,0)="^8994.02A^1^1"
^XWB(8994,3389,2,1,0)="DOC^1^30^1^1"
^XWB(8994,3389,2,1,1,0)="^^4^4^3150305^"
^XWB(8994,3389,2,1,1,1,0)="Input:   DOC = Closed reference to global root containing XML document "
^XWB(8994,3389,2,1,1,2,0)="               (loaded STS SAML Token). See $$EN^MXMLDOM instructions in"
^XWB(8994,3389,2,1,1,3,0)="               the VistA Kernel Developers Guide for required format of"
^XWB(8994,3389,2,1,1,4,0)="               the DOC global."
^XWB(8994,3389,2,"B","DOC",1)=""
^XWB(8994,3389,2,"PARAMSEQ",1,1)=""
^XWB(8994,3389,3,0)="^8994.03^7^7^3150305^^^^"
^XWB(8994,3389,3,1,0)="R(0) = DUZ if sign-on was OK, zero if not OK."
^XWB(8994,3389,3,2,0)="R(1) = (0=OK, 1,2...=Can't sign on for some reason)."
^XWB(8994,3389,3,3,0)="R(2) = Verify Code needs changing."
^XWB(8994,3389,3,4,0)="R(3) = Message."
^XWB(8994,3389,3,5,0)="R(4) = 0"
^XWB(8994,3389,3,6,0)="R(5) = count of the number of lines of text, zero if none."
^XWB(8994,3389,3,7,0)="R(5+n) = message text."
^XWB(8994,3390,0)="XUS IAM BIND USER^IAMBU^XUESSO4^1^S^^^^1^^0"
^XWB(8994,3390,1,0)="^^5^5^3151209^"
^XWB(8994,3390,1,1,0)="RPC ICR #6294 - API ICR #none"
^XWB(8994,3390,1,2,0)="This restricted RPC is used exclusively by the Identity and Access "
^XWB(8994,3390,1,3,0)="Management (IAM) Binding application to set the Security ID (SecID) and "
^XWB(8994,3390,1,4,0)="Active Directory UPN (ADUPN) in the VistA NEW PERSON file (#200) for"
^XWB(8994,3390,1,5,0)="Single Sign-On Internal (SSOi)."
^XWB(8994,3390,2,0)="^8994.02A^3^3"
^XWB(8994,3390,2,1,0)="SECID^1^40^1^1"
^XWB(8994,3390,2,1,1,0)="^^1^1^3150311^"
^XWB(8994,3390,2,1,1,1,0)="Unique Security ID [SecID, assigned by Identity and Access Management]"
^XWB(8994,3390,2,2,0)="AUTHCODE^1^80^1^2"
^XWB(8994,3390,2,2,1,0)="^8994.021^1^1^3151203^^^"
^XWB(8994,3390,2,2,1,1,0)="Security Phrase for IAM Binding Application"
^XWB(8994,3390,2,3,0)="ADUPN^1^30^1^3"
^XWB(8994,3390,2,3,1,0)="^8994.021^1^1^3151203^^"
^XWB(8994,3390,2,3,1,1,0)="Active Directory UPN"
^XWB(8994,3390,2,"B","ADUPN",3)=""
^XWB(8994,3390,2,"B","AUTHCODE",2)=""
^XWB(8994,3390,2,"B","SECID",1)=""
