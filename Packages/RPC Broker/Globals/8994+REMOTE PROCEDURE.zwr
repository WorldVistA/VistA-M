^XWB(8994,2881,3,3,0)="               -2^Request not found for this IEN: ###."
^XWB(8994,2881,3,4,0)="      The return array will contain strings formatted in groups (one per "
^XWB(8994,2881,3,5,0)="request) as follows:"
^XWB(8994,2881,3,6,0)="               "
^XWB(8994,2881,3,7,0)="$$AOD$$^IEN^DateRecieved^Requestor^Reason^RequestorType^Status"
^XWB(8994,2881,3,8,0)="        $$COMMENT1$$^Comment line 1 text"
^XWB(8994,2881,3,9,0)="        $$COMMENT2$$^Comment line 2 text"
^XWB(8994,2881,3,10,0)="        $$COMMENT3$$^Comment line 3 text"
^XWB(8994,2881,3,11,0)="        $$DOCUMENT$$^Document Caption^Document Date "
^XWB(8994,2881,3,12,0)="        $$DOCUMENT$$^Document Caption^Document Date^Document Type^"
^XWB(8994,2881,3,13,0)="                     if paper ""P"" else """"                             "
^XWB(8994,2881,3,14,0)="            (one line like the above for each document)"
^XWB(8994,2881,3,15,0)="        $$PAPER$$^one or more optional records for paper documents."
^XWB(8994,2882,0)="DSIR GET CLERK REQUESTS^GETTODAY^DSIROI^4^^^^1"
^XWB(8994,2882,1,0)="^8994.01^2^2^3111118^^"
^XWB(8994,2882,1,1,0)="This RPC returns all open/pending requests for a given clerk.  This is "
