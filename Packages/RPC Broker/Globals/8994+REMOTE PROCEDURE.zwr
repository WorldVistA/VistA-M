^XWB(8994,3891,3,11,0)="step."
^XWB(8994,3891,3,12,0)=" "
^XWB(8994,3891,3,13,0)="If there is nothing in the second piece, then no validation is needed."
^XWB(8994,3891,3,14,0)="DSIYRET(""X"") = Transfer Message"
^XWB(8994,3891,3,15,0)="DSIYRET(""D"") = Disapprove Message"
