^XWB(8994,5069,0)="DSSO LPCI SUSPENSE NOTES^LPCISUSP^DSSOROHN^4^^^^1"
^XWB(8994,5069,1,0)="^8994.01^3^3^3200821^^^"
^XWB(8994,5069,1,1,0)="This RPC compiles initial action, action (other), completion, and "
^XWB(8994,5069,1,2,0)="cancellation notes from the PROSTHETIC SUSPENSE file (#668) for display "
^XWB(8994,5069,1,3,0)="on the LPCI+ report."
^XWB(8994,5069,2,0)="^8994.02A^1^1"
^XWB(8994,5069,2,1,0)="DSSO664^1^15^1^1"
^XWB(8994,5069,2,1,1,0)="^^1^1^3200821^"
^XWB(8994,5069,2,1,1,1,0)="File 664 IEN"
^XWB(8994,5069,2,"B","DSSO664",1)=""
^XWB(8994,5069,2,"PARAMSEQ",1,1)=""
^XWB(8994,5069,3,0)="^^26^26^3200924^"
^XWB(8994,5069,3,1,0)="DSSORET - Error Messages: ""-1^""_error message"
^XWB(8994,5069,3,2,0)="          Warning Messages: ""0^""_warning message"
^XWB(8994,5069,3,3,0)="          Successful Completion:  Suspense notes for the requested"
^XWB(8994,5069,3,4,0)="            PROSTHETIC SUSPENSE file (#668) record in the format:"
^XWB(8994,5069,3,5,0)="          ^-pc 1: File 664 IEN or $$CONT$$ flag"
^XWB(8994,5069,3,6,0)="          ^-pc 2: ""NOTE"""
^XWB(8994,5069,3,7,0)="          ^-pc 3: Date/timestamp (reverse chronological order)"
^XWB(8994,5069,3,8,0)="          ^-pc 4: Note # (reverse order; will always be one unless"
^XWB(8994,5069,3,9,0)="                  there are duplicate timestamps)"
^XWB(8994,5069,3,10,0)="          ^-pc 5: Type of Note:  ""INITIAL"", ""OTHER"", ""COMPLETION"", "
^XWB(8994,5069,3,11,0)="                                 ""CANCELLATION"""
^XWB(8994,5069,3,12,0)="          ^-pc 6: Note text line 1"
^XWB(8994,5069,3,13,0)="            ..."
^XWB(8994,5069,3,14,0)=" "
^XWB(8994,5069,3,15,0)="          If a result line is longer than 245 characters, it will be cut "
^XWB(8994,5069,3,16,0)="          and continue on the next line. If the first piece of a node is"
^XWB(8994,5069,3,17,0)="          $$CONT$$ flag, append the node to the previous line as this is"
^XWB(8994,5069,3,18,0)="          the continuation of that data. "
^XWB(8994,5069,3,19,0)="         "
^XWB(8994,5069,3,20,0)="          If there are no suspense notes, then ^-pieces 3 and 4 will be"
^XWB(8994,5069,3,21,0)="          set to ""0^No notes associated""."
^XWB(8994,5069,3,22,0)=" "
^XWB(8994,5069,3,23,0)="   NOTE:  For the OWL, in the Prosthetic GUI and APAT, the cancellation"
^XWB(8994,5069,3,24,0)="          note is stored as the COMPLETION note.  In this instance, the"
^XWB(8994,5069,3,25,0)="          CANCELLATION DATE is returned since the COMPLETION DATE is not"
^XWB(8994,5069,3,26,0)="          populated."
^XWB(8994,5070,0)="DSSO FM GETS^GETS^DSSOFM2^4^^^^1"
^XWB(8994,5070,1,0)="^8994.01^2^2^3210204^^"
^XWB(8994,5070,1,1,0)="This RPC provides GETS^DIQ functionality.  File and fields to be returned "
^XWB(8994,5070,1,2,0)="are specified by the GUI.  NOTE:  This RPC does not handle subfiles."
^XWB(8994,5070,2,0)="^8994.02A^4^4"
^XWB(8994,5070,2,1,0)="DSSOFILE^1^15^1^1"
^XWB(8994,5070,2,1,1,0)="^^2^2^3210204^"
^XWB(8994,5070,2,1,1,1,0)="File number"
^XWB(8994,5070,2,1,1,2,0)="NOTE:  Subfiles are not handled by this RPC."
^XWB(8994,5070,2,2,0)="DSSOIEN^1^15^1^2"
^XWB(8994,5070,2,2,1,0)="^^1^1^3210202^"
^XWB(8994,5070,2,2,1,1,0)="Standard IEN indicating internal entry number of input file."
^XWB(8994,5070,2,3,0)="DSSOFLDS^1^245^1^3"
^XWB(8994,5070,2,3,1,0)="^^2^2^3210202^"
^XWB(8994,5070,2,3,1,1,0)="A single field number or a list of field numbers separated by "
^XWB(8994,5070,2,3,1,2,0)="semicolons(;)"
^XWB(8994,5070,2,4,0)="DSSOFLGS^1^2^0^4"
^XWB(8994,5070,2,4,1,0)="^8994.021^6^6^3210204^^^^"
^XWB(8994,5070,2,4,1,1,0)="Optional - flags to control processing:"
^XWB(8994,5070,2,4,1,2,0)="   E  - returns External value (this is the default)"
^XWB(8994,5070,2,4,1,3,0)="   I  - returns Internal value"
^XWB(8994,5070,2,4,1,4,0)="   EI - returns External and Internal values.  If both values"
^XWB(8994,5070,2,4,1,5,0)="        are requested (""EI"" or ""IE""), they will always be "
^XWB(8994,5070,2,4,1,6,0)="        returned in ""EI"" order."
^XWB(8994,5070,2,"B","DSSOFILE",1)=""
^XWB(8994,5070,2,"B","DSSOFLDS",3)=""
^XWB(8994,5070,2,"B","DSSOFLGS",4)=""
^XWB(8994,5070,2,"B","DSSOIEN",2)=""
^XWB(8994,5070,2,"PARAMSEQ",1,1)=""
^XWB(8994,5070,2,"PARAMSEQ",2,2)=""
^XWB(8994,5070,2,"PARAMSEQ",3,3)=""
^XWB(8994,5070,2,"PARAMSEQ",4,4)=""
^XWB(8994,5070,3,0)="^8994.03^17^17^3210204^^"
^XWB(8994,5070,3,1,0)="Output:  Error:    ""-1^""_error message up to 245 characters"
^XWB(8994,5070,3,2,0)="         Success:  All data is returned in this format -"
^XWB(8994,5070,3,3,0)="                   multiple lines may be returned depending"
^XWB(8994,5070,3,4,0)="                   on the number of fields and whether both"
^XWB(8994,5070,3,5,0)="                   external and internal values are requested:"
^XWB(8994,5070,3,6,0)="                   "
^XWB(8994,5070,3,7,0)="                   DSSORET(n) = line number "
^XWB(8994,5070,3,8,0)="                                ""^"" field number"
^XWB(8994,5070,3,9,0)="                                ""~"" external value (if requested)"
^XWB(8994,5070,3,10,0)="                                ""~"" internal value (if requested)"
^XWB(8994,5070,3,11,0)="                                The format of field number and"
^XWB(8994,5070,3,12,0)="                                external/internal values repeats "
^XWB(8994,5070,3,13,0)="                                for each requested field number."
^XWB(8994,5070,3,14,0)="                                n=line number"
^XWB(8994,5070,3,15,0)="                             NOTE:  Every field number is preceded"
^XWB(8994,5070,3,16,0)="                                      by a ""^""."
^XWB(8994,5070,3,17,0)="                                    Each value is preceded by a ""~""."
^XWB(8994,5071,0)="DSSO CANCEL SIMP PC ORDER^CNCL664^DSSOPN6^1"
^XWB(8994,5071,1,0)="^8994.01^2^2^3220524^^^^"
^XWB(8994,5071,1,1,0)="This RPC cancels a simplified purchase card order in the PROSTHETICS 1358 "
^XWB(8994,5071,1,2,0)="(#664) file."
^XWB(8994,5071,2,0)="^8994.02A^3^3"
^XWB(8994,5071,2,1,0)="DSSO664^1^15^1^1"
^XWB(8994,5071,2,1,1,0)="^8994.021^1^1^3220523^^"
^XWB(8994,5071,2,1,1,1,0)="File 664 IEN"
^XWB(8994,5071,2,2,0)="DSSODUZ^1^15^1^2"
^XWB(8994,5071,2,2,1,0)="^8994.021^1^1^3220523^^"
^XWB(8994,5071,2,2,1,1,0)="File 200 IEN"
^XWB(8994,5071,2,3,0)="DSSOCRMKS^1^60^0^3"
^XWB(8994,5071,2,3,1,0)="^8994.021^3^3^3220524^^"
^XWB(8994,5071,2,3,1,1,0)="Cancellation Remarks - optional"
^XWB(8994,5071,2,3,1,2,0)="  If input, must be 3-60 characters."
^XWB(8994,5071,2,3,1,3,0)="  If not input, defaults to ""Cancellation at user request"""
^XWB(8994,5071,2,"B","DSSO664",1)=""
^XWB(8994,5071,2,"B","DSSOCRMKS",3)=""
^XWB(8994,5071,2,"B","DSSODUZ",2)=""
^XWB(8994,5071,2,"PARAMSEQ",1,1)=""
^XWB(8994,5071,2,"PARAMSEQ",2,2)=""
^XWB(8994,5071,2,"PARAMSEQ",3,3)=""
^XWB(8994,5071,3,0)="^8994.03^4^4^3220524^^^"
^XWB(8994,5071,3,1,0)="Output:"
^XWB(8994,5071,3,2,0)="  Error Messages:  ""-1^""_error message"
^XWB(8994,5071,3,3,0)="  Success Message:  ""1^Simplified purchase card order cancelled "
^XWB(8994,5071,3,4,0)="                    successfully."""
^XWB(8994,5072,0)="DSSO GET ABOUT INFO^DSSOABT^DSSOUTL^2^^^^1"
^XWB(8994,5072,1,0)="^^3^3^3230711^"
^XWB(8994,5072,1,1,0)="This RPC returns the latest version for the DSSO, DSIC, and DSIV"
^XWB(8994,5072,1,2,0)="namespaces. Latest DISTRIBUTION DATE is returned for full builds (DSIC)"
^XWB(8994,5072,1,3,0)="and patches (DSSO and DSIV)."
^XWB(8994,5072,3,0)="^^14^14^3230711^"
^XWB(8994,5072,3,1,0)="Output:"
^XWB(8994,5072,3,2,0)="  Error Messages:  ""-1^""_error message "
^XWB(8994,5072,3,3,0)="                   ""-1^DSSO-No version number returned"""
^XWB(8994,5072,3,4,0)="                   ""-1^DSSO-Error returning last patch information"""
^XWB(8994,5072,3,5,0)="                   (namespaces DSIC and DSIV also generate these "
^XWB(8994,5072,3,6,0)="                    errors)"
^XWB(8994,5072,3,7,0)=" "
^XWB(8994,5072,3,8,0)="  Successful Completion:"
^XWB(8994,5072,3,9,0)="    DSSORET(n)=    (where n=line number in return)"
^XWB(8994,5072,3,10,0)="       ^-pc 1 - Numeric value for returning data in expected order"
^XWB(8994,5072,3,11,0)="       ^-pc 2 - Namespace (i.e.-""DSSO"")"
^XWB(8994,5072,3,12,0)="       ^-pc 3 - Patch or Full Build Description "
^XWB(8994,5072,3,13,0)="                 (i.e.-patch ""DSSO*2.0*3"" or full build ""DSIC 1.5"")"
^XWB(8994,5072,3,14,0)="       ^-pc 4 - Latest INSTALL file (#9.7) DISTRIBUTION DATE (#51))"
^XWB(8994,5072,3,15,0)="                 (For patches,PACKAGE file (#9.4) PATCH APPLICATION"
^XWB(8994,5072,3,16,0)="                    HISTORY (subfile #9.4901) DATE APPLIED (.02) "
^XWB(8994,5072,3,17,0)="                  For full builds,"
^XWB(8994,5072,3,18,0)="                    INSTALL file (#9.7) DISTRIBUTION DATE (#51))"
^XWB(8994,5073,0)="DSSO BATCH 664 BILLING ITEMS^BATCH664^DSSOPP5^2^A^^^1"
^XWB(8994,5073,1,0)="^^3^3^3221214^"
^XWB(8994,5073,1,1,0)="This RPC accepts an array of data in DSSOUPD which cotains multiple copies"
^XWB(8994,5073,1,2,0)="of fields/data to be input into the original entry point for"
^XWB(8994,5073,1,3,0)="DSSO ADD 664 BILLING ITEM. The calls will be made in sequence."
^XWB(8994,5073,2,0)="^8994.02A^2^2"
^XWB(8994,5073,2,1,0)="DSSOIEN^1^30^1^1"
^XWB(8994,5073,2,1,1,0)="^^1^1^3221214^"
^XWB(8994,5073,2,1,1,1,0)="IEN of Prosthetics 1358 file (#664) to which billing item is to be added"
^XWB(8994,5073,2,2,0)="DSSOUPD^2^245^1^2"
^XWB(8994,5073,2,2,1,0)="^^7^7^3221214^"
^XWB(8994,5073,2,2,1,1,0)="This is an array which contains multiple copies of the data originally "
^XWB(8994,5073,2,2,1,2,0)="passed into DSSO ADD 664 BILLING ITEM. This is a wrapper around that "
^XWB(8994,5073,2,2,1,3,0)="original RPC which allows for multiple billing items to be added to the "
^XWB(8994,5073,2,2,1,4,0)="record with only a single call."
^XWB(8994,5073,2,2,1,5,0)=" "
^XWB(8994,5073,2,2,1,6,0)="For further details regarding array formatting, see original DSSO ADD 664 "
^XWB(8994,5073,2,2,1,7,0)="BILLING ITEM documentation."
^XWB(8994,5073,2,"B","DSSOIEN",1)=""
^XWB(8994,5073,2,"B","DSSOUPD",2)=""
^XWB(8994,5073,2,"PARAMSEQ",1,1)=""
^XWB(8994,5073,2,"PARAMSEQ",2,2)=""
^XWB(8994,5073,3,0)="^^12^12^3221214^"
^XWB(8994,5073,3,1,0)="The output of this RPC will be in the form of a list of results for each "
^XWB(8994,5073,3,2,0)="individual call to DSSO ADD 664 BILLING ITEM. As such, the individual "
^XWB(8994,5073,3,3,0)="formatting of those errors can be found in the original DSSO ADD 664 "
^XWB(8994,5073,3,4,0)="BILLING ITEM documentation."
^XWB(8994,5073,3,5,0)=" "
^XWB(8994,5073,3,6,0)="The results of this RPC however will be formatted as follows:"
^XWB(8994,5073,3,7,0)=" "
^XWB(8994,5073,3,8,0)="  For billing items 1..n:"
^XWB(8994,5073,3,9,0)="    Item #1^*result*"
^XWB(8994,5073,3,10,0)="    Item #2^*result*"
^XWB(8994,5073,3,11,0)="    ..."
^XWB(8994,5073,3,12,0)="    Item #n^*result*"
^XWB(8994,5074,0)="DSSO 2319 ADD PAT RCD ACTIVITY^ACTIVITY^DSSOUT6^1^^^^1"
^XWB(8994,5074,1,0)="^8994.01^3^3^3230301^^"
^XWB(8994,5074,1,1,0)="This RPC creates an entry in the APAT PATIENT RECORD ACTIVITY FILE "
^XWB(8994,5074,1,2,0)="(#23645) when a RECORD OF PROS APPLIANCE/REPAIR (#660) entry is"
^XWB(8994,5074,1,3,0)="edited or deleted."
^XWB(8994,5074,2,0)="^8994.02A^2^2"
^XWB(8994,5074,2,1,0)="DSSOIEN^1^15^1^1"
^XWB(8994,5074,2,1,1,0)="^8994.021^1^1^3230301^^"
^XWB(8994,5074,2,1,1,1,0)="RECORD OF PROS APPLIANCE/REPAIR (#660) file IEN - required"
^XWB(8994,5074,2,2,0)="DSSOACT^1^1^1^2"
^XWB(8994,5074,2,2,1,0)="^8994.021^1^1^3230301^^"
^XWB(8994,5074,2,2,1,1,0)="Activity Type:  1=2319 entry was edited; 0=2319 entry was deleted"
^XWB(8994,5074,2,"B","DSSOACT",2)=""
^XWB(8994,5074,2,"B","DSSOIEN",1)=""
^XWB(8994,5074,2,"PARAMSEQ",1,1)=""
^XWB(8994,5074,2,"PARAMSEQ",2,2)=""
^XWB(8994,5074,3,0)="^8994.03^5^5^3230301^^"
^XWB(8994,5074,3,1,0)="Output:  "
^XWB(8994,5074,3,2,0)="  Error Message:  ""-1^""_error message"
^XWB(8994,5074,3,3,0)="  Warning Message: ""0^""_warning message"
^XWB(8994,5074,3,4,0)="  Success Message: ""1^COMPLETE - ""_newly-created APAT PATIENT RECORD"
^XWB(8994,5074,3,5,0)="    ACTIVITY file (#23645) IEN"
^XWB(8994,5075,0)="DSSO GET ESCP STATION DATA^ESCPSTN^DSSOSCU0^1^^^^1"
^XWB(8994,5075,1,0)="^8994.01^1^1^3230321^^"
^XWB(8994,5075,1,1,0)="This RPC returns station data for the ESCP application."
^XWB(8994,5075,3,0)="^8994.03^12^12^3230321^^"
^XWB(8994,5075,3,1,0)="Error Messages:  ""-1^""_error message"
^XWB(8994,5075,3,2,0)="Successful Processing: p1^p2^p3^p4^p5^p6^p7^p8 where "
^XWB(8994,5075,3,3,0)="  p1 = INSTITUTION FILE (file 4) IEN"
^XWB(8994,5075,3,4,0)="  p2 = STATION NAME (file 4 field #.01)"
^XWB(8994,5075,3,5,0)="  p3 = STATION NUMBER (file 4 field #99)"
^XWB(8994,5075,3,6,0)="  p4 = REGION (file 4 field #.07) "
^XWB(8994,5075,3,7,0)="       If REGION is null for this station, then the REGION"
^XWB(8994,5075,3,8,0)="        of the parent facility will be returned."
^XWB(8994,5075,3,9,0)="  p5 = TIME ZONE Offset"
^XWB(8994,5075,3,10,0)="  p6 = VISN (from the ASSOCIATIONS (file 4 #14) multiple"
^XWB(8994,5075,3,11,0)="       If VISN is null for this station, then the VISN of"
^XWB(8994,5075,3,12,0)="       the parent facility will be returned."
^XWB(8994,5076,0)="SDES2 PRINT APPT LETTER^PRINTLETTER^SDES2APTLETTER^2^R^^^^^^1"
^XWB(8994,5076,1,0)="^^3^3^3250214^"
^XWB(8994,5076,1,1,0)="Print single appointment letter."
^XWB(8994,5076,1,2,0)=" "
^XWB(8994,5076,1,3,0)="Can only be invoked by Acheron"
^XWB(8994,5076,2,0)="^8994.02A^2^2"
^XWB(8994,5076,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,5076,2,1,1,0)="^^10^10^3241108^"
