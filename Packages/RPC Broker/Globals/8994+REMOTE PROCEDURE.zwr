^XWB(8994,3269,1,1,0)="This RPC will add entries into file 19620.703 (DSIR SENSITIVE CLINIC) for "
^XWB(8994,3269,1,2,0)="use by the ROI Plus application when it identifies documents related to a "
^XWB(8994,3269,1,3,0)="clinic that the ROI department consider sensitive."
^XWB(8994,3269,2,0)="^8994.02A^1^1"
^XWB(8994,3269,2,1,0)="IEN^1^99^1^1"
^XWB(8994,3269,2,1,1,0)="^8994.021^1^1^3130613^^"
^XWB(8994,3269,2,1,1,1,0)="Internal Entry Number to HOSPITAL LOCATION File #44 - Required"
^XWB(8994,3269,2,"B","IEN",1)=""
^XWB(8994,3269,2,"PARAMSEQ",1,1)=""
^XWB(8994,3269,3,0)="^8994.03^4^4^3130621^^"
^XWB(8994,3269,3,1,0)="Return Values"
^XWB(8994,3269,3,2,0)="        IEN - Entry Added"
^XWB(8994,3269,3,3,0)="        0 ^ Entry already exists!"
^XWB(8994,3269,3,4,0)="        -1^Invalid HOSPITAL LOCATION!"
^XWB(8994,3270,0)="DSIRPARM LSTCLN LIST CLINICS^LSTCLN^DSIRPARM^4^R^^^1"
^XWB(8994,3270,1,0)="^8994.01^2^2^3130613^"
^XWB(8994,3270,1,1,0)="This RPC will return a list of all the clinics that the ROI department "
^XWB(8994,3270,1,2,0)="has flagged as sensitive for their disclosure purposes."
^XWB(8994,3270,3,0)="^8994.03^3^3^3130621^^"
^XWB(8994,3270,3,1,0)="Return Array"
^XWB(8994,3270,3,2,0)="        0 ^ No sensitive clinics identified!"
^XWB(8994,3270,3,3,0)="        IEN ^ NAME"
^XWB(8994,3271,0)="DSIRPARM LSTFAC LIST FACILITY^LSTFAC^DSIRPARM^4^R^^^1"
^XWB(8994,3271,1,0)="^^2^2^3130621^"
^XWB(8994,3271,1,1,0)="This RPC will return a list of facilities with defined parameter settings "
^XWB(8994,3271,1,2,0)="in the DSIR FACILITY PARAMETERS (#19620.701)."
^XWB(8994,3271,3,0)="^8994.03^3^3^3130621^^"
^XWB(8994,3271,3,1,0)="Return Array"
^XWB(8994,3271,3,2,0)="        0 ^ No facilities defined in parameter file!"
^XWB(8994,3271,3,3,0)="        IEN ^ NAME ^ DISPLAY NAME"
^XWB(8994,3272,0)="DVBA CAPRI EXAM XML^FILEIN^DVBAXML^1^S"
^XWB(8994,3272,1,0)="^8994.01^2^2^3130829^^^^"
^XWB(8994,3272,1,1,0)="This RPC allows for the filling of the 2507 EXAM template in the XML "
^XWB(8994,3272,1,2,0)="version."
