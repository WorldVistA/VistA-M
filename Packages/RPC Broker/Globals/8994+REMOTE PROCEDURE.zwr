^XWB(8994,4346,2,"PARAMSEQ",2,2)=""
^XWB(8994,4346,3,0)="^8994.03^19^19^3150731^^"
^XWB(8994,4346,3,1,0)="Output:"
^XWB(8994,4346,3,2,0)="  Error Messages:  ""-1^""_error message or ""0^""_warning message"
^XWB(8994,4346,3,3,0)="  Successful Completion:"
^XWB(8994,4346,3,4,0)="    A list of Appliance Transactions from file 660 that are related to "
^XWB(8994,4346,3,5,0)="    the requested Record of Pros Appliance/Repair (#660) by the AMIS"
^XWB(8994,4346,3,6,0)="    Grouper."
^XWB(8994,4346,3,7,0)="    "
^XWB(8994,4346,3,8,0)="    Format: For each 660 record (except Shipping) with the same"
^XWB(8994,4346,3,9,0)="            AMIS Grouper:"
^XWB(8994,4346,3,10,0)="      DSSORET(n)= ^-pc 1 HCPCS"
^XWB(8994,4346,3,11,0)="                   ^-pc 2 HCPCS short description"
^XWB(8994,4346,3,12,0)="                   ^-pc 3 Quantity"
^XWB(8994,4346,3,13,0)="                   ^-pc 4 Cost"
^XWB(8994,4346,3,14,0)="                   ^-pc 5 Prosthetic Billing Item Short Description"
^XWB(8994,4346,3,15,0)=" "
^XWB(8994,4346,3,16,0)="        An additional line is included at the end of the data:"
^XWB(8994,4346,3,17,0)="          DSSORET(n)=""TOTAL COST FOR TRANSACTION"" ^ $$$$$"
^XWB(8994,4346,3,18,0)="            where $$$$$ = total cost of all displayed appliance "
^XWB(8994,4346,3,19,0)="                          transactions"
^XWB(8994,4347,0)="DSSO LIST DISABILITY CODES^LISTDIS^DSSOPP^4^^^^1"
^XWB(8994,4347,1,0)="^8994.01^2^2^3150903^^"
