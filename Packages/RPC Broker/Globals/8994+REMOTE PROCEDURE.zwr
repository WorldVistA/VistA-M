^XWB(8994,3690,3,0)="^8994.03^31^31^3160622^^"
^XWB(8994,3690,3,1,0)="The RPC returns the output in a one dimensional array RESULT."
^XWB(8994,3690,3,2,0)="     RESULT(1)=""[Data]"""
^XWB(8994,3690,3,3,0)="     RESULT(2)=""70^ACUTE PSYCHIATRY (<45 DAYS)^ACUTE PSYCHIATRY (<45"
^XWB(8994,3690,3,4,0)="               DAYS)"""
^XWB(8994,3690,3,5,0)="     RESULT(3)=""72^ALCOHOL DEPENDENCE TRMT UNIT^ALCOHOL DEPENDENCE TRMT"
^XWB(8994,3690,3,6,0)="               UNIT"""
^XWB(8994,3690,3,7,0)="     RESULT(4)=""1^ALLERGY^ALLERGY"""
^XWB(8994,3690,3,8,0)="     RESULT(5)=""78^ANESTHESIOLOGY^ANESTHESIOLOGY"""
^XWB(8994,3690,3,9,0)="     RESULT(6)=""21^BLIND REHAB^BLIND REHAB"""
^XWB(8994,3690,3,10,0)="     RESULT(7)=""36^BLIND REHAB OBSERVATION^BLIND REHAB OBSERVATION"""
^XWB(8994,3690,3,11,0)="     RESULT(8)=""13^CARDIAC INTENSIVE CARE UNIT^CARDIAC INTENSIVE CARE"
