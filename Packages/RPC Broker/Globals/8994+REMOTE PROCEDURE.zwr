^XWB(8994,5013,0)="SDES2 GET VIDEO VISIT PROV^GETSPACEBARPRO^SDES2SPACEBAR^2^R^^^^^^1"
^XWB(8994,5013,1,0)="^^4^4^3250214^"
^XWB(8994,5013,1,1,0)="Gets the video visit provider from the ^TMP(DUZ,""SDECPROIEN"") that is "
^XWB(8994,5013,1,2,0)="stored from the GETPROINFO^SDESVVS TAG."
^XWB(8994,5013,1,3,0)=" "
^XWB(8994,5013,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,5013,2,0)="^8994.02A^1^1"
^XWB(8994,5013,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,5013,2,1,1,0)="^8994.021^10^10^3250214^^"
^XWB(8994,5013,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,5013,2,1,1,2,0)="              Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5013,2,1,1,3,0)="   SDCONTEXT(""PATIENT DFN"") = The DFN/IEN of the target patient from the"
^XWB(8994,5013,2,1,1,4,0)="              calling application."
^XWB(8994,5013,2,1,1,5,0)="   SDCONTEXT(""PATIENT ICN"") = The ICN of the target patient from the"
^XWB(8994,5013,2,1,1,6,0)="              calling application."
^XWB(8994,5013,2,1,1,7,0)="   SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action in the"
^XWB(8994,5013,2,1,1,8,0)="              calling application."
^XWB(8994,5013,2,1,1,9,0)="   SDCONTEXT(""USER SECID"") = The SECID of the user taking action in"
^XWB(8994,5013,2,1,1,10,0)="              the calling application."
^XWB(8994,5013,2,"B","SDCONTEXT",1)=""
^XWB(8994,5013,2,"PARAMSEQ",1,1)=""
^XWB(8994,5013,3,0)="^8994.03^13^13^3250214^^"
^XWB(8994,5013,3,1,0)="Returns the output as below."
^XWB(8994,5013,3,2,0)=" "
^XWB(8994,5013,3,3,0)="{"
^XWB(8994,5013,3,4,0)="  ""VVSProvider"": {"
^XWB(8994,5013,3,5,0)="    ""ProviderCell"": """","
^XWB(8994,5013,3,6,0)="    ""ProviderClass"": """","
^XWB(8994,5013,3,7,0)="    ""ProviderEmail"": ""david.dunnam@domain.ext"","
^XWB(8994,5013,3,8,0)="    ""ProviderIEN"": 520881845,"
^XWB(8994,5013,3,9,0)="    ""ProviderName"": ""DUNNAM,"
^XWB(8994,5013,3,10,0)="    DAVIDW"","
^XWB(8994,5013,3,11,0)="    ""ProviderTitle"": ""OI&TSTAFF"""
^XWB(8994,5013,3,12,0)="  }"
^XWB(8994,5013,3,13,0)="}"
^XWB(8994,5014,0)="SDES2 GET APPTS BY APPT IENS^APPTSBYIENLIST^SDES2GETAPPTRPCS^2^R^^^^^^1"
^XWB(8994,5014,1,0)="^^4^4^3250213^"
^XWB(8994,5014,1,1,0)="This RPC will take in a list of up to 50 appointment IENS values and "
^XWB(8994,5014,1,2,0)="returns an appointment object for each given appointment IEN."
^XWB(8994,5014,1,3,0)=" "
^XWB(8994,5014,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,5014,2,0)="^8994.02A^2^2"
^XWB(8994,5014,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,5014,2,1,1,0)="^^10^10^3240613^"
^XWB(8994,5014,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,5014,2,1,1,2,0)="                          Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5014,2,1,1,3,0)="SDCONTEXT(""USER DUZ"")   = The DUZ of the user taking action on the"
^XWB(8994,5014,2,1,1,4,0)="                          calling application. "
^XWB(8994,5014,2,1,1,5,0)="SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,5014,2,1,1,6,0)="                          calling application."
^XWB(8994,5014,2,1,1,7,0)="SDCONTEXT(""PATIENT DFN"")= The name of the patient taking action on the"
^XWB(8994,5014,2,1,1,8,0)="                          calling application."
^XWB(8994,5014,2,1,1,9,0)="SDCONTEXT(""PATIENT ICN"")= The ICN of the patient taking action on the"
^XWB(8994,5014,2,1,1,10,0)="                          calling application."
^XWB(8994,5014,2,2,0)="SDPARAM^2^32000^1^2"
^XWB(8994,5014,2,2,1,0)="^8994.021^2^2^3250213^^"
^XWB(8994,5014,2,2,1,1,0)="SDPARAM(""APPOINTMENT IEN"",ien)="""""
^XWB(8994,5014,2,2,1,2,0)="*where ien is the appointment ien"
^XWB(8994,5014,2,"B","SDCONTEXT",1)=""
^XWB(8994,5014,2,"B","SDPARAM",2)=""
^XWB(8994,5014,2,"PARAMSEQ",1,1)=""
^XWB(8994,5014,2,"PARAMSEQ",2,2)=""
^XWB(8994,5014,3,0)="^^360^360^3260211^"
