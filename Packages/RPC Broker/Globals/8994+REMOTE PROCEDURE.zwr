^XWB(8994,5177,3,0)="^^89^89^3241216^"
^XWB(8994,5177,3,1,0)="Example of successful retreival of patient orders and valid SA values."
^XWB(8994,5177,3,2,0)=" "
^XWB(8994,5177,3,3,0)="JSON elements:"
^XWB(8994,5177,3,4,0)=" "
^XWB(8994,5177,3,5,0)="""orders""           = section for 1 to many orders"
^XWB(8994,5177,3,6,0)=" ""orderId""           = unique order number in ORDERS file (#100)."
^XWB(8994,5177,3,7,0)=" ""specialAuthority""  = SA section for multiple SA indicators"
^XWB(8994,5177,3,8,0)="   ""code""     = 2-4 char internal letter code, e.g. AO Agent Orange"
^XWB(8994,5177,3,9,0)="   ""defalut""  = yes, no, unanswered, default prompt value"
^XWB(8994,5177,3,10,0)="   ""visible""  = true/false, should this SA appear to user for an answer"
^XWB(8994,5177,3,11,0)="  "
^XWB(8994,5177,3,12,0)="Example JSON msg:"
^XWB(8994,5177,3,13,0)=" "
