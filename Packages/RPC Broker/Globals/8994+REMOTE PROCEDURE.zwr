^XWB(8994,4722,2,0)="^8994.02A^3^3"
^XWB(8994,4722,2,1,0)="APPTLIST^2^^1^1"
^XWB(8994,4722,2,1,1,0)="^^9^9^3220829^"
^XWB(8994,4722,2,1,1,1,0)="A list of appointment IENs for which letters are to be printed. This RPC "
^XWB(8994,4722,2,1,1,2,0)="is intended to be used to print a list of letters for actions such as "
^XWB(8994,4722,2,1,1,3,0)="cancelling clinc availability, where multiple letters need to be printed "
^XWB(8994,4722,2,1,1,4,0)="at one time."
^XWB(8994,4722,2,1,1,5,0)=" "
^XWB(8994,4722,2,1,1,6,0)="Example:"
^XWB(8994,4722,2,1,1,7,0)="APPTLIST(12345)="""""
