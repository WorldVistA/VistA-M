^XWB(8994,3687,1,1,0)="HMP TIU LONG LIST OF NOTE TITLES"
^XWB(8994,3690,0)="VIAB BMS^EN^VIABMS^2^S^^^^^^1"
^XWB(8994,3690,1,0)="^8994.01^3^3^3160419^"
^XWB(8994,3690,1,1,0)="This RPC is in support of the Bed Management System (BMS). It reads the"
^XWB(8994,3690,1,2,0)="parameter ""Path"" and determines from it what data to return.  All BMS"
^XWB(8994,3690,1,3,0)="requests are handled by this RPC."
^XWB(8994,3690,2,0)="^8994.02A^2^1"
^XWB(8994,3690,2,1,0)="VIA^2^^1^1"
^XWB(8994,3690,2,1,1,0)="^8994.021^23^23^3160622^^"
^XWB(8994,3690,2,1,1,1,0)="The ""PATH"" parameter dictates what additional parameters should be passed"
^XWB(8994,3690,2,1,1,2,0)="in. Examples of input parameters passed to the RPC."
^XWB(8994,3690,2,1,1,3,0)="      VIA(""PATH"")=""GETPATIENT"""
^XWB(8994,3690,2,1,1,4,0)="      VIA(""IENS"")=""7173105,"""
^XWB(8994,3690,2,1,1,5,0)=" "
^XWB(8994,3690,2,1,1,6,0)="      VIA(""PATH"")=""LISTPATIENT"""
^XWB(8994,3690,2,1,1,7,0)="      VIA(""SDATE"")=3010524"
^XWB(8994,3690,2,1,1,8,0)="      VIA(""EDATE"")=3010524"
^XWB(8994,3690,2,1,1,9,0)=" "
^XWB(8994,3690,2,1,1,10,0)="      VIA(""PATH"")=""LISTADMITTEDPATIENTS"""
^XWB(8994,3690,2,1,1,11,0)="      VIA(""TO"")=192210"
^XWB(8994,3690,2,1,1,12,0)=" "
^XWB(8994,3690,2,1,1,13,0)="      VIA(""PATH"")=""LISTHOSPITALLOCATIONS"""
^XWB(8994,3690,2,1,1,14,0)=" "
^XWB(8994,3690,2,1,1,15,0)="      VIA(""PATH"")=""LISTPATIENTAPPOINTMENT"""
^XWB(8994,3690,2,1,1,16,0)="      VIA(""IENS"")="",7208163,"""
^XWB(8994,3690,2,1,1,17,0)="      VIA(""CLNIEN"")=1690"
^XWB(8994,3690,2,1,1,18,0)="      VIA(""SDATE"")=3101206"
^XWB(8994,3690,2,1,1,19,0)="      VIA(""EDATE"")=3110429.1101"
^XWB(8994,3690,2,1,1,20,0)=" "
^XWB(8994,3690,2,1,1,21,0)="      VIA(""PATH"")=""LISTROOMBED"""
^XWB(8994,3690,2,1,1,22,0)="      VIA(""FROM"")=100"
^XWB(8994,3690,2,1,1,23,0)="      VIA(""MAX"")=44"
^XWB(8994,3690,2,2,0)="LIST ATTRIBUTES^2^512^1"
