^XWB(8994,4595,0)="DSSO CHECK PCO CNCLD STATUS^CNCLCHK^DSSOUTA^1"
^XWB(8994,4595,1,0)="^8994.01^6^6^3200130^^"
^XWB(8994,4595,1,1,0)="This RPC checks the Supply Status (file 442 field .5) of the specified"
^XWB(8994,4595,1,2,0)="purchase card order number (simplified or detailed) to determine if a "
^XWB(8994,4595,1,3,0)="purchase card order with this purchase card order number has been"
^XWB(8994,4595,1,4,0)="cancelled.  If at least one purchase card order matching the requested"
^XWB(8994,4595,1,5,0)="purchase card order number is cancelled, the cancelled indicator is set"
^XWB(8994,4595,1,6,0)="to 1; otherwise, the cancelled indicator is set to zero."
^XWB(8994,4595,2,0)="^8994.02A^1^1"
^XWB(8994,4595,2,1,0)="DSSOPON^1^30^1^1"
^XWB(8994,4595,2,1,1,0)="^8994.021^3^3^3200130^^"
^XWB(8994,4595,2,1,1,1,0)="Full purchase card order number in the format site-PO# (i.e. -"
^XWB(8994,4595,2,1,1,2,0)="500-P90005) or the portion of the purchase card order number to the right"
^XWB(8994,4595,2,1,1,3,0)="of the dash (P90005) - REQUIRED"
^XWB(8994,4595,2,"B","DSSOPON",1)=""
^XWB(8994,4595,2,"PARAMSEQ",1,1)=""
^XWB(8994,4595,3,0)="^^8^8^3200130^"
^XWB(8994,4595,3,1,0)="DSSORET - Error Message:  ""-1^""_error message text"
^XWB(8994,4595,3,2,0)="          Successful Message:  "
^XWB(8994,4595,3,3,0)="            ^-piece 1: Cancelled Indicator=1 if cancelled"
^XWB(8994,4595,3,4,0)="                                          =0 if not cancelled"
^XWB(8994,4595,3,5,0)="                       (to be cancelled the external value"
^XWB(8994,4595,3,6,0)="                        of SUPPLY STATUS (#.5) in the "
^XWB(8994,4595,3,7,0)="                        PROCUREMENT & ACCOUNTING TRANSACTIONS"
^XWB(8994,4595,3,8,0)="                        file (#442) contains ""Cancelled"")"
^XWB(8994,4596,0)="DSSO PI RETRVE HCPCS ITM MSTR^LISTHIM^DSSOUP1^4^^^^1"
^XWB(8994,4596,1,0)="^^23^23^3150708^"
^XWB(8994,4596,1,1,0)="This RPC returns up to 2500 records from the list of HCPCS entries from "
^XWB(8994,4596,1,2,0)="the Prosthetics HCPCS Item Master file (#661.11)."
