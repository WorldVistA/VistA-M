^XWB(8994,4962,0)="SDES2 RESTORE CLIN AVAIL^RESTORE^SDES2RSTCAVAIL^2^R^^^^^^1"
^XWB(8994,4962,1,0)="^^6^6^3250214^"
^XWB(8994,4962,1,1,0)="This RPC will allow the restore of clinic availability.  If the day was a "
^XWB(8994,4962,1,2,0)="full day cancel, will restore full day.  If time periods (partial) day "
^XWB(8994,4962,1,3,0)="cancellation were cancelled, then the RPC will restore a partial day for "
^XWB(8994,4962,1,4,0)="the time period start time sent in."
^XWB(8994,4962,1,5,0)=" "
^XWB(8994,4962,1,6,0)="Can only be invoked by Acheron"
^XWB(8994,4962,2,0)="^8994.02A^2^2"
^XWB(8994,4962,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,4962,2,1,1,0)="^^10^10^3240617^"
^XWB(8994,4962,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,4962,2,1,1,2,0)="                          Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,4962,2,1,1,3,0)="SDCONTEXT(""USER DUZ"")   = The DUZ of the user taking action on the"
^XWB(8994,4962,2,1,1,4,0)="                          calling application. "
^XWB(8994,4962,2,1,1,5,0)="SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,4962,2,1,1,6,0)="                          calling application."
^XWB(8994,4962,2,1,1,7,0)="SDCONTEXT(""PATIENT DFN"")= The name of the patient taking action on the"
^XWB(8994,4962,2,1,1,8,0)="                          calling application."
^XWB(8994,4962,2,1,1,9,0)="SDCONTEXT(""PATIENT ICN"")= The ICN of the patient taking action on the"
^XWB(8994,4962,2,1,1,10,0)="                          calling application."
^XWB(8994,4962,2,2,0)="SRESTORE^2^32000^1^2"
^XWB(8994,4962,2,2,1,0)="^8994.021^12^12^3250214^^"
