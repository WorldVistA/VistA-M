^XWB(8994,4724,0)="TIU NEED TO SIGN?^NDTOSIGN^TIUSRVA^1^P"
^XWB(8994,4724,1,0)="^^1^1^3180817^"
^XWB(8994,4724,1,1,0)="DOES THE CURRENT USER NEED TO SIGN THIS DOCUMENT?"
^XWB(8994,4724,2,0)="^8994.02A^1^1"
^XWB(8994,4724,2,1,0)="TIUDA^1^^1^1"
^XWB(8994,4724,2,1,1,0)="^^1^1^3180817^"
^XWB(8994,4724,2,1,1,1,0)="THIS IS THE TIU DOCUMENT IEN."
