^XWB(8994,5145,2,1,1,8,0)="                               the calling application."
^XWB(8994,5145,2,1,1,9,0)="SDCONTEXT(""PATIENT ICN"")      = The ICN of the patient taking action on"
^XWB(8994,5145,2,1,1,10,0)="                               the calling application."
^XWB(8994,5145,2,2,0)="LETTER^2^32000^1^2"
