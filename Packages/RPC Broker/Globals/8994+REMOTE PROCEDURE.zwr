^XWB(8994,4594,0)="SDES DISPOSITION RECALL REQ^DISPRECALL^SDES^2^R^0^^0^^^1"
^XWB(8994,4594,1,0)="^^6^6^3250206^"
^XWB(8994,4594,1,1,0)="DISPOSITION and DELETE an entry from the RECALL REMINDERS file (403.5). "
^XWB(8994,4594,1,2,0)="During the deletion of the entry, the new-style xref in 403.5 will "
^XWB(8994,4594,1,3,0)="trigger the move of the data from 403.5 to the RECALL REMINDERS REMOVED "
^XWB(8994,4594,1,4,0)="file (403.56)."
^XWB(8994,4594,1,5,0)=" "
