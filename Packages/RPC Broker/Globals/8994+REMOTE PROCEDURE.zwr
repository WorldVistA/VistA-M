^XWB(8994,1445,2,1,1,1,0)="This is the list of name-value pairs that represent a report definition."
^XWB(8994,1445,2,"B","DEF",1)=""
^XWB(8994,1445,2,"PARAMSEQ",1,1)=""
^XWB(8994,1445,3,0)="^^1^1^3021114^"
