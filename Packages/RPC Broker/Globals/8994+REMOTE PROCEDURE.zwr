^XWB(8994,3890,1,1,0)="WOINIT"
^XWB(8994,3890,1,2,0)=" "
^XWB(8994,3890,1,3,0)="RPC to create a record for a new Work Order and set up fields depending "
^XWB(8994,3890,1,4,0)="on what kind of user is coming in."
^XWB(8994,3890,2,0)="^8994.02A^3^3"
^XWB(8994,3890,2,1,0)="TYPE^1^1^0^1"
^XWB(8994,3890,2,1,1,0)="^8994.021^3^3^3130401^^"
^XWB(8994,3890,2,1,1,1,0)="TYPE"
^XWB(8994,3890,2,1,1,2,0)=" "
^XWB(8994,3890,2,1,1,3,0)="Only used if coming from the Equipment screens - if so, TYPE=""Q"" "
^XWB(8994,3890,2,1,1,4,0)="        ""W"" = Ward User (user entering data from a Ward - minimal entry)"
^XWB(8994,3890,2,1,1,5,0)="        ""Q"" = Equipment Inventory (user coming from editing/adding a"
^XWB(8994,3890,2,1,1,6,0)="                        new piece of equipment in Equipment Inventory"
^XWB(8994,3890,2,1,1,7,0)="        ""E"" = Engineering Entry - Engineer entering/maintaining WO's"
^XWB(8994,3890,2,2,0)="SHOPKEY^1^2^0^2"
^XWB(8994,3890,2,2,1,0)="^^4^4^3130409^"
^XWB(8994,3890,2,2,1,1,0)="SHOPKEY"
^XWB(8994,3890,2,2,1,2,0)=" "
^XWB(8994,3890,2,2,1,3,0)="NO LONGER NEEDED"
^XWB(8994,3890,2,2,1,4,0)="The default shop key will be the receiving shop (default shop) for a VA. "
^XWB(8994,3890,2,2,1,5,0)="If TYPE=""W"" or ""Q"", the RPC will try to find a SHOPKEY, if not, one must "
^XWB(8994,3890,2,2,1,6,0)="be sent in"
^XWB(8994,3890,2,3,0)="EQIEN^1^11^0^3"
^XWB(8994,3890,2,3,1,0)="^^3^3^3120906^"
