^XWB(8994,4571,0)="DSIYDEX GETFD^GETFD^DSIYDEX^2^^^^1"
^XWB(8994,4571,1,0)="^8994.01^10^10^3190624^^^^"
^XWB(8994,4571,1,1,0)="DSIYDEX GETFD - Returns data array containing the fields for a specified "
^XWB(8994,4571,1,2,0)="data exchange.  The data exchange directs the process to a routine that "
^XWB(8994,4571,1,3,0)="fetches the data fields for a specified file and IEN (internal entry "
^XWB(8994,4571,1,4,0)="number)."
^XWB(8994,4571,1,5,0)=" "
^XWB(8994,4571,1,6,0)="The level of the requested data dictates if one or two IENs is required."
^XWB(8994,4571,1,7,0)=" "
^XWB(8994,4571,1,8,0)="Input (1) File Reference - the file # or the file name"
^XWB(8994,4571,1,9,0)="      (2) IEN1 - top level record in the file."
^XWB(8994,4571,1,10,0)="      (3) IEN2 - 2nd level, specific to a field multiple."
^XWB(8994,4571,2,0)="^8994.02A^4^4"
^XWB(8994,4571,2,1,0)="DSIYFREF^1^^1^1"
^XWB(8994,4571,2,1,1,0)="^8994.021^1^1^3190624^^^"
^XWB(8994,4571,2,1,1,1,0)="File Reference - the file # or the file name."
^XWB(8994,4571,2,2,0)="DSIYN1^1^16^1^2"
^XWB(8994,4571,2,2,1,0)="^8994.021^1^1^3190624^^^"
^XWB(8994,4571,2,2,1,1,0)="Pass the internal entry number top level record in the file."
^XWB(8994,4571,2,3,0)="DSIYN2^1^10^1^3"
^XWB(8994,4571,2,3,1,0)="^^2^2^3181127^"
^XWB(8994,4571,2,3,1,1,0)="Optional but null must be passed if not needed."
^XWB(8994,4571,2,3,1,2,0)="Pass the internal entry number for the 2nd level field multiple."
^XWB(8994,4571,2,4,0)="DSIY2^1^16^^3"
^XWB(8994,4571,2,4,1,0)="^^4^4^3190624^"
^XWB(8994,4571,2,4,1,1,0)="DSIY2 input for 2nd level, field multiple."
^XWB(8994,4571,2,4,1,2,0)=" "
^XWB(8994,4571,2,4,1,3,0)="FILE,IEN1,FLD#,IEN2"
^XWB(8994,4571,2,4,1,4,0)="     (3) IEN2 - 2nd level, specific to a field multiple."
^XWB(8994,4571,2,"B","DSIY2",4)=""
^XWB(8994,4571,2,"B","DSIYFREF",1)=""
^XWB(8994,4571,2,"B","DSIYN1",2)=""
^XWB(8994,4571,2,"B","DSIYN2",3)=""
^XWB(8994,4571,2,"PARAMSEQ",1,1)=""
^XWB(8994,4571,2,"PARAMSEQ",2,2)=""
^XWB(8994,4571,2,"PARAMSEQ",3,3)=""
^XWB(8994,4571,2,"PARAMSEQ",3,4)=""
^XWB(8994,4571,3,0)="^8994.03^5^5^3190624^^^^"
^XWB(8994,4571,3,1,0)="Returns array containing the field name and the current value."
^XWB(8994,4571,3,2,0)="arr(1)=""field-1 name^value"""
^XWB(8994,4571,3,3,0)="arr(2)=""field-1 name 'EXT'^value"""
^XWB(8994,4571,3,4,0)="arr(3)=""field-2 name^value"""
^XWB(8994,4571,3,5,0)="arr(4)=""field-2 'EXT' name^value"""
^XWB(8994,4572,0)="DSIYDEX SETFD^SETFD^DSIYDEX^1"
^XWB(8994,4572,1,0)="^8994.01^3^3^3190624^^^^"
^XWB(8994,4572,1,1,0)="DSIYDEX SETFD - files the field updates to a specified data exchange."
^XWB(8994,4572,1,2,0)="The data exchange points the process to the filing program associated "
^XWB(8994,4572,1,3,0)="with the file and fields for the data exchange."
^XWB(8994,4572,2,0)="^8994.02A^2^2"
^XWB(8994,4572,2,1,0)="DSIYFREF^1^32^1^1"
^XWB(8994,4572,2,1,1,0)="^^1^1^3181107^"
^XWB(8994,4572,2,1,1,1,0)="File Reference - the file # or the file name."
^XWB(8994,4572,2,2,0)="DSIYREC^2^120^1^2"
^XWB(8994,4572,2,2,1,0)="^8994.021^1^1^3190624^^^^"
^XWB(8994,4572,2,2,1,1,0)="Pass an array of fields in the format of field name ^ value."
^XWB(8994,4572,2,"B","DSIYFREF",1)=""
^XWB(8994,4572,2,"B","DSIYREC",2)=""
^XWB(8994,4572,2,"PARAMSEQ",1,1)=""
^XWB(8994,4572,2,"PARAMSEQ",2,2)=""
^XWB(8994,4572,3,0)="^^12^12^3190624^"
^XWB(8994,4572,3,1,0)="DSIYDEX SETFD - files the field updates to a specified data exchange."
^XWB(8994,4572,3,2,0)="The data array is passed to FlieMan for a precheck that may find "
^XWB(8994,4572,3,3,0)="issues with the input format or value of the data.  If this "
^XWB(8994,4572,3,4,0)="occurs the process will return a message from FileMan describing "
^XWB(8994,4572,3,5,0)="the field issue."
^XWB(8994,4572,3,6,0)=" "
^XWB(8994,4572,3,7,0)="If no issues are found the process will call Fileman to post the field "
^XWB(8994,4572,3,8,0)="updates. Again if there is an issue the process will return a message "
^XWB(8994,4572,3,9,0)="indicating the update wasn't successful.  "
^XWB(8994,4572,3,10,0)=" "
^XWB(8994,4572,3,11,0)="If no issues are found for pre-check or posting then a success message is "
^XWB(8994,4572,3,12,0)="passed back."
^XWB(8994,4573,0)="SDES SEARCH CLINIC^CLINICRSCSEARCH^SDES^2^R^^^^^^1"
