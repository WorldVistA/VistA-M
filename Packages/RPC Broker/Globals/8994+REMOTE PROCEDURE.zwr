^XWB(8994,3262,3,10,0)="      NAME)"
^XWB(8994,3263,0)="DSIRLTRS GETLTRS^GETLTRS^DSIRLTRS^4^^^^1"
^XWB(8994,3263,1,0)="^8994.01^3^3^3131212^^"
^XWB(8994,3263,1,1,0)="This RPC will return the letter definition from file 19610.16 (DSIR LOCAL "
