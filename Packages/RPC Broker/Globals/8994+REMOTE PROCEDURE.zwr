^XWB(8994,2233,3,3,0)="   OR ""-1^RECORD NOT FOUND"""
^XWB(8994,2233,3,4,0)="   OR ""-2^IEN CANNOT BE BLANK"" "
^XWB(8994,2234,0)="DSIR UPDATE FOIA OFFSETS^MANUFOIA^DSIROI8^1"
