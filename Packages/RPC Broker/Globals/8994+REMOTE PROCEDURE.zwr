^XWB(8994,4757,2,2,0)="DRUG IEN^1^^1^2"
^XWB(8994,4757,2,3,0)="DAYS SUPPLY^1^^1^3"
^XWB(8994,4757,2,4,0)="ORDERABLE ITEM IEN^1^^1^4"
