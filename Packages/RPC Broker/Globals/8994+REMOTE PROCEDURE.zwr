^XWB(8994,3386,3,3,0)="        RES(1) through Y(n)=""Error Message"""
^XWB(8994,3387,0)="XUS IAM FIND USER^IAMFU^XUESSO3^2^S^^^^1^^0"
^XWB(8994,3387,1,0)="^^9^9^3151209^"
^XWB(8994,3387,1,1,0)="RPC ICR #6288 - API ICR #none"
^XWB(8994,3387,1,2,0)="This restricted RPC is used exclusively by the Identity and Access "
^XWB(8994,3387,1,3,0)="Management (IAM) Provisioning application to find a list of users that "
^XWB(8994,3387,1,4,0)="satisfy a collection of input criteria."
^XWB(8994,3387,1,5,0)=" "
^XWB(8994,3387,1,6,0)="One or more of the input array values must be set by the calling "
^XWB(8994,3387,1,7,0)="application. The XUSHOWSSN Security Key is required to do lookups using "
^XWB(8994,3387,1,8,0)="Personally Identifiable Information (PII) such as Social Security Number "
^XWB(8994,3387,1,9,0)="(SSN) or Date of Birth (DOB)."
^XWB(8994,3387,2,0)="^8994.02A^6^6"
^XWB(8994,3387,2,1,0)="NAME^1^35^0^1"
^XWB(8994,3387,2,1,1,0)="^8994.021^1^1^3150128^^"
^XWB(8994,3387,2,1,1,1,0)="Search on user name."
^XWB(8994,3387,2,2,0)="SSN^1^9^^2"
^XWB(8994,3387,2,2,1,0)="^^2^2^3150210^"
^XWB(8994,3387,2,2,1,1,0)="Search on user Social Security Number (SSN). The user calling this RPC "
^XWB(8994,3387,2,2,1,2,0)="must hold the XUSHOWSSN Security Key to search using SSN."
^XWB(8994,3387,2,3,0)="DOB^1^15^^3"
^XWB(8994,3387,2,3,1,0)="^^2^2^3150210^"
^XWB(8994,3387,2,3,1,1,0)="Search on user Date of Birth (DOB). The user calling this RPC must hold"
^XWB(8994,3387,2,3,1,2,0)="the XUSHOWSSN Security Key to search using DOB."
^XWB(8994,3387,2,4,0)="ADUPN^1^50^^4"
^XWB(8994,3387,2,4,1,0)="^8994.021^1^1^3150206^^"
^XWB(8994,3387,2,4,1,1,0)="Search on user Active Directory UPN."
^XWB(8994,3387,2,5,0)="SECID^1^30^^5"
^XWB(8994,3387,2,5,1,0)="^8994.021^1^1^3150210^^^"
^XWB(8994,3387,2,5,1,1,0)="Search on user Security ID."
^XWB(8994,3387,2,6,0)="AUTHCODE^1^80^1^6"
^XWB(8994,3387,2,6,1,0)="^8994.021^1^1^3150729^^^"
