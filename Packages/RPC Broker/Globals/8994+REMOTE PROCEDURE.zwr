^XWB(8994,2526,3,6,0)="    2           End date for search"
^XWB(8994,2526,3,7,0)="    3           Maximum number of exams"
^XWB(8994,2527,0)="XDR ADD POTENTIAL PATIENT DUP^ADD^XDRDADDS^1^A^0^^1^1^1^0"
^XWB(8994,2527,1,0)="^8994.01^5^5^3080707^^"
^XWB(8994,2527,1,1,0)="Add a record to the VistA DUPLICATE RECORD file (#15), or find an existing"
^XWB(8994,2527,1,2,0)="record for the pair of potential duplicates passed to the RPC. This was"
^XWB(8994,2527,1,3,0)="written to allow MPI to add potential duplicate patients to the file, when"
^XWB(8994,2527,1,4,0)="potential duplicates are detected by the Person Service Identity"
^XWB(8994,2527,1,5,0)="Management (PSIM) probabilistic search."
^XWB(8994,2527,2,0)="^8994.02A^6^3"
^XWB(8994,2527,2,1,0)="FILE NUMBER^1^20^1^2"
^XWB(8994,2527,2,1,1,0)="^8994.021^3^3^3080707^^^^"
^XWB(8994,2527,2,1,1,1,0)="File number for the file to which the potential duplicate records belong. "
^XWB(8994,2527,2,1,1,2,0)="For example, if the two potential duplicate entries are on the PATIENT "
^XWB(8994,2527,2,1,1,3,0)="file, this value is set to 2."
^XWB(8994,2527,2,5,0)="TO_IEN^1^14^1^4"
^XWB(8994,2527,2,5,1,0)="^8994.021^2^2^3080707^^"
^XWB(8994,2527,2,5,1,1,0)="Internal Entry Number (IEN) of one of the potential duplicate records. "
^XWB(8994,2527,2,5,1,2,0)="For example, this could be a DFN from the PATIENT file (file #2)."
^XWB(8994,2527,2,6,0)="FROM_IEN^1^14^1^3"
^XWB(8994,2527,2,6,1,0)="^8994.021^2^2^3080707^^"
^XWB(8994,2527,2,6,1,1,0)="Internal Entry Number (IEN) of one of the potential duplicate records. "
^XWB(8994,2527,2,6,1,2,0)="For example, this could be a DFN from the PATIENT file (file #2)."
^XWB(8994,2527,2,"B","FILE NUMBER",1)=""
^XWB(8994,2527,2,"B","FROM_IEN",6)=""
^XWB(8994,2527,2,"B","TO_IEN",5)=""
^XWB(8994,2527,2,"PARAMSEQ",2,1)=""
^XWB(8994,2527,2,"PARAMSEQ",3,6)=""
^XWB(8994,2527,2,"PARAMSEQ",4,5)=""
^XWB(8994,2527,3,0)="^8994.03^4^4^3080707^^"
^XWB(8994,2527,3,1,0)="RETURN =IEN from file 15 DUPLICATE RECORD FILE# - If no errors occur, and "
^XWB(8994,2527,3,2,0)="if either an existing record is found, or a new record is added."
^XWB(8994,2527,3,3,0)="  "
^XWB(8994,2527,3,4,0)="RETURN = -1^Error Message - if any errors occur"
^XWB(8994,2528,0)="XDR UPD SUPPR EMAIL^EN^XDRDEFLG^1^A^0^^1^1^^0"
^XWB(8994,2528,1,0)="^^9^9^3080919^"
^XWB(8994,2528,1,1,0)="Used to remotely set the field SUPPRESS NEW DUP EMAIL (#99) on the"
^XWB(8994,2528,1,2,0)="DUPLICATE RESOLUTION file (#15.1)."
^XWB(8994,2528,1,3,0)=" "
^XWB(8994,2528,1,4,0)="SUPPRESS NEW DUP EMAIL is set to 1 (Yes) to suppress the email that is"
^XWB(8994,2528,1,5,0)="normally sent when a new record is added to the DUPLICATE RECORD file by"
^XWB(8994,2528,1,6,0)="PSIM (i.e., by a call from routine XDRDADDS)"
^XWB(8994,2528,1,7,0)=" "
^XWB(8994,2528,1,8,0)="If SUPPRESS NEW DUP EMAIL is set to 0 (No) or null, the email will be "
^XWB(8994,2528,1,9,0)="sent."
^XWB(8994,2528,2,0)="^8994.02A^2^2"
^XWB(8994,2528,2,1,0)="FILE NUMBER^1^20^1^2"
^XWB(8994,2528,2,1,1,0)="^8994.021^3^3^3080919^^^"
^XWB(8994,2528,2,1,1,1,0)="File number for the file that is the .01 field of a record in the "
^XWB(8994,2528,2,1,1,2,0)="DUPLICATE RESOLUTION file. This is the record that is to be updated by "
^XWB(8994,2528,2,1,1,3,0)="this RPC."
^XWB(8994,2528,2,2,0)="VALUE^1^1^1^3"
^XWB(8994,2528,2,2,1,0)="^^2^2^3080919^"
^XWB(8994,2528,2,2,1,1,0)="Must be set to 1 or 0. This value will be put into the SUPPRESS NEW DUP "
^XWB(8994,2528,2,2,1,2,0)="EMAIL field."
^XWB(8994,2528,2,"B","FILE NUMBER",1)=""
^XWB(8994,2528,2,"B","VALUE",2)=""
^XWB(8994,2528,2,"PARAMSEQ",2,1)=""
^XWB(8994,2528,2,"PARAMSEQ",3,2)=""
^XWB(8994,2528,3,0)="^8994.03^3^3^3080919^^^"
^XWB(8994,2528,3,1,0)="RETURN=0  -  if no errors occurred."
^XWB(8994,2528,3,2,0)=" "
^XWB(8994,2528,3,3,0)="RETURN=-1^Error Message  -  if errors occurred"
^XWB(8994,2529,0)="MPIF DNL ADD UPD^DNLADD^MPIRPC^2^R^0^^^1^^1"
^XWB(8994,2529,1,0)="^8994.01^2^2^3080429^^^^"
^XWB(8994,2529,1,1,0)="This RPC has been established to allow the remote creation of records "
^XWB(8994,2529,1,2,0)="into the MPI DO NOT LINK (#985.26) file."
^XWB(8994,2529,2,0)="^8994.02A^12^6"
^XWB(8994,2529,2,1,0)="SOURCEID^1^50^1^1"
^XWB(8994,2529,2,1,1,0)="^8994.021^4^4^3080428^^^"
^XWB(8994,2529,2,1,1,1,0)="The field is the ID of the record you want to add to the DO NOT LINK list."
^XWB(8994,2529,2,1,1,2,0)="The field format will be the fully qualified SourceID:"
^XWB(8994,2529,2,1,1,3,0)="  SourceID~AssigningLocation~AssigningAuthority~SourceType"
^XWB(8994,2529,2,1,1,4,0)=" For example: 123~500~USVHA~PI"
^XWB(8994,2529,2,2,0)="DNLSOURCEID^1^50^1^2"
^XWB(8994,2529,2,2,1,0)="^^5^5^3080428^"
^XWB(8994,2529,2,2,1,1,0)="The field contains the corresponding ID of the record you want to add to"
^XWB(8994,2529,2,2,1,2,0)="the DO NOT LINK list.  The field format will be the fully qualified"
^XWB(8994,2529,2,2,1,3,0)="SourceID:"
^XWB(8994,2529,2,2,1,4,0)=" SourceID~AssigningLocation~AssigningAuthority~SourceType"
^XWB(8994,2529,2,2,1,5,0)="  For example: 123~500~USVHA~PI"
^XWB(8994,2529,2,3,0)="DNLIDENTIFIEDBY^1^60^1^5"
^XWB(8994,2529,2,3,1,0)="^^1^1^3080428^"
^XWB(8994,2529,2,3,1,1,0)="This is the person that identified the DO NOT LINK record."
^XWB(8994,2529,2,4,0)="DNLEVENT^1^30^1^3"
^XWB(8994,2529,2,4,1,0)="^^3^3^3080428^"
^XWB(8994,2529,2,4,1,1,0)="This is the event that triggered this entry to get created.  The events "
^XWB(8994,2529,2,4,1,2,0)="are MPI Resolve Mismatch, User input, TOOLKIT Resolve Duplicate, and"
^XWB(8994,2529,2,4,1,3,0)="KERNEL VERIFIED NOT A DUPLICATE."
^XWB(8994,2529,2,5,0)="DNLSOURCEID^1^50^1^2"
^XWB(8994,2529,2,5,1,0)="^8994.021^5^5^3080428^^"
^XWB(8994,2529,2,5,1,1,0)="The field contains the corresponding ID of the record you want to add to"
^XWB(8994,2529,2,5,1,2,0)="the DO NOT LINK list.  The field format will be the fully qualified"
^XWB(8994,2529,2,5,1,3,0)="SourceID:"
^XWB(8994,2529,2,5,1,4,0)="SourceID~AssigningLocation~AssigningAuthority~SourceType"
^XWB(8994,2529,2,5,1,5,0)=" For example: 123~500~USVHA~PI"
^XWB(8994,2529,2,6,0)="INACT^1^1^^6"
^XWB(8994,2529,2,6,1,0)="^8994.021^3^3^3081003^^"
^XWB(8994,2529,2,6,1,1,0)="This field will be used to pass whether the user/application wants the "
^XWB(8994,2529,2,6,1,2,0)="pair to be inactivated.  If you want the pair to be inactivated pass a Y"
^XWB(8994,2529,2,6,1,3,0)="for yes, otherwise leave blank."
^XWB(8994,2529,2,9,0)="DNLIDENTIFIEDBY^1^60^1^5"
^XWB(8994,2529,2,9,1,0)="^8994.021^1^1^3080428^^"
^XWB(8994,2529,2,9,1,1,0)="This is the person that identified the DO NOT LINK record."
^XWB(8994,2529,2,10,0)="DNLEVENT^1^30^1^3"
^XWB(8994,2529,2,10,1,0)="^8994.021^3^3^3080428^^"
^XWB(8994,2529,2,10,1,1,0)="This is the event that triggered this entry to get created.  The events "
^XWB(8994,2529,2,10,1,2,0)="are MPI Resolve Mismatch, User input, TOOLKIT Resolve Duplicate, "
^XWB(8994,2529,2,10,1,3,0)="and KERNEL VERIFIED NOT A DUPLICATE."
^XWB(8994,2529,2,11,0)="DNLIDENTIFYINGLOCATION^1^5^1^4"
^XWB(8994,2529,2,11,1,0)="^8994.021^2^2^3080428^^^"
^XWB(8994,2529,2,11,1,1,0)="This field contains the station# of the person that identified/triggered "
^XWB(8994,2529,2,11,1,2,0)="the DO NOT LINK request to be added."
^XWB(8994,2529,2,12,0)="INACT^1^1^^6"
^XWB(8994,2529,2,12,1,0)="^8994.021^3^3^3080429^^^^"
^XWB(8994,2529,2,12,1,1,0)="This field will be used to pass whether the user/application wants the pair"
^XWB(8994,2529,2,12,1,2,0)="to be inactivated.  If you want the pair to be inactivated pass a Y for"
^XWB(8994,2529,2,12,1,3,0)="yes, otherwise leave blank."
