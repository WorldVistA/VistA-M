^XWB(8994,5051,2,0)="^8994.02A^2^2"
^XWB(8994,5051,2,1,0)="D0^1^30^1^1"
^XWB(8994,5051,2,1,1,0)="^8994.021^3^3^3221221^^"
^XWB(8994,5051,2,1,1,1,0)=" The value of this parameter is a pointer to ^MAG(2005)."
^XWB(8994,5051,2,1,1,2,0)=" This pointer identifies the image for which information"
^XWB(8994,5051,2,1,1,3,0)=" is being requested."
^XWB(8994,5051,2,2,0)="ERROR MESSAGE^1^80^1^5"
^XWB(8994,5051,2,2,1,0)="^^1^1^3221228^"
^XWB(8994,5051,2,2,1,1,0)="This is the error message if the cleanup failed"
^XWB(8994,5051,2,"B","D0",1)=""
^XWB(8994,5051,2,"B","ERROR MESSAGE",2)=""
^XWB(8994,5051,2,"PARAMSEQ",1,1)=""
^XWB(8994,5051,2,"PARAMSEQ",5,2)=""
^XWB(8994,5051,3,0)="^^8^8^3221221^"
^XWB(8994,5051,3,1,0)=" When an error occurs during the processing of this RPC,"
^XWB(8994,5051,3,2,0)=" the output array consists only one element:"
^XWB(8994,5051,3,3,0)="     OUT(1) = -1,Invalid IEN (xxx)"
^XWB(8994,5051,3,4,0)="     OUT(1) = -3,Image #nnn has been deleted."
^XWB(8994,5051,3,5,0)="     OUT(1) = -2,No data for ""nnn""."
^XWB(8994,5051,3,6,0)=" Otherwise, each element of the output array contains"
^XWB(8994,5051,3,7,0)=" three or more caret-separated pieces of data:"
^XWB(8994,5051,3,8,0)="     OUT(i) = field-name ^ data (internal) [ ^ data (external) ]"
