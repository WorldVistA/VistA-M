^XWB(8994,3926,1,11,0)="  p5:  CMR Name"
^XWB(8994,3926,1,12,0)="  p6:  Request Date"
^XWB(8994,3926,1,13,0)="  p7:  Requestor"
^XWB(8994,3926,1,14,0)="  p8:  Warehouse Assignee"
^XWB(8994,3926,2,0)="^8994.02A^3^3"
^XWB(8994,3926,2,1,0)="SCHBY^1^2^1^1"
^XWB(8994,3926,2,1,1,0)="^8994.021^13^13^3130502^^"
