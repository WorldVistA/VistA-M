^XWB(8994,3950,2,"PARAMSEQ",2,2)=""
^XWB(8994,3950,2,"PARAMSEQ",3,3)=""
^XWB(8994,3950,3,0)="^8994.03^6^6^3130205^^"
^XWB(8994,3950,3,1,0)="RETURN PARAMETER"
^XWB(8994,3950,3,2,0)=" "
