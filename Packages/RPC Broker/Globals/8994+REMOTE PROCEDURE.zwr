^XWB(8994,3711,2,"PARAMSEQ",4,8)=""
^XWB(8994,3711,2,"PARAMSEQ",5,7)=""
^XWB(8994,3711,2,"PARAMSEQ",6,2)=""
^XWB(8994,3711,2,"PARAMSEQ",7,3)=""
^XWB(8994,3711,2,"PARAMSEQ",8,6)=""
^XWB(8994,3711,2,"PARAMSEQ",9,9)=""
^XWB(8994,3711,2,"PARAMSEQ",10,10)=""
^XWB(8994,3711,3,0)="^^2^2^3161103^"
^XWB(8994,3711,3,1,0)="Returns a single entry in the global array indicating whether the record "
^XWB(8994,3711,3,2,0)="was updated or whether there was an error."
^XWB(8994,3712,0)="SDECRMGP GETRMGUP^GETRMGUP^SDECRMGP^1^R^0^^0"
^XWB(8994,3712,1,0)="^8994.01^2^2^3161129^^"
^XWB(8994,3712,1,1,0)="Returns the values set for the user preference of the Request Manager "
^XWB(8994,3712,1,2,0)="Grid Filter, Column Order, and Sort Order."
^XWB(8994,3712,2,0)="^8994.02A^1^1"
^XWB(8994,3712,2,1,0)="SDECUSER^1^^^1"
^XWB(8994,3712,2,1,1,0)="^^1^1^3161129^"
^XWB(8994,3712,2,1,1,1,0)="The user's internal IEN.  If not passed in the system will default to DUZ."
^XWB(8994,3712,2,"B","SDECUSER",1)=""
^XWB(8994,3712,2,"PARAMSEQ",1,1)=""
^XWB(8994,3712,3,0)="^^2^2^3161129^"
^XWB(8994,3712,3,1,0)="Returns a single delimited entry with the Request Manager Grid Filter, "
^XWB(8994,3712,3,2,0)="Column Order, and Sort Order user's preferences."
^XWB(8994,3713,0)="SDECRMGP PUTRMGUP^PUTRMGUP^SDECRMGP^4^R^0^^0"
^XWB(8994,3713,1,0)="^8994.01^2^2^3161129^^^^"
^XWB(8994,3713,1,1,0)="Store the user's preferences for the Request Manager Grid Filter, Column "
^XWB(8994,3713,1,2,0)="Order, and Sort Order."
^XWB(8994,3713,2,0)="^8994.02A^2^2"
^XWB(8994,3713,2,1,0)="SDECUSER^1^^^1"
^XWB(8994,3713,2,1,1,0)="^^1^1^3161129^"
