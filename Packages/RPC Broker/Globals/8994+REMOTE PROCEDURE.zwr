^XWB(8994,4408,3,2,0)="as derived from the copied text (example "".5"")"
^XWB(8994,4408,3,3,0)="         Or"
^XWB(8994,4408,3,4,0)="Error condition ""-1^Error Msg"""
^XWB(8994,4409,0)="ORWTIU WRDCOPY^WRDCOPY^ORWTIU^1"
^XWB(8994,4409,1,0)="^8994.01^2^2^3120419^"
