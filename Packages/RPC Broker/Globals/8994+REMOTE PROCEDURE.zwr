^XWB(8994,3390,2,"PARAMSEQ",2,2)=""
^XWB(8994,3390,2,"PARAMSEQ",3,3)=""
^XWB(8994,3390,3,0)="^8994.03^2^2^3151203^^^"
^XWB(8994,3390,3,1,0)="Return: Fail    Y = ""-1^Error Message"""
^XWB(8994,3390,3,2,0)="        Success Y = DUZ"
^XWB(8994,3391,0)="MPI TK POC USER SETUP^TKPOC^MPIRPC12^1^P^0^^^1"
^XWB(8994,3391,1,0)="^8994.01^3^3^3141216^^^^"
^XWB(8994,3391,1,1,0)="This remote procedure call (RPC) is invoked when a VistA user uses the "
^XWB(8994,3391,1,2,0)="option MPIF TK POC USER SETUP to confirm their traits and establish a TK "
^XWB(8994,3391,1,3,0)="POC record on the MPI in the New Person file (#200)."
^XWB(8994,3391,2,0)="^8994.02A^1^1"
^XWB(8994,3391,2,1,0)="USER^1^250^1^1"
^XWB(8994,3391,2,1,1,0)="^^1^1^3141216^"
^XWB(8994,3391,2,1,1,1,0)="NAME_""~""_SSN_""~""_NTNAME_""~""_PHONE"
^XWB(8994,3391,2,"B","USER",1)=""
^XWB(8994,3391,2,"PARAMSEQ",1,1)=""
^XWB(8994,3391,3,0)="^8994.03^1^1^3141216^^^^"
^XWB(8994,3391,3,1,0)="1 for successful creation  or  -1^error message"
^XWB(8994,3392,0)="DSIRRPT6 RQSTRS REPORT^RQSTRS^DSIRRPT6^4^^^^1"
^XWB(8994,3392,1,0)="^8994.01^4^4^3150429^^^"
^XWB(8994,3392,1,1,0)="This RPC will return entries from the DSIR NEW REQUESTORS file "
^XWB(8994,3392,1,2,0)="(#19620.12) in alphabetical order.  The report can be pulled for all "
^XWB(8994,3392,1,3,0)="requestors or in an alphabetic range, and further sorted by those flagged "
^XWB(8994,3392,1,4,0)="as Active, Inactive or Both."
^XWB(8994,3392,2,0)="^8994.02A^5^5"
^XWB(8994,3392,2,1,0)="INACT^1^1^0^1"
^XWB(8994,3392,2,1,1,0)="^^2^2^3150422^"
^XWB(8994,3392,2,1,1,1,0)="Inactive/Active Flag (Optional - A = Active Only, I = Inactive Only, B = "
^XWB(8994,3392,2,1,1,2,0)="Both) [Default - B]"
^XWB(8994,3392,2,2,0)="FRNM^1^30^0^2"
^XWB(8994,3392,2,2,1,0)="^8994.021^2^2^3150422^^"
^XWB(8994,3392,2,2,1,1,0)="From Name (Optional - Starting name or partial name, if null all names "
^XWB(8994,3392,2,2,1,2,0)="pulled)"
^XWB(8994,3392,2,3,0)="TONM^1^30^0^3"
^XWB(8994,3392,2,3,1,0)="^^2^2^3150422^"
^XWB(8994,3392,2,3,1,1,0)="To Name (Optional - Ending name or partial name, only valid if starting "
^XWB(8994,3392,2,3,1,2,0)="name passed)"
^XWB(8994,3392,2,4,0)="SCHED^1^1^0^4"
^XWB(8994,3392,2,4,1,0)="^^2^2^3150429^"
^XWB(8994,3392,2,4,1,1,0)="This is a flag to indicate if the report should be scheduled in TaskMan "
^XWB(8994,3392,2,4,1,2,0)="or not.  1 = Yes, 0 = No, Default is 0."
^XWB(8994,3392,2,5,0)="ESTART^1^14^0^5"
^XWB(8994,3392,2,5,1,0)="^8994.021^2^2^3150429^^"
^XWB(8994,3392,2,5,1,1,0)="This is the FileMan format date/time to start the task. If blank the task "
^XWB(8994,3392,2,5,1,2,0)="will run immediately."
^XWB(8994,3392,2,"B","ESTART",5)=""
^XWB(8994,3392,2,"B","FRNM",2)=""
^XWB(8994,3392,2,"B","INACT",1)=""
^XWB(8994,3392,2,"B","SCHED",4)=""
^XWB(8994,3392,2,"B","TONM",3)=""
