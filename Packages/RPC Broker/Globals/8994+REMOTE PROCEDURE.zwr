^XWB(8994,4770,2,2,1,0)="^^6^6^3221011^"
^XWB(8994,4770,2,2,1,1,0)="The integer code indicating the context of the query, as:"
^XWB(8994,4770,2,2,1,2,0)="1 = All Signed (by PT)"
^XWB(8994,4770,2,2,1,3,0)="2 = Unsigned (by PT&(AUTHOR!TRANSRIBER)"
^XWB(8994,4770,2,2,1,4,0)="3 = Uncosigned (by PT&EXPECTED COSIGNER)"
^XWB(8994,4770,2,2,1,5,0)="4 = Signed notes (by PT&selected author)"
^XWB(8994,4770,2,2,1,6,0)="5 = Signed notes (by PT&date range)"
^XWB(8994,4770,2,3,0)="DFN^1^32000^1^3"
^XWB(8994,4770,2,3,1,0)="^^1^1^3221011^"
^XWB(8994,4770,2,3,1,1,0)="The IEN or pointer to Patient File #2"
^XWB(8994,4770,2,4,0)="BEGINDATE^1^25^0^4"
^XWB(8994,4770,2,4,1,0)="^^1^1^3221011^"
^XWB(8994,4770,2,4,1,1,0)="The beginning date/time in ISO 8601 Time Format to start for the search."
