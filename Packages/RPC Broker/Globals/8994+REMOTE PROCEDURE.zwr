^XWB(8994,4620,0)="DSSO PRINT RFQ/10-90^PRINT^DSSOFOPR^4^^^^1"
^XWB(8994,4620,1,0)="^8994.01^2^2^3190705^^^"
^XWB(8994,4620,1,1,0)="This RPC returns data for viewing/printing the ADP FL 10-90 Request for "
^XWB(8994,4620,1,2,0)="Quote letter."
^XWB(8994,4620,2,0)="^8994.02A^2^2"
^XWB(8994,4620,2,1,0)="DSSO6654^1^15^1^1"
^XWB(8994,4620,2,1,1,0)="^^1^1^3190705^"
^XWB(8994,4620,2,1,1,1,0)="IEN of the PROS LETTER TRANSACTIONS (#665.4) file to be printed"
^XWB(8994,4620,2,2,0)="DSSO6699^1^15^1^2"
^XWB(8994,4620,2,2,1,0)="^8994.021^1^1^3190705^^^"
^XWB(8994,4620,2,2,1,1,0)="IEN of PROSTHETICS SITE PARAMETERS (#669.9) file"
^XWB(8994,4620,2,"B","DSSO6654",1)=""
