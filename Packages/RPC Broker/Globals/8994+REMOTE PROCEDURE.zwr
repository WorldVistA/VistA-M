^XWB(8994,4556,2,1,1,0)="^^1^1^3210820^"
^XWB(8994,4556,2,1,1,1,0)="IEN associated with the appointment request"
^XWB(8994,4556,2,2,0)="DISP^1^30^1^2"
^XWB(8994,4556,2,2,1,0)="^^14^14^3220425^"
^XWB(8994,4556,2,2,1,1,0)="Disposition reason associated with the closing of the appointment "
^XWB(8994,4556,2,2,1,2,0)="request.  Enter one of the following reasons:"
^XWB(8994,4556,2,2,1,3,0)="   CHANGED CLINIC   "
^XWB(8994,4556,2,2,1,4,0)="   DEATH   "
^XWB(8994,4556,2,2,1,5,0)="   ENTERED IN ERROR   "
^XWB(8994,4556,2,2,1,6,0)="   FAILURE TO RESPOND   "
^XWB(8994,4556,2,2,1,7,0)="   MRTC PARENT CLOSED   "
^XWB(8994,4556,2,2,1,8,0)="   REMOVED/EXTERNAL APP   "
^XWB(8994,4556,2,2,1,9,0)="   REMOVED/NO LONGER NECESSARY   "
^XWB(8994,4556,2,2,1,10,0)="   REMOVED/NON-VA CARE   "
^XWB(8994,4556,2,2,1,11,0)="   REMOVED/SCHEDULED-ASSIGNED   "
^XWB(8994,4556,2,2,1,12,0)="   REMOVED/VA CONTRACT CARE   "
^XWB(8994,4556,2,2,1,13,0)="   TRANSFERRED TO EWL"
^XWB(8994,4556,2,2,1,14,0)="   VET SELF-CANCEL"
^XWB(8994,4556,2,3,0)="DISPBY^1^30^1^3"
^XWB(8994,4556,2,3,1,0)="^^1^1^3231019^"
^XWB(8994,4556,2,3,1,1,0)="User IEN that is dispositioning the request"
^XWB(8994,4556,2,4,0)="DISPDT^1^30^1^4"
^XWB(8994,4556,2,4,1,0)="^^1^1^3220221^"
^XWB(8994,4556,2,4,1,1,0)="The date of disposition in external format (e.g.,CCYY-MM-DD)"
^XWB(8994,4556,2,6,0)="EASTRCKNGNMBR^1^40^0^5"
^XWB(8994,4556,2,6,1,0)="^^2^2^3220112^"
