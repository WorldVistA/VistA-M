^XWB(8994,925,2,1,1,0)="^^7^7^3180305^"
^XWB(8994,925,2,1,1,1,0)="Input variable ECARY has the following pieces of data separated by"
^XWB(8994,925,2,1,1,2,0)="up-arrows."
^XWB(8994,925,2,1,1,3,0)=" "
^XWB(8994,925,2,1,1,4,0)="  1. ECDFN - Patient IEN (#200)"
^XWB(8994,925,2,1,1,5,0)="  2. ECDT  - Procedure date and time (fileman format)"
^XWB(8994,925,2,1,1,6,0)="  3. ECL   - Location IEN"
^XWB(8994,925,2,1,1,7,0)="  4. EC4   - Clinic IEN"
^XWB(8994,925,2,"B","ECARY",1)=""
