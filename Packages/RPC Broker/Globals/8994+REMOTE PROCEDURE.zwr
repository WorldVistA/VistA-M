^XWB(8994,3111,1,2,0)="upon a fixed scalar value for one or more of its attributes."
^XWB(8994,3111,2,0)="^8994.02A^1^1"
^XWB(8994,3111,2,1,0)="PROCATTS^2^300^1^1"
^XWB(8994,3111,2,1,1,0)="^^9^9^3100805^"
^XWB(8994,3111,2,1,1,1,0)="Input parameters are name-value pairs sent as successive integer"
^XWB(8994,3111,2,1,1,2,0)="subscripts in an array that should be passed in by reference as the second"
^XWB(8994,3111,2,1,1,3,0)="argument to entry point FINDPROC^MAGVRS07.  The first argument should be"
^XWB(8994,3111,2,1,1,4,0)="an array name (passed by reference) that will contain the returned value."
^XWB(8994,3111,2,1,1,5,0)=" "
^XWB(8994,3111,2,1,1,6,0)="The values passed in should be in the format <fname>`<value>, where"
^XWB(8994,3111,2,1,1,7,0)="<fname> is a field name in the IMAGING PROCEDURE REFERENCE File"
^XWB(8994,3111,2,1,1,8,0)="(#2005.61) and <value> is the value to which the record's attribute"
^XWB(8994,3111,2,1,1,9,0)="should be equal.  If multiple values are passed in, they will be ANDed."
^XWB(8994,3111,2,"B","PROCATTS",1)=""
^XWB(8994,3111,2,"PARAMSEQ",1,1)=""
^XWB(8994,3111,3,0)="^8994.03^7^7^3100417^^^"
^XWB(8994,3111,3,1,0)="The first and only element of the return array will be structured as "
^XWB(8994,3111,3,2,0)="follows, delimited by ` (backtick):"
^XWB(8994,3111,3,3,0)=" "
^XWB(8994,3111,3,4,0)="P1  0 if no error, nonzero if error"
^XWB(8994,3111,3,5,0)="P2  Empty if no error, text if error"
^XWB(8994,3111,3,6,0)="P3  Internal entry number of procedure on the IMAGING PROCEDURE File "
^XWB(8994,3111,3,7,0)="(#2005.61) if no error"
^XWB(8994,3112,0)="MAGV FIND SERIES BY REFERENCE^FINDBYRF^MAGVRS14^2^R"
^XWB(8994,3112,1,0)="^8994.01^1^1^3100826^^"
^XWB(8994,3112,1,1,0)="This RPC looks up series by Reference UID."
^XWB(8994,3112,2,0)="^8994.02A^1^1"
^XWB(8994,3112,2,1,0)="REFUID^1^^^1"
^XWB(8994,3112,2,1,1,0)="^8994.021^1^1^3100826^^"
^XWB(8994,3112,2,1,1,1,0)="The REFERENCE UID used to look up series."
^XWB(8994,3112,2,"B","REFUID",1)=""
^XWB(8994,3112,2,"PARAMSEQ",1,1)=""
^XWB(8994,3112,3,0)="^8994.03^1^1^3100826^^"
^XWB(8994,3112,3,1,0)="Returns an array of series IENs or an error message."
^XWB(8994,3113,0)="MAGV FIND SERIES BY UID^FINDSER^MAGVRS11^1^R"
^XWB(8994,3113,1,0)="^8994.01^1^1^3100826^^"
^XWB(8994,3113,1,1,0)="This RPC looks up series by series UID."
^XWB(8994,3113,2,0)="^8994.02A^1^1"
^XWB(8994,3113,2,1,0)="SERUID^1"
^XWB(8994,3113,2,1,1,0)="^8994.021^1^1^3100826^^"
^XWB(8994,3113,2,1,1,1,0)="The SERIES UID used to look up the series."
^XWB(8994,3113,2,"B","SERUID",1)=""
^XWB(8994,3113,3,0)="^8994.03^1^1^3100826^^"
^XWB(8994,3113,3,1,0)="Returns a single series IEN or an error message."
^XWB(8994,3114,0)="MAGV FIND SOP BY UID^FINDSOP^MAGVRS21^1^R"
^XWB(8994,3114,1,0)="^^1^1^3100805^"
^XWB(8994,3114,1,1,0)="This RPC looks up SOPs by SOP UID."
^XWB(8994,3114,2,0)="^8994.02A^1^1"
^XWB(8994,3114,2,1,0)="SOPUID^1^^^1"
^XWB(8994,3114,2,1,1,0)="^^1^1^3100805^"
^XWB(8994,3114,2,1,1,1,0)="The SOP UID used to look up the series."
^XWB(8994,3114,2,"B","SOPUID",1)=""
^XWB(8994,3114,2,"PARAMSEQ",1,1)=""
^XWB(8994,3114,3,0)="^^1^1^3100805^"
^XWB(8994,3114,3,1,0)="Returns a single SOP IEN or an error message."
^XWB(8994,3115,0)="MAGV FIND STUDY BY UID^FINDSTDY^MAGVRS05^1^R"
^XWB(8994,3115,1,0)="^8994.01^12^12^3110126^^"
^XWB(8994,3115,1,1,0)="Input parameters are name-value pairs sent as successive integer"
^XWB(8994,3115,1,2,0)="subscripts in an array that should be passed in by reference as the"
^XWB(8994,3115,1,3,0)="second argument to entry point FINDSTDY^MAGVRS05.  The first argument"
^XWB(8994,3115,1,4,0)="to FINDSTDY^MAGVRS05 should be an array name (passed by reference)"
^XWB(8994,3115,1,5,0)="that will contain the returned value."
^XWB(8994,3115,1,6,0)=" "
^XWB(8994,3115,1,7,0)="The values that may be passed in are as follows."
^XWB(8994,3115,1,8,0)="PAT_IEN: internal entry number of the patient record on the IMAGING"
^XWB(8994,3115,1,9,0)="PATIENT REFERENCE File (#2005.6)"
^XWB(8994,3115,1,10,0)="PROC_IEN: internal entry number of the procedure on the IMAGING PROCEDURE "
^XWB(8994,3115,1,11,0)="File (#2005.61)"
^XWB(8994,3115,1,12,0)="STUDY_INSTANCE_UID: external identifier of the study"
^XWB(8994,3115,2,0)="^8994.02A^1^1"
^XWB(8994,3115,2,1,0)="STUDYUID^1^64^1^1"
^XWB(8994,3115,2,1,1,0)="^^1^1^3100408^"
^XWB(8994,3115,2,1,1,1,0)="This is the ISO object identifier of the study."
^XWB(8994,3115,2,"B","STUDYUID",1)=""
^XWB(8994,3115,2,"PARAMSEQ",1,1)=""
^XWB(8994,3115,3,0)="^8994.03^6^6^3100408^^"
^XWB(8994,3115,3,1,0)="The first and only element of the return array will be structured as"
^XWB(8994,3115,3,2,0)="follows:"
^XWB(8994,3115,3,3,0)=" P1  0 if no error, nonzero if error"
^XWB(8994,3115,3,4,0)=" P2  Empty if no error, text if error"
^XWB(8994,3115,3,5,0)=" P3  Internal entry number of procedure on the IMAGE STUDY File"
^XWB(8994,3115,3,6,0)="(#2005.62) if no error"
^XWB(8994,3116,0)="MAGV FIND STUDY TIU^TIUCHK^MAGVRS43^2^R^0"
^XWB(8994,3116,1,0)="^^3^3^3110905^"
^XWB(8994,3116,1,1,0)="This RPC returns the TIU note with which an image study is associated"
^XWB(8994,3116,1,2,0)="if the study is associated with a consult procedure and a TIU note"
^XWB(8994,3116,1,3,0)="exists for the consult."
^XWB(8994,3116,2,0)="^8994.02A^1^1"
^XWB(8994,3116,2,1,0)="STYIEN^1^15^1^1"
^XWB(8994,3116,2,1,1,0)="^^1^1^3110905^"
^XWB(8994,3116,2,1,1,1,0)="This is an internal entry number on the IMAGE STUDY File (#2005.63)."
^XWB(8994,3116,2,"B","STYIEN",1)=""
^XWB(8994,3116,2,"PARAMSEQ",1,1)=""
^XWB(8994,3116,3,0)="^^10^10^3110905^"
^XWB(8994,3116,3,1,0)="This RPC returns an array with a single entry in the form n`msg`tiuien"
^XWB(8994,3116,3,2,0)="whose format is as follows:"
^XWB(8994,3116,3,3,0)="   n = 0 if the study is associated with a consult procedure and a"
^XWB(8994,3116,3,4,0)="         TIU note exists for the consult"
^XWB(8994,3116,3,5,0)="      >0 if the study is not associated with a consult for a local VA"
^XWB(8994,3116,3,6,0)="         patient, or no TIU note exists for the consult"
^XWB(8994,3116,3,7,0)="      <0 if an error condition exists (e.g., invalid input)"
^XWB(8994,3116,3,8,0)="   msg = error message text if n < 0"
^XWB(8994,3116,3,9,0)="   tiuien = internal entry number of the TIU note on the TIU DOCUMENT"
^XWB(8994,3116,3,10,0)="            File (#8925) if n = 0"
^XWB(8994,3117,0)="MAGV FIND WORK ITEM^FIND^MAGVIM01^2^R"
^XWB(8994,3117,1,0)="^8994.01^17^17^3120618^^^^"
