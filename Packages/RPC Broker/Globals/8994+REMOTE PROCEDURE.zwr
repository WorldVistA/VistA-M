^XWB(8994,4909,3,0)="^8994.03^7^7^3250213^^^^"
^XWB(8994,4909,3,1,0)="This RPC will either return an error message noting an issue with either "
^XWB(8994,4909,3,2,0)="the SDECONTEXT or SDCLINIC array or the IEN of the newly added clinic in "
^XWB(8994,4909,3,3,0)="the HOSPITAL LOCATION (#44) file."
^XWB(8994,4909,3,4,0)=" "
^XWB(8994,4909,3,5,0)="A corresponding entry will be added to the SDEC RESOURCE (#409.831) file "
^XWB(8994,4909,3,6,0)="to keep the HOSPITAL LOCATION (#44) file and the SDEC RESOURCE (#409.831) "
^XWB(8994,4909,3,7,0)="file in sync."
^XWB(8994,4910,0)="SDES GET PATREG BY DFNICN^GETREGA^SDESGETREGA2^2^R^^^^^^1"
^XWB(8994,4910,1,0)="^^6^6^3250207^"
^XWB(8994,4910,1,1,0)="Look up each of the patient DFNs and ICNs specified and return their "
^XWB(8994,4910,1,2,0)="registration data ** (as if SDES GET PATIENT REGISTRATION2 was called). "
^XWB(8994,4910,1,3,0)="At least one DFN or one ICN is required, and a combination of DFNs and "
^XWB(8994,4910,1,4,0)="ICNs may be given."
^XWB(8994,4910,1,5,0)=" "
^XWB(8994,4910,1,6,0)="Can only be invoked by Acheron"
^XWB(8994,4910,2,0)="^8994.02A^3^2"
^XWB(8994,4910,2,2,0)="DFNS^2^^0^1"
^XWB(8994,4910,2,2,1,0)="^^2^2^3230727^"
^XWB(8994,4910,2,2,1,1,0)="LIST OF ONE OR MORE DFNS TO GET PATIENT REGISTRATION. AT LEAST ONE DFN OR "
^XWB(8994,4910,2,2,1,2,0)="ONE ICN IS REQUIRED."
^XWB(8994,4910,2,3,0)="ICNS^2^^0^2"
^XWB(8994,4910,2,3,1,0)="^8994.021^2^2^3250207^^^"
