^XWB(8994,4202,1,13,0)="  | to be a violation of US Federal Statutes.                     |"
^XWB(8994,4202,1,14,0)="  +---------------------------------------------------------------+"
^XWB(8994,4202,1,15,0)="Return a DICOM formatted patient name (family^given^middle^prefix^suffix)."
^XWB(8994,4202,2,0)="^8994.02A^2^2"
^XWB(8994,4202,2,1,0)="DFN^1^30^1^1"
^XWB(8994,4202,2,1,1,0)="^8994.021^3^3^3180717^^"
^XWB(8994,4202,2,1,1,1,0)=" The value of this parameter is a pointer to ^DPT()."
^XWB(8994,4202,2,1,1,2,0)=" This pointer identifies the patient for whom information"
^XWB(8994,4202,2,1,1,3,0)=" is being requested."
^XWB(8994,4202,2,2,0)="DELIM^1^10^0^2"
^XWB(8994,4202,2,2,1,0)="^8994.021^2^2^3190325^^"
^XWB(8994,4202,2,2,1,1,0)="The user may specify an optional delimeter to separate name components."
^XWB(8994,4202,2,2,1,2,0)="The ""^"" is the default delimiter if no delimeter is specified."
^XWB(8994,4202,2,"B","DELIM",2)=""
^XWB(8994,4202,2,"B","DFN",1)=""
^XWB(8994,4202,2,"PARAMSEQ",1,1)=""
^XWB(8994,4202,2,"PARAMSEQ",2,2)=""
^XWB(8994,4202,3,0)="^8994.03^7^7^3190325^^^^"
^XWB(8994,4202,3,1,0)=" When an error occurs during the processing of this RPC,"
^XWB(8994,4202,3,2,0)=" the following error messages may be returned:"
^XWB(8994,4202,3,3,0)="     ""-1,No Patient Identified"""
^XWB(8994,4202,3,4,0)="     ""-2,No patient found with DFN=<dfn>"""
^XWB(8994,4202,3,5,0)="Otherwise the patient name components are return in DICOM format:"
^XWB(8994,4202,3,6,0)="family name^given name^middle name^prefix^suffix "
^XWB(8994,4202,3,7,0)="Note: The prefix and suffix are in reversed order in HL7."
^XWB(8994,4203,0)="IBECEA COPAY SYNCH^RETURN^IBECEA38^4^R^^^^^^1"
^XWB(8994,4203,1,0)="^8994.01^3^3^3200207^^^^"
^XWB(8994,4203,1,1,0)="This remote procedure will perform actions Create, Read, Update, Delete "
^XWB(8994,4203,1,2,0)="(CRUD) to track urgent care copays for a Veteran across all VA facilities"
^XWB(8994,4203,1,3,0)="the individual has been treated at."
^XWB(8994,4203,2,0)="^8994.02A^8^8"
^XWB(8994,4203,2,1,0)="IBICN^1^40^1^1"
^XWB(8994,4203,2,1,1,0)="^8994.021^2^2^3191210^^"
^XWB(8994,4203,2,1,1,1,0)="This is the patient's ICN used to identify the patient at a remote "
^XWB(8994,4203,2,1,1,2,0)=" facility."
^XWB(8994,4203,2,2,0)="IBSITE^1^5^1^2"
^XWB(8994,4203,2,2,1,0)="^8994.021^1^1^3191210^^"
^XWB(8994,4203,2,2,1,1,0)="This is the site # where the care was billed."
^XWB(8994,4203,2,3,0)="IBBILL^1^10^1^5"
^XWB(8994,4203,2,3,1,0)="^8994.021^2^2^3200207^^^"
^XWB(8994,4203,2,3,1,1,0)="This is the bill # created for the care provided in which a copay was "
^XWB(8994,4203,2,3,1,2,0)="charged."
^XWB(8994,4203,2,4,0)="IBVISDT^1^16^1^3"
^XWB(8994,4203,2,4,1,0)="^8994.021^1^1^3191210^^^"
^XWB(8994,4203,2,4,1,1,0)="This is the date the care was provided."
^XWB(8994,4203,2,5,0)="IBSTAT^1^1^1^4"
^XWB(8994,4203,2,5,1,0)="^8994.021^1^1^3191210^^^"
^XWB(8994,4203,2,5,1,1,0)="This is the copay status (S: 1 - Free, 2 - Billed, 3 - Cancelled)."
^XWB(8994,4203,2,6,0)="IBCOMM^1^1^1^6"
^XWB(8994,4203,2,6,1,0)="^8994.021^1^1^3191210^^^"
^XWB(8994,4203,2,6,1,1,0)="This is for applicable comments: 1 - SC/SA/CV, 2 - Not SC/SA/CV"
^XWB(8994,4203,2,7,0)="IBUNIQ^1^30^1^7"
^XWB(8994,4203,2,8,0)="IBELGRP^1^3^1^8"
^XWB(8994,4203,2,8,1,0)="^^4^4^3200207^"
^XWB(8994,4203,2,8,1,1,0)="This is the eligibilty group for the veteran at the facility where the "
^XWB(8994,4203,2,8,1,2,0)="visit was entered."
^XWB(8994,4203,2,8,1,3,0)="created for the care provided in which a copay was"
^XWB(8994,4203,2,8,1,4,0)="charged."
^XWB(8994,4203,2,"B","IBBILL",3)=""
^XWB(8994,4203,2,"B","IBCOMM",6)=""
^XWB(8994,4203,2,"B","IBELGRP",8)=""
^XWB(8994,4203,2,"B","IBICN",1)=""
^XWB(8994,4203,2,"B","IBSITE",2)=""
^XWB(8994,4203,2,"B","IBSTAT",5)=""
^XWB(8994,4203,2,"B","IBUNIQ",7)=""
^XWB(8994,4203,2,"B","IBVISDT",4)=""
^XWB(8994,4203,2,"PARAMSEQ",1,1)=""
^XWB(8994,4203,2,"PARAMSEQ",2,2)=""
^XWB(8994,4203,2,"PARAMSEQ",3,4)=""
^XWB(8994,4203,2,"PARAMSEQ",4,5)=""
^XWB(8994,4203,2,"PARAMSEQ",5,3)=""
^XWB(8994,4203,2,"PARAMSEQ",6,6)=""
^XWB(8994,4203,2,"PARAMSEQ",7,7)=""
^XWB(8994,4203,2,"PARAMSEQ",8,8)=""
^XWB(8994,4203,3,0)="^8994.03^1^1^3200207^^^^"
^XWB(8994,4203,3,1,0)="The return value will be whether the operations was successful."
^XWB(8994,4204,0)="XUS IS USER ACTIVE^ACTIVE^XUESSO4^1^P"
^XWB(8994,4204,1,0)="^8994.01^2^2^3200326^^^"
^XWB(8994,4204,1,1,0)="This API/RPC is used to check if a user is active, as defined in the "
^XWB(8994,4204,1,2,0)="routine APIs $$ACTIVE^XUSER."
^XWB(8994,4204,2,0)="^8994.02A^1^1"
^XWB(8994,4204,2,1,0)="XUIEN^1^30^0^1"
^XWB(8994,4204,2,1,1,0)="^8994.021^1^1^3200326^^^"
^XWB(8994,4204,2,1,1,1,0)=" This is the IEN of a user in the NEW PERSON file to be checked."
^XWB(8994,4204,2,"B","XUIEN",1)=""
^XWB(8994,4204,2,"PARAMSEQ",1,1)=""
^XWB(8994,4204,3,0)="^8994.03^7^7^3200326^^"
^XWB(8994,4204,3,1,0)=" It returns the following codes: "
^XWB(8994,4204,3,2,0)="           """"  No user record.  "
^XWB(8994,4204,3,3,0)="           0   User can't sign-on.  "
^XWB(8994,4204,3,4,0)="           0^DISUSER  User can't sign-on because of DISUSER flag."
^XWB(8994,4204,3,5,0)="           0^TERMINATED^2980310  User terminated on date.  "
^XWB(8994,4204,3,6,0)="           1^NEW  A new user, could sign-on.  "
^XWB(8994,4204,3,7,0)="           1^ACTIVE^2980310.09  An active user, last sign-on date."
^XWB(8994,4205,0)="DSSO XPAR DEL^DEL^DSSOXP1^1^A"
^XWB(8994,4205,1,0)="^8994.01^1^1^3180223^^^^"
^XWB(8994,4205,1,1,0)="Delete an existing parameter for an entity for a specific instance"
^XWB(8994,4205,2,0)="^8994.02A^2^2"
^XWB(8994,4205,2,1,0)="DSSODTA^1^250^1^1"
^XWB(8994,4205,2,1,1,0)="^8994.021^5^5^3180223^^^^"
^XWB(8994,4205,2,1,1,1,0)="DATA - required - p1~p2~p3~p4"
^XWB(8994,4205,2,1,1,2,0)=" p1 := optional - entity(s) - if not passed, set to ""USR"" for"
^XWB(8994,4205,2,1,1,3,0)="                  current user"
^XWB(8994,4205,2,1,1,4,0)=" p2 := required - parameter name"
^XWB(8994,4205,2,1,1,5,0)=" p3 := optional - instance"
^XWB(8994,4205,2,2,0)="DSSOFUN^1^1^0^2"
^XWB(8994,4205,2,2,1,0)="^^1^1^3180223^"
^XWB(8994,4205,2,2,1,1,0)="If $G(DSSOFUN) then extrinsic function, else RPC."
^XWB(8994,4205,2,"B","DSSODTA",1)=""
^XWB(8994,4205,2,"B","DSSOFUN",2)=""
^XWB(8994,4205,2,"PARAMSEQ",1,1)=""
^XWB(8994,4205,2,"PARAMSEQ",2,2)=""
^XWB(8994,4205,3,0)="^8994.03^2^2^3180223^^^^"
^XWB(8994,4205,3,1,0)="If the parameter is successfully deleted, return 1"
^XWB(8994,4205,3,2,0)="Else return -1^error message"
^XWB(8994,4206,0)="DSSO PRINT PC ORDER^PPCO^DSSOPPC^4^A^^^1"
^XWB(8994,4206,1,0)="^8994.01^3^3^3201211^^"
^XWB(8994,4206,1,1,0)="Gets the contents of a Prosthetics 1358 (file 664) entry along with "
^XWB(8994,4206,1,2,0)="Prosthetic site and vendor information and privacy statement, if"
^XWB(8994,4206,1,3,0)="requested, for printing/faxing."
^XWB(8994,4206,2,0)="^8994.02A^3^3"
^XWB(8994,4206,2,1,0)="DSSO664^1^30^0^1"
^XWB(8994,4206,2,1,1,0)="^8994.021^1^1^3170526^^^"
^XWB(8994,4206,2,1,1,1,0)="The pointer to PROSTHETICS 1358 file (#664)."
^XWB(8994,4206,2,2,0)="DSSOPO^1^30^0^2"
^XWB(8994,4206,2,2,1,0)="^8994.021^1^1^3170526^^^^"
^XWB(8994,4206,2,2,1,1,0)="Purchase Card Reference (field 7.5 in file 664)."
^XWB(8994,4206,2,3,0)="DSSOPRI^1^1^0^3"
^XWB(8994,4206,2,3,1,0)="^8994.021^2^2^3201211^^^^"
^XWB(8994,4206,2,3,1,1,0)="1=return Privacy statement"
^XWB(8994,4206,2,3,1,2,0)="0 or null=no Privacy statement"
^XWB(8994,4206,2,"B","DSSO664",1)=""
^XWB(8994,4206,2,"B","DSSOI",1)=""
^XWB(8994,4206,2,"B","DSSOP",2)=""
^XWB(8994,4206,2,"B","DSSOPO",2)=""
^XWB(8994,4206,2,"B","DSSOPRI",3)=""
^XWB(8994,4206,2,"PARAMSEQ",1,1)=""
^XWB(8994,4206,2,"PARAMSEQ",2,2)=""
^XWB(8994,4206,2,"PARAMSEQ",3,3)=""
^XWB(8994,4206,3,0)="^^17^17^3201211^"
^XWB(8994,4206,3,1,0)="Returns -1^error message if neither parameter 1 or 2 are sent or there is "
^XWB(8994,4206,3,2,0)="no entry found, or the patient, vendor or station are blank in file 664."
^XWB(8994,4206,3,3,0)="Returns array for printing/faxing a PO in the following format:"
^XWB(8994,4206,3,4,0)="array(n)=file 664 ien or subfile ien^field^E or I^data"
^XWB(8994,4206,3,5,0)="array(n...)=all 664 data fields in the above format"
^XWB(8994,4206,3,6,0)="array(n)=""$$STATION$"""
^XWB(8994,4206,3,7,0)="array(n...)=station name, address, and other parameters from file 669.9"
^XWB(8994,4206,3,8,0)="array(n)=""$$STATE ABBREVIATION$$"""
^XWB(8994,4206,3,9,0)="array(n)=STATE ABBREVIATION (#1) from file 5 STATE file"
^XWB(8994,4206,3,10,0)="array(n)=""$$VENDOR$$"""
^XWB(8994,4206,3,11,0)="array(n...)=vendor name, address, phone/fax, and identifier numbers"
^XWB(8994,4206,3,12,0)="If requested,"
^XWB(8994,4206,3,13,0)="array(n)=$$TEMPORARY$$^The temporary address info of the veteran"
^XWB(8994,4206,3,14,0)="array(n)=$$PERMANENT$$^The permanent address info of the veteran"
^XWB(8994,4206,3,15,0)="array(n)=$$RESIDENTIAL$$^The residential address info of the veteran"
^XWB(8994,4206,3,16,0)="array(n)=""$$PRIVACY STATEMENT$$"""
^XWB(8994,4206,3,17,0)="array(n)=privacy statement text"
^XWB(8994,4207,0)="DSSO PRIVACY STATEMENT^PRI^DSSOPPC^4^A^0^^1"
^XWB(8994,4207,1,0)="^^1^1^3110718^"
^XWB(8994,4207,1,1,0)="Returns the prosthetics privacy statement for inclusion on fax cover pages"
^XWB(8994,4207,3,0)="^^4^4^3110718^"
^XWB(8994,4207,3,1,0)="Returns array containing the prosthetics privacy statement for "
^XWB(8994,4207,3,2,0)="inclusion on fax cover pages"
^XWB(8994,4207,3,3,0)="array(n)=""$$PRIVACY STATEMENT$$"""
^XWB(8994,4207,3,4,0)="array(n...)=line of prosthetics privacy statement"
^XWB(8994,4208,0)="DSSO XPAR GET ALL FOR ENT^GETALL^DSSOXPR^2^A"
^XWB(8994,4208,1,0)="^8994.01^1^1^3110908^^"
^XWB(8994,4208,1,1,0)="Returns all values for all instances and values for an entity/parameter."
^XWB(8994,4208,2,0)="^8994.02A^1^1"
^XWB(8994,4208,2,1,0)="DATA^1^240^1^1"
^XWB(8994,4208,2,1,1,0)="^8994.021^5^5^3110908^^^^"
^XWB(8994,4208,2,1,1,1,0)=" DATA = ""ARR(1)~ARR(2)~ARR(3)~ARR(4)~ARR(5)~ARR(6)"""
^XWB(8994,4208,2,1,1,2,0)="     e.g. ""SYS~DSSO PAGE SETUP~~~~"""
^XWB(8994,4208,2,1,1,3,0)="  ARR(1) = entity     ARR(2) = param name    ARR(3) = instance"
^XWB(8994,4208,2,1,1,4,0)="  ARR(4) = value      ARR(5) = new instance value"
^XWB(8994,4208,2,1,1,5,0)="  ARR(6) = format for GETLST, Default = ""Q"""
^XWB(8994,4208,2,"B","DATA",1)=""
^XWB(8994,4208,2,"PARAMSEQ",1,1)=""
^XWB(8994,4208,3,0)="^8994.03^8^8^3110908^^^^"
^XWB(8994,4208,3,1,0)="Returns array of parameter values based on the ARR(6) value:"
^XWB(8994,4208,3,2,0)="  default= ""Q"" - quick,    #)=internal instance^internal value"
^XWB(8994,4208,3,3,0)="           ""E"" - external, #)=external instance^external value"
^XWB(8994,4208,3,4,0)="           ""B"" - both,     #,""N"")=internal instance^external instance"
^XWB(8994,4208,3,5,0)="                           #,""V"")=internal value^external value"
^XWB(8994,4208,3,6,0)="           ""N"" - external instance)=internal value^external value"
^XWB(8994,4208,3,7,0)="        some of those pieces may be <null> depends upon ARR(6)"
^XWB(8994,4208,3,8,0)="On error, return RET(1)=-1^error message"
^XWB(8994,4209,0)="DSSO SIMP/DTLD PC ORDER LIST^PPOL^DSSOPRC^4^^^^1"
^XWB(8994,4209,1,0)="^8994.01^4^4^3220708^^^^"
^XWB(8994,4209,1,1,0)="This RPC retrieves a list of simplified and detailed purchase card order "
^XWB(8994,4209,1,2,0)="numbers from the Procurement & Accounting Transactions file (file"
^XWB(8994,4209,1,3,0)="442) beginning with the input value (at least one character is "
^XWB(8994,4209,1,4,0)="required).  "
^XWB(8994,4209,2,0)="^8994.02A^1^1"
^XWB(8994,4209,2,1,0)="DSSOPON^1^30^1^1"
^XWB(8994,4209,2,1,1,0)="^8994.021^6^6^3220708^^^^"
^XWB(8994,4209,2,1,1,1,0)="This field can contain the long (XXX-XXXXXX) or short (XXXXXX) format of "
^XWB(8994,4209,2,1,1,2,0)="the purchase order number."
^XWB(8994,4209,2,1,1,3,0)=" "
^XWB(8994,4209,2,1,1,4,0)="At least one character must be input as this data is the beginning of the"
^XWB(8994,4209,2,1,1,5,0)="lookup value for purchase order numbers in the Procurement & Accounting"
^XWB(8994,4209,2,1,1,6,0)="Transactions file (field #.01 Purchase Order Number, file 442)."
^XWB(8994,4209,2,"B","DSSOPON",1)=""
^XWB(8994,4209,2,"PARAMSEQ",1,1)=""
^XWB(8994,4209,3,0)="^8994.03^11^11^3220708^^"
^XWB(8994,4209,3,1,0)="Returns -1^error message if no purchase order number starting value is"
^XWB(8994,4209,3,2,0)="provided and if no purchase orders begin with the starting value"
^XWB(8994,4209,3,3,0)="Returns array for populating the PO lookup list in the following format:"
^XWB(8994,4209,3,4,0)=" "
^XWB(8994,4209,3,5,0)="array(n)=p1^p2^p3^p4^p5^p6^p7^p8^p9"
^XWB(8994,4209,3,6,0)=" "
^XWB(8994,4209,3,7,0)="  p1 = File #442 IEN                 p6 = VENDOR (#5)(External)"
^XWB(8994,4209,3,8,0)="  p2 = PURCHASE ORDER NUMBER (#.01)  p7 = TYPE OF ORDER (#48)"
^XWB(8994,4209,3,9,0)="  p3 = P.O. DATE (#.1)               p8 = PCDO VENDOR (#53)(Internal)"
^XWB(8994,4209,3,10,0)="  p4 = SUPPLY STATUS (#.5)           p9 = PCDO VENDOR (#53)(External)"
^XWB(8994,4209,3,11,0)="  p5 = VENDOR (#5)(Internal)"
^XWB(8994,4209,3,12,0)="array(n)=file 442 ien^65^I^data"
^XWB(8994,4209,3,13,0)="array(n...) array lines are repeated for each purchase order number"
^XWB(8994,4209,3,14,0)="starting with the input value"
^XWB(8994,4209,3,15,0)="array(n)=""$$END$$"""
^XWB(8994,4210,0)="DSSO PRINT SIMP/DTLD PC ORDER^PPRC^DSSOPRC^4^A^^^1"
^XWB(8994,4210,1,0)="^8994.01^7^7^3190812^^^^"
^XWB(8994,4210,1,1,0)="This RPC gets the contents of a Procurement & Accounting Transactions"
^XWB(8994,4210,1,2,0)="(file 442) entry, Control Point Activity (file 410) entry, selected"
^XWB(8994,4210,1,3,0)="station data from the Admin. Activity Site Parameters (file 411) "
^XWB(8994,4210,1,4,0)="entry, Vendor (file 440) entry, and selected User (file 200) data for"
^XWB(8994,4210,1,5,0)="printing/faxing simplified and detailed purchase card orders for the "
^XWB(8994,4210,1,6,0)="input purchase order number or IEN.  Use RPC DSSO PRINT PC ORDER to"
^XWB(8994,4210,1,7,0)="return data for Prosthetics purchase card orders."
^XWB(8994,4210,2,0)="^8994.02A^2^2"
^XWB(8994,4210,2,1,0)="DSSOPRC^1^30^0^1"
^XWB(8994,4210,2,1,1,0)="^8994.021^2^2^3131017^^^"
^XWB(8994,4210,2,1,1,1,0)="This is the pointer to the Procurement & Accounting Transactions File "
^XWB(8994,4210,2,1,1,2,0)="(file 442) for the requested purchase order number."
^XWB(8994,4210,2,2,0)="DSSOPON^1^30^0^2"
^XWB(8994,4210,2,2,1,0)="^8994.021^2^2^3190812^^^^"
^XWB(8994,4210,2,2,1,1,0)="This field may contain the long (XXX-XXXXXX) or short (XXXXXX) versions "
^XWB(8994,4210,2,2,1,2,0)="of the Purchase Order Number (field #.01 in file 442)."
^XWB(8994,4210,2,"B","DSSOPON",2)=""
^XWB(8994,4210,2,"B","DSSOPRC",1)=""
^XWB(8994,4210,2,"PARAMSEQ",1,1)=""
^XWB(8994,4210,2,"PARAMSEQ",2,2)=""
^XWB(8994,4210,3,0)="^^52^52^3190812^"
^XWB(8994,4210,3,1,0)="Returns -1^error message if:"
^XWB(8994,4210,3,2,0)=" 1) neither parameter 1 or 2 are sent"
^XWB(8994,4210,3,3,0)=" 2) there is no entry found in file 442 - Procurement & Accounting"
^XWB(8994,4210,3,4,0)=" Transactions file"
^XWB(8994,4210,3,5,0)=" 3) the user is not found in file 200 - New Person file"
^XWB(8994,4210,3,6,0)=" 4) site parameters have not been established in file 411 - Admin."
^XWB(8994,4210,3,7,0)=" Activity Site Parameters file"
^XWB(8994,4210,3,8,0)=" 5) no entry is found in file 411 - Admin. Activity Site Parameters file"
^XWB(8994,4210,3,9,0)=" 6) no vendor is present for this purchase order number in file 442 -"
^XWB(8994,4210,3,10,0)=" Procurement & Accounting Transactions file"
^XWB(8994,4210,3,11,0)=" 7) no authorized buyer exists for this purchase order in file 442 -"
^XWB(8994,4210,3,12,0)=" Procurement & Accounting Transactions file"
^XWB(8994,4210,3,13,0)=" "
^XWB(8994,4210,3,14,0)=" Returns array for printing/faxing a simplified or detailed purchase card "
^XWB(8994,4210,3,15,0)=" order in the following format:"
^XWB(8994,4210,3,16,0)=" "
^XWB(8994,4210,3,17,0)=" array(n)=""$$TITLE LINE DATE/TIME$$^Aug 08, 2019@16:36:54""  $Horolog date "
^XWB(8994,4210,3,18,0)="             used as current date/time for title line"
^XWB(8994,4210,3,19,0)=" array(n)=""$$442-PO DATA$$"""
^XWB(8994,4210,3,20,0)=" array(n)=file or subfile #^file 442 ien or subfile ien^field^E or I^data"
^XWB(8994,4210,3,21,0)=" array(n...)=a subset of all 442 data fields in the above format"
^XWB(8994,4210,3,22,0)=" *NOTE* - File 442 field #1.4, external format, includes a ""-"" and the "
^XWB(8994,4210,3,23,0)="             numeric portion of field #1 FCP (i.e. - ""442^99999595,^1.4"
^XWB(8994,4210,3,24,0)="             ^E^36X0160-910"")"
^XWB(8994,4210,3,25,0)="          File 442 field #5.2, external format, includes file 49 field "
^XWB(8994,4210,3,26,0)="             #1.5 Mail Symbol in parentheses (i.e. - ""442^99999595,^5.2"
^XWB(8994,4210,3,27,0)="             ^E^PROSTHETICS AND SENSORY AIDS(121)"")"
^XWB(8994,4210,3,28,0)="          File 442 field #8, external format, is pre-formatted for both"
^XWB(8994,4210,3,29,0)="             Supply and Fiscal values (i.e. - ""442^99999595,^8^E^SOURCE "
^XWB(8994,4210,3,30,0)="             CODE: SUPPLY- COMB.2,4,6 FISCAL-3"")"
^XWB(8994,4210,3,31,0)="          File 442 field #46 PURCHASE CARD NUMBER external format has a "
^XWB(8994,4210,3,32,0)="             caret and the PURCHASE CARD NAME (file 440.5, field 10)"
^XWB(8994,4210,3,33,0)="             appended"
^XWB(8994,4210,3,34,0)="          File 442 field #99999999, external format, is the FCP/PRJ value "
^XWB(8994,4210,3,35,0)="             from file 420 field 27 FCP/PRJ that is to be displayed after "
^XWB(8994,4210,3,36,0)="             the BOC information."
^XWB(8994,4210,3,37,0)=" array(n)=""$$410-2237 DATA$$"" (file 410 entries are optional)"
^XWB(8994,4210,3,38,0)=" array(n)=file or subfile #^file 410 ien or subfile ien^field^E or I^data"
