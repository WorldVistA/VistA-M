^XWB(8994,3832,0)="MAGQBP VAL^VAL^MAGBVAL^2^R"
^XWB(8994,3832,1,0)="^8994.01^4^4^3180620^^"
^XWB(8994,3832,1,1,0)="This call will validate existing data in the "
^XWB(8994,3832,1,2,0)="IMAGING SITE PARAMETERS File."
^XWB(8994,3832,1,3,0)="If existing data is invalid,  the BP cannot run the "
^XWB(8994,3832,1,4,0)="Imaging Site Parameters edit window."
^XWB(8994,3832,2,0)="^8994.02A^2^2"
^XWB(8994,3832,2,1,0)="MAGARRAY^2^^1^1"
^XWB(8994,3832,2,1,1,0)="^^1^1^3180620^"
^XWB(8994,3832,2,1,1,1,0)="Array of Field Numbers to Validate"
^XWB(8994,3832,2,2,0)="ALL^1^30^0^2"
^XWB(8994,3832,2,2,1,0)="^^3^3^3180620^"
^XWB(8994,3832,2,2,1,1,0)="if ALL=1  then all fields will be validated."
^XWB(8994,3832,2,2,1,2,0)="if ALL=0  then the validation will stop when first invalid"
^XWB(8994,3832,2,2,1,3,0)="entry is found."
^XWB(8994,3832,2,"B","ALL",2)=""
^XWB(8994,3832,2,"B","MAGARRAY",1)=""
^XWB(8994,3832,2,"PARAMSEQ",1,1)=""
^XWB(8994,3832,2,"PARAMSEQ",2,2)=""
^XWB(8994,3832,3,0)="^8994.03^4^4^3180620^^"
^XWB(8994,3832,3,1,0)="Array(0)=1^Success    if all field data was valid"
^XWB(8994,3832,3,2,0)="Array(0)=""0^Error message""  if any data is invalid"
^XWB(8994,3832,3,3,0)="if ALL=1  then Array(1..n) will contain Error messages for"
^XWB(8994,3832,3,4,0)="all fields that have invalid data."
^XWB(8994,3833,0)="ORWDPS1 GETPRIOR^GETPRIOR^ORWDPS1^1"
^XWB(8994,3833,1,0)="^8994.01^3^3^3170312^^^^"
^XWB(8994,3833,1,1,0)="This gets the sites preferred priority for ""ASAP"". If ""ASAP"" is not used "
^XWB(8994,3833,1,2,0)="it holds the sites alternative to ""ASAP"" or if ""ASAP"" has been renamed it "
^XWB(8994,3833,1,3,0)="can hold that information if it is chosen. It only holds one entry."
^XWB(8994,3833,3,0)="^8994.03^1^1^3170312^^^^"
^XWB(8994,3833,3,1,0)="It returns the sites selection for the ""ASAP"" priority alternative."
^XWB(8994,3834,0)="ORWDPS1 GETPRIEN^GETPRIEN^ORWDPS1^1^^0"
^XWB(8994,3834,1,0)="^8994.01^2^2^3170501^^^^"
^XWB(8994,3834,1,1,0)="Returns the IEN of the sites selection for an Alternative to the ""ASAP"" "
^XWB(8994,3834,1,2,0)="order urgency, from file ORD(101.42."
^XWB(8994,3834,2,0)="^8994.02A^^0"
^XWB(8994,3834,3,0)="^8994.03^1^1^3170501^^^^"
^XWB(8994,3834,3,1,0)="The IEN of the sites ""ASAP"" urgency selection"
^XWB(8994,3835,0)="XUS MVI NEW PERSON DATA^EP^XUMVIDTA^1^A^^^1^1^^0"
^XWB(8994,3835,1,0)="^8994.01^8^8^3181004^"
^XWB(8994,3835,1,1,0)="This RPC will return calculated data analysis from NEW PERSON file (#200) "
^XWB(8994,3835,1,2,0)="at VistA for user's selection criteria for active and non active NEW "
^XWB(8994,3835,1,3,0)="PERSON entries."
^XWB(8994,3835,1,4,0)=" "
^XWB(8994,3835,1,5,0)="Active New Person aggregated data for one or all below elements:"
^XWB(8994,3835,1,6,0)="SECID"
^XWB(8994,3835,1,7,0)="AUDPN (Email)"
^XWB(8994,3835,1,8,0)="NT USERNAME"
^XWB(8994,3835,2,0)="^8994.02A^2^2"
^XWB(8994,3835,2,1,0)="SEL^1^1^1^1"
^XWB(8994,3835,2,1,1,0)="^^5^5^3181004^"
^XWB(8994,3835,2,1,1,1,0)="This input parameter can contain 1 - 3 numeric values. It evaluates to "
^XWB(8994,3835,2,1,1,2,0)="following criteria."
^XWB(8994,3835,2,1,1,3,0)="1 - ALL (Active and Inactive)"
^XWB(8994,3835,2,1,1,4,0)="2 - Active New Person"
^XWB(8994,3835,2,1,1,5,0)="3 - Inactive New Person"
^XWB(8994,3835,2,2,0)="ACTSEL^1^1^0^2"
^XWB(8994,3835,2,2,1,0)="^^8^8^3181004^"
^XWB(8994,3835,2,2,1,1,0)="This input parameter can contain 1 - 4 numeric value. It evaluates to "
^XWB(8994,3835,2,2,1,2,0)="following criteria of Active records. This input parameter is only "
^XWB(8994,3835,2,2,1,3,0)="present if selection criteria is for Active New Person."
^XWB(8994,3835,2,2,1,4,0)=" "
^XWB(8994,3835,2,2,1,5,0)="1 - ALL"
^XWB(8994,3835,2,2,1,6,0)="2 - Number of Active records having a SecID value"
^XWB(8994,3835,2,2,1,7,0)="3 - Number of Active records having an Email value"
^XWB(8994,3835,2,2,1,8,0)="4 - Number of Active records having a NT USERNAME value"
^XWB(8994,3835,2,"B","ACTSEL",2)=""
^XWB(8994,3835,2,"B","SEL",1)=""
^XWB(8994,3835,2,"PARAMSEQ",1,1)=""
^XWB(8994,3835,2,"PARAMSEQ",2,2)=""
^XWB(8994,3835,3,0)="^^3^3^3181004^"
^XWB(8994,3835,3,1,0)="RETURN:"
^XWB(8994,3835,3,2,0)="Total Count^Total Non Active^Total Active^Total SECID^Total Email^Total "
^XWB(8994,3835,3,3,0)="NT User^Total Visitors"
^XWB(8994,3836,0)="XOBV VALIDATE SAML^SAML^XOBVSAML^2^R^^^^1^^1"
^XWB(8994,3836,1,0)="^8994.01^1^1^3170413^^"
^XWB(8994,3836,1,1,0)="This RPC receives a SAML token to validate a user logon to VistA."
^XWB(8994,3836,2,0)="^8994.02A^1^1"
^XWB(8994,3836,2,1,0)="DOC^1^32000^1^1"
^XWB(8994,3836,2,1,1,0)="^8994.021^1^1^3170413^^"
^XWB(8994,3836,2,1,1,1,0)="This is the saml token."
^XWB(8994,3836,2,"B","DOC",1)=""
^XWB(8994,3836,2,"PARAMSEQ",1,1)=""
^XWB(8994,3836,3,0)="^8994.03^1^1^3170413^^"
^XWB(8994,3836,3,1,0)="Returns user's DUZ if successful, otherwise returns ""1^error message""."
^XWB(8994,3837,0)="DSIYUTL EQSCH EQUIP SEARCH^EQSCH^DSIYUTL^4^^^^1"
^XWB(8994,3837,1,0)="^8994.01^1^1^3160804^^^^"
^XWB(8994,3837,1,1,0)="Searches the EQUIPMENT INV. (#6914) file by requested field."
^XWB(8994,3837,2,0)="^8994.02A^7^6"
^XWB(8994,3837,2,1,0)="TERM^1^30^0^1"
^XWB(8994,3837,2,1,1,0)="^8994.021^1^1^3121108^^"
^XWB(8994,3837,2,1,1,1,0)="What to search for"
^XWB(8994,3837,2,2,0)="SCHBY^1^5^1^2"
^XWB(8994,3837,2,2,1,0)="^^28^28^3160804^"
^XWB(8994,3837,2,2,1,1,0)="BY"
^XWB(8994,3837,2,2,1,2,0)=" "
^XWB(8994,3837,2,2,1,3,0)="Allows searching by the following fields:"
^XWB(8994,3837,2,2,1,4,0)=" "
^XWB(8994,3837,2,2,1,5,0)="EN:     Search by Equipment ID (XREF ""B"")"
^XWB(8994,3837,2,2,1,6,0)="MA:     Search by Manufacturer (XREF ""K"") - Allows Full Field Search"
^XWB(8994,3837,2,2,1,7,0)="MF:     Search by Manufacturer's Equipment Name (XREF ""H"")"
^XWB(8994,3837,2,2,1,8,0)="                This is the default search if nothing supplied"
^XWB(8994,3837,2,2,1,9,0)="                Allows Full Field Search"
^XWB(8994,3837,2,2,1,10,0)="MO:     Search by Model (XREF ""EC"")"
^XWB(8994,3837,2,2,1,11,0)="SN:     Search by Serial # (XREF FC"")"
^XWB(8994,3837,2,2,1,12,0)="EC:     Search by Equipment Category (XREF ""G"") - Allows Full Field Search"
^XWB(8994,3837,2,2,1,13,0)="LO:     Search by Location (XREF ""D"") - Allows Full Field Search"
^XWB(8994,3837,2,2,1,14,0)="LI:     Search by Local Identifier (XREF ""L"")"
^XWB(8994,3837,2,2,1,15,0)="AV:     Search by Asset Value - NOTE - this search is not included in the"
^XWB(8994,3837,2,2,1,16,0)="                By ""ALL"" functionality"
^XWB(8994,3837,2,2,1,17,0)="AD:     Search by CMR/EIL (Xref ""AD"") - allows full field search, included"
^XWB(8994,3837,2,2,1,18,0)="                in search by ""ALL"" functionality"
^XWB(8994,3837,2,2,1,19,0)="PO:     Search by PO# (Xref ""M"") - allows full field search, included in"
^XWB(8994,3837,2,2,1,20,0)="                search by ""ALL"" functionality"
^XWB(8994,3837,2,2,1,21,0)="RD:     Search by Replacement Date no xref"
^XWB(8994,3837,2,2,1,22,0)="AR:     Search by EQ type - xref ""AR"""
^XWB(8994,3837,2,2,1,23,0)="PI:     Search by Inventory Date - no xref"
^XWB(8994,3837,2,2,1,24,0)="CSN:    Search by Category Stock # - Xref ""J"" "
^XWB(8994,3837,2,2,1,25,0)="ALL:    Search by all above except for ""AV"""
^XWB(8994,3837,2,2,1,26,0)=" "
^XWB(8994,3837,2,2,1,27,0)="When calling this from the Turn-In screen, use """", or ""ALL"" to search all "
^XWB(8994,3837,2,2,1,28,0)="fields."
^XWB(8994,3837,2,3,0)="USE^1^20^0^3"
^XWB(8994,3837,2,3,1,0)="^8994.021^13^13^3160804^^"
^XWB(8994,3837,2,3,1,1,0)="USE"
^XWB(8994,3837,2,3,1,2,0)="Use Status for this piece of equipment - SET included in the DD entry"
^XWB(8994,3837,2,3,1,3,0)="for 6914,20 field in Equipment Management File"
^XWB(8994,3837,2,3,1,4,0)="Required"
^XWB(8994,3837,2,3,1,5,0)=" "
^XWB(8994,3837,2,3,1,6,0)="Multiple USE criteria can be sent - they should be started,separated and "
^XWB(8994,3837,2,3,1,7,0)="ended with ""^"" - i.e., ""^1^4^5^"""
^XWB(8994,3837,2,3,1,8,0)=" "
^XWB(8994,3837,2,3,1,9,0)="If the user does not select any USE statuses, continue to send a null "
^XWB(8994,3837,2,3,1,10,0)="string (USE="""")"
^XWB(8994,3837,2,3,1,11,0)=" "
^XWB(8994,3837,2,3,1,12,0)="When calling this from the turn-in screen, use ""^1^2^3^5^"" to indicate "
^XWB(8994,3837,2,3,1,13,0)="all use statuses EXCEPT for ""TURNED-IN"""
^XWB(8994,3837,2,4,0)="NOREC^1^4^0^4"
^XWB(8994,3837,2,4,1,0)="^8994.021^5^5^3130710^^^"
^XWB(8994,3837,2,4,1,1,0)="NOREC"
^XWB(8994,3837,2,4,1,2,0)=" "
^XWB(8994,3837,2,4,1,3,0)="The number of records to return"
^XWB(8994,3837,2,4,1,4,0)="Not Required"
^XWB(8994,3837,2,4,1,5,0)="If not entered, All matching records will be returned"
^XWB(8994,3837,2,5,0)="SCHTXT^1^1^0^5"
^XWB(8994,3837,2,5,1,0)="^8994.021^4^4^3130307^^^^"
^XWB(8994,3837,2,5,1,1,0)="SCHTXT"
^XWB(8994,3837,2,5,1,2,0)=" "
^XWB(8994,3837,2,5,1,3,0)="Finds the TERM anywhere within the string for specific searches.  Slower "
^XWB(8994,3837,2,5,1,4,0)="search as Xref's can't be used"
^XWB(8994,3837,2,6,0)="TIFLAG^1^10^0^6"
^XWB(8994,3837,2,6,1,0)="^8994.021^11^11^3130416^^^"
^XWB(8994,3837,2,6,1,1,0)="TIFLAG"
^XWB(8994,3837,2,6,1,2,0)=" "
^XWB(8994,3837,2,6,1,3,0)="Indicates whether this search is coming from the Turn-In Screen.  If it "
^XWB(8994,3837,2,6,1,4,0)="does come from Turn-In, all CMR's have to match."
^XWB(8994,3837,2,6,1,5,0)=" "
^XWB(8994,3837,2,6,1,6,0)="The appropriate values for this field are:"
^XWB(8994,3837,2,6,1,7,0)="""*"" Indicates that this is a new turn-in request - first piece of "
^XWB(8994,3837,2,6,1,8,0)="equipment"
^XWB(8994,3837,2,6,1,9,0)="CMR IEN = send the CMR IEN if this is a subsequent piece of equipment for "
^XWB(8994,3837,2,6,1,10,0)="a turn-in requst - all equipment in the same turn-in request need to hbe "
^XWB(8994,3837,2,6,1,11,0)="for the same CMR."
^XWB(8994,3837,2,7,0)="DSIYNEXT^1^45^0^6"
^XWB(8994,3837,2,7,1,0)="^^2^2^3160120^"
^XWB(8994,3837,2,7,1,1,0)="TYPE OF EQ - 'NX' NON-EXPENDABLE EQ;'BSE' BUILDING SERVICE EQ;'EXP' FOR "
^XWB(8994,3837,2,7,1,2,0)="EXPENDABLE EQ;'ALL' FOR ALL"
^XWB(8994,3837,2,7,1,3,0)="This parameter is only used when the user is asking for more data for a "
^XWB(8994,3837,2,7,1,4,0)="search (pressing pageup/pagedown at the end of the data, etc.)  This will "
^XWB(8994,3837,2,7,1,5,0)="allow the RPC to grab the next set of data to display to the user."
^XWB(8994,3837,2,7,1,6,0)=" "
^XWB(8994,3837,2,7,1,7,0)="Format is:"
^XWB(8994,3837,2,7,1,8,0)=" "
^XWB(8994,3837,2,7,1,9,0)="MOVE^FIRST/LAST IEN"
^XWB(8994,3837,2,7,1,10,0)=" "
^XWB(8994,3837,2,7,1,11,0)="If the user indicates they want to move down through the data - send"
^XWB(8994,3837,2,7,1,12,0)="1^the last IEN from the last search"
^XWB(8994,3837,2,7,1,13,0)=" "
^XWB(8994,3837,2,7,1,14,0)="If the user indicates they want to move up through the data - send"
^XWB(8994,3837,2,7,1,15,0)="-1^the first IEN from the last search"
^XWB(8994,3837,2,7,1,16,0)=" "
^XWB(8994,3837,2,7,1,17,0)="All other parameters (TERM, BY, USE, NOREC, SCHTXT) need to be sent "
^XWB(8994,3837,2,7,1,18,0)="exactly as they were for the original search in this session."
^XWB(8994,3837,2,"B","DSIYNEXT",7)=""
^XWB(8994,3837,2,"B","NOREC",4)=""
^XWB(8994,3837,2,"B","SCHBY",2)=""
