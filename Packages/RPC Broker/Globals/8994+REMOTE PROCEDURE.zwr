^XWB(8994,3977,2,1,1,2,0)=" "
^XWB(8994,3977,2,1,1,3,0)="Number of the file to search"
^XWB(8994,3977,2,2,0)="XREF^1^15^1^2"
^XWB(8994,3977,2,2,1,0)="^^3^3^3130313^"
^XWB(8994,3977,2,2,1,1,0)="XREF"
