^XWB(8994,1787,2,0)="^8994.02A^2^2"
^XWB(8994,1787,2,1,0)="REGIEN^1^^1^1"
^XWB(8994,1787,2,1,1,0)="^8994.021^2^2^3050513^^"
^XWB(8994,1787,2,1,1,1,0)="The REGIEN parameter should contain a valid registry IEN (IEN of the"
