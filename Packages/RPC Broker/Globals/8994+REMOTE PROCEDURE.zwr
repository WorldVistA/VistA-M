^XWB(8994,4607,3,0)="^8994.03^8^8^3230110^^^"
^XWB(8994,4607,3,1,0)="Output:"
^XWB(8994,4607,3,2,0)="  Error Messages:"
^XWB(8994,4607,3,3,0)="    DSSORET=""-1^""_error message or ""0^""_warning message"
^XWB(8994,4607,3,4,0)="  Successful Completion:"
^XWB(8994,4607,3,5,0)="    DSSORET=""1"" ^ AMIS Grouper ^ ""STOCK ISSUE CREATED SUCCESSFULLY"" ^ "
^XWB(8994,4607,3,6,0)="      File 660 IEN"
^XWB(8994,4607,3,7,0)="        where AMIS Grouper = a number that groups items for a Stock"
^XWB(8994,4607,3,8,0)="          Issue together"
^XWB(8994,4608,0)="DSSO PI 661.7 MATCHES^NBR6617^DSSOUP2^1"
^XWB(8994,4608,1,0)="^^2^2^3150625^"
^XWB(8994,4608,1,1,0)="This RPC returns the number of Prosthetic Current Stock (#661.7) records "
^XWB(8994,4608,1,2,0)="for the specified HCPCS and Date/Time Stamp."
^XWB(8994,4608,2,0)="^8994.02A^2^2"
^XWB(8994,4608,2,1,0)="DSSOHCP^1^15^1^1"
^XWB(8994,4608,2,1,1,0)="^^1^1^3150625^"
^XWB(8994,4608,2,1,1,1,0)="HCPCS - in external format (i.e. - ""A5500"") - required"
^XWB(8994,4608,2,2,0)="DSSODTM^1^14^1^2"
^XWB(8994,4608,2,2,1,0)="^^1^1^3150625^"
^XWB(8994,4608,2,2,1,1,0)="Date/Time Stamp in internal format (i.e. - yyymmdd.hhmmss) - required"
^XWB(8994,4608,2,"B","DSSODTM",2)=""
^XWB(8994,4608,2,"B","DSSOHCP",1)=""
^XWB(8994,4608,2,"PARAMSEQ",1,1)=""
^XWB(8994,4608,2,"PARAMSEQ",2,2)=""
^XWB(8994,4608,3,0)="^^5^5^3150625^"
^XWB(8994,4608,3,1,0)="Output:"
^XWB(8994,4608,3,2,0)="  Error messages:  DSSORET=""-1^""_error message or ""0^""_warning message"
^XWB(8994,4608,3,3,0)="  Successful Completion: Returns the number of Prosthetic Current Stock"
^XWB(8994,4608,3,4,0)="    (#661.7) records for the scanned bar code in the format:"
^XWB(8994,4608,3,5,0)="       DSSORET = Number records found ""^661.7 records found"""
^XWB(8994,4609,0)="DSSO PI 661.6 VENDORS^NBR6616^DSSOUP2^2"
^XWB(8994,4609,1,0)="^^2^2^3150625^"
^XWB(8994,4609,1,1,0)="This RPC returns a list of Pros Inventory Transaction (#661.6) vendors "
^XWB(8994,4609,1,2,0)="for the specified Station, HCPCS, and Date/Time Stamp."
^XWB(8994,4609,2,0)="^8994.02A^3^3"
^XWB(8994,4609,2,1,0)="DSSOSTN^1^15^1^1"
^XWB(8994,4609,2,1,1,0)="^^1^1^3150625^"
^XWB(8994,4609,2,1,1,1,0)="Station - Institution file (#4) IEN"
^XWB(8994,4609,2,2,0)="DSSOHCP^1^20^1^2"
^XWB(8994,4609,2,2,1,0)="^^1^1^3150625^"
^XWB(8994,4609,2,2,1,1,0)="HCPCS in external format (i.e. - ""A5500"""
^XWB(8994,4609,2,3,0)="DSSODTM^1^14^1^3"
^XWB(8994,4609,2,3,1,0)="^^1^1^3150625^"
^XWB(8994,4609,2,3,1,1,0)="Date/Time Stamp in internal format (i.e. - yyymmdd.hhmmss)"
^XWB(8994,4609,2,"B","DSSODTM",3)=""
^XWB(8994,4609,2,"B","DSSOHCP",2)=""
^XWB(8994,4609,2,"B","DSSOSTN",1)=""
^XWB(8994,4609,2,"PARAMSEQ",1,1)=""
^XWB(8994,4609,2,"PARAMSEQ",2,2)=""
^XWB(8994,4609,2,"PARAMSEQ",3,3)=""
^XWB(8994,4609,3,0)="^^6^6^3150625^"
^XWB(8994,4609,3,1,0)="Output:"
^XWB(8994,4609,3,2,0)="  Error Messages:  DSSORET(0)=""-1^""_error message or ""0^""_warning message"
^XWB(8994,4609,3,3,0)="  Successful Completion:"
^XWB(8994,4609,3,4,0)="    DSSORET(n) = "
^XWB(8994,4609,3,5,0)="            ^-pc 1 Vendor File (#440) IEN"
^XWB(8994,4609,3,6,0)="            ^-pc 2 Vendor Name (file 440, field #.01 - external format)"
^XWB(8994,4610,0)="DSSO PI QUANTITY FOR BAR CODE^VAL6617^DSSOUP2^1"
^XWB(8994,4610,1,0)="^^3^3^3150708^"
^XWB(8994,4610,1,1,0)="This RPC returns the Prosthetic Current Stock file (#661.7) IEN, the"
^XWB(8994,4610,1,2,0)="quantity for the scanned bar code and station, and the HCPCS Item number "
^XWB(8994,4610,1,3,0)="associated to the bar code.."
^XWB(8994,4610,2,0)="^8994.02A^2^2"
^XWB(8994,4610,2,1,0)="DSSOBCD^1^20^1^1"
^XWB(8994,4610,2,1,1,0)="^^1^1^3150706^"
^XWB(8994,4610,2,1,1,1,0)="Scanned bar code (i.e. - ""A5500-3150429162145"")"
^XWB(8994,4610,2,2,0)="DSSOSTN^1^10^1^2"
^XWB(8994,4610,2,2,1,0)="^8994.021^1^1^3150708^^"
^XWB(8994,4610,2,2,1,1,0)="IEN of Institution file (#4)"
^XWB(8994,4610,2,"B","DSSOBCD",1)=""
^XWB(8994,4610,2,"B","DSSOSTN",2)=""
^XWB(8994,4610,2,"PARAMSEQ",1,1)=""
^XWB(8994,4610,2,"PARAMSEQ",2,2)=""
^XWB(8994,4610,3,0)="^^8^8^3150708^"
^XWB(8994,4610,3,1,0)="Output:"
^XWB(8994,4610,3,2,0)="  Error messages:  DSSORET=""-1^""_error message or ""0^""_warning message"
^XWB(8994,4610,3,3,0)="  Successful Completion:  Returns Current Stock file (#661.7) IEN for the "
^XWB(8994,4610,3,4,0)="    scanned bar code, the quantity (661.7 field 6), and the HCPCS Item "
^XWB(8994,4610,3,5,0)="    (661.7 field 3):"
^XWB(8994,4610,3,6,0)="    DSSORET=  ^-pc 1 - File 661.7 IEN"
^XWB(8994,4610,3,7,0)="               ^-pc 2 - Quantity (661.7 field 6)"
^XWB(8994,4610,3,8,0)="               ^-pc 3 - HCPCS Item (661.7 field 3)"
^XWB(8994,4611,0)="DSSO LPCI PLUS REPORT^LPCIPLUS^DSSOROHL^4^^^^1"
^XWB(8994,4611,1,0)="^^15^15^3210806^"
^XWB(8994,4611,1,1,0)="This RPC provides a list of order history transactions for one user or all"
^XWB(8994,4611,1,2,0)="users.  There are multiple lines for each purchase card order - the first"
^XWB(8994,4611,1,3,0)="and second lines contain multiple fields; the third line (and "
^XWB(8994,4611,1,4,0)="subsequent lines) contain dates to be displayed as billing date(s); a "
^XWB(8994,4611,1,5,0)="line is returned for each billing item, and shipping/delivery costs are "
^XWB(8994,4611,1,6,0)="returned as additional billing item entries. The purchasing agent's notes "
^XWB(8994,4611,1,7,0)="are returned for a PO if comments exist."
^XWB(8994,4611,1,8,0)=" "
^XWB(8994,4611,1,9,0)="A final node is returned to indicate whether the process is or is not "
^XWB(8994,4611,1,10,0)="complete.  If the report is not complete, ""$$MORE$$^last date"
^XWB(8994,4611,1,11,0)="processed^last IEN processed"" is returned in the final node.  If "
^XWB(8994,4611,1,12,0)="$$MORE$$ is present, then the next iteration of the RPC should replace"
^XWB(8994,4611,1,13,0)="DSSOBDT with the last date processed and DSSOIEN with the last IEN"
^XWB(8994,4611,1,14,0)="processed.  If the report is complete, then the final node will be set to"
^XWB(8994,4611,1,15,0)="""$$END$$""."
^XWB(8994,4611,2,0)="^8994.02A^7^7"
^XWB(8994,4611,2,1,0)="DSSO6699^1^15^1^1"
^XWB(8994,4611,2,1,1,0)="^^1^1^3190503^"
^XWB(8994,4611,2,1,1,1,0)="DSSO6699 - required - Prosthetic Site - file 669.9 IEN"
^XWB(8994,4611,2,2,0)="DSSOADM^1^1^0^2"
^XWB(8994,4611,2,2,1,0)="^8994.021^2^2^3190503^^"
^XWB(8994,4611,2,2,1,1,0)="DSSOADM - optional - ""1"" indicates that an Admin user is requesting the "
^XWB(8994,4611,2,2,1,2,0)="report"
^XWB(8994,4611,2,3,0)="DSSOBDT^1^7^0^3"
^XWB(8994,4611,2,3,1,0)="^^2^2^3190530^"
^XWB(8994,4611,2,3,1,1,0)="DSSOBDT - optional - Begin Date of report in FileMan format; defaults to "
^XWB(8994,4611,2,3,1,2,0)="the current date"
^XWB(8994,4611,2,4,0)="DSSOEDT^1^7^0^4"
^XWB(8994,4611,2,4,1,0)="^^2^2^3190503^"
^XWB(8994,4611,2,4,1,1,0)="DSSOEDT - optional - End Date - in FileMan format - if entered, must be "
^XWB(8994,4611,2,4,1,2,0)="future to DSSOBDT; if null, defaults to current date"
^XWB(8994,4611,2,5,0)="DSSOUSR^1^30^0^5"
^XWB(8994,4611,2,5,1,0)="^8994.021^3^3^3191203^^^^"
^XWB(8994,4611,2,5,1,1,0)="DSSOUSR - optional (only required if DSSOADM'=1)- DUZ of user for which "
^XWB(8994,4611,2,5,1,2,0)="to pull order history - New Person file (#200) IEN;  if full report is "
^XWB(8994,4611,2,5,1,3,0)="requested by an admin, this field should be null."
^XWB(8994,4611,2,6,0)="DSSOIEN^1^30^0^6"
^XWB(8994,4611,2,6,1,0)="^8994.021^2^2^3201015^^^^"
^XWB(8994,4611,2,6,1,1,0)="This is the last IEN # returned by a previous call to this RPC.  This is "
^XWB(8994,4611,2,6,1,2,0)="to be used for chunking data across multiple calls."
^XWB(8994,4611,2,7,0)="DSSOSTS^1^1^1^7"
^XWB(8994,4611,2,7,1,0)="^^5^5^3210806^"
^XWB(8994,4611,2,7,1,1,0)="Status - indicates whether to return reconciled or unreconciled"
^XWB(8994,4611,2,7,1,2,0)="purchase card orders from the PROSTHETICS 1358 file (#664) based"
^XWB(8994,4611,2,7,1,3,0)="on the value of SUPPLY STATUS (file 442 field #.5):"
^XWB(8994,4611,2,7,1,4,0)="  ""R"" - reconciled"
^XWB(8994,4611,2,7,1,5,0)="  ""U"" - unreconciled"
^XWB(8994,4611,2,"B","DSSO6699",1)=""
^XWB(8994,4611,2,"B","DSSOADM",2)=""
^XWB(8994,4611,2,"B","DSSOBDT",3)=""
^XWB(8994,4611,2,"B","DSSOEDT",4)=""
^XWB(8994,4611,2,"B","DSSOIEN",6)=""
^XWB(8994,4611,2,"B","DSSOSTS",7)=""
^XWB(8994,4611,2,"B","DSSOUSR",5)=""
^XWB(8994,4611,2,"PARAMSEQ",1,1)=""
^XWB(8994,4611,2,"PARAMSEQ",2,2)=""
^XWB(8994,4611,2,"PARAMSEQ",3,3)=""
^XWB(8994,4611,2,"PARAMSEQ",4,4)=""
^XWB(8994,4611,2,"PARAMSEQ",5,5)=""
^XWB(8994,4611,2,"PARAMSEQ",6,6)=""
^XWB(8994,4611,2,"PARAMSEQ",7,7)=""
^XWB(8994,4611,3,0)="^^106^106^3210806^"
^XWB(8994,4611,3,1,0)="   Error Messages:    DSSORET(0)=""-1^""_error message or"
^XWB(8994,4611,3,2,0)="   Warning Messages:  DSSORET(0)=""0^""_warning message"
^XWB(8994,4611,3,3,0)="   Successful Processing:"
^XWB(8994,4611,3,4,0)="     For each purchase card order returned, several lines will be"
^XWB(8994,4611,3,5,0)="     returned:"
^XWB(8994,4611,3,6,0)="       DSSORET(n)="
^XWB(8994,4611,3,7,0)="        PO Line 1:"
^XWB(8994,4611,3,8,0)="           ^-piece 1:  File 664 IEN"
^XWB(8994,4611,3,9,0)="           ^-piece 2:  Text ""FLDS-1"""
^XWB(8994,4611,3,10,0)="           ^-piece 3:  IFCAP Order (full PO number)"
^XWB(8994,4611,3,11,0)="           ^-piece 4:  Vendor (external format)"
^XWB(8994,4611,3,12,0)="           ^-piece 5:  Not used"
^XWB(8994,4611,3,13,0)="           ^-piece 6:  Total Ordered"
^XWB(8994,4611,3,14,0)="           ^-piece 7:  Last 4 digits of Purchase Card Number"
^XWB(8994,4611,3,15,0)="           ^-piece 8:  Date Ordered (external format)"
^XWB(8994,4611,3,16,0)="           ^-piece 9:  Date Reconciled (external format)"
^XWB(8994,4611,3,17,0)="           ^-piece 10: Total Reconciled"
^XWB(8994,4611,3,18,0)="           ^-piece 11: Not Used"
^XWB(8994,4611,3,19,0)="           ^-piece 12: Initiator"
^XWB(8994,4611,3,20,0)=" "
^XWB(8994,4611,3,21,0)="        PO Line 2:"
^XWB(8994,4611,3,22,0)="           ^-piece 1:  File 664 IEN"
^XWB(8994,4611,3,23,0)="           ^-piece 2:  Text ""FLDS-2"""
^XWB(8994,4611,3,24,0)="           ^-piece 3:  Station"
^XWB(8994,4611,3,25,0)="           ^-piece 4:  Cancellation Date"
^XWB(8994,4611,3,26,0)="           ^-piece 5:  Act. Shipping Charge"
^XWB(8994,4611,3,27,0)="           ^-piece 6:  Est. Shipping Charge"
^XWB(8994,4611,3,28,0)="           ^-piece 7:  Line Item Count"
^XWB(8994,4611,3,29,0)="           ^-piece 8:  Patient Name (Last,First MI)"
^XWB(8994,4611,3,30,0)="           ^-piece 9:  Supply Status"
^XWB(8994,4611,3,31,0)="           ^-piece 10: Days since P.O. DATE - stops"
^XWB(8994,4611,3,32,0)="                       incrementing if CLOSE OUT DATE is populated"
^XWB(8994,4611,3,33,0)="           ^-piece 11: FCP (external format)"
^XWB(8994,4611,3,34,0)="           ^-piece 12: Final Charge (file 440.6 field #44)"
^XWB(8994,4611,3,35,0)="                =1 if this is the final charge"
^XWB(8994,4611,3,36,0)="                =0 if not the final charge"
^XWB(8994,4611,3,37,0)="           ^-piece 13: Not Used"
^XWB(8994,4611,3,38,0)=" "
^XWB(8994,4611,3,39,0)="       PO Line 3+ - these dates are to be displayed as the Transaction"
^XWB(8994,4611,3,40,0)="         Dates for the purchase card order.  There may be more than one"
^XWB(8994,4611,3,41,0)="         line of Transaction Dates:"
^XWB(8994,4611,3,42,0)="           ^-piece 1:   File 664 IEN"
^XWB(8994,4611,3,43,0)="           ^-piece 2:   ""BILLING DATES-""_x where x=line number of the"
^XWB(8994,4611,3,44,0)="                        line of TRANSACTION DATEs from file 440.6"
^XWB(8994,4611,3,45,0)="           ^-piece 3+:  Repeating TRANSACTION DATE information:"
^XWB(8994,4611,3,46,0)="               ~-piece 1 TRANSACTION DATE (file 440.6 field #5) for"
^XWB(8994,4611,3,47,0)="                        this purchase card order number."
^XWB(8994,4611,3,48,0)="               ~-piece 2 AMOUNT (file 440.6 field #13)"
^XWB(8994,4611,3,49,0)="               ~-piece 3 RECONCILED INDICATOR"
^XWB(8994,4611,3,50,0)="                         =1 Reconciled"
^XWB(8994,4611,3,51,0)="                         =0 Not Reconciled"
^XWB(8994,4611,3,52,0)="               NOTE: The first TRANSACTION DATE section may contain"
^XWB(8994,4611,3,53,0)="                     message: ""0~No Billing Dates found."""
^XWB(8994,4611,3,54,0)=" "
^XWB(8994,4611,3,55,0)="       PO Line n to n+1 (where n=# of billing items in file 664) -"
^XWB(8994,4611,3,56,0)="           information for each billing item:"
^XWB(8994,4611,3,57,0)="           ^-piece 1: File 664 IEN"
^XWB(8994,4611,3,58,0)="           ^-piece 2: ""BILLING ITEM"""
^XWB(8994,4611,3,59,0)="           ^-piece 3: Line Item Number"
^XWB(8994,4611,3,60,0)="           ^-piece 4: SHORT DESCRIPTION (file #441 field #.05)"
^XWB(8994,4611,3,61,0)="           ^-piece 5: TOTAL COST (file #660 field #14)"
^XWB(8994,4611,3,62,0)="           ^-piece 6: BRIEF DESCRIPTION (file 664 subfile 664.02 #1)"
^XWB(8994,4611,3,63,0)=" "
^XWB(8994,4611,3,64,0)="       Last Billing Item Line - SHIPPING/DELIVERY Charge - if there is no"
^XWB(8994,4611,3,65,0)="         shipping charge, then this line doesn't exist:"
^XWB(8994,4611,3,66,0)="           ^-piece 1: File 664 IEN"
^XWB(8994,4611,3,67,0)="           ^-piece 2: ""BILLING ITEM"""
^XWB(8994,4611,3,68,0)="           ^-piece 3: Line Item Number"
^XWB(8994,4611,3,69,0)="           ^-piece 4: ""*DELIVERY"" (to be used as Item Description) if"
^XWB(8994,4611,3,70,0)="                      there are no line items in the PO but"
^XWB(8994,4611,3,71,0)="                      there is a SHIPPING ENTRY (field #13) in the"
^XWB(8994,4611,3,72,0)="                      PROSTHETICS 1358 file (#664)"
^XWB(8994,4611,3,73,0)=" "
^XWB(8994,4611,3,74,0)="                  or  ""*SHIPPING"" (to be used as Item Description) if"
^XWB(8994,4611,3,75,0)="                      there are line items and a SHIPPING"
^XWB(8994,4611,3,76,0)="                      ENTRY (field #13) in the PROSTHETICS 1358 file"
^XWB(8994,4611,3,77,0)="                      (#664)"
^XWB(8994,4611,3,78,0)=" "
^XWB(8994,4611,3,79,0)="           ^-piece 5: If ^piece-4 is ""*DELIVERY"", this is the TOTAL COST"
^XWB(8994,4611,3,80,0)="                      (field #14) from the RECORD OF PROS APPLIANCE/"
^XWB(8994,4611,3,81,0)="                      REPAIR (#660)"
^XWB(8994,4611,3,82,0)=" "
^XWB(8994,4611,3,83,0)="                  or  If ^-piece 4 is ""*SHIPPING"", this is the SHIP/DEL"
^XWB(8994,4611,3,84,0)="                      (field #6) from the RECORD OF PROS APPLIANCE/REPAIR"
^XWB(8994,4611,3,85,0)="                      (#660)."
^XWB(8994,4611,3,86,0)=" "
^XWB(8994,4611,3,87,0)="       Last PO Line  - Comments from file 23645.1 for this simplified"
^XWB(8994,4611,3,88,0)="                       purchase card order - only viewable by the "
^XWB(8994,4611,3,89,0)="                       Initiator of the PO"
^XWB(8994,4611,3,90,0)="           ^-piece 1: File 664 IEN"
^XWB(8994,4611,3,91,0)="           ^-piece 2: ""COM"""
^XWB(8994,4611,3,92,0)="           ^-piece 3: Comments from file 23645.1"
^XWB(8994,4611,3,93,0)="           ^-piece 4: Timestamp (legacy comment date will be 1000101)"
^XWB(8994,4611,3,94,0)="           ^-piece 5: User"
^XWB(8994,4611,3,95,0)=" "
^XWB(8994,4611,3,96,0)="       If a node begins with ""$$CONT$$"", this means the node should be"
^XWB(8994,4611,3,97,0)="       appended to the previous node and treated as a single record."
^XWB(8994,4611,3,98,0)=" "
^XWB(8994,4611,3,99,0)=" If the final result of a call begins with ""$$MORE$$"", the end date was"
^XWB(8994,4611,3,100,0)=" not reached.  It will be formatted as follows:"
^XWB(8994,4611,3,101,0)=" "
^XWB(8994,4611,3,102,0)="        p1 = $$MORE$$"
^XWB(8994,4611,3,103,0)="        p2 = Last date processed; to be used as DSSOBDT in next call"
^XWB(8994,4611,3,104,0)="        p3 = Last IEN processed; to be used as DSSOIEN in next call"
^XWB(8994,4611,3,105,0)=" "
^XWB(8994,4611,3,106,0)=" If the final node equals ""$$END$$"", the report is complete."
^XWB(8994,4612,0)="DSSO FIND VENDOR BY DUNS^MATCHVEN^DSSOUTM^4^^^^1"
^XWB(8994,4612,1,0)="^8994.01^3^3^3190611^"
^XWB(8994,4612,1,1,0)="This RPC returns a list of vendors by Dun & Bradstreet # starting from "
^XWB(8994,4612,1,2,0)="the input value.  Both active and inactive vendors are returned.  "
^XWB(8994,4612,1,3,0)="Inactive vendors are specified by ""**""_Vendor Name."
^XWB(8994,4612,2,0)="^8994.02A^2^2"
^XWB(8994,4612,2,1,0)="DSSODUNS^1^13^1^1"
^XWB(8994,4612,2,1,1,0)="^^1^1^3190611^"
