^XWB(8994,4964,0)="SDES2 REACTIVATE CLINIC^REACTIVATECLIN^SDES2REACTTCLIN^2^R^0^^0^1^^1"
^XWB(8994,4964,1,0)="^^5^5^3250214^"
^XWB(8994,4964,1,1,0)="This RPC reactivates a clinic from HOSPITAL LOCATION File (#44) IEN. It will"
^XWB(8994,4964,1,2,0)="remove the leading 'ZZ' from the clinic name if it doesn't create a name "
^XWB(8994,4964,1,3,0)="conflict."
^XWB(8994,4964,1,4,0)=" "
^XWB(8994,4964,1,5,0)="Can only be invoked by Acheron"
^XWB(8994,4964,2,0)="^8994.02A^2^2"
^XWB(8994,4964,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,4964,2,1,1,0)="^^10^10^3240617^"
^XWB(8994,4964,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,4964,2,1,1,2,0)="                          Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,4964,2,1,1,3,0)="SDCONTEXT(""USER DUZ"")   = The DUZ of the user taking action on the"
^XWB(8994,4964,2,1,1,4,0)="                          calling application. "
^XWB(8994,4964,2,1,1,5,0)="SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,4964,2,1,1,6,0)="                          calling application."
^XWB(8994,4964,2,1,1,7,0)="SDCONTEXT(""PATIENT DFN"")= The name of the patient taking action on the"
^XWB(8994,4964,2,1,1,8,0)="                          calling application."
^XWB(8994,4964,2,1,1,9,0)="SDCONTEXT(""PATIENT ICN"")= The ICN of the patient taking action on the"
^XWB(8994,4964,2,1,1,10,0)="                          calling application."
^XWB(8994,4964,2,2,0)="SDPARAM^2^32000^1^2"
^XWB(8994,4964,2,2,1,0)="3^8994.021^3^3^3250214^"
^XWB(8994,4964,2,2,1,1,0)="SDPARAM(""CLINIC IEN"")=       Clinic IEN in HOSPITAL LOCATION file (#44)"
^XWB(8994,4964,2,2,1,2,0)="                             (required)"
^XWB(8994,4964,2,2,1,3,0)="SDPARAM(""REACTIVATION DATE"") ISO DATE to reactivate the clinic (required)"
^XWB(8994,4964,2,"B","SDCONTEXT",1)=""
^XWB(8994,4964,2,"B","SDPARAM",2)=""
^XWB(8994,4964,2,"PARAMSEQ",1,1)=""
^XWB(8994,4964,2,"PARAMSEQ",2,2)=""
