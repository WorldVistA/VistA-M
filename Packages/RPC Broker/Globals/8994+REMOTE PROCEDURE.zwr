^XWB(8994,5036,3,14,0)="                         ""PersonClass"": ["
^XWB(8994,5036,3,15,0)="                                 """","
^XWB(8994,5036,3,16,0)="                         ],"
^XWB(8994,5036,3,17,0)="                         ""Phone3"": """","
^XWB(8994,5036,3,18,0)="                         ""Phone4"": """","
