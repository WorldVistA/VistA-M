^XWB(8994,4954,0)="DSIR C & P LIST^NOTE^DSIRCNP^4^^^^1"
^XWB(8994,4954,1,0)="^8994.01^6^6^3211222^^^"
^XWB(8994,4954,1,1,0)="Returns a list of all requests with a non-closed status and has at least "
^XWB(8994,4954,1,2,0)="one document that is in the list of C & P Exam titles, with the current "
^XWB(8994,4954,1,3,0)="date being at least 19 working days."
^XWB(8994,4954,1,4,0)=" "
^XWB(8994,4954,1,5,0)="the Return:  "
^XWB(8994,4954,1,6,0)=" REQ^Name of Patient^Clerk^Record Date^Record date + 20 biz days"
^XWB(8994,4954,3,0)="^8994.03^1^1^3210225^^"
^XWB(8994,4954,3,1,0)="Request^Name of Patient^Clerk^Record date^Record date + 20 biz days"
^XWB(8994,4955,0)="DSIR C&P LOOKUP^CPLU^DSIRCNP^4^^^^1"
^XWB(8994,4955,1,0)="^^2^2^3211222^"
^XWB(8994,4955,1,1,0)="This remote procedure does lookups on the DSIR ROI INSTANCE file (#19620)"
^XWB(8994,4955,1,2,0)="and returns compensation and pension requests if any."
^XWB(8994,4955,2,0)="^8994.02A^1^1"
^XWB(8994,4955,2,1,0)="IEN^1^320^1^1"
^XWB(8994,4955,2,1,1,0)="^8994.021^1^1^3210308^^"
^XWB(8994,4955,2,1,1,1,0)="The IEN to 19620"
^XWB(8994,4955,2,"B","IEN",1)=""
^XWB(8994,4955,2,"PARAMSEQ",1,1)=""
^XWB(8994,4955,3,0)="^8994.03^4^4^3210308^^"
^XWB(8994,4955,3,1,0)="Returns a list of data of Comp & Pen data"
^XWB(8994,4955,3,2,0)=" "
^XWB(8994,4955,3,3,0)=";IEN(19620.1)^Name of Patient^Clerk^DOCUMENT_DATE_TIME^20 BIZ DAYS FROM "
^XWB(8994,4955,3,4,0)="DOCUMENT DATE^DATE REQUEST RECEIVED^IEN(19620)^STATUS OF RECORD"
^XWB(8994,4956,0)="DSIR UPDATE CNP^CKCNP^DSIRUTL^1^P^^^1^8.2"
^XWB(8994,4956,1,0)="^^3^3^3220429^"
^XWB(8994,4956,1,1,0)="Given a pointer to file 19620 check file 19620.1 for"
^XWB(8994,4956,1,2,0)="any compensation and pesion documents.  If there are"
^XWB(8994,4956,1,3,0)="any set the flag to 1 otherwise set it to null."
^XWB(8994,4956,2,0)="^8994.02A^1^1"
^XWB(8994,4956,2,1,0)="DSIRIEN^1^100^1^1"
^XWB(8994,4956,2,1,1,0)="^^1^1^3220429^"
^XWB(8994,4956,2,1,1,1,0)="Pointer to DSIR ROI INSTANCE (#19620)."
^XWB(8994,4956,2,"B","DSIRIEN",1)=""
^XWB(8994,4956,2,"PARAMSEQ",1,1)=""
^XWB(8994,4956,3,0)="^^1^1^3220429^"
^XWB(8994,4956,3,1,0)="1 if cnp found or 0 if none found."
^XWB(8994,4957,0)="DSIR ADD DOCUMENTS^NEWITEMS^DSIROIM^4^P^^^1^8.2"
^XWB(8994,4957,1,0)="^8994.01^2^2^3230105^^"
^XWB(8994,4957,1,1,0)="RPC to add multiple documents to a request with one call instead of one "
^XWB(8994,4957,1,2,0)="at a time."
^XWB(8994,4957,2,0)="^8994.02A^1^1"
^XWB(8994,4957,2,1,0)="DSIRDATA^2^32000^1^1"
^XWB(8994,4957,2,1,1,0)="^^1^1^3230105^"
^XWB(8994,4957,2,1,1,1,0)="Array of document data to add to a request."
^XWB(8994,4957,2,"B","DSIRDATA",1)=""
^XWB(8994,4957,2,"PARAMSEQ",1,1)=""
^XWB(8994,4957,3,0)="^^5^5^3230105^"
^XWB(8994,4957,3,1,0)="Global array of results of the add functions."
^XWB(8994,4957,3,2,0)=" "
^XWB(8994,4957,3,3,0)="1^ien for success"
^XWB(8994,4957,3,4,0)="or"
^XWB(8994,4957,3,5,0)="-1^message for failure"
^XWB(8994,4958,0)="DSIR GET TIU NOTES^GETTIU^DSIROIN^4^P^^^1^8.2"
^XWB(8994,4958,1,0)="^^2^2^3230112^"
^XWB(8994,4958,1,1,0)="Given a list of TIU record numbers return the text of the documents in"
^XWB(8994,4958,1,2,0)="an array."
^XWB(8994,4958,2,0)="^8994.02A^1^1"
^XWB(8994,4958,2,1,0)="ARRAY^2^32000^1^1"
^XWB(8994,4958,2,1,1,0)="^^9^9^3230112^"
^XWB(8994,4958,2,1,1,1,0)="List of tiu record numbers and a reference number."
^XWB(8994,4958,2,1,1,2,0)=" "
^XWB(8994,4958,2,1,1,3,0)="Example:"
^XWB(8994,4958,2,1,1,4,0)=" "
^XWB(8994,4958,2,1,1,5,0)="S ARRAY(1)=""132711^1234"""
^XWB(8994,4958,2,1,1,6,0)="S ARRAY(2)=""132738^1235"""
^XWB(8994,4958,2,1,1,7,0)="S ARRAY(3)=132735^1236"""
^XWB(8994,4958,2,1,1,8,0)="S ARRAY(4)=132732^1237"""
^XWB(8994,4958,2,1,1,9,0)="S ARRAY(5)=""132729^1238"""
^XWB(8994,4958,2,"B","ARRAY",1)=""
^XWB(8994,4958,2,"PARAMSEQ",1,1)=""
^XWB(8994,4958,3,0)="^^18^18^3230112^"
^XWB(8994,4958,3,1,0)="Tiu text of the tiu iens that were sent in:"
^XWB(8994,4958,3,2,0)=" "
^XWB(8994,4958,3,3,0)="Example:"
^XWB(8994,4958,3,4,0)=" "
^XWB(8994,4958,3,5,0)="^TMP(""DSIROIN"",25920,1,132711,0)=""NR^132711^1234"""
^XWB(8994,4958,3,6,0)="^TMP(""DSIROIN"",25920,1,132711,1)="" LOCAL TITLE: "
^XWB(8994,4958,3,7,0)="UNKNOWN                                            """
^XWB(8994,4958,3,8,0)="^TMP(""DSIROIN"",25920,1,132711,2)=""DATE OF NOTE: JAN 04, 1990@13:26     "
^XWB(8994,4958,3,9,0)="ENTRY DATE: APR 13, 1993@09:27:56      """
^XWB(8994,4958,3,10,0)="^TMP(""DSIROIN"",25920,1,132711,3)=""      AUTHOR: KRWHJBD,CXEY         EXP "
^XWB(8994,4958,3,11,0)="COSIGNER:                           """
^XWB(8994,4958,3,12,0)="^TMP(""DSIROIN"",25920,1,132711,4)=""     "
^XWB(8994,4958,3,13,0)="URGENCY:                            STATUS:                               "
^XWB(8994,4958,3,14,0)=""""
^XWB(8994,4958,3,15,0)="^TMP(""DSIROIN"",25920,1,132711,5)="""""
^XWB(8994,4958,3,16,0)="^TMP(""DSIROIN"",25920,1,132711,6)=""   *** UNKNOWN Has ADDENDA ***"""
^XWB(8994,4958,3,17,0)="^TMP(""DSIROIN"",25920,1,132711,7)="""""
^XWB(8994,4958,3,18,0)="^TMP(""DSIROIN"",25920,1,132711,8)="""""
^XWB(8994,4959,0)="SDES2 EDIT PAT PRE-REG^EDITPREREG^SDES2EDITPREREG^2^R^0^1^^^^1"
^XWB(8994,4959,1,0)="^8994.01^4^4^3250717^^"
^XWB(8994,4959,1,1,0)="Updates patient pre-registration and associated files when a Vetlink "
^XWB(8994,4959,1,2,0)="Kiosk pre-register event occurs."
^XWB(8994,4959,1,3,0)=" "
^XWB(8994,4959,1,4,0)="Can only be invoked by Acheron"
^XWB(8994,4959,2,0)="^8994.02A^2^2"
^XWB(8994,4959,2,1,0)="SDCONTEXT^2^^1^1"
^XWB(8994,4959,2,1,1,0)="^^14^14^3230926^"
^XWB(8994,4959,2,1,1,1,0)=" SDCONTEXT(""ACHERON AUDIT ID"") = 36 character unique ID number."
^XWB(8994,4959,2,1,1,2,0)=" Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,4959,2,1,1,3,0)="  "
^XWB(8994,4959,2,1,1,4,0)=" SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action on the calling "
^XWB(8994,4959,2,1,1,5,0)=" application."
^XWB(8994,4959,2,1,1,6,0)="                  "
^XWB(8994,4959,2,1,1,7,0)=" SDCONTEXT(""USER SECID"") = The Security ID of the user taking action on"
^XWB(8994,4959,2,1,1,8,0)=" the calling application."
^XWB(8994,4959,2,1,1,9,0)="  "
^XWB(8994,4959,2,1,1,10,0)=" SDCONTEXT(""PATIENT DFN"") = The DFN of the Veteran/user taking action"
^XWB(8994,4959,2,1,1,11,0)=" on the calling application."
^XWB(8994,4959,2,1,1,12,0)=" "
^XWB(8994,4959,2,1,1,13,0)=" SDCONTEXT(""PATIENT ICN"") = The ICN of the Veteran/user taking action "
^XWB(8994,4959,2,1,1,14,0)=" on the calling application."
^XWB(8994,4959,2,2,0)="PARAMS^2^^1^2"
^XWB(8994,4959,2,2,1,0)="^^16^16^3250717^"
^XWB(8994,4959,2,2,1,1,0)=" PARAMS(""DFN"")     - DFN for the Pre-Registration Call."
^XWB(8994,4959,2,2,1,2,0)=" "
^XWB(8994,4959,2,2,1,3,0)=" PARAMS(""STATUS CODE"") - Status Code for the Pre-Registration Call:"
^XWB(8994,4959,2,2,1,4,0)=" "
^XWB(8994,4959,2,2,1,5,0)="     'B' = 'BUSY'"
^XWB(8994,4959,2,2,1,6,0)="     'C' = 'CONNECTED'"
^XWB(8994,4959,2,2,1,7,0)="     'D' = 'DEATH'"
^XWB(8994,4959,2,2,1,8,0)="     'K' = 'CALL BACK'"
^XWB(8994,4959,2,2,1,9,0)="     'M' = 'LEFT CALLBACK MESSAGE'"
^XWB(8994,4959,2,2,1,10,0)="     'N' = 'NO ANSWER'"
^XWB(8994,4959,2,2,1,11,0)="     'P' = 'NO PHONE'"
^XWB(8994,4959,2,2,1,12,0)="     'T' = 'DON'T CALL'"
^XWB(8994,4959,2,2,1,13,0)="     'U' = 'UNCOOPERATIVE'"
^XWB(8994,4959,2,2,1,14,0)="     'V' = 'PREVIOUSLY UPDATED'"
^XWB(8994,4959,2,2,1,15,0)="     'W' = 'WRONG NUMBER'"
^XWB(8994,4959,2,2,1,16,0)="     'X' = 'CHANGE INFORMATION'"
^XWB(8994,4959,2,"B","PARAMS",2)=""
^XWB(8994,4959,2,"B","SDCONTEXT",1)=""
^XWB(8994,4959,2,"PARAMSEQ",1,1)=""
^XWB(8994,4959,2,"PARAMSEQ",2,2)=""
^XWB(8994,4959,3,0)="^8994.03^20^20^3250717^^^"
