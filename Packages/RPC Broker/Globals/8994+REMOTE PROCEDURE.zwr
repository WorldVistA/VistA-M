^XWB(8994,5118,2,0)="^8994.02A^7^7"
^XWB(8994,5118,2,1,0)="IBICN^1^40^1^1"
^XWB(8994,5118,2,1,1,0)="^^2^2^3231022^"
^XWB(8994,5118,2,1,1,1,0)=" This is the patient's ICN used to identify the patient at a remote "
^XWB(8994,5118,2,1,1,2,0)="  facility."
