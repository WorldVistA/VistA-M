^XWB(8994,4262,2,"PARAMSEQ",1,1)=""
^XWB(8994,4262,3,0)="^^8^8^3131028^"
^XWB(8994,4262,3,1,0)="Output:"
^XWB(8994,4262,3,2,0)="  Error Messages:  DSSORET(0)=""-1^error message"" or ""0^error message"""
^XWB(8994,4262,3,3,0)="  Successful Completion:  Returns file 420.5 IEN along with external "
^XWB(8994,4262,3,4,0)="                          values of the Name (field #.01) and Full"
^XWB(8994,4262,3,5,0)="                          Name (field #1) of the Unit of Issue file"
^XWB(8994,4262,3,6,0)="                          (#420.5)."
^XWB(8994,4262,3,7,0)="                          Format: "
^XWB(8994,4262,3,8,0)="                          DSSORET(n)=420.5 IEN^Name^Full Name"
^XWB(8994,4263,0)="DSSO RETRIEVE PROS SITES^RTRV6699^DSSOUTS^4^A^0^^1"
^XWB(8994,4263,1,0)="^8994.01^3^3^3171012^^^^"
^XWB(8994,4263,1,1,0)="This RPC provides a list of sites from the Prosthetics Site Parameter "
^XWB(8994,4263,1,2,0)="file (#669.9).  If a list is required for the NPPD Station when creating "
^XWB(8994,4263,1,3,0)="a work order, parameter NPPD must be set to 1."
^XWB(8994,4263,2,0)="^8994.02A^3^3"
^XWB(8994,4263,2,1,0)="DSSOFR^1^30^0^1"
^XWB(8994,4263,2,1,1,0)="^8994.021^3^3^3131029^^^^"
^XWB(8994,4263,2,1,1,1,0)="This field is a free-text starting value for the list of Prosthetics"
^XWB(8994,4263,2,1,1,2,0)="sites.  If it is not provided, a list of all sites in file 669.9 will be "
^XWB(8994,4263,2,1,1,3,0)="returned."
^XWB(8994,4263,2,2,0)="DSSONPPD^1^1^0^2"
^XWB(8994,4263,2,2,1,0)="^^4^4^3171012^"
^XWB(8994,4263,2,2,1,1,0)="DSSONPPD = 1 indicates that the ""C"" index must be used in filtering "
^XWB(8994,4263,2,2,1,2,0)="the NPPD Station List when creating a work order.  Otherwise, the ""B"""
^XWB(8994,4263,2,2,1,3,0)="index is used to return all sites in the Prosthetics Site Parameters file"
^XWB(8994,4263,2,2,1,4,0)="(#669.9)."
^XWB(8994,4263,2,3,0)="DSSONUM^1^4^0^3"
^XWB(8994,4263,2,3,1,0)="^8994.021^1^1^3171012^^^"
^XWB(8994,4263,2,3,1,1,0)="DSSONUM - maximum number of records to return - defaults to 1000"
^XWB(8994,4263,2,"B","DSSOFR",1)=""
^XWB(8994,4263,2,"B","DSSONPPD",2)=""
^XWB(8994,4263,2,"B","DSSONUM",3)=""
^XWB(8994,4263,2,"B","NPPD",2)=""
^XWB(8994,4263,2,"PARAMSEQ",1,1)=""
^XWB(8994,4263,2,"PARAMSEQ",2,2)=""
^XWB(8994,4263,2,"PARAMSEQ",3,3)=""
^XWB(8994,4263,3,0)="^8994.03^7^7^3171012^^^"
^XWB(8994,4263,3,1,0)="Output:"
^XWB(8994,4263,3,2,0)="  Error Message:  ""-1^error message"" or ""0^warning message"""
^XWB(8994,4263,3,3,0)="  Successful Completion: "
^XWB(8994,4263,3,4,0)="    DSSORET(N)=File 669.9 IEN^File 669.9 field .01 Site Name^^"
^XWB(8994,4263,3,5,0)="                File 669.9 field 1 Station (external)^^"
^XWB(8994,4263,3,6,0)="                File 669.9 field 1 Station (internal)^4"
^XWB(8994,4263,3,7,0)="                File 4 field 99 Station Number "
^XWB(8994,4264,0)="DSSO FIND INSTITUTION SITES^FINDSTES^DSSOUTS^4^A^0^^1"
^XWB(8994,4264,1,0)="^8994.01^1^1^3220916^^^^"
^XWB(8994,4264,1,1,0)="This RPC provides a list of sites from the Institution file (#4)."
^XWB(8994,4264,2,0)="^8994.02A^2^2"
^XWB(8994,4264,2,1,0)="DSSOFR^1^30^1^1"
^XWB(8994,4264,2,1,1,0)="^8994.021^2^2^3140214^^"
^XWB(8994,4264,2,1,1,1,0)="Starting value for the list of sites - must be at least 3"
^XWB(8994,4264,2,1,1,2,0)="characters and no longer than 30 characters"
^XWB(8994,4264,2,2,0)="DSSONUM^1^4^0^2"
^XWB(8994,4264,2,2,1,0)="^8994.021^1^1^3220916^^"
^XWB(8994,4264,2,2,1,1,0)="DSSONUM - maximum number of sites to return"
^XWB(8994,4264,2,"B","DSSOFR",1)=""
^XWB(8994,4264,2,"B","DSSONUM",2)=""
^XWB(8994,4264,2,"PARAMSEQ",1,1)=""
^XWB(8994,4264,2,"PARAMSEQ",2,2)=""
^XWB(8994,4264,3,0)="^^14^14^3220916^"
^XWB(8994,4264,3,1,0)="Output:"
^XWB(8994,4264,3,2,0)="  Error Messages:  ""-1^error message"" or ""0^warning message"""
^XWB(8994,4264,3,3,0)="  Successful Completion:"
^XWB(8994,4264,3,4,0)="    A global array of sites from the Institution file (#4) beginning with "
^XWB(8994,4264,3,5,0)="    the requested value.  Format:"
^XWB(8994,4264,3,6,0)="     DSSORET(n)="
^XWB(8994,4264,3,7,0)="       ^-piece 1 - File 4 IEN "
^XWB(8994,4264,3,8,0)="       ^-piece 2 - File 4 field .01 Site Name (internal) "
^XWB(8994,4264,3,9,0)="       ^-piece 3 - File 4 field 99 Station Number (external)"
^XWB(8994,4264,3,10,0)="       ^-piece 4 - File 4 field .02 State (external) "
^XWB(8994,4264,3,11,0)="       ^-piece 5 - File 4 field 1.01 Street Addr. 1 (external)"
^XWB(8994,4264,3,12,0)="       ^-piece 6 - File 4 field 1.02 Street Addr. 2 (external)  "
^XWB(8994,4264,3,13,0)="       ^-piece 7 - File 4 field 1.03 City (external) "
^XWB(8994,4264,3,14,0)="       ^-piece 8 - File 4 field 1.04 Zip (external)"
^XWB(8994,4265,0)="DSSO RETRIEVE NEW PERSON^RTRVPRSN^DSSOOU1^4^A^0^^1"
^XWB(8994,4265,1,0)="^8994.01^1^1^3140214^^^^"
^XWB(8994,4265,1,1,0)="This RPC returns entries from the New Person file (#200)."
^XWB(8994,4265,2,0)="^8994.02A^1^1"
^XWB(8994,4265,2,1,0)="DSSONPR^1^35^1^1"
^XWB(8994,4265,2,1,1,0)="^^1^1^3140214^"
^XWB(8994,4265,2,1,1,1,0)="Null, partial value, or exact name of New Person"
^XWB(8994,4265,2,"B","DSSONPR",1)=""
^XWB(8994,4265,2,"PARAMSEQ",1,1)=""
^XWB(8994,4265,3,0)="^8994.03^5^5^3140214^^^^"
^XWB(8994,4265,3,1,0)="Output:"
^XWB(8994,4265,3,2,0)="  Error Messages:  DSSORET(0)=""-1^error message"" or ""0^warning message"""
^XWB(8994,4265,3,3,0)="  Successful Completion:  Returns file 200 IEN along with external formats"
^XWB(8994,4265,3,4,0)="                          of Name (field #.01) and Title (field #8)."
^XWB(8994,4265,3,5,0)="    DSSORET(n)=File 200 IEN^File 200 Name^File 200 Title"
^XWB(8994,4266,0)="DSSO FIND DEVICE^RTRVDVC^DSSOOU1^4^A^0^^1"
^XWB(8994,4266,1,0)="^8994.01^2^2^3170421^^^"
^XWB(8994,4266,1,1,0)="This RPC returns entries from the Device file (#3.5) based on a "
^XWB(8994,4266,1,2,0)="requested starting value."
^XWB(8994,4266,2,0)="^8994.02A^2^2"
^XWB(8994,4266,2,1,0)="DSSODVC^1^30^1^1"
^XWB(8994,4266,2,1,1,0)="^^1^1^3170327^"
^XWB(8994,4266,2,1,1,1,0)="This required field contains a partial value or exact name of a Device.  "
^XWB(8994,4266,2,1,1,2,0)="It must be a least three and no more than 30 characters."
^XWB(8994,4266,2,2,0)="DSSONUM^1^4^0^2"
^XWB(8994,4266,2,2,1,0)="^^1^1^3170421^"
^XWB(8994,4266,2,2,1,1,0)="The maximum number of records to return - defaults to 500."
^XWB(8994,4266,2,"B","DSSODVC",1)=""
^XWB(8994,4266,2,"B","DSSONUM",2)=""
^XWB(8994,4266,2,"PARAMSEQ",1,1)=""
^XWB(8994,4266,2,"PARAMSEQ",2,2)=""
^XWB(8994,4266,3,0)="^^5^5^3170421^"
^XWB(8994,4266,3,1,0)="Output:"
^XWB(8994,4266,3,2,0)="  Error Messages:  "
^XWB(8994,4266,3,3,0)="    DSSORET(0)=""-1^error message"" or ""0^error message"""
^XWB(8994,4266,3,4,0)="  Successful Completion:"
^XWB(8994,4266,3,5,0)="    DSSORET(n)=File 3.5 IEN^File 3.5 field #.01 Name"
^XWB(8994,4267,0)="DSSO OWL DETAIL^PODT^DSSOODT^4^A^0^^1"
^XWB(8994,4267,1,0)="^^7^7^3140206^"
^XWB(8994,4267,1,1,0)="This RPC provides data from the Prosthetics 2529-3 file (#664.1) for the "
^XWB(8994,4267,1,2,0)="OWL Detail screen. "
^XWB(8994,4267,1,3,0)="NOTE:  The patient's masked Social Security Number is also concatenated to"
^XWB(8994,4267,1,4,0)="the internal value returned for Patient (file 664.1 field .02)."
^XWB(8994,4267,1,5,0)="    The Extended Description (subfile 664.16 field 7) is returned with"
^XWB(8994,4267,1,6,0)="word-processing field line numbers rather than ""E"" (external format) or "
^XWB(8994,4267,1,7,0)="""I"" (internal)."
^XWB(8994,4267,2,0)="^8994.02A^2^2"
^XWB(8994,4267,2,1,0)="IEN6641^1^15^0^1"
^XWB(8994,4267,2,1,1,0)="^8994.021^2^2^3140206^^^"
^XWB(8994,4267,2,1,1,1,0)="Prosthetics 2529-3 IEN (file 664.1).  If the Work Order Number is not "
^XWB(8994,4267,2,1,1,2,0)="input, then this field must be input."
^XWB(8994,4267,2,2,0)="WONBR^1^20^0^2"
^XWB(8994,4267,2,2,1,0)="^8994.021^2^2^3140206^^^^"
^XWB(8994,4267,2,2,1,1,0)="The Work Order Number - 1-20 characters.  If the IEN of file 664.1 is not "
^XWB(8994,4267,2,2,1,2,0)="input, then this field must be input."
^XWB(8994,4267,2,"B","IEN6641",1)=""
^XWB(8994,4267,2,"B","WONBR",2)=""
^XWB(8994,4267,2,"PARAMSEQ",1,1)=""
^XWB(8994,4267,2,"PARAMSEQ",2,2)=""
^XWB(8994,4267,3,0)="^^19^19^3140206^"
^XWB(8994,4267,3,1,0)="Output:"
^XWB(8994,4267,3,2,0)="  Error Messages:  ""-1^error message"" or ""0^warning message"""
^XWB(8994,4267,3,3,0)="  Successful Completion:"
^XWB(8994,4267,3,4,0)="    Two lines are returned for each non-multiple field in file 664.1:"
^XWB(8994,4267,3,5,0)="    (Note: Only the internal format line is returned for the .01 field.)"
^XWB(8994,4267,3,6,0)="      DSSORET(n)=""664.1^IEN^Field Nbr^""E""^value"""
^XWB(8994,4267,3,7,0)="      DSSORET(n)=""664.1^IEN^Field Nbr^""I""^value"""
^XWB(8994,4267,3,8,0)=" "
^XWB(8994,4267,3,9,0)="NOTE:  The patient's masked Social Security Number is also concatenated to"
^XWB(8994,4267,3,10,0)="the internal value returned for Patient (file 664.1 field .02)."
^XWB(8994,4267,3,11,0)="  Example:"
^XWB(8994,4267,3,12,0)="    664.1^36^.02^E^PROS,OFFICIAL"
^XWB(8994,4267,3,13,0)="    664.1^36^.02^I^101025^XXX-XX-5678"
^XWB(8994,4267,3,14,0)=" "
^XWB(8994,4267,3,15,0)="    The Extended Description word processing field (subfile 664.16 field "
^XWB(8994,4267,3,16,0)="7) is returned in the following format:"
^XWB(8994,4267,3,17,0)="       664.16^1^7^1^EXTENDED DESC 1"
^XWB(8994,4267,3,18,0)="       664.16^1^7^2^EXTENDED DESC line 2^EXTENDED DESC line 2"
^XWB(8994,4267,3,19,0)="       664.16^1^7^31^EXTENDED DESC line 3"
^XWB(8994,4268,0)="DSSO OWL ADD ON LIST RMKS^WP66422^DSSOOWA^4^A^0^^1"
^XWB(8994,4268,1,0)="^8994.01^3^3^3170517^^^^"
^XWB(8994,4268,1,1,0)="This RPC returns the Remarks word-processing field for the requested "
^XWB(8994,4268,1,2,0)="Materials Used multiple (#664.22) in the Prosthetic Work Order"
^XWB(8994,4268,1,3,0)="file (#664.2)."
^XWB(8994,4268,2,0)="^8994.02A^2^2"
^XWB(8994,4268,2,1,0)="DSSO6642^1^30^1^1"
^XWB(8994,4268,2,1,1,0)="^8994.021^1^1^3170517^^"
^XWB(8994,4268,2,1,1,1,0)="The IEN of the Prosthetic Work Order (#664.2) file"
^XWB(8994,4268,2,2,0)="DSSO66422^1^30^1^2"
^XWB(8994,4268,2,2,1,0)="^8994.021^2^2^3170517^^^^"
^XWB(8994,4268,2,2,1,1,0)="The IEN of the Materials Used multiple (#664.22) from the Prosthetic Work "
^XWB(8994,4268,2,2,1,2,0)="Order file (#664.2) from which the Remarks data is returned"
^XWB(8994,4268,2,"B","DSSO6642",1)=""
^XWB(8994,4268,2,"B","DSSO66422",2)=""
^XWB(8994,4268,2,"B","IEN6642",1)=""
^XWB(8994,4268,2,"B","IEN66422",2)=""
^XWB(8994,4268,2,"PARAMSEQ",1,1)=""
^XWB(8994,4268,2,"PARAMSEQ",2,2)=""
^XWB(8994,4268,3,0)="^8994.03^6^6^3170517^^^^"
^XWB(8994,4268,3,1,0)="Output:"
^XWB(8994,4268,3,2,0)="  Error Messages:"
^XWB(8994,4268,3,3,0)="    ""-1^""_error message"
^XWB(8994,4268,3,4,0)="    ""0^""_warning message"
^XWB(8994,4268,3,5,0)="  Successful Message:"
^XWB(8994,4268,3,6,0)="    DSSORET(n)=word-processing field data"
^XWB(8994,4269,0)="DSSO OWL ASSIGN TECHNICIAN^ASGNTECH^DSSOOWO^1^A^0"
^XWB(8994,4269,1,0)="^8994.01^1^1^3170519^^"
^XWB(8994,4269,1,1,0)="This RPC is used to assign the initial technician to the work order."
^XWB(8994,4269,2,0)="^8994.02A^3^3"
^XWB(8994,4269,2,1,0)="DSSOIE1^1^30^1^1"
^XWB(8994,4269,2,1,1,0)="^^1^1^3140109^"
^XWB(8994,4269,2,1,1,1,0)="Prosthetics 2529-3 IEN (file #664.1))"
^XWB(8994,4269,2,2,0)="DSSOTCH^1^30^1^2"
^XWB(8994,4269,2,2,1,0)="^^1^1^3140109^"
^XWB(8994,4269,2,2,1,1,0)="New Person (file #200) IEN of Technician "
^XWB(8994,4269,2,3,0)="DSSOCHG^1^1^0^3"
^XWB(8994,4269,2,3,1,0)="^8994.021^6^6^3170519^^"
^XWB(8994,4269,2,3,1,1,0)="This flag indicates whether the technician is to be replaced if the work "
^XWB(8994,4269,2,3,1,2,0)="order is already assigned."
^XWB(8994,4269,2,3,1,3,0)="  DSSOCHG = 1 -> Work Order is already assigned, but user wants to "
^XWB(8994,4269,2,3,1,4,0)="proceed in changing the initial technician."
^XWB(8994,4269,2,3,1,5,0)="  DSSOCHG = 0 -> The user will receive a warning message if an initial "
^XWB(8994,4269,2,3,1,6,0)="technician is already assigned.  Processing ends."
^XWB(8994,4269,2,"B","DSSOCHG",3)=""
^XWB(8994,4269,2,"B","DSSOIE1",1)=""
^XWB(8994,4269,2,"B","DSSOTCH",2)=""
^XWB(8994,4269,2,"PARAMSEQ",1,1)=""
^XWB(8994,4269,2,"PARAMSEQ",2,2)=""
^XWB(8994,4269,2,"PARAMSEQ",3,3)=""
^XWB(8994,4269,3,0)="^^8^8^3170519^"
^XWB(8994,4269,3,1,0)="Returns a single value."
^XWB(8994,4269,3,2,0)=" "
^XWB(8994,4269,3,3,0)="Error Messages:"
^XWB(8994,4269,3,4,0)="  -1^Error Message"""
^XWB(8994,4269,3,5,0)="Warning Message:"
^XWB(8994,4269,3,6,0)="  ""0^This Work Order has already been assigned."""
^XWB(8994,4269,3,7,0)="Successful Message:"
^XWB(8994,4269,3,8,0)="  ""1^Technician added successfully."""
^XWB(8994,4270,0)="DSSO DPT GET DEMO^DEM^DSSOPT^2^A"
^XWB(8994,4270,1,0)="^8994.01^9^9^3170516^^"
^XWB(8994,4270,1,1,0)="This RPC returns specific demographic elements for a patient.  The "
^XWB(8994,4270,1,2,0)="routine was cloned from DSICDPT1 with two fields being added to the"
^XWB(8994,4270,1,3,0)="return:"
^XWB(8994,4270,1,4,0)="VAEL(3) -List[30] - Eligibility Status - If the SERVICE CONNECTED? field"
^XWB(8994,4270,1,5,0)="is YES, a ""1"" will be returned in the first piece; otherwise, a ""0"" will"
^XWB(8994,4270,1,6,0)="be returned.  If service-connected, the SERVICE CONNECTED PERCENTAGE field"
^XWB(8994,4270,1,7,0)="will be returned in the second piece.  (e.g., 1^70)"
^XWB(8994,4270,1,8,0)=" "
^XWB(8994,4270,1,9,0)="VAEL(7) - Claim Number - List[32]"
^XWB(8994,4270,2,0)="^8994.02A^5^5"
^XWB(8994,4270,2,1,0)="DSSODFN^1^20^0^1"
^XWB(8994,4270,2,1,1,0)="^^3^3^3170516^"
^XWB(8994,4270,2,1,1,1,0)="This is the patient's DFN or pointer to the Patient file (#2)."
^XWB(8994,4270,2,1,1,2,0)=" "
^XWB(8994,4270,2,1,1,3,0)="DFN or SSN must be passed."
^XWB(8994,4270,2,2,0)="DSSOSSN^1^10^0^2"
^XWB(8994,4270,2,2,1,0)="^8994.021^3^3^3170516^^"
^XWB(8994,4270,2,2,1,1,0)="This is the patient's 9 (or 10) digit SSN."
^XWB(8994,4270,2,2,1,2,0)=" "
^XWB(8994,4270,2,2,1,3,0)="Either SSN or DFN are required. "
^XWB(8994,4270,2,3,0)="DSSOPRM^1^1^0^3"
^XWB(8994,4270,2,3,1,0)="^8994.021^3^3^3170516^^"
^XWB(8994,4270,2,3,1,1,0)="This is a Boolean flag (1 or 0).  The default value is zero.  If one, "
^XWB(8994,4270,2,3,1,2,0)="then always return the patient's permanent address information; "
^XWB(8994,4270,2,3,1,3,0)="otherwise, return as configured in the MAS software."
^XWB(8994,4270,2,4,0)="DSSOCNF^1^13^0^4"
^XWB(8994,4270,2,4,1,0)="^^17^17^3170516^"
^XWB(8994,4270,2,4,1,1,0)="This flag determines whether or not to return the confidential address "
^XWB(8994,4270,2,4,1,2,0)="information.  It is optional.  If this is passed, then TODAY will be the "
^XWB(8994,4270,2,4,1,3,0)="default date to use to check to see if a confidential address is active "
^XWB(8994,4270,2,4,1,4,0)="for that date."
^XWB(8994,4270,2,4,1,5,0)=" "
^XWB(8994,4270,2,4,1,6,0)="  DSSOCNF - optional - p1^p2"
^XWB(8994,4270,2,4,1,7,0)="       p1 - required - confidential address category - this is a string of"
^XWB(8994,4270,2,4,1,8,0)="                       one or more numerics, e.g. - 134, where category"
^XWB(8994,4270,2,4,1,9,0)="                       numbers are:"
^XWB(8994,4270,2,4,1,10,0)="                         1 for Eligibility/Enrollment"
^XWB(8994,4270,2,4,1,11,0)="                         2 for Appointment/Scheduling"
^XWB(8994,4270,2,4,1,12,0)="                         3 for Copayments/Veterans Billing"
^XWB(8994,4270,2,4,1,13,0)="                         4 for Medical Records"
^XWB(8994,4270,2,4,1,14,0)="                         5 for All Others"
^XWB(8994,4270,2,4,1,15,0)=" "
^XWB(8994,4270,2,4,1,16,0)="       p2 - optional - Fileman date to determine if confidential date is"
^XWB(8994,4270,2,4,1,17,0)="                       effective.  Default date is TODAY."
^XWB(8994,4270,2,5,0)="DSSOFLG^1^1^0^5"
^XWB(8994,4270,2,5,1,0)="^8994.021^11^11^3170516^^"
^XWB(8994,4270,2,5,1,1,0)="This Boolean value (1 or 0) will determine the data returned for certain "
^XWB(8994,4270,2,5,1,2,0)="data elements.  The default value is 0.  Any state, county, or zip code "
^XWB(8994,4270,2,5,1,3,0)="data element's return value will be affected by this flag."
^XWB(8994,4270,2,5,1,4,0)="  If DSSOFLG=0, return:"
^XWB(8994,4270,2,5,1,5,0)="     State Abbreviation"
^XWB(8994,4270,2,5,1,6,0)="     a 5- or 9-digit Zip Code "
^XWB(8994,4270,2,5,1,7,0)="     County Name."
^XWB(8994,4270,2,5,1,8,0)="  If DSSOFLG=1, return:"
^XWB(8994,4270,2,5,1,9,0)="     IEN to file 5^State Name^State Abbreviation"
^XWB(8994,4270,2,5,1,10,0)="     Zip Code (internal)^Zip Code (external)"
^XWB(8994,4270,2,5,1,11,0)="     multiple IEN value^County Name."
^XWB(8994,4270,2,"B","DFN",1)=""
^XWB(8994,4270,2,"B","DSICONF",4)=""
^XWB(8994,4270,2,"B","DSIFLG",5)=""
^XWB(8994,4270,2,"B","DSSOCNF",4)=""
^XWB(8994,4270,2,"B","DSSODFN",1)=""
^XWB(8994,4270,2,"B","DSSOFLG",5)=""
^XWB(8994,4270,2,"B","DSSOPRM",3)=""
^XWB(8994,4270,2,"B","DSSOSSN",2)=""
^XWB(8994,4270,2,"B","PERM",3)=""
^XWB(8994,4270,2,"B","SSN",2)=""
^XWB(8994,4270,2,"PARAMSEQ",1,1)=""
^XWB(8994,4270,2,"PARAMSEQ",2,2)=""
^XWB(8994,4270,2,"PARAMSEQ",3,3)=""
^XWB(8994,4270,2,"PARAMSEQ",4,4)=""
^XWB(8994,4270,2,"PARAMSEQ",5,5)=""
^XWB(8994,4270,3,0)="^^50^50^3170516^"
^XWB(8994,4270,3,1,0)="On error return -1^error message"
^XWB(8994,4270,3,2,0)="Else return:"
^XWB(8994,4270,3,3,0)=" DSSODAT()  Description"
^XWB(8994,4270,3,4,0)=" ----------  --------------------------------------------"
^XWB(8994,4270,3,5,0)="     1       Patient Name"
^XWB(8994,4270,3,6,0)="     2       SSN;Dashed SSN"
^XWB(8994,4270,3,7,0)="     3       DOB(internal);DOB(external)"
^XWB(8994,4270,3,8,0)="     4       Age"
^XWB(8994,4270,3,9,0)="     5       Sex"
^XWB(8994,4270,3,10,0)="     6       Date of Death(internal);Date of Death(external)"
^XWB(8994,4270,3,11,0)="     7       Race"
^XWB(8994,4270,3,12,0)="     8       Religion"
^XWB(8994,4270,3,13,0)="     9       Marital Status"
^XWB(8994,4270,3,14,0)="    10       Employment Status"
^XWB(8994,4270,3,15,0)="    11       1st Street Address Line"
^XWB(8994,4270,3,16,0)="    12       2nd Street Address Line"
^XWB(8994,4270,3,17,0)="    13       3rd Street Address Line"
^XWB(8994,4270,3,18,0)="    14       City"
^XWB(8994,4270,3,19,0)="    15       State Abbreviation [or IEN^State Name^State Abbreviation]"
^XWB(8994,4270,3,20,0)="    16       Zip (9 or 5) [or Zip(internal)^Zip(external)]"
^XWB(8994,4270,3,21,0)="    17       County [or multiple IEN^County Name]"
^XWB(8994,4270,3,22,0)="    18       Home Phone"
^XWB(8994,4270,3,23,0)="    19       Work Phone"
^XWB(8994,4270,3,24,0)="    20       LastName^FirstName^Middle^Suffix/Title"
^XWB(8994,4270,3,25,0)=" ---- DSSODAT(21 - DSSODAT(28) all refer to confidential address  ----"
^XWB(8994,4270,3,26,0)="    21       Confidential Address category bitmap.  Default value of "
^XWB(8994,4270,3,27,0)="             ""00000"".  This is a 5-character string of 0s and 1s where "
^XWB(8994,4270,3,28,0)="             each bit refers to whether or not the particular category"
^XWB(8994,4270,3,29,0)="             is active or not as of the date in the DSICONF parameter."
^XWB(8994,4270,3,30,0)="             Only those categories requested in DSICONF parameter will"
^XWB(8994,4270,3,31,0)="             have a bit value of 1:"
^XWB(8994,4270,3,32,0)="    22       Street Address 1"
^XWB(8994,4270,3,33,0)="    23       Street Address 2"
^XWB(8994,4270,3,34,0)="    24       Street Address 3"
^XWB(8994,4270,3,35,0)="    25       City"
^XWB(8994,4270,3,36,0)="    26       State Abbreviation [or IEN^State Name^State Abbreviation]"
^XWB(8994,4270,3,37,0)="    27       Zip (9 or 5) [or Zip(internal)^Zip(external)]"
^XWB(8994,4270,3,38,0)="    28       County [or multiple IEN^County Name]"
^XWB(8994,4270,3,39,0)="    "
^XWB(8994,4270,3,40,0)="***********************************************************************"
^XWB(8994,4270,3,41,0)="    29       Primary Eligibility^other elig^other elig^..."
^XWB(8994,4270,3,42,0)="    30       Eligibility Status - If the Service Connected? field is YES,"
^XWB(8994,4270,3,43,0)="             a ""1"" will be returned in the first piece; otherwise, "
^XWB(8994,4270,3,44,0)="             a ""0"" will be returned.  If service connected, the SERVICE"
^XWB(8994,4270,3,45,0)="             CONNECTED PERCENTAGE field will be returned in the second"
^XWB(8994,4270,3,46,0)="             piece."
^XWB(8994,4270,3,47,0)="    31       Equals ""1"" if the patient is a Veteran; otherwise, set to "
^XWB(8994,4270,3,48,0)="             ""0""."
^XWB(8994,4270,3,49,0)="    32       Claim Number "
^XWB(8994,4270,3,50,0)="    33       Current Means Test Status Code^Name"
^XWB(8994,4271,0)="DSSO GET INSTITUTION^GETINST^DSSOUTS^4^^^^1"
^XWB(8994,4271,1,0)="^8994.01^3^3^3140215^^^"
^XWB(8994,4271,1,1,0)="This RPC returns fields .01 - Name, .02 - State, 1.01 - Street Addr. 1, "
^XWB(8994,4271,1,2,0)="1.02 - Street Addr. 2, 1.03 - City, 1.04 - Zip, and 99 - Station Number "
^XWB(8994,4271,1,3,0)="from the Institution File (#4) for the requested IEN."
^XWB(8994,4271,2,0)="^8994.02A^1^1"
^XWB(8994,4271,2,1,0)="DSSOIEN^1^30^1^1"
^XWB(8994,4271,2,1,1,0)="^8994.021^1^1^3140215^^^^"
^XWB(8994,4271,2,1,1,1,0)="IEN of Institution File (#4)"
^XWB(8994,4271,2,"B","DSSOIEN",1)=""
^XWB(8994,4271,2,"PARAMSEQ",1,1)=""
^XWB(8994,4271,3,0)="^^12^12^3140215^"
^XWB(8994,4271,3,1,0)="Output:"
^XWB(8994,4271,3,2,0)="  Error Messages:  ""-1^error message"" or ""0^warning message"""
^XWB(8994,4271,3,3,0)="  Successful Completion:"
^XWB(8994,4271,3,4,0)="    DSSORET(n)=file 4 ien or subfile ien^field #^""E"" or ""I""^data"
^XWB(8994,4271,3,5,0)="      for the following fields:  "
^XWB(8994,4271,3,6,0)="        .01  Name"
^XWB(8994,4271,3,7,0)="        .02  State"
^XWB(8994,4271,3,8,0)="       1.01  Street Addr. 1"
^XWB(8994,4271,3,9,0)="       1.02  Street Addr. 2"
^XWB(8994,4271,3,10,0)="       1.03  City"
^XWB(8994,4271,3,11,0)="       1.04  Zip"
^XWB(8994,4271,3,12,0)="         99  Station Number"
^XWB(8994,4272,0)="DSSO FIND VENDORS^FINDVEN^DSSOUTV^4^^^^1"
^XWB(8994,4272,1,0)="^8994.01^3^3^3220527^^^^"
^XWB(8994,4272,1,1,0)="This RPC returns a list of vendors beginning with the input value or by "
^XWB(8994,4272,1,2,0)="the specific IEN.  Both active and inactive vendors are returned.  "
^XWB(8994,4272,1,3,0)="Inactive vendors are specified by ""**""_Vendor Name."
^XWB(8994,4272,2,0)="^8994.02A^2^2"
^XWB(8994,4272,2,1,0)="DSSONUM^1^6^0^1"
^XWB(8994,4272,2,1,1,0)="^8994.021^1^1^3220527^^"
^XWB(8994,4272,2,1,1,1,0)="The maximum number of records to be returned - defaults to 1000."
^XWB(8994,4272,2,2,0)="DSSOVEN^1^36^1^2"
^XWB(8994,4272,2,2,1,0)="^8994.021^2^2^3220527^^^"
^XWB(8994,4272,2,2,1,1,0)="Starting value of vendor name, exact vendor name,"
^XWB(8994,4272,2,2,1,2,0)="or specific Vendor File (#440) IEN"
^XWB(8994,4272,2,"B","DSSONUM",1)=""
^XWB(8994,4272,2,"B","DSSOVEN",2)=""
^XWB(8994,4272,2,"PARAMSEQ",1,1)=""
^XWB(8994,4272,2,"PARAMSEQ",2,2)=""
^XWB(8994,4272,3,0)="^^24^24^3220527^"
^XWB(8994,4272,3,1,0)="Output:"
^XWB(8994,4272,3,2,0)="Error Messages:  DSSORET(0)=""-1""_error message or ""0""^_warning message"
^XWB(8994,4272,3,3,0)=" "
^XWB(8994,4272,3,4,0)="Successful Completion:  A list of active and inactive vendor names and"
^XWB(8994,4272,3,5,0)="identifying information from the Vendor File (#440) starting from the"
^XWB(8994,4272,3,6,0)="requested value in the format:"
^XWB(8994,4272,3,7,0)="  pc 1  .01  Name - internal value - file 440 IEN"
^XWB(8994,4272,3,8,0)="  pc 2  .01  Name - external value"
^XWB(8994,4272,3,9,0)="  pc 3  1    Ordering Address1"
^XWB(8994,4272,3,10,0)="  pc 4  2    Ordering Address2"
^XWB(8994,4272,3,11,0)="  pc 5  3    Ordering Address3"
^XWB(8994,4272,3,12,0)="  pc 6  4    Ordering Address4"
^XWB(8994,4272,3,13,0)="  pc 7  4.2  Ordering City"
^XWB(8994,4272,3,14,0)="  pc 8  4.4  Ordering State"
^XWB(8994,4272,3,15,0)="  pc 9  4.6  Ordering Zip Code"
^XWB(8994,4272,3,16,0)="  pc 10 5    Vendor Phone Number"
^XWB(8994,4272,3,17,0)="  pc 11      Not used"
^XWB(8994,4272,3,18,0)="  pc 12 46   Fax #"
^XWB(8994,4272,3,19,0)="  pc 13 18.3 Dun & Bradstreet"
^XWB(8994,4272,3,20,0)="  pc 14 8.3  Business Type"
^XWB(8994,4272,3,21,0)="  pc 15 55   UEI"
^XWB(8994,4272,3,22,0)="  pc 16 5.1  Account No."
^XWB(8994,4272,3,23,0)=" "
^XWB(8994,4272,3,24,0)="Inactive vendors are indicated by ""**""_Vendor Name."
^XWB(8994,4273,0)="DSSO FM FIND^FIND^DSSOFM5^4^A^^^1"
^XWB(8994,4273,1,0)="^8994.01^7^7^3140313^^"
^XWB(8994,4273,1,1,0)="This provides a wrapper around the FIND^DIC API.  It exposes more of the"
^XWB(8994,4273,1,2,0)="functionality of the API to the RPC than the old DSIC DDR FINDER RPC."
^XWB(8994,4273,1,3,0)=" "
^XWB(8994,4273,1,4,0)="For a lookup value, this RPC will return all matches.  It allows for"
^XWB(8994,4273,1,5,0)="input a multiple screening logic which would be ANDed together."
^XWB(8994,4273,1,6,0)=" "
^XWB(8994,4273,1,7,0)="This RPC is cloned from DSIC FM FIND."
^XWB(8994,4273,2,0)="^8994.02A^1^1"
^XWB(8994,4273,2,1,0)="INPUT^2^250^1^1"
^XWB(8994,4273,2,1,1,0)="^^7^7^3140313^"
^XWB(8994,4273,2,1,1,1,0)="The INPUT(n) = tag^value   where"
^XWB(8994,4273,2,1,1,2,0)="   tag = LIST^DIC input parameter name such as"
^XWB(8994,4273,2,1,1,3,0)="         FILE  IENS  FIELDS  FLAGS  NUMBER  INDEX  VAL  SCREEN"
^XWB(8994,4273,2,1,1,4,0)="   value = value for that input parameter"
^XWB(8994,4273,2,1,1,5,0)=" "
^XWB(8994,4273,2,1,1,6,0)="For those input parameters that allow an array, you can pass that array"
^XWB(8994,4273,2,1,1,7,0)="in the tag such as SCREEN()^lookup value"
^XWB(8994,4273,2,"B","INPUT",1)=""
^XWB(8994,4273,2,"PARAMSEQ",1,1)=""
^XWB(8994,4273,3,0)="^^10^10^3140313^"
^XWB(8994,4273,3,1,0)=" Iif problem, return one or more rows:s return one or more rows:"
^XWB(8994,4273,3,2,0)="    List[0] = - 1^message"
^XWB(8994,4273,3,3,0)="    List[n] = message  or  -1^message   for n=1,2,3,4,..."
^XWB(8994,4273,3,4,0)=" "
^XWB(8994,4273,3,5,0)=" Return entries found that match the input value:"
^XWB(8994,4273,3,6,0)="    List[n] = results    where n=0,1,2,3,4,..."
^XWB(8994,4273,3,7,0)="    1st ^-piece of results is the ien for the record from that file"
^XWB(8994,4273,3,8,0)="    2nd ^-piece equals the value of the field in the 1st ;-piece of FIELDS"
^XWB(8994,4273,3,9,0)="    3rd ^-piece equals the value of the field in the 2nd ;-piece of FIELDS"
^XWB(8994,4273,3,10,0)="    etc., etc., ...."
^XWB(8994,4274,0)="DSSO FM LIST^LIST^DSSOFM5^4^A^^^1"
^XWB(8994,4274,1,0)="^^7^7^3140313^"
^XWB(8994,4274,1,1,0)="The RPC provides a wrapper around the LIST^DIC API.  It exposes more of"
^XWB(8994,4274,1,2,0)="the functionality of the API than the DSIC DDR LISTER RPC."
^XWB(8994,4274,1,3,0)=" "
^XWB(8994,4274,1,4,0)="For a lookup value, return all entries starting from that lookup value"
^XWB(8994,4274,1,5,0)="and which collates after that lookup value."
^XWB(8994,4274,1,6,0)=" "
^XWB(8994,4274,1,7,0)="This RPC was cloned from DSIC FM LIST."
^XWB(8994,4274,2,0)="^8994.02A^1^1"
^XWB(8994,4274,2,1,0)="INPUT^2^250^1^1"
^XWB(8994,4274,2,1,1,0)="^^9^9^3140313^"
^XWB(8994,4274,2,1,1,1,0)="The INPUT(n) = tag^value  where"
^XWB(8994,4274,2,1,1,2,0)="   tag = LIST^DIC input parameter name such as"
^XWB(8994,4274,2,1,1,3,0)="         FILE  IENS  FIELDS  FLAGS  NUMBER  INDEX  FROM  PART  SCREEN"
^XWB(8994,4274,2,1,1,4,0)="   value = value for that input parameter"
^XWB(8994,4274,2,1,1,5,0)=" "
^XWB(8994,4274,2,1,1,6,0)="The INDEX variable consists only of a single index name."
^XWB(8994,4274,2,1,1,7,0)=" "
^XWB(8994,4274,2,1,1,8,0)="For those input parameters that allow an array, you can pass that array"
^XWB(8994,4274,2,1,1,9,0)="in the tag such as FROM(2)^lookup value"
^XWB(8994,4274,2,"B","INPUT",1)=""
^XWB(8994,4274,2,"PARAMSEQ",1,1)=""
^XWB(8994,4274,3,0)="^^11^11^3140313^"
^XWB(8994,4274,3,1,0)="If problems, return List[0] = -1^error message."
^XWB(8994,4274,3,2,0)="There may be addtional messages on subsequent lines "
^XWB(8994,4274,3,3,0)="  where List[n]=message  or  -1^message  for n = 1,2,3,4,..."
^XWB(8994,4274,3,4,0)=" "
^XWB(8994,4274,3,5,0)="Return values in list[n] = data  where n = 0,1,2,3,4,..."
^XWB(8994,4274,3,6,0)="  1st ^-piece of data is the ien for that record"
^XWB(8994,4274,3,7,0)="  2nd ^-piece is the value of the field in the 1st ;-piece of FIELDS"
^XWB(8994,4274,3,8,0)="  4th ^-piece is the value of the field in the 3rd ;-piece of FIELDS"
^XWB(8994,4274,3,9,0)="   etc., etc., ..."
^XWB(8994,4274,3,10,0)=" "
^XWB(8994,4274,3,11,0)=" 3rd ^-piece is the value of the field in the 2nd ;-piece of FIELDS"
^XWB(8994,4275,0)="DSSO XPD LAST INSTALL^RLAST^DSSOXPD^1"
^XWB(8994,4275,1,0)="^^4^4^3180223^"
^XWB(8994,4275,1,1,0)="This RPC returns the latest completely-installed version of a KIDS build"
^XWB(8994,4275,1,2,0)="from the Install file (#9.7).  This RPC is intended for use for"
^XWB(8994,4275,1,3,0)="applications that do not have an entry in the Package file (#9.4)"
^XWB(8994,4275,1,4,0)="(i.e. - APAT); however, it may be used for any application."
^XWB(8994,4275,2,0)="^8994.02A^2^2"
^XWB(8994,4275,2,1,0)="DSSOINNM^1^50^1^1"
^XWB(8994,4275,2,1,1,0)="^^2^2^3180223^"
^XWB(8994,4275,2,1,1,1,0)="Required - the namespace of the application (i.e. - DSSO).  The"
^XWB(8994,4275,2,1,1,2,0)="version number and patch number may be entered but are unnecessary."
^XWB(8994,4275,2,2,0)="DSSOFUN^1^1^0^2"
^XWB(8994,4275,2,2,1,0)="^^1^1^3180223^"
^XWB(8994,4275,2,2,1,1,0)="If $G(DSSOFUN) then extrinsic function, else RPC."
^XWB(8994,4275,2,"B","DSSOFUN",2)=""
^XWB(8994,4275,2,"B","DSSOINNM",1)=""
^XWB(8994,4275,2,"B","INSTLNME",1)=""
^XWB(8994,4275,2,"PARAMSEQ",1,1)=""
^XWB(8994,4275,2,"PARAMSEQ",2,2)=""
^XWB(8994,4275,3,0)="^^8^8^3180223^"
^XWB(8994,4275,3,1,0)="Output:"
^XWB(8994,4275,3,2,0)="  Error Message:  ""-1^""_error message"" or ""0^""_warning message"
^XWB(8994,4275,3,3,0)="  Successful Completion:"
^XWB(8994,4275,3,4,0)="  Last Completed Installation in format:"
^XWB(8994,4275,3,5,0)="    Version Number from Build file (#9.6)^Status^Install Complete"
^XWB(8994,4275,3,6,0)="    Date^ File Comment"
^XWB(8994,4275,3,7,0)="    Note:  Only entries whose Status (field #.02) in the Install"
^XWB(8994,4275,3,8,0)="           file (file #9.7) is 3 (Install Completed) are returned."
^XWB(8994,4276,0)="DSSO DTLD CRT 442 1-PO NBR^CRT442^DSSODP0^1"
^XWB(8994,4276,1,0)="^8994.01^19^19^3170426^^"
^XWB(8994,4276,1,1,0)="APAT RPC to get the next Common Numbering Series number from the PAT"
^XWB(8994,4276,1,2,0)="Number file (#442.6) and create a purchase order in the Procurement &"
^XWB(8994,4276,1,3,0)="Accounting Transactions file (#442)."
^XWB(8994,4276,1,4,0)=" "
^XWB(8994,4276,1,5,0)="Input:"
^XWB(8994,4276,1,6,0)="  DSSODUZ      - User or initiator of an order"
^XWB(8994,4276,1,7,0)="  DSSO411      - IEN of file #411 - Admin. Activity Site Parameter"
^XWB(8994,4276,1,8,0)="  DSSOPCD      - IEN of file #440.5 - Purchase Card file"
^XWB(8994,4276,1,9,0)="  DSSOVEN      - IEN of file #440 - Vendor file"
^XWB(8994,4276,1,10,0)="  DSSOCNS      - IEN of file #442.6 - PAT Number file (contains Common"
^XWB(8994,4276,1,11,0)="                  Numbering Series)"
^XWB(8994,4276,1,12,0)="  DSSOPDT      - P.O. Date"
^XWB(8994,4276,1,13,0)="  DSSOSRC      - IEN of file 420.8 - Source Code file"
^XWB(8994,4276,1,14,0)=" "
^XWB(8994,4276,1,15,0)="Output:"
