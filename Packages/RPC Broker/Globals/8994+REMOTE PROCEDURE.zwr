^XWB(8994,2976,3,1,0)="The array contains the internal numbers of the entries in file 19620."
^XWB(8994,2977,0)="DSIROIC WPFILER WP FILER^WPFILER^DSIROIC^1"
^XWB(8994,2977,1,0)="^8994.01^2^2^3111208^^^^"
^XWB(8994,2977,1,1,0)="This RPC is used to update comments is several places withing the Release "
^XWB(8994,2977,1,2,0)="of Information Record Manager (ROI/DSIR)"
^XWB(8994,2977,2,0)="^8994.02A^3^3"
^XWB(8994,2977,2,1,0)="IEN^1^20^1^1"
^XWB(8994,2977,2,1,1,0)="^^2^2^3110721^"
^XWB(8994,2977,2,1,1,1,0)="The IEN (Internal Entry Number) is the location within the file where "
^XWB(8994,2977,2,1,1,2,0)="the data is to be filed."
^XWB(8994,2977,2,2,0)="TYPE^1^1^1^2"
^XWB(8994,2977,2,2,1,0)="^^5^5^3110721^"
^XWB(8994,2977,2,2,1,1,0)=" TYPE    - Must be ""C"", ""I"", ""A"", OR ""R"" as follows:"
^XWB(8994,2977,2,2,1,2,0)="           Regular comments (19620,.31)(C)"
^XWB(8994,2977,2,2,1,3,0)="           Internal Comments (19620,.32)(I) "
^XWB(8994,2977,2,2,1,4,0)="           Annotations (19620.98,100)(A)"
