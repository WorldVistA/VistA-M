^XWB(8994,3690,3,20,0)="     RESULT(4)=""75^A MEDICINE^A M^248^1"""
^XWB(8994,3690,3,21,0)="     RESULT(5)=""695^ADJUDICATION^^^"""
^XWB(8994,3690,3,22,0)="     RESULT(6)=""93^ADMISSION MED^ADM MED^^"""
