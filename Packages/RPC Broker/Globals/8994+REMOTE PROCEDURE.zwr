^XWB(8994,4998,0)="SDES2 QUERY APPT REQUESTS^QUERY^SDES2QRYAPREQS^4^R^^^0^^^1"
^XWB(8994,4998,1,0)="^^6^6^3250214^"
^XWB(8994,4998,1,1,0)="This RPC allows the user to query appointment requests, consults and "
^XWB(8994,4998,1,2,0)="recall requests. The query supports multiple filter criteria such as "
^XWB(8994,4998,1,3,0)="patient(s), clinic(s)/service(s), request types, origination date, "
^XWB(8994,4998,1,4,0)="priority group, PID date, wait time, and urgency (consults only)."
^XWB(8994,4998,1,5,0)=" "
^XWB(8994,4998,1,6,0)="Can only be invoked by Acheron"
^XWB(8994,4998,2,0)="^8994.02A^2^2"
^XWB(8994,4998,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,4998,2,1,1,0)="^8994.021^11^11^3260302^^^"
^XWB(8994,4998,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"")"
^XWB(8994,4998,2,1,1,2,0)=" - Up to 40 Character unique ID number. "
^XWB(8994,4998,2,1,1,3,0)=" - Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,4998,2,1,1,4,0)="SDCONTEXT(""USER DUZ"")"
^XWB(8994,4998,2,1,1,5,0)=" - The DUZ of the user taking action in the calling application."
^XWB(8994,4998,2,1,1,6,0)="SDCONTEXT(""USER SECID"")"
^XWB(8994,4998,2,1,1,7,0)=" - The SECID of the user taking action in the calling application."
^XWB(8994,4998,2,1,1,8,0)="SDCONTEXT(""PATIENT DFN"")"
^XWB(8994,4998,2,1,1,9,0)=" - The DFN/IEN of the target patient from the calling application."
^XWB(8994,4998,2,1,1,10,0)="SDCONTEXT(""PATIENT ICN"")"
^XWB(8994,4998,2,1,1,11,0)=" - The ICN of the target patient from the calling application."
^XWB(8994,4998,2,2,0)="SDINPUT^2^32000^1^2"
^XWB(8994,4998,2,2,1,0)="^^56^56^3260303^"
^XWB(8994,4998,2,2,1,1,0)="This is the list of filter and sort criteria that controls the behavior "
^XWB(8994,4998,2,2,1,2,0)="of the query as well as the sorting and number of records to return."
^XWB(8994,4998,2,2,1,3,0)=" "
^XWB(8994,4998,2,2,1,4,0)=" "
^XWB(8994,4998,2,2,1,5,0)=" SDINPUT(""FILTER"",""PATIENT"",PATIENT IEN)=""""      <- for searching by "
^XWB(8994,4998,2,2,1,6,0)="                                                    patient"
^XWB(8994,4998,2,2,1,7,0)=" SDINPUT(""FILTER"",""REQUEST TYPE"",""APPT"")=""""      <- for APPT"
^XWB(8994,4998,2,2,1,8,0)=" SDINPUT(""FILTER"",""REQUEST TYPE"",""CONSULT"")=""""   <- for CONSULT"
^XWB(8994,4998,2,2,1,9,0)=" SDINPUT(""FILTER"",""REQUEST TYPE"",""RECALL"")=""""    <- for RECALL"
^XWB(8994,4998,2,2,1,10,0)=" SDINPUT(""FILTER"",""REQUEST TYPE"",""ALL"")=""""       <- for ALL request types"
^XWB(8994,4998,2,2,1,11,0)=" SDINPUT(""FILTER"",""REQUEST SUBTYPE"",""APPT"")=""""    <- for APPT requests"
^XWB(8994,4998,2,2,1,12,0)=" SDINPUT(""FILTER"",""REQUEST SUBTYPE"",""RTC"")=""""     <- for RTC requests"
^XWB(8994,4998,2,2,1,13,0)=" SDINPUT(""FILTER"",""REQUEST SUBTYPE"",""VETERAN"")="""" <- for VETERAN requests"
^XWB(8994,4998,2,2,1,14,0)=" SDINPUT(""FILTER"",""REQUEST SUBTYPE"",""ALL"")=""""     <- for ALL request "
^XWB(8994,4998,2,2,1,15,0)="                                                      sub-types (default)"
^XWB(8994,4998,2,2,1,16,0)=" "
^XWB(8994,4998,2,2,1,17,0)=" SDINPUT(""FILTER"",""CLINIC"",CLINIC IEN)="""""
^XWB(8994,4998,2,2,1,18,0)=" SDINPUT(""FILTER"",""SERVICE"",AMIS STOP CODE)="""""
^XWB(8994,4998,2,2,1,19,0)=" SDINPUT(""FILTER"",""PRIORITY GROUP"",""GROUP 0"")="""" <- for group 0"
^XWB(8994,4998,2,2,1,20,0)="                                  ,""GROUP 1"")="""" <- for group 1"
^XWB(8994,4998,2,2,1,21,0)="                                  ,""GROUP 2"")="""" <- for group 2"
^XWB(8994,4998,2,2,1,22,0)="                                  ,""GROUP 3"")="""" <- for group 3"
^XWB(8994,4998,2,2,1,23,0)="                                  ,""GROUP 4"")="""" <- for group 4"
^XWB(8994,4998,2,2,1,24,0)="                                  ,""GROUP 5"")="""" <- for group 5"
^XWB(8994,4998,2,2,1,25,0)="                                  ,""GROUP 6"")="""" <- for group 6"
^XWB(8994,4998,2,2,1,26,0)="                                  ,""GROUP 7"")="""" <- for group 7"
^XWB(8994,4998,2,2,1,27,0)="                                  ,""GROUP 8"")="""" <- for group 8"
^XWB(8994,4998,2,2,1,28,0)="                                  ,""ALL"")=""""     <- for ALL groups"
^XWB(8994,4998,2,2,1,29,0)=" SDINPUT(""FILTER"",""WAIT TIME"")=WAIT TIME"
^XWB(8994,4998,2,2,1,30,0)="                               ALL - for all days"
^XWB(8994,4998,2,2,1,31,0)="                               <30 - less than 30 days"
^XWB(8994,4998,2,2,1,32,0)="                               30-60 - 30 to 60 days"
^XWB(8994,4998,2,2,1,33,0)="                               60-90 - 60 to 90 days"
^XWB(8994,4998,2,2,1,34,0)="                               >=90  - greater than/equal to 90 days"
^XWB(8994,4998,2,2,1,35,0)=" SDINPUT(""FILTER"",""ORIGINATION DATE"")=ORIGINATION DATE"
^XWB(8994,4998,2,2,1,36,0)=" SDINPUT(""FILTER"",""PID"")=PATIENT INDICATED DATE - ALSO DESIRED DATE"
^XWB(8994,4998,2,2,1,37,0)=" SDINPUT(""FILTER"",""URGENCY"")=URGENCY IEN (POINTER TO THE PROTOCOL FILE "
^XWB(8994,4998,2,2,1,38,0)="                             #101) - only applies to consults"
^XWB(8994,4998,2,2,1,39,0)=" SDINPUT(""SORT"")=SORT TYPE"
^XWB(8994,4998,2,2,1,40,0)="                    DEFAULT, PATIENT NAME, CLINIC, REQUEST, WAIT TIME, "
