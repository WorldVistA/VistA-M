^XWB(8994,3583,3,3,0)="  each entry contains the following ^ pieces:"
^XWB(8994,3583,3,4,0)="    1. APPT - Pointer to SDEC APPOINTMENT file"
^XWB(8994,3583,3,5,0)="    2. DATE - Appointment Start time in external format from"
^XWB(8994,3583,3,6,0)="              STARTTIME field of SDEC APPOINTMENT file"
^XWB(8994,3583,3,7,0)="    3. IEN - patient pointer to PATIENT file"
^XWB(8994,3583,3,8,0)="    4. NAME - patient name from PATIENT file"
^XWB(8994,3583,3,9,0)="    5. CLINIEN - Clinic pointer to HOSPITAL LOCATION file"
^XWB(8994,3583,3,10,0)="    6. CLINNAME - Clinic name from HOSPITAL LOCATION file"
^XWB(8994,3583,3,11,0)="    7. DATE1 - Cancel Date/Time in external format from"
^XWB(8994,3583,3,12,0)="               CANCEL DATETIME field"
^XWB(8994,3583,3,13,0)="    8. USERIEN - DATA ENTRY CLERK ien pointer to NEW PERSON file"
^XWB(8994,3583,3,14,0)="    9. USERNAME - DATA ENTRY CLERK name from NEW PERSON file"
^XWB(8994,3583,3,15,0)="   10. PROVIEN - Provider ien from PROVIDER field pointer to"
^XWB(8994,3583,3,16,0)="                 NEW PERSON file"
^XWB(8994,3583,3,17,0)="   11. PROVNAME - provider name of PROVIDER from NEW PERSON file"
^XWB(8994,3583,3,18,0)="   12. STATUS - text from STATUS field valid values are:"
