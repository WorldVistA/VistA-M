^XWB(8994,4477,2,3,1,0)="^^1^1^3191016^"
^XWB(8994,4477,2,3,1,1,0)="This is the patient check information from the eRx processing hub."
^XWB(8994,4477,2,4,0)="DACHK^2^^0^4"
^XWB(8994,4477,2,4,1,0)="^^1^1^3191016^"
^XWB(8994,4477,2,4,1,1,0)="The drug autocheck information from the eRx processing hub."
^XWB(8994,4477,2,5,0)="STATION^1^^0^5"
^XWB(8994,4477,2,5,1,0)="^^1^1^3191016^"
^XWB(8994,4477,2,5,1,1,0)="This is the station number the prescription is being sent to."
^XWB(8994,4477,2,6,0)="DIV^1^^0^6"
^XWB(8994,4477,2,6,1,0)="^^1^1^3191016^"
^XWB(8994,4477,2,6,1,1,0)="The division associated with the incoming eRx."
^XWB(8994,4477,2,7,0)="ERXHID^1^^0^7"
^XWB(8994,4477,2,7,1,0)="^^1^1^3191016^"
