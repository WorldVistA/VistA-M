^XWB(8994,4456,3,48,0)="1^SELF IDENTIFICATION"
^XWB(8994,4457,0)="MPI RETURN PRIMARY VIEW DATA^PVDATA^MPIRPC1^4^P^0^^1^1^^1"
^XWB(8994,4457,1,0)="^8994.01^5^5^3200728^"
^XWB(8994,4457,1,1,0)="This Remote Procedure Call will return Primary View data (File #985) for "
^XWB(8994,4457,1,2,0)=" a specified ICN."
^XWB(8994,4457,1,3,0)="       Example: S ICN=1234567890V123456"
^XWB(8994,4457,1,4,0)="                S SCORE=1 ;(optional)"
^XWB(8994,4457,1,5,0)="                D PVDATA^MPIRPC1(.RET,ICN,SCORE)"
^XWB(8994,4457,2,0)="^8994.02A^2^2"
^XWB(8994,4457,2,1,0)="ICN^1^17^1^2"
^XWB(8994,4457,2,1,1,0)="^^2^2^3200728^"
^XWB(8994,4457,2,1,1,1,0)="This is the Integration Control Number of the patient for whom Primary "
^XWB(8994,4457,2,1,1,2,0)=" View data is requested."
^XWB(8994,4457,2,2,0)="SCORE^1^1^0^3"
^XWB(8994,4457,2,2,1,0)="^^4^4^3200728^"
^XWB(8994,4457,2,2,1,1,0)="Optional parameter:"
^XWB(8994,4457,2,2,1,2,0)="   If set to 1, RPC will return AUTHORITY SCORE values."
^XWB(8994,4457,2,2,1,3,0)="   If null, NO AUTHORITY SCORE values are returned."
^XWB(8994,4457,2,2,1,4,0)=" Input: 1 or Null"
^XWB(8994,4457,2,"B","ICN",1)=""
^XWB(8994,4457,2,"B","SCORE",2)=""
^XWB(8994,4457,2,"PARAMSEQ",2,1)=""
^XWB(8994,4457,2,"PARAMSEQ",3,2)=""
^XWB(8994,4457,3,0)="^^2^2^3200728^"
^XWB(8994,4457,3,1,0)="This Remote Procedure Call will return the Primary View data to the "
^XWB(8994,4457,3,2,0)=" requesting entity."
^XWB(8994,4458,0)="VIAB PATCH^PATCH^VIABRPC^1^P^^^^^^1"
^XWB(8994,4458,1,0)="^^2^2^3200902^"
^XWB(8994,4458,1,1,0)="Calls $$PATCH^XPDUTL to return boolean that indicates whether the patch "
^XWB(8994,4458,1,2,0)="sent in in the string has been installed."
^XWB(8994,4458,2,0)="^8994.02A^1^1"
^XWB(8994,4458,2,1,0)="STR^1^20^1^1"
^XWB(8994,4458,2,1,1,0)="^^3^3^3200902^"
^XWB(8994,4458,2,1,1,1,0)="String value for patch being evaluated.  EX: VIAB*1.0*20"
^XWB(8994,4458,2,1,1,2,0)="Note: you must enter the full patch name. If the above example was VIAB*1*20"
^XWB(8994,4458,2,1,1,3,0)="it would return false as the 1 would not match 1.0."
^XWB(8994,4458,2,"B","STR",1)=""
^XWB(8994,4458,2,"PARAMSEQ",1,1)=""
^XWB(8994,4458,3,0)="^^1^1^3200902^"
^XWB(8994,4458,3,1,0)="Boolean 1= True, 0 = False"
^XWB(8994,4459,0)="DVBA MVI CERNER CORRELATIONS^GETACC^DVBAMVI2^1^P^^^^1"
^XWB(8994,4459,1,0)="^^2^2^3201008^"
^XWB(8994,4459,1,1,0)="This RPC will be used by CAPRI to determine if there are any active Cerner"
^XWB(8994,4459,1,2,0)="correlations for a given ICN."
^XWB(8994,4459,2,0)="^8994.02A^1^1"
^XWB(8994,4459,2,1,0)="ICN^1^20^1^1"
^XWB(8994,4459,2,1,1,0)="^^1^1^3200922^"
^XWB(8994,4459,2,1,1,1,0)="This value should be the ICN (nnnnnnnnnnVxxxxxx) for a given patient."
^XWB(8994,4459,2,"B","ICN",1)=""
^XWB(8994,4459,2,"PARAMSEQ",1,1)=""
^XWB(8994,4459,3,0)="^^2^2^3201008^"
^XWB(8994,4459,3,1,0)="1 (Yes) or 0 (No) indicating if the patient has an active Cerner"
^XWB(8994,4459,3,2,0)="correlation. -1 if an error occurs."
^XWB(8994,4460,0)="MPI GETCORRESPONDINGIDS^^DVBC223P^2^P^0^^^1^^1"
^XWB(8994,4460,1,0)="^^3^3^3201008^"
^XWB(8994,4460,1,1,0)="*** This RPC should not be run locally. *** Added by patch DVBA*2.7*223. "
^XWB(8994,4460,1,2,0)="This RPC will be used by Capri to pull the list of active correlations "
^XWB(8994,4460,1,3,0)="for a given ICN, via HL7 Direct, from the MPI environment."
^XWB(8994,4460,2,0)="^8994.02A^1^1"
^XWB(8994,4460,2,1,0)="ICN^1^20^1^1"
^XWB(8994,4460,2,1,1,0)="^^1^1^3200930^"
^XWB(8994,4460,2,1,1,1,0)="This value should be the ICN (nnnnnnnnnnVxxxxxx) for a given patient."
^XWB(8994,4460,2,"B","ICN",1)=""
^XWB(8994,4460,2,"PARAMSEQ",1,1)=""
^XWB(8994,4460,3,0)="^8994.03^5^5^3201008^^"
^XWB(8994,4460,3,1,0)="The return value will be a list of active correlations in the following "
^XWB(8994,4460,3,2,0)=" format:"
^XWB(8994,4460,3,3,0)="  "
^XWB(8994,4460,3,4,0)=" Return(n)=SourceID^Station#^DateLastTreated^id type^AssigningAuthority^"
^XWB(8994,4460,3,5,0)=" status of ICN or correlation^OID if both 2.4 and 3.0"
^XWB(8994,4461,0)="ORPDMP STRTPDMP^STRTPDMP^ORPDMP^4^^^^1"
^XWB(8994,4461,1,0)="^8994.01^2^2^3200204^^^"
^XWB(8994,4461,1,1,0)="This RPC is used to return PDMP results or to tell CPRS to kick off the "
^XWB(8994,4461,1,2,0)="timer to retrieve PDMP results from a background job."
^XWB(8994,4461,2,0)="^8994.02A^5^4"
