^XWB(8994,3001,3,5,0)="    -1^ERROR MESSAGE"
^XWB(8994,3002,0)="DSIROI4 GETDEM GET DEMOGRAPHIC^GETDEM^DSIROI4^2^^^^"
^XWB(8994,3002,1,0)="^8994.01^1^1^3111207^^^^"
^XWB(8994,3002,1,1,0)="Returns limited demographic data required for processing a request."
^XWB(8994,3002,2,0)="^8994.02A^1^1"
^XWB(8994,3002,2,1,0)="IFN^1^30^1^1"
^XWB(8994,3002,2,1,1,0)="^8994.021^1^1^3111207^^^^"
^XWB(8994,3002,2,1,1,1,0)="IFN - Patient IFN."
^XWB(8994,3002,2,"B","IFN",1)=""
