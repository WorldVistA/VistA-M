^XWB(8994,3392,2,"PARAMSEQ",2,2)=""
^XWB(8994,3392,2,"PARAMSEQ",3,3)=""
^XWB(8994,3392,2,"PARAMSEQ",4,4)=""
^XWB(8994,3392,2,"PARAMSEQ",5,5)=""
^XWB(8994,3392,3,0)="^8994.03^5^5^3150429^^"
^XWB(8994,3392,3,1,0)="Return Array"
^XWB(8994,3392,3,2,0)="   (0) = 0 ^ No records found!"
^XWB(8994,3392,3,3,0)="   (n) = Requestor IEN (19620.12) ^ Requestor Name ^ Inactive (1/0) ^"
^XWB(8994,3392,3,4,0)="         Street Address 1 ^ Street Address 2 ^ Street Address 3 ^ City ^ "
^XWB(8994,3392,3,5,0)="         State Abrv ^ Zip"
^XWB(8994,3393,0)="DSIROI9 INACTRQR INACTIVATE^INACTRQR^DSIROI9^1"
^XWB(8994,3393,1,0)="^^2^2^3150422^"
^XWB(8994,3393,1,1,0)="This RPC should be used to toggle the Inactive field of the DSIR NEW "
^XWB(8994,3393,1,2,0)="REQUESTOR file (#19620.12)."
^XWB(8994,3393,2,0)="^8994.02A^2^2"
^XWB(8994,3393,2,1,0)="IEN^1^99^1^1"
^XWB(8994,3393,2,1,1,0)="^^1^1^3150422^"
^XWB(8994,3393,2,1,1,1,0)="Internal Entry Number to file #19620.12 - DSIR NEW REQUESTOR"
^XWB(8994,3393,2,2,0)="FLG^1^1^0^2"
^XWB(8994,3393,2,2,1,0)="^^1^1^3150422^"
