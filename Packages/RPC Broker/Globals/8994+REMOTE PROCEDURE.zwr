^XWB(8994,3367,0)="VPS GET ALL CLINICS^ALLCLN^VPSRPC10^4^R^^^1^1"
^XWB(8994,3367,1,0)="^8994.01^1^1^3141029^^"
^XWB(8994,3367,1,1,0)="This RPC returns a list of hospital locations (defined in the HOSPITAL LOCATION file), which conform the criteria."
^XWB(8994,3367,2,0)="^8994.02A^6^6"
^XWB(8994,3367,2,1,0)="HLTYPES^1^^^1"
^XWB(8994,3367,2,1,1,0)="^^11^11^3141029^"
^XWB(8994,3367,2,1,1,1,0)="List of location types separated by commas (internal values of the TYPE field of the HOSPITAL LOCATION file):"
^XWB(8994,3367,2,1,1,2,0)="  C  Clinic"
^XWB(8994,3367,2,1,1,3,0)="  F  File Area"
^XWB(8994,3367,2,1,1,4,0)="  I  Imaging"
^XWB(8994,3367,2,1,1,5,0)="  M  Module"
^XWB(8994,3367,2,1,1,6,0)="  N  Non-Clinic Stop"
^XWB(8994,3367,2,1,1,7,0)="  OR Operating Room"
^XWB(8994,3367,2,1,1,8,0)="  W  Ward"
^XWB(8994,3367,2,1,1,9,0)="  Z  Other Location"
^XWB(8994,3367,2,1,1,10,0)=" "
^XWB(8994,3367,2,1,1,11,0)="Only locations of the types defined by this parameter are selected by the remote procedure. By default ($G(HLTYPES)=""""), all locations are selected."
^XWB(8994,3367,2,2,0)="DIVIEN^1^^^2"
^XWB(8994,3367,2,2,1,0)="^^1^1^3141029^"
^XWB(8994,3367,2,2,1,1,0)="Division IEN. If this parameter is defined and greated than zero then only the locations associated with this division are selected."
^XWB(8994,3367,2,3,0)="PART^1^30^^3"
^XWB(8994,3367,2,3,1,0)="^^1^1^3141029^"
^XWB(8994,3367,2,3,1,1,0)="The partial match restriction."
^XWB(8994,3367,2,4,0)="FLAGS^1^^^4"
^XWB(8994,3367,2,4,1,0)="^8994.021^6^6^3141029^^"
^XWB(8994,3367,2,4,1,1,0)="Flags that control the execution (can be combined):"
^XWB(8994,3367,2,4,1,2,0)=" "
^XWB(8994,3367,2,4,1,3,0)="  A  Include active locations (default)"
^XWB(8994,3367,2,4,1,4,0)="  B  Backwards. Traverses the index in the opposite"
^XWB(8994,3367,2,4,1,5,0)="     direction of normal traversal."
^XWB(8994,3367,2,4,1,6,0)="  I  Include inactive locations"
^XWB(8994,3367,2,5,0)="NUMBER^1^^^5"
^XWB(8994,3367,2,5,1,0)="^^1^1^3141029^"
^XWB(8994,3367,2,5,1,1,0)="Maximum number of entries to return. A value of ""*"" or no value in this parameter designates all entries"
^XWB(8994,3367,2,6,0)="FROM^1^^^6"
^XWB(8994,3367,2,6,1,0)="^8994.021^8^8^3141029^^"
^XWB(8994,3367,2,6,1,1,0)="The index entry(s) from which to begin the list"
^XWB(8994,3367,2,6,1,2,0)="  ^01: From Name"
^XWB(8994,3367,2,6,1,3,0)="  ^02: From IEN"
^XWB(8994,3367,2,6,1,4,0)=" "
^XWB(8994,3367,2,6,1,5,0)="For example, a FROM value of ""VA"" would list entries following VA. You can use the 2nd and 3rd ""^""- pieces of the @RESULT@(0) node to continue the listing in the subsequent procedure calls."
^XWB(8994,3367,2,6,1,6,0)=" "
^XWB(8994,3367,2,6,1,7,0)="NOTE: The FROM value itself is not included in the resulting list"
^XWB(8994,3367,2,6,1,8,0)="See description of the LIST^DIC for more details about the PART, NUMBER, and FROM parameters."
^XWB(8994,3367,2,"B","DIVIEN",2)=""
^XWB(8994,3367,2,"B","FLAGS",4)=""
^XWB(8994,3367,2,"B","FROM",6)=""
^XWB(8994,3367,2,"B","HLTYPES",1)=""
^XWB(8994,3367,2,"B","NUMBER",5)=""
^XWB(8994,3367,2,"B","PART",3)=""
^XWB(8994,3367,2,"PARAMSEQ",1,1)=""
^XWB(8994,3367,2,"PARAMSEQ",2,2)=""
^XWB(8994,3367,2,"PARAMSEQ",3,3)=""
^XWB(8994,3367,2,"PARAMSEQ",4,4)=""
^XWB(8994,3367,2,"PARAMSEQ",5,5)=""
^XWB(8994,3367,2,"PARAMSEQ",6,6)=""
^XWB(8994,3367,3,0)="^8994.03^21^21^3141029^^"
^XWB(8994,3367,3,1,0)="A negative value of the first ""^""-piece of the RESULTS(0) indicates that an error occurred during the execution of the remote procedure. In this case, the second piece of the RESULT(0) will contain number of the error descriptors returned in the"
^XWB(8994,3367,3,2,0)=" subsequent nodes of the RESULTS array:"
^XWB(8994,3367,3,3,0)="  RESULTS(0)         Result Descriptior"
^XWB(8994,3367,3,4,0)="                     ^01: The last error code"
^XWB(8994,3367,3,5,0)="                     ^02: Message"
^XWB(8994,3367,3,6,0)=" "
^XWB(8994,3367,3,7,0)="Othewise, number of hospital locations and the value of the FROM parameter for the next procedure call are return in the RESULTS(0) and the subsequent nodes of the global array contain the locations."
^XWB(8994,3367,3,8,0)=" "
^XWB(8994,3367,3,9,0)="  RESULTS(0)          Result Descriptor"
^XWB(8994,3367,3,10,0)="                       ^01: Number of locations"
^XWB(8994,3367,3,11,0)="                       ^02: From Name"
^XWB(8994,3367,3,12,0)="                       ^03: From IEN"
^XWB(8994,3367,3,13,0)=" "
^XWB(8994,3367,3,14,0)="  RESULTS(1..n)       Hospital Location"
^XWB(8994,3367,3,15,0)="                       ^01: IEN"
^XWB(8994,3367,3,16,0)="                       ^02: Name"
^XWB(8994,3367,3,17,0)="                       ^03: Location Type (internal)"
^XWB(8994,3367,3,18,0)="                       ^04: Institution IEN"
^XWB(8994,3367,3,19,0)="                       ^05: Division IEN"
^XWB(8994,3367,3,20,0)="                       ^06: Active (0/1)"
^XWB(8994,3367,3,21,0)="NOTE: The 6th ""^""-piece of the location record (Active) is populated only if both ""A"" and ""I"" flags are used."
^XWB(8994,3368,0)="VPS GET APPOINTMENTS^GET^VPSAPPT^4^^^^1^"
^XWB(8994,3368,1,0)="^8994.01^1^1^3141027^^^^"
^XWB(8994,3368,1,1,0)="This RPC will return appointments for a given data range for a specific Appointment Queue. This RPC will refresh an existing queue with the current appointments and typically need to be called only once a day."
