^XWB(8994,3126,3,0)="^8994.03^7^7^3100421^^^"
^XWB(8994,3126,3,1,0)="This RPC returns an array of name-value pairs of patient record "
^XWB(8994,3126,3,2,0)="attributes, including the following:"
^XWB(8994,3126,3,3,0)=" AOF"
^XWB(8994,3126,3,4,0)=" ASSIGNING ENTITY"
^XWB(8994,3126,3,5,0)=" ENTERPRISE PATIENT ID"
^XWB(8994,3126,3,6,0)=" ID TYPE"
^XWB(8994,3126,3,7,0)="Names and values are separated by tilde (`)."
^XWB(8994,3127,0)="MAGV GET PROC REF ATTS^GETPROCA^MAGVRS08^2^R^0"
^XWB(8994,3127,1,0)="^^3^3^3100805^"
^XWB(8994,3127,1,1,0)="This RPC, given the internal entry number of an entry on the IMAGING "
^XWB(8994,3127,1,2,0)="PROCEDURE REFERENCE File (#2005.61), returns an array containing the "
^XWB(8994,3127,1,3,0)="field names and values that are defined for that entry."
^XWB(8994,3127,2,0)="^8994.02A^3^3"
^XWB(8994,3127,2,1,0)="PATREFIEN^1^10^^1"
^XWB(8994,3127,2,1,1,0)="^^2^2^3100805^"
^XWB(8994,3127,2,1,1,1,0)="This is the internal entry number on the IMAGING PATIENT REFERENCE File "
^XWB(8994,3127,2,1,1,2,0)="(#2005.6) of the patient with whom this procedure reference is associated."
^XWB(8994,3127,2,2,0)="PROCREFIEN^1^10^1^2"
^XWB(8994,3127,2,2,1,0)="^^2^2^3100805^"
^XWB(8994,3127,2,2,1,1,0)="This is the internal entry number of the entry on the IMAGING PROCEDURE "
^XWB(8994,3127,2,2,1,2,0)="REFERENCE File (#2005.61) for which attribute values are to be returned."
^XWB(8994,3127,2,3,0)="OVERRIDE^1^3^^3"
^XWB(8994,3127,2,3,1,0)="^^3^3^3100805^"
^XWB(8994,3127,2,3,1,1,0)="This parameter should be used with EXTREME CAUTION.  It suppresses the "
^XWB(8994,3127,2,3,1,2,0)="check of the patient reference IEN against the value of the PARENT IEN "
^XWB(8994,3127,2,3,1,3,0)="Field (#.99) on the IMAGING PROCEDURE REFERENCE File (#2005.61)."
^XWB(8994,3127,2,"B","OVERRIDE",3)=""
^XWB(8994,3127,2,"B","PATREFIEN",1)=""
^XWB(8994,3127,2,"B","PROCREFIEN",2)=""
^XWB(8994,3127,2,"PARAMSEQ",1,1)=""
^XWB(8994,3127,2,"PARAMSEQ",2,2)=""
^XWB(8994,3127,2,"PARAMSEQ",3,3)=""
^XWB(8994,3127,3,0)="^^4^4^3100805^"
^XWB(8994,3127,3,1,0)="This RPC returns an array containing the field names and values "
^XWB(8994,3127,3,2,0)="associated with the requested entry on the IMAGING PROCEDURE REFERENCE "
^XWB(8994,3127,3,3,0)="File (#2005.61).  Each array entry is returned in the format "
^XWB(8994,3127,3,4,0)="<fname>`<value>."
^XWB(8994,3128,0)="MAGV GET PROCEDURE INFO^GETPROCI^MAGVRS08^2^R^0"
^XWB(8994,3128,1,0)="^^6^6^3100805^"
^XWB(8994,3128,1,1,0)="This RPC, given the internal entry number of an entry on the IMAGING "
^XWB(8994,3128,1,2,0)="PROCEDURE REFERENCE File (#2005.61) that references a VA procedure,"
^XWB(8994,3128,1,3,0)="returns an array containing the attributes of that procedure."
^XWB(8994,3128,1,4,0)=" "
^XWB(8994,3128,1,5,0)="If the entry references a non-VA procedure, an appropriate exception "
^XWB(8994,3128,1,6,0)="message is returned."
^XWB(8994,3128,2,0)="^8994.02A^3^3"
^XWB(8994,3128,2,1,0)="PATREFIEN^1^10^^1"
^XWB(8994,3128,2,1,1,0)="^^2^2^3100805^"
^XWB(8994,3128,2,1,1,1,0)="This is the internal entry number on the IMAGING PATIENT REFERENCE File"
^XWB(8994,3128,2,1,1,2,0)="(#2005.6) of the patient with whom this procedure reference is associated."
^XWB(8994,3128,2,2,0)="PROCREFIEN^1^10^1^2"
^XWB(8994,3128,2,2,1,0)="^^3^3^3100805^"
^XWB(8994,3128,2,2,1,1,0)="This is the internal entry number of the entry on the IMAGING PROCEDURE"
^XWB(8994,3128,2,2,1,2,0)="REFERENCE File (#2005.61) for which procedure information is to be"
^XWB(8994,3128,2,2,1,3,0)="returned."
^XWB(8994,3128,2,3,0)="OVERRIDE^1^3^^3"
^XWB(8994,3128,2,3,1,0)="^^4^4^3100805^"
^XWB(8994,3128,2,3,1,1,0)="This parameter should be used with EXTREME CAUTION.  If valued TRUE "
^XWB(8994,3128,2,3,1,2,0)="(nonzero), it suppresses the check of the patient reference IEN against "
^XWB(8994,3128,2,3,1,3,0)="the value of the PARENT IEN Field (#.99) on the IMAGING PROCEDURE "
^XWB(8994,3128,2,3,1,4,0)="REFERENCE File (#2005.61)."
^XWB(8994,3128,2,"B","OVERRIDE",3)=""
^XWB(8994,3128,2,"B","PATREFIEN",1)=""
^XWB(8994,3128,2,"B","PROCREFIEN",2)=""
^XWB(8994,3128,2,"PARAMSEQ",1,1)=""
^XWB(8994,3128,2,"PARAMSEQ",2,2)=""
^XWB(8994,3128,2,"PARAMSEQ",3,3)=""
^XWB(8994,3128,3,0)="^^15^15^3100805^"
^XWB(8994,3128,3,1,0)="This RPC returns an array containing information about the VA procedure "
^XWB(8994,3128,3,2,0)="that is referenced by the requested entry on the IMAGING "
^XWB(8994,3128,3,3,0)="PROCEDURE REFERENCE File (#2005.61).  The entries of the array are "
^XWB(8994,3128,3,4,0)="formatted as <fname>`<value>."
^XWB(8994,3128,3,5,0)=" "
^XWB(8994,3128,3,6,0)="If the entry does not point to a VA procedure, an appropriate exception "
^XWB(8994,3128,3,7,0)="is returned."
