^XWB(8994,5047,0)="PSO EPCS PSDRPH FILER^PSDKEY^PSOEPUT2^1^R^^^^1"
^XWB(8994,5047,1,0)="^8994.01^2^2^3240723^^^^"
^XWB(8994,5047,1,1,0)="Allocates and deallocates the PSDRPH key to the specified user and logs "
^XWB(8994,5047,1,2,0)="the event in the XUEPCS PSDRPH AUDIT (#8991.7) file."
^XWB(8994,5047,2,0)="^8994.02A^3^3"
^XWB(8994,5047,2,1,0)="PSOSUBJ^1^30^1^1"
^XWB(8994,5047,2,1,1,0)="^^2^2^3240708^"
^XWB(8994,5047,2,1,1,1,0)="The NEW PERSON (#200) file Internal Entry Number (IEN) of the user to"
^XWB(8994,5047,2,1,1,2,0)="whom the PSDRPH key is being allocated or deallocated."
^XWB(8994,5047,2,2,0)="PSOACTOR^1^30^1^2"
^XWB(8994,5047,2,2,1,0)="^^2^2^3240708^"
^XWB(8994,5047,2,2,1,1,0)="The NEW PERSON (#200) file Internal Entry Number (IEN) of the user "
^XWB(8994,5047,2,2,1,2,0)="performing the allocation or deallocation of the PSDRPH key."
^XWB(8994,5047,2,3,0)="PSOACTION^1^1^1^3"
^XWB(8994,5047,2,3,1,0)="^^2^2^3240723^"
^XWB(8994,5047,2,3,1,1,0)="A flag indicating the type of action to be taken, either ""1"" to allocate "
^XWB(8994,5047,2,3,1,2,0)="the PSDRPH key, or ""0"" to deallocate the PSDRPH key."
^XWB(8994,5047,2,"B","PSOACTION",3)=""
^XWB(8994,5047,2,"B","PSOACTOR",2)=""
^XWB(8994,5047,2,"B","PSOSUBJ",1)=""
^XWB(8994,5047,2,"PARAMSEQ",1,1)=""
^XWB(8994,5047,2,"PARAMSEQ",2,2)=""
^XWB(8994,5047,2,"PARAMSEQ",3,3)=""
^XWB(8994,5047,3,0)="^8994.03^3^3^3240723^^^^"
^XWB(8994,5047,3,1,0)="The return value is 1 if the allocation or deallocation was successful. "
^XWB(8994,5047,3,2,0)="The return value is 0^Error Message Text if the allocation or deallocation"
^XWB(8994,5047,3,3,0)="was unsuccessful."
^XWB(8994,5048,0)="SDES2 SEARCH RECALL CLINICS^CLINICSEARCH^SDES2SEARCHRCLN^2^R^^^^^^1"
^XWB(8994,5048,1,0)="^^5^5^3250218^"
^XWB(8994,5048,1,1,0)=" This RPC allows users to search for clinics that are active recall "
^XWB(8994,5048,1,2,0)="clinics.  Given a search string (3 - 35 characters in length), the RPC "
^XWB(8994,5048,1,3,0)="will return a list of clinics who have associated recall letters assigned"
^XWB(8994,5048,1,4,0)=" "
^XWB(8994,5048,1,5,0)=" Can only be invoked by Acheron"
^XWB(8994,5048,2,0)="^8994.02A^2^2"
^XWB(8994,5048,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,5048,2,1,1,0)="^^16^16^3240903^"
^XWB(8994,5048,2,1,1,1,0)="SDCONTEXT(""ACHERON AUDIT ID"") = 40 character unique ID number."
^XWB(8994,5048,2,1,1,2,0)="                                Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,5048,2,1,1,3,0)="  "
^XWB(8994,5048,2,1,1,4,0)="SDCONTEXT(""USER DUZ"")         = The DUZ of the user taking action on the "
^XWB(8994,5048,2,1,1,5,0)="                                calling application."
^XWB(8994,5048,2,1,1,6,0)="   "
^XWB(8994,5048,2,1,1,7,0)="SDCONTEXT(""USER SECID"")       = The Security ID of the user taking action "
^XWB(8994,5048,2,1,1,8,0)="on"
^XWB(8994,5048,2,1,1,9,0)="                                the calling application."
^XWB(8994,5048,2,1,1,10,0)="   "
^XWB(8994,5048,2,1,1,11,0)="SDCONTEXT(""PATIENT DFN"")      = The DFN of the Veteran/user taking action "
^XWB(8994,5048,2,1,1,12,0)="on"
^XWB(8994,5048,2,1,1,13,0)="                                the calling application."
^XWB(8994,5048,2,1,1,14,0)=" "
^XWB(8994,5048,2,1,1,15,0)="SDCONTEXT(""PATIENT ICN"")      = The ICN of the Veteran/user taking action "
^XWB(8994,5048,2,1,1,16,0)="                                on the calling application."
^XWB(8994,5048,2,2,0)="SEARCHARRAY^2^32000^1^2"
^XWB(8994,5048,2,2,1,0)="^^1^1^3240903^"
^XWB(8994,5048,2,2,1,1,0)="SEARCH(""SEARCH STRING"") ; String to search"
^XWB(8994,5048,2,"B","SDCONTEXT",1)=""
^XWB(8994,5048,2,"B","SEARCHARRAY",2)=""
^XWB(8994,5048,2,"PARAMSEQ",1,1)=""
^XWB(8994,5048,2,"PARAMSEQ",2,2)=""
^XWB(8994,5048,3,0)="^^15^15^3240903^"
^XWB(8994,5048,3,1,0)="{"
^XWB(8994,5048,3,2,0)=" ""Clinic"": ["
^XWB(8994,5048,3,3,0)="  {"
^XWB(8994,5048,3,4,0)="   ""Abbreviation"": ""CLORED"","
^XWB(8994,5048,3,5,0)="   ""IEN"": 5276,"
