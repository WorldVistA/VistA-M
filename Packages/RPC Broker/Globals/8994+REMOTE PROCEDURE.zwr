^XWB(8994,3313,2,1,1,5,0)="^02: Client Vs ....... Client software version for checking."
^XWB(8994,3313,2,1,1,6,0)="^03: Client O/S Vs ... Client OS version for logging."
^XWB(8994,3313,2,1,1,7,0)="^04: ClientBuildDayTime ..... for logging."
^XWB(8994,3313,2,"B","DATA",1)=""
