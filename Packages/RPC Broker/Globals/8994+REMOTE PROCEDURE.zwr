^XWB(8994,4612,2,"B","DSSODUNS",1)=""
^XWB(8994,4612,2,"B","DSSONUM",2)=""
^XWB(8994,4612,2,"PARAMSEQ",1,1)=""
^XWB(8994,4612,2,"PARAMSEQ",2,2)=""
^XWB(8994,4612,3,0)="^^12^12^3190611^"
^XWB(8994,4612,3,1,0)="Error Messages:  ""-1^""_error message or ""0^""_warning message"
^XWB(8994,4612,3,2,0)="Successful Completion:  A list of vendors and identifying information"
^XWB(8994,4612,3,3,0)="  from the VENDOR (#440) file starting from the requested Dun & "
^XWB(8994,4612,3,4,0)="  Bradstreet # value in the format:"
^XWB(8994,4612,3,5,0)=" "
^XWB(8994,4612,3,6,0)="     ^-pc 1  .01  NAME               ^-pc 8   4.6   ORDERING ZIP CODE"
^XWB(8994,4612,3,7,0)="     ^-pc 2  1    ORDERING ADDRESS1  ^-pc 9   5     VENDOR PHONE NUMBER"
^XWB(8994,4612,3,8,0)="     ^-pc 3  2    ORDERING ADDRESS2  ^-pc 10  46    FAX #"
^XWB(8994,4612,3,9,0)="     ^-pc 4  3    ORDERING ADDRESS3  ^-pc 11  18.3  DUN & BRADSTREET #"
^XWB(8994,4612,3,10,0)="     ^-pc 5  4    ORDERING ADDRESS4  ^-pc 12  8.3   BUSINESS TYPE"
^XWB(8994,4612,3,11,0)="     ^-pc 6  4.2  ORDERING CITY      ^-pc 13  5.1   ACCOUNT NO."
^XWB(8994,4612,3,12,0)="     ^-pc 7  4.4  ORDERING STATE"
