^XWB(8994,3388,2,2,1,0)="^8994.021^1^1^3150722^^^^"
^XWB(8994,3388,2,2,1,1,0)="Security Phrase for IAM Provisioning Application."
^XWB(8994,3388,2,"B","AUTHCODE",2)=""
