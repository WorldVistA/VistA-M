^XWB(8994,3603,3,94,0)="(#26.11) "
^XWB(8994,3603,3,95,0)="         4. PRFLNAME - PRF Local Flag name "
^XWB(8994,3603,3,96,0)="         5. PRFLSTAT - PRF Local Flag status 0=INACTIVE 1=ACTIVE "
^XWB(8994,3603,3,97,0)="  116 SUBGRP - value from the ENROLLMENT SUBGROUP field of the PATIENT "
