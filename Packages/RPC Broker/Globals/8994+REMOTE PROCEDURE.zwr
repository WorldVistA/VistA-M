^XWB(8994,4951,3,2,0)=" 2:n entries = IEN ^ Tech Name   --> from file 200"
^XWB(8994,4952,0)="ISIJ RAD EXAM UPDATE^UPDEXAM^ISIDICR1^4^R"
^XWB(8994,4952,1,0)="^8994.01^1^1^3210805^"
^XWB(8994,4952,1,1,0)="Updates TECHNOLOGIST & TECH COMMENT in the exam record; called from ISIRad Report Entry."
^XWB(8994,4952,2,0)="^8994.02A^1^1"
^XWB(8994,4952,2,1,0)="PARAMS^1^255^1^1"
^XWB(8994,4952,2,1,1,0)="^^6^6^3210805^"
^XWB(8994,4952,2,1,1,1,0)="TX_CODE ^ Case ID | Tech-1 ^ Tech-2 ^ Tech_Comment (Note pipe-delimiter)"
^XWB(8994,4952,2,1,1,2,0)=" TX_CODE = 1 --> update Tech & Tech Comment"
^XWB(8994,4952,2,1,1,3,0)=" Case ID: RADFN^RADTI^RACNI^RARPT"
^XWB(8994,4952,2,1,1,4,0)=" Tech-1 - Technologist IEN or nil; at least one tech required"
^XWB(8994,4952,2,1,1,5,0)=" Tech-2 - Technologist IEN or nil"
^XWB(8994,4952,2,1,1,6,0)=" Tech_Comment ? entered text, or nil"
^XWB(8994,4952,2,"B","PARAMS",1)=""
^XWB(8994,4952,2,"PARAMSEQ",1,1)=""
^XWB(8994,4952,3,0)="^8994.03^4^4^3210805^^"
^XWB(8994,4952,3,1,0)=" Code ~ Reply display text"
^XWB(8994,4952,3,2,0)=" Code:"
^XWB(8994,4952,3,3,0)="  0 -- Normal result"
^XWB(8994,4952,3,4,0)="  4 -- Error result"
^XWB(8994,4953,0)="SDES2 SEARCH CLINIC ATTRIBUTES^SEARCHCLIN^SDES2CLNSEARCH^2^R^^^^^^1"
^XWB(8994,4953,1,0)="^^8^8^3250214^"
^XWB(8994,4953,1,1,0)="Given a whole or partial Clinic Name, Station Number (Opt), Date (Opt) "
^XWB(8994,4953,1,2,0)="and Return Active Flag (Opt) return the matching clinics and their key"
^XWB(8994,4953,1,3,0)="attributes."
^XWB(8994,4953,1,4,0)=" "
^XWB(8994,4953,1,5,0)="The RPC will search both the B x-ref based on the NAME (#.01 ) field and "
^XWB(8994,4953,1,6,0)="then the C x-ref based on the ABBREVIATION (#1) field for matches."
^XWB(8994,4953,1,7,0)=" "
^XWB(8994,4953,1,8,0)="Can only be invoked by Acheron"
^XWB(8994,4953,2,0)="^8994.02A^2^2"
^XWB(8994,4953,2,1,0)="SDCONTEXT^2^32000^1^1"
^XWB(8994,4953,2,1,1,0)="^^13^13^3240305^"
^XWB(8994,4953,2,1,1,1,0)="This array contains the needed audit information as defined by the "
^XWB(8994,4953,2,1,1,2,0)=" Acheron system."
^XWB(8994,4953,2,1,1,3,0)="  "
^XWB(8994,4953,2,1,1,4,0)=" SDCONTEXT(""ACHERON AUDIT ID"") = Up to 40 Character unique ID number."
^XWB(8994,4953,2,1,1,5,0)="                           Ex: 11d9dcc6-c6a2-4785-8031-8261576fca37"
^XWB(8994,4953,2,1,1,6,0)=" SDCONTEXT(""USER DUZ"") = The DUZ of the user taking action on the"
^XWB(8994,4953,2,1,1,7,0)="                         calling application. "
^XWB(8994,4953,2,1,1,8,0)=" SDCONTEXT(""USER SECID"") = The SECID of the user taking action in the"
^XWB(8994,4953,2,1,1,9,0)="                         calling application."
^XWB(8994,4953,2,1,1,10,0)=" SDCONTEXT(""PATIENT DFN"") = The name of the patient taking action on the"
^XWB(8994,4953,2,1,1,11,0)="                            calling application."
^XWB(8994,4953,2,1,1,12,0)=" SDCONTEXT(""PATIENT ICN"") = The ICN of the patient taking action on the"
^XWB(8994,4953,2,1,1,13,0)="                            calling application."
^XWB(8994,4953,2,2,0)="SDCLINIC^2^32000^1^2"
^XWB(8994,4953,2,2,1,0)="^8994.021^15^15^3250214^^^"
^XWB(8994,4953,2,2,1,1,0)="The SDCLINIC array contains the following array elements:"
^XWB(8994,4953,2,2,1,2,0)=" "
^XWB(8994,4953,2,2,1,3,0)=" SDCLINIC(""SEARCHSTRING"") (Req) = free text string that represents the "
^XWB(8994,4953,2,2,1,4,0)="  recall clinic name that will be searched."
^XWB(8994,4953,2,2,1,5,0)=" SDCLINIC(""STATION"") (Opt) = Station Number: If present, the search would "
^XWB(8994,4953,2,2,1,6,0)="  be limited to matching clinics at the given institution. If absent, the"
^XWB(8994,4953,2,2,1,7,0)="  search would take place across all divisions/institutions. Example"
^XWB(8994,4953,2,2,1,8,0)="  values: 534, 534GB"
^XWB(8994,4953,2,2,1,9,0)=" SDCLINIC(""DATETIME"") (Opt) = Date in ISO 8601 format to use for Clinic "
^XWB(8994,4953,2,2,1,10,0)="  Status verification. If not passed in, defaults to DT."
^XWB(8994,4953,2,2,1,11,0)=" SDCLINIC(""RETURNACTIVE"") (Opt) = Boolean to return Active or Inactive "
^XWB(8994,4953,2,2,1,12,0)="  clinics."
^XWB(8994,4953,2,2,1,13,0)="    1:Returns active and inactive clinics."
^XWB(8994,4953,2,2,1,14,0)="    0:Returns only active clinics."
^XWB(8994,4953,2,2,1,15,0)="    Defaults to 0 if not passed in."
^XWB(8994,4953,2,"B","SDCLINIC",2)=""
^XWB(8994,4953,2,"B","SDCONTEXT",1)=""
^XWB(8994,4953,2,"PARAMSEQ",1,1)=""
^XWB(8994,4953,2,"PARAMSEQ",2,2)=""
^XWB(8994,4953,3,0)="^8994.03^67^67^3250214^^"
^XWB(8994,4953,3,1,0)=" A listing of matching clinics and their key attributes:"
^XWB(8994,4953,3,2,0)="  "
^XWB(8994,4953,3,3,0)="{"
