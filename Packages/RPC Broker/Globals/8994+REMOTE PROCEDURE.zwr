^XWB(8994,898,0)="DVBAB REPORT PENDING7131^STRT^DVBAB57^4^R"
^XWB(8994,898,1,0)="^^1^1^3010621^"
^XWB(8994,898,1,1,0)="Generates a list of pending 7131 requests."
^XWB(8994,898,2,0)="^8994.02A^3^3"
^XWB(8994,898,2,1,0)="SELDIV^1^^1"
^XWB(8994,898,2,2,0)="DIV^1^^1"
^XWB(8994,898,2,3,0)="DVBADLMTR^1^1^0"
^XWB(8994,898,2,3,1,0)="^8994.021^4^4^3130521^^"
^XWB(8994,898,2,3,1,1,0)="This parameter is used to indicate whether the report will create a plain "
^XWB(8994,898,2,3,1,2,0)="text format or a comma delimited output format. DVBADLMTR=0 means report "
^XWB(8994,898,2,3,1,3,0)="will be in plain text and DVBADLMTR=1 means create output in comma "
^XWB(8994,898,2,3,1,4,0)="delimited format."
