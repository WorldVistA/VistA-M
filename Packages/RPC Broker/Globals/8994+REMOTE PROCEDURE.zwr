^XWB(8994,2489,2,"PARAMSEQ",2,2)=""
^XWB(8994,2489,2,"PARAMSEQ",3,3)=""
^XWB(8994,2489,2,"PARAMSEQ",4,4)=""
^XWB(8994,2489,3,0)="^8994.03^4^4^3090407^^^"
^XWB(8994,2489,3,1,0)="An array that consist of a zero node that holds the count of drugs and"
^XWB(8994,2489,3,2,0)="subordinate nodes that hold two pieces of data:"
^XWB(8994,2489,3,3,0)="$P1 = IEN in the file"
^XWB(8994,2489,3,4,0)="$P2 = Drug name"
^XWB(8994,2490,0)="DSIR TEST PEND CLARIFICATION^PENDCLR^DSIROI8^1"
^XWB(8994,2490,1,0)="^^1^1^3191220^"
^XWB(8994,2490,1,1,0)="Test Pending Clarification, Returns an Array."
^XWB(8994,2490,2,0)="^8994.02A^1^1"
^XWB(8994,2490,2,1,0)="IEN^1^^1^1"
^XWB(8994,2490,2,1,1,0)="^8994.021^1^1^3191220^^"
^XWB(8994,2490,2,1,1,1,0)="INPUT PARAMETER - IEN = INTERNAL ENTRY NUMBER FOR FILE 19620"
^XWB(8994,2490,2,"B","IEN",1)=""
^XWB(8994,2490,2,"PARAMSEQ",1,1)=""
^XWB(8994,2490,3,0)="^8994.03^4^4^3191220^^"
^XWB(8994,2490,3,1,0)="RETURN"
^XWB(8994,2490,3,2,0)="   0 OR NULL = NO "
^XWB(8994,2490,3,3,0)="   1 = YES"
^XWB(8994,2490,3,4,0)="  -1 = NO DATA FOR THIS REQUEST"
^XWB(8994,2491,0)="YTQ SET SCRATCH^SETSCR^YTQPXRM8^2^S"
^XWB(8994,2491,1,0)="^8994.01^1^1^3081112^^^^"
^XWB(8994,2491,1,1,0)="api to set data to a scratch file for the MHA3 DLL."
^XWB(8994,2491,2,0)="^8994.02A^3^3"
^XWB(8994,2491,2,1,0)="DFN^1^^1"
^XWB(8994,2491,2,1,1,0)="^^1^1^3080523^"
^XWB(8994,2491,2,1,1,1,0)="IEN of patient in file 2."
^XWB(8994,2491,2,2,0)="CODE^1^^1"
^XWB(8994,2491,2,2,1,0)="^8994.021^1^1^3081112^^^"
