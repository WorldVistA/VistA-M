^XWB(8994,5171,3,192,0)="            ""default"": ""Unanswered"","
^XWB(8994,5171,3,193,0)="            ""description"": ""Shipboard Hazard and Defense "
^XWB(8994,5171,3,194,0)="(SHD):\r\nVeterans with conditions recognized by VA as associated with "
^XWB(8994,5171,3,195,0)="Project 112\/\r\nSHAD, shipboard and land-based biological and chemical "
^XWB(8994,5171,3,196,0)="testing conducted\r\nby the United States (U.S.) military between 1962 "
^XWB(8994,5171,3,197,0)="and 1973 are eligible\r\nfor enrollment in priority group 6, unless "
^XWB(8994,5171,3,198,0)="eligible for enrollment in a\r\nhigher priority. In addition, veterans "
^XWB(8994,5171,3,199,0)="receive care at no charge for care\r\nand medications provided for "
^XWB(8994,5171,3,200,0)="treatment of conditions related to exposure.\r\n"","
