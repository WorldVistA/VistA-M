^XWB(8994,4183,3,1,0)="MAGRY(0) When 1st '^'-piece is 0, then an error occured. 2nd piece is the error."
^XWB(8994,4183,3,2,0)="MAGRY(1..n) MAGRY(1..n) = SITE NUMBER ^ DFN ^ ICN ^ CPRSCONTEXTID"
^XWB(8994,4184,0)="CRHD GET XPAR PARAM^PARAM^CRHD6^1"
^XWB(8994,4184,1,0)="^8994.01^2^2^3180806^^^^"
^XWB(8994,4184,1,1,0)=" Simple call to return a parameter value.  The call assumes the current"
^XWB(8994,4184,1,2,0)=" user, 'defaultable' entities, and one instance."
^XWB(8994,4184,2,0)="^8994.02A^^0"
^XWB(8994,4184,3,0)="^8994.03^1^1^3180806^^"
^XWB(8994,4184,3,1,0)="Value from XPAR for the parameter that was passed in"
^XWB(8994,4185,0)="XUS MVI ENRICH NEW PERSON^UPDATE^XUMVIENU^1^A^^^^1^^0"
^XWB(8994,4185,1,0)="^8994.01^2^2^3190605^^^^"
^XWB(8994,4185,1,1,0)="This restricted RPC is used exclusively by the Master Veteran Index (MVI) "
^XWB(8994,4185,1,2,0)="to update enriched data in the VistA New Person File (#200)."
^XWB(8994,4185,2,0)="^8994.02A^2^2"
^XWB(8994,4185,2,1,0)="PARAM^2^^1^1"
^XWB(8994,4185,2,1,1,0)="^^59^59^3190605^"
^XWB(8994,4185,2,1,1,1,0)="Required elements:"
^XWB(8994,4185,2,1,1,2,0)="    PARAM(""WHO"")=Station Number of requesting station"
^XWB(8994,4185,2,1,1,3,0)="    PARAM(""NPI"")=National Provider Identifier"
^XWB(8994,4185,2,1,1,4,0)=" "
^XWB(8994,4185,2,1,1,5,0)="Required elements only when FLAG is ""A"""
^XWB(8994,4185,2,1,1,6,0)="    PARAM(""NAME"")=surname|first name|middle name|suffix|full .01 name"
^XWB(8994,4185,2,1,1,7,0)=" "
^XWB(8994,4185,2,1,1,8,0)="Optional elements (only pass those elements you want to update)"
^XWB(8994,4185,2,1,1,9,0)="    PARAM(""ADDRESS DATA"")=street address 1|street address 2|"
^XWB(8994,4185,2,1,1,10,0)="        street address 3|city|state|zip code|office phone|fax number"
^XWB(8994,4185,2,1,1,11,0)="    PARAM(""SubjectOrgan"")=subject organization"
^XWB(8994,4185,2,1,1,12,0)="        Default: ""Department Of Veterans Affairs"""
^XWB(8994,4185,2,1,1,13,0)="    PARAM(""SubjectOrganID"")=subject organization id"
^XWB(8994,4185,2,1,1,14,0)="        Default: ""urn:oid:2.16.840.1.113883.4.349"""
^XWB(8994,4185,2,1,1,15,0)=" "
^XWB(8994,4185,2,1,1,16,0)="    PARAM(""ADUPN"")=adupn"
^XWB(8994,4185,2,1,1,17,0)=" "
^XWB(8994,4185,2,1,1,18,0)="    PARAM(""AuthWriteMedOrders"")=1 or 0 for YES/NO"
^XWB(8994,4185,2,1,1,19,0)="        Default if WHO is 200PIEV and a DEA# is sent: 1 (for YES)"
^XWB(8994,4185,2,1,1,20,0)=" "
^XWB(8994,4185,2,1,1,21,0)="    PARAM(""DEA"",<seq#>,""DEA"")=Drug Enforcement Agency (DEA) #"
^XWB(8994,4185,2,1,1,22,0)="    PARAM(""DEA"",<seq#>,""Detox"")= detox number"
^XWB(8994,4185,2,1,1,23,0)="    PARAM(""DEA"",<seq#>,""DEAExpire"")=expiration date (can be future)"
^XWB(8994,4185,2,1,1,24,0)="    PARAM(""DEA"",<seq#>,""SchedIINarc"")=1 or 0 for YES/NO"
^XWB(8994,4185,2,1,1,25,0)="    PARAM(""DEA"",<seq#>,""SchedIINonNarc"")=1 or 0 for YES/NO"
^XWB(8994,4185,2,1,1,26,0)="    PARAM(""DEA"",<seq#>,""SchedIIINarc"")=1 or 0 for YES/NO"
^XWB(8994,4185,2,1,1,27,0)="    PARAM(""DEA"",<seq#>,""SchedIIINonNarc"")=1 or 0 for YES/NO"
^XWB(8994,4185,2,1,1,28,0)="    PARAM(""DEA"",<seq#>,""SchedIV"")=1 or 0 for YES/NO"
^XWB(8994,4185,2,1,1,29,0)="    PARAM(""DEA"",<seq#>,""SchedV"")=1 or 0 for YES/NO"
^XWB(8994,4185,2,1,1,30,0)=" "
^XWB(8994,4185,2,1,1,31,0)="    PARAM(""DEGREE"")=degrees (codes delimited by a space)"
^XWB(8994,4185,2,1,1,32,0)="    PARAM(""EMAIL"")=email address"
^XWB(8994,4185,2,1,1,33,0)="    PARAM(""GENDER"")=M or F"
^XWB(8994,4185,2,1,1,34,0)="    PARAM(""Inactivate"")=inactive date (can be future)"
^XWB(8994,4185,2,1,1,35,0)=" "
^XWB(8994,4185,2,1,1,36,0)="    PARAM(""NonVAPrescriber"")=1 or 0 for YES/NO"
^XWB(8994,4185,2,1,1,37,0)="        Default if WHO is 200PIEV: 1 (for YES)"
^XWB(8994,4185,2,1,1,38,0)=" "
^XWB(8994,4185,2,1,1,39,0)="    PARAM(""NTUSERNAME"")=network user name"
^XWB(8994,4185,2,1,1,40,0)=" "
^XWB(8994,4185,2,1,1,41,0)="    PARAM(""PersonClass"",<seq#>,""PersonClass"")=X12 code value"
^XWB(8994,4185,2,1,1,42,0)="    PARAM(""PersonClass"",<seq#>,""PersonClassActive"")=date"
^XWB(8994,4185,2,1,1,43,0)="        Default if not currently active: TODAY"
^XWB(8994,4185,2,1,1,44,0)="    PARAM(""PersonClass"",<seq#>,""PersonClassExpire"")=date"
^XWB(8994,4185,2,1,1,45,0)=" "
^XWB(8994,4185,2,1,1,46,0)="    PARAM(""ProviderClass"")=a value from the PROVIDER CLASS file (#7)"
^XWB(8994,4185,2,1,1,47,0)="    PARAM(""ProviderType"")=provider type code|provider type value"
^XWB(8994,4185,2,1,1,48,0)=" "
^XWB(8994,4185,2,1,1,49,0)="    PARAM(""Remarks"")=remarks"
^XWB(8994,4185,2,1,1,50,0)="        Default if WHO is 200PIEV: ""NON-VA PROVIDER"""
^XWB(8994,4185,2,1,1,51,0)=" "
^XWB(8994,4185,2,1,1,52,0)="    PARAM(""SECID"")=secid"
^XWB(8994,4185,2,1,1,53,0)="    PARAM(""TaxID"")=tax id"
^XWB(8994,4185,2,1,1,54,0)="    PARAM(""Termination"")=termination date (cannot be future)"
^XWB(8994,4185,2,1,1,55,0)=" "
^XWB(8994,4185,2,1,1,56,0)="    PARAM(""Title"")=value from TITLE file (#3.1)"
^XWB(8994,4185,2,1,1,57,0)="        Default if WHO is 200PIEV: ""NON-VA PROVIDER"""
^XWB(8994,4185,2,1,1,58,0)=" "
^XWB(8994,4185,2,1,1,59,0)="    PARAM(""UniqueUserID"")=unique user id"
^XWB(8994,4185,2,2,0)="FLAG^1^^1^2"
^XWB(8994,4185,2,2,1,0)="^8994.021^5^5^3190605^^^^"
^XWB(8994,4185,2,2,1,1,0)="This flag controls whether the RPC is adding an NEW PERSON file entry or "
^XWB(8994,4185,2,2,1,2,0)="updating an existing one."
^XWB(8994,4185,2,2,1,3,0)=" "
^XWB(8994,4185,2,2,1,4,0)="  ""U"" : Update an existing entry"
^XWB(8994,4185,2,2,1,5,0)="  ""A"" : Add a new entry"
^XWB(8994,4185,2,"B","FLAG",2)=""
^XWB(8994,4185,2,"B","PARAM",1)=""
^XWB(8994,4185,2,"PARAMSEQ",1,1)=""
^XWB(8994,4185,2,"PARAMSEQ",2,2)=""
^XWB(8994,4185,3,0)="^8994.03^13^13^3190605^^^^"
^XWB(8994,4185,3,1,0)="On success:"
^XWB(8994,4185,3,2,0)="   DUZ of New Person File entry edited or added"
^XWB(8994,4185,3,3,0)="       Returned if there were no issues adding or editing the entry."
^XWB(8994,4185,3,4,0)="   "
^XWB(8994,4185,3,5,0)="   DUZ^-1^ErrorMessage"
^XWB(8994,4185,3,6,0)="       Returned if entry was edited, but some data was not valid and could"
^XWB(8994,4185,3,7,0)="       not be filed."
^XWB(8994,4185,3,8,0)=" "
^XWB(8994,4185,3,9,0)="On failure:"
^XWB(8994,4185,3,10,0)="   -1^ErrorMessage"
^XWB(8994,4185,3,11,0)="       Returned for example if required data was not passed, entry could "
^XWB(8994,4185,3,12,0)="       not be added when FLAG=""A"", or entry could not be found based on"
^XWB(8994,4185,3,13,0)="       the NPI when FLAG=""U""."
^XWB(8994,4186,0)="ORALEAPI REPORT^REPORT^ORALEAPI^2"
^XWB(8994,4186,1,0)="^^2^2^3190618^"
^XWB(8994,4186,1,1,0)="This RPC returns TIU and OR notification data from the ALERT TRACKING file"
^XWB(8994,4186,1,2,0)="for a given date range."
^XWB(8994,4186,2,0)="^8994.02A^3^3"
^XWB(8994,4186,2,1,0)="SDT^1^^0^1"
^XWB(8994,4186,2,1,1,0)="^8994.021^1^1^3190618^^"
^XWB(8994,4186,2,1,1,1,0)="This is the starting date of the date range in FM format."
^XWB(8994,4186,2,2,0)="EDT^1^^0^2"
^XWB(8994,4186,2,2,1,0)="^^1^1^3190522^"
^XWB(8994,4186,2,2,1,1,0)="This is the ending date of the date range in FM format."
^XWB(8994,4186,2,3,0)="TYP^1^^0^3"
^XWB(8994,4186,2,3,1,0)="^8994.021^2^2^3190618^^"
^XWB(8994,4186,2,3,1,1,0)="This is the type of report data requested.  Default data returned is both "
^XWB(8994,4186,2,3,1,2,0)="OR and TIU alert data.  ""OR"" or ""TIU"" if only one type is requested."
^XWB(8994,4186,2,"B","EDT",2)=""
^XWB(8994,4186,2,"B","SDT",1)=""
^XWB(8994,4186,2,"B","TYP",3)=""
^XWB(8994,4186,2,"PARAMSEQ",1,1)=""
^XWB(8994,4186,2,"PARAMSEQ",2,2)=""
^XWB(8994,4186,2,"PARAMSEQ",3,3)=""
^XWB(8994,4186,3,0)="^^3^3^3190618^"
^XWB(8994,4186,3,1,0)="Data returned:"
^XWB(8994,4186,3,2,0)="IEN^RECIPIENT^TITLE^SERVICE/SECTION^TIME^DATE^NOTIFICATION^DIVISION "
^XWB(8994,4186,3,3,0)="[LOCATION]"
^XWB(8994,4187,0)="DVBA CAPRI GET EDIPI2^EDIPIQ2^DVBCENQ^1^R^0^^0^1"
^XWB(8994,4187,1,0)="^^4^4^3190911^"
^XWB(8994,4187,1,1,0)="CAPRI REMOTE PROCEDURE CALL RETURNS EDIPI AND LAST SERVICE BRANCH"
^XWB(8994,4187,1,2,0)=" TO BE SENT VIA DBQ'S TO DOD.  FIRST PIECE IS EDIPI OR ZERO (0) IF THERE "
^XWB(8994,4187,1,3,0)=" IS NO DATA, SECOND PIECE IS LAST SERVICE BRANCH."
^XWB(8994,4187,1,4,0)=" ""1XXXX^LAST SERVICE BRANCH"""
^XWB(8994,4187,2,0)="^8994.02A^1^1"
^XWB(8994,4187,2,1,0)="DFN^1^30^1^1"
^XWB(8994,4187,2,"B","DFN",1)=""
^XWB(8994,4187,2,"PARAMSEQ",1,1)=""
^XWB(8994,4188,0)="VAFC MVI MGRTD FACILITIES UPDT^UPDMFAC^VAFCRPC^2^A^0^^^1^^0"
^XWB(8994,4188,1,0)="^8994.01^6^6^3190403^^^^"
^XWB(8994,4188,1,1,0)="This Remote Procedure Call (RPC) will be used to create/update entries in "
^XWB(8994,4188,1,2,0)="a site's EHRM MIGRATED FACILITIES (#391.919) file, which will allow the "
^XWB(8994,4188,1,3,0)="facility to determine if a site has migrated to the CERNER application."
^XWB(8994,4188,1,4,0)="The Master Veteran Index (MVI) will be the authoritative source of this "
^XWB(8994,4188,1,5,0)="information and as such will push the migrated site information down to "
^XWB(8994,4188,1,6,0)="the sites on an as needed basis."
^XWB(8994,4188,2,0)="^8994.02A^1^1"
^XWB(8994,4188,2,1,0)="ARRCRNR^2^32000^1^1"
^XWB(8994,4188,2,1,1,0)="^8994.021^7^7^3190403^^^^"
^XWB(8994,4188,2,1,1,1,0)="The ARRCRNR parameter contains a list of the Stations Numbers passed from "
^XWB(8994,4188,2,1,1,2,0)="the Master Veteran Index (MVI) that indicates the VAMC sites that have "
^XWB(8994,4188,2,1,1,3,0)="migrated to the CERNER application."
^XWB(8994,4188,2,1,1,4,0)="   "
^XWB(8994,4188,2,1,1,5,0)="     Ie. ARRCRNR(<Station #>)="""""
^XWB(8994,4188,2,1,1,6,0)="         ARRCRNR(<Station #>)="""""
^XWB(8994,4188,2,1,1,7,0)="         etc..."
^XWB(8994,4188,2,"B","ARRCRNR",1)=""
^XWB(8994,4188,2,"PARAMSEQ",1,1)=""
^XWB(8994,4188,3,0)="^^5^5^3190403^"
^XWB(8994,4188,3,1,0)="The return parameter will return the following information depending on "
^XWB(8994,4188,3,2,0)="whether the RPC call was successful or not:"
^XWB(8994,4188,3,3,0)=" "
^XWB(8994,4188,3,4,0)="  -                 ARRAY(0)=1"
^XWB(8994,4188,3,5,0)="  - If errors     : ARRAY(<#>)=Station # ^ Error Code ^ Error Message"
^XWB(8994,4189,0)="XUS MVI NEW PERSON BULK GET^BULKGET^XUMVINPB^4^A^^^1^1^^0"
^XWB(8994,4189,1,0)="^8994.01^2^2^3200423^^^^"
^XWB(8994,4189,1,1,0)="This restricted RPC is used exclusively by the Master Veteran Index (MVI)"
^XWB(8994,4189,1,2,0)="to retrieve data in bulk from the VistA NEW PERSON file (#200)."
^XWB(8994,4189,2,0)="^8994.02A^2^2"
^XWB(8994,4189,2,1,0)="XUDUZ^1^40^1^1"
^XWB(8994,4189,2,1,1,0)="^^3^3^3200804^"
^XWB(8994,4189,2,1,1,1,0)="The File IEN in the NEW PERSON file (#200).  The RPC will START looping "
^XWB(8994,4189,2,1,1,2,0)="with this IEN to retrieve the 'NEXT' NEW PERSON meeting the selected"
^XWB(8994,4189,2,1,1,3,0)="criteria."
^XWB(8994,4189,2,2,0)="XUTYPE^1^3^1^2"
^XWB(8994,4189,2,2,1,0)="^^6^6^3200501^"
^XWB(8994,4189,2,2,1,1,0)="The TYPE of NEW PERSON's to retrieve from the NEW PERSON (#200) file:"
^XWB(8994,4189,2,2,1,2,0)=" "
^XWB(8994,4189,2,2,1,3,0)="'A'ctive   (not disuser'd, not terminated and has a primary menu option)"
^XWB(8994,4189,2,2,1,4,0)="'D'isuser'd or Terminated"
^XWB(8994,4189,2,2,1,5,0)="'V'isitor  (person has visitor records)"
^XWB(8994,4189,2,2,1,6,0)="'ALL'      (retrieve all new person's)"
^XWB(8994,4189,2,"B","XUDUZ",1)=""
^XWB(8994,4189,2,"B","XUTYPE",2)=""
^XWB(8994,4189,2,"PARAMSEQ",1,1)=""
^XWB(8994,4189,2,"PARAMSEQ",2,2)=""
^XWB(8994,4189,3,0)="^^98^98^3250318^"
^XWB(8994,4189,3,1,0)="  Success:"
^XWB(8994,4189,3,2,0)="   XURET = ^TMP(""XUMVINPU"",$J)"
^XWB(8994,4189,3,3,0)="    @XURET@(#) = FILE #;FIELD #;<SUBFIELD #>;^FIELD NAME^<COUNTER #>^"
^XWB(8994,4189,3,4,0)="                 INTERNAL VALUE^EXTERNAL VALUE"
^XWB(8994,4189,3,5,0)="          <> Denotes optional values."
^XWB(8994,4189,3,6,0)="          If Counter populated, denotes multiple value <1-n>"
^XWB(8994,4189,3,7,0)=" "
^XWB(8994,4189,3,8,0)="    @XURET@(#)=""200;IEN^DUZ^^^"""
^XWB(8994,4189,3,9,0)="    @XURET@(#)=""200;.01^NAME^^^"""
^XWB(8994,4189,3,10,0)="    @XURET@(#)=""200;.111^STREET ADDRESS 1^^^"""
^XWB(8994,4189,3,11,0)="    @XURET@(#)=""200;.112^STREET ADDRESS 2^^^"""
^XWB(8994,4189,3,12,0)="    @XURET@(#)=""200;.113^STREET ADDRESS 3^^^"""
^XWB(8994,4189,3,13,0)="    @XURET@(#)=""200;.114^CITY^^^"""
^XWB(8994,4189,3,14,0)="    @XURET@(#)=""200;.115^STATE^^^"""
^XWB(8994,4189,3,15,0)="    @XURET@(#)=""200;.116^ZIP CODE^^^"""
^XWB(8994,4189,3,16,0)="    @XURET@(#)=""200;.132^OFFICE PHONE^^^"""
^XWB(8994,4189,3,17,0)="    @XURET@(#)=""200;.151^EMAIL ADDRESS^^^"""
^XWB(8994,4189,3,18,0)="    @XURET@(#)=""200;4^SEX^^^"""
^XWB(8994,4189,3,19,0)="    @XURET@(#)=""200;5^DOB^^^"""
^XWB(8994,4189,3,20,0)="    @XURET@(#)=""200;7^DISUSER^^^"""
^XWB(8994,4189,3,21,0)="    @XURET@(#)=""200;8^TITLE^^^"""
^XWB(8994,4189,3,22,0)="    @XURET@(#)=""200;9^SSN^^^"""
^XWB(8994,4189,3,23,0)="    @XURET@(#)=""200;9.2^TERMINATION DATE^^^"""
^XWB(8994,4189,3,24,0)="    @XURET@(#)=""200;16;.01^DIVISION^<1 to n>^^"""
^XWB(8994,4189,3,25,0)="    @XURET@(#)=""200;10.1^NAME COMPONENTS^^^"""
^XWB(8994,4189,3,26,0)="    @XURET@(#)=""20;1^FAMILY (LAST) NAME^^^"""
^XWB(8994,4189,3,27,0)="    @XURET@(#)=""20;2^GIVEN (FIRST) NAME^^^"""
^XWB(8994,4189,3,28,0)="    @XURET@(#)=""20;3^MIDDLE NAME^^^"""
^XWB(8994,4189,3,29,0)="    @XURET@(#)=""20;4^PREFIX^^^"""
^XWB(8994,4189,3,30,0)="    @XURET@(#)=""20;5^SUFFIX^^^"""
^XWB(8994,4189,3,31,0)="    @XURET@(#)=""20;6^DEGREE^^^"""
^XWB(8994,4189,3,32,0)="    @XURET@(#)=""200;29^SERVICE/SECTION^^^"""
^XWB(8994,4189,3,33,0)="    @XURET@(#)=""200;205.1^SECID^^^"""
^XWB(8994,4189,3,34,0)="    @XURET@(#)=""200;205.2^SUBJECT ORGANIZATION^^^"""
^XWB(8994,4189,3,35,0)="    @XURET@(#)=""200;205.3^SUBJECT ORGANIZATION ID^^^"""
^XWB(8994,4189,3,36,0)="    @XURET@(#)=""200;205.4^UNIQUE USER ID^^^"""
^XWB(8994,4189,3,37,0)="    @XURET@(#)=""200;205.5^ADUPN^^^"""
^XWB(8994,4189,3,38,0)="    @XURET@(#)=""200;501.1^NETWORK USERNAME^^^"""
^XWB(8994,4189,3,39,0)="    @XURET@(#)=""200;41.99^NPI^^^"""
^XWB(8994,4189,3,40,0)="    @XURET@(#)=""200;53.2^DEA#^^^"""
^XWB(8994,4189,3,41,0)="    @XURET@(#)=""200;747.44^DEA EXPIRATION DATE^^^"""
^XWB(8994,4189,3,42,0)="    @XURET@(#)=""200;201^PRIMARY MENU OPTION^^^"""
^XWB(8994,4189,3,43,0)="    @XURET@(#)=""200;203;.01^SECONDARY MENU OPTIONS^<1 to n>^^"""
^XWB(8994,4189,3,44,0)="    @XURET@(#)=""200;51;.01^KEY^<1 to n>^^"""
