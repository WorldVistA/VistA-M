^XWB(8994,3122,2,0)="^8994.02A^6^6"
^XWB(8994,3122,2,1,0)="TYPE^1^^1^1"
^XWB(8994,3122,2,1,1,0)="^8994.021^1^1^3111103^^^^"
^XWB(8994,3122,2,1,1,1,0)="This is the IEN of the related work list entry in the MAG WORK ITEM file (#2006.941)."
^XWB(8994,3122,2,2,0)="EXPSTAT^1^^1^2"
^XWB(8994,3122,2,2,1,0)="^8994.021^1^1^3110420^^"
^XWB(8994,3122,2,2,1,1,0)="This is the expected status of the work item.  If the work item does not have the expected status the work item elements will not be  returned and the work item status will not be updated."
