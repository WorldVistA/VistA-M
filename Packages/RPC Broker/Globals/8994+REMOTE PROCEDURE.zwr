^XWB(8994,3590,1,1,0)="GET clinic data for report."
^XWB(8994,3590,3,0)="^^54^54^3150128^"
^XWB(8994,3590,3,1,0)="Global Array in which each array"
^XWB(8994,3590,3,2,0)="                  entry contains an clinic data separated by ^: "
^XWB(8994,3590,3,3,0)="  1. CLINIEN - clinic ID pointer to HOSPITAL LOCATION file 44"
^XWB(8994,3590,3,4,0)="  2. CLINNAME - clinic NAME from HOSPITAL LOCATION file 44"
^XWB(8994,3590,3,5,0)="  3. TYPE - clinic type - only valid value is 'CLINIC'"
^XWB(8994,3590,3,6,0)="  4. INSTIEN - institution ID pointer to INSTITUTION file"
^XWB(8994,3590,3,7,0)="  5. INSTNAME - institution NAME from INSTITUTION file"
^XWB(8994,3590,3,8,0)="  6. DIVIEN - division ID pointer to MEDICAL CENTER DIVISION"
^XWB(8994,3590,3,9,0)="              file 40.8"
^XWB(8994,3590,3,10,0)="  7. DIVNAME - division NAME from MEDICAL CENTER DIVISIOn file"
^XWB(8994,3590,3,11,0)="  8. STOP_CODE_ID - stop code ID pointer to CLINIC STOP file 40.7"
^XWB(8994,3590,3,12,0)="  9. STOP_CODE_NUMBER - stop code number"
^XWB(8994,3590,3,13,0)="  10. SERVICE - service assigned - valid values:"
^XWB(8994,3590,3,14,0)="      MEDICINE"
^XWB(8994,3590,3,15,0)="      SURGERY"
^XWB(8994,3590,3,16,0)="      PSYCHIATRY"
^XWB(8994,3590,3,17,0)="      REHAB MEDICINE"
^XWB(8994,3590,3,18,0)="      NEUROLOGY"
^XWB(8994,3590,3,19,0)="      NONE"
^XWB(8994,3590,3,20,0)="  11. TREATSPECID - treating specialty ID pointer to"
^XWB(8994,3590,3,21,0)="                    FACILITY TREATING SPECIALTY file 45.7"
^XWB(8994,3590,3,22,0)="  12. TREATSPECNAME - treating specialty NAME from"
^XWB(8994,3590,3,23,0)="                    FACILITY TREATING SPECIALTY file"
^XWB(8994,3590,3,24,0)="  13. PROVIEN - default provider ID pointer to NEW PERSON file 200"
^XWB(8994,3590,3,25,0)="  14. PROVNAME - default provider NAME from NEW PERSON file"
^XWB(8994,3590,3,26,0)="  15. AGENCYID - agency ID pointer to AGENCY file 4.11"
^XWB(8994,3590,3,27,0)="  16. AGENCYNAME - agency NAME from AGENCY file"
^XWB(8994,3590,3,28,0)="  17. APPTLEN - length of app't numeric 10-240 and"
^XWB(8994,3590,3,29,0)="                multiple of 10 or 15"
^XWB(8994,3590,3,30,0)="  18. VAPPTLEN - variable appointment length 'V' means"
^XWB(8994,3590,3,31,0)="                 ""YES, VARIABLE LENGTH""; otherwise null"
^XWB(8994,3590,3,32,0)="  19. PROHIBITACC - prohibit access to clinic? 'YES' or null"
^XWB(8994,3590,3,33,0)="  20. NON-COUNT - non-count clinic? 'YES' 'NO'"
^XWB(8994,3590,3,34,0)="  21. INACTIVATE_DT - inactivate date in external format"
^XWB(8994,3590,3,35,0)="                      date clinic was inactivated"
^XWB(8994,3590,3,36,0)="  22. REACTIVATE_DT - reactivate date in external format"
^XWB(8994,3590,3,37,0)="                      date clinic was reactivated"
^XWB(8994,3590,3,38,0)="  23. DEF-APPT-TYPE_ID - default appointment type ID pointer to"
^XWB(8994,3590,3,39,0)="                         APPOINTMENT TYPE file 409.1"
^XWB(8994,3590,3,40,0)="  24. DEF-APPT-TYPE_NAME - default appointment type NAME from"
^XWB(8994,3590,3,41,0)="                           APPOINTMENT TYPE file"
^XWB(8994,3590,3,42,0)="  25. PROVIDERS - Providers separated by pipe."
^XWB(8994,3590,3,43,0)="      Each pipe piece contains the following ;; pieces:"
^XWB(8994,3590,3,44,0)="         1. provider ID pointer to NEW PERSON FILE 200"
^XWB(8994,3590,3,45,0)="         2. provider NAME from NEW PERSON file"
^XWB(8994,3590,3,46,0)="         3. default provider? 'NO' 'YES'"
^XWB(8994,3590,3,47,0)="  26. CLIN-SVCS-RES_ID - clinic services resource ID pointer to"
^XWB(8994,3590,3,48,0)="  27. CLIN-SVCS-RES_NAME - clinic services resource NAME"
^XWB(8994,3590,3,49,0)="  28. CLINIC-GRP_ID - clinic group (reports) ID pointer to"
^XWB(8994,3590,3,50,0)="                      CLINIC GROUP file 409.67"
^XWB(8994,3590,3,51,0)="  29. CLINIC-GRP_NAME - clinic group (reports) NAME from"
^XWB(8994,3590,3,52,0)="                        CLINIC GROUP file"
^XWB(8994,3590,3,53,0)="  30. DATE - Date/Time this Clinic was created in external format"
^XWB(8994,3590,3,54,0)="  31. MAXDAYS - max # days for future booking"
^XWB(8994,3591,0)="SDEC WLPCSET^WLPCSET^SDEC^4^R^0^^0"
^XWB(8994,3591,1,0)="^8994.01^1^1^3150128^^"
^XWB(8994,3591,1,1,0)="SET update patient contacts in SD WAIT LIST file"
^XWB(8994,3591,2,0)="^8994.02A^2^2"
^XWB(8994,3591,2,1,0)="INP^1^^1^1"
^XWB(8994,3591,2,1,1,0)="^^8^8^3141202^"
^XWB(8994,3591,2,1,1,1,0)=";  INP = Patient Contacts separated by ::"
^XWB(8994,3591,2,1,1,2,0)=" ;            Each :: piece has the following ~~ pieces:  (same as they "
^XWB(8994,3591,2,1,1,3,0)="are passed into SDEC WLSET)"
^XWB(8994,3591,2,1,1,4,0)=" ;            1) = (required)    DATE ENTERED external date/time"
^XWB(8994,3591,2,1,1,5,0)=" ;            2) = (optional)    PC ENTERED BY USER ID or NAME - Pointer "
^XWB(8994,3591,2,1,1,6,0)="to NEW PERSON file or NAME"
^XWB(8994,3591,2,1,1,7,0)=" ;            4) = (optional)    ACTION - 'Called' or 'Message Left'"
^XWB(8994,3591,2,1,1,8,0)=" ;            5) = (optional)    PATIENT PHONE Free-Text 4-20 characters"
^XWB(8994,3591,2,2,0)="WLIEN^1^^1^2"
^XWB(8994,3591,2,2,1,0)="^8994.021^1^1^3150128^^"
^XWB(8994,3591,2,2,1,1,0)="Wait List Id pointer to SDEC WAIT LIST file 409.3"
^XWB(8994,3591,2,"B","INP",1)=""
^XWB(8994,3591,2,"B","WLIEN",2)=""
^XWB(8994,3591,2,"PARAMSEQ",1,1)=""
^XWB(8994,3591,2,"PARAMSEQ",2,2)=""
^XWB(8994,3591,3,0)="^8994.03^12^12^3150128^^"
^XWB(8994,3591,3,1,0)="    Successful Return:"
^XWB(8994,3591,3,2,0)="      A single entry in the Global Array in the format"
^XWB(8994,3591,3,3,0)="      ""0^<optional msg text>"""
^XWB(8994,3591,3,4,0)="      ""T00020RETURNCODE^T00100TEXT"""
^XWB(8994,3591,3,5,0)="   Caught Exception Return:"
^XWB(8994,3591,3,6,0)="    A single entry in the Global Array in the format ""-1^<error text>"""
^XWB(8994,3591,3,7,0)="    ""T00020RETURNCODE^T00100TEXT"""
^XWB(8994,3591,3,8,0)="   Unexpected Exception Return:"
^XWB(8994,3591,3,9,0)="      Handled by the RPC Broker."
^XWB(8994,3591,3,10,0)="      M errors are trapped by the use of M and Kernel error handling."
^XWB(8994,3591,3,11,0)="      The RPC execution stops and the RPC Broker sends the error"
^XWB(8994,3591,3,12,0)="      generated text back to the client."
^XWB(8994,3592,0)="SDEC APPSDGET^APPSDGET^SDEC^4^R^0^^0"
^XWB(8994,3592,1,0)="^8994.01^2^2^3150127^^"
^XWB(8994,3592,1,1,0)="GET appointment entries from SDEC APPOINTMENT file 409.84"
^XWB(8994,3592,1,2,0)="  all records returned if all input is null"
^XWB(8994,3592,2,0)="^8994.02A^8^8"
^XWB(8994,3592,2,1,0)="MAXREC^1^^0^1"
^XWB(8994,3592,2,1,1,0)="^^1^1^3141223^"
^XWB(8994,3592,2,1,1,1,0)="Max records returned default to all"
^XWB(8994,3592,2,2,0)="LASTSUB^1^^0^2"
^XWB(8994,3592,2,2,1,0)="^^1^1^3141223^"
^XWB(8994,3592,2,2,1,1,0)="last subscripts from previous call"
^XWB(8994,3592,2,3,0)="SDBEG^1^^0^3"
^XWB(8994,3592,2,3,1,0)="^^2^2^3141223^"
^XWB(8994,3592,2,3,1,1,0)="Begin Date range in external format"
^XWB(8994,3592,2,3,1,2,0)="Default to all dates"
^XWB(8994,3592,2,4,0)="SDEND^1^^0^4"
^XWB(8994,3592,2,4,1,0)="^^2^2^3141223^"
^XWB(8994,3592,2,4,1,1,0)="End Date range in external format"
^XWB(8994,3592,2,4,1,2,0)="Default to all dates"
^XWB(8994,3592,2,5,0)="NOTEFLG^1^^0^5"
^XWB(8994,3592,2,5,1,0)="^^2^2^3141223^"
^XWB(8994,3592,2,5,1,1,0)="1=do NOT return NOTE text"
^XWB(8994,3592,2,5,1,2,0)="0=return NOTE text"
^XWB(8994,3592,2,6,0)="SDRES^1^^0^6"
^XWB(8994,3592,2,6,1,0)="^^2^2^3141223^"
^XWB(8994,3592,2,6,1,1,0)="Resource ID pointer to SDEC RESOURCE file"
^XWB(8994,3592,2,6,1,2,0)="Default to all resources"
^XWB(8994,3592,2,7,0)="DFN^1^^0^7"
^XWB(8994,3592,2,7,1,0)="^^2^2^3141223^"
^XWB(8994,3592,2,7,1,1,0)="pointer to PATIENT file 2"
^XWB(8994,3592,2,7,1,2,0)="Default to all patients"
^XWB(8994,3592,2,8,0)="SDID^1^^0^8"
^XWB(8994,3592,2,8,1,0)="^8994.021^1^1^3150127^^"
^XWB(8994,3592,2,8,1,1,0)="external ID (free-text)"
^XWB(8994,3592,2,"B","DFN",7)=""
^XWB(8994,3592,2,"B","LASTSUB",2)=""
^XWB(8994,3592,2,"B","MAXREC",1)=""
^XWB(8994,3592,2,"B","NOTEFLG",5)=""
^XWB(8994,3592,2,"B","SDBEG",3)=""
^XWB(8994,3592,2,"B","SDEND",4)=""
^XWB(8994,3592,2,"B","SDID",8)=""
^XWB(8994,3592,2,"B","SDRES",6)=""
^XWB(8994,3592,2,"PARAMSEQ",1,1)=""
^XWB(8994,3592,2,"PARAMSEQ",2,2)=""
^XWB(8994,3592,2,"PARAMSEQ",3,3)=""
^XWB(8994,3592,2,"PARAMSEQ",4,4)=""
^XWB(8994,3592,2,"PARAMSEQ",5,5)=""
^XWB(8994,3592,2,"PARAMSEQ",6,6)=""
^XWB(8994,3592,2,"PARAMSEQ",7,7)=""
^XWB(8994,3592,2,"PARAMSEQ",8,8)=""
^XWB(8994,3592,3,0)="^8994.03^64^64^3150127^^"
^XWB(8994,3592,3,1,0)=" ; Successful Return:"
^XWB(8994,3592,3,2,0)=" ; Global Array in which each array entry contains data from the"
^XWB(8994,3592,3,3,0)=" ; SDEC APPOINTMENT file 409.84."
^XWB(8994,3592,3,4,0)=" ; Data is separated by ^:"
^XWB(8994,3592,3,5,0)=" ; 1. IEN - pointer to SDEC APPOINTMENT file"
^XWB(8994,3592,3,6,0)=" ; 2. DATE1 - STARTTIME in external format"
^XWB(8994,3592,3,7,0)=" ; 3. DATE2 - ENDTIME in external format"
^XWB(8994,3592,3,8,0)=" ; 4. CHECKIN_TIME - CHECKIN date/time in external format"
^XWB(8994,3592,3,9,0)=" ; 5. DATE - CHECK IN TIME ENTERED - date/time in external format"
^XWB(8994,3592,3,10,0)=" ; 6. DFN - Patient ID"
^XWB(8994,3592,3,11,0)=" ; 7. NAME - Patient NAME"
^XWB(8994,3592,3,12,0)=" ; 8. SDEC_ACCESS_TYPE_IEN - access type ID pointer to"
^XWB(8994,3592,3,13,0)=" ;                           SDEC ACCESS TYPE file"
^XWB(8994,3592,3,14,0)=" ; 9. SDEC_ACCESS_TYPE_NAME - access type NAME from"
^XWB(8994,3592,3,15,0)=" ;                            SDEC ACCESS TYPE file"
^XWB(8994,3592,3,16,0)=" ; 10. RESOURCEID - Pointer to the SDEC RESOURCE file"
^XWB(8994,3592,3,17,0)=" ; 11. RESOURCE_NAME - NAME from SDEC RESOURCE file"
^XWB(8994,3592,3,18,0)=" ; 12. USERIEN - DATA ENTRY CLERK id pointer to NEW PERSON file"
^XWB(8994,3592,3,19,0)=" ; 13. USERNAME - DATA ENTRY CLERK name from NEW PERSON file"
^XWB(8994,3592,3,20,0)=" ; 14. DATE3 - DATE APPT MADE in external format"
^XWB(8994,3592,3,21,0)=" ; 15. NOSHOW - NOSHOW flag 1=YES; 0=NO default to no"
^XWB(8994,3592,3,22,0)=" ; 16. DATE4 - NOSHOW DATETIME in external format"
^XWB(8994,3592,3,23,0)=" ; 17. USERIEN1 - NOSHOW BY USER id pointer to NEW PERSON file"
^XWB(8994,3592,3,24,0)=" ; 18. USERNAME1 - NOSHOW BY USER name from NEW PERSON file"
^XWB(8994,3592,3,25,0)=" ; 19. DATE5 - REBOOK DATETIME in external format"
^XWB(8994,3592,3,26,0)=" ; 20. DATE6 - CANCEL DATETIME in external format"
^XWB(8994,3592,3,27,0)=" ; 21. USERIEN2 - CANCELLED BY USER id pointer to NEW PERSON file"
^XWB(8994,3592,3,28,0)=" ; 22. USERNAME2 - CANCELLED BY USER name from NEW PERSON file"
^XWB(8994,3592,3,29,0)=" ; 23. CANCELLATION_REASONS_IEN - CANCELLATION REASON id pointer"
^XWB(8994,3592,3,30,0)=" ;                            to CANCELLATION REASONS file 409.2"
^XWB(8994,3592,3,31,0)=" ; 24. CANCELLATION_REASONS_NAME - CANCELLATION REASON name from"
^XWB(8994,3592,3,32,0)=" ;                            CANCELLATION REASONS file"
^XWB(8994,3592,3,33,0)=" ; 25. WALKIN - WALKIN flag y=YES; n=NO default to NO"
^XWB(8994,3592,3,34,0)=" ; 26. CHECKOUT - CHECKOUT date/time in external format"
^XWB(8994,3592,3,35,0)=" ; 27. V_PROVIDER_IEN - V PROVIDER IEN id pointer to"
^XWB(8994,3592,3,36,0)=" ;                      V PROVIDER file"
^XWB(8994,3592,3,37,0)=" ; 28. V_PROVIDER_NAME - V PROVIDER name from V PROVIDER FILE"
^XWB(8994,3592,3,38,0)=" ; 29. PROVIEN - PROVIDER id pointer to NEW PERSON file"
^XWB(8994,3592,3,39,0)=" ; 30. PROVNAME - PROVIDER name from NEW PERSON file"
^XWB(8994,3592,3,40,0)=" ; 31. STATUS - STATUS set of codes"
^XWB(8994,3592,3,41,0)=" ;              valid values in external form are:"
^XWB(8994,3592,3,42,0)=" ;                NO-SHOW"
^XWB(8994,3592,3,43,0)=" ;                CLINIC"
^XWB(8994,3592,3,44,0)=" ;                NO-SHOW & AUTO RE-BOOK"
^XWB(8994,3592,3,45,0)=" ;                CANCELLED BY CLINIC & AUTO RE-BOOK"
^XWB(8994,3592,3,46,0)=" ;                INPATIENT APPOINTMENT"
^XWB(8994,3592,3,47,0)=" ;                CANCELLED BY PATIENT"
^XWB(8994,3592,3,48,0)=" ;                CANCELLED BY PATIENT & AUTO-REBOOK"
^XWB(8994,3592,3,49,0)=" ;                NO ACTION TAKEN"
^XWB(8994,3592,3,50,0)=" ; 32. APPTLEN - LENGTH OF APPT numeric 5-120"
^XWB(8994,3592,3,51,0)=" ; 33. APPT_STAT_IEN - PREV APPT STATUS id pointer to"
^XWB(8994,3592,3,52,0)=" ;                     APPOINTMENT STATUS file 409.63"
^XWB(8994,3592,3,53,0)=" ; 34. APPT_STAT_NAME - PREV APPT STATUS name from"
^XWB(8994,3592,3,54,0)=" ;                      APPOINTMENT STATUS file"
^XWB(8994,3592,3,55,0)=" ; 35. DAPTDT - DESIRED DATE OF APPOINTMENT in external format"
^XWB(8994,3592,3,56,0)=" ; 36. SDID - EXTERNAL ID free-text"
^XWB(8994,3592,3,57,0)=" ; 37. SDAPTYP - APPT REQUEST TYPE - variable pointer pointer"
^XWB(8994,3592,3,58,0)=" ;               to one of these files:"
^XWB(8994,3592,3,59,0)=" ;                SD WAIT LIST - E|<WL IEN> E|123"
^XWB(8994,3592,3,60,0)=" ;                REQUEST/CONSULTATION - C|<CONSULT IEN> C|123"
^XWB(8994,3592,3,61,0)=" ;                RECALL REMINDERS - R|^<RECALL IEN> R|123"
^XWB(8994,3592,3,62,0)=" ; 38. NOTE - NOTE free-text converted from Word Processing"
^XWB(8994,3592,3,63,0)=" ;            field. May contain Carriage return/line feed"
^XWB(8994,3592,3,64,0)=" ;            characters"
^XWB(8994,3593,0)="SDEC WLOPEN^WLOPEN^SDEC^4^R^0^^0"
^XWB(8994,3593,1,0)="^8994.01^1^1^3150128^^"
^XWB(8994,3593,1,1,0)="SET Waitlist Open/re-open"
^XWB(8994,3593,2,0)="^8994.02A^3^3"
^XWB(8994,3593,2,1,0)="WLIEN^1^^0^2"
^XWB(8994,3593,2,1,1,0)="^8994.021^1^1^3150128^^^"
^XWB(8994,3593,2,1,1,1,0)="Waitlist ID - Pointer to SD WAIT LIST file"
^XWB(8994,3593,2,2,0)="WLDDT^1^^0^3"
^XWB(8994,3593,2,2,1,0)="^8994.021^1^1^3150128^^"
^XWB(8994,3593,2,2,1,1,0)="Desired Date of appointment in external format"
^XWB(8994,3593,2,3,0)="WLAPP^1^^0^1"
^XWB(8994,3593,2,3,1,0)="^8994.021^1^1^3150128^^"
^XWB(8994,3593,2,3,1,1,0)="Appointment ID pointer to SDEC APPOINTMENT file 409.84"
^XWB(8994,3593,2,"B","WLAPP",3)=""
^XWB(8994,3593,2,"B","WLDDT",2)=""
^XWB(8994,3593,2,"B","WLIEN",1)=""
^XWB(8994,3593,2,"PARAMSEQ",1,3)=""
^XWB(8994,3593,2,"PARAMSEQ",2,1)=""
^XWB(8994,3593,2,"PARAMSEQ",3,2)=""
^XWB(8994,3593,3,0)="^8994.03^1^1^3150128^^"
^XWB(8994,3593,3,1,0)="Single entry in the global array containing a return code and text."
^XWB(8994,3594,0)="SDECLOC PRIVLOC^PRIVLOC^SDECLOC^4^R^0^^1"
^XWB(8994,3594,1,0)="^8994.01^1^1^3150420^^"
^XWB(8994,3594,1,1,0)="Returns Privileged User data for Hospital Locations."
^XWB(8994,3594,2,0)="^8994.02A^1^1"
^XWB(8994,3594,2,1,0)="LOCATION^1^^1^1"
^XWB(8994,3594,2,1,1,0)="^8994.021^1^1^3150420^^"
^XWB(8994,3594,2,1,1,1,0)="IEN to Hospital Location file."
^XWB(8994,3594,2,"B","LOCATION",1)=""
^XWB(8994,3594,2,"PARAMSEQ",1,1)=""
^XWB(8994,3594,3,0)="^8994.03^12^12^3150420^^"
^XWB(8994,3594,3,1,0)="Global Array in which each array element contains information separated "
^XWB(8994,3594,3,2,0)="by ^:"
^XWB(8994,3594,3,3,0)="1. Hospital Location IEN"
^XWB(8994,3594,3,4,0)="2. Hospital Location Name"
^XWB(8994,3594,3,5,0)="3. Privileged User IEN"
^XWB(8994,3594,3,6,0)="4. Privileged User Name"
^XWB(8994,3594,3,7,0)=" "
^XWB(8994,3594,3,8,0)="Unexpected Exception Return:"
^XWB(8994,3594,3,9,0)="  Handled by the RPC Broker."
^XWB(8994,3594,3,10,0)="  M errors are trapped by the use of M and Kernel error handling."
^XWB(8994,3594,3,11,0)="  The RPC execution stops and the RPC Broker sends the error"
^XWB(8994,3594,3,12,0)="  generated text back."
^XWB(8994,3595,0)="SDECRMG RMG^RMG^SDECRMG^4^R^0^^0"
^XWB(8994,3595,1,0)="^^6^6^3210422^"
^XWB(8994,3595,1,1,0)="This RPC returns data from the ^XTMP(""SDECIDX"",$J,""XREF"" global."
^XWB(8994,3595,1,2,0)="This call uses the filter and sort arrays passed in to return data in the "
^XWB(8994,3595,1,3,0)="desired format. This call returns a list of items by a key."
^XWB(8994,3595,1,4,0)=" "
^XWB(8994,3595,1,5,0)="Per SD*5.3*784, MAX RECS ACCUMULATED (#5) field has been added and Input"
^XWB(8994,3595,1,6,0)="Parameters were defined to match the routine input parameters."
^XWB(8994,3595,2,0)="^8994.02A^6^6"
^XWB(8994,3595,2,1,0)="MAXREC^1^^^1"
^XWB(8994,3595,2,1,1,0)="^^1^1^3150420^"
^XWB(8994,3595,2,1,1,1,0)="MAXIMUM number of records to return. The default is 25 if left blank."
^XWB(8994,3595,2,2,0)="LASTSUB^1^^^2"
^XWB(8994,3595,2,2,1,0)="^^4^4^3150420^"
^XWB(8994,3595,2,2,1,1,0)="This parameter would contain the key of the last record processed."
^XWB(8994,3595,2,2,1,2,0)="If this parameter is included, the routine will retrieve the next MAXREC "
^XWB(8994,3595,2,2,1,3,0)="number of items from the previous filter/sort request and will not "
^XWB(8994,3595,2,2,1,4,0)="initiate a new search."
^XWB(8994,3595,2,3,0)="FILTER^2^^^3"
^XWB(8994,3595,2,3,1,0)="^^11^11^3150420^"
^XWB(8994,3595,2,3,1,1,0)="This parameter will contain the filter data. Filters can be in any order"
^XWB(8994,3595,2,3,1,2,0)=" and in any number."
^XWB(8994,3595,2,3,1,3,0)=" "
^XWB(8994,3595,2,3,1,4,0)=" It has 2 pieces to each entry. The first piece is the type and the second"
^XWB(8994,3595,2,3,1,5,0)=" piece is the value.  Below are examples"
^XWB(8994,3595,2,3,1,6,0)=" FILTER(1)=WAITTIME^>=90"
^XWB(8994,3595,2,3,1,7,0)=" FILTER(2)=REQUESTTYPE^E~C"
^XWB(8994,3595,2,3,1,8,0)=" FILTER(3)=PRIORITYGROUP^GROUP 1~GROUP 2 Clinics is a list of clinics in "
^XWB(8994,3595,2,3,1,9,0)="EXTERNAL FORMAT"
^XWB(8994,3595,2,3,1,10,0)=" Origination date and desired date are list of dates in EXTERNAL format"
^XWB(8994,3595,2,3,1,11,0)=" PatientName is a list of internal DFNS"
^XWB(8994,3595,2,4,0)="SORT^2^^^4"
^XWB(8994,3595,2,4,1,0)="^^11^11^3150420^"
^XWB(8994,3595,2,4,1,1,0)="The sort array tells how to return the requested data."
^XWB(8994,3595,2,4,1,2,0)=" Sort can be any number and in any order."
^XWB(8994,3595,2,4,1,3,0)=" "
^XWB(8994,3595,2,4,1,4,0)=" SORT(1)=WAITTIME"
^XWB(8994,3595,2,4,1,5,0)=" SORT(2)=REQUESTTYPE"
^XWB(8994,3595,2,4,1,6,0)=" SORT(3)=PRIORITYGROUP"
^XWB(8994,3595,2,4,1,7,0)=" SORT(4)=DESIREDDATE"
^XWB(8994,3595,2,4,1,8,0)=" SORT(5)=ORIGINATIONDATE"
^XWB(8994,3595,2,4,1,9,0)=" SORT(6)=CLINICS"
^XWB(8994,3595,2,4,1,10,0)=" SORT(7)=PATIENTNAME"
