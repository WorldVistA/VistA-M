^XWB(8994,2876,1,4,0)="file."
^XWB(8994,2876,1,5,0)="Output: Data vs ERROR"
^XWB(8994,2877,0)="XUS KAAJEE GET USER VIA PROXY^USERINFO^XUSKAAJ1^2^R^^^^1^^1"
^XWB(8994,2877,1,0)="^8994.01^2^2^3151215^^^"
^XWB(8994,2877,1,1,0)="Returns a variety of information needed for KAAJEE logon based on the "
^XWB(8994,2877,1,2,0)="ccow token"
^XWB(8994,2877,2,0)="^8994.02A^3^3"
^XWB(8994,2877,2,1,0)="CLIENT-IP^1^^1^1"
^XWB(8994,2877,2,1,1,0)="^^3^3^3080730^"
^XWB(8994,2877,2,1,1,1,0)="IP address of the client workstation used for logging (signon log) and IP "
^XWB(8994,2877,2,1,1,2,0)="blocking (failed access attempts).  Also, this IP address is used to "
^XWB(8994,2877,2,1,1,3,0)="validate ccow token submitted."
^XWB(8994,2877,2,2,0)="SERVER-NM^1^^1^2"
^XWB(8994,2877,2,2,1,0)="^^2^2^3080730^"
^XWB(8994,2877,2,2,1,1,0)="Identifying name for the calling application or server used for logging "
^XWB(8994,2877,2,2,1,2,0)="(signon log)"
^XWB(8994,2877,2,3,0)="CCOWTOK^1^^1^3"
^XWB(8994,2877,2,3,1,0)="^8994.021^1^1^3151215^^^"
^XWB(8994,2877,2,3,1,1,0)="Value of ccow token passed."
^XWB(8994,2877,2,"B","CCOWTOK",3)=""
^XWB(8994,2877,2,"B","CLIENT-IP",1)=""
^XWB(8994,2877,2,"B","SERVER-NM",2)=""
^XWB(8994,2877,2,"PARAMSEQ",1,1)=""
^XWB(8994,2877,2,"PARAMSEQ",2,2)=""
^XWB(8994,2877,2,"PARAMSEQ",3,3)=""
^XWB(8994,2877,3,0)="^8994.03^20^20^3151215^^"
^XWB(8994,2877,3,1,0)="output is the same as the RPC named XUS FATKAAT GET USER INFO."
^XWB(8994,2877,3,2,0)="  "
^XWB(8994,2877,3,3,0)="OUTPUT:"
^XWB(8994,2877,3,4,0)=" Result(0) is the users DUZ."
^XWB(8994,2877,3,5,0)=" Result(1) is the user name from the .01 field."
^XWB(8994,2877,3,6,0)=" Result(2) is the users full name from the name standard file."
^XWB(8994,2877,3,7,0)=" Result(3) is the FAMILY (LAST) NAME"
^XWB(8994,2877,3,8,0)=" Result(4) is the GIVEN (FIRST) NAME"
^XWB(8994,2877,3,9,0)=" Result(5) is the MIDDLE NAME"
^XWB(8994,2877,3,10,0)=" Result(6) is the PREFIX"
^XWB(8994,2877,3,11,0)=" Result(7) is the SUFFIX"
^XWB(8994,2877,3,12,0)=" Result(8) is the DEGREE"
^XWB(8994,2877,3,13,0)=" Result(9) is station # of the division that the user is working in."
^XWB(8994,2877,3,14,0)=" Result(10) is the station # of the parent facility for the login division"
^XWB(8994,2877,3,15,0)=" Result(11) is the station # from the KSP site parameters, the parent"
^XWB(8994,2877,3,16,0)=" ""computer system"" "
^XWB(8994,2877,3,17,0)=" Result(12) is the signon log entry IEN "
^XWB(8994,2877,3,18,0)=" Result(13) = # of permissible divisions "
^XWB(8994,2877,3,19,0)=" Result(14-n) are the permissible divisions for user login, in the format:"
^XWB(8994,2877,3,20,0)=" IEN of file 4^Station Name^Station Number^default? (1 or 0)"
^XWB(8994,2878,0)="XUS KAAJEE GET CCOW TOKEN^CCOWIP^XUSKAAJ1^2^R^^^^1^^1"
^XWB(8994,2878,1,0)="^8994.01^1^1^3151215^^^"
^XWB(8994,2878,1,1,0)="This RPC gets a token to save in the CCOW context to aid in sign-on"
^XWB(8994,2878,2,0)="^8994.02A^1^1"
^XWB(8994,2878,2,1,0)="IP-ADDRESS^1^30^0^1"
^XWB(8994,2878,2,1,1,0)="^8994.021^4^4^3151215^^"
^XWB(8994,2878,2,1,1,1,0)="This value represents the IP address of the workstation.  Useful for J2EE"
^XWB(8994,2878,2,1,1,2,0)="applications that connect to VistA via the application server. If present,"
^XWB(8994,2878,2,1,1,3,0)="this value will be used when associating a CCOW token to the IP"
^XWB(8994,2878,2,1,1,4,0)="address of the client workstation"
