^XWB(8994,4475,3,10,0)="in order by field #.01"
^XWB(8994,4476,0)="SDEC VVC_APPT^VVCAPPT^SDECVVC^4^P^^^^^^1"
^XWB(8994,4476,1,0)="^^7^7^3200609^"
^XWB(8994,4476,1,1,0)="If an appointment is for a VVC clinic, return the URL of the VVC Web app."
^XWB(8994,4476,1,2,0)=" "
^XWB(8994,4476,1,3,0)="The NATIONAL entry in the SDEC Settings file (#409.98) stores the stop "
^XWB(8994,4476,1,4,0)="code that identifies a VVC clinic in field #5 (VVC Clinic Stop Code).  If "
^XWB(8994,4476,1,5,0)="the stop code for the clinic associated with the resource scheduled for "
^XWB(8994,4476,1,6,0)="the appointment equals this stop code, the RPC returns the value in field "
^XWB(8994,4476,1,7,0)="#6 VVC APP URL of the NATIONAL entry in the SDEC Settings file."
^XWB(8994,4476,2,0)="^8994.02A^1^1"
^XWB(8994,4476,2,1,0)="SDECAPPT^1^^1^1"
^XWB(8994,4476,2,1,1,0)="^8994.021^1^1^3200609^^"
