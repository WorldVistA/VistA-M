^XWB(8994,4620,3,0)="^^55^55^3190705^"
^XWB(8994,4620,3,1,0)="Output:"
^XWB(8994,4620,3,2,0)="  Error Messages:  DSSORET(0)=""-1^""_error message or ""0^""_warning message"
^XWB(8994,4620,3,3,0)="  Successful Completion: returns a global array of sections containing "
^XWB(8994,4620,3,4,0)="      various data to be used in displaying an RFQ/10-90 letter."
^XWB(8994,4620,3,5,0)="     DSSORET(n)= p1"
^XWB(8994,4620,3,6,0)="        where p1 = a line of data to be used in displaying the"
^XWB(8994,4620,3,7,0)="                   RFQ/10-90 letter"
^XWB(8994,4620,3,8,0)="      The sections include:"
^XWB(8994,4620,3,9,0)="        $HEADER includes:"
^XWB(8994,4620,3,10,0)="                  HDR^""REQUEST FOR QUOTATION"""
^XWB(8994,4620,3,11,0)="                  REQDATE^date the letter was first generated  (file "
^XWB(8994,4620,3,12,0)="                    665.4 field #11)"
^XWB(8994,4620,3,13,0)="        $VENDOR - includes:   (all from VENDOR (#440) file)"
^XWB(8994,4620,3,14,0)="                  NAME^data (mandatory)                NAME"
^XWB(8994,4620,3,15,0)="                  ADDR1^data (if null, don?t return)  ORDERING ADDRESS1"
^XWB(8994,4620,3,16,0)="                  ADDR2^data (if null, don?t return)  ORDERING ADDRESS2"
^XWB(8994,4620,3,17,0)="                  ADDR3^data (if null, don?t return)  ORDERING ADDRESS3"
^XWB(8994,4620,3,18,0)="                  ADDR4^data (if null, don?t return)  ORDERING ADDRESS4"
^XWB(8994,4620,3,19,0)="                  CITY^data                           ORDERING CITY"
^XWB(8994,4620,3,20,0)="                  STATE^data   (abbreviation)         ORDERING STATE"
^XWB(8994,4620,3,21,0)="                  ZIP^data                            ORDERING ZIP CODE"
^XWB(8994,4620,3,22,0)="                  PHONE^data                          VENDOR PHONE NUMBER"
^XWB(8994,4620,3,23,0)="                  FAX^data                            FAX #"
^XWB(8994,4620,3,24,0)="        $FACILITY includes: (all from file 669.9)"
^XWB(8994,4620,3,25,0)="                  REQSERVICE^""Prosthetics Service"""
^XWB(8994,4620,3,26,0)="                  NAME^data                           NAME"
^XWB(8994,4620,3,27,0)="                  ADDR1^data (only address line)      STREET ADD1"
^XWB(8994,4620,3,28,0)="                  CITY^data                           CITY"
^XWB(8994,4620,3,29,0)="                  STATE^data   (abbreviation)         STATE^data   "
^XWB(8994,4620,3,30,0)="                     If STATE is blank, CITY will be"
^XWB(8994,4620,3,31,0)="                     NAME (file 4, field .01)."
^XWB(8994,4620,3,32,0)="                  ZIP^data                            ZIP CODE"
^XWB(8994,4620,3,33,0)="        $VETERAN:"
^XWB(8994,4620,3,34,0)="                  NAME^data   format: LAST, FIRST     NAME from PATIENT "
^XWB(8994,4620,3,35,0)="                                                        file (#2)"
^XWB(8994,4620,3,36,0)="        $BODY1:"
^XWB(8994,4620,3,37,0)="                  Text for letter from template (one line for RFQ)"
^XWB(8994,4620,3,38,0)=" "
^XWB(8994,4620,3,39,0)="        $BODY1-END"
^XWB(8994,4620,3,40,0)="        $BODY2:  (from file 665.2)"
^XWB(8994,4620,3,41,0)="                  Text for letter from template (6 lines for RFQ)"
^XWB(8994,4620,3,42,0)="        $BODY2-END"
^XWB(8994,4620,3,43,0)="        $SIGNATURE"
^XWB(8994,4620,3,44,0)="                  SIG^data                     CHIEF SIG BLOCK"
^XWB(8994,4620,3,45,0)="                                                        (file 669.9)"
^XWB(8994,4620,3,46,0)="                  TITLE^data                   SIGNATURE BLOCK TITLE"
^XWB(8994,4620,3,47,0)="                                                        (file 669.9)"
^XWB(8994,4620,3,48,0)="        $ITEMS"
^XWB(8994,4620,3,49,0)="                  Each line in the ITEM multiple of the Pros Letter "
^XWB(8994,4620,3,50,0)="                  Transactions file (#665.4) will be provided here."
^XWB(8994,4620,3,51,0)="                  If no ITEM exists in the multiple, ""No items found."""
^XWB(8994,4620,3,52,0)="                  will appear between $ITEM and $ITEM-END."
^XWB(8994,4620,3,53,0)="       $ITEMS-END"
^XWB(8994,4620,3,54,0)="       $TRAILER"
^XWB(8994,4620,3,55,0)="                  TRLR^FL 10-90 ADP"
^XWB(8994,4621,0)="DSSO LPCI COMMENT HANDLER^EN^DSSOPP1^1^^^^1"
^XWB(8994,4621,1,0)="^8994.01^8^8^3201015^^"
^XWB(8994,4621,1,1,0)="This RPC is utilized to handle the LPCI comments for associated PO "
^XWB(8994,4621,1,2,0)="entries and is stored within file #23645.1 as a separate log per PO."
^XWB(8994,4621,1,3,0)=" "
^XWB(8994,4621,1,4,0)="If the entered PROSTHETICS 1358 (#664) IEN entered does not currently "
^XWB(8994,4621,1,5,0)="have a comment on file for the current user, a new entry will be created."
^XWB(8994,4621,1,6,0)=" "
^XWB(8994,4621,1,7,0)="If the entered #664 IEN and user has an existing comment, the new comment "
^XWB(8994,4621,1,8,0)="will be added to the existing log."
^XWB(8994,4621,1,9,0)="If the entered #664 IEN and user has an existing comment, it will be set"
^XWB(8994,4621,1,10,0)="to the new value passed in."
^XWB(8994,4621,1,11,0)=" "
^XWB(8994,4621,1,12,0)="If a valid #664 IEN for the user is passed in but no comment is provided,"
^XWB(8994,4621,1,13,0)="the comment entry will be deleted entirely."
^XWB(8994,4621,2,0)="^8994.02A^2^2"
^XWB(8994,4621,2,1,0)="DSSOPO^1^^1^1"
^XWB(8994,4621,2,1,1,0)="^8994.021^1^1^3201015^^^"
^XWB(8994,4621,2,1,1,1,0)="This is the PROSTHETICS 1358 (#664) IEN"
^XWB(8994,4621,2,2,0)="DSSOTEXT^1^240^1^2"
^XWB(8994,4621,2,2,1,0)="^8994.021^1^1^3201015^^"
^XWB(8994,4621,2,2,1,1,0)="This is the text you wish to add as a LPCI comment."
^XWB(8994,4621,2,"B","DSSOPO",1)=""
^XWB(8994,4621,2,"B","DSSOTEXT",2)=""
^XWB(8994,4621,2,"PARAMSEQ",1,1)=""
^XWB(8994,4621,2,"PARAMSEQ",2,2)=""
^XWB(8994,4621,3,0)="^^5^5^3201015^"
^XWB(8994,4621,3,1,0)="If the operation completes successfully:"
^XWB(8994,4621,3,2,0)="  *IEN*,*Comment subfile IEN*^*results message"
^XWB(8994,4621,3,3,0)=" "
^XWB(8994,4621,3,4,0)="If an error has occurred:"
^XWB(8994,4621,3,5,0)="  -1^*APAT error message*:*any error message passed back by FileMan*"
^XWB(8994,4622,0)="DSSO GET NEW PERSON^GET200^DSSOUTU^4^^^^1"
^XWB(8994,4622,1,0)="^^2^2^3200331^"
^XWB(8994,4622,1,1,0)="This RPC returns commercial phone, fax, and email fields as well as SSN"
^XWB(8994,4622,1,2,0)="for the specified user from the NEW PERSON (#200) file."
^XWB(8994,4622,2,0)="^8994.02A^1^1"
^XWB(8994,4622,2,1,0)="DSSO200^1^15^1^1"
^XWB(8994,4622,2,1,1,0)="^8994.021^1^1^3200331^^"
^XWB(8994,4622,2,1,1,1,0)="NEW PERSON (#200) file IEN"
^XWB(8994,4622,2,"B","DSSO200",1)=""
^XWB(8994,4622,2,"PARAMSEQ",1,1)=""
^XWB(8994,4622,3,0)="^8994.03^10^10^3200331^^"
^XWB(8994,4622,3,1,0)="Output:"
^XWB(8994,4622,3,2,0)="   Error Messages:  DSSORET(0)=""-1^""_error message or ""0^""_warning message"
^XWB(8994,4622,3,3,0)="   Successful Completion: Returns specific fields from the NEW PERSON "
^XWB(8994,4622,3,4,0)="     (#200) file for the specified user in external format:"
^XWB(8994,4622,3,5,0)="       DSSORET(n)=p1^p2^p3^p4^p5 where"
^XWB(8994,4622,3,6,0)="         p1=File Number (200)"
^XWB(8994,4622,3,7,0)="         p2=File 200 IEN_"","""
^XWB(8994,4622,3,8,0)="         p3=Field Number"
^XWB(8994,4622,3,9,0)="         p4=""E"" (external format)"
^XWB(8994,4622,3,10,0)="         p5=data"
^XWB(8994,4623,0)="DSSO LPCI PLUS NULL VPO^NULLVPO^DSSOROH2^4^^^^1"
^XWB(8994,4623,1,0)="^8994.01^3^3^3210706^^^"
^XWB(8994,4623,1,1,0)="This RPC returns all charges with VENDOR PURCHASE ORDER equal to null or "
^XWB(8994,4623,1,2,0)="all ""0""s (i.e. - ""000000"") for the specified user.  This list is "
^XWB(8994,4623,1,3,0)="associated to the LPCI Plus report."
^XWB(8994,4623,2,0)="^8994.02A^2^2"
^XWB(8994,4623,2,1,0)="DSSOUSR^1^15^1^1"
^XWB(8994,4623,2,1,1,0)="^8994.021^3^3^3210706^^"
^XWB(8994,4623,2,1,1,1,0)="File 200 IEN - user for which unreconciled charges with VENDOR PURCHASE"
^XWB(8994,4623,2,1,1,2,0)="               ORDER (file 440.6 #20) equal to null or all ""0""s are"
^XWB(8994,4623,2,1,1,3,0)="               returned"
^XWB(8994,4623,2,2,0)="DSSOIEN^1^15^0^2"
^XWB(8994,4623,2,2,1,0)="^8994.021^3^3^3210706^^^^"
^XWB(8994,4623,2,2,1,1,0)="IEN of last file 440.6 record processed for chunking purposes - not "
^XWB(8994,4623,2,2,1,2,0)="required on the first call of the RPC, but it is required for each "
^XWB(8994,4623,2,2,1,3,0)="subsequent call"
^XWB(8994,4623,2,"B","DSSOIEN",2)=""
^XWB(8994,4623,2,"B","DSSOUSR",1)=""
^XWB(8994,4623,2,"PARAMSEQ",1,1)=""
^XWB(8994,4623,2,"PARAMSEQ",2,2)=""
^XWB(8994,4623,3,0)="^^30^30^3210706^"
^XWB(8994,4623,3,1,0)="Output: "
^XWB(8994,4623,3,2,0)="  Error Message format:  ""-1^""_error message"
^XWB(8994,4623,3,3,0)="     ""-1^User is required."""
^XWB(8994,4623,3,4,0)="     ""-1^Invalid User"""
^XWB(8994,4623,3,5,0)="     ""-1^Unknown error occurred"""
^XWB(8994,4623,3,6,0)="     ""-1^DSSOROH1-NULLVPO 440.6 IEN ""_ien_ ""-""_FileMan error text"
^XWB(8994,4623,3,7,0)=" "
^XWB(8994,4623,3,8,0)="  Warning Message format: ""0^""_warning message"
^XWB(8994,4623,3,9,0)="     ""0^No Credit Card Transactions with Null VPO found for this user."""
^XWB(8994,4623,3,10,0)="        Returned if no unreconciled charges exist for the specified user"
^XWB(8994,4623,3,11,0)="          in file 440.6"
^XWB(8994,4623,3,12,0)=" "
^XWB(8994,4623,3,13,0)="  Successful Completion: array of caret-delimited charge data from"
^XWB(8994,4623,3,14,0)="     file 440.6 in format:"
^XWB(8994,4623,3,15,0)="       DSSORET(n)= piece 1 ^ piece 2 ^ piece 3 ^ piece 4 ^ piece 5"
^XWB(8994,4623,3,16,0)="         ^-piece 1:  440.6 IEN"
^XWB(8994,4623,3,17,0)="         ^-piece 2:  TRANSACTION DATE (file 440.6 field #6)"
^XWB(8994,4623,3,18,0)="         ^-piece 3:  AMOUNT (file 440.6 field #13) "
^XWB(8994,4623,3,19,0)="         ^-piece 4:  MERCHANT NAME (file 440.6 field #31)"
^XWB(8994,4623,3,20,0)="         ^-piece 5:  CREDIT CARD NUMBER (file 440.6 field #3) - "
^XWB(8994,4623,3,21,0)="                     last 4 digits"
^XWB(8994,4623,3,22,0)="     If the end of the data for this user was not reached, a final node "
^XWB(8994,4623,3,23,0)="     formatted as follows is returned:"
^XWB(8994,4623,3,24,0)="       ""$$MORE$$^File 440.6 IEN"" where File 440.6 IEN is to be passed"
^XWB(8994,4623,3,25,0)="          into the next call of this RPC until all data has been "
^XWB(8994,4623,3,26,0)="          processed."
^XWB(8994,4623,3,27,0)="     When the end of the data for the specified user has been reached,"
^XWB(8994,4623,3,28,0)="     this node is returned whether data is returned or not on the last"
^XWB(8994,4623,3,29,0)="     call:"
^XWB(8994,4623,3,30,0)="       ""1^COMPLETE"""
^XWB(8994,4624,0)="PSO VCC REFILL^AP1^PSOVCCA^2^A^^^^^^1"
^XWB(8994,4624,1,0)="^^6^6^3220411^"
^XWB(8994,4624,1,1,0)="The RPC performs a refill on an outpatient pharmacy order request."
^XWB(8994,4624,1,2,0)=" "
^XWB(8994,4624,1,3,0)="In addition, the RPC will provide the ability in Outpatient Pharmacy "
^XWB(8994,4624,1,4,0)="to store the source of a refill request (eg. VCC, Computerized Patient "
^XWB(8994,4624,1,5,0)="Record System (CPRS), Outpatient Pharmacy) as well as the person "
^XWB(8994,4624,1,6,0)="making the request - if the name is known."
^XWB(8994,4624,2,0)="^8994.02A^5^5"
^XWB(8994,4624,2,1,0)="DFN^1^30^1^1"
^XWB(8994,4624,2,1,1,0)="^^1^1^3220426^"
^XWB(8994,4624,2,1,1,1,0)="Internal Entry Number of the patient record for the PATIENT file (#2)."
^XWB(8994,4624,2,2,0)="RXN^1^30^1^2"
^XWB(8994,4624,2,2,1,0)="^^2^2^3220426^"
^XWB(8994,4624,2,2,1,1,0)="The external representation of the Prescription number from the"
^XWB(8994,4624,2,2,1,2,0)="PRESCRIPTION file (#52,.01)."
^XWB(8994,4624,2,3,0)="USER^1^30^0^3"
^XWB(8994,4624,2,3,1,0)="^^1^1^3220426^"
^XWB(8994,4624,2,3,1,1,0)="USER requesting the refill."
^XWB(8994,4624,2,4,0)="REFILL SOURCE^1^30^0^4"
^XWB(8994,4624,2,4,1,0)="^8994.021^1^1^3220629^^^^"
^XWB(8994,4624,2,4,1,1,0)="The system from which the REFILL request Originated (e.g., VCC, VSE)."
^XWB(8994,4624,2,5,0)="RETURN FLAG^1^1^0^5"
^XWB(8994,4624,2,5,1,0)="^^5^5^3220629^"
^XWB(8994,4624,2,5,1,1,0)="Return Flag"
^XWB(8994,4624,2,5,1,2,0)=" an optional input parameter in which the value will be 1 or null."
^XWB(8994,4624,2,5,1,3,0)=" if = 1 then the RPC will return the numeric code with the error text."
^XWB(8994,4624,2,5,1,4,0)=" if = null then the RPC will only return the numeric code (-5, -4, -3, 0, "
^XWB(8994,4624,2,5,1,5,0)="      or 1 )"
^XWB(8994,4624,2,"B","DFN",1)=""
^XWB(8994,4624,2,"B","REFILL SOURCE",4)=""
^XWB(8994,4624,2,"B","RETURN FLAG",5)=""
^XWB(8994,4624,2,"B","RXN",2)=""
^XWB(8994,4624,2,"B","USER",3)=""
^XWB(8994,4624,2,"PARAMSEQ",1,1)=""
^XWB(8994,4624,2,"PARAMSEQ",2,2)=""
^XWB(8994,4624,2,"PARAMSEQ",3,3)=""
^XWB(8994,4624,2,"PARAMSEQ",4,4)=""
^XWB(8994,4624,2,"PARAMSEQ",5,5)=""
^XWB(8994,4624,3,0)="^^37^37^3220630^"
^XWB(8994,4624,3,1,0)="Returns an array. Depending on the value of the Return Flag input"
^XWB(8994,4624,3,2,0)="parameter, either a single code is returned or a code and free text "
^XWB(8994,4624,3,3,0)="description of the code."
^XWB(8994,4624,3,4,0)=" "
^XWB(8994,4624,3,5,0)="When the Return Flag input parameter equals 1, then the code and text"
^XWB(8994,4624,3,6,0)="description will be returned:"
^XWB(8994,4624,3,7,0)=" "
^XWB(8994,4624,3,8,0)="Exception condition when attempting to refill the prescription:"
^XWB(8994,4624,3,9,0)="ARRAY(0)=0 "
^XWB(8994,4624,3,10,0)="ARRAY(1)=error text detail on why the prescription was not filled"
^XWB(8994,4624,3,11,0)=" "
^XWB(8994,4624,3,12,0)="The following is an example of one of many types of exceptions that could"
^XWB(8994,4624,3,13,0)="be returned:"
^XWB(8994,4624,3,14,0)="ARRAY(0)=0"
^XWB(8994,4624,3,15,0)="ARRAY(1)="" Cannot refill Rx # 2769331  Rx is in SUSPENDED status"""
^XWB(8994,4624,3,16,0)=" "
^XWB(8994,4624,3,17,0)="Successful refill:"
^XWB(8994,4624,3,18,0)="ARRAY(0)=""1 - Prescription successfully refilled"""
^XWB(8994,4624,3,19,0)=" "
^XWB(8994,4624,3,20,0)="Data validation error which will be one of the following:"
^XWB(8994,4624,3,21,0)="ARRAY(0)=""-3 - Missing or Invalid Prescription Number"""
^XWB(8994,4624,3,22,0)="ARRAY(0)=""-4 - Missing or Invalid Patient ID"""
^XWB(8994,4624,3,23,0)="ARRAY(0)=""-5 - Prescription Number does not match to the Patient"""
^XWB(8994,4624,3,24,0)="ARRAY(0)=""-6 - Patient is not assigned an ICN"""
^XWB(8994,4624,3,25,0)=" "
^XWB(8994,4624,3,26,0)="When the Return Flag is equal null, then only the code will be sent:"
^XWB(8994,4624,3,27,0)=" "
^XWB(8994,4624,3,28,0)="Exception condition when attempting to refill the prescription:"
^XWB(8994,4624,3,29,0)="ARRAY(0)=0"
^XWB(8994,4624,3,30,0)=" "
^XWB(8994,4624,3,31,0)="Successful refill:"
^XWB(8994,4624,3,32,0)="ARRAY(0)=1"
^XWB(8994,4624,3,33,0)=" "
^XWB(8994,4624,3,34,0)="Data Validation error which will be one of the following:"
^XWB(8994,4624,3,35,0)="ARRAY(0)=-3"
^XWB(8994,4624,3,36,0)="ARRAY(0)=-4"
^XWB(8994,4624,3,37,0)="ARRAY(0)=-5"
^XWB(8994,4629,0)="SDES GET STOPCD DETAIL^GETSTOPCODE^SDES^2^R^^^^^^1"
