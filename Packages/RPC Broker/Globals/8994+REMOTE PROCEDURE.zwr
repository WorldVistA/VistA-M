^XWB(8994,2711,1,1,0)="This Remote Procedure Call allows the remote creation of a VistA"
^XWB(8994,2711,1,2,0)="PATIENT (#2) record at the Preferred Facility for the Veteran"
^XWB(8994,2711,1,3,0)="On-Line Application (VOA) project."
^XWB(8994,2711,2,0)="^8994.02A^2^1"
^XWB(8994,2711,2,2,0)="PARAM^2^2000^1^1"
^XWB(8994,2711,2,2,1,0)="^8994.021^109^109^3210413^^"
^XWB(8994,2711,2,2,1,1,0)="PARAM may contain the following values: (R) Required (O) Optional"
^XWB(8994,2711,2,2,1,2,0)="The values are passed into this RPC from the Master Patient Index (MPI) "
^XWB(8994,2711,2,2,1,3,0)="via the MPI PSIM ADD PREF FACILITY Remote Procedure."
^XWB(8994,2711,2,2,1,4,0)="     "
^XWB(8994,2711,2,2,1,5,0)="  (R) PARAM(""PRFCLTY"") = Preferred Facility Station Number. Must be the"
^XWB(8994,2711,2,2,1,6,0)="                         same as the receiving site."
^XWB(8994,2711,2,2,1,7,0)="                      "
^XWB(8994,2711,2,2,1,8,0)="  (R) PARAM(""NAME"") = Last Name^First Name^Middle Name^Suffix"
^XWB(8994,2711,2,2,1,9,0)="                      Name of the applicant to be added to the PATIENT"
^XWB(8994,2711,2,2,1,10,0)="                      (#2) file. The name is converted ino the format:"
^XWB(8994,2711,2,2,1,11,0)="                        LastName,FirstName MiddleName Suffix"
^XWB(8994,2711,2,2,1,12,0)="                      when the entry is added. Then, if the NAME"
^XWB(8994,2711,2,2,1,13,0)="                      COMPONENTS flag for this site is set to 1, the Name"
^XWB(8994,2711,2,2,1,14,0)="                      Components passed in PARAM(""LONGNAME"") are filed in"
^XWB(8994,2711,2,2,1,15,0)="                      the NAME COMPONENTS (#20) file for that patient. If"
^XWB(8994,2711,2,2,1,16,0)="                      PARAM(""LONGNAME"") is not passed, then the Name"
^XWB(8994,2711,2,2,1,17,0)="                      Components from PARAM(""NAME"") are filed."
^XWB(8994,2711,2,2,1,18,0)="                     "
^XWB(8994,2711,2,2,1,19,0)="  (O) PARAM(""LONGNAME"") = Last Name^First Name^Middle Name^Suffix"
^XWB(8994,2711,2,2,1,20,0)="                          If the full name is greater than 30 characters"
^XWB(8994,2711,2,2,1,21,0)="                          in length, the unshortened components can be"
^XWB(8994,2711,2,2,1,22,0)="                          sent in this parameter. After an entry is"
^XWB(8994,2711,2,2,1,23,0)="                          created in the PATIENT (#2) file with the name"
^XWB(8994,2711,2,2,1,24,0)="                          passed in PARAM(""NAME""), if the NAME COMPONENTS"
^XWB(8994,2711,2,2,1,25,0)="                          FLAG at this site is set to 1, the Name"
^XWB(8994,2711,2,2,1,26,0)="                          Components passed in this parameter are filed"
^XWB(8994,2711,2,2,1,27,0)="                          into the NAME COMPONENTS (#20) for this entry."
^XWB(8994,2711,2,2,1,28,0)="                     "
^XWB(8994,2711,2,2,1,29,0)="  (R) PARAM(""GENDER"") = External format - MALE or FEMALE"
^XWB(8994,2711,2,2,1,30,0)="                        SEX of the applicant to be added to the PATIENT"
^XWB(8994,2711,2,2,1,31,0)="                        (#2) file."
^XWB(8994,2711,2,2,1,32,0)="                     "
^XWB(8994,2711,2,2,1,33,0)="  (R) PARAM(""DOB"") = External date format; can be imprecise. Month and/or"
^XWB(8994,2711,2,2,1,34,0)="                     day alone, without year is not allowed. DATE OF BIRTH"
^XWB(8994,2711,2,2,1,35,0)="                     of the applicant to be added to the PATIENT (#2)"
^XWB(8994,2711,2,2,1,36,0)="                     file."
^XWB(8994,2711,2,2,1,37,0)="                     "
^XWB(8994,2711,2,2,1,38,0)="  (R) PARAM(""SSN"") = Format: nine numbers / no dashes, or a NULL value."
^XWB(8994,2711,2,2,1,39,0)="                     The SOCIAL SECURITY NUMBER of the applicant to be "
^XWB(8994,2711,2,2,1,40,0)="                     added to the PATIENT (#2) file. If SSN is sent with a"
^XWB(8994,2711,2,2,1,41,0)="                     null value, then the patient is given a PSEUDO SSN"
^XWB(8994,2711,2,2,1,42,0)="                     number and the PSEUDO SSN REASON field is also set to"
^XWB(8994,2711,2,2,1,43,0)="                     ""SSN UNKNOWN/FOLLOW-UP REQUIRED""."
^XWB(8994,2711,2,2,1,44,0)="                    "
^XWB(8994,2711,2,2,1,45,0)="  (R) PARAM(""SRVCNCTD"") = YES or NO"
^XWB(8994,2711,2,2,1,46,0)="                          Is the applicant to be added to the PATIENT (#2)"
^XWB(8994,2711,2,2,1,47,0)="                          file SERVICE CONNECTED?"
^XWB(8994,2711,2,2,1,48,0)="                  "
^XWB(8994,2711,2,2,1,49,0)="  (R) PARAM(""TYPE"") = Primary patient TYPE:"
^XWB(8994,2711,2,2,1,50,0)="                        ACTIVE DUTY,"
^XWB(8994,2711,2,2,1,51,0)="                        ALLIED VETERAN,"
^XWB(8994,2711,2,2,1,52,0)="                        COLLATERAL,"
^XWB(8994,2711,2,2,1,53,0)="                        EMPLOYEE,"
^XWB(8994,2711,2,2,1,54,0)="                        MILITARY RETIREE,"
^XWB(8994,2711,2,2,1,55,0)="                        NON-VETERAN (OTHER),"
^XWB(8994,2711,2,2,1,56,0)="                        NSC VETERAN,"
^XWB(8994,2711,2,2,1,57,0)="                        SC VETERAN, OR"
^XWB(8994,2711,2,2,1,58,0)="                        TRICARE"
^XWB(8994,2711,2,2,1,59,0)="                      Primary patient TYPE of the applicant to be added to"
^XWB(8994,2711,2,2,1,60,0)="                      the PATIENT (#2) file."
^XWB(8994,2711,2,2,1,61,0)="                  "
^XWB(8994,2711,2,2,1,62,0)="  (R) PARAM(""VET"") = YES or NO"
^XWB(8994,2711,2,2,1,63,0)="                     Is the applicant to be added to the PATIENT (#2) file"
^XWB(8994,2711,2,2,1,64,0)="                     a VETERAN?"
^XWB(8994,2711,2,2,1,65,0)="                  "
^XWB(8994,2711,2,2,1,66,0)="  (R) PARAM(""FULLICN "") = A 10 digit NUMBER, followed by V (delimiter),"
^XWB(8994,2711,2,2,1,67,0)="                          followed by a 6 digit CHECKSUM NUMBER."
^XWB(8994,2711,2,2,1,68,0)="                          The full INTEGRATION CONTROL NUMBER (ICN) of the"
^XWB(8994,2711,2,2,1,69,0)="                          applicant to be added to the PATIENT (#2) file."
^XWB(8994,2711,2,2,1,70,0)="      "
^XWB(8994,2711,2,2,1,71,0)="  (O) PARAM(""POBCTY"") = City name."
^XWB(8994,2711,2,2,1,72,0)="                        PLACE OF BIRTH [CITY] of the applicant to be added"
^XWB(8994,2711,2,2,1,73,0)="                        to the PATIENT (#2) file."
^XWB(8994,2711,2,2,1,74,0)="                  "
^XWB(8994,2711,2,2,1,75,0)="  (O) PARAM(""POBST"") = 2-character STATE ABBREVIATION"
^XWB(8994,2711,2,2,1,76,0)="                       PLACE OF BIRTH [STATE] of the applicant to be added"
^XWB(8994,2711,2,2,1,77,0)="                       to the PATIENT (#2) file."
^XWB(8994,2711,2,2,1,78,0)="                  "
^XWB(8994,2711,2,2,1,79,0)="  (O) PARAM(""MMN"") = MOTHER'S MAIDEN NAME."
^XWB(8994,2711,2,2,1,80,0)="                     Maiden name of the mother of the applicant to be"
^XWB(8994,2711,2,2,1,81,0)="                     added to the PATIENT (#2) file."
^XWB(8994,2711,2,2,1,82,0)="                  "
^XWB(8994,2711,2,2,1,83,0)="  (O) PARAM(""MBI"") = MULTIPLE BIRTH INDICATOR. Y or N"
^XWB(8994,2711,2,2,1,84,0)="                  "
^XWB(8994,2711,2,2,1,85,0)="  (O) PARAM(""ALIAS"",#) = ALIAS"
^XWB(8994,2711,2,2,1,86,0)="                           LastName^FirstName^MiddleName^Suffix^SSN"
^XWB(8994,2711,2,2,1,87,0)="                         The Alias Name is converted to:"
^XWB(8994,2711,2,2,1,88,0)="                           LastName,FirstName MiddleName Suffix"
^XWB(8994,2711,2,2,1,89,0)="                         The # subscript is a sequential number."
^XWB(8994,2711,2,2,1,90,0)="                  "
^XWB(8994,2711,2,2,1,91,0)="  (O) PARAM(""ENROLLMENT"") = Set equal to 1 if Enrollment/Eligibility "
^XWB(8994,2711,2,2,1,92,0)="                            messaging should be triggered to further "
^XWB(8994,2711,2,2,1,93,0)="                            update the identity/registration of the"
^XWB(8994,2711,2,2,1,94,0)="                            individual at the site."
^XWB(8994,2711,2,2,1,95,0)="                  "
^XWB(8994,2711,2,2,1,96,0)="  (O) PARAM(""ResAddL1"")       = Street address line1"
^XWB(8994,2711,2,2,1,97,0)="  (O) PARAM(""ResAddL2"")       = Street address line2"
^XWB(8994,2711,2,2,1,98,0)="  (O) PARAM(""ResAddL3"")       = Street address line3"
^XWB(8994,2711,2,2,1,99,0)="  (O) PARAM(""ResAddCity"")     = City address"
^XWB(8994,2711,2,2,1,100,0)="  (O) PARAM(""ResAddState"")    = 2-character state abbreviation"
^XWB(8994,2711,2,2,1,101,0)="                                  (for a US address)"
^XWB(8994,2711,2,2,1,102,0)="  (O) PARAM(""ResAddZIP"")      = Zip code (5 or 9 digits) (for a US"
^XWB(8994,2711,2,2,1,103,0)="                                  address)"
^XWB(8994,2711,2,2,1,104,0)="  (O) PARAM(""ResPhone"")       = Home phone"
^XWB(8994,2711,2,2,1,105,0)="  (O) PARAM(""ResAddCountry"")  = 3-character country code"
^XWB(8994,2711,2,2,1,106,0)="                                  (e.g., USA, CAN, MEX)"
^XWB(8994,2711,2,2,1,107,0)="                         "
^XWB(8994,2711,2,2,1,108,0)="  (O) PARAM(""ResAddProvince"") = Province (for a foreign address)"
^XWB(8994,2711,2,2,1,109,0)="  (O) PARAM(""ResAddPCode"")    = Postal code (for a foreign address)"
^XWB(8994,2711,2,"B","PARAM",2)=""
^XWB(8994,2711,2,"PARAMSEQ",1,2)=""
^XWB(8994,2711,3,0)="^^35^35^3210413^"
^XWB(8994,2711,3,1,0)="This RPC will return a string with up to 4 ^-pieces."
^XWB(8994,2711,3,2,0)=" "
^XWB(8994,2711,3,3,0)="If a PATIENT (#2) file entry was created successfully,"
^XWB(8994,2711,3,4,0)=" "
^XWB(8994,2711,3,5,0)="  1st ^-piece = 1"
^XWB(8994,2711,3,6,0)="  2nd ^-piece = DFN of the PATIENT created"
^XWB(8994,2711,3,7,0)="  3rd ^-piece = if the patient was created but ALIAS data failed to "
^XWB(8994,2711,3,8,0)="                  update, this piece contains an error message"
^XWB(8994,2711,3,9,0)="  4th ^-piece = 1 or null"
^XWB(8994,2711,3,10,0)="                If the NAME COMPONENTS FLAG is set to 1 at this site, this"
^XWB(8994,2711,3,11,0)="                piece contains a 1 to indicate that name components passed"
^XWB(8994,2711,3,12,0)="                in PARAM(""LONGNAME"") (if passed) or PARAM(""NAME"") were"
^XWB(8994,2711,3,13,0)="                filed into the NAME COMPONENTS (#20) file for this"
^XWB(8994,2711,3,14,0)="                patient."
^XWB(8994,2711,3,15,0)=" "
^XWB(8994,2711,3,16,0)="If an entry already exists in the PATIENT (#2) file that has an ICN equal "
^XWB(8994,2711,3,17,0)="to the ICN passed in PARAM(""FULLICN""), then the following is returned. "
^XWB(8994,2711,3,18,0)="(Note that the Patient record is not updated with any of the data passed "
^XWB(8994,2711,3,19,0)="in the PARAM input array.)"
^XWB(8994,2711,3,20,0)=" "
^XWB(8994,2711,3,21,0)="   1^DFN of the existing PATIENT with an ICN equal to PARAM(""FULLICN"")"
^XWB(8994,2711,3,22,0)=" "
^XWB(8994,2711,3,23,0)="If the patient could not be added to the PATIENT file the following is "
^XWB(8994,2711,3,24,0)="returned:"
^XWB(8994,2711,3,25,0)=" "
^XWB(8994,2711,3,26,0)="  -1^<error text>"
^XWB(8994,2711,3,27,0)="   "
^XWB(8994,2711,3,28,0)="Example output:"
^XWB(8994,2711,3,29,0)=" "
^XWB(8994,2711,3,30,0)="  1^<dfn>"
^XWB(8994,2711,3,31,0)="  1^<dfn>^^1"
^XWB(8994,2711,3,32,0)="  1^<dfn>^<error text about alias failing to update>"
^XWB(8994,2711,3,33,0)="  1^<dfn>^<error text about alias failing to update>^1"
^XWB(8994,2711,3,34,0)=" "
^XWB(8994,2711,3,35,0)="  -1^<error text>"
^XWB(8994,2712,0)="DVBAB ZIP2CITY^ZIP2CITY^DVBABADR^2^S"
^XWB(8994,2712,1,0)="^^4^4^3090611^"
^XWB(8994,2712,1,1,0)="The remote procedure returns a list containing city, county, and state for"
^XWB(8994,2712,1,2,0)="a given ZIP code."
^XWB(8994,2712,1,3,0)="Results format:  Result(0)=ResultCount_""^""_ErrorMsg"
^XWB(8994,2712,1,4,0)="                 Result(1..n)=City_""^""_County_""^""_State"
^XWB(8994,2712,2,0)="^8994.02A^1^1"
^XWB(8994,2712,2,1,0)="DVBZIP^1^12^1^1"
^XWB(8994,2712,2,1,1,0)="^^1^1^3090611^"
^XWB(8994,2712,2,1,1,1,0)="ZIP code value in ZIP+4 format."
^XWB(8994,2712,2,"B","DVBZIP",1)=""
^XWB(8994,2712,2,"PARAMSEQ",1,1)=""
^XWB(8994,2712,3,0)="^^3^3^3090611^"
^XWB(8994,2712,3,1,0)="RESULT(0)=ResultCount_""^""_ErrorMsg"
^XWB(8994,2712,3,2,0)="RESULT(1)=City_""^""_County_""^""_State"
^XWB(8994,2712,3,3,0)="RESULT(n)=City_""^""_County_""^""_State"
^XWB(8994,2713,0)="DVBA CHECK PATCH^CHECK^DVBAB1B^1^S"
^XWB(8994,2713,1,0)="^^3^3^3090930^"
^XWB(8994,2713,1,1,0)="This RPC is a wrapper for the supported $$PATCH^XPDUTL API to determine"
^XWB(8994,2713,1,2,0)="whether a given patch is installed or not.  ""1^Patch Is Installed"" is "
^XWB(8994,2713,1,3,0)="returned on success; otherwise ""0^Patch Is Not Installed"" is returned."
^XWB(8994,2713,2,0)="^8994.02A^1^1"
^XWB(8994,2713,2,1,0)="DVBPATCH^1^20^1^1"
^XWB(8994,2713,2,1,1,0)="^^1^1^3090930^"
^XWB(8994,2713,2,1,1,1,0)="This parameter contains the patch designation (ex. DVBA*2.7*142)."
^XWB(8994,2713,2,"B","DVBPATCH",1)=""
^XWB(8994,2713,2,"PARAMSEQ",1,1)=""
^XWB(8994,2713,3,0)="^^2^2^3090930^"
^XWB(8994,2713,3,1,0)="Returns ""1^Patch Is Installed"" on success; otherwise returns ""0^Patch Is "
^XWB(8994,2713,3,2,0)="Not Installed""."
^XWB(8994,2714,0)="MAG BROKER SECURITY^BSE^MAGS2BSE^1^R"
^XWB(8994,2714,1,0)="^^1^1^3090818^"
^XWB(8994,2714,1,1,0)="CALL BSE(BROKER SECURITY ENHANCEMENT) - XUS SET VISITOR, RETURN A BSE TOKEN"
^XWB(8994,2714,2,0)="^8994.02A^1^1"
^XWB(8994,2714,2,1,0)="RES^1^256^0"
^XWB(8994,2714,2,1,1,0)="^^1^1^3090818^"
^XWB(8994,2714,2,1,1,1,0)="CALL TO GET A BSE TOKEN FOR AUTHENTICATING REMOTE VISTA USER"
^XWB(8994,2714,2,"B","RES",1)=""
^XWB(8994,2714,3,0)="^^2^2^3090818^"
^XWB(8994,2714,3,1,0)="RETURN A BSE TOKEN ACCORDING THE USER'S DUZ, E.G.: XUSBSE2032-487327_6"
^XWB(8994,2714,3,2,0)="THAT SAVES THE USER DEMOGRAPHIC INFO INTO XTMP(TOKEN, ) W/ EXPIRED DATE"
^XWB(8994,2715,0)="PSN FDA MED GUIDE PRINT QUEUE^RETRIEVE^PSNFDAMG^2^R^^^0^^^0"
^XWB(8994,2715,1,0)="^^2^2^3100212^"
^XWB(8994,2715,1,1,0)="This Remote Proceedure Call is used by a Java Client to print FDA Medication"
^XWB(8994,2715,1,2,0)="Guides for the National Drug File (NDF) application."
^XWB(8994,2715,2,0)="^8994.02A^1^1"
^XWB(8994,2715,2,1,0)="AIP^1^15^1"
^XWB(8994,2715,2,1,1,0)="^^1^1^3100212^"
^XWB(8994,2715,2,1,1,1,0)="The desk top IP address"
^XWB(8994,2715,2,"B","AIP",1)=""
^XWB(8994,2715,3,0)="^^1^1^3100212^"
^XWB(8994,2715,3,1,0)="The FDA Med Guide URL"
^XWB(8994,2716,0)="TIU MED GET PATIENT DATA^GETPATDT^TIUMED1^2^R^0"
^XWB(8994,2716,1,0)="^8994.01^1^1^3090610^^^"
^XWB(8994,2716,1,1,0)="Returns patient data."
^XWB(8994,2716,2,0)="^8994.02A^3^3"
^XWB(8994,2716,2,1,0)="TIUDFN^1^^1^1"
^XWB(8994,2716,2,1,1,0)="^8994.021^1^1^3090610^^"
^XWB(8994,2716,2,1,1,1,0)="This is the patient IEN."
^XWB(8994,2716,2,2,0)="TIUSEC^1^^0^2"
^XWB(8994,2716,2,2,1,0)="^8994.021^2^2^3090610^^"
^XWB(8994,2716,2,2,1,1,0)="This BOOLEAN value allows sensitive patient data to be displayed or "
^XWB(8994,2716,2,2,1,2,0)="hidden."
^XWB(8994,2716,2,3,0)="TIUGHS^1^^0^3"
^XWB(8994,2716,2,3,1,0)="^8994.021^2^2^3090610^^^"
^XWB(8994,2716,2,3,1,1,0)="This BOOLEAN value determines whether or not HEALTH SUMMARY information "
^XWB(8994,2716,2,3,1,2,0)="will included after the patient data."
^XWB(8994,2716,2,"B","TIUDFN",1)=""
^XWB(8994,2716,2,"B","TIUGHS",3)=""
^XWB(8994,2716,2,"B","TIUSEC",2)=""
^XWB(8994,2716,2,"PARAMSEQ",1,1)=""
^XWB(8994,2716,2,"PARAMSEQ",2,2)=""
^XWB(8994,2716,2,"PARAMSEQ",3,3)=""
^XWB(8994,2716,3,0)="^8994.03^5^5^3090610^^^"
^XWB(8994,2716,3,1,0)="The return array has elements with the following positional values:"
^XWB(8994,2716,3,2,0)=" "
^XWB(8994,2716,3,3,0)="PATIENT DFN^PATIENT NAME^PATIENT SEX^PATIENT SSN^PATIENT DOB^SECURITY"
^XWB(8994,2716,3,4,0)=" "
^XWB(8994,2716,3,5,0)="Health Summary Data Follows if desired."
^XWB(8994,2717,0)="TIU MED GET HEALTH SUMMARY^GETHS^TIUMED1^2^R^0"
^XWB(8994,2717,1,0)="^^1^1^3090610^"
^XWB(8994,2717,1,1,0)="Returns the HEALTH SUMMARY information."
^XWB(8994,2717,2,0)="^8994.02A^1^1"
^XWB(8994,2717,2,1,0)="TIUDFN^1^^1^1"
^XWB(8994,2717,2,1,1,0)="^^1^1^3090610^"
^XWB(8994,2717,2,1,1,1,0)="This is the patient IEN."
^XWB(8994,2717,2,"B","TIUDFN",1)=""
^XWB(8994,2717,2,"PARAMSEQ",1,1)=""
^XWB(8994,2718,0)="TIU MED LAST5^LAST5^TIUMED1^2^R^0"
^XWB(8994,2718,1,0)="^8994.01^1^1^3090610^^"
^XWB(8994,2718,1,1,0)="Returns a list of patients that match an A9999 identifier."
^XWB(8994,2718,2,0)="^8994.02A^1^1"
^XWB(8994,2718,2,1,0)="TIUID^1^^1^1"
^XWB(8994,2718,2,"B","TIUID",1)=""
^XWB(8994,2718,2,"PARAMSEQ",1,1)=""
^XWB(8994,2719,0)="TIU MED LIST ALL^LISTALL^TIUMED1^2^R^0"
^XWB(8994,2719,1,0)="^^1^1^3090610^"
^XWB(8994,2719,1,1,0)="Returns a list of patients for selection."
