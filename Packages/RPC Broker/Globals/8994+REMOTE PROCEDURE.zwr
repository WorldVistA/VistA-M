^XWB(8994,4045,2,3,1,9,0)="DSIYDAT(""COM1"")=first comment line"
^XWB(8994,4045,2,3,1,10,0)="DSIYDAT(""COM2"")=second comment line"
^XWB(8994,4045,2,3,1,11,0)=" "
^XWB(8994,4045,2,3,1,12,0)="DSIYDAT(""I"",IEN)=IEN - for each record to change"
