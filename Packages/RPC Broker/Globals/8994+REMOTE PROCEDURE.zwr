^XWB(8994,4927,2,0)="^8994.02A^3^3"
^XWB(8994,4927,2,1,0)="DSIVDFN^1^30^1^1"
^XWB(8994,4927,2,1,1,0)="^^2^2^3221201^"
^XWB(8994,4927,2,1,1,1,0)="This is the patient IEN for which you wish to start the CMS MBI process "
^XWB(8994,4927,2,1,1,2,0)="for ""No Insurance"" buffers."
^XWB(8994,4927,2,2,0)="DSIVLOC^1^30^1^2"
^XWB(8994,4927,2,2,1,0)="^^2^2^3221201^"
^XWB(8994,4927,2,2,1,1,0)="This is the location IEN (#44) for which you wish to start the CMS MBI "
^XWB(8994,4927,2,2,1,2,0)="process for a ""No Insurance"" buffer entry."
