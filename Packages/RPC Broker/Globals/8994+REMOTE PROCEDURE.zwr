^XWB(8994,4020,0)="DSIYGO01 AUTOGENS SECONDARY^AUTOGENS^DSIYGO01^4^^^^1"
^XWB(8994,4020,1,0)="^8994.01^7^7^3130918^^"
^XWB(8994,4020,1,1,0)="AUTOGENS"
^XWB(8994,4020,1,2,0)=" "
^XWB(8994,4020,1,3,0)="Runs AutoGen for a Secondary."
^XWB(8994,4020,1,4,0)=" "
^XWB(8994,4020,1,5,0)="The first time through, the user might be warned that there are existing "
^XWB(8994,4020,1,6,0)="orders outstanding for this secondary.  The GUI can allow the user to "
^XWB(8994,4020,1,7,0)="""FORCE"" the run the second time through."
^XWB(8994,4020,2,0)="^8994.02A^3^3"
^XWB(8994,4020,2,1,0)="PIEN^1^15^0^1"
^XWB(8994,4020,2,1,1,0)="^^7^7^3130918^"
^XWB(8994,4020,2,1,1,1,0)="PIEN"
^XWB(8994,4020,2,1,1,2,0)=" "
^XWB(8994,4020,2,1,1,3,0)="Primary Distribution Point to stock from.  If blank assume ALL primary "
^XWB(8994,4020,2,1,1,4,0)="distribution points can be used."
^XWB(8994,4020,2,1,1,5,0)=" "
^XWB(8994,4020,2,1,1,6,0)="ASSUMPTION:  All user validation for this primary distribution point has "
^XWB(8994,4020,2,1,1,7,0)="been done no checking is done in this RPC."
^XWB(8994,4020,2,2,0)="IPIEN^1^15^1^2"
^XWB(8994,4020,2,2,1,0)="^^7^7^3130918^"
^XWB(8994,4020,2,2,1,1,0)="IPIEN"
^XWB(8994,4020,2,2,1,2,0)=" "
^XWB(8994,4020,2,2,1,3,0)="IEN for the Secondary Distribution Point which is being stocked - "
^XWB(8994,4020,2,2,1,4,0)="Required."
^XWB(8994,4020,2,2,1,5,0)=" "
^XWB(8994,4020,2,2,1,6,0)="ASSUMPTION:  All validation as to whether the user has access to this "
^XWB(8994,4020,2,2,1,7,0)="Distribution Point has been done - this RPC will not check for this."
^XWB(8994,4020,2,3,0)="FORCE^1^1^0^3"
^XWB(8994,4020,2,3,1,0)="^^5^5^3130918^"
^XWB(8994,4020,2,3,1,1,0)="FORCE"
^XWB(8994,4020,2,3,1,2,0)=" "
^XWB(8994,4020,2,3,1,3,0)="Set to 1 if the first time through the user was warned that there are "
^XWB(8994,4020,2,3,1,4,0)="outstanding distribution orders.  If the user agrees they want to run "
^XWB(8994,4020,2,3,1,5,0)="AutoGen anyways, call it again with FORCE=1"
